index 0000000000000000000000000000000000000000..9c15c2deb4379b1a5ce2003f5ed15d74cc8014ea
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,66 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("RFC 6902 examples", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(applyPatch({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]), { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]),
+    { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(applyPatch({ a: { b: 1 } }, [{ op: "copy", from: "/a", path: "/c" }]), { a: { b: 1 }, c: { b: 1 } });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: 1 }]), { a: 1 });
+});
+
+test("root and empty-key paths", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch({ "": 1 }, [{ op: "replace", path: "/", value: 2 }]), { "": 2 });
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/", value: 2 }]), { "": 2 });
+});
+
+test("does not mutate and does not share", () => {
+  const doc = { a: { b: 1 } };
+  const value = { x: 1 };
+  const out = applyPatch(doc, [{ op: "add", path: "/c", value }]) as any;
+  assert.deepEqual(doc, { a: { b: 1 } });
+  assert.notEqual(out.c, value);
+  assert.notEqual(out.a, doc.a);
+});
+
+test("failures", () => {
+  const bad: unknown[] = [
+    [{ op: "remove", path: "/x" }],
+    [{ op: "replace", path: "/x", value: 1 }],
+    [{ op: "add", path: "/x/y", value: 1 }],
+    [{ op: "add", path: "/l/5", value: 1 }],
+    [{ op: "add", path: "/l/01", value: 1 }],
+    [{ op: "remove", path: "/l/-" }],
+    [{ op: "test", path: "/a", value: 2 }],
+    [{ op: "test", path: "/a" }],
+    [{ op: "add", path: "/x" }],
+    [{ op: "move", from: "/a", path: "/a/b" }],
+    [{ op: "move", path: "/a" }],
+    [{ op: "bogus", path: "/a" }],
+    [{ path: "/a" }],
+    [{ op: "remove", path: "" }],
+    [{ op: "remove", path: "a" }],
+    [null],
+    {},
+  ];
+  for (const p of bad) assert.throws(() => applyPatch({ a: 1, l: [1] }, p), undefined, JSON.stringify(p));
+});
+
+test("test op uses structural equality", () => {
+  applyPatch({ a: { x: 1, y: [1, 2] } }, [{ op: "test", path: "/a", value: { y: [1, 2], x: 1 } }]);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]));
+});
+
+test("__proto__ is an ordinary key", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { p: 1 } }]) as any;
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+  assert.equal(({} as any).p, undefined);
+});
