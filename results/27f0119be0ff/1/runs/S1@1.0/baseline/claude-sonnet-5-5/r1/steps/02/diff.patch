index 0000000000000000000000000000000000000000..da6eb203b1c07e95f094acbe080634b1f9a27eab
--- /dev/null
+++ b/src/patch.ts
@@ -0,0 +1,128 @@
+import { parsePointer, resolvePointer } from "./pointer.ts";
+import type { JsonValue } from "./pointer.ts";
+
+const has = (object: object, key: string): boolean => Object.prototype.hasOwnProperty.call(object, key);
+
+/** Deep copy that keeps "__proto__" as an ordinary member. */
+function clone(value: unknown): JsonValue {
+  if (Array.isArray(value)) return value.map(clone);
+  if (typeof value === "object" && value !== null) {
+    const copy: Record<string, JsonValue> = {};
+    for (const key of Object.keys(value)) setMember(copy, key, clone((value as Record<string, unknown>)[key]));
+    return copy;
+  }
+  return value as JsonValue;
+}
+
+function setMember(object: object, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function equal(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => equal(item, b[i]));
+  }
+  if (typeof a === "object" && a !== null) {
+    if (typeof b !== "object" || b === null || Array.isArray(b)) return false;
+    const keysA = Object.keys(a);
+    return (
+      keysA.length === Object.keys(b).length &&
+      keysA.every((k) => has(b, k) && equal((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]))
+    );
+  }
+  return a === b;
+}
+
+/** Resolves the container of the last token of `path`, returning it with that token. */
+function locateParent(document: unknown, path: string): { parent: unknown; token: string } {
+  const tokens = parsePointer(path);
+  const token = tokens.pop() as string;
+  return { parent: resolvePointer(document, tokens.map((t) => "/" + t.replace(/~/g, "~0").replace(/\//g, "~1")).join("")), token };
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean, path: string): number {
+  if (allowEnd && token === "-") return length;
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) throw new Error(`Path "${path}": "${token}" is not a valid array index`);
+  const index = Number(token);
+  if (index > length || (index === length && !allowEnd)) throw new Error(`Path "${path}": array index ${token} is out of range`);
+  return index;
+}
+
+function add(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  if (path === "") return value;
+  const { parent, token } = locateParent(document, path);
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(token, parent.length, true, path), 0, value);
+  } else if (typeof parent === "object" && parent !== null) {
+    setMember(parent, token, value);
+  } else {
+    throw new Error(`Path "${path}": parent is not a container`);
+  }
+  return document;
+}
+
+function remove(document: JsonValue, path: string): JsonValue {
+  if (path === "") throw new Error("Cannot remove the document root");
+  const { parent, token } = locateParent(document, path);
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(token, parent.length, false, path), 1);
+  } else if (typeof parent === "object" && parent !== null && has(parent, token)) {
+    delete (parent as Record<string, unknown>)[token];
+  } else {
+    throw new Error(`Path "${path}" does not exist`);
+  }
+  return document;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the result as a new value.
+ * Neither argument is mutated. Throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): JsonValue {
+  if (!Array.isArray(patch)) throw new TypeError("A JSON Patch must be an array of operations");
+  let result = clone(document);
+  patch.forEach((op: unknown, i) => {
+    if (typeof op !== "object" || op === null || Array.isArray(op)) throw new TypeError(`Operation ${i} is not an object`);
+    const o = op as Record<string, unknown>;
+    if (typeof o.op !== "string") throw new TypeError(`Operation ${i} has no valid "op"`);
+    if (typeof o.path !== "string") throw new TypeError(`Operation ${i} has no valid "path"`);
+    const path = o.path;
+    parsePointer(path);
+    switch (o.op) {
+      case "add":
+      case "replace":
+      case "test": {
+        if (!has(o, "value") || o.value === undefined) throw new TypeError(`Operation ${i} (${o.op}) requires "value"`);
+        const value = clone(o.value);
+        if (o.op === "add") {
+          result = add(result, path, value);
+        } else if (o.op === "replace") {
+          resolvePointer(result, path);
+          result = path === "" ? value : add(remove(result, path), path, value);
+        } else if (!equal(resolvePointer(result, path), value)) {
+          throw new Error(`Test failed at "${path}"`);
+        }
+        break;
+      }
+      case "remove":
+        result = remove(result, path);
+        break;
+      case "move":
+      case "copy": {
+        if (typeof o.from !== "string") throw new TypeError(`Operation ${i} (${o.op}) requires a string "from"`);
+        const from = o.from;
+        const value = clone(resolvePointer(result, from));
+        if (o.op === "copy") {
+          result = add(result, path, value);
+        } else if (from !== path) {
+          if (path.startsWith(from + "/")) throw new Error(`Cannot move "${from}" into one of its children`);
+          result = add(remove(result, from), path, value);
+        }
+        break;
+      }
+      default:
+        throw new TypeError(`Operation ${i} has unknown op "${o.op}"`);
+    }
+  });
+  return result;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
