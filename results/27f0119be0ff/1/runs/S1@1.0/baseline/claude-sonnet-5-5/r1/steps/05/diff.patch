diff --git a/test/diff.test.ts b/test/diff.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2865fd6dcbf50d7755057aed1f711c7ae79ccf28
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,42 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown) {
+  const f = JSON.stringify(from), t = JSON.stringify(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.equal(JSON.stringify(from), f);
+  assert.equal(JSON.stringify(to), t);
+  return patch;
+}
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small change yields a small patch", () => {
+  assert.deepEqual(roundTrip({ a: { b: 1, c: [1, 2, 3] }, d: "x" }, { a: { b: 1, c: [1, 9, 3] }, d: "x" }),
+    [{ op: "replace", path: "/a/c/1", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+});
+
+test("various shapes", () => {
+  roundTrip(1, 2);
+  roundTrip({ a: 1 }, [1]);
+  roundTrip([1, 2, 3], []);
+  roundTrip([], [1, 2, 3]);
+  roundTrip([1, 2, 3, 4, 5], [5, 1]);
+  roundTrip({ a: null }, { a: false });
+  roundTrip({ "a/b": 1, "~": 2, "": 3 }, { "a/b": 2, "~x": 2, "": 4 });
+  roundTrip(JSON.parse('{"__proto__":{"x":1}}'), JSON.parse('{"__proto__":{"x":2},"y":1}'));
+  roundTrip({ a: [{ b: 1 }, { c: 2 }] }, { a: [{ b: 1, z: 0 }] });
+});
+
+test("patch does not share structure with inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to) as any;
+  patch[0].value.b = 2;
+  assert.equal(to.a.b, 1);
+});
