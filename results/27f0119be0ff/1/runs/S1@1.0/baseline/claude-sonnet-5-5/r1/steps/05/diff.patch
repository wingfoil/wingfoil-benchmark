index 0000000000000000000000000000000000000000..941091c52c03ef541cab0f3b24b8b39579b604e6
--- /dev/null
+++ b/src/diff.ts
@@ -0,0 +1,56 @@
+import { clone, equal, has } from "./patch.ts";
+import type { JsonValue } from "./pointer.ts";
+
+export type Operation =
+  | { op: "add" | "replace"; path: string; value: JsonValue }
+  | { op: "remove"; path: string };
+
+const escape = (token: string): string => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+const isObject = (v: unknown): v is Record<string, unknown> => typeof v === "object" && v !== null && !Array.isArray(v);
+
+function diff(from: unknown, to: unknown, path: string, out: Operation[]): void {
+  if (equal(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) out.push({ op: "remove", path: `${path}/${escape(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escape(key)}`;
+      if (has(from, key)) diff(from[key], to[key], child, out);
+      else out.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+  } else {
+    out.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, out: Operation[]): void {
+  // Unchanged leading and trailing elements need no operation, so an insertion or deletion
+  // in the middle of an array does not rewrite everything after it.
+  let start = 0;
+  while (start < from.length && start < to.length && equal(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && equal(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const common = Math.min(endFrom - start, endTo - start);
+  for (let i = start; i < start + common; i++) diff(from[i], to[i], `${path}/${i}`, out);
+  // Remove surplus elements from the end so earlier indices stay valid.
+  for (let i = endFrom - 1; i >= start + common; i--) out.push({ op: "remove", path: `${path}/${i}` });
+  for (let i = start + common; i < endTo; i++) out.push({ op: "add", path: `${path}/${i}`, value: clone(to[i]) });
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only
+ * the parts that differ. Neither argument is mutated, and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const out: Operation[] = [];
+  diff(from, to, "", out);
+  return out;
+}
