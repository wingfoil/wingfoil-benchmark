+---
+id: task-005-implement-createpatch-json-patch-generation-rfc-6902
+type: task
+title: "Implement createPatch JSON Patch generation RFC 6902"
+status: pending
+---
+
+<!-- task body. `wingfoil memory add` copies this scaffold verbatim; `memory submit` replaces
+     these placeholder comments with real content and fills the required frontmatter fields. -->
+
+- Added `createPatch(from, to)` to `src/index.ts`: returns a JSON Patch (RFC 6902) of `add`, `remove`
+  and `replace` operations that turns `from` into `to` through `applyPatch`.
+- Added `test/create-patch.test.ts`: empty patch for equal input, single-operation patches for small
+  changes, array insert/remove, depth diffing, type changes, pointer escaping, `__proto__`, no
+  aliasing, rejection of non-JSON input. Also checked with a throwaway 20000-case random round-trip.
diff --git a/src/index.ts b/src/index.ts
index 83733bddf5f8e1b382d9bbc5a571946e26644cd5..0e9aa475ac7fad235d78fd00434dea14ac84140a 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -282,3 +282,110 @@ export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue
   if (!isJsonValue(patch)) throw new Error("Invalid JSON Merge Patch: patch must be a JSON value");
   return mergeValues(target, patch);
 }
+
+function escapeToken(token: string): string {
+  // "~" first, then "/", the reverse of parsePointer (RFC 6901, section 4).
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function isPlainObject(value: JsonValue): value is { [key: string]: JsonValue } {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function diffObjects(
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  path: string,
+  out: PatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!hasOwn(to, key)) out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+  }
+  for (const key of Object.keys(to)) {
+    const child = `${path}/${escapeToken(key)}`;
+    if (hasOwn(from, key)) {
+      diffValues(from[key], to[key], child, out);
+    } else {
+      out.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+  }
+}
+
+/** Longest-common-subsequence lengths: `table[i][j]` is for `from.slice(i)` and `to.slice(j)`. */
+function lcsTable(from: JsonValue[], to: JsonValue[]): number[][] {
+  const table = Array.from({ length: from.length + 1 }, () => new Array<number>(to.length + 1).fill(0));
+  for (let i = from.length - 1; i >= 0; i--) {
+    for (let j = to.length - 1; j >= 0; j--) {
+      table[i][j] = jsonEqual(from[i], to[j])
+        ? table[i + 1][j + 1] + 1
+        : Math.max(table[i + 1][j], table[i][j + 1]);
+    }
+  }
+  return table;
+}
+
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, out: PatchOperation[]): void {
+  const table = lcsTable(from, to);
+  let i = 0;
+  let j = 0;
+  let index = 0; // position in the array as it stands once the operations so far are applied
+  while (i < from.length || j < to.length) {
+    if (i < from.length && j < to.length && jsonEqual(from[i], to[j])) {
+      i++;
+      j++;
+      index++;
+      continue;
+    }
+    // A run of elements only in `from`, then a run of elements only in `to`.
+    const removedStart = i;
+    while (
+      i < from.length &&
+      (j === to.length || (!jsonEqual(from[i], to[j]) && table[i + 1][j] >= table[i][j + 1]))
+    ) {
+      i++;
+    }
+    const addedStart = j;
+    while (j < to.length && (i === from.length || !jsonEqual(from[i], to[j]))) j++;
+    const removed = from.slice(removedStart, i);
+    const added = to.slice(addedStart, j);
+    const paired = Math.min(removed.length, added.length);
+    for (let k = 0; k < paired; k++) {
+      diffValues(removed[k], added[k], `${path}/${index++}`, out);
+    }
+    for (const _ of removed.slice(paired)) out.push({ op: "remove", path: `${path}/${index}` });
+    for (const value of added.slice(paired)) {
+      out.push({ op: "add", path: `${path}/${index++}`, value: clone(value) });
+    }
+  }
+}
+
+function diffValues(from: JsonValue, to: JsonValue, path: string, out: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isPlainObject(from) && isPlainObject(to)) {
+    diffObjects(from, to, path, out);
+  } else {
+    out.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when passed to `applyPatch`; neither
+ * argument is mutated, and the patch shares no structure with them.
+ *
+ * The patch is minimal in size of what it touches: equal values yield `[]`, objects are compared
+ * member by member, arrays by their longest common subsequence of equal elements, and only a
+ * value that cannot be edited in place (different types, or scalars) is replaced. The output is
+ * deterministic: removals of an object's members come first, then additions and changes in the
+ * key order of `to`.
+ *
+ * @throws Error if `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  if (!isJsonValue(from)) throw new Error("Invalid JSON Patch source: from must be a JSON value");
+  if (!isJsonValue(to)) throw new Error("Invalid JSON Patch target: to must be a JSON value");
+  const out: PatchOperation[] = [];
+  diffValues(from, to, "", out);
+  return out;
+}
