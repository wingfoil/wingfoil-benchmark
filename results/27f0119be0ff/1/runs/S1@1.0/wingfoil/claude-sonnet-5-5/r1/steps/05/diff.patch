new file mode 100644
index 0000000000000000000000000000000000000000..8afe42e653ea3f30fc66adfe64e90d481e848366
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,71 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch, type JsonValue } from "../src/index.ts";
+
+const make = (from: unknown, to: unknown) => createPatch(from as JsonValue, to as JsonValue);
+
+function roundTrip(from: JsonValue, to: JsonValue) {
+  const before = structuredClone([from, to]);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual([from, to], before);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+  assert.deepEqual(roundTrip(null, null), []);
+});
+
+test("one small change gives one small operation", () => {
+  const from = { a: { b: 1, c: [1, 2, 3] }, d: "x" };
+  assert.deepEqual(roundTrip(from, { a: { b: 1, c: [1, 9, 3] }, d: "x" }), [
+    { op: "replace", path: "/a/c/1", value: 9 },
+  ]);
+  assert.deepEqual(roundTrip(from, { a: { b: 1, c: [1, 2, 3] } }), [{ op: "remove", path: "/d" }]);
+  assert.deepEqual(roundTrip(from, { ...from, e: 1 }), [{ op: "add", path: "/e", value: 1 }]);
+});
+
+test("array insertions and removals do not rewrite the rest", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 5, 3, 4]), [{ op: "add", path: "/2", value: 5 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  roundTrip([1, 2, 3, 4, 5], [5, 1, 9, 9, 4]);
+  roundTrip([], [1, 2]);
+  roundTrip([1, 2], []);
+});
+
+test("changed elements inside arrays are diffed in depth", () => {
+  assert.deepEqual(roundTrip([{ a: 1, b: 2 }, 7], [{ a: 1, b: 3 }, 7]), [
+    { op: "replace", path: "/0/b", value: 3 },
+  ]);
+});
+
+test("type changes and the root are replaced", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip({ a: {} }, { a: [] }), [{ op: "replace", path: "/a", value: [] }]);
+  assert.deepEqual(roundTrip({ a: null }, { a: 0 }), [{ op: "replace", path: "/a", value: 0 }]);
+  roundTrip("a", { b: 1 });
+});
+
+test("member names are escaped and special names are plain keys", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "m~n": 1 }, { "a/b": 2, "m~n": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/m~0n", value: 2 },
+  ]);
+  const proto = JSON.parse('{"__proto__": 1, "toString": 2}') as JsonValue;
+  roundTrip({}, proto);
+  roundTrip(proto, {});
+});
+
+test("the patch shares no structure with the inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = make({}, to);
+  (patch[0] as { value: { b: number } }).value.b = 2;
+  assert.equal(to.a.b, 1);
+});
+
+test("non-JSON input is rejected", () => {
+  assert.throws(() => make(undefined, 1), /JSON value/);
+  assert.throws(() => make(1, { a: NaN }), /JSON value/);
+});
