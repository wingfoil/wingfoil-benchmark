@@ -0,0 +1,64 @@
+/** A parsed JSON value. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Splits a pointer into its unescaped reference tokens (RFC 6901, section 3). */
+function parsePointer(pointer: string): string[] {
+  if (pointer === "") return [];
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new Error(`Invalid JSON Pointer "${pointer}": "~" must be followed by "0" or "1"`);
+      }
+      // "~1" first, then "~0", so that "~01" yields "~1" (RFC 6901, section 4).
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/** Reads one reference token from `current`; own members only, never inherited ones. */
+function step(current: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: no array element "${token}"`);
+    }
+    return current[Number(token)];
+  }
+  if (
+    typeof current === "object" &&
+    current !== null &&
+    Object.prototype.hasOwnProperty.call(current, token)
+  ) {
+    return (current as Record<string, unknown>)[token];
+  }
+  throw new Error(`JSON Pointer "${pointer}" does not resolve: no member "${token}"`);
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer `pointer` (RFC 6901) refers to.
+ *
+ * @throws Error if `pointer` is not a valid JSON Pointer, or does not resolve to a value of
+ * `document` (missing member, out-of-range or malformed array index, the "-" token, or a
+ * token applied to a primitive).
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: must be a string");
+  }
+  let current: unknown = document;
+  for (const token of parsePointer(pointer)) {
+    current = step(current, token, pointer);
+  }
+  return current as JsonValue;
+}
