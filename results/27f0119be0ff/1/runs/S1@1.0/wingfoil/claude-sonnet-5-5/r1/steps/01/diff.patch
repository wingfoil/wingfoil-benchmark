+++ b/test/pointer.test.ts
@@ -0,0 +1,93 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// The document of RFC 6901, section 5, and its table of pointers (section 5).
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("unescapes ~01 as ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x", "~/": "y" }, "/~01"), "x");
+  assert.equal(resolvePointer({ "~/": "y" }, "/~0~1"), "y");
+});
+
+test("resolves falsy and null values", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer({ a: false }, "/a"), false);
+  assert.equal(resolvePointer([0], "/0"), 0);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("resolves nested structures", () => {
+  assert.equal(resolvePointer({ a: [{ b: [1, 2] }] }, "/a/0/b/1"), 2);
+});
+
+test("rejects syntactically invalid pointers", () => {
+  for (const p of ["foo", "a/b", "/a~", "/a~2", "/~", "/a~b"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), Error, p);
+  }
+});
+
+test("rejects non-string pointers", () => {
+  assert.throws(() => resolvePointer({}, undefined as unknown as string));
+});
+
+test("throws when a member is missing", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: "str" }, "/a/0"));
+  assert.throws(() => resolvePointer({ a: 1 }, "/"));
+});
+
+test("does not resolve inherited properties", () => {
+  for (const p of ["/__proto__", "/constructor", "/toString", "/hasOwnProperty"]) {
+    assert.throws(() => resolvePointer({}, p), Error, p);
+  }
+  assert.throws(() => resolvePointer([], "/length"));
+  assert.throws(() => resolvePointer({ a: [1] }, "/a/constructor"));
+});
+
+test("array indices", () => {
+  const arr = ["a", "b"];
+  assert.equal(resolvePointer(arr, "/1"), "b");
+  assert.throws(() => resolvePointer(arr, "/2"), Error, "out of range");
+  assert.throws(() => resolvePointer(arr, "/-"), Error, "past the end");
+  assert.throws(() => resolvePointer(arr, "/-1"));
+  assert.throws(() => resolvePointer(arr, "/01"));
+  assert.throws(() => resolvePointer(arr, "/1.0"));
+  assert.throws(() => resolvePointer(arr, "/+1"));
+  assert.throws(() => resolvePointer(arr, "/ 1"));
+  assert.throws(() => resolvePointer(arr, "/"));
+  assert.throws(() => resolvePointer(arr, "/0x1"));
+});
+
+test("'-' and numeric tokens are plain keys on objects", () => {
+  assert.equal(resolvePointer({ "-": 1, "01": 2 }, "/-"), 1);
+  assert.equal(resolvePointer({ "-": 1, "01": 2 }, "/01"), 2);
+});
