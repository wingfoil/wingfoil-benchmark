+---
+id: task-004-implement-json-merge-patch-applymergepatch-rfc-7386
+type: task
+title: "Implement JSON Merge Patch applyMergePatch RFC 7386"
+status: pending
+---
+
+## What was done
+
+- Added `applyMergePatch(target, patch)` to `src/index.ts` (RFC 7386): non-object patches replace the
+  target, object patches merge member by member, `null` members delete, arrays are replaced.
+- Added `test/merge-patch.test.ts`: the RFC appendix A cases, scalar targets, no mutation or aliasing,
+  `__proto__` and inherited names, and rejection of non-JSON input.
diff --git a/src/index.ts b/src/index.ts
index d60af5ffd3b43ebde785fcd36392f51c5127ec8f..83733bddf5f8e1b382d9bbc5a571946e26644cd5 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -250,3 +250,35 @@ export function applyPatch(document: JsonValue, patch: PatchOperation[]): JsonVa
   const operations = Array.from(patch, validateOperation);
   return operations.reduce(applyOperation, clone(document));
 }
+
+function mergeValues(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (typeof patch !== "object" || patch === null || Array.isArray(patch)) return clone(patch);
+  const result: { [key: string]: JsonValue } = {};
+  if (typeof target === "object" && target !== null && !Array.isArray(target)) {
+    for (const key of Object.keys(target)) setMember(result, key, clone(target[key]));
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, mergeValues(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies the JSON Merge Patch `patch` (RFC 7386) to `target` and returns the result as a new
+ * value; neither argument is mutated, and the result shares no structure with them.
+ *
+ * A non-object `patch` replaces `target`; an object `patch` is merged member by member, a `null`
+ * member removing that member of `target`. Arrays are replaced, never merged.
+ *
+ * @throws Error if `target` or `patch` is not a JSON value.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonValue(target)) throw new Error("Invalid JSON Merge Patch: target must be a JSON value");
+  if (!isJsonValue(patch)) throw new Error("Invalid JSON Merge Patch: patch must be a JSON value");
+  return mergeValues(target, patch);
+}
