index 0000000000000000000000000000000000000000..3039e7a60e8a823b3a43e59839340d25a61262b4
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,62 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch, type JsonValue } from "../src/index.ts";
+
+const merge = (target: unknown, patch: unknown) => applyMergePatch(target as JsonValue, patch as JsonValue);
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [JsonValue, JsonValue, JsonValue][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(merge(target, patch), expected);
+  }
+});
+
+test("scalar and non-object targets", () => {
+  assert.deepEqual(merge(1, { a: 1 }), { a: 1 });
+  assert.deepEqual(merge(null, { a: 1 }), { a: 1 });
+  assert.equal(merge({ a: 1 }, 5), 5);
+});
+
+test("does not mutate or alias its arguments", () => {
+  const target = { a: { b: 1 }, c: [1] };
+  const patch = { a: { d: [2] }, e: { f: 1 } };
+  const result = merge(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 }, c: [1] });
+  assert.deepEqual(patch, { a: { d: [2] }, e: { f: 1 } });
+  assert.notEqual(result.a.d, patch.a.d);
+  assert.notEqual(result.e, patch.e);
+  assert.notEqual(result.c, target.c);
+});
+
+test('"__proto__" and inherited names are ordinary keys', () => {
+  const result = merge({}, JSON.parse('{"__proto__": {"x": 1}}')) as any;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.equal(({} as any).x, undefined);
+  assert.deepEqual(merge({}, { toString: null }), {});
+  assert.deepEqual(merge({}, { toString: { a: 1 } }), { toString: { a: 1 } });
+});
+
+test("rejects non-JSON input", () => {
+  assert.throws(() => merge({}, undefined));
+  assert.throws(() => merge({}, { a: undefined }));
+  assert.throws(() => merge({}, { a: NaN }));
+  assert.throws(() => merge(undefined, {}));
+  assert.throws(() => merge(new Date(), {}));
+});
