+
+## What was done
+
+Added `applyPatch(document, patch)` to `src/index.ts` (RFC 6902: add, remove, replace, move, copy,
+test), built on the RFC 6901 helpers of `resolvePointer`. Tests in `test/patch.test.ts` cover each
+operation (happy and error paths), patch validation, non-mutation and prototype-key safety.
diff --git a/src/index.ts b/src/index.ts
index e4d7558b7336ca86be8b90db1d5aa4feddedad21..79c841d271d0d90009ce7965b42f738b6f22680c 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -62,3 +62,180 @@ export function resolvePointer(document: JsonValue, pointer: string): JsonValue
   }
   return current as JsonValue;
 }
+
+/** One operation of a JSON Patch document (RFC 6902, section 4). */
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; path: string; from: string };
+
+const OPERATIONS_WITH_VALUE = ["add", "replace", "test"];
+const OPERATIONS_WITH_FROM = ["move", "copy"];
+const OPERATIONS = [...OPERATIONS_WITH_VALUE, ...OPERATIONS_WITH_FROM, "remove"];
+
+type Container = JsonValue[] | { [key: string]: JsonValue };
+
+function clone(value: JsonValue): JsonValue {
+  return structuredClone(value);
+}
+
+function hasOwn(object: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(object, key);
+}
+
+function jsonEqual(a: JsonValue, b: JsonValue): boolean {
+  if (a === b) return true;
+  if (typeof a !== "object" || typeof b !== "object" || a === null || b === null) return false;
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) &&
+      Array.isArray(b) &&
+      a.length === b.length &&
+      a.every((item, i) => jsonEqual(item, b[i]))
+    );
+  }
+  const keys = Object.keys(a);
+  return (
+    keys.length === Object.keys(b).length &&
+    keys.every((key) => hasOwn(b, key) && jsonEqual(a[key], b[key]))
+  );
+}
+
+function validateOperation(operation: unknown, index: number): PatchOperation {
+  const where = `Invalid JSON Patch: operation ${index}`;
+  if (typeof operation !== "object" || operation === null || Array.isArray(operation)) {
+    throw new Error(`${where} must be an object`);
+  }
+  const fields = operation as Record<string, unknown>;
+  if (typeof fields.op !== "string" || !OPERATIONS.includes(fields.op)) {
+    throw new Error(`${where} has an unknown "op"`);
+  }
+  if (typeof fields.path !== "string") {
+    throw new Error(`${where} needs a string "path"`);
+  }
+  if (OPERATIONS_WITH_VALUE.includes(fields.op) && !hasOwn(fields, "value")) {
+    throw new Error(`${where} ("${fields.op}") needs a "value"`);
+  }
+  if (OPERATIONS_WITH_FROM.includes(fields.op) && typeof fields.from !== "string") {
+    throw new Error(`${where} ("${fields.op}") needs a string "from"`);
+  }
+  return operation as PatchOperation;
+}
+
+/** Walks to the container that holds the last token of `tokens`. */
+function parentOf(document: JsonValue, tokens: string[], pointer: string): Container {
+  let current: unknown = document;
+  for (const token of tokens.slice(0, -1)) {
+    current = step(current, token, pointer);
+  }
+  if (typeof current !== "object" || current === null) {
+    throw new Error(`JSON Pointer "${pointer}" does not resolve: parent is not a container`);
+  }
+  return current as Container;
+}
+
+function setMember(object: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  // defineProperty, so that a "__proto__" key is an own member and not a prototype assignment.
+  Object.defineProperty(object, key, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
+
+function addValue(document: JsonValue, pointer: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(document, tokens, pointer);
+  const token = tokens[tokens.length - 1];
+  if (!Array.isArray(parent)) {
+    setMember(parent, token, value);
+  } else if (token === "-") {
+    parent.push(value);
+  } else if (ARRAY_INDEX.test(token) && Number(token) <= parent.length) {
+    parent.splice(Number(token), 0, value);
+  } else {
+    throw new Error(`JSON Patch: cannot add at "${pointer}": invalid array index`);
+  }
+  return document;
+}
+
+function removeValue(document: JsonValue, pointer: string): JsonValue {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    throw new Error("JSON Patch: cannot remove the whole document");
+  }
+  resolvePointer(document, pointer);
+  const parent = parentOf(document, tokens, pointer);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(Number(token), 1);
+  } else {
+    delete parent[token];
+  }
+  return document;
+}
+
+function replaceValue(document: JsonValue, pointer: string, value: JsonValue): JsonValue {
+  if (parsePointer(pointer).length === 0) return value;
+  removeAndInsert(document, pointer, value);
+  return document;
+}
+
+function removeAndInsert(document: JsonValue, pointer: string, value: JsonValue): void {
+  const tokens = parsePointer(pointer);
+  resolvePointer(document, pointer);
+  const parent = parentOf(document, tokens, pointer);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else {
+    setMember(parent, token, value);
+  }
+}
+
+function moveValue(document: JsonValue, from: string, path: string): JsonValue {
+  const source = parsePointer(from);
+  const target = parsePointer(path);
+  if (target.length > source.length && source.every((token, i) => token === target[i])) {
+    throw new Error(`JSON Patch: cannot move "${from}" into one of its own children`);
+  }
+  const value = resolvePointer(document, from);
+  return addValue(removeValue(document, from), path, value);
+}
+
+function applyOperation(document: JsonValue, operation: PatchOperation): JsonValue {
+  switch (operation.op) {
+    case "add":
+      return addValue(document, operation.path, clone(operation.value));
+    case "remove":
+      return removeValue(document, operation.path);
+    case "replace":
+      return replaceValue(document, operation.path, clone(operation.value));
+    case "move":
+      return moveValue(document, operation.from, operation.path);
+    case "copy":
+      return addValue(document, operation.path, clone(resolvePointer(document, operation.from)));
+    case "test":
+      if (!jsonEqual(resolvePointer(document, operation.path), operation.value)) {
+        throw new Error(`JSON Patch: test failed at "${operation.path}"`);
+      }
+      return document;
+  }
+}
+
+/**
+ * Applies the JSON Patch `patch` (RFC 6902) to `document` and returns the result as a new value;
+ * neither argument is mutated, and the result shares no structure with them.
+ *
+ * @throws Error if `patch` is not a valid patch, or an operation fails (unresolvable path,
+ * invalid array index, failed "test", moving a value into its own child, removing the root).
+ */
+export function applyPatch(document: JsonValue, patch: PatchOperation[]): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: must be an array of operations");
+  }
+  const operations = patch.map(validateOperation);
+  return operations.reduce(applyOperation, clone(document));
+}
