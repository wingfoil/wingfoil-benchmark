@@ -0,0 +1,101 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, type JsonValue, type PatchOperation } from "../src/index.ts";
+
+const apply = (doc: JsonValue, patch: unknown) => applyPatch(doc, patch as PatchOperation[]);
+
+test("add: member, array insert, append, replace existing, root", () => {
+  assert.deepEqual(apply({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(apply({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(apply([1], [{ op: "add", path: "/-", value: 2 }]), [1, 2]);
+  assert.deepEqual(apply([1], [{ op: "add", path: "/1", value: 2 }]), [1, 2]);
+  assert.deepEqual(apply({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(apply({ a: 1 }, [{ op: "add", path: "", value: [] }]), []);
+});
+
+test("add: errors", () => {
+  assert.throws(() => apply({}, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.throws(() => apply([1], [{ op: "add", path: "/3", value: 1 }]));
+  assert.throws(() => apply([1], [{ op: "add", path: "/01", value: 1 }]));
+  assert.throws(() => apply({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]));
+});
+
+test("remove", () => {
+  assert.deepEqual(apply({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(apply({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+  assert.throws(() => apply({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => apply([1], [{ op: "remove", path: "/-" }]));
+  assert.throws(() => apply([1], [{ op: "remove", path: "/1" }]));
+  assert.throws(() => apply({}, [{ op: "remove", path: "/toString" }]));
+});
+
+test("replace", () => {
+  assert.deepEqual(apply({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(apply([1, 2], [{ op: "replace", path: "/1", value: 3 }]), [1, 3]);
+  assert.equal(apply({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+  assert.throws(() => apply({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => apply([1], [{ op: "replace", path: "/1", value: 1 }]));
+});
+
+test("move", () => {
+  assert.deepEqual(
+    apply({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(apply({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(apply({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.throws(() => apply({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => apply({}, [{ op: "move", from: "/a", path: "/b" }]));
+});
+
+test("copy copies deeply", () => {
+  const result = apply({ a: { b: 1 } }, [
+    { op: "copy", from: "/a", path: "/c" },
+    { op: "add", path: "/c/b", value: 2 },
+  ]) as { a: { b: number }; c: { b: number } };
+  assert.deepEqual(result, { a: { b: 1 }, c: { b: 2 } });
+  assert.throws(() => apply({}, [{ op: "copy", from: "/a", path: "/b" }]));
+});
+
+test("test", () => {
+  const doc = { a: { x: 1, y: [1, 2] }, n: null };
+  assert.deepEqual(apply(doc, [{ op: "test", path: "/a", value: { y: [1, 2], x: 1 } }]), doc);
+  assert.deepEqual(apply(doc, [{ op: "test", path: "/n", value: null }]), doc);
+  assert.throws(() => apply(doc, [{ op: "test", path: "/a/y", value: [2, 1] }]));
+  assert.throws(() => apply(doc, [{ op: "test", path: "/a/x", value: "1" }]));
+  assert.throws(() => apply(doc, [{ op: "test", path: "/zz", value: null }]));
+});
+
+test("operations apply in order and a failure throws", () => {
+  assert.deepEqual(apply({}, [{ op: "add", path: "/a", value: 1 }, { op: "replace", path: "/a", value: 2 }]), { a: 2 });
+  assert.throws(() => apply({}, [{ op: "add", path: "/a", value: 1 }, { op: "test", path: "/a", value: 2 }]));
+});
+
+test("invalid patches", () => {
+  assert.throws(() => apply({}, { op: "add" }));
+  assert.throws(() => apply({}, [null]));
+  assert.throws(() => apply({}, [[]]));
+  assert.throws(() => apply({}, [{ op: "bogus", path: "" }]));
+  assert.throws(() => apply({}, [{ op: "add", value: 1 }]));
+  assert.throws(() => apply({}, [{ op: "add", path: "/a" }]));
+  assert.throws(() => apply({}, [{ op: "move", path: "/a" }]));
+  assert.throws(() => apply({}, [{ op: "add", path: "a", value: 1 }]));
+  assert.deepEqual(apply({}, []), {});
+});
+
+test("does not mutate input or alias it", () => {
+  const doc = { a: { b: [1] } };
+  const patch = [{ op: "add", path: "/c", value: { d: 1 } }, { op: "add", path: "/a/b/-", value: 2 }];
+  const result = apply(doc, patch) as { a: unknown; c: unknown };
+  assert.deepEqual(doc, { a: { b: [1] } });
+  assert.deepEqual(patch[0].value, { d: 1 });
+  assert.notEqual(result.a, doc.a);
+  assert.notEqual(result.c, patch[0].value);
+  assert.notEqual(apply(doc, []), doc);
+});
+
+test("prototype keys are ordinary members", () => {
+  const result = apply({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]);
+  assert.deepEqual(Object.keys(result as object), ["__proto__"]);
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+});
