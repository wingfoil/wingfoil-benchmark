+function isJsonValue(value: unknown): value is JsonValue {
+  if (value === null || typeof value === "boolean" || typeof value === "string") return true;
+  if (typeof value === "number") return Number.isFinite(value);
+  if (Array.isArray(value)) return Array.from(value).every(isJsonValue);
+  return (
+    typeof value === "object" &&
+    Object.getPrototypeOf(value) === Object.prototype &&
+    Object.values(value).every(isJsonValue)
+  );
+}
+
 function validateOperation(operation: unknown, index: number): PatchOperation {
   const where = `Invalid JSON Patch: operation ${index}`;
   if (typeof operation !== "object" || operation === null || Array.isArray(operation)) {
@@ -113,8 +124,8 @@ function validateOperation(operation: unknown, index: number): PatchOperation {
   if (typeof fields.path !== "string") {
     throw new Error(`${where} needs a string "path"`);
   }
-  if (OPERATIONS_WITH_VALUE.includes(fields.op) && !hasOwn(fields, "value")) {
-    throw new Error(`${where} ("${fields.op}") needs a "value"`);
+  if (OPERATIONS_WITH_VALUE.includes(fields.op) && !isJsonValue(fields.value)) {
+    throw new Error(`${where} ("${fields.op}") needs a JSON "value"`);
   }
   if (OPERATIONS_WITH_FROM.includes(fields.op) && typeof fields.from !== "string") {
     throw new Error(`${where} ("${fields.op}") needs a string "from"`);
@@ -236,6 +247,6 @@ export function applyPatch(document: JsonValue, patch: PatchOperation[]): JsonVa
   if (!Array.isArray(patch)) {
     throw new Error("Invalid JSON Patch: must be an array of operations");
   }
-  const operations = patch.map(validateOperation);
+  const operations = Array.from(patch, validateOperation);
   return operations.reduce(applyOperation, clone(document));
 }
