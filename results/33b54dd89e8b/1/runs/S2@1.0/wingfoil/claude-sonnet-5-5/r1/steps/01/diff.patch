 export function shippingCost(goods: Cents, grams: number): Cents {
-  if (goods > FREE_SHIPPING_FROM_CENTS) return 0;
+  if (goods >= FREE_SHIPPING_FROM_CENTS) return 0;
   return parcelCost(grams);
 }
diff --git a/src/tax.ts b/src/tax.ts
