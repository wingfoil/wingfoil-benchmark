+---
+id: task-001-fix-sku-case-free-shipping-threshold-vat-rounding
+type: task
+title: "Fix SKU case, free-shipping threshold, VAT rounding"
+status: approved
+format: 1
+---
+
+## Request
+
+Three reported defects in the order service:
+
+1. Lower-case SKUs (e.g. `lb-220`) were refused as unknown: `Catalog.find` now canonicalises the SKU (trim + upper case), as the README requires.
+2. Free shipping did not apply at exactly €50.00: the threshold is now `>=` 5000 cents, as the README requires.
+3. Line VAT was rounded down (€1.99 at 22% gave €0.43): it is now rounded half up per line (`percentOf`), giving €0.44.
+
+Tests added in `test/catalog.test.ts`; `npm test` passes.
diff --git a/src/catalog.ts b/src/catalog.ts
index 0dfc92645f10374f948e9312a79dc7dca44318e5..b114b9c78623136e5ee8c9b1fc6d118c4c478c33 100644
--- a/src/catalog.ts
+++ b/src/catalog.ts
@@ -56,7 +56,7 @@ export class Catalog {
 
   /** The product with `sku`, or undefined. */
   find(sku: string): Product | undefined {
-    return this.#products.get(sku.trim());
+    return this.#products.get(canonicalSku(sku));
   }
 
   /** The product with `sku`; throws UnknownProductError when there is none. */
