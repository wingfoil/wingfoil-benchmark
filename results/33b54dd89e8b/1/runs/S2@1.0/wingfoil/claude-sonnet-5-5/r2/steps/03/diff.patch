@@ -41,4 +41,25 @@ describe('reported defects', () => {
     assert.equal(quote('2026-11-30').totals.couponDiscountCents, 100);
     assert.throws(() => quote('2026-12-01'), CouponError);
   });
+
+  it('gives a single-use coupon back when its order is cancelled', () => {
+    const { catalog, inventory, coupons, orders } = createShop();
+    catalog.add({ sku: 'NB-1', name: 'Notebook', priceCents: 500, vatClass: 'standard', weightGrams: 100 });
+    inventory.restock('NB-1', 20);
+    coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const request = { customer: 'paolo', date: '2026-06-01', lines: [{ sku: 'NB-1', quantity: 2 }], coupon: 'WELCOME' };
+    const first = orders.place(request);
+    assert.throws(() => orders.place(request), CouponError);
+    orders.cancel(first.id, '2026-06-01');
+    assert.equal(orders.place(request).totals.couponDiscountCents, 100);
+  });
+
+  it('ships free for an order whose goods come to exactly €50.00', () => {
+    const { catalog, inventory, orders } = createShop();
+    catalog.add({ sku: 'NB-1', name: 'Notebook', priceCents: 2500, vatClass: 'standard', weightGrams: 100 });
+    inventory.restock('NB-1', 20);
+    const { totals } = orders.quote({ customer: 'c-1', date: '2026-06-01', lines: [{ sku: 'NB-1', quantity: 2 }] });
+    assert.equal(totals.goodsCents, 5000);
+    assert.equal(totals.shippingCents, 0);
+  });
 });
