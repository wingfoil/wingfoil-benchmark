@@ -79,4 +79,26 @@ describe('orders', () => {
     assert.match(text, /1 × Enamel mug \(MUG-01\)\s+€10\.00/);
     assert.match(text, /Total\s+€/);
   });
+
+  it('gives a single-use coupon back when its order is cancelled', () => {
+    const s = shop();
+    s.coupons.add({ code: 'WELCOME', kind: 'fixed', value: 500, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = s.orders.place({ customer: 'paolo', date: '2026-03-02', coupon: 'welcome', lines: [{ sku: 'MUG-01', quantity: 1 }] });
+    s.orders.cancel(first.id, '2026-03-02');
+    const again = s.orders.place({ customer: 'paolo', date: '2026-03-02', coupon: 'WELCOME', lines: [{ sku: 'MUG-01', quantity: 2 }] });
+    assert.equal(again.totals.couponDiscountCents, 500);
+  });
+
+  it('ships free when the goods come to exactly 50.00 after discounts', () => {
+    const s = shop();
+    s.coupons.add({ code: 'FIVE', kind: 'fixed', value: 500, validFrom: '2026-01-01', validUntil: '2026-12-31' });
+    const plain = s.orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'TEA-7', quantity: 10 }] });
+    assert.equal(plain.totals.goodsCents, 4500);
+    const exact = s.orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 5 }] });
+    assert.equal(exact.totals.goodsCents, 5000);
+    assert.equal(exact.totals.shippingCents, 0);
+    const coupon = s.orders.place({ customer: 'c-1', date: '2026-03-02', coupon: 'FIVE', lines: [{ sku: 'MUG-01', quantity: 6 }] });
+    assert.equal(coupon.totals.goodsCents, 5500);
+    assert.equal(coupon.totals.shippingCents, 0);
+  });
 });
