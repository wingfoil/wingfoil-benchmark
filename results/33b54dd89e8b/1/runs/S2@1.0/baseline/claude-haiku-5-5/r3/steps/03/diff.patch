+
+  it('gives a single-use coupon back when its order is cancelled, so the corrected order can use it', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = orders.place({ customer: 'c-1', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'WELCOME' });
+    orders.cancel(first.id, '2026-05-05');
+    assert.equal(coupons.usedBy('WELCOME'), undefined);
+    const corrected = orders.place({ customer: 'c-1', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 2 }], coupon: 'WELCOME' });
