+
+  it('gives a single-use coupon back when its order is cancelled, so a new order can use it', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'WELCOME', kind: 'fixed', value: 500, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = orders.place({ customer: 'paolo', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 1 }], coupon: 'welcome' });
+    orders.cancel(first.id, '2026-03-02');
+    assert.equal(coupons.usedBy('WELCOME'), undefined);
+    orders.place({ customer: 'paolo', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 2 }], coupon: 'WELCOME' });
+  });
+
+  it('ships an order whose goods come to exactly €50.00 free', () => {
+    const { orders } = shop();
+    const order = orders.place({ customer: 'c-2', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 5 }] });
+    assert.equal(order.totals.goodsCents, 5000);
+    assert.equal(order.totals.shippingCents, 0);
+  });
 });
