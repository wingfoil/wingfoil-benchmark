+test('cancelling an order gives its single-use coupon back', () => {
+  const shop = createShop();
+  shop.catalog.add({ sku: 'MUG-01', name: 'Mug', priceCents: 1000, vatClass: 'standard', weightGrams: 300 });
+  shop.inventory.restock('MUG-01', 10);
+  shop.coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+  const first = shop.orders.place({ customer: 'paolo', date: '2026-03-02', coupon: 'welcome', lines: [{ sku: 'MUG-01', quantity: 1 }] });
+  shop.orders.cancel(first.id, '2026-03-02');
+  const second = shop.orders.place({ customer: 'paolo', date: '2026-03-02', coupon: 'WELCOME', lines: [{ sku: 'MUG-01', quantity: 1 }] });
+  assert.equal(second.coupon, 'WELCOME');
+});
