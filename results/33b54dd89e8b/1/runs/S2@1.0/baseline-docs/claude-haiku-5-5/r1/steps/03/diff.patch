+
+  it('gives a single-use coupon back when its order is cancelled, so a corrected order can use it', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const wrong = orders.place({ customer: 'c-1', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'WELCOME' });
+    orders.cancel(wrong.id, '2026-05-05');
+    assert.equal(coupons.usedBy('WELCOME'), undefined);
+    const corrected = orders.place({ customer: 'c-1', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 2 }], coupon: 'WELCOME' });
+    assert.equal(corrected.totals.couponDiscountCents, 400);
+    assert.equal(coupons.usedBy('WELCOME'), corrected.id);
+  });
 });
