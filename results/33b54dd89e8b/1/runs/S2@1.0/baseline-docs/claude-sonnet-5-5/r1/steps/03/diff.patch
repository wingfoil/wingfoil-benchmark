+describe('single-use coupons and cancellation', () => {
+  it('gives a single-use coupon back when its order is cancelled', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'WELCOME', kind: 'fixed', value: 100, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = orders.place({ customer: 'paolo', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'WELCOME' });
+    orders.cancel(first.id, '2026-05-05');
+    assert.equal(coupons.usedBy('WELCOME'), undefined);
+    const second = orders.place({ customer: 'paolo', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'WELCOME' });
+    assert.equal(coupons.usedBy('WELCOME'), second.id);
+  });
+});
