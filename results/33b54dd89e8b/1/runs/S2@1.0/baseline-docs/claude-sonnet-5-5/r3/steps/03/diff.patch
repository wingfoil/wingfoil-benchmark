+
+  it('gives a single-use coupon back when its order is cancelled', () => {
+    const { catalog, inventory, orders, coupons } = createShop();
+    catalog.add({ sku: 'NB-1', name: 'Notebook', priceCents: 500, vatClass: 'standard', weightGrams: 100 });
+    inventory.restock('NB-1', 20);
+    coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const request = { customer: 'paolo', date: '2026-06-01', lines: [{ sku: 'NB-1', quantity: 1 }], coupon: 'WELCOME' };
+    const first = orders.place(request);
+    assert.throws(() => orders.place(request), CouponError);
+    orders.cancel(first.id, '2026-06-01');
+    assert.equal(orders.place(request).totals.couponDiscountCents, 50);
+  });
+
+  it('ships an order free when its goods after discounts come to exactly €50.00', () => {
+    const { catalog, inventory, orders } = createShop();
+    catalog.add({ sku: 'NB-1', name: 'Notebook', priceCents: 2500, vatClass: 'standard', weightGrams: 100 });
+    inventory.restock('NB-1', 20);
+    const quote = orders.quote({ customer: 'c-1', date: '2026-06-01', lines: [{ sku: 'NB-1', quantity: 2 }] });
+    assert.equal(quote.totals.goodsCents, 5000);
+    assert.equal(quote.totals.shippingCents, 0);
+  });
