diff --git a/test/patch.test.ts b/test/patch.test.ts
index a5c23d21bc6265976a176792d8beb5b4a624d108..35508113d072083849b741ccc9a275ec6999207f 100644
--- a/test/patch.test.ts
+++ b/test/patch.test.ts
@@ -31,3 +31,19 @@ test("errors", () => {
   const r = applyPatch({}, [{ op: "add", path: "/__proto__", value: 1 }]);
   assert.equal(Object.getPrototypeOf(r), Object.prototype);
 });
+
+test("RFC 6902 edge cases", () => {
+  // add on an existing array index inserts; move into an array end; move to own descendant fails
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/0", value: 2 }]), [2, 1]);
+  assert.deepEqual(applyPatch({ a: [1], b: 2 }, [{ op: "move", from: "/b", path: "/a/-" }]), { a: [1, 2] });
+  assert.deepEqual(applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a/b", path: "/a" }]), { a: 1 });
+  // replace requires an existing target, and "-" is never an existing element
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/-", value: 2 }]));
+  // test compares objects regardless of member order, and types strictly
+  assert.deepEqual(applyPatch({ a: { x: 1, y: 2 } }, [{ op: "test", path: "/a", value: { y: 2, x: 1 } }]), { a: { x: 1, y: 2 } });
+  assert.throws(() => applyPatch({ a: "1" }, [{ op: "test", path: "/a", value: 1 }]));
+  // a failing patch leaves the input untouched
+  const d = { a: [1, 2] };
+  assert.throws(() => applyPatch(d, [{ op: "remove", path: "/a/0" }, { op: "test", path: "/a", value: [] }]));
+  assert.deepEqual(d, { a: [1, 2] });
+});
