index af39f320738eefd7a4a19624d3e45f0a2c30fe63..8bfe83d26e301e85fdcae692c69074724cf9aac0 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -230,3 +230,21 @@ export function applyPatch(document: unknown, patch: readonly PatchOperation[]):
   }
   return result;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to `target` and returns the result as a new value.
+ * Neither argument is mutated. A non-object patch replaces the target; `null` members delete.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): any {
+  if (!isObject(patch)) return clone(patch);
+  const result: Record<string, unknown> = isObject(target) ? clone(target) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(Object.hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e53ca700cc401df00f73bbf2be527ccccdea34da
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,36 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 example", () => {
+  const target = { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["example", "sample"], content: "x" };
+  const patch = { title: "Hello!", phoneNumber: "+01-123-456-7890", author: { familyName: null }, tags: ["example"] };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!", author: { givenName: "John" }, tags: ["example"], content: "x", phoneNumber: "+01-123-456-7890",
+  });
+  assert.equal(target.author.familyName, "Doe");
+});
+
+test("RFC 7386 appendix cases", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: "c" }), { a: "c" });
+  assert.deepEqual(applyMergePatch({ a: "b" }, { b: "c" }), { a: "b", b: "c" });
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: null }), {});
+  assert.deepEqual(applyMergePatch({ a: "b", b: "c" }, { a: null }), { b: "c" });
+  assert.deepEqual(applyMergePatch({ a: ["b"] }, { a: "c" }), { a: "c" });
+  assert.deepEqual(applyMergePatch({ a: "c" }, { a: ["b"] }), { a: ["b"] });
+  assert.deepEqual(applyMergePatch({ a: { b: "c" } }, { a: { b: "d", c: null } }), { a: { b: "d" } });
+  assert.deepEqual(applyMergePatch({ a: [{ b: "c" }] }, { a: [1] }), { a: [1] });
+  assert.deepEqual(applyMergePatch(["a", "b"], ["c", "d"]), ["c", "d"]);
+  assert.deepEqual(applyMergePatch({ a: "b" }, ["c"]), ["c"]);
+  assert.equal(applyMergePatch({ a: "foo" }, null), null);
+  assert.equal(applyMergePatch({ a: "foo" }, "bar"), "bar");
+  assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+  assert.deepEqual(applyMergePatch([1, 2], { a: "b", c: null }), { a: "b" });
+  assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+});
+
+test("__proto__ is plain data", () => {
+  const out = applyMergePatch({}, JSON.parse('{"__proto__": {"x": 1}}'));
+  assert.equal(({} as any).x, undefined);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+});
