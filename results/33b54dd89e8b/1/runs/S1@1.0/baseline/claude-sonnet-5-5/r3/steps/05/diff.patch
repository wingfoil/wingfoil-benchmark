index 0000000000000000000000000000000000000000..69b57d8808465d086072feaf87e25fb64fd43d78
--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,19 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+test("createPatch yields minimal patches that round-trip", () => {
+  const from = { a: [1, 2, 3, 4], b: { c: 1, "x/y": 1 }, d: "k" };
+  const to = { a: [1, 3, 4, 5], b: { c: 1, "x/y": 2 }, d: "k" };
+  const snapshot = structuredClone(from);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, snapshot);
+  assert.equal(patch.length, 3);
+  assert.deepEqual(createPatch(from, snapshot), []);
+});
+
+test("createPatch handles root and type changes", () => {
+  assert.deepEqual(applyPatch(1, createPatch(1, { a: 1 })), { a: 1 });
+  assert.deepEqual(applyPatch([1], createPatch([1], { a: 1 })), { a: 1 });
+});
