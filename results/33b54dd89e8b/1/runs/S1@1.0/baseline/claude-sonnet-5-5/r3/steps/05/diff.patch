index 8bfe83d26e301e85fdcae692c69074724cf9aac0..c9b10c90949a1422603ee19410a3eb4cfdac38ba 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -248,3 +248,101 @@ export function applyMergePatch(target: unknown, patch: unknown): any {
   }
   return result;
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+// Above this many cells the quadratic alignment of two arrays is skipped (only the common
+// head and tail are kept, the middle is compared position by position).
+const MAX_ALIGNMENT_CELLS = 4_000_000;
+
+function diffArrays(from: unknown[], to: unknown[], path: string, out: PatchOperation[]): void {
+  let head = 0;
+  while (head < from.length && head < to.length && jsonEqual(from[head], to[head])) head++;
+  let tail = 0;
+  while (
+    tail < from.length - head &&
+    tail < to.length - head &&
+    jsonEqual(from[from.length - 1 - tail], to[to.length - 1 - tail])
+  ) {
+    tail++;
+  }
+  const a = from.slice(head, from.length - tail);
+  const b = to.slice(head, to.length - tail);
+
+  // pairs[k] = [index in a, index in b] of the k-th element kept by the alignment.
+  const pairs: Array<[number, number]> = [];
+  if (a.length > 0 && b.length > 0 && a.length * b.length <= MAX_ALIGNMENT_CELLS) {
+    const width = b.length + 1;
+    const lcs = new Uint32Array((a.length + 1) * width);
+    for (let i = a.length - 1; i >= 0; i--) {
+      for (let j = b.length - 1; j >= 0; j--) {
+        lcs[i * width + j] = jsonEqual(a[i], b[j])
+          ? lcs[(i + 1) * width + j + 1] + 1
+          : Math.max(lcs[(i + 1) * width + j], lcs[i * width + j + 1]);
+      }
+    }
+    let i = 0;
+    let j = 0;
+    while (i < a.length && j < b.length) {
+      if (jsonEqual(a[i], b[j])) {
+        pairs.push([i++, j++]);
+      } else if (lcs[(i + 1) * width + j] >= lcs[i * width + j + 1]) {
+        i++;
+      } else {
+        j++;
+      }
+    }
+  }
+  pairs.push([a.length, b.length]); // sentinel
+
+  // `position` is the index in the array being patched, which already matches `to` before it.
+  let position = head;
+  let i = 0;
+  let j = 0;
+  for (const [pi, pj] of pairs) {
+    const removed = pi - i;
+    const added = pj - j;
+    const common = Math.min(removed, added);
+    for (let k = 0; k < common; k++) {
+      diffValues(a[i + k], b[j + k], `${path}/${position + k}`, out);
+    }
+    for (let k = common; k < removed; k++) {
+      out.push({ op: "remove", path: `${path}/${position + common}` });
+    }
+    for (let k = common; k < added; k++) {
+      out.push({ op: "add", path: `${path}/${position + k}`, value: clone(b[j + k]) as JsonValue });
+    }
+    position += added + 1; // the added/replaced elements, plus the kept one
+    i = pi + 1;
+    j = pj + 1;
+  }
+}
+
+function diffValues(from: unknown, to: unknown, path: string, out: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(from, key)) diffValues(from[key], to[key], child, out);
+      else out.push({ op: "add", path: child, value: clone(to[key]) as JsonValue });
+    }
+  } else if (!jsonEqual(from, to)) {
+    out.push({ op: "replace", path, value: clone(to) as JsonValue });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied, containing only the
+ * changes between them. Neither argument is mutated, and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diffValues(from, to, "", out);
+  return out;
+}
diff --git a/test/createpatch.test.ts b/test/createpatch.test.ts
