+  assert.throws(() => applyPatch({}, patch), SyntaxError);
+  const missingValue = [{ op: "test", path: "/missing" }, { op: "test", path: "" }];
+  assert.throws(() => applyPatch({}, missingValue as never), SyntaxError);
+});
+
+test("move from the whole document onto itself is a no-op", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "", path: "" }]), { a: 1 });
