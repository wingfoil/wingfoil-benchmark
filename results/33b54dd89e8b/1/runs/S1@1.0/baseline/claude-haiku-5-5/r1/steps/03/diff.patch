 test("the whole document cannot be removed", () => {
   assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]), Error);
 });
+
+test("rejects a value that is not a JSON value", () => {
+  const cyclic: Record<string, unknown> = {};
+  cyclic.self = cyclic;
+  const values = [undefined, NaN, Infinity, () => 1, 1n, Symbol("s"), new Date(0), [undefined], { a: undefined }];
+  values.push(cyclic);
+  for (const value of values) {
+    assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value } as never]), SyntaxError);
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value } as never]), SyntaxError);
+  }
+});
+
+test("accepts every JSON value", () => {
+  const value = { n: null, t: true, s: "", i: -1.5e3, a: [[], {}] };
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a", value }]), { a: value });
+});
