index 0000000000000000000000000000000000000000..c6042caef5693d13924626438352d32449b0472c
--- /dev/null
+++ b/test/apply-merge-patch.test.ts
@@ -0,0 +1,44 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyMergePatch } from '../src/index.ts';
+
+// Examples from RFC 7386, appendix A.
+test('applies the RFC 7386 examples', () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: 'b' }, { a: 'c' }, { a: 'c' }],
+    [{ a: 'b' }, { b: 'c' }, { a: 'b', b: 'c' }],
+    [{ a: 'b' }, { a: null }, {}],
+    [{ a: 'b', b: 'c' }, { a: null }, { b: 'c' }],
+    [{ a: ['b'] }, { a: 'c' }, { a: 'c' }],
+    [{ a: 'c' }, { a: ['b'] }, { a: ['b'] }],
+    [{ a: { b: 'c' } }, { a: { b: 'd', c: null } }, { a: { b: 'd' } }],
+    [{ a: [{ b: 'c' }] }, { a: [1] }, { a: [1] }],
+    [['a', 'b'], ['c', 'd'], ['c', 'd']],
+    [{ a: 'b' }, ['c'], ['c']],
+    [{ a: 'foo' }, null, null],
+    [{ a: 'foo' }, 'bar', 'bar'],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: 'b', c: null }, { a: 'b' }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test('does not modify the target or the patch', () => {
+  const target = { a: { b: 1 } };
+  const patch = { a: { c: [1] } };
+  const result = applyMergePatch(target, patch) as { a: { c: number[] } };
+  assert.deepEqual(target, { a: { b: 1 } });
+  assert.deepEqual(patch, { a: { c: [1] } });
+  result.a.c.push(2);
+  assert.deepEqual(patch, { a: { c: [1] } });
+});
+
+test('treats a "__proto__" member as an ordinary member', () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}}');
+  const result = applyMergePatch({}, patch) as Record<string, unknown>;
+  assert.equal(Object.hasOwn(result, '__proto__'), true);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
