+
+/**
+ * JSON Merge Patch (RFC 7386): a compact way to describe a partial update of a JSON document.
+ */
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Merges `patch` into `target`, in place where `target` is an object. Members of `patch` that are `null`
+ * remove the member; other members are merged recursively. A non-object patch replaces the target.
+ */
+function merge(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return patch;
+  }
+  const result: Record<string, unknown> = isObject(target) ? target : {};
+  for (const name of Object.keys(patch)) {
+    const value = patch[name];
+    if (value === null) {
+      Reflect.deleteProperty(result, name);
+    } else {
+      // defineProperty rather than assignment, so that a member named "__proto__" is an ordinary member.
+      const current = Object.hasOwn(result, name) ? result[name] : undefined;
+      Object.defineProperty(result, name, {
+        value: merge(current, value),
+        writable: true,
+        enumerable: true,
+        configurable: true,
+      });
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies `patch` (RFC 7386) to `target` and returns the merged document.
+ *
+ * `target` and the values of `patch` are never modified, and the result shares no objects with them.
+ * A patch that is not an object replaces the whole document; a `null` member of a patch removes the
+ * member from the target.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return merge(structuredClone(target), structuredClone(patch));
+}
diff --git a/test/apply-merge-patch.test.ts b/test/apply-merge-patch.test.ts
