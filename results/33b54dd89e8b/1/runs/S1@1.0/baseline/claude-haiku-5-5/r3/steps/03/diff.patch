diff --git a/test/apply-patch.test.ts b/test/apply-patch.test.ts
index a588e6c1959b075bafa3d5f008966b4ebffac47d..78ebcf85a705ac81e67b91a8e1b542a8a25e68aa 100644
--- a/test/apply-patch.test.ts
+++ b/test/apply-patch.test.ts
@@ -177,3 +177,56 @@ test('rejects patches that are not arrays of valid operations', () => {
     assert.throws(() => applyPatch({}, patch as never), JsonPatchError, JSON.stringify(patch));
   }
 });
+
+test('a sparse patch is rejected with a JsonPatchError', () => {
+  const sparse = [, { op: 'add', path: '/a', value: 1 }] as never;
+  assert.throws(() => applyPatch({}, sparse), JsonPatchError);
+});
+
+test('values must be JSON values', () => {
+  class Point {
+    x = 1;
+  }
+  const cyclic: Record<string, unknown> = {};
+  cyclic.self = cyclic;
+  const invalid: unknown[] = [
+    undefined,
+    NaN,
+    Infinity,
+    -Infinity,
+    1n,
+    new Date(0),
+    new Map(),
+    new Point(),
+    [, 1],
+    { a: undefined },
+    cyclic,
+  ];
+  for (const value of invalid) {
+    for (const patch of [
+      [{ op: 'add', path: '/a', value }],
+      [{ op: 'replace', path: '/a', value }],
+      [{ op: 'test', path: '/a', value }],
+    ]) {
+      assert.throws(() => applyPatch({ a: 0 }, patch as never), JsonPatchError, String(value));
+    }
+  }
+});
+
+test('JSON values of every kind are accepted', () => {
+  const value = { n: null, b: false, s: '', i: -1.5, a: [{}, []] };
+  assert.deepEqual(applyPatch({}, [{ op: 'add', path: '/v', value }]), { v: value });
+  assert.doesNotThrow(() => applyPatch({}, [{ op: 'add', path: '/v', value: Object.create(null) }]));
+  assert.doesNotThrow(() => applyPatch({ a: null }, [{ op: 'test', path: '/a', value: null }]));
+});
+
+test('only own members of an operation count', () => {
+  const inherited = Object.create({ op: 'add', path: '/a', value: 1 });
+  assert.throws(() => applyPatch({}, [inherited]), JsonPatchError);
+  const inheritedValue = Object.assign(Object.create({ value: 1 }), { op: 'add', path: '/a' });
+  assert.throws(() => applyPatch({}, [inheritedValue]), JsonPatchError);
+});
+
+test('a document that cannot be copied fails with a JsonPatchError', () => {
+  assert.throws(() => applyPatch({ f: () => 1 }, []), JsonPatchError);
+});
