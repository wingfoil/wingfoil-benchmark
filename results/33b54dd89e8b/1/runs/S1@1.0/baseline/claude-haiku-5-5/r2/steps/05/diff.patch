diff --git a/src/index.ts b/src/index.ts
index 2afafc8e9a27c007899f0c771e8bd2d01ff144fa..9f8787609b43140eea4efdf69a93011905ed38bf 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -311,6 +311,163 @@ function isObject(value: unknown): value is Record<string, unknown> {
   return value !== null && typeof value === "object" && !Array.isArray(value);
 }
 
+/** Above this many cells, the array alignment table is not built and elements are paired by position. */
+const MAX_ALIGNMENT_CELLS = 1_000_000;
+
+/**
+ * Creates a JSON Patch that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch describes only what changed: equal parts of the documents produce no operations, object
+ * members are compared by name, and array elements are aligned so that an inserted or removed element
+ * does not make the elements after it look changed. Neither input is mutated. Throws a `SyntaxError`
+ * when either input is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new SyntaxError("createPatch requires JSON values");
+  }
+  const operations: PatchOperation[] = [];
+  diffValue("", from, to, operations);
+  return operations;
+}
+
+/** Appends the operations that turn `from` into `to` at `path`. */
+function diffValue(path: string, from: unknown, to: unknown, operations: PatchOperation[]): void {
+  if (canonicalJson(from) === canonicalJson(to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(path, from, to, operations);
+  } else if (isObject(from) && isObject(to)) {
+    diffObject(path, from, to, operations);
+  } else {
+    operations.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+function diffObject(path: string, from: Record<string, unknown>, to: Record<string, unknown>, operations: PatchOperation[]): void {
+  for (const key of Object.keys(from)) {
+    const childPath = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(to, key)) {
+      diffValue(childPath, from[key], to[key], operations);
+    } else {
+      operations.push({ op: "remove", path: childPath });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (!Object.hasOwn(from, key)) {
+      operations.push({ op: "add", path: `${path}/${escapeToken(key)}`, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+/**
+ * Diffs two arrays. Elements common to both are aligned with a longest common subsequence, and the
+ * elements between two aligned ones are paired by position, so each pair is diffed in place and only
+ * the surplus elements are inserted or removed. Operations are emitted in order, and each one's index
+ * is the index in the array as the earlier operations have left it.
+ */
+function diffArray(path: string, from: unknown[], to: unknown[], operations: PatchOperation[]): void {
+  const fromKeys = from.map(canonicalJson);
+  const toKeys = to.map(canonicalJson);
+
+  // Equal elements at both ends are left alone; only the middle needs aligning.
+  let prefix = 0;
+  while (prefix < from.length && prefix < to.length && fromKeys[prefix] === toKeys[prefix]) {
+    prefix++;
+  }
+  let suffix = 0;
+  while (suffix < from.length - prefix && suffix < to.length - prefix && fromKeys[from.length - 1 - suffix] === toKeys[to.length - 1 - suffix]) {
+    suffix++;
+  }
+  const fromEnd = from.length - suffix;
+  const toEnd = to.length - suffix;
+  const anchors = alignElements(fromKeys.slice(prefix, fromEnd), toKeys.slice(prefix, toEnd));
+
+  let position = prefix;
+  let fromStart = prefix;
+  let toStart = prefix;
+  for (const [fromOffset, toOffset] of [...anchors, [fromEnd - prefix, toEnd - prefix]]) {
+    const fromGap = from.slice(fromStart, prefix + fromOffset);
+    const toGap = to.slice(toStart, prefix + toOffset);
+    const paired = Math.min(fromGap.length, toGap.length);
+
+    for (let index = 0; index < paired; index++) {
+      diffValue(`${path}/${position + index}`, fromGap[index], toGap[index], operations);
+    }
+    // Once the paired elements are handled, the next surplus element of the old gap sits at position + paired.
+    for (let index = paired; index < fromGap.length; index++) {
+      operations.push({ op: "remove", path: `${path}/${position + paired}` });
+    }
+    for (let index = paired; index < toGap.length; index++) {
+      operations.push({ op: "add", path: `${path}/${position + index}`, value: structuredClone(toGap[index]) });
+    }
+
+    // The aligned element after this gap is unchanged, so it is skipped.
+    position += toGap.length + 1;
+    fromStart = prefix + fromOffset + 1;
+    toStart = prefix + toOffset + 1;
+  }
+}
+
+/**
+ * Returns the pairs of positions, one in each sequence, of a longest common subsequence of equal keys,
+ * as offsets into the two sequences. Falls back to no pairs when the table would be too large.
+ */
+function alignElements(fromKeys: string[], toKeys: string[]): [number, number][] {
+  const rows = fromKeys.length + 1;
+  const columns = toKeys.length + 1;
+  if (rows * columns > MAX_ALIGNMENT_CELLS) {
+    return [];
+  }
+
+  // lengths[i * columns + j] is the length of the longest common subsequence of the suffixes from i and j.
+  const lengths = new Uint32Array(rows * columns);
+  for (let i = fromKeys.length - 1; i >= 0; i--) {
+    for (let j = toKeys.length - 1; j >= 0; j--) {
+      lengths[i * columns + j] =
+        fromKeys[i] === toKeys[j]
+          ? lengths[(i + 1) * columns + j + 1] + 1
+          : Math.max(lengths[(i + 1) * columns + j], lengths[i * columns + j + 1]);
+    }
+  }
+
+  const pairs: [number, number][] = [];
+  let i = 0;
+  let j = 0;
+  while (i < fromKeys.length && j < toKeys.length) {
+    if (fromKeys[i] === toKeys[j]) {
+      pairs.push([i, j]);
+      i++;
+      j++;
+    } else if (lengths[(i + 1) * columns + j] >= lengths[i * columns + j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
+
+/** Escapes a member name for use as a JSON Pointer reference token (RFC 6901). */
+function escapeToken(key: string): string {
+  return key.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Serializes a JSON value with object members in sorted order, so equal values give equal strings. */
+function canonicalJson(value: unknown): string {
+  if (Array.isArray(value)) {
+    return `[${value.map(canonicalJson).join(",")}]`;
+  }
+  if (isObject(value)) {
+    const members = Object.keys(value)
+      .sort()
+      .map((key) => `${JSON.stringify(key)}:${canonicalJson(value[key])}`);
+    return `{${members.join(",")}}`;
+  }
+  return JSON.stringify(value);
+}
+
 /**
  * JSON Merge Patch (RFC 7386): a partial JSON document that describes changes to another document.
  */
diff --git a/test/create-patch.test.js b/test/create-patch.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..12beaa7326a2d0b2f5fcd2c5000ac8b7d073b4f5
--- /dev/null
+++ b/test/create-patch.test.js
@@ -0,0 +1,153 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(createPatch({ a: [1, { b: null }] }, { a: [1, { b: null }] }), []);
+  assert.deepEqual(createPatch("x", "x"), []);
+  assert.deepEqual(createPatch([], []), []);
+});
+
+test("a changed member gives one replace, not the whole document", () => {
+  const from = { name: "a", big: { items: [1, 2, 3], nested: { deep: true } }, count: 1 };
+  const to = { name: "a", big: { items: [1, 2, 3], nested: { deep: true } }, count: 2 };
+  assert.deepEqual(createPatch(from, to), [{ op: "replace", path: "/count", value: 2 }]);
+});
+
+test("added and removed members", () => {
+  assert.deepEqual(createPatch({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("member order does not count as a change", () => {
+  assert.deepEqual(createPatch({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+});
+
+test("a changed array element is diffed in place", () => {
+  const from = { list: [{ id: 1, done: false }, { id: 2, done: false }] };
+  const to = { list: [{ id: 1, done: false }, { id: 2, done: true }] };
+  assert.deepEqual(createPatch(from, to), [{ op: "replace", path: "/list/1/done", value: true }]);
+});
+
+test("an element inserted in the middle of an array is a single add", () => {
+  const from = { list: ["a", "b", "c", "d", "e", "f", "g"] };
+  const to = { list: ["a", "b", "c", "x", "d", "e", "f", "g"] };
+  assert.deepEqual(createPatch(from, to), [{ op: "add", path: "/list/3", value: "x" }]);
+});
+
+test("an element removed from the middle of an array is a single remove", () => {
+  const from = { list: ["a", "b", "c", "d"] };
+  const to = { list: ["a", "c", "d"] };
+  assert.deepEqual(createPatch(from, to), [{ op: "remove", path: "/list/1" }]);
+});
+
+test("appended and truncated array elements", () => {
+  assert.deepEqual(createPatch([1, 2], [1, 2, 3, 4]), [
+    { op: "add", path: "/2", value: 3 },
+    { op: "add", path: "/3", value: 4 },
+  ]);
+  assert.deepEqual(createPatch([1, 2, 3], [1]), [
+    { op: "remove", path: "/1" },
+    { op: "remove", path: "/1" },
+  ]);
+});
+
+test("a change in the type of the root is a replace of the whole document", () => {
+  assert.deepEqual(createPatch({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(createPatch(null, { a: 1 }), [{ op: "replace", path: "", value: { a: 1 } }]);
+});
+
+test("member names are escaped as JSON Pointer tokens", () => {
+  assert.deepEqual(createPatch({ "a/b": 1, "c~d": 1 }, { "a/b": 2, "c~d": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/c~0d", value: 2 },
+  ]);
+});
+
+test("a member named __proto__ is treated as an ordinary member", () => {
+  const from = JSON.parse('{"__proto__": {"a": 1}}');
+  const to = JSON.parse('{"__proto__": {"a": 2}}');
+  assert.deepEqual(createPatch(from, to), [{ op: "replace", path: "/__proto__/a", value: 2 }]);
+});
+
+test("neither input is mutated, and the values in the patch are copies", () => {
+  const from = { list: [1, { a: 1 }], obj: { x: [1] } };
+  const to = { list: [1, { a: 2 }, 3], obj: { x: [1, 2] }, extra: { y: 1 } };
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+
+  patch.forEach((operation) => {
+    if ("value" in operation && typeof operation.value === "object") {
+      assert.notEqual(operation.value, to.extra);
+    }
+  });
+});
+
+test("rejects values that are not JSON", () => {
+  assert.throws(() => createPatch({ a: undefined }, {}), SyntaxError);
+  assert.throws(() => createPatch({}, { a: () => 1 }), SyntaxError);
+  assert.throws(() => createPatch({}, [NaN]), SyntaxError);
+});
+
+test("applying the patch gives the target for many random document pairs", () => {
+  let seed = 12345;
+  const random = () => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed / 0x7fffffff;
+  };
+  const pick = (items) => items[Math.floor(random() * items.length)];
+
+  const randomValue = (depth) => {
+    const kind = depth > 2 ? pick(["number", "string", "null"]) : pick(["number", "string", "null", "array", "object"]);
+    if (kind === "number") return Math.floor(random() * 4);
+    if (kind === "string") return pick(["a", "b", "c", "d"]);
+    if (kind === "null") return null;
+    if (kind === "array") return Array.from({ length: Math.floor(random() * 6) }, () => randomValue(depth + 1));
+    const object = {};
+    for (const key of ["a", "b", "c", "d"]) {
+      if (random() < 0.5) object[key] = randomValue(depth + 1);
+    }
+    return object;
+  };
+
+  // Mutates a copy of a document in a few random places, which gives a related target.
+  const mutate = (value, depth) => {
+    if (random() < 0.2) return randomValue(depth);
+    if (Array.isArray(value)) {
+      const copy = value.map((item) => mutate(item, depth + 1));
+      if (random() < 0.3) copy.splice(Math.floor(random() * (copy.length + 1)), 0, randomValue(depth + 1));
+      if (random() < 0.3 && copy.length > 0) copy.splice(Math.floor(random() * copy.length), 1);
+      return copy;
+    }
+    if (value !== null && typeof value === "object") {
+      const copy = {};
+      for (const key of Object.keys(value)) {
+        if (random() < 0.1) continue;
+        copy[key] = mutate(value[key], depth + 1);
+      }
+      if (random() < 0.3) copy[pick(["a", "b", "c", "d"])] = randomValue(depth + 1);
+      return copy;
+    }
+    return value;
+  };
+
+  for (let run = 0; run < 500; run++) {
+    const from = randomValue(0);
+    const to = mutate(from, 0);
+    const patch = createPatch(from, to);
+    assert.deepEqual(applyPatch(from, patch), to, JSON.stringify({ from, to, patch }));
+  }
+});
+
+test("a large array with one change is still patched by its change alone", () => {
+  const from = { list: Array.from({ length: 3000 }, (_, index) => ({ index })) };
+  const to = structuredClone(from);
+  to.list[1500].index = -1;
+  assert.deepEqual(createPatch(from, to), [{ op: "replace", path: "/list/1500/index", value: -1 }]);
+});
