+
+/**
+ * JSON Patch (RFC 6902): a sequence of operations that changes a JSON document.
+ */
+
+/** One operation of a JSON Patch. */
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; from: string; path: string };
+
+const OPERATIONS: ReadonlySet<string> = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+
+/**
+ * Applies a JSON Patch to a JSON document and returns the resulting document.
+ *
+ * The operations run in order on a copy, so the input document is never mutated. Throws a
+ * `SyntaxError` when the patch is malformed, and an `Error` when an operation cannot be applied,
+ * such as a `test` whose value differs or a `remove` of a location that does not exist.
+ */
+export function applyPatch(document: unknown, patch: readonly PatchOperation[]): unknown {
+  if (!Array.isArray(patch)) {
+    throw new SyntaxError("JSON Patch must be an array of operations");
+  }
+
+  let result = structuredClone(document);
+  for (const operation of patch) {
+    result = applyOperation(result, validateOperation(operation));
+  }
+  return result;
+}
+
+/** Checks the shape of one operation, which may come from untyped input. */
+function validateOperation(operation: unknown): PatchOperation {
+  if (!isObject(operation)) {
+    throw new SyntaxError("JSON Patch operation must be an object");
+  }
+  const { op, path, from } = operation;
+  if (typeof op !== "string" || !OPERATIONS.has(op)) {
+    throw new SyntaxError(`Invalid JSON Patch operation ${JSON.stringify(op)}`);
+  }
+  if (typeof path !== "string") {
+    throw new SyntaxError(`JSON Patch operation ${op} must have a string "path"`);
+  }
+
+  switch (op) {
+    case "add":
+    case "replace":
+    case "test":
+      // "value" may be any JSON value, including null, so only its presence is checked.
+      if (!Object.hasOwn(operation, "value")) {
+        throw new SyntaxError(`JSON Patch operation ${op} must have a "value"`);
+      }
+      return { op, path, value: operation.value };
+    case "remove":
+      return { op, path };
+    default:
+      // "move" and "copy"
+      if (typeof from !== "string") {
+        throw new SyntaxError(`JSON Patch operation ${op} must have a string "from"`);
+      }
+      return { op: op as "move" | "copy", from, path };
+  }
+}
+
+function applyOperation(root: unknown, operation: PatchOperation): unknown {
+  switch (operation.op) {
+    case "add":
+      return add(root, operation.path, structuredClone(operation.value));
+    case "replace":
+      return replace(root, operation.path, structuredClone(operation.value));
+    case "remove":
+      return remove(root, operation.path);
+    case "move": {
+      // A location cannot be moved into one of its own children, since removing it would take the target too.
+      const from = parsePointer(operation.from);
+      const to = parsePointer(operation.path);
+      if (to.length > from.length && from.every((token, index) => token === to[index])) {
+        throw new Error(`JSON Patch move cannot move ${JSON.stringify(operation.from)} into its own child ${JSON.stringify(operation.path)}`);
+      }
+      const value = resolvePointer(root, operation.from);
+      return add(remove(root, operation.from), operation.path, value);
+    }
+    case "copy":
+      return add(root, operation.path, structuredClone(resolvePointer(root, operation.from)));
+    case "test": {
+      const actual = resolvePointer(root, operation.path);
+      if (!jsonEqual(actual, operation.value)) {
+        throw new Error(`JSON Patch test failed at ${JSON.stringify(operation.path)}`);
+      }
+      return root;
+    }
+  }
+}
+
+/** Inserts a value at a location. Returns the new root, which differs from `root` only for the empty pointer. */
+function add(root: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    return value;
+  }
+
+  const { parent, key } = locateParent(root, tokens, pointer);
+  if (Array.isArray(parent)) {
+    // "-" appends; any other index inserts before the element at that index, so it may equal the length.
+    const index = key === "-" ? parent.length : arrayIndex(key, parent.length, pointer, true);
+    parent.splice(index, 0, value);
+  } else {
+    defineMember(parent, key, value);
+  }
+  return root;
+}
+
+/** Replaces the value at a location, which must already exist. Returns the new root. */
+function replace(root: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    return value;
+  }
+
+  const { parent, key } = locateParent(root, tokens, pointer);
+  if (Array.isArray(parent)) {
+    parent[arrayIndex(key, parent.length, pointer, false)] = value;
+  } else {
+    if (!Object.hasOwn(parent, key)) {
+      throw new Error(`JSON Patch replace target ${JSON.stringify(pointer)} does not exist`);
+    }
+    defineMember(parent, key, value);
+  }
+  return root;
+}
+
+/** Removes the value at a location, which must exist. Returns the new root. */
+function remove(root: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    throw new Error("JSON Patch cannot remove the whole document");
+  }
+
+  const { parent, key } = locateParent(root, tokens, pointer);
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(key, parent.length, pointer, false), 1);
+  } else {
+    if (!Object.hasOwn(parent, key)) {
+      throw new Error(`JSON Patch remove target ${JSON.stringify(pointer)} does not exist`);
+    }
+    delete parent[key];
+  }
+  return root;
+}
+
+/** Finds the container that holds the location named by `tokens`, and the key of that location within it. */
+function locateParent(root: unknown, tokens: string[], pointer: string): { parent: unknown[] | Record<string, unknown>; key: string } {
+  const parent = tokens.slice(0, -1).reduce((current, token) => step(current, token, pointer), root);
+  if (!Array.isArray(parent) && !isObject(parent)) {
+    throw new Error(`JSON Patch path ${JSON.stringify(pointer)} does not exist: cannot add to a primitive value`);
+  }
+  return { parent, key: tokens[tokens.length - 1] };
+}
+
+/** Parses an array index for a location in an array of `length` elements. `allowEnd` admits the position after the last element. */
+function arrayIndex(token: string, length: number, pointer: string, allowEnd: boolean): number {
+  if (!ARRAY_INDEX.test(token)) {
+    throw new SyntaxError(`Invalid JSON Patch path ${JSON.stringify(pointer)}: ${JSON.stringify(token)} is not an array index`);
+  }
+  const index = Number(token);
+  if (index > length || (index === length && !allowEnd)) {
+    throw new Error(`JSON Patch path ${JSON.stringify(pointer)} is out of range: index ${index}`);
+  }
+  return index;
+}
+
+/** Sets an own property. `defineProperty` keeps a key such as "__proto__" an ordinary member. */
+function defineMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, enumerable: true, writable: true, configurable: true });
+}
+
+/** Compares two JSON values by content: arrays by position, objects by their own members. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, index) => jsonEqual(item, b[index]));
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((key) => Object.hasOwn(b, key) && jsonEqual(a[key], b[key]));
+  }
+  return false;
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
diff --git a/test/apply-patch.test.js b/test/apply-patch.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..d947290ad0579c76d242eac5f6c63db6b6782b7b
--- /dev/null
+++ b/test/apply-patch.test.js
@@ -0,0 +1,158 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("adds a member to an object and an element to an array", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux"] });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+});
+
+test("add with the dash token appends to an array", () => {
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]), {
+    foo: ["bar", ["abc", "def"]],
+  });
+});
+
+test("add replaces an existing object member", () => {
+  assert.deepEqual(applyPatch({ foo: 1 }, [{ op: "add", path: "/foo", value: 2 }]), { foo: 2 });
+});
+
+test("add with the empty pointer replaces the whole document", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+});
+
+test("add can set a member named __proto__ without touching the prototype", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal({}.polluted, undefined);
+});
+
+test("add fails when the parent is missing, a primitive, or the index is out of range", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]), /primitive/);
+  assert.throws(() => applyPatch({ foo: [] }, [{ op: "add", path: "/foo/2", value: 1 }]), /out of range/);
+  assert.throws(() => applyPatch({ foo: [] }, [{ op: "add", path: "/foo/01", value: 1 }]), SyntaxError);
+});
+
+test("removes a member and an array element", () => {
+  assert.deepEqual(applyPatch({ foo: "bar", baz: "qux" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+});
+
+test("remove fails when the target does not exist or is the whole document", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "/b" }]), /does not exist/);
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "remove", path: "/a/1" }]), /out of range/);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]), /whole document/);
+});
+
+test("replaces a member, an array element and the whole document", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), {
+    baz: "boo",
+    foo: "bar",
+  });
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "replace", path: "/foo/0", value: null }]), { foo: [null] });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: "x" }]), "x");
+});
+
+test("replace fails when the target does not exist", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "replace", path: "/b", value: 1 }]), /does not exist/);
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "replace", path: "/a/1", value: 1 }]), /out of range/);
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "replace", path: "/a/-", value: 1 }]), SyntaxError);
+});
+
+test("moves a value from one location to another", () => {
+  assert.deepEqual(applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [
+    { op: "move", from: "/foo/waldo", path: "/qux/thud" },
+  ]), { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+});
+
+test("move fails when the source is missing or the target is inside the source", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "/b", path: "/c" }]), /does not/);
+  assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b/c" }]), /own child/);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "", path: "/c" }]), /own child/);
+});
+
+test("copies a value and does not share it with the source", () => {
+  const result = applyPatch({ foo: { bar: ["baz"] } }, [{ op: "copy", from: "/foo/bar", path: "/copy" }, { op: "add", path: "/copy/1", value: "qux" }]);
+  assert.deepEqual(result, { foo: { bar: ["baz"] }, copy: ["baz", "qux"] });
+});
+
+test("copy fails when the source is missing", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", from: "/b", path: "/c" }]), /does not/);
+});
+
+test("test passes on equal values and fails otherwise", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/foo", value: ["a", 2, "c"] }]), {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  });
+  assert.deepEqual(applyPatch({ a: null }, [{ op: "test", path: "/a", value: null }]), { a: null });
+  assert.throws(() => applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]), /test failed/);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]), /test failed/);
+  assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: "test", path: "/a", value: { b: 1, c: 2 } }]), /test failed/);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/b", value: 1 }]), /does not/);
+});
+
+test("applies the operations in order", () => {
+  assert.deepEqual(applyPatch({}, [
+    { op: "add", path: "/a", value: 1 },
+    { op: "replace", path: "/a", value: 2 },
+    { op: "test", path: "/a", value: 2 },
+  ]), { a: 2 });
+});
+
+test("an empty patch returns an equal document", () => {
+  assert.deepEqual(applyPatch({ a: [1] }, []), { a: [1] });
+});
+
+test("does not mutate the input document or the patch", () => {
+  const document = { foo: ["bar"], nested: { a: 1 } };
+  const patch = [
+    { op: "add", path: "/foo/-", value: { deep: true } },
+    { op: "replace", path: "/nested/a", value: 2 },
+    { op: "remove", path: "/foo/0" },
+  ];
+  const before = structuredClone(document);
+  const patchBefore = structuredClone(patch);
+
+  const result = applyPatch(document, patch);
+
+  assert.deepEqual(result, { foo: [{ deep: true }], nested: { a: 2 } });
+  assert.deepEqual(document, before);
+  assert.deepEqual(patch, patchBefore);
+  assert.notEqual(result, document);
+});
+
+test("the result does not share values with the patch", () => {
+  const value = { list: [1] };
+  const result = applyPatch({}, [
+    { op: "add", path: "/a", value },
+    { op: "add", path: "/a/list/-", value: 2 },
+  ]);
+  assert.deepEqual(result, { a: { list: [1, 2] } });
+  assert.deepEqual(value, { list: [1] });
+});
+
+test("rejects a patch that is not an array", () => {
+  assert.throws(() => applyPatch({}, { op: "add", path: "/a", value: 1 }), SyntaxError);
+  assert.throws(() => applyPatch({}, undefined), SyntaxError);
+});
+
+test("rejects a malformed operation", () => {
+  assert.throws(() => applyPatch({}, [null]), SyntaxError);
+  assert.throws(() => applyPatch({}, [[]]), SyntaxError);
+  assert.throws(() => applyPatch({}, [{ path: "/a", value: 1 }]), SyntaxError);
+  assert.throws(() => applyPatch({}, [{ op: "increment", path: "/a" }]), SyntaxError);
+  assert.throws(() => applyPatch({}, [{ op: "add", value: 1 }]), SyntaxError);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "a", value: 1 }]), SyntaxError);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]), SyntaxError);
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/a" }]), SyntaxError);
+  assert.throws(() => applyPatch({}, [{ op: "move", path: "/a" }]), SyntaxError);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", from: 1, path: "/b" }]), SyntaxError);
+  assert.throws(() => applyPatch({}, [{ op: "remove" }]), SyntaxError);
+});
