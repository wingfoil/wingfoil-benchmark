diff --git a/test/apply-patch.test.js b/test/apply-patch.test.js
index d947290ad0579c76d242eac5f6c63db6b6782b7b..dd5547bcb2867e93024172f4f6782cf13e46e06c 100644
--- a/test/apply-patch.test.js
