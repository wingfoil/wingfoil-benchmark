@@ -156,3 +156,35 @@ test("rejects a malformed operation", () => {
   assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", from: 1, path: "/b" }]), SyntaxError);
   assert.throws(() => applyPatch({}, [{ op: "remove" }]), SyntaxError);
 });
+
+test("add, replace and test reject a value that is not a JSON value", () => {
+  const bad = [undefined, NaN, Infinity, () => 1, Symbol("s"), 1n, new Date(0), new Map(), [undefined], [, 1]];
+  for (const value of bad) {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/b", value }]), SyntaxError);
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "replace", path: "/a", value }]), SyntaxError);
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value }]), SyntaxError);
+  }
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/b", value: { nested: { deep: undefined } } }]), SyntaxError);
+});
+
+test("rejects a cyclic value", () => {
+  const value = {};
+  value.self = value;
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value }]), SyntaxError);
+});
+
+test("accepts every JSON value, including nested null, false, zero and empty strings", () => {
+  const value = { n: null, f: false, z: 0, s: "", list: [[], {}, -1.5e3] };
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a", value }]), { a: value });
+});
+
+test("reads operation members as own properties only", () => {
+  const inherited = Object.create({ op: "add", path: "/b", value: 1 });
+  assert.throws(() => applyPatch({}, [inherited]), SyntaxError);
+  const inheritedPath = Object.create({ path: "/b" });
+  Object.assign(inheritedPath, { op: "remove" });
+  assert.throws(() => applyPatch({ a: 1 }, [inheritedPath]), SyntaxError);
+  const inheritedFrom = Object.create({ from: "/a" });
+  Object.assign(inheritedFrom, { op: "copy", path: "/b" });
+  assert.throws(() => applyPatch({ a: 1 }, [inheritedFrom]), SyntaxError);
+});
