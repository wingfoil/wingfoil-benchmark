index 0000000000000000000000000000000000000000..917d1594a011a29ebc0138a1e463992037a41550
--- /dev/null
+++ b/src/patch.ts
@@ -0,0 +1,170 @@
+import { parseTokens, resolveTokens } from "./pointer.ts";
+import type { JsonValue } from "./pointer.ts";
+
+/** One operation of a JSON Patch document (RFC 6902, section 4). */
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; from: string; path: string };
+
+/** A JSON Patch document: an ordered list of operations. */
+export type JsonPatch = PatchOperation[];
+
+type Container = Record<string, unknown> | unknown[];
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const NEEDS_VALUE = new Set(["add", "replace", "test"]);
+const NEEDS_FROM = new Set(["move", "copy"]);
+const OPERATIONS = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+
+function invalid(index: number, reason: string): TypeError {
+  return new TypeError(`Invalid JSON Patch: operation ${index} ${reason}`);
+}
+
+function requirePointer(operation: Record<string, unknown>, member: string, index: number): void {
+  if (typeof operation[member] !== "string") {
+    throw invalid(index, `needs a string "${member}" member`);
+  }
+  parseTokens(operation[member]);
+}
+
+function validateOperation(operation: unknown, index: number): void {
+  if (typeof operation !== "object" || operation === null || Array.isArray(operation)) {
+    throw invalid(index, "is not an object");
+  }
+  const members = operation as Record<string, unknown>;
+  if (typeof members.op !== "string" || !OPERATIONS.has(members.op)) {
+    throw invalid(index, `has an unknown "op" ${JSON.stringify(members.op)}`);
+  }
+  requirePointer(members, "path", index);
+  if (NEEDS_FROM.has(members.op)) {
+    requirePointer(members, "from", index);
+  }
+  if (NEEDS_VALUE.has(members.op) && !Object.hasOwn(members, "value")) {
+    throw invalid(index, `needs a "value" member`);
+  }
+}
+
+function validatePatch(patch: unknown): asserts patch is JsonPatch {
+  if (!Array.isArray(patch)) {
+    throw new TypeError("Invalid JSON Patch: must be an array of operations");
+  }
+  patch.forEach(validateOperation);
+}
+
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (typeof a !== "object" || typeof b !== "object" || a === null || b === null) {
+    return a === b;
+  }
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  const keysA = Object.keys(a);
+  return (
+    keysA.length === Object.keys(b).length &&
+    keysA.every((key) => Object.hasOwn(b, key) && jsonEqual((a as Container)[key as never], (b as Container)[key as never]))
+  );
+}
+
+function locateParent(document: unknown, tokens: string[], pointer: string): Container {
+  const parent = resolveTokens(document, tokens.slice(0, -1), pointer);
+  if (typeof parent !== "object" || parent === null) {
+    throw new RangeError(`JSON Patch path "${pointer}" does not resolve: its parent is not a container`);
+  }
+  return parent as Container;
+}
+
+function missing(pointer: string): RangeError {
+  return new RangeError(`JSON Patch path "${pointer}" does not resolve to an existing value`);
+}
+
+function arrayIndex(token: string, limit: number, pointer: string): number {
+  if (!ARRAY_INDEX.test(token) || Number(token) > limit) {
+    throw missing(pointer);
+  }
+  return Number(token);
+}
+
+function addMember(document: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parseTokens(pointer);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = locateParent(document, tokens, pointer);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    const index = token === "-" ? parent.length : arrayIndex(token, parent.length, pointer);
+    parent.splice(index, 0, value);
+  } else {
+    // defineProperty keeps "__proto__" an ordinary member instead of reassigning the prototype.
+    Object.defineProperty(parent, token, { value, writable: true, enumerable: true, configurable: true });
+  }
+  return document;
+}
+
+function removeMember(document: unknown, pointer: string): unknown {
+  const tokens = parseTokens(pointer);
+  if (tokens.length === 0) {
+    throw new RangeError("JSON Patch cannot remove the whole document");
+  }
+  const parent = locateParent(document, tokens, pointer);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(token, parent.length - 1, pointer), 1);
+  } else if (Object.hasOwn(parent, token)) {
+    delete parent[token];
+  } else {
+    throw missing(pointer);
+  }
+  return document;
+}
+
+function replaceMember(document: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parseTokens(pointer);
+  resolveTokens(document, tokens, pointer);
+  return tokens.length === 0 ? value : addMember(removeMember(document, pointer), pointer, value);
+}
+
+function moveMember(document: unknown, from: string, pointer: string): unknown {
+  const value = resolveTokens(document, parseTokens(from), from);
+  if (from === pointer) {
+    return document;
+  }
+  if (pointer.startsWith(`${from}/`)) {
+    throw new RangeError(`JSON Patch cannot move "${from}" into its own child "${pointer}"`);
+  }
+  return addMember(removeMember(document, from), pointer, value);
+}
+
+function applyOperation(document: unknown, operation: PatchOperation): unknown {
+  switch (operation.op) {
+    case "add":
+      return addMember(document, operation.path, structuredClone(operation.value));
+    case "remove":
+      return removeMember(document, operation.path);
+    case "replace":
+      return replaceMember(document, operation.path, structuredClone(operation.value));
+    case "move":
+      return moveMember(document, operation.from, operation.path);
+    case "copy":
+      return addMember(document, operation.path, structuredClone(resolveTokens(document, parseTokens(operation.from), operation.from)));
+    case "test":
+      if (!jsonEqual(resolveTokens(document, parseTokens(operation.path), operation.path), operation.value)) {
+        throw new Error(`JSON Patch test failed: value at "${operation.path}" is not equal to the expected value`);
+      }
+      return document;
+  }
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the result as a new value.
+ *
+ * Neither `document` nor `patch` is mutated and the result shares no structure with them. The patch
+ * is validated before anything is applied (`TypeError` for a malformed operation, `SyntaxError` for
+ * an invalid JSON Pointer). Operations then apply in order; the first one that fails (unresolvable
+ * path: `RangeError`; failed `test`: `Error`) aborts the whole patch.
+ */
+export function applyPatch(document: unknown, patch: JsonPatch): unknown {
+  validatePatch(patch);
+  return patch.reduce(applyOperation, structuredClone(document));
+}
