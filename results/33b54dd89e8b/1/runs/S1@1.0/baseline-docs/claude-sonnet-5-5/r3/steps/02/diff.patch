@@ -47,5 +48,10 @@ function step(current: unknown, token: string, pointer: string): unknown {
  * array token, or a step into a scalar).
  */
 export function resolvePointer(document: unknown, pointer: string): unknown {
-  return parseTokens(pointer).reduce((current, token) => step(current, token, pointer), document);
+  return resolveTokens(document, parseTokens(pointer), pointer);
+}
+
+/** Follows already-parsed `tokens` from `document`; `pointer` is only used in error messages. */
+export function resolveTokens(document: unknown, tokens: string[], pointer: string): unknown {
+  return tokens.reduce((current, token) => step(current, token, pointer), document);
 }
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7c43274662a44a879c9dcff68dd6ca45cc623b2a
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,197 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+// RFC 6902 appendix A examples.
+test("A.1 adding an object member", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), {
+    foo: "bar",
+    baz: "qux",
+  });
+});
+
+test("A.2 adding an array element", () => {
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), {
+    foo: ["bar", "qux", "baz"],
+  });
+});
+
+test("A.3 removing an object member", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+});
+
+test("A.4 removing an array element", () => {
+  assert.deepEqual(applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), {
+    foo: ["bar", "baz"],
+  });
+});
+
+test("A.5 replacing a value", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), {
+    baz: "boo",
+    foo: "bar",
+  });
+});
+
+test("A.6 moving a value", () => {
+  const doc = { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } };
+  assert.deepEqual(applyPatch(doc, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]), {
+    foo: { bar: "baz" },
+    qux: { corge: "grault", thud: "fred" },
+  });
+});
+
+test("A.7 moving an array element", () => {
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+});
+
+test("A.8/A.9 testing a value", () => {
+  assert.deepEqual(applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "qux" }]), { baz: "qux" });
+  assert.throws(() => applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]));
+});
+
+test("A.10 adding a nested member object", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]), {
+    foo: "bar",
+    child: { grandchild: {} },
+  });
+});
+
+test("A.12 adding to a nonexistent target fails", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]), RangeError);
+});
+
+test("A.14 ~ escape ordering", () => {
+  assert.deepEqual(applyPatch({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }]), { "/": 9, "~1": 10 });
+});
+
+test("A.16 adding an array value", () => {
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]), {
+    foo: ["bar", ["abc", "def"]],
+  });
+});
+
+test("add: replaces an existing member, the whole document, and appends with '-'", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/1", value: 2 }]), [1, 2]);
+});
+
+test("add: rejects bad array indexes", () => {
+  for (const path of ["/3", "/01", "/-1", "/x"]) {
+    assert.throws(() => applyPatch([1], [{ op: "add", path, value: 0 }]), RangeError, path);
+  }
+});
+
+test("remove: missing target and root fail", () => {
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/a" }]), RangeError);
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/1" }]), RangeError);
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/-" }]), RangeError);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "" }]), RangeError);
+});
+
+test("replace: target must exist; root can be replaced", () => {
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]), RangeError);
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/-", value: 1 }]), RangeError);
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: null }]), null);
+});
+
+test("move: missing source fails, moving into own child fails, same location is a no-op", () => {
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/a", path: "/b" }]), RangeError);
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]), Error);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+});
+
+test("copy: duplicates a value without sharing structure", () => {
+  const result = applyPatch({ a: { b: 1 } }, [
+    { op: "copy", from: "/a", path: "/c" },
+    { op: "replace", path: "/c/b", value: 2 },
+  ]);
+  assert.deepEqual(result, { a: { b: 1 }, c: { b: 2 } });
+  assert.throws(() => applyPatch({}, [{ op: "copy", from: "/a", path: "/b" }]), RangeError);
+});
+
+test("test: compares deeply, ignoring member order, and distinguishes types", () => {
+  const doc = { a: { x: 1, y: [1, { z: null }] } };
+  applyPatch(doc, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }]);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "test", path: "/a", value: { 0: 1 } }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/b", value: 1 }]), RangeError);
+});
+
+test("test: a failed test aborts the whole patch", () => {
+  assert.throws(() =>
+    applyPatch({ a: 1 }, [
+      { op: "replace", path: "/a", value: 2 },
+      { op: "test", path: "/a", value: 1 },
+    ]),
+  );
+});
+
+test("operations apply sequentially", () => {
+  assert.deepEqual(
+    applyPatch({}, [
+      { op: "add", path: "/a", value: [] },
+      { op: "add", path: "/a/-", value: 1 },
+      { op: "copy", from: "/a/0", path: "/b" },
+    ]),
+    { a: [1], b: 1 },
+  );
+  assert.deepEqual(applyPatch({ a: 1 }, []), { a: 1 });
+});
+
+test("does not mutate the document or the patch, and shares no structure", () => {
+  const doc = { a: { b: [1, 2] } };
+  const value = { n: [1] };
+  const patch = [
+    { op: "add", path: "/a/b/0", value: 0 },
+    { op: "add", path: "/v", value },
+  ];
+  const snapshotDoc = structuredClone(doc);
+  const snapshotPatch = structuredClone(patch);
+  const result = applyPatch(doc, patch) as { a: unknown; v: unknown };
+  assert.deepEqual(doc, snapshotDoc);
+  assert.deepEqual(patch, snapshotPatch);
+  assert.notEqual(result.v, value);
+  assert.deepEqual(applyPatch(doc, []), doc);
+  assert.notEqual(applyPatch(doc, []), doc);
+});
+
+test("prototype keys are ordinary members", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as object;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/constructor" }]), RangeError);
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+});
+
+test("invalid patches are rejected", () => {
+  const bad: unknown[] = [
+    null,
+    {},
+    "x",
+    [null],
+    [[]],
+    [{}],
+    [{ op: "nope", path: "" }],
+    [{ op: "add", path: "/a" }],
+    [{ op: "replace", path: "/a" }],
+    [{ op: "test", path: "/a" }],
+    [{ op: "add", value: 1 }],
+    [{ op: "add", path: 1, value: 1 }],
+    [{ op: "remove" }],
+    [{ op: "move", path: "/a" }],
+    [{ op: "copy", from: 1, path: "/a" }],
+  ];
+  for (const patch of bad) {
+    assert.throws(() => applyPatch({ a: 1 }, patch as never), TypeError, JSON.stringify(patch));
+  }
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "a", value: 1 }]), SyntaxError);
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "a", path: "/a" }]), SyntaxError);
+});
+
+test("a patch invalid in a later operation is rejected before anything applies", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: 1 }, { op: "bogus", path: "/a" }] as never), TypeError);
+});
