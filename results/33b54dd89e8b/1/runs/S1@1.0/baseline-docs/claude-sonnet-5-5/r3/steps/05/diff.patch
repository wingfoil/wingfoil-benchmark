diff --git a/test/diff.test.ts b/test/diff.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d6744300685e695fc8fc9f56fc3278bb3884afba
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,75 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown) {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a small change gives a single operation", () => {
+  const from = { name: "x", nested: { deep: { value: 1, other: [1, 2, 3] } }, big: "y".repeat(100) };
+  const to = structuredClone(from);
+  to.nested.deep.value = 2;
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/nested/deep/value", value: 2 }]);
+});
+
+test("adds, removes and replaces members", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 3, c: 4 }), [
+    { op: "remove", path: "/a" },
+    { op: "replace", path: "/b", value: 3 },
+    { op: "add", path: "/c", value: 4 },
+  ]);
+});
+
+test("escapes ~ and / in member names, and treats __proto__ as ordinary", () => {
+  const to = JSON.parse('{"a/b":1,"c~d":2,"__proto__":3}');
+  const patch = roundTrip({}, to);
+  assert.deepEqual(patch.map((operation) => operation.path), ["/a~1b", "/c~0d", "/__proto__"]);
+});
+
+test("array insertion and deletion in the middle touch only that element", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 4]), [{ op: "remove", path: "/1" }, { op: "remove", path: "/1" }]);
+});
+
+test("arrays that grow or shrink at the end", () => {
+  roundTrip([1], [1, 2, 3]);
+  roundTrip([1, 2, 3], [1]);
+  roundTrip([], [1]);
+  roundTrip([[1, 2], { a: 1 }], [[1, 3], { a: 2 }, 5]);
+});
+
+test("differing types and root changes are replaced", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  roundTrip(1, "1");
+  roundTrip(null, {});
+  roundTrip({ a: null }, { a: [] });
+  roundTrip({ a: [] }, { a: {} });
+});
+
+test("member order does not matter", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+});
+
+test("does not mutate inputs and shares no structure", () => {
+  const from = { a: { x: 1 } };
+  const to = { a: { x: 1 }, b: { y: [1] } };
+  const snapshot = structuredClone([from, to]);
+  const patch = createPatch(from, to);
+  assert.deepEqual([from, to], snapshot);
+  assert.notEqual((patch[0] as { value: unknown }).value, to.b);
+});
+
+test("rejects values that are not JSON", () => {
+  assert.throws(() => createPatch({ a: undefined }, {}), TypeError);
+  assert.throws(() => createPatch({}, { a: NaN }), TypeError);
+  assert.throws(() => createPatch([, 1], [1, 1]), TypeError);
+  assert.throws(() => createPatch(undefined, 1), TypeError);
+  assert.throws(() => createPatch({}, { a: () => 1 }), TypeError);
+});
