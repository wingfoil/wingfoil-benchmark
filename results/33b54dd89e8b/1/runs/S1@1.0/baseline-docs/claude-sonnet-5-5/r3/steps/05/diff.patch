new file mode 100644
index 0000000000000000000000000000000000000000..4d3a24a96d6948088790ebb64c0912e71f0d7eb1
--- /dev/null
+++ b/src/diff.ts
@@ -0,0 +1,100 @@
+import { jsonEqual } from "./patch.ts";
+import type { JsonPatch } from "./patch.ts";
+import type { JsonValue } from "./pointer.ts";
+
+type JsonObject = { [key: string]: JsonValue };
+
+function isObject(value: unknown): value is JsonObject {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function escapeToken(token: string): string {
+  return token.replaceAll("~", "~0").replaceAll("/", "~1");
+}
+
+/** Rejects anything that is not a JSON value (undefined, functions, NaN, sparse array holes...). */
+function assertJson(value: unknown, role: string, path: string): void {
+  if (value === null || typeof value === "string" || typeof value === "boolean" || (typeof value === "number" && Number.isFinite(value))) {
+    return;
+  }
+  if (Array.isArray(value)) {
+    // An index loop, because forEach skips the holes of a sparse array.
+    for (let index = 0; index < value.length; index++) {
+      assertJson(value[index], role, `${path}/${index}`);
+    }
+    return;
+  }
+  if (typeof value === "object" && Object.getPrototypeOf(value) === Object.prototype) {
+    for (const name of Object.keys(value)) {
+      assertJson((value as JsonObject)[name], role, `${path}/${escapeToken(name)}`);
+    }
+    return;
+  }
+  throw new TypeError(`Invalid createPatch input: "${role}" has a non-JSON value at "${path}"`);
+}
+
+function diffObjects(from: JsonObject, to: JsonObject, path: string, patch: JsonPatch): void {
+  for (const name of Object.keys(from)) {
+    if (!Object.hasOwn(to, name)) {
+      patch.push({ op: "remove", path: `${path}/${escapeToken(name)}` });
+    }
+  }
+  for (const name of Object.keys(to)) {
+    const child = `${path}/${escapeToken(name)}`;
+    if (Object.hasOwn(from, name)) {
+      diffValues(from[name], to[name], child, patch);
+    } else {
+      patch.push({ op: "add", path: child, value: structuredClone(to[name]) });
+    }
+  }
+}
+
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, patch: JsonPatch): void {
+  // Trimming the common ends keeps an insertion or deletion in the middle from shifting every later element.
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+    start++;
+  }
+  let end = 0;
+  while (end < from.length - start && end < to.length - start && jsonEqual(from[from.length - 1 - end], to[to.length - 1 - end])) {
+    end++;
+  }
+  const removable = from.length - start - end;
+  const addable = to.length - start - end;
+  const shared = Math.min(removable, addable);
+  for (let offset = 0; offset < shared; offset++) {
+    diffValues(from[start + offset], to[start + offset], `${path}/${start + offset}`, patch);
+  }
+  for (let offset = shared; offset < removable; offset++) {
+    patch.push({ op: "remove", path: `${path}/${start + shared}` });
+  }
+  for (let offset = shared; offset < addable; offset++) {
+    patch.push({ op: "add", path: `${path}/${start + offset}`, value: structuredClone(to[start + offset]) });
+  }
+}
+
+function diffValues(from: JsonValue, to: JsonValue, path: string, patch: JsonPatch): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, patch);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from, to, path, patch);
+  } else if (!jsonEqual(from, to)) {
+    patch.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Computes a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * Only what differs is described: objects are compared member by member and arrays element by
+ * element after trimming their common start and end, so a small change gives a small patch. Equal
+ * documents give an empty patch. Neither argument is mutated and the patch shares no structure with
+ * them. Throws `TypeError` when either argument is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatch {
+  assertJson(from, "from", "");
+  assertJson(to, "to", "");
+  const patch: JsonPatch = [];
+  diffValues(from as JsonValue, to as JsonValue, "", patch);
+  return patch;
+}
