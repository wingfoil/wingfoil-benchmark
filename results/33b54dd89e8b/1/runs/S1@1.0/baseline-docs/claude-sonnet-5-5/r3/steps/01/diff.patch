diff --git a/src/pointer.ts b/src/pointer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1c39115c041622850f4fea4544642af7b9887f71
--- /dev/null
+++ b/src/pointer.ts
@@ -0,0 +1,51 @@
+/** A JSON value as defined by RFC 8259. */
+export type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const INVALID_ESCAPE = /~(?![01])/;
+
+function parseTokens(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new TypeError("JSON Pointer must be a string");
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new SyntaxError(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (INVALID_ESCAPE.test(token)) {
+        throw new SyntaxError(`Invalid JSON Pointer "${pointer}": "~" must be followed by "0" or "1"`);
+      }
+      // ~1 must be decoded before ~0, so that "~01" yields "~1" and not "/".
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+function step(current: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+      throw new RangeError(`JSON Pointer "${pointer}" does not resolve: no array element "${token}"`);
+    }
+    return current[Number(token)];
+  }
+  if (typeof current === "object" && current !== null && Object.hasOwn(current, token)) {
+    return (current as Record<string, unknown>)[token];
+  }
+  throw new RangeError(`JSON Pointer "${pointer}" does not resolve: no member "${token}"`);
+}
+
+/**
+ * Returns the value of `document` that `pointer` refers to, as specified by RFC 6901.
+ *
+ * Throws a `SyntaxError` when `pointer` is not a valid JSON Pointer, and a `RangeError` when it
+ * does not resolve to a value of the document (missing member, out-of-range index, the "-"
+ * array token, or a step into a scalar).
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  return parseTokens(pointer).reduce((current, token) => step(current, token, pointer), document);
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..019d184646f0f55b992828f303b50c90a98d5f31
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,79 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// RFC 6901 section 5 example document.
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("returns falsy values and null as found values", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer({ a: false }, "/a"), false);
+  assert.equal(resolvePointer([0], "/0"), 0);
+});
+
+test("decodes ~01 as ~1, not as /", () => {
+  assert.equal(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+});
+
+test("rejects syntactically invalid pointers", () => {
+  for (const pointer of ["foo", "a/b", "/a~", "/a~2", "/~", "/a~b"]) {
+    assert.throws(() => resolvePointer(doc, pointer), SyntaxError, pointer);
+  }
+  assert.throws(() => resolvePointer(doc, undefined as unknown as string), TypeError);
+});
+
+test("throws when the pointer does not resolve", () => {
+  const cases: [unknown, string][] = [
+    [doc, "/missing"],
+    [doc, "/foo/2"],
+    [doc, "/foo/-"],
+    [doc, "/foo/00"],
+    [doc, "/foo/01"],
+    [doc, "/foo/+1"],
+    [doc, "/foo/-1"],
+    [doc, "/foo/1.0"],
+    [doc, "/foo/length"],
+    [doc, "/foo/bar"],
+    [doc, "/foo/0/x"],
+    [{ a: null }, "/a/b"],
+    [{}, "/__proto__"],
+    [{}, "/constructor"],
+    [{}, "/toString"],
+    [[], "/0"],
+  ];
+  for (const [document, pointer] of cases) {
+    assert.throws(() => resolvePointer(document, pointer), RangeError, pointer);
+  }
+});
+
+test("does not treat a scalar document as having members", () => {
+  assert.equal(resolvePointer(5, ""), 5);
+  assert.throws(() => resolvePointer(5, "/a"), RangeError);
+  assert.throws(() => resolvePointer(null, "/a"), RangeError);
+});
