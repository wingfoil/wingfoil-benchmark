   }
diff --git a/test/diff.test.ts b/test/diff.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eb01c8acb8848f08c20dab6848c7bb8c8836b129
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,69 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(createPatch({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a small change yields a single small operation", () => {
+  const from = { a: { b: 1, c: [1, 2, 3] }, d: "x" };
+  const to = { a: { b: 1, c: [1, 9, 3] }, d: "x" };
+  assert.deepEqual(createPatch(from, to), [{ op: "replace", path: "/a/c/1", value: 9 }]);
+});
+
+test("member order does not matter", () => {
+  assert.deepEqual(createPatch({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+});
+
+test("adds, removes and escapes member names", () => {
+  assert.deepEqual(createPatch({ "a/b": 1, "m~n": 2 }, { "m~n": 3, c: 4 }), [
+    { op: "remove", path: "/a~1b" },
+    { op: "replace", path: "/m~0n", value: 3 },
+    { op: "add", path: "/c", value: 4 },
+  ]);
+});
+
+test("an inserted or deleted array element is one operation", () => {
+  assert.deepEqual(createPatch([1, 2, 3], [0, 1, 2, 3]), [{ op: "add", path: "/0", value: 0 }]);
+  assert.deepEqual(createPatch([1, 2, 3, 4], [1, 4]), [
+    { op: "remove", path: "/1" },
+    { op: "remove", path: "/1" },
+  ]);
+});
+
+test("type changes and root changes replace", () => {
+  assert.deepEqual(createPatch({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(createPatch({ a: null }, { a: {} }), [{ op: "replace", path: "/a", value: {} }]);
+});
+
+test("applying the patch yields the target", () => {
+  const cases: [unknown, unknown][] = [
+    [[1, 2, 3], [3, 2, 1]],
+    [[1, 2], [1, 2, 3, 4]],
+    [[1, [2, 3]], [[2, 3], 1, 5]],
+    [{ a: [{ b: 1 }, { c: 2 }] }, { a: [{ c: 2 }, { b: 1, z: [] }] }],
+    [1, "x"],
+    [null, { a: null }],
+    [{ "": 1, "/": { "~": 2 } }, { "": 2, "/": { "~": 3, y: 1 } }],
+  ];
+  for (const [from, to] of cases) {
+    assert.deepEqual(applyPatch(from as never, createPatch(from as never, to as never)), to);
+  }
+});
+
+test("does not mutate arguments and shares no structure", () => {
+  const from = { a: { b: 1 } };
+  const to = { a: { b: 1, c: { d: [1] } } };
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  assert.notEqual((patch[0] as { value: unknown }).value, to.a.c);
+});
+
+test("rejects non-JSON input", () => {
+  assert.throws(() => createPatch({ a: NaN }, {}));
+  assert.throws(() => createPatch({}, { a: undefined } as never));
+});
