new file mode 100644
index 0000000000000000000000000000000000000000..73f3082d532a6cc053893223e86bf8e3e9186aa8
--- /dev/null
+++ b/src/diff.ts
@@ -0,0 +1,80 @@
+import { isJsonValue, jsonEqual } from "./patch.ts";
+import type { PatchOperation } from "./patch.ts";
+import type { JsonValue } from "./pointer.ts";
+
+type JsonObject = { [key: string]: JsonValue };
+
+function isPlainObject(value: JsonValue): value is JsonObject {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Escapes a member name as a JSON Pointer token (RFC 6901 §3). */
+function escapeToken(token: string): string {
+  return token.replaceAll("~", "~0").replaceAll("/", "~1");
+}
+
+function diffObjects(from: JsonObject, to: JsonObject, path: string, out: PatchOperation[]): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+  }
+  for (const key of Object.keys(to)) {
+    const childPath = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) diff(from[key], to[key], childPath, out);
+    else out.push({ op: "add", path: childPath, value: structuredClone(to[key]) });
+  }
+}
+
+/** Length of the common run of equal elements at the start of `a` and `b`. */
+function commonPrefix(a: JsonValue[], b: JsonValue[]): number {
+  let length = 0;
+  while (length < a.length && length < b.length && jsonEqual(a[length], b[length])) length++;
+  return length;
+}
+
+/** Length of the common run at the end of `a` and `b`, not overlapping the first `skip` elements. */
+function commonSuffix(a: JsonValue[], b: JsonValue[], skip: number): number {
+  let length = 0;
+  const limit = Math.min(a.length, b.length) - skip;
+  while (length < limit && jsonEqual(a[a.length - 1 - length], b[b.length - 1 - length])) length++;
+  return length;
+}
+
+/**
+ * Diffs two arrays: the common head and tail are left alone, the differing middle is diffed element
+ * by element, and any surplus is removed or added, so an insertion or deletion stays a single operation.
+ */
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, out: PatchOperation[]): void {
+  const head = commonPrefix(from, to);
+  const tail = commonSuffix(from, to, head);
+  const fromLength = from.length - head - tail;
+  const toLength = to.length - head - tail;
+  const shared = Math.min(fromLength, toLength);
+  for (let i = 0; i < shared; i++) diff(from[head + i], to[head + i], `${path}/${head + i}`, out);
+  for (let i = shared; i < fromLength; i++) out.push({ op: "remove", path: `${path}/${head + shared}` });
+  for (let i = shared; i < toLength; i++) {
+    out.push({ op: "add", path: `${path}/${head + i}`, value: structuredClone(to[head + i]) });
+  }
+}
+
+function diff(from: JsonValue, to: JsonValue, path: string, out: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) diffArrays(from, to, path, out);
+  else if (isPlainObject(from) && isPlainObject(to)) diffObjects(from, to, path, out);
+  else out.push({ op: "replace", path, value: structuredClone(to) });
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * Only what differs is described: unchanged members and array elements produce no operation, and
+ * nested changes are addressed by their own path. Identical documents give an empty patch. Neither
+ * argument is mutated and the patch shares no structure with them. Throws an `Error` if `from` or
+ * `to` is not JSON (see `applyPatch` for what counts).
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  if (!isJsonValue(from)) throw new Error("Invalid JSON Patch diff: `from` must be JSON");
+  if (!isJsonValue(to)) throw new Error("Invalid JSON Patch diff: `to` must be JSON");
+  const operations: PatchOperation[] = [];
+  diff(from, to, "", operations);
+  return operations;
+}
