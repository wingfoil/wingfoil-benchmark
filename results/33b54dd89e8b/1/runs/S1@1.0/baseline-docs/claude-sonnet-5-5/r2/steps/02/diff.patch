new file mode 100644
index 0000000000000000000000000000000000000000..91722e3495ae13c3157ecc14ebc6fff9121c3283
--- /dev/null
+++ b/src/pointer.ts
@@ -0,0 +1,59 @@
+/** Any value a JSON document can hold. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/** Decodes one reference token (RFC 6901 §4); `~1` becomes `/` and `~0` becomes `~`. */
+function unescapeToken(token: string): string {
+  return token.replace(/~(.?)/g, (_match, next: string) => {
+    if (next === "0") return "~";
+    if (next === "1") return "/";
+    throw new Error(`Invalid JSON Pointer: bad escape "~${next}"`);
+  });
+}
+
+/** Splits a pointer into its decoded reference tokens (RFC 6901 §3); throws if it is invalid. */
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: must be a string");
+  }
+  if (pointer === "") return [];
+  if (!pointer.startsWith("/")) {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+/** Resolves one reference token against a value (RFC 6901 §4); throws when it does not exist. */
+function step(current: unknown, token: string): unknown {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+      throw new Error(`JSON Pointer does not resolve: no array element "${token}"`);
+    }
+    return current[Number(token)];
+  }
+  if (typeof current === "object" && current !== null) {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new Error(`JSON Pointer does not resolve: no member "${token}"`);
+    }
+    return (current as Record<string, unknown>)[token];
+  }
+  throw new Error(`JSON Pointer does not resolve: cannot descend into a scalar at "${token}"`);
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer `pointer` refers to (RFC 6901).
+ *
+ * The empty pointer refers to the whole document. Throws an `Error` when `pointer` is not a valid
+ * JSON Pointer, or when it does not resolve to a value of `document` (missing member, array index
+ * out of range or with leading zeros, the end-of-array token `-`, or a path through a scalar).
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  return parsePointer(pointer).reduce<unknown>(step, document) as JsonValue;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..41e5ed7ccde97f75a4e98969f75e6464cc6ff8ff
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,163 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("add: member, array insert, append with '-', replace existing member (RFC 6902 A.1, A.3, A.16)", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), {
+    foo: "bar",
+    baz: "qux",
+  });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), {
+    foo: ["bar", "qux", "baz"],
+  });
+  assert.deepEqual(applyPatch({ foo: ["a"] }, [{ op: "add", path: "/foo/-", value: "b" }]), {
+    foo: ["a", "b"],
+  });
+  assert.deepEqual(applyPatch({ foo: 1 }, [{ op: "add", path: "/foo", value: 2 }]), { foo: 2 });
+});
+
+test("add: whole document with the empty path", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+});
+
+test("add: errors", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/2", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/01", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]));
+});
+
+test("add: '__proto__' is an ordinary member", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as object;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+});
+
+test("remove: member and array element (RFC 6902 A.4, A.5)", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), {
+    foo: ["bar", "baz"],
+  });
+});
+
+test("remove: errors", () => {
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/-" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]));
+});
+
+test("replace: member and whole document (RFC 6902 A.6)", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), {
+    baz: "boo",
+    foo: "bar",
+  });
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: 3 }]), 3);
+  assert.deepEqual(applyPatch([1, 2], [{ op: "replace", path: "/1", value: 5 }]), [1, 5]);
+});
+
+test("replace: errors", () => {
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/1", value: 1 }]));
+});
+
+test("move: member and array element (RFC 6902 A.7, A.8)", () => {
+  assert.deepEqual(
+    applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [
+      { op: "move", from: "/foo/waldo", path: "/qux/thud" },
+    ]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+});
+
+test("move: onto itself is a no-op; into own child and missing source fail", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/c" }]));
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/a", path: "/b" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", path: "/b" }]));
+});
+
+test("copy: duplicates without aliasing (RFC 6902 A.9)", () => {
+  const result = applyPatch({ foo: { bar: [1] } }, [{ op: "copy", from: "/foo", path: "/baz" }]) as {
+    foo: { bar: number[] };
+    baz: { bar: number[] };
+  };
+  assert.deepEqual(result.baz, { bar: [1] });
+  assert.notEqual(result.baz, result.foo);
+  assert.throws(() => applyPatch({}, [{ op: "copy", from: "/a", path: "/b" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", path: "/b" }]));
+});
+
+test("test: deep equality (RFC 6902 A.10-A.15)", () => {
+  const doc = { baz: "qux", foo: ["a", 2, "c"], o: { x: 1, y: [1, { z: null }] } };
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/baz", value: "qux" }]), doc);
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/foo/1", value: 2 }]), doc);
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/o", value: { y: [1, { z: null }], x: 1 } }]), doc);
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "", value: doc }]), doc);
+});
+
+test("test: failures", () => {
+  const doc = { a: 1, b: [1, 2], c: "1" };
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a", value: 2 }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a", value: "1" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/b", value: [2, 1] }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/b", value: [1] }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/zz", value: null }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a" }]));
+});
+
+test("operations apply in order and a failing one aborts the patch", () => {
+  assert.deepEqual(
+    applyPatch({}, [
+      { op: "add", path: "/a", value: 1 },
+      { op: "copy", from: "/a", path: "/b" },
+      { op: "test", path: "/b", value: 1 },
+    ]),
+    { a: 1, b: 1 },
+  );
+  assert.throws(() =>
+    applyPatch({}, [
+      { op: "add", path: "/a", value: 1 },
+      { op: "remove", path: "/zz" },
+    ]),
+  );
+});
+
+test("an empty patch returns an equal, distinct document", () => {
+  const doc = { a: [1] };
+  const result = applyPatch(doc, []);
+  assert.deepEqual(result, doc);
+  assert.notEqual(result, doc);
+});
+
+test("does not mutate the document or the patch", () => {
+  const doc = { a: { b: [1, 2] }, c: 1 };
+  const patch = [
+    { op: "add", path: "/a/b/-", value: { k: 1 } },
+    { op: "move", from: "/c", path: "/d" },
+    { op: "remove", path: "/a/b/0" },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const result = applyPatch(doc, patch) as { a: { b: unknown[] } };
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  (patch[0].value as { k: number }).k = 9;
+  assert.deepEqual(result.a.b, [2, { k: 1 }]);
+});
+
+test("invalid patches", () => {
+  assert.throws(() => applyPatch({}, {} as never));
+  assert.throws(() => applyPatch({}, [null] as never));
+  assert.throws(() => applyPatch({}, [[]] as never));
+  assert.throws(() => applyPatch({}, [{ path: "/a", value: 1 }] as never));
+  assert.throws(() => applyPatch({}, [{ op: "bogus", path: "/a" }] as never));
+  assert.throws(() => applyPatch({}, [{ op: "add", value: 1 }] as never));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: 1, value: 1 }] as never));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "a", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a~2", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "x", path: "/a" }]));
+});
