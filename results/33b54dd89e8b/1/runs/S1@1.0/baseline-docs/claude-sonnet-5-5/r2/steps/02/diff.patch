index 0000000000000000000000000000000000000000..49063bf9e05cfc818e5f3a728367e524b8316ba7
--- /dev/null
+++ b/src/patch.ts
@@ -0,0 +1,163 @@
+import { parsePointer } from "./pointer.ts";
+import type { JsonValue } from "./pointer.ts";
+
+/** One operation of a JSON Patch document (RFC 6902 §4). */
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; from: string; path: string };
+
+type Container = JsonValue[] | { [key: string]: JsonValue };
+
+const OPERATIONS = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+const hasOwn = (object: object, key: string): boolean => Object.prototype.hasOwnProperty.call(object, key);
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Returns the operation's pointer member `name` as tokens; throws if absent or not a valid pointer. */
+function requirePointer(operation: Record<string, unknown>, name: "path" | "from"): string[] {
+  if (typeof operation[name] !== "string") {
+    throw new Error(`Invalid JSON Patch: "${operation.op}" needs a string "${name}"`);
+  }
+  return parsePointer(operation[name]);
+}
+
+function requireValue(operation: Record<string, unknown>): JsonValue {
+  if (!hasOwn(operation, "value") || operation.value === undefined) {
+    throw new Error(`Invalid JSON Patch: "${operation.op}" needs a "value"`);
+  }
+  return structuredClone(operation.value) as JsonValue;
+}
+
+/** Deep equality of two JSON values (RFC 6902 §4.6): object member order is irrelevant. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]));
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((key) => hasOwn(b, key) && jsonEqual(a[key], b[key]));
+  }
+  return a === b;
+}
+
+/** Finds the container holding the target of `tokens`; the parent must exist. */
+function parentOf(root: JsonValue, tokens: string[]): Container {
+  let current: unknown = root;
+  for (const token of tokens.slice(0, -1)) {
+    current = child(current, token);
+  }
+  if (typeof current !== "object" || current === null) {
+    throw new Error("JSON Patch: the parent of the target is not an object or an array");
+  }
+  return current as Container;
+}
+
+function child(container: unknown, token: string): unknown {
+  if (Array.isArray(container)) {
+    return container[existingIndex(container, token)];
+  }
+  if (isObject(container) && hasOwn(container, token)) return container[token];
+  throw new Error(`JSON Patch: path does not exist at "${token}"`);
+}
+
+function existingIndex(array: JsonValue[], token: string): number {
+  if (!ARRAY_INDEX.test(token) || Number(token) >= array.length) {
+    throw new Error(`JSON Patch: no array element "${token}"`);
+  }
+  return Number(token);
+}
+
+function setMember(object: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function getAt(root: JsonValue, tokens: string[]): JsonValue {
+  if (tokens.length === 0) return root;
+  return child(parentOf(root, tokens), tokens[tokens.length - 1]) as JsonValue;
+}
+
+function addAt(root: JsonValue, tokens: string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens);
+  const token = tokens[tokens.length - 1];
+  if (!Array.isArray(parent)) {
+    setMember(parent, token, value);
+  } else if (token === "-") {
+    parent.push(value);
+  } else if (ARRAY_INDEX.test(token) && Number(token) <= parent.length) {
+    parent.splice(Number(token), 0, value);
+  } else {
+    throw new Error(`JSON Patch: cannot add at array index "${token}"`);
+  }
+  return root;
+}
+
+function removeAt(root: JsonValue, tokens: string[]): JsonValue {
+  if (tokens.length === 0) throw new Error("JSON Patch: cannot remove the whole document");
+  getAt(root, tokens);
+  const parent = parentOf(root, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(token), 1);
+  else delete parent[token];
+  return root;
+}
+
+function replaceAt(root: JsonValue, tokens: string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) return value;
+  getAt(root, tokens);
+  const parent = parentOf(root, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(token)] = value;
+  else setMember(parent, token, value);
+  return root;
+}
+
+function moveAt(root: JsonValue, from: string[], path: string[]): JsonValue {
+  const isProperPrefix = from.length < path.length && from.every((token, i) => token === path[i]);
+  if (isProperPrefix) throw new Error("JSON Patch: cannot move a value into one of its own children");
+  const value = getAt(root, from);
+  if (from.length === path.length && from.every((token, i) => token === path[i])) return root;
+  return addAt(removeAt(root, from), path, value);
+}
+
+function applyOperation(root: JsonValue, operation: unknown): JsonValue {
+  if (!isObject(operation)) throw new Error("Invalid JSON Patch: an operation must be an object");
+  if (typeof operation.op !== "string" || !OPERATIONS.has(operation.op)) {
+    throw new Error(`Invalid JSON Patch: unknown operation "${String(operation.op)}"`);
+  }
+  const path = requirePointer(operation, "path");
+  switch (operation.op) {
+    case "add":
+      return addAt(root, path, requireValue(operation));
+    case "remove":
+      return removeAt(root, path);
+    case "replace":
+      return replaceAt(root, path, requireValue(operation));
+    case "move":
+      return moveAt(root, requirePointer(operation, "from"), path);
+    case "copy":
+      return addAt(root, path, structuredClone(getAt(root, requirePointer(operation, "from"))));
+    default:
+      if (!jsonEqual(getAt(root, path), requireValue(operation))) {
+        throw new Error(`JSON Patch: test failed at "${operation.path}"`);
+      }
+      return root;
+  }
+}
+
+/**
+ * Applies the JSON Patch `patch` (RFC 6902) to `document` and returns the resulting document.
+ *
+ * Operations apply in order, each to the result of the previous one. Neither `document` nor `patch`
+ * is mutated, and the result shares no structure with them. Throws an `Error` when `patch` is not a
+ * valid JSON Patch or when an operation fails (including a failed `test`); no partial result is returned.
+ */
+export function applyPatch(document: JsonValue, patch: PatchOperation[]): JsonValue {
+  if (!Array.isArray(patch)) throw new Error("Invalid JSON Patch: must be an array of operations");
+  return patch.reduce<JsonValue>(applyOperation, structuredClone(document));
+}
