diff --git a/src/merge-patch.ts b/src/merge-patch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..074a3d25e71b006967ca24c84f8cdc9d8621cccf
--- /dev/null
+++ b/src/merge-patch.ts
@@ -0,0 +1,39 @@
+import { isJsonValue } from "./patch.ts";
+import type { JsonValue } from "./pointer.ts";
+
+type JsonObject = { [key: string]: JsonValue };
+
+function isPlainObject(value: unknown): value is JsonObject {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setMember(object: JsonObject, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** MergePatch(Target, Patch) of RFC 7386 §2; works on values already known to be JSON. */
+function merge(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isPlainObject(patch)) return structuredClone(patch);
+  const result: JsonObject = {};
+  if (isPlainObject(target)) {
+    for (const [key, value] of Object.entries(target)) setMember(result, key, structuredClone(value));
+  }
+  for (const [key, value] of Object.entries(patch)) {
+    if (value === null) delete result[key];
+    else setMember(result, key, merge(Object.hasOwn(result, key) ? result[key] : {}, value));
+  }
+  return result;
+}
+
+/**
+ * Applies the JSON Merge Patch `patch` (RFC 7386) to `target` and returns the merged document.
+ *
+ * A non-object patch replaces the target; an object patch is merged member by member, where a `null`
+ * member removes the target's member. Arrays are replaced, never merged. Neither argument is mutated
+ * and the result shares no structure with them. Throws an `Error` if `target` or `patch` is not JSON.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonValue(target)) throw new Error("Invalid JSON Merge Patch: the target must be JSON");
+  if (!isJsonValue(patch)) throw new Error("Invalid JSON Merge Patch: the patch must be JSON");
+  return merge(target, patch);
+}
