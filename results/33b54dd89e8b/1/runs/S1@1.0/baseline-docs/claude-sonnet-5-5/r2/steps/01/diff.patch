new file mode 100644
index 0000000000000000000000000000000000000000..df36534454ea5bdddf283901b4f3dbe0c15e0c4d
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,60 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// The example document of RFC 6901 §5.
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("resolves the RFC 6901 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("decodes ~01 as ~1, not as /", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("returns null and falsy values that are present", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer({ a: false }, "/a"), false);
+});
+
+test("rejects invalid pointers", () => {
+  for (const pointer of ["foo", "#/foo", "/a~", "/a~2", "/a~b"]) {
+    assert.throws(() => resolvePointer(doc, pointer), /Invalid JSON Pointer/, pointer);
+  }
+});
+
+test("rejects pointers that do not resolve", () => {
+  const cases = ["/nope", "/foo/2", "/foo/-", "/foo/01", "/foo/+1", "/foo/-1", "/foo/1.0", "/foo/x", "/foo/0/0", "/a/b"];
+  for (const pointer of cases) {
+    assert.throws(() => resolvePointer(doc, pointer), /does not resolve/, pointer);
+  }
+});
+
+test("only follows own members", () => {
+  for (const pointer of ["/__proto__", "/toString", "/constructor"]) {
+    assert.throws(() => resolvePointer({}, pointer), /does not resolve/, pointer);
+  }
+});
