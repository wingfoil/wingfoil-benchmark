--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,59 @@
+/** Any value a JSON document can hold. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/** Decodes one reference token (RFC 6901 §4); `~1` becomes `/` and `~0` becomes `~`. */
+function unescapeToken(token: string): string {
+  return token.replace(/~(.?)/g, (_match, next: string) => {
+    if (next === "0") return "~";
+    if (next === "1") return "/";
+    throw new Error(`Invalid JSON Pointer: bad escape "~${next}"`);
+  });
+}
+
+/** Splits a pointer into its decoded reference tokens (RFC 6901 §3). */
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: must be a string");
+  }
+  if (pointer === "") return [];
+  if (!pointer.startsWith("/")) {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+/** Resolves one reference token against a value (RFC 6901 §4); throws when it does not exist. */
+function step(current: unknown, token: string): unknown {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+      throw new Error(`JSON Pointer does not resolve: no array element "${token}"`);
+    }
+    return current[Number(token)];
+  }
+  if (typeof current === "object" && current !== null) {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new Error(`JSON Pointer does not resolve: no member "${token}"`);
+    }
+    return (current as Record<string, unknown>)[token];
+  }
+  throw new Error(`JSON Pointer does not resolve: cannot descend into a scalar at "${token}"`);
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer `pointer` refers to (RFC 6901).
+ *
+ * The empty pointer refers to the whole document. Throws an `Error` when `pointer` is not a valid
+ * JSON Pointer, or when it does not resolve to a value of `document` (missing member, array index
+ * out of range or with leading zeros, the end-of-array token `-`, or a path through a scalar).
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  return parsePointer(pointer).reduce<unknown>(step, document) as JsonValue;
+}
