diff --git a/src/patch.ts b/src/patch.ts
index 49063bf9e05cfc818e5f3a728367e524b8316ba7..f76249a34c60eab0ad72e6ceb4ecbb77d99360b7 100644
--- a/src/patch.ts
+++ b/src/patch.ts
@@ -26,10 +26,21 @@ function requirePointer(operation: Record<string, unknown>, name: "path" | "from
   return parsePointer(operation[name]);
 }
 
+/** True if `value` is made only of null, booleans, finite numbers, strings, arrays and plain objects. */
+function isJsonValue(value: unknown): boolean {
+  if (value === null || typeof value === "boolean" || typeof value === "string") return true;
+  if (typeof value === "number") return Number.isFinite(value);
+  if (Array.isArray(value)) return Array.from(value, (item) => item).every(isJsonValue);
+  if (!isObject(value)) return false;
+  const prototype = Object.getPrototypeOf(value);
+  return (prototype === Object.prototype || prototype === null) && Object.values(value).every(isJsonValue);
+}
+
 function requireValue(operation: Record<string, unknown>): JsonValue {
   if (!hasOwn(operation, "value") || operation.value === undefined) {
     throw new Error(`Invalid JSON Patch: "${operation.op}" needs a "value"`);
   }
+  if (!isJsonValue(operation.value)) throw new Error(`Invalid JSON Patch: "${operation.op}" needs a JSON "value"`);
   return structuredClone(operation.value) as JsonValue;
 }
 
