+++ b/test/pointer.test.ts
@@ -0,0 +1,84 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// The example document of RFC 6901, section 5.
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+const rfcCases: [string, unknown][] = [
+  ["", doc],
+  ["/foo", ["bar", "baz"]],
+  ["/foo/0", "bar"],
+  ["/", 0],
+  ["/a~1b", 1],
+  ["/c%d", 2],
+  ["/e^f", 3],
+  ["/g|h", 4],
+  ["/i\\j", 5],
+  ['/k"l', 6],
+  ["/ ", 7],
+  ["/m~0n", 8],
+];
+
+for (const [pointer, expected] of rfcCases) {
+  test(`RFC 6901 example "${pointer}"`, () => {
+    assert.deepEqual(resolvePointer(doc, pointer), expected);
+  });
+}
+
+test("escapes decode in the right order: ~01 is the token ~1", () => {
+  assert.equal(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+});
+
+test("resolves null and falsy values", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer({ a: false }, "/a"), false);
+});
+
+test("resolves into nested arrays and objects", () => {
+  assert.equal(resolvePointer({ a: [{ b: [1, 2] }] }, "/a/0/b/1"), 2);
+});
+
+test("rejects pointers that are not valid", () => {
+  for (const pointer of ["foo", "a/b", "/a~", "/a~2", "/~"]) {
+    assert.throws(() => resolvePointer(doc, pointer), /Invalid JSON Pointer/, pointer);
+  }
+});
+
+test("rejects references to missing members", () => {
+  assert.throws(() => resolvePointer(doc, "/nope"), /does not resolve/);
+  assert.throws(() => resolvePointer(doc, "/foo/2"), /does not resolve/);
+});
+
+test("rejects '-', leading zeros, signs and non-digits as array indices", () => {
+  for (const token of ["-", "01", "+1", "-1", "1.0", "a", ""]) {
+    assert.throws(() => resolvePointer(doc, `/foo/${token}`), /does not resolve/, token);
+  }
+});
+
+test("rejects descending into scalars", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"), /does not resolve/);
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"), /does not resolve/);
+  assert.throws(() => resolvePointer("text", "/0"), /does not resolve/);
+});
+
+test("does not follow inherited properties", () => {
+  for (const pointer of ["/__proto__", "/constructor", "/toString", "/foo/length"]) {
+    assert.throws(() => resolvePointer(doc, pointer), /does not resolve/, pointer);
+  }
+});
+
+test("a numeric-looking token is a member name on objects", () => {
+  assert.equal(resolvePointer({ "0": "zero" }, "/0"), "zero");
+});
