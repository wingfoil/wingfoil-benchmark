+++ b/src/index.ts
@@ -0,0 +1,61 @@
+/** Any value that a JSON document can hold. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const INVALID_ESCAPE = /~(?![01])/;
+
+function unescapeToken(token: string): string {
+  if (INVALID_ESCAPE.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in token "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+function step(current: unknown, token: string, pointer: string): JsonValue {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: no array element "${token}"`);
+    }
+    return current[Number(token)];
+  }
+  if (typeof current === "object" && current !== null) {
+    if (!Object.hasOwn(current, token)) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: no member "${token}"`);
+    }
+    return (current as Record<string, JsonValue>)[token];
+  }
+  throw new Error(`JSON Pointer "${pointer}" does not resolve: cannot descend into a scalar at "${token}"`);
+}
+
+/**
+ * Returns the value that a JSON Pointer (RFC 6901) refers to inside a JSON document.
+ *
+ * The empty pointer refers to the whole document. Only own members are followed, so
+ * pointers such as "/__proto__" or "/constructor" never reach inherited properties.
+ *
+ * @throws Error if `pointer` is not a valid JSON Pointer, or does not resolve to a value of `document`
+ * (missing member, out-of-range or non-canonical array index, the "-" end-of-array token, or a scalar
+ * traversed as a container).
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  return parsePointer(pointer).reduce<JsonValue>((current, token) => step(current, token, pointer), document);
+}
