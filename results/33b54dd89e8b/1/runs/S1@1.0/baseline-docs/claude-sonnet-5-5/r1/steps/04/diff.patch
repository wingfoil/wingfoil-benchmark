new file mode 100644
index 0000000000000000000000000000000000000000..0f19bc52da1c3e5f279cf7e30fad9c1ff8a80ed0
--- /dev/null
+++ b/src/merge-patch.ts
@@ -0,0 +1,41 @@
+import type { JsonValue } from "./pointer.ts";
+
+type JsonObject = { [key: string]: JsonValue };
+
+function isObject(value: JsonValue | undefined): value is JsonObject {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Sets an own member, so that a key such as "__proto__" cannot alter the prototype. */
+function setMember(object: JsonObject, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { value, enumerable: true, writable: true, configurable: true });
+}
+
+function merge(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result: JsonObject = {};
+  if (isObject(target)) {
+    for (const [key, value] of Object.entries(target)) {
+      setMember(result, key, structuredClone(value));
+    }
+  }
+  for (const [key, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, merge(Object.hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to `target` and returns the merged document as a new value;
+ * neither argument is mutated. A non-object patch replaces the target, `null` members of an object
+ * patch delete the matching member, and other members are merged recursively.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  return merge(target, patch);
+}
