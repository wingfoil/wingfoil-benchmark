index 0000000000000000000000000000000000000000..cee21a46c5fb29d22a9e2670948e52bff98a3906
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,48 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+import type { JsonValue } from "../src/index.ts";
+
+const parse = (text: string): JsonValue => JSON.parse(text) as JsonValue;
+
+// Examples of RFC 7386, appendix A.
+const rfcCases: [JsonValue, JsonValue, JsonValue][] = [
+  [{ a: "b" }, { a: "c" }, { a: "c" }],
+  [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  [{ a: "b" }, { a: null }, {}],
+  [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+  [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+  [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  [["a", "b"], ["c", "d"], ["c", "d"]],
+  [{ a: "b" }, ["c"], ["c"]],
+  [{ a: "foo" }, null, null],
+  [{ a: "foo" }, "bar", "bar"],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: "b", c: null }, { a: "b" }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+
+for (const [target, patch, expected] of rfcCases) {
+  test(`RFC 7386 A: ${JSON.stringify(target)} + ${JSON.stringify(patch)}`, () => {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  });
+}
+
+test("does not mutate target or patch, and shares no structure with them", () => {
+  const target = { a: { b: 1 }, c: [1] };
+  const patch = { a: { d: 2 }, e: { f: [3] } };
+  const result = applyMergePatch(target, patch) as { a: object; e: { f: unknown } };
+  assert.deepEqual(target, { a: { b: 1 }, c: [1] });
+  assert.deepEqual(patch, { a: { d: 2 }, e: { f: [3] } });
+  assert.notEqual(result.e, patch.e);
+  assert.notEqual(result.e.f, patch.e.f);
+});
+
+test("treats __proto__ as an ordinary member", () => {
+  const result = applyMergePatch({}, parse('{"__proto__": {"polluted": true}}')) as object;
+  assert.equal(Object.hasOwn(result, "__proto__"), true);
+  assert.equal(({} as { polluted?: boolean }).polluted, undefined);
+  assert.equal((result as { polluted?: boolean }).polluted, undefined);
+});
