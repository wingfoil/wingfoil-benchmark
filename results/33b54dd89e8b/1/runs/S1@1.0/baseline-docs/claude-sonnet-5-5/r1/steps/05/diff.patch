index 0000000000000000000000000000000000000000..edae8aef4ac0ce591319bcaebc3b01311a14063a
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,71 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+import type { JsonValue } from "../src/index.ts";
+
+function roundTrip(from: JsonValue, to: JsonValue) {
+  const before = structuredClone([from, to]);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual([from, to], before);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a changed member yields a single replace", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: { c: [1, 2] }, d: "x" }, { a: 1, b: { c: [1, 3] }, d: "x" }), [
+    { op: "replace", path: "/b/c/1", value: 3 },
+  ]);
+});
+
+test("added and removed members", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, c: 3 }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("array insertion in the middle is one add", () => {
+  assert.deepEqual(roundTrip([1, 2, 4, 5], [1, 2, 3, 4, 5]), [{ op: "add", path: "/2", value: 3 }]);
+});
+
+test("array removal and truncation", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 4]), [
+    { op: "remove", path: "/1" },
+    { op: "remove", path: "/1" },
+  ]);
+  roundTrip([1, 2, 3], []);
+  roundTrip([], [1, 2]);
+});
+
+test("type changes and the root", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  roundTrip(null, { a: null });
+  roundTrip({ a: [] }, { a: {} });
+  roundTrip(1, 2);
+});
+
+test("keys needing escaping, including __proto__", () => {
+  const from = JSON.parse('{"a/b":1,"m~n":1,"__proto__":{"x":1}}') as JsonValue;
+  const to = JSON.parse('{"a/b":2,"m~n":2,"__proto__":{"x":2}}') as JsonValue;
+  const patch = roundTrip(from, to);
+  assert.deepEqual(patch.map((o) => o.path), ["/a~1b", "/m~0n", "/__proto__/x"]);
+});
+
+test("the patch shares no structure with the inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0] as { value: { b: number } }).value.b = 9;
+  assert.equal(to.a.b, 1);
+});
+
+test("mixed nested arrays of objects", () => {
+  const patch = roundTrip(
+    { items: [{ id: 1, n: "a" }, { id: 2, n: "b" }, { id: 3, n: "c" }] },
+    { items: [{ id: 1, n: "a" }, { id: 2, n: "B" }, { id: 3, n: "c" }, { id: 4, n: "d" }] },
+  );
+  assert.equal(patch.length, 2);
+});
