diff --git a/src/diff.ts b/src/diff.ts
new file mode 100644
index 0000000000000000000000000000000000000000..04689387b318b1d347c785135822f3696e972666
--- /dev/null
+++ b/src/diff.ts
@@ -0,0 +1,96 @@
+import type { JsonValue } from "./pointer.ts";
+import type { PatchOperation } from "./patch.ts";
+
+type JsonObject = { [key: string]: JsonValue };
+
+function isObject(value: JsonValue): value is JsonObject {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function childPath(path: string, token: string | number): string {
+  return `${path}/${escapeToken(String(token))}`;
+}
+
+function diffObjects(from: JsonObject, to: JsonObject, path: string): PatchOperation[] {
+  const removed = Object.keys(from).filter((key) => !Object.hasOwn(to, key));
+  const operations: PatchOperation[] = removed.map((key) => ({ op: "remove", path: childPath(path, key) }));
+  for (const key of Object.keys(to)) {
+    if (Object.hasOwn(from, key)) {
+      operations.push(...diff(from[key], to[key], childPath(path, key)));
+    } else {
+      operations.push({ op: "add", path: childPath(path, key), value: structuredClone(to[key]) });
+    }
+  }
+  return operations;
+}
+
+function commonPrefix(from: JsonValue[], to: JsonValue[]): number {
+  let length = 0;
+  while (length < from.length && length < to.length && diff(from[length], to[length], "").length === 0) {
+    length++;
+  }
+  return length;
+}
+
+function commonSuffix(from: JsonValue[], to: JsonValue[], prefix: number): number {
+  let length = 0;
+  while (
+    length < from.length - prefix &&
+    length < to.length - prefix &&
+    diff(from[from.length - 1 - length], to[to.length - 1 - length], "").length === 0
+  ) {
+    length++;
+  }
+  return length;
+}
+
+/**
+ * Diffs arrays by trimming the unchanged head and tail, then comparing the remaining elements
+ * pairwise; surplus elements of `from` are removed and surplus elements of `to` are added.
+ */
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string): PatchOperation[] {
+  const prefix = commonPrefix(from, to);
+  const suffix = commonSuffix(from, to, prefix);
+  const fromEnd = from.length - suffix;
+  const toEnd = to.length - suffix;
+  const paired = Math.min(fromEnd, toEnd) - prefix;
+  const operations: PatchOperation[] = [];
+  for (let i = 0; i < paired; i++) {
+    operations.push(...diff(from[prefix + i], to[prefix + i], childPath(path, prefix + i)));
+  }
+  for (let i = prefix + paired; i < fromEnd; i++) {
+    operations.push({ op: "remove", path: childPath(path, prefix + paired) });
+  }
+  for (let i = prefix + paired; i < toEnd; i++) {
+    operations.push({ op: "add", path: childPath(path, i), value: structuredClone(to[i]) });
+  }
+  return operations;
+}
+
+function diff(from: JsonValue, to: JsonValue, path: string): PatchOperation[] {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    return diffArrays(from, to, path);
+  }
+  if (isObject(from) && isObject(to)) {
+    return diffObjects(from, to, path);
+  }
+  if (from === to) {
+    return [];
+  }
+  return [{ op: "replace", path, value: structuredClone(to) }];
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch holds only the changes: unchanged members and elements are left out, and objects and
+ * arrays are compared recursively, so a small difference yields a small patch. Equal documents give
+ * an empty patch. Neither input is mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  return diff(from, to, "");
+}
