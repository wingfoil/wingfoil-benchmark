--- /dev/null
+++ b/src/json-pointer.ts
@@ -0,0 +1,90 @@
+/**
+ * A JSON value, as defined by RFC 8259.
+ */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+/**
+ * Raised when a JSON Pointer is malformed or does not resolve to a value of the document.
+ */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+/** An array index as RFC 6901 defines it: "0", or a non-zero digit followed by digits. */
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * The whole pointer is validated before the document is walked, so a malformed pointer is
+ * reported as such even when an earlier token would also fail to resolve.
+ *
+ * @param document - The JSON document to resolve the pointer against.
+ * @param pointer - A JSON Pointer string; the empty string refers to the whole document.
+ * @returns The value the pointer refers to, which may be `null`.
+ * @throws {JsonPointerError} If the pointer is not a valid JSON Pointer, or it does not resolve
+ * to a value of the document.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  return parseTokens(pointer).reduce(step, document);
+}
+
+/**
+ * Splits a pointer into its unescaped reference tokens. The empty pointer has no tokens.
+ */
+function parseTokens(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("a JSON Pointer must be a string");
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new JsonPointerError(`JSON Pointer "${pointer}" must be empty or start with "/"`);
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+/**
+ * Decodes "~1" to "/" and "~0" to "~". Any other "~" is not a valid escape sequence.
+ * The decoding is a single pass, so "~01" decodes to "~1" and not to "/".
+ */
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new JsonPointerError(`invalid escape sequence in JSON Pointer token "${token}"`);
+  }
+  return token.replace(/~([01])/g, (_, escaped: string) => (escaped === "0" ? "~" : "/"));
+}
+
+/**
+ * Moves from a value to the child that a reference token names.
+ */
+function step(current: JsonValue, token: string): JsonValue {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token)) {
+      throw new JsonPointerError(`"${token}" is not a valid array index`);
+    }
+    const index = Number(token);
+    if (index >= current.length) {
+      throw new JsonPointerError(`array index ${index} is out of range`);
+    }
+    return current[index];
+  }
+  if (current !== null && typeof current === "object") {
+    // Own properties only, so that inherited names such as "constructor" do not resolve.
+    if (!Object.hasOwn(current, token)) {
+      throw new JsonPointerError(`no member "${token}" in the object`);
+    }
+    return current[token];
+  }
+  throw new JsonPointerError(`cannot resolve "${token}" inside a scalar value`);
+}
