@@ -0,0 +1,94 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer, JsonPointerError } from "./index.ts";
+
+// The example document of RFC 6901, section 5.
+const rfcDocument = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("the empty pointer refers to the whole document", () => {
+  assert.equal(resolvePointer(rfcDocument, ""), rfcDocument);
+});
+
+test("resolves the RFC 6901 examples", () => {
+  assert.deepEqual(resolvePointer(rfcDocument, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfcDocument, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfcDocument, "/"), 0);
+  assert.equal(resolvePointer(rfcDocument, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfcDocument, "/c%d"), 2);
+  assert.equal(resolvePointer(rfcDocument, "/e^f"), 3);
+  assert.equal(resolvePointer(rfcDocument, "/g|h"), 4);
+  assert.equal(resolvePointer(rfcDocument, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfcDocument, '/k"l'), 6);
+  assert.equal(resolvePointer(rfcDocument, "/ "), 7);
+  assert.equal(resolvePointer(rfcDocument, "/m~0n"), 8);
+});
+
+test("a null value is a value of the document", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+});
+
+test("resolves through nested objects and arrays", () => {
+  const document = { a: [{ b: { c: [10, 20, 30] } }] };
+  assert.equal(resolvePointer(document, "/a/0/b/c/2"), 30);
+});
+
+test("the last array element is reachable by its index, not by '-'", () => {
+  assert.equal(resolvePointer({ list: [1, 2, 3] }, "/list/2"), 3);
+});
+
+test("rejects a pointer that does not start with '/'", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "foo"), JsonPointerError);
+});
+
+test("rejects an invalid escape sequence", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/~2"), JsonPointerError);
+  assert.throws(() => resolvePointer(rfcDocument, "/a~"), JsonPointerError);
+});
+
+test("rejects an array index with a leading zero", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/foo/01"), JsonPointerError);
+});
+
+test("rejects a non-numeric token used on an array", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/foo/first"), JsonPointerError);
+});
+
+test("rejects the '-' token, which refers past the end of an array", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/foo/-"), JsonPointerError);
+});
+
+test("rejects an array index out of range", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/foo/2"), JsonPointerError);
+});
+
+test("rejects a key that the object does not have", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/missing"), JsonPointerError);
+});
+
+test("does not resolve inherited properties", () => {
+  assert.throws(() => resolvePointer({}, "/constructor"), JsonPointerError);
+  assert.throws(() => resolvePointer({}, "/__proto__"), JsonPointerError);
+});
+
+test("rejects descending into a scalar", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/foo/0/x"), JsonPointerError);
+  assert.throws(() => resolvePointer({ n: 1 }, "/n/x"), JsonPointerError);
+});
+
+test("rejects a pointer that is not a string", () => {
+  assert.throws(
+    () => resolvePointer(rfcDocument, undefined as unknown as string),
+    JsonPointerError,
+  );
+});
