index 0000000000000000000000000000000000000000..3a1911d8d6015e0ba113b92f5924e0e871ae2eea
--- /dev/null
+++ b/src/json-merge-patch.ts
@@ -0,0 +1,59 @@
+import type { JsonValue } from "./json-pointer.ts";
+import { cloneJson, isJsonObject, isJsonValue, setMember, type JsonObject } from "./json-value.ts";
+
+/**
+ * Raised when the target or the patch of a JSON Merge Patch is not a JSON value.
+ */
+export class JsonMergePatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonMergePatchError";
+  }
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document.
+ *
+ * A patch that is an object merges into the target: a member set to `null` is removed from the
+ * target, and any other member is merged recursively into the target's member of the same name.
+ * Where the target is not an object, it is replaced by an empty object first. Any other patch,
+ * including an array or a scalar, replaces the target as a whole.
+ *
+ * The target and the patch are not modified: the result is a new value, which shares no structure
+ * with them.
+ *
+ * @param target - The JSON document to change.
+ * @param patch - The partial document to merge into the target.
+ * @returns The merged document.
+ * @throws {JsonMergePatchError} If the target or the patch is not a JSON value.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonValue(target)) {
+    throw new JsonMergePatchError("the target is not a JSON value");
+  }
+  if (!isJsonValue(patch)) {
+    throw new JsonMergePatchError("the patch is not a JSON value");
+  }
+  return merge(cloneJson(target), patch);
+}
+
+/**
+ * Merges a patch into a target that the caller owns: the target is changed in place, and only
+ * the values copied from the patch are new. The target may be `undefined`, for a member the target
+ * does not have.
+ */
+function merge(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return cloneJson(patch);
+  }
+  const result: JsonObject = isJsonObject(target) ? target : {};
+  for (const [key, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = Object.hasOwn(result, key) ? result[key] : undefined;
+      setMember(result, key, merge(current, value));
+    }
+  }
+  return result;
+}
