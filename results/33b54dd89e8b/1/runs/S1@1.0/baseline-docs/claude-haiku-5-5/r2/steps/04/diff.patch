@@ -0,0 +1,70 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch, JsonMergePatchError } from "./index.ts";
+
+// The examples of RFC 7386, appendix A.
+const rfcExamples: [string, unknown, unknown, unknown][] = [
+  ["replaces a member", { a: "b" }, { a: "c" }, { a: "c" }],
+  ["adds a member", { a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  ["removes a member set to null", { a: "b" }, { a: null }, {}],
+  ["removes only the member set to null", { a: "b", b: "c" }, { a: null }, { b: "c" }],
+  ["replaces an array with a string", { a: ["b"] }, { a: "c" }, { a: "c" }],
+  ["replaces a string with an array", { a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  ["merges nested objects", { a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  ["replaces an array of objects", { a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  ["replaces an array", ["a", "b"], ["c", "d"], ["c", "d"]],
+  ["replaces an object with an array", { a: "b" }, ["c"], ["c"]],
+  ["replaces a member with null", { a: "foo" }, null, null],
+  ["replaces a member with a scalar", { a: "foo" }, "bar", "bar"],
+  ["keeps a null member that is not patched", { e: null }, { a: 1 }, { e: null, a: 1 }],
+  ["replaces an array with an object", [1, 2], { a: "b", c: null }, { a: "b" }],
+  ["creates nested objects, dropping null members", {}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+
+for (const [name, target, patch, expected] of rfcExamples) {
+  test(`merge patch ${name} (RFC 7386 appendix A)`, () => {
+    assert.deepEqual(applyMergePatch(target as never, patch as never), expected);
+  });
+}
+
+test("merge patch with an object creates the members of a non-object target", () => {
+  assert.deepEqual(applyMergePatch(5, { a: 1 }), { a: 1 });
+  assert.deepEqual(applyMergePatch(null, { a: { b: 2 } }), { a: { b: 2 } });
+});
+
+test("merge patch with a null member on a missing key leaves the target unchanged", () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, { missing: null }), { a: 1 });
+});
+
+test("merge patch does not modify the target or the patch", () => {
+  const target = { a: { b: 1 }, c: [1] };
+  const patch = { a: { d: { e: 2 } }, f: { g: null } };
+  const result = applyMergePatch(target, patch);
+  assert.deepEqual(target, { a: { b: 1 }, c: [1] });
+  assert.deepEqual(patch, { a: { d: { e: 2 } }, f: { g: null } });
+  assert.deepEqual(result, { a: { b: 1, d: { e: 2 } }, c: [1], f: {} });
+});
+
+test("merge patch result shares no structure with the patch", () => {
+  const patch = { a: { b: [1] } };
+  const result = applyMergePatch({}, patch) as { a: { b: number[] } };
+  result.a.b.push(2);
+  assert.deepEqual(patch, { a: { b: [1] } });
+});
+
+test("merge patch defines a member named __proto__ as an own property", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"polluted":true}}'));
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(JSON.parse(JSON.stringify(result)), JSON.parse('{"__proto__":{"polluted":true}}'));
+  assert.equal(({} as { polluted?: boolean }).polluted, undefined);
+});
+
+test("merge patch rejects a target that is not a JSON value", () => {
+  assert.throws(() => applyMergePatch(undefined as never, {}), JsonMergePatchError);
+  assert.throws(() => applyMergePatch({ a: Number.NaN }, {}), JsonMergePatchError);
+});
+
+test("merge patch rejects a patch that is not a JSON value", () => {
+  assert.throws(() => applyMergePatch({}, undefined as never), JsonMergePatchError);
+  assert.throws(() => applyMergePatch({}, { a: () => 1 } as never), JsonMergePatchError);
+});
