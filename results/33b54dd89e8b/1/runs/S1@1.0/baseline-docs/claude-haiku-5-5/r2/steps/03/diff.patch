diff --git a/src/json-patch.test.ts b/src/json-patch.test.ts
index 5d1cec912c0126703b3519da61eb893ec4dd1198..a319597d425d3ddcfd3c8fb61c923b6466a41245 100644
--- a/src/json-patch.test.ts
+++ b/src/json-patch.test.ts
@@ -341,3 +341,51 @@ test("RFC 6902 appendix A: '~' escapes are decoded in a pointer", () => {
     "~1": 10,
   });
 });
+
+// The patch is checked for shape before any operation runs, so a malformed pointer is reported as
+// such, with the pointer error as cause, even when an earlier operation would fail.
+test("a malformed pointer later in the patch is reported before an earlier operation fails", () => {
+  assert.throws(
+    () =>
+      applyPatch({ a: 1 }, [
+        { op: "test", path: "/a", value: 2 },
+        { op: "add", path: "x", value: 1 },
+      ] as never),
+    (error: unknown) =>
+      error instanceof JsonPatchError &&
+      error.cause instanceof JsonPointerError &&
+      /malformed/.test(error.message),
+  );
+});
+
+test("a malformed 'path' of move is reported as malformed, not as moving into a child", () => {
+  assert.throws(
+    () => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/~2" }] as never),
+    (error: unknown) =>
+      error instanceof JsonPatchError &&
+      error.cause instanceof JsonPointerError &&
+      /malformed/.test(error.message),
+  );
+});
+
+test("a malformed 'from' of move or copy is reported before the source is looked up", () => {
+  assert.throws(
+    () => applyPatch({}, [{ op: "move", from: "x", path: "/b" }] as never),
+    (error: unknown) => error instanceof JsonPatchError && error.cause instanceof JsonPointerError,
+  );
+  assert.throws(
+    () => applyPatch({}, [{ op: "copy", from: "/x/~2", path: "/b" }] as never),
+    (error: unknown) => error instanceof JsonPatchError && error.cause instanceof JsonPointerError,
+  );
+});
+
+test("a sparse patch array is rejected with a JsonPatchError", () => {
+  assert.throws(() => applyPatch({}, new Array(2) as never), JsonPatchError);
+});
+
+test("the document must be a JSON value", () => {
+  assert.throws(() => applyPatch(undefined as never, []), JsonPatchError);
+  assert.throws(() => applyPatch({ n: Number.NaN }, []), JsonPatchError);
+  assert.throws(() => applyPatch({ d: new Date(0) } as never, []), JsonPatchError);
+  assert.throws(() => applyPatch({ u: undefined } as never, []), JsonPatchError);
+});
