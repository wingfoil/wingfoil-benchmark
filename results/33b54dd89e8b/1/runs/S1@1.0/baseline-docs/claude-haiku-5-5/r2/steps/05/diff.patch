index 0000000000000000000000000000000000000000..0ef0b362a44aa0b46382ef99bd4c67cecfae83b3
--- /dev/null
+++ b/src/json-patch-diff.ts
@@ -0,0 +1,201 @@
+import { JsonPatchError, type JsonPatch, type JsonPatchOperation } from "./json-patch.ts";
+import type { JsonValue } from "./json-pointer.ts";
+import { cloneJson, isJsonObject, isJsonValue, jsonEqual, type JsonObject } from "./json-value.ts";
+
+/**
+ * The largest alignment table, in cells, that the array comparison builds. An array whose changed
+ * middle is larger than this is paired by position: the patch is still correct, but it may be
+ * longer than the smallest possible one.
+ */
+const MAX_ALIGNMENT_CELLS = 4_000_000;
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when it is applied with `applyPatch`.
+ *
+ * The patch describes only what changed. Members and elements that are equal in both documents
+ * produce no operation. A member that is added or removed produces one `add` or `remove`, and an
+ * array element that is inserted or removed produces one operation: the elements after it are not
+ * sent again. A value that changed in place is replaced at its own pointer, and a value whose type
+ * changed is replaced as a whole.
+ *
+ * Neither input is modified, and the values in the patch are copies, so the patch shares no
+ * structure with either document.
+ *
+ * @param from - The JSON document that the patch starts from.
+ * @param to - The JSON document that the patch produces.
+ * @returns The operations, in an order in which each one applies to the result of the previous one.
+ * The patch is empty when the documents are equal.
+ * @throws {JsonPatchError} If either document is not a JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatch {
+  if (!isJsonValue(from)) {
+    throw new JsonPatchError("the source is not a JSON value");
+  }
+  if (!isJsonValue(to)) {
+    throw new JsonPatchError("the target is not a JSON value");
+  }
+  const operations: JsonPatchOperation[] = [];
+  diff(from, to, "", operations);
+  return operations;
+}
+
+function diff(
+  from: JsonValue,
+  to: JsonValue,
+  path: string,
+  operations: JsonPatchOperation[],
+): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(from, to, path, operations);
+  } else if (isJsonObject(from) && isJsonObject(to)) {
+    diffObject(from, to, path, operations);
+  } else {
+    operations.push({ op: "replace", path, value: cloneJson(to) });
+  }
+}
+
+function diffObject(
+  from: JsonObject,
+  to: JsonObject,
+  path: string,
+  operations: JsonPatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    const pointer = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(to, key)) {
+      diff(from[key], to[key], pointer, operations);
+    } else {
+      operations.push({ op: "remove", path: pointer });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (!Object.hasOwn(from, key)) {
+      const pointer = `${path}/${escapeToken(key)}`;
+      operations.push({ op: "add", path: pointer, value: cloneJson(to[key]) });
+    }
+  }
+}
+
+/**
+ * Compares two arrays in three steps. The elements at both ends that are equal are skipped; the
+ * elements in between are aligned, so that the elements common to both arrays stay in place; and
+ * each gap between two aligned elements is turned into operations on the array as it is at that
+ * point. The operations keep track of the current index, since each one changes the indexes after
+ * it.
+ */
+function diffArray(
+  from: JsonValue[],
+  to: JsonValue[],
+  path: string,
+  operations: JsonPatchOperation[],
+): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+    start++;
+  }
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && jsonEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+
+  let index = start;
+  let fromNext = start;
+  let toNext = start;
+  for (const [fromAnchor, toAnchor] of alignElements(from, fromNext, fromEnd, to, toNext, toEnd)) {
+    index = diffGap(from, fromNext, fromAnchor, to, toNext, toAnchor, path, index, operations);
+    fromNext = fromAnchor + 1;
+    toNext = toAnchor + 1;
+    index++;
+  }
+  diffGap(from, fromNext, fromEnd, to, toNext, toEnd, path, index, operations);
+}
+
+/**
+ * Turns the difference between two runs of unaligned elements into operations. The elements that
+ * occupy the same position are compared with each other; the surplus of one run is removed or added
+ * at the position where it sits. Returns the index of the element after the run, in the array as
+ * it is once the operations have been applied.
+ */
+function diffGap(
+  from: JsonValue[],
+  fromStart: number,
+  fromEnd: number,
+  to: JsonValue[],
+  toStart: number,
+  toEnd: number,
+  path: string,
+  index: number,
+  operations: JsonPatchOperation[],
+): number {
+  const paired = Math.min(fromEnd - fromStart, toEnd - toStart);
+  let position = index;
+  for (let offset = 0; offset < paired; offset++) {
+    diff(from[fromStart + offset], to[toStart + offset], `${path}/${position}`, operations);
+    position++;
+  }
+  for (let offset = fromStart + paired; offset < fromEnd; offset++) {
+    operations.push({ op: "remove", path: `${path}/${position}` });
+  }
+  for (let offset = toStart + paired; offset < toEnd; offset++) {
+    operations.push({ op: "add", path: `${path}/${position}`, value: cloneJson(to[offset]) });
+    position++;
+  }
+  return position;
+}
+
+/**
+ * Finds a longest common subsequence of two runs of elements, compared by content. Returns the
+ * matched pairs of indexes, in order. The table has a cell for every pair of positions, so a run
+ * pair larger than `MAX_ALIGNMENT_CELLS` is not aligned at all.
+ */
+function alignElements(
+  from: JsonValue[],
+  fromStart: number,
+  fromEnd: number,
+  to: JsonValue[],
+  toStart: number,
+  toEnd: number,
+): [number, number][] {
+  const rows = fromEnd - fromStart + 1;
+  const columns = toEnd - toStart + 1;
+  if (rows * columns > MAX_ALIGNMENT_CELLS) {
+    return [];
+  }
+  // lengths[i][j]: the length of a longest common subsequence of
+  // from[fromStart + i..] and to[toStart + j..].
+  const lengths = Array.from({ length: rows }, () => new Array<number>(columns).fill(0));
+  for (let i = rows - 2; i >= 0; i--) {
+    for (let j = columns - 2; j >= 0; j--) {
+      lengths[i][j] = jsonEqual(from[fromStart + i], to[toStart + j])
+        ? lengths[i + 1][j + 1] + 1
+        : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  const pairs: [number, number][] = [];
+  let i = 0;
+  let j = 0;
+  while (i < rows - 1 && j < columns - 1) {
+    if (jsonEqual(from[fromStart + i], to[toStart + j])) {
+      pairs.push([fromStart + i, toStart + j]);
+      i++;
+      j++;
+    } else if (lengths[i + 1][j] >= lengths[i][j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
+
+/**
+ * Escapes a member name as a JSON Pointer reference token (RFC 6901, section 3).
+ */
+function escapeToken(key: string): string {
+  return key.replace(/~/g, "~0").replace(/\//g, "~1");
+}
