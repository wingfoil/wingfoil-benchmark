index 0000000000000000000000000000000000000000..d63d8846240fd9104526676f9f557d24edb5da70
--- /dev/null
+++ b/src/json-patch-diff.test.ts
@@ -0,0 +1,162 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch, JsonPatchError } from "./index.ts";
+
+test("equal documents produce an empty patch", () => {
+  assert.deepEqual(createPatch({ a: [1, { b: "c" }] }, { a: [1, { b: "c" }] }), []);
+});
+
+test("a scalar at the root is replaced as a whole", () => {
+  assert.deepEqual(createPatch(1, 2), [{ op: "replace", path: "", value: 2 }]);
+});
+
+test("a changed member produces a replace of that member only", () => {
+  assert.deepEqual(createPatch({ a: { b: 1, c: 2 } }, { a: { b: 1, c: 3 } }), [
+    { op: "replace", path: "/a/c", value: 3 },
+  ]);
+});
+
+test("an added member produces an add, and a removed member a remove", () => {
+  assert.deepEqual(createPatch({ a: 1 }, { a: 1, b: 2 }), [{ op: "add", path: "/b", value: 2 }]);
+  assert.deepEqual(createPatch({ a: 1, b: 2 }, { a: 1 }), [{ op: "remove", path: "/b" }]);
+});
+
+test("a value whose type changes is replaced as a whole", () => {
+  assert.deepEqual(createPatch({ a: [1] }, { a: { x: 1 } }), [
+    { op: "replace", path: "/a", value: { x: 1 } },
+  ]);
+  assert.deepEqual(createPatch({ a: null }, { a: false }), [
+    { op: "replace", path: "/a", value: false },
+  ]);
+});
+
+test("a changed array element produces a replace of that element only", () => {
+  assert.deepEqual(createPatch({ a: [1, 2, 3] }, { a: [1, 9, 3] }), [
+    { op: "replace", path: "/a/1", value: 9 },
+  ]);
+});
+
+test("elements appended to or removed from the end of an array", () => {
+  assert.deepEqual(createPatch({ a: [1] }, { a: [1, 2, 3] }), [
+    { op: "add", path: "/a/1", value: 2 },
+    { op: "add", path: "/a/2", value: 3 },
+  ]);
+  assert.deepEqual(createPatch({ a: [1, 2, 3] }, { a: [1] }), [
+    { op: "remove", path: "/a/1" },
+    { op: "remove", path: "/a/1" },
+  ]);
+});
+
+test("an element inserted in the middle of an array is one add, not a rewrite of the tail", () => {
+  assert.deepEqual(createPatch([1, 2, 3, 4], [1, 2, 0, 3, 4]), [
+    { op: "add", path: "/2", value: 0 },
+  ]);
+});
+
+test("an element removed from the middle of an array is one remove", () => {
+  assert.deepEqual(createPatch(["a", "b", "c", "d"], ["a", "c", "d"]), [
+    { op: "remove", path: "/1" },
+  ]);
+});
+
+test("an element inserted at the start of an array is one add", () => {
+  assert.deepEqual(createPatch([1, 2, 3], [0, 1, 2, 3]), [{ op: "add", path: "/0", value: 0 }]);
+});
+
+test("a changed element of an array of objects is patched inside that element", () => {
+  assert.deepEqual(
+    createPatch(
+      [
+        { id: 1, v: 1 },
+        { id: 2, v: 2 },
+        { id: 3, v: 3 },
+      ],
+      [
+        { id: 1, v: 1 },
+        { id: 2, v: 5 },
+        { id: 3, v: 3 },
+      ],
+    ),
+    [{ op: "replace", path: "/1/v", value: 5 }],
+  );
+});
+
+test("a repeated element is added or removed once, at the right position", () => {
+  assert.deepEqual(createPatch([1, 1, 1], [1, 1]), [{ op: "remove", path: "/2" }]);
+  assert.deepEqual(createPatch([1, 1], [1, 1, 1]), [{ op: "add", path: "/2", value: 1 }]);
+});
+
+test("a changed element in an array of a different length is paired with its neighbour", () => {
+  assert.deepEqual(createPatch(["a", "x", "c"], ["a", "y", "z", "c"]), [
+    { op: "replace", path: "/1", value: "y" },
+    { op: "add", path: "/2", value: "z" },
+  ]);
+});
+
+test("a large document with one small change produces a patch of one operation", () => {
+  const from = {
+    items: Array.from({ length: 5000 }, (_, index) => ({ id: index, name: `item ${index}` })),
+    meta: { version: 1 },
+  };
+  const to = structuredClone(from);
+  to.items[2500].name = "renamed";
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [{ op: "replace", path: "/items/2500/name", value: "renamed" }]);
+});
+
+test("keys are escaped as JSON Pointer tokens", () => {
+  const from = { "a/b": 1, "m~n": 2 };
+  const to = { "a/b": 3, "m~n": 2, "c~/d": 4 };
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [
+    { op: "replace", path: "/a~1b", value: 3 },
+    { op: "add", path: "/c~0~1d", value: 4 },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("a member named __proto__ is treated as an ordinary member", () => {
+  const from = JSON.parse("{}");
+  const to = JSON.parse('{"__proto__":{"polluted":true}}');
+  assert.deepEqual(createPatch(from, to), [
+    { op: "add", path: "/__proto__", value: { polluted: true } },
+  ]);
+});
+
+test("applying the patch to the source yields the target", () => {
+  const cases: [unknown, unknown][] = [
+    [null, { a: [1, 2] }],
+    [{ a: [1, 2, 3], b: { c: "d" } }, { a: [0, 2, 4], e: null }],
+    [[{ x: 1 }, [2, 3], "s"], [[2, 3], { x: 2 }, "t", true]],
+    [[1, 2, 3, 4, 5, 6], [6, 5, 4, 3, 2, 1]],
+    [{ a: [] }, { a: [[], {}, ""] }],
+    [[1, 2, 3], []],
+  ];
+  for (const [from, to] of cases) {
+    const patch = createPatch(from as never, to as never);
+    assert.deepEqual(applyPatch(from as never, patch), to);
+  }
+});
+
+test("does not mutate either input", () => {
+  const from = { a: [1, { b: 2 }], c: "x" };
+  const to = { a: [1, { b: 3 }, 4], d: { e: [5] } };
+  const fromBefore = JSON.stringify(from);
+  const toBefore = JSON.stringify(to);
+  createPatch(from, to);
+  assert.equal(JSON.stringify(from), fromBefore);
+  assert.equal(JSON.stringify(to), toBefore);
+});
+
+test("the values in the patch share no structure with the target", () => {
+  const to = { a: { b: [1] } };
+  const patch = createPatch({}, to);
+  (patch[0] as { value: { b: number[] } }).value.b.push(2);
+  assert.deepEqual(to, { a: { b: [1] } });
+});
+
+test("rejects a source or target that is not a JSON value", () => {
+  assert.throws(() => createPatch(undefined as never, 1), JsonPatchError);
+  assert.throws(() => createPatch(1, { a: Number.NaN }), JsonPatchError);
+  assert.throws(() => createPatch({ a: () => 1 } as never, {}), JsonPatchError);
+});
