diff --git a/src/json-value.ts b/src/json-value.ts
index 96a501eb793cc8e90e197d46203038d91808a19f..1541e327d8bbc076ea093262838f00c441d5ba50 100644
--- a/src/json-value.ts
+++ b/src/json-value.ts
@@ -37,3 +37,24 @@ export function setMember(object: JsonObject, key: string, value: JsonValue): vo
 export function cloneJson(value: JsonValue): JsonValue {
   return JSON.parse(JSON.stringify(value)) as JsonValue;
 }
+
+/**
+ * Compares two JSON values by content: objects are equal when they have the same members with
+ * equal values, in any order, and arrays when they have equal elements in the same order.
+ */
+export function jsonEqual(a: JsonValue, b: JsonValue): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (Array.isArray(a) && Array.isArray(b)) {
+    return a.length === b.length && a.every((element, index) => jsonEqual(element, b[index]));
+  }
+  if (isJsonObject(a) && isJsonObject(b)) {
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.hasOwn(b, key) && jsonEqual(a[key], b[key]))
+    );
+  }
+  return false;
+}
