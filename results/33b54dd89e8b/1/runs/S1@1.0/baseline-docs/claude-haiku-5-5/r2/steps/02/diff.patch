index 0000000000000000000000000000000000000000..006a0f7cae76173a185f82ccfb74c83567abb4c8
--- /dev/null
+++ b/src/json-patch.ts
@@ -0,0 +1,299 @@
+import {
+  parseArrayIndex,
+  parseTokens,
+  resolvePointer,
+  type JsonValue,
+} from "./json-pointer.ts";
+
+/**
+ * Raised when a JSON Patch is malformed, or when one of its operations cannot be applied.
+ * The `cause` of an error caused by a malformed JSON Pointer is the `JsonPointerError`.
+ */
+export class JsonPatchError extends Error {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = "JsonPatchError";
+  }
+}
+
+/**
+ * One operation of a JSON Patch, as RFC 6902 section 4 defines them.
+ */
+export type JsonPatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; from: string; path: string };
+
+/**
+ * A JSON Patch (RFC 6902): an array of operations, applied in order.
+ */
+export type JsonPatch = JsonPatchOperation[];
+
+const OPERATION_NAMES = ["add", "remove", "replace", "move", "copy", "test"] as const;
+type OperationName = (typeof OPERATION_NAMES)[number];
+
+type JsonObject = { [key: string]: JsonValue };
+type JsonContainer = JsonValue[] | JsonObject;
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document.
+ *
+ * The operations are applied in order, each to the result of the previous one. The input document
+ * and the patch are not modified: the result is a new value, which shares no structure with them.
+ *
+ * @param document - The JSON document to change.
+ * @param patch - The operations to apply, as an array.
+ * @returns The changed document.
+ * @throws {JsonPatchError} If the patch is malformed, if a pointer in it is malformed, or if an
+ * operation cannot be applied (for example a missing member, or a failing `test`).
+ */
+export function applyPatch(document: JsonValue, patch: JsonPatch): JsonValue {
+  const operations = parsePatch(patch);
+  let result = cloneJson(document);
+  for (const [index, operation] of operations.entries()) {
+    try {
+      result = applyOperation(result, operation);
+    } catch (error) {
+      const reason = error instanceof Error ? error.message : String(error);
+      throw new JsonPatchError(`operation ${index} (${operation.op}) failed: ${reason}`, {
+        cause: error,
+      });
+    }
+  }
+  return result;
+}
+
+/**
+ * Checks the shape of every operation before any of them is applied.
+ */
+function parsePatch(patch: unknown): JsonPatchOperation[] {
+  if (!Array.isArray(patch)) {
+    throw new JsonPatchError("a JSON Patch must be an array of operations");
+  }
+  return patch.map(parseOperation);
+}
+
+/**
+ * Checks that an operation has the members its kind requires, with values of the right type.
+ * Pointer syntax is checked when the operation is applied.
+ */
+function parseOperation(value: unknown, index: number): JsonPatchOperation {
+  const fail = (reason: string) => new JsonPatchError(`operation ${index} ${reason}`);
+  if (!isJsonObject(value)) {
+    throw fail("must be an object");
+  }
+  const { op, path, from } = value;
+  if (typeof op !== "string" || !isOperationName(op)) {
+    throw fail(`has an unknown "op"`);
+  }
+  if (typeof path !== "string") {
+    throw fail(`needs a string "path"`);
+  }
+  switch (op) {
+    case "remove":
+      return { op, path };
+    case "add":
+    case "replace":
+    case "test":
+      if (!Object.hasOwn(value, "value") || !isJsonValue(value.value)) {
+        throw fail(`needs a JSON "value"`);
+      }
+      return { op, path, value: value.value };
+    case "move":
+    case "copy":
+      if (typeof from !== "string") {
+        throw fail(`needs a string "from"`);
+      }
+      return { op, from, path };
+  }
+}
+
+function applyOperation(root: JsonValue, operation: JsonPatchOperation): JsonValue {
+  switch (operation.op) {
+    case "add":
+      return add(root, operation.path, cloneJson(operation.value));
+    case "remove":
+      return remove(root, operation.path);
+    case "replace":
+      return replace(root, operation.path, cloneJson(operation.value));
+    case "move":
+      return move(root, operation.from, operation.path);
+    case "copy":
+      return add(root, operation.path, cloneJson(resolvePointer(root, operation.from)));
+    case "test":
+      assertEqual(root, operation.path, operation.value);
+      return root;
+  }
+}
+
+/**
+ * Adds a value at a pointer. A member of an object is set, an array element is inserted, and the
+ * "-" token appends to an array. The empty pointer replaces the whole document.
+ */
+function add(root: JsonValue, path: string, value: JsonValue): JsonValue {
+  if (path === "") {
+    return value;
+  }
+  const { parent, key } = locate(root, path);
+  if (!Array.isArray(parent)) {
+    setMember(parent, key, value);
+  } else if (key === "-") {
+    parent.push(value);
+  } else {
+    const index = parseArrayIndex(key);
+    if (index > parent.length) {
+      throw new JsonPatchError(`array index ${index} is out of range`);
+    }
+    parent.splice(index, 0, value);
+  }
+  return root;
+}
+
+/**
+ * Replaces the existing value at a pointer. The empty pointer replaces the whole document.
+ */
+function replace(root: JsonValue, path: string, value: JsonValue): JsonValue {
+  if (path === "") {
+    return value;
+  }
+  const { parent, key } = locate(root, path);
+  if (Array.isArray(parent)) {
+    parent[existingIndex(parent, key)] = value;
+  } else {
+    requireMember(parent, key);
+    setMember(parent, key, value);
+  }
+  return root;
+}
+
+/**
+ * Removes the existing value at a pointer. The empty pointer cannot be removed, since the
+ * document would be left without a value.
+ */
+function remove(root: JsonValue, path: string): JsonValue {
+  if (path === "") {
+    throw new JsonPatchError("the whole document cannot be removed");
+  }
+  const { parent, key } = locate(root, path);
+  if (Array.isArray(parent)) {
+    parent.splice(existingIndex(parent, key), 1);
+  } else {
+    requireMember(parent, key);
+    delete parent[key];
+  }
+  return root;
+}
+
+/**
+ * Moves the value at `from` to `path`: a removal followed by an addition, as RFC 6902 defines it.
+ */
+function move(root: JsonValue, from: string, path: string): JsonValue {
+  if (path.startsWith(`${from}/`)) {
+    throw new JsonPatchError(`"${from}" cannot be moved into one of its own children`);
+  }
+  const value = resolvePointer(root, from);
+  if (path === from) {
+    return root;
+  }
