+++ b/src/json-patch.test.ts
@@ -0,0 +1,343 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, JsonPatchError, JsonPointerError, type JsonPatch } from "./index.ts";
+
+test("add inserts a new member into an object", () => {
+  assert.deepEqual(
+    applyPatch({ foo: 1 }, [{ op: "add", path: "/bar", value: 2 }]),
+    { foo: 1, bar: 2 },
+  );
+});
+
+test("add replaces an existing member of an object", () => {
+  assert.deepEqual(applyPatch({ foo: 1 }, [{ op: "add", path: "/foo", value: 9 }]), { foo: 9 });
+});
+
+test("add inserts an element at the given index of an array", () => {
+  assert.deepEqual(applyPatch({ a: [1, 3] }, [{ op: "add", path: "/a/1", value: 2 }]), {
+    a: [1, 2, 3],
+  });
+});
+
+test("add with the '-' token appends to an array", () => {
+  assert.deepEqual(applyPatch({ a: [1, 2] }, [{ op: "add", path: "/a/-", value: 3 }]), {
+    a: [1, 2, 3],
+  });
+});
+
+test("add with the empty pointer replaces the whole document", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [true] }]), [true]);
+});
+
+test("add at an index equal to the array length appends", () => {
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/1", value: 2 }]), [1, 2]);
+});
+
+test("add rejects an array index beyond the array length", () => {
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/2", value: 2 }]), JsonPatchError);
+});
+
+test("add rejects a missing parent", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a/b", value: 1 }]), JsonPatchError);
+});
+
+test("add rejects an array index with a leading zero or a non-numeric token", () => {
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/01", value: 2 }]), JsonPatchError);
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/x", value: 2 }]), JsonPatchError);
+});
+
+test("add defines a member named __proto__ as an own property", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(JSON.parse(JSON.stringify(result)), JSON.parse('{"__proto__":{"polluted":true}}'));
+  assert.equal(({} as { polluted?: boolean }).polluted, undefined);
+});
+
+test("remove deletes a member of an object", () => {
+  assert.deepEqual(applyPatch({ foo: 1, bar: 2 }, [{ op: "remove", path: "/foo" }]), { bar: 2 });
+});
+
+test("remove deletes an element of an array", () => {
+  assert.deepEqual(applyPatch({ a: [1, 2, 3] }, [{ op: "remove", path: "/a/1" }]), { a: [1, 3] });
+});
+
+test("remove rejects a missing member", () => {
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/foo" }]), JsonPatchError);
+});
+
+test("remove rejects an array index out of range", () => {
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "remove", path: "/a/1" }]), JsonPatchError);
+});
+
+test("remove rejects the '-' token", () => {
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "remove", path: "/a/-" }]), JsonPatchError);
+});
+
+test("remove rejects the empty pointer, since there is no document left", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]), JsonPatchError);
+});
+
+test("replace overwrites an existing value", () => {
+  assert.deepEqual(applyPatch({ foo: "a" }, [{ op: "replace", path: "/foo", value: null }]), {
+    foo: null,
+  });
+});
+
+test("replace overwrites an element of an array", () => {
+  assert.deepEqual(applyPatch({ a: [1, 2] }, [{ op: "replace", path: "/a/0", value: 0 }]), {
+    a: [0, 2],
+  });
+});
+
+test("replace with the empty pointer replaces the whole document", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: "x" }]), "x");
+});
+
+test("replace rejects a missing member", () => {
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/foo", value: 1 }]), JsonPatchError);
+});
+
+test("replace rejects an array index out of range or the '-' token", () => {
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "replace", path: "/a/1", value: 1 }]), JsonPatchError);
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "replace", path: "/a/-", value: 1 }]), JsonPatchError);
+});
+
+test("move relocates a value and removes it from its source", () => {
+  assert.deepEqual(applyPatch({ a: { x: 1 } }, [{ op: "move", from: "/a/x", path: "/b" }]), {
+    a: {},
+    b: 1,
+  });
+});
+
+test("move from an array element to an earlier index", () => {
+  assert.deepEqual(applyPatch({ a: [1, 2, 3] }, [{ op: "move", from: "/a/2", path: "/a/0" }]), {
+    a: [3, 1, 2],
+  });
+});
+
+test("move to the same location leaves the document unchanged", () => {
+  assert.deepEqual(applyPatch({ a: [1, 2] }, [{ op: "move", from: "/a/0", path: "/a/0" }]), {
+    a: [1, 2],
+  });
+});
+
+test("move rejects a missing source", () => {
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/x", path: "/y" }]), JsonPatchError);
+});
+
+test("move rejects a target inside its own source", () => {
+  assert.throws(
+    () => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b/c" }]),
+    JsonPatchError,
+  );
+});
+
+test("move rejects a missing target parent", () => {
+  assert.throws(
+    () => applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/missing/b" }]),
+    JsonPatchError,
+  );
+});
+
+test("copy duplicates a value and leaves the source in place", () => {
+  assert.deepEqual(applyPatch({ a: [1] }, [{ op: "copy", from: "/a", path: "/b" }]), {
+    a: [1],
+    b: [1],
+  });
+});
+
+test("copy produces an independent value", () => {
+  const result = applyPatch({ a: { x: 1 } }, [
+    { op: "copy", from: "/a", path: "/b" },
+    { op: "replace", path: "/b/x", value: 2 },
+  ]);
+  assert.deepEqual(result, { a: { x: 1 }, b: { x: 2 } });
+});
+
+test("copy rejects a missing source", () => {
+  assert.throws(() => applyPatch({}, [{ op: "copy", from: "/x", path: "/y" }]), JsonPatchError);
+});
+
+test("test succeeds when the value is equal, compared deeply", () => {
+  const document = { a: [1, { b: "c" }], d: null };
+  assert.deepEqual(
+    applyPatch(document, [
+      { op: "test", path: "/a", value: [1, { b: "c" }] },
+      { op: "test", path: "/d", value: null },
+      { op: "test", path: "", value: document },
+    ]),
+    document,
+  );
+});
+
+test("test fails when the value differs", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: 2 }]), JsonPatchError);
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "test", path: "/a", value: [1, 2] }]), JsonPatchError);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]), JsonPatchError);
+});
+
+test("test fails when the value is a different object or array shape", () => {
+  assert.throws(() => applyPatch({ a: { x: 1 } }, [{ op: "test", path: "/a", value: { x: 1, y: 2 } }]), JsonPatchError);
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "test", path: "/a", value: { 0: 1 } }]), JsonPatchError);
+});
+
+test("test rejects a missing member", () => {
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/a", value: null }]), JsonPatchError);
+});
+
+test("applies the operations in order, each to the result of the previous one", () => {
+  const patch: JsonPatch = [
+    { op: "add", path: "/list/-", value: "first" },
+    { op: "add", path: "/list/-", value: "second" },
+    { op: "move", from: "/list/0", path: "/moved" },
+    { op: "test", path: "/list/0", value: "second" },
+    { op: "remove", path: "/list/0" },
+  ];
+  assert.deepEqual(applyPatch({ list: [] }, patch), { list: [], moved: "first" });
+});
+
+test("does not mutate the input document", () => {
+  const document = { a: { b: [1, 2] }, c: 1 };
+  const snapshot = JSON.parse(JSON.stringify(document));
+  applyPatch(document, [
+    { op: "add", path: "/a/b/-", value: 3 },
+    { op: "remove", path: "/c" },
+    { op: "move", from: "/a/b/0", path: "/d" },
+    { op: "replace", path: "/a/b/0", value: 9 },
+  ]);
+  assert.deepEqual(document, snapshot);
+});
+
+test("does not mutate the patch or alias its values in the result", () => {
+  const patch: JsonPatch = [{ op: "add", path: "/a", value: { x: [1] } }];
+  const snapshot = JSON.parse(JSON.stringify(patch));
+  const result = applyPatch({}, patch) as { a: { x: number[] } };
+  result.a.x.push(2);
+  assert.deepEqual(patch, snapshot);
+});
+
+test("an empty patch returns an equal document", () => {
+  const document = { a: [1] };
+  assert.deepEqual(applyPatch(document, []), document);
+});
+
+test("the patch must be an array", () => {
+  assert.throws(() => applyPatch({}, {} as never), JsonPatchError);
+});
+
+test("rejects an operation that is not an object", () => {
+  assert.throws(() => applyPatch({}, [null] as never), JsonPatchError);
+  assert.throws(() => applyPatch({}, ["add"] as never), JsonPatchError);
+});
+
+test("rejects an unknown or missing op", () => {
+  assert.throws(() => applyPatch({}, [{ op: "frob", path: "" }] as never), JsonPatchError);
+  assert.throws(() => applyPatch({}, [{ path: "/a", value: 1 }] as never), JsonPatchError);
+});
+
+test("rejects an operation whose path is not a valid JSON Pointer", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "a", value: 1 }] as never), JsonPatchError);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: 3 }] as never), JsonPatchError);
+});
+
+test("rejects add, replace and test without a value", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }] as never), JsonPatchError);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "replace", path: "/a" }] as never), JsonPatchError);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a" }] as never), JsonPatchError);
+});
+
+test("rejects move and copy without a valid from pointer", () => {
+  assert.throws(() => applyPatch({}, [{ op: "copy", path: "/a" }] as never), JsonPatchError);
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "a", path: "/b" }] as never), JsonPatchError);
+});
+
+test("a failing operation fails the whole patch", () => {
+  const document = { a: 1 };
+  assert.throws(
+    () =>
+      applyPatch(document, [
+        { op: "replace", path: "/a", value: 2 },
+        { op: "test", path: "/a", value: 1 },
+      ]),
+    JsonPatchError,
+  );
+});
+
+test("the error of a malformed pointer is a JsonPatchError with the pointer error as cause", () => {
+  assert.throws(
+    () => applyPatch({ a: 1 }, [{ op: "remove", path: "/~2" }]),
+    (error: unknown) =>
+      error instanceof JsonPatchError && error.cause instanceof JsonPointerError,
+  );
+});
+
+// The examples of RFC 6902, appendix A.
+test("RFC 6902 appendix A: adds, removes and replaces members and elements", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), {
+    foo: "bar",
+    baz: "qux",
+  });
+  assert.deepEqual(
+    applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]),
+    { foo: ["bar", "qux", "baz"] },
+  );
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), {
+    foo: "bar",
+  });
+  assert.deepEqual(
+    applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]),
+    { foo: ["bar", "baz"] },
+  );
+  assert.deepEqual(
+    applyPatch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]),
+    { baz: "boo", foo: "bar" },
+  );
+});
+
+test("RFC 6902 appendix A: moves and copies values", () => {
+  assert.deepEqual(
+    applyPatch(
+      { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+      [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    ),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(
+    applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [
+      { op: "move", from: "/foo/1", path: "/foo/3" },
+    ]),
+    { foo: ["all", "cows", "eat", "grass"] },
+  );
+});
+
+test("RFC 6902 appendix A: appends an array value with '-'", () => {
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]), {
+    foo: ["bar", ["abc", "def"]],
+  });
+});
+
+test("RFC 6902 appendix A: tests a value, and fails the patch when it differs", () => {
+  const document = { baz: "qux", foo: ["a", 2, "c"] };
+  assert.deepEqual(
+    applyPatch(document, [
+      { op: "test", path: "/baz", value: "qux" },
+      { op: "test", path: "/foo/1", value: 2 },
+    ]),
+    document,
+  );
+  assert.throws(() => applyPatch(document, [{ op: "test", path: "/baz", value: "bar" }]), JsonPatchError);
+});
+
+test("RFC 6902 appendix A: adding to a nonexistent target fails", () => {
+  assert.throws(
+    () => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]),
+    JsonPatchError,
+  );
+});
+
+test("RFC 6902 appendix A: '~' escapes are decoded in a pointer", () => {
+  assert.deepEqual(applyPatch({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }]), {
+    "/": 9,
+    "~1": 10,
+  });
+});
