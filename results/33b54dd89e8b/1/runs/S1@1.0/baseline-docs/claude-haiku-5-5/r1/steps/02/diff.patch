index 0000000000000000000000000000000000000000..a8e8764684699a657977f7bc045615a73fbbcf0a
--- /dev/null
+++ b/src/json-patch.ts
@@ -0,0 +1,286 @@
+import type { JsonValue } from './json-value.ts';
+import { ARRAY_INDEX, parsePointer, resolvePointer, selectChild } from './json-pointer.ts';
+
+/**
+ * Raised when a JSON Patch is malformed or one of its operations cannot be applied (RFC 6902).
+ */
+export class JsonPatchError extends Error {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = 'JsonPatchError';
+  }
+}
+
+type JsonObject = { [key: string]: JsonValue };
+
+/** The array or object that holds the target of an operation. */
+type Container = JsonValue[] | JsonObject;
+
+/** The container that holds the target of a pointer, and the token that names the target in it. */
+interface Slot {
+  container: Container;
+  token: string;
+}
+
+/** One validated operation of a JSON Patch (RFC 6902, section 4). */
+type Operation =
+  | { op: 'add' | 'replace' | 'test'; path: string; value: JsonValue }
+  | { op: 'remove'; path: string }
+  | { op: 'move' | 'copy'; from: string; path: string };
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Whether `value` is a JSON value (RFC 8259): numbers must be finite, and objects must be plain.
+ */
+function isJsonValue(value: unknown): value is JsonValue {
+  if (typeof value === 'number') {
+    return Number.isFinite(value);
+  }
+  if (value === null || typeof value === 'boolean' || typeof value === 'string') {
+    return true;
+  }
+  if (Array.isArray(value)) {
+    return value.every(isJsonValue);
+  }
+  if (isRecord(value)) {
+    const prototype = Object.getPrototypeOf(value);
+    return (prototype === Object.prototype || prototype === null) && Object.values(value).every(isJsonValue);
+  }
+  return false;
+}
+
+/**
+ * Parses one element of a patch into an operation, checking the members that its `op` requires.
+ */
+function parseOperation(raw: unknown, index: number): Operation {
+  if (!isRecord(raw)) {
+    throw new JsonPatchError(`operation ${index} is not an object`);
+  }
+  const { op, path } = raw;
+  if (typeof op !== 'string') {
+    throw new JsonPatchError(`operation ${index} has no string "op" member`);
+  }
+  if (typeof path !== 'string') {
+    throw new JsonPatchError(`operation ${index} ("${op}") has no string "path" member`);
+  }
+  switch (op) {
+    case 'add':
+    case 'replace':
+    case 'test': {
+      const value = raw.value;
+      if (!isJsonValue(value)) {
+        throw new JsonPatchError(`operation ${index} ("${op}") has no JSON "value" member`);
+      }
+      return { op, path, value };
+    }
+    case 'remove':
+      return { op, path };
+    case 'move':
+    case 'copy': {
+      const from = raw.from;
+      if (typeof from !== 'string') {
+        throw new JsonPatchError(`operation ${index} ("${op}") has no string "from" member`);
+      }
+      return { op, from, path };
+    }
+    default:
+      throw new JsonPatchError(`operation ${index} has unknown "op" ${JSON.stringify(op)}`);
+  }
+}
+
+/**
+ * Returns the container that holds the target of `pointer` and the token that names it.
+ * Returns `undefined` for the empty pointer, which targets the whole document.
+ */
+function locate(root: JsonValue, pointer: string): Slot | undefined {
+  const tokens = parsePointer(pointer);
+  const token = tokens.pop();
+  if (token === undefined) {
+    return undefined;
+  }
+  const container = tokens.reduce<JsonValue>((current, step) => selectChild(current, step, pointer), root);
+  return { container: asContainer(container, pointer), token };
+}
+
+function asContainer(value: JsonValue, pointer: string): Container {
+  if (Array.isArray(value)) {
+    return value;
+  }
+  if (value !== null && typeof value === 'object') {
+    return value;
+  }
+  throw new JsonPatchError(`"${pointer}" does not refer to an array or an object`);
+}
+
+/**
+ * Sets an own member of an object. `defineProperty` is used so that a key such as `__proto__`
+ * becomes a member and does not change the prototype.
+ */
+function setMember(object: JsonObject, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/**
+ * Inserts `value` at the index named by `token`. The token `-` names the position past the last element.
+ */
+function insertElement(array: JsonValue[], token: string, value: JsonValue, pointer: string): void {
+  if (token === '-') {
+    array.push(value);
+    return;
+  }
+  if (!ARRAY_INDEX.test(token) || Number(token) > array.length) {
+    throw new JsonPatchError(`"${pointer}" is not a valid position in the array`);
+  }
+  array.splice(Number(token), 0, value);
+}
+
+/**
+ * Adds `value` at `pointer`: it sets an object member, inserts an array element, or replaces the whole document.
+ */
+function add(root: JsonValue, pointer: string, value: JsonValue): JsonValue {
+  const slot = locate(root, pointer);
+  if (slot === undefined) {
+    return value;
+  }
+  if (Array.isArray(slot.container)) {
+    insertElement(slot.container, slot.token, value, pointer);
+  } else {
+    setMember(slot.container, slot.token, value);
+  }
+  return root;
+}
+
+/**
+ * Replaces the value at `pointer`, which must already exist.
+ */
+function replace(root: JsonValue, pointer: string, value: JsonValue): JsonValue {
+  const slot = locate(root, pointer);
+  if (slot === undefined) {
+    return value;
+  }
+  selectChild(slot.container, slot.token, pointer);
+  if (Array.isArray(slot.container)) {
+    slot.container[Number(slot.token)] = value;
+  } else {
+    setMember(slot.container, slot.token, value);
+  }
+  return root;
+}
+
+/**
+ * Removes the value at `pointer`, which must already exist.
+ */
+function remove(root: JsonValue, pointer: string): JsonValue {
+  const slot = locate(root, pointer);
+  if (slot === undefined) {
+    throw new JsonPatchError('the whole document cannot be removed');
+  }
+  selectChild(slot.container, slot.token, pointer);
+  if (Array.isArray(slot.container)) {
+    slot.container.splice(Number(slot.token), 1);
+  } else {
+    delete slot.container[slot.token];
+  }
+  return root;
+}
+
+/** Whether `tokens` starts with every token of `prefix`. */
+function startsWith(tokens: string[], prefix: string[]): boolean {
+  return prefix.length <= tokens.length && prefix.every((token, index) => token === tokens[index]);
+}
+
+/**
+ * Moves the value at `from` to `pointer`. The value is removed first, so a move within one array
+ * is relative to the array after the removal (RFC 6902, section 4.4).
+ */
+function move(root: JsonValue, from: string, pointer: string): JsonValue {
+  const fromTokens = parsePointer(from);
+  const toTokens = parsePointer(pointer);
+  const value = resolvePointer(root, from);
+  if (startsWith(toTokens, fromTokens)) {
+    if (toTokens.length === fromTokens.length) {
+      return root;
+    }
+    throw new JsonPatchError(`"${from}" cannot be moved into one of its own children`);
+  }
+  return add(remove(root, from), pointer, value);
+}
+
+/**
+ * Whether two JSON values are equal: arrays element by element and in order, objects member by member
+ * regardless of key order (RFC 6902, section 4.6).
+ */
+function deepEqual(a: JsonValue, b: JsonValue): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, index) => deepEqual(item, b[index]));
+  }
+  if (Array.isArray(b) || a === null || b === null || typeof a !== 'object' || typeof b !== 'object') {
+    return false;
+  }
+  const keys = Object.keys(a);
+  return keys.length === Object.keys(b).length && keys.every((key) => Object.hasOwn(b, key) && deepEqual(a[key], b[key]));
+}
+
+/**
+ * Returns `root` when the value at `pointer` equals `expected`, and throws otherwise.
+ */
+function testValue(root: JsonValue, pointer: string, expected: JsonValue): JsonValue {
+  if (!deepEqual(resolvePointer(root, pointer), expected)) {
+    throw new JsonPatchError(`the value at "${pointer}" is not the expected value`);
+  }
+  return root;
+}
+
+function applyOperation(root: JsonValue, operation: Operation): JsonValue {
+  switch (operation.op) {
+    case 'add':
+      return add(root, operation.path, structuredClone(operation.value));
+    case 'replace':
+      return replace(root, operation.path, structuredClone(operation.value));
+    case 'remove':
+      return remove(root, operation.path);
+    case 'move':
+      return move(root, operation.from, operation.path);
+    case 'copy':
+      return add(root, operation.path, structuredClone(resolvePointer(root, operation.from)));
+    case 'test':
+      return testValue(root, operation.path, operation.value);
+  }
+}
+
+function errorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the patched document.
+ *
+ * The whole patch is validated before any operation runs. The operations are then applied in order,
+ * each to the result of the previous one, on a copy of `document`: neither `document` nor `patch` is
+ * modified, and a patch that fails leaves no partial result behind.
+ *
+ * @throws {JsonPatchError} when `patch` is not an array of valid operations, or when an operation
+ * cannot be applied to the document (for example, a `test` that does not match, or a `remove` of a
+ * missing member).
+ */
+export function applyPatch(document: JsonValue, patch: JsonValue): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new JsonPatchError('a JSON Patch must be an array of operations');
+  }
+  const operations = patch.map(parseOperation);
+  let result = structuredClone(document);
+  for (const [index, operation] of operations.entries()) {
+    try {
+      result = applyOperation(result, operation);
+    } catch (error) {
+      throw new JsonPatchError(`operation ${index} ("${operation.op}") failed: ${errorMessage(error)}`, { cause: error });
+    }
+  }
+  return result;
+}
