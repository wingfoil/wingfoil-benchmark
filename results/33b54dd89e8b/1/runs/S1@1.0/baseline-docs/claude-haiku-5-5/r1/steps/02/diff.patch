diff --git a/test/apply-patch.test.ts b/test/apply-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7c09310d3efbf01f75b05c553ea3df17bbfc43b5
--- /dev/null
+++ b/test/apply-patch.test.ts
@@ -0,0 +1,358 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch, JsonPatchError } from '../src/index.ts';
+
+describe('applyPatch: add', () => {
+  test('adds a new object member', () => {
+    assert.deepEqual(applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/baz', value: 'qux' }]), {
+      foo: 'bar',
+      baz: 'qux',
+    });
+  });
+
+  test('adding an existing object member replaces its value', () => {
+    assert.deepEqual(applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/foo', value: 'baz' }]), { foo: 'baz' });
+  });
+
+  test('inserts an array element at the given index, shifting the following elements', () => {
+    assert.deepEqual(applyPatch({ foo: ['bar', 'baz'] }, [{ op: 'add', path: '/foo/1', value: 'qux' }]), {
+      foo: ['bar', 'qux', 'baz'],
+    });
+  });
+
+  test('the - token appends to an array', () => {
+    assert.deepEqual(applyPatch({ foo: ['bar'] }, [{ op: 'add', path: '/foo/-', value: 'baz' }]), {
+      foo: ['bar', 'baz'],
+    });
+  });
+
+  test('an array index equal to the length appends', () => {
+    assert.deepEqual(applyPatch({ foo: ['bar'] }, [{ op: 'add', path: '/foo/1', value: 'baz' }]), {
+      foo: ['bar', 'baz'],
+    });
+  });
+
+  test('an array index past the length throws', () => {
+    assert.throws(() => applyPatch({ foo: ['bar'] }, [{ op: 'add', path: '/foo/2', value: 'baz' }]), JsonPatchError);
+  });
+
+  test('a leading-zero array index throws', () => {
+    assert.throws(() => applyPatch({ foo: ['bar'] }, [{ op: 'add', path: '/foo/01', value: 'baz' }]), JsonPatchError);
+  });
+
+  test('the empty path replaces the whole document', () => {
+    assert.deepEqual(applyPatch({ foo: 'bar' }, [{ op: 'add', path: '', value: [1, 2] }]), [1, 2]);
+  });
+
+  test('a missing parent throws', () => {
+    assert.throws(() => applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/baz/bat', value: 'qux' }]), JsonPatchError);
+  });
+
+  test('a primitive parent throws', () => {
+    assert.throws(() => applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/foo/bat', value: 'qux' }]), JsonPatchError);
+  });
+
+  test('a null value is added as a value', () => {
+    assert.deepEqual(applyPatch({}, [{ op: 'add', path: '/a', value: null }]), { a: null });
+  });
+
+  test('a __proto__ key is added as an own member, not as the prototype', () => {
+    const result = applyPatch({}, [{ op: 'add', path: '/__proto__', value: 1 }]) as Record<string, unknown>;
+    assert.equal(Object.hasOwn(result, '__proto__'), true);
+    assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  });
+});
+
+describe('applyPatch: remove', () => {
+  test('removes an object member', () => {
+    assert.deepEqual(applyPatch({ baz: 'qux', foo: 'bar' }, [{ op: 'remove', path: '/baz' }]), { foo: 'bar' });
+  });
+
+  test('removes an array element and shifts the following elements', () => {
+    assert.deepEqual(applyPatch({ foo: ['bar', 'qux', 'baz'] }, [{ op: 'remove', path: '/foo/1' }]), {
+      foo: ['bar', 'baz'],
+    });
+  });
+
+  test('a missing member throws', () => {
+    assert.throws(() => applyPatch({ foo: 'bar' }, [{ op: 'remove', path: '/baz' }]), JsonPatchError);
+  });
+
+  test('an array index past the end throws', () => {
+    assert.throws(() => applyPatch({ foo: ['bar'] }, [{ op: 'remove', path: '/foo/1' }]), JsonPatchError);
+  });
+
+  test('the - token throws', () => {
+    assert.throws(() => applyPatch({ foo: ['bar'] }, [{ op: 'remove', path: '/foo/-' }]), JsonPatchError);
+  });
+
+  test('the whole document cannot be removed', () => {
+    assert.throws(() => applyPatch({ foo: 'bar' }, [{ op: 'remove', path: '' }]), JsonPatchError);
+  });
+});
+
+describe('applyPatch: replace', () => {
+  test('replaces an object member value', () => {
+    assert.deepEqual(applyPatch({ foo: 'bar' }, [{ op: 'replace', path: '/foo', value: 'baz' }]), { foo: 'baz' });
+  });
+
+  test('replaces an array element', () => {
+    assert.deepEqual(applyPatch({ foo: ['a', 'b'] }, [{ op: 'replace', path: '/foo/0', value: 'c' }]), {
+      foo: ['c', 'b'],
+    });
+  });
+
+  test('replaces the whole document at the empty path', () => {
+    assert.deepEqual(applyPatch({ foo: 'bar' }, [{ op: 'replace', path: '', value: 'baz' }]), 'baz');
+  });
+
+  test('a missing member throws', () => {
+    assert.throws(() => applyPatch({ foo: 'bar' }, [{ op: 'replace', path: '/baz', value: 'qux' }]), JsonPatchError);
+  });
+
+  test('an array index past the end throws', () => {
+    assert.throws(() => applyPatch({ foo: ['a'] }, [{ op: 'replace', path: '/foo/1', value: 'b' }]), JsonPatchError);
+  });
+});
+
+describe('applyPatch: move', () => {
+  test('moves an object member to another location', () => {
+    assert.deepEqual(
+      applyPatch({ foo: { bar: 'baz', waldo: 'fred' }, qux: { corge: 'grault' } }, [
+        { op: 'move', from: '/foo/waldo', path: '/qux/thud' },
+      ]),
+      { foo: { bar: 'baz' }, qux: { corge: 'grault', thud: 'fred' } },
+    );
+  });
+
+  test('moves an array element, removing it before adding it at the target index', () => {
+    assert.deepEqual(applyPatch({ foo: ['all', 'grass', 'cows', 'eat'] }, [{ op: 'move', from: '/foo/1', path: '/foo/3' }]), {
+      foo: ['all', 'cows', 'eat', 'grass'],
+    });
+  });
+
+  test('moving a value to its own location leaves the document unchanged', () => {
+    assert.deepEqual(applyPatch({ foo: ['a', 'b'] }, [{ op: 'move', from: '/foo/0', path: '/foo/0' }]), {
+      foo: ['a', 'b'],
+    });
+  });
+
+  test('moving a value into one of its own children throws', () => {
+    assert.throws(
+      () => applyPatch({ foo: { bar: 1 } }, [{ op: 'move', from: '/foo', path: '/foo/bar/baz' }]),
+      JsonPatchError,
+    );
+  });
+
+  test('a missing source throws', () => {
+    assert.throws(() => applyPatch({ foo: 'bar' }, [{ op: 'move', from: '/baz', path: '/qux' }]), JsonPatchError);
+  });
+
+  test('a missing target parent throws', () => {
+    assert.throws(() => applyPatch({ foo: 'bar' }, [{ op: 'move', from: '/foo', path: '/qux/quux' }]), JsonPatchError);
+  });
+});
+
+describe('applyPatch: copy', () => {
+  test('copies an object member to another location', () => {
+    assert.deepEqual(applyPatch({ foo: 'bar' }, [{ op: 'copy', from: '/foo', path: '/baz' }]), {
+      foo: 'bar',
+      baz: 'bar',
+    });
+  });
+
+  test('copies an array element to a new index', () => {
+    assert.deepEqual(applyPatch({ foo: ['a', 'b'] }, [{ op: 'copy', from: '/foo/0', path: '/foo/2' }]), {
+      foo: ['a', 'b', 'a'],
+    });
+  });
+
+  test('a copy is independent of its source', () => {
+    const result = applyPatch({ a: { x: 1 } }, [
+      { op: 'copy', from: '/a', path: '/b' },
+      { op: 'add', path: '/b/y', value: 2 },
+    ]);
+    assert.deepEqual(result, { a: { x: 1 }, b: { x: 1, y: 2 } });
+  });
+
+  test('a missing source throws', () => {
+    assert.throws(() => applyPatch({ foo: 'bar' }, [{ op: 'copy', from: '/baz', path: '/qux' }]), JsonPatchError);
+  });
+});
+
+describe('applyPatch: test', () => {
+  test('a matching value leaves the document unchanged', () => {
+    assert.deepEqual(applyPatch({ baz: 'qux', foo: ['a', 2, 'c'] }, [
+      { op: 'test', path: '/baz', value: 'qux' },
+      { op: 'test', path: '/foo/1', value: 2 },
+    ]), { baz: 'qux', foo: ['a', 2, 'c'] });
+  });
+
+  test('a non-matching value throws', () => {
+    assert.throws(() => applyPatch({ baz: 'qux' }, [{ op: 'test', path: '/baz', value: 'bar' }]), JsonPatchError);
+  });
+
+  test('objects are compared by their members, regardless of key order', () => {
+    assert.doesNotThrow(() =>
+      applyPatch({ a: { x: 1, y: [true, null] } }, [{ op: 'test', path: '/a', value: { y: [true, null], x: 1 } }]),
+    );
+  });
+
+  test('arrays are compared element by element, in order', () => {
+    assert.throws(() => applyPatch({ a: [1, 2] }, [{ op: 'test', path: '/a', value: [2, 1] }]), JsonPatchError);
+    assert.throws(() => applyPatch({ a: [1, 2] }, [{ op: 'test', path: '/a', value: [1] }]), JsonPatchError);
+  });
+
+  test('an array is not equal to an object with the same keys', () => {
+    assert.throws(() => applyPatch({ a: [] }, [{ op: 'test', path: '/a', value: {} }]), JsonPatchError);
+  });
+
+  test('a null value matches null and not a missing member', () => {
+    assert.doesNotThrow(() => applyPatch({ a: null }, [{ op: 'test', path: '/a', value: null }]));
+    assert.throws(() => applyPatch({}, [{ op: 'test', path: '/a', value: null }]), JsonPatchError);
+  });
+
+  test('a missing path throws', () => {
+    assert.throws(() => applyPatch({ foo: 'bar' }, [{ op: 'test', path: '/baz', value: 'bar' }]), JsonPatchError);
+  });
+
+  test('numbers and strings of different types are not equal', () => {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: 'test', path: '/a', value: '1' }]), JsonPatchError);
+  });
+});
+
+describe('applyPatch: RFC 6902 appendix examples', () => {
+  test('the ~ escapes in a path are decoded', () => {
+    assert.doesNotThrow(() =>
+      applyPatch({ '/': 9, '~1': 10 }, [
+        { op: 'test', path: '/~01', value: 10 },
+        { op: 'test', path: '/~1', value: 9 },
+      ]),
+    );
+  });
+});
+
+describe('applyPatch: operations are applied in order and atomically', () => {
+  test('an empty patch returns an equal document', () => {
+    assert.deepEqual(applyPatch({ foo: [1, { bar: null }] }, []), { foo: [1, { bar: null }] });
+  });
+
+  test('later operations see the effect of earlier ones', () => {
+    assert.deepEqual(
+      applyPatch({}, [
+        { op: 'add', path: '/a', value: [] },
+        { op: 'add', path: '/a/-', value: 'x' },
+        { op: 'replace', path: '/a/0', value: 'y' },
+      ]),
+      { a: ['y'] },
+    );
+  });
+
+  test('a failing operation makes the whole patch throw', () => {
+    assert.throws(
+      () =>
+        applyPatch({ foo: 'bar' }, [
+          { op: 'add', path: '/baz', value: 'qux' },
+          { op: 'remove', path: '/missing' },
+        ]),
+      JsonPatchError,
+    );
+  });
+});
+
+describe('applyPatch: input is not mutated', () => {
+  test('the document and the patch are unchanged after a successful patch', () => {
+    const document = { foo: { bar: ['a', 'b'] }, baz: 1 };
+    const patch = [
+      { op: 'add', path: '/foo/bar/-', value: { c: [1] } },
+      { op: 'move', from: '/baz', path: '/qux' },
+      { op: 'copy', from: '/foo', path: '/copy' },
+      { op: 'replace', path: '/foo/bar/0', value: 'z' },
+    ];
+    const documentBefore = structuredClone(document);
+    const patchBefore = structuredClone(patch);
+
+    applyPatch(document, patch);
+
+    assert.deepEqual(document, documentBefore);
+    assert.deepEqual(patch, patchBefore);
+  });
+
+  test('the document is unchanged after a failing patch', () => {
+    const document = { foo: ['bar'] };
+    const documentBefore = structuredClone(document);
+
+    assert.throws(() =>
+      applyPatch(document, [
+        { op: 'add', path: '/foo/-', value: 'baz' },
+        { op: 'test', path: '/foo/0', value: 'other' },
+      ]),
+    );
+    assert.deepEqual(document, documentBefore);
+  });
+
+  test('the result does not share structure with the document', () => {
+    const document = { foo: { bar: 1 } };
+    const result = applyPatch(document, [{ op: 'add', path: '/baz', value: 2 }]) as typeof document & { baz: number };
+
+    assert.notEqual(result, document);
+    assert.notEqual(result.foo, document.foo);
+    result.foo.bar = 99;
+    assert.equal(document.foo.bar, 1);
+  });
+
+  test('values taken from the patch are copied into the result', () => {
+    const value = { list: [1] };
+    const patch = [{ op: 'add', path: '/a', value }];
+    const result = applyPatch({}, patch) as { a: { list: number[] } };
+
+    result.a.list.push(2);
+    assert.deepEqual(value, { list: [1] });
+    assert.deepEqual(patch, [{ op: 'add', path: '/a', value: { list: [1] } }]);
+  });
+});
+
+describe('applyPatch: invalid patches', () => {
+  test('a patch that is not an array throws', () => {
+    assert.throws(() => applyPatch({}, { op: 'add', path: '/a', value: 1 } as unknown as []), JsonPatchError);
+    assert.throws(() => applyPatch({}, 'add' as unknown as []), JsonPatchError);
+  });
+
+  test('an operation that is not an object throws', () => {
+    assert.throws(() => applyPatch({}, [null] as unknown as []), JsonPatchError);
+    assert.throws(() => applyPatch({}, [['add', '/a', 1]] as unknown as []), JsonPatchError);
+  });
+
+  test('an unknown operation throws', () => {
+    assert.throws(() => applyPatch({}, [{ op: 'increment', path: '/a', value: 1 }] as unknown as []), JsonPatchError);
+  });
+
+  test('an operation without a string op member throws', () => {
+    assert.throws(() => applyPatch({}, [{ path: '/a', value: 1 }] as unknown as []), JsonPatchError);
+  });
+
+  test('an operation without a string path throws', () => {
+    assert.throws(() => applyPatch({}, [{ op: 'remove' }] as unknown as []), JsonPatchError);
+    assert.throws(() => applyPatch({}, [{ op: 'remove', path: 1 }] as unknown as []), JsonPatchError);
+  });
+
+  test('a path that is not a valid JSON Pointer throws', () => {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: 'remove', path: 'a' }]), JsonPatchError);
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: 'replace', path: '/a~', value: 1 }]), JsonPatchError);
+  });
+
+  test('add, replace and test require a value member', () => {
+    assert.throws(() => applyPatch({}, [{ op: 'add', path: '/a' }] as unknown as []), JsonPatchError);
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: 'replace', path: '/a' }] as unknown as []), JsonPatchError);
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: 'test', path: '/a' }] as unknown as []), JsonPatchError);
+  });
+
+  test('move and copy require a from member that is a string', () => {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: 'move', path: '/b' }] as unknown as []), JsonPatchError);
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: 'copy', from: 1, path: '/b' }] as unknown as []), JsonPatchError);
+  });
+
+  test('a from member that is not a valid JSON Pointer throws', () => {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: 'copy', from: 'a', path: '/b' }]), JsonPatchError);
+  });
+});
