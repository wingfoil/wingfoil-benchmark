diff --git a/src/json-merge-patch.ts b/src/json-merge-patch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a7f3543cc18851583a30a9b54cd6dc4589a7a5ab
--- /dev/null
+++ b/src/json-merge-patch.ts
@@ -0,0 +1,65 @@
+import { isJsonValue, type JsonValue } from './json-value.ts';
+
+/**
+ * Raised when the target or the patch of a JSON Merge Patch is not a JSON value (RFC 7386).
+ */
+export class JsonMergePatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'JsonMergePatchError';
+  }
+}
+
+type JsonObject = { [key: string]: JsonValue };
+
+function isObject(value: unknown): value is JsonObject {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Merges `patch` into `target` (RFC 7386, section 2). `target` is owned by the caller of `merge`: it is
+ * updated in place when it is an object. The result shares no object with `patch`.
+ */
+function merge(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result: JsonObject = isObject(target) ? target : {};
+  for (const [key, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = Object.hasOwn(result, key) ? result[key] : undefined;
+      // defineProperty, so that a key such as `__proto__` becomes a member and does not change the prototype.
+      Object.defineProperty(result, key, {
+        value: merge(current, value),
+        writable: true,
+        enumerable: true,
+        configurable: true,
+      });
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to `target` and returns the merged document.
+ *
+ * A patch that is an object merges into the target member by member: a `null` member removes the
+ * member of the same name, and any other member is merged recursively. Any other patch replaces the
+ * target as a whole. For example, `applyMergePatch({ a: 1, b: 2 }, { a: null, c: 3 })` gives `{ b: 2, c: 3 }`.
+ *
+ * The result is a new value: neither `target` nor `patch` is modified, and the result shares no object
+ * with either of them.
+ *
+ * @throws {JsonMergePatchError} when `target` or `patch` is not a JSON value.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonValue(target)) {
+    throw new JsonMergePatchError('the target of a merge patch must be a JSON value');
+  }
+  if (!isJsonValue(patch)) {
+    throw new JsonMergePatchError('a merge patch must be a JSON value');
+  }
+  return merge(structuredClone(target), patch);
+}
