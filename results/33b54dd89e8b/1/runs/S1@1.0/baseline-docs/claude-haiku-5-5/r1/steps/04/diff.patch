diff --git a/src/json-value.ts b/src/json-value.ts
index 10957dbadd9b15f1ba8ee5c5f8162ff7ad84fc0d..93030c15457edc576ced0700096982d6e8daa96f 100644
--- a/src/json-value.ts
+++ b/src/json-value.ts
@@ -2,3 +2,33 @@
  * A JSON value as defined by RFC 8259.
  */
 export type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
+
+/**
+ * Whether `value` is a JSON value (RFC 8259): numbers must be finite, arrays must be dense, objects must
+ * be plain, and no container may contain itself. `ancestors` holds the containers being checked.
+ */
+export function isJsonValue(value: unknown, ancestors = new Set<unknown>()): value is JsonValue {
+  if (typeof value === 'number') {
+    return Number.isFinite(value);
+  }
+  if (value === null || typeof value === 'boolean' || typeof value === 'string') {
+    return true;
+  }
+  if (typeof value !== 'object' || ancestors.has(value)) {
+    return false;
+  }
+  let members: unknown[];
+  if (Array.isArray(value)) {
+    members = Array.from(value);
+  } else {
+    const prototype = Object.getPrototypeOf(value);
+    if (prototype !== Object.prototype && prototype !== null) {
+      return false;
+    }
+    members = Object.values(value);
+  }
+  ancestors.add(value);
+  const isJson = members.every((member) => isJsonValue(member, ancestors));
+  ancestors.delete(value);
+  return isJson;
+}
diff --git a/test/merge-patch.test.ts b/test/merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..56744bc98edb7eac72272a13f8a2140ebddda932
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,144 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyMergePatch, JsonMergePatchError, type JsonValue } from '../src/index.ts';
+
+/** The cases of RFC 7386, Appendix A: [target, patch, expected result]. */
+const APPENDIX_A: [JsonValue, JsonValue, JsonValue][] = [
+  [{ a: 'b' }, { a: 'c' }, { a: 'c' }],
+  [{ a: 'b' }, { b: 'c' }, { a: 'b', b: 'c' }],
+  [{ a: 'b' }, { a: null }, {}],
+  [{ a: 'b', b: 'c' }, { a: null }, { b: 'c' }],
+  [{ a: ['b'] }, { a: 'c' }, { a: 'c' }],
+  [{ a: 'c' }, { a: ['b'] }, { a: ['b'] }],
+  [{ a: { b: 'c' } }, { a: { b: 'd', c: null } }, { a: { b: 'd' } }],
+  [{ a: [{ b: 'c' }] }, { a: [1] }, { a: [1] }],
+  [['a', 'b'], ['c', 'd'], ['c', 'd']],
+  [{ a: 'b' }, ['c'], ['c']],
+  [{ a: 'foo' }, null, null],
+  [{ a: 'foo' }, 'bar', 'bar'],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: 'b', c: null }, { a: 'b' }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+
+describe('applyMergePatch: RFC 7386 Appendix A', () => {
+  for (const [target, patch, expected] of APPENDIX_A) {
+    test(`${JSON.stringify(target)} with ${JSON.stringify(patch)} gives ${JSON.stringify(expected)}`, () => {
+      assert.deepEqual(applyMergePatch(target, patch), expected);
+    });
+  }
+});
+
+describe('applyMergePatch: members', () => {
+  test('a patch member replaces the target member of the same name', () => {
+    assert.deepEqual(applyMergePatch({ a: 1 }, { a: 2 }), { a: 2 });
+  });
+
+  test('a null member removes the target member', () => {
+    assert.deepEqual(applyMergePatch({ a: 1, b: 2 }, { a: null }), { b: 2 });
+  });
+
+  test('a null member for a missing key changes nothing', () => {
+    assert.deepEqual(applyMergePatch({ a: 1 }, { b: null }), { a: 1 });
+  });
+
+  test('a null member is removed, not stored as null', () => {
+    assert.equal(Object.hasOwn(applyMergePatch({ a: 1 }, { a: null }) as object, 'a'), false);
+  });
+
+  test('a nested object is merged recursively, leaving the untouched members alone', () => {
+    assert.deepEqual(applyMergePatch({ a: { b: 1, c: 2 }, d: 3 }, { a: { c: null, e: 4 } }), {
+      a: { b: 1, e: 4 },
+      d: 3,
+    });
+  });
+
+  test('a member whose target is a primitive is replaced by the patch object', () => {
+    assert.deepEqual(applyMergePatch({ a: 1 }, { a: { b: 2 } }), { a: { b: 2 } });
+  });
+
+  test('a null member inside a new nested object is dropped', () => {
+    assert.deepEqual(applyMergePatch({}, { a: { b: null, c: 1 } }), { a: { c: 1 } });
+  });
+
+  test('an array in the patch replaces the target value as a whole', () => {
+    assert.deepEqual(applyMergePatch({ a: [1, 2, 3] }, { a: [4] }), { a: [4] });
+  });
+
+  test('a __proto__ member is an own member, not the prototype', () => {
+    const patch = JSON.parse('{"__proto__": {"polluted": true}}') as JsonValue;
+    const result = applyMergePatch({}, patch) as Record<string, unknown>;
+    assert.equal(Object.getPrototypeOf(result), Object.prototype);
+    assert.equal(Object.hasOwn(result, '__proto__'), true);
+    assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  });
+});
+
+describe('applyMergePatch: whole values', () => {
+  test('a non-object patch replaces the target', () => {
+    assert.equal(applyMergePatch({ a: 1 }, 'text'), 'text');
+  });
+
+  test('a null patch replaces the target with null', () => {
+    assert.equal(applyMergePatch({ a: 1 }, null), null);
+  });
+
+  test('an object patch replaces an array target with an object', () => {
+    assert.deepEqual(applyMergePatch([1, 2], { a: 1 }), { a: 1 });
+  });
+
+  test('an object patch replaces a null target with an object', () => {
+    assert.deepEqual(applyMergePatch(null, { a: 1 }), { a: 1 });
+  });
+
+  test('an empty object patch leaves an object target unchanged', () => {
+    assert.deepEqual(applyMergePatch({ a: 1 }, {}), { a: 1 });
+  });
+});
+
+describe('applyMergePatch: immutability', () => {
+  test('neither the target nor the patch is modified', () => {
+    const target = { a: { b: 1 }, c: [1] };
+    const patch = { a: { b: null, d: { e: 2 } }, f: [3] };
+    const targetCopy = structuredClone(target);
+    const patchCopy = structuredClone(patch);
+    applyMergePatch(target, patch);
+    assert.deepEqual(target, targetCopy);
+    assert.deepEqual(patch, patchCopy);
+  });
+
+  test('the result shares no object with the patch', () => {
+    const patch = { a: { b: 1 }, c: [{ d: 1 }] };
+    const result = applyMergePatch({}, patch) as { a: { b: number }; c: { d: number }[] };
+    result.a.b = 2;
+    result.c[0].d = 2;
+    assert.deepEqual(patch, { a: { b: 1 }, c: [{ d: 1 }] });
+  });
+
+  test('the result shares no object with the target', () => {
+    const target = { a: { b: 1 } };
+    const result = applyMergePatch(target, {}) as { a: { b: number } };
+    result.a.b = 2;
+    assert.deepEqual(target, { a: { b: 1 } });
+  });
+});
+
+describe('applyMergePatch: invalid input', () => {
+  test('an undefined target throws', () => {
+    assert.throws(() => applyMergePatch(undefined as unknown as JsonValue, {}), JsonMergePatchError);
+  });
+
+  test('a patch that is not a JSON value throws', () => {
+    assert.throws(() => applyMergePatch({}, { a: undefined } as unknown as JsonValue), JsonMergePatchError);
+  });
+
+  test('a nested non-finite number in the patch throws', () => {
+    assert.throws(() => applyMergePatch({}, { a: { b: NaN } }), JsonMergePatchError);
+  });
+
+  test('a target that contains a cycle throws', () => {
+    const target: Record<string, unknown> = {};
+    target.self = target;
+    assert.throws(() => applyMergePatch(target as JsonValue, {}), JsonMergePatchError);
+  });
+});
