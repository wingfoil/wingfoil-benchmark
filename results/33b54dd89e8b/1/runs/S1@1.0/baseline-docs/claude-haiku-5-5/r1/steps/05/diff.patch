index 0000000000000000000000000000000000000000..12a61878d12d6b0f51c89bf28e8824de097e2974
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,158 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch, createPatch, JsonPatchError, type JsonValue } from '../src/index.ts';
+
+function roundTrip(from: JsonValue, to: JsonValue): void {
+  assert.deepEqual(applyPatch(from, createPatch(from, to)), to);
+}
+
+describe('createPatch', () => {
+  test('identical documents give an empty patch', () => {
+    assert.deepEqual(createPatch({ a: [1, { b: 'c' }] }, { a: [1, { b: 'c' }] }), []);
+  });
+
+  test('objects with the same members in another order give an empty patch', () => {
+    assert.deepEqual(createPatch({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+  });
+
+  test('a changed primitive at the root is a replace of the whole document', () => {
+    assert.deepEqual(createPatch(1, 2), [{ op: 'replace', path: '', value: 2 }]);
+  });
+
+  test('a changed object member is a single replace', () => {
+    assert.deepEqual(createPatch({ a: 1, b: 2 }, { a: 1, b: 3 }), [{ op: 'replace', path: '/b', value: 3 }]);
+  });
+
+  test('a new object member is a single add', () => {
+    assert.deepEqual(createPatch({ a: 1 }, { a: 1, b: 'x' }), [{ op: 'add', path: '/b', value: 'x' }]);
+  });
+
+  test('a removed object member is a single remove', () => {
+    assert.deepEqual(createPatch({ a: 1, b: 2 }, { a: 1 }), [{ op: 'remove', path: '/b' }]);
+  });
+
+  test('a change deep in the document describes only that member', () => {
+    const from = { users: [{ name: 'Ada', tags: ['x'] }], version: 1 };
+    const to = { users: [{ name: 'Ada', tags: ['x', 'y'] }], version: 1 };
+    assert.deepEqual(createPatch(from, to), [{ op: 'add', path: '/users/0/tags/1', value: 'y' }]);
+  });
+
+  test('a change to one element of a long array is a single operation', () => {
+    const from = { items: Array.from({ length: 1000 }, (_, index) => ({ id: index, done: false })) };
+    const to = structuredClone(from);
+    to.items[500].done = true;
+    assert.deepEqual(createPatch(from, to), [{ op: 'replace', path: '/items/500/done', value: true }]);
+  });
+
+  test('appending an element adds it after the last index', () => {
+    assert.deepEqual(createPatch({ a: [1, 2] }, { a: [1, 2, 3] }), [{ op: 'add', path: '/a/2', value: 3 }]);
+  });
+
+  test('removing the first element removes only that element', () => {
+    const from = { a: Array.from({ length: 1000 }, (_, index) => index) };
+    const to = { a: from.a.slice(1) };
+    assert.deepEqual(createPatch(from, to), [{ op: 'remove', path: '/a/0' }]);
+  });
+
+  test('a shifted array is described by the element that left and the one that came', () => {
+    assert.deepEqual(createPatch({ a: [1, 2, 3, 4] }, { a: [2, 3, 4, 5] }), [
+      { op: 'remove', path: '/a/0' },
+      { op: 'add', path: '/a/3', value: 5 },
+    ]);
+  });
+
+  test('a change to a long array with no shared elements still round-trips', () => {
+    const from = { a: Array.from({ length: 1100 }, (_, index) => index) };
+    const to = { a: Array.from({ length: 1100 }, (_, index) => index + 5000) };
+    roundTrip(from, to);
+  });
+
+  test('inserting an element in the middle of an array adds only that element', () => {
+    assert.deepEqual(createPatch({ a: ['x', 'z'] }, { a: ['x', 'y', 'z'] }), [{ op: 'add', path: '/a/1', value: 'y' }]);
+  });
+
+  test('a changed value of another type is replaced as a whole', () => {
+    assert.deepEqual(createPatch({ a: { b: 1 } }, { a: [1] }), [{ op: 'replace', path: '/a', value: [1] }]);
+    assert.deepEqual(createPatch({ a: null }, { a: 0 }), [{ op: 'replace', path: '/a', value: 0 }]);
+  });
+
+  test('a null member changed to another value is replaced', () => {
+    assert.deepEqual(createPatch({ a: null }, { a: 'x' }), [{ op: 'replace', path: '/a', value: 'x' }]);
+  });
+
+  test('keys are escaped in the pointer', () => {
+    assert.deepEqual(createPatch({ 'a/b': 1, 'c~d': 1 }, { 'a/b': 2, 'c~d': 2 }), [
+      { op: 'replace', path: '/a~1b', value: 2 },
+      { op: 'replace', path: '/c~0d', value: 2 },
+    ]);
+  });
+
+  test('the added value is a copy that shares nothing with the target', () => {
+    const to = { added: { deep: [1] } };
+    const [operation] = createPatch({}, to) as [{ value: { deep: number[] } }];
+    operation.value.deep.push(2);
+    assert.deepEqual(to, { added: { deep: [1] } });
+  });
+
+  test('neither input is modified', () => {
+    const from = { a: [1, { b: 2 }], c: 'x' };
+    const to = { a: [1, { b: 3 }, 4], d: null };
+    const fromCopy = structuredClone(from);
+    const toCopy = structuredClone(to);
+    createPatch(from, to);
+    assert.deepEqual(from, fromCopy);
+    assert.deepEqual(to, toCopy);
+  });
+
+  test('a value that is not JSON is rejected', () => {
+    assert.throws(() => createPatch({ a: undefined } as unknown as JsonValue, {}), JsonPatchError);
+    assert.throws(() => createPatch({}, [1, , 2] as unknown as JsonValue), JsonPatchError);
+  });
+
+  test('random pairs of small documents round-trip, from a fixed seed', () => {
+    let seed = 42;
+    const next = (limit: number): number => {
+      seed = (seed * 1103515245 + 12345) % 2147483648;
+      return seed % limit;
+    };
+    const randomValue = (depth: number): JsonValue => {
+      const kind = next(depth > 0 ? 6 : 3);
+      if (kind === 0) {
+        return next(4);
+      }
+      if (kind === 1) {
+        return `s${next(3)}`;
+      }
+      if (kind === 2) {
+        return next(2) === 0;
+      }
+      if (kind === 3) {
+        return Array.from({ length: next(5) }, () => randomValue(depth - 1));
+      }
+      const members: { [key: string]: JsonValue } = {};
+      for (let index = next(4); index > 0; index--) {
+        members[`k${next(4)}`] = randomValue(depth - 1);
+      }
+      return members;
+    };
+    for (let round = 0; round < 500; round++) {
+      roundTrip(randomValue(3), randomValue(3));
+    }
+  });
+
+  test('the patch turns the source into the target when applied', () => {
+    const cases: [JsonValue, JsonValue][] = [
+      [{ a: 1 }, { b: 1 }],
+      [[1, 2, 3, 4], [2, 3, 4, 5]],
+      [[1, [2, 3], { x: [4] }], [0, [2], { x: [4, 5] }, 6]],
+      [{ a: { b: { c: [1, 2] } } }, { a: { b: { c: [] } }, d: 'e' }],
+      [{ 'a/b~c': [1] }, { 'a/b~c': [1, { '': null }] }],
+      ['text', ['text']],
+      [[], {}],
+      [{ k: [{ x: 1 }, { x: 2 }] }, { k: [{ x: 2 }] }],
+    ];
+    for (const [from, to] of cases) {
+      roundTrip(from, to);
+    }
+  });
+});
