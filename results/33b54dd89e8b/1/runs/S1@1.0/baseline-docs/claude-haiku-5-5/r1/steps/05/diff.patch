+import { encodeToken } from './json-pointer.ts';
+import { JsonPatchError, type JsonPatchOperation } from './json-patch.ts';
+import { deepEqual, isJsonValue, type JsonValue } from './json-value.ts';
+
+type JsonObject = { [key: string]: JsonValue };
+
+function isObject(value: JsonValue): value is JsonObject {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+/** The pointer of a member or element `token` inside the value at `path`. */
+function childPath(path: string, token: string): string {
+  return `${path}/${encodeToken(token)}`;
+}
+
+/**
+ * Appends to `operations` the operations that turn `from` into `to`, the value at `path`.
+ * Containers of the same kind are compared member by member; anything else is replaced as a whole.
+ */
+function diffValue(from: JsonValue, to: JsonValue, path: string, operations: JsonPatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, operations);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from, to, path, operations);
+  } else {
+    operations.push({ op: 'replace', path, value: structuredClone(to) });
+  }
+}
+
+function diffObjects(from: JsonObject, to: JsonObject, path: string, operations: JsonPatchOperation[]): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      operations.push({ op: 'remove', path: childPath(path, key) });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (Object.hasOwn(from, key)) {
+      diffValue(from[key], to[key], childPath(path, key), operations);
+    } else {
+      operations.push({ op: 'add', path: childPath(path, key), value: structuredClone(to[key]) });
+    }
+  }
+}
+
+/**
+ * The longest common subsequence search examines at most this many pairs of elements. Beyond it, the
+ * elements that remain between the shared start and end of two arrays are paired by position instead.
+ */
+const MAX_ALIGNMENT_CELLS = 1_000_000;
+
+/**
+ * Pairs up equal elements of `from` and `to` along a longest common subsequence, so that the fewest
+ * elements are removed and added. Returns the index pairs in order.
+ */
+function alignElements(from: JsonValue[], to: JsonValue[]): [number, number][] {
+  if (from.length * to.length > MAX_ALIGNMENT_CELLS) {
+    return [];
+  }
+  // lengths[i][j] is the length of the longest common subsequence of from[i..] and to[j..].
+  const lengths = Array.from({ length: from.length + 1 }, () => new Array<number>(to.length + 1).fill(0));
+  for (let i = from.length - 1; i >= 0; i--) {
+    for (let j = to.length - 1; j >= 0; j--) {
+      lengths[i][j] = deepEqual(from[i], to[j])
+        ? lengths[i + 1][j + 1] + 1
+        : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  const pairs: [number, number][] = [];
+  let i = 0;
+  let j = 0;
+  while (i < from.length && j < to.length) {
+    if (deepEqual(from[i], to[j])) {
+      pairs.push([i, j]);
+      i++;
+      j++;
+    } else if (lengths[i + 1][j] >= lengths[i][j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
+
+/**
+ * Compares the run of `from` that lies between two shared elements with the run of `to` in the same place.
+ * The runs are paired by position, then the surplus of the longer run is removed or added. `toStart` is the
+ * index of the run's first element in `to`, which is also its index in the array being patched at that point.
+ */
+function diffRun(
+  fromRun: JsonValue[],
+  toRun: JsonValue[],
+  toStart: number,
+  path: string,
+  operations: JsonPatchOperation[],
+): void {
+  const paired = Math.min(fromRun.length, toRun.length);
+  for (let offset = 0; offset < paired; offset++) {
+    diffValue(fromRun[offset], toRun[offset], childPath(path, String(toStart + offset)), operations);
+  }
+  for (let offset = paired; offset < fromRun.length; offset++) {
+    operations.push({ op: 'remove', path: childPath(path, String(toStart + paired)) });
+  }
+  for (let offset = paired; offset < toRun.length; offset++) {
+    const value = structuredClone(toRun[offset]);
+    operations.push({ op: 'add', path: childPath(path, String(toStart + offset)), value });
+  }
+}
+
+/**
+ * Compares two arrays. The elements they share at the start and at the end are skipped, and the elements
+ * they share in between are aligned; each run between two aligned elements is then compared by position.
+ */
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, operations: JsonPatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && deepEqual(from[start], to[start])) {
+    start++;
+  }
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && deepEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+  const shared: [number, number][] = alignElements(from.slice(start, fromEnd), to.slice(start, toEnd)).map(
+    ([i, j]) => [i + start, j + start],
+  );
+  shared.push([fromEnd, toEnd]);
+  let fromIndex = start;
+  let toIndex = start;
+  for (const [i, j] of shared) {
+    diffRun(from.slice(fromIndex, i), to.slice(toIndex, j), toIndex, path, operations);
+    fromIndex = i + 1;
+    toIndex = j + 1;
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch describes only what differs: unchanged members and elements are not repeated. Neither
+ * `from` nor `to` is modified, and the values of the patch are copies, so the patch shares nothing with
+ * them. Two equal documents give an empty patch.
+ *
+ * @throws {JsonPatchError} when `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatchOperation[] {
+  if (!isJsonValue(from)) {
+    throw new JsonPatchError('the source document must be a JSON value');
+  }
+  if (!isJsonValue(to)) {
+    throw new JsonPatchError('the target document must be a JSON value');
+  }
+  const operations: JsonPatchOperation[] = [];
+  diffValue(from, to, '', operations);
+  return operations;
+}
