index 0000000000000000000000000000000000000000..6f64d2eacc4b9d53d6c392dd4540815a610a8896
--- /dev/null
+++ b/src/json-pointer.ts
@@ -0,0 +1,68 @@
+import type { JsonValue } from "./json-value.ts";
+
+// An array index is "0" or a non-negative integer without leading zeros (RFC 6901, section 4).
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+// A "~" is only valid as the start of the escape sequence "~0" or "~1" (RFC 6901, section 3).
+const INVALID_TILDE = /~(?![01])/;
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document and returns the value it refers to.
+ *
+ * Throws an `Error` when the pointer is not a valid JSON Pointer, or when it does not
+ * resolve to a value of the document (a missing member, an array index out of range,
+ * or a step into a scalar). Only own members are resolved, so inherited properties such
+ * as `constructor` are never returned.
+ *
+ * @param document - The JSON document to resolve the pointer against.
+ * @param pointer - The JSON Pointer, e.g. `"/foo/0"`; the empty string refers to the whole document.
+ * @returns The value the pointer refers to.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  return parseTokens(pointer).reduce(step, document);
+}
+
+/** Splits a pointer into its unescaped reference tokens, validating its syntax. */
+function parseTokens(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: expected a string");
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer "${pointer}": a non-empty pointer must start with "/"`);
+  }
+  return pointer.slice(1).split("/").map((token) => unescapeToken(pointer, token));
+}
+
+/** Decodes "~1" to "/" and "~0" to "~", in that order as RFC 6901 requires. */
+function unescapeToken(pointer: string, token: string): string {
+  if (INVALID_TILDE.test(token)) {
+    throw new Error(`Invalid JSON Pointer "${pointer}": "~" must be followed by "0" or "1"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/** Moves one reference token down into the document. */
+function step(current: JsonValue, token: string): JsonValue {
+  if (Array.isArray(current)) {
+    return current[arrayIndex(token, current.length)];
+  }
+  if (typeof current === "object" && current !== null && Object.hasOwn(current, token)) {
+    return current[token];
+  }
+  throw new Error(`JSON Pointer does not resolve: no member "${token}"`);
+}
+
+/** Checks that a token is an in-range array index and returns it as a number. */
+function arrayIndex(token: string, length: number): number {
+  if (!ARRAY_INDEX.test(token)) {
+    throw new Error(`JSON Pointer does not resolve: "${token}" is not an array index`);
+  }
+  const index = Number(token);
+  if (index >= length) {
+    throw new Error(`JSON Pointer does not resolve: index ${token} is out of range`);
+  }
+  return index;
+}
