@@ -0,0 +1,11 @@
+/**
+ * A value of the JSON data model (RFC 8259): null, a boolean, a number, a string,
+ * an array of values, or an object whose members are values.
+ */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [member: string]: JsonValue };
diff --git a/test/resolve-pointer.test.ts b/test/resolve-pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..45e291e1f4022b8c87950014f733b3138710bda0
--- /dev/null
+++ b/test/resolve-pointer.test.ts
@@ -0,0 +1,147 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// Examples from RFC 6901, section 5.
+const rfcDocument = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+describe("resolvePointer", () => {
+  describe("resolving valid pointers", () => {
+    it("returns the whole document for the empty pointer", () => {
+      assert.deepEqual(resolvePointer(rfcDocument, ""), rfcDocument);
+    });
+
+    it("resolves an object member", () => {
+      assert.deepEqual(resolvePointer(rfcDocument, "/foo"), ["bar", "baz"]);
+    });
+
+    it("resolves an array element by index", () => {
+      assert.equal(resolvePointer(rfcDocument, "/foo/0"), "bar");
+      assert.equal(resolvePointer(rfcDocument, "/foo/1"), "baz");
+    });
+
+    it("resolves the empty-string member for a single slash", () => {
+      assert.equal(resolvePointer(rfcDocument, "/"), 0);
+    });
+
+    it("resolves keys containing special characters", () => {
+      assert.equal(resolvePointer(rfcDocument, "/a~1b"), 1);
+      assert.equal(resolvePointer(rfcDocument, "/c%d"), 2);
+      assert.equal(resolvePointer(rfcDocument, "/e^f"), 3);
+      assert.equal(resolvePointer(rfcDocument, "/g|h"), 4);
+      assert.equal(resolvePointer(rfcDocument, "/i\\j"), 5);
+      assert.equal(resolvePointer(rfcDocument, '/k"l'), 6);
+      assert.equal(resolvePointer(rfcDocument, "/ "), 7);
+      assert.equal(resolvePointer(rfcDocument, "/m~0n"), 8);
+    });
+
+    it("decodes ~1 before ~0 so that escapes do not overlap", () => {
+      assert.equal(resolvePointer({ "~1": "tilde-one" }, "/~01"), "tilde-one");
+    });
+
+    it("resolves nested objects and arrays", () => {
+      const document = { a: [{ b: { c: ["deep"] } }] };
+      assert.equal(resolvePointer(document, "/a/0/b/c/0"), "deep");
+    });
+
+    it("returns falsy JSON values as found", () => {
+      const document = { zero: 0, no: false, empty: "", nothing: null };
+      assert.equal(resolvePointer(document, "/zero"), 0);
+      assert.equal(resolvePointer(document, "/no"), false);
+      assert.equal(resolvePointer(document, "/empty"), "");
+      assert.equal(resolvePointer(document, "/nothing"), null);
+    });
+
+    it("resolves the dash as an ordinary member name of an object", () => {
+      assert.equal(resolvePointer({ "-": "dash" }, "/-"), "dash");
+    });
+
+    it("resolves a numeric-looking member name of an object", () => {
+      assert.equal(resolvePointer({ "0": "zero" }, "/0"), "zero");
+    });
+
+    it("returns a scalar document for the empty pointer", () => {
+      assert.equal(resolvePointer(42, ""), 42);
+    });
+  });
+
+  describe("errors on pointers that do not resolve", () => {
+    it("throws for a missing object member", () => {
+      assert.throws(() => resolvePointer(rfcDocument, "/missing"), Error);
+    });
+
+    it("throws for an array index out of range", () => {
+      assert.throws(() => resolvePointer(rfcDocument, "/foo/2"), Error);
+    });
+
+    it("throws for the dash, which refers past the end of an array", () => {
+      assert.throws(() => resolvePointer(rfcDocument, "/foo/-"), Error);
+    });
+
+    it("throws for a non-numeric token applied to an array", () => {
+      assert.throws(() => resolvePointer(rfcDocument, "/foo/bar"), Error);
+    });
+
+    it("throws for an index with leading zeros", () => {
+      assert.throws(() => resolvePointer(rfcDocument, "/foo/01"), Error);
+    });
+
+    it("throws for an index too large to be an array position", () => {
+      assert.throws(
+        () => resolvePointer(rfcDocument, "/foo/99999999999999999999"),
+        Error,
+      );
+    });
+
+    it("throws when descending into a scalar", () => {
+      assert.throws(() => resolvePointer({ a: 1 }, "/a/b"), Error);
+    });
+
+    it("throws when descending into null", () => {
+      assert.throws(() => resolvePointer({ a: null }, "/a/b"), Error);
+    });
+
+    it("throws for a length member of an array", () => {
+      assert.throws(() => resolvePointer(["x"], "/length"), Error);
+    });
+
+    it("does not resolve inherited Object.prototype members", () => {
+      assert.throws(() => resolvePointer({}, "/constructor"), Error);
+      assert.throws(() => resolvePointer({}, "/toString"), Error);
+      assert.throws(() => resolvePointer({}, "/__proto__"), Error);
+      assert.throws(() => resolvePointer({}, "/__proto__/polluted"), Error);
+    });
+  });
+
+  describe("rejecting invalid pointers", () => {
+    it("throws when a non-empty pointer does not start with a slash", () => {
+      assert.throws(() => resolvePointer(rfcDocument, "foo"), Error);
+      assert.throws(() => resolvePointer(rfcDocument, "foo/0"), Error);
+    });
+
+    it("throws for an escape other than ~0 or ~1", () => {
+      assert.throws(() => resolvePointer({ "a~b": 1 }, "/a~b"), Error);
+      assert.throws(() => resolvePointer({ "a~2": 1 }, "/a~2"), Error);
+    });
+
+    it("throws for a tilde at the end of a token", () => {
+      assert.throws(() => resolvePointer({ a: 1 }, "/a~"), Error);
+    });
+
+    it("throws for a pointer that is not a string", () => {
+      assert.throws(() => resolvePointer(rfcDocument, 0 as unknown as string), Error);
+      assert.throws(() => resolvePointer(rfcDocument, undefined as unknown as string), Error);
+    });
+  });
+});
