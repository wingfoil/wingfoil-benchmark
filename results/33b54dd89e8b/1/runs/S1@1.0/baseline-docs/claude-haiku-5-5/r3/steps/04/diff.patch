+++ b/src/json-merge-patch.ts
@@ -0,0 +1,52 @@
+import { defineMember, isJsonValue, isRecord, type JsonObject, type JsonValue } from "./json-value.ts";
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the merged document.
+ *
+ * A patch that is an object merges into the target member by member: a member whose value is `null`
+ * removes that member from the target, and any other member is merged into the target's member of the
+ * same name. A target that is not an object is replaced by an empty object before a patch object is
+ * merged into it. A patch that is not an object, including an array, replaces the target as a whole,
+ * so any `null` inside it is kept as data.
+ *
+ * The input is never modified. The result is a new value that shares no object or array with the
+ * target or the patch, so it can be changed freely.
+ *
+ * Throws an `Error` when the target or the patch is not JSON data, for example a `Date`, a non-finite
+ * number, `undefined` or an object that contains itself.
+ *
+ * @param target - The JSON document to patch.
+ * @param patch - The merge patch to apply.
+ * @returns The merged document, as a new value.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonValue(target)) {
+    throw new Error("Invalid JSON document: the target is not JSON data");
+  }
+  if (!isJsonValue(patch)) {
+    throw new Error("Invalid JSON Merge Patch: the patch is not JSON data");
+  }
+  return mergeValue(structuredClone(target), patch);
+}
+
+/** Merges a patch into a target that the caller owns, and returns the merged value. */
+function mergeValue(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isRecord(patch)) {
+    return structuredClone(patch);
+  }
+  const merged: JsonObject = isRecord(target) ? target : {};
+  for (const name of Object.keys(patch)) {
+    const value = patch[name];
+    if (value === null) {
+      delete merged[name];
+    } else {
+      defineMember(merged, name, mergeValue(ownMember(merged, name), value));
+    }
+  }
+  return merged;
+}
+
+/** Reads a member of the object only when the object owns it, so inherited names such as "constructor" are absent. */
+function ownMember(object: JsonObject, name: string): JsonValue | undefined {
+  return Object.hasOwn(object, name) ? object[name] : undefined;
+}
