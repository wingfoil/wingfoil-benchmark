diff --git a/src/json-value.ts b/src/json-value.ts
index ad97aa2d3d1880e3d5a5495ac211692d9f87b370..147028a7c1536c474580426f7ac4ef6629cbf17a 100644
--- a/src/json-value.ts
+++ b/src/json-value.ts
@@ -8,4 +8,42 @@ export type JsonValue =
   | number
   | string
   | JsonValue[]
-  | { [member: string]: JsonValue };
+  | JsonObject;
+
+/** A JSON object: an object whose members are JSON values. */
+export type JsonObject = { [member: string]: JsonValue };
+
+/** Checks whether a value is a JSON object, which is neither null nor an array. */
+export function isRecord(value: unknown): value is JsonObject {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Sets an own member. Defining the property, rather than assigning it, keeps names such as "__proto__" as data. */
+export function defineMember(object: JsonObject, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { value, enumerable: true, writable: true, configurable: true });
+}
+
+/** Checks that a value is JSON data: a plain object or a dense array, without a cycle, all the way down. */
+export function isJsonValue(value: unknown, ancestors: object[] = []): value is JsonValue {
+  if (value === null || typeof value === "string" || typeof value === "boolean") {
+    return true;
+  }
+  if (typeof value === "number") {
+    return Number.isFinite(value);
+  }
+  if (typeof value !== "object" || ancestors.includes(value)) {
+    return false;
+  }
+  const path = [...ancestors, value];
+  if (Array.isArray(value)) {
+    // A dense array has exactly one own key per element; a hole or an extra property breaks that.
+    return Object.keys(value).length === value.length && value.every((item) => isJsonValue(item, path));
+  }
+  return isPlainObject(value) && Object.values(value).every((member) => isJsonValue(member, path));
+}
+
+/** Checks that an object is a plain object or one with no prototype, such as the result of JSON.parse. */
+function isPlainObject(value: object): boolean {
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
diff --git a/test/apply-merge-patch.test.ts b/test/apply-merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..92289d2220a134291a5df1f5171624c6f98e154e
--- /dev/null
+++ b/test/apply-merge-patch.test.ts
@@ -0,0 +1,127 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+// Patches and documents arrive as untyped external input, so the tests cast the invalid ones through `unknown`.
+const untyped = (value: unknown) => value as Parameters<typeof applyMergePatch>[0];
+
+describe("applyMergePatch", () => {
+  // Examples from RFC 7386, appendix A.
+  describe("RFC 7386 examples", () => {
+    const cases: [string, unknown, unknown, unknown][] = [
+      ["replaces a member", { a: "b" }, { a: "c" }, { a: "c" }],
+      ["adds a member", { a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+      ["removes a member set to null", { a: "b" }, { a: null }, {}],
+      ["removes only the member set to null", { a: "b", b: "c" }, { a: null }, { b: "c" }],
+      ["replaces an array with a string", { a: ["b"] }, { a: "c" }, { a: "c" }],
+      ["replaces a string with an array", { a: "c" }, { a: ["b"] }, { a: ["b"] }],
+      ["merges nested objects and removes a nested member", { a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+      ["replaces an array of objects wholesale", { a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+      ["replaces an array with an array", ["a", "b"], ["c", "d"], ["c", "d"]],
+      ["replaces an object with an array", { a: "b" }, ["c"], ["c"]],
+      ["replaces an object with null", { a: "foo" }, null, null],
+      ["replaces an object with a string", { a: "foo" }, "bar", "bar"],
+      ["keeps a null member that the patch does not remove", { e: null }, { a: 1 }, { e: null, a: 1 }],
+      ["replaces an array with an object, removing a null member", [1, 2], { a: "b", c: null }, { a: "b" }],
+      ["creates nested objects, removing a null member", {}, { a: { bb: { c: null } } }, { a: { bb: {} } }],
+    ];
+    for (const [name, target, patch, expected] of cases) {
+      it(`${name}`, () => {
+        assert.deepEqual(applyMergePatch(untyped(target), untyped(patch)), expected);
+      });
+    }
+  });
+
+  describe("non-object targets", () => {
+    it("replaces a scalar target with an object built from the patch", () => {
+      assert.deepEqual(applyMergePatch(untyped("abc"), untyped({ a: 1 })), { a: 1 });
+    });
+
+    it("replaces an array target with an object built from the patch", () => {
+      assert.deepEqual(applyMergePatch(untyped([1]), untyped({ a: 1 })), { a: 1 });
+    });
+
+    it("builds an empty object from a null target and a patch that only removes members", () => {
+      assert.deepEqual(applyMergePatch(untyped(null), untyped({ a: null })), {});
+    });
+  });
+
+  describe("removal", () => {
+    it("ignores a null member whose name is absent from the target", () => {
+      assert.deepEqual(applyMergePatch({ a: 1 }, { b: null }), { a: 1 });
+    });
+
+    it("does not treat an inherited name as a member of the target", () => {
+      assert.deepEqual(applyMergePatch({}, { constructor: { x: 1 } }), { constructor: { x: 1 } });
+    });
+  });
+
+  describe("nulls inside replaced values", () => {
+    it("keeps nulls inside an array value", () => {
+      assert.deepEqual(applyMergePatch({}, { a: [null, 1] }), { a: [null, 1] });
+    });
+
+    it("keeps nulls inside an array value that replaces an object", () => {
+      assert.deepEqual(applyMergePatch({ a: { b: 1 } }, { a: [{ c: null }] }), { a: [{ c: null }] });
+    });
+  });
+
+  describe("member names that are not plain data", () => {
+    it("adds a member named __proto__ as an own property, without changing the prototype", () => {
+      const result = applyMergePatch({}, JSON.parse('{"__proto__": {"polluted": true}}')) as object;
+      assert.equal(Object.getPrototypeOf(result), Object.prototype);
+      assert.deepEqual(Object.getOwnPropertyDescriptor(result, "__proto__")?.value, { polluted: true });
+      assert.equal(({} as Record<string, unknown>).polluted, undefined);
+    });
+  });
+
+  describe("immutability", () => {
+    it("does not modify the target or the patch", () => {
+      const target = { a: { b: 1, c: [1] } };
+      const patch = { a: { b: null, d: { e: 2 } } };
+      const targetCopy = structuredClone(target);
+      const patchCopy = structuredClone(patch);
+      applyMergePatch(target, patch);
+      assert.deepEqual(target, targetCopy);
+      assert.deepEqual(patch, patchCopy);
+    });
+
+    it("returns a value that shares no object or array with the target", () => {
+      const target = { a: { b: [1] } };
+      const result = applyMergePatch(target, {}) as typeof target;
+      assert.notEqual(result, target);
+      assert.notEqual(result.a, target.a);
+      assert.notEqual(result.a.b, target.a.b);
+    });
+
+    it("returns a value that shares no object or array with the patch", () => {
+      const patch = { a: { b: [1] } };
+      const result = applyMergePatch({}, patch) as typeof patch;
+      assert.notEqual(result.a, patch.a);
+      assert.notEqual(result.a.b, patch.a.b);
+    });
+  });
+
+  describe("invalid input", () => {
+    it("throws when the patch contains a value that is not JSON data", () => {
+      assert.throws(() => applyMergePatch({}, untyped({ a: undefined })), Error);
+      assert.throws(() => applyMergePatch({}, untyped({ a: Number.NaN })), Error);
+      assert.throws(() => applyMergePatch({}, untyped({ a: new Date(0) })), Error);
+    });
+
+    it("throws when the patch is not JSON data at the top level", () => {
+      assert.throws(() => applyMergePatch({}, untyped(undefined)), Error);
+    });
+
+    it("throws when the patch contains itself", () => {
+      const patch: Record<string, unknown> = {};
+      patch.a = patch;
+      assert.throws(() => applyMergePatch({}, untyped(patch)), Error);
+    });
+
+    it("throws when the target is not JSON data", () => {
+      assert.throws(() => applyMergePatch(untyped(new Date(0)), {}), Error);
+      assert.throws(() => applyMergePatch(untyped(Number.POSITIVE_INFINITY), {}), Error);
+    });
+  });
+});
