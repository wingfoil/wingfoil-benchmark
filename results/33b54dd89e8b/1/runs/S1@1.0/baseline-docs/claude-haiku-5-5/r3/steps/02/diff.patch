+++ b/test/apply-patch.test.ts
@@ -0,0 +1,407 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+// Patches arrive as untyped external input, so the tests cast the invalid ones through `unknown`.
+const untyped = (value: unknown) => value as Parameters<typeof applyPatch>[1];
+
+describe("applyPatch", () => {
+  describe("add", () => {
+    it("adds a new object member", () => {
+      assert.deepEqual(
+        applyPatch({ foo: "bar" }, untyped([{ op: "add", path: "/baz", value: "qux" }])),
+        { foo: "bar", baz: "qux" },
+      );
+    });
+
+    it("replaces the value of an existing object member", () => {
+      assert.deepEqual(
+        applyPatch({ foo: "bar" }, untyped([{ op: "add", path: "/foo", value: 1 }])),
+        { foo: 1 },
+      );
+    });
+
+    it("inserts an array element before the given index", () => {
+      assert.deepEqual(
+        applyPatch({ foo: ["bar", "baz"] }, untyped([{ op: "add", path: "/foo/1", value: "qux" }])),
+        { foo: ["bar", "qux", "baz"] },
+      );
+    });
+
+    it("appends an array element with the dash index", () => {
+      assert.deepEqual(
+        applyPatch({ foo: ["bar"] }, untyped([{ op: "add", path: "/foo/-", value: ["abc", "def"] }])),
+        { foo: ["bar", ["abc", "def"]] },
+      );
+    });
+
+    it("inserts at the end of an array when the index equals its length", () => {
+      assert.deepEqual(applyPatch([1, 2], untyped([{ op: "add", path: "/2", value: 3 }])), [1, 2, 3]);
+    });
+
+    it("treats the dash as an ordinary member name of an object", () => {
+      assert.deepEqual(applyPatch({}, untyped([{ op: "add", path: "/-", value: 1 }])), { "-": 1 });
+    });
+
+    it("replaces the whole document for the empty pointer", () => {
+      assert.deepEqual(applyPatch({ foo: 1 }, untyped([{ op: "add", path: "", value: [2] }])), [2]);
+    });
+
+    it("adds a member whose name is __proto__ as an own property", () => {
+      const result = applyPatch({}, untyped([{ op: "add", path: "/__proto__", value: 1 }])) as object;
+      assert.equal(Object.getPrototypeOf(result), Object.prototype);
+      assert.equal(Object.getOwnPropertyDescriptor(result, "__proto__")?.value, 1);
+    });
+
+    it("throws when the parent location does not exist", () => {
+      assert.throws(
+        () => applyPatch({}, untyped([{ op: "add", path: "/baz/bat", value: 1 }])),
+        Error,
+      );
+    });
+
+    it("throws when the parent is a scalar", () => {
+      assert.throws(() => applyPatch({ a: 1 }, untyped([{ op: "add", path: "/a/b", value: 1 }])), Error);
+    });
+
+    it("throws for an array index past the end of the array", () => {
+      assert.throws(
+        () => applyPatch({ foo: ["bar"] }, untyped([{ op: "add", path: "/foo/2", value: 1 }])),
+        Error,
+      );
+    });
+
+    it("throws for a non-numeric token applied to an array", () => {
+      assert.throws(
+        () => applyPatch({ foo: [] }, untyped([{ op: "add", path: "/foo/bar", value: 1 }])),
+        Error,
+      );
+    });
+  });
+
+  describe("remove", () => {
+    it("removes an object member", () => {
+      assert.deepEqual(
+        applyPatch({ baz: "qux", foo: "bar" }, untyped([{ op: "remove", path: "/baz" }])),
+        { foo: "bar" },
+      );
+    });
+
+    it("removes an array element and shifts the rest", () => {
+      assert.deepEqual(
+        applyPatch({ foo: ["bar", "qux", "baz"] }, untyped([{ op: "remove", path: "/foo/1" }])),
+        { foo: ["bar", "baz"] },
+      );
+    });
+
+    it("removes an own __proto__ member", () => {
+      const document = JSON.parse('{"__proto__": 1, "a": 2}') as Parameters<typeof applyPatch>[0];
+      assert.deepEqual(applyPatch(document, untyped([{ op: "remove", path: "/__proto__" }])), { a: 2 });
+    });
+
+    it("throws when the target does not exist", () => {
+      assert.throws(() => applyPatch({ foo: 1 }, untyped([{ op: "remove", path: "/bar" }])), Error);
+    });
+
+    it("throws for an array index out of range", () => {
+      assert.throws(() => applyPatch({ foo: [1] }, untyped([{ op: "remove", path: "/foo/1" }])), Error);
+    });
+
+    it("throws when removing the whole document", () => {
+      assert.throws(() => applyPatch({ foo: 1 }, untyped([{ op: "remove", path: "" }])), Error);
+    });
+  });
+
+  describe("replace", () => {
+    it("replaces an object member value", () => {
+      assert.deepEqual(
+        applyPatch({ baz: "qux", foo: "bar" }, untyped([{ op: "replace", path: "/baz", value: "boo" }])),
+        { baz: "boo", foo: "bar" },
+      );
+    });
+
+    it("keeps the position of a replaced object member", () => {
+      const result = applyPatch(
+        { a: 1, b: 2, c: 3 },
+        untyped([{ op: "replace", path: "/b", value: 9 }]),
+      ) as Record<string, unknown>;
+      assert.deepEqual(Object.keys(result), ["a", "b", "c"]);
+    });
+
+    it("replaces an array element", () => {
+      assert.deepEqual(applyPatch([1, 2, 3], untyped([{ op: "replace", path: "/1", value: "x" }])), [
+        1,
+        "x",
+        3,
+      ]);
+    });
+
+    it("replaces the whole document for the empty pointer", () => {
+      assert.deepEqual(applyPatch({ foo: 1 }, untyped([{ op: "replace", path: "", value: null }])), null);
+    });
+
+    it("throws when the target does not exist", () => {
+      assert.throws(
+        () => applyPatch({ foo: 1 }, untyped([{ op: "replace", path: "/bar", value: 2 }])),
+        Error,
+      );
+    });
+
+    it("throws for the dash, which does not name an existing array element", () => {
+      assert.throws(
+        () => applyPatch({ foo: [1] }, untyped([{ op: "replace", path: "/foo/-", value: 2 }])),
+        Error,
+      );
+    });
+  });
+
+  describe("move", () => {
+    it("moves an object member to another object", () => {
+      assert.deepEqual(
+        applyPatch(
+          { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+          untyped([{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+        ),
+        { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+      );
+    });
+
+    it("moves an array element to a later index", () => {
+      assert.deepEqual(
+        applyPatch(
+          { foo: ["all", "grass", "cows", "eat"] },
+          untyped([{ op: "move", from: "/foo/1", path: "/foo/3" }]),
+        ),
+        { foo: ["all", "cows", "eat", "grass"] },
+      );
+    });
+
+    it("moves a value to the whole-document location", () => {
+      assert.deepEqual(applyPatch({ a: { b: 1 } }, untyped([{ op: "move", from: "/a", path: "" }])), {
+        b: 1,
+      });
+    });
+
+    it("throws when moving a location into one of its own children", () => {
+      assert.throws(
+        () => applyPatch({ foo: { bar: 1 } }, untyped([{ op: "move", from: "/foo", path: "/foo/bar/baz" }])),
+        Error,
+      );
+    });
+
+    it("throws when the source does not exist", () => {
+      assert.throws(() => applyPatch({ a: 1 }, untyped([{ op: "move", from: "/b", path: "/c" }])), Error);
+    });
+
+    it("throws when the destination parent does not exist", () => {
+      assert.throws(
+        () => applyPatch({ a: 1 }, untyped([{ op: "move", from: "/a", path: "/b/c" }])),
+        Error,
+      );
+    });
+  });
+
+  describe("copy", () => {
+    it("copies an array element to the end of the array", () => {
+      assert.deepEqual(
+        applyPatch({ foo: ["bar", "baz"] }, untyped([{ op: "copy", from: "/foo/0", path: "/foo/-" }])),
+        { foo: ["bar", "baz", "bar"] },
+      );
+    });
+
+    it("copies a value to a new object member and keeps the source", () => {
+      assert.deepEqual(
+        applyPatch({ a: { b: 1 } }, untyped([{ op: "copy", from: "/a", path: "/c" }])),
+        { a: { b: 1 }, c: { b: 1 } },
+      );
+    });
+
+    it("throws when the source does not exist", () => {
+      assert.throws(() => applyPatch({ a: 1 }, untyped([{ op: "copy", from: "/b", path: "/c" }])), Error);
+    });
+  });
+
+  describe("test", () => {
+    it("succeeds and leaves the document unchanged when the values are equal", () => {
+      const document = { baz: "qux", foo: ["a", 2, "c"] };
+      assert.deepEqual(
+        applyPatch(document, untyped([
+          { op: "test", path: "/baz", value: "qux" },
+          { op: "test", path: "/foo/1", value: 2 },
