+++ b/src/json-patch.ts
@@ -0,0 +1,243 @@
+import type { JsonValue } from "./json-value.ts";
+import { isArrayIndex, parsePointer, resolveTokens } from "./json-pointer.ts";
+
+/** One operation of a JSON Patch (RFC 6902, section 4). */
+export type JsonPatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; from: string; path: string };
+
+/** A JSON Patch (RFC 6902, section 3): operations that are applied in order. */
+export type JsonPatch = JsonPatchOperation[];
+
+type OperationName = JsonPatchOperation["op"];
+
+/** An operation whose JSON Pointers are already parsed into reference tokens. */
+type Step =
+  | { op: "add" | "replace" | "test"; path: string[]; value: JsonValue }
+  | { op: "remove"; path: string[] }
+  | { op: "move" | "copy"; from: string[]; path: string[] };
+
+/** An array or an object, the places where an operation adds, replaces or removes a member. */
+type Container = JsonValue[] | { [member: string]: JsonValue };
+
+const OPERATION_NAMES: readonly string[] = ["add", "remove", "replace", "move", "copy", "test"];
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the resulting document.
+ *
+ * The input is never modified. The result is a new value that shares no object or array with the
+ * input or with the patch, so it can be changed freely. The whole patch is validated before any
+ * operation runs, and operations run in order, each seeing the results of the ones before it.
+ *
+ * Throws an `Error` when the patch is not a valid JSON Patch, or when an operation fails: a test
+ * that does not match, a location that does not exist, an array index out of range, an attempt
+ * to remove the whole document, or a move into one of the moved location's own children.
+ *
+ * @param document - The JSON document to patch.
+ * @param patch - The operations to apply, in order.
+ * @returns The patched document, as a new value.
+ */
+export function applyPatch(document: JsonValue, patch: JsonPatch): JsonValue {
+  return parsePatch(patch).reduce(applyStep, structuredClone(document));
+}
+
+/** Checks that the patch is an array of valid operations and parses them, before anything is applied. */
+function parsePatch(patch: unknown): Step[] {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: expected an array of operations");
+  }
+  return patch.map((operation: unknown, position) => parseOperation(operation, position));
+}
+
+/** Validates one operation of a patch and parses its JSON Pointers. */
+function parseOperation(operation: unknown, position: number): Step {
+  if (!isRecord(operation)) {
+    throw invalidOperation(position, "is not an object");
+  }
+  const { op } = operation;
+  if (!isOperationName(op)) {
+    throw invalidOperation(position, `has an unknown "op"`);
+  }
+  const path = parseMemberPointer(operation, "path", position);
+  switch (op) {
+    case "add":
+    case "replace":
+    case "test":
+      return { op, path, value: parseValue(operation, position) };
+    case "remove":
+      return { op, path };
+    case "move":
+    case "copy":
+      return { op, from: parseMemberPointer(operation, "from", position), path };
+  }
+}
+
+/** Applies one parsed operation to the document, which the caller owns, and returns the new root. */
+function applyStep(root: JsonValue, step: Step): JsonValue {
+  switch (step.op) {
+    case "add":
+      return add(root, step.path, structuredClone(step.value));
+    case "remove":
+      remove(root, step.path);
+      return root;
+    case "replace":
+      return replace(root, step.path, structuredClone(step.value));
+    case "move":
+      if (isProperPrefix(step.from, step.path)) {
+        throw new Error("JSON Patch move cannot move a location into one of its own children");
+      }
+      return add(root, step.path, remove(root, step.from));
+    case "copy":
+      return add(root, step.path, structuredClone(resolveTokens(root, step.from)));
+    case "test":
+      if (!jsonEqual(resolveTokens(root, step.path), step.value)) {
+        throw new Error("JSON Patch test failed: the value at the location does not match");
+      }
+      return root;
+  }
+}
+
+/** Adds a value at a location, inserting into arrays; returns the new root, which differs only for the empty pointer. */
+function add(root: JsonValue, tokens: string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const [parent, key] = parentOf(root, tokens);
+  if (Array.isArray(parent)) {
+    parent.splice(insertionIndex(key, parent.length), 0, value);
+  } else {
+    defineMember(parent, key, value);
+  }
+  return root;
+}
+
+/** Replaces the value at an existing location; returns the new root, which differs only for the empty pointer. */
+function replace(root: JsonValue, tokens: string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const [parent, key] = parentOf(root, tokens);
+  resolveTokens(parent, [key]); // The target must exist.
+  if (Array.isArray(parent)) {
+    parent[Number(key)] = value;
+  } else {
+    defineMember(parent, key, value);
+  }
+  return root;
+}
+
+/** Removes the value at an existing location, and returns it. */
+function remove(root: JsonValue, tokens: string[]): JsonValue {
+  if (tokens.length === 0) {
+    throw new Error("JSON Patch cannot remove the whole document");
+  }
+  const [parent, key] = parentOf(root, tokens);
+  const removed = resolveTokens(parent, [key]); // The target must exist.
+  if (Array.isArray(parent)) {
+    parent.splice(Number(key), 1);
+  } else {
+    delete parent[key];
+  }
+  return removed;
+}
+
+/** Finds the array or object that holds the location named by the last token. */
+function parentOf(root: JsonValue, tokens: string[]): [Container, string] {
+  const parent = resolveTokens(root, tokens.slice(0, -1));
+  if (!isContainer(parent)) {
+    throw new Error("JSON Patch location does not resolve: its parent is a scalar");
+  }
+  return [parent, tokens[tokens.length - 1]];
+}
+
+/** Returns the index an "add" inserts at in an array: the dash appends, and any other index may equal the length. */
+function insertionIndex(token: string, length: number): number {
+  if (token === "-") {
+    return length;
+  }
+  if (!isArrayIndex(token) || Number(token) > length) {
+    throw new Error(`JSON Patch location does not resolve: "${token}" is not an insertion index`);
+  }
+  return Number(token);
+}
+
+/** Sets an own member. Defining the property, rather than assigning it, keeps names such as "__proto__" as data. */
+function defineMember(object: { [member: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { value, enumerable: true, writable: true, configurable: true });
+}
+
+/** Checks whether `prefix` is a proper prefix of `tokens`, which means a location is moved into its own child. */
+function isProperPrefix(prefix: string[], tokens: string[]): boolean {
+  return prefix.length < tokens.length && prefix.every((token, index) => token === tokens[index]);
+}
+
+/** Compares two JSON values by content: member order in an object is ignored, element order in an array is not. */
+function jsonEqual(left: JsonValue, right: JsonValue): boolean {
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return (
+      Array.isArray(left) &&
+      Array.isArray(right) &&
+      left.length === right.length &&
+      left.every((item, index) => jsonEqual(item, right[index]))
+    );
+  }
+  if (typeof left !== "object" || left === null || typeof right !== "object" || right === null) {
+    return left === right;
+  }
+  const keys = Object.keys(left);
+  return (
+    keys.length === Object.keys(right).length &&
+    keys.every((key) => Object.hasOwn(right, key) && jsonEqual(left[key], right[key]))
+  );
+}
+
+/** Parses the JSON Pointer held by a member of an operation. */
+function parseMemberPointer(operation: Record<string, unknown>, member: "path" | "from", position: number): string[] {
+  const pointer = operation[member];
+  if (typeof pointer !== "string") {
+    throw invalidOperation(position, `has no "${member}" string`);
+  }
+  return parsePointer(pointer);
+}
+
+/** Reads the value of an operation, which must be present and must be a JSON value. */
+function parseValue(operation: Record<string, unknown>, position: number): JsonValue {
+  if (!Object.hasOwn(operation, "value")) {
+    throw invalidOperation(position, `has no "value"`);
+  }
+  const { value } = operation;
+  if (!isJsonValue(value)) {
+    throw invalidOperation(position, `has a "value" that is not JSON`);
+  }
+  return value;
+}
+
+function invalidOperation(position: number, reason: string): Error {
+  return new Error(`Invalid JSON Patch: operation ${position} ${reason}`);
+}
+
+function isOperationName(value: unknown): value is OperationName {
+  return typeof value === "string" && OPERATION_NAMES.includes(value);
+}
+
+function isContainer(value: JsonValue): value is Container {
+  return typeof value === "object" && value !== null;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isJsonValue(value: unknown): value is JsonValue {
+  if (value === null || typeof value === "string" || typeof value === "boolean") {
+    return true;
+  }
+  if (typeof value === "number") {
+    return Number.isFinite(value);
+  }
+  if (Array.isArray(value)) {
+    return value.every(isJsonValue);
+  }
+  return isRecord(value) && Object.values(value).every(isJsonValue);
+}
