diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9f5b3c29c197b3f9a994f51ef61f0c638f811eed
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,126 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+// Documents and values arrive as untyped external input, so the tests cast the invalid ones through `unknown`.
+const untyped = (value: unknown) => value as Parameters<typeof createPatch>[0];
+
+describe("createPatch", () => {
+  describe("describes the change", () => {
+    const cases: [string, unknown, unknown, unknown][] = [
+      ["an identical document gives an empty patch", { a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }, []],
+      ["replaces a changed scalar", { a: 1 }, { a: 2 }, [{ op: "replace", path: "/a", value: 2 }]],
+      ["adds a new member", { a: 1 }, { a: 1, b: 2 }, [{ op: "add", path: "/b", value: 2 }]],
+      ["removes a member that is gone", { a: 1, b: 2 }, { a: 1 }, [{ op: "remove", path: "/b" }]],
+      ["sets a member to null rather than removing it", { a: 1 }, { a: null }, [{ op: "replace", path: "/a", value: null }]],
+      ["changes only the nested member that differs", { a: { b: 1, c: 2 } }, { a: { b: 1, c: 3 } }, [{ op: "replace", path: "/a/c", value: 3 }]],
+      ["replaces an array element in place", [1, 2, 3], [1, 5, 3], [{ op: "replace", path: "/1", value: 5 }]],
+      ["appends to an array", [1, 2], [1, 2, 3], [{ op: "add", path: "/2", value: 3 }]],
+      ["inserts at the front of an array", [2, 3], [1, 2, 3], [{ op: "add", path: "/0", value: 1 }]],
+      ["removes from the middle of an array", [1, 2, 3], [1, 3], [{ op: "remove", path: "/1" }]],
+      [
+        "changes one field of an object inside an array",
+        [{ id: 1, n: "a" }, { id: 2, n: "b" }],
+        [{ id: 1, n: "a" }, { id: 2, n: "c" }],
+        [{ op: "replace", path: "/1/n", value: "c" }],
+      ],
+      ["replaces the whole document when its type changes", { a: 1 }, [1], [{ op: "replace", path: "", value: [1] }]],
+      ["replaces a scalar document", 1, "one", [{ op: "replace", path: "", value: "one" }]],
+      ["builds an array from an empty one", [], [1, 2], [{ op: "add", path: "/0", value: 1 }, { op: "add", path: "/1", value: 2 }]],
+      ["empties an array", [1, 2], [], [{ op: "remove", path: "/0" }, { op: "remove", path: "/0" }]],
+    ];
+    for (const [name, from, to, expected] of cases) {
+      it(name, () => {
+        assert.deepEqual(createPatch(untyped(from), untyped(to)), expected);
+      });
+    }
+
+    it("escapes slashes and tildes in member names as RFC 6901 requires", () => {
+      assert.deepEqual(createPatch({ "a/b": 1, "c~d": 1 }, { "a/b": 2, "c~d": 1 }), [
+        { op: "replace", path: "/a~1b", value: 2 },
+      ]);
+    });
+
+    it("pairs changed objects inside an array so that only their differing members are patched", () => {
+      const from = [{ id: "x", n: 1 }, { id: "y", n: 2 }, { id: "z", n: 3 }];
+      const to = [{ id: "x", n: 1 }, { id: "y", n: 9 }, { id: "z", n: 3 }];
+      assert.deepEqual(createPatch(from, to), [{ op: "replace", path: "/1/n", value: 9 }]);
+    });
+  });
+
+  describe("applied to the input, gives the target", () => {
+    const documents: [string, unknown, unknown][] = [
+      ["nested objects and arrays", { a: [{ b: 1 }, [2, 3]], c: { d: null } }, { a: [{ b: 2 }, [2]], c: { e: true } }],
+      ["arrays with repeated values", [1, 1, 2, 1, 2], [2, 1, 1, 2, 1, 1]],
+      ["arrays of objects reordered and changed", [{ k: 1 }, { k: 2 }, { k: 3 }], [{ k: 3 }, { k: 2, v: 0 }]],
+      ["an empty object to a full one", {}, { a: { b: [null, false, "s"] } }],
+      ["a full object to an empty one", { a: { b: [1] } }, {}],
+      ["a member name that is a prototype name", { __proto__x: 1 }, { __proto__x: 2, constructor: [] }],
+      ["a document whose type changes at the root", [1, 2], { a: [1, 2] }],
+    ];
+    for (const [name, from, to] of documents) {
+      it(`reproduces the target for ${name}`, () => {
+        assert.deepEqual(applyPatch(untyped(from), createPatch(untyped(from), untyped(to))), to);
+      });
+    }
+  });
+
+  describe("size of the patch", () => {
+    it("describes one changed member of a large document with one operation", () => {
+      const from = { items: Array.from({ length: 1000 }, (_, index) => ({ id: index, name: `item ${index}` })) };
+      const to = structuredClone(from);
+      to.items[500].name = "changed";
+      assert.deepEqual(createPatch(from, to), [{ op: "replace", path: "/items/500/name", value: "changed" }]);
+    });
+
+    it("describes one inserted element of a large array with one operation", () => {
+      const from = Array.from({ length: 1000 }, (_, index) => index);
+      const to = [...from.slice(0, 700), -1, ...from.slice(700)];
+      assert.deepEqual(createPatch(from, to), [{ op: "add", path: "/700", value: -1 }]);
+    });
+
+    it("keeps the patch small when two distant parts of a very large array change", () => {
+      const from = Array.from({ length: 5000 }, (_, index) => index);
+      const to = [...from];
+      to[0] = -1;
+      to[4999] = -2;
+      const patch = createPatch(from, to);
+      assert.equal(patch.length, 2);
+      assert.deepEqual(applyPatch(from, patch), to);
+    });
+  });
+
+  describe("does not modify its inputs", () => {
+    it("leaves both documents unchanged", () => {
+      const from = { a: [1, { b: 2 }] };
+      const to = { a: [1, { b: 3 }], c: "new" };
+      const fromCopy = structuredClone(from);
+      const toCopy = structuredClone(to);
+      createPatch(from, to);
+      assert.deepEqual(from, fromCopy);
+      assert.deepEqual(to, toCopy);
+    });
+
+    it("gives values that share no object with the target", () => {
+      const to = { added: { nested: [1] } };
+      const patch = createPatch({}, to);
+      assert.notEqual(patch[0].value, to.added);
+    });
+  });
+
+  describe("invalid input", () => {
+    it("throws when the source is not JSON data", () => {
+      assert.throws(() => createPatch(untyped(undefined), untyped({})), /not JSON data/);
+    });
+
+    it("throws when the target holds a non-finite number", () => {
+      assert.throws(() => createPatch(untyped({}), untyped({ a: Number.NaN })), /not JSON data/);
+    });
+
+    it("throws when the target contains itself", () => {
+      const to: Record<string, unknown> = {};
+      to.self = to;
+      assert.throws(() => createPatch(untyped({}), untyped(to)), /not JSON data/);
+    });
+  });
+});
