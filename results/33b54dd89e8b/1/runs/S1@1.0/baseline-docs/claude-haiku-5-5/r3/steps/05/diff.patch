+++ b/src/json-patch-diff.ts
@@ -0,0 +1,166 @@
+import type { JsonPatch, JsonPatchOperation } from "./json-patch.ts";
+import { formatPointer } from "./json-pointer.ts";
+import { isJsonValue, isRecord, jsonEqual, type JsonObject, type JsonValue } from "./json-value.ts";
+
+/** A pair of positions, one in each array, of two elements that are equal. */
+type Match = [from: number, to: number];
+
+// Above this many cells, the common elements of two arrays are not searched for; their middles are then paired by position.
+const MAX_ALIGNMENT_CELLS = 4_000_000;
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied, and describes only what changed.
+ *
+ * Objects are compared member by member, so a changed member is one `replace` and a change deep inside
+ * a document is described at its own location. Arrays are aligned on their common elements, so an
+ * inserted or removed element is one `add` or `remove` rather than a shift of every element after it,
+ * and an element that changed in place is described inside it. Together these keep a small edit to a
+ * large document a small patch.
+ *
+ * The inputs are never modified. The values in the patch are copies, so the patch shares no object or
+ * array with either input.
+ *
+ * Throws an `Error` when either document is not JSON data, for example a `Date`, a non-finite number,
+ * `undefined` or an object that contains itself.
+ *
+ * @param from - The document the patch starts from.
+ * @param to - The document the patch must produce.
+ * @returns The operations that, applied in order to `from`, produce `to`; an empty array when they are equal.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatch {
+  if (!isJsonValue(from)) {
+    throw new Error("Invalid JSON document: the source is not JSON data");
+  }
+  if (!isJsonValue(to)) {
+    throw new Error("Invalid JSON document: the target is not JSON data");
+  }
+  return diffValues(from, to, []);
+}
+
+/** Describes the operations that turn one value into another, at the location named by the path tokens. */
+function diffValues(from: JsonValue, to: JsonValue, path: string[]): JsonPatch {
+  if (jsonEqual(from, to)) {
+    return [];
+  }
+  if (isRecord(from) && isRecord(to)) {
+    return diffObjects(from, to, path);
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    return diffArrays(from, to, path);
+  }
+  return [{ op: "replace", path: formatPointer(path), value: structuredClone(to) }];
+}
+
+/** Describes the members that were removed, added or changed between two objects. */
+function diffObjects(from: JsonObject, to: JsonObject, path: string[]): JsonPatch {
+  const removals = Object.keys(from)
+    .filter((name) => !Object.hasOwn(to, name))
+    .map((name): JsonPatchOperation => ({ op: "remove", path: formatPointer([...path, name]) }));
+  const changes = Object.keys(to).flatMap((name): JsonPatch =>
+    Object.hasOwn(from, name)
+      ? diffValues(from[name], to[name], [...path, name])
+      : [{ op: "add", path: formatPointer([...path, name]), value: structuredClone(to[name]) }],
+  );
+  return [...removals, ...changes];
+}
+
+/** Describes the changes between two arrays, aligning their common elements so that they stay in place. */
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string[]): JsonPatch {
+  let nextFrom = 0;
+  let nextTo = 0;
+  const patch: JsonPatch = [];
+  // The sentinel after the last element closes the final gap between the common elements.
+  for (const [matchFrom, matchTo] of [...commonElements(from, to), [from.length, to.length] as Match]) {
+    patch.push(...diffGap(from.slice(nextFrom, matchFrom), to.slice(nextTo, matchTo), nextTo, path));
+    nextFrom = matchFrom + 1;
+    nextTo = matchTo + 1;
+  }
+  return patch;
+}
+
+/**
+ * Describes the change between the elements that lie between two common elements.
+ *
+ * Operations run in order, so when the array is patched, every element before `base` is already in its
+ * final place and the gap starts at index `base`. Paired elements are described in place; the surplus
+ * ones are removed or inserted at the index where the gap continues.
+ */
+function diffGap(removed: JsonValue[], added: JsonValue[], base: number, path: string[]): JsonPatch {
+  const paired = Math.min(removed.length, added.length);
+  const pairedChanges = removed
+    .slice(0, paired)
+    .flatMap((item, offset) => diffValues(item, added[offset], [...path, String(base + offset)]));
+  // Each removal shifts the next element into the same index, so the surplus removals all target one index.
+  const surplusRemovals = removed
+    .slice(paired)
+    .map((): JsonPatchOperation => ({ op: "remove", path: formatPointer([...path, String(base + paired)]) }));
+  const surplusAdditions = added.slice(paired).map((value, offset): JsonPatchOperation => ({
+    op: "add",
+    path: formatPointer([...path, String(base + paired + offset)]),
+    value: structuredClone(value),
+  }));
+  return [...pairedChanges, ...surplusRemovals, ...surplusAdditions];
+}
+
+/**
+ * Finds the elements the two arrays have in common, as pairs of positions in increasing order.
+ *
+ * The elements that match at the start and at the end are taken directly, which is always part of
+ * some longest common subsequence. Only the middle is searched, with a longest common subsequence.
+ */
+function commonElements(from: JsonValue[], to: JsonValue[]): Match[] {
+  let prefix = 0;
+  while (prefix < from.length && prefix < to.length && jsonEqual(from[prefix], to[prefix])) {
+    prefix++;
+  }
+  let suffix = 0;
+  while (
+    suffix < from.length - prefix &&
+    suffix < to.length - prefix &&
+    jsonEqual(from[from.length - 1 - suffix], to[to.length - 1 - suffix])
+  ) {
+    suffix++;
+  }
+  const middle = longestCommonSubsequence(from.slice(prefix, from.length - suffix), to.slice(prefix, to.length - suffix));
+  return [
+    ...Array.from({ length: prefix }, (_, index): Match => [index, index]),
+    ...middle.map(([matchFrom, matchTo]): Match => [matchFrom + prefix, matchTo + prefix]),
+    ...Array.from({ length: suffix }, (_, index): Match => [from.length - suffix + index, to.length - suffix + index]),
+  ];
+}
+
+/**
+ * Finds a longest common subsequence of two arrays, by dynamic programming over their suffixes.
+ *
+ * When the table would be too large, no pairs are found, so the caller pairs the elements by position.
+ */
+function longestCommonSubsequence(from: JsonValue[], to: JsonValue[]): Match[] {
+  if (from.length * to.length > MAX_ALIGNMENT_CELLS) {
+    return [];
+  }
+  const width = to.length + 1;
+  // lengths[i * width + j] is the length of a longest common subsequence of from[i..] and to[j..].
+  const lengths = new Uint32Array((from.length + 1) * width);
+  for (let i = from.length - 1; i >= 0; i--) {
+    for (let j = to.length - 1; j >= 0; j--) {
+      lengths[i * width + j] = jsonEqual(from[i], to[j])
+        ? lengths[(i + 1) * width + j + 1] + 1
+        : Math.max(lengths[(i + 1) * width + j], lengths[i * width + j + 1]);
+    }
+  }
+  const matches: Match[] = [];
+  let i = 0;
+  let j = 0;
+  while (i < from.length && j < to.length) {
+    if (jsonEqual(from[i], to[j]) && lengths[i * width + j] === lengths[(i + 1) * width + j + 1] + 1) {
+      matches.push([i, j]);
+      i++;
+      j++;
+    } else if (lengths[(i + 1) * width + j] >= lengths[i * width + j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return matches;
+}
