+
+describe('applyPatch: test', () => {
+  test('succeeds when the values are equal, comparing structure', () => {
+    const document = { baz: 'qux', foo: ['a', 2, 'c'] };
+    assert.deepEqual(
+      applyPatch(document, [
+        { op: 'test', path: '/baz', value: 'qux' },
+        { op: 'test', path: '/foo', value: ['a', 2, 'c'] },
+        { op: 'test', path: '/foo/1', value: 2 },
+        { op: 'test', path: '', value: document },
+      ]),
+      document,
+    );
+  });
+
+  test('fails when the values differ', () => {
+    assert.throws(() => applyPatch({ baz: 'qux' }, [{ op: 'test', path: '/baz', value: 'bar' }]));
+  });
+
+  test('fails on a type mismatch, such as "10" against 10', () => {
+    assert.throws(() => applyPatch({ a: 10 }, [{ op: 'test', path: '/a', value: '10' }]));
+  });
+
+  test('fails when an array has a different length or an object a different key set', () => {
+    assert.throws(() => applyPatch({ a: [1, 2] }, [{ op: 'test', path: '/a', value: [1] }]));
+    assert.throws(() => applyPatch({ a: { x: 1 } }, [{ op: 'test', path: '/a', value: { x: 1, y: 2 } }]));
+  });
+
+  test('a missing target is an error', () => {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: 'test', path: '/b', value: 1 }]));
+  });
+});
+
+describe('applyPatch: sequences and failures', () => {
+  test('operations apply in order, each to the result of the previous one', () => {
+    assert.deepEqual(
+      applyPatch({ a: 1 }, [
+        { op: 'add', path: '/b', value: 2 },
+        { op: 'replace', path: '/a', value: 3 },
+        { op: 'move', from: '/b', path: '/c' },
+      ]),
+      { a: 3, c: 2 },
+    );
+  });
+
+  test('an empty patch returns an equal document', () => {
+    assert.deepEqual(applyPatch({ a: [1] }, []), { a: [1] });
+  });
+
+  test('a failing operation makes the whole call throw', () => {
+    assert.throws(() =>
+      applyPatch({ a: 1 }, [
+        { op: 'add', path: '/b', value: 2 },
+        { op: 'remove', path: '/missing' },
+      ]),
+    );
+  });
+});
+
+describe('applyPatch: invalid patches', () => {
+  test('a patch that is not an array is an error', () => {
+    assert.throws(() => applyUnchecked({}, { op: 'add', path: '/a', value: 1 }), SyntaxError);
+  });
+
+  test('an operation that is not an object is an error', () => {
+    assert.throws(() => applyUnchecked({}, [null]), SyntaxError);
+    assert.throws(() => applyUnchecked({}, ['add']), SyntaxError);
+    assert.throws(() => applyUnchecked({}, [[{ op: 'add' }]]), SyntaxError);
+  });
+
+  test('a missing or unknown "op" is an error', () => {
+    assert.throws(() => applyUnchecked({}, [{ path: '/a', value: 1 }]), SyntaxError);
+    assert.throws(() => applyUnchecked({}, [{ op: 'append', path: '/a', value: 1 }]), SyntaxError);
+  });
+
+  test('a missing "path" is an error', () => {
+    assert.throws(() => applyUnchecked({}, [{ op: 'remove' }]), SyntaxError);
+  });
+
+  test('a path that is not a JSON Pointer is an error', () => {
+    assert.throws(() => applyUnchecked({ a: 1 }, [{ op: 'remove', path: 'a' }]), SyntaxError);
+    assert.throws(() => applyUnchecked({ a: 1 }, [{ op: 'remove', path: '/a~2' }]), SyntaxError);
+  });
+
+  test('add, replace and test require a "value" member, which may be null', () => {
+    assert.throws(() => applyUnchecked({}, [{ op: 'add', path: '/a' }]), SyntaxError);
+    assert.throws(() => applyUnchecked({ a: 1 }, [{ op: 'replace', path: '/a' }]), SyntaxError);
+    assert.throws(() => applyUnchecked({}, [{ op: 'test', path: '/a' }]), SyntaxError);
+    assert.deepEqual(applyUnchecked({ a: 1 }, [{ op: 'replace', path: '/a', value: null }]), { a: null });
+  });
+
+  test('move and copy require a "from" member', () => {
+    assert.throws(() => applyUnchecked({}, [{ op: 'move', path: '/a' }]), SyntaxError);
+    assert.throws(() => applyUnchecked({}, [{ op: 'copy', path: '/a', from: 1 }]), SyntaxError);
+  });
+
+  test('an invalid operation anywhere in the patch is an error before anything is applied', () => {
+    const document = { a: 1 };
+    assert.throws(() =>
+      applyUnchecked(document, [
+        { op: 'remove', path: '/a' },
+        { op: 'bogus', path: '/b' },
+      ]),
+      SyntaxError,
+    );
+    assert.deepEqual(document, { a: 1 });
+  });
+});
+
+describe('applyPatch: immutability', () => {
+  test('the input document is not mutated by a successful patch', () => {
+    const document = { foo: ['bar'], nested: { a: 1 } };
+    const snapshot = JSON.stringify(document);
+    applyPatch(document, [
+      { op: 'add', path: '/foo/-', value: 'baz' },
+      { op: 'replace', path: '/nested/a', value: 2 },
+      { op: 'move', from: '/nested', path: '/moved' },
+      { op: 'remove', path: '/foo/0' },
+    ]);
+    assert.equal(JSON.stringify(document), snapshot);
+  });
+
+  test('the input document is not mutated when a patch fails', () => {
+    const document = { foo: ['bar'] };
+    const snapshot = JSON.stringify(document);
+    assert.throws(() =>
+      applyPatch(document, [
+        { op: 'add', path: '/foo/-', value: 'baz' },
+        { op: 'test', path: '/foo/0', value: 'nope' },
+      ]),
+    );
+    assert.equal(JSON.stringify(document), snapshot);
+  });
+
+  test('the result shares no structure with the input', () => {
+    const document = { nested: { a: [1] } };
+    const result = applyPatch(document, [{ op: 'add', path: '/other', value: 1 }]) as typeof document & {
+      other: number;
+    };
+    assert.notEqual(result.nested, document.nested);
+    assert.notEqual(result.nested.a, document.nested.a);
+    result.nested.a.push(2);
+    assert.deepEqual(document, { nested: { a: [1] } });
+  });
+
+  test('a value taken from the patch is copied, so later operations do not change the patch', () => {
+    const patch: JsonPatch = [
+      { op: 'add', path: '/a', value: { x: 1 } },
+      { op: 'add', path: '/a/y', value: 2 },
+    ];
+    const result = applyPatch({}, patch);
+    assert.deepEqual(result, { a: { x: 1, y: 2 } });
+    assert.deepEqual(patch[0], { op: 'add', path: '/a', value: { x: 1 } });
+  });
+});
