+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch, type JsonPatch } from '../src/index.ts';
+
+// Patches are checked at runtime, so the invalid ones are passed through an untyped helper.
+const applyUnchecked = (document: unknown, patch: unknown) =>
+  applyPatch(document as never, patch as JsonPatch);
+
+describe('applyPatch: add', () => {
+  test('adds an object member', () => {
+    assert.deepEqual(
+      applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/baz', value: 'qux' }]),
+      { foo: 'bar', baz: 'qux' },
+    );
+  });
+
+  test('replaces the value of an existing object member', () => {
+    assert.deepEqual(applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/foo', value: 1 }]), { foo: 1 });
+  });
+
+  test('inserts an array element before the index', () => {
+    assert.deepEqual(
+      applyPatch({ foo: ['bar', 'baz'] }, [{ op: 'add', path: '/foo/1', value: 'qux' }]),
+      { foo: ['bar', 'qux', 'baz'] },
+    );
+  });
+
+  test('appends an array element at index equal to the length', () => {
+    assert.deepEqual(applyPatch([1, 2], [{ op: 'add', path: '/2', value: 3 }]), [1, 2, 3]);
+  });
+
+  test('the "-" token appends an array element', () => {
+    assert.deepEqual(applyPatch({ a: [1] }, [{ op: 'add', path: '/a/-', value: 2 }]), { a: [1, 2] });
+  });
+
+  test('an empty path replaces the whole document', () => {
+    assert.deepEqual(applyPatch({ a: 1 }, [{ op: 'add', path: '', value: [true] }]), [true]);
+  });
+
+  test('adds a nested object and a null value', () => {
+    assert.deepEqual(
+      applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/child', value: { grandchild: {} } }]),
+      { foo: 'bar', child: { grandchild: {} } },
+    );
+    assert.deepEqual(applyPatch({}, [{ op: 'add', path: '/n', value: null }]), { n: null });
+  });
+
+  test('stores "__proto__" as an own member without touching the prototype', () => {
+    const result = applyPatch({}, [{ op: 'add', path: '/__proto__', value: { polluted: true } }]);
+    assert.equal(Object.hasOwn(result as object, '__proto__'), true);
+    assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  });
+
+  test('an array index above the length is an error', () => {
+    assert.throws(() => applyPatch([1], [{ op: 'add', path: '/2', value: 3 }]));
+  });
+
+  test('a non-numeric or leading-zero array index is an error', () => {
+    assert.throws(() => applyPatch([1], [{ op: 'add', path: '/x', value: 3 }]));
+    assert.throws(() => applyPatch([1], [{ op: 'add', path: '/01', value: 3 }]));
+  });
+
+  test('adding under a missing parent is an error', () => {
+    assert.throws(() => applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/baz/bat', value: 'qux' }]));
+  });
+
+  test('adding under a primitive is an error', () => {
+    assert.throws(() => applyPatch({ foo: 1 }, [{ op: 'add', path: '/foo/bar', value: 'qux' }]));
+  });
+});
+
+describe('applyPatch: remove', () => {
+  test('removes an object member', () => {
+    assert.deepEqual(applyPatch({ baz: 'qux', foo: 'bar' }, [{ op: 'remove', path: '/baz' }]), { foo: 'bar' });
+  });
+
+  test('removes an array element and shifts the rest', () => {
+    assert.deepEqual(
+      applyPatch({ foo: ['bar', 'qux', 'baz'] }, [{ op: 'remove', path: '/foo/1' }]),
+      { foo: ['bar', 'baz'] },
