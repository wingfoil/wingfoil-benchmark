+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the merged document. The input is
+ * not modified: the result is a new value that shares no structure with the target or the patch.
+ *
+ * @throws {SyntaxError} when the patch is not a JSON value.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonValue(patch)) {
+    throw new SyntaxError('invalid JSON Merge Patch: the patch is not a JSON value');
+  }
+  return mergePatch(target, patch);
+}
+
+/**
+ * Merges a patch into a target, as MergePatch is defined in RFC 7386, section 2. A member the patch names
+ * with `null` is removed; any other member is merged recursively. Members the patch does not name are copied.
+ */
+function mergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isRecord(patch)) {
+    return copyValue(patch);
+  }
+  const base: { [key: string]: JsonValue } = isRecord(target) ? target : {};
+  const merged: { [key: string]: JsonValue } = {};
+  for (const key of Object.keys(base)) {
+    if (!Object.hasOwn(patch, key)) {
+      setMember(merged, key, copyValue(base[key]));
+    }
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value !== null) {
+      setMember(merged, key, mergePatch(Object.hasOwn(base, key) ? base[key] : null, value));
+    }
+  }
+  return merged;
+}
+
+/** True when a value is a JSON object, as opposed to an array, a primitive or null. */
+function isRecord(value: JsonValue): value is { [key: string]: JsonValue } {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
