+++ b/test/merge-patch.test.ts
@@ -0,0 +1,130 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyMergePatch } from '../src/index.ts';
+
+describe('applyMergePatch: RFC 7386 appendix A examples', () => {
+  test('replaces a member with a new value', () => {
+    assert.deepEqual(applyMergePatch({ a: 'b' }, { a: 'c' }), { a: 'c' });
+  });
+
+  test('adds a member that the target does not have', () => {
+    assert.deepEqual(applyMergePatch({ a: 'b' }, { b: 'c' }), { a: 'b', b: 'c' });
+  });
+
+  test('a null member removes the member from the target', () => {
+    assert.deepEqual(applyMergePatch({ a: 'b' }, { a: null }), {});
+    assert.deepEqual(applyMergePatch({ a: 'b', b: 'c' }, { a: null }), { b: 'c' });
+  });
+
+  test('an array in the target is replaced by a string in the patch', () => {
+    assert.deepEqual(applyMergePatch({ a: ['b'] }, { a: 'c' }), { a: 'c' });
+  });
+
+  test('a string in the target is replaced by an array in the patch', () => {
+    assert.deepEqual(applyMergePatch({ a: 'c' }, { a: ['b'] }), { a: ['b'] });
+  });
+
+  test('members of nested objects are merged, and null removes a nested member', () => {
+    assert.deepEqual(applyMergePatch({ a: { b: 'c' } }, { a: { b: 'd', c: null } }), { a: { b: 'd' } });
+  });
+
+  test('an array of objects in the target is replaced as a whole', () => {
+    assert.deepEqual(applyMergePatch({ a: [{ b: 'c' }] }, { a: [1] }), { a: [1] });
+  });
+
+  test('an array target is replaced by an array patch', () => {
+    assert.deepEqual(applyMergePatch(['a', 'b'], ['c', 'd']), ['c', 'd']);
+  });
+
+  test('an object patch replaces an array target', () => {
+    assert.deepEqual(applyMergePatch({ a: 'b' }, ['c']), ['c']);
+  });
+
+  test('a null patch replaces the whole document', () => {
+    assert.equal(applyMergePatch({ a: 'foo' }, null), null);
+  });
+
+  test('a string patch replaces the whole document', () => {
+    assert.equal(applyMergePatch({ a: 'foo' }, 'bar'), 'bar');
+  });
+
+  test('a null member of the target is kept when the patch does not name it', () => {
+    assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+  });
+
+  test('an array target with an object patch: null members are dropped, others are added', () => {
+    assert.deepEqual(applyMergePatch([1, 2], { a: 'b', c: null }), { a: 'b' });
+  });
+
+  test('a null member inside a new nested object is removed from the result', () => {
+    assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+  });
+});
+
+describe('applyMergePatch: rules', () => {
+  test('a non-object target is treated as an empty object when the patch is an object', () => {
+    assert.deepEqual(applyMergePatch('foo', { a: 1 }), { a: 1 });
+    assert.deepEqual(applyMergePatch(null, { a: 1, b: null }), { a: 1 });
+    assert.deepEqual(applyMergePatch([1, 2], { a: 'b' }), { a: 'b' });
+  });
+
+  test('a null member of the patch is ignored when the target has no such member', () => {
+    assert.deepEqual(applyMergePatch({ a: 1 }, { b: null }), { a: 1 });
+  });
+
+  test('an empty object patch leaves the target equal to itself', () => {
+    assert.deepEqual(applyMergePatch({ a: { b: [1] } }, {}), { a: { b: [1] } });
+  });
+
+  test('a non-null member value merges into the existing nested object', () => {
+    assert.deepEqual(
+      applyMergePatch({ a: { x: 1, y: { z: 2 } } }, { a: { y: { w: 3 } } }),
+      { a: { x: 1, y: { z: 2, w: 3 } } },
+    );
+  });
+
+  test('a primitive value in the patch replaces an object in the target', () => {
+    assert.deepEqual(applyMergePatch({ a: { b: 1 } }, { a: 5 }), { a: 5 });
+  });
+
+  test('members are set as own data, so "__proto__" stays a plain member', () => {
+    const result = applyMergePatch({}, JSON.parse('{"__proto__": {"polluted": true}}')) as Record<string, unknown>;
+    assert.equal(Object.hasOwn(result, '__proto__'), true);
+    assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  });
+});
+
+describe('applyMergePatch: input and output', () => {
+  test('does not modify the target or the patch', () => {
+    const target = { a: { b: 'c', d: [1] }, e: 'f' };
+    const patch = { a: { b: 'x', g: { h: 1 } }, e: null };
+    const targetBefore = structuredClone(target);
+    const patchBefore = structuredClone(patch);
+    applyMergePatch(target, patch);
+    assert.deepEqual(target, targetBefore);
+    assert.deepEqual(patch, patchBefore);
+  });
+
+  test('the result shares no object with the patch', () => {
+    const patch = { a: { b: 1 } };
+    const result = applyMergePatch({}, patch) as { a: { b: number } };
+    result.a.b = 2;
+    assert.equal(patch.a.b, 1);
+  });
+
+  test('the result shares no object with the target', () => {
+    const target = { a: { b: 1 } };
+    const result = applyMergePatch(target, {}) as { a: { b: number } };
+    result.a.b = 2;
+    assert.equal(target.a.b, 1);
+  });
+});
+
+describe('applyMergePatch: errors', () => {
+  test('a patch that is not a JSON value throws a SyntaxError', () => {
+    assert.throws(() => applyMergePatch({}, { a: undefined } as never), SyntaxError);
+    assert.throws(() => applyMergePatch({}, { a: NaN } as never), SyntaxError);
+    assert.throws(() => applyMergePatch({}, { a: new Date(0) } as never), SyntaxError);
+    assert.throws(() => applyMergePatch({}, [undefined] as never), SyntaxError);
+  });
+});
