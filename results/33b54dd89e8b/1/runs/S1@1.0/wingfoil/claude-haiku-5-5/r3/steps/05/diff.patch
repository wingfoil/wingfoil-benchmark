index 0000000000000000000000000000000000000000..eb9c3d9da3875e44588a8b097ea09a6d0a366de2
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,124 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch, createPatch } from '../src/index.ts';
+
+describe('createPatch: the patch turns from into to', () => {
+  test('equal documents give an empty patch', () => {
+    assert.deepEqual(createPatch({ a: [1, { b: 'c' }] }, { a: [1, { b: 'c' }] }), []);
+  });
+
+  test('a changed scalar member gives one replace', () => {
+    assert.deepEqual(createPatch({ a: 'b' }, { a: 'c' }), [{ op: 'replace', path: '/a', value: 'c' }]);
+  });
+
+  test('a member only in to gives one add', () => {
+    assert.deepEqual(createPatch({ a: 'b' }, { a: 'b', c: 1 }), [{ op: 'add', path: '/c', value: 1 }]);
+  });
+
+  test('a member only in from gives one remove', () => {
+    assert.deepEqual(createPatch({ a: 'b', c: 1 }, { a: 'b' }), [{ op: 'remove', path: '/c' }]);
+  });
+
+  test('a change in one nested member gives one replace at that member', () => {
+    const from = { user: { name: 'Ada', address: { city: 'London', zip: 'N1' }, tags: ['x'] } };
+    const to = { user: { name: 'Ada', address: { city: 'Paris', zip: 'N1' }, tags: ['x'] } };
+    assert.deepEqual(createPatch(from, to), [{ op: 'replace', path: '/user/address/city', value: 'Paris' }]);
+  });
+
+  test('a value whose type changes gives one replace', () => {
+    assert.deepEqual(createPatch({ a: 1 }, { a: [1] }), [{ op: 'replace', path: '/a', value: [1] }]);
+    assert.deepEqual(createPatch({ a: { b: 1 } }, { a: 'x' }), [{ op: 'replace', path: '/a', value: 'x' }]);
+    assert.deepEqual(createPatch({ a: null }, { a: false }), [{ op: 'replace', path: '/a', value: false }]);
+  });
+
+  test('a root whose kind changes is replaced as a whole, at the empty pointer', () => {
+    assert.deepEqual(createPatch({ a: 1 }, [1]), [{ op: 'replace', path: '', value: [1] }]);
+    assert.deepEqual(createPatch('a', 'b'), [{ op: 'replace', path: '', value: 'b' }]);
+  });
+
+  test('an element appended to an array gives one add at its index', () => {
+    assert.deepEqual(createPatch({ a: [1, 2, 3] }, { a: [1, 2, 3, 4] }), [{ op: 'add', path: '/a/3', value: 4 }]);
+  });
+
+  test('an element removed from the middle of an array gives one remove', () => {
+    assert.deepEqual(createPatch({ a: [1, 2, 3] }, { a: [1, 3] }), [{ op: 'remove', path: '/a/1' }]);
+  });
+
+  test('an element inserted into the middle of an array gives one add', () => {
+    assert.deepEqual(createPatch({ a: [1, 2, 4] }, { a: [1, 2, 3, 4] }), [{ op: 'add', path: '/a/2', value: 3 }]);
+  });
+
+  test('an object in an array that changes in one member gives one replace inside it', () => {
+    const from = { items: [{ id: 1, qty: 2 }, { id: 2, qty: 5 }, { id: 3, qty: 1 }] };
+    const to = { items: [{ id: 1, qty: 2 }, { id: 2, qty: 9 }, { id: 3, qty: 1 }] };
+    assert.deepEqual(createPatch(from, to), [{ op: 'replace', path: '/items/1/qty', value: 9 }]);
+  });
+
+  test('an array element changed in place gives one replace at its index', () => {
+    assert.deepEqual(createPatch({ a: [1, 2, 3] }, { a: [1, 9, 3] }), [{ op: 'replace', path: '/a/1', value: 9 }]);
+  });
+
+  test('a long array with one changed element sends only that element', () => {
+    const from = { a: Array.from({ length: 1000 }, (_, i) => i) };
+    const to = { a: Array.from({ length: 1000 }, (_, i) => (i === 500 ? -1 : i)) };
+    assert.deepEqual(createPatch(from, to), [{ op: 'replace', path: '/a/500', value: -1 }]);
+  });
+
+  test('keys containing "/" and "~" are escaped in the pointer', () => {
+    assert.deepEqual(createPatch({ 'a/b': 1, 'c~d': 1 }, { 'a/b': 2, 'c~d': 2 }), [
+      { op: 'replace', path: '/a~1b', value: 2 },
+      { op: 'replace', path: '/c~0d', value: 2 },
+    ]);
+  });
+
+  test('a "__proto__" key is an ordinary member', () => {
+    const from = JSON.parse('{"__proto__": {"a": 1}}');
+    const to = JSON.parse('{"__proto__": {"a": 2}}');
+    assert.deepEqual(createPatch(from, to), [{ op: 'replace', path: '/__proto__/a', value: 2 }]);
+  });
+});
+
+describe('createPatch: the patch applies to from and gives to', () => {
+  const cases: [string, unknown, unknown][] = [
+    ['scalars', 1, 2],
+    ['nested objects', { a: { b: [1, { c: 'd' }] } }, { a: { b: [1, { c: 'e', f: null }], g: 1 } }],
+    ['arrays of different lengths', [1, 2, 3, 4, 5], [5, 4, 3]],
+    ['arrays with insertions and removals', [1, 2, 4, 6], [0, 1, 2, 3, 4, 5, 6]],
+    ['arrays of objects', [{ a: 1 }, { b: 2 }], [{ a: 1 }, { b: 3 }, { c: 4 }]],
+    ['empty and non-empty', [], { a: [] }],
+  ];
+  for (const [name, from, to] of cases) {
+    test(`round trip: ${name}`, () => {
+      assert.deepEqual(applyPatch(from as never, createPatch(from as never, to as never)), to);
+    });
+  }
+});
+
+describe('createPatch: inputs', () => {
+  test('does not mutate either input', () => {
+    const from = { a: [1, { b: 'c' }], d: { e: 1 } };
+    const to = { a: [1, { b: 'x' }, 2], d: { f: [3] } };
+    const fromCopy = structuredClone(from);
+    const toCopy = structuredClone(to);
+    createPatch(from, to);
+    assert.deepEqual(from, fromCopy);
+    assert.deepEqual(to, toCopy);
+  });
+
+  test('the patch shares no structure with to', () => {
+    const to = { a: { b: [1] } };
+    const patch = createPatch({}, to);
+    (patch[0] as { value: { b: number[] } }).value.b.push(2);
+    assert.deepEqual(to, { a: { b: [1] } });
+  });
+
+  test('a from that is not a JSON value throws a SyntaxError', () => {
+    assert.throws(() => createPatch({ a: undefined } as never, { a: 1 }), SyntaxError);
+    assert.throws(() => createPatch(Number.NaN as never, 1), SyntaxError);
+  });
+
+  test('a to that is not a JSON value throws a SyntaxError', () => {
+    assert.throws(() => createPatch({ a: 1 }, { a: new Date(0) } as never), SyntaxError);
+    assert.throws(() => createPatch({}, [Infinity] as never), SyntaxError);
+  });
+});
