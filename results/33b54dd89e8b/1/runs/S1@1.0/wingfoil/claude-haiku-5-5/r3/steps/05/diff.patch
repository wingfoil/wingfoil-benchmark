+---
+id: task-005-create-a-json-patch-from-two-documents-rfc-6902
+type: task
+title: "Create a JSON Patch from two documents (RFC 6902)"
+status: approved
+format: 1
+---
+
+# Create a JSON Patch from two documents (RFC 6902)
+
+## Request
+
+Our clients want to send only what changed between two versions of a JSON document, instead of the whole
+new version. Add a way to produce such a change as a JSON Patch (RFC 6902).
+
+Export a function `createPatch(from, to)` from `src/index.ts`. It returns a JSON Patch that turns `from`
+into `to` when applied with `applyPatch`, and it must not mutate either input. The patch describes what
+changed, and nothing more: when two versions differ in one small place, the patch must not send the whole
+document again.
+
+## Acceptance
+
+- `applyPatch(from, createPatch(from, to))` deep-equals `to`, for any two JSON values.
+- Equal inputs give an empty patch.
+- Objects are compared member by member: a member only in `from` gives `remove`, a member only in `to`
+  gives `add`, and a member in both is compared recursively. A changed scalar gives one `replace`.
+- Arrays are compared element by element, so that an appended, removed or inserted element gives one `add`
+  or `remove` at its index, and an element that changed in one place gives a patch at that place.
+- A value whose type changes (object to array, number to string, and so on) gives one `replace`.
+- The whole document is replaced, with path `""`, only when the root itself changes type or kind.
+- Keys containing `/` or `~` are escaped as RFC 6901 requires.
+- The patch shares no structure with `from` or `to`, and neither input is mutated.
+- An input that is not a JSON value (such as `undefined`, `NaN` or a `Date`) throws a `SyntaxError`,
+  consistent with `applyPatch` and `applyMergePatch`.
+
+## Scope
+
+- Library code in `src/index.ts`, no runtime dependency. Reuse the JSON-value, copy and equality helpers
+  that the other functions already use.
+- Tests with `node --test` in `test/create-patch.test.ts`: the happy path of each rule, the edge cases
+  above (escaped keys, a root change, arrays), a round trip through `applyPatch`, the error path for a
+  non-JSON input, and that the inputs are not mutated.
+- `README.md` documents the new function under a "Creating a JSON Patch" section.
diff --git a/src/index.ts b/src/index.ts
index 251670b3ec395777be56f4c917ce3fc874b0bf38..e4179802b515756e966d81de5cfd44ec7e1c0bb9 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -50,6 +50,22 @@ export function applyPatch(document: JsonValue, patch: JsonPatch): JsonValue {
   return result;
 }
 
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to`: applying it to `from` with `applyPatch` gives
+ * a document equal to `to`. The patch describes only what changed. The inputs are not modified, and the patch
+ * shares no structure with them.
+ *
+ * @throws {SyntaxError} when either document is not a JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatch {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new SyntaxError('cannot create a JSON Patch: a document is not a JSON value');
+  }
+  const patch: JsonPatch = [];
+  diffValues(from, to, '', patch);
+  return patch;
+}
+
 /**
  * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the merged document. The input is
  * not modified: the result is a new value that shares no structure with the target or the patch.
@@ -345,3 +361,126 @@ function deepEqual(a: JsonValue, b: JsonValue): boolean {
   }
   return a === b;
 }
+
+/** Appends the operations that turn the value `from` into the value `to`, at the location `path`. */
+function diffValues(from: JsonValue, to: JsonValue, path: string, patch: JsonPatch): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (isRecord(from) && isRecord(to)) {
+    diffMembers(from, to, path, patch);
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    diffElements(from, to, path, patch);
+  } else {
+    patch.push({ op: 'replace', path, value: copyValue(to) });
+  }
+}
+
+/** Appends the operations that turn one object into another: removed members, then changed and added ones. */
+function diffMembers(
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  path: string,
+  patch: JsonPatch,
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      patch.push({ op: 'remove', path: childPath(path, key) });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (Object.hasOwn(from, key)) {
+      diffValues(from[key], to[key], childPath(path, key), patch);
+    } else {
+      patch.push({ op: 'add', path: childPath(path, key), value: copyValue(to[key]) });
+    }
+  }
+}
+
+/**
+ * Appends the operations that turn one array into another. The elements that both arrays keep, in order, are
+ * aligned by their longest common subsequence; the elements between two kept ones are paired by position, so
+ * an element that changed in place is described inside it, and the others are removed or added.
+ */
+function diffElements(from: JsonValue[], to: JsonValue[], path: string, patch: JsonPatch): void {
+  const head = commonHeadLength(from, to);
+  const tail = commonTailLength(from, to, head);
+  const oldMiddle = from.slice(head, from.length - tail);
+  const newMiddle = to.slice(head, to.length - tail);
+  let index = head; // the position, in the array as the patch has changed it so far, of the next element
+  let oldNext = 0;
+  let newNext = 0;
+  const kept: [number, number][] = [...longestCommon(oldMiddle, newMiddle), [oldMiddle.length, newMiddle.length]];
+  for (const [oldKept, newKept] of kept) {
+    const oldGap = oldMiddle.slice(oldNext, oldKept);
+    const newGap = newMiddle.slice(newNext, newKept);
+    const paired = Math.min(oldGap.length, newGap.length);
+    for (let k = 0; k < paired; k++) {
+      diffValues(oldGap[k], newGap[k], childPath(path, String(index + k)), patch);
+    }
+    for (let k = paired; k < oldGap.length; k++) {
+      patch.push({ op: 'remove', path: childPath(path, String(index + paired)) });
+    }
+    for (let k = paired; k < newGap.length; k++) {
+      patch.push({ op: 'add', path: childPath(path, String(index + k)), value: copyValue(newGap[k]) });
+    }
+    index += newGap.length + 1; // the kept element after the gap sits at this position
+    oldNext = oldKept + 1;
+    newNext = newKept + 1;
+  }
+}
+
+/** The number of leading elements that two arrays have in common. */
+function commonHeadLength(a: JsonValue[], b: JsonValue[]): number {
+  let length = 0;
+  while (length < a.length && length < b.length && deepEqual(a[length], b[length])) {
+    length++;
+  }
+  return length;
+}
+
+/** The number of trailing elements that two arrays have in common, not counting the first `head` elements. */
+function commonTailLength(a: JsonValue[], b: JsonValue[], head: number): number {
+  let length = 0;
+  while (
+    length < a.length - head &&
+    length < b.length - head &&
+    deepEqual(a[a.length - 1 - length], b[b.length - 1 - length])
+  ) {
+    length++;
+  }
+  return length;
+}
+
+/** Pairs the indexes of a longest common subsequence of two arrays, as [index in a, index in b] pairs. */
+function longestCommon(a: JsonValue[], b: JsonValue[]): [number, number][] {
+  // lengths[i][j] is the length of the longest common subsequence of a from i and b from j
+  const lengths: number[][] = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lengths[i][j] = deepEqual(a[i], b[j])
+        ? lengths[i + 1][j + 1] + 1
+        : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  const pairs: [number, number][] = [];
+  let i = 0;
+  let j = 0;
+  while (i < a.length && j < b.length) {
+    if (deepEqual(a[i], b[j])) {
+      pairs.push([i, j]);
+      i++;
+      j++;
+    } else if (lengths[i + 1][j] >= lengths[i][j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
+
+/** The JSON Pointer of a member of the location `path`, with "~" and "/" escaped as RFC 6901 requires. */
+function childPath(path: string, key: string): string {
+  return `${path}/${key.replace(/~/g, '~0').replace(/\//g, '~1')}`;
+}
