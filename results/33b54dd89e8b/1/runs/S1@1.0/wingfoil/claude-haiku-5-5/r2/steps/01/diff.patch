@@ -0,0 +1,64 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * A pointer is a sequence of reference tokens, each preceded by `/`. Within a token, `~1` stands for
+ * `/` and `~0` for `~`. The empty pointer refers to the whole document. A token selects an object
+ * member by its exact key, or an array element by a decimal index with no sign and no leading zero.
+ *
+ * @param document the JSON value to navigate.
+ * @param pointer the JSON Pointer string.
+ * @returns the value the pointer refers to.
+ * @throws {Error} when `pointer` is not a valid JSON Pointer, or when it does not resolve to a value
+ * of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  let current: unknown = document;
+  for (const token of tokens) {
+    current = select(current, token, pointer);
+  }
+  return current;
+}
+
+/** Splits a pointer into its decoded reference tokens, checking its syntax. */
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error(`invalid JSON Pointer: expected a string, got ${typeof pointer}`);
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`invalid JSON Pointer ${JSON.stringify(pointer)}: it must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((raw) => decodeToken(raw, pointer));
+}
+
+/** Decodes the escape sequences of one reference token. `~1` is decoded before `~0`. */
+function decodeToken(raw: string, pointer: string): string {
+  if (/~(?![01])/.test(raw)) {
+    throw new Error(`invalid JSON Pointer ${JSON.stringify(pointer)}: "~" must be followed by 0 or 1`);
+  }
+  return raw.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/** Returns the child of `container` that `token` names, or throws when there is none. */
+function select(container: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(container)) {
+    if (!/^(0|[1-9][0-9]*)$/.test(token) || Number(token) >= container.length) {
+      throw unresolved(pointer, token);
+    }
+    return container[Number(token)];
+  }
+  if (typeof container === "object" && container !== null && Object.hasOwn(container, token)) {
+    return (container as Record<string, unknown>)[token];
+  }
+  throw unresolved(pointer, token);
+}
+
+function unresolved(pointer: string, token: string): Error {
+  return new Error(`JSON Pointer ${JSON.stringify(pointer)} does not resolve: no value at ${JSON.stringify(token)}`);
+}
diff --git a/test/resolve-pointer.test.ts b/test/resolve-pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e56975529a0d5d213637600d0198559fcb9cfc6c
--- /dev/null
+++ b/test/resolve-pointer.test.ts
@@ -0,0 +1,113 @@
+import { test, describe } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// The example document of RFC 6901, section 5.
+const rfcDocument = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+describe("resolvePointer: RFC 6901 examples", () => {
+  const cases: [string, unknown][] = [
+    ["", rfcDocument],
+    ["/foo", ["bar", "baz"]],
+    ["/foo/0", "bar"],
+    ["/", 0],
+    ["/a~1b", 1],
+    ["/c%d", 2],
+    ["/e^f", 3],
+    ["/g|h", 4],
+    ["/i\\j", 5],
+    ['/k"l', 6],
+    ["/ ", 7],
+    ["/m~0n", 8],
+  ];
+  for (const [pointer, expected] of cases) {
+    test(`resolves ${JSON.stringify(pointer)}`, () => {
+      assert.deepEqual(resolvePointer(rfcDocument, pointer), expected);
+    });
+  }
+});
+
+describe("resolvePointer: navigation", () => {
+  test("the empty pointer refers to the whole document, including primitives", () => {
+    assert.equal(resolvePointer(42, ""), 42);
+    assert.equal(resolvePointer(null, ""), null);
+  });
+
+  test("resolves nested objects and arrays", () => {
+    const document = { users: [{ name: "ada" }, { name: "grace" }] };
+    assert.equal(resolvePointer(document, "/users/1/name"), "grace");
+  });
+
+  test("resolves a member whose value is null", () => {
+    assert.equal(resolvePointer({ a: null }, "/a"), null);
+  });
+
+  test("decodes ~1 before ~0, so ~01 denotes the key '~1'", () => {
+    assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+  });
+
+  test("looks members up by own property only", () => {
+    assert.throws(() => resolvePointer({}, "/__proto__"));
+    assert.throws(() => resolvePointer({}, "/toString"));
+  });
+});
+
+describe("resolvePointer: invalid pointers", () => {
+  const document = { foo: ["bar", "baz"], "~": 1 };
+
+  test("rejects a non-empty pointer that does not start with '/'", () => {
+    assert.throws(() => resolvePointer(document, "foo"), /invalid JSON Pointer/);
+    assert.throws(() => resolvePointer(document, "#/foo"), /invalid JSON Pointer/);
+  });
+
+  test("rejects a '~' that is not followed by 0 or 1", () => {
+    assert.throws(() => resolvePointer(document, "/~2"), /invalid JSON Pointer/);
+    assert.throws(() => resolvePointer(document, "/~"), /invalid JSON Pointer/);
+    assert.throws(() => resolvePointer(document, "/a~"), /invalid JSON Pointer/);
+  });
+
+  test("rejects a non-string pointer", () => {
+    assert.throws(() => resolvePointer(document, undefined as unknown as string), /invalid JSON Pointer/);
+    assert.throws(() => resolvePointer(document, 0 as unknown as string), /invalid JSON Pointer/);
+  });
+});
+
+describe("resolvePointer: pointers that do not resolve", () => {
+  const document = { foo: ["bar", "baz"], nothing: null, text: "abc" };
+
+  test("rejects a missing object member", () => {
+    assert.throws(() => resolvePointer(document, "/missing"), /does not resolve/);
+  });
+
+  test("rejects an array index out of range", () => {
+    assert.throws(() => resolvePointer(document, "/foo/2"), /does not resolve/);
+  });
+
+  test("rejects the '-' token, which names no existing element", () => {
+    assert.throws(() => resolvePointer(document, "/foo/-"), /does not resolve/);
+  });
+
+  test("rejects array indices with a sign, a leading zero or a non-numeric form", () => {
+    assert.throws(() => resolvePointer(document, "/foo/+1"), /does not resolve/);
+    assert.throws(() => resolvePointer(document, "/foo/01"), /does not resolve/);
+    assert.throws(() => resolvePointer(document, "/foo/x"), /does not resolve/);
+    assert.throws(() => resolvePointer(document, "/foo/"), /does not resolve/);
+  });
+
+  test("rejects traversal into a primitive or null", () => {
+    assert.throws(() => resolvePointer(document, "/foo/0/x"), /does not resolve/);
+    assert.throws(() => resolvePointer(document, "/text/0"), /does not resolve/);
+    assert.throws(() => resolvePointer(document, "/nothing/x"), /does not resolve/);
+  });
+});
