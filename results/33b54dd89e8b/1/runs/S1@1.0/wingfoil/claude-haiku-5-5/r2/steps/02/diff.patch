index 0000000000000000000000000000000000000000..7d6cdfbbb65783f3851c7258a599f424853c3933
--- /dev/null
+++ b/src/pointer.ts
@@ -0,0 +1,77 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * A pointer is a sequence of reference tokens, each preceded by `/`. Within a token, `~1` stands for
+ * `/` and `~0` for `~`. The empty pointer refers to the whole document. A token selects an object
+ * member by its exact key, or an array element by a decimal index with no sign and no leading zero.
+ *
+ * @param document the JSON value to navigate.
+ * @param pointer the JSON Pointer string.
+ * @returns the value the pointer refers to.
+ * @throws {Error} when `pointer` is not a valid JSON Pointer, or when it does not resolve to a value
+ * of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  return resolveTokens(document, parsePointer(pointer), pointer);
+}
+
+/**
+ * Follows decoded reference tokens from `document`, and returns the value they reach.
+ *
+ * @param pointer the pointer the tokens were parsed from, quoted in error messages.
+ * @throws {Error} when a token does not resolve.
+ */
+export function resolveTokens(document: unknown, tokens: readonly string[], pointer: string): unknown {
+  let current: unknown = document;
+  for (const token of tokens) {
+    current = select(current, token, pointer);
+  }
+  return current;
+}
+
+/**
+ * Splits a pointer into its decoded reference tokens, checking its syntax.
+ *
+ * @throws {Error} when `pointer` is not a valid JSON Pointer.
+ */
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error(`invalid JSON Pointer: expected a string, got ${typeof pointer}`);
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`invalid JSON Pointer ${JSON.stringify(pointer)}: it must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((raw) => decodeToken(raw, pointer));
+}
+
+/** Decodes the escape sequences of one reference token. `~1` is decoded before `~0`. */
+function decodeToken(raw: string, pointer: string): string {
+  if (/~(?![01])/.test(raw)) {
+    throw new Error(`invalid JSON Pointer ${JSON.stringify(pointer)}: "~" must be followed by 0 or 1`);
+  }
+  return raw.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/** Returns the child of `container` that `token` names, or throws when there is none. */
+function select(container: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(container)) {
+    if (!/^(0|[1-9][0-9]*)$/.test(token) || Number(token) >= container.length) {
+      throw unresolved(pointer, token);
+    }
+    return container[Number(token)];
+  }
+  if (typeof container === "object" && container !== null && Object.hasOwn(container, token)) {
+    return (container as Record<string, unknown>)[token];
+  }
+  throw unresolved(pointer, token);
+}
+
+function unresolved(pointer: string, token: string): Error {
+  return new Error(`JSON Pointer ${JSON.stringify(pointer)} does not resolve: no value at ${JSON.stringify(token)}`);
+}
