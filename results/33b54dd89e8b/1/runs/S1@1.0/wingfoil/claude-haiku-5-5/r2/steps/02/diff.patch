@@ -0,0 +1,273 @@
+import { test, describe } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+/** Deep-freezes a value, so that any mutation of it throws in strict mode. */
+function deepFreeze<T>(value: T): T {
+  if (typeof value === "object" && value !== null) {
+    for (const child of Object.values(value)) deepFreeze(child);
+    Object.freeze(value);
+  }
+  return value;
+}
+
+// The examples of RFC 6902, appendix A.
+describe("applyPatch: RFC 6902 appendix A examples", () => {
+  const cases: [string, unknown, unknown, unknown][] = [
+    ["adds an object member",{ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" }],
+    ["adds an array element",{ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] }],
+    ["removes an object member",{ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }],
+    ["removes an array element",{ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }],
+    ["replaces a value",{ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" }],
+    [
+      "moves a value between objects",
+      { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+      [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+      { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+    ],
+    [
+      "moves an array element",
+      { foo: ["all", "grass", "cows", "eat"] },
+      [{ op: "move", from: "/foo/1", path: "/foo/3" }],
+      { foo: ["all", "cows", "eat", "grass"] },
+    ],
+    ["test succeeds when values are equal",{ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], { baz: "qux", foo: ["a", 2, "c"] }],
+    [
+      "copies a value",
+      { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+      [{ op: "copy", from: "/foo/waldo", path: "/qux/thud" }],
+      { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault", thud: "fred" } },
+    ],
+    ["test ignores object key order",{ a: { x: 1, y: [1, 2] } }, [{ op: "test", path: "/a", value: { y: [1, 2], x: 1 } }], { a: { x: 1, y: [1, 2] } }],
+    ["decodes ~0 and ~1 escapes in pointers",{ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }],
+    ["appends with the '-' index",{ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] }],
+    ["replaces the whole document with the empty pointer",{ foo: "bar" }, [{ op: "replace", path: "", value: { baz: "qux" } }], { baz: "qux" }],
+  ];
+  for (const [name, document, patch, expected] of cases) {
+    test(name, () => {
+      assert.deepEqual(applyPatch(document, patch as never), expected);
+    });
+  }
+});
+
+describe("applyPatch: add", () => {
+  test("replaces an existing object member", () => {
+    assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+  });
+
+  test("inserts at the end of an array when the index equals its length", () => {
+    assert.deepEqual(applyPatch([1, 2], [{ op: "add", path: "/2", value: 3 }]), [1, 2, 3]);
+  });
+
+  test("adds the empty pointer as the whole document", () => {
+    assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  });
+
+  test("stores a key named __proto__ as an own data member", () => {
+    const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as object;
+    assert.equal(Object.hasOwn(result, "__proto__"), true);
+    assert.equal(Object.getPrototypeOf(result), Object.prototype);
+    assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  });
+
+  test("rejects an array index beyond the end", () => {
+    assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/2", value: 3 }]), /failed/);
+  });
+
+  test("rejects an array index with a leading zero or a sign", () => {
+    assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/01", value: 3 }]), /failed/);
+    assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/+0", value: 3 }]), /failed/);
+  });
+
+  test("rejects a missing parent", () => {
+    assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]), /failed/);
+  });
+
+  test("rejects traversal into a primitive", () => {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 2 }]), /failed/);
+  });
+});
+
+describe("applyPatch: remove", () => {
+  test("rejects a missing object member", () => {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "/b" }]), /failed/);
+  });
+
+  test("rejects an array index out of range", () => {
+    assert.throws(() => applyPatch({ a: [1] }, [{ op: "remove", path: "/a/1" }]), /failed/);
+  });
+
+  test("rejects the '-' index, which names no existing element", () => {
+    assert.throws(() => applyPatch({ a: [1] }, [{ op: "remove", path: "/a/-" }]), /failed/);
+  });
+
+  test("rejects removing the whole document", () => {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]), /failed/);
+  });
+});
+
+describe("applyPatch: replace", () => {
+  test("rejects a missing target, which add would create", () => {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "replace", path: "/b", value: 2 }]), /failed/);
+  });
+
+  test("rejects an array index out of range", () => {
+    assert.throws(() => applyPatch({ a: [1] }, [{ op: "replace", path: "/a/1", value: 2 }]), /failed/);
+  });
+
+  test("replaces an array element", () => {
+    assert.deepEqual(applyPatch({ a: [1, 2] }, [{ op: "replace", path: "/a/0", value: 9 }]), { a: [9, 2] });
+  });
+});
+
+describe("applyPatch: move", () => {
+  test("rejects a missing source", () => {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "/b", path: "/c" }]), /failed/);
+  });
+
+  test("rejects moving a value into one of its own children", () => {
+    assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b/c" }]), /failed/);
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "", path: "/a" }]), /failed/);
+  });
+
+  test("moving a value onto its own location leaves the document unchanged", () => {
+    assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1, b: 2 });
+  });
+});
+
+describe("applyPatch: copy", () => {
+  test("rejects a missing source", () => {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", from: "/b", path: "/c" }]), /failed/);
+  });
+
+  test("the copy shares no structure with its source", () => {
+    const result = applyPatch(
+      { a: { x: [1] }, b: null },
+      [
+        { op: "copy", from: "/a", path: "/b" },
+        { op: "add", path: "/b/x/0", value: 2 },
+      ],
+    ) as { a: unknown; b: unknown };
+    assert.deepEqual(result, { a: { x: [1] }, b: { x: [2, 1] } });
+  });
+});
+
+describe("applyPatch: test", () => {
+  test("fails when the value differs", () => {
+    assert.throws(() => applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]), /failed/);
+  });
+
+  test("does not coerce between strings and numbers", () => {
+    assert.throws(() => applyPatch({ a: 10 }, [{ op: "test", path: "/a", value: "10" }]), /failed/);
+  });
+
+  test("fails when the target does not exist", () => {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/b", value: null }]), /failed/);
+  });
+
+  test("compares arrays in order", () => {
+    assert.throws(() => applyPatch({ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]), /failed/);
+  });
+
+  test("compares null with null, and distinguishes null from a missing member", () => {
+    assert.deepEqual(applyPatch({ a: null }, [{ op: "test", path: "/a", value: null }]), { a: null });
+    assert.throws(() => applyPatch({}, [{ op: "test", path: "/a", value: null }]), /failed/);
+  });
+});
+
+describe("applyPatch: sequencing and atomicity", () => {
+  test("applies operations in order, each to the result of the previous one", () => {
+    const result = applyPatch({ a: [] }, [
+      { op: "add", path: "/a/0", value: "x" },
+      { op: "replace", path: "/a/0", value: "y" },
+      { op: "test", path: "/a/0", value: "y" },
+    ]);
+    assert.deepEqual(result, { a: ["y"] });
+  });
+
+  test("a failing operation rejects the whole patch", () => {
+    const document = { a: 1 };
+    assert.throws(
+      () =>
+        applyPatch(document, [
+          { op: "replace", path: "/a", value: 2 },
+          { op: "remove", path: "/missing" },
+        ]),
+      /failed/,
+    );
+    assert.deepEqual(document, { a: 1 });
+  });
+
+  test("an empty patch returns an equal document", () => {
+    assert.deepEqual(applyPatch({ a: [1] }, []), { a: [1] });
+  });
+});
+
+describe("applyPatch: no mutation of its inputs", () => {
+  test("does not mutate the document, even when the patch changes nested values", () => {
+    const document = deepFreeze({ a: { b: [1, 2] }, c: "d" });
+    const result = applyPatch(document, [
+      { op: "add", path: "/a/b/-", value: 3 },
+      { op: "remove", path: "/c" },
+      { op: "replace", path: "/a/b/0", value: 9 },
+    ]);
+    assert.deepEqual(result, { a: { b: [9, 2, 3] } });
+    assert.deepEqual(document, { a: { b: [1, 2] }, c: "d" });
+  });
+
+  test("returns a new value, not the input document, even for an empty patch", () => {
+    const document = { a: 1 };
+    assert.notEqual(applyPatch(document, []), document);
+  });
+
+  test("does not mutate the patch, nor the values it carries", () => {
+    const value = { x: {} };
+    const patch = deepFreeze([
+      { op: "add", path: "/a", value },
+      { op: "add", path: "/a/x/y", value: 1 },
+    ]);
+    const result = applyPatch({}, patch);
+    assert.deepEqual(result, { a: { x: { y: 1 } } });
+    assert.deepEqual(value, { x: {} });
+  });
+});
+
+describe("applyPatch: invalid patches", () => {
+  const document = { a: [1], b: "c" };
+
+  test("rejects a patch that is not an array", () => {
+    assert.throws(() => applyPatch(document, { op: "remove", path: "/a" } as never), /invalid JSON Patch/);
+    assert.throws(() => applyPatch(document, undefined as never), /invalid JSON Patch/);
+  });
+
+  test("rejects an operation that is not an object", () => {
+    assert.throws(() => applyPatch(document, [null] as never), /invalid JSON Patch/);
+    assert.throws(() => applyPatch(document, [["remove", "/a"]] as never), /invalid JSON Patch/);
+  });
+
+  test("rejects an unknown or missing op", () => {
+    assert.throws(() => applyPatch(document, [{ op: "increment", path: "/a" }] as never), /invalid JSON Patch/);
+    assert.throws(() => applyPatch(document, [{ path: "/a" }] as never), /invalid JSON Patch/);
+  });
+
+  test("rejects a missing or non-string path", () => {
+    assert.throws(() => applyPatch(document, [{ op: "remove" }] as never), /invalid JSON Patch/);
+    assert.throws(() => applyPatch(document, [{ op: "remove", path: 1 }] as never), /invalid JSON Patch/);
+  });
+
+  test("rejects move and copy without a string from", () => {
+    assert.throws(() => applyPatch(document, [{ op: "move", path: "/b" }] as never), /invalid JSON Patch/);
+    assert.throws(() => applyPatch(document, [{ op: "copy", from: 0, path: "/b" }] as never), /invalid JSON Patch/);
+  });
+
+  test("rejects add, replace and test without a value member", () => {
+    assert.throws(() => applyPatch(document, [{ op: "add", path: "/b" }] as never), /invalid JSON Patch/);
+    assert.throws(() => applyPatch(document, [{ op: "replace", path: "/b" }] as never), /invalid JSON Patch/);
+    assert.throws(() => applyPatch(document, [{ op: "test", path: "/b" }] as never), /invalid JSON Patch/);
+  });
+
+  test("rejects an invalid pointer in path or from", () => {
+    assert.throws(() => applyPatch(document, [{ op: "remove", path: "a" }]), /invalid JSON Pointer/);
+    assert.throws(() => applyPatch(document, [{ op: "copy", from: "/a~2", path: "/b" }]), /invalid JSON Pointer/);
+  });
+});
