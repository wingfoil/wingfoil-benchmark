new file mode 100644
index 0000000000000000000000000000000000000000..22a034a0730fb0fe0a8838b9dd4a6b08c8c0c00d
--- /dev/null
+++ b/src/patch.ts
@@ -0,0 +1,282 @@
+import { parsePointer, resolveTokens } from "./pointer.ts";
+
+const OPERATIONS = ["add", "remove", "replace", "move", "copy", "test"] as const;
+
+/** The name of a JSON Patch operation (RFC 6902, section 4). */
+export type OperationName = (typeof OPERATIONS)[number];
+
+/**
+ * One operation of a JSON Patch (RFC 6902, section 4). `from` is used by `move` and `copy`, and
+ * `value` by `add`, `replace` and `test`.
+ */
+export interface PatchOperation {
+  op: OperationName;
+  path: string;
+  from?: string;
+  value?: unknown;
+}
+
+/** A pointer of a patch operation, with its reference tokens already decoded. */
+interface Location {
+  pointer: string;
+  tokens: string[];
+}
+
+/** An operation of a patch that has passed its checks. */
+type Step =
+  | { op: "add" | "replace" | "test"; path: Location; value: unknown }
+  | { op: "remove"; path: Location }
+  | { op: "move" | "copy"; from: Location; path: Location };
+
+/** An object or array that an operation changes. */
+type Container = unknown[] | Record<string, unknown>;
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document.
+ *
+ * The operations are applied in order, each to the result of the previous one. The patch is checked
+ * before it runs, then applied to a copy of `document`: the input document and the input patch are
+ * never mutated, and a patch that fails part-way yields no partial result.
+ *
+ * @param document the JSON value to change.
+ * @param patch the operations to apply, in order.
+ * @returns the resulting document, as a new value.
+ * @throws {Error} when `patch` is not a valid JSON Patch, or when one of its operations fails.
+ */
+export function applyPatch(document: unknown, patch: readonly PatchOperation[]): unknown {
+  const steps = checkPatch(patch);
+  let result = cloneJson(document);
+  for (const [index, step] of steps.entries()) {
+    try {
+      result = applyStep(result, step);
+    } catch (error) {
+      throw new Error(`JSON Patch operation ${index} (${step.op}) failed: ${(error as Error).message}`);
+    }
+  }
+  return result;
+}
+
+function checkPatch(patch: unknown): Step[] {
+  if (!Array.isArray(patch)) {
+    throw invalid("the patch must be an array");
+  }
+  return patch.map((operation, index) => checkOperation(operation, index));
+}
+
+/** Checks the shape of one operation, and parses its pointers. */
+function checkOperation(operation: unknown, index: number): Step {
+  if (!isRecord(operation)) {
+    throw invalid(`operation ${index} is not an object`);
+  }
+  const { op, path, from, value } = operation;
+  if (typeof op !== "string" || !OPERATIONS.includes(op as OperationName)) {
+    throw invalid(`operation ${index} has an unknown "op"`);
+  }
+  if (typeof path !== "string") {
+    throw invalid(`operation ${index} has no string "path"`);
+  }
+  const name = op as OperationName;
+  if (name === "move" || name === "copy") {
+    if (typeof from !== "string") {
+      throw invalid(`operation ${index} (${name}) has no string "from"`);
+    }
+    return { op: name, from: locate(from), path: locate(path) };
+  }
+  if (name === "remove") {
+    return { op: name, path: locate(path) };
+  }
+  if (!Object.hasOwn(operation, "value")) {
+    throw invalid(`operation ${index} (${name}) has no "value"`);
+  }
+  return { op: name, path: locate(path), value };
+}
+
+function applyStep(root: unknown, step: Step): unknown {
+  switch (step.op) {
+    case "add":
+      return add(root, step.path, cloneJson(step.value));
+    case "remove":
+      return remove(root, step.path);
+    case "replace":
+      return replace(root, step.path, cloneJson(step.value));
+    case "move":
+      return move(root, step.from, step.path);
+    case "copy":
+      return add(root, step.path, cloneJson(valueAt(root, step.from)));
+    case "test":
+      if (!jsonEqual(valueAt(root, step.path), step.value)) {
+        throw new Error(`the value at ${step.path.pointer} is not the expected one`);
+      }
+      return root;
+  }
+}
+
+/** Sets the object member or inserts the array element at `at`. Returns the new root. */
+function add(root: unknown, at: Location, value: unknown): unknown {
+  if (at.tokens.length === 0) {
+    return value;
+  }
+  const container = containerOf(root, at);
+  const key = lastToken(at);
+  if (!Array.isArray(container)) {
+    defineMember(container, key, value);
+  } else if (key === "-") {
+    container.push(value);
+  } else {
+    const index = arrayIndex(key, at);
+    if (index > container.length) {
+      throw new Error(`index ${index} is beyond the end of the array at ${JSON.stringify(at.pointer)}`);
+    }
+    container.splice(index, 0, value);
+  }
+  return root;
+}
+
+/** Deletes the object member or splices out the array element at `at`. Returns the new root. */
+function remove(root: unknown, at: Location): unknown {
+  if (at.tokens.length === 0) {
+    throw new Error("the whole document cannot be removed");
+  }
+  const container = containerOf(root, at);
+  const key = lastToken(at);
+  if (Array.isArray(container)) {
+    container.splice(existingIndex(container, key, at), 1);
+  } else {
+    if (!Object.hasOwn(container, key)) {
+      throw missing(at);
+    }
+    delete container[key];
+  }
+  return root;
+}
+
+/** Replaces the existing value at `at`. Returns the new root. */
+function replace(root: unknown, at: Location, value: unknown): unknown {
+  if (at.tokens.length === 0) {
+    return value;
+  }
+  const container = containerOf(root, at);
+  const key = lastToken(at);
+  if (Array.isArray(container)) {
+    container[existingIndex(container, key, at)] = value;
+  } else {
+    if (!Object.hasOwn(container, key)) {
+      throw missing(at);
+    }
+    defineMember(container, key, value);
+  }
+  return root;
+}
+
+/** Removes the value at `from` and adds it at `path`. Returns the new root. */
+function move(root: unknown, from: Location, path: Location): unknown {
+  if (isProperPrefix(from.tokens, path.tokens)) {
+    throw new Error(`${JSON.stringify(from.pointer)} cannot be moved into its own child ${JSON.stringify(path.pointer)}`);
+  }
+  const value = valueAt(root, from);
+  return add(remove(root, from), path, value);
+}
+
+/** Returns the value at `at`, or throws when there is none. */
+function valueAt(root: unknown, at: Location): unknown {
+  return resolveTokens(root, at.tokens, at.pointer);
+}
+
+/** Returns the object or array that holds the member `at` names. */
+function containerOf(root: unknown, at: Location): Container {
+  const parent = resolveTokens(root, at.tokens.slice(0, -1), at.pointer);
+  if (Array.isArray(parent)) {
+    return parent;
+  }
+  if (typeof parent === "object" && parent !== null) {
+    return parent as Record<string, unknown>;
+  }
+  throw new Error(`${JSON.stringify(at.pointer)} is inside a primitive value`);
+}
+
+/**
+ * Sets an own data property. `defineProperty` is used rather than assignment, so that a key such as
+ * `__proto__` is stored as data and does not change the prototype.
+ */
+function defineMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function locate(pointer: string): Location {
+  return { pointer, tokens: parsePointer(pointer) };
+}
+
+function lastToken(at: Location): string {
+  return at.tokens[at.tokens.length - 1];
+}
+
+/** Parses an array index: `0`, or a decimal integer with no sign and no leading zero. */
+function arrayIndex(token: string, at: Location): number {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`${JSON.stringify(token)} is not an array index in ${JSON.stringify(at.pointer)}`);
+  }
+  return Number(token);
+}
+
+/** Returns the index of an element that exists in `array`, or throws when there is none. */
+function existingIndex(array: unknown[], key: string, at: Location): number {
+  const index = arrayIndex(key, at);
+  if (index >= array.length) {
+    throw missing(at);
+  }
+  return index;
+}
+
+function missing(at: Location): Error {
+  return new Error(`no value at ${JSON.stringify(at.pointer)}`);
+}
+
+/** Whether `prefix` is a proper prefix of `tokens`, that is shorter and matching from the start. */
+function isProperPrefix(prefix: readonly string[], tokens: readonly string[]): boolean {
+  return prefix.length < tokens.length && prefix.every((token, i) => token === tokens[i]);
+}
+
+/** Compares two JSON values: object members are unordered, array elements are ordered. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (typeof a !== "object" || typeof b !== "object" || a === null || b === null) {
+    return false;
+  }
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]));
+  }
+  const keys = Object.keys(a);
+  return (
+    keys.length === Object.keys(b).length &&
+    keys.every((key) => Object.hasOwn(b, key) && jsonEqual(valueOf(a, key), valueOf(b, key)))
+  );
+}
+
+function valueOf(object: object, key: string): unknown {
+  return (object as Record<string, unknown>)[key];
+}
+
+/** Deep-copies a JSON value, so that the copy shares no object or array with it. */
+function cloneJson(value: unknown): unknown {
+  if (Array.isArray(value)) {
+    return value.map((item) => cloneJson(item));
+  }
+  if (typeof value !== "object" || value === null) {
+    return value;
+  }
+  const copy: Record<string, unknown> = {};
+  for (const key of Object.keys(value)) {
+    defineMember(copy, key, cloneJson(valueOf(value, key)));
+  }
+  return copy;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function invalid(message: string): Error {
+  return new Error(`invalid JSON Patch: ${message}`);
+}
