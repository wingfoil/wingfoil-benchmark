+import { cloneJson, isJsonValue, isPlainObject, jsonEqual, valueOf } from "./json.ts";
+import type { PatchOperation } from "./patch.ts";
+import { childPointer } from "./pointer.ts";
+
+/**
+ * Produces the JSON Patch (RFC 6902) that turns `from` into `to`: applying it to `from` with `applyPatch`
+ * gives a value equal to `to`.
+ *
+ * The patch describes only what changed. Equal members and equal array elements produce no operation, so
+ * a change in one place gives an operation at that place, and not a copy of the whole document. In an array,
+ * the common prefix and suffix are skipped, so an element inserted or removed gives one `add` or `remove`, and
+ * the elements after it are not rewritten. A value whose type changes is replaced as a whole.
+ *
+ * Neither input is mutated, and the operations share no object or array with either input.
+ *
+ * @param from the JSON value to start from.
+ * @param to the JSON value that the patch leads to.
+ * @returns the operations, in an order in which each one applies to the result of the ones before it.
+ * @throws {Error} when `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new Error("invalid JSON document: it holds a value that is not JSON");
+  }
+  const operations: PatchOperation[] = [];
+  diff(from, to, "", operations);
+  return operations;
+}
+
+/** Appends the operations that turn `from` into `to`, the values found at `pointer`. */
+function diff(from: unknown, to: unknown, pointer: string, operations: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, pointer, operations);
+  } else if (isPlainObject(from) && isPlainObject(to)) {
+    diffObjects(from, to, pointer, operations);
+  } else if (!jsonEqual(from, to)) {
+    operations.push({ op: "replace", path: pointer, value: cloneJson(to) });
+  }
+}
+
+/** Removes the members that `to` lacks, then adds the new ones and compares those it keeps. */
+function diffObjects(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  pointer: string,
+  operations: PatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      operations.push({ op: "remove", path: childPointer(pointer, key) });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const child = childPointer(pointer, key);
+    if (Object.hasOwn(from, key)) {
+      diff(valueOf(from, key), valueOf(to, key), child, operations);
+    } else {
+      operations.push({ op: "add", path: child, value: cloneJson(valueOf(to, key)) });
+    }
+  }
+}
+
+/**
+ * Skips the common prefix and suffix of the two arrays. The elements between them are compared at the same
+ * index, and the surplus of one side is removed from the end of `from`, or added at the end of `to`.
+ */
+function diffArrays(from: unknown[], to: unknown[], pointer: string, operations: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+    start++;
+  }
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && jsonEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+  const paired = Math.min(fromEnd - start, toEnd - start);
+  for (let i = 0; i < paired; i++) {
+    diff(from[start + i], to[start + i], childPointer(pointer, String(start + i)), operations);
+  }
+  // Removing from the end keeps the index of each removed element valid at the time of its removal.
+  for (let i = fromEnd - 1; i >= start + paired; i--) {
+    operations.push({ op: "remove", path: childPointer(pointer, String(i)) });
+  }
+  for (let i = start + paired; i < toEnd; i++) {
+    operations.push({ op: "add", path: childPointer(pointer, String(i)), value: cloneJson(to[i]) });
+  }
+}
