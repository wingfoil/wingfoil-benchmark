@@ -63,3 +63,21 @@ export function isJsonValue(value: unknown, active: Set<object> = new Set()): bo
       return false;
   }
 }
+
+/** Compares two JSON values: object members are unordered, array elements are ordered. */
+export function jsonEqual(a: unknown, b: unknown): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (typeof a !== "object" || typeof b !== "object" || a === null || b === null) {
+    return false;
+  }
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]));
+  }
+  const keys = Object.keys(a);
+  return (
+    keys.length === Object.keys(b).length &&
+    keys.every((key) => Object.hasOwn(b, key) && jsonEqual(valueOf(a, key), valueOf(b, key)))
+  );
+}
