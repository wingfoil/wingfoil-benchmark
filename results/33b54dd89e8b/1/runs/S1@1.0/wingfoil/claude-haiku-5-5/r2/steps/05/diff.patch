@@ -0,0 +1,176 @@
+import { test, describe } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+/** Deep-freezes a value, so that any mutation of it throws in strict mode. */
+function deepFreeze<T>(value: T): T {
+  if (typeof value === "object" && value !== null) {
+    for (const child of Object.values(value)) deepFreeze(child);
+    Object.freeze(value);
+  }
+  return value;
+}
+
+describe("createPatch: no change", () => {
+  test("gives an empty patch for equal values", () => {
+    const value = { a: [1, { b: "c" }], d: null };
+    assert.deepEqual(createPatch(value, structuredClone(value)), []);
+  });
+
+  test("gives an empty patch for primitives that are equal", () => {
+    assert.deepEqual(createPatch("x", "x"), []);
+    assert.deepEqual(createPatch(3, 3), []);
+    assert.deepEqual(createPatch(null, null), []);
+  });
+});
+
+describe("createPatch: objects", () => {
+  test("a changed primitive member gives one replace", () => {
+    assert.deepEqual(createPatch({ name: "ada", age: 36 }, { name: "ada", age: 37 }), [
+      { op: "replace", path: "/age", value: 37 },
+    ]);
+  });
+
+  test("an added member gives one add", () => {
+    assert.deepEqual(createPatch({ a: 1 }, { a: 1, b: 2 }), [{ op: "add", path: "/b", value: 2 }]);
+  });
+
+  test("a removed member gives one remove", () => {
+    assert.deepEqual(createPatch({ a: 1, b: 2 }, { a: 1 }), [{ op: "remove", path: "/b" }]);
+  });
+
+  test("a change deep in the document gives one operation at its full pointer", () => {
+    const from = { users: [{ name: "ada", tags: ["x"] }, { name: "grace" }], meta: { version: 1, big: "…" } };
+    const to = { users: [{ name: "ada", tags: ["x"] }, { name: "grace" }], meta: { version: 2, big: "…" } };
+    assert.deepEqual(createPatch(from, to), [{ op: "replace", path: "/meta/version", value: 2 }]);
+  });
+
+  test("a member that changes from an object to a string gives one replace", () => {
+    assert.deepEqual(createPatch({ a: { b: 1 } }, { a: "text" }), [{ op: "replace", path: "/a", value: "text" }]);
+  });
+
+  test("a member that changes from a primitive to an object gives one replace", () => {
+    assert.deepEqual(createPatch({ a: 1 }, { a: { b: 1 } }), [{ op: "replace", path: "/a", value: { b: 1 } }]);
+  });
+
+  test("a root that changes type gives one replace with the empty pointer", () => {
+    assert.deepEqual(createPatch({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+    assert.deepEqual(createPatch([1], "x"), [{ op: "replace", path: "", value: "x" }]);
+  });
+
+  test("keys with / and ~ are escaped in the pointers", () => {
+    assert.deepEqual(createPatch({ "a/b": 1, "m~n": 1 }, { "a/b": 2, "m~n": 3 }), [
+      { op: "replace", path: "/a~1b", value: 2 },
+      { op: "replace", path: "/m~0n", value: 3 },
+    ]);
+  });
+
+  test("the __proto__ key is handled as data", () => {
+    const from = JSON.parse('{"__proto__": {"x": 1}}');
+    const to = JSON.parse('{"__proto__": {"x": 2}}');
+    const patch = createPatch(from, to);
+    assert.deepEqual(patch, [{ op: "replace", path: "/__proto__/x", value: 2 }]);
+    assert.deepEqual(applyPatch(from, patch), to);
+  });
+});
+
+describe("createPatch: arrays", () => {
+  test("a changed element gives one replace at its index", () => {
+    assert.deepEqual(createPatch({ xs: [1, 2, 3] }, { xs: [1, 9, 3] }), [{ op: "replace", path: "/xs/1", value: 9 }]);
+  });
+
+  test("an element inserted into the middle of a long array gives one add", () => {
+    const from = { xs: [1, 2, 3, 4, 5, 6, 7, 8] };
+    const to = { xs: [1, 2, 3, "new", 4, 5, 6, 7, 8] };
+    assert.deepEqual(createPatch(from, to), [{ op: "add", path: "/xs/3", value: "new" }]);
+  });
+
+  test("an element removed from the middle of a long array gives one remove", () => {
+    const from = { xs: [1, 2, 3, "old", 4, 5, 6, 7, 8] };
+    const to = { xs: [1, 2, 3, 4, 5, 6, 7, 8] };
+    assert.deepEqual(createPatch(from, to), [{ op: "remove", path: "/xs/3" }]);
+  });
+
+  test("an element appended or removed at the end gives one operation", () => {
+    assert.deepEqual(createPatch({ xs: [1] }, { xs: [1, 2] }), [{ op: "add", path: "/xs/1", value: 2 }]);
+    assert.deepEqual(createPatch({ xs: [1, 2] }, { xs: [1] }), [{ op: "remove", path: "/xs/1" }]);
+  });
+
+  test("elements are added to and removed from an empty array", () => {
+    assert.deepEqual(createPatch({ xs: [] }, { xs: [1, 2] }), [
+      { op: "add", path: "/xs/0", value: 1 },
+      { op: "add", path: "/xs/1", value: 2 },
+    ]);
+    assert.deepEqual(createPatch({ xs: [1, 2] }, { xs: [] }), [
+      { op: "remove", path: "/xs/1" },
+      { op: "remove", path: "/xs/0" },
+    ]);
+  });
+
+  test("an element that changes type gives one replace", () => {
+    assert.deepEqual(createPatch({ xs: [[1]] }, { xs: [{ a: 1 }] }), [{ op: "replace", path: "/xs/0", value: { a: 1 } }]);
+  });
+
+  test("a reordering is applied correctly", () => {
+    const from = { xs: ["a", "b", "c", "d"] };
+    const to = { xs: ["d", "c", "b", "a"] };
+    assert.deepEqual(applyPatch(from, createPatch(from, to)), to);
+  });
+});
+
+describe("createPatch: round trip", () => {
+  const pairs: [string, unknown, unknown][] = [
+    ["nested objects and arrays", { a: [{ b: 1, c: [2, 3] }], d: "x" }, { a: [{ b: 2, c: [2] }, 7], e: true }],
+    ["an empty object and an object", {}, { a: { b: [null, false] } }],
+    ["a deleted subtree", { a: { b: { c: { d: 1 } } }, keep: 1 }, { keep: 1 }],
+    ["many changes in an array of objects", [{ id: 1 }, { id: 2 }, { id: 3 }], [{ id: 3 }, { id: 1, x: 1 }]],
+    ["a string root", "abc", "abd"],
+  ];
+  for (const [name, from, to] of pairs) {
+    test(`applying the patch gives the new value: ${name}`, () => {
+      assert.deepEqual(applyPatch(from, createPatch(from, to)), to);
+    });
+  }
+});
+
+describe("createPatch: inputs and output", () => {
+  test("does not mutate either input", () => {
+    const from = deepFreeze({ a: [1, { b: 2 }], c: "x" });
+    const to = deepFreeze({ a: [1, { b: 3 }], d: [4] });
+    const snapshot = structuredClone([from, to]);
+    createPatch(from, to);
+    assert.deepEqual([from, to], snapshot);
+  });
+
+  test("the patch shares no object or array with either input", () => {
+    const from = { a: { b: 1 } };
+    const to = { a: { b: { c: [1, 2] } } };
+    const patch = createPatch(from, to);
+    const value = patch[0].value as { c: unknown[] };
+    value.c.push(3);
+    assert.deepEqual(to, { a: { b: { c: [1, 2] } } });
+  });
+
+  test("the patch is not changed by applying it", () => {
+    const from = { xs: [1] };
+    const to = { xs: [1, { y: 2 }] };
+    const patch = createPatch(from, to);
+    const snapshot = structuredClone(patch);
+    applyPatch(from, patch);
+    assert.deepEqual(patch, snapshot);
+  });
+
+  test("rejects a document that is not JSON", () => {
+    assert.throws(() => createPatch({ a: undefined }, { a: 1 }), /invalid JSON document/);
+    assert.throws(() => createPatch({ a: 1 }, { a: () => 1 }), /invalid JSON document/);
+    assert.throws(() => createPatch({ d: new Date() }, {}), /invalid JSON document/);
+    assert.throws(() => createPatch({ a: NaN }, { a: 1 }), /invalid JSON document/);
+  });
+
+  test("rejects a circular document", () => {
+    const circular: Record<string, unknown> = { a: 1 };
+    circular.self = circular;
+    assert.throws(() => createPatch(circular, { a: 1 }), /invalid JSON document/);
+    assert.throws(() => createPatch({ a: 1 }, circular), /invalid JSON document/);
+  });
+});
