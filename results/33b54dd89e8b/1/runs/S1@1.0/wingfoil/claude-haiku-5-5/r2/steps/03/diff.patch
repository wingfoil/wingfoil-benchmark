diff --git a/test/apply-patch.test.ts b/test/apply-patch.test.ts
index 6345737357203c5baa865d2e59f74a051e2dfeef..514cbd31a3ef9e205fef76e6df3f12359a038f43 100644
--- a/test/apply-patch.test.ts
+++ b/test/apply-patch.test.ts
@@ -271,3 +271,89 @@ describe("applyPatch: invalid patches", () => {
     assert.throws(() => applyPatch(document, [{ op: "copy", from: "/a~2", path: "/b" }]), /invalid JSON Pointer/);
   });
 });
+
+describe("applyPatch: values must be JSON", () => {
+  const add = (value: unknown) => [{ op: "add", path: "/b", value }] as never;
+
+  test("rejects a value that JSON cannot represent", () => {
+    assert.throws(() => applyPatch({}, add(undefined)), /invalid JSON Patch/);
+    assert.throws(() => applyPatch({}, add(() => 1)), /invalid JSON Patch/);
+    assert.throws(() => applyPatch({}, add(Symbol("s"))), /invalid JSON Patch/);
+    assert.throws(() => applyPatch({}, add(1n)), /invalid JSON Patch/);
+    assert.throws(() => applyPatch({}, add(NaN)), /invalid JSON Patch/);
+    assert.throws(() => applyPatch({}, add(Infinity)), /invalid JSON Patch/);
+  });
+
+  test("rejects a class instance, such as a Date, which would be copied as an empty object", () => {
+    assert.throws(() => applyPatch({}, add(new Date(0))), /invalid JSON Patch/);
+    assert.throws(() => applyPatch({}, add(new Map())), /invalid JSON Patch/);
+  });
+
+  test("rejects a non-JSON value nested in an array or an object", () => {
+    assert.throws(() => applyPatch({}, add([1, undefined])), /invalid JSON Patch/);
+    assert.throws(() => applyPatch({}, add({ x: { y: () => 1 } })), /invalid JSON Patch/);
+  });
+
+  test("rejects a test value that is not JSON", () => {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: undefined }] as never), /invalid JSON Patch/);
+  });
+
+  test("accepts null, nested arrays and objects, and a key named __proto__ as JSON values", () => {
+    const value = JSON.parse('{"__proto__": {"k": [null, true, 1.5, "s", {}]}}');
+    assert.deepEqual(applyPatch({}, add(value)), { b: value });
+  });
+
+  test("rejects a circular value, rather than recursing into it", () => {
+    const value: Record<string, unknown> = {};
+    value.self = value;
+    assert.throws(() => applyPatch({}, add(value)), /invalid JSON Patch/);
+  });
+
+  test("accepts a value that is shared by two places but is not circular", () => {
+    const shared = { x: 1 };
+    assert.deepEqual(applyPatch({}, [
+      { op: "add", path: "/a", value: shared },
+      { op: "add", path: "/b", value: shared },
+    ]), { a: { x: 1 }, b: { x: 1 } });
+  });
+
+  test("rejects a document that is not JSON, rather than copying it into a different value", () => {
+    assert.throws(() => applyPatch({ d: new Date(0) }, []), /invalid JSON document/);
+    assert.throws(() => applyPatch({ u: undefined }, []), /invalid JSON document/);
+    assert.throws(() => applyPatch({ f: () => 1 }, []), /invalid JSON document/);
+  });
+
+  test("rejects a circular document", () => {
+    const document: Record<string, unknown> = {};
+    document.self = document;
+    assert.throws(() => applyPatch(document, []), /invalid JSON document/);
+  });
+});
+
+describe("applyPatch: operation members are own members", () => {
+  test("ignores an operation member that is only inherited, and rejects the operation", () => {
+    const operation = Object.create({ op: "remove", path: "/a" });
+    assert.throws(() => applyPatch({ a: 1 }, [operation] as never), /invalid JSON Patch/);
+  });
+
+  test("rejects an operation that is an instance of a class rather than a plain object", () => {
+    class Operation {
+      op = "remove";
+      path = "/a";
+    }
+    assert.throws(() => applyPatch({ a: 1 }, [new Operation()] as never), /invalid JSON Patch/);
+  });
+
+  test("rejects an inherited value member, which an add operation does not have", () => {
+    const operation = Object.create({ value: 2 });
+    Object.assign(operation, { op: "add", path: "/b" });
+    assert.throws(() => applyPatch({ a: 1 }, [operation] as never), /invalid JSON Patch/);
+  });
+});
+
+describe("applyPatch: a patch with holes", () => {
+  test("is rejected as an invalid patch", () => {
+    const patch = [, { op: "remove", path: "/a" }];
+    assert.throws(() => applyPatch({ a: 1 }, patch as never), /invalid JSON Patch/);
+  });
+});
