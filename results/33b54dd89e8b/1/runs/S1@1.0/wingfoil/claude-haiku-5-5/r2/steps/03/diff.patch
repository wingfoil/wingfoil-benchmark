-function isRecord(value: unknown): value is Record<string, unknown> {
-  return typeof value === "object" && value !== null && !Array.isArray(value);
+/** Whether `value` is an object created by a literal or by `JSON.parse`, rather than an array or a class instance. */
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  if (typeof value !== "object" || value === null) {
+    return false;
+  }
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
+
+/**
+ * Whether `value` is a JSON value (RFC 8259, on which RFC 6902 builds): null, a boolean, a finite number, a
+ * string, or an array or plain object whose elements and members are JSON values. `active` holds the
+ * containers being checked, so that a circular value is refused rather than recursed into.
+ */
+function isJsonValue(value: unknown, active: Set<object> = new Set()): boolean {
+  switch (typeof value) {
+    case "string":
+    case "boolean":
+      return true;
+    case "number":
+      return Number.isFinite(value);
+    case "object": {
+      if (value === null) {
+        return true;
+      }
+      if (active.has(value) || !(Array.isArray(value) || isPlainObject(value))) {
+        return false;
+      }
+      active.add(value);
+      const children = Array.isArray(value) ? Array.from(value) : Object.values(value);
+      const json = children.every((child) => isJsonValue(child, active));
+      active.delete(value);
+      return json;
+    }
+    default:
+      return false;
+  }
+}
+
+/** Reads a member the object has as its own; an inherited member is `undefined`. */
+function ownMember(object: Record<string, unknown>, key: string): unknown {
+  return Object.hasOwn(object, key) ? object[key] : undefined;
 }
 
