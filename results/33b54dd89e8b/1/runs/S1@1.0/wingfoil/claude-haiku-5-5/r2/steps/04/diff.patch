@@ -0,0 +1,45 @@
+import { cloneJson, defineMember, isJsonValue, isPlainObject, valueOf } from "./json.ts";
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document.
+ *
+ * An object patch merges into the target member by member: a member whose patch value is `null` is removed,
+ * and any other member is merged in turn. Any other patch (an array, a string, a number, a boolean, or `null`
+ * at the top level) replaces the target as a whole.
+ *
+ * The target and the patch are never mutated: the result is a new value that shares no object or array with
+ * either of them.
+ *
+ * @param target the JSON value to merge the patch into.
+ * @param patch the JSON Merge Patch.
+ * @returns the merged document, as a new value.
+ * @throws {Error} when `target` or `patch` is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonValue(target)) {
+    throw new Error("invalid JSON document: it holds a value that is not JSON");
+  }
+  if (!isJsonValue(patch)) {
+    throw new Error("invalid JSON Merge Patch: it holds a value that is not JSON");
+  }
+  return merge(cloneJson(target), patch);
+}
+
+/** Merges `patch` into `target`, which the caller has copied, and returns the merged value. */
+function merge(target: unknown, patch: unknown): unknown {
+  if (!isPlainObject(patch)) {
+    return cloneJson(patch);
+  }
+  const result: Record<string, unknown> = isPlainObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = valueOf(patch, key);
+    if (value === null) {
+      delete result[key];
+    } else {
+      // Only the target's own member is merged into: an inherited one, such as the prototype for `__proto__`, is not.
+      const current = Object.hasOwn(result, key) ? valueOf(result, key) : undefined;
+      defineMember(result, key, merge(current, value));
+    }
+  }
+  return result;
+}
