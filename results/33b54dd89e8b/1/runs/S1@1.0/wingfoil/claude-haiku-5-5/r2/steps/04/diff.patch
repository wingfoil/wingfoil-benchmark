diff --git a/test/merge-patch.test.ts b/test/merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c8070bd5f34f113f339811775f274e9169e3c126
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,137 @@
+import { test, describe } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+/** Deep-freezes a value, so that any mutation of it throws in strict mode. */
+function deepFreeze<T>(value: T): T {
+  if (typeof value === "object" && value !== null) {
+    for (const child of Object.values(value)) deepFreeze(child);
+    Object.freeze(value);
+  }
+  return value;
+}
+
+// The examples of RFC 7386, appendix A.
+describe("applyMergePatch: RFC 7386 appendix A examples", () => {
+  const cases: [string, unknown, unknown, unknown][] = [
+    ["replaces a member", { a: "b" }, { a: "c" }, { a: "c" }],
+    ["adds a member", { a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    ["removes a member", { a: "b" }, { a: null }, {}],
+    ["removes one of two members", { a: "b", b: "c" }, { a: null }, { b: "c" }],
+    ["replaces an array with a string", { a: ["b"] }, { a: "c" }, { a: "c" }],
+    ["replaces a string with an array", { a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    ["merges nested objects", { a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    ["replaces an array of objects", { a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    ["replaces an array with an array", ["a", "b"], ["c", "d"], ["c", "d"]],
+    ["replaces an object with an array", { a: "b" }, ["c"], ["c"]],
+    ["replaces a document with null", { a: "foo" }, null, null],
+    ["replaces a document with a string", { a: "foo" }, "bar", "bar"],
+    ["keeps a null member that is not removed", { e: null }, { a: 1 }, { e: null, a: 1 }],
+    ["merges into an array target as an empty object", [1, 2], { a: "b", c: null }, { a: "b" }],
+    ["drops nested nulls of a new object", {}, { a: { bb: { c: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [name, target, patch, expected] of cases) {
+    test(name, () => {
+      assert.deepEqual(applyMergePatch(target, patch), expected);
+    });
+  }
+});
+
+describe("applyMergePatch: merging", () => {
+  test("keeps the members a patch does not name", () => {
+    assert.deepEqual(applyMergePatch({ a: 1, b: 2, c: 3 }, { b: 20 }), { a: 1, b: 20, c: 3 });
+  });
+
+  test("removing a member that is absent is not an error", () => {
+    assert.deepEqual(applyMergePatch({ a: 1 }, { b: null }), { a: 1 });
+  });
+
+  test("a null member inside a nested object removes it", () => {
+    assert.deepEqual(applyMergePatch({ a: { b: 1, c: 2 } }, { a: { c: null } }), { a: { b: 1 } });
+  });
+
+  test("an array inside an object patch replaces the member and keeps its null elements", () => {
+    assert.deepEqual(applyMergePatch({ a: { b: 1 } }, { a: [null, 1] }), { a: [null, 1] });
+  });
+
+  test("a primitive replaces an object member, and a null member removes it", () => {
+    assert.deepEqual(applyMergePatch({ a: { b: 1 } }, { a: 5 }), { a: 5 });
+    assert.deepEqual(applyMergePatch({ a: { b: 1 } }, { a: null }), {});
+  });
+
+  test("an empty patch leaves the target as it is", () => {
+    assert.deepEqual(applyMergePatch({ a: [1, { b: 2 }] }, {}), { a: [1, { b: 2 }] });
+  });
+
+  test("an empty target takes the members of the patch", () => {
+    assert.deepEqual(applyMergePatch({}, { a: 1, b: [true] }), { a: 1, b: [true] });
+  });
+});
+
+describe("applyMergePatch: values", () => {
+  test("stores the key __proto__ as data, without changing a prototype", () => {
+    const patch = JSON.parse('{"__proto__": {"polluted": true}}');
+    const result = applyMergePatch({}, patch) as Record<string, unknown>;
+    assert.equal(Object.getPrototypeOf(result), Object.prototype);
+    assert.equal(({} as Record<string, unknown>).polluted, undefined);
+    assert.deepEqual(Object.keys(result), ["__proto__"]);
+  });
+
+  test("a __proto__ member of the target is not merged into a prototype", () => {
+    const target = JSON.parse('{"__proto__": {"a": 1}}');
+    const patch = JSON.parse('{"__proto__": {"polluted": true}}');
+    const result = applyMergePatch(target, patch) as Record<string, unknown>;
+    assert.equal(({} as Record<string, unknown>).polluted, undefined);
+    assert.equal(Object.getPrototypeOf(Object.prototype), null);
+    assert.deepEqual(result, JSON.parse('{"__proto__": {"a": 1, "polluted": true}}'));
+  });
+
+  test("does not mutate the target or the patch", () => {
+    const target = deepFreeze({ a: { b: 1, c: [1] }, d: 2 });
+    const patch = deepFreeze({ a: { b: null, e: { f: 3 } } });
+    assert.deepEqual(applyMergePatch(target, patch), { a: { c: [1], e: { f: 3 } }, d: 2 });
+    assert.deepEqual(target, { a: { b: 1, c: [1] }, d: 2 });
+    assert.deepEqual(patch, { a: { b: null, e: { f: 3 } } });
+  });
+
+  test("the result shares no object or array with the target or the patch", () => {
+    const target = { a: { b: [1] } };
+    const patch = { c: { d: [2] } };
+    const result = applyMergePatch(target, patch) as { a: { b: unknown[] }; c: { d: unknown[] } };
+    result.a.b.push(9);
+    result.c.d.push(9);
+    assert.deepEqual(target, { a: { b: [1] } });
+    assert.deepEqual(patch, { c: { d: [2] } });
+  });
+
+  test("the result of a replaced member is a copy of the patch's value", () => {
+    const patch = { a: [{ b: 1 }] };
+    const result = applyMergePatch({}, patch) as { a: { b: number }[] };
+    result.a[0].b = 2;
+    assert.deepEqual(patch, { a: [{ b: 1 }] });
+  });
+});
+
+describe("applyMergePatch: invalid input", () => {
+  test("throws when the patch holds undefined", () => {
+    assert.throws(() => applyMergePatch({}, { a: undefined }), /not JSON/);
+  });
+
+  test("throws when the patch is not a JSON value", () => {
+    assert.throws(() => applyMergePatch({}, undefined), /not JSON/);
+    assert.throws(() => applyMergePatch({}, { a: Number.NaN }), /not JSON/);
+    assert.throws(() => applyMergePatch({}, { a: () => 1 }), /not JSON/);
+    assert.throws(() => applyMergePatch({}, { a: new Date(0) }), /not JSON/);
+  });
+
+  test("throws when the target holds a value that is not JSON", () => {
+    assert.throws(() => applyMergePatch({ a: Number.POSITIVE_INFINITY }, {}), /not JSON/);
+    assert.throws(() => applyMergePatch({ a: new Date(0) }, { b: 1 }), /not JSON/);
+  });
+
+  test("throws when the patch is circular", () => {
+    const patch: Record<string, unknown> = {};
+    patch.self = patch;
+    assert.throws(() => applyMergePatch({}, patch), /not JSON/);
+  });
+});
