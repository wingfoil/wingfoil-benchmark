 }
 
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a target JSON document and returns the merged document.
+ *
+ * An object patch is merged into the target member by member, recursively: a member whose value is
+ * `null` removes the target member of that name, and any other member replaces the target member or
+ * is added to it. An object patch applied to a target that is not an object merges into an empty
+ * object. A patch that is not an object, arrays included, replaces the whole target: an array is a
+ * value, so its `null` elements are kept.
+ * Only own members of the patch count. The input target and patch are not modified: the result is a
+ * new value, and values taken from the patch are copied into it.
+ *
+ * @throws {SyntaxError} when the patch contains a value that is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonValue(patch)) {
+    throw new SyntaxError('invalid JSON Merge Patch: it contains a value that is not a JSON value');
+  }
+  return mergePatch(structuredClone(target), structuredClone(patch));
+}
+
+/** Merges a patch into a target that the caller owns, and returns the merged value. */
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return patch;
+  }
+  const result = isObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    if (patch[key] === null) {
+      Reflect.deleteProperty(result, key);
+    } else {
+      const current = Object.hasOwn(result, key) ? result[key] : undefined;
+      defineMember(result, key, mergePatch(current, patch[key]));
+    }
+  }
+  return result;
+}
+
 type Operation =
   | { op: 'add' | 'replace' | 'test'; path: string; value: unknown }
   | { op: 'remove'; path: string }
diff --git a/test/apply-merge-patch.test.ts b/test/apply-merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eda63a58831e257fe633b73e6c8ca607ae00eb7b
--- /dev/null
+++ b/test/apply-merge-patch.test.ts
@@ -0,0 +1,93 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyMergePatch } from '../src/index.ts';
+
+// The examples of RFC 7386, section 3.
+test('a member of the patch replaces the target member (3, first example)', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { a: 'c' }), { a: 'c' });
+});
+
+test('a member of the patch absent from the target is added (3, second example)', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { b: 'c' }), { a: 'b', b: 'c' });
+});
+
+test('a null member removes the target member (3, third example)', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { a: null }), {});
+});
+
+test('a null member for an absent target member is a no-op', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { c: null }), { a: 'b' });
+});
+
+test('a nested object patch merges recursively (3, fourth example)', () => {
+  const target = { a: { b: 'c' } };
+  assert.deepEqual(applyMergePatch(target, { a: { b: 'd', c: null } }), { a: { b: 'd' } });
+});
+
+test('a nested null removes a nested member and keeps its siblings', () => {
+  assert.deepEqual(applyMergePatch({ a: { b: 1, c: 2 } }, { a: { b: null } }), { a: { c: 2 } });
+});
+
+test('an object patch on a non-object target merges into an empty object (3, fifth example)', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, ['c']), ['c']);
+  assert.deepEqual(applyMergePatch('x', { a: 1, b: null }), { a: 1 });
+  assert.deepEqual(applyMergePatch(null, { a: { b: null } }), { a: {} });
+  assert.deepEqual(applyMergePatch(42, { a: 1 }), { a: 1 });
+  assert.deepEqual(applyMergePatch([1, 2], { a: 1 }), { a: 1 });
+});
+
+test('a non-object patch replaces the whole target', () => {
+  assert.equal(applyMergePatch({ a: 1 }, null), null);
+  assert.equal(applyMergePatch({ a: 1 }, false), false);
+  assert.equal(applyMergePatch({ a: 1 }, 0), 0);
+  assert.equal(applyMergePatch({ a: 1 }, ''), '');
+  assert.deepEqual(applyMergePatch({ a: 1 }, ['x', null]), ['x', null]);
+});
+
+test('an array in the patch replaces the target array as a whole, nulls included', () => {
+  assert.deepEqual(applyMergePatch({ a: [1, 2, 3] }, { a: [4, null] }), { a: [4, null] });
+  assert.deepEqual(applyMergePatch({ a: { b: 1 } }, { a: [{ c: null }] }), { a: [{ c: null }] });
+});
+
+test('the target and the patch are not mutated, and the result shares no state with them', () => {
+  const target = { a: { b: 1 }, c: [1] };
+  const patch = { a: { d: { e: 2 } }, f: { g: [3] } };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 }, c: [1] });
+  assert.deepEqual(patch, { a: { d: { e: 2 } }, f: { g: [3] } });
+  result.f.g.push(4);
+  result.a.d.e = 9;
+  assert.deepEqual(patch, { a: { d: { e: 2 } }, f: { g: [3] } });
+});
+
+test('only own members of the patch count: an object with a custom prototype is not a JSON value', () => {
+  const patch = Object.create({ inherited: 'x' }) as Record<string, unknown>;
+  patch.own = 1;
+  assert.throws(() => applyMergePatch({ inherited: 'kept' }, patch), SyntaxError);
+  assert.deepEqual(applyMergePatch({ inherited: 'kept' }, { own: 1 }), { inherited: 'kept', own: 1 });
+});
+
+test('a "__proto__" member is an ordinary member', () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}}');
+  const result = applyMergePatch({}, patch) as Record<string, unknown>;
+  assert.deepEqual(Object.keys(result), ['__proto__']);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test('a patch containing a value that is not a JSON value throws SyntaxError', () => {
+  assert.throws(() => applyMergePatch({}, { a: undefined }), SyntaxError);
+  assert.throws(() => applyMergePatch({}, { a: NaN }), SyntaxError);
+  assert.throws(() => applyMergePatch({}, { a: { b: Infinity } }), SyntaxError);
+  assert.throws(() => applyMergePatch({}, { a: new Date() }), SyntaxError);
+  assert.throws(() => applyMergePatch({}, { a: () => 1 }), SyntaxError);
+  assert.throws(() => applyMergePatch({}, [1, undefined]), SyntaxError);
+});
+
+test('valid JSON values of every kind are accepted in the patch', () => {
+  assert.deepEqual(applyMergePatch({}, { a: 0, b: false, c: '', d: [null, { e: [] }] }), {
+    a: 0,
+    b: false,
+    c: '',
+    d: [null, { e: [] }],
+  });
+});
