@@ -0,0 +1,48 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document and returns the value it refers to.
+ *
+ * The empty pointer refers to the whole document. Otherwise the pointer is a sequence of reference
+ * tokens, each preceded by "/". Object members are selected by name and array elements by index.
+ * Inherited object properties do not resolve. The document is not modified.
+ *
+ * @throws {SyntaxError} when the pointer is not a valid JSON Pointer.
+ * @throws {Error} when the pointer does not resolve to a value of the document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== 'string') {
+    throw new TypeError('JSON Pointer must be a string');
+  }
+  if (pointer === '') {
+    return document;
+  }
+  if (!pointer.startsWith('/')) {
+    throw new SyntaxError(`invalid JSON Pointer "${pointer}": it must be empty or start with "/"`);
+  }
+
+  let current = document;
+  for (const escaped of pointer.slice(1).split('/')) {
+    current = select(current, unescapeToken(escaped, pointer), pointer);
+  }
+  return current;
+}
+
+/** Decodes "~1" to "/" and "~0" to "~", in that order; any other "~" is invalid. */
+function unescapeToken(token: string, pointer: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new SyntaxError(`invalid JSON Pointer "${pointer}": "~" must be followed by "0" or "1"`);
+  }
+  return token.replace(/~1/g, '/').replace(/~0/g, '~');
+}
+
+/** Returns the member or element of `container` named by `token`, or throws if there is none. */
+function select(container: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(container)) {
+    const isIndex = /^(0|[1-9][0-9]*)$/.test(token);
+    if (isIndex && Number(token) < container.length) {
+      return container[Number(token)];
+    }
+  } else if (typeof container === 'object' && container !== null && Object.hasOwn(container, token)) {
+    return (container as Record<string, unknown>)[token];
+  }
+  throw new Error(`JSON Pointer "${pointer}" does not resolve to a value of the document`);
+}
diff --git a/test/resolve-pointer.test.ts b/test/resolve-pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..14a90d304f03700fa9beafd170d09c423b94237d
--- /dev/null
+++ b/test/resolve-pointer.test.ts
@@ -0,0 +1,114 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { resolvePointer } from '../src/index.ts';
+
+// The example document of RFC 6901, section 5.
+const rfcDocument = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+test('the empty pointer refers to the whole document', () => {
+  assert.equal(resolvePointer(rfcDocument, ''), rfcDocument);
+});
+
+test('resolves the RFC 6901 examples', () => {
+  assert.deepEqual(resolvePointer(rfcDocument, '/foo'), ['bar', 'baz']);
+  assert.equal(resolvePointer(rfcDocument, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(rfcDocument, '/'), 0);
+  assert.equal(resolvePointer(rfcDocument, '/a~1b'), 1);
+  assert.equal(resolvePointer(rfcDocument, '/c%d'), 2);
+  assert.equal(resolvePointer(rfcDocument, '/e^f'), 3);
+  assert.equal(resolvePointer(rfcDocument, '/g|h'), 4);
+  assert.equal(resolvePointer(rfcDocument, '/i\\j'), 5);
+  assert.equal(resolvePointer(rfcDocument, '/k"l'), 6);
+  assert.equal(resolvePointer(rfcDocument, '/ '), 7);
+  assert.equal(resolvePointer(rfcDocument, '/m~0n'), 8);
+});
+
+test('resolves nested objects and arrays', () => {
+  const document = { a: { b: [{ c: 'deep' }] } };
+  assert.equal(resolvePointer(document, '/a/b/0/c'), 'deep');
+});
+
+test('decodes ~0 and ~1 in order, so ~01 is the key "~1"', () => {
+  assert.equal(resolvePointer({ '~1': 'x' }, '/~01'), 'x');
+});
+
+test('resolves present values that are falsy', () => {
+  const document = { n: null, f: false, z: 0, e: '' };
+  assert.equal(resolvePointer(document, '/n'), null);
+  assert.equal(resolvePointer(document, '/f'), false);
+  assert.equal(resolvePointer(document, '/z'), 0);
+  assert.equal(resolvePointer(document, '/e'), '');
+});
+
+test('does not modify the document', () => {
+  const document = { a: [1, 2] };
+  const copy = structuredClone(document);
+  resolvePointer(document, '/a/1');
+  assert.deepEqual(document, copy);
+});
+
+test('throws when the pointer does not start with "/"', () => {
+  assert.throws(() => resolvePointer(rfcDocument, 'foo'), Error);
+  assert.throws(() => resolvePointer(rfcDocument, 'foo/bar'), Error);
+  assert.throws(() => resolvePointer(rfcDocument, '#/foo'), Error);
+});
+
+test('throws on a "~" that is not followed by 0 or 1', () => {
+  assert.throws(() => resolvePointer(rfcDocument, '/a~2b'), Error);
+  assert.throws(() => resolvePointer(rfcDocument, '/a~'), Error);
+  assert.throws(() => resolvePointer(rfcDocument, '/~'), Error);
+});
+
+test('throws when a member does not exist', () => {
+  assert.throws(() => resolvePointer(rfcDocument, '/missing'), Error);
+  assert.throws(() => resolvePointer({ a: {} }, '/a/missing'), Error);
+});
+
+test('inherited properties do not resolve', () => {
+  assert.throws(() => resolvePointer({}, '/constructor'), Error);
+  assert.throws(() => resolvePointer({}, '/__proto__'), Error);
+  assert.throws(() => resolvePointer({}, '/toString'), Error);
+});
+
+test('an own "__proto__" member resolves', () => {
+  const document = JSON.parse('{"__proto__": "own"}');
+  assert.equal(resolvePointer(document, '/__proto__'), 'own');
+});
+
+test('array tokens must be array indices', () => {
+  const document = { arr: ['x', 'y'] };
+  assert.equal(resolvePointer(document, '/arr/1'), 'y');
+  assert.throws(() => resolvePointer(document, '/arr/-'), Error);
+  assert.throws(() => resolvePointer(document, '/arr/01'), Error);
+  assert.throws(() => resolvePointer(document, '/arr/+1'), Error);
+  assert.throws(() => resolvePointer(document, '/arr/1x'), Error);
+  assert.throws(() => resolvePointer(document, '/arr/'), Error);
+});
+
+test('an array index outside the array throws', () => {
+  assert.throws(() => resolvePointer({ arr: ['x', 'y'] }, '/arr/2'), Error);
+  assert.throws(() => resolvePointer({ arr: [] }, '/arr/0'), Error);
+});
+
+test('a token cannot select into a primitive value', () => {
+  assert.throws(() => resolvePointer({ a: 5 }, '/a/b'), Error);
+  assert.throws(() => resolvePointer({ a: 'str' }, '/a/0'), Error);
+  assert.throws(() => resolvePointer({ a: null }, '/a/x'), Error);
+  assert.throws(() => resolvePointer(5, '/x'), Error);
+});
+
+test('throws when the pointer is not a string', () => {
+  assert.throws(() => resolvePointer({}, undefined as unknown as string), Error);
+  assert.throws(() => resolvePointer({}, 1 as unknown as string), Error);
+});
