+/** Returns the `value` member of an operation, which must be present and a JSON value. */
+function parseValue(entry: Record<string, unknown>, op: string): unknown {
+  if (!Object.hasOwn(entry, 'value')) {
+    throw new SyntaxError(`invalid JSON Patch operation: "${op}" requires a "value"`);
+  }
+  const value = ownMember(entry, 'value');
+  if (!isJsonValue(value)) {
+    throw new SyntaxError(`invalid JSON Patch operation: "value" of "${op}" is not a JSON value`);
+  }
+  return value;
+}
+
+/** Returns an own member of an object, or undefined: an inherited property is not a JSON member. */
+function ownMember(object: Record<string, unknown>, key: string): unknown {
+  return Object.hasOwn(object, key) ? object[key] : undefined;
+}
