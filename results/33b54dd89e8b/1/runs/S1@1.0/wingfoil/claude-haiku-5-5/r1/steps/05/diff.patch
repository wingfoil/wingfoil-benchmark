index 0000000000000000000000000000000000000000..068a9439c9be9c1cdaa56ecbd36046376e2b8f3e
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,125 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch, createPatch } from '../src/index.ts';
+
+/** Checks that the patch turns `from` into `to`, and that the inputs are left as they were. */
+function assertRoundTrip(from: unknown, to: unknown): unknown[] {
+  const fromBefore = structuredClone(from);
+  const toBefore = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, fromBefore);
+  assert.deepEqual(to, toBefore);
+  return patch;
+}
+
+test('equal documents give an empty patch', () => {
+  assert.deepEqual(createPatch({ a: [1, { b: 'c' }] }, { a: [1, { b: 'c' }] }), []);
+  assert.deepEqual(createPatch(null, null), []);
+  assert.deepEqual(createPatch('x', 'x'), []);
+});
+
+test('a single changed member of a nested object gives one replace at its pointer', () => {
+  const from = { a: { b: { c: 1, d: 'keep' } }, e: [1, 2, 3] };
+  const to = { a: { b: { c: 2, d: 'keep' } }, e: [1, 2, 3] };
+  assert.deepEqual(assertRoundTrip(from, to), [{ op: 'replace', path: '/a/b/c', value: 2 }]);
+});
+
+test('an added member gives one add, and a removed member gives one remove', () => {
+  assert.deepEqual(assertRoundTrip({ a: 1 }, { a: 1, b: 'new' }), [
+    { op: 'add', path: '/b', value: 'new' },
+  ]);
+  assert.deepEqual(assertRoundTrip({ a: 1, b: 2 }, { a: 1 }), [{ op: 'remove', path: '/b' }]);
+});
+
+test('a member whose value changes kind gives one replace', () => {
+  assert.deepEqual(assertRoundTrip({ a: null }, { a: { b: 1 } }), [
+    { op: 'replace', path: '/a', value: { b: 1 } },
+  ]);
+  assert.deepEqual(assertRoundTrip({ a: 'text' }, { a: 3 }), [{ op: 'replace', path: '/a', value: 3 }]);
+  assert.deepEqual(assertRoundTrip({ a: [1] }, { a: { 0: 1 } }), [
+    { op: 'replace', path: '/a', value: { 0: 1 } },
+  ]);
+});
+
+test('a changed array element gives one replace at its index', () => {
+  assert.deepEqual(assertRoundTrip({ list: ['a', 'b', 'c'] }, { list: ['a', 'x', 'c'] }), [
+    { op: 'replace', path: '/list/1', value: 'x' },
+  ]);
+});
+
+test('an element inserted in the middle of an array gives one add, not a rewrite of the rest', () => {
+  assert.deepEqual(assertRoundTrip([1, 2, 3, 4], [1, 2, 'new', 3, 4]), [
+    { op: 'add', path: '/2', value: 'new' },
+  ]);
+  assert.deepEqual(assertRoundTrip([1, 2, 3], [0, 1, 2, 3]), [{ op: 'add', path: '/0', value: 0 }]);
+});
+
+test('an element removed from the middle of an array gives one remove', () => {
+  assert.deepEqual(assertRoundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: 'remove', path: '/1' }]);
+});
+
+test('appended and truncated arrays give adds and removes at the end', () => {
+  assert.deepEqual(assertRoundTrip([1, 2], [1, 2, 3, 4]), [
+    { op: 'add', path: '/2', value: 3 },
+    { op: 'add', path: '/3', value: 4 },
+  ]);
+  assert.deepEqual(assertRoundTrip([1, 2, 3, 4], [1, 2]), [
+    { op: 'remove', path: '/3' },
+    { op: 'remove', path: '/2' },
+  ]);
+});
+
+test('an array emptied or filled from nothing is patched', () => {
+  assert.deepEqual(assertRoundTrip([], [{ a: 1 }]), [{ op: 'add', path: '/0', value: { a: 1 } }]);
+  assert.deepEqual(assertRoundTrip(['a'], []), [{ op: 'remove', path: '/0' }]);
+});
+
+test('a change of the whole document gives a replace with the empty pointer', () => {
+  assert.deepEqual(assertRoundTrip({ a: 1 }, [1]), [{ op: 'replace', path: '', value: [1] }]);
+  assert.deepEqual(assertRoundTrip('old', { a: 1 }), [{ op: 'replace', path: '', value: { a: 1 } }]);
+  assert.deepEqual(assertRoundTrip(0, false), [{ op: 'replace', path: '', value: false }]);
+});
+
+test('member names containing "/" or "~" are escaped in the pointer', () => {
+  assert.deepEqual(assertRoundTrip({ 'a/b': 1, 'c~d': 1 }, { 'a/b': 2, 'c~d': 2 }), [
+    { op: 'replace', path: '/a~1b', value: 2 },
+    { op: 'replace', path: '/c~0d', value: 2 },
+  ]);
+});
+
+test('a member named "__proto__" is an ordinary member', () => {
+  const from = JSON.parse('{"__proto__": {"x": 1}}');
+  const to = JSON.parse('{"__proto__": {"x": 2}}');
+  assert.deepEqual(assertRoundTrip(from, to), [{ op: 'replace', path: '/__proto__/x', value: 2 }]);
+});
+
+test('values taken from the inputs are copied into the patch', () => {
+  const from = { a: 1 };
+  const to = { a: 1, b: { c: [1] } };
+  const patch = createPatch(from, to) as { value: { c: unknown[] } }[];
+  patch[0].value.c.push('later');
+  assert.deepEqual(to, { a: 1, b: { c: [1] } });
+  assert.deepEqual(applyPatch(from, createPatch(from, to)), to);
+});
+
+test('a patch from a document that is later changed still applies to the original', () => {
+  const from = { list: [1, 2] };
+  const to = { list: [1, 2, { deep: true }] };
+  const patch = createPatch(from, to);
+  const result = applyPatch(from, patch) as { list: { deep: boolean }[] };
+  result.list[2].deep = false;
+  assert.deepEqual(to, { list: [1, 2, { deep: true }] });
+});
+
+test('inputs that are not JSON values throw a SyntaxError', () => {
+  assert.throws(() => createPatch({ a: undefined }, {}), SyntaxError);
+  assert.throws(() => createPatch({}, { a: NaN }), SyntaxError);
+  assert.throws(() => createPatch({ a: Infinity }, {}), SyntaxError);
+  assert.throws(() => createPatch({}, { d: new Date(0) }), SyntaxError);
+  assert.throws(() => createPatch([1, , 3], [1, 2, 3]), SyntaxError);
+  assert.throws(() => createPatch(() => 1, {}), SyntaxError);
+  const cyclic: Record<string, unknown> = {};
+  cyclic.self = cyclic;
+  assert.throws(() => createPatch({}, cyclic), SyntaxError);
+});
