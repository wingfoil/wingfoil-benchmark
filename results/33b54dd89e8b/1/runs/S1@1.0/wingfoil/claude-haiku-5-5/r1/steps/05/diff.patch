index 321e1d1deffb87ca9d79237ee0fc80196dc2e51f..b668c8d504a3d45661635709570487267a94e2e7 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -78,6 +78,98 @@ function mergePatch(target: unknown, patch: unknown): unknown {
   return result;
 }
 
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch describes what changed and nothing more. A member present in only one object is removed
+ * or added, and a member present in both is compared recursively. In an array, the common prefix and
+ * suffix are skipped and the elements between them are compared by position, then the surplus is
+ * removed or added: an insertion or a deletion in the middle of an array is a single operation. Any
+ * other difference is a `replace`, and equal documents give an empty patch. Member names are escaped
+ * in the pointers (RFC 6901). The inputs are not modified: the values in the patch are copies.
+ *
+ * @throws {SyntaxError} when `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new SyntaxError('invalid JSON Patch source: it must contain only JSON values');
+  }
+  return diff(from, to, '');
+}
+
+/** Lists the operations that turn `from` into `to`, both found at `path`. */
+function diff(from: unknown, to: unknown, path: string): Operation[] {
+  if (jsonEqual(from, to)) {
+    return [];
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    return diffArrays(from, to, path);
+  }
+  if (isObject(from) && isObject(to)) {
+    return diffObjects(from, to, path);
+  }
+  return [{ op: 'replace', path, value: structuredClone(to) }];
+}
+
+/** Lists the operations that turn one object into another, member by member. */
+function diffObjects(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  path: string,
+): Operation[] {
+  const operations: Operation[] = [];
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      operations.push({ op: 'remove', path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const memberPath = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) {
+      operations.push(...diff(from[key], to[key], memberPath));
+    } else {
+      operations.push({ op: 'add', path: memberPath, value: structuredClone(to[key]) });
+    }
+  }
+  return operations;
+}
+
+/**
+ * Lists the operations that turn one array into another. The common prefix and suffix are skipped;
+ * the elements between them are paired by position, then the surplus of `from` is removed from the
+ * end and the surplus of `to` is inserted in order.
+ */
+function diffArrays(from: unknown[], to: unknown[], path: string): Operation[] {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+    start++;
+  }
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && jsonEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+  const paired = Math.min(fromEnd - start, toEnd - start);
+  const operations: Operation[] = [];
+  for (let offset = 0; offset < paired; offset++) {
+    const index = start + offset;
+    operations.push(...diff(from[index], to[index], `${path}/${index}`));
+  }
+  for (let index = fromEnd - 1; index >= start + paired; index--) {
+    operations.push({ op: 'remove', path: `${path}/${index}` });
+  }
+  for (let index = start + paired; index < toEnd; index++) {
+    operations.push({ op: 'add', path: `${path}/${index}`, value: structuredClone(to[index]) });
+  }
+  return operations;
+}
+
+/** Escapes a member name as a reference token of a JSON Pointer: "~" becomes "~0", "/" becomes "~1". */
+function escapeToken(key: string): string {
+  return key.replace(/~/g, '~0').replace(/\//g, '~1');
+}
+
 type Operation =
   | { op: 'add' | 'replace' | 'test'; path: string; value: unknown }
   | { op: 'remove'; path: string }
