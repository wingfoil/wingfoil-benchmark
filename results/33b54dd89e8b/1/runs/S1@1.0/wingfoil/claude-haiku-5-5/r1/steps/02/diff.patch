+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the resulting document.
+ *
+ * The patch is an array of operations, applied in order, each to the result of the previous one:
+ * `add`, `remove`, `replace`, `move`, `copy` and `test`. Paths are JSON Pointers (RFC 6901). The
+ * input document and the patch are not modified: the result is a new value, and values taken from
+ * the patch are copied into it.
+ *
+ * @throws {SyntaxError} when the patch, or one of its operations or paths, is invalid.
+ * @throws {Error} when an operation fails, for example when its target does not exist or a
+ *   `test` value differs. No partial result is returned.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new SyntaxError('invalid JSON Patch: it must be an array of operations');
+  }
+  let result = structuredClone(document);
+  for (const entry of patch) {
+    result = applyOperation(result, parseOperation(entry));
+  }
+  return result;
+}
+
+type Operation =
+  | { op: 'add' | 'replace' | 'test'; path: string; value: unknown }
+  | { op: 'remove'; path: string }
+  | { op: 'move' | 'copy'; path: string; from: string };
+
+/** Checks the members of one patch operation, and returns it typed. */
+function parseOperation(entry: unknown): Operation {
+  if (!isObject(entry)) {
+    throw new SyntaxError('invalid JSON Patch operation: it must be an object');
+  }
+  const { op, path, from } = entry;
+  if (typeof path !== 'string') {
+    throw new SyntaxError('invalid JSON Patch operation: "path" must be a string');
+  }
+  parsePointer(path);
+  switch (op) {
+    case 'add':
+    case 'replace':
+    case 'test':
+      if (!Object.hasOwn(entry, 'value')) {
+        throw new SyntaxError(`invalid JSON Patch operation: "${op}" requires a "value"`);
+      }
+      return { op, path, value: entry.value };
+    case 'remove':
+      return { op, path };
+    case 'move':
+    case 'copy':
+      if (typeof from !== 'string') {
+        throw new SyntaxError(`invalid JSON Patch operation: "${op}" requires a string "from"`);
+      }
+      parsePointer(from);
+      return { op, path, from };
+    default:
+      throw new SyntaxError(`invalid JSON Patch operation: unknown "op" ${JSON.stringify(op)}`);
+  }
+}
+
+/** Applies one operation, returning the new document. The document it is given may be changed. */
+function applyOperation(document: unknown, operation: Operation): unknown {
+  switch (operation.op) {
+    case 'add':
+      return add(document, operation.path, structuredClone(operation.value));
+    case 'replace':
+      return replace(document, operation.path, structuredClone(operation.value));
+    case 'remove':
+      return remove(document, operation.path);
+    case 'move':
+      return move(document, operation.from, operation.path);
+    case 'copy':
+      return add(
+        document,
+        operation.path,
+        structuredClone(resolvePointer(document, operation.from)),
+      );
+    case 'test':
+      if (!jsonEqual(resolvePointer(document, operation.path), operation.value)) {
+        throw new Error(`test failed: the value at "${operation.path}" differs`);
+      }
+      return document;
+  }
+}
+
+/** Sets the member or inserts the element that `path` names; "" replaces the whole document. */
+function add(document: unknown, path: string, value: unknown): unknown {
+  if (path === '') {
+    return value;
+  }
+  const parent = resolvePointer(document, parentPointer(path));
+  const token = lastToken(path);
+  if (Array.isArray(parent)) {
+    const index = token === '-' ? parent.length : arrayIndex(token, parent.length, path, true);
+    parent.splice(index, 0, value);
+  } else if (isObject(parent)) {
+    defineMember(parent, token, value);
+  } else {
+    throw new Error(`add failed: "${path}" has no parent object or array`);
+  }
+  return document;
+}
+
+/** Replaces the value at `path`, which must exist. */
+function replace(document: unknown, path: string, value: unknown): unknown {
+  if (path === '') {
+    return value;
+  }
+  resolvePointer(document, path);
+  const parent = resolvePointer(document, parentPointer(path));
+  const token = lastToken(path);
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else if (isObject(parent)) {
+    defineMember(parent, token, value);
+  }
+  return document;
