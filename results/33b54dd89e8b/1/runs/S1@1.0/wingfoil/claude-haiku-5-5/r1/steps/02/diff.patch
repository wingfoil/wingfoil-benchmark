+ * (RFC 6901 section 4), and below `length`, or at most `length` when `allowEnd` is set.
+ */
+function arrayIndex(token: string, length: number, path: string, allowEnd: boolean): number {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`"${path}" does not name an array index`);
+  }
+  const index = Number(token);
+  if (index > length || (!allowEnd && index === length)) {
+    throw new Error(`"${path}" is outside the array`);
+  }
+  return index;
