+++ b/test/apply-patch.test.ts
@@ -0,0 +1,284 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch } from '../src/index.ts';
+
+// The examples of RFC 6902, appendix A.
+test('add adds an object member (A.1)', () => {
+  const document = { foo: 'bar' };
+  assert.deepEqual(applyPatch(document, [{ op: 'add', path: '/baz', value: 'qux' }]), {
+    baz: 'qux',
+    foo: 'bar',
+  });
+});
+
+test('add inserts an array element before the given index (A.2)', () => {
+  const document = { foo: ['bar', 'baz'] };
+  assert.deepEqual(applyPatch(document, [{ op: 'add', path: '/foo/1', value: 'qux' }]), {
+    foo: ['bar', 'qux', 'baz'],
+  });
+});
+
+test('add with "-" appends to an array (A.16)', () => {
+  const document = { foo: ['bar'] };
+  assert.deepEqual(applyPatch(document, [{ op: 'add', path: '/foo/-', value: ['abc', 'def'] }]), {
+    foo: ['bar', ['abc', 'def']],
+  });
+});
+
+test('remove removes an object member (A.3)', () => {
+  const document = { baz: 'qux', foo: 'bar' };
+  assert.deepEqual(applyPatch(document, [{ op: 'remove', path: '/baz' }]), { foo: 'bar' });
+});
+
+test('remove removes an array element', () => {
+  assert.deepEqual(applyPatch({ foo: ['a', 'b', 'c'] }, [{ op: 'remove', path: '/foo/1' }]), {
+    foo: ['a', 'c'],
+  });
+});
+
+test('replace replaces a member (A.4)', () => {
+  const document = { baz: 'qux', foo: 'bar' };
+  assert.deepEqual(applyPatch(document, [{ op: 'replace', path: '/baz', value: 'boo' }]), {
+    baz: 'boo',
+    foo: 'bar',
+  });
+});
+
+test('move moves a member to another object (A.5)', () => {
+  const document = { foo: { bar: 'baz', waldo: 'fred' }, qux: { corge: 'grault' } };
+  assert.deepEqual(applyPatch(document, [{ op: 'move', from: '/foo/waldo', path: '/qux/thud' }]), {
+    foo: { bar: 'baz' },
+    qux: { corge: 'grault', thud: 'fred' },
+  });
+});
+
+test('move moves an array element (A.6)', () => {
+  const document = { foo: ['all', 'grass', 'cows', 'eat'] };
+  assert.deepEqual(applyPatch(document, [{ op: 'move', from: '/foo/1', path: '/foo/3' }]), {
+    foo: ['all', 'cows', 'eat', 'grass'],
+  });
+});
+
+test('copy copies a value to another location (A.7)', () => {
+  const document = { foo: ['all', 'grass'] };
+  assert.deepEqual(applyPatch(document, [{ op: 'copy', from: '/foo/1', path: '/foo/-' }]), {
+    foo: ['all', 'grass', 'grass'],
+  });
+});
+
+test('test succeeds when the value is equal (A.7)', () => {
+  const document = { baz: 'qux', foo: ['a', 2, 'c'] };
+  assert.deepEqual(
+    applyPatch(document, [
+      { op: 'test', path: '/baz', value: 'qux' },
+      { op: 'test', path: '/foo/1', value: 2 },
+    ]),
+    document,
+  );
+});
+
+test('test throws when the value differs (A.8)', () => {
+  const document = { baz: 'qux' };
+  assert.throws(() => applyPatch(document, [{ op: 'test', path: '/baz', value: 'bar' }]), Error);
+});
+
+test('test compares objects by content, ignoring member order, and arrays by order', () => {
+  const document = { o: { a: 1, b: [1, 2] } };
+  applyPatch(document, [{ op: 'test', path: '/o', value: { b: [1, 2], a: 1 } }]);
+  assert.throws(
+    () => applyPatch(document, [{ op: 'test', path: '/o', value: { a: 1, b: [2, 1] } }]),
+    Error,
+  );
+  assert.throws(() => applyPatch(document, [{ op: 'test', path: '/o', value: { a: 1 } }]), Error);
+});
+
+test('test distinguishes values of different JSON types', () => {
+  assert.throws(() => applyPatch({ n: 1 }, [{ op: 'test', path: '/n', value: '1' }]), Error);
+  assert.throws(() => applyPatch({ n: null }, [{ op: 'test', path: '/n', value: false }]), Error);
+  assert.throws(() => applyPatch({ n: [] }, [{ op: 'test', path: '/n', value: {} }]), Error);
+});
+
+test('the whole document is replaced by a patch on the empty pointer', () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: 'replace', path: '', value: [2] }]), [2]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: 'add', path: '', value: 'x' }]), 'x');
+});
+
+test('operations apply in order, each to the result of the previous one', () => {
+  const document = { a: 1 };
+  const patch = [
+    { op: 'add', path: '/b', value: 2 },
+    { op: 'move', from: '/a', path: '/c' },
+    { op: 'replace', path: '/b', value: 3 },
+  ];
+  assert.deepEqual(applyPatch(document, patch), { b: 3, c: 1 });
+});
+
+test('an empty patch returns an equal document', () => {
+  const document = { a: [1, { b: 2 }] };
+  assert.deepEqual(applyPatch(document, []), document);
+});
+
+test('the input document is not mutated', () => {
+  const document = { a: { b: [1, 2] }, c: 'd' };
+  const copy = structuredClone(document);
+  applyPatch(document, [
+    { op: 'add', path: '/a/b/-', value: 3 },
+    { op: 'remove', path: '/c' },
+    { op: 'move', from: '/a/b/0', path: '/e' },
+    { op: 'copy', from: '/a', path: '/f' },
+    { op: 'replace', path: '/a/b/0', value: 'x' },
+  ]);
+  assert.deepEqual(document, copy);
+});
+
+test('the input document is not mutated when an operation fails', () => {
+  const document = { a: [1] };
+  const copy = structuredClone(document);
+  assert.throws(
+    () =>
+      applyPatch(document, [
+        { op: 'add', path: '/a/-', value: 2 },
+        { op: 'remove', path: '/missing' },
+      ]),
+    Error,
+  );
+  assert.deepEqual(document, copy);
+});
+
+test('values taken from the patch are copied, not shared with the result', () => {
+  const value = { list: [1] };
+  const result = applyPatch({}, [{ op: 'add', path: '/x', value }]) as { x: { list: number[] } };
+  result.x.list.push(2);
+  assert.deepEqual(value, { list: [1] });
+});
+
+test('a copied value is independent of its source', () => {
+  const document = { a: { list: [1] } };
+  const result = applyPatch(document, [{ op: 'copy', from: '/a', path: '/b' }]) as {
+    a: { list: number[] };
+    b: { list: number[] };
+  };
+  result.b.list.push(2);
+  assert.deepEqual(result.a, { list: [1] });
+});
+
+test('an own "__proto__" member is an ordinary key', () => {
+  const result = applyPatch({}, [{ op: 'add', path: '/__proto__', value: 'own' }]);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(Object.hasOwn(result as object, '__proto__'), true);
+});
+
+test('pointers are decoded with the RFC 6901 escapes', () => {
+  const replaced = applyPatch({ 'a/b': 1, 'm~n': 2 }, [{ op: 'replace', path: '/a~1b', value: 3 }]);
+  assert.deepEqual(replaced, { 'a/b': 3, 'm~n': 2 });
+  const tested = { '~1': 'x' };
+  assert.deepEqual(applyPatch(tested, [{ op: 'test', path: '/~01', value: 'x' }]), tested);
+});
+
+test('move onto its own location is a no-op', () => {
+  const document = { a: [1, 2] };
+  assert.deepEqual(applyPatch(document, [{ op: 'move', from: '/a/0', path: '/a/0' }]), {
+    a: [1, 2],
+  });
+});
+
+test('move cannot put a value inside its own child', () => {
+  assert.throws(
+    () => applyPatch({ a: { b: 1 } }, [{ op: 'move', from: '/a', path: '/a/b/c' }]),
+    Error,
+  );
+});
+
+test('add throws when the parent does not exist', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: '/a/b', value: 1 }]), Error);
+});
+
+test('add throws when the parent is a primitive', () => {
+  assert.throws(() => applyPatch({ a: 'x' }, [{ op: 'add', path: '/a/b', value: 1 }]), Error);
+});
+
+test('add throws for an array index outside 0..length', () => {
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: 'add', path: '/a/2', value: 0 }]), Error);
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: 'add', path: '/a/-1', value: 0 }]), Error);
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: 'add', path: '/a/01', value: 0 }]), Error);
+});
+
+test('remove throws when the target does not exist', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'remove', path: '/b' }]), Error);
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: 'remove', path: '/a/1' }]), Error);
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: 'remove', path: '/a/-' }]), Error);
+});
+
+test('remove throws on the whole document', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'remove', path: '' }]), Error);
+});
+
+test('remove does not touch inherited properties', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'remove', path: '/constructor' }]), Error);
+});
+
+test('replace throws when the target does not exist', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'replace', path: '/b', value: 2 }]), Error);
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: 'replace', path: '/a/1', value: 2 }]), Error);
+});
+
+test('test throws when the target does not exist', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'test', path: '/b', value: 1 }]), Error);
+});
+
+test('move throws when the source does not exist', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'move', from: '/b', path: '/c' }]), Error);
+});
+
+test('copy throws when the source does not exist', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'copy', from: '/b', path: '/c' }]), Error);
+});
+
+test('a failing operation makes the whole call throw', () => {
+  assert.throws(
+    () =>
+      applyPatch({ a: 1 }, [
+        { op: 'add', path: '/b', value: 2 },
+        { op: 'test', path: '/a', value: 9 },
+      ]),
+    Error,
+  );
+});
+
+test('throws when the patch is not an array', () => {
+  assert.throws(() => applyPatch({}, { op: 'add', path: '/a', value: 1 }), Error);
+  assert.throws(() => applyPatch({}, undefined), Error);
+  assert.throws(() => applyPatch({}, 'add'), Error);
+});
+
+test('throws when an operation is not an object', () => {
+  assert.throws(() => applyPatch({}, [null]), Error);
+  assert.throws(() => applyPatch({}, ['add']), Error);
+  assert.throws(() => applyPatch({}, [[]]), Error);
+});
+
+test('throws when the op is unknown or missing', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'append', path: '/a', value: 1 }]), Error);
+  assert.throws(() => applyPatch({}, [{ path: '/a', value: 1 }]), Error);
+});
+
+test('throws when the path is missing or not a string', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'remove' }]), Error);
+  assert.throws(() => applyPatch({}, [{ op: 'remove', path: 1 }]), Error);
+});
+
+test('throws when the path is not a valid JSON Pointer', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'remove', path: 'a' }]), Error);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'remove', path: '/a~2' }]), Error);
+});
+
+test('throws when add, replace or test has no value', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: '/a' }]), Error);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'replace', path: '/a' }]), Error);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'test', path: '/a' }]), Error);
+});
+
+test('throws when move or copy has no string from', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'move', path: '/b' }]), Error);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'copy', from: 1, path: '/b' }]), Error);
+});
