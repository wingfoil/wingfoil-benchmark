+
+/** Sets an own property, so that a key such as "__proto__" is an ordinary member. */
+function defineMember(container: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(container, key, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
