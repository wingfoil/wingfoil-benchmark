+     content it carries. -->
+
+# Request
+
+Review how `applyPatch` checks and applies patches and make it conform to RFC 6902, errors included.
+
+# Done
+
+- Reviewed every operation against RFC 6902 (add, remove, replace, move, copy, test; array indexes, `-`,
+  atomicity, proper-prefix rule for move). Most behaviour already conformed.
+- `move` whose `from` equals `path` is now a no-op (including the whole document) once `from` resolves.
+- `value` of add/replace/test must be a JSON value (no `undefined`, NaN, Infinity, functions); otherwise the patch is invalid.
+- Tests added in `test/patch.test.mjs`; `npm test` passes (17 tests).
diff --git a/src/index.ts b/src/index.ts
index 3a0513cfd629e384c712e64d635db4524dfc94fd..28c1cdbb504c40db08c76b65c7b532698946f33c 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -170,6 +170,13 @@ function isProperPrefix(prefix: string[], tokens: string[]): boolean {
   return prefix.length < tokens.length && prefix.every((token, i) => token === tokens[i]);
 }
 
+function isJsonValue(value: unknown): value is JsonValue {
+  if (value === null || typeof value === "string" || typeof value === "boolean") return true;
+  if (typeof value === "number") return Number.isFinite(value);
+  if (Array.isArray(value)) return value.every(isJsonValue);
+  return isContainer(value) && Object.keys(value).every((key) => isJsonValue(value[key]));
+}
+
 function requirePointer(operation: Record<string, unknown>, member: "path" | "from"): string[] {
   if (!hasOwn(operation, member)) {
     throw new Error(`Invalid patch operation: missing "${member}"`);
@@ -190,6 +197,9 @@ function applyOperation(document: unknown, operation: unknown): unknown {
   if (VALUE_OPS.has(op) && !hasOwn(operation, "value")) {
     throw new Error(`Invalid patch operation: "${op}" requires "value"`);
   }
+  if (VALUE_OPS.has(op) && !isJsonValue(operation.value)) {
+    throw new Error(`Invalid patch operation: "${op}" value is not a JSON value`);
+  }
   switch (op) {
     case "add":
       return addAt(document, path, clone(operation.value));
@@ -202,6 +212,7 @@ function applyOperation(document: unknown, operation: unknown): unknown {
         throw new Error("Cannot move a value into one of its own children");
       }
       resolveTokens(document, from);
+      if (from.length === path.length && from.every((token, i) => token === path[i])) return document;
       const [without, moved] = removeAt(document, from);
       return addAt(without, path, moved);
     }
diff --git a/test/patch.test.mjs b/test/patch.test.mjs
index f0a45e4db0b459b4f7f8cc13f8558a7693840b18..0c9eb893cf830a973a58cbbf127e839c99566514 100644
--- a/test/patch.test.mjs
