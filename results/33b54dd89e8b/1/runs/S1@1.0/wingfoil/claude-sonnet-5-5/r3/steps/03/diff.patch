@@ -117,3 +117,14 @@ test("__proto__ members are ordinary data", () => {
   const copied = apply(JSON.parse('{"__proto__":{"x":1}}'), { op: "copy", from: "/__proto__", path: "/y" });
   assert.deepEqual(copied.y, { x: 1 });
 });
+
+test("move to its own location is a no-op, even for the whole document", () => {
+  assert.deepEqual(apply({ a: 1 }, { op: "move", from: "", path: "" }), { a: 1 });
+  assert.throws(() => apply({ a: 1 }, { op: "move", from: "/x", path: "/x" }));
+});
+
+test("values must be JSON values", () => {
+  assert.throws(() => apply({}, { op: "add", path: "/a", value: undefined }));
+  assert.throws(() => apply({}, { op: "replace", path: "", value: { a: undefined } }));
+  assert.throws(() => apply({ a: 1 }, { op: "test", path: "/a", value: Number.NaN }));
+});
