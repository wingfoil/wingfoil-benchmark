+
+Implement JSON Merge Patch (RFC 7386): export `applyMergePatch(target, patch)` from `src/index.ts`.
+Object patches merge recursively, `null` members delete, non-object patches (arrays included)
+replace the target. Inputs are not mutated. Tests in `test/mergepatch.test.mjs`.
diff --git a/src/index.ts b/src/index.ts
index 28c1cdbb504c40db08c76b65c7b532698946f33c..3c496368de168a90de8faa81aee03287224b70d4 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -241,3 +241,22 @@ export function applyPatch(document: JsonValue, patch: PatchOperation[]): JsonVa
   for (const operation of patch) result = applyOperation(result, operation);
   return result as JsonValue;
 }
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return isContainer(value) && !Array.isArray(value);
+}
+
+/** Applies a JSON Merge Patch (RFC 7386) to `target` and returns the merged document; inputs are not mutated. */
+export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
+  if (!isPlainObject(patch)) return clone(patch) as JsonValue;
+  const result: Record<string, unknown> = isPlainObject(target) ? (clone(target) as Record<string, unknown>) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result as JsonValue;
+}
