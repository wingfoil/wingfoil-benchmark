-    } else {
-      throw new Error(`Pointer does not resolve: cannot descend into a primitive at "${token}"`);
+      resolveTokens(document, from);
+      const [without, moved] = removeAt(document, from);
+      return addAt(without, path, moved);
     }
+    case "copy":
+      return addAt(document, path, clone(resolveTokens(document, from)));
+    default:
+      if (!deepEqual(resolveTokens(document, path), operation.value)) {
+        throw new Error(`Test failed at "${operation.path}"`);
+      }
+      return document;
   }
