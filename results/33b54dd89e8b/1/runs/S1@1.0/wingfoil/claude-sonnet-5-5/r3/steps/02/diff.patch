+
+function applyOperation(document: unknown, operation: unknown): unknown {
+  if (!isContainer(operation) || Array.isArray(operation)) {
+    throw new Error("Invalid patch operation: not an object");
+  }
+  const op = operation.op;
+  if (typeof op !== "string" || !ALL_OPS.has(op)) {
+    throw new Error(`Invalid patch operation: unknown op ${JSON.stringify(op)}`);
+  }
