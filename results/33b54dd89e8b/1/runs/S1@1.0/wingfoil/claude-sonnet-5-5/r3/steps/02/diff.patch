+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result as a new value.
+ * Neither `document` nor `patch` is mutated, and the result shares no structure with either.
+ * The patch is atomic: nothing is returned if any operation fails.
+ *
+ * @throws Error when `patch` is invalid, or when one of its operations fails (including a failed `test`).
+ */
+export function applyPatch(document: JsonValue, patch: PatchOperation[]): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: not an array");
+  }
+  let result: unknown = clone(document);
+  for (const operation of patch) result = applyOperation(result, operation);
+  return result as JsonValue;
 }
