+++ b/test/patch.test.mjs
@@ -0,0 +1,119 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const apply = (doc, ...patch) => applyPatch(doc, patch);
+
+test("add: RFC 6902 examples", () => {
+  assert.deepEqual(apply({ foo: "bar" }, { op: "add", path: "/baz", value: "qux" }), { foo: "bar", baz: "qux" });
+  assert.deepEqual(apply({ foo: ["bar", "baz"] }, { op: "add", path: "/foo/1", value: "qux" }), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(apply({ foo: [1] }, { op: "add", path: "/foo/-", value: 2 }), { foo: [1, 2] });
+  assert.deepEqual(apply({ foo: [1] }, { op: "add", path: "/foo/1", value: 2 }), { foo: [1, 2] });
+  assert.deepEqual(apply({ a: 1 }, { op: "add", path: "/a", value: 2 }), { a: 2 });
+  assert.deepEqual(apply({ a: 1 }, { op: "add", path: "", value: [1] }), [1]);
+});
+
+test("add: errors", () => {
+  assert.throws(() => apply({}, { op: "add", path: "/a/b", value: 1 }));
+  assert.throws(() => apply({ foo: [1] }, { op: "add", path: "/foo/3", value: 1 }));
+  assert.throws(() => apply({ foo: [1] }, { op: "add", path: "/foo/01", value: 1 }));
+  assert.throws(() => apply({ foo: [1] }, { op: "add", path: "/foo/x", value: 1 }));
+  assert.throws(() => apply({ a: 1 }, { op: "add", path: "/a/b", value: 1 }));
+  assert.throws(() => apply({}, { op: "add", path: "/a" }));
+});
+
+test("remove", () => {
+  assert.deepEqual(apply({ a: 1, b: 2 }, { op: "remove", path: "/a" }), { b: 2 });
+  assert.deepEqual(apply({ foo: ["bar", "qux", "baz"] }, { op: "remove", path: "/foo/1" }), { foo: ["bar", "baz"] });
+  assert.throws(() => apply({ a: 1 }, { op: "remove", path: "/b" }));
+  assert.throws(() => apply({ a: [1] }, { op: "remove", path: "/a/-" }));
+  assert.throws(() => apply({ a: [1] }, { op: "remove", path: "/a/1" }));
+  assert.throws(() => apply({ a: 1 }, { op: "remove", path: "" }));
+});
+
+test("replace", () => {
+  assert.deepEqual(apply({ baz: "qux", foo: "bar" }, { op: "replace", path: "/baz", value: "boo" }), { baz: "boo", foo: "bar" });
+  assert.deepEqual(apply([1, 2], { op: "replace", path: "/1", value: 9 }), [1, 9]);
+  assert.deepEqual(apply({ a: 1 }, { op: "replace", path: "", value: 5 }), 5);
+  assert.throws(() => apply({ a: 1 }, { op: "replace", path: "/b", value: 1 }));
+  assert.throws(() => apply([1], { op: "replace", path: "/-", value: 1 }));
+});
+
+test("move", () => {
+  assert.deepEqual(
+    apply({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, { op: "move", from: "/foo/waldo", path: "/qux/thud" }),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(apply({ foo: ["all", "grass", "cows", "eat"] }, { op: "move", from: "/foo/1", path: "/foo/3" }), { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(apply({ a: 1 }, { op: "move", from: "/a", path: "/a" }), { a: 1 });
+  assert.throws(() => apply({ a: { b: 1 } }, { op: "move", from: "/a", path: "/a/b" }));
+  assert.throws(() => apply({ a: 1 }, { op: "move", from: "/x", path: "/y" }));
+  assert.throws(() => apply({ a: 1 }, { op: "move", path: "/y" }));
+});
+
+test("copy", () => {
+  const out = apply({ a: { b: 1 } }, { op: "copy", from: "/a", path: "/c" });
+  assert.deepEqual(out, { a: { b: 1 }, c: { b: 1 } });
+  assert.notEqual(out.a, out.c);
+  assert.throws(() => apply({ a: 1 }, { op: "copy", from: "/x", path: "/y" }));
+});
+
+test("test", () => {
+  assert.deepEqual(apply({ a: 1 }, { op: "test", path: "/a", value: 1 }), { a: 1 });
+  assert.deepEqual(apply({ a: { x: 1, y: [1, 2] } }, { op: "test", path: "/a", value: { y: [1, 2], x: 1 } }), { a: { x: 1, y: [1, 2] } });
+  assert.deepEqual(apply({ a: null }, { op: "test", path: "/a", value: null }), { a: null });
+  assert.deepEqual(apply({ a: 1 }, { op: "test", path: "", value: { a: 1 } }), { a: 1 });
+  assert.throws(() => apply({ a: 1 }, { op: "test", path: "/a", value: "1" }));
+  assert.throws(() => apply({ a: 1 }, { op: "test", path: "/a", value: 2 }));
+  assert.throws(() => apply({ a: [1, 2] }, { op: "test", path: "/a", value: [2, 1] }));
+  assert.throws(() => apply({ a: {} }, { op: "test", path: "/a", value: [] }));
+  assert.throws(() => apply({ a: { b: 1 } }, { op: "test", path: "/a", value: { b: 1, c: 2 } }));
+  assert.throws(() => apply({ a: 1 }, { op: "test", path: "/b", value: 1 }));
+  assert.throws(() => apply({ a: 1 }, { op: "test", path: "/a" }));
+});
+
+test("operations apply in order; a failure aborts", () => {
+  assert.deepEqual(apply({}, { op: "add", path: "/a", value: 1 }, { op: "copy", from: "/a", path: "/b" }), { a: 1, b: 1 });
+  const doc = { a: 1 };
+  assert.throws(() => apply(doc, { op: "add", path: "/b", value: 2 }, { op: "test", path: "/a", value: 9 }));
+  assert.deepEqual(doc, { a: 1 });
+  assert.deepEqual(applyPatch({ a: 1 }, []), { a: 1 });
+});
+
+test("invalid patches throw", () => {
+  assert.throws(() => applyPatch({}, {}));
+  assert.throws(() => applyPatch({}, null));
+  assert.throws(() => applyPatch({}, [null]));
+  assert.throws(() => applyPatch({}, [[]]));
+  assert.throws(() => apply({}, { path: "/a", value: 1 }));
+  assert.throws(() => apply({}, { op: "bogus", path: "/a" }));
+  assert.throws(() => apply({}, { op: "add", value: 1 }));
+  assert.throws(() => apply({}, { op: "add", path: 1, value: 1 }));
+  assert.throws(() => apply({}, { op: "add", path: "a", value: 1 }));
+  assert.throws(() => apply({}, { op: "add", path: "/~2", value: 1 }));
+  assert.throws(() => apply({}, { op: "copy", from: 1, path: "/a" }));
+});
+
+test("does not mutate or alias input and patch", () => {
+  const doc = { a: { b: [1] } };
+  const value = { n: [1] };
+  const out = apply(doc, { op: "add", path: "/a/b/-", value: 2 }, { op: "add", path: "/v", value });
+  assert.deepEqual(doc, { a: { b: [1] } });
+  assert.notEqual(out.a, doc.a);
+  assert.notEqual(out.v, value);
+  out.v.n.push(2);
+  assert.deepEqual(value, { n: [1] });
+  const same = applyPatch(doc, []);
+  assert.notEqual(same, doc);
+});
+
+test("__proto__ members are ordinary data", () => {
+  const out = apply({}, { op: "add", path: "/__proto__", value: { polluted: true } });
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal({}.polluted, undefined);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+  assert.throws(() => apply({}, { op: "remove", path: "/__proto__" }));
+  assert.throws(() => apply({}, { op: "replace", path: "/constructor", value: 1 }));
+  const copied = apply(JSON.parse('{"__proto__":{"x":1}}'), { op: "copy", from: "/__proto__", path: "/y" });
+  assert.deepEqual(copied.y, { x: 1 });
+});
