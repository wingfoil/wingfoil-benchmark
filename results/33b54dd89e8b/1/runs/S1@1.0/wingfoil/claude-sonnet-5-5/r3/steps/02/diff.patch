+/** Resolves the container holding the target of a non-empty token list, and the target's final token. */
+function parentOf(document: unknown, tokens: string[]): [Record<string, unknown> | unknown[], string] {
+  const parent = resolveTokens(document, tokens.slice(0, -1));
+  if (!isContainer(parent)) {
+    throw new Error("Patch target has no container parent");
