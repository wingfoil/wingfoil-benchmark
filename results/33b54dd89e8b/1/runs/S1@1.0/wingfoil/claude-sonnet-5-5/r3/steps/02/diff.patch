+  if (VALUE_OPS.has(op) && !hasOwn(operation, "value")) {
+    throw new Error(`Invalid patch operation: "${op}" requires "value"`);
+  }
+  switch (op) {
+    case "add":
+      return addAt(document, path, clone(operation.value));
+    case "remove":
+      return removeAt(document, path)[0];
+    case "replace":
+      return replaceAt(document, path, clone(operation.value));
+    case "move": {
+      if (isProperPrefix(from, path)) {
+        throw new Error("Cannot move a value into one of its own children");
       }
