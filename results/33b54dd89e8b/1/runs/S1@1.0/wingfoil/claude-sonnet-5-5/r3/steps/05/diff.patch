+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from, to) {
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small change yields a small patch", () => {
+  const from = { a: { b: 1, c: [1, 2, 3] }, d: "x" };
+  const to = { a: { b: 1, c: [1, 9, 3] }, d: "x" };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/c/1", value: 9 }]);
+});
+
+test("object members added and removed", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, c: 3 }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("array insert, append and removal", () => {
+  assert.deepEqual(roundTrip([1, 2, 3], [0, 1, 2, 3]), [{ op: "add", path: "/0", value: 0 }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 2, 3, 4]), [{ op: "add", path: "/3", value: 4 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 4]), [
+    { op: "remove", path: "/2" },
+    { op: "remove", path: "/1" },
+  ]);
+});
+
+test("type changes, root replacement and null", () => {
+  roundTrip({ a: [1] }, { a: { 0: 1 } });
+  roundTrip({ a: null }, { a: 1 });
+  assert.deepEqual(roundTrip(1, "x"), [{ op: "replace", path: "", value: "x" }]);
+  roundTrip([], {});
+});
+
+test("keys needing escaping, including __proto__", () => {
+  roundTrip({ "a/b": 1, "m~n": 2, "": 3 }, { "a/b": 2, "m~n": 3, "": 4 });
+  const to = JSON.parse('{"__proto__": {"x": 1}}');
+  const patch = roundTrip({}, to);
+  assert.equal(patch[0].path, "/__proto__");
+});
+
+test("patch shares no structure with inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  patch[0].value.b = 2;
+  assert.equal(to.a.b, 1);
+});
+
+test("randomized round trips", () => {
+  let seed = 7;
+  const rnd = (n) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff), seed % n);
+  const gen = (depth) => {
+    const k = rnd(depth > 2 ? 4 : 6);
+    if (k === 0) return rnd(3);
+    if (k === 1) return "s" + rnd(3);
+    if (k === 2) return null;
+    if (k === 3) return rnd(2) === 0;
+    if (k === 4) return Array.from({ length: rnd(5) }, () => gen(depth + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(depth + 1)]));
+  };
+  for (let i = 0; i < 2000; i++) roundTrip(gen(0), gen(0));
+});
