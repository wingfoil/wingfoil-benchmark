@@ -260,3 +260,54 @@ export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
   }
   return result as JsonValue;
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffInto(operations: PatchOperation[], path: string, from: unknown, to: unknown): void {
+  if (deepEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    let start = 0;
+    while (start < from.length && start < to.length && deepEqual(from[start], to[start])) start++;
+    let fromEnd = from.length;
+    let toEnd = to.length;
+    while (fromEnd > start && toEnd > start && deepEqual(from[fromEnd - 1], to[toEnd - 1])) {
+      fromEnd--;
+      toEnd--;
+    }
+    const shared = Math.min(fromEnd, toEnd) - start;
+    for (let i = 0; i < shared; i++) diffInto(operations, `${path}/${start + i}`, from[start + i], to[start + i]);
+    // Remove surplus items from the highest index down so earlier indices stay valid.
+    for (let i = fromEnd - 1; i >= start + shared; i--) operations.push({ op: "remove", path: `${path}/${i}` });
+    for (let i = start + shared; i < toEnd; i++) {
+      operations.push({ op: "add", path: `${path}/${i}`, value: clone(to[i]) as JsonValue });
+    }
+    return;
+  }
+  if (isPlainObject(from) && isPlainObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!hasOwn(to, key)) operations.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const member = `${path}/${escapeToken(key)}`;
+      if (hasOwn(from, key)) {
+        diffInto(operations, member, from[key], to[key]);
+      } else {
+        operations.push({ op: "add", path: member, value: clone(to[key]) as JsonValue });
+      }
+    }
+    return;
+  }
+  operations.push({ op: "replace", path, value: clone(to) as JsonValue });
+}
+
+/**
+ * Computes a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ * Only the parts that differ are described; neither input is mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  const operations: PatchOperation[] = [];
+  diffInto(operations, "", from, to);
+  return operations;
+}
