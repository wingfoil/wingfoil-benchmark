@@ -112,3 +112,22 @@ test("replace keeps member order", () => {
   const out = applyPatch({ a: 1, b: 2 }, [{ op: "replace", path: "/a", value: 5 }]);
   assert.deepEqual(Object.keys(out as object), ["a", "b"]);
 });
+
+import { applyMergePatch } from "./index.js";
+
+test("RFC 7386 merge patch", () => {
+  const target = { a: "b", c: { d: "e", f: "g" } };
+  assert.deepEqual(applyMergePatch(target, { a: "z", c: { f: null } }), { a: "z", c: { d: "e" } });
+  assert.deepEqual(target, { a: "b", c: { d: "e", f: "g" } });
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: ["c"] }), { a: ["c"] });
+  assert.deepEqual(applyMergePatch(["a", "b"], ["c", "d"]), ["c", "d"]);
+  assert.deepEqual(applyMergePatch({ a: "b" }, ["c"]), ["c"]);
+  assert.equal(applyMergePatch({ a: "foo" }, null), null);
+  assert.equal(applyMergePatch({ a: "foo" }, "bar"), "bar");
+  assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+  assert.deepEqual(applyMergePatch([1, 2], { a: "b", c: null }), { a: "b" });
+  assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+  assert.deepEqual(applyMergePatch(5, { a: 1 }), { a: 1 });
+  assert.deepEqual(applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')), JSON.parse('{"__proto__":{"x":1}}'));
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+});
