+     content it carries. -->
+
+Export `createPatch(from, to)` from `src/index.ts`: it returns a JSON Patch (RFC 6902) that turns `from`
+into `to` when applied with `applyPatch`. It describes only what changed (member and element level
+`add`, `remove` and `replace` operations, never the whole document when a small part differs), escapes
+pointer tokens per RFC 6901, does not mutate its inputs, shares no structure with them, and rejects
+non-JSON values as `applyPatch` does. Tests check that applying the patch yields `to`, that patches are
+minimal for small changes, and the error path.
diff --git a/src/index.test.ts b/src/index.test.ts
index 832a8e78d0a63071c4aead74b8d472970913cc82..444100755eaf185d3b8c1bd00a7084d04f805d3f 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -131,3 +131,59 @@ test("RFC 7386 merge patch", () => {
   assert.deepEqual(applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')), JSON.parse('{"__proto__":{"x":1}}'));
   assert.equal(({} as Record<string, unknown>).x, undefined);
 });
+
+import { createPatch } from "./index.js";
+
+function roundTrip(from: unknown, to: unknown) {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("createPatch yields nothing for equal documents", () => {
+  assert.deepEqual(createPatch({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("createPatch describes only the change", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: { c: 2, d: 3 } }, { a: 1, b: { c: 2, d: 4 } }), [
+    { op: "replace", path: "/b/d", value: 4 },
+  ]);
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+  assert.deepEqual(roundTrip({ l: [1, 2, 3, 4] }, { l: [1, 2, 9, 3, 4] }), [{ op: "add", path: "/l/2", value: 9 }]);
+  assert.deepEqual(roundTrip({ l: [1, 2, 3, 4] }, { l: [1, 4] }), [
+    { op: "remove", path: "/l/1" },
+    { op: "remove", path: "/l/1" },
+  ]);
+  assert.deepEqual(roundTrip({ l: [1, { a: 1 }] }, { l: [1, { a: 2 }] }), [{ op: "replace", path: "/l/1/a", value: 2 }]);
+});
+
+test("createPatch handles roots, type changes and escaping", () => {
+  assert.deepEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip({ a: null }, { a: {} }), [{ op: "replace", path: "/a", value: {} }]);
+  assert.deepEqual(roundTrip({ "a/b": 1, "m~n": 1, "": 1 }, { "a/b": 2, "m~n": 2, "": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/m~0n", value: 2 },
+    { op: "replace", path: "/", value: 2 },
+  ]);
+  const proto = JSON.parse('{"__proto__":{"x":1}}');
+  roundTrip({}, proto);
+  roundTrip(proto, {});
+});
+
+test("createPatch does not mutate or alias its inputs", () => {
+  const from = { a: [1, 2], b: { c: 1 } };
+  const to = { a: [1, 2, { z: 1 }], b: 5, n: { k: [1] } };
+  const before = JSON.stringify([from, to]);
+  const patch = createPatch(from, to) as { value?: unknown }[];
+  assert.equal(JSON.stringify([from, to]), before);
+  assert.equal(patch.some((op) => op.value === to.n || op.value === to.a[2]), false);
+});
+
+test("createPatch rejects values that are not JSON", () => {
+  assert.throws(() => createPatch({ a: NaN }, {}));
+  assert.throws(() => createPatch({}, { a: new Date(0) }));
+});
diff --git a/src/index.ts b/src/index.ts
index 69f36cbc00e5d62c89e0717b4aea3d180308b787..11e5106ffc28f95383d931aeba33e4c2f0cdbf6b 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -217,3 +217,52 @@ function mergePatch(target: Json, patch: unknown): Json {
 export function applyMergePatch(target: unknown, patch: unknown): Json {
   return mergePatch(clone(target), patch);
 }
+
+const escapeToken = (token: string): string => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+/** One operation of a JSON Patch produced by `createPatch`. */
+export type PatchOperation = { op: "add" | "replace"; path: string; value: Json } | { op: "remove"; path: string };
+
+function diffArrays(from: Json[], to: Json[], path: string, out: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && equal(from[start], to[start])) start++;
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && equal(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+  const common = Math.min(fromEnd, toEnd) - start;
+  for (let i = 0; i < common; i++) diff(from[start + i], to[start + i], `${path}/${start + i}`, out);
+  for (let i = start + common; i < fromEnd; i++) out.push({ op: "remove", path: `${path}/${start + common}` });
+  for (let i = start + common; i < toEnd; i++) out.push({ op: "add", path: `${path}/${i}`, value: to[i] });
+}
+
+function diff(from: Json, to: Json, path: string, out: PatchOperation[]): void {
+  if (equal(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) return diffArrays(from, to, path, out);
+  if (isObject(from) && isObject(to)) {
+    const source = from as { [key: string]: Json };
+    const target = to as { [key: string]: Json };
+    for (const key of Object.keys(source)) {
+      if (!hasOwn(target, key)) out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(target)) {
+      const member = `${path}/${escapeToken(key)}`;
+      if (hasOwn(source, key)) diff(source[key], target[key], member, out);
+      else out.push({ op: "add", path: member, value: target[key] });
+    }
+    return;
+  }
+  out.push({ op: "replace", path, value: to });
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied; inputs are not mutated.
+ * Only the differing members and elements are described, so a small change gives a small patch.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diff(clone(from), clone(to), "", out);
+  return out;
+}
