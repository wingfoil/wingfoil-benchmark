+---
+id: task-001-json-pointer-resolvepointer-rfc-6901
+type: task
+title: "JSON Pointer resolvePointer (RFC 6901)"
+status: approved
+format: 1
+---
+
+<!-- task body. `wingfoil memory add` copies this scaffold, setting only `id`, `title` and
+     `status` (and any `--tags` or `--set` value). Fill the required frontmatter fields and replace
+     these placeholder comments yourself; `wingfoil memory submit` then checks the required fields,
+     moves `status` forward and commits the document as you left it, naming in the commit body the
+     content it carries. -->
+
+# Request
+
+Implement JSON Pointer (RFC 6901). Export `resolvePointer(document, pointer)` from `src/index.ts`:
+returns the value the pointer refers to; throws if the pointer is not a valid JSON Pointer or does not
+resolve to a value of the document. Later features build on it.
+
+# Acceptance
+
+- "" refers to the whole document; otherwise the pointer must start with "/".
+- `~0` -> `~`, `~1` -> `/` (in that order); any other `~` escape is invalid.
+- Arrays: index is `0` or digits without leading zeros; `-` and out-of-range throw.
+- Objects: only own properties (no prototype lookup, e.g. `__proto__`).
+- Non-container values cannot be traversed: throws.
diff --git a/src/index.test.ts b/src/index.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8e78481f45292db558e6014b92a0fc7e7d9f1430
--- /dev/null
+++ b/src/index.test.ts
@@ -0,0 +1,53 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "./index.js";
+
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+  nul: null,
+};
+
+test("RFC 6901 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+  assert.equal(resolvePointer(doc, "/nul"), null);
+});
+
+test("~01 decodes to ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["foo", "/a~", "/a~2", "/~"]) assert.throws(() => resolvePointer({}, p));
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer(doc, "/missing"));
+  assert.throws(() => resolvePointer(doc, "/foo/2"));
+  assert.throws(() => resolvePointer(doc, "/foo/-"));
+  assert.throws(() => resolvePointer(doc, "/foo/01"));
+  assert.throws(() => resolvePointer(doc, "/foo/a"));
+  assert.throws(() => resolvePointer(doc, "/foo/0/x"));
+  assert.throws(() => resolvePointer(doc, "/nul/x"));
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer({}, "/toString"));
+});
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b77dade8a1985672584f2dbccdb5ac223f545fc5
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,41 @@
+export type Json = null | boolean | number | string | Json[] | { [key: string]: Json };
+
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/** Resolves a JSON Pointer (RFC 6901) against a document; throws if invalid or unresolvable. */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return document;
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  let current: unknown = document;
+  for (const raw of pointer.slice(1).split("/")) {
+    const token = unescapeToken(raw);
+    if (Array.isArray(current)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`Pointer does not resolve: "${token}" is not an array index`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new Error(`Pointer does not resolve: index ${token} out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(`Pointer does not resolve: no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`Pointer does not resolve: cannot traverse into a scalar at "${token}"`);
+    }
+  }
+  return current;
+}
