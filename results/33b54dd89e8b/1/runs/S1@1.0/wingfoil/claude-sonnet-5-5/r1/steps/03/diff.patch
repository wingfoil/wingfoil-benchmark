--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -100,3 +100,15 @@ test("applyPatch does not mutate input and does not alias", () => {
   assert.equal(Object.getPrototypeOf(p), Object.prototype);
   assert.equal(Object.keys(p)[0], "__proto__");
 });
+
+test("applyPatch rejects values that are not JSON", () => {
+  for (const value of [NaN, Infinity, new Date(0), new Map(), undefined]) {
+    assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value }]));
+  }
+  assert.throws(() => applyPatch({ a: NaN }, []));
+});
+
+test("replace keeps member order", () => {
+  const out = applyPatch({ a: 1, b: 2 }, [{ op: "replace", path: "/a", value: 5 }]);
+  assert.deepEqual(Object.keys(out as object), ["a", "b"]);
+});
