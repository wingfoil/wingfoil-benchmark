@@ -51,3 +51,52 @@ test("unresolvable pointers throw", () => {
   assert.throws(() => resolvePointer({}, "/__proto__"));
   assert.throws(() => resolvePointer({}, "/toString"));
 });
+
+import { applyPatch } from "./index.js";
+
+test("RFC 6902 operations", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(applyPatch({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(applyPatch([1, 2, 3], [{ op: "remove", path: "/1" }]), [1, 3]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch([1, 2], [{ op: "replace", path: "/1", value: 9 }]), [1, 9]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch({ a: { b: 1 }, c: 2 }, [{ op: "move", from: "/a/b", path: "/d" }]), { a: {}, c: 2, d: 1 });
+  assert.deepEqual(applyPatch([1, 2, 3], [{ op: "move", from: "/0", path: "/2" }]), [2, 3, 1]);
+  assert.deepEqual(applyPatch({ a: [1] }, [{ op: "copy", from: "/a", path: "/b" }]), { a: [1], b: [1] });
+  assert.deepEqual(applyPatch({ a: { b: [1, 2] } }, [{ op: "test", path: "/a", value: { b: [1, 2] } }]), { a: { b: [1, 2] } });
+});
+
+test("applyPatch errors", () => {
+  const bad: unknown[][] = [
+    [{ op: "test", path: "/a", value: 2 }],
+    [{ op: "remove", path: "/x" }],
+    [{ op: "replace", path: "/x", value: 1 }],
+    [{ op: "add", path: "/x/y", value: 1 }],
+    [{ op: "add", path: "/a", value: 1, extra: 1 }, { op: "add", path: "/a" }],
+    [{ op: "bogus", path: "/a" }],
+    [{ op: "move", from: "/a", path: "/a/b" }],
+    [{ op: "copy", path: "/b" }],
+    [{ op: "add", path: "a", value: 1 }],
+    ["x"],
+  ];
+  for (const p of bad) assert.throws(() => applyPatch({ a: 1 }, p));
+  assert.throws(() => applyPatch({ a: 1 }, { op: "add" }));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/3", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/01", value: 1 }]));
+});
+
+test("applyPatch does not mutate input and does not alias", () => {
+  const doc = { a: { b: [1] } };
+  const patch = [{ op: "add", path: "/c", value: { z: 1 } }, { op: "copy", from: "/a", path: "/d" }];
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, { a: { b: [1] } });
+  assert.deepEqual(patch[0].value, { z: 1 });
+  out.a.b.push(2);
+  assert.deepEqual(out.d.b, [1]);
+  const p = applyPatch({}, [{ op: "add", path: "/__proto__", value: 1 }]) as any;
+  assert.equal(Object.getPrototypeOf(p), Object.prototype);
+  assert.equal(Object.keys(p)[0], "__proto__");
+});
