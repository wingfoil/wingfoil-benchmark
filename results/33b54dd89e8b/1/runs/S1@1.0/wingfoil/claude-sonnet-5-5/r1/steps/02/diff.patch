index b77dade8a1985672584f2dbccdb5ac223f545fc5..b5b9ca33ac0efab515fcdab66c4e5440487ccfbc 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -39,3 +39,146 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+const hasOwn = (o: object, k: string): boolean => Object.prototype.hasOwnProperty.call(o, k);
+
+function setMember(obj: { [key: string]: Json }, key: string, value: Json): void {
+  // defineProperty keeps a "__proto__" member an ordinary own property.
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone(value: unknown): Json {
+  if (Array.isArray(value)) return value.map(clone);
+  if (typeof value === "object" && value !== null) {
+    const out: { [key: string]: Json } = {};
+    for (const key of Object.keys(value)) setMember(out, key, clone((value as Record<string, unknown>)[key]));
+    return out;
+  }
+  if (value === undefined || typeof value === "function" || typeof value === "symbol" || typeof value === "bigint") {
+    throw new Error("Not a JSON value");
+  }
+  return value as Json;
+}
+
+function equal(a: Json, b: Json): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => equal(v, b[i]));
+  }
+  if (typeof a === "object" && a !== null) {
+    if (typeof b !== "object" || b === null) return false;
+    const ka = Object.keys(a);
+    return ka.length === Object.keys(b).length && ka.every((k) => hasOwn(b, k) && equal(a[k], b[k]));
+  }
+  return a === b;
+}
+
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") throw new Error("Invalid JSON Pointer: not a string");
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (allowEnd && token === "-") return length;
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) throw new Error(`"${token}" is not a valid array index`);
+  const index = Number(token);
+  if (index > length || (index === length && !allowEnd)) throw new Error(`Array index ${token} out of range`);
+  return index;
+}
+
+function parentOf(root: Json, tokens: string[]): Json {
+  let current: Json = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      current = current[arrayIndex(token, current.length, false)];
+    } else if (typeof current === "object" && current !== null && hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path does not resolve at "${token}"`);
+    }
+  }
+  return current;
+}
+
+function getAt(root: Json, tokens: string[]): Json {
+  const parent = parentOf(root, tokens);
+  if (tokens.length === 0) return root;
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) return parent[arrayIndex(last, parent.length, false)];
+  if (typeof parent === "object" && parent !== null && hasOwn(parent, last)) return parent[last];
+  throw new Error(`Path does not resolve at "${last}"`);
+}
+
+function addAt(root: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(arrayIndex(last, parent.length, true), 0, value);
+  else if (typeof parent === "object" && parent !== null) setMember(parent, last, value);
+  else throw new Error("Cannot add into a scalar");
+  return root;
+}
+
+function removeAt(root: Json, tokens: string[]): Json {
+  if (tokens.length === 0) throw new Error("Cannot remove the document root");
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(arrayIndex(last, parent.length, false), 1);
+  else if (typeof parent === "object" && parent !== null && hasOwn(parent, last)) delete parent[last];
+  else throw new Error(`Path does not resolve at "${last}"`);
+  return root;
+}
+
+/** Applies a JSON Patch (RFC 6902) to a document and returns a new document; the input is not mutated. */
+export function applyPatch(document: unknown, patch: unknown): Json {
+  if (!Array.isArray(patch)) throw new Error("Invalid JSON Patch: not an array");
+  let result = clone(document);
+  patch.forEach((operation: unknown, i) => {
+    const fail = (msg: string): never => {
+      throw new Error(`Patch operation ${i}: ${msg}`);
+    };
+    if (typeof operation !== "object" || operation === null || Array.isArray(operation)) fail("not an object");
+    const o = operation as Record<string, unknown>;
+    const op = hasOwn(o, "op") ? o.op : undefined;
+    if (typeof op !== "string" || !["add", "remove", "replace", "move", "copy", "test"].includes(op)) {
+      fail(`unknown or missing "op"`);
+    }
+    const path = parsePointer(hasOwn(o, "path") ? o.path : undefined);
+    const needsValue = op === "add" || op === "replace" || op === "test";
+    if (needsValue && !hasOwn(o, "value")) fail('missing "value"');
+    try {
+      switch (op) {
+        case "add":
+          result = addAt(result, path, clone(o.value));
+          break;
+        case "remove":
+          result = removeAt(result, path);
+          break;
+        case "replace":
+          getAt(result, path);
+          result = path.length === 0 ? clone(o.value) : addAt(removeAt(result, path), path, clone(o.value));
+          break;
+        case "move":
+        case "copy": {
+          const from = parsePointer(hasOwn(o, "from") ? o.from : undefined);
+          const value = clone(getAt(result, from));
+          if (op === "move") {
+            const proper = from.length < path.length && from.every((t, k) => t === path[k]);
+            if (proper) throw new Error('"from" is a proper prefix of "path"');
+            if (from.length === path.length && proper === false && from.every((t, k) => t === path[k])) break;
+            result = removeAt(result, from);
+          }
+          result = addAt(result, path, value);
+          break;
+        }
+        case "test":
+          if (!equal(getAt(result, path), clone(o.value))) throw new Error("test failed: values differ");
+          break;
+      }
+    } catch (e) {
+      fail((e as Error).message);
+    }
+  });
+  return result;
+}
