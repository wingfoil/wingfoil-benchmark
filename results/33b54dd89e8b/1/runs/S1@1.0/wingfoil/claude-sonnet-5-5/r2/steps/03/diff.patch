+
+# Task
+
+Review how `applyPatch` checks and applies patches and make it conform to RFC 6902, errors included.
+Found: `replace` removed then re-added the member, moving it to the end of the object; it now
+replaces the value in place. Test added in `test/patch.test.ts`.
diff --git a/src/patch.ts b/src/patch.ts
index d4fbcef1cbf3ad00145e32d7301367e5d39516e0..f165279772ed06a117382b0e754ee6a39296f5a9 100644
--- a/src/patch.ts
+++ b/src/patch.ts
@@ -106,6 +106,17 @@ function remove(root: unknown, path: string): { root: unknown; removed: unknown
   return { root, removed };
 }
 
+function replace(root: unknown, path: string, value: unknown): unknown {
+  const tokens = parsePointer(path);
+  get(root, path);
+  if (tokens.length === 0) return value;
+  const parent = walk(root, tokens.slice(0, -1), path);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(last)] = value;
+  else setMember(parent as Record<string, unknown>, last, value);
+  return root;
+}
+
 function requireValue(op: Record<string, unknown>, name: string): unknown {
   if (!has(op, "value")) throw new JsonPatchError(`"${name}" operation requires a "value"`);
   return op.value;
@@ -142,9 +153,7 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
         result = remove(result, path).root;
         break;
       case "replace": {
-        const value = clone(requireValue(o, name));
-        get(result, path);
-        result = parsePointer(path).length === 0 ? value : add(remove(result, path).root, path, value);
+        result = replace(result, path, clone(requireValue(o, name)));
         break;
       }
       case "move":
