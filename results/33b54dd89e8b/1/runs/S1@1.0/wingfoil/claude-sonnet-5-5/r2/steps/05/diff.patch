+/**
+ * JSON Patch generation (RFC 6902).
+ */
+import { equal } from "./patch.ts";
+
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: unknown };
+
+function has(obj: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(obj, key);
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+// The patch must not share structure with the inputs, so values are copied.
+function copy<T>(value: T): T {
+  if (Array.isArray(value)) return value.map(copy) as T;
+  if (isObject(value)) {
+    const out: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) {
+      Object.defineProperty(out, key, {
+        value: copy(value[key]),
+        writable: true,
+        enumerable: true,
+        configurable: true,
+      });
+    }
+    return out as T;
+  }
+  return value;
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: Operation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && equal(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && equal(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const common = Math.min(endFrom, endTo) - start;
+  for (let i = 0; i < common; i++) diff(from[start + i], to[start + i], `${path}/${start + i}`, ops);
+  // Removals go from the end so that earlier indices stay valid.
+  for (let i = endFrom - 1; i >= start + common; i--) ops.push({ op: "remove", path: `${path}/${i}` });
+  for (let i = start + common; i < endTo; i++) {
+    ops.push({ op: "add", path: `${path}/${i}`, value: copy(to[i]) });
+  }
+}
+
+function diff(from: unknown, to: unknown, path: string, ops: Operation[]): void {
+  if (equal(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (has(from, key)) diff(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: copy(to[key]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: copy(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only
+ * what differs: unchanged parts of objects and arrays are left out. Neither argument is mutated,
+ * and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  const ops: Operation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
