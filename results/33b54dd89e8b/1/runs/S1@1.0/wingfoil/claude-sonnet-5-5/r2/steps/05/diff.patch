@@ -0,0 +1,80 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown): unknown[] {
+  const a = structuredClone(from);
+  const b = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, a);
+  assert.deepEqual(to, b);
+  return patch;
+}
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a small change gives a small patch", () => {
+  const from = { a: { b: 1, c: [1, 2, 3] }, big: { x: 1 } };
+  const to = { a: { b: 2, c: [1, 2, 3] }, big: { x: 1 } };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b", value: 2 }]);
+});
+
+test("object members added and removed", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, c: 3 }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("array insert, delete and append touch only the difference", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 4]), [
+    { op: "remove", path: "/2" },
+    { op: "remove", path: "/1" },
+  ]);
+  assert.deepEqual(roundTrip([1], [1, 2, 3]), [
+    { op: "add", path: "/1", value: 2 },
+    { op: "add", path: "/2", value: 3 },
+  ]);
+});
+
+test("root and type changes, null, and escaped keys", () => {
+  assert.deepEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  roundTrip({ a: 1 }, [1]);
+  roundTrip({ a: null }, { a: { b: [] } });
+  roundTrip(null, { a: 1 });
+  assert.deepEqual(roundTrip({ "a/b": 1, "~": 1 }, { "a/b": 2, "~": 1 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+  ]);
+});
+
+test("__proto__ keys stay plain data", () => {
+  const to = JSON.parse('{"__proto__":{"x":1},"y":[{"__proto__":2}]}');
+  roundTrip({}, to);
+  roundTrip(to, { y: [] });
+});
+
+test("the patch shares nothing with the inputs", () => {
+  const to = { a: { b: [1] } };
+  const patch = createPatch({}, to) as { value: { b: number[] } }[];
+  patch[0].value.b.push(2);
+  assert.deepEqual(to, { a: { b: [1] } });
+});
+
+test("randomised round trip", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) % n);
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 4 : 6);
+    if (k === 0) return rnd(3);
+    if (k === 1) return null;
+    if (k === 2) return "s" + rnd(2);
+    if (k === 3) return rnd(2) === 0;
+    if (k === 4) return Array.from({ length: rnd(5) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let i = 0; i < 500; i++) roundTrip(gen(0), gen(0));
+});
