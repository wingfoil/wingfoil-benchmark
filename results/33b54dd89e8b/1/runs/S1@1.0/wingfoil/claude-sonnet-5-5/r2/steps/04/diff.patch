+/**
+ * JSON Merge Patch (RFC 7386).
+ */
+
+function has(obj: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(obj, key);
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+// Defines the member directly so that a "__proto__" key stays plain data.
+function setMember(obj: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+// Copies a patch value, dropping the null members, which a merge never stores.
+function strip(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map((v) => v);
+  if (isObject(value)) return merge({}, value);
+  return value;
+}
+
+function merge(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return strip(patch);
+  const out: Record<string, unknown> = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) setMember(out, key, target[key]);
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete out[key];
+    } else {
+      setMember(out, key, merge(has(out, key) ? out[key] : undefined, value));
+    }
+  }
+  return out;
+}
+
+/** Applies a JSON Merge Patch to a target document and returns the merged document. */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return merge(target, patch);
+}
