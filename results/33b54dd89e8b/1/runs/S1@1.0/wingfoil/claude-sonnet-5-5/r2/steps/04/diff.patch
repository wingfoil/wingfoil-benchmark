+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, want] of cases) assert.deepEqual(applyMergePatch(t, p), want);
+});
+
+test("does not mutate inputs and strips nulls from new objects", () => {
+  const t = { a: { b: 1 } };
+  const p = { a: { c: 2 }, d: { e: null, f: 1 } };
+  assert.deepEqual(applyMergePatch(t, p), { a: { b: 1, c: 2 }, d: { f: 1 } });
+  assert.deepEqual(t, { a: { b: 1 } });
+  assert.deepEqual(p, { a: { c: 2 }, d: { e: null, f: 1 } });
+});
+
+test("__proto__ stays plain data", () => {
+  const out = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as object;
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+});
