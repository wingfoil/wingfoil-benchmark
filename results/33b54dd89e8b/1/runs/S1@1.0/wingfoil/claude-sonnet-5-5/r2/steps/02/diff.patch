+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, want: unknown) =>
+  assert.deepEqual(applyPatch(doc, patch), want);
+const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch));
+
+test("add", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }], { foo: [1, 2] });
+  ok({ foo: [1] }, [{ op: "add", path: "/foo/1", value: 2 }], { foo: [1, 2] });
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "add", path: "/a", value: 2 }], { a: 2 });
+  bad({ foo: [1] }, [{ op: "add", path: "/foo/3", value: 2 }]);
+  bad({ foo: [1] }, [{ op: "add", path: "/foo/01", value: 2 }]);
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+});
+
+test("remove", () => {
+  ok({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }], { b: 2 });
+  ok({ a: [1, 2, 3] }, [{ op: "remove", path: "/a/1" }], { a: [1, 3] });
+  bad({ a: 1 }, [{ op: "remove", path: "/b" }]);
+  bad({ a: [1] }, [{ op: "remove", path: "/a/1" }]);
+});
+
+test("replace", () => {
+  ok({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }], { a: 2 });
+  ok({ a: [1, 2] }, [{ op: "replace", path: "/a/0", value: 9 }], { a: [9, 2] });
+  ok({ a: 1 }, [{ op: "replace", path: "", value: 5 }], 5);
+  bad({ a: 1 }, [{ op: "replace", path: "/b", value: 2 }]);
+});
+
+test("move", () => {
+  ok({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }],
+    { foo: ["all", "cows", "eat", "grass"] });
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  bad({ a: 1 }, [{ op: "move", from: "/x", path: "/y" }]);
+});
+
+test("copy", () => {
+  const doc = { a: { x: 1 } };
+  const out = applyPatch(doc, [{ op: "copy", from: "/a", path: "/b" }]) as any;
+  assert.deepEqual(out, { a: { x: 1 }, b: { x: 1 } });
+  assert.notEqual(out.a, out.b);
+  bad(doc, [{ op: "copy", from: "/z", path: "/b" }]);
+});
+
+test("test", () => {
+  ok({ a: { x: 1, y: [1] } }, [{ op: "test", path: "/a", value: { y: [1], x: 1 } }], { a: { x: 1, y: [1] } });
+  ok({ a: null }, [{ op: "test", path: "/a", value: null }], { a: null });
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+  bad({ a: [1] }, [{ op: "test", path: "/a", value: { 0: 1 } }]);
+  bad({ a: 1 }, [{ op: "test", path: "/b", value: 1 }]);
+});
+
+test("invalid patches", () => {
+  bad({}, {});
+  bad({}, [1]);
+  bad({}, [{ path: "/a" }]);
+  bad({}, [{ op: "bogus", path: "/a" }]);
+  bad({}, [{ op: "add", value: 1 }]);
+  bad({}, [{ op: "move", path: "/a" }]);
+  bad({}, [{ op: "add", path: "a", value: 1 }]);
+});
+
+test("does not mutate input, and is atomic", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const value = { v: 1 };
+  const copy = structuredClone(doc);
+  const out = applyPatch(doc, [
+    { op: "add", path: "/a/-", value },
+    { op: "remove", path: "/b/c" },
+  ]) as any;
+  assert.deepEqual(doc, copy);
+  value.v = 2;
+  assert.deepEqual(out.a[2], { v: 1 });
+  bad(doc, [{ op: "remove", path: "/a/0" }, { op: "test", path: "/a/0", value: 99 }]);
+  assert.deepEqual(doc, copy);
+});
+
+test("__proto__ stays plain data", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { p: 1 } }]) as any;
+  assert.equal(({} as any).p, undefined);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+});
