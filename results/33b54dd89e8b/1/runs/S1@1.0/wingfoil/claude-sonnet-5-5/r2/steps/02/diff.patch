+/**
+ * JSON Patch (RFC 6902).
+ */
+import { parsePointer } from "./pointer.ts";
+
+/** Error thrown for an invalid patch or an operation that fails. */
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+const INDEX = /^(0|[1-9][0-9]*)$/;
+
+function has(obj: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(obj, key);
+}
+
+function isContainer(value: unknown): value is object {
+  return typeof value === "object" && value !== null;
+}
+
+function clone<T>(value: T): T {
+  if (Array.isArray(value)) return value.map(clone) as T;
+  if (isContainer(value)) {
+    const out: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(out, key, clone((value as Record<string, unknown>)[key]));
+    return out as T;
+  }
+  return value;
+}
+
+// Defines the member directly so that a "__proto__" key stays plain data.
+function setMember(obj: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function equal(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => equal(v, b[i]));
+  }
+  if (isContainer(a)) {
+    if (!isContainer(b) || Array.isArray(b)) return false;
+    const ka = Object.keys(a);
+    if (ka.length !== Object.keys(b).length) return false;
+    return ka.every(
+      (k) => has(b, k) && equal((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]),
+    );
+  }
+  return a === b;
+}
+
+function walk(root: unknown, tokens: string[], path: string): unknown {
+  let current = root;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!INDEX.test(token) || Number(token) >= current.length) {
+        throw new JsonPatchError(`path "${path}" does not exist`);
+      }
+      current = current[Number(token)];
+    } else if (isContainer(current) && has(current, token)) {
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPatchError(`path "${path}" does not exist`);
+    }
+  }
+  return current;
+}
+
+function get(root: unknown, path: string): unknown {
+  return walk(root, parsePointer(path), path);
+}
+
+function add(root: unknown, path: string, value: unknown): unknown {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return value;
+  const last = tokens[tokens.length - 1];
+  const parent = walk(root, tokens.slice(0, -1), path);
+  if (Array.isArray(parent)) {
+    if (last === "-") {
+      parent.push(value);
+    } else if (INDEX.test(last) && Number(last) <= parent.length) {
+      parent.splice(Number(last), 0, value);
+    } else {
+      throw new JsonPatchError(`invalid array index in path "${path}"`);
+    }
+  } else if (isContainer(parent)) {
+    setMember(parent as Record<string, unknown>, last, value);
+  } else {
+    throw new JsonPatchError(`parent of path "${path}" is not a container`);
+  }
+  return root;
+}
+
+function remove(root: unknown, path: string): { root: unknown; removed: unknown } {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    throw new JsonPatchError("cannot remove the document root");
+  }
+  const last = tokens[tokens.length - 1];
+  const parent = walk(root, tokens.slice(0, -1), path);
+  const removed = walk(parent, [last], path);
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete (parent as Record<string, unknown>)[last];
+  return { root, removed };
+}
+
+function requireValue(op: Record<string, unknown>, name: string): unknown {
+  if (!has(op, "value")) throw new JsonPatchError(`"${name}" operation requires a "value"`);
+  return op.value;
+}
+
+function requireString(op: Record<string, unknown>, member: string, name: string): string {
+  if (typeof op[member] !== "string") {
+    throw new JsonPatchError(`"${name}" operation requires a string "${member}"`);
+  }
+  return op[member] as string;
+}
+
+/**
+ * Applies the JSON Patch `patch` (RFC 6902) to `document` and returns the result as a new
+ * value; neither argument is mutated. Throws a `JsonPatchError` if the patch is invalid or an
+ * operation fails (including a failed "test"), and a `JsonPointerError` for an invalid pointer.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchError("a JSON Patch must be an array");
+  let result = clone(document);
+  for (const op of patch) {
+    if (!isContainer(op) || Array.isArray(op)) {
+      throw new JsonPatchError("a patch operation must be an object");
+    }
+    const o = op as Record<string, unknown>;
+    const name = o.op;
+    if (typeof name !== "string") throw new JsonPatchError('operation lacks a string "op"');
+    const path = requireString(o, "path", name);
+    switch (name) {
+      case "add":
+        result = add(result, path, clone(requireValue(o, name)));
+        break;
+      case "remove":
+        result = remove(result, path).root;
+        break;
+      case "replace": {
+        const value = clone(requireValue(o, name));
+        get(result, path);
+        result = parsePointer(path).length === 0 ? value : add(remove(result, path).root, path, value);
+        break;
+      }
+      case "move":
+      case "copy": {
+        const from = requireString(o, "from", name);
+        const fromTokens = parsePointer(from);
+        const value = get(result, from);
+        if (name === "copy") {
+          result = add(result, path, clone(value));
+          break;
+        }
+        const toTokens = parsePointer(path);
+        if (
+          fromTokens.length < toTokens.length &&
+          fromTokens.every((t, i) => t === toTokens[i])
+        ) {
+          throw new JsonPatchError('"from" must not be a proper prefix of "path"');
+        }
+        if (from === path) break;
+        result = add(remove(result, from).root, path, value);
+        break;
+      }
+      case "test":
+        if (!equal(get(result, path), requireValue(o, name))) {
+          throw new JsonPatchError(`test failed at "${path}"`);
+        }
+        break;
+      default:
+        throw new JsonPatchError(`unknown operation "${name}"`);
+    }
+  }
+  return result;
+}
