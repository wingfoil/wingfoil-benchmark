+    exportMonth(month) {
+      if (!MONTH.test(month)) return err('invalid', `${month} is not a month (YYYY-MM)`);
+      const lines = [EXPORT_HEADER];
+      for (const order of orders) {
+        if (!order.date.startsWith(`${month}-`)) continue;
+        const customer = customers.get(order.customerId);
+        if (!customer.ok) return customer;
+        const cost = costOf(order, codes.get(order.number));
+        if (!cost.ok) return cost;
+        const fields = [String(order.number), order.date, customer.value.name, formatEuros(cost.value.totalCents)];
+        lines.push(fields.map(csvField).join(','));
+      }
+      return ok(lines.join('\n'));
+    },
   };
 }
