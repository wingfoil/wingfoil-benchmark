+
+describe('monthly export', () => {
+  const HEADER = 'order,date,customer,total';
+
+  it('lists the orders placed in the month by number, with what each customer pays', () => {
+    const shop = stocked();
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'HAM-W', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-31', lines: [{ sku: 'HAM-W', quantity: 1 }] }));
+    valueOf(shop.orders.applyCode(3, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.exportMonth('2026-10')), [HEADER, '1,2026-10-02,Mira Holt,17.80', '3,2026-10-31,Mira Holt,57.60'].join('\n'));
+  });
+
+  it('leaves contact details out of the export', () => {
+    const shop = stocked();
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    const csv = valueOf(shop.orders.exportMonth('2026-10'));
+    assert.doesNotMatch(csv, /mira@example\.org|555-0101/);
+  });
+
+  it('gives the header alone for a month with no orders', () => {
+    const shop = stocked();
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    assert.equal(valueOf(shop.orders.exportMonth('2026-08')), HEADER);
+  });
+
+  it('quotes a value that contains a comma or a quote', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, "Mira" Jr', email: 'jr@example.org', phone: '' }));
+    valueOf(shop.orders.place({ customerId: 'c2', date: '2026-10-05', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    assert.equal(valueOf(shop.orders.exportMonth('2026-10')), [HEADER, '1,2026-10-05,"Holt, ""Mira"" Jr",17.80'].join('\n'));
+  });
+
+  it('refuses a month that is not YYYY-MM', () => {
+    const shop = stocked();
+    for (const month of ['2026-13', '2026-00', '2026-3', '2026-10-01', 'October']) {
+      const refused = shop.orders.exportMonth(month);
+      assert.equal(refused.ok, false, month);
+      if (refused.ok) assert.fail('expected a refusal');
+      assert.equal(refused.error.code, 'invalid');
+    }
+  });
