+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** SPRING10 takes this percentage off the items. */
+const SPRING10_PERCENT = 10;
+
+/** WELCOME5 takes this much off the items. */
+const WELCOME5_CENTS: Cents = 500;
+
+/** WELCOME5 applies only to items that come to at least this much. */
+const WELCOME5_MIN_ITEMS_CENTS: Cents = 3000;
+
+/**
+ * What a discount code takes off an order's items. Codes match ignoring case and surrounding spaces.
+ *
+ * @param code - the code the customer gave
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  const name = code.trim().toUpperCase();
+  if (name === 'SPRING10') return ok(percentOf(itemsCents, SPRING10_PERCENT));
+  if (name === 'WELCOME5') {
+    if (itemsCents < WELCOME5_MIN_ITEMS_CENTS) {
+      return err('invalid', `WELCOME5 needs items of ${formatEuros(WELCOME5_MIN_ITEMS_CENTS)} € or more`);
+    }
+    return ok(WELCOME5_CENTS);
+  }
+  return err('invalid', `${code} is not a discount code`);
+}
+
+/**
+ * A percentage of an amount in whole cents, rounded to the nearest cent with a half cent rounding up.
+ *
+ * @param cents - the amount, in cents
+ * @param percent - the whole percentage to take
+ */
+function percentOf(cents: Cents, percent: number): Cents {
+  return Math.floor((cents * percent + 50) / 100);
+}
