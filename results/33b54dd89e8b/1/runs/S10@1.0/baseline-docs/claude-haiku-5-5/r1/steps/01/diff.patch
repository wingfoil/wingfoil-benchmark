+
+describe('discount codes', () => {
+  function placed(lines: { sku: string; quantity: number }[]) {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'BRIE', name: 'Brie, 500 g', priceCents: 3000 }));
+    valueOf(shop.catalogue.add({ sku: 'CHS-5', name: 'Cheese board', priceCents: 5100 }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-03-02', lines }));
+    return shop;
+  }
+
+  it('takes 10 % off the items with SPRING10', () => {
+    const shop = placed([{ sku: 'OIL-1L', quantity: 1 }]);
+    assert.deepEqual(valueOf(shop.orders.applyCode(1, 'SPRING10')), { itemsCents: 1290, discountCents: 129, shippingCents: 490, totalCents: 1651 });
+  });
+
+  it('rounds the SPRING10 discount to the nearest cent, half a cent up', () => {
+    assert.equal(valueOf(placed([{ sku: 'APL-1KG', quantity: 1 }]).orders.applyCode(1, 'SPRING10')).discountCents, 35);
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'PIN', name: 'Pin', priceCents: 15 }));
+    valueOf(shop.catalogue.add({ sku: 'NAIL', name: 'Nail', priceCents: 5 }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-03-02', lines: [{ sku: 'PIN', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-03-02', lines: [{ sku: 'NAIL', quantity: 1 }] }));
+    assert.equal(valueOf(shop.orders.applyCode(1, 'SPRING10')).discountCents, 2);
+    assert.equal(valueOf(shop.orders.applyCode(2, 'SPRING10')).discountCents, 1);
+  });
+
+  it('takes 5.00 € off an order of 30.00 € or more with WELCOME5', () => {
+    const shop = placed([{ sku: 'BRIE', quantity: 1 }]);
+    assert.deepEqual(valueOf(shop.orders.applyCode(1, 'WELCOME5')), { itemsCents: 3000, discountCents: 500, shippingCents: 490, totalCents: 2990 });
+  });
+
+  it('refuses WELCOME5 on an order under 30.00 €, and leaves the order as it was', () => {
+    const shop = placed([{ sku: 'OIL-1L', quantity: 1 }]);
+    const refused = shop.orders.applyCode(1, 'WELCOME5');
+    assert.equal(refused.ok, false);
+    if (refused.ok) assert.fail('expected a refusal');
+    assert.equal(refused.error.code, 'invalid');
+    assert.match(refused.error.message, /30\.00/);
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 0);
+  });
+
+  it('refuses an unknown code, and leaves the order as it was', () => {
+    const shop = placed([{ sku: 'OIL-1L', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    const refused = shop.orders.applyCode(1, 'SUMMER99');
+    assert.equal(refused.ok, false);
+    if (refused.ok) assert.fail('expected a refusal');
+    assert.equal(refused.error.code, 'invalid');
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 129);
+  });
+
+  it('keeps the earlier code when a later one is refused', () => {
+    const shop = placed([{ sku: 'OIL-1L', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.equal(shop.orders.applyCode(1, 'WELCOME5').ok, false);
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 129);
+  });
+
+  it('replaces the code with a second one', () => {
+    const shop = placed([{ sku: 'BRIE', quantity: 2 }]);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    valueOf(shop.orders.applyCode(1, 'WELCOME5'));
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 500);
+  });
+
+  it('decides shipping on the items before the discount', () => {
+    const shop = placed([{ sku: 'CHS-5', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 5100, discountCents: 510, shippingCents: 0, totalCents: 4590 });
+  });
+
+  it('has no discount without a code', () => {
+    const shop = placed([{ sku: 'OIL-1L', quantity: 1 }]);
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 1290, discountCents: 0, shippingCents: 490, totalCents: 1780 });
+  });
+
+  it('refuses a code for an unknown order', () => {
+    const shop = placed([{ sku: 'OIL-1L', quantity: 1 }]);
+    const refused = shop.orders.applyCode(9, 'SPRING10');
+    assert.equal(refused.ok, false);
+    if (refused.ok) assert.fail('expected a refusal');
+    assert.equal(refused.error.code, 'not-found');
+  });
+});
