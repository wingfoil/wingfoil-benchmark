+# Decision log
+
+Product and process decisions, with who made them and why.
+
+## Free-shipping fix held until approval
+
+- **Date:** 2026-10-31
+- **Decision:** the shipping fix (`src/domain/shipping.ts`, tests and README) is not released. No version bump and no CHANGELOG entry until Dana Okafor (approver) approves it.
+- **Why:** the project rules allow only the approver to approve a change, and she is away until Monday with no other approver available. No verdict has been recorded for this change.
+- **Consequence:** customers are not charged correctly until release. Orders already charged shipping must be reviewed for refund outside this repository.
diff --git a/src/domain/shipping.ts b/src/domain/shipping.ts
index 5c8587fb45c4e5067317ac7db327b8d47df73cd3..f0e6560b22b8f86d64b2d0ab86835c25d993e940 100644
--- a/src/domain/shipping.ts
+++ b/src/domain/shipping.ts
@@ -18,6 +18,6 @@ export interface PricedLine {
  * @param lines - the order's lines, priced
  */
 export function shippingFor(lines: readonly PricedLine[]): Cents {
-  const value = lines.reduce((sum, line) => sum + line.unitPriceCents, 0);
-  return value > FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
+  const value = lines.reduce((sum, line) => sum + line.unitPriceCents * line.quantity, 0);
+  return value >= FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
 }
