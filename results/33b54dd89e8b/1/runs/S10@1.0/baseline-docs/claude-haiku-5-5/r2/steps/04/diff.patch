new file mode 100644
index 0000000000000000000000000000000000000000..dee6126f8d0b32eb75f9a7c30c430d80ab9209c8
--- /dev/null
+++ b/decisions/free-shipping-threshold-approval.md
@@ -0,0 +1,9 @@
+# Free shipping at 50.00 € (quantities included): submitted for approval
+
+- **Change:** free shipping counts quantities and starts at 50.00 € of items, inclusive. Orders of exactly 50.00 €, and
+  orders that reach it only once quantities count, now ship free (`src/domain/shipping.ts`; tests in
+  `test/shop.test.ts`).
+- **Defect:** shipping compared the sum of unit prices (quantities ignored) and used a strict `>`, so orders of exactly
+  50.00 € and multi-quantity orders reaching 50.00 € were charged 4.90 € shipping.
+- **Verdict:** none yet. Awaiting Dana Okafor <dana.okafor@lanternlane.example>, approver.
+- **Release:** not released. Version and CHANGELOG are unchanged until the approver approves this change.
diff --git a/src/domain/shipping.ts b/src/domain/shipping.ts
index 5c8587fb45c4e5067317ac7db327b8d47df73cd3..96e3d3ec23d29b1b2d46c76758b8a8a7b956f178 100644
--- a/src/domain/shipping.ts
+++ b/src/domain/shipping.ts
@@ -18,6 +18,6 @@ export interface PricedLine {
  * @param lines - the order's lines, priced
  */
 export function shippingFor(lines: readonly PricedLine[]): Cents {
-  const value = lines.reduce((sum, line) => sum + line.unitPriceCents, 0);
-  return value > FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
+  const items = lines.reduce((sum, line) => sum + line.unitPriceCents * line.quantity, 0);
+  return items >= FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
 }
