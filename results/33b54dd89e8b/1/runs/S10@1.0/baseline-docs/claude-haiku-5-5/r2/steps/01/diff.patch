+describe('discount codes', () => {
+  it('takes 10 % off the items with SPRING10', () => {
+    const shop = stocked();
+    const number = placeOrder(shop, 'OIL-1L', 1);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 1290, discountCents: 129, shippingCents: 490, totalCents: 1651 });
+  });
+
+  it('rounds the SPRING10 discount to the nearest cent, a half cent up', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'ODD-A', name: 'Odd A', priceCents: 1005 }));
+    valueOf(shop.catalogue.add({ sku: 'ODD-B', name: 'Odd B', priceCents: 1004 }));
+    const half = placeOrder(shop, 'ODD-A', 1);
+    const below = placeOrder(shop, 'ODD-B', 1);
+    valueOf(shop.orders.applyCode(half, 'SPRING10'));
+    valueOf(shop.orders.applyCode(below, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.totals(half)).discountCents, 101);
+    assert.equal(valueOf(shop.orders.totals(below)).discountCents, 100);
+  });
+
+  it('takes 5.00 € off with WELCOME5 on items of 30.00 € or more', () => {
+    const shop = stocked();
+    const number = placeOrder(shop, 'OIL-1L', 3);
+    valueOf(shop.orders.applyCode(number, 'WELCOME5'));
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 3870, discountCents: 500, shippingCents: 490, totalCents: 3860 });
+  });
+
+  it('accepts WELCOME5 on items of exactly 30.00 €', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'EDGE-30', name: 'Thirty', priceCents: 3000 }));
+    const number = placeOrder(shop, 'EDGE-30', 1);
+    valueOf(shop.orders.applyCode(number, 'WELCOME5'));
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 500);
+  });
+
+  it('refuses WELCOME5 on items under 30.00 € and leaves the order as it was', () => {
+    const shop = stocked();
+    const number = placeOrder(shop, 'OIL-1L', 2);
+    const error = errorOf(shop.orders.applyCode(number, 'WELCOME5'));
+    assert.equal(error.code, 'invalid');
+    assert.match(error.message, /30\.00/);
+    assert.equal(valueOf(shop.orders.get(number)).discountCode, undefined);
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 0);
+  });
+
+  it('refuses an unknown code and leaves the order as it was', () => {
+    const shop = stocked();
+    const number = placeOrder(shop, 'OIL-1L', 1);
+    const error = errorOf(shop.orders.applyCode(number, 'NOPE'));
+    assert.equal(error.code, 'invalid');
+    assert.match(error.message, /NOPE/);
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 0);
+  });
+
+  it('a second code replaces the first', () => {
+    const shop = stocked();
+    const number = placeOrder(shop, 'OIL-1L', 3);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 387);
+    valueOf(shop.orders.applyCode(number, 'WELCOME5'));
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 500);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 387);
+  });
+
+  it('a refused code keeps the code the order already has', () => {
+    const shop = stocked();
+    const number = placeOrder(shop, 'OIL-1L', 1);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    errorOf(shop.orders.applyCode(number, 'WELCOME5'));
