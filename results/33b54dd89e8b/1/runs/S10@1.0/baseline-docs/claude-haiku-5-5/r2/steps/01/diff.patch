+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** A discount code the shop honours. */
+export type DiscountCode = 'SPRING10' | 'WELCOME5';
+
+/** WELCOME5 needs items that come to this amount or more. */
+const WELCOME_MIN_ITEMS_CENTS: Cents = 3000;
+
+/** What WELCOME5 takes off an order's items. */
+const WELCOME_DISCOUNT_CENTS: Cents = 500;
+
+/**
+ * Whether a code is known and applies to items of this amount.
+ *
+ * @param code - the code as the customer typed it
+ * @param itemsCents - the order's items, before any discount
+ */
+export function checkCode(code: string, itemsCents: Cents): Result<DiscountCode> {
+  switch (code) {
+    case 'SPRING10':
+      return ok('SPRING10');
+    case 'WELCOME5':
+      if (itemsCents < WELCOME_MIN_ITEMS_CENTS) {
+        return err('invalid', `WELCOME5 needs items of ${formatEuros(WELCOME_MIN_ITEMS_CENTS)} € or more; these come to ${formatEuros(itemsCents)} €`);
+      }
+      return ok('WELCOME5');
+    default:
+      return err('invalid', `${code} is not a discount code`);
+  }
+}
+
+/**
+ * What a code takes off items of this amount. SPRING10 is 10 %, rounded to the nearest cent with a half cent
+ * rounding up, so it is computed in whole cents: (items × 10 + 50) ÷ 100, rounded down.
+ *
+ * @param code - a code already checked against these items
+ * @param itemsCents - the order's items, before any discount
+ */
+export function discountFor(code: DiscountCode, itemsCents: Cents): Cents {
+  return code === 'SPRING10' ? Math.floor((itemsCents * 10 + 50) / 100) : WELCOME_DISCOUNT_CENTS;
+}
