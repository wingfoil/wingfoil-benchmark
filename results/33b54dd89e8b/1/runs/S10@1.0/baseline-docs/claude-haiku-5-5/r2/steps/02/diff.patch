@@ -0,0 +1,13 @@
+/**
+ * One line of CSV: its fields joined by commas, each quoted when it holds a comma, a quote or a line break, with its
+ * quotes doubled.
+ *
+ * @param fields - the values of the line, in column order
+ */
+export function csvLine(fields: readonly string[]): string {
+  return fields.map(csvField).join(',');
+}
+
+function csvField(field: string): string {
+  return /[",\r\n]/.test(field) ? `"${field.replaceAll('"', '""')}"` : field;
+}
