+describe('monthly export', () => {
+  const HEADER = 'order,date,customer,total\n';
+
+  function withJonas(shop: Shop): void {
+    valueOf(shop.customers.add({ id: 'c2', name: 'Jonas, Ruiz', email: 'jonas@example.org', phone: '555-0199' }));
+  }
+
+  it('gives a header and one line per order of the month, by order number, in euros', () => {
+    const shop = stocked();
+    withJonas(shop);
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-04', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'APL-1KG', quantity: 2 }] }));
+    valueOf(shop.orders.place({ customerId: 'c2', date: '2026-10-19', lines: [{ sku: 'HAM-W', quantity: 1 }] }));
+    assert.equal(
+      valueOf(shop.orders.exportMonth('2026-10')),
+      `${HEADER}1,2026-10-04,Mira Holt,17.80\n3,2026-10-19,"Jonas, Ruiz",64.00\n`,
+    );
+  });
+
+  it('leaves out the customers’ email addresses and phone numbers', () => {
+    const shop = stocked();
+    placeOrder(shop, 'OIL-1L', 1);
+    const text = valueOf(shop.orders.exportMonth('2026-10'));
+    assert.doesNotMatch(text, /mira@example\.org|555-0101/);
+  });
+
+  it('takes the discount into the total', () => {
+    const shop = stocked();
+    const number = placeOrder(shop, 'OIL-1L', 1);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.exportMonth('2026-10')), `${HEADER}1,2026-10-04,Mira Holt,16.51\n`);
+  });
+
+  it('includes the first and last day of the month and no other', () => {
+    const shop = stocked();
+    for (const date of ['2026-09-30', '2026-10-01', '2026-10-31', '2026-11-01']) {
+      valueOf(shop.orders.place({ customerId: 'c1', date, lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    }
+    const lines = valueOf(shop.orders.exportMonth('2026-10')).trimEnd().split('\n');
+    assert.deepEqual(lines.slice(1).map((line) => line.split(',')[1]), ['2026-10-01', '2026-10-31']);
+  });
+
+  it('gives the header alone for a month with no orders', () => {
+    const shop = stocked();
+    placeOrder(shop, 'OIL-1L', 1);
