+/**
+ * One CSV line: each value quoted, with its quotes doubled, when it holds a comma, a quote or a line break.
+ *
+ * @param values - the values of the line, in column order
+ */
+function csvLine(values: readonly string[]): string {
+  return values.map((value) => (/[",\r\n]/.test(value) ? `"${value.replaceAll('"', '""')}"` : value)).join(',');
