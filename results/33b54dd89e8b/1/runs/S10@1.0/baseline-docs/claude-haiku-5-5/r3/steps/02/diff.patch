+describe('monthly export', () => {
+  it('gives the header line alone for a month with no orders', () => {
+    const shop = stocked();
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    assert.equal(valueOf(shop.orders.exportMonth('2026-10')), 'order,date,customer,total\n');
+  });
+
+  it('lists the orders of the month by number, with the total the customer pays', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, "Mira" Jr', email: 'jr@example.org', phone: '' }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    const third = valueOf(shop.orders.place({ customerId: 'c2', date: '2026-10-31', lines: [{ sku: 'HAM-W', quantity: 1 }] }));
+    valueOf(shop.orders.applyCode(third.number, 'SPRING10'));
+    assert.equal(
+      valueOf(shop.orders.exportMonth('2026-10')),
+      [
+        'order,date,customer,total',
+        '1,2026-10-02,Mira Holt,17.80',
+        '3,2026-10-31,"Holt, ""Mira"" Jr",57.60',
+        '',
+      ].join('\n'),
+    );
+  });
+
+  it('keeps the first and last day of the month and leaves out the same month of another year', () => {
+    const shop = stocked();
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2025-10-15', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-01', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-11-01', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    assert.equal(
+      valueOf(shop.orders.exportMonth('2026-10')),
+      ['order,date,customer,total', '2,2026-10-01,Mira Holt,17.80', ''].join('\n'),
+    );
+  });
