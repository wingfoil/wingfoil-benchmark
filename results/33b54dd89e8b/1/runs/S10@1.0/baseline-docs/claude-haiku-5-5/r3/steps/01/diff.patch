+/**
+ * What priced lines come to before any discount or shipping.
+ *
+ * @param lines - the order's lines, priced
+ */
+function itemsOf(lines: readonly PricedLine[]): Cents {
+  return lines.reduce((sum, line) => sum + line.unitPriceCents * line.quantity, 0);
+}
