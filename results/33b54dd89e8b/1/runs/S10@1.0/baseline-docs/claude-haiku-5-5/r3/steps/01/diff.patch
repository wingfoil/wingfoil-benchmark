+    applyCode(number, code) {
+      const order = orders[number - 1];
+      if (order === undefined) return err('not-found', `no order ${number}`);
+      const known = discountCodeOf(code);
+      if (known === undefined) return err('not-found', `no discount code ${code}`);
+      const itemsCents = itemsOf(pricedLines(order));
+      const minimumCents = minimumItemsFor(known);
+      if (itemsCents < minimumCents) {
+        const needs = `${known} needs items of ${formatEuros(minimumCents)} € or more`;
+        return err('invalid', `${needs}; this order's items come to ${formatEuros(itemsCents)} €`);
+      }
+      const discounted: Order = { ...order, discountCode: known };
+      orders[number - 1] = discounted;
+      return ok(discounted);
     },
