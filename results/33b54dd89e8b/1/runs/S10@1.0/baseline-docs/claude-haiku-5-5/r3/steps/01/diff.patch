@@ -0,0 +1,52 @@
+import type { Cents } from './money.ts';
+
+/** The discount codes the shop honours. */
+export const DISCOUNT_CODES = ['SPRING10', 'WELCOME5'] as const;
+
+/** A discount code the shop honours. */
+export type DiscountCode = (typeof DISCOUNT_CODES)[number];
+
+/** What WELCOME5 takes off an order's items. */
+const WELCOME_DISCOUNT_CENTS: Cents = 500;
+
+/** The items an order must come to before WELCOME5 applies. */
+const WELCOME_MIN_ITEMS_CENTS: Cents = 3000;
+
+/**
+ * The code this text names, if the shop honours it. Codes are matched exactly.
+ *
+ * @param text - what the customer typed
+ */
+export function discountCodeOf(text: string): DiscountCode | undefined {
+  return DISCOUNT_CODES.find((code) => code === text);
+}
+
+/**
+ * The items an order must come to before this code applies.
+ *
+ * @param code - the discount code
+ */
+export function minimumItemsFor(code: DiscountCode): Cents {
+  switch (code) {
+    case 'SPRING10':
+      return 0;
+    case 'WELCOME5':
+      return WELCOME_MIN_ITEMS_CENTS;
+  }
+}
+
+/**
+ * What a code takes off an order's items. SPRING10 is 10 % of the items, rounded to the nearest cent with a
+ * half cent rounding up; the arithmetic stays in whole cents so no rounding error creeps in.
+ *
+ * @param code - the discount code
+ * @param itemsCents - the order's items, before any discount
+ */
+export function discountFor(code: DiscountCode, itemsCents: Cents): Cents {
+  switch (code) {
+    case 'SPRING10':
+      return Math.floor((itemsCents * 10 + 50) / 100);
+    case 'WELCOME5':
+      return WELCOME_DISCOUNT_CENTS;
+  }
+}
