@@ -0,0 +1,36 @@
+import type { Cents } from './money.ts';
+import { formatEuros } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** The items total from which `WELCOME5` is accepted. */
+export const WELCOME5_MINIMUM_CENTS: Cents = 3000;
+
+const WELCOME5_CENTS: Cents = 500;
+
+/**
+ * Checks that a discount code exists and may be used on an order whose items come to this amount.
+ *
+ * @param code - the code the customer entered
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function checkCode(code: string, itemsCents: Cents): Result<string> {
+  if (code === 'SPRING10') return ok(code);
+  if (code === 'WELCOME5') {
+    return itemsCents >= WELCOME5_MINIMUM_CENTS
+      ? ok(code)
+      : err('invalid', `WELCOME5 needs items of at least ${formatEuros(WELCOME5_MINIMUM_CENTS)} €`);
+  }
+  return err('invalid', `${code} is not a discount code`);
+}
+
+/**
+ * What a code takes off an order's items.
+ *
+ * @param code - a code accepted by `checkCode`
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Cents {
+  if (code === 'SPRING10') return Math.floor((itemsCents + 5) / 10);
+  return WELCOME5_CENTS;
+}
