    * `WELCOME5` on an order whose items come to less than 30.00 €, is refused and the order is left as it was.
    */
   applyCode(number: number, code: string): Result<OrderTotals>;
+  /**
+   * The orders placed in a month (`YYYY-MM`) as CSV text, by number: a header line, then per order its number, date,
+   * customer name and total in euros (no contact details). A month with no orders gives the header alone; a bad month is refused.
+   */
+  exportMonth(month: string): Result<string>;
+}
+
+const MONTH = /^\d{4}-(0[1-9]|1[0-2])$/;
+const EXPORT_HEADER = ['order', 'date', 'customer', 'total'];
+
+function csvField(value: string): string {
+  return /[",\r\n]/.test(value) ? `"${value.replaceAll('"', '""')}"` : value;
 }
 
 const DATE = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
@@ -120,5 +133,17 @@ export function createOrderBook(catalogue: Catalogue, customers: Customers): Ord
       codes.set(number, code);
       return totalsOf(number, code);
     },
+    exportMonth(month) {
+      if (!MONTH.test(month)) return err('invalid', `${month} is not a month (YYYY-MM)`);
+      const rows = orders
+        .filter((order) => order.date.startsWith(`${month}-`))
+        .map((order) => {
+          const customer = customers.get(order.customerId);
+          const totals = totalsOf(order.number, codes.get(order.number));
+          if (!customer.ok || !totals.ok) return [];
+          return [String(order.number), order.date, customer.value.name, formatEuros(totals.value.totalCents)];
+        });
+      return ok([EXPORT_HEADER, ...rows].map((row) => row.map(csvField).join(',')).join('\n') + '\n');
+    },
   };
 }
