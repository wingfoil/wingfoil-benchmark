+describe('monthly export', () => {
+  it('lists the month\'s orders with what each customer pays, quoting commas and quotes', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, "Bo"', email: 'bo@example.org', phone: '555-0102' }));
+    shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c2', date: '2026-10-03', lines: [{ sku: 'APL-1KG', quantity: 2 }] });
+    valueOf(shop.orders.applyCode(3, 'SPRING10'));
+    assert.equal(
+      valueOf(shop.orders.exportMonth('2026-10')),
+      'order,date,customer,total\n' +
+        '2,2026-10-02,Mira Holt,17.80\n' +
+        '3,2026-10-03,"Holt, ""Bo""",11.18\n',
+    );
+  });
+
+  it('gives the header alone for an empty month and refuses a bad month', () => {
+    const shop = stocked();
+    assert.equal(valueOf(shop.orders.exportMonth('2026-10')), 'order,date,customer,total\n');
+    assert.equal(shop.orders.exportMonth('2026-13').ok, false);
+  });
