+
+describe('discount codes', () => {
+  function orderOf(sku: string, quantity: number) {
+    const shop = stocked();
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku, quantity }] });
+    return shop;
+  }
+
+  it('takes 10 % off the items with SPRING10, shipping untouched', () => {
+    const shop = orderOf('OIL-1L', 1);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 1290, discountCents: 129, shippingCents: 490, totalCents: 1651 });
+  });
+
+  it('rounds a half cent up', () => {
+    const shop = orderOf('APL-1KG', 1);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 35);
+  });
+
+  it('takes 5.00 € off with WELCOME5 from 30.00 € of items', () => {
+    const shop = orderOf('OIL-1L', 3);
+    valueOf(shop.orders.applyCode(1, 'WELCOME5'));
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 500);
+  });
+
+  it('refuses WELCOME5 on a smaller order and leaves the order as it was', () => {
+    const shop = orderOf('OIL-1L', 1);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    const refused = shop.orders.applyCode(1, 'WELCOME5');
+    assert.equal(refused.ok, false);
+    assert.match(!refused.ok ? refused.error.message : '', /30\.00/);
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 129);
+  });
+
+  it('refuses an unknown code and an unknown order', () => {
+    const shop = orderOf('OIL-1L', 1);
+    assert.equal(shop.orders.applyCode(1, 'NOPE').ok, false);
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 0);
+    assert.equal(shop.orders.applyCode(9, 'SPRING10').ok, false);
+  });
+
+  it('lets a second code replace the first', () => {
+    const shop = orderOf('OIL-1L', 3);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    valueOf(shop.orders.applyCode(1, 'WELCOME5'));
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 500);
+  });
+
+  it('decides free shipping on the items before the discount', () => {
+    const shop = orderOf('HAM-W', 1);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    const totals = valueOf(shop.orders.totals(1));
+    assert.equal(totals.shippingCents, 0);
+    assert.equal(totals.totalCents, 6400 - 640);
+  });
+});
