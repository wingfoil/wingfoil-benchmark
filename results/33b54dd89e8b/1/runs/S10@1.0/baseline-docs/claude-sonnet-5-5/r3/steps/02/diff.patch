+describe('monthly export', () => {
+  const HEADER = 'order,date,customer,total\n';
+
+  it('lists the orders of the month by number, with what the customer pays', () => {
+    const shop = stocked();
+    shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'APL-1KG', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-10-03', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    valueOf(shop.orders.applyCode(3, 'SPRING10'));
+    assert.equal(
+      valueOf(shop.orders.exportMonth('2026-10')),
+      `${HEADER}2,2026-10-02,Mira Holt,17.80\n3,2026-10-03,Mira Holt,57.60\n`,
+    );
+  });
+
+  it('gives the header alone for a month without orders', () => {
+    assert.equal(valueOf(stocked().orders.exportMonth('2026-11')), HEADER);
+  });
+
+  it('quotes values with a comma or a quote', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, "Mira"', email: 'h@example.org', phone: '1' }));
+    shop.orders.place({ customerId: 'c2', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    assert.equal(valueOf(shop.orders.exportMonth('2026-10')), `${HEADER}1,2026-10-02,"Holt, ""Mira""",17.80\n`);
+  });
+
+  it('refuses a month that is not YYYY-MM', () => {
+    const shop = stocked();
+    assert.equal(shop.orders.exportMonth('2026-13').ok, false);
+    assert.equal(shop.orders.exportMonth('2026-1').ok, false);
+  });
+});
