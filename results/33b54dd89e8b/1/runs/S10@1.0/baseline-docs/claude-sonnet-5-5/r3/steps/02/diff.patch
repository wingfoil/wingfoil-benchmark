diff --git a/README.md b/README.md
index 07fbd12e469e1200f986f409fd47582c98a2835d..0aa4fe9f8cfa11b7741e6ed0031c6433bb2e461e 100644
--- a/README.md
+++ b/README.md
@@ -14,3 +14,11 @@ first. `SPRING10` takes 10 % off the items (a half cent rounds up); `WELCOME5` t
 30.00 € or more. An unknown code, or `WELCOME5` on a smaller order, is refused and the order left as it was. The
 discount never touches shipping, and free shipping is decided on the items before the discount. `totals` shows the
 discount as `discountCents` (0 without a code); `totalCents` is items minus discount plus shipping.
+
+## Monthly export
+
+`orders.exportMonth('YYYY-MM')` gives the accountant's export as CSV text: a header line, then one line per order
+placed in that month, by order number. It carries no email address or phone number. The columns are `order`, `date` (as stored), `customer` (the name) and
+`total` (what the customer pays, in euros with two decimals, such as `12.50`). A value with a comma, a quote or a line
+break is quoted, its quotes doubled. A month with no orders gives the header line alone; a month that is not
+`YYYY-MM` is refused.
diff --git a/src/domain/csv.ts b/src/domain/csv.ts
new file mode 100644
index 0000000000000000000000000000000000000000..66803b9f37a20d7418e8e8a037afe3ae6619853a
--- /dev/null
+++ b/src/domain/csv.ts
@@ -0,0 +1,8 @@
+/**
+ * One CSV line from its values: a value with a comma, a quote or a line break is quoted, its quotes doubled.
+ *
+ * @param values - the values of the line, in column order
+ */
+export function csvLine(values: readonly string[]): string {
+  return values.map((value) => (/[",\r\n]/.test(value) ? `"${value.replaceAll('"', '""')}"` : value)).join(',');
+}
