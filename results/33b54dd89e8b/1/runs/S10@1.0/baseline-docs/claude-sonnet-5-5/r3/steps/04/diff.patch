+## Free shipping from 50.00 € (fix, proposed 1.6.1)
+
+- Verdict: none yet. Submitted to Dana Okafor <dana.okafor@lanternlane.example>, approver, and awaiting her verdict. She is away until Monday.
+- What: orders whose items come to 50.00 € or more, quantities included, ship free. Before, an order of exactly 50.00 € and an order reaching 50.00 € only through quantities were charged 4.90 € shipping. Fixed in `src/domain/shipping.ts` (commit a45949d), with tests.
+- Not released: `package.json` is still 1.6.0 and `CHANGELOG.md` has no 1.6.1 entry, because a change is released only after the approver has approved it. No one else may give the verdict.
+- To finish once she approves: record her verdict here with her reason, bump `version` to 1.6.1, and add a 1.6.1 entry to `CHANGELOG.md`.
diff --git a/src/domain/shipping.ts b/src/domain/shipping.ts
index 5c8587fb45c4e5067317ac7db327b8d47df73cd3..f0e6560b22b8f86d64b2d0ab86835c25d993e940 100644
--- a/src/domain/shipping.ts
+++ b/src/domain/shipping.ts
@@ -18,6 +18,6 @@ export interface PricedLine {
  * @param lines - the order's lines, priced
  */
 export function shippingFor(lines: readonly PricedLine[]): Cents {
-  const value = lines.reduce((sum, line) => sum + line.unitPriceCents, 0);
-  return value > FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
+  const value = lines.reduce((sum, line) => sum + line.unitPriceCents * line.quantity, 0);
+  return value >= FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
 }
