@@ -0,0 +1,31 @@
+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** Orders whose items come to this amount or more can use `WELCOME5`. */
+export const WELCOME5_FROM_CENTS: Cents = 3000;
+
+/**
+ * What a discount code takes off the items of an order, in cents. An order whose items do not qualify
+ * is refused with the reason; an unknown code is refused too. Shipping is never discounted.
+ *
+ * - `SPRING10` takes 10 % off the items, rounded to the nearest cent (a half cent rounds up);
+ * - `WELCOME5` takes 5.00 € off the items, on orders of 30.00 € or more.
+ *
+ * @param code - the code, already normalised (trimmed, upper case)
+ * @param itemsCents - the items of the order, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  switch (code) {
+    case 'SPRING10':
+      return ok(Math.floor((itemsCents * 10 + 50) / 100));
+    case 'WELCOME5':
+      if (itemsCents < WELCOME5_FROM_CENTS) {
+        return err('invalid', `WELCOME5 is for orders of 30.00 € or more; these items come to ${formatEuros(itemsCents)} €`);
+      }
+      return ok(500);
+    default:
+      return err('invalid', `${code} is not a discount code`);
+  }
+}
