@@ -0,0 +1,28 @@
+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** Orders whose items come to at least this amount can use WELCOME5. */
+export const WELCOME_MINIMUM_CENTS: Cents = 3000;
+
+/**
+ * The discount a code gives on an order whose items come to `itemsCents`. Shipping is never discounted.
+ *
+ * @param code - the code, already trimmed and upper-cased
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  switch (code) {
+    case 'SPRING10':
+      // 10 % of the items, rounded to the nearest cent with a half cent going up.
+      return ok(Math.floor((itemsCents * 10 + 50) / 100));
+    case 'WELCOME5':
+      if (itemsCents < WELCOME_MINIMUM_CENTS) {
+        return err('invalid', `WELCOME5 needs items of ${formatEuros(WELCOME_MINIMUM_CENTS)} € or more`);
+      }
+      return ok(500);
+    default:
+      return err('invalid', `${code} is not a discount code`);
+  }
+}
