@@ -0,0 +1,46 @@
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** A discount code the shop sends out in its newsletter. */
+interface DiscountCode {
+  readonly code: string;
+  /** The discount on an order's items, in cents, or why the items do not qualify. */
+  readonly discount: (itemsCents: Cents) => Result<Cents>;
+}
+
+/** Orders whose items come to this amount or more can use `WELCOME5`. */
+export const WELCOME_MINIMUM_CENTS: Cents = 3000;
+
+/** The discount `WELCOME5` takes off an order's items. */
+export const WELCOME_DISCOUNT_CENTS: Cents = 500;
+
+const CODES: readonly DiscountCode[] = [
+  {
+    code: 'SPRING10',
+    discount: (itemsCents) => ok(Math.floor((itemsCents * 10 + 50) / 100)),
+  },
+  {
+    code: 'WELCOME5',
+    discount: (itemsCents) =>
+      itemsCents < WELCOME_MINIMUM_CENTS
+        ? err('invalid', `WELCOME5 needs items of at least ${WELCOME_MINIMUM_CENTS / 100} €`)
+        : ok(WELCOME_DISCOUNT_CENTS),
+  },
+];
+
+/**
+ * The discount a code gives on an order's items, or why the code is refused.
+ *
+ * Codes are matched ignoring case and surrounding spaces. `SPRING10` takes 10 % of the items, rounded to the nearest
+ * cent with a half cent rounding up.
+ *
+ * @param code - the code as the customer typed it
+ * @param itemsCents - the order's items, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  const wanted = code.trim().toUpperCase();
+  const found = CODES.find((known) => known.code === wanted);
+  if (found === undefined) return err('invalid', `${code.trim()} is not a discount code`);
+  return found.discount(itemsCents);
+}
