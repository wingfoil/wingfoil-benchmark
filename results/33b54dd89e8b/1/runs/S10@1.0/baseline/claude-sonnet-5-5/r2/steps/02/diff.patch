     assert.equal(formatEuros(5), '0.05');
   });
 });
+
+describe('exportMonth', () => {
+  it("lists the month's orders as CSV, with the total the customer pays", () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, "Al"', email: 'al@example.org', phone: '555-0102' }));
+    shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c2', date: '2026-10-03', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    valueOf(shop.orders.applyCode(3, 'SPRING10'));
+    assert.equal(
+      shop.orders.exportMonth('2026-10'),
+      'order,date,customer,email,phone,total\n' +
+        '2,2026-10-02,Mira Holt,mira@example.org,555-0101,17.80\n' +
+        '3,2026-10-03,"Holt, ""Al""",al@example.org,555-0102,57.60\n',
+    );
+    assert.equal(shop.orders.exportMonth('2026-11'), 'order,date,customer,email,phone,total\n');
+    assert.throws(() => shop.orders.exportMonth('2026-13'), RangeError);
+  });
+});
