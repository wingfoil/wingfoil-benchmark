+++ b/src/domain/discounts.ts
@@ -0,0 +1,38 @@
+import type { Cents } from './money.ts';
+
+/** The discount codes customers can be given, with how each is worked out and when it applies. */
+const CODES: Readonly<Record<string, { minItemsCents: Cents; discountFor(itemsCents: Cents): Cents }>> = {
+  // 10 % of the items, a half cent rounding up
+  SPRING10: { minItemsCents: 0, discountFor: (items) => Math.floor((items + 5) / 10) },
+  WELCOME5: { minItemsCents: 3000, discountFor: () => 500 },
+};
+
+/**
+ * The code as the shop knows it (ignoring case and surrounding spaces), or undefined if it is not a code.
+ *
+ * @param code - what the customer typed
+ */
+export function normalizeCode(code: string): string | undefined {
+  const normalized = code.trim().toUpperCase();
+  return Object.hasOwn(CODES, normalized) ? normalized : undefined;
+}
+
+/**
+ * The smallest amount of items an order needs for this code.
+ *
+ * @param code - a known code
+ */
+export function minimumItemsFor(code: string): Cents {
+  return CODES[code]?.minItemsCents ?? 0;
+}
+
+/**
+ * What a known code takes off an order whose items come to this amount; 0 if the order is too small.
+ *
+ * @param code - a known code
+ * @param itemsCents - the order's items, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Cents {
+  const rule = CODES[code];
+  return rule === undefined || itemsCents < rule.minItemsCents ? 0 : rule.discountFor(itemsCents);
+}
