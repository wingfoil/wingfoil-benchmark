+    applyCode(number, code) {
+      const order = orders[number - 1];
+      if (order === undefined) return err('not-found', `no order ${number}`);
+      const normalised = code.trim().toUpperCase();
+      const itemsCents = order.lines.reduce((sum, line) => {
+        const product = catalogue.get(line.sku);
+        return sum + (product.ok ? product.value.priceCents : 0) * line.quantity;
+      }, 0);
+      const discount = discountFor(normalised, itemsCents);
+      if (!discount.ok) return discount;
+      const updated: Order = { ...order, code: normalised };
+      orders[number - 1] = updated;
+      return ok(updated);
