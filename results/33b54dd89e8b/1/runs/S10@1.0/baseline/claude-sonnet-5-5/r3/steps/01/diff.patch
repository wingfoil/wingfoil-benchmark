+}
+
+/** Orders whose items come to this amount or more can take `WELCOME5`. */
+const WELCOME5_MINIMUM_CENTS: Cents = 3000;
+const WELCOME5_CENTS: Cents = 500;
+
+/** The discount a code gives on items worth `itemsCents`, or why the order cannot take it. */
+function discountFor(code: string | undefined, itemsCents: Cents): Result<Cents> {
+  switch (code) {
+    case undefined:
+      return ok(0);
+    case 'SPRING10':
+      // 10 % rounded to the nearest cent, a half cent up, in integers.
+      return ok(Math.floor((itemsCents + 5) / 10));
+    case 'WELCOME5':
+      return itemsCents >= WELCOME5_MINIMUM_CENTS
+        ? ok(WELCOME5_CENTS)
+        : err('invalid', 'WELCOME5 needs items of at least 30.00 €');
+    default:
+      return err('invalid', `${code} is not a discount code`);
+  }
 }
 
