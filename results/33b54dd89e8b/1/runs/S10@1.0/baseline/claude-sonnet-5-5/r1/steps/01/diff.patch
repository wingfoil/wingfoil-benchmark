+const WELCOME5_MIN_ITEMS_CENTS: Cents = 3000;
+const WELCOME5_CENTS: Cents = 500;
+
+/** The discount a known code gives on these items, or why the order does not qualify; `undefined` for an unknown code. */
+function discountFor(code: string, itemsCents: Cents): Result<Cents> | undefined {
+  switch (code) {
+    case 'SPRING10':
+      return ok(Math.floor((itemsCents * 10 + 50) / 100));
+    case 'WELCOME5':
