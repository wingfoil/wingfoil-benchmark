     },
+    exportMonth(month) {
+      if (!MONTH.test(month)) throw new RangeError(`${month} is not a month (YYYY-MM)`);
+      const lines = ['order,date,customer,email,phone,total'];
+      for (const order of orders) {
+        if (!order.date.startsWith(`${month}-`)) continue;
+        const customer = customers.get(order.customerId);
+        const who = customer.ok ? customer.value : { name: '', email: '', phone: '' };
+        const total = formatEuros(totalsOf(order, codes.get(order.number)).totalCents);
+        lines.push([String(order.number), order.date, who.name, who.email, who.phone, total].map(csvField).join(','));
+      }
+      return lines.join('\n') + '\n';
+    },
   };
 }
