+
+# Free shipping counts quantities and includes 50.00 exactly
+
+Urgent: customers are being overcharged shipping. The rule is that an order ships free when its items come to 50.00 €
+or more, quantities included. The order book does not follow it in two ways.
+
+## Request
+
+- An order whose items come to exactly 50.00 € is charged shipping. It must ship free.
+- An order that reaches 50.00 € only once quantities count (three bottles of oil at 17.00 €, for example) is charged
+  shipping. It must ship free.
+- Shipping is decided on the items before any discount, as it already is.
+
+## Acceptance
+
+- An order whose items come to exactly 5000 cents ships free.
+- An order whose items come to 4999 cents still pays shipping (490 cents).
+- Quantities count: three of a 1700-cent product (5100 cents) ships free.
+- Two of a 2500-cent product (5000 cents) ships free.
+
+## Traceability
+
+Requirement: the free-shipping rule of the order book, as stated in the request above (50.00 € of items or more,
+quantities included). Fix in `src/domain/shipping.ts`. Tests in `test/shop.test.ts`.
diff --git a/src/domain/shipping.ts b/src/domain/shipping.ts
index 5c8587fb45c4e5067317ac7db327b8d47df73cd3..f0e6560b22b8f86d64b2d0ab86835c25d993e940 100644
--- a/src/domain/shipping.ts
+++ b/src/domain/shipping.ts
@@ -18,6 +18,6 @@ export interface PricedLine {
  * @param lines - the order's lines, priced
  */
 export function shippingFor(lines: readonly PricedLine[]): Cents {
-  const value = lines.reduce((sum, line) => sum + line.unitPriceCents, 0);
-  return value > FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
+  const value = lines.reduce((sum, line) => sum + line.unitPriceCents * line.quantity, 0);
+  return value >= FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
 }
