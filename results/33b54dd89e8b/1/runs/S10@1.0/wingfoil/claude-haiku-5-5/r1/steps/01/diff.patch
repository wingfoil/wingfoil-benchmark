@@ -0,0 +1,43 @@
+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** The items an order must come to for WELCOME5: 30.00 €. */
+const WELCOME_MINIMUM_CENTS: Cents = 3000;
+
+/** What WELCOME5 takes off: 5.00 €. */
+const WELCOME_DISCOUNT_CENTS: Cents = 500;
+
+/**
+ * A discount code as customers write it: trimmed and in upper case, so `" spring10 "` is `SPRING10`.
+ *
+ * @param code - the code as the customer gave it
+ */
+export function normaliseCode(code: string): string {
+  return code.trim().toUpperCase();
+}
+
+/**
+ * What a discount code takes off an order's items, or why the items do not earn it.
+ *
+ * @param code - the discount code, normalised with `normaliseCode`
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  switch (code) {
+    case 'SPRING10':
+      // A tenth of the items, rounded to the nearest cent with a half cent up: (items + 5) / 10, in whole cents.
+      return ok(Math.floor((itemsCents + 5) / 10));
+    case 'WELCOME5':
+      if (itemsCents < WELCOME_MINIMUM_CENTS) {
+        return err(
+          'invalid',
+          `WELCOME5 needs items of at least ${formatEuros(WELCOME_MINIMUM_CENTS)} €; these come to ${formatEuros(itemsCents)} €`,
+        );
+      }
+      return ok(WELCOME_DISCOUNT_CENTS);
+    default:
+      return err('not-found', `${code} is not a discount code`);
+  }
+}
