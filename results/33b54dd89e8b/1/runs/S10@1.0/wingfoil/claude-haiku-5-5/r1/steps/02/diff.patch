+
+describe('monthly export', () => {
+  function withOrders() {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, Mira "Mimi"', email: 'mimi@example.org', phone: '' }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-03-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c2', date: '2026-02-28', lines: [{ sku: 'HAM-W', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c2', date: '2026-03-31', lines: [{ sku: 'HAM-W', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-04-01', lines: [{ sku: 'APL-1KG', quantity: 1 }] }));
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    return shop;
+  }
+
+  it('gives a header line, then the orders of the month by number', () => {
+    const shop = withOrders();
+    assert.equal(
+      valueOf(shop.orders.exportMonth('2026-03')),
+      [
+        'order,date,customer,total',
+        '1,2026-03-02,Mira Holt,16.51',
+        '3,2026-03-31,"Holt, Mira ""Mimi""",64.00',
+      ].join('\n'),
+    );
+  });
+
+  it('leaves out the customers\' email addresses and phone numbers', () => {
+    const shop = withOrders();
+    const text = valueOf(shop.orders.exportMonth('2026-03'));
+    assert.doesNotMatch(text, /@/);
+    assert.doesNotMatch(text, /555-0101/);
+  });
+
+  it('writes the total with two decimals, after discount and shipping', () => {
+    const shop = withOrders();
+    const lines = valueOf(shop.orders.exportMonth('2026-03')).split('\n');
+    assert.match(lines[1], /,16\.51$/);
+    assert.match(lines[2], /,64\.00$/);
+  });
+
+  it('gives the header line alone for a month with no orders', () => {
+    const shop = withOrders();
+    assert.equal(valueOf(shop.orders.exportMonth('2025-12')), 'order,date,customer,total');
+  });
+
+  it('gives the header line alone for an empty order book', () => {
+    const shop = stocked();
+    assert.equal(valueOf(shop.orders.exportMonth('2026-03')), 'order,date,customer,total');
+  });
+
+  it('refuses a month that is not YYYY-MM, and says why', () => {
+    const shop = withOrders();
+    for (const month of ['2026-3', 'March', '2026-13', '2026-03-01']) {
+      const refused = shop.orders.exportMonth(month);
+      assert.equal(refused.ok, false, month);
+      if (refused.ok) assert.fail(`${month} should be refused`);
+      assert.equal(refused.error.code, 'invalid');
+      assert.match(refused.error.message, /YYYY-MM/);
+    }
+  });
+});
