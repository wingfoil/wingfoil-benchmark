@@ -0,0 +1,28 @@
+---
+id: task-004-fix-free-shipping-at-50.00-euro-including-quantities
+type: task
+title: "Fix free shipping at 50.00 euro including quantities"
+status: pending
+format: 1
+---
+
+## Goal
+
+Customers are being overcharged shipping. The rule is: an order whose items come to 50.00 € or more ships free, with
+quantities counted. The code charged shipping in two cases it should not:
+
+- an order whose items come to exactly 50.00 € (the comparison was strict, `>`, not `>=`);
+- an order that reaches 50.00 € only once quantities count, e.g. three bottles of olive oil at 17.00 €. The shipping
+  sum added each product's unit price once, ignoring quantities.
+
+## Requirements
+
+- `shippingFor` decides free shipping on `unitPriceCents * quantity` summed over the lines, and ships free at 5000 cents
+  or more.
+- Tests cover: exactly 50.00 € of items ships free; three units at 17.00 € ships free; 49.99 € still pays shipping.
+- `CHANGELOG.md` records the fix under Unreleased. The version is not bumped here: a release waits for the approver.
+
+## Acceptance
+
+- `npm test` passes, including the new shipping tests.
+- No file under `.wingfoil/` is changed.
diff --git a/src/domain/shipping.ts b/src/domain/shipping.ts
index 5c8587fb45c4e5067317ac7db327b8d47df73cd3..37eb05157f7663c7559c31e5025f836a7da946db 100644
--- a/src/domain/shipping.ts
+++ b/src/domain/shipping.ts
@@ -13,11 +13,12 @@ export interface PricedLine {
 }
 
 /**
- * The shipping charge of an order with these lines.
+ * The shipping charge of an order with these lines: free when its items, quantities counted, come to the free-shipping
+ * amount or more.
  *
  * @param lines - the order's lines, priced
  */
 export function shippingFor(lines: readonly PricedLine[]): Cents {
-  const value = lines.reduce((sum, line) => sum + line.unitPriceCents, 0);
-  return value > FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
+  const value = lines.reduce((sum, line) => sum + line.unitPriceCents * line.quantity, 0);
+  return value >= FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
 }
