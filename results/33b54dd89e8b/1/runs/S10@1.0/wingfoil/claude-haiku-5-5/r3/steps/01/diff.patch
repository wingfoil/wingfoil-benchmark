@@ -0,0 +1,52 @@
+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** The discount codes the shop accepts. */
+export type DiscountCode = 'SPRING10' | 'WELCOME5';
+
+/** Orders whose items come to this amount or more can take WELCOME5. */
+export const WELCOME5_FROM_CENTS: Cents = 3000;
+
+/** What WELCOME5 takes off an order's items. */
+const WELCOME5_CENTS: Cents = 500;
+
+/**
+ * A code as a customer typed it, read as one of the codes the shop accepts: spaces and letter case do not matter.
+ *
+ * @param typed - the code as typed
+ */
+export function parseDiscountCode(typed: string): Result<DiscountCode> {
+  const code = typed.trim().toUpperCase();
+  if (code === 'SPRING10' || code === 'WELCOME5') return ok(code);
+  return err('invalid', `${typed.trim()} is not a discount code we know`);
+}
+
+/**
+ * Whether a code can be used on an order with these items; WELCOME5 needs items of 30.00 € or more.
+ *
+ * @param code - the code to use
+ * @param itemsCents - the order's items, before any discount
+ */
+export function checkDiscount(code: DiscountCode, itemsCents: Cents): Result<DiscountCode> {
+  if (code === 'WELCOME5' && itemsCents < WELCOME5_FROM_CENTS) {
+    return err(
+      'invalid',
+      `WELCOME5 takes 5.00 € off orders of 30.00 € or more, and these items come to ${formatEuros(itemsCents)} €`,
+    );
+  }
+  return ok(code);
+}
+
+/**
+ * What a code takes off an order's items. SPRING10 is 10 % of the items, rounded to the nearest cent with a half
+ * cent going up: `(items × 10 + 50) ÷ 100`, rounded down.
+ *
+ * @param code - the code in use
+ * @param itemsCents - the order's items, before any discount
+ */
+export function discountFor(code: DiscountCode, itemsCents: Cents): Cents {
+  if (code === 'WELCOME5') return WELCOME5_CENTS;
+  return Math.floor((itemsCents * 10 + 50) / 100);
+}
