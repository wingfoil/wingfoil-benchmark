+    applyCode(number, typed) {
+      const order = orders[number - 1];
+      if (order === undefined) return err('not-found', `no order ${number}`);
+      const code = parseDiscountCode(typed);
+      if (!code.ok) return code;
+      const qualified = checkDiscount(code.value, itemsOf(pricedLines(order)));
+      if (!qualified.ok) return qualified;
+      const updated: Order = { ...order, discountCode: qualified.value };
+      orders[number - 1] = updated;
+      return ok(updated);
     },
   };
+
+  /** The lines of an order with each product's unit price. */
+  function pricedLines(order: NewOrder): PricedLine[] {
+    return order.lines.map((line) => {
+      const product = catalogue.get(line.sku);
+      return { unitPriceCents: product.ok ? product.value.priceCents : 0, quantity: line.quantity };
+    });
+  }
+
+  /** What priced lines come to, before any discount or shipping. */
+  function itemsOf(priced: readonly PricedLine[]): Cents {
+    return priced.reduce((sum, line) => sum + line.unitPriceCents * line.quantity, 0);
+  }
 }
