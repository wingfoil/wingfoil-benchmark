+
+describe('monthly export', () => {
+  const HEADER = 'order,date,customer,total\n';
+
+  it('lists the orders of the month by number, with what each customer pays', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, Jonas "JH"', email: 'jonas@example.org', phone: '' }));
+    shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'APL-1KG', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    const discounted = shop.orders.place({ customerId: 'c2', date: '2026-10-31', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    assert.equal(discounted.ok, true);
+    valueOf(shop.orders.applyCode(3, 'SPRING10'));
+    shop.orders.place({ customerId: 'c1', date: '2026-11-01', lines: [{ sku: 'APL-1KG', quantity: 1 }] });
+    assert.equal(
+      valueOf(shop.orders.exportMonth('2026-10')),
+      `${HEADER}2,2026-10-02,Mira Holt,17.80\n3,2026-10-31,"Holt, Jonas ""JH""",57.60\n`,
+    );
+  });
+
+  it('gives the header line alone for a month with no orders', () => {
+    const shop = stocked();
+    placed(shop, [{ sku: 'APL-1KG', quantity: 1 }]);
+    assert.equal(valueOf(shop.orders.exportMonth('2026-12')), HEADER);
+    assert.equal(valueOf(createShop().orders.exportMonth('2026-10')), HEADER);
+  });
+
+  it('refuses a month that is not YYYY-MM', () => {
+    const shop = stocked();
+    for (const month of ['2026-13', '2026-1', '10/2026', '2026-10-01', '']) {
+      const refused = shop.orders.exportMonth(month);
+      assert.equal(refused.ok, false, month);
+      if (!refused.ok) assert.equal(refused.error.code, 'invalid');
+    }
+  });
+});
