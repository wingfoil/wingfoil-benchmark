@@ -0,0 +1,38 @@
+import type { Cents } from './money.ts';
+import { formatEuros } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** What a code takes off an order, given the order's items before any discount. */
+type Discount = (itemsCents: Cents) => Result<Cents>;
+
+/** Takes `percent` off the items, rounded to the nearest cent, a half cent rounding up. */
+function percentOff(percent: number): Discount {
+  return (itemsCents) => ok(Math.floor((itemsCents * percent + 50) / 100));
+}
+
+/** Takes `cents` off the items, on an order whose items come to at least `minItemsCents`. */
+function amountOff(cents: Cents, minItemsCents: Cents): Discount {
+  return (itemsCents) =>
+    itemsCents < minItemsCents
+      ? err('invalid', `this code needs items of ${formatEuros(minItemsCents)} € or more, and these come to ${formatEuros(itemsCents)} €`)
+      : ok(cents);
+}
+
+/** The codes the shop accepts, by code. */
+const DISCOUNTS = new Map<string, Discount>([
+  ['SPRING10', percentOff(10)],
+  ['WELCOME5', amountOff(500, 3000)],
+]);
+
+/**
+ * What a code takes off an order whose items come to this amount, before any discount.
+ *
+ * @param code - the code the customer gave
+ * @param itemsCents - the order's items, in cents, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  const discount = DISCOUNTS.get(code);
+  if (discount === undefined) return err('not-found', `${code} is not a discount code`);
+  return discount(itemsCents);
+}
