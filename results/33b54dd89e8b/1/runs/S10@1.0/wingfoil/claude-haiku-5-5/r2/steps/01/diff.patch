+    placed(shop, [{ sku: 'BIG-1', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 5100, discountCents: 510, shippingCents: 0, totalCents: 4590 });
+  });
+
+  it('takes 5.00 EUR off an order of 30.00 EUR or more with WELCOME5', () => {
