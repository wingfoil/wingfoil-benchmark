+function priced(shop: ReturnType<typeof stocked>, sku: string, priceCents: number) {
+  valueOf(shop.catalogue.add({ sku, name: sku, priceCents }));
+}
+
+function placed(shop: ReturnType<typeof stocked>, lines: { sku: string; quantity: number }[]) {
+  return valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-04', lines }));
+}
+
+describe('discount codes', () => {
+  it('takes 10 % off the items with SPRING10', () => {
+    const shop = stocked();
+    placed(shop, [{ sku: 'HAM-W', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 6400, discountCents: 640, shippingCents: 0, totalCents: 5760 });
+  });
+
+  it('rounds the SPRING10 discount half a cent up', () => {
+    const shop = stocked();
+    priced(shop, 'TEA-1', 335);
+    priced(shop, 'GUM-1', 5);
+    placed(shop, [{ sku: 'TEA-1', quantity: 1 }]);
+    placed(shop, [{ sku: 'GUM-1', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    valueOf(shop.orders.applyCode(2, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 34);
+    assert.equal(valueOf(shop.orders.totals(2)).discountCents, 1);
+  });
+
+  it('keeps charging shipping on the undiscounted items', () => {
+    const shop = stocked();
+    placed(shop, [{ sku: 'OIL-1L', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 1290, discountCents: 129, shippingCents: 490, totalCents: 1651 });
+  });
+
