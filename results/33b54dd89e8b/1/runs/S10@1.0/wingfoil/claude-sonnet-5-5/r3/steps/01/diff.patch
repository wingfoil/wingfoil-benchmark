+const WELCOME5_CENTS: Cents = 500;
+/** `WELCOME5` needs items of at least this amount. */
+const WELCOME5_MINIMUM_CENTS: Cents = 3000;
+
+/** The discount of a code on items of this amount, or why the order does not qualify. */
+function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  switch (code) {
+    case 'SPRING10':
+      // Integer arithmetic: a half cent rounds up.
+      return ok(Math.floor((itemsCents * SPRING10_PERCENT + 50) / 100));
+    case 'WELCOME5':
+      return itemsCents >= WELCOME5_MINIMUM_CENTS
+        ? ok(WELCOME5_CENTS)
+        : err('invalid', 'WELCOME5 needs items of at least 30.00 €');
+    default:
+      return err('invalid', `${code} is not a discount code`);
+  }
