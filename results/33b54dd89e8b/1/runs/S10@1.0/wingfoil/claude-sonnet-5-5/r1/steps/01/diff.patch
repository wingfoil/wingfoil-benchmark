+
+describe('discount codes', () => {
+  function orderOf(shop: ReturnType<typeof stocked>, sku: string, quantity: number) {
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-05', lines: [{ sku, quantity }] }));
+  }
+
+  it('shows no discount without a code', () => {
+    const shop = stocked();
+    orderOf(shop, 'OIL-1L', 1);
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 0);
+  });
+
+  it('takes 10 % off the items with SPRING10, never off shipping', () => {
+    const shop = stocked();
+    orderOf(shop, 'OIL-1L', 1);
+    assert.deepEqual(valueOf(shop.orders.applyCode(1, 'SPRING10')), { itemsCents: 1290, discountCents: 129, shippingCents: 490, totalCents: 1651 });
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 1290, discountCents: 129, shippingCents: 490, totalCents: 1651 });
+  });
+
+  it('rounds SPRING10 to the nearest cent, half a cent up', () => {
+    const shop = stocked();
+    orderOf(shop, 'APL-1KG', 1); // 349 -> 34.9 -> 35
+    assert.equal(valueOf(shop.orders.applyCode(1, 'SPRING10')).discountCents, 35);
+    valueOf(shop.catalogue.add({ sku: 'X', name: 'X', priceCents: 345 }));
+    orderOf(shop, 'X', 1); // 34.5 -> 35
+    assert.equal(valueOf(shop.orders.applyCode(2, 'SPRING10')).discountCents, 35);
+    valueOf(shop.catalogue.add({ sku: 'Y', name: 'Y', priceCents: 344 }));
+    orderOf(shop, 'Y', 1); // 34.4 -> 34
+    assert.equal(valueOf(shop.orders.applyCode(3, 'SPRING10')).discountCents, 34);
+  });
+
+  it('takes 5.00 off with WELCOME5 from 30.00 of items', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'T30', name: 'T30', priceCents: 3000 }));
+    orderOf(shop, 'T30', 1);
+    assert.deepEqual(valueOf(shop.orders.applyCode(1, 'WELCOME5')), { itemsCents: 3000, discountCents: 500, shippingCents: 490, totalCents: 2990 });
+  });
+
+  it('refuses WELCOME5 below 30.00 and leaves the order as it was', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'T2999', name: 'T', priceCents: 2999 }));
+    orderOf(shop, 'T2999', 1);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    const result = shop.orders.applyCode(1, 'WELCOME5');
+    assert.equal(result.ok, false);
+    if (!result.ok) assert.match(result.error.message, /WELCOME5.*30\.00/);
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 300);
+  });
+
+  it('refuses an unknown code and an unknown order', () => {
+    const shop = stocked();
+    orderOf(shop, 'OIL-1L', 1);
+    const result = shop.orders.applyCode(1, 'SUMMER');
+    assert.equal(result.ok, false);
+    if (!result.ok) assert.match(result.error.message, /SUMMER/);
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 0);
+    assert.equal(shop.orders.applyCode(9, 'SPRING10').ok, false);
+  });
+
+  it('lets a second code replace the first', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'T40', name: 'T40', priceCents: 4000 }));
+    orderOf(shop, 'T40', 1);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.applyCode(1, 'WELCOME5')).discountCents, 500);
+  });
+
+  it('decides free shipping on the items before the discount', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'T50', name: 'T50', priceCents: 5000 }));
+    orderOf(shop, 'T50', 1);
+    const totals = valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.deepEqual(totals, { itemsCents: 5000, discountCents: 500, shippingCents: 0, totalCents: 4500 });
+  });
+
+  it('counts quantities when deciding free shipping', () => {
+    const shop = stocked();
+    orderOf(shop, 'OIL-1L', 4); // 51.60
+    assert.equal(valueOf(shop.orders.totals(1)).shippingCents, 0);
+  });
+});
