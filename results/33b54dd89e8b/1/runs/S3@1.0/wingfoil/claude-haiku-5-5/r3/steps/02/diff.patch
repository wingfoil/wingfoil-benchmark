diff --git a/src/rental.test.ts b/src/rental.test.ts
index c948d68038ce4fbdaf99958531a86eeb8310b2ef..11b483072b1c5575ce2c51d6e87e98f9e5b3397c 100644
--- a/src/rental.test.ts
+++ b/src/rental.test.ts
@@ -134,3 +134,71 @@ test('addEquipment rejects an id that is already in use', () => {
   const rental = service();
   assert.throws(() => rental.addEquipment({ id: 'board-1', kind: 'sail', dailyPrice: 100 }));
 });
+
+test('availability lists every item when none is booked, sorted by id', () => {
+  const rental = service();
+  rental.addEquipment({ id: 'board-0', kind: 'board', dailyPrice: 2000 });
+  assert.deepEqual(
+    rental.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    ['board-0', 'board-1', 'sail-1'],
+  );
+});
+
+test('availability with a kind lists only items of that kind', () => {
+  const rental = service();
+  const period = { start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' };
+  assert.deepEqual(rental.availability({ ...period, kind: 'board' }), ['board-1']);
+  assert.deepEqual(rental.availability({ ...period, kind: 'sail' }), ['sail-1']);
+});
+
+test('availability leaves out an item booked for an overlapping period', () => {
+  const rental = service();
+  rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.deepEqual(
+    rental.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-04T00:00:00Z', kind: 'board' }),
+    [],
+  );
+});
+
+test('availability keeps an item booked only for a touching period', () => {
+  const rental = service();
+  rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.deepEqual(
+    rental.availability({ start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z', kind: 'board' }),
+    ['board-1'],
+  );
+});
+
+test('a booking of one item does not remove another item from availability', () => {
+  const rental = service();
+  rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.deepEqual(rental.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' }), ['sail-1']);
+});
+
+test('availability returns an empty array when no item of the kind is free', () => {
+  const rental = service();
+  rental.book({ itemId: 'sail-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  assert.deepEqual(rental.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'sail' }), []);
+});
+
+test('availability does not change what can be booked', () => {
+  const rental = service();
+  const period = { start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' };
+  const first = rental.availability(period);
+  assert.deepEqual(rental.availability(period), first);
+  assert.doesNotThrow(() => rental.book({ itemId: 'board-1', ...period }));
+});
+
+test('availability rejects a period that is not whole UTC days', () => {
+  const rental = service();
+  assert.throws(() => rental.availability({ start: '2026-07-01T10:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.throws(() => rental.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+  assert.throws(() => rental.availability({ start: '2026-02-30T00:00:00Z', end: '2026-03-02T00:00:00Z' }));
+});
+
+test('availability rejects an unknown kind', () => {
+  const rental = service();
+  assert.throws(() =>
+    rental.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'kite' } as never),
+  );
+});
