diff --git a/src/rental.test.ts b/src/rental.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c948d68038ce4fbdaf99958531a86eeb8310b2ef
--- /dev/null
+++ b/src/rental.test.ts
@@ -0,0 +1,136 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.js';
+
+function service() {
+  const rental = createRentalService();
+  rental.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  rental.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1999 });
+  return rental;
+}
+
+test('quote returns the number of days times the daily price in cents', () => {
+  const quote = service().quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.deepEqual(quote, {
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00.000Z',
+    end: '2026-07-03T00:00:00.000Z',
+    total: 5000,
+  });
+});
+
+test('quote keeps the total an integer number of cents', () => {
+  const quote = service().quote({ itemId: 'sail-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.equal(quote.total, 5997);
+  assert.ok(Number.isInteger(quote.total));
+});
+
+test('quote of a single day is one daily price', () => {
+  const quote = service().quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  assert.equal(quote.total, 2500);
+});
+
+test('quote rejects an unknown item', () => {
+  assert.throws(() => service().quote({ itemId: 'nope', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+});
+
+test('quote rejects a start that is not at midnight UTC', () => {
+  assert.throws(() => service().quote({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-02T00:00:00Z' }));
+});
+
+test('quote rejects an end that is not at midnight UTC', () => {
+  assert.throws(() => service().quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T12:00:00Z' }));
+});
+
+test('quote rejects a time written with a non-UTC offset', () => {
+  assert.throws(() =>
+    service().quote({ itemId: 'board-1', start: '2026-07-01T00:00:00+02:00', end: '2026-07-02T00:00:00Z' }),
+  );
+});
+
+test('quote rejects a period that ends before or at its start', () => {
+  const rental = service();
+  assert.throws(() => rental.quote({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+  assert.throws(() => rental.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+});
+
+test('quote rejects a date that does not exist', () => {
+  assert.throws(() => service().quote({ itemId: 'board-1', start: '2026-02-30T00:00:00Z', end: '2026-03-02T00:00:00Z' }));
+});
+
+test('quote rejects a value that is not a string', () => {
+  assert.throws(() => service().quote({ itemId: 'board-1', start: 1782864000000, end: '2026-07-02T00:00:00Z' } as never));
+});
+
+test('book returns an id and the same total as the quote', () => {
+  const rental = service();
+  const request = { itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' };
+  const quote = rental.quote(request);
+  const booking = rental.book(request);
+  assert.equal(typeof booking.id, 'string');
+  assert.deepEqual(
+    { itemId: booking.itemId, start: booking.start, end: booking.end, total: booking.total },
+    { itemId: quote.itemId, start: quote.start, end: quote.end, total: quote.total },
+  );
+});
+
+test('each booking gets its own id', () => {
+  const rental = service();
+  const first = rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  const second = rental.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.notEqual(first.id, second.id);
+});
+
+test('book rejects an unknown item', () => {
+  assert.throws(() => service().book({ itemId: 'nope', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+});
+
+test('book rejects a period that is not whole days', () => {
+  assert.throws(() => service().book({ itemId: 'board-1', start: '2026-07-01T00:30:00Z', end: '2026-07-02T00:00:00Z' }));
+});
+
+test('book rejects a period that overlaps an existing booking of the same item', () => {
+  const rental = service();
+  rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  // starts inside, ends inside, and contains the existing booking
+  assert.throws(() => rental.book({ itemId: 'board-1', start: '2026-07-03T00:00:00Z', end: '2026-07-05T00:00:00Z' }));
+  assert.throws(() => rental.book({ itemId: 'board-1', start: '2026-06-30T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.throws(() => rental.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' }));
+  assert.throws(() => rental.book({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-08-01T00:00:00Z' }));
+});
+
+test('a period that only touches an existing booking is accepted', () => {
+  const rental = service();
+  rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.doesNotThrow(() => rental.book({ itemId: 'board-1', start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z' }));
+  assert.doesNotThrow(() => rental.book({ itemId: 'board-1', start: '2026-06-30T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+});
+
+test('a booking does not block another item for the same period', () => {
+  const rental = service();
+  rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.doesNotThrow(() => rental.book({ itemId: 'sail-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' }));
+});
+
+test('a rejected booking does not block the period', () => {
+  const rental = service();
+  rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.throws(() => rental.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-04T00:00:00Z' }));
+  assert.doesNotThrow(() => rental.book({ itemId: 'board-1', start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z' }));
+});
+
+test('addEquipment rejects an unknown kind', () => {
+  const rental = createRentalService();
+  assert.throws(() => rental.addEquipment({ id: 'x', kind: 'kite', dailyPrice: 1000 } as never));
+});
+
+test('addEquipment rejects a price that is not a whole number of non-negative cents', () => {
+  const rental = createRentalService();
+  assert.throws(() => rental.addEquipment({ id: 'x', kind: 'board', dailyPrice: 19.99 }));
+  assert.throws(() => rental.addEquipment({ id: 'y', kind: 'board', dailyPrice: -100 }));
+});
+
+test('addEquipment rejects an id that is already in use', () => {
+  const rental = service();
+  assert.throws(() => rental.addEquipment({ id: 'board-1', kind: 'sail', dailyPrice: 100 }));
+});
diff --git a/src/rental.ts b/src/rental.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7950cd8ce5a7519ccf3c671496a722f2e4a8b7d7
--- /dev/null
+++ b/src/rental.ts
@@ -0,0 +1,155 @@
+/** Money is an integer number of euro cents. */
+export type Cents = number;
+
+/** A rentable item: a board or a sail, with the price of one rental day. */
+export interface Equipment {
+  id: string;
+  kind: 'board' | 'sail';
+  dailyPrice: Cents;
+}
+
+/** A rental period. `start` and `end` are UTC midnights; `end` is the start of the day after the last day. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  total: Cents;
+}
+
+export interface Booking {
+  id: string;
+  itemId: string;
+  start: string;
+  end: string;
+  total: Cents;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+interface Reservation {
+  id: string;
+  itemId: string;
+  startMs: number;
+  endMs: number;
+  total: Cents;
+}
+
+const DAY_MS = 86_400_000;
+const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00:00(\.000)?Z$/;
+
+/** Parses a UTC midnight ISO-8601 string into epoch milliseconds, rejecting anything else. */
+function parseMidnight(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !UTC_MIDNIGHT.test(value)) {
+    throw new Error(`${name} must be a UTC midnight ISO-8601 string, got ${JSON.stringify(value)}`);
+  }
+  const ms = Date.parse(value);
+  // Date.parse rolls over impossible dates such as 2026-02-30; the round trip catches them.
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a valid date: ${value}`);
+  }
+  return ms;
+}
+
+/** Validates a period and returns its bounds in epoch milliseconds. */
+function parsePeriod(request: RentalRequest): { startMs: number; endMs: number } {
+  const startMs = parseMidnight(request.start, 'start');
+  const endMs = parseMidnight(request.end, 'end');
+  if (endMs <= startMs) {
+    throw new Error('end must be after start');
+  }
+  return { startMs, endMs };
+}
+
+/** Prices a period: whole days times the daily price, which must stay a safe integer of cents. */
+function priceOf(startMs: number, endMs: number, dailyPrice: Cents): Cents {
+  const total = ((endMs - startMs) / DAY_MS) * dailyPrice;
+  if (!Number.isSafeInteger(total)) {
+    throw new Error('total is out of range');
+  }
+  return total;
+}
+
+/** Creates an in-memory rental service for boards and sails. */
+export function createRentalService(): RentalService {
+  const items = new Map<string, Equipment>();
+  const reservations: Reservation[] = [];
+  let nextBooking = 1;
+
+  function findItem(itemId: unknown): Equipment {
+    const item = typeof itemId === 'string' ? items.get(itemId) : undefined;
+    if (!item) {
+      throw new Error(`unknown item: ${String(itemId)}`);
+    }
+    return item;
+  }
+
+  function priced(request: RentalRequest): { item: Equipment; startMs: number; endMs: number; total: Cents } {
+    const item = findItem(request.itemId);
+    const { startMs, endMs } = parsePeriod(request);
+    return { item, startMs, endMs, total: priceOf(startMs, endMs, item.dailyPrice) };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item.id !== 'string' || item.id === '') {
+        throw new Error('id must be a non-empty string');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error(`kind must be 'board' or 'sail', got ${String(item.kind)}`);
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of cents');
+      }
+      if (items.has(item.id)) {
+        throw new Error(`equipment already exists: ${item.id}`);
+      }
+      items.set(item.id, { ...item });
+    },
+
+    quote(request) {
+      const { startMs, endMs, total } = priced(request);
+      return {
+        itemId: request.itemId,
+        start: new Date(startMs).toISOString(),
+        end: new Date(endMs).toISOString(),
+        total,
+      };
+    },
+
+    book(request) {
+      const { item, startMs, endMs, total } = priced(request);
+      // Periods are half-open: a booking that starts when another ends does not overlap it.
+      const clash = reservations.some(
+        (r) => r.itemId === item.id && r.startMs < endMs && startMs < r.endMs,
+      );
+      if (clash) {
+        throw new Error(`${item.id} is already booked for an overlapping period`);
+      }
+      const reservation: Reservation = {
+        id: `booking-${nextBooking++}`,
+        itemId: item.id,
+        startMs,
+        endMs,
+        total,
+      };
+      reservations.push(reservation);
+      return {
+        id: reservation.id,
+        itemId: item.id,
+        start: new Date(startMs).toISOString(),
+        end: new Date(endMs).toISOString(),
+        total,
+      };
+    },
+  };
+}
