+function hourlyService() {
+  const rental = service();
+  rental.addEquipment({ id: 'hourly-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 800 });
+  return rental;
+}
+
+test('addEquipment accepts an hourly price, and an item may have none', () => {
+  const rental = createRentalService();
+  assert.doesNotThrow(() => rental.addEquipment({ id: 'x', kind: 'board', dailyPrice: 2500, hourlyPrice: 800 }));
+  assert.doesNotThrow(() => rental.addEquipment({ id: 'y', kind: 'sail', dailyPrice: 2500 }));
+});
+
+test('addEquipment rejects an hourly price that is not a non-negative whole number of cents', () => {
+  const rental = createRentalService();
+  assert.throws(() => rental.addEquipment({ id: 'x', kind: 'board', dailyPrice: 2500, hourlyPrice: 8.5 }));
+  assert.throws(() => rental.addEquipment({ id: 'y', kind: 'board', dailyPrice: 2500, hourlyPrice: -800 }));
+});
+
+test('quote of three hours is three hourly prices', () => {
+  const quote = hourlyService().quote({ itemId: 'hourly-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T13:00:00Z' });
+  assert.deepEqual(quote, {
+    itemId: 'hourly-1',
+    start: '2026-07-01T10:00:00.000Z',
+    end: '2026-07-01T13:00:00.000Z',
+    total: 2400,
+  });
+});
+
+test('book of an hourly period returns the same total as the quote', () => {
+  const rental = hourlyService();
+  const request = { itemId: 'hourly-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' };
+  assert.equal(rental.book(request).total, 1600);
+  assert.equal(rental.quote(request).total, 1600);
+});
+
+test('an hourly period that crosses midnight is priced by the hours it covers', () => {
+  const quote = hourlyService().quote({ itemId: 'hourly-1', start: '2026-07-01T23:00:00Z', end: '2026-07-02T01:00:00Z' });
+  assert.equal(quote.total, 1600);
+});
+
+test('a period shorter than a day that starts or ends off the hour is rejected', () => {
+  const rental = hourlyService();
+  assert.throws(() => rental.quote({ itemId: 'hourly-1', start: '2026-07-01T10:30:00Z', end: '2026-07-01T12:30:00Z' }));
+  assert.throws(() => rental.book({ itemId: 'hourly-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:15:00Z' }));
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  const rental = service();
+  const request = { itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' };
+  assert.throws(() => rental.quote(request));
+  assert.throws(() => rental.book(request));
+});
+
+test('a 24-hour period that does not start at midnight is rejected', () => {
+  const rental = hourlyService();
+  assert.throws(() => rental.quote({ itemId: 'hourly-1', start: '2026-07-01T10:00:00Z', end: '2026-07-02T10:00:00Z' }));
+});
+
+test('an hourly booking blocks an overlapping period of the same item, not a touching one', () => {
+  const rental = hourlyService();
+  rental.book({ itemId: 'hourly-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' });
+  assert.throws(() => rental.book({ itemId: 'hourly-1', start: '2026-07-01T11:00:00Z', end: '2026-07-01T13:00:00Z' }));
+  assert.throws(() => rental.book({ itemId: 'hourly-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.doesNotThrow(() => rental.book({ itemId: 'hourly-1', start: '2026-07-01T12:00:00Z', end: '2026-07-01T13:00:00Z' }));
+  assert.doesNotThrow(() => rental.book({ itemId: 'hourly-1', start: '2026-07-01T09:00:00Z', end: '2026-07-01T10:00:00Z' }));
+});
+
+test('availability includes an hourly period: an overlapping one hides the item, a touching one does not', () => {
+  const rental = hourlyService();
+  rental.book({ itemId: 'hourly-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' });
+  assert.deepEqual(
+    rental.availability({ start: '2026-07-01T11:00:00Z', end: '2026-07-01T13:00:00Z', kind: 'board' }),
+    ['board-1'],
+  );
+  assert.deepEqual(
+    rental.availability({ start: '2026-07-01T12:00:00Z', end: '2026-07-01T13:00:00Z', kind: 'board' }),
+    ['board-1', 'hourly-1'],
+  );
+});
+
+test('an hourly rental gets no long-stay discount, and a whole-day rental is priced as before', () => {
+  const rental = hourlyService();
+  assert.equal(rental.quote({ itemId: 'hourly-1', start: '2026-07-01T00:00:00Z', end: '2026-07-01T03:00:00Z' }).total, 2400);
+  assert.equal(rental.quote({ itemId: 'hourly-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' }).total, 6750);
+});
+
+test('quote rejects an hourly period whose end is not after its start', () => {
+  const rental = hourlyService();
+  assert.throws(() => rental.quote({ itemId: 'hourly-1', start: '2026-07-01T12:00:00Z', end: '2026-07-01T10:00:00Z' }));
+  assert.throws(() => rental.quote({ itemId: 'hourly-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T10:00:00Z' }));
+});
