@@ -21,10 +21,47 @@ test('quote returns the number of days times the daily price in cents', () => {
 
 test('quote keeps the total an integer number of cents', () => {
   const quote = service().quote({ itemId: 'sail-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
-  assert.equal(quote.total, 5997);
+  assert.equal(quote.total, 5397);
   assert.ok(Number.isInteger(quote.total));
 });
 
+test('quote of two days is the full price, with no discount', () => {
+  const quote = service().quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.equal(quote.total, 5000);
+});
+
+test('quote of three days gets 10% off the full price', () => {
+  const quote = service().quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.equal(quote.total, 6750);
+});
+
+test('quote of more than three days gets the same 10% off', () => {
+  const quote = service().quote({ itemId: 'sail-1', start: '2026-07-01T00:00:00Z', end: '2026-07-05T00:00:00Z' });
+  assert.equal(quote.total, 7196);
+});
+
+test('a discounted total rounds to the nearest cent, halves up', () => {
+  const rental = createRentalService();
+  rental.addEquipment({ id: 'half', kind: 'board', dailyPrice: 5 });
+  // 15 cents full price, 13.5 cents discounted: rounds up to 14
+  assert.equal(rental.quote({ itemId: 'half', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' }).total, 14);
+  // 5997 full price, 5397.3 discounted: rounds down to 5397
+  assert.equal(service().quote({ itemId: 'sail-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' }).total, 5397);
+});
+
+test('book of three days returns the discounted total, equal to the quote', () => {
+  const rental = service();
+  const request = { itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' };
+  assert.equal(rental.book(request).total, 6750);
+  assert.equal(rental.quote(request).total, 6750);
+});
+
+test('the discount does not change which periods are rejected', () => {
+  const rental = service();
+  assert.throws(() => rental.quote({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-04T00:00:00Z' }));
+  assert.throws(() => rental.book({ itemId: 'board-1', start: '2026-07-04T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+});
+
 test('quote of a single day is one daily price', () => {
   const quote = service().quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
   assert.equal(quote.total, 2500);
