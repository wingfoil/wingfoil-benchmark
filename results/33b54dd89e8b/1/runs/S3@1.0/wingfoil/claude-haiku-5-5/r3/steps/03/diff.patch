@@ -54,6 +54,8 @@ interface Reservation {
 }
 
 const DAY_MS = 86_400_000;
+/** From this many whole days, a rental costs 10% less than its full price. */
+const LONG_STAY_DAYS = 3;
 const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00:00(\.000)?Z$/;
 
 /** Parses a UTC midnight ISO-8601 string into epoch milliseconds, rejecting anything else. */
@@ -79,13 +81,24 @@ function parsePeriod(period: Pick<RentalRequest, 'start' | 'end'>): { startMs: n
   return { startMs, endMs };
 }
 
-/** Prices a period: whole days times the daily price, which must stay a safe integer of cents. */
+/**
+ * Prices a period: whole days times the daily price. A period of LONG_STAY_DAYS or more gets 10% off,
+ * rounded to the nearest cent with halves up. Every intermediate value must stay a safe integer of cents.
+ */
 function priceOf(startMs: number, endMs: number, dailyPrice: Cents): Cents {
-  const total = ((endMs - startMs) / DAY_MS) * dailyPrice;
-  if (!Number.isSafeInteger(total)) {
+  const days = (endMs - startMs) / DAY_MS;
+  const fullPrice = days * dailyPrice;
+  if (!Number.isSafeInteger(fullPrice)) {
     throw new Error('total is out of range');
   }
-  return total;
+  if (days < LONG_STAY_DAYS) {
+    return fullPrice;
+  }
+  if (!Number.isSafeInteger(fullPrice * 9)) {
+    throw new Error('total is out of range');
+  }
+  // 90% of fullPrice, rounded half up: floor(9 * fullPrice / 10 + 1/2), kept in integers.
+  return Math.floor((fullPrice * 9 + 5) / 10);
 }
 
