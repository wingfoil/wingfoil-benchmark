@@ -331,3 +331,86 @@ test('quote rejects an hourly period whose end is not after its start', () => {
   assert.throws(() => rental.quote({ itemId: 'hourly-1', start: '2026-07-01T12:00:00Z', end: '2026-07-01T10:00:00Z' }));
   assert.throws(() => rental.quote({ itemId: 'hourly-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T10:00:00Z' }));
 });
+
+const JULY_DAY = { start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' };
+
+test('cancel of a day that is cancelled more than 24 hours before its start refunds the total', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', ...JULY_DAY });
+  assert.deepEqual(rental.cancel(booking.id, '2026-06-29T00:00:00Z'), { bookingId: booking.id, refund: 2500 });
+});
+
+test('cancel exactly 24 hours before the start refunds the full total', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', ...JULY_DAY });
+  assert.equal(rental.cancel(booking.id, '2026-06-30T00:00:00Z').refund, 2500);
+});
+
+test('cancel less than 24 hours before the start gets no refund', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', ...JULY_DAY });
+  assert.equal(rental.cancel(booking.id, '2026-06-30T00:00:01Z').refund, 0);
+});
+
+test('cancel at or after the start gets no refund', () => {
+  const rental = service();
+  const first = rental.book({ itemId: 'board-1', ...JULY_DAY });
+  const second = rental.book({ itemId: 'sail-1', ...JULY_DAY });
+  assert.equal(rental.cancel(first.id, '2026-07-01T00:00:00Z').refund, 0);
+  assert.equal(rental.cancel(second.id, '2026-07-01T09:00:00Z').refund, 0);
+});
+
+test('cancel of a discounted booking refunds the discounted total', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.equal(booking.total, 6750);
+  assert.equal(rental.cancel(booking.id, '2026-06-01T00:00:00Z').refund, 6750);
+});
+
+test('cancel of an hourly booking refunds its total when cancelled 24 hours ahead, and nothing within 24 hours', () => {
+  const rental = hourlyService();
+  const early = rental.book({ itemId: 'hourly-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T13:00:00Z' });
+  const late = rental.book({ itemId: 'hourly-1', start: '2026-07-02T10:00:00Z', end: '2026-07-02T11:00:00Z' });
+  assert.equal(rental.cancel(early.id, '2026-06-30T10:00:00Z').refund, 2400);
+  assert.equal(rental.cancel(late.id, '2026-07-02T00:00:00Z').refund, 0);
+});
+
+test('a cancelled booking no longer holds its equipment in availability', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', ...JULY_DAY });
+  rental.cancel(booking.id, '2026-06-29T00:00:00Z');
+  assert.deepEqual(rental.availability({ ...JULY_DAY, kind: 'board' }), ['board-1']);
+});
+
+test('after a cancellation, book accepts an overlapping period for the same item', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', ...JULY_DAY });
+  rental.cancel(booking.id, '2026-06-29T00:00:00Z');
+  assert.doesNotThrow(() => rental.book({ itemId: 'board-1', ...JULY_DAY }));
+});
+
+test('a booking can only be cancelled once', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', ...JULY_DAY });
+  rental.cancel(booking.id, '2026-06-29T00:00:00Z');
+  assert.throws(() => rental.cancel(booking.id, '2026-06-29T00:00:00Z'));
+});
+
+test('cancel rejects an unknown booking id', () => {
+  assert.throws(() => service().cancel('booking-99', '2026-06-29T00:00:00Z'));
+});
+
+test('cancel rejects a malformed time', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', ...JULY_DAY });
+  assert.throws(() => rental.cancel(booking.id, '2026-06-29T00:00:00+02:00'));
+  assert.throws(() => rental.cancel(booking.id, '2026-02-30T00:00:00Z'));
+});
+
+test('cancelling one booking does not free another booking of the same item', () => {
+  const rental = service();
+  const first = rental.book({ itemId: 'board-1', ...JULY_DAY });
+  rental.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  rental.cancel(first.id, '2026-06-29T00:00:00Z');
+  assert.throws(() => rental.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' }));
+});
