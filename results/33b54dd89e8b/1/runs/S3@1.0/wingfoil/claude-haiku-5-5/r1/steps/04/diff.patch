+
+describe('hourly rental', () => {
+  function serviceWithHourlyBoard() {
+    const service = createRentalService();
+    service.addEquipment({ id: 'board-h', kind: 'board', dailyPrice: 2500, hourlyPrice: 800 });
+    service.addEquipment({ id: 'sail-d', kind: 'sail', dailyPrice: 1800 });
+    return service;
+  }
+
+  test('addEquipment accepts an hourly price', () => {
+    const service = createRentalService();
+    assert.doesNotThrow(() => service.addEquipment({ id: 'h-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 800 }));
+  });
+
+  test('addEquipment rejects an hourly price that is not a non-negative integer of cents', () => {
+    const service = createRentalService();
+    assert.throws(() => service.addEquipment({ id: 'a', kind: 'board', dailyPrice: 2500, hourlyPrice: 8.5 }));
+    assert.throws(() => service.addEquipment({ id: 'b', kind: 'board', dailyPrice: 2500, hourlyPrice: -800 }));
+    assert.throws(() => service.addEquipment({ id: 'c', kind: 'board', dailyPrice: 2500, hourlyPrice: Number.NaN }));
+  });
+
+  test('one hour costs one hourly price', () => {
+    const service = serviceWithHourlyBoard();
+    assert.deepEqual(
+      service.quote({ itemId: 'board-h', start: '2026-07-01T10:00:00Z', end: '2026-07-01T11:00:00Z' }),
+      { itemId: 'board-h', start: '2026-07-01T10:00:00Z', end: '2026-07-01T11:00:00Z', total: 800 },
+    );
+  });
+
+  test('several hours cost the hourly price times the number of hours, with no day discount', () => {
+    const service = serviceWithHourlyBoard();
+    const quote = service.quote({ itemId: 'board-h', start: '2026-07-01T13:00:00Z', end: '2026-07-01T16:00:00Z' });
+    assert.equal(quote.total, 3 * 800);
+  });
+
+  test('a rental spanning midnight is priced by the hour', () => {
+    const service = serviceWithHourlyBoard();
+    const quote = service.quote({ itemId: 'board-h', start: '2026-07-01T22:00:00Z', end: '2026-07-02T02:00:00Z' });
+    assert.equal(quote.total, 4 * 800);
+  });
+
+  test('a rental of almost a day is still priced by the hour', () => {
+    const service = serviceWithHourlyBoard();
+    const quote = service.quote({ itemId: 'board-h', start: '2026-07-01T00:00:00Z', end: '2026-07-01T23:00:00Z' });
+    assert.equal(quote.total, 23 * 800);
+  });
+
+  test('book returns the same total as quote for the same hourly period', () => {
+    const service = serviceWithHourlyBoard();
+    const period = { itemId: 'board-h', start: '2026-07-01T09:00:00Z', end: '2026-07-01T12:00:00Z' };
+    const quote = service.quote(period);
+    const booking = service.book(period);
+    assert.equal(booking.total, quote.total);
+    assert.equal(booking.total, 2400);
+  });
+
+  test('an item without an hourly price cannot be rented by the hour', () => {
+    const service = serviceWithHourlyBoard();
+    const hour = { itemId: 'sail-d', start: '2026-07-01T10:00:00Z', end: '2026-07-01T11:00:00Z' };
+    assert.throws(() => service.quote(hour));
+    assert.throws(() => service.book(hour));
+  });
+
+  test('an item without an hourly price still rents by the whole day', () => {
+    const service = serviceWithHourlyBoard();
+    assert.equal(service.quote({ itemId: 'sail-d', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }).total, 1800);
+  });
+
+  test('throws when the start is not on the hour', () => {
+    const service = serviceWithHourlyBoard();
+    assert.throws(() => service.quote({ itemId: 'board-h', start: '2026-07-01T09:30:00Z', end: '2026-07-01T10:30:00Z' }));
+  });
+
+  test('throws when the end is not on the hour', () => {
+    const service = serviceWithHourlyBoard();
+    assert.throws(() => service.book({ itemId: 'board-h', start: '2026-07-01T09:00:00Z', end: '2026-07-01T10:15:00Z' }));
+  });
+
+  test('throws for a day-long rental that does not start at midnight UTC', () => {
+    const service = serviceWithHourlyBoard();
+    assert.throws(() => service.quote({ itemId: 'board-h', start: '2026-07-01T09:00:00Z', end: '2026-07-02T09:00:00Z' }));
+  });
+
+  test('throws for a multi-day rental that does not end at midnight UTC', () => {
+    const service = serviceWithHourlyBoard();
+    assert.throws(() => service.quote({ itemId: 'board-h', start: '2026-07-01T00:00:00Z', end: '2026-07-02T05:00:00Z' }));
+  });
+
+  test('overlapping hourly bookings for the same item clash', () => {
+    const service = serviceWithHourlyBoard();
+    service.book({ itemId: 'board-h', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' });
+    assert.throws(() => service.book({ itemId: 'board-h', start: '2026-07-01T11:00:00Z', end: '2026-07-01T13:00:00Z' }));
+  });
+
+  test('hourly bookings that only touch do not clash', () => {
+    const service = serviceWithHourlyBoard();
+    service.book({ itemId: 'board-h', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' });
+    assert.doesNotThrow(() => service.book({ itemId: 'board-h', start: '2026-07-01T12:00:00Z', end: '2026-07-01T13:00:00Z' }));
+  });
+
+  test('an hourly booking makes the item unavailable for the day it covers', () => {
+    const service = serviceWithHourlyBoard();
+    service.book({ itemId: 'board-h', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' });
+    assert.deepEqual(
+      service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'board' }),
+      [],
+    );
+    assert.deepEqual(
+      service.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z', kind: 'board' }),
+      ['board-h'],
+    );
+  });
+});
