diff --git a/tests/rental.test.ts b/tests/rental.test.ts
index 1af4c76c3914defa4bac05807a9d1677a207ffca..2578e86b657e7d76a50a595ccd2798887d98bde7 100644
--- a/tests/rental.test.ts
+++ b/tests/rental.test.ts
@@ -162,3 +162,109 @@ describe('book', () => {
     assert.throws(() => createRentalService().quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
   });
 });
+
+describe('availability', () => {
+  test('lists every item when no kind is given, sorted by id', () => {
+    const service = createRentalService();
+    service.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 1800 });
+    service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1800 });
+    assert.deepEqual(
+      service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+      ['board-1', 'sail-1', 'sail-2'],
+    );
+  });
+
+  test('lists only the items of the given kind', () => {
+    const service = serviceWithEquipment();
+    service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+    assert.deepEqual(
+      service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'board' }),
+      ['board-1', 'board-2'],
+    );
+    assert.deepEqual(
+      service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'sail' }),
+      ['sail-1'],
+    );
+  });
+
+  test('leaves out an item booked for an overlapping part of the period', () => {
+    const service = serviceWithEquipment();
+    service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+    assert.deepEqual(
+      service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' }),
+      ['sail-1'],
+    );
+  });
+
+  test('keeps an item whose booking only touches the period', () => {
+    const service = serviceWithEquipment();
+    service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+    assert.deepEqual(
+      service.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' }),
+      ['board-1', 'sail-1'],
+    );
+  });
+
+  test('an item with no bookings is free', () => {
+    const service = serviceWithEquipment();
+    assert.deepEqual(
+      service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+      ['board-1', 'sail-1'],
+    );
+  });
+
+  test('returns an empty array when nothing is free', () => {
+    const service = createRentalService();
+    assert.deepEqual(service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }), []);
+    service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+    service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+    assert.deepEqual(
+      service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'board' }),
+      [],
+    );
+  });
+
+  test('gives the same answer on every call', () => {
+    const service = serviceWithEquipment();
+    const query = { start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' };
+    assert.deepEqual(service.availability(query), service.availability(query));
+  });
+
+  test('does not change when a period is only quoted', () => {
+    const service = serviceWithEquipment();
+    service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+    assert.deepEqual(
+      service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'board' }),
+      ['board-1'],
+    );
+  });
+
+  test('throws for a kind other than board or sail', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() =>
+      service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'kite' as unknown as 'board' }),
+    );
+  });
+
+  test('throws when the start is not at midnight UTC', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() => service.availability({ start: '2026-07-01T12:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  });
+
+  test('throws when the end is not at midnight UTC', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() => service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T06:00:00Z' }));
+  });
+
+  test('throws for a timestamp that is not a real date', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() => service.availability({ start: '2026-02-30T00:00:00Z', end: '2026-03-01T00:00:00Z' }));
+  });
+
+  test('throws when the end is not after the start', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() => service.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+    assert.throws(() => service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+  });
+});
