+
+describe('cancel', () => {
+  const twoDays = { itemId: 'board-1', start: '2026-07-10T00:00:00Z', end: '2026-07-12T00:00:00Z' };
+
+  test('a booking cancelled 24 hours or more before its start is refunded in full', () => {
+    const service = serviceWithEquipment();
+    const booking = service.book(twoDays);
+    assert.deepEqual(service.cancel(booking.id, '2026-07-07T00:00:00Z'), { bookingId: booking.id, refund: 5000 });
+  });
+
+  test('exactly 24 hours before the start counts as in time', () => {
+    const service = serviceWithEquipment();
+    const booking = service.book(twoDays);
+    assert.equal(service.cancel(booking.id, '2026-07-09T00:00:00Z').refund, 5000);
+  });
+
+  test('a booking cancelled less than 24 hours before its start gets no refund', () => {
+    const service = serviceWithEquipment();
+    const booking = service.book(twoDays);
+    assert.equal(service.cancel(booking.id, '2026-07-09T01:00:00Z').refund, 0);
+  });
+
+  test('a booking cancelled after its start gets no refund', () => {
+    const service = serviceWithEquipment();
+    const booking = service.book(twoDays);
+    assert.equal(service.cancel(booking.id, '2026-07-10T09:00:00Z').refund, 0);
+  });
+
+  test('the refund is the discounted total for a long rental', () => {
+    const service = serviceWithEquipment();
+    const booking = service.book({ itemId: 'board-1', start: '2026-07-10T00:00:00Z', end: '2026-07-13T00:00:00Z' });
+    assert.equal(booking.total, 6750);
+    assert.equal(service.cancel(booking.id, '2026-07-01T00:00:00Z').refund, 6750);
+  });
+
+  test('a time that is not an ISO-8601 UTC timestamp is refused', () => {
+    const service = serviceWithEquipment();
+    const booking = service.book(twoDays);
+    assert.throws(() => service.cancel(booking.id, '2026-07-07'));
+    assert.throws(() => service.cancel(booking.id, 'yesterday'));
+  });
+
+  test('an impossible date is refused', () => {
+    const service = serviceWithEquipment();
+    const booking = service.book(twoDays);
+    assert.throws(() => service.cancel(booking.id, '2026-02-30T00:00:00Z'));
+  });
+
+  test('throws for an unknown booking', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() => service.cancel('booking-99', '2026-07-01T00:00:00Z'));
+  });
+
+  test('a booking can only be cancelled once', () => {
+    const service = serviceWithEquipment();
+    const booking = service.book(twoDays);
+    service.cancel(booking.id, '2026-07-01T00:00:00Z');
+    assert.throws(() => service.cancel(booking.id, '2026-07-01T00:00:00Z'));
+  });
+
+  test('a cancelled booking releases its equipment for the period', () => {
+    const service = serviceWithEquipment();
+    const booking = service.book(twoDays);
+    service.cancel(booking.id, '2026-07-01T00:00:00Z');
+    assert.deepEqual(service.availability({ start: '2026-07-10T00:00:00Z', end: '2026-07-11T00:00:00Z', kind: 'board' }), ['board-1']);
+    assert.doesNotThrow(() => service.book(twoDays));
+  });
+
+  test('cancelling one booking leaves the others holding their equipment', () => {
+    const service = serviceWithEquipment();
+    const first = service.book(twoDays);
+    service.book({ itemId: 'board-1', start: '2026-07-12T00:00:00Z', end: '2026-07-13T00:00:00Z' });
+    service.cancel(first.id, '2026-07-01T00:00:00Z');
+    assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-12T00:00:00Z', end: '2026-07-13T00:00:00Z' }));
+    assert.deepEqual(service.availability({ start: '2026-07-12T00:00:00Z', end: '2026-07-13T00:00:00Z', kind: 'board' }), []);
+  });
+});
