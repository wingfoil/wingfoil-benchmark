     }
     const { startMs, endMs } = parsePeriod(request.start, request.end);
     const days = (endMs - startMs) / DAY_MS;
-    return { item, startMs, endMs, total: item.dailyPrice * days };
+    const fullPrice = item.dailyPrice * days;
+    // Rentals of three days or more get 10% off, rounded to the nearest cent (halves up).
+    const total = days >= LONG_RENTAL_DAYS ? Math.round((fullPrice * 9) / 10) : fullPrice;
+    return { item, startMs, endMs, total };
   }
 
   // Periods are half-open: [start, end). Periods that only touch do not overlap.
