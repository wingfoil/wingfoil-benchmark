@@ -0,0 +1,117 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one day of rental, in euro cents. */
+  dailyPrice: number;
+}
+
+export interface PeriodRequest {
+  itemId: string;
+  /** ISO-8601 UTC timestamp at midnight, e.g. `2026-07-01T00:00:00Z`. */
+  start: string;
+  /** ISO-8601 UTC timestamp at midnight: the start of the day after the last rented day. */
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  /** Total price, in euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: PeriodRequest): Quote;
+  book(request: PeriodRequest): Booking;
+}
+
+interface Stay {
+  itemId: string;
+  startMs: number;
+  endMs: number;
+}
+
+const DAY_MS = 86_400_000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00:00(\.000)?Z$/;
+const KINDS: readonly string[] = ['board', 'sail'];
+
+function parseMidnight(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC timestamp at midnight`);
+  }
+  const ms = Date.parse(value);
+  // Date.parse accepts some impossible dates (e.g. February 30th) by rolling them over; reject those.
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a valid date`);
+  }
+  return ms;
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item.id !== 'string' || item.id.length === 0) {
+    throw new Error('item id must be a non-empty string');
+  }
+  if (!KINDS.includes(item.kind)) {
+    throw new Error(`item kind must be 'board' or 'sail'`);
+  }
+  if (!Number.isInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('daily price must be a non-negative integer number of euro cents');
+  }
+}
+
+export function createRentalService(): RentalService {
+  const items = new Map<string, Equipment>();
+  const stays: Stay[] = [];
+  let bookingCount = 0;
+
+  function priced(request: PeriodRequest): { item: Equipment; startMs: number; endMs: number; total: number } {
+    const item = items.get(request.itemId);
+    if (item === undefined) {
+      throw new Error(`unknown item: ${request.itemId}`);
+    }
+    const startMs = parseMidnight(request.start, 'start');
+    const endMs = parseMidnight(request.end, 'end');
+    if (endMs <= startMs) {
+      throw new Error('end must be after start');
+    }
+    const days = (endMs - startMs) / DAY_MS;
+    return { item, startMs, endMs, total: item.dailyPrice * days };
+  }
+
+  return {
+    addEquipment(item) {
+      validateEquipment(item);
+      if (items.has(item.id)) {
+        throw new Error(`item already exists: ${item.id}`);
+      }
+      items.set(item.id, { ...item });
+    },
+
+    quote(request) {
+      const { total } = priced(request);
+      return { itemId: request.itemId, start: request.start, end: request.end, total };
+    },
+
+    book(request) {
+      const { startMs, endMs, total } = priced(request);
+      // Periods are half-open: [start, end). Periods that only touch do not overlap.
+      const clash = stays.some(
+        (stay) => stay.itemId === request.itemId && startMs < stay.endMs && stay.startMs < endMs,
+      );
+      if (clash) {
+        throw new Error(`item ${request.itemId} is already booked for an overlapping period`);
+      }
+      bookingCount += 1;
+      stays.push({ itemId: request.itemId, startMs, endMs });
+      return { id: `booking-${bookingCount}`, itemId: request.itemId, start: request.start, end: request.end, total };
+    },
+  };
+}
diff --git a/tests/rental.test.ts b/tests/rental.test.ts
