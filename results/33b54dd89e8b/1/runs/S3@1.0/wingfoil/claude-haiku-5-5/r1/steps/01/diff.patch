+++ b/tests/rental.test.ts
@@ -0,0 +1,164 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+const board = { id: 'board-1', kind: 'board', dailyPrice: 2500 } as const;
+const sail = { id: 'sail-1', kind: 'sail', dailyPrice: 1800 } as const;
+
+function serviceWithEquipment() {
+  const service = createRentalService();
+  service.addEquipment(board);
+  service.addEquipment(sail);
+  return service;
+}
+
+describe('addEquipment', () => {
+  test('accepts a board and a sail', () => {
+    const service = createRentalService();
+    service.addEquipment(board);
+    service.addEquipment(sail);
+    assert.equal(service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }).total, 2500);
+  });
+
+  test('rejects an empty or non-string id', () => {
+    const service = createRentalService();
+    assert.throws(() => service.addEquipment({ id: '', kind: 'board', dailyPrice: 100 }));
+    assert.throws(() => service.addEquipment({ id: 7 as unknown as string, kind: 'board', dailyPrice: 100 }));
+  });
+
+  test('rejects an unknown kind', () => {
+    const service = createRentalService();
+    assert.throws(() => service.addEquipment({ id: 'x', kind: 'kite' as unknown as 'board', dailyPrice: 100 }));
+  });
+
+  test('rejects a price that is not a non-negative integer of cents', () => {
+    const service = createRentalService();
+    assert.throws(() => service.addEquipment({ id: 'a', kind: 'board', dailyPrice: 12.5 }));
+    assert.throws(() => service.addEquipment({ id: 'b', kind: 'board', dailyPrice: -1 }));
+    assert.throws(() => service.addEquipment({ id: 'c', kind: 'board', dailyPrice: Number.NaN }));
+  });
+
+  test('rejects an id already in use', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'sail', dailyPrice: 100 }));
+  });
+});
+
+describe('quote', () => {
+  test('one day costs one daily price', () => {
+    const service = serviceWithEquipment();
+    assert.deepEqual(
+      service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+      { itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', total: 2500 },
+    );
+  });
+
+  test('several days cost the daily price times the number of days', () => {
+    const service = serviceWithEquipment();
+    const quote = service.quote({ itemId: 'sail-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+    assert.equal(quote.total, 3 * 1800);
+  });
+
+  test('accepts the millisecond form of midnight', () => {
+    const service = serviceWithEquipment();
+    const quote = service.quote({ itemId: 'sail-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z' });
+    assert.equal(quote.total, 1800);
+  });
+
+  test('does not check availability', () => {
+    const service = serviceWithEquipment();
+    service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+    const quote = service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+    assert.equal(quote.total, 2500);
+  });
+
+  test('throws for an unknown item', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() => service.quote({ itemId: 'nope', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  });
+
+  test('throws when the start is not at midnight UTC', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-01T09:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  });
+
+  test('throws when the end is not at midnight UTC', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00+01:00' }));
+  });
+
+  test('throws for a timestamp that is not a real date', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-02-30T00:00:00Z', end: '2026-03-01T00:00:00Z' }));
+  });
+
+  test('throws for a timestamp that is not ISO-8601', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: 'tomorrow', end: '2026-07-02T00:00:00Z' }));
+  });
+
+  test('throws when the end is not after the start', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+    assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-03T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  });
+});
+
+describe('book', () => {
+  test('returns the booking with the quoted total and an id', () => {
+    const service = serviceWithEquipment();
+    const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+    assert.equal(typeof booking.id, 'string');
+    assert.deepEqual(
+      { itemId: booking.itemId, start: booking.start, end: booking.end, total: booking.total },
+      { itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z', total: 5000 },
+    );
+  });
+
+  test('gives each booking its own id', () => {
+    const service = serviceWithEquipment();
+    const first = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+    const second = service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+    assert.notEqual(first.id, second.id);
+  });
+
+  test('rejects an overlapping period for the same item', () => {
+    const service = serviceWithEquipment();
+    service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+    assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-03T00:00:00Z', end: '2026-07-05T00:00:00Z' }));
+    assert.throws(() => service.book({ itemId: 'board-1', start: '2026-06-30T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+    assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' }));
+    assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' }));
+  });
+
+  test('allows periods that only touch', () => {
+    const service = serviceWithEquipment();
+    service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+    assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' }));
+  });
+
+  test('does not conflict across different items', () => {
+    const service = serviceWithEquipment();
+    service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+    assert.doesNotThrow(() => service.book({ itemId: 'sail-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  });
+
+  test('throws for an unknown item', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() => service.book({ itemId: 'nope', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  });
+
+  test('throws for a period that is not whole days', () => {
+    const service = serviceWithEquipment();
+    assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-01T12:00:00Z' }));
+    assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+  });
+
+  test('services are independent of each other', () => {
+    const first = serviceWithEquipment();
+    const second = serviceWithEquipment();
+    first.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+    assert.doesNotThrow(() => second.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+    assert.throws(() => createRentalService().quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  });
+});
