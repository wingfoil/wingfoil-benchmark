diff --git a/test/rental.test.ts b/test/rental.test.ts
index 9d52fee53f98793a45d43d1a634afba041ba0ddf..8904fe707e89b07f81d64b7c03df024da45ec08b 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -178,3 +178,70 @@ describe('book', () => {
     assert.equal(booking.itemId, 'sail-1');
   });
 });
+
+describe('availability', () => {
+  test('lists every registered item, sorted, when none is booked', () => {
+    const service = serviceWithBoard();
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+    service.addEquipment({ id: 'board-0', kind: 'board', dailyPrice: 2500 });
+
+    assert.deepEqual(service.availability({ start: DAY1, end: DAY2 }), ['board-0', 'board-1', 'sail-1']);
+  });
+
+  test('lists only the items of the given kind', () => {
+    const service = serviceWithBoard();
+    service.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 1500 });
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+
+    assert.deepEqual(service.availability({ start: DAY1, end: DAY2, kind: 'sail' }), ['sail-1', 'sail-2']);
+    assert.deepEqual(service.availability({ start: DAY1, end: DAY2, kind: 'board' }), ['board-1']);
+  });
+
+  test('leaves out an item booked for an overlapping period', () => {
+    const service = serviceWithBoard();
+    service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+    service.book({ itemId: 'board-1', start: DAY1, end: DAY3 });
+
+    assert.deepEqual(service.availability({ start: DAY2, end: DAY4 }), ['board-2']);
+    assert.deepEqual(service.availability({ start: DAY1, end: DAY2 }), ['board-2']);
+  });
+
+  test('keeps an item booked only for adjacent periods', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: DAY1, end: DAY2 });
+    service.book({ itemId: 'board-1', start: DAY3, end: DAY4 });
+
+    assert.deepEqual(service.availability({ start: DAY2, end: DAY3 }), ['board-1']);
+  });
+
+  test('returns an empty array when nothing is free or nothing is registered', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: DAY1, end: DAY4 });
+
+    assert.deepEqual(service.availability({ start: DAY2, end: DAY3 }), []);
+    assert.deepEqual(service.availability({ start: DAY1, end: DAY2, kind: 'sail' }), []);
+    assert.deepEqual(createRentalService().availability({ start: DAY1, end: DAY2 }), []);
+  });
+
+  test('throws for a kind that is not board or sail', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.availability({ start: DAY1, end: DAY2, kind: 'wetsuit' as 'board' }));
+  });
+
+  test('throws when the period is not whole UTC days or does not run forward', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.availability({ start: '2026-07-01T09:00:00Z', end: DAY2 }));
+    assert.throws(() => service.availability({ start: DAY1, end: '2026-07-02T12:00:00Z' }));
+    assert.throws(() => service.availability({ start: DAY1, end: 'not-a-date' }));
+    assert.throws(() => service.availability({ start: DAY2, end: DAY2 }));
+    assert.throws(() => service.availability({ start: DAY2, end: DAY1 }));
+  });
+
+  test('does not book anything, so a free period can still be booked', () => {
+    const service = serviceWithBoard();
+    assert.deepEqual(service.availability({ start: DAY1, end: DAY2 }), ['board-1']);
+
+    assert.equal(service.book({ itemId: 'board-1', start: DAY1, end: DAY2 }).total, 2500);
+    assert.deepEqual(service.availability({ start: DAY1, end: DAY2 }), []);
+  });
+});
