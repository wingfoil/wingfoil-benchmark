+
+describe('cancel', () => {
+  const HOURLY_START = '2026-07-01T09:00:00Z';
+  const HOURLY_END = '2026-07-01T12:00:00Z';
+
+  test('refunds the full total when cancelled at least 24 hours before the start', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY2, end: DAY3 });
+
+    assert.deepEqual(service.cancel(booking.id, '2026-07-01T00:00:00Z'), { bookingId: booking.id, refund: 2500 });
+  });
+
+  test('counts exactly 24 hours before the start as at least 24 hours', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY2, end: DAY3 });
+
+    assert.equal(service.cancel(booking.id, '2026-07-01T00:00:00Z').refund, 2500);
+  });
+
+  test('refunds nothing when cancelled less than 24 hours before the start', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY2, end: DAY3 });
+
+    assert.equal(service.cancel(booking.id, '2026-07-01T00:00:01Z').refund, 0);
+  });
+
+  test('refunds nothing when cancelled after the start', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY2, end: DAY3 });
+
+    assert.equal(service.cancel(booking.id, '2026-07-02T08:00:00Z').refund, 0);
+  });
+
+  test('refunds the hourly total of a cancelled hourly booking under the same rule', () => {
+    const service = serviceWithBoard(2500, 1000);
+    const booking = service.book({ itemId: 'board-1', start: HOURLY_START, end: HOURLY_END });
+
+    assert.equal(service.cancel(booking.id, '2026-06-30T09:00:00Z').refund, 3000);
+    const late = service.book({ itemId: 'board-1', start: '2026-07-02T09:00:00Z', end: '2026-07-02T10:00:00Z' });
+    assert.equal(service.cancel(late.id, '2026-07-02T08:59:00Z').refund, 0);
+  });
+
+  test('refunds the discounted total of a long rental', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY1, end: DAY4 });
+
+    assert.equal(service.cancel(booking.id, '2026-06-01T00:00:00Z').refund, 6750);
+  });
+
+  test('frees the equipment so an overlapping period can be booked and listed as free', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY1, end: DAY2 });
+    assert.throws(() => service.book({ itemId: 'board-1', start: DAY1, end: DAY2 }));
+
+    service.cancel(booking.id, '2026-06-01T00:00:00Z');
+
+    assert.deepEqual(service.availability({ start: DAY1, end: DAY2 }), ['board-1']);
+    assert.equal(service.book({ itemId: 'board-1', start: DAY1, end: DAY2 }).total, 2500);
+  });
+
+  test('throws for a booking id that does not exist, and changes nothing', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY1, end: DAY2 });
+
+    assert.throws(() => service.cancel('booking-99', '2026-06-01T00:00:00Z'));
+    assert.deepEqual(service.availability({ start: DAY1, end: DAY2 }), []);
+    assert.equal(service.cancel(booking.id, '2026-06-01T00:00:00Z').refund, 2500);
+  });
+
+  test('throws when the booking was already cancelled, and keeps the first result', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY2, end: DAY3 });
+    service.cancel(booking.id, '2026-06-01T00:00:00Z');
+
+    assert.throws(() => service.cancel(booking.id, '2026-06-01T00:00:00Z'));
+    assert.throws(() => service.cancel(booking.id, '2026-07-01T23:00:00Z'));
+    assert.deepEqual(service.availability({ start: DAY2, end: DAY3 }), ['board-1']);
+  });
+
+  test('throws for an at that is not a UTC ISO-8601 instant, and changes nothing', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY2, end: DAY3 });
+
+    assert.throws(() => service.cancel(booking.id, '2026-06-01'));
+    assert.throws(() => service.cancel(booking.id, '2026-06-01T00:00:00+02:00'));
+    assert.throws(() => service.cancel(booking.id, '2026-02-30T00:00:00Z'));
+    assert.throws(() => service.cancel(booking.id, 'not-a-date'));
+    assert.deepEqual(service.availability({ start: DAY2, end: DAY3 }), []);
+    assert.equal(service.cancel(booking.id, '2026-06-01T00:00:00Z').refund, 2500);
+  });
+
+  test('accepts an at with fractional seconds', () => {
+    const service = serviceWithBoard();
+    const late = service.book({ itemId: 'board-1', start: DAY2, end: DAY3 });
+    const early = service.book({ itemId: 'board-1', start: DAY3, end: DAY4 });
+
+    assert.equal(service.cancel(late.id, '2026-07-01T00:00:00.500Z').refund, 0);
+    assert.equal(service.cancel(early.id, '2026-07-01T00:00:00.500Z').refund, 2500);
+  });
+});
