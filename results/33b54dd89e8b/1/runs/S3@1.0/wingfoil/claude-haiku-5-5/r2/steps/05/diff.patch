 /**
  * Returns the instant of a UTC hour given as an ISO-8601 string, or throws if it is not one.
  * `Date.UTC` rolls an impossible date or hour such as February 30 or 24:00 over, so the parts are checked back.
@@ -110,6 +129,32 @@ function parseHour(value: string, name: string): number {
