+
+    cancel(bookingId: string, at: string): Cancellation {
+      const booking = booked.find((other) => other.id === bookingId);
+      if (booking === undefined) {
+        throw new Error(`unknown booking ${bookingId}`);
+      }
+      const atMs = parseInstant(at, 'at');
+      if (booking.cancelled) {
+        throw new Error(`booking ${bookingId} is already cancelled`);
+      }
+      const refund = booking.period.startMs - atMs >= FULL_REFUND_NOTICE_MS ? booking.total : 0;
+      booking.cancelled = true;
+      return { bookingId, refund };
+    },
   };
 }
