+/**
+ * Returns the instant of a UTC time given as an ISO-8601 string with a `Z` suffix, fractional seconds allowed, or throws
+ * if it is not one. Impossible dates are rejected as `parseHour` rejects them.
+ */
+function parseInstant(value: string, name: string): number {
+  const match = UTC_INSTANT.exec(value);
+  if (match === null) {
+    throw new Error(`${name} must be a UTC ISO-8601 instant with a Z suffix, got ${value}`);
+  }
+  const [year, month, day, hour, minute, second] = match.slice(1, 7).map(Number);
+  const fraction = match[7] === undefined ? 0 : Number(match[7]) * 1000;
+  const ms = Date.UTC(year, month - 1, day, hour, minute, second) + fraction;
+  const date = new Date(ms);
+  if (
+    date.getUTCFullYear() !== year ||
+    date.getUTCMonth() !== month - 1 ||
+    date.getUTCDate() !== day ||
+    date.getUTCHours() !== hour ||
+    date.getUTCMinutes() !== minute ||
+    date.getUTCSeconds() !== second
+  ) {
+    throw new Error(`${name} is not a date and time that exist, got ${value}`);
+  }
+  return ms;
+}
