@@ -0,0 +1,159 @@
+/**
+ * The booking desk's rental module, kept in memory.
+ *
+ * Money is an integer number of euro cents. Times are UTC ISO-8601 strings, and a rental covers
+ * whole days: it starts and ends at midnight UTC, and it ends at the start of the day after its last day.
+ */
+
+/** The kinds of equipment the school rents. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item. `dailyPrice` is the price of one day of rental, in euro cents. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** A request to rent an item for the whole days from `start` up to `end`. */
+export interface PeriodRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The price of renting an item for a period, in euro cents. */
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  total: number;
+}
+
+/** A booked period. `id` identifies the booking. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** The rental module's service: its equipment register, price quotes and bookings. */
+export interface RentalService {
+  /** Registers an item. Throws for an invalid item or an `id` that is already registered. */
+  addEquipment(item: Equipment): void;
+  /** Prices renting an item for a period. Throws for an unknown item or a period the rules do not allow. */
+  quote(request: PeriodRequest): Quote;
+  /** Books an item for a period. Throws as `quote` does, and when the item is already booked for an overlapping period. */
+  book(request: PeriodRequest): Booking;
+}
+
+interface Period {
+  startMs: number;
+  endMs: number;
+}
+
+interface BookedPeriod {
+  itemId: string;
+  period: Period;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+const KINDS: readonly string[] = ['board', 'sail'];
+
+const UTC_MIDNIGHT = /^(\d{4})-(\d{2})-(\d{2})T00:00:00(?:\.000)?Z$/;
+
+/**
+ * Returns the instant of a UTC midnight given as an ISO-8601 string, or throws if it is not one.
+ * `Date.UTC` rolls an impossible date such as February 30 over into March, so the parts are checked back.
+ */
+function parseMidnight(value: string, name: string): number {
+  const match = UTC_MIDNIGHT.exec(value);
+  if (match === null) {
+    throw new Error(`${name} must be a UTC midnight ISO-8601 string, got ${value}`);
+  }
+  const year = Number(match[1]);
+  const month = Number(match[2]);
+  const day = Number(match[3]);
+  const ms = Date.UTC(year, month - 1, day);
+  const date = new Date(ms);
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
+    throw new Error(`${name} is not a date that exists, got ${value}`);
+  }
+  return ms;
+}
+
+function parsePeriod(request: PeriodRequest): Period {
+  const startMs = parseMidnight(request.start, 'start');
+  const endMs = parseMidnight(request.end, 'end');
+  if (endMs <= startMs) {
+    throw new Error(`end must be after start, got ${request.start} to ${request.end}`);
+  }
+  return { startMs, endMs };
+}
+
+/** Creates an empty rental service. Booking ids follow a fixed sequence, so a fresh service gives the same ids. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const booked: Array<BookedPeriod & { id: string }> = [];
+
+  function findItem(itemId: string): Equipment {
+    const item = equipment.get(itemId);
+    if (item === undefined) {
+      throw new Error(`unknown item ${itemId}`);
+    }
+    return item;
+  }
+
+  function priceOf(item: Equipment, period: Period): number {
+    return ((period.endMs - period.startMs) / DAY_MS) * item.dailyPrice;
+  }
+
+  return {
+    addEquipment(item: Equipment): void {
+      if (typeof item.id !== 'string' || item.id === '') {
+        throw new Error('item id must be a non-empty string');
+      }
+      if (!KINDS.includes(item.kind)) {
+        throw new Error(`item kind must be board or sail, got ${item.kind}`);
+      }
+      if (!Number.isInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error(`daily price must be a non-negative integer of euro cents, got ${item.dailyPrice}`);
+      }
+      if (equipment.has(item.id)) {
+        throw new Error(`item ${item.id} is already registered`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request: PeriodRequest): Quote {
+      const item = findItem(request.itemId);
+      const period = parsePeriod(request);
+      return {
+        itemId: item.id,
+        start: request.start,
+        end: request.end,
+        total: priceOf(item, period),
+      };
+    },
+
+    book(request: PeriodRequest): Booking {
+      const item = findItem(request.itemId);
+      const period = parsePeriod(request);
+      const clashes = booked.some(
+        (other) =>
+          other.itemId === item.id && other.period.startMs < period.endMs && period.startMs < other.period.endMs,
+      );
+      if (clashes) {
+        throw new Error(`item ${item.id} is already booked for an overlapping period`);
+      }
+      const id = `booking-${booked.length + 1}`;
+      booked.push({ id, itemId: item.id, period });
+      return {
+        id,
+        itemId: item.id,
+        start: request.start,
+        end: request.end,
+        total: priceOf(item, period),
+      };
+    },
+  };
+}
diff --git a/test/rental.test.ts b/test/rental.test.ts
