index 0000000000000000000000000000000000000000..9d52fee53f98793a45d43d1a634afba041ba0ddf
--- /dev/null
+++ b/test/rental.test.ts
@@ -0,0 +1,180 @@
+import { describe, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+const DAY1 = '2026-07-01T00:00:00Z';
+const DAY2 = '2026-07-02T00:00:00Z';
+const DAY3 = '2026-07-03T00:00:00Z';
+const DAY4 = '2026-07-04T00:00:00Z';
+
+function serviceWithBoard(dailyPrice = 2500) {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice });
+  return service;
+}
+
+describe('addEquipment', () => {
+  test('registers a board and a sail so they can be quoted', () => {
+    const service = createRentalService();
+    service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+
+    assert.equal(service.quote({ itemId: 'board-1', start: DAY1, end: DAY2 }).total, 2500);
+    assert.equal(service.quote({ itemId: 'sail-1', start: DAY1, end: DAY2 }).total, 1500);
+  });
+
+  test('rejects an item id that is already registered', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'sail', dailyPrice: 900 }));
+  });
+
+  test('rejects an unknown kind', () => {
+    const service = createRentalService();
+    assert.throws(() =>
+      service.addEquipment({ id: 'x-1', kind: 'wetsuit' as 'board', dailyPrice: 900 }),
+    );
+  });
+
+  test('rejects an empty or non-string id', () => {
+    const service = createRentalService();
+    assert.throws(() => service.addEquipment({ id: '', kind: 'board', dailyPrice: 900 }));
+    assert.throws(() =>
+      service.addEquipment({ id: 7 as unknown as string, kind: 'board', dailyPrice: 900 }),
+    );
+  });
+
+  test('rejects a daily price that is negative, fractional or not a number', () => {
+    const service = createRentalService();
+    assert.throws(() => service.addEquipment({ id: 'a', kind: 'board', dailyPrice: -1 }));
+    assert.throws(() => service.addEquipment({ id: 'b', kind: 'board', dailyPrice: 12.5 }));
+    assert.throws(() =>
+      service.addEquipment({ id: 'c', kind: 'board', dailyPrice: '25' as unknown as number }),
+    );
+  });
+});
+
+describe('quote', () => {
+  test('returns the total as days times the daily price', () => {
+    const service = serviceWithBoard(2500);
+    assert.deepEqual(service.quote({ itemId: 'board-1', start: DAY1, end: DAY4 }), {
+      itemId: 'board-1',
+      start: DAY1,
+      end: DAY4,
+      total: 7500,
+    });
+  });
+
+  test('prices a single whole day', () => {
+    const service = serviceWithBoard(2500);
+    assert.equal(service.quote({ itemId: 'board-1', start: DAY1, end: DAY2 }).total, 2500);
+  });
+
+  test('throws for an unknown item', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.quote({ itemId: 'nope', start: DAY1, end: DAY2 }));
+  });
+
+  test('throws when the start is not at midnight UTC', () => {
+    const service = serviceWithBoard();
+    assert.throws(() =>
+      service.quote({ itemId: 'board-1', start: '2026-07-01T09:00:00Z', end: DAY2 }),
+    );
+  });
+
+  test('throws when the end is not at midnight UTC', () => {
+    const service = serviceWithBoard();
+    assert.throws(() =>
+      service.quote({ itemId: 'board-1', start: DAY1, end: '2026-07-02T12:00:00Z' }),
+    );
+  });
+
+  test('throws when the times are not UTC', () => {
+    const service = serviceWithBoard();
+    assert.throws(() =>
+      service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00+02:00', end: DAY2 }),
+    );
+  });
+
+  test('throws when the end is not after the start', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: DAY2, end: DAY2 }));
+    assert.throws(() => service.quote({ itemId: 'board-1', start: DAY2, end: DAY1 }));
+  });
+
+  test('throws for a date that does not exist', () => {
+    const service = serviceWithBoard();
+    assert.throws(() =>
+      service.quote({ itemId: 'board-1', start: '2026-02-30T00:00:00Z', end: DAY2 }),
+    );
+    assert.throws(() => service.quote({ itemId: 'board-1', start: 'not-a-date', end: DAY2 }));
+  });
+});
+
+describe('book', () => {
+  test('books the item and returns the quoted total with an id', () => {
+    const service = serviceWithBoard(2500);
+    const quote = service.quote({ itemId: 'board-1', start: DAY1, end: DAY3 });
+    const booking = service.book({ itemId: 'board-1', start: DAY1, end: DAY3 });
+
+    assert.equal(typeof booking.id, 'string');
+    assert.equal(booking.id.length > 0, true);
+    assert.deepEqual({ ...booking, id: undefined }, { ...quote, id: undefined });
+  });
+
+  test('gives each booking its own id, the same sequence on every fresh service', () => {
+    const first = serviceWithBoard();
+    const second = serviceWithBoard();
+
+    const a = first.book({ itemId: 'board-1', start: DAY1, end: DAY2 });
+    const b = first.book({ itemId: 'board-1', start: DAY2, end: DAY3 });
+    const c = second.book({ itemId: 'board-1', start: DAY1, end: DAY2 });
+
+    assert.notEqual(a.id, b.id);
+    assert.equal(a.id, c.id);
+  });
+
+  test('throws for an unknown item', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.book({ itemId: 'nope', start: DAY1, end: DAY2 }));
+  });
+
+  test('throws for a period the rules do not allow', () => {
+    const service = serviceWithBoard();
+    assert.throws(() =>
+      service.book({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: DAY2 }),
+    );
+    assert.throws(() => service.book({ itemId: 'board-1', start: DAY2, end: DAY1 }));
+  });
+
+  test('throws when the item is already booked for an overlapping period', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: DAY1, end: DAY3 });
+
+    assert.throws(() => service.book({ itemId: 'board-1', start: DAY2, end: DAY4 }));
+    assert.throws(() => service.book({ itemId: 'board-1', start: DAY1, end: DAY2 }));
+  });
+
+  test('throws when a new period lies wholly inside an existing booking', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: DAY1, end: DAY4 });
+
+    assert.throws(() => service.book({ itemId: 'board-1', start: DAY2, end: DAY3 }));
+  });
+
+  test('accepts a period that starts on the day the previous booking ends', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: DAY1, end: DAY2 });
+
+    const next = service.book({ itemId: 'board-1', start: DAY2, end: DAY3 });
+    assert.equal(next.total, 2500);
+  });
+
+  test('accepts an overlapping period for a different item', () => {
+    const service = serviceWithBoard();
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+    service.book({ itemId: 'board-1', start: DAY1, end: DAY3 });
+
+    const booking = service.book({ itemId: 'sail-1', start: DAY1, end: DAY3 });
+    assert.equal(booking.itemId, 'sail-1');
+  });
+});
