@@ -129,3 +129,26 @@ test('hourly periods must be on the hour and under a day, longer ones on midnigh
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
   assert.throws(() => s.addEquipment({ id: 'y', kind: 'sail', dailyPrice: 1, hourlyPrice: 1.5 }));
 });
+
+test('cancel refunds in full at least 24 hours before the start, nothing later', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(10), end: d(12) });
+  assert.deepEqual(s.cancel(a.id, '2026-07-09T00:00:00Z'), { bookingId: a.id, refund: a.total });
+  const b = s.book({ itemId: 'b1', start: d(10), end: d(12) });
+  assert.deepEqual(s.cancel(b.id, '2026-07-09T01:00:00Z'), { bookingId: b.id, refund: 0 });
+  const c = s.book({ itemId: 'b1', start: d(10), end: d(12) });
+  assert.equal(s.cancel(c.id, '2026-07-11T00:00:00Z').refund, 0);
+});
+
+test('a cancelled booking frees its equipment, ids are not reused, and it cancels once', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(10), end: d(12) });
+  s.cancel(a.id, '2026-07-01T00:00:00Z');
+  assert.ok(s.availability({ start: d(10), end: d(12) }).includes('b1'));
+  const b = s.book({ itemId: 'b1', start: d(10), end: d(12) });
+  assert.notEqual(a.id, b.id);
+  assert.throws(() => s.cancel(a.id, '2026-07-02T00:00:00Z'));
+  assert.throws(() => s.cancel('nope', '2026-07-02T00:00:00Z'));
+  assert.throws(() => s.cancel(b.id, '2026-07-02T00:30:00Z'));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(11), end: d(13) }));
+});
