@@ -0,0 +1,94 @@
+/** Kinds of equipment the school rents out. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item. `dailyPrice` is an integer number of euro cents per day. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** A rental period: ISO-8601 UTC midnights, `end` being the start of the day after the last day. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The cost of renting an item for a period; `total` is in euro cents. */
+export interface Quote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed booking; `total` is in euro cents. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** In-memory rental service of the booking desk. */
+export interface RentalService {
+  /** Registers an item for rental; throws on invalid or duplicate items. */
+  addEquipment(item: Equipment): void;
+  /** Prices a rental; throws for an unknown item or a disallowed period. */
+  quote(request: RentalRequest): Quote;
+  /** Books an item; throws like `quote`, and when the item is taken during the period. */
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00:00(?:\.0+)?Z$/;
+
+/** Parses a midnight-UTC ISO-8601 string to epoch milliseconds, or throws. */
+function parseMidnight(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC midnight such as 2026-07-01T00:00:00Z`);
+  }
+  const ms = Date.parse(value);
+  // Rejects dates that do not exist, such as February 30th.
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a valid date`);
+  }
+  return ms;
+}
+
+/** Creates an empty in-memory rental service. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Array<Booking & { from: number; to: number }> = [];
+
+  function price(request: RentalRequest): { quote: Quote; from: number; to: number } {
+    const item = equipment.get(request?.itemId);
+    if (!item) throw new Error(`unknown item: ${String(request?.itemId)}`);
+    const from = parseMidnight(request.start, 'start');
+    const to = parseMidnight(request.end, 'end');
+    if (to <= from) throw new Error('end must be after start');
+    const days = (to - from) / DAY_MS;
+    const { itemId, start, end } = request;
+    return { quote: { itemId, start, end, total: days * item.dailyPrice }, from, to };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item?.id !== 'string' || item.id === '') throw new Error('id must be a non-empty string');
+      if (item.kind !== 'board' && item.kind !== 'sail') throw new Error("kind must be 'board' or 'sail'");
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+      }
+      if (equipment.has(item.id)) throw new Error(`item already exists: ${item.id}`);
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, from, to } = price(request);
+      const taken = bookings.some((b) => b.itemId === quote.itemId && from < b.to && b.from < to);
+      if (taken) throw new Error(`${quote.itemId} is not free for the whole period`);
+      const booking = { id: `booking-${bookings.length + 1}`, ...quote };
+      bookings.push({ ...booking, from, to });
+      return booking;
+    },
+  };
+}
