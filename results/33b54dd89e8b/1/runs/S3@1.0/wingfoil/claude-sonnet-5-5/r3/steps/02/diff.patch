index ca0f73f2a08df04acc67ce798a0a1d14a755448f..6b796bff32e175edd6f40fbd09bbcd866c004ef0 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -49,3 +49,27 @@ test('addEquipment validates items', () => {
   assert.throws(() => s.addEquipment({ id: 'z', kind: 'boat' as never, dailyPrice: 1 }));
   assert.throws(() => s.addEquipment({ id: 'z', kind: 'board', dailyPrice: 12.5 }));
 });
+
+test('availability lists free items of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 1 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.deepEqual(s.availability({ start: d(2), end: d(4) }), ['a0', 's1']);
+  assert.deepEqual(s.availability({ start: d(2), end: d(4), kind: 'board' }), ['a0']);
+  assert.deepEqual(s.availability({ start: d(2), end: d(4), kind: 'sail' }), ['s1']);
+});
+
+test('availability treats adjacent bookings as free', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.deepEqual(s.availability({ start: d(3), end: d(4) }), ['b1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(2) }), []);
+});
+
+test('availability rejects bad periods and kinds', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: d(2), end: d(2) }));
+  assert.throws(() => s.availability({ start: '2026-07-01T10:00:00Z', end: d(2) }));
+  assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'boat' as never }));
+});
