+
+test('rentals under a day are priced per hour', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 3000, hourlyPrice: 700 });
+  const t = (h: string) => `2026-07-01T${h}:00:00Z`;
+  assert.equal(s.quote({ itemId: 'h1', start: t('13'), end: t('14') }).total, 700);
+  assert.equal(s.quote({ itemId: 'h1', start: t('09'), end: t('13') }).total, 2800);
+  assert.equal(s.quote({ itemId: 'h1', start: t('00'), end: t('23') }).total, 16100);
+  assert.equal(s.quote({ itemId: 'h1', start: t('20'), end: '2026-07-02T02:00:00Z' }).total, 4200);
+  assert.equal(s.book({ itemId: 'h1', start: t('13'), end: t('15') }).total, 1400);
+});
+
+test('hourly bookings conflict only when they overlap', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 3000, hourlyPrice: 700 });
+  s.book({ itemId: 'h1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T15:00:00Z' });
+  s.book({ itemId: 'h1', start: '2026-07-01T15:00:00Z', end: '2026-07-01T16:00:00Z' });
+  assert.throws(() => s.book({ itemId: 'h1', start: '2026-07-01T14:00:00Z', end: '2026-07-01T15:00:00Z' }));
+  assert.throws(() => s.book({ itemId: 'h1', start: d(1), end: d(2) }));
+});
+
+test('items without an hourly price cannot be rented by the hour', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' }));
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 3000, hourlyPrice: 700 });
+  assert.deepEqual(s.availability({ start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' }), ['h1']);
+});
+
+test('hourly periods must be on the hour and under a day, longer ones on midnights', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 3000, hourlyPrice: 700 });
+  const q = (start: string, end: string) => () => s.quote({ itemId: 'h1', start, end });
+  assert.throws(q('2026-07-01T10:30:00Z', '2026-07-01T12:00:00Z'));
+  assert.throws(q('2026-07-01T10:00:00Z', '2026-07-01T10:00:00Z'));
+  assert.throws(q('2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z'));
+  assert.throws(q('2026-07-01T10:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: 'y', kind: 'sail', dailyPrice: 1, hourlyPrice: 1.5 }));
+});
