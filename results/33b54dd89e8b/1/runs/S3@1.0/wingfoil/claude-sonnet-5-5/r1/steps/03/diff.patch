+/** Total in euro cents; the long-stay price is rounded to the nearest cent, halves up. */
+function totalFor(days: number, dailyPrice: number): number {
+  const full = days * dailyPrice;
+  return days >= LONG_STAY_DAYS ? Math.round((full * LONG_STAY_PERCENT) / 100) : full;
+}
