+---
+id: task-001-rental-module-equipment-quote-book
+type: task
+title: "Rental module: equipment, quote, book"
+status: approved
+format: 1
+---
+
+# Rental module: equipment, quote, book
+
+Export `createRentalService()` from `src/index.ts`: an in-memory service with `addEquipment`, `quote` and `book`.
+
+- `addEquipment({ id, kind: 'board' | 'sail', dailyPrice })`
+- `quote({ itemId, start, end })` returns `{ itemId, start, end, total }`
+- `book({ itemId, start, end })` returns `{ id, itemId, start, end, total }`
+- `quote` and `book` throw for an unknown item or a disallowed period; `book` also throws when the item is not free for the whole period.
+
+School rules: money in integer euro cents; times in UTC ISO-8601; whole days only (midnight UTC to midnight UTC, end is the start of the day after the last day); no overlapping bookings of one item; cancellation policy (no refund under 24 h before start, otherwise full refund) is out of scope: cancellations are not implemented yet.
diff --git a/src/index.test.ts b/src/index.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fd9284aa879e9abfb8bf99f811ee15cd9b290a7f
--- /dev/null
+++ b/src/index.test.ts
@@ -0,0 +1,60 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2550 });
+  return s;
+}
+const req = (start: string, end: string, itemId = 'b1') => ({ itemId, start, end });
+
+test('quote prices whole days in cents', () => {
+  const q = setup().quote(req('2026-07-01T00:00:00Z', '2026-07-04T00:00:00Z'));
+  assert.deepEqual(q, { itemId: 'b1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z', total: 7650 });
+});
+
+test('quote rejects unknown item, non-midnight, bad order, bad format', () => {
+  const s = setup();
+  assert.throws(() => s.quote(req('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z', 'x')));
+  assert.throws(() => s.quote(req('2026-07-01T10:00:00Z', '2026-07-02T00:00:00Z')));
+  assert.throws(() => s.quote(req('2026-07-01T00:00:00+02:00', '2026-07-02T00:00:00Z')));
+  assert.throws(() => s.quote(req('2026-07-02T00:00:00Z', '2026-07-02T00:00:00Z')));
+  assert.throws(() => s.quote(req('2026-07-03T00:00:00Z', '2026-07-02T00:00:00Z')));
+  assert.throws(() => s.quote(req('2026-02-30T00:00:00Z', '2026-03-02T00:00:00Z')));
+});
+
+test('book returns a booking with distinct ids', () => {
+  const s = setup();
+  const a = s.book(req('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z'));
+  const b = s.book(req('2026-07-02T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.equal(a.total, 2550);
+  assert.equal(a.itemId, 'b1');
+  assert.notEqual(a.id, b.id);
+});
+
+test('book refuses overlaps but allows back-to-back and other items', () => {
+  const s = setup();
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  s.book(req('2026-07-02T00:00:00Z', '2026-07-05T00:00:00Z'));
+  assert.throws(() => s.book(req('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z')));
+  assert.throws(() => s.book(req('2026-07-04T00:00:00Z', '2026-07-06T00:00:00Z')));
+  assert.throws(() => s.book(req('2026-07-01T00:00:00Z', '2026-07-06T00:00:00Z')));
+  s.book(req('2026-07-05T00:00:00Z', '2026-07-06T00:00:00Z'));
+  s.book(req('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z'));
+  s.book(req('2026-07-02T00:00:00Z', '2026-07-05T00:00:00Z', 's1'));
+});
+
+test('quote does not reserve; invalid book does not reserve', () => {
+  const s = setup();
+  s.quote(req('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z'));
+  s.book(req('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z'));
+  assert.throws(() => s.book(req('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z')));
+});
+
+test('addEquipment validates input', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'b2', kind: 'boat' as 'board', dailyPrice: 1 }));
+});
diff --git a/src/index.ts b/src/index.ts
