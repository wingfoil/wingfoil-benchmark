@@ -128,3 +128,35 @@ test('addEquipment validates hourlyPrice', () => {
   assert.throws(() => s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
   assert.throws(() => s.addEquipment({ id: 'b3', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
 });
+
+test('cancel refunds in full 24 h or more before the start, nothing later', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2550, hourlyPrice: 700 });
+  const a = s.book(req('2026-07-02T00:00:00Z', '2026-07-03T00:00:00Z', 'b2'));
+  assert.deepEqual(s.cancel(a.id, '2026-07-01T00:00:00Z'), { bookingId: a.id, refund: 2550 });
+  const b = s.book(req('2026-07-02T00:00:00Z', '2026-07-03T00:00:00Z', 'b2'));
+  assert.deepEqual(s.cancel(b.id, '2026-07-01T01:00:00Z'), { bookingId: b.id, refund: 0 });
+  const c = s.book(req('2026-07-02T00:00:00Z', '2026-07-03T00:00:00Z', 'b2'));
+  assert.equal(s.cancel(c.id, '2026-07-02T05:00:00Z').refund, 0);
+});
+
+test('a cancelled booking frees its equipment and ids stay unique', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2550 });
+  const a = s.book(req('2026-07-02T00:00:00Z', '2026-07-03T00:00:00Z', 'b2'));
+  s.cancel(a.id, '2026-06-01T00:00:00Z');
+  assert.deepEqual(s.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' }), ['b2']);
+  const b = s.book(req('2026-07-02T00:00:00Z', '2026-07-03T00:00:00Z', 'b2'));
+  assert.notEqual(b.id, a.id);
+});
+
+test('a booking can be cancelled once; unknown bookings and bad times are refused', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2550 });
+  const a = s.book(req('2026-07-02T00:00:00Z', '2026-07-03T00:00:00Z', 'b2'));
+  assert.throws(() => s.cancel(a.id, 'tomorrow'));
+  assert.throws(() => s.cancel(a.id, '2026-06-01T00:30:00Z'));
+  assert.throws(() => s.cancel('nope', '2026-06-01T00:00:00Z'));
+  s.cancel(a.id, '2026-06-01T00:00:00Z');
+  assert.throws(() => s.cancel(a.id, '2026-06-01T00:00:00Z'), /already cancelled/);
+});
