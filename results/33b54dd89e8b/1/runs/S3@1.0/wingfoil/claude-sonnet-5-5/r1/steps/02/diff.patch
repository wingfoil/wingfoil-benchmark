@@ -58,3 +58,22 @@ test('addEquipment validates input', () => {
   assert.throws(() => s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 1.5 }));
   assert.throws(() => s.addEquipment({ id: 'b2', kind: 'boat' as 'board', dailyPrice: 1 }));
 });
+
+test('availability lists free items of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'b0', kind: 'board', dailyPrice: 1 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1 });
+  s.book(req('2026-07-02T00:00:00Z', '2026-07-05T00:00:00Z'));
+  const q = { start: '2026-07-04T00:00:00Z', end: '2026-07-06T00:00:00Z' };
+  assert.deepEqual(s.availability({ ...q, kind: 'board' }), ['b0']);
+  assert.deepEqual(s.availability(q), ['b0', 's1']);
+  assert.deepEqual(s.availability({ start: '2026-07-05T00:00:00Z', end: '2026-07-06T00:00:00Z', kind: 'board' }), ['b0', 'b1']);
+  assert.deepEqual(s.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'sail' }), ['s1']);
+});
+
+test('availability rejects bad periods and unknown kinds', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.throws(() => s.availability({ start: '2026-07-01T10:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.throws(() => s.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'boat' as 'board' }));
+});
