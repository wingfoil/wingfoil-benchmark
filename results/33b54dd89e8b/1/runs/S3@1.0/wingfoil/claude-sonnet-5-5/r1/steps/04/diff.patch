@@ -93,3 +93,38 @@ test('long-stay total is rounded to whole cents', () => {
   s.addEquipment({ id: 'd1', kind: 'board', dailyPrice: 105 });
   assert.equal(s.quote({ itemId: 'd1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' }).total, 284);
 });
+
+test('hourly rental is priced per hour', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2550, hourlyPrice: 700 });
+  const q = s.quote(req('2026-07-01T13:00:00Z', '2026-07-01T16:00:00Z', 'b2'));
+  assert.equal(q.total, 2100);
+  assert.equal(s.book(req('2026-07-01T09:00:00Z', '2026-07-01T10:00:00Z', 'b2')).total, 700);
+  assert.equal(s.quote(req('2026-07-01T20:00:00Z', '2026-07-02T09:00:00Z', 'b2')).total, 13 * 700);
+});
+
+test('hourly rental needs an hourly price and whole hours', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2550, hourlyPrice: 700 });
+  s.addEquipment({ id: 'b3', kind: 'board', dailyPrice: 2550 });
+  assert.throws(() => s.quote(req('2026-07-01T13:00:00Z', '2026-07-01T16:00:00Z', 'b3')));
+  assert.throws(() => s.quote(req('2026-07-01T13:30:00Z', '2026-07-01T16:00:00Z', 'b2')));
+  assert.throws(() => s.quote(req('2026-07-01T13:00:00Z', '2026-07-01T16:00:30Z', 'b2')));
+  assert.throws(() => s.quote(req('2026-07-01T16:00:00Z', '2026-07-01T16:00:00Z', 'b2')));
+  assert.throws(() => s.quote(req('2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z', 'b2')));
+});
+
+test('hourly bookings conflict with overlapping ones only', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2550, hourlyPrice: 700 });
+  s.book(req('2026-07-01T13:00:00Z', '2026-07-01T15:00:00Z', 'b2'));
+  assert.throws(() => s.book(req('2026-07-01T14:00:00Z', '2026-07-01T16:00:00Z', 'b2')));
+  assert.throws(() => s.book(req('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z', 'b2')));
+  s.book(req('2026-07-01T15:00:00Z', '2026-07-01T16:00:00Z', 'b2'));
+});
+
+test('addEquipment validates hourlyPrice', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'b3', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+});
