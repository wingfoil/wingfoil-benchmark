   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10, hourlyPrice: 1.5 }));
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10, hourlyPrice: -1 }));
