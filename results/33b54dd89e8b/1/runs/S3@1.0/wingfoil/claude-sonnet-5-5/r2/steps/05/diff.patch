+
+test('cancel refunds in full at least 24 hours before start, nothing after', () => {
+  const s = setup();
+  const early = s.book(r('b1', D2, D4));
+  assert.deepEqual(s.cancel(early.id, '2026-07-01T00:00:00Z'), { bookingId: early.id, refund: early.total });
+  const late = s.book(r('b1', D2, D4));
+  assert.deepEqual(s.cancel(late.id, '2026-07-01T00:00:01Z'), { bookingId: late.id, refund: 0 });
+  const started = s.book(r('s1', D2, D4));
+  assert.equal(s.cancel(started.id, '2026-07-04T00:00:00Z').refund, 0);
+});
+
+test('a cancelled booking frees its equipment and cannot be cancelled twice', () => {
+  const s = setup();
+  const b = s.book(r('b1', D2, D4));
+  assert.ok(!s.availability({ start: D2, end: D4 }).includes('b1'));
+  s.cancel(b.id, D1);
+  assert.ok(s.availability({ start: D2, end: D4 }).includes('b1'));
+  s.book(r('b1', D2, D4));
+  assert.throws(() => s.cancel(b.id, D1));
+});
+
+test('cancel rejects unknown bookings and invalid times', () => {
+  const s = setup();
+  const b = s.book(r('b1', D2, D4));
+  assert.throws(() => s.cancel('nope', D1));
+  assert.throws(() => s.cancel(b.id, 'yesterday'));
+  assert.throws(() => s.cancel(b.id, undefined as never));
+  assert.equal(s.cancel(b.id, D1).bookingId, b.id);
+});
