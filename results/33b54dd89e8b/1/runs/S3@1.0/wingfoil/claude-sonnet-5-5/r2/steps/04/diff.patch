+/** Parses and checks a period: whole UTC days, or under a day on UTC hours (`hourly`). */
+function parsePeriod(startValue: unknown, endValue: unknown): { start: number; end: number; hourly: boolean } {
+  const start = parseHour(startValue, 'start');
+  const end = parseHour(endValue, 'end');
+  if (end <= start) {
+    throw new Error('end must be after start');
+  }
+  if (end - start < DAY_MS) {
+    return { start, end, hourly: true };
+  }
+  if (start % DAY_MS !== 0 || end % DAY_MS !== 0) {
+    throw new Error('a rental of a day or more must be whole UTC days');
+  }
