 });
+
+test('hourly rentals are priced per hour, without the long-stay discount', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 5000, hourlyPrice: 900 });
+  s.addEquipment({ id: 'd1', kind: 'board', dailyPrice: 5000 });
+  const h = (n: number) => `2026-07-01T${String(n).padStart(2, '0')}:00:00Z`;
+  assert.equal(s.quote(r('h1', h(10), h(11))).total, 900);
+  assert.equal(s.quote(r('h1', h(9), h(21))).total, 10800);
+  assert.equal(s.quote(r('h1', h(0), h(23))).total, 20700);
+  assert.throws(() => s.quote(r('d1', h(10), h(12))));
+  assert.throws(() => s.quote(r('h1', '2026-07-01T10:30:00Z', h(12))));
+  assert.throws(() => s.quote(r('h1', h(10), '2026-07-02T10:00:00Z')));
+  assert.equal(s.quote(r('h1', D1, D2)).total, 5000);
+});
+
+test('hourly bookings block overlaps and show in availability', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 5000, hourlyPrice: 900 });
+  s.book(r('h1', '2026-07-01T10:00:00Z', '2026-07-01T12:00:00Z'));
+  assert.throws(() => s.book(r('h1', '2026-07-01T11:00:00Z', '2026-07-01T13:00:00Z')));
+  s.book(r('h1', '2026-07-01T12:00:00Z', '2026-07-01T13:00:00Z'));
+  assert.deepEqual(s.availability({ start: D1, end: D2 }), []);
+  assert.deepEqual(s.availability({ start: '2026-07-01T13:00:00Z', end: '2026-07-01T14:00:00Z' }), ['h1']);
+});
+
+test('hourlyPrice validation', () => {
+  const s = createRentalService();
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10, hourlyPrice: -1 }));
+});
