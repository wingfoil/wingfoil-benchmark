@@ -0,0 +1,66 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2550 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  return s;
+}
+const r = (itemId: string, start: string, end: string) => ({ itemId, start, end });
+const D1 = '2026-07-01T00:00:00.000Z';
+const D2 = '2026-07-02T00:00:00.000Z';
+const D4 = '2026-07-04T00:00:00.000Z';
+
+test('quote prices whole days in cents', () => {
+  assert.deepEqual(setup().quote(r('b1', D1, D4)), { ...r('b1', D1, D4), total: 7650 });
+});
+
+test('book returns an id and the quote', () => {
+  const b = setup().book(r('b1', D1, D2));
+  assert.equal(typeof b.id, 'string');
+  assert.deepEqual({ ...b, id: undefined }, { ...r('b1', D1, D2), total: 2550, id: undefined });
+});
+
+test('booking ids are unique', () => {
+  const s = setup();
+  assert.notEqual(s.book(r('b1', D1, D2)).id, s.book(r('s1', D1, D2)).id);
+});
+
+test('overlapping bookings of one item are refused, adjacent ones are not', () => {
+  const s = setup();
+  s.book(r('b1', D2, D4));
+  assert.throws(() => s.book(r('b1', D1, '2026-07-03T00:00:00Z')));
+  assert.throws(() => s.book(r('b1', D2, D4)));
+  s.book(r('b1', D1, D2));
+  s.book(r('b1', D4, '2026-07-05T00:00:00Z'));
+  s.book(r('s1', D2, D4));
+});
+
+test('quote does not reserve', () => {
+  const s = setup();
+  s.quote(r('b1', D1, D2));
+  s.book(r('b1', D1, D2));
+});
+
+test('unknown item and invalid periods throw', () => {
+  const s = setup();
+  for (const call of [s.quote, s.book]) {
+    assert.throws(() => call(r('nope', D1, D2)));
+    assert.throws(() => call(r('b1', D2, D1)));
+    assert.throws(() => call(r('b1', D1, D1)));
+    assert.throws(() => call(r('b1', '2026-07-01T10:00:00Z', D2)));
+    assert.throws(() => call(r('b1', D1, '2026-07-02T00:00:00+02:00')));
+    assert.throws(() => call(r('b1', 'garbage', D2)));
+    assert.throws(() => call(r('b1', '2026-02-30T00:00:00Z', D2)));
+  }
+});
+
+test('equipment validation', () => {
+  const s = createRentalService();
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'mast' as 'board', dailyPrice: 10 }));
+  s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10 });
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 10 }));
+});
