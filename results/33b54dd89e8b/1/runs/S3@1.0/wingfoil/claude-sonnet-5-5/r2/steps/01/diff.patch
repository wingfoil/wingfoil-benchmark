@@ -0,0 +1,110 @@
+/** The kinds of equipment the school rents. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item; `dailyPrice` is an integer number of euro cents per day. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** A rental period: UTC ISO-8601 midnights, `end` being the start of the day after the last day. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The price of renting an item for a period; `total` is in euro cents. */
+export interface Quote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed booking. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** The booking desk's in-memory rental service. */
+export interface RentalService {
+  /** Registers an item for rental; throws on an invalid item or a duplicate id. */
+  addEquipment(item: Equipment): void;
+  /** Prices a rental; throws for an unknown item or a period that is not whole UTC days. */
+  quote(request: RentalRequest): Quote;
+  /** Books an item; throws like `quote`, and when the item is taken during the period. */
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?Z$/;
+
+function parseMidnight(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC midnight, got ${String(value)}`);
+  }
+  const time = Date.parse(value);
+  if (Number.isNaN(time) || new Date(time).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a valid date: ${value}`);
+  }
+  return time;
+}
+
+/** Creates an empty rental service that keeps everything in memory. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Booking[] = [];
+  let nextBooking = 1;
+
+  function price(request: RentalRequest): { quote: Quote; start: number; end: number } {
+    const item = equipment.get(request?.itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${String(request?.itemId)}`);
+    }
+    const start = parseMidnight(request.start, 'start');
+    const end = parseMidnight(request.end, 'end');
+    if (end <= start) {
+      throw new Error('end must be after start');
+    }
+    const days = (end - start) / DAY_MS;
+    return {
+      quote: { itemId: item.id, start: request.start, end: request.end, total: days * item.dailyPrice },
+      start,
+      end,
+    };
+  }
+
+  return {
+    addEquipment(item) {
+      if (!item || typeof item.id !== 'string' || item.id === '') {
+        throw new Error('equipment id must be a non-empty string');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error(`unknown equipment kind: ${String(item.kind)}`);
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of cents');
+      }
+      if (equipment.has(item.id)) {
+        throw new Error(`equipment already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, start, end } = price(request);
+      const taken = bookings.some(
+        (b) => b.itemId === quote.itemId && Date.parse(b.start) < end && start < Date.parse(b.end),
+      );
+      if (taken) {
+        throw new Error(`${quote.itemId} is not free from ${quote.start} to ${quote.end}`);
+      }
+      const booking: Booking = { id: `booking-${nextBooking++}`, ...quote };
+      bookings.push(booking);
+      return { ...booking };
+    },
+  };
+}
