diff --git a/test/rental.test.ts b/test/rental.test.ts
index 01e36f9a5939a58c40a943bdc2173466eb5fa268..fc1c56d90ba9797a21427ca846ea1c3c51d306e6 100644
--- a/test/rental.test.ts
