@@ -64,3 +64,21 @@ test('equipment validation', () => {
   s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10 });
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 10 }));
 });
+
+test('availability lists free items of a kind or of any kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 100 });
+  s.book(r('b1', D2, D4));
+  const D3 = '2026-07-03T00:00:00Z';
+  assert.deepEqual(s.availability({ start: D1, end: D3 }), ['a0', 's1']);
+  assert.deepEqual(s.availability({ start: D1, end: D3, kind: 'board' }), ['a0']);
+  assert.deepEqual(s.availability({ start: D1, end: D2, kind: 'board' }), ['a0', 'b1']);
+  assert.deepEqual(s.availability({ start: D4, end: '2026-07-05T00:00:00Z', kind: 'board' }), ['a0', 'b1']);
+});
+
+test('availability rejects invalid queries', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: D2, end: D1 }));
+  assert.throws(() => s.availability({ start: '2026-07-01', end: D2 }));
+  assert.throws(() => s.availability({ start: D1, end: D2, kind: 'boat' as never }));
+});
