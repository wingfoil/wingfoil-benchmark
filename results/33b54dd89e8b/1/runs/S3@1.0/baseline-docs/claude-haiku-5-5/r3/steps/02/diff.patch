diff --git a/test/rental.test.ts b/test/rental.test.ts
index c4c4c64a2b349d2366a32cca0673434716fb8255..627c066f1b6113828497273a49cc2d5f68dcd60d 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -224,3 +224,94 @@ test('addEquipment refuses a daily price that is not a positive whole number of
     assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice }), /dailyPrice/);
   }
 });
+
+test('availability lists every item free for the whole period, sorted', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 1200 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1200 });
+
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' }),
+    ['board-1', 'sail-1', 'sail-2'],
+  );
+});
+
+test('availability filters by kind when one is given', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1200 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'board' }),
+    ['board-1', 'board-2'],
+  );
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'sail' }),
+    ['sail-1'],
+  );
+});
+
+test('availability leaves out an item booked for any day of the period', () => {
+  const service = serviceWithBoard();
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+  service.book({ itemId: 'board-1', start: '2026-07-05T00:00:00Z', end: '2026-07-10T00:00:00Z' });
+
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-06T00:00:00Z' }),
+    ['board-2'],
+  );
+});
+
+test('availability keeps an item whose booking only touches the period', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+
+  assert.deepEqual(
+    service.availability({ start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z' }),
+    ['board-1'],
+  );
+});
+
+test('availability does not change when a quote is made or a booking is refused', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-05T00:00:00Z', end: '2026-07-10T00:00:00Z' });
+  const query = { start: '2026-07-06T00:00:00Z', end: '2026-07-07T00:00:00Z' };
+
+  assert.throws(() => service.book({ itemId: 'board-1', ...query }));
+  service.quote({ itemId: 'board-1', ...query });
+
+  assert.deepEqual(service.availability(query), []);
+});
+
+test('availability returns an empty list when nothing is free', () => {
+  const service = createRentalService();
+
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    [],
+  );
+});
+
+test('availability refuses a period that is not whole midnight-UTC days', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(
+    () => service.availability({ start: '2026-07-01T10:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    /midnight UTC/,
+  );
+  assert.throws(
+    () => service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-01T00:00:00Z' }),
+    /at least one day/,
+  );
+});
+
+test('availability refuses a kind other than board or sail', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(
+    () => service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'wetsuit' as 'board' }),
+    /kind/,
+  );
+});
