diff --git a/test/rental.test.ts b/test/rental.test.ts
index 1b7a07e6d3253b1e3a9787a7a891049f2a359d53..45c558b264a50653363a514f1ceee72ac5866b13 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -492,3 +492,72 @@ test('book gives no discount for a rental of two days', () => {
 
   assert.equal(booking.total, 5000);
 });
+
+test('cancel returns the booking id and the total given back to the customer', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+
+  assert.deepEqual(service.cancel(booking.id, '2026-06-20T09:00:00Z'), { bookingId: booking.id, refund: 2500 });
+});
+
+test('cancel refunds the discounted total of a rental of three days or more', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+
+  assert.equal(service.cancel(booking.id, '2026-06-20T09:00:00Z').refund, 6750);
+});
+
+test('cancel refunds the hourly total of an hourly rental', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T13:00:00Z' });
+
+  assert.equal(service.cancel(booking.id, '2026-07-01T09:00:00Z').refund, 1800);
+});
+
+test('a cancelled booking no longer holds its equipment', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  const period = { start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' };
+  assert.deepEqual(service.availability(period), []);
+
+  service.cancel(booking.id, '2026-06-20T09:00:00Z');
+
+  assert.deepEqual(service.availability(period), ['board-1']);
+  assert.equal(service.book({ itemId: 'board-1', ...period }).total, 2500);
+});
+
+test('cancel leaves the other bookings of the equipment in place', () => {
+  const service = serviceWithBoard();
+  const cancelled = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+
+  service.cancel(cancelled.id, '2026-06-20T09:00:00Z');
+
+  assert.deepEqual(
+    service.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' }),
+    [],
+  );
+});
+
+test('cancel refuses a booking that has already been cancelled', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  service.cancel(booking.id, '2026-06-20T09:00:00Z');
+
+  assert.throws(() => service.cancel(booking.id, '2026-06-21T09:00:00Z'), /already cancelled/);
+});
+
+test('cancel refuses an unknown booking id', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() => service.cancel('booking-99', '2026-06-20T09:00:00Z'), /unknown booking/);
+});
+
+test('cancel refuses a cancellation time that is not a whole hour in UTC', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+
+  assert.throws(() => service.cancel(booking.id, '2026-06-20T09:30:00Z'), /whole hour in UTC/);
+  assert.deepEqual(service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }), []);
+});
