 const DAY_MS = 24 * 60 * 60 * 1000;
+/** A rental of at least this many days gets the long-rental discount. */
+const LONG_RENTAL_DAYS = 3;
+const LONG_RENTAL_DISCOUNT_PERCENT = 10;
 const MIDNIGHT_UTC = /^(\d{4}-\d{2}-\d{2})T00:00:00(\.000)?Z$/;
 const KINDS: readonly EquipmentKind[] = ['board', 'sail'];
 
@@ -130,7 +136,13 @@ export function createRentalService(): RentalService {
   }
 
   function priceOf(item: EquipmentItem, period: Period): number {
-    return ((period.end - period.start) / DAY_MS) * item.dailyPrice;
+    const days = (period.end - period.start) / DAY_MS;
+    const fullPrice = days * item.dailyPrice;
+    if (days < LONG_RENTAL_DAYS) {
+      return fullPrice;
+    }
+    // Takes 10% off as whole cents: 90% of the full price, rounded to the nearest cent with halves up.
+    return Math.round((fullPrice * (100 - LONG_RENTAL_DISCOUNT_PERCENT)) / 100);
