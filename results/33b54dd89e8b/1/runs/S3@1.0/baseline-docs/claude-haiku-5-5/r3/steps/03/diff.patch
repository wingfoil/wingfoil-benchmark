+
+test('quote takes 10% off a rental of exactly three days', () => {
+  const service = serviceWithBoard();
+
+  const quote = service.quote({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-04T00:00:00Z',
+  });
+
+  assert.equal(quote.total, 6750);
+});
+
+test('quote takes 10% off a rental longer than three days', () => {
+  const service = serviceWithBoard();
+
+  const quote = service.quote({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-11T00:00:00Z',
+  });
+
+  assert.equal(quote.total, 22500);
+});
+
+test('quote gives no discount for a rental of two days', () => {
+  const service = serviceWithBoard();
+
+  const quote = service.quote({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+  });
+
+  assert.equal(quote.total, 5000);
+});
+
+test('quote rounds the discounted total to the nearest whole cent, halves up', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1201 });
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 1005 });
+
+  assert.equal(
+    service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' }).total,
+    3243,
+  );
+  assert.equal(
+    service.quote({ itemId: 'board-2', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' }).total,
+    2714,
+  );
+});
+
+test('book charges the discounted total for a rental of three days or more', () => {
+  const service = serviceWithBoard();
+
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-04T00:00:00Z',
+  });
+
+  assert.equal(booking.total, 6750);
+});
+
+test('book gives no discount for a rental of two days', () => {
+  const service = serviceWithBoard();
+
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+  });
+
+  assert.equal(booking.total, 5000);
+});
