diff --git a/test/rental.test.ts b/test/rental.test.ts
index d45b672ac1d965e9947c69a5eb18c3a0c81e464b..dc521a2839e05332ca1fd5369ddac11f2e277182 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -187,3 +187,91 @@ describe('book', () => {
     assert.equal(booking.total, 1200);
   });
 });
+
+describe('availability', () => {
+  function serviceWithStock() {
+    const service = createRentalService();
+    service.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 1200 });
+    service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1200 });
+    service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+    return service;
+  }
+
+  test('lists the ids of every kind of free equipment, sorted', () => {
+    const service = serviceWithStock();
+    assert.deepEqual(
+      service.availability({ start: midnight(DAY), end: midnight(NEXT_DAY) }),
+      ['board-1', 'board-2', 'sail-1', 'sail-2'],
+    );
+  });
+
+  test('lists only the free equipment of the given kind', () => {
+    const service = serviceWithStock();
+    assert.deepEqual(
+      service.availability({ start: midnight(DAY), end: midnight(NEXT_DAY), kind: 'sail' }),
+      ['sail-1', 'sail-2'],
+    );
+    assert.deepEqual(
+      service.availability({ start: midnight(DAY), end: midnight(NEXT_DAY), kind: 'board' }),
+      ['board-1', 'board-2'],
+    );
+  });
+
+  test('leaves out equipment booked for an overlapping period', () => {
+    const service = serviceWithStock();
+    service.book({ itemId: 'board-1', start: midnight(DAY), end: midnight('2026-07-13') });
+    assert.deepEqual(
+      service.availability({ start: midnight(NEXT_DAY), end: midnight('2026-07-12'), kind: 'board' }),
+      ['board-2'],
+    );
+  });
+
+  test('keeps equipment whose booking only touches the period', () => {
+    const service = serviceWithStock();
+    service.book({ itemId: 'board-1', start: midnight(DAY), end: midnight(NEXT_DAY) });
+    assert.deepEqual(
+      service.availability({ start: midnight(NEXT_DAY), end: midnight('2026-07-12'), kind: 'board' }),
+      ['board-1', 'board-2'],
+    );
+  });
+
+  test('returns an empty list when nothing is free or no equipment matches', () => {
+    const service = serviceWithStock();
+    service.book({ itemId: 'sail-1', start: midnight(DAY), end: midnight(NEXT_DAY) });
+    service.book({ itemId: 'sail-2', start: midnight(DAY), end: midnight(NEXT_DAY) });
+    assert.deepEqual(
+      service.availability({ start: midnight(DAY), end: midnight(NEXT_DAY), kind: 'sail' }),
+      [],
+    );
+    assert.deepEqual(createRentalService().availability({ start: midnight(DAY), end: midnight(NEXT_DAY) }), []);
+  });
+
+  test('does not reserve the equipment it lists', () => {
+    const service = serviceWithStock();
+    const query = { start: midnight(DAY), end: midnight(NEXT_DAY), kind: 'board' as const };
+    service.availability(query);
+    assert.deepEqual(service.availability(query), ['board-1', 'board-2']);
+  });
+
+  test('throws for an unknown kind', () => {
+    const service = serviceWithStock();
+    assert.throws(
+      () => service.availability({ start: midnight(DAY), end: midnight(NEXT_DAY), kind: 'kite' as 'board' }),
+      /kind/,
+    );
+  });
+
+  test('throws when the start is not at midnight UTC', () => {
+    const service = serviceWithStock();
+    assert.throws(
+      () => service.availability({ start: '2026-07-10T09:00:00.000Z', end: midnight(NEXT_DAY) }),
+      /midnight/,
+    );
+  });
+
+  test('throws when the end is not after the start', () => {
+    const service = serviceWithStock();
+    assert.throws(() => service.availability({ start: midnight(DAY), end: midnight(DAY) }), /after/);
+  });
+});
