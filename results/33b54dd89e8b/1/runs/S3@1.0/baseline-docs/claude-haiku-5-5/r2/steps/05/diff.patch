diff --git a/test/rental.test.ts b/test/rental.test.ts
index c2e9ddc44ddeeb0e7a56f3acf6c03ab91398d75a..5e8336be33ea8415deb187de1745a71889993b47 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -420,3 +420,87 @@ describe('availability', () => {
     assert.throws(() => service.availability({ start: midnight(DAY), end: midnight(DAY) }), /after/);
   });
 });
+
+describe('cancel', () => {
+  test('refunds the whole booking when cancelled before the period starts', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: midnight(DAY), end: midnight('2026-07-13') });
+    assert.deepEqual(service.cancel(booking.id, '2026-07-09T12:00:00.000Z'), {
+      bookingId: booking.id,
+      refund: 6750,
+    });
+  });
+
+  test('refunds an hourly rental cancelled before it starts', () => {
+    const service = serviceWithHourlyBoard();
+    const booking = service.book({
+      itemId: 'board-1',
+      start: '2026-07-10T10:00:00.000Z',
+      end: '2026-07-10T12:00:00.000Z',
+    });
+    assert.deepEqual(service.cancel(booking.id, '2026-07-10T09:00:00.000Z'), {
+      bookingId: booking.id,
+      refund: 1600,
+    });
+  });
+
+  test('refunds nothing when cancelled at the moment the period starts', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: midnight(DAY), end: midnight(NEXT_DAY) });
+    assert.equal(service.cancel(booking.id, midnight(DAY)).refund, 0);
+  });
+
+  test('refunds nothing when cancelled after the period has started', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: midnight(DAY), end: midnight(NEXT_DAY) });
+    assert.equal(service.cancel(booking.id, '2026-07-10T09:00:00.000Z').refund, 0);
+  });
+
+  test('frees the equipment so that it can be booked again for the same period', () => {
+    const service = serviceWithBoard();
+    const request = { itemId: 'board-1', start: midnight(DAY), end: midnight(NEXT_DAY) };
+    const booking = service.book(request);
+    service.cancel(booking.id, '2026-07-09T12:00:00.000Z');
+    assert.equal(service.book(request).total, 2500);
+  });
+
+  test('frees the equipment so that availability lists it again', () => {
+    const service = serviceWithBoard();
+    service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+    const booking = service.book({ itemId: 'board-1', start: midnight(DAY), end: midnight(NEXT_DAY) });
+    service.cancel(booking.id, '2026-07-09T12:00:00.000Z');
+    assert.deepEqual(
+      service.availability({ start: midnight(DAY), end: midnight(NEXT_DAY), kind: 'board' }),
+      ['board-1', 'board-2'],
+    );
+  });
+
+  test('keeps the other bookings of the same item in place', () => {
+    const service = serviceWithBoard();
+    const first = service.book({ itemId: 'board-1', start: midnight(DAY), end: midnight(NEXT_DAY) });
+    service.book({ itemId: 'board-1', start: midnight(NEXT_DAY), end: midnight('2026-07-12') });
+    service.cancel(first.id, '2026-07-09T12:00:00.000Z');
+    assert.throws(
+      () => service.book({ itemId: 'board-1', start: midnight(NEXT_DAY), end: midnight('2026-07-13') }),
+      /not available/,
+    );
+  });
+
+  test('throws when the same booking is cancelled twice', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: midnight(DAY), end: midnight(NEXT_DAY) });
+    service.cancel(booking.id, '2026-07-09T12:00:00.000Z');
+    assert.throws(() => service.cancel(booking.id, '2026-07-09T13:00:00.000Z'), /already cancelled/);
+  });
+
+  test('throws for an unknown booking', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.cancel('booking-99', '2026-07-09T12:00:00.000Z'), /unknown booking/);
+  });
+
+  test('throws when the time of cancellation is not an ISO-8601 UTC timestamp', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: midnight(DAY), end: midnight(NEXT_DAY) });
+    assert.throws(() => service.cancel(booking.id, 'yesterday'), /ISO-8601/);
+  });
+});
