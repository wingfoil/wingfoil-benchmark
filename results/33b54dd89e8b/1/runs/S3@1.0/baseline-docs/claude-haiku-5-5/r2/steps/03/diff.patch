+/** Applies the long-rental discount to a full price, rounding to the nearest cent. */
+function priceFor(fullPrice: number, days: number): number {
+  if (days < LONG_RENTAL_MIN_DAYS) {
+    return fullPrice;
+  }
+  return Math.round((fullPrice * (100 - LONG_RENTAL_DISCOUNT_PERCENT)) / 100);
+}
