+describe('availability', () => {
+  test('lists every item when no kind is given, sorted by id', () => {
+    const service = createRentalService();
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+    service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+    service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+    assert.deepEqual(service.availability({ start: DAY, end: NEXT_DAY }), ['board-1', 'board-2', 'sail-1']);
+  });
+
+  test('lists only the items of the given kind', () => {
+    const service = createRentalService();
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+    service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+    assert.deepEqual(service.availability({ start: DAY, end: NEXT_DAY, kind: 'sail' }), ['sail-1']);
+    assert.deepEqual(service.availability({ start: DAY, end: NEXT_DAY, kind: 'board' }), ['board-1']);
+  });
+
+  test('returns an empty list when the catalogue is empty', () => {
+    const service = createRentalService();
+    assert.deepEqual(service.availability({ start: DAY, end: NEXT_DAY }), []);
+  });
+
+  test('leaves out an item booked for an overlapping period', () => {
+    const service = serviceWithBoard();
+    service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+    service.book({ itemId: 'board-1', start: DAY, end: THIRD_DAY });
+    assert.deepEqual(service.availability({ start: NEXT_DAY, end: FOURTH_DAY }), ['board-2']);
+  });
+
+  test('leaves out an item whose booking lies inside the period', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: NEXT_DAY, end: THIRD_DAY });
+    assert.deepEqual(service.availability({ start: DAY, end: FOURTH_DAY }), []);
+  });
+
+  test('keeps an item whose booking only touches the period at a boundary', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY });
+    assert.deepEqual(service.availability({ start: NEXT_DAY, end: THIRD_DAY }), ['board-1']);
+  });
+
+  test('keeps an item that is free for the whole period but booked on other days', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: FOURTH_DAY, end: '2026-07-05T00:00:00Z' });
+    assert.deepEqual(service.availability({ start: DAY, end: THIRD_DAY }), ['board-1']);
+  });
+
+  test('does not reserve anything', () => {
+    const service = serviceWithBoard();
+    service.availability({ start: DAY, end: NEXT_DAY });
+    assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY }));
+  });
+
+  test('rejects an unknown kind', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.availability({ start: DAY, end: NEXT_DAY, kind: 'kite' as 'board' }));
+  });
+
+  test('rejects a period that is not valid', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.availability({ start: DAY, end: DAY }));
+    assert.throws(() => service.availability({ start: '2026-07-01T10:00:00Z', end: NEXT_DAY }));
+  });
+});
