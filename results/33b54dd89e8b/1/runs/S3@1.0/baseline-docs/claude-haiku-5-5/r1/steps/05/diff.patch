+
+describe('cancel', () => {
+  const BEFORE_DAY = '2026-06-30T00:00:00Z';
+  const TOO_LATE = '2026-06-30T00:30:00Z';
+
+  test('refunds the full total when cancelled 24 hours or more before the start', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY });
+    assert.deepEqual(service.cancel(booking.id, BEFORE_DAY), { bookingId: booking.id, refund: 2500 });
+  });
+
+  test('refunds the full total when cancelled well in advance', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY });
+    assert.equal(service.cancel(booking.id, '2026-06-01T09:00:00Z').refund, 2500);
+  });
+
+  test('refunds the discounted total of a rental of three days', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY, end: FOURTH_DAY });
+    assert.equal(service.cancel(booking.id, BEFORE_DAY).refund, 6750);
+  });
+
+  test('refunds the total of an hourly rental', () => {
+    const service = createRentalService();
+    service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+    const booking = service.book({
+      itemId: 'board-1',
+      start: '2026-07-01T10:00:00Z',
+      end: '2026-07-01T12:00:00Z',
+    });
+    assert.equal(service.cancel(booking.id, '2026-06-30T10:00:00Z').refund, 1200);
+  });
+
+  test('refunds nothing when cancelled less than 24 hours before the start', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY });
+    assert.equal(service.cancel(booking.id, TOO_LATE).refund, 0);
+  });
+
+  test('refunds nothing when cancelled after the start', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY });
+    assert.equal(service.cancel(booking.id, '2026-07-01T12:00:00Z').refund, 0);
+  });
+
+  test('frees the equipment so that its period can be booked again', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY, end: THIRD_DAY });
+    service.cancel(booking.id, BEFORE_DAY);
+    assert.deepEqual(service.availability({ start: DAY, end: THIRD_DAY }), ['board-1']);
+    assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: DAY, end: THIRD_DAY }));
+  });
+
+  test('keeps the equipment held by other bookings', () => {
+    const service = serviceWithBoard();
+    const cancelled = service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY });
+    service.book({ itemId: 'board-1', start: NEXT_DAY, end: THIRD_DAY });
+    service.cancel(cancelled.id, BEFORE_DAY);
+    assert.deepEqual(service.availability({ start: NEXT_DAY, end: THIRD_DAY }), []);
+  });
+
+  test('does not change the price of a quote', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY });
+    service.cancel(booking.id, TOO_LATE);
+    assert.equal(service.quote({ itemId: 'board-1', start: DAY, end: NEXT_DAY }).total, 2500);
+  });
+
+  test('rejects a cancellation of a booking twice', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY });
+    service.cancel(booking.id, BEFORE_DAY);
+    assert.throws(() => service.cancel(booking.id, BEFORE_DAY));
+  });
+
+  test('rejects an unknown booking', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.cancel('booking-99', BEFORE_DAY));
+  });
+
+  test('rejects a time that is not an ISO-8601 UTC timestamp', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY });
+    assert.throws(() => service.cancel(booking.id, '2026-06-30T00:00:00+02:00'));
+    assert.throws(() => service.cancel(booking.id, '2026-06-30'));
+    assert.throws(() => service.cancel(booking.id, '2026-02-30T00:00:00Z'));
+  });
+});
