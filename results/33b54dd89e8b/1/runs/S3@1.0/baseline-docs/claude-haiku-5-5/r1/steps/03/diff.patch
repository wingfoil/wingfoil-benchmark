+/**
+ * Applies the long-stay discount to a full price. The discount is rounded to the nearest cent,
+ * with halves rounded up, so the total stays an integer number of cents.
+ */
+function totalWithLongStayDiscount(fullPrice: number, days: number): number {
+  if (days < LONG_STAY_MIN_DAYS) {
+    return fullPrice;
+  }
+  return fullPrice - Math.round((fullPrice * LONG_STAY_DISCOUNT_PERCENT) / 100);
