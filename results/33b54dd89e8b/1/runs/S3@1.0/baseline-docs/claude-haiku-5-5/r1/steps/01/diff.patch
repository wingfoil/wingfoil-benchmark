+/**
+ * The booking desk's rental module of the Lakeside Windsurf School.
+ *
+ * Rents boards and sails by the whole day. Money is in euro cents; times are midnight-UTC
+ * ISO-8601 strings.
+ */
+export { createRentalService } from './rental-service.js';
+export type {
+  Booking,
+  Equipment,
+  EquipmentKind,
+  Quote,
+  RentalRequest,
+  RentalService,
+} from './rental-service.js';
diff --git a/src/period.ts b/src/period.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6d4f237f2325d7d62cf32d40bd9d273477b55fd1
--- /dev/null
+++ b/src/period.ts
@@ -0,0 +1,43 @@
+/** Milliseconds in one day. Every rental period is a whole number of days, so its length is a multiple of this. */
+const DAY_MS = 86_400_000;
+
+/** Midnight UTC as an ISO-8601 timestamp: the date, then `T00:00:00`, optional milliseconds, then `Z`. */
+const MIDNIGHT_UTC = /^(\d{4}-\d{2}-\d{2})T00:00:00(?:\.000)?Z$/;
+
+/** A rental period in epoch milliseconds: `startMs` is included, `endMs` is excluded. */
+export interface DayPeriod {
+  readonly startMs: number;
+  readonly endMs: number;
+  readonly days: number;
+}
+
+/**
+ * Validates a rental period given as two midnight-UTC ISO-8601 strings.
+ *
+ * Both bounds must be midnight UTC, and `end` must come after `start`. The end is exclusive, so
+ * the period ends at the start of the day after its last day. Throws a `RangeError` otherwise.
+ */
+export function parseDayPeriod(start: unknown, end: unknown): DayPeriod {
+  const startMs = parseMidnightUtc(start, 'start');
+  const endMs = parseMidnightUtc(end, 'end');
+  if (endMs <= startMs) {
+    throw new RangeError('end must be after start');
+  }
+  return { startMs, endMs, days: (endMs - startMs) / DAY_MS };
+}
+
+/** Whether two periods share at least one moment. Periods that only touch at a boundary do not overlap. */
+export function overlaps(a: DayPeriod, b: DayPeriod): boolean {
+  return a.startMs < b.endMs && b.startMs < a.endMs;
+}
+
+function parseMidnightUtc(value: unknown, field: string): number {
+  const match = typeof value === 'string' ? MIDNIGHT_UTC.exec(value) : null;
+  const ms = match === null ? Number.NaN : Date.parse(value as string);
+  // Date.parse rolls invalid days such as 2026-02-30 over into the next month; comparing the
+  // date back catches that.
+  if (match === null || Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== match[1]) {
+    throw new RangeError(`${field} must be midnight UTC, such as 2026-07-01T00:00:00Z`);
+  }
+  return ms;
+}
diff --git a/src/rental-service.test.ts b/src/rental-service.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..866f8abfaef95c59079e40f2a64bd4d1a32e0e2a
--- /dev/null
+++ b/src/rental-service.test.ts
@@ -0,0 +1,176 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.js';
+
+const DAY = '2026-07-01T00:00:00Z';
+const NEXT_DAY = '2026-07-02T00:00:00Z';
+const THIRD_DAY = '2026-07-03T00:00:00Z';
+const FOURTH_DAY = '2026-07-04T00:00:00Z';
+
+function serviceWithBoard() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  return service;
+}
+
+describe('addEquipment', () => {
+  test('accepts a board and a sail', () => {
+    const service = createRentalService();
+    assert.doesNotThrow(() => service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 }));
+    assert.doesNotThrow(() => service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 }));
+  });
+
+  test('rejects an unknown kind', () => {
+    const service = createRentalService();
+    assert.throws(() => service.addEquipment({ id: 'x', kind: 'kite' as 'board', dailyPrice: 100 }));
+  });
+
+  test('rejects an empty id', () => {
+    const service = createRentalService();
+    assert.throws(() => service.addEquipment({ id: '', kind: 'board', dailyPrice: 100 }));
+  });
+
+  test('rejects a duplicate id', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'sail', dailyPrice: 1500 }));
+  });
+
+  test('rejects a price that is not a non-negative integer number of cents', () => {
+    const service = createRentalService();
+    assert.throws(() => service.addEquipment({ id: 'a', kind: 'board', dailyPrice: 25.5 }));
+    assert.throws(() => service.addEquipment({ id: 'b', kind: 'board', dailyPrice: -1 }));
+    assert.throws(() => service.addEquipment({ id: 'c', kind: 'board', dailyPrice: Number.NaN }));
+  });
+});
+
+describe('quote', () => {
+  test('prices one day as the daily price', () => {
+    const service = serviceWithBoard();
+    assert.deepEqual(service.quote({ itemId: 'board-1', start: DAY, end: NEXT_DAY }), {
+      itemId: 'board-1',
+      start: DAY,
+      end: NEXT_DAY,
+      total: 2500,
+    });
+  });
+
+  test('multiplies the daily price by the number of days', () => {
+    const service = serviceWithBoard();
+    const quote = service.quote({ itemId: 'board-1', start: DAY, end: THIRD_DAY });
+    assert.equal(quote.total, 5000);
+  });
+
+  test('does not reserve the item', () => {
+    const service = serviceWithBoard();
+    service.quote({ itemId: 'board-1', start: DAY, end: NEXT_DAY });
+    assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY }));
+  });
+
+  test('quotes a period that is already booked', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY });
+    assert.equal(service.quote({ itemId: 'board-1', start: DAY, end: NEXT_DAY }).total, 2500);
+  });
+
+  test('rejects an unknown item', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.quote({ itemId: 'nope', start: DAY, end: NEXT_DAY }));
+  });
+
+  test('rejects an end that is not after the start', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: DAY, end: DAY }));
+    assert.throws(() => service.quote({ itemId: 'board-1', start: NEXT_DAY, end: DAY }));
+  });
+
+  test('rejects a start that is not midnight UTC', () => {
+    const service = serviceWithBoard();
+    assert.throws(() =>
+      service.quote({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: NEXT_DAY }),
+    );
+  });
+
+  test('rejects a time that is not written in UTC', () => {
+    const service = serviceWithBoard();
+    assert.throws(() =>
+      service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00+02:00', end: NEXT_DAY }),
+    );
+    assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-01', end: NEXT_DAY }));
+  });
+
+  test('rejects a date that does not exist', () => {
+    const service = serviceWithBoard();
+    assert.throws(() =>
+      service.quote({ itemId: 'board-1', start: '2026-02-30T00:00:00Z', end: '2026-03-01T00:00:00Z' }),
+    );
+  });
+
+  test('rejects a request that is not a string period', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: 0 as unknown as string, end: NEXT_DAY }));
+  });
+});
+
+describe('book', () => {
+  test('returns a booking with an id and the quoted total', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', start: DAY, end: THIRD_DAY });
+    assert.equal(typeof booking.id, 'string');
+    assert.notEqual(booking.id, '');
+    assert.deepEqual(
+      { itemId: booking.itemId, start: booking.start, end: booking.end, total: booking.total },
+      { itemId: 'board-1', start: DAY, end: THIRD_DAY, total: 5000 },
+    );
+  });
+
+  test('gives each booking a different id', () => {
+    const service = serviceWithBoard();
+    const first = service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY });
+    const second = service.book({ itemId: 'board-1', start: NEXT_DAY, end: THIRD_DAY });
+    assert.notEqual(first.id, second.id);
+  });
+
+  test('rejects an unknown item', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.book({ itemId: 'nope', start: DAY, end: NEXT_DAY }));
+  });
+
+  test('rejects a period the rules do not allow', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.book({ itemId: 'board-1', start: DAY, end: DAY }));
+    assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-01T12:00:00Z', end: NEXT_DAY }));
+  });
+
+  test('rejects a period that overlaps an existing booking of the same item', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: DAY, end: THIRD_DAY });
+    assert.throws(() => service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY }));
+    assert.throws(() => service.book({ itemId: 'board-1', start: NEXT_DAY, end: FOURTH_DAY }));
+  });
+
+  test('rejects a period that fully contains an existing booking', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: NEXT_DAY, end: THIRD_DAY });
+    assert.throws(() => service.book({ itemId: 'board-1', start: DAY, end: FOURTH_DAY }));
+  });
+
+  test('allows a period that starts when the previous booking ends', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY });
+    assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: NEXT_DAY, end: THIRD_DAY }));
+  });
+
+  test('allows a period on the same days for a different item', () => {
+    const service = serviceWithBoard();
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+    service.book({ itemId: 'board-1', start: DAY, end: THIRD_DAY });
+    assert.doesNotThrow(() => service.book({ itemId: 'sail-1', start: DAY, end: THIRD_DAY }));
+  });
+
+  test('a rejected booking does not block later bookings', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: DAY, end: NEXT_DAY });
+    assert.throws(() => service.book({ itemId: 'board-1', start: DAY, end: THIRD_DAY }));
+    assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: NEXT_DAY, end: THIRD_DAY }));
+  });
+});
diff --git a/src/rental-service.ts b/src/rental-service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c638bd02b770a1733e54511021d1c0b961453ad1
--- /dev/null
+++ b/src/rental-service.ts
@@ -0,0 +1,106 @@
+import { overlaps, parseDayPeriod, type DayPeriod } from './period.js';
+
+/** The kinds of equipment the school rents out. */
+export type EquipmentKind = 'board' | 'sail';
+
+const EQUIPMENT_KINDS: readonly EquipmentKind[] = ['board', 'sail'];
+
+/** A rentable item. `dailyPrice` is the cost of one day's rental, in euro cents. */
+export interface Equipment {
+  readonly id: string;
+  readonly kind: EquipmentKind;
+  readonly dailyPrice: number;
+}
+
+/**
+ * A request to rent an item for whole days. `start` and `end` are midnight-UTC ISO-8601 strings,
+ * and `end` is exclusive: it is the start of the day after the last day rented.
+ */
+export interface RentalRequest {
+  readonly itemId: string;
+  readonly start: string;
+  readonly end: string;
+}
+
+/** The price of renting an item for a period, in euro cents. */
+export interface Quote {
+  readonly itemId: string;
+  readonly start: string;
+  readonly end: string;
+  readonly total: number;
+}
+
+/** A confirmed booking. `id` identifies it. */
+export interface Booking extends Quote {
+  readonly id: string;
+}
+
+/** The in-memory rental service of the booking desk. */
+export interface RentalService {
+  /** Adds an item to the catalogue. Throws if the item is invalid or its id is already used. */
+  addEquipment(item: Equipment): void;
+  /** Prices a rental. Does not reserve the item. Throws for an unknown item or an invalid period. */
+  quote(request: RentalRequest): Quote;
+  /** Books an item for a period. Throws for an unknown item, an invalid period, or an overlapping booking. */
+  book(request: RentalRequest): Booking;
+}
+
+interface Reservation {
+  readonly id: string;
+  readonly period: DayPeriod;
+}
+
+/** Creates an empty rental service that keeps all equipment and bookings in memory. */
+export function createRentalService(): RentalService {
+  const items = new Map<string, Equipment>();
+  const reservations = new Map<string, Reservation[]>();
+  let bookingCount = 0;
+
+  function priceRequest(request: RentalRequest): { item: Equipment; period: DayPeriod; total: number } {
+    const item = items.get(request.itemId);
+    if (item === undefined) {
+      throw new RangeError(`unknown item: ${request.itemId}`);
+    }
+    const period = parseDayPeriod(request.start, request.end);
+    return { item, period, total: period.days * item.dailyPrice };
+  }
+
+  return {
+    addEquipment(item) {
+      assertValidEquipment(item);
+      if (items.has(item.id)) {
+        throw new Error(`duplicate item id: ${item.id}`);
+      }
+      items.set(item.id, { ...item });
+    },
+
+    quote(request) {
+      const { total } = priceRequest(request);
+      return { itemId: request.itemId, start: request.start, end: request.end, total };
+    },
+
+    book(request) {
+      const { item, period, total } = priceRequest(request);
+      const booked = reservations.get(item.id) ?? [];
+      if (booked.some((reservation) => overlaps(reservation.period, period))) {
+        throw new Error(`${item.id} is already booked for an overlapping period`);
+      }
+      bookingCount += 1;
+      const id = `booking-${bookingCount}`;
+      reservations.set(item.id, [...booked, { id, period }]);
+      return { id, itemId: item.id, start: request.start, end: request.end, total };
+    },
+  };
+}
+
+function assertValidEquipment(item: Equipment): void {
+  if (typeof item.id !== 'string' || item.id === '') {
+    throw new TypeError('item id must be a non-empty string');
+  }
+  if (!EQUIPMENT_KINDS.includes(item.kind)) {
+    throw new RangeError("kind must be 'board' or 'sail'");
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new RangeError('dailyPrice must be a non-negative integer number of euro cents');
+  }
+}
