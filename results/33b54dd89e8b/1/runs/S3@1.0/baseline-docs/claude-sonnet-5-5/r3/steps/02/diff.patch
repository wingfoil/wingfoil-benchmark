diff --git a/test/rental.test.ts b/test/rental.test.ts
index f1417db4b3501df0d2e24b4b65743e409cb5f6b8..ccebf0464399188ab7d0250a8a973cfd3ee13dda 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -83,3 +83,45 @@ test('book rejects an unknown item and invalid periods without booking', () => {
   assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-01T12:00:00.000Z', end: `2026-07-02${DAY}` }));
   service.book({ itemId: 'board-1', start: `2026-07-01${DAY}`, end: `2026-07-02${DAY}` });
 });
+
+function serviceWithFleet() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  return service;
+}
+
+test('availability lists the free items of any kind, sorted', () => {
+  const service = serviceWithFleet();
+  assert.deepEqual(service.availability({ start: `2026-07-01${DAY}`, end: `2026-07-02${DAY}` }), ['board-1', 'board-2', 'sail-1']);
+});
+
+test('availability filters by kind', () => {
+  const service = serviceWithFleet();
+  const period = { start: `2026-07-01${DAY}`, end: `2026-07-02${DAY}` };
+  assert.deepEqual(service.availability({ ...period, kind: 'board' }), ['board-1', 'board-2']);
+  assert.deepEqual(service.availability({ ...period, kind: 'sail' }), ['sail-1']);
+});
+
+test('availability excludes items booked during any part of the period', () => {
+  const service = serviceWithFleet();
+  service.book({ itemId: 'board-1', start: `2026-07-03${DAY}`, end: `2026-07-04${DAY}` });
+  assert.deepEqual(service.availability({ start: `2026-07-01${DAY}`, end: `2026-07-05${DAY}` }), ['board-2', 'sail-1']);
+  assert.deepEqual(service.availability({ start: `2026-07-03${DAY}`, end: `2026-07-04${DAY}`, kind: 'board' }), ['board-2']);
+});
+
+test('availability keeps items whose bookings only touch the period', () => {
+  const service = serviceWithFleet();
+  service.book({ itemId: 'board-1', start: `2026-07-01${DAY}`, end: `2026-07-03${DAY}` });
+  service.book({ itemId: 'board-1', start: `2026-07-05${DAY}`, end: `2026-07-06${DAY}` });
+  assert.deepEqual(service.availability({ start: `2026-07-03${DAY}`, end: `2026-07-05${DAY}`, kind: 'board' }), ['board-1', 'board-2']);
+});
+
+test('availability is empty when nothing matches and rejects invalid queries', () => {
+  const service = serviceWithFleet();
+  assert.deepEqual(createRentalService().availability({ start: `2026-07-01${DAY}`, end: `2026-07-02${DAY}` }), []);
+  assert.throws(() => service.availability({ start: '2026-07-01T10:00:00.000Z', end: `2026-07-02${DAY}` }));
+  assert.throws(() => service.availability({ start: `2026-07-02${DAY}`, end: `2026-07-02${DAY}` }));
+  assert.throws(() => service.availability({ start: `2026-07-01${DAY}`, end: `2026-07-02${DAY}`, kind: 'kite' as 'board' }));
+});
