+/** Full price, less 10% (rounded to whole cents) from `LONG_STAY_DAYS` days. */
+function rentalTotal(dailyPrice: number, days: number): number {
+  const full = dailyPrice * days;
+  return days >= LONG_STAY_DAYS ? Math.round((full * LONG_STAY_PERCENT_PAID) / 100) : full;
+}
