diff --git a/test/rental.test.ts b/test/rental.test.ts
index c35775ad8772a39a27408a7d88d7732549bebd63..5e9a4990a8a193f65efe9cffcfd68f209f5bd410 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -209,3 +209,35 @@ test('availability for an hourly period lists only items with an hourly price',
   assert.deepEqual(service.availability({ start: '2026-07-01T09:00:00Z', end: '2026-07-01T12:00:00Z' }), ['board-1']);
   assert.deepEqual(service.availability({ start: `2026-07-01${DAY}`, end: `2026-07-02${DAY}` }), ['board-1', 'sail-1']);
 });
+
+test('cancel refunds the full total at least 24 hours before the start', () => {
+  const service = serviceWithBoard();
+  const { id } = service.book({ itemId: 'board-1', start: `2026-07-03${DAY}`, end: `2026-07-04${DAY}` });
+  assert.deepEqual(service.cancel(id, '2026-07-02T00:00:00Z'), { bookingId: id, refund: 2500 });
+});
+
+test('cancel refunds nothing less than 24 hours before the start or after it', () => {
+  const service = serviceWithBoard();
+  const a = service.book({ itemId: 'board-1', start: `2026-07-03${DAY}`, end: `2026-07-04${DAY}` });
+  const b = service.book({ itemId: 'board-1', start: `2026-07-05${DAY}`, end: `2026-07-06${DAY}` });
+  assert.equal(service.cancel(a.id, '2026-07-02T00:00:01Z').refund, 0);
+  assert.equal(service.cancel(b.id, '2026-07-07T00:00:00Z').refund, 0);
+});
+
+test('a cancelled booking frees its equipment and ids are not reused', () => {
+  const service = serviceWithBoard();
+  const period = { itemId: 'board-1', start: `2026-07-03${DAY}`, end: `2026-07-04${DAY}` };
+  const first = service.book(period);
+  service.cancel(first.id, '2026-06-01T00:00:00Z');
+  assert.deepEqual(service.availability({ start: period.start, end: period.end }), ['board-1']);
+  assert.equal(service.book(period).id, 'booking-2');
+});
+
+test('cancel rejects unknown bookings, invalid times and second cancellations', () => {
+  const service = serviceWithBoard();
+  const { id } = service.book({ itemId: 'board-1', start: `2026-07-03${DAY}`, end: `2026-07-04${DAY}` });
+  assert.throws(() => service.cancel('nope', '2026-06-01T00:00:00Z'));
+  assert.throws(() => service.cancel(id, 'garbage'));
+  service.cancel(id, '2026-06-01T00:00:00Z');
+  assert.throws(() => service.cancel(id, '2026-06-02T00:00:00Z'));
+});
