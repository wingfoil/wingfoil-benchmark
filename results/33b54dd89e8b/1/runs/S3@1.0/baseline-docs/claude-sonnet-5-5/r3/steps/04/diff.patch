@@ -144,3 +144,68 @@ test('book charges the discounted total for a rental of 3 days or more', () => {
   const booking = serviceWithBoard().book({ itemId: 'board-1', start: `2026-07-01${DAY}`, end: `2026-07-04${DAY}` });
   assert.equal(booking.total, 6750);
 });
+
+function serviceWithHourlyBoard() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  return service;
+}
+
+test('quote prices a rental shorter than a day at the hourly price for each hour', () => {
+  const quote = serviceWithHourlyBoard().quote({ itemId: 'board-1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T16:00:00Z' });
+  assert.deepEqual(quote, { itemId: 'board-1', start: '2026-07-01T13:00:00.000Z', end: '2026-07-01T16:00:00.000Z', total: 1800 });
+});
+
+test('quote prices an hourly rental that crosses midnight, without the long-stay discount', () => {
+  const quote = serviceWithHourlyBoard().quote({ itemId: 'board-1', start: '2026-07-01T20:00:00Z', end: '2026-07-02T19:00:00Z' });
+  assert.equal(quote.total, 600 * 23);
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  const service = serviceWithHourlyBoard();
+  assert.throws(() => service.quote({ itemId: 'sail-1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T15:00:00Z' }));
+  assert.throws(() => service.book({ itemId: 'sail-1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T15:00:00Z' }));
+});
+
+test('hourly periods must start and end on the hour and stay under a day', () => {
+  const service = serviceWithHourlyBoard();
+  const bad = [
+    ['2026-07-01T13:30:00Z', '2026-07-01T15:00:00Z'],
+    ['2026-07-01T13:00:00Z', '2026-07-01T15:00:01Z'],
+    ['2026-07-01T13:00:00Z', '2026-07-01T13:00:00Z'],
+    ['2026-07-01T15:00:00Z', '2026-07-01T13:00:00Z'],
+    ['2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z'],
+    ['2026-07-01T10:00:00Z', '2026-07-03T00:00:00Z'],
+  ];
+  for (const [start, end] of bad) {
+    assert.throws(() => service.quote({ itemId: 'board-1', start, end }), undefined, `${start} -> ${end}`);
+  }
+});
+
+test('daily rentals of an item with an hourly price keep the daily price', () => {
+  const quote = serviceWithHourlyBoard().quote({ itemId: 'board-1', start: `2026-07-01${DAY}`, end: `2026-07-03${DAY}` });
+  assert.equal(quote.total, 5000);
+});
+
+test('addEquipment rejects an invalid hourly price', () => {
+  const service = createRentalService();
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100, hourlyPrice: 5.5 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100, hourlyPrice: -1 }));
+});
+
+test('hourly bookings block overlapping periods, not back-to-back ones, and show in availability', () => {
+  const service = serviceWithHourlyBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T15:00:00Z' });
+  assert.equal(booking.total, 1200);
+  assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-01T14:00:00Z', end: '2026-07-01T16:00:00Z' }));
+  service.book({ itemId: 'board-1', start: '2026-07-01T15:00:00Z', end: '2026-07-01T16:00:00Z' });
+  assert.deepEqual(service.availability({ start: '2026-07-01T14:00:00Z', end: '2026-07-01T15:00:00Z' }), []);
+  assert.throws(() => service.book({ itemId: 'board-1', start: `2026-07-01${DAY}`, end: `2026-07-02${DAY}` }));
+});
+
+test('availability for an hourly period lists only items with an hourly price', () => {
+  const service = serviceWithHourlyBoard();
+  assert.deepEqual(service.availability({ start: '2026-07-01T09:00:00Z', end: '2026-07-01T12:00:00Z' }), ['board-1']);
+  assert.deepEqual(service.availability({ start: `2026-07-01${DAY}`, end: `2026-07-02${DAY}` }), ['board-1', 'sail-1']);
+});
