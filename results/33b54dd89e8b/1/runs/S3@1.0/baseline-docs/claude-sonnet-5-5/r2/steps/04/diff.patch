diff --git a/test/rental.test.ts b/test/rental.test.ts
index a7c4a4ae2b5f6fc6e50a8e7d2d5c4159c253f71b..a211d709c3ee3415c877c02b4f296da3ca3cff69 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -151,8 +151,69 @@ describe('availability', () => {
 
   it('rejects invalid periods and kinds', () => {
     const s = stocked();
-    assert.throws(() => s.availability(period('2026-07-01T10:00:00Z', '2026-07-02T00:00:00Z')));
+    assert.throws(() => s.availability(period('2026-07-01T10:30:00Z', '2026-07-02T00:00:00Z')));
     assert.throws(() => s.availability(period('2026-07-02T00:00:00Z', '2026-07-02T00:00:00Z')));
     assert.throws(() => s.availability(period('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z', 'kayak' as 'board')));
   });
 });
+
+describe('hourly rental', () => {
+  const hourly = () => {
+    const s = createRentalService();
+    s.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 800 });
+    s.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+    return s;
+  };
+
+  it('prices each started-and-ended hour at the hourly price', () => {
+    const q = hourly().quote(request('2026-07-01T13:00:00Z', '2026-07-01T17:00:00Z'));
+    assert.deepEqual(q, {
+      itemId: 'board-1',
+      start: '2026-07-01T13:00:00.000Z',
+      end: '2026-07-01T17:00:00.000Z',
+      total: 3200,
+    });
+  });
+
+  it('allows a rental across midnight shorter than a day, without discount', () => {
+    const q = hourly().quote(request('2026-07-01T22:00:00Z', '2026-07-02T02:00:00Z'));
+    assert.equal(q.total, 3200);
+  });
+
+  it('rejects an item without an hourly price', () => {
+    assert.throws(() => hourly().quote(request('2026-07-01T13:00:00Z', '2026-07-01T15:00:00Z', 'sail-1')));
+  });
+
+  it('rejects times that are not on the hour', () => {
+    const s = hourly();
+    assert.throws(() => s.quote(request('2026-07-01T13:30:00Z', '2026-07-01T15:00:00Z')));
+    assert.throws(() => s.quote(request('2026-07-01T13:00:00Z', '2026-07-01T15:00:01Z')));
+  });
+
+  it('rejects periods of a day or more that are not whole UTC days', () => {
+    const s = hourly();
+    assert.throws(() => s.quote(request('2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z')));
+    assert.throws(() => s.quote(request('2026-07-01T00:00:00Z', '2026-07-02T06:00:00Z')));
+  });
+
+  it('rejects an invalid hourly price', () => {
+    const s = createRentalService();
+    assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+    assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: 1.5 }));
+  });
+
+  it('books hourly periods and rejects overlaps, allowing back-to-back', () => {
+    const s = hourly();
+    const b = s.book(request('2026-07-01T13:00:00Z', '2026-07-01T15:00:00Z'));
+    assert.equal(b.total, 1600);
+    assert.throws(() => s.book(request('2026-07-01T14:00:00Z', '2026-07-01T16:00:00Z')));
+    s.book(request('2026-07-01T15:00:00Z', '2026-07-01T16:00:00Z'));
+  });
+
+  it('checks availability for an hourly period', () => {
+    const s = hourly();
+    s.book(request('2026-07-01T13:00:00Z', '2026-07-01T15:00:00Z'));
+    assert.deepEqual(s.availability({ start: '2026-07-01T14:00:00Z', end: '2026-07-01T16:00:00Z' }), ['sail-1']);
+    assert.deepEqual(s.availability({ start: '2026-07-01T15:00:00Z', end: '2026-07-01T16:00:00Z' }), ['board-1', 'sail-1']);
+  });
+});
