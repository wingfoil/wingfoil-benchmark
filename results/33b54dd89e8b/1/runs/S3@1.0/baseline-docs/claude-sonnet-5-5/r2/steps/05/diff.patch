diff --git a/test/rental.test.ts b/test/rental.test.ts
index a211d709c3ee3415c877c02b4f296da3ca3cff69..f7d93f308a8f5ee0d63aa76e3b79caaaf6e6f06f 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -217,3 +217,45 @@ describe('hourly rental', () => {
     assert.deepEqual(s.availability({ start: '2026-07-01T15:00:00Z', end: '2026-07-01T16:00:00Z' }), ['board-1', 'sail-1']);
   });
 });
+
+describe('cancel', () => {
+  const book = (s = setup()) => ({ s, b: s.book(request('2026-07-10T00:00:00Z', '2026-07-13T00:00:00Z')) });
+
+  it('refunds the full total at least 24 hours before the start', () => {
+    const { s, b } = book();
+    assert.deepEqual(s.cancel(b.id, '2026-07-09T00:00:00Z'), { bookingId: b.id, refund: 6750 });
+  });
+
+  it('refunds nothing less than 24 hours before the start or after it', () => {
+    const a = book();
+    assert.equal(a.s.cancel(a.b.id, '2026-07-09T00:30:15Z').refund, 0);
+    const c = book();
+    assert.equal(c.s.cancel(c.b.id, '2026-07-11T00:00:00Z').refund, 0);
+  });
+
+  it('frees the equipment', () => {
+    const { s, b } = book();
+    s.cancel(b.id, '2026-07-01T00:00:00Z');
+    assert.deepEqual(s.availability({ start: '2026-07-10T00:00:00Z', end: '2026-07-13T00:00:00Z' }), ['board-1']);
+    s.book(request('2026-07-10T00:00:00Z', '2026-07-11T00:00:00Z'));
+  });
+
+  it('does not reuse the id of a cancelled booking', () => {
+    const { s, b } = book();
+    s.cancel(b.id, '2026-07-01T00:00:00Z');
+    assert.notEqual(s.book(request('2026-07-10T00:00:00Z', '2026-07-11T00:00:00Z')).id, b.id);
+  });
+
+  it('cancels a booking only once', () => {
+    const { s, b } = book();
+    s.cancel(b.id, '2026-07-01T00:00:00Z');
+    assert.throws(() => s.cancel(b.id, '2026-07-02T00:00:00Z'));
+  });
+
+  it('rejects an unknown booking and an invalid time', () => {
+    const { s, b } = book();
+    assert.throws(() => s.cancel('nope', '2026-07-01T00:00:00Z'));
+    assert.throws(() => s.cancel(b.id, 'yesterday'));
+    assert.equal(s.cancel(b.id, '2026-07-01T00:00:00Z').refund, 6750);
+  });
+});
