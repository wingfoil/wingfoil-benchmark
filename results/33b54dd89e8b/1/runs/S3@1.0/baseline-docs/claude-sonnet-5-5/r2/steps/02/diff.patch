diff --git a/test/rental.test.ts b/test/rental.test.ts
index b4312daf065e561f1b012918fdd74215671efed8..35785ea556231f4cd2547690e1c62fd552e5a332 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -87,3 +87,53 @@ describe('book', () => {
     s.book(request('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z'));
   });
 });
+
+describe('availability', () => {
+  function stocked() {
+    const s = createRentalService();
+    s.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+    s.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2000 });
+    s.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+    s.book(request('2026-07-02T00:00:00Z', '2026-07-04T00:00:00Z', 'board-1'));
+    return s;
+  }
+  const period = (start: string, end: string, kind?: 'board' | 'sail') => ({ start, end, kind });
+
+  it('lists the free items of any kind, sorted', () => {
+    const ids = stocked().availability(period('2026-07-05T00:00:00Z', '2026-07-06T00:00:00Z'));
+    assert.deepEqual(ids, ['board-1', 'board-2', 'sail-1']);
+  });
+
+  it('leaves out items booked during any part of the period', () => {
+    const ids = stocked().availability(period('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+    assert.deepEqual(ids, ['board-2', 'sail-1']);
+  });
+
+  it('treats back-to-back periods as free', () => {
+    const s = stocked();
+    assert.deepEqual(s.availability(period('2026-07-04T00:00:00Z', '2026-07-05T00:00:00Z', 'board')), [
+      'board-1',
+      'board-2',
+    ]);
+    assert.deepEqual(s.availability(period('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z', 'board')), [
+      'board-1',
+      'board-2',
+    ]);
+  });
+
+  it('filters by kind', () => {
+    const ids = stocked().availability(period('2026-07-01T00:00:00Z', '2026-07-10T00:00:00Z', 'sail'));
+    assert.deepEqual(ids, ['sail-1']);
+  });
+
+  it('returns an empty list when nothing matches', () => {
+    assert.deepEqual(createRentalService().availability(period('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z')), []);
+  });
+
+  it('rejects invalid periods and kinds', () => {
+    const s = stocked();
+    assert.throws(() => s.availability(period('2026-07-01T10:00:00Z', '2026-07-02T00:00:00Z')));
+    assert.throws(() => s.availability(period('2026-07-02T00:00:00Z', '2026-07-02T00:00:00Z')));
+    assert.throws(() => s.availability(period('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z', 'kayak' as 'board')));
+  });
+});
