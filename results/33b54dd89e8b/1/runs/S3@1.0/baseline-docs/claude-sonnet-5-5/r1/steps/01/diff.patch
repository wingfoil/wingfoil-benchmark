@@ -0,0 +1,74 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+function setup() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  return service;
+}
+
+const d = (day: number) => `2026-07-${String(day).padStart(2, '0')}T00:00:00.000Z`;
+
+test('quote prices whole days in cents', () => {
+  assert.deepEqual(setup().quote({ itemId: 'b1', start: d(1), end: d(4) }), {
+    itemId: 'b1', start: d(1), end: d(4), total: 7500,
+  });
+});
+
+test('quote accepts timestamps without milliseconds', () => {
+  const q = setup().quote({ itemId: 's1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  assert.equal(q.total, 1500);
+});
+
+test('quote rejects unknown items', () => {
+  assert.throws(() => setup().quote({ itemId: 'x', start: d(1), end: d(2) }), /Unknown item/);
+});
+
+test('quote rejects periods that are not whole UTC days', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T10:00:00Z', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T00:00:00+02:00', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-02-30T00:00:00Z', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: 'garbage', end: d(2) }));
+});
+
+test('quote rejects empty and reversed periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(2), end: d(2) }), /after start/);
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(3), end: d(2) }), /after start/);
+});
+
+test('book returns a booking with its own id', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(1), end: d(2) });
+  const b = s.book({ itemId: 'b1', start: d(2), end: d(3) });
+  assert.equal(a.total, 2500);
+  assert.notEqual(a.id, b.id);
+});
+
+test('book rejects overlapping periods for the same item only', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: d(5), end: d(8) });
+  assert.throws(() => s.book({ itemId: 'b1', start: d(7), end: d(9) }), /not free/);
+  assert.throws(() => s.book({ itemId: 'b1', start: d(4), end: d(6) }), /not free/);
+  assert.throws(() => s.book({ itemId: 'b1', start: d(1), end: d(20) }), /not free/);
+  assert.doesNotThrow(() => s.book({ itemId: 's1', start: d(5), end: d(8) }));
+  assert.doesNotThrow(() => s.book({ itemId: 'b1', start: d(8), end: d(9) }));
+});
+
+test('a rejected booking leaves the period free', () => {
+  const s = setup();
+  assert.throws(() => s.book({ itemId: 'b1', start: d(3), end: d(3) }));
+  assert.doesNotThrow(() => s.book({ itemId: 'b1', start: d(3), end: d(4) }));
+});
+
+test('addEquipment validates its input', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }), /already exists/);
+  assert.throws(() => s.addEquipment({ id: 'n', kind: 'board', dailyPrice: 12.5 }));
+  assert.throws(() => s.addEquipment({ id: 'n', kind: 'board', dailyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: '', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'n', kind: 'kayak' as 'board', dailyPrice: 1 }));
+});
