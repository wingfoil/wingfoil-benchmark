@@ -0,0 +1,110 @@
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00:00(\.000)?Z$/;
+
+/** The kinds of equipment the school rents out. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item; `dailyPrice` is an integer number of euro cents per day. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** A rental period for one item; `start` and `end` are ISO-8601 UTC midnights, `end` exclusive. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The cost of renting an item for a period; `total` is an integer number of euro cents. */
+export interface Quote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed booking, identified by `id`. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** The in-memory rental service of the booking desk. */
+export interface RentalService {
+  /** Registers an item; throws on invalid data or a duplicate id. */
+  addEquipment(item: Equipment): void;
+  /** Prices a rental; throws for an unknown item or a period the rules do not allow. */
+  quote(request: RentalRequest): Quote;
+  /** Books a rental; throws like `quote`, and when the item is taken during the period. */
+  book(request: RentalRequest): Booking;
+}
+
+function parseMidnight(value: unknown, label: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${label} must be an ISO-8601 UTC string at midnight, got ${String(value)}`);
+  }
+  const time = Date.parse(value);
+  if (Number.isNaN(time) || new Date(time).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${label} is not a valid date: ${value}`);
+  }
+  return time;
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item?.id !== 'string' || item.id === '') {
+    throw new Error('Equipment id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error(`Equipment kind must be 'board' or 'sail', got ${String(item.kind)}`);
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('Equipment dailyPrice must be a non-negative integer number of cents');
+  }
+}
+
+/** Creates an empty rental service that keeps everything in memory. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Array<Booking & { startMs: number; endMs: number }> = [];
+
+  function price(request: RentalRequest): Quote & { startMs: number; endMs: number } {
+    const item = equipment.get(request?.itemId);
+    if (!item) {
+      throw new Error(`Unknown item: ${String(request?.itemId)}`);
+    }
+    const startMs = parseMidnight(request.start, 'start');
+    const endMs = parseMidnight(request.end, 'end');
+    if (endMs <= startMs) {
+      throw new Error('end must be after start');
+    }
+    const days = (endMs - startMs) / DAY_MS;
+    return { itemId: item.id, start: request.start, end: request.end, total: days * item.dailyPrice, startMs, endMs };
+  }
+
+  return {
+    addEquipment(item) {
+      validateEquipment(item);
+      if (equipment.has(item.id)) {
+        throw new Error(`Equipment already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      const { startMs, endMs, ...quote } = price(request);
+      return quote;
+    },
+
+    book(request) {
+      const { startMs, endMs, ...quote } = price(request);
+      const taken = bookings.some(
+        (b) => b.itemId === quote.itemId && b.startMs < endMs && startMs < b.endMs,
+      );
+      if (taken) {
+        throw new Error(`Item ${quote.itemId} is not free from ${quote.start} to ${quote.end}`);
+      }
+      const booking: Booking = { id: `booking-${bookings.length + 1}`, ...quote };
+      bookings.push({ ...booking, startMs, endMs });
+      return booking;
+    },
+  };
+}
