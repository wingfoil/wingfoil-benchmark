diff --git a/src/index.test.ts b/src/index.test.ts
index 6d39f496bbacbe60182898b357768fa65f8cc685..25930ce03f088b2a173438ab03b38ee5be5977bc 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -133,3 +133,61 @@ test('availability rejects invalid periods and kinds', () => {
   assert.throws(() => s.availability({ start: 'garbage', end: d(2) }));
   assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'kayak' as never }), /kind/);
 });
+
+const at = (day: number, hour: number) => `2026-07-${String(day).padStart(2, '0')}T${String(hour).padStart(2, '0')}:00:00Z`;
+
+function withHourly() {
+  const service = setup();
+  service.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  return service;
+}
+
+test('quote prices a rental shorter than a day per hour, without discount', () => {
+  const s = withHourly();
+  assert.deepEqual(s.quote({ itemId: 'h1', start: at(1, 13), end: at(1, 17) }), {
+    itemId: 'h1', start: at(1, 13), end: at(1, 17), total: 2400,
+  });
+  assert.equal(s.quote({ itemId: 'h1', start: at(1, 0), end: at(1, 23) }).total, 13800);
+  assert.equal(s.quote({ itemId: 'h1', start: at(1, 22), end: at(2, 2) }).total, 2400);
+});
+
+test('book charges the hourly total and blocks overlapping hours only', () => {
+  const s = withHourly();
+  assert.equal(s.book({ itemId: 'h1', start: at(1, 13), end: at(1, 17) }).total, 2400);
+  assert.throws(() => s.book({ itemId: 'h1', start: at(1, 16), end: at(1, 18) }), /not free/);
+  assert.equal(s.book({ itemId: 'h1', start: at(1, 17), end: at(1, 18) }).total, 600);
+});
+
+test('a full day is still priced per day', () => {
+  assert.equal(withHourly().quote({ itemId: 'h1', start: d(1), end: d(2) }).total, 2500);
+});
+
+test('hourly rental needs an hourly price', () => {
+  assert.throws(() => withHourly().quote({ itemId: 'b1', start: at(1, 13), end: at(1, 17) }), /by the hour/);
+});
+
+test('hourly rental must start and end on the hour', () => {
+  const s = withHourly();
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-07-01T13:30:00Z', end: at(1, 17) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: at(1, 13), end: '2026-07-01T17:00:01Z' }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-07-01T13:00:00+02:00', end: at(1, 17) }));
+});
+
+test('rentals of a day or more must still be whole days', () => {
+  const s = withHourly();
+  assert.throws(() => s.quote({ itemId: 'h1', start: at(1, 10), end: at(2, 10) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: d(1), end: at(2, 10) }));
+});
+
+test('availability accepts hourly periods', () => {
+  const s = withHourly();
+  s.book({ itemId: 'h1', start: at(1, 13), end: at(1, 17) });
+  assert.deepEqual(s.availability({ start: at(1, 9), end: at(1, 13), kind: 'board' }), ['b1', 'h1']);
+  assert.deepEqual(s.availability({ start: at(1, 12), end: at(1, 14), kind: 'board' }), ['b1']);
+});
+
+test('addEquipment validates the hourly price', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'n', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'n', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+});
