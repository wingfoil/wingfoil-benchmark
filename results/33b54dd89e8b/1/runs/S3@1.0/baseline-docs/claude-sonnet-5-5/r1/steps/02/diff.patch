diff --git a/src/index.test.ts b/src/index.test.ts
index d278d89488dd28c3e70b2ca21ae081ece1c413da..bae6d6fb42057f522b56030fec7e8327ea5be934 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -72,3 +72,46 @@ test('addEquipment validates its input', () => {
   assert.throws(() => s.addEquipment({ id: '', kind: 'board', dailyPrice: 1 }));
   assert.throws(() => s.addEquipment({ id: 'n', kind: 'kayak' as 'board', dailyPrice: 1 }));
 });
+
+function stocked() {
+  const service = setup();
+  service.addEquipment({ id: 'b0', kind: 'board', dailyPrice: 2000 });
+  return service;
+}
+
+test('availability lists the free items of every kind, sorted', () => {
+  assert.deepEqual(stocked().availability({ start: d(1), end: d(3) }), ['b0', 'b1', 's1']);
+});
+
+test('availability filters by kind', () => {
+  assert.deepEqual(stocked().availability({ start: d(1), end: d(3), kind: 'board' }), ['b0', 'b1']);
+});
+
+test('availability leaves out items booked during any part of the period', () => {
+  const s = stocked();
+  s.book({ itemId: 'b1', start: d(2), end: d(4) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(3), kind: 'board' }), ['b0']);
+  assert.deepEqual(s.availability({ start: d(3), end: d(5), kind: 'board' }), ['b0']);
+  assert.deepEqual(s.availability({ start: d(2), end: d(3), kind: 'board' }), ['b0']);
+});
+
+test('availability treats the end as exclusive', () => {
+  const s = stocked();
+  s.book({ itemId: 'b1', start: d(2), end: d(4) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(2), kind: 'board' }), ['b0', 'b1']);
+  assert.deepEqual(s.availability({ start: d(4), end: d(6), kind: 'board' }), ['b0', 'b1']);
+});
+
+test('availability is empty when nothing matches', () => {
+  const s = setup();
+  s.book({ itemId: 's1', start: d(1), end: d(2) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(2), kind: 'sail' }), []);
+  assert.deepEqual(createRentalService().availability({ start: d(1), end: d(2) }), []);
+});
+
+test('availability rejects invalid periods and kinds', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: d(2), end: d(2) }), /after start/);
+  assert.throws(() => s.availability({ start: 'garbage', end: d(2) }));
+  assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'kayak' as never }), /kind/);
+});
