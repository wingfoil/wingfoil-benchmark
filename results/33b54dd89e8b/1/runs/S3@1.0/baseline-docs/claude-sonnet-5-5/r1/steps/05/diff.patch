@@ -191,3 +191,35 @@ test('addEquipment validates the hourly price', () => {
   assert.throws(() => s.addEquipment({ id: 'n', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
   assert.throws(() => s.addEquipment({ id: 'n', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
 });
+
+test('cancel refunds the full total at least 24 h before start', () => {
+  const s = setup();
+  const { id } = s.book({ itemId: 'b1', start: d(5), end: d(8) });
+  assert.deepEqual(s.cancel(id, at(4, 0)), { bookingId: id, refund: 6750 });
+});
+
+test('cancel refunds nothing less than 24 h before start or after it', () => {
+  const s = withHourly();
+  const first = s.book({ itemId: 'b1', start: d(5), end: d(6) });
+  assert.equal(s.cancel(first.id, at(4, 1)).refund, 0);
+  const second = s.book({ itemId: 'h1', start: at(5, 13), end: at(5, 17) });
+  assert.equal(s.cancel(second.id, at(6, 0)).refund, 0);
+});
+
+test('a cancelled booking frees its equipment and ids stay unique', () => {
+  const s = setup();
+  const first = s.book({ itemId: 'b1', start: d(5), end: d(6) });
+  s.cancel(first.id, at(1, 0));
+  assert.deepEqual(s.availability({ start: d(5), end: d(6), kind: 'board' }), ['b1']);
+  const second = s.book({ itemId: 'b1', start: d(5), end: d(6) });
+  assert.notEqual(second.id, first.id);
+});
+
+test('cancel rejects an unknown booking, a second cancellation and an invalid time', () => {
+  const s = setup();
+  const { id } = s.book({ itemId: 'b1', start: d(5), end: d(6) });
+  assert.throws(() => s.cancel('nope', at(1, 0)), /Unknown booking/);
+  assert.throws(() => s.cancel(id, 'garbage'));
+  s.cancel(id, at(1, 0));
+  assert.throws(() => s.cancel(id, at(1, 0)), /already cancelled/);
+});
