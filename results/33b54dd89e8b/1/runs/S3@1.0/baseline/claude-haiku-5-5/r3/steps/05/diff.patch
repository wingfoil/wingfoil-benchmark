+function parseInstant(value: unknown): number {
+  const match = typeof value === 'string' ? ISO_INSTANT.exec(value) : null;
+  // Date.parse rolls over impossible dates such as February 31, so check the calendar date separately.
+  const date = match ? new Date(Date.UTC(Number(match[2]), Number(match[3]) - 1, Number(match[4]))) : null;
+  const isRealDate =
+    date !== null && date.getUTCMonth() === Number(match?.[3]) - 1 && date.getUTCDate() === Number(match?.[4]);
+  const ms = isRealDate ? Date.parse(value as string) : NaN;
+  if (Number.isNaN(ms)) {
