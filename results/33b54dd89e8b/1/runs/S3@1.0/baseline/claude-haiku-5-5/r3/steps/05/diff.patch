diff --git a/test/rental.test.js b/test/rental.test.js
index 7afa1c01488d20cfee597faa16a695cbaa698c5f..8297c56f9e4c77e6bfef819bffacca1966ee0d52 100644
--- a/test/rental.test.js
+++ b/test/rental.test.js
@@ -388,3 +388,54 @@ test('addEquipment rejects an invalid hourly price', () => {
   service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 2500, hourlyPrice: 800 });
   assert.equal(service.quote({ itemId: 'x', start: '2026-07-01T10:00:00Z', end: '2026-07-01T11:00:00Z' }).total, 800);
 });
+
+test('cancelling before the rental starts refunds the whole booking price', () => {
+  const service = serviceWithItems();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+  assert.deepEqual(service.cancel(booking.id, '2026-06-30T18:00:00Z'), {
+    bookingId: booking.id,
+    refund: 6750,
+  });
+});
+
+test('cancelling once the rental has started refunds nothing', () => {
+  const service = serviceWithItems();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+  assert.equal(service.cancel(booking.id, '2026-07-01T00:00:00Z').refund, 0);
+  const other = service.book({ itemId: 'sail-1', start: '2026-07-01', end: '2026-07-03' });
+  assert.equal(service.cancel(other.id, '2026-07-02T09:00:00+02:00').refund, 0);
+});
+
+test('an hourly booking is refunded in full when cancelled before it starts', () => {
+  const service = serviceWithHourly();
+  const booking = service.book({ itemId: 'board-h', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' });
+  assert.equal(service.cancel(booking.id, '2026-07-01T09:59:59Z').refund, 1600);
+});
+
+test('a cancelled booking no longer holds its equipment', () => {
+  const service = serviceWithItems();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-05' });
+  assert.deepEqual(service.availability({ start: '2026-07-02', end: '2026-07-03', kind: 'board' }), []);
+  service.cancel(booking.id, '2026-06-20T00:00:00Z');
+  assert.deepEqual(service.availability({ start: '2026-07-02', end: '2026-07-03', kind: 'board' }), ['board-1']);
+  assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-05' }));
+});
+
+test('a booking can only be cancelled once', () => {
+  const service = serviceWithItems();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+  service.cancel(booking.id, '2026-06-20T00:00:00Z');
+  assert.throws(() => service.cancel(booking.id, '2026-06-21T00:00:00Z'), /already cancelled/);
+});
+
+test('cancel rejects unknown bookings and invalid times without changing anything', () => {
+  const service = serviceWithItems();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+  assert.throws(() => service.cancel('nope', '2026-06-20T00:00:00Z'), /Unknown booking/);
+  assert.throws(() => service.cancel(booking.id, '2026-06-20'), /ISO-8601/);
+  assert.throws(() => service.cancel(booking.id, '2026-06-20T00:00:00'), /ISO-8601/);
+  assert.throws(() => service.cancel(booking.id, 'yesterday'), /ISO-8601/);
+  assert.throws(() => service.cancel(booking.id, '2026-02-31T00:00:00Z'), /ISO-8601/);
+  assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-04', kind: 'board' }), []);
+  assert.equal(service.cancel(booking.id, '2026-06-20T00:00:00Z').refund, 6750);
+});
