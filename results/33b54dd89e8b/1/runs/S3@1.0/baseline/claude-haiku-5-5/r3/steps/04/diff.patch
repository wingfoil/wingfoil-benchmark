diff --git a/test/rental.test.js b/test/rental.test.js
index 9eaf4a0739b47986baf27ac36dd6a25b3eb39e25..7afa1c01488d20cfee597faa16a695cbaa698c5f 100644
--- a/test/rental.test.js
