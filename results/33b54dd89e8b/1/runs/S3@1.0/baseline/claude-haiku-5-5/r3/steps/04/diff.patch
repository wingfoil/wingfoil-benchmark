@@ -153,8 +153,9 @@ test('unknown items are rejected by quote and book', () => {
 test('periods must start and end at midnight UTC', () => {
   const service = serviceWithItems();
   const bad = [
-    ['2026-07-01T12:00:00Z', '2026-07-02T00:00:00Z'],
+    ['2026-07-01T12:30:00Z', '2026-07-02T00:00:00Z'],
     ['2026-07-01T00:00:00Z', '2026-07-02T10:00:00Z'],
+    ['2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z'],
     ['2026-07-01T02:00:00+02:00', '2026-07-03'],
     ['2026-07-01T00:00:00.5Z', '2026-07-02'],
   ];
@@ -268,10 +269,122 @@ test('availability does not change bookings or prices', () => {
 
 test('availability validates its period and kind', () => {
   const service = serviceWithItems();
-  assert.throws(() => service.availability({ start: '2026-07-01T12:00:00Z', end: '2026-07-02' }), /midnight UTC/);
+  assert.throws(() => service.availability({ start: '2026-07-01T12:30:00Z', end: '2026-07-02' }), /midnight UTC/);
   assert.throws(() => service.availability({ start: '2026-07-02', end: '2026-07-02' }), /end must be after start/);
   assert.throws(
     () => service.availability({ start: '2026-07-01', end: '2026-07-02', kind: 'kite' }),
     /kind/,
   );
 });
+
+function serviceWithHourly() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-h', kind: 'board', dailyPrice: 2500, hourlyPrice: 800 });
+  service.addEquipment({ id: 'sail-d', kind: 'sail', dailyPrice: 1500 });
+  return service;
+}
+
+test('an hourly rental is priced at the hourly price for each hour', () => {
+  const service = serviceWithHourly();
+  assert.deepEqual(
+    service.quote({ itemId: 'board-h', start: '2026-07-01T13:00:00Z', end: '2026-07-01T16:00:00Z' }),
+    {
+      itemId: 'board-h',
+      start: '2026-07-01T13:00:00.000Z',
+      end: '2026-07-01T16:00:00.000Z',
+      total: 2400,
+    },
+  );
+});
+
+test('an hourly rental can start at midnight and run for less than a day', () => {
+  const service = serviceWithHourly();
+  assert.equal(
+    service.quote({ itemId: 'board-h', start: '2026-07-01', end: '2026-07-01T23:00:00Z' }).total,
+    800 * 23,
+  );
+});
+
+test('book charges the hourly total and blocks only the booked hours', () => {
+  const service = serviceWithHourly();
+  const booking = service.book({ itemId: 'board-h', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' });
+  assert.equal(booking.total, 1600);
+  assert.throws(
+    () => service.book({ itemId: 'board-h', start: '2026-07-01T11:00:00Z', end: '2026-07-01T13:00:00Z' }),
+    /overlapping/,
+  );
+  assert.doesNotThrow(() =>
+    service.book({ itemId: 'board-h', start: '2026-07-01T12:00:00Z', end: '2026-07-01T13:00:00Z' }),
+  );
+});
+
+test('an hourly rental overlaps a daily booking of the same item', () => {
+  const service = serviceWithHourly();
+  service.book({ itemId: 'board-h', start: '2026-07-01', end: '2026-07-02' });
+  assert.throws(
+    () => service.book({ itemId: 'board-h', start: '2026-07-01T10:00:00Z', end: '2026-07-01T11:00:00Z' }),
+    /overlapping/,
+  );
+});
+
+test('hourly rentals get no long-rental discount', () => {
+  const service = serviceWithHourly();
+  assert.equal(
+    service.quote({ itemId: 'board-h', start: '2026-07-01T08:00:00Z', end: '2026-07-01T20:00:00Z' }).total,
+    800 * 12,
+  );
+});
+
+test('a day-or-longer rental of an hourly item is still priced by the day', () => {
+  const service = serviceWithHourly();
+  assert.equal(service.quote({ itemId: 'board-h', start: '2026-07-01', end: '2026-07-02' }).total, 2500);
+  assert.equal(service.quote({ itemId: 'board-h', start: '2026-07-01', end: '2026-07-04' }).total, 6750);
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  const service = serviceWithHourly();
+  const request = { itemId: 'sail-d', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' };
+  assert.throws(() => service.quote(request), /cannot be rented by the hour/);
+  assert.throws(() => service.book(request), /cannot be rented by the hour/);
+  assert.equal(service.availability(request).includes('sail-d'), true);
+});
+
+test('hourly periods must start and end on a whole UTC hour', () => {
+  const service = serviceWithHourly();
+  const bad = [
+    ['2026-07-01T10:30:00Z', '2026-07-01T12:00:00Z'],
+    ['2026-07-01T10:00:00Z', '2026-07-01T12:15:00Z'],
+    ['2026-07-01T10:00:00+02:00', '2026-07-01T12:00:00Z'],
+    ['2026-07-01T24:00:00Z', '2026-07-02T00:00:00Z'],
+  ];
+  for (const [start, end] of bad) {
+    assert.throws(() => service.quote({ itemId: 'board-h', start, end }), /midnight UTC or a whole UTC hour/, start + ' ' + end);
+    assert.throws(() => service.book({ itemId: 'board-h', start, end }), /midnight UTC or a whole UTC hour/, start + ' ' + end);
+  }
+});
+
+test('hourly periods must be shorter than a day, and end after they start', () => {
+  const service = serviceWithHourly();
+  assert.throws(
+    () => service.quote({ itemId: 'board-h', start: '2026-07-01T10:00:00Z', end: '2026-07-02T10:00:00Z' }),
+    /midnight UTC for a rental of a day or more/,
+  );
+  assert.throws(
+    () => service.quote({ itemId: 'board-h', start: '2026-07-01T10:00:00Z', end: '2026-07-01T10:00:00Z' }),
+    /end must be after start/,
+  );
+});
+
+test('addEquipment rejects an invalid hourly price', () => {
+  const service = createRentalService();
+  assert.throws(
+    () => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 2500, hourlyPrice: 0 }),
+    /hourlyPrice/,
+  );
+  assert.throws(
+    () => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 2500, hourlyPrice: 8.5 }),
+    /hourlyPrice/,
+  );
+  service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 2500, hourlyPrice: 800 });
+  assert.equal(service.quote({ itemId: 'x', start: '2026-07-01T10:00:00Z', end: '2026-07-01T11:00:00Z' }).total, 800);
+});
