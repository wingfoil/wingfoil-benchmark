+test('availability lists the free items of the requested kind, sorted', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 1200 });
+  rentals.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  rentals.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1200 });
+  rentals.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+  assert.deepEqual(rentals.availability({ start: '2026-07-02', end: '2026-07-03', kind: 'board' }), ['board-2']);
+  assert.deepEqual(rentals.availability({ start: '2026-07-02', end: '2026-07-03', kind: 'sail' }), ['sail-1', 'sail-2']);
+  assert.deepEqual(rentals.availability({ start: '2026-07-02', end: '2026-07-03' }), ['board-2', 'sail-1', 'sail-2']);
+});
+
+test('availability treats the period as whole days, half-open like book', () => {
+  const rentals = service();
+  rentals.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+  assert.deepEqual(rentals.availability({ start: '2026-07-04', end: '2026-07-06', kind: 'board' }), ['board-1']);
+  assert.deepEqual(rentals.availability({ start: '2026-06-28', end: '2026-07-01', kind: 'board' }), ['board-1']);
+  assert.deepEqual(rentals.availability({ start: '2026-07-03', end: '2026-07-05', kind: 'board' }), []);
+  assert.deepEqual(rentals.availability({ start: '2026-06-01', end: '2026-08-01', kind: 'board' }), []);
+  assert.deepEqual(rentals.availability({ start: '2026-06-01', end: '2026-08-01' }), ['sail-1']);
+});
+
+test('availability does not change bookings and rejects bad input', () => {
