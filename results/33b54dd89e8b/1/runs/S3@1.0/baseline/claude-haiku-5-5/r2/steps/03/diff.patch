@@ -47,6 +47,8 @@ export interface RentalService {
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
+const LONG_RENTAL_DAYS = 3;
+const LONG_RENTAL_DISCOUNT_PERCENT = 10;
 const MIDNIGHT_UTC = /^(\d{4})-(\d{2})-(\d{2})(?:T00:00:00(?:\.000)?Z)?$/;
 
 /** Parses a midnight-UTC ISO-8601 string into epoch milliseconds, or throws. */
@@ -98,10 +100,12 @@ export function createRentalService(): RentalService {
   function priceFor(request: RentalRequest): Quote {
     const item = findItem(request.itemId);
     const { start, end, days } = parsePeriod(request);
-    const total = days * item.dailyPrice;
-    if (!Number.isSafeInteger(total)) {
+    const fullPrice = days * item.dailyPrice;
+    if (!Number.isSafeInteger(fullPrice)) {
       throw new Error('total price is out of range');
     }
+    // Rentals of three days or more get 10% off the full price, rounded to the nearest cent.
+    const total = days >= LONG_RENTAL_DAYS ? Math.round((fullPrice * (100 - LONG_RENTAL_DISCOUNT_PERCENT)) / 100) : fullPrice;
     return { itemId: item.id, start, end, total };
   }
 
