diff --git a/test/rentals.test.ts b/test/rentals.test.ts
index 59cb487cdbc388154451b03c485686f9caf4209c..913ac4391eeba36fe1dc81c53d49b4271dd4e648 100644
--- a/test/rentals.test.ts
+++ b/test/rentals.test.ts
@@ -244,3 +244,54 @@ test('addEquipment validates hourlyPrice when given', () => {
   assert.throws(() => rentals.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 1.5 }), /hourlyPrice/);
   rentals.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 0 });
 });
+
+test('cancel before the start refunds the whole total and frees the item', () => {
+  const rentals = service();
+  const booking = rentals.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+  assert.deepEqual(rentals.cancel(booking.id, '2026-06-30T12:00:00Z'), { bookingId: booking.id, refund: 6750 });
+  assert.doesNotThrow(() => rentals.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' }));
+});
+
+test('cancel during the rental refunds the unused share of the total', () => {
+  const rentals = service();
+  const booking = rentals.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+  // Two of three days unused, of a discounted total of 6750.
+  assert.equal(rentals.cancel(booking.id, '2026-07-02T00:00:00Z').refund, 4500);
+});
+
+test('cancel after the end refunds nothing', () => {
+  const rentals = service();
+  const booking = rentals.book({ itemId: 'sail-1', start: '2026-07-01', end: '2026-07-02' });
+  assert.equal(rentals.cancel(booking.id, '2026-07-05T00:00:00Z').refund, 0);
+});
+
+test('cancel of an hourly rental refunds by the hour', () => {
+  const rentals = hourlyService();
+  const booking = rentals.book({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T14:00:00Z' });
+  assert.equal(rentals.cancel(booking.id, '2026-07-01T11:00:00Z').refund, 1800);
+});
+
+test('a cancelled booking no longer shows as taken in availability', () => {
+  const rentals = service();
+  const booking = rentals.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-03' });
+  assert.deepEqual(rentals.availability({ start: '2026-07-01', end: '2026-07-03', kind: 'board' }), []);
+  rentals.cancel(booking.id, '2026-06-30T00:00:00Z');
+  assert.deepEqual(rentals.availability({ start: '2026-07-01', end: '2026-07-03', kind: 'board' }), ['board-1']);
+});
+
+test('a booking can only be cancelled once', () => {
+  const rentals = service();
+  const booking = rentals.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-03' });
+  rentals.cancel(booking.id, '2026-06-30T00:00:00Z');
+  assert.throws(() => rentals.cancel(booking.id, '2026-06-30T00:00:00Z'), /already cancelled/);
+});
+
+test('cancel rejects unknown bookings and bad times without cancelling anything', () => {
+  const rentals = service();
+  const booking = rentals.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-03' });
+  assert.throws(() => rentals.cancel('nope', '2026-06-30T00:00:00Z'), /unknown booking/);
+  assert.throws(() => rentals.cancel(booking.id, '2026-07-01'), /UTC ISO-8601 instant/);
+  assert.throws(() => rentals.cancel(booking.id, '2026-02-30T10:00:00Z'), /not a valid date/);
+  assert.throws(() => rentals.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-02' }), /not free/);
+  assert.equal(rentals.cancel(booking.id, '2026-06-30T00:00:00Z').refund, 5000);
+});
