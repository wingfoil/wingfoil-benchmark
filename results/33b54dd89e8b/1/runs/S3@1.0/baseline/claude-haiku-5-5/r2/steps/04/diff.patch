diff --git a/test/rentals.test.ts b/test/rentals.test.ts
index 8a675b37e010d68c2f13ac25b5dbee7049fc8b1e..59cb487cdbc388154451b03c485686f9caf4209c 100644
--- a/test/rentals.test.ts
+++ b/test/rentals.test.ts
@@ -131,7 +131,7 @@ test('availability does not change bookings and rejects bad input', () => {
   const rentals = service();
   assert.deepEqual(rentals.availability({ start: '2026-07-01', end: '2026-07-02' }), ['board-1', 'sail-1']);
   assert.doesNotThrow(() => rentals.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-02' }));
-  assert.throws(() => rentals.availability({ start: '2026-07-01T06:00:00Z', end: '2026-07-02' }), /midnight UTC/);
+  assert.throws(() => rentals.availability({ start: '2026-07-01T06:30:00Z', end: '2026-07-02' }), /whole hour/);
   assert.throws(() => rentals.availability({ start: '2026-07-02', end: '2026-07-01' }), /end must be after start/);
   assert.throws(() => rentals.availability({ start: '2026-07-01', end: '2026-07-02', kind: 'kite' as 'board' }), /kind/);
 });
@@ -141,3 +141,106 @@ test('quote does not reserve the item', () => {
   rentals.quote({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-02' });
   assert.doesNotThrow(() => rentals.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-02' }));
 });
+
+function hourlyService() {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  rentals.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1200 });
+  return rentals;
+}
+
+test('quote prices a rental shorter than a day by the hour', () => {
+  const rentals = hourlyService();
+  assert.deepEqual(
+    rentals.quote({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T13:00:00Z' }),
+    { itemId: 'board-1', start: '2026-07-01T10:00:00.000Z', end: '2026-07-01T13:00:00.000Z', total: 1800 },
+  );
+  assert.equal(rentals.quote({ itemId: 'board-1', start: '2026-07-01T22:00:00Z', end: '2026-07-02' }).total, 1200);
+});
+
+test('a rental of a full day or more still uses the daily price', () => {
+  const rentals = hourlyService();
+  assert.equal(rentals.quote({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-02' }).total, 2500);
+  assert.equal(rentals.quote({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' }).total, 6750);
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  const rentals = service();
+  assert.throws(
+    () => rentals.quote({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' }),
+    /cannot be rented by the hour/,
+  );
+  assert.throws(
+    () => rentals.book({ itemId: 'sail-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' }),
+    /cannot be rented by the hour/,
+  );
+});
+
+test('a rental shorter than a day must start and end on the hour', () => {
+  const rentals = hourlyService();
+  const bad = [
+    { start: '2026-07-01T10:30:00Z', end: '2026-07-01T12:00:00Z' },
+    { start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:15:00Z' },
+    { start: '2026-07-01T10:00:00.500Z', end: '2026-07-01T12:00:00Z' },
+    { start: '2026-07-01T24:00:00Z', end: '2026-07-02T01:00:00Z' },
+  ];
+  for (const period of bad) {
+    assert.throws(() => rentals.quote({ itemId: 'board-1', ...period }), Error, JSON.stringify(period));
+  }
+});
+
+test('a rental of a day or more must start and end at midnight, even when it is not whole days', () => {
+  const rentals = hourlyService();
+  assert.throws(
+    () => rentals.quote({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-02T10:00:00Z' }),
+    /midnight UTC/,
+  );
+  assert.throws(
+    () => rentals.quote({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-02T10:00:00Z' }),
+    /midnight UTC/,
+  );
+});
+
+test('hourly rentals book and block only the hours they cover', () => {
+  const rentals = hourlyService();
+  rentals.book({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T13:00:00Z' });
+  assert.throws(
+    () => rentals.book({ itemId: 'board-1', start: '2026-07-01T12:00:00Z', end: '2026-07-01T14:00:00Z' }),
+    /not free/,
+  );
+  assert.doesNotThrow(() => rentals.book({ itemId: 'board-1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T15:00:00Z' }));
+  assert.doesNotThrow(() => rentals.book({ itemId: 'board-1', start: '2026-07-01T06:00:00Z', end: '2026-07-01T10:00:00Z' }));
+  assert.throws(() => rentals.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-02' }), /not free/);
+});
+
+test('a daily rental blocks the hourly rentals inside it', () => {
+  const rentals = hourlyService();
+  rentals.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-02' });
+  assert.throws(
+    () => rentals.book({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T11:00:00Z' }),
+    /not free/,
+  );
+  assert.doesNotThrow(() => rentals.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-02T01:00:00Z' }));
+});
+
+test('availability for an afternoon lists only items with an hourly price that are free', () => {
+  const rentals = hourlyService();
+  rentals.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500, hourlyPrice: 500 });
+  rentals.addEquipment({ id: 'board-3', kind: 'board', dailyPrice: 2500 });
+  rentals.book({ itemId: 'board-2', start: '2026-07-01T12:00:00Z', end: '2026-07-01T16:00:00Z' });
+  assert.deepEqual(
+    rentals.availability({ start: '2026-07-01T13:00:00Z', end: '2026-07-01T17:00:00Z', kind: 'board' }),
+    ['board-1'],
+  );
+  assert.deepEqual(
+    rentals.availability({ start: '2026-07-01T16:00:00Z', end: '2026-07-01T17:00:00Z' }),
+    ['board-1', 'board-2'],
+  );
+});
+
+test('addEquipment validates hourlyPrice when given', () => {
+  const rentals = createRentalService();
+  assert.throws(() => rentals.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: -1 }), /hourlyPrice/);
+  assert.throws(() => rentals.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 1.5 }), /hourlyPrice/);
+  rentals.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 0 });
+});
