diff --git a/test/rental.test.ts b/test/rental.test.ts
index 1586f6c71500aac2437eaa80d1f52dd9234df7a2..689ef58550c8d45192746d48389c3f9268cb284c 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -276,3 +276,70 @@ test('book does not record a refused booking', () => {
     service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' }),
   );
 });
+
+test('cancel before the rental starts refunds the full total and frees the equipment', () => {
+  const service = desk();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.deepEqual(service.cancel(booking.id, '2026-06-30T12:00:00Z'), {
+    bookingId: booking.id,
+    refund: 9450,
+  });
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z', kind: 'board' }),
+    ['board-1'],
+  );
+  assert.doesNotThrow(() =>
+    service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' }),
+  );
+});
+
+test('cancel accepts a cancellation time that is not on the hour', () => {
+  const service = desk();
+  service.addEquipment({ id: 'board-h', kind: 'board', dailyPrice: 3500, hourlyPrice: 1200 });
+  const booking = service.book({ itemId: 'board-h', start: '2026-07-01T13:00:00Z', end: '2026-07-01T15:00:00Z' });
+  assert.equal(service.cancel(booking.id, '2026-07-01T10:30:00Z').refund, 2400);
+});
+
+test('cancel refunds nothing once the rental has started', () => {
+  const service = desk();
+  const atStart = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  assert.equal(service.cancel(atStart.id, '2026-07-01T00:00:00Z').refund, 0);
+  const during = service.book({ itemId: 'board-1', start: '2026-07-05T00:00:00Z', end: '2026-07-06T00:00:00Z' });
+  assert.equal(service.cancel(during.id, '2026-07-05T08:30:00Z').refund, 0);
+  assert.deepEqual(
+    service.availability({ start: '2026-07-05T00:00:00Z', end: '2026-07-06T00:00:00Z', kind: 'board' }),
+    ['board-1'],
+  );
+});
+
+test('cancel only frees the cancelled booking, not other bookings of the same item', () => {
+  const service = desk();
+  const first = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  service.cancel(first.id, '2026-06-30T00:00:00Z');
+  assert.throws(
+    () => service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' }),
+    /not free/,
+  );
+  assert.deepEqual(
+    service.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z', kind: 'board' }),
+    [],
+  );
+});
+
+test('cancel refuses a booking that is already cancelled', () => {
+  const service = desk();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  service.cancel(booking.id, '2026-06-30T00:00:00Z');
+  assert.throws(() => service.cancel(booking.id, '2026-06-29T00:00:00Z'), /already cancelled/);
+});
+
+test('cancel refuses an unknown booking and an invalid cancellation time', () => {
+  const service = desk();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  assert.throws(() => service.cancel('nope', '2026-06-30T00:00:00Z'), /unknown booking/);
+  assert.throws(() => service.cancel(booking.id, '2026-06-30'), /ISO-8601 UTC/);
+  assert.throws(() => service.cancel(booking.id, '2026-06-30T00:00:00+02:00'), /ISO-8601 UTC/);
+  // The refused calls did not cancel the booking.
+  assert.equal(service.cancel(booking.id, '2026-06-30T00:00:00Z').refund, 3500);
+});
