+test('availability lists the free equipment, sorted, optionally by kind', () => {
+  const service = desk();
+  service.addEquipment({ id: 'board-0', kind: 'board', dailyPrice: 3000 });
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  const period = { start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' };
+  assert.deepEqual(service.availability(period), ['board-0', 'sail-1']);
+  assert.deepEqual(service.availability({ ...period, kind: 'board' }), ['board-0']);
+  assert.deepEqual(service.availability({ ...period, kind: 'sail' }), ['sail-1']);
+});
+
+test('availability ignores bookings that only touch the period', () => {
+  const service = desk();
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.deepEqual(
+    service.availability({ start: '2026-07-04T00:00:00Z', end: '2026-07-05T00:00:00Z', kind: 'board' }),
+    ['board-1'],
+  );
+  assert.deepEqual(
+    service.availability({ start: '2026-06-30T00:00:00Z', end: '2026-07-01T00:00:00Z', kind: 'board' }),
+    ['board-1'],
+  );
+});
+
+test('availability is empty when nothing is free or nothing exists', () => {
