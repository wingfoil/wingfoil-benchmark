+
+test('quote takes 10% off rentals of three days or more, rounding to the cent', () => {
+  const service = desk();
+  assert.equal(
+    service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-08T00:00:00Z' }).total,
+    22050,
