+    service.quote({ itemId: 'cheap', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' }).total,
+    3,
+  );
+  // 5 x 1 cent = 5, 10% off is 4.5 cents, which rounds up to 5.
+  assert.equal(
