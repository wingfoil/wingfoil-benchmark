+test('quote charges full price for rentals of fewer than three days', () => {
+  const service = desk();
+  assert.equal(
+    service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' }).total,
+    7000,
+  );
+  assert.equal(
