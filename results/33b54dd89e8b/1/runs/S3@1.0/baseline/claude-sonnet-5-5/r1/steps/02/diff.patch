@@ -32,3 +32,15 @@ test('book refuses overlaps but allows adjacent periods', () => {
   s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
   s.book(req('2026-05-01T00:00:00Z', '2026-05-03T00:00:00Z', 's1'));
 });
+
+test('availability lists free items of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 1 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  s.book(req('2026-05-03T00:00:00Z', '2026-05-05T00:00:00Z'));
+  const q = { start: '2026-05-01T00:00:00Z', end: '2026-05-04T00:00:00Z' };
+  assert.deepEqual(s.availability(q), ['a0', 's1']);
+  assert.deepEqual(s.availability({ ...q, kind: 'board' }), ['a0']);
+  assert.deepEqual(s.availability({ ...q, end: '2026-05-03T00:00:00Z', kind: 'board' }), ['a0', 'b1']);
+  assert.throws(() => s.availability({ ...q, end: q.start }));
+});
