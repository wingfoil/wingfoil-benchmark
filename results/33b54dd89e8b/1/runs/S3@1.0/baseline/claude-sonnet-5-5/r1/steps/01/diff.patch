@@ -0,0 +1,34 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2550 });
+  return s;
+}
+const req = (start: string, end: string, itemId = 'b1') => ({ itemId, start, end });
+
+test('quote multiplies days by daily price', () => {
+  const q = setup().quote(req('2026-05-01T00:00:00Z', '2026-05-04T00:00:00.000Z'));
+  assert.equal(q.total, 7650);
+});
+
+test('rejects unknown items and bad periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote(req('2026-05-01T00:00:00Z', '2026-05-02T00:00:00Z', 'x')));
+  assert.throws(() => s.quote(req('2026-05-01T10:00:00Z', '2026-05-02T00:00:00Z')));
+  assert.throws(() => s.quote(req('2026-05-01T00:00:00+02:00', '2026-05-02T00:00:00Z')));
+  assert.throws(() => s.quote(req('2026-05-02T00:00:00Z', '2026-05-02T00:00:00Z')));
+  assert.throws(() => s.quote(req('2026-02-30T00:00:00Z', '2026-03-02T00:00:00Z')));
+});
+
+test('book refuses overlaps but allows adjacent periods', () => {
+  const s = setup();
+  const a = s.book(req('2026-05-01T00:00:00Z', '2026-05-03T00:00:00Z'));
+  assert.throws(() => s.book(req('2026-05-02T00:00:00Z', '2026-05-04T00:00:00Z')));
+  const b = s.book(req('2026-05-03T00:00:00Z', '2026-05-04T00:00:00Z'));
+  assert.notEqual(a.id, b.id);
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  s.book(req('2026-05-01T00:00:00Z', '2026-05-03T00:00:00Z', 's1'));
+});
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..674fecd1db87733a32a14fa78fd8c0159c5763da
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,104 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one day of rental, in euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  /** ISO-8601, midnight UTC. */
+  start: string;
+  /** ISO-8601, midnight UTC; the start of the day after the last rented day. */
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  /** Euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?Z$/;
+
+function parseMidnightUtc(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 string at midnight UTC, ending in Z`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms) || ms % DAY_MS !== 0) {
+    throw new Error(`${name} must be a valid date at midnight UTC`);
+  }
+  return ms;
+}
+
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: (Booking & { startMs: number; endMs: number })[] = [];
+  let nextBookingId = 1;
+
+  function price(request: RentalRequest) {
+    const item = equipment.get(request?.itemId);
+    if (!item) throw new Error(`Unknown item: ${String(request?.itemId)}`);
+    const startMs = parseMidnightUtc(request.start, 'start');
+    const endMs = parseMidnightUtc(request.end, 'end');
+    if (endMs <= startMs) throw new Error('end must be after start');
+    const days = (endMs - startMs) / DAY_MS;
+    return {
+      startMs,
+      endMs,
+      quote: {
+        itemId: item.id,
+        start: new Date(startMs).toISOString(),
+        end: new Date(endMs).toISOString(),
+        total: days * item.dailyPrice,
+      } satisfies Quote,
+    };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item?.id !== 'string' || item.id === '') {
+        throw new Error('Equipment id must be a non-empty string');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error("Equipment kind must be 'board' or 'sail'");
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+      }
+      if (equipment.has(item.id)) throw new Error(`Equipment already exists: ${item.id}`);
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { startMs, endMs, quote } = price(request);
+      const clash = bookings.some(
+        (b) => b.itemId === quote.itemId && startMs < b.endMs && b.startMs < endMs,
+      );
+      if (clash) throw new Error(`Item ${quote.itemId} is not free for the whole period`);
+      const booking = { id: `booking-${nextBookingId++}`, ...quote };
+      bookings.push({ ...booking, startMs, endMs });
+      return booking;
+    },
+  };
+}
