@@ -57,3 +57,20 @@ test('availability lists free items of a kind, sorted', () => {
   assert.deepEqual(s.availability({ ...q, end: '2026-05-03T00:00:00Z', kind: 'board' }), ['a0', 'b1']);
   assert.throws(() => s.availability({ ...q, end: q.start }));
 });
+
+test('rentals shorter than a day are priced per hour, on the hour only', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 5000, hourlyPrice: 1200 });
+  s.addEquipment({ id: 'd', kind: 'board', dailyPrice: 5000 });
+  const r = req('2026-05-01T13:00:00Z', '2026-05-01T16:00:00.000Z', 'h');
+  assert.equal(s.quote(r).total, 3600);
+  assert.equal(s.book(r).total, 3600);
+  assert.equal(s.quote(req('2026-05-01T22:00:00Z', '2026-05-02T01:00:00Z', 'h')).total, 3600);
+  assert.throws(() => s.book(req('2026-05-01T15:00:00Z', '2026-05-01T17:00:00Z', 'h')));
+  s.book(req('2026-05-01T16:00:00Z', '2026-05-01T17:00:00Z', 'h'));
+  assert.throws(() => s.quote(r.start ? req(r.start, r.end, 'd') : r));
+  assert.throws(() => s.quote(req('2026-05-01T13:30:00Z', '2026-05-01T16:00:00Z', 'h')));
+  assert.throws(() => s.quote(req('2026-05-01T13:00:00Z', '2026-05-02T13:00:00Z', 'h')));
+  assert.throws(() => s.addEquipment({ id: 'z', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+  assert.deepEqual(s.availability({ start: '2026-05-01T00:00:00Z', end: '2026-05-02T00:00:00Z' }), ['d']);
+});
