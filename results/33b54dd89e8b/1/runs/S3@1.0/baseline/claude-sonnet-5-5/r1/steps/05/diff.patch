+test('cancel frees the equipment, refunds before the start, and works only once', () => {
+  const s = setup();
+  const a = s.book(req('2026-05-01T00:00:00Z', '2026-05-03T00:00:00Z'));
+  assert.deepEqual(s.cancel(a.id, '2026-04-30T12:00:00Z'), { bookingId: a.id, refund: 5100 });
+  assert.throws(() => s.cancel(a.id, '2026-04-30T13:00:00Z'), /already cancelled/);
+  assert.throws(() => s.cancel('nope', '2026-04-30T13:00:00Z'), /Unknown booking/);
+  const b = s.book(req('2026-05-01T00:00:00Z', '2026-05-03T00:00:00Z'));
+  assert.equal(s.cancel(b.id, '2026-05-01T00:00:00Z').refund, 0);
+  assert.throws(() => s.cancel(b.id, 'garbage'));
+});
