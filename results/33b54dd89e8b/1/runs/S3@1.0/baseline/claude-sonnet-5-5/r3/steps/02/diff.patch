@@ -39,3 +39,16 @@ test('book prevents overlaps but allows back-to-back', () => {
   s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
   s.book(req('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z', 's1'));
 });
+
+test('availability lists free items by kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a-sail', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'b0', kind: 'board', dailyPrice: 2000 });
+  s.book(req('2026-07-02T00:00:00Z', '2026-07-04T00:00:00Z'));
+  const q = { start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' };
+  assert.deepEqual(s.availability(q), ['a-sail', 'b0', 'b1']);
+  assert.deepEqual(s.availability({ ...q, end: '2026-07-03T00:00:00Z' }), ['a-sail', 'b0']);
+  assert.deepEqual(s.availability({ ...q, start: '2026-07-04T00:00:00Z', end: '2026-07-05T00:00:00Z', kind: 'board' }), ['b0', 'b1']);
+  assert.deepEqual(s.availability({ ...q, end: '2026-07-03T00:00:00Z', kind: 'sail' }), ['a-sail']);
+  assert.throws(() => s.availability({ start: q.end, end: q.start }));
+});
