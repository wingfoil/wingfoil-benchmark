+
+test('hourly rental', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2500, hourlyPrice: 800 });
+  s.addEquipment({ id: 'd', kind: 'board', dailyPrice: 2500 });
+  const r = (start: string, end: string, itemId = 'h') => ({ itemId, start, end });
+  assert.equal(s.quote(r('2026-07-01T10:00:00Z', '2026-07-01T13:00:00Z')).total, 2400);
+  assert.equal(s.quote(r('2026-07-01T22:00:00Z', '2026-07-02T02:00:00Z')).total, 3200);
+  assert.equal(s.quote(r('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z')).total, 2500);
+  assert.throws(() => s.quote(r('2026-07-01T10:00:00Z', '2026-07-01T13:00:00Z', 'd')));
+  assert.throws(() => s.quote(r('2026-07-01T10:30:00Z', '2026-07-01T13:00:00Z')));
+  assert.throws(() => s.quote(r('2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z')));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: 1.5 }));
+  s.book(r('2026-07-01T10:00:00Z', '2026-07-01T12:00:00Z'));
+  assert.throws(() => s.book(r('2026-07-01T11:00:00Z', '2026-07-01T13:00:00Z')));
+  s.book(r('2026-07-01T12:00:00Z', '2026-07-01T13:00:00Z'));
+});
