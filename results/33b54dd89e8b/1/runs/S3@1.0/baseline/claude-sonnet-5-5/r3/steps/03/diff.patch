+test('10% off from 3 days, none below, rounded to the cent', () => {
+  const s = setup();
+  const total = (end: string) => s.quote(req('2026-07-01T00:00:00Z', end)).total;
+  assert.equal(total('2026-07-03T00:00:00Z'), 5000);
+  assert.equal(total('2026-07-04T00:00:00Z'), 6750);
+  assert.equal(total('2026-07-06T00:00:00Z'), 11250);
+  s.addEquipment({ id: 'odd', kind: 'sail', dailyPrice: 1005 });
+  assert.equal(s.quote({ itemId: 'odd', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' }).total, 2714);
+  assert.equal(s.book(req('2026-07-01T00:00:00Z', '2026-07-04T00:00:00Z')).total, 6750);
+});
