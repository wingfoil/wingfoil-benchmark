+test('cancel refunds fully at 24h or more before start, nothing later, frees the item, once only', () => {
+  const s = setup();
+  const b = s.book(req('2026-07-10T00:00:00Z', '2026-07-12T00:00:00Z'));
+  assert.deepEqual(s.cancel(b.id, '2026-07-09T00:00:00Z'), { bookingId: b.id, refund: 5000 });
+  assert.throws(() => s.cancel(b.id, '2026-07-09T00:00:00Z'));
+  assert.throws(() => s.cancel('nope', '2026-07-09T00:00:00Z'));
+  const b2 = s.book(req('2026-07-10T00:00:00Z', '2026-07-12T00:00:00Z'));
+  assert.equal(s.cancel(b2.id, '2026-07-09T00:00:01Z').refund, 0);
+  assert.deepEqual(s.availability({ start: '2026-07-10T00:00:00Z', end: '2026-07-12T00:00:00Z' }), ['b1']);
