@@ -72,3 +72,21 @@ test('hourly rental', () => {
   s.book({ itemId: 'h1', start: h(16), end: h(17) });
   assert.deepEqual(s.availability({ start: h(14), end: h(15) }), ['n1']);
 });
+
+test('cancel refunds before start, frees the equipment, and works once', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(10), end: d(13) });
+  assert.deepEqual(s.cancel(a.id, d(5)), { bookingId: a.id, refund: 6885 });
+  assert.deepEqual(s.availability({ start: d(10), end: d(13) }), ['b1']);
+  assert.throws(() => s.cancel(a.id, d(5)));
+  assert.throws(() => s.cancel('nope', d(5)));
+  s.book({ itemId: 'b1', start: d(10), end: d(13) });
+});
+
+test('cancel after the start refunds nothing; after the end is rejected', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(10), end: d(13) });
+  assert.throws(() => s.cancel(a.id, d(13)));
+  assert.throws(() => s.cancel(a.id, '2026-07-05T10:30:00Z'));
+  assert.equal(s.cancel(a.id, d(11)).refund, 0);
+});
