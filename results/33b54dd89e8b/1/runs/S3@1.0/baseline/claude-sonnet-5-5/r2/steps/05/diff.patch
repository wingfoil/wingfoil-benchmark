+    cancel(bookingId, at) {
+      const atMs = parseHour(at, 'at');
+      if (cancelled.has(bookingId)) throw new Error(`Booking already cancelled: ${bookingId}`);
+      const index = bookings.findIndex((b) => b.id === bookingId);
