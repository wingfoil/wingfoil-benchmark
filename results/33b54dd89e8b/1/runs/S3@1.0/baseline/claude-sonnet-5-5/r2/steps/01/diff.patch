--- /dev/null
+++ b/test/rental.test.ts
@@ -0,0 +1,37 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2550 });
+  return s;
+}
+const d = (day: number) => `2026-07-${String(day).padStart(2, '0')}T00:00:00Z`;
+
+test('quote multiplies days by daily price', () => {
+  assert.deepEqual(setup().quote({ itemId: 'b1', start: d(1), end: d(4) }), {
+    itemId: 'b1', start: d(1), end: d(4), total: 7650,
+  });
+});
+
+test('rejects unknown items and invalid periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'x', start: d(1), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(2), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(3), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T10:00:00Z', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T00:00:00+02:00', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-02-30T00:00:00Z', end: d(2) }));
+});
+
+test('book prevents overlaps but allows adjacent periods', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.equal(a.total, 5100);
+  assert.throws(() => s.book({ itemId: 'b1', start: d(2), end: d(4) }));
+  const b = s.book({ itemId: 'b1', start: d(3), end: d(4) });
+  assert.notEqual(a.id, b.id);
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  s.book({ itemId: 's1', start: d(1), end: d(3) });
+});
