@@ -0,0 +1,94 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one day of rental, in euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  /** ISO-8601 UTC instant, midnight. */
+  start: string;
+  /** ISO-8601 UTC instant, midnight, the start of the day after the last rented day. */
+  end: string;
+}
+
+export interface Quote extends RentalRequest {
+  /** Total price, in euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?Z$/;
+
+function parseMidnight(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC string at midnight, like 2026-07-01T00:00:00Z`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms) || ms % DAY_MS !== 0 || new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a valid date: ${value}`);
+  }
+  return ms;
+}
+
+export function createRentalService(): RentalService {
+  const items = new Map<string, Equipment>();
+  const bookings: (Booking & { startMs: number; endMs: number })[] = [];
+  let nextBookingId = 1;
+
+  function price(request: RentalRequest) {
+    const item = items.get(request?.itemId);
+    if (!item) throw new Error(`Unknown item: ${request?.itemId}`);
+    const startMs = parseMidnight(request.start, 'start');
+    const endMs = parseMidnight(request.end, 'end');
+    if (endMs <= startMs) throw new Error('end must be after start');
+    const days = (endMs - startMs) / DAY_MS;
+    const quote: Quote = {
+      itemId: item.id,
+      start: request.start,
+      end: request.end,
+      total: days * item.dailyPrice,
+    };
+    return { quote, startMs, endMs };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item?.id !== 'string' || item.id === '') throw new Error('id must be a non-empty string');
+      if (item.kind !== 'board' && item.kind !== 'sail') throw new Error("kind must be 'board' or 'sail'");
+      if (!Number.isInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+      }
+      if (items.has(item.id)) throw new Error(`Item already exists: ${item.id}`);
+      items.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, startMs, endMs } = price(request);
+      const clash = bookings.some(
+        (b) => b.itemId === quote.itemId && startMs < b.endMs && b.startMs < endMs,
+      );
+      if (clash) throw new Error(`Item ${quote.itemId} is not free for the whole period`);
+      const booking: Booking = { id: `booking-${nextBookingId++}`, ...quote };
+      bookings.push({ ...booking, startMs, endMs });
+      return booking;
+    },
+  };
+}
diff --git a/test/rental.test.ts b/test/rental.test.ts
