 const DAY_MS = 24 * 60 * 60 * 1000;
+/** Rentals of at least this many days get the long-stay discount. */
+const LONG_STAY_DAYS = 3;
+/** Long-stay discount, as a percentage of the full price. */
+const LONG_STAY_DISCOUNT_PERCENT = 10;
 const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?Z$/;
 
 function parseMidnight(value: unknown, name: string): number {
@@ -67,11 +71,17 @@ export function createRentalService(): RentalService {
     const endMs = parseMidnight(request.end, 'end');
     if (endMs <= startMs) throw new Error('end must be after start');
     const days = (endMs - startMs) / DAY_MS;
+    const fullPrice = days * item.dailyPrice;
+    // Whole euro cents: the discounted total is rounded to the nearest cent.
+    const total =
+      days >= LONG_STAY_DAYS
+        ? Math.round((fullPrice * (100 - LONG_STAY_DISCOUNT_PERCENT)) / 100)
+        : fullPrice;
     const quote: Quote = {
       itemId: item.id,
       start: request.start,
       end: request.end,
-      total: days * item.dailyPrice,
+      total,
     };
     return { quote, startMs, endMs };
   }
