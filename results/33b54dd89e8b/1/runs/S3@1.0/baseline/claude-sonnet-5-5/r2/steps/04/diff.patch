+
+test('hourly rental', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2550, hourlyPrice: 600 });
+  s.addEquipment({ id: 'n1', kind: 'board', dailyPrice: 2550 });
+  const h = (hour: number) => `2026-07-01T${String(hour).padStart(2, '0')}:00:00Z`;
+  assert.equal(s.quote({ itemId: 'h1', start: h(13), end: h(16) }).total, 1800);
+  assert.throws(() => s.quote({ itemId: 'n1', start: h(13), end: h(16) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-07-01T13:30:00Z', end: h(16) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: h(10), end: '2026-07-02T10:00:00Z' }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: 1.5 }));
+  s.book({ itemId: 'h1', start: h(13), end: h(16) });
+  assert.throws(() => s.book({ itemId: 'h1', start: h(15), end: h(17) }));
+  s.book({ itemId: 'h1', start: h(16), end: h(17) });
+  assert.deepEqual(s.availability({ start: h(14), end: h(15) }), ['n1']);
