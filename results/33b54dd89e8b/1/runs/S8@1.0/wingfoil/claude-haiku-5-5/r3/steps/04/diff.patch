diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..83404285013fbde7fcca1f79b9340bee0c70c491
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,122 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+function fixedClock(now: string): () => string {
+  return () => now;
+}
+
+describe('importTasks', () => {
+  it('adds a line with a priority and tags, and reports it imported', () => {
+    const list = createTodoList(fixedClock('2026-10-01T09:00:00.000Z'));
+    const report = importTasks(list, 'Renew the insurance;high;admin money');
+    assert.deepEqual(report, { imported: 1, rejected: [] });
+    const [task] = list.list();
+    assert.equal(task?.title, 'Renew the insurance');
+    assert.equal(task?.priority, 'high');
+    assert.deepEqual(task?.tags, ['admin', 'money']);
+    assert.equal(task?.status, 'open');
+  });
+
+  it('uses a normal priority when the priority is empty', () => {
+    const list = createTodoList();
+    assert.deepEqual(importTasks(list, 'Buy milk;;home'), { imported: 1, rejected: [] });
+    assert.equal(list.list()[0]?.priority, 'normal');
+  });
+
+  it('adds a task with no tags when the tags are empty', () => {
+    const list = createTodoList();
+    assert.deepEqual(importTasks(list, 'Buy milk;low;'), { imported: 1, rejected: [] });
+    assert.deepEqual(list.list()[0]?.tags, []);
+  });
+
+  it('skips blank lines and lines of only spaces, without counting them as rejected', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'One;;\n\n   \nTwo;;\n');
+    assert.deepEqual(report, { imported: 2, rejected: [] });
+  });
+
+  it('numbers rejected lines from 1, counting blank lines', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Good;;\n\nBad;urgent;\n;;\nAlso good;;');
+    assert.equal(report.imported, 2);
+    assert.deepEqual(
+      report.rejected.map((rejection) => rejection.line),
+      [3, 4],
+    );
+  });
+
+  it('rejects an unknown priority, and adds nothing for that line', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Urgent one;urgent;');
+    assert.equal(report.imported, 0);
+    assert.equal(report.rejected.length, 1);
+    assert.equal(report.rejected[0]?.line, 1);
+    assert.match(report.rejected[0]?.reason ?? '', /low, normal or high/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects an empty title, and an over-long title, with the reason from add', () => {
+    const list = createTodoList();
+    const report = importTasks(list, `;high;\n${'a'.repeat(121)};;`);
+    assert.equal(report.imported, 0);
+    assert.match(report.rejected[0]?.reason ?? '', /empty/);
+    assert.match(report.rejected[1]?.reason ?? '', /120/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('splits the tags on any run of spaces, so no tag holds a space', () => {
+    const list = createTodoList();
+    assert.deepEqual(importTasks(list, 'Paint;;  garden   shed '), { imported: 1, rejected: [] });
+    assert.deepEqual(list.list()[0]?.tags, ['garden', 'shed']);
+  });
+
+  it('rejects a line with too few or too many fields, saying the form is title;priority;tags', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Buy milk\nBuy bread;normal\nA;b;c;d');
+    assert.equal(report.imported, 0);
+    assert.deepEqual(
+      report.rejected.map((rejection) => rejection.line),
+      [1, 2, 3],
+    );
+    for (const rejection of report.rejected) assert.match(rejection.reason, /title;priority;tags/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a title already in the list, and one repeated in the text, keeping the first', () => {
+    const list = createTodoList();
+    list.add({ title: 'Already here' });
+    const report = importTasks(list, 'Already here;high;\nNew one;low;\nNew one;high;work');
+    assert.deepEqual(
+      report.rejected.map((rejection) => rejection.line),
+      [1, 3],
+    );
+    assert.match(report.rejected[0]?.reason ?? '', /already/);
+    assert.equal(report.imported, 1);
+    const kept = list.find('New one');
+    assert.equal(kept.ok && kept.value.priority, 'low');
+  });
+
+  it('adds the valid lines and rejects the others in the same text', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Good one;high;home\nBad;urgent;\nGood two;;');
+    assert.equal(report.imported, 2);
+    assert.deepEqual(
+      report.rejected.map((rejection) => rejection.line),
+      [2],
+    );
+    assert.deepEqual(list.list().map((task) => task.title).sort(), ['Good one', 'Good two']);
+  });
+
+  it('returns an empty report for an empty text', () => {
+    assert.deepEqual(importTasks(createTodoList(), ''), { imported: 0, rejected: [] });
+  });
+
+  it('gives each imported task its own id, and does not throw on odd input', () => {
+    const list = createTodoList();
+    importTasks(list, 'One;;\nTwo;;\n;;;;;;');
+    const ids = list.list().map((task) => task.id);
+    assert.equal(new Set(ids).size, 2);
+  });
+});
