@@ -0,0 +1,56 @@
+import type { TaskList } from './list.ts';
+import { err } from './result.ts';
+import type { Result } from './result.ts';
+import type { Priority, Task } from './task.ts';
+
+/** A line of the imported text that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks were added, and every line that could not be added. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds a task to `list` for each line of `text`, each line as `title;priority;tags`: the priority may be
+ * empty for a normal one, and the tags are separated by spaces. Blank lines are skipped. A line that cannot
+ * be added is reported and the others are still added.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import, one task per line
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  text.split(/\r?\n/).forEach((content, index) => {
+    if (content.trim() === '') return;
+    const added = addLine(list, content);
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
+
+/**
+ * Adds the task one line describes. The list checks its title, priority and tags, so an unknown priority
+ * is refused there.
+ *
+ * @param list - the task list to add the task to
+ * @param line - one line, as `title;priority;tags`
+ */
+function addLine(list: TaskList, line: string): Result<Task> {
+  const fields = line.split(';');
+  if (fields.length !== 3) {
+    return err('invalid-input', `the line has ${fields.length} fields; it must be title;priority;tags`);
+  }
+  const [title, priority, tags] = fields.map((field) => field.trim());
+  return list.add({
+    title,
+    priority: priority === '' ? undefined : (priority as Priority),
+    tags: tags === '' ? [] : tags.split(/\s+/),
+  });
+}
