 /** Whether a task still has to be done. */
 export type Status = 'open' | 'done';
 
+/** The longest title a task may have, in characters, once its spaces are trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
 /** A task of the list. Its id never changes, even when the task is renamed. */
 export interface Task {
   readonly id: string;
@@ -30,6 +33,59 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/**
+ * A title, trimmed: it must not be empty, and must be at most `MAX_TITLE_LENGTH` characters.
+ *
+ * @param title - the title as given
+ */
+export function checkTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'the title is empty; give the task a name');
+  const length = [...trimmed].length;
+  if (length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${length} characters long; the most allowed is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * A priority, as given: it must be one of `PRIORITIES`.
+ *
+ * @param priority - the priority as given
+ */
+export function checkPriority(priority: string): Result<Priority> {
+  const found = PRIORITIES.find((known) => known === priority);
+  if (found === undefined) {
+    const names = `${PRIORITIES.slice(0, -1).join(', ')} or ${PRIORITIES[PRIORITIES.length - 1]}`;
+    return err('invalid-input', `the priority "${priority}" is not ${names}`);
+  }
+  return ok(found);
+}
+
+/**
+ * A tag, as given: it must not be empty, and must not contain a space.
+ *
+ * @param tag - the tag as given
+ */
+export function checkTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'a tag cannot be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space; a tag is one word`);
+  return ok(tag);
+}
+
+/**
+ * Tags, each checked by `checkTag`; the first that is not valid fails the whole list.
+ *
+ * @param tags - the tags as given
+ */
+export function checkTags(tags: readonly string[]): Result<readonly string[]> {
+  for (const tag of tags) {
+    const checked = checkTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok(tags);
+}
+
