+describe('input checks', () => {
+  function errorOf<T>(result: { ok: true; value: T } | { ok: false; error: { code: string; message: string } }) {
+    if (result.ok) assert.fail('expected the input to be rejected');
+    assert.equal(result.error.code, 'invalid-input');
+    return result.error.message;
+  }
+
+  it('rejects a title that is empty or only spaces', () => {
+    const list = createTodoList();
+    assert.match(errorOf(list.add({ title: '' })), /empty/);
+    assert.match(errorOf(list.add({ title: '   ' })), /empty/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a title longer than 120 characters, and accepts one of exactly 120', () => {
+    const list = createTodoList();
+    assert.match(errorOf(list.add({ title: 'a'.repeat(121) })), /120/);
+    assert.equal(valueOf(list.add({ title: 'a'.repeat(120) })).title, 'a'.repeat(120));
+  });
+
+  it('checks the length of a title once its spaces are trimmed', () => {
+    const list = createTodoList();
+    assert.equal(valueOf(list.add({ title: `  ${'b'.repeat(120)}  ` })).title, 'b'.repeat(120));
+    assert.match(errorOf(list.add({ title: `  ${'c'.repeat(121)}  ` })), /120/);
+  });
+
+  it('rejects a priority other than low, normal or high, and keeps normal as the default', () => {
+    const list = createTodoList();
+    assert.match(errorOf(list.add({ title: 'Urgent one', priority: 'urgent' as Priority })), /low, normal or high/);
+    assert.equal(list.list().length, 0);
+    for (const priority of PRIORITIES) {
+      assert.equal(valueOf(list.add({ title: `Priority ${priority}`, priority })).priority, priority);
+    }
+    assert.equal(valueOf(list.add({ title: 'No priority' })).priority, 'normal');
+  });
+
+  it('rejects an empty tag, or a tag with a space, when adding a task', () => {
+    const list = createTodoList();
+    assert.match(errorOf(list.add({ title: 'Bad tag', tags: [''] })), /empty/);
+    assert.match(errorOf(list.add({ title: 'Bad tag', tags: ['garden shed'] })), /space/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects an empty tag, or a tag with a space, when tagging a task', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'Tag me', tags: ['home'] }));
+    assert.match(errorOf(list.tag(task.id, '')), /empty/);
+    assert.match(errorOf(list.tag(task.id, 'garden shed')), /space/);
+    assert.deepEqual(valueOf(list.get(task.id)), task);
+  });
+
+  it('rejects an empty or over-long title when renaming, and keeps the old title', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'Keep my name' }));
+    assert.match(errorOf(list.rename('Keep my name', '  ')), /empty/);
+    assert.match(errorOf(list.rename('Keep my name', 'd'.repeat(121))), /120/);
+    assert.deepEqual(valueOf(list.get(task.id)), task);
+  });
+
+  it('leaves the list as it was when input is rejected, and keeps working after', () => {
+    const clock = { now: '2026-10-01T09:00:00.000Z' };
+    const list = createTodoList(() => clock.now);
+    const kept = valueOf(list.add({ title: 'Kept', tags: ['home'] }));
+    clock.now = '2026-10-02T10:00:00.000Z';
+    list.add({ title: '' });
+    list.add({ title: 'Bad', priority: 'urgent' as Priority });
+    list.tag('Kept', 'two words');
+    list.rename('Kept', '');
+    assert.deepEqual(list.list(), [kept]);
+    assert.equal(list.openCount(), 1);
+    assert.equal(valueOf(list.add({ title: 'Next' })).id, '2');
+  });
+});
