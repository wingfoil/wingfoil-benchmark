+
+describe('input checks', () => {
+  function errorOf<T>(result: { ok: true; value: T } | { ok: false; error: TodoError }): TodoError {
+    if (result.ok) assert.fail('the change was accepted, but it should be refused');
+    return result.error;
+  }
+
+  it('refuses a title that is empty or only spaces, and adds nothing', () => {
+    const list = createTodoList();
+    for (const title of ['', '   ']) {
+      const error = errorOf(list.add({ title }));
+      assert.equal(error.code, 'invalid-input');
+      assert.match(error.message, /title cannot be empty/);
+    }
+    assert.equal(list.list().length, 0);
+  });
+
+  it('accepts a title of exactly 120 characters', () => {
+    const list = createTodoList();
+    assert.equal(valueOf(list.add({ title: 'a'.repeat(120) })).title, 'a'.repeat(120));
+  });
+
+  it('refuses a title longer than 120 characters, and says how long it is', () => {
+    const list = createTodoList();
+    const error = errorOf(list.add({ title: 'a'.repeat(121) }));
+    assert.equal(error.code, 'invalid-input');
+    assert.match(error.message, /at most 120 characters, this one has 121/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('measures the title after trimming, and counts characters rather than code units', () => {
+    const list = createTodoList();
+    assert.equal(valueOf(list.add({ title: `  ${'a'.repeat(120)}  ` })).title, 'a'.repeat(120));
+    assert.equal(valueOf(list.add({ title: '😀'.repeat(120) })).title, '😀'.repeat(120));
+  });
+
+  it('accepts each priority and refuses any other', () => {
+    const list = createTodoList();
+    for (const priority of ['low', 'normal', 'high'] as const) {
+      assert.equal(valueOf(list.add({ title: `p-${priority}`, priority })).priority, priority);
+    }
+    for (const priority of ['urgent', 'High', ''] as Priority[]) {
+      const error = errorOf(list.add({ title: `bad-${priority}`, priority }));
+      assert.equal(error.code, 'invalid-input');
+      assert.match(error.message, /priority must be low, normal or high/);
+      assert.match(error.message, new RegExp(priority === '' ? '""' : priority));
+    }
+    assert.equal(list.list().length, 3);
+  });
+
+  it('refuses an empty tag or a tag with a space, and adds nothing', () => {
+    const list = createTodoList();
+    const empty = errorOf(list.add({ title: 'Tagged', tags: [''] }));
+    assert.equal(empty.code, 'invalid-input');
+    assert.match(empty.message, /tag cannot be empty/);
+    const spaced = errorOf(list.add({ title: 'Tagged', tags: ['home office'] }));
+    assert.equal(spaced.code, 'invalid-input');
+    assert.match(spaced.message, /tag cannot contain a space/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('refuses a rename to a blank or too-long title, and keeps the old title', () => {
+    const list = createTodoList();
+    valueOf(list.add({ title: 'Keep me' }));
+    assert.equal(errorOf(list.rename('Keep me', '  ')).code, 'invalid-input');
+    assert.equal(errorOf(list.rename('Keep me', 'b'.repeat(121))).code, 'invalid-input');
+    assert.equal(valueOf(list.find('Keep me')).title, 'Keep me');
+    assert.equal(list.list().length, 1);
+  });
+
+  it('refuses a tag that is empty or has a space, and keeps the task as it was', () => {
+    const list = createTodoList();
+    valueOf(list.add({ title: 'Mail', tags: ['work'] }));
+    assert.equal(errorOf(list.tag('Mail', '')).code, 'invalid-input');
+    assert.equal(errorOf(list.tag('Mail', 'home office')).code, 'invalid-input');
+    assert.deepEqual(valueOf(list.find('Mail')).tags, ['work']);
+  });
+});
