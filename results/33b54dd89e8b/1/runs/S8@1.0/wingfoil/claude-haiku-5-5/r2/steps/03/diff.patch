diff --git a/src/domain/task.ts b/src/domain/task.ts
index 22ce01bc8b73e98d0f189fdbd0b4dfabcd2ad79b..a59e2bbba1f45b84c036e7fc5d01d8f370fe4f20 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -28,6 +28,67 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/** The longest title a task can have, in characters. */
+const MAX_TITLE_LENGTH = 120;
+
+/**
+ * The title, trimmed, when it is neither blank nor longer than the limit. The length counts characters,
+ * not UTF-16 code units.
+ *
+ * @param title - the title as it was typed
+ */
+export function checkTitle(title: string): Result<string> {
+  const next = title.trim();
+  if (next === '') return err('invalid-input', 'a title cannot be empty');
+  const length = [...next].length;
+  if (length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `a title can be at most ${MAX_TITLE_LENGTH} characters, this one has ${length}`);
+  }
+  return ok(next);
+}
+
+/**
+ * The priority, when it is one of `PRIORITIES`. Nothing is trimmed or folded to another case.
+ *
+ * @param priority - the priority as it was typed
+ */
+export function checkPriority(priority: string): Result<Priority> {
+  const known = PRIORITIES.find((level) => level === priority);
+  return known === undefined
+    ? err('invalid-input', `priority must be low, normal or high, not "${priority}"`)
+    : ok(known);
+}
+
+/**
+ * The tag, when it is not blank and has no whitespace in it.
+ *
+ * @param tag - the tag as it was typed
+ */
+export function checkTag(tag: string): Result<string> {
+  if (tag.trim() === '') return err('invalid-input', 'a tag cannot be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `a tag cannot contain a space: "${tag}"`);
+  return ok(tag);
+}
+
+/**
+ * The input for a new task, when its title, its priority if given, and each of its tags are valid.
+ *
+ * @param input - what was typed to add the task
+ */
+export function checkNewTask(input: NewTask): Result<NewTask> {
+  const title = checkTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined) {
+    const priority = checkPriority(input.priority);
+    if (!priority.ok) return priority;
+  }
+  for (const tag of input.tags ?? []) {
+    const checked = checkTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok(input);
+}
+
 /**
  * A new open task. Its priority is `normal` unless given; its tags keep the order given, each once.
  *
