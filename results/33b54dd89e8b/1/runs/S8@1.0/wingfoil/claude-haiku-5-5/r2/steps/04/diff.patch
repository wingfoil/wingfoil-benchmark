diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c54e2f6f07f3360a3cfefb574396f4a86a73c016
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,102 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+const AT = '2026-10-31T09:00:00.000Z';
+
+describe('importTasks', () => {
+  it('adds every line as a task, with its priority and tags', () => {
+    const list = createTodoList(() => AT);
+    const result = importTasks(list, 'Renew the insurance;high;admin money\nSweep;low;house');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+    const [first, second] = list.list();
+    assert.deepEqual([first.title, first.priority, first.tags], ['Renew the insurance', 'high', ['admin', 'money']]);
+    assert.deepEqual([second.title, second.priority, second.tags], ['Sweep', 'low', ['house']]);
+    assert.equal(first.status, 'open');
+    assert.equal(first.createdAt, AT);
+  });
+
+  it('gives a normal priority and no tags when they are left empty', () => {
+    const list = createTodoList(() => AT);
+    assert.deepEqual(importTasks(list, 'Buy milk;;'), { imported: 1, rejected: [] });
+    assert.deepEqual([list.list()[0].priority, list.list()[0].tags], ['normal', []]);
+  });
+
+  it('trims the title and priority, and splits tags on any run of spaces', () => {
+    const list = createTodoList(() => AT);
+    importTasks(list, '  Water the plants ;  high ;  garden   indoor ');
+    const [task] = list.list();
+    assert.deepEqual([task.title, task.priority, task.tags], ['Water the plants', 'high', ['garden', 'indoor']]);
+  });
+
+  it('skips blank lines but still counts them in the line numbers', () => {
+    const list = createTodoList(() => AT);
+    const result = importTasks(list, 'First;;\n\n   \nBad;urgent;\nLast;;');
+    assert.equal(result.imported, 2);
+    assert.deepEqual(result.rejected, [
+      { line: 4, reason: 'priority must be low, normal or high, not "urgent"' },
+    ]);
+  });
+
+  it('accepts Windows line endings', () => {
+    const list = createTodoList(() => AT);
+    assert.deepEqual(importTasks(list, 'One;;\r\nTwo;high;\r\n'), { imported: 2, rejected: [] });
+    assert.deepEqual(list.list().map((task) => task.title).sort(), ['One', 'Two']);
+  });
+
+  it('rejects a line without exactly three fields, and says what it should look like', () => {
+    const list = createTodoList(() => AT);
+    const result = importTasks(list, 'Just a title\nA;b;c;d');
+    assert.equal(result.imported, 0);
+    assert.deepEqual(result.rejected, [
+      { line: 1, reason: 'expected three fields separated by ";" (title;priority;tags), found 1' },
+      { line: 2, reason: 'expected three fields separated by ";" (title;priority;tags), found 4' },
+    ]);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects an empty or blank title, with the list\'s reason', () => {
+    const list = createTodoList(() => AT);
+    const result = importTasks(list, ' ;high;\n;;');
+    assert.deepEqual(result.rejected, [
+      { line: 1, reason: 'a title cannot be empty' },
+      { line: 2, reason: 'a title cannot be empty' },
+    ]);
+  });
+
+  it('rejects a title longer than 120 characters', () => {
+    const list = createTodoList(() => AT);
+    const title = 'x'.repeat(121);
+    const result = importTasks(list, `${title};;`);
+    assert.deepEqual(result.rejected, [
+      { line: 1, reason: 'a title can be at most 120 characters, this one has 121' },
+    ]);
+  });
+
+  it('rejects a title already in the list, and a title repeated within the text', () => {
+    const list = createTodoList(() => AT);
+    importTasks(list, 'Milk;;');
+    const result = importTasks(list, 'Milk;high;\nEggs;;\nEggs;low;');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(result.rejected, [
+      { line: 1, reason: 'there is already a task "Milk"' },
+      { line: 3, reason: 'there is already a task "Eggs"' },
+    ]);
+    assert.equal(list.list().length, 2);
+  });
+
+  it('keeps the valid lines when others are rejected', () => {
+    const list = createTodoList(() => AT);
+    const result = importTasks(list, 'Good;high;a\nBad;nope;\nAlso good;;\n;;');
+    assert.equal(result.imported, 2);
+    assert.deepEqual(result.rejected.map((row) => row.line), [2, 4]);
+    assert.deepEqual(list.list().map((task) => task.title).sort(), ['Also good', 'Good']);
+  });
+
+  it('imports nothing from empty text', () => {
+    const list = createTodoList(() => AT);
+    assert.deepEqual(importTasks(list, ''), { imported: 0, rejected: [] });
+    assert.deepEqual(importTasks(list, '\n\n'), { imported: 0, rejected: [] });
+  });
+});
