+++ b/src/domain/import.ts
@@ -0,0 +1,60 @@
+import { ok } from './result.ts';
+import type { TaskList } from './list.ts';
+import { checkPriority } from './task.ts';
+import type { Priority } from './task.ts';
+
+/** A line of an import that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and every line that was not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds one task to `list` for each line of `text`, in the form `title;priority;tags`. The priority may be
+ * empty for a normal one; the tags are separated by spaces. Blank lines are skipped. Each line is added on
+ * its own: valid lines are kept even when others are rejected.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import, one task per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+
+  text.split('\n').forEach((raw, index) => {
+    const line = index + 1;
+    const content = raw.replace(/\r$/, '');
+    if (content.trim() === '') return;
+
+    const fields = content.split(';');
+    if (fields.length !== 3) {
+      const reason = `expected three fields separated by ";" (title;priority;tags), found ${fields.length}`;
+      rejected.push({ line, reason });
+      return;
+    }
+    const [title, priorityField, tagsField] = fields;
+
+    const typed = priorityField.trim();
+    const priority = typed === '' ? ok<Priority | undefined>(undefined) : checkPriority(typed);
+    if (!priority.ok) {
+      rejected.push({ line, reason: priority.error.message });
+      return;
+    }
+
+    const tags = tagsField.split(/\s+/).filter((tag) => tag !== '');
+    const added = list.add({ title, priority: priority.value, tags });
+    if (added.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line, reason: added.error.message });
+    }
+  });
+
+  return { imported, rejected };
+}
