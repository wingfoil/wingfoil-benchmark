diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1bfa8561e251e68eb2641c9a56863d3f64f33068
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,122 @@
+import assert from 'node:assert/strict';
+import { beforeEach, describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+const START = '2026-10-01T09:00:00.000Z';
+
+describe('importTasks', () => {
+  let now = START;
+  const clock = () => now;
+
+  beforeEach(() => {
+    now = START;
+  });
+
+  it('adds each line as a task, with its priority and tags', () => {
+    const list = createTodoList(clock);
+    const result = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;low;');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+    const insurance = list.find('Renew the insurance');
+    assert.equal(insurance.ok && insurance.value.priority, 'high');
+    assert.deepEqual(insurance.ok && insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.equal(milk.ok && milk.value.priority, 'low');
+    assert.deepEqual(milk.ok && milk.value.tags, []);
+  });
+
+  it('gives a normal priority when the priority is empty', () => {
+    const list = createTodoList(clock);
+    importTasks(list, 'Water the plants;;home');
+    const task = list.find('Water the plants');
+    assert.equal(task.ok && task.value.priority, 'normal');
+    assert.deepEqual(task.ok && task.value.tags, ['home']);
+  });
+
+  it('splits tags on runs of spaces, so repeated spaces make no empty tag', () => {
+    const list = createTodoList(clock);
+    importTasks(list, 'Call the dentist;normal;  health   family ');
+    const task = list.find('Call the dentist');
+    assert.deepEqual(task.ok && task.value.tags, ['health', 'family']);
+  });
+
+  it('skips blank lines without rejecting them, and counts them in line numbers', () => {
+    const list = createTodoList(clock);
+    const result = importTasks(list, 'One;;\n\n   \nTwo;bogus;\nThree;;');
+    assert.equal(result.imported, 2);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0]?.line, 4);
+    assert.match(result.rejected[0]?.reason ?? '', /"bogus" is not a priority/);
+    assert.equal(list.list().length, 2);
+  });
+
+  it('accepts lines that end in CRLF, as spreadsheet exports do', () => {
+    const list = createTodoList(clock);
+    const result = importTasks(list, 'One;high;a\r\nTwo;;b\r\n');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+    assert.equal(list.find('Two').ok, true);
+  });
+
+  it('rejects a line that does not have exactly three fields', () => {
+    const list = createTodoList(clock);
+    const result = importTasks(list, 'Only a title\nToo;many;fields;here\nGood;;');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(
+      result.rejected.map((item) => item.line),
+      [1, 2],
+    );
+    for (const item of result.rejected) assert.match(item.reason, /three fields/);
+    assert.equal(list.list().length, 1);
+  });
+
+  it('rejects an invalid priority with the list\'s reason, and imports the other lines', () => {
+    const list = createTodoList(clock);
+    const result = importTasks(list, 'Good;;\nBad;urgent;\nAlso good;high;');
+    assert.equal(result.imported, 2);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0]?.line, 2);
+    assert.match(result.rejected[0]?.reason ?? '', /"urgent" is not a priority/);
+    assert.equal(list.find('Bad').ok, false);
+  });
+
+  it('rejects a title that is empty or too long', () => {
+    const list = createTodoList(clock);
+    const result = importTasks(list, `;high;\n${'x'.repeat(121)};;`);
+    assert.equal(result.imported, 0);
+    assert.deepEqual(
+      result.rejected.map((item) => item.line),
+      [1, 2],
+    );
+    assert.match(result.rejected[0]?.reason ?? '', /empty/);
+    assert.match(result.rejected[1]?.reason ?? '', /121 characters/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a duplicate title, including one repeated within the same text', () => {
+    const list = createTodoList(clock);
+    list.add({ title: 'Existing' });
+    const result = importTasks(list, 'Existing;;\nNew;;\nNew;high;');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(
+      result.rejected.map((item) => item.line),
+      [1, 3],
+    );
+    assert.match(result.rejected[0]?.reason ?? '', /already a task "Existing"/);
+    assert.equal(list.list().length, 2);
+  });
+
+  it('returns nothing imported and nothing rejected for empty text', () => {
+    const list = createTodoList(clock);
+    assert.deepEqual(importTasks(list, ''), { imported: 0, rejected: [] });
+    assert.deepEqual(importTasks(list, '\n \n'), { imported: 0, rejected: [] });
+    assert.equal(list.list().length, 0);
+  });
+
+  it('stamps the imported tasks with the list clock', () => {
+    const list = createTodoList(clock);
+    importTasks(list, 'Stamped;;');
+    const task = list.find('Stamped');
+    assert.equal(task.ok && task.value.createdAt, START);
+    assert.equal(task.ok && task.value.updatedAt, START);
+  });
+});
