new file mode 100644
index 0000000000000000000000000000000000000000..578f27fc733fcd8358c798ff0495bf5ef8e7f57d
--- /dev/null
+++ b/src/domain/import.ts
@@ -0,0 +1,61 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { TaskList } from './list.ts';
+import { checkPriority } from './task.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** A line of the import text that did not become a task: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks were added, and every line that could not be added. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds every task in `text` to `list`, one per line, each as `title;priority;tags`. An empty priority
+ * gives a normal task, and tags are separated by spaces. Blank lines are skipped. A line that cannot be
+ * added is reported and leaves the list as it is; the other lines are still added. Lines may end in
+ * CRLF.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the tasks, one per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  text.split(/\r?\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const parsed = parseTaskLine(raw);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line: index + 1, reason: added.error.message });
+    }
+  });
+  return { imported, rejected };
+}
+
+/**
+ * The task a line of the import text describes, if the line has exactly three fields and its priority
+ * is valid. The title and tags are checked by the list when the task is added.
+ *
+ * @param raw - one line of the import text
+ */
+function parseTaskLine(raw: string): Result<NewTask> {
+  const fields = raw.split(';');
+  if (fields.length !== 3) return err('invalid-input', 'a line needs three fields: title;priority;tags');
+  const [title, priorityField, tagsField] = fields.map((field) => field.trim());
+  const priority = priorityField === '' ? ok<Priority>('normal') : checkPriority(priorityField);
+  if (!priority.ok) return priority;
+  return ok({
+    title,
+    priority: priority.value,
+    tags: tagsField.split(/\s+/).filter((tag) => tag !== ''),
+  });
+}
