diff --git a/src/domain/task.ts b/src/domain/task.ts
index e4116dabd533f5c3cc309e4707eb053c05e8bac0..c122e008eb0c764101d9a8456c7748546ff3e249 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -32,6 +32,64 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/** The longest a task title may be, in characters, once its surrounding spaces are removed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * The title with its surrounding spaces removed, if it is a valid title: not empty, and at most
+ * `MAX_TITLE_LENGTH` characters.
+ *
+ * @param title - the title as it was typed
+ */
+export function checkTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'a task needs a title, and the title is empty');
+  const length = [...trimmed].length;
+  if (length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${length} characters long; the limit is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority, if it is one of `low`, `normal` or `high`. Checked at runtime, since a screen may pass a
+ * value the types do not cover.
+ *
+ * @param priority - the priority as it was given
+ */
+export function checkPriority(priority: unknown): Result<Priority> {
+  if ((PRIORITIES as readonly unknown[]).includes(priority)) return ok(priority as Priority);
+  return err('invalid-input', `"${String(priority)}" is not a priority; use low, normal or high`);
+}
+
+/**
+ * The tag, if it is valid: not empty, and without a space.
+ *
+ * @param tag - the tag as it was typed
+ */
+export function checkTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'a tag cannot be empty');
+  if (tag.includes(' ')) return err('invalid-input', `the tag "${tag}" contains a space; use a single word`);
+  return ok(tag);
+}
+
+/**
+ * What it takes to add a task, checked: the title, priority and every tag must be valid.
+ *
+ * @param input - the title, priority and tags as they were typed
+ */
+export function checkNewTask(input: NewTask): Result<NewTask> {
+  const title = checkTitle(input.title);
+  if (!title.ok) return title;
+  const priority = checkPriority(input.priority ?? 'normal');
+  if (!priority.ok) return priority;
+  for (const tag of input.tags ?? []) {
+    const checked = checkTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok({ title: title.value, priority: priority.value, tags: input.tags });
+}
+
