@@ -204,3 +204,68 @@ describe('task list', () => {
     assert.equal(list.list()[0]?.updatedAt, LATER);
   });
 });
+
+describe('task list input checks', () => {
+  const clock = () => START;
+
+  function refusedWith(result: { ok: boolean; error?: { code: string; message: string } }): string {
+    assert.equal(result.ok, false);
+    if (result.ok || result.error === undefined) assert.fail('expected a refusal');
+    assert.equal(result.error.code, 'invalid-input');
+    assert.notEqual(result.error.message, '');
+    return result.error.message;
+  }
+
+  it('refuses an empty title, or one of only spaces, on add and rename', () => {
+    const list = createTodoList(clock);
+    const kept = valueOf(list.add({ title: 'Keep me' }));
+    refusedWith(list.add({ title: '' }));
+    refusedWith(list.add({ title: '   ' }));
+    refusedWith(list.rename(kept.id, '  '));
+    assert.equal(valueOf(list.get(kept.id)).title, 'Keep me');
+    assert.equal(list.list().length, 1);
+  });
+
+  it('refuses a title longer than 120 characters, and accepts one of exactly 120', () => {
+    const list = createTodoList(clock);
+    const exact = 'a'.repeat(120);
+    assert.equal(valueOf(list.add({ title: exact })).title, exact);
+    const message = refusedWith(list.add({ title: 'b'.repeat(121) }));
+    assert.match(message, /121 characters/);
+    assert.match(message, /120/);
+    refusedWith(list.rename(exact, 'c'.repeat(121)));
+    assert.equal(valueOf(list.find(exact)).title, exact);
+  });
+
+  it('measures the title length without its surrounding spaces', () => {
+    const list = createTodoList(clock);
+    assert.equal(valueOf(list.add({ title: `  ${'d'.repeat(120)}  ` })).title, 'd'.repeat(120));
+  });
+
+  it('refuses a priority other than low, normal or high, on add', () => {
+    const list = createTodoList(clock);
+    const message = refusedWith(list.add({ title: 'Urgent', priority: 'urgent' as 'low' }));
+    assert.match(message, /urgent/);
+    assert.equal(list.list().length, 0);
+    assert.equal(valueOf(list.add({ title: 'Fine', priority: 'high' })).priority, 'high');
+  });
+
+  it('refuses an empty tag, or a tag with a space, on add and tag', () => {
+    const list = createTodoList(clock);
+    const task = valueOf(list.add({ title: 'Tag me' }));
+    refusedWith(list.add({ title: 'Bad tags', tags: ['ok', ''] }));
+    refusedWith(list.add({ title: 'Spaced', tags: ['two words'] }));
+    refusedWith(list.tag(task.id, ''));
+    const message = refusedWith(list.tag(task.id, 'two words'));
+    assert.match(message, /two words/);
+    assert.equal(list.list().length, 1);
+    assert.deepEqual(valueOf(list.get(task.id)).tags, []);
+    assert.equal(valueOf(list.get(task.id)).updatedAt, START);
+  });
+
+  it('leaves a list unchanged when a rejected rename or tag names an unknown task', () => {
+    const list = createTodoList(clock);
+    refusedWith(list.tag('no-such-task', 'x y'));
+    assert.equal(list.list().length, 0);
+  });
+});
