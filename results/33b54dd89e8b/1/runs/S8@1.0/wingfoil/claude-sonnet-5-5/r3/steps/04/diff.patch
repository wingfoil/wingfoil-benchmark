@@ -0,0 +1,30 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds each valid line with its priority and tags', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;;\nCall mum');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const [insurance] = list.list({ priority: 'high' });
+    assert.deepEqual(insurance?.tags, ['admin', 'money']);
+    assert.equal(list.list({ priority: 'normal' }).length, 2);
+  });
+
+  it('skips blank lines but counts them in line numbers', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'A\r\n\r\n  \r\n;low;x\r\nB;urgent;\r\nA;;\r\na;b;c;d');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(
+      report.rejected.map((r) => r.line),
+      [4, 5, 6, 7],
+    );
+    assert.match(report.rejected[1]?.reason ?? '', /urgent/);
+  });
+
+  it('rejects nothing on empty text', () => {
+    assert.deepEqual(importTasks(createTodoList(), ''), { imported: 0, rejected: [] });
+  });
+});
