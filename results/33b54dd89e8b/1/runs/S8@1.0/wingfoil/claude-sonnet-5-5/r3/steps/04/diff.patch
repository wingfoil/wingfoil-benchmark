+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+import { validatePriority } from './task.ts';
+
+/** A line of the import text that could not be added. */
+export interface RejectedLine {
+  /** The line number in the text, counting from 1. */
+  readonly line: number;
+  /** What is wrong with the line, for the person importing. */
+  readonly reason: string;
+}
+
+/** The outcome of a bulk import: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks described in `text` to `list`, one per line, as `title;priority;tags`. The priority may be
+ * empty for a normal one, the tags are separated by spaces, and the priority and tags may be left out.
+ * Blank lines are skipped; every other line that cannot be added is reported and the rest are still added.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+
+  text.split(/\r\n|\n|\r/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `the line has ${fields.length} fields; expected at most 3 (title;priority;tags)` });
+      return;
+    }
+    const [title = '', rawPriority = '', rawTags = ''] = fields;
+
+    let priority: Priority | undefined;
+    if (rawPriority.trim() !== '') {
+      const checked = validatePriority(rawPriority.trim());
+      if (!checked.ok) {
+        rejected.push({ line, reason: checked.error.message });
+        return;
+      }
+      priority = checked.value;
+    }
+
+    const tags = rawTags.split(/\s+/).filter((tag) => tag !== '');
+    const added = list.add({ title, ...(priority === undefined ? {} : { priority }), tags });
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+
+  return { imported, rejected };
+}
