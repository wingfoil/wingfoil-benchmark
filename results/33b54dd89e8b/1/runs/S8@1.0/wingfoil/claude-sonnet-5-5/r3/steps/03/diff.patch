+
+describe('input validation', () => {
+  const code = (r: { ok: boolean; error?: { code: string } }) => (r.ok ? 'ok' : r.error?.code);
+
+  it('rejects bad input and leaves the list unchanged', () => {
+    const list = createTodoList();
+    list.add({ title: 'a', tags: ['x'] });
+    const before = JSON.stringify(list.list());
+    assert.equal(code(list.add({ title: '' })), 'invalid-input');
+    assert.equal(code(list.add({ title: '   ' })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'x'.repeat(121) })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'b', priority: 'urgent' as never })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'b', tags: ['ok', ''] })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'b', tags: ['a b'] })), 'invalid-input');
+    assert.equal(code(list.rename('a', ' ')), 'invalid-input');
+    assert.equal(code(list.rename('a', 'x'.repeat(121))), 'invalid-input');
+    assert.equal(code(list.tag('a', '')), 'invalid-input');
+    assert.equal(code(list.tag('a', 'two words')), 'invalid-input');
+    assert.equal(JSON.stringify(list.list()), before);
+  });
+
+  it('accepts the limits', () => {
+    const list = createTodoList();
+    assert.equal(code(list.add({ title: 'x'.repeat(120), priority: 'high', tags: ['t'] })), 'ok');
+  });
+});
