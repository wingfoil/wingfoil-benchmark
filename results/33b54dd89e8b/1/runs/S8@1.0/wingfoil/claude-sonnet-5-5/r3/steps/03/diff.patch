   return a.title < b.title ? -1 : a.title > b.title ? 1 : 0;
 }
 
+/** The longest title a task can have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Whether a title is acceptable: not blank, and at most {@link MAX_TITLE_LENGTH} characters once trimmed.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'the title is empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; the limit is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Whether a priority is one of `low`, `normal` and `high`.
+ *
+ * @param priority - the priority as typed
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  const known = PRIORITIES.find((candidate) => candidate === priority);
+  return known === undefined
+    ? err('invalid-input', `the priority "${priority}" is not one of ${PRIORITIES.join(', ')}`)
+    : ok(known);
+}
+
+/**
+ * Whether a tag is acceptable: not empty and without whitespace.
+ *
+ * @param tag - the tag as typed
+ */
+export function validateTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'the tag is empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space`);
+  return ok(tag);
+}
+
 function unique(tags: readonly string[]): string[] {
   return tags.filter((tag, index) => tags.indexOf(tag) === index);
 }
