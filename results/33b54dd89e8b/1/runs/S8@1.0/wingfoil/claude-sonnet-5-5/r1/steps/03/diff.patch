+
+describe('input validation', () => {
+  const code = (result: { ok: boolean; error?: { code: string } }) => (result.ok ? 'ok' : result.error?.code);
+
+  it('rejects bad titles, priorities and tags when adding, changing nothing', () => {
+    const list = createTodoList();
+    assert.equal(code(list.add({ title: '   ' })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'x'.repeat(121) })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'ok', priority: 'urgent' as never })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'ok', tags: ['fine', ''] })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'ok', tags: ['two words'] })), 'invalid-input');
+    assert.equal(list.list().length, 0);
+    assert.equal(code(list.add({ title: 'x'.repeat(120) })), 'ok');
+  });
+
+  it('rejects a bad new title or tag, leaving the task as it was', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'Sweep' }));
+    assert.equal(code(list.rename('Sweep', '  ')), 'invalid-input');
+    assert.equal(code(list.rename('Sweep', 'y'.repeat(121))), 'invalid-input');
+    assert.equal(code(list.tag('Sweep', '')), 'invalid-input');
+    assert.equal(code(list.tag('Sweep', 'a b')), 'invalid-input');
+    assert.deepEqual(valueOf(list.find('Sweep')), before);
+  });
+});
