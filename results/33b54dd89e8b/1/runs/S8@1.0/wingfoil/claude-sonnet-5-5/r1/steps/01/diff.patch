+
+describe('task ids', () => {
+  it('gives each task its own id, kept when renamed', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    const b = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(a.id, b.id);
+    const renamed = valueOf(list.rename(a.id, 'c'));
+    assert.equal(renamed.id, a.id);
+    assert.equal(valueOf(list.get(a.id)).title, 'c');
+    assert.equal(list.find('a').ok, false);
+  });
+
+  it('accepts an id wherever a title is taken', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'a' }));
+    assert.equal(valueOf(list.find(id)).title, 'a');
+    assert.deepEqual(valueOf(list.tag(id, 'x')).tags, ['x']);
+    assert.deepEqual(valueOf(list.untag(id, 'x')).tags, []);
+    assert.equal(valueOf(list.complete(id)).status, 'done');
+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.equal(valueOf(list.rename(id, 'a')).title, 'a');
+    valueOf(list.remove(id));
+    assert.equal(list.openCount(), 0);
+  });
+
+  it('never reuses the id of a removed task, and reports an unknown id', () => {
+    const list = createTodoList();
+    const first = valueOf(list.add({ title: 'a' }));
+    list.remove('a');
+    assert.notEqual(valueOf(list.add({ title: 'a' })).id, first.id);
+    const missing = list.get(first.id);
+    assert.equal(missing.ok, false);
+    if (!missing.ok) assert.equal(missing.error.code, 'not-found');
+  });
+});
