+
+describe('input validation', () => {
+  const rejected = (result: { ok: boolean; error?: { code: string; message: string } }): void => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+    assert.ok((result.error?.message ?? '').length > 0);
+  };
+
+  it('rejects bad titles, priorities and tags on add, leaving the list unchanged', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: '' }));
+    rejected(list.add({ title: '   ' }));
+    rejected(list.add({ title: 'x'.repeat(121) }));
+    rejected(list.add({ title: 'ok', priority: 'urgent' as never }));
+    rejected(list.add({ title: 'ok', tags: ['fine', ''] }));
+    rejected(list.add({ title: 'ok', tags: ['two words'] }));
+    assert.equal(list.list().length, 0);
+    assert.ok(list.add({ title: 'x'.repeat(120) }).ok);
+    assert.ok(list.add({ title: 'ok', priority: 'high', tags: ['a-b'] }).ok);
+  });
+
+  it('rejects bad titles on rename and bad tags on tag, changing nothing', () => {
+    const list = createTodoList();
+    list.add({ title: 'a' });
+    const before = JSON.stringify(list.list());
+    rejected(list.rename('a', ' '));
+    rejected(list.rename('a', 'x'.repeat(121)));
+    rejected(list.tag('a', ''));
+    rejected(list.tag('a', 'has space'));
+    assert.equal(JSON.stringify(list.list()), before);
+  });
+});
