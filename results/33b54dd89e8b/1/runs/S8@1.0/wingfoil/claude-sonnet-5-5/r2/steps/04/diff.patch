+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds valid lines, skips blank ones and reports the rest with their line numbers', () => {
+    const list = createTodoList();
+    const text = [
+      'Renew the insurance;high;admin money',
+      '',
+      'Buy milk;;',
+      'Water plants',
+      'Bad;urgent;x',
+      ';low;',
+      'Buy milk;low;',
+      'Tag;low;a b;extra',
+    ].join('\n');
+    const result = importTasks(list, text);
+    assert.equal(result.imported, 3);
+    assert.deepEqual(
+      result.rejected.map((r) => r.line),
+      [5, 6, 7, 8],
+    );
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    assert.equal(list.list().length, 3);
+  });
+
+  it('handles Windows line endings', () => {
+    const list = createTodoList();
+    assert.equal(importTasks(list, 'A;low;\r\nB;;x\r\n').imported, 2);
+  });
+});
