+describe('task timestamps', () => {
+  it('records createdAt and updatedAt, and bumps updatedAt on every change', () => {
+    let tick = 0;
+    const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)));
+    const added = list.add({ title: 'a' });
+    assert.ok(added.ok);
+    assert.equal(added.value.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(added.value.updatedAt, added.value.createdAt);
+    const steps = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.rename('a', 'b'),
+      () => list.tag('b', 'x'),
+      () => list.untag('b', 'x'),
+    ];
+    steps.forEach((step, index) => {
+      const result = step();
+      assert.ok(result.ok);
+      assert.equal(result.value.createdAt, '2026-01-01T00:00:00.000Z');
+      assert.equal(result.value.updatedAt, `2026-01-01T00:00:0${index + 1}.000Z`);
+    });
+  });
+});
