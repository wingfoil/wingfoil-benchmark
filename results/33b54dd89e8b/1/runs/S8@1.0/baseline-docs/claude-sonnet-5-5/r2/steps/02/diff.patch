+
+describe('task dates', () => {
+  function steppingClock(): () => string {
+    let minute = 0;
+    return () => new Date(Date.UTC(2026, 0, 1, 0, minute++)).toISOString();
+  }
+
+  it('dates a new task with equal creation and update times', () => {
+    const task = valueOf(createTodoList(steppingClock()).add({ title: 'a' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets the update time on every kind of change, and keeps the creation time', () => {
+    const list = createTodoList(steppingClock());
+    const { createdAt } = valueOf(list.add({ title: 'a' }));
+    const changes = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.rename('a', 'b'),
+      () => list.tag('b', 'x'),
+      () => list.untag('b', 'x'),
+    ];
+    let previous = createdAt;
+    for (const change of changes) {
+      const task = valueOf(change());
+      assert.equal(task.createdAt, createdAt);
+      assert.ok(task.updatedAt > previous);
+      previous = task.updatedAt;
+    }
+  });
+
+  it('leaves the update time alone when a change fails', () => {
+    const list = createTodoList(steppingClock());
+    const before = valueOf(list.add({ title: 'a' }));
+    assert.equal(list.reopen('a').ok, false);
+    assert.deepEqual(valueOf(list.get(before.id)), before);
+  });
+});
