+
+describe('importTasks', () => {
+  it('adds every valid line, with priority and tags', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\nBuy milk;;\nCall mum\r\nWash car;low;car');
+    assert.deepEqual(report, { imported: 4, rejected: [] });
+    const insurance = valueOf(list.find('Renew the insurance'));
+    assert.equal(insurance.priority, 'high');
+    assert.deepEqual(insurance.tags, ['admin', 'money']);
+    assert.equal(valueOf(list.find('Buy milk')).priority, 'normal');
+  });
+
+  it('rejects bad lines with their number and carries on', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const report = importTasks(list, ';high;x\n\nGood;urgent;\nExisting\nA;b;c;d\nFine');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(report.rejected.map((r) => r.line), [1, 3, 4, 5]);
+    assert.ok(report.rejected.every((r) => r.reason.length > 0));
+  });
+});
