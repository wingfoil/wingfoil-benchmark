+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { TaskList } from './list.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** A line of an import that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks it added, and every line it could not add. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Reads one line, `title;priority;tags`, as a new task. The priority and the tags may be left out or
+ * empty; the tags are separated by spaces. Whether the values are valid is left to the list.
+ *
+ * @param line - one non-blank line of an import
+ */
+export function parseTaskLine(line: string): Result<NewTask> {
+  const fields = line.split(';');
+  if (fields.length > 3) {
+    return err('invalid-input', `expected at most 3 fields (title;priority;tags) but found ${fields.length}`);
+  }
+  const [title = '', priority = '', tags = ''] = fields;
+  const words = tags.split(/\s+/).filter((tag) => tag !== '');
+  return ok({
+    title,
+    ...(priority.trim() === '' ? {} : { priority: priority.trim().toLowerCase() as Priority }),
+    tags: words,
+  });
+}
+
+/**
+ * Adds the tasks written in `text`, one per line as `title;priority;tags`, to the list. Blank lines
+ * are skipped; a line that cannot be added is reported and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  text.split(/\r\n|\r|\n/).forEach((line, index) => {
+    if (line.trim() === '') return;
+    const parsed = parseTaskLine(line);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
