index c4e3534b382a7385cab8f7bc43d8e4fc138aaa26..2e6b7c52086c0fc329a23c1d850d820fdf265472 100644
--- a/test/list.test.ts
+++ b/test/list.test.ts
@@ -160,3 +160,44 @@ describe('task dates', () => {
     assert.deepEqual(valueOf(list.get(before.id)), before);
   });
 });
+
+describe('input validation', () => {
+  const rejected = (result: { ok: boolean; error?: { code: string; message: string } }, text: RegExp) => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+    assert.match(result.error?.message ?? '', text);
+  };
+
+  it('rejects an empty, blank or too long title when adding', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: '' }), /empty/);
+    rejected(list.add({ title: '   ' }), /empty/);
+    rejected(list.add({ title: 'x'.repeat(121) }), /120/);
+    assert.equal(list.list().length, 0);
+    valueOf(list.add({ title: 'x'.repeat(120) }));
+  });
+
+  it('rejects an unknown priority and a bad tag when adding', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: 'A', priority: 'urgent' as 'high' }), /priority/);
+    rejected(list.add({ title: 'A', tags: ['ok', ''] }), /tag/);
+    rejected(list.add({ title: 'A', tags: ['two words'] }), /space/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a bad new title when renaming, and changes nothing', () => {
+    const list = createTodoList();
+    list.add({ title: 'A' });
+    rejected(list.rename('A', '  '), /empty/);
+    rejected(list.rename('A', 'y'.repeat(121)), /120/);
+    assert.equal(valueOf(list.find('A')).title, 'A');
+  });
+
+  it('rejects a bad tag when tagging, and changes nothing', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'A' }));
+    rejected(list.tag('A', ''), /empty/);
+    rejected(list.tag('A', 'a b'), /space/);
+    assert.deepEqual(valueOf(list.find('A')), before);
+  });
+});
