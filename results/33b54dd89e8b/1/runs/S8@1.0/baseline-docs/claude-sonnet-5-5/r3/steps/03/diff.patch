@@ -168,3 +168,41 @@ describe('task list', () => {
     assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
   });
 });
+
+describe('input validation', () => {
+  const code = (r: { ok: boolean; error?: { code: string } }) => (r.ok ? 'ok' : r.error?.code);
+
+  it('refuses an empty, blank or over-long title when adding', () => {
+    const list = createTodoList();
+    assert.equal(code(list.add({ title: '' })), 'invalid-input');
+    assert.equal(code(list.add({ title: '   ' })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'x'.repeat(121) })), 'invalid-input');
+    assert.equal(list.list().length, 0);
+    assert.equal(code(list.add({ title: 'x'.repeat(120) })), 'ok');
+  });
+
+  it('refuses an unknown priority and bad tags when adding', () => {
+    const list = createTodoList();
+    assert.equal(code(list.add({ title: 'a', priority: 'urgent' as never })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'a', tags: ['ok', ''] })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'a', tags: ['two words'] })), 'invalid-input');
+    assert.equal(list.list().length, 0);
+  });
+
+  it('refuses a bad new title when renaming, and changes nothing', () => {
+    const list = createTodoList();
+    list.add({ title: 'a' });
+    assert.equal(code(list.rename('a', '  ')), 'invalid-input');
+    assert.equal(code(list.rename('a', 'x'.repeat(121))), 'invalid-input');
+    assert.equal(list.list()[0]?.title, 'a');
+  });
+
+  it('refuses an empty tag or one with a space, and changes nothing', () => {
+    const list = createTodoList();
+    list.add({ title: 'a' });
+    assert.equal(code(list.tag('a', '')), 'invalid-input');
+    assert.equal(code(list.tag('a', 'home work')), 'invalid-input');
+    assert.deepEqual(list.list()[0]?.tags, []);
+    assert.equal(code(list.tag('a', 'home')), 'ok');
+  });
+});
