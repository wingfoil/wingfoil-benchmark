+
+describe('bulk import', () => {
+  it('adds every valid line, with its priority and tags', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\nBuy milk;;\nCall mum');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = valueOf(list.find('Renew the insurance'));
+    assert.equal(insurance.priority, 'high');
+    assert.deepEqual(insurance.tags, ['admin', 'money']);
+    assert.equal(valueOf(list.find('Buy milk')).priority, 'normal');
+  });
+
+  it('rejects bad lines with their number, and still adds the others', () => {
+    const list = createTodoList();
+    list.add({ title: 'Taken' });
+    const report = importTasks(list, 'Fine;low;a\r\n\n;high;\nOops;urgent;\nTaken;;\nToo;low;a;b\nFine;;');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(report.rejected.map((r) => r.line), [3, 4, 5, 6, 7]);
+    assert.equal(list.list().length, 2);
+  });
+});
