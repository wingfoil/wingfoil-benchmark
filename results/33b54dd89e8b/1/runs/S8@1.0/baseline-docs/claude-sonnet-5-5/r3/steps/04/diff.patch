+++ b/src/domain/import.ts
@@ -0,0 +1,57 @@
+import { validatePriority } from './task.ts';
+import type { TaskList } from './list.ts';
+import type { NewTask } from './task.ts';
+
+/** A line of the imported text that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks were added, and every line that was not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+const MAX_FIELDS = 3;
+
+/**
+ * Adds to the list a task for every valid line of `text`, one task per line as `title;priority;tags`.
+ * The priority may be empty for a normal one; the tags are separated by spaces and may be left out.
+ * Blank lines are skipped, but still count in the line numbers. A line the list refuses, such as a
+ * title already taken, is rejected with the list's reason; the other lines are added all the same.
+ *
+ * @param list - the task list to add to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const reason = importLine(list, raw);
+    if (reason === undefined) imported += 1;
+    else rejected.push({ line: index + 1, reason });
+  });
+  return { imported, rejected };
+}
+
+function importLine(list: TaskList, raw: string): string | undefined {
+  const parsed = parseLine(raw);
+  if (typeof parsed === 'string') return parsed;
+  const added = list.add(parsed);
+  return added.ok ? undefined : added.error.message;
+}
+
+function parseLine(raw: string): NewTask | string {
+  const fields = raw.split(';');
+  if (fields.length > MAX_FIELDS) {
+    return `the line has ${fields.length} fields; it takes at most ${MAX_FIELDS}: title;priority;tags`;
+  }
+  const [title = '', priority = '', tags = ''] = fields.map((field) => field.trim());
+  const tagList = tags.split(/\s+/).filter((tag) => tag !== '');
+  if (priority === '') return { title, tags: tagList };
+  const checked = validatePriority(priority);
+  return checked.ok ? { title, priority: checked.value, tags: tagList } : checked.error.message;
+}
