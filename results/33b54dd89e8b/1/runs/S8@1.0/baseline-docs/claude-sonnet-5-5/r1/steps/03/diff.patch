diff --git a/src/domain/validation.ts b/src/domain/validation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bb2e3ffa3ed842d19f1b656b2f1b32039c2be09e
--- /dev/null
+++ b/src/domain/validation.ts
@@ -0,0 +1,65 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** The most characters a title may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * The title, trimmed, if it is fit for a task: not empty and at most `MAX_TITLE_LENGTH` characters.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: unknown): Result<string> {
+  if (typeof title !== 'string') return err('invalid-input', 'the title must be text');
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'the title is empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; the most allowed is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority, if it is one of `low`, `normal` and `high`.
+ *
+ * @param priority - the priority as given
+ */
+export function validatePriority(priority: unknown): Result<Priority> {
+  if (!PRIORITIES.includes(priority as Priority)) {
+    return err('invalid-input', `the priority ${JSON.stringify(priority)} is not one of ${PRIORITIES.join(', ')}`);
+  }
+  return ok(priority as Priority);
+}
+
+/**
+ * The tag, if it is fit to tag a task with: not empty and without a space.
+ *
+ * @param tag - the tag as typed
+ */
+export function validateTag(tag: unknown): Result<string> {
+  if (typeof tag !== 'string') return err('invalid-input', 'a tag must be text');
+  if (tag === '') return err('invalid-input', 'a tag is empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space`);
+  return ok(tag);
+}
+
+/**
+ * Checks everything a new task is made of: its title, its priority when given, and its tags.
+ *
+ * @param input - the new task as given by a screen
+ */
+export function validateNewTask(input: NewTask): Result<NewTask> {
+  const title = validateTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined) {
+    const priority = validatePriority(input.priority);
+    if (!priority.ok) return priority;
+  }
+  for (const tag of input.tags ?? []) {
+    const checked = validateTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok(input);
+}
diff --git a/test/list.test.ts b/test/list.test.ts
index eb5f66c514d4bf240a995592fbfae01c34ab4d52..a3b763ce47f300fd64e94014bb804e570fa75925 100644
--- a/test/list.test.ts
+++ b/test/list.test.ts
@@ -159,3 +159,46 @@ describe('task timestamps', () => {
     assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
   });
 });
+
+describe('input validation', () => {
+  const rejected = (result: { ok: boolean; error?: { code: string; message: string } }, text: RegExp) => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+    assert.match(result.error?.message ?? '', text);
+  };
+
+  it('rejects an empty, blank or too long title when adding', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: '' }), /empty/);
+    rejected(list.add({ title: '   ' }), /empty/);
+    rejected(list.add({ title: 'x'.repeat(121) }), /120/);
+    assert.equal(list.list().length, 0);
+    assert.equal(list.add({ title: 'x'.repeat(120) }).ok, true);
+  });
+
+  it('rejects an unknown priority or a bad tag when adding', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: 'a', priority: 'urgent' as never }), /priority/);
+    rejected(list.add({ title: 'a', tags: ['ok', ''] }), /empty/);
+    rejected(list.add({ title: 'a', tags: ['two words'] }), /space/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a bad new title and changes nothing', () => {
+    const list = createTodoList();
+    list.add({ title: 'a' });
+    rejected(list.rename('a', '  '), /empty/);
+    rejected(list.rename('a', 'y'.repeat(121)), /120/);
+    assert.equal(list.list()[0]?.title, 'a');
+    assert.equal(valueOf(list.rename('a', 'b')).title, 'b');
+  });
+
+  it('rejects a bad tag and changes nothing', () => {
+    const list = createTodoList();
+    list.add({ title: 'a' });
+    rejected(list.tag('a', ''), /empty/);
+    rejected(list.tag('a', 'x y'), /space/);
+    assert.deepEqual(list.list()[0]?.tags, []);
+    assert.deepEqual(valueOf(list.tag('a', 'home')).tags, ['home']);
+  });
+});
