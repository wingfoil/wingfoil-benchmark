+
+describe('task ids', () => {
+  it('gives each task its own id, and get returns the task', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    const b = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(a.id, b.id);
+    assert.deepEqual(valueOf(list.get(a.id)), a);
+  });
+
+  it('keeps the id when the task is renamed, and accepts it instead of a title', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'Old' }));
+    const renamed = valueOf(list.rename(id, 'New'));
+    assert.equal(renamed.id, id);
+    assert.equal(valueOf(list.get(id)).title, 'New');
+    assert.equal(list.find('Old').ok, false);
+    assert.equal(valueOf(list.complete(id)).status, 'done');
+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.deepEqual(valueOf(list.tag(id, 'x')).tags, ['x']);
+    assert.deepEqual(valueOf(list.untag(id, 'x')).tags, []);
+    assert.equal(valueOf(list.remove(id)).title, 'New');
+    assert.equal(list.openCount(), 0);
+  });
+
+  it('reports an unknown id, and does not reuse the id of a removed task', () => {
+    const list = createTodoList();
+    const first = valueOf(list.add({ title: 'a' }));
+    const missing = list.get('nope');
+    assert.equal(missing.ok, false);
+    if (!missing.ok) assert.equal(missing.error.code, 'not-found');
+    list.remove(first.id);
+    assert.equal(list.get(first.id).ok, false);
+    assert.notEqual(valueOf(list.add({ title: 'a' })).id, first.id);
+  });
+
+  it('still refuses to rename onto another title, but allows renaming to the same title', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    list.add({ title: 'b' });
+    const clash = list.rename(a.id, 'b');
+    assert.equal(clash.ok, false);
+    assert.equal(list.rename(a.id, 'a').ok, true);
+  });
+});
