--- a/test/list.test.ts
+++ b/test/list.test.ts
@@ -8,11 +8,16 @@ function valueOf<T>(result: { ok: true; value: T } | { ok: false; error: unknown
   return result.value;
 }
 
+function steppingClock(): () => string {
+  let minute = 0;
+  return () => new Date(Date.UTC(2026, 0, 1, 0, minute++)).toISOString();
+}
+
 describe('task list', () => {
   it('adds an open task with a normal priority by default', () => {
     const list = createTodoList();
     const task = valueOf(list.add({ title: '  Buy milk ' }));
-    assert.deepEqual(task, { id: task.id, title: 'Buy milk', priority: 'normal', tags: [], status: 'open' });
+    assert.deepEqual(task, { id: task.id, title: 'Buy milk', priority: 'normal', tags: [], status: 'open', createdAt: task.createdAt, updatedAt: task.createdAt });
     assert.equal(list.openCount(), 1);
   });
 
@@ -115,3 +120,42 @@ describe('task ids', () => {
     assert.equal(list.rename(a.id, 'a').ok, true);
   });
 });
+
+describe('task timestamps', () => {
+  it('gives a new task the same createdAt and updatedAt', () => {
+    const list = createTodoList(steppingClock());
+    const task = valueOf(list.add({ title: 'a' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every kind of change, and keeps createdAt', () => {
+    const list = createTodoList(steppingClock());
+    const { id, createdAt } = valueOf(list.add({ title: 'a' }));
+    const changes = [
+      () => list.complete(id),
+      () => list.reopen(id),
+      () => list.rename(id, 'b'),
+      () => list.tag(id, 'x'),
+      () => list.untag(id, 'x'),
+    ];
+    changes.forEach((change, index) => {
+      const task = valueOf(change());
+      assert.equal(task.createdAt, createdAt);
+      assert.equal(task.updatedAt, new Date(Date.UTC(2026, 0, 1, 0, index + 1)).toISOString());
+      assert.deepEqual(valueOf(list.get(id)), task);
+    });
+  });
+
+  it('leaves updatedAt alone when a change fails', () => {
+    const list = createTodoList(steppingClock());
+    const added = valueOf(list.add({ title: 'a' }));
+    assert.equal(list.reopen('a').ok, false);
+    assert.deepEqual(valueOf(list.get(added.id)), added);
+  });
+
+  it('dates tasks with the current time by default', () => {
+    const task = valueOf(createTodoList().add({ title: 'a' }));
+    assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
+  });
+});
