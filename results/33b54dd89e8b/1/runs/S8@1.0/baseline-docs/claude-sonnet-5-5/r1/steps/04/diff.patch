+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { TaskList } from './list.ts';
+import type { NewTask } from './task.ts';
+import { validatePriority } from './validation.ts';
+
+/** A line of an import that could not be added, and why. */
+export interface RejectedLine {
+  /** The line's number in the text, counting from 1. */
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks it added, and the lines it could not add. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+const FIELD_SEPARATOR = ';';
+const MAX_FIELDS = 3;
+
+function parseLine(text: string): Result<NewTask> {
+  const fields = text.split(FIELD_SEPARATOR);
+  if (fields.length > MAX_FIELDS) {
+    return err('invalid-input', `the line has ${fields.length} fields; the most allowed is ${MAX_FIELDS} (title;priority;tags)`);
+  }
+  const [title = '', priority = '', tags = ''] = fields;
+  const words = tags.split(/\s+/).filter((tag) => tag !== '');
+  if (priority.trim() === '') return ok({ title, tags: words });
+  const checked = validatePriority(priority.trim().toLowerCase());
+  return checked.ok ? ok({ title, priority: checked.value, tags: words }) : checked;
+}
+
+/**
+ * Adds to the list the tasks written one per line as `title;priority;tags`. The priority may be left
+ * empty for a normal one; tags are separated by spaces. Blank lines are skipped, and a line that cannot
+ * be added is reported without stopping the others.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((content, index) => {
+    if (content.trim() === '') return;
+    const parsed = parseLine(content);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
