@@ -0,0 +1,27 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds each line with its priority and tags, skipping blank lines', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\nBuy milk;;\r\nCall mum');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok);
+    assert.equal(milk.value.priority, 'normal');
+  });
+
+  it('rejects bad lines with their line number and imports the rest', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Ok;low;\n;high;x\nDup;;\nDup;;\nBad;urgent;\na;b;c;d');
+    assert.equal(report.imported, 2);
+    assert.deepEqual(report.rejected.map((r) => r.line), [2, 4, 5, 6]);
+    assert.ok(report.rejected.every((r) => r.reason.length > 0));
+  });
+});
