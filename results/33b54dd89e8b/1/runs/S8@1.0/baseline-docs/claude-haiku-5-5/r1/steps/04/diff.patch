diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f5bd9d830196ba782fb9380ac0fd894ed20c7469
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,85 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('bulk import', () => {
+  it('adds each line as a task, with its priority and tags', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;low;');
+    assert.deepEqual(report, { imported: 2, rejected: [] });
+    assert.deepEqual(
+      list.list().map((task) => [task.title, task.priority, task.tags]),
+      [
+        ['Renew the insurance', 'high', ['admin', 'money']],
+        ['Buy milk', 'low', []],
+      ],
+    );
+  });
+
+  it('gives a task a normal priority when the priority is left empty', () => {
+    const list = createTodoList();
+    importTasks(list, 'Water the plants;;garden');
+    const task = list.find('Water the plants');
+    assert.ok(task.ok);
+    assert.equal(task.value.priority, 'normal');
+  });
+
+  it('skips blank lines without counting them as rejected, and numbers lines from 1', () => {
+    const list = createTodoList();
+    const report = importTasks(list, '\nBuy milk;;\n   \n;high;\nCall mum;;\n');
+    assert.equal(report.imported, 2);
+    assert.deepEqual(report.rejected, [{ line: 4, reason: 'the title cannot be empty or only spaces' }]);
+  });
+
+  it('reads CRLF line endings, as spreadsheets export them', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Buy milk;;\r\nCall mum;high;\r\n');
+    assert.deepEqual(report, { imported: 2, rejected: [] });
+  });
+
+  it('rejects a line with an unknown priority and adds the other lines', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Buy milk;urgent;\nCall mum;;');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(report.rejected, [
+      { line: 1, reason: 'the priority "urgent" is not low, normal or high' },
+    ]);
+    assert.equal(list.openCount(), 1);
+  });
+
+  it('rejects a line that does not have exactly three fields', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Buy milk\nCall mum;high\nPay rent;normal;home;extra');
+    assert.equal(report.imported, 0);
+    assert.deepEqual(report.rejected.map((rejection) => rejection.line), [1, 2, 3]);
+    assert.equal(list.openCount(), 0);
+  });
+
+  it('refuses a second line with a title already in the list, or repeated within the text', () => {
+    const list = createTodoList();
+    list.add({ title: 'Buy milk' });
+    const report = importTasks(list, 'Buy milk;;\nCall mum;;\nCall mum;high;');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(report.rejected, [
+      { line: 1, reason: 'there is already a task "Buy milk"' },
+      { line: 3, reason: 'there is already a task "Call mum"' },
+    ]);
+  });
+
+  it('trims spaces around the title and priority, and splits tags on any run of spaces', () => {
+    const list = createTodoList();
+    importTasks(list, '  Renew the insurance ; high ;  admin   money ');
+    const task = list.find('Renew the insurance');
+    assert.ok(task.ok);
+    assert.equal(task.value.priority, 'high');
+    assert.deepEqual(task.value.tags, ['admin', 'money']);
+  });
+
+  it('reports rejections with the reason the list gives, and reports nothing for empty text', () => {
+    const list = createTodoList();
+    assert.deepEqual(importTasks(list, ''), { imported: 0, rejected: [] });
+    const report = importTasks(list, ';;');
+    assert.deepEqual(report.rejected, [{ line: 1, reason: 'the title cannot be empty or only spaces' }]);
+  });
+});
