index 0000000000000000000000000000000000000000..d6fbf8ca7bf7898172019c17daf5bbf3eb6c1b58
--- /dev/null
+++ b/src/domain/import.ts
@@ -0,0 +1,54 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { TaskList } from './list.ts';
+import type { NewTask } from './task.ts';
+import { checkPriority } from './validation.ts';
+
+/** A line of an import that could not be added: its number, counting from 1, and why it was refused. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks it added, and every line it refused. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds one task per line of `text`, each line as `title;priority;tags`: the priority may be left empty for
+ * a normal one, and the tags are separated by spaces. Blank lines are skipped. A line that cannot be added
+ * is reported with its number and reason, and the other lines are still added.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import, one task per line
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  text.split(/\r?\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const parsed = parseLine(raw);
+    const outcome = parsed.ok ? list.add(parsed.value) : parsed;
+    if (outcome.ok) imported++;
+    else rejected.push({ line: index + 1, reason: outcome.error.message });
+  });
+  return { imported, rejected };
+}
+
+/**
+ * The task a line describes, before the list checks it, or why the line does not have the three fields.
+ *
+ * @param raw - one line of the import
+ */
+function parseLine(raw: string): Result<NewTask> {
+  const fields = raw.split(';');
+  if (fields.length !== 3) return err('invalid-input', 'a line holds a title, a priority and tags, separated by ";"');
+  const [title, priority, tags] = fields;
+  const tagList = tags.split(/\s+/).filter((tag) => tag !== '');
+  if (priority.trim() === '') return ok({ title, tags: tagList });
+  const checked = checkPriority(priority.trim());
+  if (!checked.ok) return checked;
+  return ok({ title, priority: checked.value, tags: tagList });
+}
