diff --git a/src/domain/validation.ts b/src/domain/validation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..35b16a27a3319d7db46843bd4922d20df612312c
--- /dev/null
+++ b/src/domain/validation.ts
@@ -0,0 +1,61 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** The longest a title may be, in characters, once its surrounding spaces are removed. */
+const TITLE_MAX_LENGTH = 120;
+
+/**
+ * The title, trimmed, if it is neither empty nor longer than the limit.
+ *
+ * @param title - the title as typed
+ */
+export function checkTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'the title cannot be empty or only spaces');
+  if ([...trimmed].length > TITLE_MAX_LENGTH) {
+    return err('invalid-input', `the title is longer than ${TITLE_MAX_LENGTH} characters`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority, if it is one of the priorities the list knows.
+ *
+ * @param priority - the priority as given
+ */
+export function checkPriority(priority: string): Result<Priority> {
+  const known = PRIORITIES.find((candidate) => candidate === priority);
+  return known === undefined
+    ? err('invalid-input', `the priority "${priority}" is not low, normal or high`)
+    : ok(known);
+}
+
+/**
+ * The tag, if it is not empty and holds no space.
+ *
+ * @param tag - the tag as given
+ */
+export function checkTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'a tag cannot be empty');
+  if (tag.includes(' ')) return err('invalid-input', `the tag "${tag}" cannot contain a space`);
+  return ok(tag);
+}
+
+/**
+ * The new task's title, priority and tags, each checked; the priority is `normal` unless given.
+ *
+ * @param input - the task as given, before it is added
+ */
+export function checkNewTask(input: NewTask): Result<NewTask> {
+  const title = checkTitle(input.title);
+  if (!title.ok) return title;
+  const priority = checkPriority(input.priority ?? 'normal');
+  if (!priority.ok) return priority;
+  for (const tag of input.tags ?? []) {
+    const checked = checkTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok({ title: title.value, priority: priority.value, tags: input.tags });
+}
