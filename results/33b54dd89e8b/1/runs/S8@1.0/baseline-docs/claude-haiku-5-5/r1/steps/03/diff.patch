@@ -202,3 +208,89 @@ describe('task list', () => {
     if (!result.ok) assert.equal(result.error.code, 'not-found');
   });
 });
+
+describe('input validation', () => {
+  const titleLimit = 120;
+
+  it('refuses a task whose title is empty or only spaces, and leaves the list unchanged', () => {
+    const list = createTodoList({ now: clockAt('2026-01-01T09:00:00.000Z') });
+    list.add({ title: 'Keep me' });
+    for (const title of ['', '   ']) {
+      const error = errorOf(list.add({ title }));
+      assert.equal(error.code, 'invalid-input');
+      assert.match(error.message, /title.*empty/);
+    }
+    assert.deepEqual(
+      list.list().map((task) => task.title),
+      ['Keep me'],
+    );
+  });
+
+  it('accepts a title of exactly 120 characters and refuses one longer', () => {
+    const list = createTodoList();
+    assert.equal(list.add({ title: 'a'.repeat(titleLimit) }).ok, true);
+    const error = errorOf(list.add({ title: 'b'.repeat(titleLimit + 1) }));
+    assert.equal(error.code, 'invalid-input');
+    assert.match(error.message, /120 characters/);
+    assert.equal(list.list().length, 1);
+  });
+
+  it('measures the title limit after trimming surrounding spaces', () => {
+    const list = createTodoList();
+    assert.equal(list.add({ title: `  ${'c'.repeat(titleLimit)}  ` }).ok, true);
+  });
+
+  it('refuses a rename to an empty or overlong title, and keeps the task as it was', () => {
+    const list = createTodoList({ now: clockAt('2026-01-01T09:00:00.000Z', '2026-01-02T09:00:00.000Z') });
+    list.add({ title: 'Sweep' });
+    assert.equal(errorOf(list.rename('Sweep', '  ')).code, 'invalid-input');
+    assert.equal(errorOf(list.rename('Sweep', 'd'.repeat(titleLimit + 1))).code, 'invalid-input');
+    const task = valueOf(list.find('Sweep'));
+    assert.deepEqual([task.title, task.updatedAt], ['Sweep', '2026-01-01T09:00:00.000Z']);
+  });
+
+  it('refuses a priority other than low, normal or high, and leaves the list unchanged', () => {
+    const list = createTodoList();
+    for (const priority of ['urgent', 'High', '']) {
+      const error = errorOf(list.add({ title: 'Ring back', priority: priority as 'low' }));
+      assert.equal(error.code, 'invalid-input');
+      assert.match(error.message, /priority.*low, normal or high/);
+    }
+    assert.equal(list.list().length, 0);
+  });
+
+  it('accepts each of the three priorities', () => {
+    const list = createTodoList();
+    for (const priority of ['low', 'normal', 'high'] as const) {
+      assert.equal(valueOf(list.add({ title: priority, priority })).priority, priority);
+    }
+  });
+
+  it('refuses an empty tag or a tag with a space when adding a task, and adds nothing', () => {
+    const list = createTodoList();
+    for (const tags of [[''], ['home', 'two words'], ['  ']]) {
+      const error = errorOf(list.add({ title: 'Tidy shelf', tags }));
+      assert.equal(error.code, 'invalid-input');
+      assert.match(error.message, /tag/);
+    }
+    assert.equal(list.list().length, 0);
+  });
+
+  it('refuses an empty tag or a tag with a space when tagging, and keeps the task as it was', () => {
+    const list = createTodoList({ now: clockAt('2026-01-01T09:00:00.000Z', '2026-01-02T09:00:00.000Z') });
+    list.add({ title: 'Fix the tap', tags: ['house'] });
+    for (const tag of ['', 'needs plumber']) {
+      assert.equal(errorOf(list.tag('Fix the tap', tag)).code, 'invalid-input');
+    }
+    const task = valueOf(list.find('Fix the tap'));
+    assert.deepEqual([task.tags, task.updatedAt], [['house'], '2026-01-01T09:00:00.000Z']);
+  });
+
+  it('applies the same checks when the task is referred to by its id', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'Mow' }));
+    assert.equal(errorOf(list.rename(task.id, '')).code, 'invalid-input');
+    assert.equal(errorOf(list.tag(task.id, 'lawn care')).code, 'invalid-input');
+    assert.equal(valueOf(list.get(task.id)).title, 'Mow');
+  });
+});
