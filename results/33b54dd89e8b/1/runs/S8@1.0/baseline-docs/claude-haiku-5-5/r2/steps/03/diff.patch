--- /dev/null
+++ b/src/domain/input.ts
@@ -0,0 +1,63 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** The longest title a task can have, in characters, not counting spaces at either end. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * The title as it will be stored, or why it cannot be: it must not be empty or only spaces, and must not
+ * be longer than `MAX_TITLE_LENGTH` characters.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'a task needs a title; the title is empty or only spaces');
+  const length = [...trimmed].length;
+  if (length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `a title can be at most ${MAX_TITLE_LENGTH} characters; this one has ${length}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority, if it is one of `low`, `normal` and `high`; otherwise why it is not.
+ *
+ * @param priority - the priority as typed
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  if ((PRIORITIES as readonly string[]).includes(priority)) return ok(priority as Priority);
+  return err('invalid-input', `priority "${priority}" is not one of ${PRIORITIES.join(', ')}`);
+}
+
+/**
+ * The tag, if it is not empty and has no spaces; otherwise why it is not. Tags are kept as typed.
+ *
+ * @param tag - the tag as typed
+ */
+export function validateTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'a tag cannot be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `tag "${tag}" cannot contain spaces`);
+  return ok(tag);
+}
+
+/**
+ * The new task, if its title, priority and every tag are valid; otherwise the first problem found.
+ *
+ * @param input - the task as typed: a title, and optionally a priority and tags
+ */
+export function validateNewTask(input: NewTask): Result<NewTask> {
+  const title = validateTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined) {
+    const priority = validatePriority(input.priority);
+    if (!priority.ok) return priority;
+  }
+  for (const tag of input.tags ?? []) {
+    const checked = validateTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok(input);
+}
