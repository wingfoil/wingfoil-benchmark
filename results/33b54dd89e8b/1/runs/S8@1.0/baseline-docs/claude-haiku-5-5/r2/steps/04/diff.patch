diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f0af090adaa5ab795bfb6c1b1fcb3f140d6014b6
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,113 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds each line as a task, with its priority and tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;low;\nCall mum;;family');
+    assert.deepEqual(result, { imported: 3, rejected: [] });
+    assert.deepEqual(
+      list.list().map(({ title, priority, tags }) => ({ title, priority, tags })),
+      [
+        { title: 'Renew the insurance', priority: 'high', tags: ['admin', 'money'] },
+        { title: 'Call mum', priority: 'normal', tags: ['family'] },
+        { title: 'Buy milk', priority: 'low', tags: [] },
+      ],
+    );
+  });
+
+  it('skips blank lines, and still counts them in the line numbers of rejected lines', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Bins;;\n\n   \nBins;high;\nPost;;');
+    assert.equal(result.imported, 2);
+    assert.deepEqual(result.rejected.map((rejection) => rejection.line), [4]);
+    assert.match(result.rejected[0]?.reason ?? '', /already/);
+    assert.equal(list.list().length, 2);
+  });
+
+  it('reads lines ending in Windows line breaks, as spreadsheets export them', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Bins;;\r\nPost;low;\r\n');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+  });
+
+  it('rejects a line with an unknown priority, and keeps the other lines', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Bins;urgent;\nPost;;');
+    assert.equal(result.imported, 1);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0]?.line, 1);
+    assert.match(result.rejected[0]?.reason ?? '', /priority/);
+    assert.deepEqual(
+      list.list().map((task) => task.title),
+      ['Post'],
+    );
+  });
+
+  it('rejects a line with an empty title or a title longer than 120 characters', () => {
+    const list = createTodoList();
+    const result = importTasks(list, `;high;\n${'a'.repeat(121)};;\n${'a'.repeat(120)};;`);
+    assert.equal(result.imported, 1);
+    assert.deepEqual(
+      result.rejected.map((rejection) => rejection.line),
+      [1, 2],
+    );
+    assert.match(result.rejected[0]?.reason ?? '', /title/);
+    assert.match(result.rejected[1]?.reason ?? '', /120/);
+  });
+
+  it('splits the tags on any run of spaces, and ignores spaces around them', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Paint;;garden  shed\nFix;;  house  ');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+    assert.deepEqual(
+      list.list().map((task) => [task.title, task.tags]),
+      [
+        ['Fix', ['house']],
+        ['Paint', ['garden', 'shed']],
+      ],
+    );
+  });
+
+  it('rejects a line that does not have exactly three fields, and says what it should look like', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high\nBuy;low;a;b\nFine;;');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(
+      result.rejected.map((rejection) => rejection.line),
+      [1, 2],
+    );
+    assert.match(result.rejected[0]?.reason ?? '', /title;priority;tags/);
+  });
+
+  it('rejects a line whose title is already a task of the list, and keeps the existing task', () => {
+    const list = createTodoList();
+    list.add({ title: 'Bins', priority: 'low' });
+    const result = importTasks(list, 'Bins;high;\nPost;;');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(result.rejected.map((rejection) => rejection.line), [1]);
+    assert.match(result.rejected[0]?.reason ?? '', /already/);
+    assert.equal(list.find('Bins').ok && list.find('Bins').value.priority, 'low');
+  });
+
+  it('rejects a title repeated within the text, the second time', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Bins;;\nBins;high;');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(result.rejected.map((rejection) => rejection.line), [2]);
+  });
+
+  it('imports nothing from empty text', () => {
+    const list = createTodoList();
+    assert.deepEqual(importTasks(list, ''), { imported: 0, rejected: [] });
+    assert.deepEqual(list.list(), []);
+  });
+
+  it('keeps the times of the list on the imported tasks', () => {
+    const list = createTodoList(() => '2026-04-01T08:00:00.000Z');
+    importTasks(list, 'Bins;;');
+    assert.equal(list.list()[0]?.createdAt, '2026-04-01T08:00:00.000Z');
+  });
+});
