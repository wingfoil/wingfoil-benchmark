index 0000000000000000000000000000000000000000..534d73d7a747cde36652361c713484e5130680ed
--- /dev/null
+++ b/src/domain/import.ts
@@ -0,0 +1,70 @@
+import { validatePriority } from './input.ts';
+import { err } from './result.ts';
+import type { Result } from './result.ts';
+import type { TaskList } from './list.ts';
+import type { NewTask, Task } from './task.ts';
+
+/** A line of imported text that did not become a task: its line number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks it added, and every line it could not add. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * The task a line of `title;priority;tags` describes, or why the line is not one. An empty priority means
+ * `normal`; the tags are separated by spaces. The title and the tags are checked when the task is added.
+ *
+ * @param line - one line of the text, without its line break
+ */
+function parseTaskLine(line: string): Result<NewTask> {
+  const fields = line.split(';');
+  if (fields.length !== 3) return err('invalid-input', 'a line must read title;priority;tags');
+  const [title, priorityField, tagsField] = fields as [string, string, string];
+  const priority = priorityField.trim();
+  if (priority === '') return { ok: true, value: { title, tags: splitTags(tagsField) } };
+  const checked = validatePriority(priority);
+  if (!checked.ok) return checked;
+  return { ok: true, value: { title, priority: checked.value, tags: splitTags(tagsField) } };
+}
+
+function splitTags(field: string): string[] {
+  return field.split(/\s+/).filter((tag) => tag !== '');
+}
+
+/**
+ * Adds the task a line describes to `list`; the outcome is the task added, or why it was not.
+ *
+ * @param list - the list to add to
+ * @param line - one line of the text, without its line break
+ */
+function addLine(list: TaskList, line: string): Result<Task> {
+  const parsed = parseTaskLine(line);
+  return parsed.ok ? list.add(parsed.value) : parsed;
+}
+
+/**
+ * Adds every task of `text` to `list`, one task per line as `title;priority;tags`. Blank lines are skipped;
+ * a line that cannot be added is reported with its line number, counting from 1, and the lines around it
+ * are still added. Lines may end in `\n` or `\r\n`.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the tasks, one per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  const lines = text.split(/\r?\n/);
+  lines.forEach((line, index) => {
+    if (line.trim() === '') return;
+    const added = addLine(list, line);
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
