--- /dev/null
+++ b/src/domain/input.ts
@@ -0,0 +1,55 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { NewTask, Priority } from './task.ts';
+
+const MAX_TITLE_LENGTH = 120;
+
+/**
+ * The title without its surrounding spaces, if it is neither empty nor longer than 120 characters.
+ *
+ * @param title - the title as the person typed it
+ */
+export function checkTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'a task needs a title, but the title is empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `a title can be at most ${MAX_TITLE_LENGTH} characters, this one has ${trimmed.length}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The tag, if it is not empty and has no space in it.
+ *
+ * @param tag - the tag as the person typed it
+ */
+export function checkTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'a tag cannot be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `a tag cannot contain a space, but "${tag}" does`);
+  return ok(tag);
+}
+
+/**
+ * Everything a new task needs, checked: its title, its priority (`normal` when none is given) and each of its tags.
+ *
+ * @param input - the title, priority and tags as the person gave them
+ */
+export function checkNewTask(input: NewTask): Result<NewTask> {
+  const title = checkTitle(input.title);
+  if (!title.ok) return title;
+  const priority = checkPriority(input.priority ?? 'normal');
+  if (!priority.ok) return priority;
+  for (const tag of input.tags ?? []) {
+    const checked = checkTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok({ title: title.value, priority: priority.value, tags: input.tags });
+}
+
+function checkPriority(priority: string): Result<Priority> {
+  const known = PRIORITIES.find((candidate) => candidate === priority);
+  return known === undefined
+    ? err('invalid-input', `the priority must be low, normal or high, not "${priority}"`)
+    : ok(known);
+}
