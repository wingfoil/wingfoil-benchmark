@@ -0,0 +1,50 @@
+import { checkPriority } from './input.ts';
+import type { TaskList } from './list.ts';
+import { err } from './result.ts';
+import type { Result } from './result.ts';
+import type { Task } from './task.ts';
+
+/** A line of the import text that could not be added, and why. */
+export interface RejectedLine {
+  /** The line's number in the text, counting from 1 and including blank lines. */
+  readonly line: number;
+  /** What was wrong with the line, for the person importing it. */
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks it added, and each line it refused. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds one task to `list` for each line of `text`. A line reads `title;priority;tags`: the priority may be left empty
+ * for `normal`, and the tags are separated by spaces. Blank lines are skipped. A line that cannot be added is reported
+ * with its number and reason, and the other lines are still added.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import, one task per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  for (const [index, raw] of text.split(/\r?\n/).entries()) {
+    if (raw.trim() === '') continue;
+    const added = addLine(list, raw);
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  }
+  return { imported, rejected };
+}
+
+function addLine(list: TaskList, raw: string): Result<Task> {
+  const fields = raw.split(';');
+  if (fields.length !== 3) {
+    return err('invalid-input', 'a line needs three fields separated by semicolons, as title;priority;tags');
+  }
+  const [title, priority, tags] = fields.map((field) => field.trim());
+  const checked = checkPriority(priority === '' ? 'normal' : priority);
+  if (!checked.ok) return checked;
+  return list.add({ title, priority: checked.value, tags: tags === '' ? [] : tags.split(/\s+/) });
+}
