diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a7b59ee08d43742e9a909fb204c7abf3638eb3f7
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,104 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+const START = '2026-03-01T09:00:00.000Z';
+
+/** A clock that always reads the start time, so imported tasks are stamped the same way every run. */
+const fixedClock = () => START;
+
+describe('bulk import', () => {
+  it('adds each valid line as a task, with its priority and tags', () => {
+    const list = createTodoList(fixedClock);
+    const result = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;low;\nFix the tap;;house');
+    assert.deepEqual(result.rejected, []);
+    assert.equal(result.imported, 3);
+    assert.deepEqual(
+      list.list().map(({ title, priority, tags }) => ({ title, priority, tags })),
+      [
+        { title: 'Renew the insurance', priority: 'high', tags: ['admin', 'money'] },
+        { title: 'Fix the tap', priority: 'normal', tags: ['house'] },
+        { title: 'Buy milk', priority: 'low', tags: [] },
+      ],
+    );
+  });
+
+  it('makes a task normal when its priority is left empty', () => {
+    const list = createTodoList(fixedClock);
+    importTasks(list, 'Walk the dog;;');
+    assert.equal(list.list()[0].priority, 'normal');
+  });
+
+  it('splits tags on any run of spaces and ignores spaces around them', () => {
+    const list = createTodoList(fixedClock);
+    importTasks(list, 'Paint the fence;normal;  garden   outdoors ');
+    assert.deepEqual(list.list()[0].tags, ['garden', 'outdoors']);
+  });
+
+  it('skips blank lines, and still counts them when numbering a rejected line', () => {
+    const list = createTodoList(fixedClock);
+    const result = importTasks(list, 'Sweep;;\n\n   \nMop;;\n;;;\n');
+    assert.equal(result.imported, 2);
+    assert.deepEqual(
+      result.rejected.map(({ line }) => line),
+      [5],
+    );
+  });
+
+  it('reads lines that end in carriage returns, as spreadsheets export them', () => {
+    const list = createTodoList(fixedClock);
+    const result = importTasks(list, 'Sweep;high;home\r\nMop;;home\r\n');
+    assert.equal(result.imported, 2);
+    assert.deepEqual(result.rejected, []);
+  });
+
+  it('rejects a line without three fields, says why, and still adds the valid lines', () => {
+    const list = createTodoList(fixedClock);
+    const result = importTasks(list, 'Buy milk\nWalk the dog;;\nWash;high;a;b');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(
+      result.rejected.map(({ line }) => line),
+      [1, 3],
+    );
+    assert.match(result.rejected[0].reason, /title;priority;tags/);
+    assert.equal(list.list().length, 1);
+  });
+
+  it('rejects a line with an unknown priority, using the list\'s own message', () => {
+    const list = createTodoList(fixedClock);
+    const result = importTasks(list, 'Pay the bill;urgent;money');
+    assert.equal(result.imported, 0);
+    assert.deepEqual(result.rejected, [
+      { line: 1, reason: 'the priority must be low, normal or high, not "urgent"' },
+    ]);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a line with an empty title', () => {
+    const list = createTodoList(fixedClock);
+    const result = importTasks(list, ' ;high;money');
+    assert.equal(result.imported, 0);
+    assert.equal(result.rejected.length, 1);
+    assert.match(result.rejected[0].reason, /title.*empty/);
+  });
+
+  it('rejects a title already in the list, and a title repeated within the text', () => {
+    const list = createTodoList(fixedClock);
+    list.add({ title: 'Call the plumber' });
+    const result = importTasks(list, 'Call the plumber;;\nBuy milk;;\nBuy milk;high;');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(
+      result.rejected.map(({ line }) => line),
+      [1, 3],
+    );
+    assert.match(result.rejected[0].reason, /already a task "Call the plumber"/);
+    assert.equal(list.list().length, 2);
+  });
+
+  it('imports nothing from empty text', () => {
+    const list = createTodoList(fixedClock);
+    assert.deepEqual(importTasks(list, ''), { imported: 0, rejected: [] });
+    assert.equal(list.list().length, 0);
+  });
+});
