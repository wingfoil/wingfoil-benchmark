+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of an import that could not be added, and why. */
+export interface RejectedLine {
+  /** The line's number in the text, counting from 1. */
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks it added, and every line it could not add. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds one task per line of `text`, each line as `title;priority;tags`. The priority may be left empty for a
+ * normal one, and the tags are separated by spaces. Blank lines are skipped. A line that cannot be added is
+ * reported, and the other lines are still added.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+
+  text.split(/\r?\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+
+    const fields = raw.split(';');
+    if (fields.length !== 3) {
+      const reason = `a line needs 3 parts separated by ";" (title;priority;tags), but this one has ${fields.length}`;
+      rejected.push({ line, reason });
+      return;
+    }
+
+    const [title, priority, tags] = fields.map((field) => field.trim());
+    // The list checks the priority, so an unknown one is rejected with its own message.
+    const result = list.add({
+      title,
+      priority: priority === '' ? undefined : (priority as Priority),
+      tags: tags === '' ? [] : tags.split(/\s+/),
+    });
+    if (result.ok) imported++;
+    else rejected.push({ line, reason: result.error.message });
+  });
+
+  return { imported, rejected };
+}
