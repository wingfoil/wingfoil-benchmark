new file mode 100644
index 0000000000000000000000000000000000000000..26d80fc64264c026c4681099e81ba36b1630f8fe
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,56 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds each line as a task, with the given priority and tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;;');
+    assert.equal(result.imported, 2);
+    assert.deepEqual(result.rejected, []);
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok);
+    assert.equal(milk.value.priority, 'normal');
+    assert.deepEqual(milk.value.tags, []);
+  });
+
+  it('skips blank lines but still counts them in line numbers', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'First;low;\n\n   \nThird;;\n');
+    assert.equal(result.imported, 2);
+    assert.deepEqual(result.rejected, []);
+  });
+
+  it('accepts Windows line endings', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'First;low;\r\nSecond;high;x\r\n');
+    assert.equal(result.imported, 2);
+    assert.deepEqual(result.rejected, []);
+  });
+
+  it('reports rejected lines with their numbers and reasons, and adds the rest', () => {
+    const list = createTodoList();
+    const text = ['Good;low;', '', ';high;', 'Urgent;urgent;', 'Too;many;tags;here', 'Good;normal;', 'Fine;;a  b'].join('\n');
+    const result = importTasks(list, text);
+    assert.equal(result.imported, 2);
+    assert.deepEqual(
+      result.rejected.map((entry) => entry.line),
+      [3, 4, 5, 6],
+    );
+    assert.match(result.rejected[0].reason, /empty or only spaces/);
+    assert.match(result.rejected[1].reason, /priority must be low, normal, high/);
+    assert.match(result.rejected[2].reason, /3 parts/);
+    assert.match(result.rejected[3].reason, /already a task "Good"/);
+    assert.equal(list.list().length, 2);
+  });
+
+  it('returns zero for empty text', () => {
+    const list = createTodoList();
+    assert.deepEqual(importTasks(list, ''), { imported: 0, rejected: [] });
+  });
+});
