diff --git a/src/domain/task.ts b/src/domain/task.ts
index 2175c2934ab52377c7665fa82f613235a9bf20bf..ea5482f88c528d2d31d0b842251916b164f5fdb5 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -30,6 +30,64 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/** The longest a task title may be, in characters, once its spaces at the ends are trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * A title, trimmed, if it can be a task's title: not empty, and at most `MAX_TITLE_LENGTH` characters.
+ *
+ * @param title - the title as it was typed
+ */
+export function checkTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'a task needs a title, but it is empty or only spaces');
+  const length = [...trimmed].length;
+  if (length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `a title can be at most ${MAX_TITLE_LENGTH} characters, but this one has ${length}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * A priority, if it is one of `PRIORITIES`.
+ *
+ * @param priority - the priority as it was given, which may not be a valid one
+ */
+export function checkPriority(priority: string): Result<Priority> {
+  const found = PRIORITIES.find((known) => known === priority);
+  return found === undefined
+    ? err('invalid-input', `priority must be ${PRIORITIES.join(', ')}, not "${priority}"`)
+    : ok(found);
+}
+
+/**
+ * A tag, if it can be one: not empty, and without a space.
+ *
+ * @param tag - the tag as it was typed
+ */
+export function checkTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'a tag cannot be empty');
+  if (tag.includes(' ')) return err('invalid-input', `a tag cannot contain a space, so "${tag}" is not allowed`);
+  return ok(tag);
+}
+
+/**
+ * A new task's input, if all of it is valid: a title, a priority if given, and tags.
+ *
+ * @param input - the title, priority and tags to check
+ */
+export function checkNewTask(input: NewTask): Result<NewTask> {
+  const title = checkTitle(input.title);
+  if (!title.ok) return title;
+  const priority = checkPriority(input.priority ?? 'normal');
+  if (!priority.ok) return priority;
+  for (const tag of input.tags ?? []) {
+    const checked = checkTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok({ title: title.value, priority: priority.value, tags: input.tags });
+}
+
