+
+describe('input checks', () => {
+  function rejected<T>(result: { ok: true; value: T } | { ok: false; error: { code: string; message: string } }) {
+    assert.equal(result.ok, false, 'expected the input to be rejected');
+    if (result.ok) assert.fail('expected the input to be rejected');
+    assert.equal(result.error.code, 'invalid-input');
+    return result.error.message;
+  }
+
+  it('rejects an empty or all-space title when adding, and adds nothing', () => {
+    const list = createTodoList();
+    assert.match(rejected(list.add({ title: '' })), /title.*empty/);
+    assert.match(rejected(list.add({ title: '   ' })), /title.*empty/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a title longer than 120 characters, and accepts exactly 120', () => {
+    const list = createTodoList();
+    assert.match(rejected(list.add({ title: 'a'.repeat(121) })), /at most 120 characters, but this one has 121/);
+    assert.equal(list.list().length, 0);
+    assert.equal(valueOf(list.add({ title: 'a'.repeat(120) })).title.length, 120);
+  });
+
+  it('counts the title without its surrounding spaces', () => {
+    const list = createTodoList();
+    assert.equal(valueOf(list.add({ title: `  ${'a'.repeat(120)}  ` })).title.length, 120);
+  });
+
+  it('rejects a priority other than low, normal and high, and adds nothing', () => {
+    const list = createTodoList();
+    const message = rejected(list.add({ title: 'Mow the lawn', priority: 'urgent' as never }));
+    assert.match(message, /priority must be low, normal, high, not "urgent"/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects an empty tag or a tag with a space, and adds nothing', () => {
+    const list = createTodoList();
+    assert.match(rejected(list.add({ title: 'Sweep', tags: ['home', ''] })), /tag cannot be empty/);
+    assert.match(rejected(list.add({ title: 'Sweep', tags: ['big room'] })), /cannot contain a space, so "big room"/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a bad rename and leaves the task as it was', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'Fix the gate' }));
+    assert.match(rejected(list.rename(id, '   ')), /title/);
+    assert.match(rejected(list.rename(id, 'b'.repeat(121))), /at most 120/);
+    assert.equal(valueOf(list.get(id)).title, 'Fix the gate');
+    assert.equal(valueOf(list.get(id)).updatedAt, valueOf(list.get(id)).createdAt);
+  });
+
+  it('rejects a bad tag and leaves the task as it was', () => {
+    const list = createTodoList();
+    list.add({ title: 'Fix the gate' });
+    const before = valueOf(list.find('Fix the gate'));
+    assert.match(rejected(list.tag('Fix the gate', '')), /tag cannot be empty/);
+    assert.match(rejected(list.tag('Fix the gate', 'back yard')), /cannot contain a space/);
+    assert.deepEqual(valueOf(list.find('Fix the gate')), before);
+  });
+
+  it('accepts a title, priority and tags that are within the rules', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'Fix the gate', priority: 'high', tags: ['garden'] }));
+    assert.deepEqual([task.title, task.priority, task.tags], ['Fix the gate', 'high', ['garden']]);
+    assert.deepEqual(valueOf(list.tag('Fix the gate', 'back-yard')).tags, ['garden', 'back-yard']);
+  });
+});
