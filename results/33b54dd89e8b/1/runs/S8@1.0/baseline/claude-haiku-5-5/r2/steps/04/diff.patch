+++ b/test/import.test.ts
@@ -0,0 +1,92 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds one task per line, with its priority and tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;low;');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+    const tasks = list.list();
+    assert.deepEqual(
+      tasks.map(({ title, priority, tags }) => ({ title, priority, tags })),
+      [
+        { title: 'Renew the insurance', priority: 'high', tags: ['admin', 'money'] },
+        { title: 'Buy milk', priority: 'low', tags: [] },
+      ],
+    );
+  });
+
+  it('uses a normal priority when the priority is empty', () => {
+    const list = createTodoList();
+    assert.deepEqual(importTasks(list, 'Fix the tap;  ;house'), { imported: 1, rejected: [] });
+    assert.equal(list.list()[0].priority, 'normal');
+  });
+
+  it('skips blank lines, and still counts them in line numbers', () => {
+    const list = createTodoList();
+    const result = importTasks(list, '\nBuy milk;;\n   \nBuy bread;;\n\n');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+  });
+
+  it('reads Windows line endings, as spreadsheets export them', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;\r\nBuy bread;;home\r\n');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+    assert.deepEqual(
+      list.list().map((task) => task.tags),
+      [['home'], []],
+    );
+  });
+
+  it('adds the valid lines and rejects the others with a line number and reason', () => {
+    const list = createTodoList();
+    const text = [
+      'Buy milk;;',
+      'Walk the dog;urgent;',
+      '',
+      ';;home',
+      'Buy bread;;two words',
+      'Buy milk;high;',
+      'Call the plumber;low;',
+    ].join('\n');
+    const result = importTasks(list, text);
+    assert.equal(result.imported, 3);
+    assert.deepEqual(
+      result.rejected.map(({ line }) => line),
+      [2, 4, 6],
+    );
+    assert.match(result.rejected[0].reason, /low, normal or high/);
+    assert.match(result.rejected[1].reason, /needs a title/);
+    assert.match(result.rejected[2].reason, /already a task "Buy milk"/);
+    assert.deepEqual(
+      list.list().map((task) => task.title),
+      ['Buy bread', 'Buy milk', 'Call the plumber'],
+    );
+  });
+
+  it('rejects a line without exactly three fields, and says how many it has', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk\nBuy bread;high\nA;b;c;d');
+    assert.deepEqual(
+      result.rejected.map(({ line }) => line),
+      [1, 2, 3],
+    );
+    assert.match(result.rejected[0].reason, /has 1$/);
+    assert.match(result.rejected[1].reason, /has 2$/);
+    assert.match(result.rejected[2].reason, /has 4$/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('treats a tags field of only spaces as no tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Fix the tap;;  ');
+    assert.deepEqual(result, { imported: 1, rejected: [] });
+    assert.deepEqual(list.list()[0].tags, []);
+  });
+
+  it('reports nothing for empty text', () => {
+    assert.deepEqual(importTasks(createTodoList(), ''), { imported: 0, rejected: [] });
+  });
+});
