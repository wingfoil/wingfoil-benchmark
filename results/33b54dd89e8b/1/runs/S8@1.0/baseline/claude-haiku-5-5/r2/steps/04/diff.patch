+import type { TaskList } from './list.ts';
+
+/** A line that could not be added, and why. `line` counts from 1, blank lines included. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks were added, and every line that was not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds one task per line of `text` to `list`, each line as `title;priority;tags`. The priority may be
+ * left empty for a normal one, and the tags are separated by spaces. Blank lines are skipped. A line
+ * that cannot be added is reported with the reason, and the others are still added.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import, one task per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  const lines = text.split(/\r?\n/);
+
+  lines.forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length !== 3) {
+      rejected.push({
+        line,
+        reason: `a line needs three fields, title;priority;tags, but this one has ${fields.length}`,
+      });
+      return;
+    }
+    const [title, priority, tags] = fields.map((field) => field.trim());
+    const result = list.add({
+      title,
+      priority: priority === '' ? undefined : (priority as 'low' | 'normal' | 'high'),
+      tags: tags === '' ? [] : tags.split(/\s+/),
+    });
+    if (result.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line, reason: result.error.message });
+    }
+  });
+
+  return { imported, rejected };
+}
