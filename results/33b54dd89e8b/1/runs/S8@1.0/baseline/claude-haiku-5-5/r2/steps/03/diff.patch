diff --git a/src/domain/task.ts b/src/domain/task.ts
index deeb1c4608e687fb4c62392cc9b5c64ffa6aa9d1..284f92ff868fcaeaa991379fdbea9e8fbbdf85e2 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -7,6 +7,49 @@ export type Priority = 'low' | 'normal' | 'high';
 /** Every priority, from the least urgent to the most. */
 export const PRIORITIES: readonly Priority[] = ['low', 'normal', 'high'];
 
+/** The longest title a task can have, in characters, once surrounding spaces are removed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * The title as a task will keep it: surrounding spaces removed, and not empty or too long.
+ *
+ * @param title - the title as typed
+ */
+export function checkTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'a task needs a title, but it is empty or only spaces');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err(
+      'invalid-input',
+      `a title can be at most ${MAX_TITLE_LENGTH} characters, but this one has ${trimmed.length}`,
+    );
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority, if it is one of `low`, `normal` or `high`.
+ *
+ * @param priority - the priority as typed
+ */
+export function checkPriority(priority: string): Result<Priority> {
+  if (!(PRIORITIES as readonly string[]).includes(priority)) {
+    return err('invalid-input', `priority must be low, normal or high, not "${priority}"`);
+  }
+  return ok(priority as Priority);
+}
+
+/**
+ * The tag, if it is not empty and has no spaces in it.
+ *
+ * @param tag - the tag as typed
+ */
+export function checkTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'a tag cannot be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `a tag cannot contain a space, but "${tag}" does`);
+  return ok(tag);
+}
+
 /** Whether a task still has to be done. */
 export type Status = 'open' | 'done';
 
