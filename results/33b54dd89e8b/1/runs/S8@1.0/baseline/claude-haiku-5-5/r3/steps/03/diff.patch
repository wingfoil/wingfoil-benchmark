@@ -0,0 +1,41 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+
+/** The longest title a task may have, in characters, once surrounding spaces are removed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Whether `title` can name a task: not empty, not only spaces, and at most 120 characters long.
+ *
+ * @param title - the title as the person typed it
+ */
+export function checkTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'a task needs a title, but the title is empty or only spaces');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `a title can be at most ${MAX_TITLE_LENGTH} characters, but this one is ${trimmed.length}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Whether `priority` is one the list knows: `low`, `normal` or `high`.
+ *
+ * @param priority - the priority as the person typed it
+ */
+export function checkPriority(priority: string): Result<string> {
+  if ((PRIORITIES as readonly string[]).includes(priority)) return ok(priority);
+  return err('invalid-input', `the priority must be ${PRIORITIES.join(', ')}, not "${priority}"`);
+}
+
+/**
+ * Whether `tag` can label a task: not empty, and without spaces.
+ *
+ * @param tag - the tag as the person typed it
+ */
+export function checkTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'a tag cannot be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `a tag cannot contain spaces, but "${tag}" does`);
+  return ok(tag);
+}
