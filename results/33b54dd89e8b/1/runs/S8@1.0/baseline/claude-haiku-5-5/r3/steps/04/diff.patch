+import type { TaskList } from './list.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** A line of the import that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks it added, and every line it could not add. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds one task per line of `text` to `list`, each line written as `title;priority;tags`. The priority may be
+ * empty for a normal one, and the tags are separated by spaces. Blank lines are skipped; every other line the
+ * list refuses is reported, and the rest are still added.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import, one task per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+
+  text.split('\n').forEach((raw, index) => {
+    const line = index + 1;
+    const content = raw.replace(/\r$/, '');
+    if (content.trim() === '') return;
+
+    const fields = content.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line, reason: `a line needs three fields separated by ";", but this one has ${fields.length}` });
+      return;
+    }
+    const [title, priority, tags] = fields;
+    const task: NewTask = {
+      title,
+      ...(priority.trim() === '' ? {} : { priority: priority.trim() as Priority }),
+      tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+    };
+
+    const result = list.add(task);
+    if (result.ok) imported += 1;
+    else rejected.push({ line, reason: result.error.message });
+  });
+
+  return { imported, rejected };
+}
