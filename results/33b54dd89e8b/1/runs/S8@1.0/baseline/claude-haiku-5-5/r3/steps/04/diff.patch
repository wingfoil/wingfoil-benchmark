index 0000000000000000000000000000000000000000..a73c11d012b44e393c00f6a93bc5b09d7988d838
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds each line as a task, with its priority and tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;;\nWater plants;low;');
+    assert.deepEqual(result, { imported: 3, rejected: [] });
+    const byTitle = Object.fromEntries(list.list().map((task) => [task.title, task]));
+    assert.equal(byTitle['Renew the insurance'].priority, 'high');
+    assert.deepEqual(byTitle['Renew the insurance'].tags, ['admin', 'money']);
+    assert.equal(byTitle['Buy milk'].priority, 'normal');
+    assert.deepEqual(byTitle['Buy milk'].tags, []);
+    assert.equal(byTitle['Water plants'].priority, 'low');
+  });
+
+  it('skips blank lines, and handles CRLF line endings', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;\r\n\r\n   \r\nBuy bread;;\r\n');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+    assert.equal(list.list().length, 2);
+  });
+
+  it('reports rejected lines by their number, counting blank lines, and still adds the rest', () => {
+    const list = createTodoList();
+    const text = [
+      'Buy milk;;',
+      '',
+      'Fix the tap;urgent;house',
+      'Call the plumber;high;a;b;c',
+      ';high;house',
+      'Buy milk;low;',
+      'Pay rent;high;money',
+    ].join('\n');
+    const result = importTasks(list, text);
+    assert.equal(result.imported, 2);
+    assert.deepEqual(
+      result.rejected.map((entry) => entry.line),
+      [3, 4, 5, 6],
+    );
+    assert.match(result.rejected[0].reason, /must be low, normal, high/);
+    assert.match(result.rejected[1].reason, /three fields/);
+    assert.match(result.rejected[2].reason, /empty/);
+    assert.match(result.rejected[3].reason, /already a task/);
+    assert.deepEqual(list.list().map((task) => task.title).sort(), ['Buy milk', 'Pay rent']);
+  });
+
+  it('adds nothing for empty text', () => {
+    const list = createTodoList();
+    assert.deepEqual(importTasks(list, ''), { imported: 0, rejected: [] });
+    assert.equal(list.list().length, 0);
+  });
+});
