+describe('input validation', () => {
+  it('rejects invalid input and changes nothing', () => {
+    const list = createTodoList();
+    list.add({ title: 'a' });
+    const bad = [
+      list.add({ title: '   ' }),
+      list.add({ title: 'x'.repeat(121) }),
+      list.add({ title: 'b', priority: 'urgent' as never }),
+      list.add({ title: 'b', tags: ['ok', ''] }),
+      list.add({ title: 'b', tags: ['a b'] }),
+      list.rename('a', ' '),
+      list.rename('a', 'x'.repeat(121)),
+      list.tag('a', ''),
+      list.tag('a', 'a b'),
+    ];
+    for (const r of bad) assert.ok(!r.ok && r.error.code === 'invalid-input' && r.error.message.length > 0);
+    assert.equal(list.list().length, 1);
+    assert.equal(valueOf(list.find('a')).title, 'a');
+    assert.deepEqual(valueOf(list.find('a')).tags, []);
+    assert.equal(valueOf(list.add({ title: 'x'.repeat(120) })).title.length, 120);
+  });
+});
