index 3d6da5e82995fe7bb72dd849ca0f6a136c46a395..53ee34a9ba57f4903dde68d321d1431fb242fb2f 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -33,6 +33,44 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/** The longest title a task can have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Why a title cannot be used, or nothing when it can.
+ *
+ * @param title - the title as typed
+ */
+export function checkTitle(title: unknown): Result<string> {
+  if (typeof title !== 'string' || title.trim() === '') return err('invalid-input', 'the title must not be empty');
+  const trimmed = title.trim();
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; the limit is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Whether a priority is one of `low`, `normal` and `high`.
+ *
+ * @param priority - the priority as given
+ */
+export function checkPriority(priority: unknown): Result<Priority> {
+  if (PRIORITIES.includes(priority as Priority)) return ok(priority as Priority);
+  return err('invalid-input', `the priority "${String(priority)}" is not one of ${PRIORITIES.join(', ')}`);
+}
+
+/**
+ * Whether a tag is usable: not empty and without spaces.
+ *
+ * @param tag - the tag as given
+ */
+export function checkTag(tag: unknown): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'a tag must not be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" must not contain a space`);
+  return ok(tag);
+}
+
