+describe('task ids', () => {
+  it('gives each task its own id, found with get and accepted instead of a title', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    const b = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(a.id, b.id);
+    assert.deepEqual(valueOf(list.get(a.id)), a);
+    assert.equal(list.get('nope').ok, false);
+    const renamed = valueOf(list.rename(a.id, 'c'));
+    assert.equal(renamed.id, a.id);
+    assert.equal(valueOf(list.get(a.id)).title, 'c');
+    assert.equal(list.find('a').ok, false);
+    assert.equal(valueOf(list.complete(a.id)).status, 'done');
+    assert.deepEqual(valueOf(list.tag(b.id, 'x')).tags, ['x']);
+    assert.deepEqual(valueOf(list.untag(b.id, 'x')).tags, []);
+    assert.equal(valueOf(list.remove(b.id)).title, 'b');
+    assert.equal(list.get(b.id).ok, false);
+  });
+
+  it('does not reuse the id of a removed task', () => {
+    const list = createTodoList();
+    const first = valueOf(list.add({ title: 'a' }));
+    list.remove('a');
+    assert.notEqual(valueOf(list.add({ title: 'a' })).id, first.id);
+  });
+
