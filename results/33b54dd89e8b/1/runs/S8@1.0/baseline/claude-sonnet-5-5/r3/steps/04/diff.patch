+++ b/src/domain/import.ts
@@ -0,0 +1,53 @@
+import { validatePriority } from './task.ts';
+import type { TaskList } from './list.ts';
+
+/** A line of an import that could not be added, with its number (from 1) and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks it added, and the lines it could not add. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds to `list` a task for every valid line of `text`, written `title;priority;tags`. The priority may be
+ * empty for a normal one, the tags are separated by spaces, and blank lines are skipped.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - one task per line
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+
+  text.split(/\r\n|\n|\r/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const reject = (reason: string): void => {
+      rejected.push({ line, reason });
+    };
+
+    const fields = raw.split(';');
+    if (fields.length > 3) return reject(`expected "title;priority;tags" but found ${fields.length} fields`);
+    const [title = '', priorityText = '', tagsText = ''] = fields;
+
+    const priorityName = priorityText.trim().toLowerCase();
+    let priority;
+    if (priorityName !== '') {
+      const checked = validatePriority(priorityName);
+      if (!checked.ok) return reject(checked.error.message);
+      priority = checked.value;
+    }
+
+    const tags = tagsText.split(/\s+/).filter((tag) => tag !== '');
+    const added = list.add({ title, ...(priority === undefined ? {} : { priority }), tags });
+    if (!added.ok) return reject(added.error.message);
+    imported += 1;
+  });
+
+  return { imported, rejected };
+}
