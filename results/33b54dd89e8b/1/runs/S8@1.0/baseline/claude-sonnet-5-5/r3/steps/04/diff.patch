+
+describe('importTasks', () => {
+  it('adds valid lines and reports the others by line number', () => {
+    const list = createTodoList();
+    const report = importTasks(
+      list,
+      'Renew the insurance;high;admin money\n\nBuy milk\nWalk;urgent;\nBuy milk;low;\r\nA;b;c;d\n;;',
+    );
+    assert.equal(report.imported, 2);
+    assert.deepEqual(
+      report.rejected.map((r) => r.line),
+      [4, 5, 6, 7],
+    );
+    const insurance = valueOf(list.find('Renew the insurance'));
+    assert.equal(insurance.priority, 'high');
+    assert.deepEqual(insurance.tags, ['admin', 'money']);
+    assert.equal(valueOf(list.find('Buy milk')).priority, 'normal');
+  });
+});
