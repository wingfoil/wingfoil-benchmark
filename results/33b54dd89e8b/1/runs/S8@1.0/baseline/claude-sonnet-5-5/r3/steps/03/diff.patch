+describe('input validation', () => {
+  const code = (r: { ok: boolean; error?: { code: string } }) => (r.ok ? 'ok' : r.error?.code);
+
+  it('rejects invalid input and leaves the list unchanged', () => {
+    const list = createTodoList();
+    list.add({ title: 'keep' });
+    assert.equal(code(list.add({ title: '   ' })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'x'.repeat(121) })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'x'.repeat(120) })), 'ok');
+    assert.equal(code(list.add({ title: 'p', priority: 'urgent' as never })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'q', tags: ['ok', 'a b'] })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'r', tags: [''] })), 'invalid-input');
+    assert.equal(code(list.rename('keep', ' ')), 'invalid-input');
+    assert.equal(code(list.rename('keep', 'y'.repeat(121))), 'invalid-input');
+    assert.equal(code(list.tag('keep', '')), 'invalid-input');
+    assert.equal(code(list.tag('keep', 'a b')), 'invalid-input');
+    assert.equal(list.list().length, 2);
+    assert.deepEqual(valueOf(list.find('keep')).tags, []);
+  });
+});
