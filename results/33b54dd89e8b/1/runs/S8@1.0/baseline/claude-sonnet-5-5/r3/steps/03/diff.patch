index e9a9e91e6b12ddc70c447334b96885b1341b714f..0e5af2cde9ba3eeeb41a25f93b0a9fdd1a241821 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -31,6 +31,47 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/** The longest title a task can have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a title as typed by the user: not blank, and at most `MAX_TITLE_LENGTH` characters once trimmed.
+ *
+ * @param title - the title to check
+ */
+export function validateTitle(title: unknown): Result<string> {
+  if (typeof title !== 'string' || title.trim() === '') return err('invalid-input', 'the title is empty');
+  const trimmed = title.trim();
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; the limit is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be one of `PRIORITIES`.
+ *
+ * @param priority - the priority to check
+ */
+export function validatePriority(priority: unknown): Result<Priority> {
+  const known = PRIORITIES.find((candidate) => candidate === priority);
+  if (known === undefined) {
+    return err('invalid-input', `the priority ${JSON.stringify(priority)} is not one of ${PRIORITIES.join(', ')}`);
+  }
+  return ok(known);
+}
+
+/**
+ * Checks a tag: it must not be empty nor contain a space.
+ *
+ * @param tag - the tag to check
+ */
+export function validateTag(tag: unknown): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'a tag is empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space`);
+  return ok(tag);
+}
+
