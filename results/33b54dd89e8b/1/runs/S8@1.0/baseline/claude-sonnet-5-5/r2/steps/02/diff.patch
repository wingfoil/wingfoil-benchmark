+describe('task timestamps', () => {
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    let time = Date.parse('2026-01-01T00:00:00.000Z');
+    const list = createTodoList(() => new Date((time += 1000)));
+    const added = valueOf(list.add({ title: 'Sweep' }));
+    assert.equal(added.createdAt, '2026-01-01T00:00:01.000Z');
+    assert.equal(added.updatedAt, added.createdAt);
+    const steps = [
+      () => list.complete('Sweep'),
+      () => list.reopen('Sweep'),
+      () => list.rename('Sweep', 'Mop'),
+      () => list.tag('Mop', 'home'),
+      () => list.untag('Mop', 'home'),
+    ];
+    let previous = added.updatedAt;
+    for (const step of steps) {
+      const task = valueOf(step());
+      assert.equal(task.createdAt, added.createdAt);
+      assert.ok(task.updatedAt > previous);
+      previous = task.updatedAt;
+    }
+    assert.equal(valueOf(list.tag('Mop', 'x')).updatedAt > previous, true);
+    const same = valueOf(list.tag('Mop', 'x'));
+    assert.equal(valueOf(list.tag('Mop', 'x')).updatedAt, same.updatedAt);
+  });
