+describe('importTasks', () => {
+  it('imports valid lines and reports the others by line number', () => {
+    const list = createTodoList();
+    const report = importTasks(
+      list,
+      'Renew the insurance;high;admin money\n\nBuy milk\nWalk;urgent;\nBuy milk;;\n;low;x\nA;low;b;c\r\nCall;;a b a',
+    );
+    assert.equal(report.imported, 3);
+    assert.deepEqual(report.rejected.map((r) => r.line), [4, 5, 6, 7]);
+    assert.equal(valueOf(list.find('Renew the insurance')).priority, 'high');
+    assert.deepEqual(valueOf(list.find('Renew the insurance')).tags, ['admin', 'money']);
