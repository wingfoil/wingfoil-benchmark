@@ -0,0 +1,48 @@
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of the text that could not be added, with its number (from 1) and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks of `text` to `list`, one per line as `title;priority;tags`. The priority may be empty
+ * for a normal one, the tags are separated by spaces, and both may be left out. Blank lines are skipped.
+ * A line that cannot be added is reported and the others are still imported.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  const lines = text.replace(/^﻿/, '').split(/\r\n|\r|\n/);
+  lines.forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `expected at most 3 fields (title;priority;tags), found ${fields.length}` });
+      return;
+    }
+    const [title = '', priorityText = '', tagsText = ''] = fields;
+    const priority = priorityText.trim().toLowerCase();
+    const tags = tagsText.split(/\s+/).filter((tag) => tag !== '');
+    const result = list.add({
+      title,
+      ...(priority === '' ? {} : { priority: priority as Priority }),
+      tags,
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line, reason: result.error.message });
+  });
+  return { imported, rejected };
+}
