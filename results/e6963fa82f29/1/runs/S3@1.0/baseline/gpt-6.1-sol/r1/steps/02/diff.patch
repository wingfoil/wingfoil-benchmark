diff --git a/test/rentals.test.js b/test/rentals.test.js
index 92bf6e894cf629a94fbb450bfb5e361c3258ab77..34f37bae50bdbfb7e1ba9b2f97a7001d5929fee7 100644
--- a/test/rentals.test.js
+++ b/test/rentals.test.js
@@ -97,3 +97,56 @@ test('isolates service instances and protects state from caller mutation', () =>
   desk().book(request());
   assert.throws(() => createRentalService().quote(request()));
 });
+
+test('availability returns sorted IDs with optional kind filtering and no reservations', () => {
+  const service = desk();
+  service.addEquipment({ id: 'z-board', kind: 'board', dailyPrice: 0 });
+  service.addEquipment({ id: 'a-sail', kind: 'sail', dailyPrice: Number.MAX_SAFE_INTEGER });
+  const query = { start: day(10), end: day(12) };
+  assert.deepEqual(service.availability(query), ['a-sail', 'board', 'sail', 'z-board']);
+  assert.deepEqual(service.availability({ ...query, kind: 'board' }), ['board', 'z-board']);
+  assert.deepEqual(service.availability({ ...query, kind: 'sail' }), ['a-sail', 'sail']);
+  const result = service.availability(query);
+  result.length = 0;
+  assert.deepEqual(service.availability(query), ['a-sail', 'board', 'sail', 'z-board']);
+  assert.equal(service.book(request()).id, '1');
+  assert.deepEqual(service.availability(query), ['a-sail', 'sail', 'z-board']);
+  assert.deepEqual(desk().availability(query), ['board', 'sail']);
+});
+
+test('availability excludes every overlap and allows adjacent periods', () => {
+  const service = desk();
+  service.book(request(10, 14));
+  for (const [start, end] of [[10, 14], [11, 13], [9, 15], [9, 11], [13, 15]]) {
+    assert.deepEqual(service.availability({ start: day(start), end: day(end) }), ['sail']);
+  }
+  for (const [start, end] of [[8, 10], [14, 16]]) {
+    assert.deepEqual(service.availability({ start: day(start), end: day(end) }), ['board', 'sail']);
+  }
+  assert.deepEqual(service.availability({
+    start: '2026-06-10T00:00:00.000+00:00', end: day(14), kind: 'board',
+  }), []);
+  service.book(request(16, 18));
+  assert.deepEqual(service.availability({ start: day(14), end: day(16), kind: 'board' }), ['board']);
+  assert.deepEqual(service.availability({ start: day(14), end: day(17), kind: 'board' }), []);
+});
+
+test('availability validates periods and kinds even for empty inventories', () => {
+  for (const service of [createRentalService(), desk()]) {
+    for (const query of [
+      { start: day(10), end: day(10) },
+      { start: day(12), end: day(10) },
+      { start: '2026-02-30T00:00:00Z', end: day(12) },
+      { start: '2026-06-10', end: day(12) },
+      { start: '2026-06-10T01:00:00Z', end: day(12) },
+      { start: day(10), end: 'invalid' },
+      { start: day(10), end: day(12), kind: 'kayak' },
+    ]) {
+      assert.throws(() => service.availability(query));
+    }
+  }
+  const service = createRentalService();
+  assert.deepEqual(service.availability({ start: day(10), end: day(12) }), []);
+  service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 100 });
+  assert.deepEqual(service.availability({ start: day(10), end: day(12), kind: 'sail' }), []);
+});
