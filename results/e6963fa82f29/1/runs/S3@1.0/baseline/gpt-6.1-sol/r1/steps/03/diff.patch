+test('quotes and bookings discount the entire rental from three days onward', () => {
+  for (const [days, total] of [[1, 2500], [2, 5000], [3, 6750], [4, 9000], [10, 22500]]) {
+    const service = desk();
+    const input = request(10, 10 + days);
+    assert.deepEqual(service.quote(input), { ...input, total });
+    assert.deepEqual(service.book(input), { id: '1', ...input, total });
+  }
+  const service = desk();
+  assert.equal(service.quote(request(10, 13, 'sail')).total, 3240);
+  assert.equal(service.book(request(10, 13, 'sail')).total, 3240);
+});
+
+test('discounts round the full total once to the nearest cent, with half cents up', () => {
+  for (const [dailyPrice, days, total] of [[0, 3, 0], [1, 3, 3], [2, 3, 5], [1, 5, 5], [3, 5, 14],
+    [3002399751580330, 3, 8106479329266891]]) {
+    const service = createRentalService();
+    service.addEquipment({ id: 'board', kind: 'board', dailyPrice });
+    const input = request(10, 10 + days);
+    assert.equal(service.quote(input).total, total);
+    assert.equal(service.book(input).total, total);
+  }
+});
+
+test('rejects unsafe full prices even for discounted rentals', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 3100000000000000 });
+  assert.throws(() => service.quote(request(10, 13)));
+  assert.throws(() => service.book(request(10, 13)));
+});
