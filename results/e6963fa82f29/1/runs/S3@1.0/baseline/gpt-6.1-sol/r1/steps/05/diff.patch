diff --git a/test/rentals.test.js b/test/rentals.test.js
index e13a745620101f9204b887694b99503f190d0c33..dcd912d86dba7b1252f6b5979f56ec2dedccca77 100644
--- a/test/rentals.test.js
+++ b/test/rentals.test.js
@@ -272,3 +272,96 @@ test('copies hourly prices when registering equipment', () => {
   item.hourlyPrice = 1;
   assert.equal(service.quote(hourlyRequest()).total, 2100);
 });
+
+test('cancellation refunds the charged total at least 24 hours before the start', () => {
+  for (const [at, refunded] of [
+    [day(8), true],
+    ['2026-06-08T23:59:59.999Z', true],
+    ['2026-06-09T00:00:00.000+00:00', true],
+    ['2026-06-09T00:00:00.001Z', false],
+    ['2026-06-09T12:30Z', false],
+    [day(10), false],
+    [day(11), false],
+    [day(20), false],
+  ]) {
+    const service = desk();
+    const booking = service.book(request(10, 13));
+    assert.equal(booking.total, 6750);
+    assert.deepEqual(service.cancel(booking.id, at), {
+      bookingId: booking.id, refund: refunded ? 6750 : 0,
+    });
+    assert.throws(() => service.cancel(booking.id, day(8)), /already cancelled/);
+  }
+});
+
+test('cancellation releases only its booking and never reuses booking IDs', () => {
+  for (const at of [day(8), day(10)]) {
+    const service = desk();
+    const booking = service.book(request());
+    const adjacent = service.book(request(12, 14));
+    service.book(request(10, 12, 'sail'));
+    assert.deepEqual(service.availability(request()), []);
+    service.cancel(booking.id, at);
+    assert.deepEqual(service.availability(request()), ['board']);
+    assert.deepEqual(service.availability(request(12, 14)), ['sail']);
+    const replacement = service.book(request());
+    assert.notEqual(replacement.id, booking.id);
+    assert.notEqual(replacement.id, adjacent.id);
+    assert.throws(() => service.cancel(booking.id, at));
+    assert.throws(() => service.book(request()));
+    assert.throws(() => service.book(request(12, 14)));
+  }
+});
+
+test('cancellation uses the hourly booking start and refunds zero-priced bookings', () => {
+  for (const price of [0, 700]) {
+    for (const [at, refunded] of [
+      ['2026-06-09T13:00:00+00:00', true],
+      ['2026-06-09T13:00:00.001Z', false],
+    ]) {
+      const service = hourlyDesk(price);
+      const input = hourlyRequest(hour(10, 13), hour(10, 16), 'hourly');
+      const booking = service.book(input);
+      assert.deepEqual(service.cancel(booking.id, at), {
+        bookingId: booking.id, refund: refunded ? price * 3 : 0,
+      });
+      assert.deepEqual(service.availability(input), ['hourly']);
+      service.book(input);
+    }
+  }
+});
+
+test('invalid cancellations preserve bookings and refund eligibility', () => {
+  const service = desk();
+  const booking = service.book(request());
+  for (const at of [
+    'invalid', '2026-06-08', '2026-06-08T12:30:00',
+    '2026-06-08T12:30:00+01:00', '2026-02-30T12:30:00Z',
+    '2026-06-08T24:00:00Z', '2026-06-08T12:60:00Z',
+    '2026-06-08T12:30:60Z', null, undefined, 0,
+  ]) {
+    assert.throws(() => service.cancel(booking.id, at));
+    assert.deepEqual(service.availability(request()), ['sail']);
+    assert.throws(() => service.book(request()));
+  }
+  for (const id of ['missing', '', 1, null, undefined]) {
+    assert.throws(() => service.cancel(id, day(8)), /Unknown booking/);
+  }
+  assert.throws(() => desk().cancel(booking.id, day(8)), /Unknown booking/);
+  assert.deepEqual(service.cancel(booking.id, day(8)), { bookingId: booking.id, refund: 5000 });
+});
+
+test('cancellation state is independent of returned booking and result objects', () => {
+  const service = desk();
+  const booking = service.book(request());
+  const id = booking.id;
+  booking.id = 'changed';
+  booking.start = day(20);
+  booking.total = 1;
+  const result = service.cancel(id, day(9));
+  assert.deepEqual(result, { bookingId: id, refund: 5000 });
+  result.bookingId = 'other';
+  result.refund = 0;
+  assert.throws(() => service.cancel(id, day(9)), /already cancelled/);
+  service.book(request());
+});
