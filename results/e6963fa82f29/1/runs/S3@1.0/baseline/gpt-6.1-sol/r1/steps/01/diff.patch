diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5a9844888e3c192c4c519d4e978899ab3136c4fc
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,90 @@
+export interface Equipment {
+  id: string;
+  kind: 'board' | 'sail';
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+export interface RentalBooking extends RentalQuote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): RentalQuote;
+  book(request: RentalRequest): RentalBooking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+function midnight(value: string): number {
+  // Only explicit UTC timestamps are accepted. Checking the calendar date also
+  // catches dates such as February 30, which Date.parse can silently roll over.
+  if (typeof value !== 'string' ||
+      !/^\d{4}-\d{2}-\d{2}T00:00(?::00(?:\.0+)?)?(?:Z|\+00:00)$/.test(value)) {
+    throw new Error('Rental dates must be ISO-8601 timestamps at midnight UTC');
+  }
+  const time = Date.parse(value);
+  if (!Number.isFinite(time) || new Date(time).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error('Invalid rental date');
+  }
+  return time;
+}
+
+/** Creates an independent rental desk. All prices and totals are euro cents. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: { itemId: string; start: number; end: number }[] = [];
+  let nextBookingId = 1;
+
+  function calculate(request: RentalRequest) {
+    const item = equipment.get(request.itemId);
+    if (!item) throw new Error('Unknown equipment item');
+    const start = midnight(request.start);
+    const end = midnight(request.end);
+    if (end <= start) throw new Error('Rental end must be after its start');
+    const total = ((end - start) / DAY_MS) * item.dailyPrice;
+    if (!Number.isSafeInteger(total)) throw new Error('Rental total exceeds the supported cent amount');
+    const quote: RentalQuote = {
+      itemId: item.id,
+      start: request.start,
+      end: request.end,
+      total,
+    };
+    return { quote, start, end };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item.id !== 'string' || (item.kind !== 'board' && item.kind !== 'sail')) {
+        throw new Error('Equipment requires a string ID and board or sail kind');
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('Daily price must be a non-negative safe integer in euro cents');
+      }
+      if (equipment.has(item.id)) throw new Error('Equipment ID already exists');
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+    quote(request) {
+      return calculate(request).quote;
+    },
+    book(request) {
+      const { quote, start, end } = calculate(request);
+      if (bookings.some(booking => booking.itemId === quote.itemId &&
+          start < booking.end && booking.start < end)) {
+        throw new Error('Equipment is already booked for this period');
+      }
+      bookings.push({ itemId: quote.itemId, start, end });
+      return { id: String(nextBookingId++), ...quote };
+    },
+  };
+}
diff --git a/test/rentals.test.js b/test/rentals.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..92bf6e894cf629a94fbb450bfb5e361c3258ab77
--- /dev/null
+++ b/test/rentals.test.js
@@ -0,0 +1,99 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createRentalService } from '../dist/index.js';
+
+const day = number => `2026-06-${String(number).padStart(2, '0')}T00:00:00Z`;
+const request = (start = 10, end = 12, itemId = 'board') => ({ itemId, start: day(start), end: day(end) });
+function desk() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail', kind: 'sail', dailyPrice: 1200 });
+  return service;
+}
+
+test('quotes and books whole days in integer cents, preserving request timestamps', () => {
+  const service = desk();
+  assert.deepEqual(service.quote(request()), { ...request(), total: 5000 });
+  assert.deepEqual(service.quote(request(10, 11, 'sail')), { ...request(10, 11, 'sail'), total: 1200 });
+  const booking = service.book(request());
+  assert.deepEqual(booking, { id: booking.id, ...request(), total: 5000 });
+  assert.equal(typeof booking.id, 'string');
+  assert.ok(booking.id.length);
+  assert.notEqual(service.book(request(12, 13)).id, booking.id);
+  assert.deepEqual(service.quote(request()), { ...request(), total: 5000 });
+});
+
+test('rejects every overlap while allowing adjacent periods and other items', () => {
+  const service = desk();
+  service.book(request(10, 14));
+  for (const [start, end] of [[10, 14], [11, 13], [9, 15], [9, 11], [13, 15]]) {
+    assert.throws(() => service.book(request(start, end)));
+  }
+  service.book(request(8, 10));
+  service.book(request(14, 16));
+  service.book(request(10, 14, 'sail'));
+});
+
+test('quote and book reject unknown items and invalid periods', () => {
+  const service = desk();
+  const invalid = [
+    request(10, 10), request(12, 10), request(10, 12, 'missing'),
+    { ...request(), start: '2026-02-30T00:00:00Z' },
+    { ...request(), start: '2026-06-10' },
+    { ...request(), start: '2026-06-10T00:00:00' },
+    { ...request(), start: '2026-06-10T01:00:00Z' },
+    { ...request(), start: '2026-06-10T00:00:00+01:00' },
+    { ...request(), end: '2026-06-12T00:00:00.001Z' },
+    { ...request(), end: 'invalid' },
+  ];
+  for (const input of invalid) {
+    assert.throws(() => service.quote(input));
+    assert.throws(() => service.book(input));
+  }
+  service.book(request());
+});
+
+test('handles leap days, year boundaries, and explicit zero UTC offsets', () => {
+  const service = desk();
+  for (const [start, end] of [
+    ['2028-02-28T00:00:00Z', '2028-03-01T00:00:00Z'],
+    ['2026-12-31T00:00:00.000Z', '2027-01-02T00:00:00+00:00'],
+  ]) {
+    assert.equal(service.quote({ itemId: 'board', start, end }).total, 5000);
+  }
+  service.book(request());
+  assert.throws(() => service.book({ ...request(), start: '2026-06-10T00:00:00.000+00:00' }));
+});
+
+test('validates equipment and prevents unsafe cent totals', () => {
+  const service = desk();
+  for (const dailyPrice of [-1, 1.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 1]) {
+    assert.throws(() => service.addEquipment({ id: 'bad', kind: 'sail', dailyPrice }));
+  }
+  assert.throws(() => service.addEquipment({ id: 'bad', kind: 'kayak', dailyPrice: 100 }));
+  assert.throws(() => service.addEquipment({ id: 12, kind: 'board', dailyPrice: 100 }));
+  assert.throws(() => service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 1 }));
+  service.addEquipment({ id: 'free', kind: 'sail', dailyPrice: 0 });
+  assert.equal(service.book(request(10, 12, 'free')).total, 0);
+  service.addEquipment({ id: 'large', kind: 'board', dailyPrice: Number.MAX_SAFE_INTEGER });
+  assert.throws(() => service.quote(request(10, 12, 'large')));
+  assert.throws(() => service.book(request(10, 12, 'large')));
+});
+
+test('isolates service instances and protects state from caller mutation', () => {
+  const service = createRentalService();
+  const item = { id: 'board', kind: 'board', dailyPrice: 2500 };
+  service.addEquipment(item);
+  item.dailyPrice = 1;
+  const input = request();
+  const booking = service.book(input);
+  input.start = day(20);
+  booking.itemId = 'other';
+  booking.start = day(20);
+  const quote = service.quote(request());
+  quote.total = 1;
+  assert.equal(service.quote(request()).total, 5000);
+  assert.throws(() => service.book(request()));
+  desk().book(request());
+  assert.throws(() => createRentalService().quote(request()));
+});
