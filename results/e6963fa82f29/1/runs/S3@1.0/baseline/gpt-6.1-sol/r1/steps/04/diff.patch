diff --git a/test/rentals.test.js b/test/rentals.test.js
index c736d738cc7ab458d7d990f2f18b01c921d49370..e13a745620101f9204b887694b99503f190d0c33 100644
--- a/test/rentals.test.js
+++ b/test/rentals.test.js
@@ -180,3 +180,95 @@ test('availability validates periods and kinds even for empty inventories', () =
   service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 100 });
   assert.deepEqual(service.availability({ start: day(10), end: day(12), kind: 'sail' }), []);
 });
+
+const hour = (dayNumber, hourNumber) => day(dayNumber).replace('T00:', `T${String(hourNumber).padStart(2, '0')}:`);
+const hourlyRequest = (start = hour(10, 13), end = hour(10, 16), itemId = 'board') => ({ itemId, start, end });
+function hourlyDesk(hourlyPrice = 700) {
+  const service = desk();
+  service.addEquipment({ id: 'hourly', kind: 'board', dailyPrice: 2500, hourlyPrice });
+  return service;
+}
+
+test('quotes and books hourly rentals, including crossing midnight and zero prices', () => {
+  for (const [start, end, hours] of [
+    [hour(10, 13), hour(10, 16), 3],
+    [hour(10, 23), hour(11, 2), 3],
+    [day(10), hour(10, 23), 23],
+    [hour(10, 23), day(11), 1],
+  ]) {
+    for (const price of [0, 700]) {
+      const service = hourlyDesk(price);
+      const input = hourlyRequest(start, end, 'hourly');
+      assert.deepEqual(service.quote(input), { ...input, total: hours * price });
+      assert.deepEqual(service.book(input), { id: '1', ...input, total: hours * price });
+    }
+  }
+  const service = hourlyDesk();
+  const input = hourlyRequest('2026-06-10T13:00:00.000+00:00', '2026-06-10T14:00Z', 'hourly');
+  assert.deepEqual(service.quote(input), { ...input, total: 700 });
+  assert.equal(service.quote(request(10, 11, 'hourly')).total, 2500);
+  assert.equal(service.quote(request(10, 13, 'hourly')).total, 6750);
+});
+
+test('hourly rentals require a valid hourly price and safe totals', () => {
+  const service = hourlyDesk();
+  for (const price of [-1, 0.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 1, null, '700']) {
+    assert.throws(() => service.addEquipment({ id: 'bad', kind: 'board', dailyPrice: 1, hourlyPrice: price }));
+  }
+  for (const method of ['quote', 'book']) {
+    assert.throws(() => service[method](hourlyRequest()));
+  }
+  const large = hourlyDesk(Number.MAX_SAFE_INTEGER);
+  const oneHour = hourlyRequest(hour(10, 13), hour(10, 14), 'hourly');
+  assert.equal(large.quote(oneHour).total, Number.MAX_SAFE_INTEGER);
+  assert.throws(() => large.quote(hourlyRequest(hour(10, 13), hour(10, 15), 'hourly')));
+  assert.throws(() => large.book(hourlyRequest(hour(10, 13), hour(10, 15), 'hourly')));
+  assert.equal(large.book(oneHour).id, '1');
+});
+
+test('rejects fractional hours and non-midnight periods of a day or longer', () => {
+  const service = hourlyDesk();
+  for (const [start, end] of [
+    [hour(10, 13), hour(11, 13)],
+    [day(10), hour(11, 1)],
+    [hour(10, 1), day(12)],
+    ['2026-06-10T13:30:00Z', hour(10, 15)],
+    [hour(10, 13), '2026-06-10T15:00:01Z'],
+    [hour(10, 13), '2026-06-10T15:00:00.001Z'],
+    ['2026-06-10T24:00:00Z', day(12)],
+    ['2026-02-30T13:00:00Z', '2026-02-30T14:00:00Z'],
+    ['2026-06-10T13:00:00+01:00', hour(10, 15)],
+  ]) {
+    const input = hourlyRequest(start, end, 'hourly');
+    assert.throws(() => service.quote(input));
+    assert.throws(() => service.book(input));
+    assert.throws(() => service.availability({ start, end }));
+  }
+});
+
+test('hourly and daily bookings share overlap checks and availability', () => {
+  const service = hourlyDesk();
+  const query = { start: hour(10, 13), end: hour(10, 16) };
+  assert.deepEqual(service.availability(query), ['hourly']);
+  assert.deepEqual(service.availability({ ...query, kind: 'sail' }), []);
+  service.book(hourlyRequest(query.start, query.end, 'hourly'));
+  assert.deepEqual(service.availability(query), []);
+  assert.deepEqual(service.availability({ start: day(10), end: day(11), kind: 'board' }), ['board']);
+  assert.throws(() => service.book(request(10, 11, 'hourly')));
+  for (const [start, end] of [[12, 14], [14, 15], [15, 17], [12, 17]]) {
+    assert.throws(() => service.book(hourlyRequest(hour(10, start), hour(10, end), 'hourly')));
+  }
+  service.book(hourlyRequest(hour(10, 12), hour(10, 13), 'hourly'));
+  service.book(hourlyRequest(hour(10, 16), hour(10, 17), 'hourly'));
+  service.book(request(11, 12, 'hourly'));
+  assert.throws(() => service.book(hourlyRequest(hour(11, 12), hour(11, 13), 'hourly')));
+  assert.equal(service.quote(hourlyRequest(query.start, query.end, 'hourly')).total, 2100);
+});
+
+test('copies hourly prices when registering equipment', () => {
+  const service = createRentalService();
+  const item = { id: 'board', kind: 'board', dailyPrice: 2500, hourlyPrice: 700 };
+  service.addEquipment(item);
+  item.hourlyPrice = 1;
+  assert.equal(service.quote(hourlyRequest()).total, 2100);
+});
