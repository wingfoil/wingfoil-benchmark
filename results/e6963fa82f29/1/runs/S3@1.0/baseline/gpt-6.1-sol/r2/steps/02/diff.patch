diff --git a/test/rental.test.mjs b/test/rental.test.mjs
index 6677efbb5175d266f0daa1a8339febc5b9fffc44..a14b6d318178afd02d84b74831bc6bbc67518f04 100644
--- a/test/rental.test.mjs
+++ b/test/rental.test.mjs
@@ -77,3 +77,45 @@ test('caller mutations cannot change equipment or bookings; services are indepen
   assert.equal(service.quote(request()).total, 200);
   assert.throws(() => createRentalService().quote(request()));
 });
+
+test('availability returns sorted IDs, optionally filtered by kind, without reserving', () => {
+  const service = desk();
+  service.addEquipment({ id: 'another', kind: 'board', dailyPrice: Number.MAX_SAFE_INTEGER });
+  const query = { start: date(1), end: date(3) };
+  assert.deepEqual(service.availability(query), ['another', 'board', 'sail']);
+  assert.deepEqual(service.availability({ ...query, kind: 'board' }), ['another', 'board']);
+  assert.deepEqual(service.availability({ ...query, kind: 'sail' }), ['sail']);
+  const ids = service.availability(query);
+  ids.length = 0;
+  service.book(request());
+  assert.deepEqual(service.availability(query), ['another', 'sail']);
+  assert.deepEqual(createRentalService().availability(query), []);
+});
+
+test('availability excludes every overlap shape and allows adjacent periods', () => {
+  const service = desk();
+  service.book(request(3, 6));
+  for (const [start, end] of [[3, 6], [2, 4], [5, 7], [4, 5], [2, 7]]) {
+    assert.deepEqual(service.availability({ start: date(start), end: date(end) }), ['sail']);
+    assert.deepEqual(service.availability({ start: date(start), end: date(end), kind: 'board' }), []);
+  }
+  for (const [start, end] of [[1, 3], [6, 7]]) {
+    assert.deepEqual(service.availability({ start: date(start), end: date(end) }), ['board', 'sail']);
+  }
+  assert.deepEqual(service.availability({ start: '2026-06-03T00:00+00:00', end: '2026-06-06T00:00:00.000Z' }), ['sail']);
+});
+
+test('availability validates periods and kinds even with no equipment', () => {
+  const service = createRentalService();
+  const query = { start: date(1), end: date(3) };
+  for (const value of ['2026-02-30T00:00:00Z', '2026-06-01', '2026-06-01T00:00:00', '2026-06-01T01:00:00Z', '2026-06-01T00:00:00+01:00', '2026-06-01T00:00:00.001Z', 'invalid', null, 0]) {
+    assert.throws(() => service.availability({ ...query, start: value }));
+    assert.throws(() => service.availability({ ...query, end: value }));
+  }
+  assert.throws(() => service.availability({ ...query, end: date(1) }));
+  assert.throws(() => service.availability({ ...query, end: date(0) }));
+  assert.throws(() => service.availability({ ...query, start: date(4) }));
+  for (const kind of ['mast', '', null, 0]) {
+    assert.throws(() => service.availability({ ...query, kind }));
+  }
+});
