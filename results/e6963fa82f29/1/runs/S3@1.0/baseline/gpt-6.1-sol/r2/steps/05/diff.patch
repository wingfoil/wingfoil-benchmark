+function cancellationTime(value: string): number {
+  if (typeof value !== 'string' ||
+      !/^\d{4}-\d{2}-\d{2}T(?:[01]\d|2[0-3]):[0-5]\d(?::[0-5]\d(?:\.\d{1,3})?)?(?:Z|\+00:00)$/.test(value)) {
+    throw new Error('Cancellation time must be an ISO-8601 UTC string');
+  }
+  const time = Date.parse(value);
+  if (!Number.isFinite(time) || new Date(time).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error('Invalid cancellation date');
+  }
+  return time;
+}
