+test('cancellation refunds the paid total at least 24 hours before the start', () => {
+  for (const at of ['2026-06-01T00:00Z', '2026-06-02T00:00:00.000+00:00']) {
+    const service = desk();
+    const booking = service.book(request(3, 6));
+    booking.total = 999;
+    assert.deepEqual(service.cancel(booking.id, at), { bookingId: booking.id, refund: 3375 });
+    assert.throws(() => service.cancel(booking.id, at), /already cancelled/);
+  }
+});
+
+test('cancellation applies the exact cutoff and releases equipment even without a refund', () => {
+  for (const at of [
+    '2026-06-02T00:00:00.001Z',
+    '2026-06-02T12:34:56+00:00',
+    date(3), date(4), date(7),
+  ]) {
+    const service = desk();
+    const input = request(3, 6);
+    const booking = service.book(input);
+    assert.deepEqual(service.cancel(booking.id, at), { bookingId: booking.id, refund: 0 });
+    assert.deepEqual(service.availability(input), ['board', 'sail']);
+    const replacement = service.book(input);
+    assert.notEqual(replacement.id, booking.id);
+    assert.throws(() => service.cancel(booking.id, date(1)), /already cancelled/);
+    assert.throws(() => service.book(input));
+  }
+});
+
+test('cancellation handles hourly and free bookings and leaves other reservations intact', () => {
+  const service = desk();
+  service.addEquipment({ id: 'hourly', kind: 'board', dailyPrice: 1000, hourlyPrice: 100 });
+  service.addEquipment({ id: 'free', kind: 'sail', dailyPrice: 0 });
+  const input = hourlyRequest();
+  const booking = service.book(input);
+  service.book(request(1, 2));
+  const other = service.book(hourlyRequest('2026-06-01T16:00Z', '2026-06-01T17:00Z'));
+  assert.deepEqual(service.cancel(booking.id, '2026-05-31T13:00:00+00:00'), { bookingId: booking.id, refund: 300 });
+  assert.deepEqual(service.availability(input), ['hourly']);
+  service.book(input);
+  assert.throws(() => service.book(request(1, 2)));
+  assert.throws(() => service.book(hourlyRequest(other.start, other.end)));
+  const free = service.book(request(3, 4, 'free'));
+  assert.deepEqual(service.cancel(free.id, date(1)), { bookingId: free.id, refund: 0 });
+  assert.throws(() => service.cancel(free.id, date(1)));
+});
+
+test('invalid cancellations preserve reservations and do not consume cancellation', () => {
+  const service = desk();
+  const booking = service.book(request(3, 6));
+  for (const bookingId of ['missing', '', null, 1, undefined]) {
+    assert.throws(() => service.cancel(bookingId, date(1)), /Unknown booking/);
+  }
+  assert.throws(() => createRentalService().cancel(booking.id, date(1)), /Unknown booking/);
+  for (const at of [
+    'invalid', '', null, 0, undefined, '2026-02-30T12:00:00Z',
+    '2026-06-01', '2026-06-01T00:00:00', '2026-06-01T00:00:00+01:00',
+    '2026-06-01T24:00:00Z', '2026-06-01T00:60:00Z', '2026-06-01T00:00:60Z',
+  ]) {
+    assert.throws(() => service.cancel(booking.id, at));
+    assert.deepEqual(service.availability(request(3, 6)), ['sail']);
+    assert.throws(() => service.book(request(3, 6)));
+  }
+  assert.deepEqual(service.cancel(booking.id, date(1)), { bookingId: booking.id, refund: 3375 });
+  assert.deepEqual(service.availability(request(3, 6)), ['board', 'sail']);
+  service.book(request(3, 6));
+});
