+
+test('prices hourly quotes and bookings, including overnight and free rentals', () => {
+  const service = desk();
+  const item = { id: 'hourly', kind: 'board', dailyPrice: 1250, hourlyPrice: 600 };
+  service.addEquipment(item);
+  item.hourlyPrice = 999;
+  for (const [start, end, total] of [
+    ['2026-06-01T13:00:00Z', '2026-06-01T16:00:00Z', 1800],
+    ['2026-06-01T23:00+00:00', '2026-06-02T01:00:00.000Z', 1200],
+    ['2026-06-02T01:00Z', '2026-06-03T00:00Z', 13800],
+    [date(4), date(5), 1250],
+    [date(5), date(8), 3375],
+  ]) {
+    const input = hourlyRequest(start, end);
+    assert.deepEqual(service.quote(input), { ...input, total });
+    assert.equal(service.book(input).total, total);
+  }
+  service.addEquipment({ id: 'free', kind: 'sail', dailyPrice: 100, hourlyPrice: 0 });
+  assert.equal(service.book(hourlyRequest(undefined, undefined, 'free')).total, 0);
+  for (const operation of ['quote', 'book']) {
+    assert.throws(() => service[operation](hourlyRequest(undefined, undefined, 'board')));
+  }
+});
+
+test('hourly and daily bookings share overlap checks and allow adjacency', () => {
+  const service = desk();
+  service.addEquipment({ id: 'hourly', kind: 'board', dailyPrice: 1000, hourlyPrice: 100 });
+  service.book(hourlyRequest());
+  for (const [start, end] of [[13, 16], [12, 14], [15, 17], [14, 15], [12, 17]]) {
+    const input = hourlyRequest(`2026-06-01T${start}:00Z`, `2026-06-01T${end}:00Z`);
+    assert.throws(() => service.book(input));
+    assert.deepEqual(service.availability(input), []);
+    assert.equal(service.quote(input).total, (end - start) * 100);
+  }
+  assert.throws(() => service.book(request(1, 2, 'hourly')));
+  assert.deepEqual(service.availability(request(1, 2)), ['board', 'sail']);
+  for (const input of [
+    hourlyRequest('2026-06-01T12:00Z', '2026-06-01T13:00Z'),
+    hourlyRequest('2026-06-01T16:00Z', '2026-06-01T17:00Z'),
+  ]) {
+    assert.deepEqual(service.availability(input), ['hourly']);
+    service.book(input);
+  }
+  service.book(request(2, 3, 'hourly'));
+  assert.throws(() => service.book(hourlyRequest('2026-06-02T10:00Z', '2026-06-02T11:00Z')));
+});
+
+test('validates hourly prices, periods and safe totals', () => {
+  const service = createRentalService();
+  for (const hourlyPrice of [-1, 1.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 1, '100', null]) {
+    assert.throws(() => service.addEquipment({ id: 'hourly', kind: 'board', dailyPrice: 100, hourlyPrice }));
+  }
+  service.addEquipment({ id: 'hourly', kind: 'board', dailyPrice: 100, hourlyPrice: Number.MAX_SAFE_INTEGER });
+  assert.equal(service.quote(hourlyRequest('2026-06-01T13:00Z', '2026-06-01T14:00Z')).total, Number.MAX_SAFE_INTEGER);
+  for (const operation of ['quote', 'book']) {
+    assert.throws(() => service[operation](hourlyRequest()));
+  }
+  // Availability does not calculate prices, even when a quote would overflow.
+  assert.deepEqual(service.availability(hourlyRequest()), ['hourly']);
+  for (const [start, end] of [
+    ['2026-06-01T13:30Z', '2026-06-01T16:00Z'],
+    ['2026-06-01T13:00:01Z', '2026-06-01T16:00Z'],
+    ['2026-06-01T24:00Z', '2026-06-02T01:00Z'],
+    ['2026-02-30T13:00Z', '2026-03-01T14:00Z'],
+    ['2026-06-01T13:00Z', '2026-06-02T13:00Z'],
+    ['2026-06-01T13:00Z', '2026-06-03T00:00Z'],
+  ]) {
+    const input = hourlyRequest(start, end);
+    for (const operation of ['quote', 'book', 'availability']) {
+      assert.throws(() => service[operation](input));
+    }
+  }
+});
