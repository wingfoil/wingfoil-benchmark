+test('cancel refunds fully from 24 hours before start, frees the item, and works once', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(5), end: d(7) });
+  assert.deepEqual(s.cancel(b.id, '2026-07-04T00:00:00Z'), { bookingId: b.id, refund: b.total });
