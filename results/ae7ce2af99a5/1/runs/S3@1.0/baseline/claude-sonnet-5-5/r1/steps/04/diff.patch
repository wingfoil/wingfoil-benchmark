diff --git a/test/rental.test.ts b/test/rental.test.ts
index 3f98c412981eb10d76064dc1a4e4abdf69a3eca7..339f757a5418fde7e34711343f0573152d10e758 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -52,3 +52,20 @@ test('availability lists free items of a kind, sorted, with half-open periods',
   assert.deepEqual(s.availability({ start: d(1), end: d(5), kind: 'board' }), ['a1']);
   assert.throws(() => s.availability({ start: d(3), end: d(3) }));
 });
+
+test('hourly rentals under a day use the hourly price', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 5000, hourlyPrice: 900 });
+  s.addEquipment({ id: 'n1', kind: 'board', dailyPrice: 5000 });
+  const h = (day: number, hour: number) => `2026-07-${String(day).padStart(2, '0')}T${String(hour).padStart(2, '0')}:00:00Z`;
+  assert.equal(s.quote({ itemId: 'h1', start: h(1, 9), end: h(1, 13) }).total, 3600);
+  assert.equal(s.quote({ itemId: 'h1', start: h(1, 22), end: h(2, 2) }).total, 3600);
+  assert.throws(() => s.quote({ itemId: 'n1', start: h(1, 9), end: h(1, 13) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: h(1, 9), end: h(2, 9) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-07-01T09:30:00Z', end: h(1, 13) }));
+  s.book({ itemId: 'h1', start: h(1, 9), end: h(1, 13) });
+  assert.throws(() => s.book({ itemId: 'h1', start: h(1, 12), end: h(1, 14) }));
+  s.book({ itemId: 'h1', start: h(1, 13), end: h(1, 14) });
+  assert.deepEqual(s.availability({ start: h(1, 9), end: h(1, 10) }), ['n1']);
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+});
