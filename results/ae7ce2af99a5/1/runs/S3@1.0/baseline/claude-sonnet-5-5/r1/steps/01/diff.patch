@@ -0,0 +1,98 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one rental day, in euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  /** ISO-8601, UTC, midnight. */
+  start: string;
+  /** ISO-8601, UTC, midnight; the start of the day after the last rental day. */
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  /** Euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00(?::00(?:\.0+)?)?(?:Z|[+-]00:00)$/;
+
+function parseMidnight(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !UTC_MIDNIGHT.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC midnight, got ${String(value)}`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms)) throw new Error(`${name} is not a valid date: ${value}`);
+  return ms;
+}
+
+export function createRentalService(): RentalService {
+  const items = new Map<string, Equipment>();
+  const bookings: Array<Booking & { startMs: number; endMs: number }> = [];
+  let nextId = 1;
+
+  function price(request: RentalRequest) {
+    const item = items.get(request?.itemId);
+    if (!item) throw new Error(`Unknown item: ${String(request?.itemId)}`);
+    const startMs = parseMidnight(request.start, 'start');
+    const endMs = parseMidnight(request.end, 'end');
+    if (endMs <= startMs) throw new Error('end must be after start');
+    const days = Math.round((endMs - startMs) / DAY_MS);
+    return {
+      startMs,
+      endMs,
+      quote: {
+        itemId: item.id,
+        start: request.start,
+        end: request.end,
+        total: days * item.dailyPrice,
+      },
+    };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item?.id !== 'string' || item.id === '') throw new Error('Item id must be a non-empty string');
+      if (item.kind !== 'board' && item.kind !== 'sail') throw new Error(`Invalid kind: ${String(item.kind)}`);
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+      }
+      if (items.has(item.id)) throw new Error(`Item already exists: ${item.id}`);
+      items.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { startMs, endMs, quote } = price(request);
+      const clash = bookings.some(
+        (b) => b.itemId === quote.itemId && startMs < b.endMs && b.startMs < endMs,
+      );
+      if (clash) throw new Error(`Item ${quote.itemId} is not free for that period`);
+      const booking = { id: `booking-${nextId++}`, ...quote };
+      bookings.push({ ...booking, startMs, endMs });
+      return booking;
+    },
+  };
+}
