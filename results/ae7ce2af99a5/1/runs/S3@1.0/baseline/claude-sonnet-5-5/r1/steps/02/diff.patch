+
+test('availability lists free items of a kind, sorted, with half-open periods', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a2', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'a1', kind: 'board', dailyPrice: 1000 });
+  s.book({ itemId: 'b1', start: d(2), end: d(4) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(3) }), ['a1', 'a2']);
+  assert.deepEqual(s.availability({ start: d(4), end: d(6) }), ['a1', 'a2', 'b1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(2) }), ['a1', 'a2', 'b1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(5), kind: 'board' }), ['a1']);
+  assert.throws(() => s.availability({ start: d(3), end: d(3) }));
+});
