 ## Rental module (`src/index.ts`)
 
-`createRentalService()` returns an in-memory service: `addEquipment`, `quote`, `book`.
+`createRentalService()` returns an in-memory service: `addEquipment`, `quote`, `book`, `availability({ start, end, kind? })` (sorted ids of the equipment free for the whole period).
 Tests: `npm test` (`test/`).
 
 School rules, which apply to everything the module does:
diff --git a/src/index.ts b/src/index.ts
index a3f612bf7b8a75496bf143752aa307b17c13bbaf..ecd5411e01483edff20b8f7ef1cdde84a85e7549 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -27,10 +27,21 @@ export interface Booking extends Quote {
   id: string;
 }
 
+export interface AvailabilityQuery {
+  /** ISO-8601, UTC, midnight. */
+  start: string;
+  /** ISO-8601, UTC, midnight; the start of the day after the last rental day. */
+  end: string;
+  /** Restrict to one kind of equipment; any kind when omitted. */
+  kind?: EquipmentKind;
+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  /** Sorted ids of the equipment free for the whole period. */
+  availability(query: AvailabilityQuery): string[];
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
@@ -94,5 +105,20 @@ export function createRentalService(): RentalService {
       bookings.push({ ...booking, startMs, endMs });
       return booking;
     },
+
+    availability(query) {
+      const startMs = parseMidnight(query?.start, 'start');
+      const endMs = parseMidnight(query?.end, 'end');
+      if (endMs <= startMs) throw new Error('end must be after start');
+      const kind = query.kind;
+      if (kind !== undefined && kind !== 'board' && kind !== 'sail') {
+        throw new Error(`Invalid kind: ${String(kind)}`);
+      }
+      return [...items.values()]
+        .filter((i) => kind === undefined || i.kind === kind)
+        .filter((i) => !bookings.some((b) => b.itemId === i.id && startMs < b.endMs && b.startMs < endMs))
+        .map((i) => i.id)
+        .sort();
+    },
   };
 }
