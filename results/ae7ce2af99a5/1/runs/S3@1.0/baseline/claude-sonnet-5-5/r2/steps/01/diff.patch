@@ -0,0 +1,104 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one day of rental, in euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  /** ISO-8601, midnight UTC. */
+  start: string;
+  /** ISO-8601, midnight UTC; the start of the day after the last rental day. */
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  /** Euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00(:00(\.0+)?)?(Z|[+-]00:?00)$/;
+
+function parseMidnightUtc(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC string at midnight`);
+  }
+  const ms = Date.parse(value);
+  // Date.parse rolls impossible dates over in some forms; reject them.
+  if (Number.isNaN(ms) || ms % DAY_MS !== 0 || value.slice(0, 10) !== new Date(ms).toISOString().slice(0, 10)) {
+    throw new Error(`${name} is not a valid date: ${value}`);
+  }
+  return ms;
+}
+
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: (Booking & { startMs: number; endMs: number })[] = [];
+  let nextBookingId = 1;
+
+  function price(request: RentalRequest) {
+    if (typeof request !== 'object' || request === null) throw new Error('request is required');
+    const item = equipment.get(request.itemId);
+    if (!item) throw new Error(`unknown item: ${String(request.itemId)}`);
+    const startMs = parseMidnightUtc(request.start, 'start');
+    const endMs = parseMidnightUtc(request.end, 'end');
+    if (endMs <= startMs) throw new Error('end must be after start');
+    const total = ((endMs - startMs) / DAY_MS) * item.dailyPrice;
+    if (!Number.isSafeInteger(total)) throw new Error('total is too large');
+    return {
+      startMs,
+      endMs,
+      quote: {
+        itemId: item.id,
+        start: new Date(startMs).toISOString(),
+        end: new Date(endMs).toISOString(),
+        total,
+      },
+    };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item !== 'object' || item === null) throw new Error('item is required');
+      if (typeof item.id !== 'string' || item.id === '') throw new Error('id must be a non-empty string');
+      if (item.kind !== 'board' && item.kind !== 'sail') throw new Error("kind must be 'board' or 'sail'");
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+      }
+      if (equipment.has(item.id)) throw new Error(`item already exists: ${item.id}`);
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { startMs, endMs, quote } = price(request);
+      const clash = bookings.some(
+        (b) => b.itemId === quote.itemId && b.startMs < endMs && startMs < b.endMs,
+      );
+      if (clash) throw new Error(`item ${quote.itemId} is not available for that period`);
+      const booking: Booking = { id: `booking-${nextBookingId++}`, ...quote };
+      bookings.push({ ...booking, startMs, endMs });
+      return { ...booking };
+    },
+  };
+}
diff --git a/test/rental.test.ts b/test/rental.test.ts
