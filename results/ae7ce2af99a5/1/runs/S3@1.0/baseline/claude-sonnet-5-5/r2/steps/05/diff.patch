+
+test('cancels a booking once, refunds in full before the start and frees the equipment', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.deepEqual(s.cancel(a.id, '2026-06-30T12:00:00Z'), { bookingId: a.id, refund: 6750 });
+  assert.throws(() => s.cancel(a.id, d(1)), /already cancelled/);
+  assert.deepEqual(s.availability({ start: d(1), end: d(4), kind: 'board' }), ['b1']);
+  const b = s.book({ itemId: 'b1', start: d(2), end: d(3) });
+  assert.equal(s.cancel(b.id, '2026-07-02T10:30:00Z').refund, 0);
+  assert.throws(() => s.cancel('nope', d(1)), /unknown booking/);
+  assert.throws(() => s.cancel(b.id, 'garbage'));
+});
