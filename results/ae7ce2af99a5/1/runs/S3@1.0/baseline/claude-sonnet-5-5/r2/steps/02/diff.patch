diff --git a/src/index.ts b/src/index.ts
index c199f11550f7e54ba7bc402ea55bc84232a1ac27..8d9610f4311a7fa74db5029baa8d868430485216 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -27,10 +27,21 @@ export interface Booking extends Quote {
   id: string;
 }
 
+export interface AvailabilityQuery {
+  /** ISO-8601, midnight UTC. */
+  start: string;
+  /** ISO-8601, midnight UTC; the start of the day after the last rental day. */
+  end: string;
+  /** Restrict to this kind of equipment; any kind when omitted. */
+  kind?: EquipmentKind;
+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  /** Ids of the equipment free for the whole period, sorted. */
+  availability(query: AvailabilityQuery): string[];
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
@@ -100,5 +111,20 @@ export function createRentalService(): RentalService {
       bookings.push({ ...booking, startMs, endMs });
       return { ...booking };
     },
+
+    availability(query) {
+      if (typeof query !== 'object' || query === null) throw new Error('query is required');
+      const startMs = parseMidnightUtc(query.start, 'start');
+      const endMs = parseMidnightUtc(query.end, 'end');
+      if (endMs <= startMs) throw new Error('end must be after start');
+      if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+        throw new Error("kind must be 'board' or 'sail'");
+      }
+      return [...equipment.values()]
+        .filter((item) => query.kind === undefined || item.kind === query.kind)
+        .filter((item) => !bookings.some((b) => b.itemId === item.id && b.startMs < endMs && startMs < b.endMs))
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
diff --git a/test/rental.test.ts b/test/rental.test.ts
index 3a199835d12197419bcfc4c42c2aaff02572f66f..5aaf545da347b4da8bd88cd02b2c084809b240bf 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -35,3 +35,15 @@ test('prevents overlapping bookings but allows adjacent ones', () => {
   s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
   s.book({ itemId: 's1', start: d(1), end: d(3) });
 });
+
+test('lists the equipment available for the whole period, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a-board', kind: 'board', dailyPrice: 2000 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  s.book({ itemId: 'b1', start: d(2), end: d(4) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(3) }), ['a-board', 's1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3), kind: 'board' }), ['a-board']);
+  assert.deepEqual(s.availability({ start: d(4), end: d(5), kind: 'board' }), ['a-board', 'b1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(2), kind: 'board' }), ['a-board', 'b1']);
+  assert.throws(() => s.availability({ start: d(3), end: d(3) }));
+});
