diff --git a/test/rental.test.ts b/test/rental.test.ts
index 3bb6613208365d59a8f67ae649fd8df4ad80a3ea..712270068a31c67eaf5b35ac3efe99bb088c5e2a 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -54,3 +54,22 @@ test('lists the equipment available for the whole period, sorted', () => {
   assert.deepEqual(s.availability({ start: d(1), end: d(2), kind: 'board' }), ['a-board', 'b1']);
   assert.throws(() => s.availability({ start: d(3), end: d(3) }));
 });
+
+test('rents by the hour at the hourly price, without long-rental discount', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  s.addEquipment({ id: 'd1', kind: 'board', dailyPrice: 2500 });
+  const h = (a: number, b: number) => ({
+    start: `2026-07-01T${String(a).padStart(2, '0')}:00:00Z`,
+    end: `2026-07-01T${String(b).padStart(2, '0')}:00:00Z`,
+  });
+  assert.equal(s.quote({ itemId: 'h1', ...h(9, 10) }).total, 600);
+  assert.equal(s.book({ itemId: 'h1', ...h(10, 15) }).total, 3000);
+  assert.throws(() => s.book({ itemId: 'h1', ...h(14, 16) }));
+  assert.throws(() => s.quote({ itemId: 'd1', ...h(9, 10) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-07-01T09:30:00Z', end: '2026-07-01T11:00:00Z' }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-07-01T09:00:00Z', end: '2026-07-02T09:00:00Z' }));
+  assert.throws(() => s.addEquipment({ id: 'z', kind: 'board', dailyPrice: 10, hourlyPrice: -1 }));
+  assert.deepEqual(s.availability({ ...h(8, 10) }), ['h1']);
+  assert.deepEqual(s.availability({ ...h(12, 13) }), []);
+});
