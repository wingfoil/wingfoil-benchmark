diff --git a/src/index.ts b/src/index.ts
index e6ed1588bf6a486b8e204a5ae7d584dd997d8538..5f98bd22a049d29172cd0bcdf2dcab80f557058b 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -78,6 +78,17 @@ function isObject(value: unknown): value is Record<string, unknown> {
   return typeof value === "object" && value !== null && !Array.isArray(value);
 }
 
+/** RFC 8259: whether `value` is made only of null, booleans, finite numbers, strings, arrays and plain objects. */
+function isJsonValue(value: unknown): value is JsonValue {
+  if (Array.isArray(value)) {
+    return Array.from(value).every(isJsonValue);
+  }
+  if (isObject(value)) {
+    return Object.values(value).every(isJsonValue);
+  }
+  return value === null || typeof value === "boolean" || typeof value === "string" || (typeof value === "number" && Number.isFinite(value));
+}
+
 /** RFC 6902 section 4: validate the shape of one operation object. */
 function validateOperation(operation: unknown, index: number): PatchOperation {
   if (!isObject(operation)) {
@@ -90,8 +101,8 @@ function validateOperation(operation: unknown, index: number): PatchOperation {
   if (typeof path !== "string") {
     throw new Error(`Invalid JSON Patch: operation ${index} ("${op}") needs a string "path"`);
   }
-  if (["add", "replace", "test"].includes(op) && !Object.hasOwn(operation, "value")) {
-    throw new Error(`Invalid JSON Patch: operation ${index} ("${op}") needs a "value"`);
+  if (["add", "replace", "test"].includes(op) && !isJsonValue(operation.value)) {
+    throw new Error(`Invalid JSON Patch: operation ${index} ("${op}") needs a JSON "value"`);
   }
   if ((op === "move" || op === "copy") && typeof operation.from !== "string") {
     throw new Error(`Invalid JSON Patch: operation ${index} ("${op}") needs a string "from"`);
@@ -211,6 +222,6 @@ export function applyPatch(document: JsonValue, patch: PatchOperation[]): JsonVa
   if (!Array.isArray(patch)) {
     throw new Error("Invalid JSON Patch: a patch must be an array of operations");
   }
-  const operations = patch.map(validateOperation);
+  const operations = Array.from(patch, validateOperation);
   return operations.reduce(applyOperation, copyOf(document));
 }
