@@ -260,3 +260,113 @@ function mergePatch(target: JsonValue, patch: JsonValue): JsonValue {
   }
   return result;
 }
+
+/** RFC 6901 section 3: escape a member name as a reference token (`~` first, then `/`). */
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/**
+ * Pairs of indices `[i, j]` with `from[i]` equal to `to[j]`, increasing in both: a longest common
+ * subsequence, so that whatever is not paired is the minimal set of removed and added items.
+ */
+function commonItems(from: JsonValue[], to: JsonValue[]): [number, number][] {
+  const lengths = Array.from({ length: from.length + 1 }, () => new Array<number>(to.length + 1).fill(0));
+  for (let i = from.length - 1; i >= 0; i--) {
+    for (let j = to.length - 1; j >= 0; j--) {
+      lengths[i][j] = jsonEqual(from[i], to[j]) ? lengths[i + 1][j + 1] + 1 : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  const pairs: [number, number][] = [];
+  for (let i = 0, j = 0; i < from.length && j < to.length; ) {
+    if (jsonEqual(from[i], to[j])) {
+      pairs.push([i, j]);
+      i++;
+      j++;
+    } else if (lengths[i + 1][j] >= lengths[i][j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
+
+/**
+ * Operations turning the array `from` into `to`, found at `path`. Items common to both are left
+ * alone; between them, items that differ are patched in place pairwise, and the surplus is removed
+ * or added. A moved item thus becomes a removal and an addition, never a rewrite of what lies between.
+ */
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string): PatchOperation[] {
+  const operations: PatchOperation[] = [];
+  let position = 0;
+  let fromAt = 0;
+  let toAt = 0;
+  for (const [fromNext, toNext] of [...commonItems(from, to), [from.length, to.length]]) {
+    const removed = fromNext - fromAt;
+    const added = toNext - toAt;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) {
+      operations.push(...diffValues(from[fromAt + k], to[toAt + k], `${path}/${position + k}`));
+    }
+    for (let k = paired; k < removed; k++) {
+      operations.push({ op: "remove", path: `${path}/${position + paired}` });
+    }
+    for (let k = paired; k < added; k++) {
+      operations.push({ op: "add", path: `${path}/${position + k}`, value: copyOf(to[toAt + k]) });
+    }
+    position += added + 1;
+    fromAt = fromNext + 1;
+    toAt = toNext + 1;
+  }
+  return operations;
+}
+
+/** Operations turning the object `from` into `to`: removed members, then changed and added ones. */
+function diffObjects(from: { [key: string]: JsonValue }, to: { [key: string]: JsonValue }, path: string): PatchOperation[] {
+  const operations: PatchOperation[] = [];
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      operations.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const memberPath = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) {
+      operations.push(...diffValues(from[key], to[key], memberPath));
+    } else {
+      operations.push({ op: "add", path: memberPath, value: copyOf(to[key]) });
+    }
+  }
+  return operations;
+}
+
+/** Operations turning `from` into `to` at `path`, descending into containers of the same kind. */
+function diffValues(from: JsonValue, to: JsonValue, path: string): PatchOperation[] {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    return diffArrays(from, to, path);
+  }
+  if (isObject(from) && isObject(to)) {
+    return diffObjects(from as { [key: string]: JsonValue }, to as { [key: string]: JsonValue }, path);
+  }
+  return jsonEqual(from, to) ? [] : [{ op: "replace", path, value: copyOf(to) }];
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when passed to {@link applyPatch}.
+ *
+ * The patch holds only what changed: members and array items are added, removed or replaced where
+ * they differ, and containers are compared recursively. An item inserted into or deleted from an
+ * array is one `add` or `remove`; an item moved within an array is a `remove` and an `add`.
+ * Documents are compared as in `test` (section 4.6): numbers by value, members regardless of order.
+ *
+ * Neither argument is mutated, and the patch shares no structure with them.
+ *
+ * @throws Error if `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new Error("Invalid JSON Patch creation: from and to must be JSON values");
+  }
+  return diffValues(from, to, "");
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d96fe6e00e8f1264f87566b4992ef0db35a92c36
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,97 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const create = (from: unknown, to: unknown) => createPatch(from as never, to as never);
+
+/** Checks the round trip and that neither input is mutated; returns the patch. */
+function check(from: unknown, to: unknown) {
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = create(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  assert.deepEqual(applyPatch(from as never, patch), to);
+  return patch;
+}
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(check({ a: [1, { b: 2 }], c: "x" }, { c: "x", a: [1, { b: 2 }] }), []);
+});
+
+test("a changed member is replaced in place", () => {
+  assert.deepEqual(check({ a: 1, b: { c: 2, d: 3 } }, { a: 1, b: { c: 2, d: 4 } }), [{ op: "replace", path: "/b/d", value: 4 }]);
+});
+
+test("added and removed members", () => {
+  assert.deepEqual(check({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("member names are escaped (RFC 6901 section 3)", () => {
+  assert.deepEqual(check({ "a/b": 1, "~": 1 }, { "a/b": 2, "~": 1 }), [{ op: "replace", path: "/a~1b", value: 2 }]);
+});
+
+test("a __proto__ key is plain data", () => {
+  const from = JSON.parse('{"__proto__": {"x": 1}}');
+  const to = JSON.parse('{"__proto__": {"x": 2}}');
+  assert.deepEqual(check(from, to), [{ op: "replace", path: "/__proto__/x", value: 2 }]);
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+});
+
+test("root changes: scalar, type change, null", () => {
+  assert.deepEqual(check(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepEqual(check({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(check(null, { a: 1 }), [{ op: "replace", path: "", value: { a: 1 } }]);
+  assert.deepEqual(check({ a: null }, { a: false }), [{ op: "replace", path: "/a", value: false }]);
+});
+
+test("an item added to an array is a single add", () => {
+  assert.deepEqual(check([1, 2, 4, 5], [1, 2, 3, 4, 5]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(check({ l: [1] }, { l: [1, 2] }), [{ op: "add", path: "/l/1", value: 2 }]);
+});
+
+test("an item removed from an array is a single remove", () => {
+  assert.deepEqual(check([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(check([{ a: 1 }, { b: 2 }], [{ b: 2 }]), [{ op: "remove", path: "/0" }]);
+});
+
+test("an item changed inside an array is patched in place", () => {
+  assert.deepEqual(check([{ id: 1, v: 1 }, { id: 2, v: 2 }], [{ id: 1, v: 1 }, { id: 2, v: 3 }]), [{ op: "replace", path: "/1/v", value: 3 }]);
+});
+
+test("a moved item does not rewrite the items in between", () => {
+  const patch = check([1, 2, 3, 4, 5], [1, 3, 4, 5, 2]);
+  assert.ok(patch.length <= 2);
+  assert.ok(patch.every((operation) => operation.op !== "replace"));
+  const back = check(["a", "b", "c", "d", "e"], ["e", "a", "b", "c", "d"]);
+  assert.ok(back.length <= 2);
+});
+
+test("several insertions and removals at once", () => {
+  check([1, 2, 3, 4, 5, 6], [0, 2, 3, 9, 9, 6, 7]);
+  check([], [1, 2]);
+  check([1, 2], []);
+  check([[1, 2], [3]], [[1, 2, 3], [3]]);
+  check([1, 1, 1], [1, 1]);
+});
+
+test("duplicate items are handled", () => {
+  const patch = check(["a", "a", "b"], ["a", "b"]);
+  assert.equal(patch.length, 1);
+  assert.equal(patch[0].op, "remove");
+});
+
+test("the patch shares no structure with the inputs", () => {
+  const to = { a: { b: [1] } };
+  const patch = create({}, to);
+  (patch[0].value as { b: number[] }).b.push(2);
+  assert.deepEqual(to, { a: { b: [1] } });
+});
+
+test("rejects values that are not JSON", () => {
+  assert.throws(() => create(undefined, 1));
+  assert.throws(() => create({ a: 1 }, { a: Number.NaN }));
+});
