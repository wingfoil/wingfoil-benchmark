@@ -180,43 +180,49 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   if (!Array.isArray(patch)) throw new Error("A JSON Patch must be an array of operations");
   let root = clone(document);
 
-  patch.forEach((operation: unknown, i: number) => {
+  for (let i = 0; i < patch.length; i++) {
     try {
+      // RFC 6902 section 3: a patch is an array of operation objects; a hole is not one.
+      const operation: unknown = i in patch ? patch[i] : undefined;
       if (typeof operation !== "object" || operation === null || Array.isArray(operation)) {
         throw new Error("operation is not an object");
       }
       const op = operation as Record<string, unknown>;
-      const name = op.op;
-      const path = parsePointer(op.path);
+      // Only own members count (RFC 6902 section 4); inherited ones are not part of the document.
+      const member = (key: string): unknown => (hasOwn(op, key) ? op[key] : undefined);
+      const name = member("op");
+      const path = parsePointer(member("path"));
       const needValue = name === "add" || name === "replace" || name === "test";
       if (needValue && !hasOwn(op, "value")) throw new Error(`"${name}" requires a "value" member`);
+      // A "value" is a JSON value (section 4); reject anything else, also for "test".
+      const value = needValue ? clone(op.value) : undefined;
 
       switch (name) {
         case "add":
-          root = addAt(root, path, clone(op.value));
+          root = addAt(root, path, clone(value));
           break;
         case "remove":
           root = removeAt(root, path);
           break;
         case "replace":
           getAt(root, path);
-          root = path.length === 0 ? clone(op.value) : addAt(removeAt(root, path), path, clone(op.value));
+          root = path.length === 0 ? clone(value) : addAt(removeAt(root, path), path, clone(value));
           break;
         case "move":
         case "copy": {
-          const from = parsePointer(op.from);
-          const value = getAt(root, from);
+          const from = parsePointer(member("from"));
+          const moved = getAt(root, from);
           if (name === "copy") {
-            root = addAt(root, path, clone(value));
+            root = addAt(root, path, clone(moved));
           } else if (from.length < path.length && from.every((t, k) => t === path[k])) {
             throw new Error('"from" must not be a proper prefix of "path"');
           } else if (from.length !== path.length || !from.every((t, k) => t === path[k])) {
-            root = addAt(removeAt(root, from), path, value);
+            root = addAt(removeAt(root, from), path, moved);
           }
           break;
         }
         case "test":
-          if (!jsonEqual(getAt(root, path), op.value)) throw new Error("test failed: values differ");
+          if (!jsonEqual(getAt(root, path), value)) throw new Error("test failed: values differ");
           break;
         default:
           throw new Error(`unknown operation ${JSON.stringify(name)}`);
@@ -224,6 +230,6 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
     } catch (e) {
       throw new Error(`Patch operation ${i} failed: ${(e as Error).message}`);
     }
-  });
+  }
   return root;
 }
