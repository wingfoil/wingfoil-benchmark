index eeb1d49ed638666593f7fc7bd698ac0d352e4726..b652c77d3a7a7916238c99ff6f34041e39e651b7 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -253,3 +253,84 @@ export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
   }
   return result as JsonValue;
 }
+
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, out: PatchOperation[]): void {
+  // Items shared at both ends need no work; the longest common subsequence is only computed in between.
+  let start = 0;
+  while (start < from.length && start < to.length && deepEqual(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && deepEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const a = from.slice(start, endFrom);
+  const b = to.slice(start, endTo);
+
+  const lcs: number[][] = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lcs[i][j] = deepEqual(a[i], b[j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  // `index` is the position in the array as it stands after the operations emitted so far.
+  let index = start;
+  let i = 0;
+  let j = 0;
+  while (i < a.length || j < b.length) {
+    if (i < a.length && j < b.length && deepEqual(a[i], b[j])) {
+      i++;
+      j++;
+      index++;
+      continue;
+    }
+    // Collect the run of differing items up to the next common item.
+    const removed: JsonValue[] = [];
+    const added: JsonValue[] = [];
+    while ((i < a.length || j < b.length) && !(i < a.length && j < b.length && deepEqual(a[i], b[j]))) {
+      if (j >= b.length || (i < a.length && lcs[i + 1][j] >= lcs[i][j + 1])) removed.push(a[i++]);
+      else added.push(b[j++]);
+    }
+    const paired = Math.min(removed.length, added.length);
+    for (let k = 0; k < paired; k++) diffValues(removed[k], added[k], `${path}/${index + k}`, out);
+    index += paired;
+    for (let k = paired; k < removed.length; k++) out.push({ op: "remove", path: `${path}/${index}` });
+    for (let k = paired; k < added.length; k++) {
+      out.push({ op: "add", path: `${path}/${index}`, value: clone(added[k]) });
+      index++;
+    }
+  }
+}
+
+function diffValues(from: JsonValue, to: JsonValue, path: string, out: PatchOperation[]): void {
+  if (deepEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isPlainObject(from) && isPlainObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!hasOwn(to, key)) out.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${encodeToken(key)}`;
+      if (!hasOwn(from, key)) out.push({ op: "add", path: child, value: clone(to[key] as JsonValue) });
+      else diffValues(from[key] as JsonValue, to[key] as JsonValue, child, out);
+    }
+  } else {
+    out.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only what changed.
+ * The inputs are not mutated.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diffValues(from as JsonValue, to as JsonValue, "", out);
+  return out;
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bb1f71d5ccb1c694c234466d6229437241a28e0a
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,26 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const cases: [unknown, unknown, number?][] = [
+  [{ a: 1 }, { a: 1 }, 0],
+  [{ a: 1, b: { c: [1, 2] } }, { a: 1, b: { c: [1, 3] } }, 1],
+  [[1, 2, 3, 4], [1, 2, 9, 3, 4], 1],
+  [[1, 2, 3, 4], [1, 4], 2],
+  [[1, 2, 3, 4, 5], [1, 3, 4, 5, 2], 2],
+  [[{ x: 1 }, { x: 2 }], [{ x: 1 }, { x: 3 }], 1],
+  [{ "a/b": 1, "~": 2 }, { "a/b": 2 }, 2],
+  [1, { a: 1 }, 1],
+  [{ a: [] }, { a: {} }, 1],
+  [[3, 1, 2], [1, 2, 3], 2],
+];
+
+for (const [from, to, max] of cases) {
+  test(`createPatch ${JSON.stringify(from)} -> ${JSON.stringify(to)}`, () => {
+    const f = JSON.stringify(from);
+    const patch = createPatch(from, to);
+    assert.equal(JSON.stringify(from), f);
+    assert.deepEqual(applyPatch(from, patch), to);
+    if (max !== undefined) assert.ok(patch.length <= max, JSON.stringify(patch));
+  });
+}
