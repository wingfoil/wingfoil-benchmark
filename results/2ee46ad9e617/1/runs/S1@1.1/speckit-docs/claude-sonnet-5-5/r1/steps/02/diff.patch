--- a/src/index.ts
+++ b/src/index.ts
@@ -55,3 +55,173 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; path: string; from: string };
+
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  return pointer.slice(1).split("/").map(decodeToken);
+}
+
+function isContainer(value: unknown): value is object {
+  return typeof value === "object" && value !== null;
+}
+
+function hasOwn(object: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(object, key);
+}
+
+function setMember(object: object, key: string, value: unknown): void {
+  // defineProperty so that a "__proto__" member is an ordinary own property.
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone<T>(value: T): T {
+  if (Array.isArray(value)) return value.map(clone) as T;
+  if (isContainer(value)) {
+    const copy = {};
+    for (const key of Object.keys(value)) setMember(copy, key, clone((value as Record<string, unknown>)[key]));
+    return copy as T;
+  }
+  return value;
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) &&
+      Array.isArray(b) &&
+      a.length === b.length &&
+      a.every((item, i) => deepEqual(item, b[i]))
+    );
+  }
+  if (isContainer(a) && isContainer(b)) {
+    const keysA = Object.keys(a);
+    return (
+      keysA.length === Object.keys(b).length &&
+      keysA.every(
+        (key) =>
+          hasOwn(b, key) &&
+          deepEqual((a as Record<string, unknown>)[key], (b as Record<string, unknown>)[key]),
+      )
+    );
+  }
+  return a === b;
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (allowEnd && token === "-") return length;
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) throw new Error(`Invalid array index "${token}"`);
+  const index = Number(token);
+  if (index > length || (index === length && !allowEnd)) {
+    throw new Error(`Array index ${token} out of range`);
+  }
+  return index;
+}
+
+function getParent(root: unknown, tokens: string[]): unknown {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      current = current[arrayIndex(token, current.length, false)];
+    } else if (isContainer(current) && hasOwn(current, token)) {
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`Path does not exist at "${token}"`);
+    }
+  }
+  return current;
+}
+
+function addAt(root: JsonValue, tokens: string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) return value;
+  const parent = getParent(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(last, parent.length, true), 0, value);
+  } else if (isContainer(parent)) {
+    setMember(parent, last, value);
+  } else {
+    throw new Error(`Cannot add "${last}" to a non-container value`);
+  }
+  return root;
+}
+
+function removeAt(root: JsonValue, tokens: string[]): JsonValue {
+  if (tokens.length === 0) throw new Error("Cannot remove the document root");
+  const parent = getParent(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(last, parent.length, false), 1);
+  } else if (isContainer(parent) && hasOwn(parent, last)) {
+    delete (parent as Record<string, unknown>)[last];
+  } else {
+    throw new Error(`Member "${last}" not found`);
+  }
+  return root;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result as a new value.
+ * The inputs are not mutated. Throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): JsonValue {
+  if (!Array.isArray(patch)) throw new Error("Invalid JSON Patch: must be an array");
+
+  let result = clone(document) as JsonValue;
+  for (const operation of patch) {
+    if (!isContainer(operation) || Array.isArray(operation)) {
+      throw new Error("Invalid JSON Patch: each operation must be an object");
+    }
+    const { op, path, from, value } = operation as Record<string, unknown>;
+    const hasValue = hasOwn(operation, "value");
+    const target = parsePointer(path);
+
+    switch (op) {
+      case "add":
+        if (!hasValue) throw new Error('Invalid JSON Patch: "add" requires "value"');
+        result = addAt(result, target, clone(value) as JsonValue);
+        break;
+      case "remove":
+        result = removeAt(result, target);
+        break;
+      case "replace": {
+        if (!hasValue) throw new Error('Invalid JSON Patch: "replace" requires "value"');
+        resolvePointer(result, path as string);
+        result = addAt(target.length ? removeAt(result, target) : result, target, clone(value) as JsonValue);
+        break;
+      }
+      case "test":
+        if (!hasValue) throw new Error('Invalid JSON Patch: "test" requires "value"');
+        if (!deepEqual(resolvePointer(result, path as string), value)) {
+          throw new Error(`Test failed at "${path}"`);
+        }
+        break;
+      case "move":
+      case "copy": {
+        const source = parsePointer(from);
+        const found = clone(resolvePointer(result, from as string)) as JsonValue;
+        if (op === "move") {
+          if (source.length < target.length && source.every((t, i) => t === target[i])) {
+            throw new Error('Cannot move a value into one of its own children');
+          }
+          result = removeAt(result, source);
+        }
+        result = addAt(result, target, found);
+        break;
+      }
+      default:
+        throw new Error(`Invalid JSON Patch: unknown operation "${String(op)}"`);
+    }
+  }
+  return result;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..40ccd744a11062a94de9810c54a2ddb8e4c8efb1
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,72 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) =>
+  assert.deepEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch));
+
+test("RFC 6902 appendix A", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  ok({ foo: { bar: "baz" }, qux: {} }, [{ op: "copy", from: "/foo/bar", path: "/qux/x" }], {
+    foo: { bar: "baz" },
+    qux: { x: "baz" },
+  });
+  ok({ baz: "qux" }, [{ op: "test", path: "/baz", value: "qux" }], { baz: "qux" });
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+});
+
+test("root, errors and validation", () => {
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: 2 }], 2);
+  ok({ a: { b: 1 } }, [{ op: "test", path: "/a", value: { b: 1 } }], { a: { b: 1 } });
+  bad({}, [{ op: "remove", path: "/x" }]);
+  bad({}, [{ op: "replace", path: "/x", value: 1 }]);
+  bad([1], [{ op: "add", path: "/2", value: 1 }]);
+  bad([1], [{ op: "add", path: "/01", value: 1 }]);
+  bad([1], [{ op: "remove", path: "/1" }]);
+  bad({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "bogus", path: "/a" }]);
+  bad({}, [{ op: "move", path: "/a" }]);
+  bad({}, { op: "add" });
+  bad({}, [null]);
+  bad({}, [{ op: "add", path: "a", value: 1 }]);
+});
+
+test("does not mutate inputs and result is independent", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const value = { x: 1 };
+  const patch = [
+    { op: "add", path: "/d", value },
+    { op: "copy", from: "/b", path: "/e" },
+    { op: "remove", path: "/a/0" },
+  ];
+  const snapshot = structuredClone({ doc, patch });
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual({ doc, patch }, snapshot);
+  out.d.x = 2;
+  out.e.c = 9;
+  assert.equal(value.x, 1);
+  assert.equal(doc.b.c, 1);
+});
+
+test("__proto__ members are plain members", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: 1 }]) as any;
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(Object.keys(out)[0], "__proto__");
+});
