index 0000000000000000000000000000000000000000..5e8587776f0573e859724ed92219c76dfe79c1c1
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,57 @@
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+function decodeToken(token: string): string {
+  return token.replace(/~(.?)/g, (_, next: string) => {
+    if (next === "0") return "~";
+    if (next === "1") return "/";
+    throw new Error(`Invalid JSON Pointer: bad escape sequence in "${token}"`);
+  });
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ * Throws if the pointer is syntactically invalid or does not resolve to a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: must be a string");
+  }
+  if (pointer === "") return document;
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+
+  // Validate the whole pointer before resolving anything.
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+
+  let current: unknown = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (token === "-") {
+        throw new Error('Pointer refers to the nonexistent element after the end of the array ("-")');
+      }
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`Invalid array index "${token}"`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new Error(`Array index ${token} out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(`Member "${token}" not found`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`Cannot resolve "${token}" in a non-container value`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2f43fc6849af8209d994fc80ff97a26319b08d56
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,61 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+const doc = JSON.parse(`{
+  "foo": ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\\\j": 5,
+  "k\\"l": 6,
+  " ": 7,
+  "m~n": 8,
+  "n": null,
+  "__proto__": 9
+}`);
+
+test("RFC 6901 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+  assert.equal(resolvePointer(doc, "/n"), null);
+});
+
+test("escape order: ~01 is ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["foo", "/~", "/~2", "/a~"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), p);
+  }
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer(doc, "/nope"));
+  assert.throws(() => resolvePointer(doc, "/foo/2"));
+  assert.throws(() => resolvePointer(doc, "/foo/-"));
+  assert.throws(() => resolvePointer(doc, "/foo/01"));
+  assert.throws(() => resolvePointer(doc, "/foo/+1"));
+  assert.throws(() => resolvePointer(doc, "/foo/length"));
+  assert.throws(() => resolvePointer(doc, "/foo/0/x"));
+  assert.throws(() => resolvePointer(doc, "/n/x"));
+  assert.throws(() => resolvePointer({}, "/toString"));
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+});
+
+test("own __proto__ member resolves", () => {
+  assert.equal(resolvePointer(doc, "/__proto__"), 9);
+});
