new file mode 100644
index 0000000000000000000000000000000000000000..17c72b4f78fceab2a528533f7a3acda9567510a1
--- /dev/null
+++ b/src/merge-patch.ts
@@ -0,0 +1,17 @@
+import { clone, isObject, setOwn } from "./patch.ts";
+
+/** Applies an RFC 7386 JSON Merge Patch and returns the result as a new value, without mutating the inputs. */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch);
+  const result: Record<string, unknown> = {};
+  const source = isObject(target) ? target : {};
+  for (const key of Object.keys(source)) {
+    if (!Object.hasOwn(patch, key)) setOwn(result, key, clone(source[key]));
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) continue;
+    setOwn(result, key, applyMergePatch(Object.hasOwn(source, key) ? source[key] : undefined, value));
+  }
+  return result;
+}
