@@ -0,0 +1,45 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "./index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+    ["x", { a: 1 }, { a: 1 }],
+    [{ a: "foo" }, { a: { b: { c: null } } }, { a: { b: {} } }],
+  ];
+  for (const [t, p, e] of cases) assert.deepEqual(applyMergePatch(t, p), e);
+});
+
+test("does not mutate or share", () => {
+  const target = { a: { b: 1 }, k: { z: 1 } };
+  const patch = { a: { b: null }, n: { o: [1] } };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 }, k: { z: 1 } });
+  assert.deepEqual(patch, { a: { b: null }, n: { o: [1] } });
+  result.n.o.push(2);
+  result.k.z = 2;
+  assert.deepEqual(patch.n.o, [1]);
+  assert.equal(target.k.z, 1);
+});
+
+test("__proto__ is plain data", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as any;
+  assert.deepEqual(Object.getOwnPropertyDescriptor(result, "__proto__")?.value, { x: 1 });
+  assert.equal(({} as any).x, undefined);
+  assert.equal(result.x, undefined);
+});
