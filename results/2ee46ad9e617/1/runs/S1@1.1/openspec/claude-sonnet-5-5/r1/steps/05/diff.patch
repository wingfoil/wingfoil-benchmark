@@ -0,0 +1,85 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "./index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const f = structuredClone(from);
+  const t = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, f);
+  assert.deepEqual(to, t);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+};
+
+test("round trip and identical documents", () => {
+  roundTrip({ a: 1, b: [1, 2] }, { a: 2, b: [1, 2, 3], c: null });
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+  roundTrip(1, "x");
+  roundTrip(null, {});
+  roundTrip([], [{}]);
+});
+
+test("patch shares nothing with inputs", () => {
+  const to = { x: { y: [1] } };
+  const patch = createPatch({}, to) as { value: any }[];
+  patch[0].value.y.push(2);
+  assert.deepEqual(to, { x: { y: [1] } });
+});
+
+test("escaped names and __proto__", () => {
+  assert.deepEqual(createPatch({ "a/b~c": 1 }, { "a/b~c": 2 }), [{ op: "replace", path: "/a~1b~0c", value: 2 }]);
+  const to = JSON.parse('{"__proto__":{"x":1}}');
+  roundTrip({}, to);
+  roundTrip(to, {});
+});
+
+test("minimal object changes", () => {
+  assert.deepEqual(
+    createPatch({ user: { address: { city: "A", zip: 1 }, n: 1 } }, { user: { address: { city: "B", zip: 1 }, n: 1 } }),
+    [{ op: "replace", path: "/user/address/city", value: "B" }],
+  );
+  assert.deepEqual(createPatch({ y: 1 }, { x: 1 }), [
+    { op: "remove", path: "/y" },
+    { op: "add", path: "/x", value: 1 },
+  ]);
+  assert.deepEqual(createPatch({ a: {} }, { a: [] }), [{ op: "replace", path: "/a", value: [] }]);
+});
+
+test("array insert, remove, move", () => {
+  assert.deepEqual(createPatch([1, 2, 4, 5], [1, 2, 3, 4, 5]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(createPatch([1, 2, 3], [2, 3]), [{ op: "remove", path: "/0" }]);
+  const moved = roundTrip(["a", "b", "c", "d"], ["b", "c", "d", "a"]);
+  assert.ok(moved.every((o) => o.op !== "replace"));
+  assert.equal(moved.length, 2);
+  assert.deepEqual(createPatch([{ a: 1, b: 1 }, 2], [{ a: 1, b: 2 }, 2]), [{ op: "replace", path: "/0/b", value: 2 }]);
+});
+
+test("randomized round trip", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff), seed % n);
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 4 : 7);
+    if (k === 0) return rnd(3);
+    if (k === 1) return ["a", "b", null][rnd(3)];
+    if (k === 2) return rnd(2) === 0;
+    if (k === 3) return 1.5;
+    if (k <= 5) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let i = 0; i < 2000; i++) {
+    const from = gen(0);
+    const to = rnd(2) ? gen(0) : mutate(from);
+    roundTrip(from, to);
+  }
+  function mutate(v: unknown): unknown {
+    if (Array.isArray(v)) {
+      const c = v.map(mutate);
+      if (rnd(2)) c.splice(rnd(c.length + 1), rnd(2), gen(2));
+      if (rnd(3) === 0 && c.length > 1) c.push(c.shift());
+      return c;
+    }
+    if (v && typeof v === "object") return Object.fromEntries(Object.entries(v).map(([k, x]) => [k, mutate(x)]));
+    return v;
+  }
+});
