index 0000000000000000000000000000000000000000..db6a4d430556c261ef31cbbb94b1e15568b922a7
--- /dev/null
+++ b/src/diff.ts
@@ -0,0 +1,99 @@
+import { clone, equal, isObject } from "./patch.ts";
+
+type Json = unknown;
+type Operation =
+  | { op: "add" | "replace"; path: string; value: Json }
+  | { op: "remove"; path: string };
+
+const escape = (token: string) => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+/**
+ * Returns an RFC 6902 JSON Patch that turns `from` into `to`, describing only
+ * the parts that differ. Neither input is modified and the patch shares no
+ * object or array with them.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const ops: Operation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
+
+function diff(a: Json, b: Json, path: string, ops: Operation[]): void {
+  if (Array.isArray(a) && Array.isArray(b)) {
+    diffArrays(a, b, path, ops);
+  } else if (isObject(a) && isObject(b)) {
+    diffObjects(a, b, path, ops);
+  } else if (!equal(a, b)) {
+    ops.push({ op: "replace", path, value: clone(b) });
+  }
+}
+
+function diffObjects(a: Record<string, Json>, b: Record<string, Json>, path: string, ops: Operation[]): void {
+  for (const key of Object.keys(a)) {
+    if (!Object.hasOwn(b, key)) ops.push({ op: "remove", path: `${path}/${escape(key)}` });
+  }
+  for (const key of Object.keys(b)) {
+    if (Object.hasOwn(a, key)) diff(a[key], b[key], `${path}/${escape(key)}`, ops);
+  }
+  for (const key of Object.keys(b)) {
+    if (!Object.hasOwn(a, key)) ops.push({ op: "add", path: `${path}/${escape(key)}`, value: clone(b[key]) });
+  }
+}
+
+function diffArrays(a: Json[], b: Json[], path: string, ops: Operation[]): void {
+  let start = 0;
+  while (start < a.length && start < b.length && equal(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && equal(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const n = endA - start;
+  const m = endB - start;
+
+  // lcs[i][j]: length of the longest common subsequence of a[start+i..endA) and b[start+j..endB)
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = equal(a[start + i], b[start + j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  // idx is the position in the array as edited so far; operations are emitted in application order.
+  let idx = start;
+  let i = 0;
+  let j = 0;
+  const flushGap = (removed: number, inserted: number) => {
+    const paired = Math.min(removed, inserted);
+    for (let k = 0; k < paired; k++) {
+      diff(a[start + i - removed + k], b[start + j - inserted + k], `${path}/${idx + k}`, ops);
+    }
+    for (let k = paired; k < removed; k++) ops.push({ op: "remove", path: `${path}/${idx + paired}` });
+    for (let k = paired; k < inserted; k++) {
+      ops.push({ op: "add", path: `${path}/${idx + k}`, value: clone(b[start + j - inserted + k]) });
+    }
+    idx += inserted;
+  };
+
+  while (i < n || j < m) {
+    let removed = 0;
+    let inserted = 0;
+    while (i < n || j < m) {
+      if (i < n && j < m && equal(a[start + i], b[start + j]) && lcs[i][j] === lcs[i + 1][j + 1] + 1) break;
+      if (i < n && (j >= m || lcs[i + 1][j] >= lcs[i][j + 1])) {
+        i++;
+        removed++;
+      } else {
+        j++;
+        inserted++;
+      }
+    }
+    flushGap(removed, inserted);
+    if (i < n && j < m) {
+      i++;
+      j++;
+      idx++;
+    }
+  }
+}
