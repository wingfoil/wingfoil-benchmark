+
+test("remove and replace details", () => {
+  assert.equal(applyPatch({ a: 1 }, [{ op: "remove", path: "" }]), null);
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+  bad({ a: [1] }, [{ op: "remove", path: "/a/-" }]);
+  bad({ a: [1] }, [{ op: "replace", path: "/a/-", value: 1 }]);
+  bad({ a: [1] }, [{ op: "remove", path: "/a/1" }]);
+  bad({ a: 1 }, [{ op: "replace", path: "/b", value: 1 }]);
