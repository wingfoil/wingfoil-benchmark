+
+test("test equality", () => {
+  const doc = { a: { x: 1, y: [1, { z: null }] } };
+  ok(doc, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }], doc);
+  ok(doc, [{ op: "test", path: "", value: doc }], doc);
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+  bad({ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]);
+  bad({ a: [1] }, [{ op: "test", path: "/a", value: [1, 2] }]);
+  bad({ a: { x: 1 } }, [{ op: "test", path: "/a", value: { x: 1, y: 1 } }]);
+  bad({ a: { x: 1, y: 1 } }, [{ op: "test", path: "/a", value: { x: 1 } }]);
+  bad({ a: {} }, [{ op: "test", path: "/a", value: [] }]);
+  bad({ a: null }, [{ op: "test", path: "/a", value: {} }]);
+  bad({ a: 1 }, [{ op: "test", path: "/b", value: null }]);
