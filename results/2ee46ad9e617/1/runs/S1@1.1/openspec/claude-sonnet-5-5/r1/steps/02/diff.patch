index 0000000000000000000000000000000000000000..4908a76a65654ee6ac9085cf17c5ee9d6e493941
--- /dev/null
+++ b/src/patch.ts
@@ -0,0 +1,181 @@
+import { parsePointer } from "./pointer.ts";
+
+export class InvalidPatchError extends Error {
+  override name = "InvalidPatchError";
+}
+
+export class PatchFailedError extends Error {
+  override name = "PatchFailedError";
+}
+
+type Json = unknown;
+type Container = Json[] | Record<string, Json>;
+
+type Operation =
+  | { op: "add" | "replace" | "test"; path: string[]; value: Json }
+  | { op: "remove"; path: string[] }
+  | { op: "move" | "copy"; path: string[]; from: string[] };
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function isObject(value: unknown): value is Record<string, Json> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setOwn(target: Record<string, Json>, key: string, value: Json): void {
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone(value: Json): Json {
+  if (Array.isArray(value)) return value.map(clone);
+  if (isObject(value)) {
+    const copy: Record<string, Json> = {};
+    for (const key of Object.keys(value)) setOwn(copy, key, clone(value[key]));
+    return copy;
+  }
+  return value;
+}
+
+function equal(a: Json, b: Json): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => equal(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((k) => Object.hasOwn(b, k) && equal(a[k], b[k]));
+  }
+  return a === b;
+}
+
+function parseOperation(raw: unknown, index: number): Operation {
+  if (!isObject(raw)) throw new InvalidPatchError(`Operation ${index} must be an object`);
+  const { op } = raw;
+  const path = parsePointer(raw.path);
+  switch (op) {
+    case "add":
+    case "replace":
+    case "test":
+      if (!Object.hasOwn(raw, "value")) throw new InvalidPatchError(`Operation ${index} (${op}) requires "value"`);
+      return { op, path, value: raw.value };
+    case "remove":
+      return { op, path };
+    case "move":
+    case "copy":
+      if (!Object.hasOwn(raw, "from")) throw new InvalidPatchError(`Operation ${index} (${op}) requires "from"`);
+      return { op, path, from: parsePointer(raw.from) };
+    default:
+      throw new InvalidPatchError(`Operation ${index} has an unknown "op": ${JSON.stringify(op)}`);
+  }
+}
+
+/** Index of an existing array element named by token; throws when there is none. */
+function elementIndex(array: Json[], token: string): number {
+  if (!ARRAY_INDEX.test(token) || Number(token) >= array.length) {
+    throw new PatchFailedError(`No array element ${JSON.stringify(token)}`);
+  }
+  return Number(token);
+}
+
+function child(container: Json, token: string): Json {
+  if (Array.isArray(container)) return container[elementIndex(container, token)];
+  if (isObject(container)) {
+    if (!Object.hasOwn(container, token)) throw new PatchFailedError(`No member ${JSON.stringify(token)}`);
+    return container[token];
+  }
+  throw new PatchFailedError(`Cannot apply ${JSON.stringify(token)} to a scalar`);
+}
+
+function get(doc: Json, tokens: string[]): Json {
+  return tokens.reduce(child, doc);
+}
+
+function parentOf(doc: Json, tokens: string[]): Container {
+  const parent = get(doc, tokens.slice(0, -1));
+  if (typeof parent !== "object" || parent === null) throw new PatchFailedError("Parent is not a container");
+  return parent as Container;
+}
+
+function add(doc: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(doc, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (token === "-") {
+      parent.push(value);
+    } else {
+      if (!ARRAY_INDEX.test(token) || Number(token) > parent.length) {
+        throw new PatchFailedError(`Invalid array index ${JSON.stringify(token)}`);
+      }
+      parent.splice(Number(token), 0, value);
+    }
+  } else {
+    setOwn(parent, token, value);
+  }
+  return doc;
+}
+
+function remove(doc: Json, tokens: string[]): Json {
+  if (tokens.length === 0) return null;
+  const parent = parentOf(doc, tokens);
+  const token = tokens[tokens.length - 1];
+  child(parent, token);
+  if (Array.isArray(parent)) parent.splice(Number(token), 1);
+  else delete parent[token];
+  return doc;
+}
+
+function replace(doc: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(doc, tokens);
+  const token = tokens[tokens.length - 1];
+  child(parent, token);
+  if (Array.isArray(parent)) parent[Number(token)] = value;
+  else setOwn(parent, token, value);
+  return doc;
+}
+
+function isProperPrefix(prefix: string[], tokens: string[]): boolean {
+  return prefix.length < tokens.length && prefix.every((t, i) => t === tokens[i]);
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result as a
+ * new value; neither the document nor the patch is mutated. Throws
+ * InvalidPatchError (or InvalidPointerError) for a malformed patch and
+ * PatchFailedError when an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new InvalidPatchError("A JSON Patch must be an array");
+  const operations = patch.map(parseOperation);
+  let doc = clone(document);
+  for (const operation of operations) {
+    switch (operation.op) {
+      case "add":
+        doc = add(doc, operation.path, clone(operation.value));
+        break;
+      case "replace":
+        doc = replace(doc, operation.path, clone(operation.value));
+        break;
+      case "remove":
+        doc = remove(doc, operation.path);
+        break;
+      case "copy":
+        doc = add(doc, operation.path, clone(get(doc, operation.from)));
+        break;
+      case "move": {
+        const value = get(doc, operation.from);
+        if (isProperPrefix(operation.from, operation.path)) {
+          throw new PatchFailedError("Cannot move a location into one of its children");
+        }
+        if (operation.from.length === operation.path.length && isProperPrefix(operation.from.slice(0, -1), operation.path) && operation.from.at(-1) === operation.path.at(-1)) break;
+        doc = add(remove(doc, operation.from), operation.path, value);
+        break;
+      }
+      case "test":
+        if (!equal(get(doc, operation.path), operation.value)) throw new PatchFailedError("Test failed");
+        break;
+    }
+  }
+  return doc;
+}
