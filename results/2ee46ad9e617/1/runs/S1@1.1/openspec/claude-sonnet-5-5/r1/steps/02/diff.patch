+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  bad({ a: 1 }, [{ op: "move", from: "/x", path: "/x" }]);
+  ok({ a: { b: 1 } }, [{ op: "move", from: "/a/b", path: "" }], 1 === 1 ? 1 : 0);
+  ok({ a: 1 }, [{ op: "move", from: "", path: "" }], { a: 1 });
+  const out = applyPatch({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }, { op: "add", path: "/b/y", value: 2 }]);
+  assert.deepEqual(out, { a: { x: 1 }, b: { x: 1, y: 2 } });
