+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+});
+
+test("does not mutate input or share structure", () => {
+  const doc = { a: {}, list: [1] };
+  const value = { x: [1] };
+  const patch = [{ op: "add", path: "/a/b", value }, { op: "copy", from: "/a/b", path: "/c" }];
+  const snapshot = structuredClone({ doc, patch });
+  const result = applyPatch(doc, patch) as any;
+  assert.deepEqual({ doc, patch }, snapshot);
+  result.a.b.x.push(2);
+  assert.deepEqual(value, { x: [1] });
+  assert.deepEqual(result.c, { x: [1] });
+  assert.notEqual(applyPatch(doc, []), doc);
+  assert.deepEqual(applyPatch(doc, []), doc);
+});
+
+test("failure leaves input unmodified", () => {
+  const doc = { a: 1 };
+  bad(doc, [{ op: "add", path: "/b", value: 2 }, { op: "remove", path: "/zzz" }]);
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("invalid patches", () => {
+  assert.throws(() => applyPatch({}, {}), InvalidPatchError);
+  assert.throws(() => applyPatch({}, [1]), InvalidPatchError);
+  assert.throws(() => applyPatch({}, [null]), InvalidPatchError);
+  assert.throws(() => applyPatch({}, [{ path: "/a", value: 1 }]), InvalidPatchError);
+  assert.throws(() => applyPatch({}, [{ op: "merge", path: "/a" }]), InvalidPatchError);
+  assert.throws(() => applyPatch({}, [{ op: "add", value: 1 }]), InvalidPointerError);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "a", value: 1 }]), InvalidPointerError);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]), InvalidPatchError);
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a" }]), InvalidPatchError);
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/a" }]), InvalidPatchError);
+  assert.throws(() => applyPatch({}, [{ op: "move", path: "/a" }]), InvalidPatchError);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", path: "/b", from: "x" }]), InvalidPointerError);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "/b" }]), PatchFailedError);
+  // validation happens before applying anything
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: 1 }, { op: "bogus", path: "/a" }]), InvalidPatchError);
+});
+
+test("add details", () => {
+  ok({ a: null }, [{ op: "add", path: "/b", value: null }], { a: null, b: null });
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: "x" }], { foo: ["bar", "x"] });
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/1", value: "x" }], { foo: ["bar", "x"] });
+  ok({ a: 1 }, [{ op: "add", path: "/a", value: 2 }], { a: 2 });
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ "": 1 }, [{ op: "add", path: "/", value: 2 }], { "": 2 });
+  bad({ foo: ["a", "b"] }, [{ op: "add", path: "/foo/3", value: "x" }]);
+  bad({ foo: ["a"] }, [{ op: "add", path: "/foo/01", value: "x" }]);
+  bad({ foo: ["a"] }, [{ op: "add", path: "/foo/x", value: "x" }]);
+  bad({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]);
