index 0000000000000000000000000000000000000000..2c5d5c195b63f3b8b10cfad590ce0afc8c6b1ca7
--- /dev/null
+++ b/src/pointer.ts
@@ -0,0 +1,54 @@
+export class InvalidPointerError extends Error {
+  override name = "InvalidPointerError";
+}
+
+export class UnresolvedPointerError extends Error {
+  override name = "UnresolvedPointerError";
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new InvalidPointerError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new InvalidPointerError(`JSON Pointer must be empty or start with "/": ${JSON.stringify(pointer)}`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new InvalidPointerError(`Invalid "~" escape in JSON Pointer: ${JSON.stringify(pointer)}`);
+      }
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/**
+ * Returns the value that a JSON Pointer (RFC 6901) refers to in a JSON document.
+ * Throws InvalidPointerError for a malformed pointer and UnresolvedPointerError
+ * when the pointer does not refer to a value of the document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  let current = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new UnresolvedPointerError(`No array element ${JSON.stringify(token)} for pointer ${JSON.stringify(pointer)}`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new UnresolvedPointerError(`No member ${JSON.stringify(token)} for pointer ${JSON.stringify(pointer)}`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new UnresolvedPointerError(`Cannot apply ${JSON.stringify(token)} to a scalar for pointer ${JSON.stringify(pointer)}`);
+    }
+  }
+  return current;
+}
