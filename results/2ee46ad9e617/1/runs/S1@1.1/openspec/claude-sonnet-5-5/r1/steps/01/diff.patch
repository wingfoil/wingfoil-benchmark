@@ -0,0 +1,81 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer, InvalidPointerError, UnresolvedPointerError } from "./index.ts";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("empty pointer returns any document", () => {
+  assert.equal(resolvePointer(null, ""), null);
+  assert.equal(resolvePointer(3, ""), 3);
+});
+
+test("invalid pointers throw InvalidPointerError", () => {
+  for (const p of ["foo", "#/foo", "/a~2b", "/a~", "/~", "/a/~x"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), InvalidPointerError, p);
+  }
+  assert.throws(() => resolvePointer({}, undefined as any), InvalidPointerError);
+  assert.throws(() => resolvePointer({}, 1 as any), InvalidPointerError);
+});
+
+test("invalid pointer is rejected even if resolution would fail earlier", () => {
+  assert.throws(() => resolvePointer({}, "/missing/~2"), InvalidPointerError);
+});
+
+test("escape order: ~01 is the text ~1", () => {
+  assert.equal(resolvePointer({ "~1": 5 }, "/~01"), 5);
+});
+
+test("object members", () => {
+  assert.equal(resolvePointer({ foo: { bar: [10, 20] } }, "/foo/bar/1"), 20);
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"), UnresolvedPointerError);
+  for (const p of ["/toString", "/__proto__", "/constructor", "/hasOwnProperty"]) {
+    assert.throws(() => resolvePointer({}, p), UnresolvedPointerError, p);
+  }
+  assert.equal(resolvePointer(JSON.parse('{"__proto__": 1}'), "/__proto__"), 1);
+});
+
+test("array elements", () => {
+  const arr = ["a", "b"];
+  assert.equal(resolvePointer(arr, "/0"), "a");
+  assert.equal(resolvePointer(arr, "/1"), "b");
+  for (const p of ["/2", "/-", "/01", "/+1", "/-1", "/1.0", "/length", "/", "/ 1", "/99999999999999999999"]) {
+    assert.throws(() => resolvePointer(arr, p), UnresolvedPointerError, p);
+  }
+});
+
+test("scalars have no children; falsy values are returned", () => {
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"), UnresolvedPointerError);
+  assert.throws(() => resolvePointer({ a: "str" }, "/a/length"), UnresolvedPointerError);
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/0"), UnresolvedPointerError);
+  const doc = { a: null, b: false, c: 0, d: "" };
+  assert.equal(resolvePointer(doc, "/a"), null);
+  assert.equal(resolvePointer(doc, "/b"), false);
+  assert.equal(resolvePointer(doc, "/c"), 0);
+  assert.equal(resolvePointer(doc, "/d"), "");
+});
