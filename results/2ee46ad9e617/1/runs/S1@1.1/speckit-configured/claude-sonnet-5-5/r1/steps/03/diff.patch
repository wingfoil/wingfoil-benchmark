+# Spec: applyPatch conformance review
+
+**Standard**: RFC 6902 §3, §4, §5; RFC 6901 §3, §4.
+
+Review of `applyPatch` against every operation and error rule found one deviation: holes in a sparse
+patch array were silently skipped (`forEach`), accepting a patch whose element is not an operation object.
+Each element is now validated, so a hole raises `JsonPatchError` (§4: operations MUST be objects).
+All other behaviours (Appendix A, atomicity, move/copy/test rules, pointer errors) were verified conformant.
diff --git a/src/index.ts b/src/index.ts
index 508348895f85cac0c5157440e40847373abac3d7..9255773742f1f72458f17812e2b1d33aeb46c538 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -249,9 +249,9 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   if (!Array.isArray(patch)) throw new JsonPatchError("A JSON Patch must be an array of operations");
   let result = cloneJson(document);
   try {
-    patch.forEach((operation, index) => {
-      result = applyOperation(result, operation, index);
-    });
+    for (let index = 0; index < patch.length; index++) {
+      result = applyOperation(result, patch[index], index);
+    }
   } catch (error) {
     if (error instanceof JsonPointerError) throw new JsonPatchError(error.message);
     throw error;
