   return result;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7396 §2) and returns the merged document.
+ * A non-object patch replaces the target; object patch members set or (when `null`) remove keys,
+ * recursively. Neither argument is mutated and the result shares no structure with them.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (typeof patch !== "object" || patch === null || Array.isArray(patch)) return cloneJson(patch);
+  const result: Record<string, unknown> = {};
+  const base = typeof target === "object" && target !== null && !Array.isArray(target) ? (target as Record<string, unknown>) : {};
+  for (const key of Object.keys(base)) setMember(result, key, cloneJson(base[key]));
+  for (const key of Object.keys(patch)) {
+    const value = (patch as Record<string, unknown>)[key];
+    if (value === null) delete result[key];
+    else setMember(result, key, applyMergePatch(Object.hasOwn(result, key) ? result[key] : undefined, value));
+  }
+  return result;
+}
diff --git a/test/merge-patch.test.ts b/test/merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d3d2de9ce525b963a5c85ab03561288d6b1131c8
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,52 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+const ok = (t: unknown, p: unknown, e: unknown) => assert.deepEqual(applyMergePatch(t, p), e);
+
+test("RFC 7396 Appendix A examples", () => {
+  ok({ a: "b" }, { a: "c" }, { a: "c" });
+  ok({ a: "b" }, { b: "c" }, { a: "b", b: "c" });
+  ok({ a: "b" }, { a: null }, {});
+  ok({ a: "b", b: "c" }, { a: null }, { b: "c" });
+  ok({ a: ["b"] }, { a: "c" }, { a: "c" });
+  ok({ a: "c" }, { a: ["b"] }, { a: ["b"] });
+  ok({ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } });
+  ok({ a: [{ b: "c" }] }, { a: [1] }, { a: [1] });
+  ok(["a", "b"], ["c", "d"], ["c", "d"]);
+  ok({ a: "b" }, ["c"], ["c"]);
+  ok({ a: "foo" }, null, null);
+  ok({ a: "foo" }, "bar", "bar");
+  ok({ e: null }, { a: 1 }, { e: null, a: 1 });
+  ok([1, 2], { a: "b", c: null }, { a: "b" });
+  ok({}, { a: { bb: { ccc: null } } }, { a: { bb: {} } });
+});
+
+test("non-object targets", () => {
+  ok(null, { a: 1 }, { a: 1 });
+  ok("x", { a: 1 }, { a: 1 });
+  ok(undefined, { a: 1 }, { a: 1 });
+});
+
+test("does not mutate or share structure", () => {
+  const target = { a: { b: 1 }, c: [1] };
+  const patch = { a: { d: { e: 1 } }, f: [{ g: 1 }] };
+  const snap = structuredClone({ target, patch });
+  const r = applyMergePatch(target, patch) as any;
+  assert.deepEqual({ target, patch }, snap);
+  assert.notEqual(r.c, target.c);
+  assert.notEqual(r.a.d, patch.a.d);
+  assert.notEqual(r.f, patch.f);
+  assert.notEqual(r.f[0], patch.f[0]);
+});
+
+test("prototype pollution is guarded", () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":1},"constructor":{"prototype":{"x":1}}}');
+  const r = applyMergePatch({}, patch) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(({} as any).x, undefined);
+  assert.equal(Object.getPrototypeOf(r), Object.prototype);
+  assert.deepEqual(Object.keys(r), ["__proto__", "constructor"]);
+  assert.deepEqual(applyMergePatch(JSON.parse('{"__proto__":{"a":1}}'), JSON.parse('{"__proto__":{"b":2}}')), JSON.parse('{"__proto__":{"a":1,"b":2}}'));
+  assert.equal(Object.keys(applyMergePatch({}, JSON.parse('{"__proto__":null}')) as object).length, 0);
+});
