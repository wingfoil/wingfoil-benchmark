index 0000000000000000000000000000000000000000..2b3e2d3490f15db993ca929e7490a513438d5562
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,83 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const before = JSON.stringify(from);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.equal(JSON.stringify(from), before);
+  return patch as Array<Record<string, unknown>>;
+};
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: null }] }, { a: [1, { b: null }] }), []);
+  assert.deepEqual(roundTrip(null, null), []);
+});
+
+test("root and type changes are replaced", () => {
+  assert.deepEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip({ a: null }, { a: {} }), [{ op: "replace", path: "/a", value: {} }]);
+});
+
+test("small change in a big document is a single operation", () => {
+  const from = { a: { b: [1, 2, { c: 1, d: 2 }], e: "x" }, f: true };
+  const to = { a: { b: [1, 2, { c: 1, d: 3 }], e: "x" }, f: true };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/2/d", value: 3 }]);
+});
+
+test("object members added and removed, with escaping", () => {
+  const p = roundTrip({ "a/b": 1, "m~n": 2, keep: 1 }, { "m~n": 2, "x/y~": 3, keep: 1 });
+  assert.deepEqual(p, [
+    { op: "remove", path: "/a~1b" },
+    { op: "add", path: "/x~1y~0", value: 3 },
+  ]);
+  roundTrip({ "": 1 }, { "": 2 });
+});
+
+test("array insert and delete touch only that item", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(roundTrip([{ a: 1 }, { b: 2 }], [{ b: 2 }]), [{ op: "remove", path: "/0" }]);
+});
+
+test("array move is a move, or remove plus add, only", () => {
+  const p = roundTrip([1, 2, 3, 4, 5], [1, 5, 2, 3, 4]);
+  assert.ok(p.length <= 2 && p.every((o) => ["move", "add", "remove"].includes(o.op as string)));
+  const q = roundTrip(["a", "b", "c", "d"], ["b", "c", "d", "a"]);
+  assert.ok(q.length <= 2);
+});
+
+test("changed array items are diffed in place", () => {
+  assert.deepEqual(roundTrip([{ a: 1 }, { b: 2 }], [{ a: 1 }, { b: 3 }]), [
+    { op: "replace", path: "/1/b", value: 3 },
+  ]);
+  roundTrip([[1, 2], [3]], [[1, 2, 2], [3], [4]]);
+});
+
+test("patch values share no structure with inputs; __proto__ is an ordinary key", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to) as Array<{ value: { b: number } }>;
+  assert.notEqual(patch[0].value, to.a);
+  const from = JSON.parse('{"__proto__": {"x": 1}}');
+  const target = JSON.parse('{"__proto__": {"x": 2}, "y": 1}');
+  roundTrip(from, target);
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+});
+
+test("random documents round-trip", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) % n);
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 4 : 6);
+    if (k === 0) return rnd(3);
+    if (k === 1) return null;
+    if (k === 2) return "s" + rnd(2);
+    if (k === 3) return rnd(2) === 0;
+    if (k === 4) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let i = 0; i < 500; i++) roundTrip(gen(0), gen(0));
+});
