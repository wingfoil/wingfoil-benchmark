+
+/** A JSON Patch operation produced by `createPatch` (RFC 6902 §4.1-§4.3). */
+export type PatchOperation =
+  | { op: "add"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "replace"; path: string; value: unknown };
+
+/** Encodes one reference token (RFC 6901 §3): `~` becomes `~0` first, then `/` becomes `~1`. */
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Appends the operations turning `from` into `to` at `path`. */
+function diffValue(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${encodeToken(key)}`;
+      if (Object.hasOwn(from, key)) diffValue(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: cloneJson(to[key]) });
+    }
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(from, to, path, ops);
+  } else {
+    ops.push({ op: "replace", path, value: cloneJson(to) });
+  }
+}
+
+/**
+ * Appends the operations turning array `from` into `to`. Equal items are aligned by longest common
+ * subsequence; between aligned items, differing items at the same position are diffed in place and the
+ * surplus is removed or added. Indices refer to the array as modified by the earlier operations.
+ */
+function diffArray(from: unknown[], to: unknown[], path: string, ops: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && jsonEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const n = endFrom - start;
+  const m = endTo - start;
+  // lcs[i][j]: length of the LCS of from[start+i..endFrom) and to[start+j..endTo)
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(from[start + i], to[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  let cursor = start; // index in the working array of the next unprocessed item
+  let i = 0;
+  let j = 0;
+  const flushGap = (removed: number, added: number, fromAt: number, toAt: number): void => {
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) diffValue(from[fromAt + k], to[toAt + k], `${path}/${cursor + k}`, ops);
+    for (let k = paired; k < removed; k++) ops.push({ op: "remove", path: `${path}/${cursor + paired}` });
+    for (let k = paired; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${cursor + k}`, value: cloneJson(to[toAt + k]) });
+    }
+    cursor += added;
+  };
+  while (i < n || j < m) {
+    const gapFrom = i;
+    const gapTo = j;
+    while ((i < n || j < m) && !(i < n && j < m && jsonEqual(from[start + i], to[start + j]) && lcs[i][j] === lcs[i + 1][j + 1] + 1)) {
+      if (i < n && (j >= m || lcs[i + 1][j] >= lcs[i][j + 1])) i++;
+      else j++;
+    }
+    flushGap(i - gapFrom, j - gapTo, start + gapFrom, start + gapTo);
+    if (i < n && j < m) {
+      i++;
+      j++;
+      cursor++;
+    }
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902 §4: add, remove, replace; paths per RFC 6901) that turns `from` into `to`
+ * when applied with `applyPatch`.
+ *
+ * The patch is minimal in spirit: only what differs is described. Objects are diffed member by member;
+ * array items are aligned so that an inserted or deleted item is a single `add` or `remove`, and a moved
+ * item is a `remove` plus an `add`. Neither argument is mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffValue(from, to, "", ops);
+  return ops;
+}
