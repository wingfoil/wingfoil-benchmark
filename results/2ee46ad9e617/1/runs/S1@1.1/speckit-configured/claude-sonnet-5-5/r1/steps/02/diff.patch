+  ok({ foo: 1, baz: [{ qux: "hello" }] }, [{ op: "copy", from: "/baz/0", path: "/boo" }], {
+    foo: 1,
+    baz: [{ qux: "hello" }],
+    boo: { qux: "hello" },
+  });
+  ok({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 });
+  bad({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]);
+  ok({ foo: ["bar"] }, [{ op: "replace", path: "/foo/0", value: "x" }], { foo: ["x"] });
