+
+/**
+ * Resolves a JSON Pointer against a JSON document, as specified by RFC 6901.
+ *
+ * The empty pointer refers to the whole document. Only own members of objects are resolved. The document
+ * is not modified.
+ *
+ * @throws {JsonPointerError} if the pointer is not a valid JSON Pointer (§3), or does not resolve to a
+ * value of the document (§4: missing member, index out of range, `-`, invalid index, or a primitive/null
+ * traversed).
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  return resolveTokens(document, parsePointer(pointer), pointer);
+}
+
+/** Error thrown when a JSON Patch is invalid or one of its operations fails (RFC 6902 §4, §5). */
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Container = unknown[] | Record<string, unknown>;
+
+/** Sets an own member without ever invoking `__proto__` setters. */
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Deep-copies a JSON value; the copy shares no structure with the original. */
+function cloneJson(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(cloneJson);
+  if (typeof value === "object" && value !== null) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(copy, key, cloneJson((value as Record<string, unknown>)[key]));
+    return copy;
+  }
+  return value;
+}
+
+/** JSON equality as defined by RFC 6902 §4.6. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (typeof a === "object" && a !== null && typeof b === "object" && b !== null) {
+    const keysA = Object.keys(a);
+    return (
+      keysA.length === Object.keys(b).length &&
+      keysA.every(
+        (k) => Object.hasOwn(b, k) && jsonEqual((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]),
+      )
+    );
+  }
+  return a === b;
+}
+
+/** Returns the container holding the target of `tokens` (which must be non-empty) and the last token. */
+function parentOf(document: unknown, tokens: string[], path: string): [Container, string] {
+  const parent = resolveTokens(document, tokens.slice(0, -1), path);
+  if (typeof parent !== "object" || parent === null) {
+    throw new JsonPatchError(`Parent of "${path}" is not an object or array`);
+  }
+  return [parent as Container, tokens[tokens.length - 1]];
+}
+
+/** Index of an existing array element, or throws. */
+function existingIndex(array: unknown[], token: string, path: string): number {
+  if (!ARRAY_INDEX.test(token) || Number(token) >= array.length) {
+    throw new JsonPatchError(`No element "${token}" in "${path}"`);
+  }
+  return Number(token);
+}
+
+/** RFC 6902 §4.1 add. Returns the new document root. */
+function addAt(document: unknown, tokens: string[], path: string, value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  const [parent, token] = parentOf(document, tokens, path);
+  if (Array.isArray(parent)) {
+    if (token === "-") {
+      parent.push(value);
+    } else {
+      if (!ARRAY_INDEX.test(token) || Number(token) > parent.length) {
+        throw new JsonPatchError(`Invalid array index "${token}" in "${path}"`);
+      }
+      parent.splice(Number(token), 0, value);
+    }
+  } else {
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+/** RFC 6902 §4.2 remove. The target must exist; the root cannot be removed. */
+function removeAt(document: unknown, tokens: string[], path: string): unknown {
+  if (tokens.length === 0) throw new JsonPatchError("Cannot remove the document root");
+  const [parent, token] = parentOf(document, tokens, path);
+  if (Array.isArray(parent)) {
+    parent.splice(existingIndex(parent, token, path), 1);
+  } else {
+    if (!Object.hasOwn(parent, token)) throw new JsonPatchError(`No member "${token}" in "${path}"`);
+    delete parent[token];
+  }
+  return document;
+}
+
+/** RFC 6902 §4.3 replace. The target must exist. */
+function replaceAt(document: unknown, tokens: string[], path: string, value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  const [parent, token] = parentOf(document, tokens, path);
+  if (Array.isArray(parent)) {
+    parent[existingIndex(parent, token, path)] = value;
+  } else {
+    if (!Object.hasOwn(parent, token)) throw new JsonPatchError(`No member "${token}" in "${path}"`);
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+function requireString(operation: Record<string, unknown>, member: string, index: number): string {
+  const found = Object.hasOwn(operation, member) ? operation[member] : undefined;
+  if (typeof found !== "string") {
+    throw new JsonPatchError(`Operation ${index}: "${member}" must be a string`);
+  }
+  return found;
+}
+
+function requireValue(operation: Record<string, unknown>, index: number): unknown {
+  const found = Object.hasOwn(operation, "value") ? operation.value : undefined;
+  if (found === undefined) throw new JsonPatchError(`Operation ${index}: "value" is required`);
+  return cloneJson(found);
+}
+
+function applyOperation(document: unknown, operation: unknown, index: number): unknown {
+  if (typeof operation !== "object" || operation === null || Array.isArray(operation)) {
+    throw new JsonPatchError(`Operation ${index} must be an object`);
+  }
+  const op = operation as Record<string, unknown>;
+  const name = requireString(op, "op", index);
+  const path = requireString(op, "path", index);
+  const tokens = parsePointer(path);
+
+  switch (name) {
+    case "add":
+      return addAt(document, tokens, path, requireValue(op, index));
+    case "remove":
+      resolveTokens(document, tokens, path);
+      return removeAt(document, tokens, path);
+    case "replace": {
+      const value = requireValue(op, index);
+      resolveTokens(document, tokens, path);
+      return replaceAt(document, tokens, path, value);
+    }
+    case "move":
+    case "copy": {
+      const from = requireString(op, "from", index);
+      const fromTokens = parsePointer(from);
+      const value = resolveTokens(document, fromTokens, from);
+      if (name === "copy") return addAt(document, tokens, path, cloneJson(value));
+      if (
+        fromTokens.length < tokens.length &&
+        fromTokens.every((t, i) => t === tokens[i])
+      ) {
+        throw new JsonPatchError(`Cannot move "${from}" into one of its own children "${path}"`);
+      }
+      if (from === path) return document;
+      return addAt(removeAt(document, fromTokens, from), tokens, path, value);
+    }
+    case "test": {
+      const expected = requireValue(op, index);
+      if (!jsonEqual(resolveTokens(document, tokens, path), expected)) {
+        throw new JsonPatchError(`Operation ${index}: test failed at "${path}"`);
+      }
+      return document;
+    }
+    default:
+      throw new JsonPatchError(`Operation ${index}: unknown op "${name}"`);
+  }
+}
+
+/**
+ * Applies a JSON Patch to a JSON document, as specified by RFC 6902 (add, remove, replace, move, copy, test;
+ * paths are RFC 6901 JSON Pointers).
+ *
+ * Operations apply in order. The result is a new value sharing no structure with `document` or `patch`;
+ * neither is modified, even when the patch fails (RFC 6902 §5: the whole patch then has no effect).
+ *
+ * @throws {JsonPatchError} if the patch is malformed (§4), a path is not a valid JSON Pointer, an operation
+ * cannot be applied (missing target, bad array index, move into own child, removing the root), or a `test`
+ * operation does not match (§4.6).
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchError("A JSON Patch must be an array of operations");
+  let result = cloneJson(document);
+  try {
+    patch.forEach((operation, index) => {
+      result = applyOperation(result, operation, index);
+    });
+  } catch (error) {
+    if (error instanceof JsonPointerError) throw new JsonPatchError(error.message);
+    throw error;
+  }
+  return result;
+}
