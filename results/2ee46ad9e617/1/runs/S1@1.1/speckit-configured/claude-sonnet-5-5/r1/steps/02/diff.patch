+  bad({}, [{ op: "add", path: "a", value: 1 }]);
+  bad({}, [{ op: "add", path: "/~2", value: 1 }]);
+  bad({}, [{ op: "move", from: 1, path: "/a" }]);
+  ok({ a: 1 }, [], { a: 1 });
+});
+
+test("does not mutate input and is atomic", () => {
+  const doc = { a: { b: [1, 2] }, c: 1 };
+  const patch = [
+    { op: "add", path: "/a/b/-", value: { x: 1 } },
+    { op: "remove", path: "/c" },
+    { op: "copy", from: "/a", path: "/d" },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  out.a.b.push(9);
+  (patch[0].value as any).x = 5;
+  assert.deepEqual(out.d.b, [1, 2, { x: 1 }]);
+  assert.deepEqual(doc, docCopy);
+
+  const failing = [{ op: "remove", path: "/c" }, { op: "test", path: "/a", value: 0 }];
+  bad(doc, failing);
+  assert.deepEqual(doc, docCopy);
+  assert.notEqual(applyPatch(doc, []), doc);
+});
+
+test("prototype pollution is not possible", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(out.polluted, undefined);
+  assert.ok(Object.hasOwn(out, "__proto__"));
+  bad({}, [{ op: "add", path: "/__proto__/x", value: 1 }]);
+  bad({}, [{ op: "remove", path: "/constructor" }]);
+  bad({}, [{ op: "test", path: "/toString", value: 1 }]);
+  bad({}, [{ op: "replace", path: "/prototype", value: 1 }]);
+  bad({}, [{ op: "copy", from: "/constructor", path: "/a" }]);
+  const parsed = JSON.parse('{"__proto__": {"a": 1}}');
+  const cloned = applyPatch(parsed, []) as any;
+  assert.equal(Object.getPrototypeOf(cloned), Object.prototype);
+  assert.equal(cloned.a, undefined);
+  assert.ok(Object.hasOwn(cloned, "__proto__"));
+  const viaValue = applyPatch({}, [{ op: "add", path: "/v", value: parsed }]) as any;
+  assert.equal(viaValue.v.a, undefined);
+  assert.equal(({} as any).a, undefined);
+});
