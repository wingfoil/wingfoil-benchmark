+/** Error thrown when a JSON Pointer is malformed or does not resolve (RFC 6901 §3, §4, §7). */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+/** Array index per RFC 6901 §4: "0", or digits without a leading zero. */
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/** Decodes one reference token (RFC 6901 §4): `~1` becomes `/` first, then `~0` becomes `~`. */
+function decodeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new JsonPointerError(`Invalid escape sequence in reference token "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/**
+ * Resolves a JSON Pointer against a JSON document, as specified by RFC 6901.
+ *
+ * The empty pointer refers to the whole document. Only own members of objects are resolved. The document
+ * is not modified.
+ *
+ * @throws {JsonPointerError} if the pointer is not a valid JSON Pointer (§3), or does not resolve to a
+ * value of the document (§4: missing member, index out of range, `-`, invalid index, or a primitive/null
+ * traversed).
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("A JSON Pointer must be a string");
+  }
+  if (pointer === "") return document;
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+
+  let current: unknown = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token)) {
+        throw new JsonPointerError(`"${token}" is not a valid array index in "${pointer}"`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new JsonPointerError(`Array index ${token} is out of range in "${pointer}"`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new JsonPointerError(`No member "${token}" in "${pointer}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Cannot resolve "${token}" in a non-container value in "${pointer}"`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3e71ed8b637d135b9d290a52c87ca5d94b94595c
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,78 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer, JsonPointerError } from "../src/index.ts";
+
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("escape order: ~01 is the key ~1", () => {
+  assert.equal(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+});
+
+test("null is a value, falsy values are returned", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer({ a: [false] }, "/a/0"), false);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["foo", "/a~", "/a~2", "/a~b", "#/foo", " /foo"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), JsonPointerError, p);
+  }
+  assert.throws(() => resolvePointer({}, undefined as unknown as string), JsonPointerError);
+  assert.throws(() => resolvePointer({}, 1 as unknown as string), JsonPointerError);
+});
+
+test("unresolvable pointers throw", () => {
+  const d = { a: [1, 2], o: { x: 1 }, n: null, s: "str", e: [] };
+  for (const p of ["/b", "/a/2", "/a/-", "/a/01", "/a/+1", "/a/1.0", "/a/-1", "/a/x", "/a/", "/a/ 1",
+    "/n/x", "/s/0", "/s/length", "/o/x/y", "/a/length", "/e/0", "/a/1/0"]) {
+    assert.throws(() => resolvePointer(d, p), JsonPointerError, p);
+  }
+  assert.throws(() => resolvePointer(5, "/a"), JsonPointerError);
+});
+
+test("array index 0 and large indices", () => {
+  assert.equal(resolvePointer([5], "/0"), 5);
+  assert.throws(() => resolvePointer([5], "/99999999999999999999"), JsonPointerError);
+});
+
+test("prototype chain is not traversed", () => {
+  for (const p of ["/__proto__", "/constructor", "/prototype", "/toString", "/constructor/prototype"]) {
+    assert.throws(() => resolvePointer({}, p), JsonPointerError, p);
+  }
+  const own = JSON.parse('{"__proto__": 1}');
+  assert.equal(resolvePointer(own, "/__proto__"), 1);
+});
+
+test("document is not mutated", () => {
+  const d = { a: [1, { b: 2 }] };
+  const copy = structuredClone(d);
+  resolvePointer(d, "/a/1/b");
+  assert.deepEqual(d, copy);
+});
