 }
+
+/** Own member lookup, so inherited names such as `constructor` never leak in. */
+function ownMember(target: unknown, key: string): unknown {
+  return isObject(target) && Object.hasOwn(target, key) ? target[key] : undefined;
+}
+
+/**
+ * Apply a JSON Merge Patch (RFC 7386, as restated by RFC 7396 section 2) to a
+ * document and return the result as a new value; neither argument is mutated.
+ * A non-object patch replaces the target; an object patch is merged member by
+ * member into the target (or into `{}` if the target is not an object), where
+ * `null` removes a member. Arrays are replaced whole, never merged.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch);
+  const out: Record<string, unknown> = isObject(target) ? (clone(target) as Record<string, unknown>) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) delete out[key];
+    else setMember(out, key, applyMergePatch(ownMember(out, key), value));
+  }
+  return out;
+}
