new file mode 100644
index 0000000000000000000000000000000000000000..3d9520bea48b1ba30dd1c634f198a84bfde53555
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,64 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, want: unknown) =>
+  assert.deepEqual(applyMergePatch(doc, patch), want);
+
+// RFC 7386 appendix A example
+test("appendix A example", () =>
+  ok(
+    { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["example", "sample"], content: "This will be unchanged" },
+    { title: "Hello!", phoneNumber: "+01-123-456-7890", author: { familyName: null }, tags: ["example"] },
+    { title: "Hello!", author: { givenName: "John" }, tags: ["example"], content: "This will be unchanged", phoneNumber: "+01-123-456-7890" },
+  ));
+
+// RFC 7386 appendix A test-case table
+const cases: [unknown, unknown, unknown][] = [
+  [{ a: "b" }, { a: "c" }, { a: "c" }],
+  [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  [{ a: "b" }, { a: null }, {}],
+  [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+  [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+  [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  [["a", "b"], ["c", "d"], ["c", "d"]],
+  [{ a: "b" }, ["c"], ["c"]],
+  [{ a: "foo" }, null, null],
+  [{ a: "foo" }, "bar", "bar"],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: "b", c: null }, { a: "b" }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+cases.forEach(([doc, patch, want], i) => test(`appendix A case ${i + 1}`, () => ok(doc, patch, want)));
+
+test("inputs are not mutated and results do not alias them", () => {
+  const doc = { a: { b: 1 }, l: [1] };
+  const patch = { a: { c: { d: 1 } }, l: [2] };
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const res = applyMergePatch(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.notEqual(res.a.c, patch.a.c);
+  assert.notEqual(res.l, patch.l);
+});
+
+test("__proto__ and inherited names are plain data", () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true},"constructor":{"x":1}}');
+  const res = applyMergePatch({}, patch) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(res), Object.prototype);
+  assert.deepEqual(Object.keys(res), ["__proto__", "constructor"]);
+  assert.deepEqual(res.constructor, { x: 1 });
+  assert.equal(Object.hasOwn(res, "__proto__"), true);
+  // inherited `constructor` on the target is not merged into
+  const res2 = applyMergePatch({}, { toString: { a: 1 } }) as any;
+  assert.deepEqual(res2.toString, { a: 1 });
+});
+
+test("null removes an own __proto__ member", () => {
+  const doc = JSON.parse('{"__proto__":1,"a":2}');
+  assert.deepEqual(Object.keys(applyMergePatch(doc, JSON.parse('{"__proto__":null}')) as object), ["a"]);
+});
