+++ b/src/index.ts
@@ -0,0 +1,55 @@
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/** Decode one reference token (RFC 6901 section 4): `~1` -> `/`, then `~0` -> `~`. */
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in token "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/**
+ * Resolve a JSON Pointer (RFC 6901) against a document.
+ * Throws if the pointer is syntactically invalid (section 3) or does not
+ * resolve to a value of the document (section 4). The document is not mutated.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return document;
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  let current: unknown = document;
+  for (const raw of pointer.slice(1).split("/")) {
+    const token = unescapeToken(raw);
+    if (Array.isArray(current)) {
+      // Section 4: "-" refers to the nonexistent element after the last one.
+      if (!ARRAY_INDEX.test(token)) {
+        throw new Error(`Pointer does not resolve: "${token}" is not an array index`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new Error(`Pointer does not resolve: index ${token} out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(`Pointer does not resolve: no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`Pointer does not resolve: cannot descend into a scalar at "${token}"`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e48f75b8f68729dfa94fe36d64988f91be02337b
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,68 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// RFC 6901 section 5 example document
+const doc = JSON.parse(`{
+  "foo": ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\\\j": 5,
+  "k\\"l": 6,
+  " ": 7,
+  "m~n": 8
+}`);
+
+const examples = [
+  ["", doc],
+  ["/foo", ["bar", "baz"]],
+  ["/foo/0", "bar"],
+  ["/", 0],
+  ["/a~1b", 1],
+  ["/c%d", 2],
+  ["/e^f", 3],
+  ["/g|h", 4],
+  ["/i\\j", 5],
+  ['/k"l', 6],
+  ["/ ", 7],
+  ["/m~0n", 8],
+];
+for (const [p, v] of examples) {
+  test(`RFC 6901 section 5 example "${p}"`, () => assert.deepEqual(resolvePointer(doc, p), v));
+}
+
+test("unescape order: ~01 is ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+});
+test("null and falsy values resolve", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer([false], "/0"), false);
+  assert.equal(resolvePointer(null, ""), null);
+});
+test("invalid pointers throw", () => {
+  for (const p of ["foo", "/a~", "/a~2", "/~", "#/a"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), p);
+  }
+});
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+  assert.throws(() => resolvePointer(null, "/a"));
+  assert.throws(() => resolvePointer([1], "/1"));
+  assert.throws(() => resolvePointer([1], "/-"));
+  assert.throws(() => resolvePointer([1], "/00"));
+  assert.throws(() => resolvePointer([1], "/01"));
+  assert.throws(() => resolvePointer([1], "/+0"));
+  assert.throws(() => resolvePointer([1], "/1e0"));
+  assert.throws(() => resolvePointer([1], "/length"));
+  assert.throws(() => resolvePointer([1], "/ 0"));
+});
+test("no prototype lookups", () => {
+  for (const p of ["/__proto__", "/constructor", "/toString", "/constructor/prototype"]) {
+    assert.throws(() => resolvePointer({}, p), p);
+  }
+  assert.deepEqual(resolvePointer(JSON.parse('{"__proto__": {"x": 1}}'), "/__proto__/x"), 1);
+});
