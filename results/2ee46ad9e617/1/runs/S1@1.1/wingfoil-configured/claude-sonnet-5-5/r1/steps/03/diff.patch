+
+<!-- task body. `wingfoil memory add` copies this scaffold, setting only `id`, `title` and
+     `status` (and any `--tags` or `--set` value). Fill the required frontmatter fields and replace
+     these placeholder comments yourself; `wingfoil memory submit` then checks the required fields,
+     moves `status` forward and commits the document as you left it, naming in the commit body the
+     content it carries. -->
+
+## Request
+
+Users report that `applyPatch` accepts patches they consider invalid, gives unexpected edge-case results,
+and fails differently from their reading of RFC 6902. Review validation and application and make them conform.
+
+## Outcome
+
+Reviewed `src/index.ts` against RFC 6902 sections 4 and 5 and probed edge cases by hand (move index after
+removal, move into child, replace/remove with `-`, leading-zero indexes, bad escapes, case-sensitive ops,
+atomic failure, prototype keys). No deviation from the RFC was found, so the code is unchanged. Added four
+tests to `test/patch.test.ts` that pin these behaviours; `npm test` passes (46 tests).
+
+Open point: RFC 6902 does not say what `remove` of the whole document yields; the library returns `null`.
+Unchanged, pending the reporters' concrete cases.
diff --git a/test/patch.test.ts b/test/patch.test.ts
index b454903b4f86705462e89620f132d599cea5531a..852a318e39c6dc037bfbf7198f762936794c97fb 100644
--- a/test/patch.test.ts
+++ b/test/patch.test.ts
@@ -111,3 +111,22 @@ test("inputs are not mutated", () => {
   bad(doc, [{ op: "remove", path: "/a/0" }, { op: "remove", path: "/zzz" }]);
   assert.equal(JSON.stringify(doc), d0);
 });
+
+// Edge cases reviewed against RFC 6902 sections 4 and 5
+test("section 4.4: move index is relative to the array after removal", () => {
+  ok([1, 2, 3], [{ op: "move", from: "/0", path: "/2" }], [2, 3, 1]);
+  bad([1, 2, 3], [{ op: "move", from: "/0", path: "/3" }]);
+});
+test("section 4.3: replace needs an existing target, '-' is not one", () => {
+  bad([1], [{ op: "replace", path: "/-", value: 1 }]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+});
+test("section 5: a failing operation leaves nothing applied", () => {
+  const doc = { a: 1 };
+  bad(doc, [{ op: "add", path: "/b", value: 2 }, { op: "test", path: "/a", value: 2 }]);
+  assert.deepEqual(doc, { a: 1 });
+});
+test("op names are case-sensitive; unknown members are ignored", () => {
+  bad({}, [{ op: "ADD", path: "/a", value: 1 }]);
+  ok({}, [{ op: "add", path: "/a", value: 1, extra: true }], { a: 1 });
+});
