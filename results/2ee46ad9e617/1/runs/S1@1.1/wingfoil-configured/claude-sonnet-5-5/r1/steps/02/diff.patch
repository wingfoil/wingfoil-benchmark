+++ b/test/patch.test.ts
@@ -0,0 +1,113 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, want: unknown) =>
+  assert.deepEqual(applyPatch(doc, patch), want);
+const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch));
+
+// RFC 6902 appendix A examples
+test("A.1 adding an object member", () =>
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" }));
+test("A.2 adding an array element", () =>
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] }));
+test("A.3 removing an object member", () =>
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }));
+test("A.4 removing an array element", () =>
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }));
+test("A.5 replacing a value", () =>
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" }));
+test("A.6 moving a value", () =>
+  ok({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } }));
+test("A.7 moving an array element", () =>
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }],
+    { foo: ["all", "cows", "eat", "grass"] }));
+test("A.8 testing a value: success", () =>
+  ok({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }],
+    { baz: "qux", foo: ["a", 2, "c"] }));
+test("A.9 testing a value: error", () => bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]));
+test("A.10 adding a nested member object", () =>
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } }));
+test("A.12 adding to a nonexistent target", () =>
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]));
+test("A.14 ~ escape ordering", () =>
+  ok({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }));
+test("A.15 comparing strings and numbers", () => bad({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]));
+test("A.16 adding an array value", () =>
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] }));
+
+test("whole-document operations", () => {
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: null }], null);
+  ok({ a: 1 }, [], { a: 1 });
+});
+test("add replaces existing member; null values allowed", () => {
+  ok({ a: 1 }, [{ op: "add", path: "/a", value: null }], { a: null });
+  ok([1], [{ op: "add", path: "/1", value: 2 }], [1, 2]);
+});
+test("array index errors", () => {
+  bad([1], [{ op: "add", path: "/2", value: 0 }]);
+  bad([1], [{ op: "add", path: "/01", value: 0 }]);
+  bad([1], [{ op: "remove", path: "/-" }]);
+  bad([1], [{ op: "replace", path: "/1", value: 0 }]);
+  bad([1], [{ op: "remove", path: "/1" }]);
+});
+test("missing targets fail", () => {
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad({}, [{ op: "test", path: "/a", value: 1 }]);
+  bad({}, [{ op: "copy", from: "/a", path: "/b" }]);
+  bad({}, [{ op: "move", from: "/a", path: "/b" }]);
+});
+test("move: into own child fails, onto itself is a no-op", () => {
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+});
+test("copy is a deep copy", () => {
+  const r = applyPatch({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }, { op: "add", path: "/b/x", value: 2 }]);
+  assert.deepEqual(r, { a: { x: 1 }, b: { x: 2 } });
+});
+test("test compares deeply, object key order irrelevant", () => {
+  ok({ a: { x: [1, { y: 2 }], z: 1 } }, [{ op: "test", path: "/a", value: { z: 1, x: [1, { y: 2 }] } }], { a: { x: [1, { y: 2 }], z: 1 } });
+  bad({ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]);
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: { a: 1 } }]);
+  bad({ a: null }, [{ op: "test", path: "/a", value: 0 }]);
+});
+test("invalid patches", () => {
+  bad({}, {});
+  bad({}, [1]);
+  bad({}, [{ path: "/a" }]);
+  bad({}, [{ op: "add", value: 1 }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "move", path: "/a" }]);
+  bad({}, [{ op: "bogus", path: "/a" }]);
+  bad({}, [{ op: "add", path: "a", value: 1 }]);
+  bad({}, [{ op: "add", path: "/~2", value: 1 }]);
+  bad({}, [{ op: "add", path: 1, value: 1 }]);
+});
+test("inherited members are not targets", () => {
+  bad({}, [{ op: "remove", path: "/constructor" }]);
+  bad({}, [{ op: "test", path: "/toString", value: 1 }]);
+  bad({}, [{ op: "add", path: "/__proto__/x", value: 1 }]);
+});
+test("__proto__ is plain data; no prototype pollution", () => {
+  const r = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as any;
+  assert.equal(Object.getPrototypeOf(r), Object.prototype);
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(r.polluted, undefined);
+  assert.deepEqual(Object.keys(r), ["__proto__"]);
+});
+test("inputs are not mutated", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const patch = [{ op: "add", path: "/a/0", value: { z: 1 } }, { op: "remove", path: "/b/c" }, { op: "copy", from: "/a/0", path: "/d" }];
+  const d0 = JSON.stringify(doc), p0 = JSON.stringify(patch);
+  const r = applyPatch(doc, patch) as any;
+  assert.equal(JSON.stringify(doc), d0);
+  assert.equal(JSON.stringify(patch), p0);
+  r.a[0].z = 5;
+  assert.equal(patch[0].value.z, 1);
+  bad(doc, [{ op: "remove", path: "/a/0" }, { op: "remove", path: "/zzz" }]);
+  assert.equal(JSON.stringify(doc), d0);
+});
