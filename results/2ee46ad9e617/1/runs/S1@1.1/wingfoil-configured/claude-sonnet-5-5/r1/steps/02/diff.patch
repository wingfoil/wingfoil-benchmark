+
+## Request
+
+Implement JSON Patch (RFC 6902). Export `applyPatch(document, patch)` from `src/index.ts`: applies the
+six operations (add, remove, replace, move, copy, test) and returns a new document without mutating
+its input; throws if the patch is invalid or an operation fails.
+
+## Acceptance
+
+- RFC 6902 appendix A examples pass; `-`, whole-document paths, move-into-child, deep `test` equality.
+- Missing `op`/`path`/`from`/`value`, unknown ops and invalid pointers throw.
+- No mutation of document or patch; no prototype pollution. Tests in `test/patch.test.ts`; `npm test` passes (42 tests).
diff --git a/src/index.ts b/src/index.ts
index ea948b77762b40e46367dc1f873d0dd48a5c8e68..516cbf2b8bee2751061c6a272fefb4fe6d422a42 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -53,3 +53,187 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+/** Split a valid JSON Pointer (RFC 6901 section 3) into its decoded reference tokens. */
+function parseTokens(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+const hasOwn = (o: object, key: string): boolean => Object.prototype.hasOwnProperty.call(o, key);
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Set an own member without ever triggering the `__proto__` setter. */
+function setMember(target: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(target, key, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
+
+/** Deep copy of a JSON value; own `__proto__` members stay plain data. */
+function clone<T>(value: T): T {
+  if (Array.isArray(value)) return value.map(clone) as unknown as T;
+  if (isObject(value)) {
+    const out: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(out, key, clone(value[key]));
+    return out as T;
+  }
+  return value;
+}
+
+/** Equality for the `test` operation (RFC 6902 section 4.6). */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((k) => hasOwn(b, k) && jsonEqual(a[k], b[k]))
+    );
+  }
+  return a === b;
+}
+
+/** Walk to the container of the last token; every step must exist. */
+function parentOf(root: unknown, tokens: string[]): unknown {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`Path does not exist: bad array index "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (isObject(current) && hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path does not exist: "${token}"`);
+    }
+  }
+  return current;
+}
+
+/** Read the value at a path; it must exist. */
+function getAt(root: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) return root;
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(last) || Number(last) >= parent.length) {
+      throw new Error(`Path does not exist: bad array index "${last}"`);
+    }
+    return parent[Number(last)];
+  }
+  if (isObject(parent) && hasOwn(parent, last)) return parent[last];
+  throw new Error(`Path does not exist: "${last}"`);
+}
+
+/** Section 4.1 `add`; returns the new root. */
+function addAt(root: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (last === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(last) && Number(last) <= parent.length) {
+      parent.splice(Number(last), 0, value);
+    } else {
+      throw new Error(`Cannot add: bad array index "${last}"`);
+    }
+  } else if (isObject(parent)) {
+    setMember(parent, last, value);
+  } else {
+    throw new Error("Cannot add: parent is not a container");
+  }
+  return root;
+}
+
+/** Section 4.2 `remove`; returns the new root and the removed value. */
+function removeAt(root: unknown, tokens: string[]): { root: unknown; removed: unknown } {
+  if (tokens.length === 0) return { root: null, removed: root };
+  const removed = getAt(root, tokens); // throws if the target does not exist
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete (parent as Record<string, unknown>)[last];
+  return { root, removed };
+}
+
+function requireMember(op: Record<string, unknown>, name: string): void {
+  if (!hasOwn(op, name)) throw new Error(`Invalid patch operation: missing "${name}"`);
+}
+
+/**
+ * Apply a JSON Patch (RFC 6902) to a document and return the result.
+ * The document and the patch are not mutated. Throws if the patch is invalid
+ * or an operation fails; no partial result is returned (section 5).
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new Error("Invalid patch: not an array");
+  let root: unknown = clone(document);
+  for (const op of patch) {
+    if (!isObject(op)) throw new Error("Invalid patch operation: not an object");
+    requireMember(op, "op");
+    requireMember(op, "path");
+    const path = parseTokens(op.path);
+    switch (op.op) {
+      case "add":
+        requireMember(op, "value");
+        root = addAt(root, path, clone(op.value));
+        break;
+      case "remove":
+        root = removeAt(root, path).root;
+        break;
+      case "replace": {
+        requireMember(op, "value");
+        getAt(root, path); // the target must exist (section 4.3)
+        if (path.length === 0) {
+          root = clone(op.value);
+        } else {
+          const parent = parentOf(root, path) as Record<string, unknown> | unknown[];
+          const last = path[path.length - 1];
+          if (Array.isArray(parent)) parent[Number(last)] = clone(op.value);
+          else setMember(parent, last, clone(op.value));
+        }
+        break;
+      }
+      case "move": {
+        requireMember(op, "from");
+        const from = parseTokens(op.from);
+        const value = getAt(root, from);
+        if (from.length < path.length && from.every((t, i) => t === path[i])) {
+          throw new Error("Cannot move a value into one of its children");
+        }
+        root = addAt(removeAt(root, from).root, path, value);
+        break;
+      }
+      case "copy": {
+        requireMember(op, "from");
+        root = addAt(root, path, clone(getAt(root, parseTokens(op.from))));
+        break;
+      }
+      case "test":
+        requireMember(op, "value");
+        if (!jsonEqual(getAt(root, path), op.value)) throw new Error("Test operation failed");
+        break;
+      default:
+        throw new Error(`Invalid patch operation: unknown op "${String(op.op)}"`);
+    }
+  }
+  return root;
+}
