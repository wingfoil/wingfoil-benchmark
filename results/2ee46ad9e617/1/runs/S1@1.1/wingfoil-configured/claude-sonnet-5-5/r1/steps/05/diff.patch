index 84352dd9a02850902ef8f05c350fa2761f9b8c2d..57475184b926551878f43bdf4a35fbf80e93aa03 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -260,3 +260,90 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return out;
 }
+
+type PatchOp = { op: "add" | "remove" | "replace"; path: string; value?: unknown };
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Diff two arrays by longest common subsequence, emitting ops against the evolving array. */
+function diffArrays(a: unknown[], b: unknown[], path: string, ops: PatchOp[]): void {
+  let start = 0;
+  while (start < a.length && start < b.length && jsonEqual(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && jsonEqual(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const n = endA - start;
+  const m = endB - start;
+  // lcs[i][j]: length of the LCS of a[start+i..endA) and b[start+j..endB)
+  const lcs: number[][] = [];
+  for (let i = 0; i <= n; i++) lcs.push(new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(a[start + i], b[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  let idx = start; // position in the array being rewritten
+  let i = 0;
+  let j = 0;
+  while (i < n || j < m) {
+    if (i < n && j < m && jsonEqual(a[start + i], b[start + j])) {
+      idx++;
+      i++;
+      j++;
+      continue;
+    }
+    // A changed block: items dropped from a, items added from b, up to the next common item.
+    const dels: unknown[] = [];
+    const adds: unknown[] = [];
+    while (i < n || j < m) {
+      if (i < n && j < m && jsonEqual(a[start + i], b[start + j])) break;
+      if (j >= m || (i < n && lcs[i + 1][j] >= lcs[i][j + 1])) dels.push(a[start + i++]);
+      else adds.push(b[start + j++]);
+    }
+    const paired = Math.min(dels.length, adds.length);
+    for (let k = 0; k < paired; k++) {
+      diffValues(dels[k], adds[k], `${path}/${idx}`, ops);
+      idx++;
+    }
+    for (let k = paired; k < dels.length; k++) ops.push({ op: "remove", path: `${path}/${idx}` });
+    for (let k = paired; k < adds.length; k++) {
+      ops.push({ op: "add", path: `${path}/${idx}`, value: clone(adds[k]) });
+      idx++;
+    }
+  }
+}
+
+function diffValues(from: unknown, to: unknown, path: string, ops: PatchOp[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (hasOwn(from, key)) diffValues(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Minimal-ish JSON Patch (RFC 6902) turning `from` into `to`; neither input is mutated.
+ * Arrays are diffed by longest common subsequence, so a moved item is a remove plus an add.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOp[] {
+  const ops: PatchOp[] = [];
+  diffValues(from, to, "", ops);
+  return ops;
+}
