index 0000000000000000000000000000000000000000..b95ac54e1d9a806864635848b9c76849cf285ec2
--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,65 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const before = JSON.stringify(from);
+  const patch = createPatch(from, to);
+  assert.equal(JSON.stringify(from), before);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+};
+
+test("identical documents give an empty patch", () => assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []));
+test("one small change is one op", () =>
+  assert.deepEqual(roundTrip({ a: { b: 1, c: [1, 2] }, d: "x" }, { a: { b: 1, c: [1, 3] }, d: "x" }), [
+    { op: "replace", path: "/a/c/1", value: 3 },
+  ]));
+test("object add and remove", () =>
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, c: 3 }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: 3 },
+  ]));
+test("root and type changes", () => {
+  roundTrip(1, { a: 1 });
+  roundTrip({ a: 1 }, [1]);
+  roundTrip([1], null);
+  roundTrip({ a: null }, { a: [] });
+});
+test("array insert", () =>
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 9, 2, 3]), [{ op: "add", path: "/1", value: 9 }]));
+test("array removal", () => assert.deepEqual(roundTrip(["a", "b", "c", "d"], ["a", "c", "d"]), [{ op: "remove", path: "/1" }]));
+test("array append and prepend", () => {
+  assert.deepEqual(roundTrip([1], [1, 2]), [{ op: "add", path: "/1", value: 2 }]);
+  assert.deepEqual(roundTrip([1], [0, 1]), [{ op: "add", path: "/0", value: 0 }]);
+});
+test("array move does not rewrite items between", () => {
+  const from = [{ id: 1 }, { id: 2 }, { id: 3 }, { id: 4 }, { id: 5 }];
+  const patch = roundTrip(from, [{ id: 1 }, { id: 5 }, { id: 2 }, { id: 3 }, { id: 4 }]);
+  assert.equal(patch.length, 2);
+  assert.ok(patch.every((o) => o.op === "add" || o.op === "remove"));
+});
+test("array items changed in place recurse", () =>
+  assert.deepEqual(roundTrip([{ a: 1, b: 1 }, { a: 2 }], [{ a: 1, b: 2 }, { a: 2 }]), [
+    { op: "replace", path: "/0/b", value: 2 },
+  ]));
+test("pointer escaping and prototype-ish keys", () => {
+  roundTrip({ "a/b": 1, "m~n": 2 }, { "a/b": 2, "m~n": 3 });
+  const from = JSON.parse('{"__proto__": {"x": 1}}');
+  const to = JSON.parse('{"__proto__": {"x": 2}, "constructor": 1}');
+  const out = applyPatch(from, createPatch(from, to));
+  assert.equal(JSON.stringify(out), JSON.stringify(to));
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+});
+test("patch does not share structure with inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0].value as { b: number }).b = 5;
+  assert.equal(to.a.b, 1);
+});
+test("randomised round trips", () => {
+  let s = 7;
+  const rnd = (n: number) => ((s = (s * 1103515245 + 12345) % 2147483648), s % n);
+  const arr = () => Array.from({ length: rnd(7) }, () => rnd(4));
+  for (let k = 0; k < 300; k++) roundTrip({ x: arr(), y: [arr(), { z: arr() }] }, { x: arr(), y: [arr(), { z: arr() }] });
+});
