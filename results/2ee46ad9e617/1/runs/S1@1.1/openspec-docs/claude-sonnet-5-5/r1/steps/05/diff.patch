@@ -272,3 +272,94 @@ export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
   }
   return result as JsonValue;
 }
+
+const escapeToken = (token: string): string => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+function diffArrays(a: JsonValue[], b: JsonValue[], path: string, ops: PatchOperation[]): void {
+  let start = 0;
+  while (start < a.length && start < b.length && deepEqual(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && deepEqual(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const n = endA - start;
+  const m = endB - start;
+  // Longest common subsequence of the differing middle parts.
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = deepEqual(a[start + i], b[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  // `pos` is the index in the array being patched at which the current gap begins.
+  let pos = start;
+  let i = 0;
+  let j = 0;
+  const flush = (removed: number, added: number): void => {
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) {
+      diffValues(a[start + i - removed + k], b[start + j - added + k], `${path}/${pos + k}`, ops);
+    }
+    for (let k = paired; k < removed; k++) {
+      ops.push({ op: "remove", path: `${path}/${pos + paired}` });
+    }
+    for (let k = paired; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${pos + k}`, value: structuredClone(b[start + j - added + k]) });
+    }
+    pos += added;
+  };
+  let gapStartI = 0;
+  let gapStartJ = 0;
+  while (i < n || j < m) {
+    if (i < n && j < m && deepEqual(a[start + i], b[start + j]) && lcs[i][j] === lcs[i + 1][j + 1] + 1) {
+      flush(i - gapStartI, j - gapStartJ);
+      i++;
+      j++;
+      pos++;
+      gapStartI = i;
+      gapStartJ = j;
+    } else if (j < m && (i === n || lcs[i][j + 1] >= lcs[i + 1][j])) {
+      j++;
+    } else {
+      i++;
+    }
+  }
+  flush(i - gapStartI, j - gapStartJ);
+}
+
+function diffValues(a: JsonValue, b: JsonValue, path: string, ops: PatchOperation[]): void {
+  if (deepEqual(a, b)) return;
+  if (Array.isArray(a) && Array.isArray(b)) {
+    diffArrays(a, b, path, ops);
+  } else if (isPlainObject(a) && isPlainObject(b)) {
+    for (const key of Object.keys(a)) {
+      if (!has(b, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(b)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (has(a, key)) {
+        diffValues((a as any)[key], (b as any)[key], child, ops);
+      } else {
+        ops.push({ op: "add", path: child, value: structuredClone((b as any)[key]) });
+      }
+    }
+  } else {
+    ops.push({ op: "replace", path, value: structuredClone(b) });
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied.
+ *
+ * Neither input is mutated. Only the parts that differ are described; array items that are
+ * inserted or deleted yield a single add or remove, and a moved item yields a remove and an add.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffValues(from as JsonValue, to as JsonValue, "", ops);
+  return ops;
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1bb0a36421ff1dd9f9ee2f1c8b8841e26b931a63
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,30 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createPatch, applyPatch } from "../src/index.ts";
+
+const check = (from: any, to: any, count?: number) => {
+  const before = structuredClone(from);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, before);
+  assert.deepEqual(applyPatch(from, patch), to);
+  if (count !== undefined) assert.equal(patch.length, count);
+};
+
+test("minimal patches", () => {
+  check({ a: 1, b: { c: [1, 2] } }, { a: 1, b: { c: [1, 2] } }, 0);
+  check({ a: 1, b: { c: 2 } }, { a: 1, b: { c: 3 } }, 1);
+  check({ "a/b": 1, "~": 2 }, { "a/b": 2 }, 2);
+  check([1, 2, 3, 4], [1, 2, 9, 3, 4], 1);
+  check([1, 2, 3, 4], [1, 3, 4], 1);
+  check([1, 2, 3, 4, 5], [1, 5, 2, 3, 4], 2);
+  check([{ a: 1 }, { b: 2 }], [{ a: 1 }, { b: 3 }], 1);
+  check({ a: [1] }, [1], 1);
+  check(null, { a: 1 }, 1);
+});
+
+test("random round trips", () => {
+  for (let t = 0; t < 500; t++) {
+    const r = () => Array.from({ length: Math.floor(Math.random() * 8) }, () => Math.floor(Math.random() * 4));
+    check({ x: r() }, { x: r() });
+  }
+});
