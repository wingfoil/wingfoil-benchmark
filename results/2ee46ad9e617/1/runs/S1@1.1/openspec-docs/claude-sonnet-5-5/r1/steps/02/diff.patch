--- a/src/index.ts
+++ b/src/index.ts
@@ -54,3 +54,185 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; path: string; from: string };
+
+const has = (o: object, k: string): boolean => Object.prototype.hasOwnProperty.call(o, k);
+
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`);
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+function setMember(obj: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty so that a "__proto__" member is an ordinary own property.
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) &&
+      Array.isArray(b) &&
+      a.length === b.length &&
+      a.every((v, i) => deepEqual(v, b[i]))
+    );
+  }
+  if (typeof a === "object" && typeof b === "object" && a !== null && b !== null) {
+    const ka = Object.keys(a);
+    return (
+      ka.length === Object.keys(b).length &&
+      ka.every((k) => has(b, k) && deepEqual((a as any)[k], (b as any)[k]))
+    );
+  }
+  return false;
+}
+
+/** Returns the container holding the target of `tokens` (which must be non-empty). */
+function parentOf(doc: unknown, tokens: string[], path: string): unknown {
+  let current = doc;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`Path "${path}" does not exist: bad array index "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null && has(current, token)) {
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`Path "${path}" does not exist at "${token}"`);
+    }
+  }
+  if (typeof current !== "object" || current === null) {
+    throw new Error(`Path "${path}" does not exist: parent is a scalar`);
+  }
+  return current;
+}
+
+function getAt(doc: unknown, path: string): unknown {
+  return resolvePointer(doc, path);
+}
+
+function addAt(doc: unknown, path: string, value: unknown): unknown {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(doc, tokens, path);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (key === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(key) && Number(key) <= parent.length) {
+      parent.splice(Number(key), 0, value);
+    } else {
+      throw new Error(`Cannot add at "${path}": invalid array index "${key}"`);
+    }
+  } else {
+    setMember(parent as Record<string, unknown>, key, value);
+  }
+  return doc;
+}
+
+function removeAt(doc: unknown, path: string): unknown {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    throw new Error("Cannot remove the document root");
+  }
+  const parent = parentOf(doc, tokens, path);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(key) || Number(key) >= parent.length) {
+      throw new Error(`Cannot remove "${path}": no such array element`);
+    }
+    parent.splice(Number(key), 1);
+  } else {
+    if (!has(parent as object, key)) {
+      throw new Error(`Cannot remove "${path}": no such member`);
+    }
+    delete (parent as Record<string, unknown>)[key];
+  }
+  return doc;
+}
+
+function field(op: Record<string, unknown>, name: string, index: number): string {
+  if (typeof op[name] !== "string") {
+    throw new Error(`Invalid patch: operation ${index} requires a string "${name}"`);
+  }
+  return op[name] as string;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result as a new value.
+ *
+ * The input document and patch are never mutated. Throws if the patch is invalid or an
+ * operation fails (in which case no result is produced).
+ */
+export function applyPatch(document: unknown, patch: unknown): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid patch: not an array");
+  }
+  let doc: unknown = structuredClone(document);
+
+  patch.forEach((raw: unknown, i: number) => {
+    if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+      throw new Error(`Invalid patch: operation ${i} is not an object`);
+    }
+    const op = raw as Record<string, unknown>;
+    const path = field(op, "path", i);
+    const needValue = () => {
+      if (!has(op, "value") || op.value === undefined) {
+        throw new Error(`Invalid patch: operation ${i} requires a "value"`);
+      }
+      return structuredClone(op.value);
+    };
+
+    switch (op.op) {
+      case "add":
+        doc = addAt(doc, path, needValue());
+        break;
+      case "remove":
+        doc = removeAt(doc, path);
+        break;
+      case "replace": {
+        const value = needValue();
+        getAt(doc, path); // target must exist
+        doc = parsePointer(path).length === 0 ? value : addAt(removeAt(doc, path), path, value);
+        // removal+insertion above would shift array elements only if index is in range, which is
+        // guaranteed by the existence check, so the element lands at the same position.
+        break;
+      }
+      case "move": {
+        const from = field(op, "from", i);
+        const value = getAt(doc, from);
+        if (from === path) break;
+        if (path.startsWith(from + "/")) {
+          throw new Error(`Cannot move "${from}" into one of its own children "${path}"`);
+        }
+        doc = addAt(removeAt(doc, from), path, value);
+        break;
+      }
+      case "copy": {
+        const from = field(op, "from", i);
+        doc = addAt(doc, path, structuredClone(getAt(doc, from)));
+        break;
+      }
+      case "test":
+        if (!deepEqual(getAt(doc, path), needValue())) {
+          throw new Error(`Test failed at "${path}"`);
+        }
+        break;
+      default:
+        throw new Error(`Invalid patch: operation ${i} has unknown "op"`);
+    }
+  });
+  return doc as JsonValue;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b385396f51f9fc691fe4dc949ed3cbad17f461e0
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,58 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (d: unknown, p: unknown, e: unknown) => assert.deepEqual(applyPatch(d, p), e);
+const bad = (d: unknown, p: unknown) => assert.throws(() => applyPatch(d, p));
+
+test("add", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }], { foo: [1, 2] });
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  bad({ foo: [1] }, [{ op: "add", path: "/foo/3", value: 2 }]);
+  bad({ foo: "bar" }, [{ op: "add", path: "/a/b", value: 1 }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+});
+
+test("remove / replace", () => {
+  ok({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }], { b: 2 });
+  ok({ a: [1, 2, 3] }, [{ op: "remove", path: "/a/1" }], { a: [1, 3] });
+  bad({}, [{ op: "remove", path: "/a" }]);
+  ok({ a: [1, 2, 3] }, [{ op: "replace", path: "/a/1", value: 9 }], { a: [1, 9, 3] });
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad({ a: [1] }, [{ op: "replace", path: "/a/-", value: 1 }]);
+});
+
+test("move / copy", () => {
+  ok({ a: { b: 1 }, c: [1, 2] }, [{ op: "move", from: "/a/b", path: "/c/1" }], { a: {}, c: [1, 1, 2] });
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  const d = { a: { x: 1 } };
+  const r = applyPatch(d, [{ op: "copy", from: "/a", path: "/b" }]) as any;
+  r.b.x = 2;
+  assert.deepEqual(d, { a: { x: 1 } });
+  assert.equal(r.a.x, 1);
+  bad({}, [{ op: "copy", from: "/a", path: "/b" }]);
+});
+
+test("test", () => {
+  ok({ a: { x: 1, y: [1] } }, [{ op: "test", path: "/a", value: { y: [1], x: 1 } }], { a: { x: 1, y: [1] } });
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+  bad({ a: 1 }, [{ op: "test", path: "/b", value: null }]);
+  ok({ a: null }, [{ op: "test", path: "/a", value: null }], { a: null });
+});
+
+test("invalid patches and immutability", () => {
+  bad({}, {});
+  bad({}, [null]);
+  bad({}, [{ op: "nope", path: "" }]);
+  bad({}, [{ op: "add", value: 1 }]);
+  bad({ a: 1 }, [{ op: "move", path: "/b" }]);
+  const d = { a: [1] };
+  bad(d, [{ op: "add", path: "/a/-", value: 2 }, { op: "remove", path: "/zz" }]);
+  assert.deepEqual(d, { a: [1] });
+  const p = JSON.parse('{"__proto__": 1}');
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: p }]) as any;
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+});
