@@ -0,0 +1,21 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createPatch, applyPatch } from "../src/index.ts";
+
+test("createPatch round-trips and is minimal", () => {
+  const cases: [unknown, unknown, number][] = [
+    [{ a: 1, b: { c: [1, 2] } }, { a: 1, b: { c: [1, 2] } }, 0],
+    [{ a: 1, b: { c: 2 } }, { a: 1, b: { c: 3 } }, 1],
+    [[1, 2, 3, 4, 5], [1, 2, 9, 3, 4, 5], 1],
+    [[1, 2, 3, 4, 5], [1, 2, 4, 5], 1],
+    [[1, 2, 3, 4], [2, 3, 4, 1], 2],
+    [{ "a/b": 1, "~": 2 }, { "a/b": 2 }, 2],
+  ];
+  for (const [from, to, count] of cases) {
+    const before = JSON.stringify(from);
+    const patch = createPatch(from, to);
+    assert.equal(patch.length, count);
+    assert.deepEqual(applyPatch(from, patch), to);
+    assert.equal(JSON.stringify(from), before);
+  }
+});
