index fe64d8d236516d2e4ecc70daf775af7c5d46aa5b..174f8210f9fb19d5bad20a3ae844b0702de7ecba 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -210,3 +210,21 @@ export function applyPatch(document: unknown, patch: unknown): JsonValue {
   }
   return doc;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the result as a new value.
+ * The inputs are not mutated. A non-object patch replaces the target; a null member deletes it.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
+  if (!isObject(patch)) return clone(patch);
+  const result: Record<string, JsonValue> = isObject(target) ? (clone(target) as Record<string, JsonValue>) : {};
+  for (const key of Object.keys(patch)) {
+    const value = (patch as Record<string, unknown>)[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0cf985d0f7edd5d5e9d18c86f255b42480793f31
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,39 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 section 3 example", () => {
+  const target = { a: "b", c: { d: "e", f: "g" } };
+  const patch = { a: "z", c: { f: null } };
+  assert.deepEqual(applyMergePatch(target, patch), { a: "z", c: { d: "e" } });
+  assert.deepEqual(target, { a: "b", c: { d: "e", f: "g" } });
+});
+
+test("RFC 7386 appendix A cases", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, r] of cases) assert.deepEqual(applyMergePatch(t, p), r);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const patch = JSON.parse('{"__proto__": {"x": 1}}');
+  const out = applyMergePatch({}, patch) as Record<string, unknown>;
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+});
