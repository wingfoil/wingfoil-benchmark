+++ b/test/pointer.test.ts
@@ -0,0 +1,88 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { resolvePointer, JsonPointerError } from "../src/index.ts";
+
+// RFC 6901 section 5 example document
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.strictEqual(resolvePointer(doc, ""), doc);
+  assert.deepStrictEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.strictEqual(resolvePointer(doc, "/foo/0"), "bar");
+  assert.strictEqual(resolvePointer(doc, "/"), 0);
+  assert.strictEqual(resolvePointer(doc, "/a~1b"), 1);
+  assert.strictEqual(resolvePointer(doc, "/c%d"), 2);
+  assert.strictEqual(resolvePointer(doc, "/e^f"), 3);
+  assert.strictEqual(resolvePointer(doc, "/g|h"), 4);
+  assert.strictEqual(resolvePointer(doc, "/i\\j"), 5);
+  assert.strictEqual(resolvePointer(doc, '/k"l'), 6);
+  assert.strictEqual(resolvePointer(doc, "/ "), 7);
+  assert.strictEqual(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("escape order: ~01 is the key ~1, not /", () => {
+  assert.strictEqual(resolvePointer({ "~1": "x", "~/": "y" }, "/~01"), "x");
+  assert.strictEqual(resolvePointer({ "~/": "y" }, "/~0~1"), "y");
+});
+
+test("root can be any JSON value", () => {
+  assert.strictEqual(resolvePointer(null, ""), null);
+  assert.strictEqual(resolvePointer(5, ""), 5);
+  assert.strictEqual(resolvePointer("s", ""), "s");
+});
+
+test("null value is a value; missing is an error", () => {
+  assert.strictEqual(resolvePointer({ a: null }, "/a"), null);
+  assert.throws(() => resolvePointer({ a: null }, "/b"), JsonPointerError);
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"), JsonPointerError);
+});
+
+test("invalid pointer syntax", () => {
+  for (const p of ["foo", "a/b", "/~", "/~2", "/a~", "/~a", " "]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), JsonPointerError, p);
+  }
+  assert.throws(() => resolvePointer({}, 1 as unknown as string), JsonPointerError);
+});
+
+test("array indices", () => {
+  const a = { l: [10, 20, 30] };
+  assert.strictEqual(resolvePointer(a, "/l/2"), 30);
+  assert.throws(() => resolvePointer(a, "/l/3"), JsonPointerError);
+  assert.throws(() => resolvePointer(a, "/l/-"), JsonPointerError);
+  assert.throws(() => resolvePointer(a, "/l/01"), JsonPointerError);
+  assert.throws(() => resolvePointer(a, "/l/+1"), JsonPointerError);
+  assert.throws(() => resolvePointer(a, "/l/-1"), JsonPointerError);
+  assert.throws(() => resolvePointer(a, "/l/1.0"), JsonPointerError);
+  assert.throws(() => resolvePointer(a, "/l/"), JsonPointerError);
+  assert.throws(() => resolvePointer(a, "/l/length"), JsonPointerError);
+  assert.strictEqual(resolvePointer([[1]], "/0/0"), 1);
+});
+
+test("numeric-looking keys on objects are plain keys", () => {
+  assert.strictEqual(resolvePointer({ "0": "z", "01": "y" }, "/01"), "y");
+});
+
+test("does not resolve inherited properties", () => {
+  for (const p of ["/__proto__", "/constructor", "/toString", "/constructor/prototype", "/__proto__/x"]) {
+    assert.throws(() => resolvePointer({}, p), JsonPointerError, p);
+  }
+  assert.strictEqual(resolvePointer(JSON.parse('{"__proto__": 1}'), "/__proto__"), 1);
+});
+
+test("does not mutate the document", () => {
+  const d = { a: [1, { b: 2 }] };
+  const copy = structuredClone(d);
+  resolvePointer(d, "/a/1/b");
+  assert.deepStrictEqual(d, copy);
+});
