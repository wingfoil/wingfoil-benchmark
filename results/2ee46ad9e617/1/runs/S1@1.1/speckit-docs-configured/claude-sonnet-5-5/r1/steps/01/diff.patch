+/** Error thrown for an invalid JSON Pointer or one that does not resolve (RFC 6901). */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+/** Decodes one reference token (RFC 6901 section 4): `~1` -> `/` first, then `~0` -> `~`. */
+function decodeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new JsonPointerError(`Invalid escape in reference token "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/**
+ * Resolves a JSON Pointer against a JSON document.
+ *
+ * Implements JSON Pointer, RFC 6901: syntax (section 3), evaluation (section 4) and
+ * string representation (section 5). The empty pointer refers to the whole document.
+ * Array indices must be `0` or digits without a leading zero; `-` (section 4, the
+ * nonexistent element past the end) never resolves. Only own properties are followed.
+ * The document is not modified.
+ *
+ * @throws {JsonPointerError} if the pointer is not valid, or does not resolve to a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return document;
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+
+  let current = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new JsonPointerError(`Invalid array index "${token}"`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new JsonPointerError(`Array index ${token} is out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new JsonPointerError(`No member "${token}" in object`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Cannot resolve "${token}" in a non-container value`);
+    }
+  }
+  return current;
+}
