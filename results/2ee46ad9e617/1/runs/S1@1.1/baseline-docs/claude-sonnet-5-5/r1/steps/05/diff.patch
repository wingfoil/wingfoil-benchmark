diff --git a/README.md b/README.md
index 4d760c578188739501455f61bb911cb15ca779b4..e7e28da8acd94fcf3b99b16c98d84a8dd876c1f3 100644
--- a/README.md
+++ b/README.md
@@ -33,3 +33,14 @@ primitives replace). A patch that is not an object replaces the whole target, an
 object is treated as empty when an object patch is applied. Since `null` always means removal, a merge patch
 cannot set a member to `null`. The inputs are never mutated and the result shares no structure with them; it
 throws an `Error` if the patch is not a JSON value (`undefined`, `NaN`, functions, class instances, ...).
+
+## Creating a JSON Patch (RFC 6902)
+
+`createPatch(from, to)`, exported from `src/index.ts`, returns a JSON Patch that turns `from` into `to` when
+given to `applyPatch`, and describes only what changed. Objects are compared member by member (missing
+members are removed, new ones added, shared ones compared recursively) and a value that differs in kind or
+primitive value is replaced. Arrays are aligned on their longest common run of equal items, so a gained or
+lost item is a single `add` or `remove` and the items around it are left alone; an item that moves is removed
+and added back, and items replaced in the same spot are patched in place. Equal documents give an empty
+patch. The inputs are never mutated and the patch shares no structure with them; it throws an `Error` if
+`from` or `to` is not a JSON value.
diff --git a/src/index.ts b/src/index.ts
index 4bc347539c8183543154bc9f31c6328937ea7394..083490e5fc018b87ff36d85a03c755fc5282d958 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -278,3 +278,116 @@ export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue
   }
   return mergeValue(target, patch);
 }
+
+/** Escapes one reference token for use in a JSON Pointer (RFC 6901, section 3). */
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/**
+ * Computes which items of `from` and `to` form a longest common subsequence, as matched index pairs
+ * in increasing order.
+ */
+function commonItems(from: JsonValue[], to: JsonValue[]): Array<[number, number]> {
+  const lengths = Array.from({ length: from.length + 1 }, () => new Array<number>(to.length + 1).fill(0));
+  for (let i = from.length - 1; i >= 0; i--) {
+    for (let j = to.length - 1; j >= 0; j--) {
+      lengths[i][j] = jsonEqual(from[i], to[j]) ? lengths[i + 1][j + 1] + 1 : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  const pairs: Array<[number, number]> = [];
+  let i = 0;
+  let j = 0;
+  while (i < from.length && j < to.length) {
+    if (jsonEqual(from[i], to[j])) {
+      pairs.push([i++, j++]);
+    } else if (lengths[i + 1][j] >= lengths[i][j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
+
+/** Appends the operations turning the array `from` into `to`, keeping their common items untouched. */
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, patch: PatchOperation[]): void {
+  let cursor = 0; // index in the array being transformed, whose first `cursor` items already equal those of `to`
+  let fromIndex = 0;
+  let toIndex = 0;
+  const diffGap = (fromEnd: number, toEnd: number): void => {
+    const removed = fromEnd - fromIndex;
+    const added = toEnd - toIndex;
+    const paired = Math.min(removed, added);
+    for (let n = 0; n < paired; n++) {
+      diffValues(from[fromIndex + n], to[toIndex + n], `${path}/${cursor++}`, patch);
+    }
+    for (let n = paired; n < removed; n++) {
+      patch.push({ op: "remove", path: `${path}/${cursor}` });
+    }
+    for (let n = paired; n < added; n++) {
+      patch.push({ op: "add", path: `${path}/${cursor++}`, value: clone(to[toIndex + n]) });
+    }
+    fromIndex = fromEnd;
+    toIndex = toEnd;
+  };
+  for (const [i, j] of [...commonItems(from, to), [from.length, to.length] as [number, number]]) {
+    diffGap(i, j);
+    fromIndex++;
+    toIndex++;
+    cursor++;
+  }
+}
+
+/** Appends the operations turning the object `from` into `to`, member by member. */
+function diffObjects(
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  path: string,
+  patch: PatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      patch.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const memberPath = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) {
+      diffValues(from[key], to[key], memberPath, patch);
+    } else {
+      patch.push({ op: "add", path: memberPath, value: clone(to[key]) });
+    }
+  }
+}
+
+/** Appends the operations turning `from` into `to`, both found at `path`; nothing if they are equal. */
+function diffValues(from: JsonValue, to: JsonValue, path: string, patch: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, patch);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from, to, path, patch);
+  } else if (!jsonEqual(from, to)) {
+    patch.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ * The patch only touches what differs: unchanged members and array items are left out, an array item
+ * gained or lost is added or removed, and an item that moves is removed and added back. The inputs are
+ * never mutated and the patch shares no structure with them.
+ *
+ * @param from - the original parsed JSON document.
+ * @param to - the new parsed JSON document.
+ * @returns the patch operations; empty when the documents are equal.
+ * @throws Error if `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new Error("Cannot create a JSON Patch: both documents must be JSON values");
+  }
+  const patch: PatchOperation[] = [];
+  diffValues(from, to, "", patch);
+  return patch;
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6ed8c5ab94a73e2e54fa64ce8410e62a35ee8a18
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,84 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const create = (from: unknown, to: unknown) => createPatch(from as never, to as never);
+
+/** Asserts the patch round-trips from -> to and returns it. */
+function roundTrip(from: unknown, to: unknown) {
+  const patch = create(from, to);
+  assert.deepEqual(applyPatch(from as never, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(create({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+  assert.deepEqual(create(1, 1), []);
+});
+
+test("a small change in a large document touches only that place", () => {
+  const from = { a: { b: { c: 1, d: [1, 2, 3] } }, e: "x" };
+  const to = { a: { b: { c: 2, d: [1, 2, 3] } }, e: "x" };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/c", value: 2 }]);
+});
+
+test("object members are added, removed and escaped", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, c: 3 }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+  assert.deepEqual(roundTrip({ "a/b": 1, "m~n": 1 }, { "a/b": 2, "m~n": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/m~0n", value: 2 },
+  ]);
+  roundTrip({}, { __proto__x: 1 });
+});
+
+test("null, type changes and the root", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+  assert.deepEqual(roundTrip({ a: [1] }, { a: { 0: 1 } }), [{ op: "replace", path: "/a", value: { 0: 1 } }]);
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+});
+
+test("an array item gained or lost is added or removed only", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(roundTrip([{ a: 1 }, { b: 2 }], [{ b: 2 }]), [{ op: "remove", path: "/0" }]);
+});
+
+test("a moved array item does not rewrite the items in between", () => {
+  const patch = roundTrip([1, 2, 3, 4, 5], [2, 3, 4, 1, 5]);
+  assert.equal(patch.length, 2);
+  assert.ok(patch.every((op) => op.op === "add" || op.op === "remove" || op.op === "move"));
+  assert.equal(roundTrip([1, 2, 3, 4, 5], [1, 5, 2, 3, 4]).length, 2);
+});
+
+test("a changed array item is patched in place", () => {
+  assert.deepEqual(roundTrip([{ a: 1, b: 1 }, { a: 2, b: 2 }], [{ a: 1, b: 1 }, { a: 2, b: 3 }]), [
+    { op: "replace", path: "/1/b", value: 3 },
+  ]);
+});
+
+test("mixed array edits round-trip", () => {
+  roundTrip([1, [2, 3], { a: 1 }, 4, 5], [0, [2, 3, 4], 4, { a: 2 }, 6, 7]);
+  roundTrip([], [1, 2]);
+  roundTrip([1, 2], []);
+});
+
+test("inputs are not mutated and the patch shares no structure with them", () => {
+  const from = { a: [1], c: 1 };
+  const to = { a: [1], b: { x: [1] } };
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = create(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  assert.notEqual(patch[1].value, to.b);
+});
+
+test("non-JSON documents are rejected", () => {
+  assert.throws(() => create(undefined, 1));
+  assert.throws(() => create({}, { a: NaN }));
+});
