index 0000000000000000000000000000000000000000..dca7b89e26c7040c05c8a4e813d3805b03056a79
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,66 @@
+/** A parsed JSON value: any value a JSON document can hold. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/**
+ * Splits a JSON Pointer into its unescaped reference tokens (RFC 6901, section 3).
+ * Throws if the pointer is not syntactically valid.
+ */
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: must be a string");
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer ${JSON.stringify(pointer)}: must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new Error(`Invalid JSON Pointer ${JSON.stringify(pointer)}: "~" must be followed by "0" or "1"`);
+      }
+      // "~1" must be decoded before "~0" so that "~01" yields "~1" (RFC 6901, section 4).
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/** Evaluates one reference token against a value (RFC 6901, section 4). */
+function step(current: JsonValue, token: string, pointer: string): JsonValue {
+  const fail = (): never => {
+    throw new Error(`JSON Pointer ${JSON.stringify(pointer)} does not resolve to a value of the document`);
+  };
+  if (Array.isArray(current)) {
+    // "-" designates the nonexistent element after the last one, so it never resolves.
+    if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+      return fail();
+    }
+    return current[Number(token)];
+  }
+  // Own properties only: inherited ones such as "constructor" are not document members.
+  if (typeof current === "object" && current !== null && Object.hasOwn(current, token)) {
+    return current[token];
+  }
+  return fail();
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer `pointer` refers to (RFC 6901).
+ *
+ * @param document - a parsed JSON document.
+ * @param pointer - a JSON Pointer string, such as `"/foo/0"`; `""` refers to the whole document.
+ * @throws Error if `pointer` is not a valid JSON Pointer, or does not resolve to a value of `document`.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  return parsePointer(pointer).reduce((current, token) => step(current, token, pointer), document);
+}
