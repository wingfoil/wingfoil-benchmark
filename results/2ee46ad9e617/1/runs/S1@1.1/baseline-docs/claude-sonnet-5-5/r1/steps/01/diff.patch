+++ b/test/pointer.test.ts
@@ -0,0 +1,89 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// The example document of RFC 6901, section 5.
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+const examples: [string, unknown][] = [
+  ["", rfc],
+  ["/foo", ["bar", "baz"]],
+  ["/foo/0", "bar"],
+  ["/", 0],
+  ["/a~1b", 1],
+  ["/c%d", 2],
+  ["/e^f", 3],
+  ["/g|h", 4],
+  ["/i\\j", 5],
+  ['/k"l', 6],
+  ["/ ", 7],
+  ["/m~0n", 8],
+];
+
+for (const [pointer, expected] of examples) {
+  test(`RFC 6901 example ${JSON.stringify(pointer)}`, () => {
+    assert.deepEqual(resolvePointer(rfc, pointer), expected);
+  });
+}
+
+test("resolves falsy and null values", () => {
+  const doc = { a: null, b: false, c: "", d: [0] };
+  assert.equal(resolvePointer(doc, "/a"), null);
+  assert.equal(resolvePointer(doc, "/b"), false);
+  assert.equal(resolvePointer(doc, "/c"), "");
+  assert.equal(resolvePointer(doc, "/d/0"), 0);
+});
+
+test("the empty pointer refers to any document, including primitives", () => {
+  assert.equal(resolvePointer(null, ""), null);
+  assert.equal(resolvePointer(3, ""), 3);
+});
+
+test("unescapes ~01 as ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("rejects syntactically invalid pointers", () => {
+  for (const pointer of ["foo", "a/b", "/a~", "/a~2", "/~x", "#/a"]) {
+    assert.throws(() => resolvePointer({}, pointer), /invalid/i, pointer);
+  }
+});
+
+test("rejects non-string pointers", () => {
+  assert.throws(() => resolvePointer({}, undefined as unknown as string), /invalid/i);
+});
+
+test("throws when a member is missing", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"), /not resolve/i);
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"), /not resolve/i);
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"), /not resolve/i);
+});
+
+test("does not resolve inherited properties", () => {
+  for (const pointer of ["/__proto__", "/constructor", "/toString", "/foo/length"]) {
+    assert.throws(() => resolvePointer({ foo: [] }, pointer), /not resolve/i, pointer);
+  }
+});
+
+test("resolves an own member named __proto__", () => {
+  const doc = JSON.parse('{"__proto__": 1}');
+  assert.equal(resolvePointer(doc, "/__proto__"), 1);
+});
+
+test("throws on out-of-range, '-' and malformed array indexes", () => {
+  const doc = { a: ["x", "y"] };
+  for (const pointer of ["/a/2", "/a/-", "/a/01", "/a/+1", "/a/1.0", "/a/-1", "/a/ 1", "/a/", "/a/length"]) {
+    assert.throws(() => resolvePointer(doc, pointer), /not resolve/i, pointer);
+  }
+});
