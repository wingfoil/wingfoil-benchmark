index 01230c6ab09654926c0933fb7f6b22c94a0a0d00..e759784e502cdb7bd09bf84f9a750152c89043ed 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -234,3 +234,92 @@ export function applyMergePatch(target: unknown, patch: unknown): Json {
   }
   return result;
 }
+
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: Json }
+  | { op: "remove"; path: string };
+
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(a: Json[], b: Json[], path: string, out: PatchOperation[]): void {
+  let start = 0;
+  while (start < a.length && start < b.length && deepEqual(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && deepEqual(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const n = endA - start;
+  const m = endB - start;
+  // Longest common subsequence of the middle parts, as a table of suffix lengths.
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = deepEqual(a[start + i], b[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  // Walk the gaps between matched items; `b` indexes are the positions in the array being patched.
+  const gap = (fromA: number, toA: number, fromB: number, toB: number) => {
+    const removed = toA - fromA;
+    const added = toB - fromB;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) diffValues(a[fromA + k], b[fromB + k], `${path}/${fromB + k}`, out);
+    for (let k = paired; k < removed; k++) out.push({ op: "remove", path: `${path}/${fromB + paired}` });
+    for (let k = paired; k < added; k++) {
+      out.push({ op: "add", path: `${path}/${fromB + k}`, value: clone(b[fromB + k]) });
+    }
+  };
+  let i = 0;
+  let j = 0;
+  let lastA = start;
+  let lastB = start;
+  while (i < n && j < m) {
+    if (deepEqual(a[start + i], b[start + j])) {
+      gap(lastA, start + i, lastB, start + j);
+      i++;
+      j++;
+      lastA = start + i;
+      lastB = start + j;
+    } else if (lcs[i + 1][j] >= lcs[i][j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  gap(lastA, endA, lastB, endB);
+}
+
+function diffValues(from: Json, to: Json, path: string, out: PatchOperation[]): void {
+  if (deepEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!hasOwn(to, key)) out.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${encodeToken(key)}`;
+      if (!hasOwn(from, key)) out.push({ op: "add", path: child, value: clone(to[key]) });
+      else diffValues(from[key], to[key], child, out);
+    }
+  } else {
+    out.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Produce a JSON Patch (RFC 6902) that turns `from` into `to` when applied.
+ * The patch is minimal in structure: only changed members and array items are touched. Array items that
+ * are added, removed or moved yield `add`/`remove` operations, not rewrites of the items around them.
+ * Neither argument is modified.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diffValues(clone(from), clone(to), "", out);
+  return out;
+}
