+
+test("RFC 6902 operations", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(applyPatch({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(applyPatch([1, 2, 3], [{ op: "remove", path: "/1" }]), [1, 3]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch([1, 2], [{ op: "replace", path: "/1", value: 9 }]), [1, 9]);
+  assert.deepEqual(applyPatch({ a: { b: 1 }, c: {} }, [{ op: "move", from: "/a/b", path: "/c/d" }]), { a: {}, c: { d: 1 } });
+  assert.deepEqual(applyPatch([1, 2, 3], [{ op: "move", from: "/0", path: "/2" }]), [2, 3, 1]);
+  assert.deepEqual(applyPatch({ a: [1] }, [{ op: "copy", from: "/a", path: "/b" }]), { a: [1], b: [1] });
+  assert.deepEqual(applyPatch({ a: { x: 1, y: 2 } }, [{ op: "test", path: "/a", value: { y: 2, x: 1 } }]), { a: { x: 1, y: 2 } });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch({ a: 1 }, []), { a: 1 });
+});
+
+test("applyPatch does not mutate or alias", () => {
+  const input = { a: { b: [1] } };
+  const value = { z: 1 };
+  const out = applyPatch(input, [{ op: "add", path: "/c", value }, { op: "copy", from: "/a", path: "/d" }, { op: "remove", path: "/a/b/0" }]) as any;
+  assert.deepEqual(input, { a: { b: [1] } });
+  assert.notEqual(out.c, value);
+  assert.deepEqual(out.d, { b: [1] });
+  assert.deepEqual(out.a, { b: [] });
+});
+
+test("applyPatch errors", () => {
+  const bad: [unknown, unknown][] = [
+    [{}, {}],
+    [{}, [1]],
+    [{}, [{ op: "nope", path: "/a" }]],
+    [{}, [{ op: "add", path: "/a" }]],
+    [{}, [{ op: "add", value: 1 }]],
+    [{}, [{ op: "move", path: "/a" }]],
+    [{}, [{ op: "remove", path: "/a" }]],
+    [{}, [{ op: "replace", path: "/a", value: 1 }]],
+    [{}, [{ op: "add", path: "/a/b", value: 1 }]],
+    [[1], [{ op: "add", path: "/2", value: 1 }]],
+    [[1], [{ op: "add", path: "/01", value: 1 }]],
+    [[1], [{ op: "remove", path: "/-" }]],
+    [[1], [{ op: "replace", path: "/1", value: 1 }]],
+    [{ a: 1 }, [{ op: "test", path: "/a", value: 2 }]],
+    [{ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]],
+    [{ a: 1 }, [{ op: "copy", from: "/x", path: "/y" }]],
+    [{ a: 1 }, [{ op: "remove", path: "" }]],
+    [{ a: 1 }, [{ op: "add", path: "a", value: 1 }]],
+    [{ a: 1 }, [{ op: "add", path: "/b", value: 1 }, { op: "remove", path: "/zz" }]],
+  ];
+  for (const [d, p] of bad) assert.throws(() => applyPatch(d, p), Error, JSON.stringify(p));
+});
+
+test("applyPatch is safe with __proto__ and inherited keys", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as any;
+  assert.equal(({} as any).x, undefined);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/toString" }]));
+});
diff --git a/src/index.ts b/src/index.ts
index c6e5ebcb6c1a337bcf5dca7eb0469a8eae74f5f8..a7f9adbf997d6fa1a717966f6dd24d8529fd6023 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -43,3 +43,171 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+function parsePointer(pointer: unknown, what: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error(`Invalid JSON Patch: "${what}" must be a string`);
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  return pointer.slice(1).split("/").map(decodeToken);
+}
+
+function isObject(value: unknown): value is { [key: string]: Json } {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function hasOwn(object: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(object, key);
+}
+
+function setMember(object: { [key: string]: Json }, key: string, value: Json): void {
+  Object.defineProperty(object, key, { value, enumerable: true, writable: true, configurable: true });
+}
+
+function clone(value: unknown): Json {
+  if (Array.isArray(value)) return value.map(clone);
+  if (isObject(value)) {
+    const copy: { [key: string]: Json } = {};
+    for (const key of Object.keys(value)) setMember(copy, key, clone(value[key]));
+    return copy;
+  }
+  return value as Json;
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => deepEqual(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length &&
+      keys.every((key) => hasOwn(b, key) && deepEqual(a[key], b[key]));
+  }
+  return a === b;
+}
+
+const INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Walk to the parent of the target; the parent must exist. */
+function parentOf(root: Json, tokens: string[]): Json {
+  let current: Json = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`JSON Patch: path does not resolve at "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (isObject(current) && hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`JSON Patch: path does not resolve at "${token}"`);
+    }
+  }
+  return current;
+}
+
+function getValue(root: Json, tokens: string[]): Json {
+  if (tokens.length === 0) return root;
+  const parent = parentOf(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!INDEX.test(key) || Number(key) >= parent.length) {
+      throw new Error(`JSON Patch: no element at "${key}"`);
+    }
+    return parent[Number(key)];
+  }
+  if (isObject(parent) && hasOwn(parent, key)) return parent[key];
+  throw new Error(`JSON Patch: no member "${key}"`);
+}
+
+function addValue(root: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (key === "-") {
+      parent.push(value);
+    } else if (INDEX.test(key) && Number(key) <= parent.length) {
+      parent.splice(Number(key), 0, value);
+    } else {
+      throw new Error(`JSON Patch: invalid array index "${key}"`);
+    }
+  } else if (isObject(parent)) {
+    setMember(parent, key, value);
+  } else {
+    throw new Error(`JSON Patch: cannot add into a scalar at "${key}"`);
+  }
+  return root;
+}
+
+function removeValue(root: Json, tokens: string[]): Json {
+  if (tokens.length === 0) throw new Error("JSON Patch: cannot remove the document root");
+  getValue(root, tokens); // the target must exist
+  const parent = parentOf(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(key), 1);
+  else delete (parent as { [key: string]: Json })[key];
+  return root;
+}
+
+/**
+ * Apply a JSON Patch (RFC 6902) to a document and return the result as a new value.
+ * Neither the document nor the patch is mutated. Throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): Json {
+  if (!Array.isArray(patch)) throw new Error("Invalid JSON Patch: not an array");
+  let result = clone(document);
+  for (const operation of patch) {
+    if (!isObject(operation as unknown)) throw new Error("Invalid JSON Patch: operation is not an object");
+    const op = operation as { [key: string]: Json };
+    const path = parsePointer(op.path, "path");
+    const needValue = () => {
+      if (!hasOwn(op, "value")) throw new Error(`Invalid JSON Patch: "${op.op}" requires "value"`);
+      return clone(op.value);
+    };
+    switch (op.op) {
+      case "add":
+        result = addValue(result, path, needValue());
+        break;
+      case "remove":
+        result = removeValue(result, path);
+        break;
+      case "replace": {
+        const value = needValue();
+        if (path.length === 0) {
+          result = value;
+        } else {
+          getValue(result, path); // the target must exist
+          result = removeValue(result, path);
+          result = addValue(result, path, value);
+        }
+        break;
+      }
+      case "move":
+      case "copy": {
+        const from = parsePointer(op.from, "from");
+        const value = clone(getValue(result, from));
+        if (op.op === "move") {
+          if (from.length < path.length && from.every((token, i) => token === path[i])) {
+            throw new Error("JSON Patch: cannot move a value into one of its children");
+          }
+          result = removeValue(result, from);
+        }
+        result = addValue(result, path, value);
+        break;
+      }
+      case "test":
+        if (!deepEqual(getValue(result, path), needValue())) {
+          throw new Error(`JSON Patch: test failed at "${op.path}"`);
+        }
+        break;
+      default:
+        throw new Error(`Invalid JSON Patch: unknown op ${JSON.stringify(op.op)}`);
+    }
+  }
+  return result;
+}
