+
+test("replace and self-move keep member order", () => {
+  assert.equal(JSON.stringify(applyPatch({ a: 1, b: 2 }, [{ op: "replace", path: "/a", value: 3 }])), '{"a":3,"b":2}');
+  assert.equal(JSON.stringify(applyPatch({ a: 1, b: 2 }, [{ op: "move", from: "/a", path: "/a" }])), '{"a":1,"b":2}');
+});
