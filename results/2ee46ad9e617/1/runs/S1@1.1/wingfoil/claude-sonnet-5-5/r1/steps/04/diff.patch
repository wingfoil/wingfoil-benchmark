+
+/**
+ * Apply a JSON Merge Patch (RFC 7386) to a target document and return the merged document.
+ * Neither argument is modified.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): Json {
+  if (!isObject(patch)) return clone(patch);
+  const result: { [key: string]: Json } = isObject(target) ? (clone(target) as { [key: string]: Json }) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
