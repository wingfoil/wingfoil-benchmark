--- /dev/null
+++ b/test/json-patch.test.ts
@@ -0,0 +1,140 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, JsonPatchError } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) =>
+  assert.deepEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) =>
+  assert.throws(() => applyPatch(doc, patch), JsonPatchError);
+
+test("patch shape validation", () => {
+  for (const p of [{}, null, "x", undefined]) bad({}, p);
+  for (const o of [null, [], 5, "x"]) bad({}, [o]);
+  for (const op of [undefined, 1, "merge", "ADD"]) bad({}, [{ op, path: "/a", value: 1 }]);
+  for (const path of [undefined, 1, "a", "/a~2"]) bad({}, [{ op: "add", path, value: 1 }]);
+  for (const op of ["add", "replace", "test"]) bad({ a: 1 }, [{ op, path: "/a" }]);
+  for (const op of ["move", "copy"]) {
+    bad({ a: 1 }, [{ op, path: "/b" }]);
+    bad({ a: 1 }, [{ op, path: "/b", from: 1 }]);
+    bad({ a: 1 }, [{ op, path: "/b", from: "a" }]);
+  }
+  bad({}, [{ op: "remove" }]);
+});
+
+test("null value, extra members, empty patch", () => {
+  ok({}, [{ op: "add", path: "/a", value: null }], { a: null });
+  ok({}, [{ op: "add", path: "/a", value: 1, comment: "x" }], { a: 1 });
+  ok({ a: [1] }, [], { a: [1] });
+});
+
+test("non-mutating, atomic, no aliasing", () => {
+  const doc = { a: { b: [1, 2] } };
+  const snap = structuredClone(doc);
+  const value = { x: [1] };
+  const res = applyPatch(doc, [
+    { op: "add", path: "/a/b/-", value: 3 },
+    { op: "add", path: "/c", value },
+  ]) as any;
+  assert.deepEqual(doc, snap);
+  res.c.x.push(2);
+  res.a.b.push(9);
+  assert.deepEqual(value, { x: [1] });
+  assert.deepEqual(doc, snap);
+  bad(doc, [{ op: "add", path: "/z", value: 1 }, { op: "remove", path: "/nope" }]);
+  assert.deepEqual(doc, snap);
+});
+
+test("add", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ a: 1 }, [{ op: "add", path: "/a", value: 2 }], { a: 2 });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/-", value: "q" }], { foo: ["bar", "baz", "q"] });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/2", value: "q" }], { foo: ["bar", "baz", "q"] });
+  for (const i of ["3", "01", "-1", "x"]) bad({ foo: ["bar", "baz"] }, [{ op: "add", path: `/foo/${i}`, value: 1 }]);
+  bad({ a: {} }, [{ op: "add", path: "/a/b/c", value: 1 }]);
+  bad({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]);
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "add", path: "", value: null }], null);
+  ok({ "a/b": 1, "m~n": 1 }, [{ op: "add", path: "/a~1b", value: 2 }, { op: "add", path: "/m~0n", value: 3 }], { "a/b": 2, "m~n": 3 });
+});
+
+test("add __proto__ is an ordinary member", () => {
+  const res = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as any;
+  assert.ok(Object.prototype.hasOwnProperty.call(res, "__proto__"));
+  assert.equal(({} as any).x, undefined);
+  assert.equal(Object.getPrototypeOf(res), Object.prototype);
+  const parsed = JSON.parse('{"__proto__":{"y":1}}');
+  const copy = applyPatch(parsed, []) as any;
+  assert.ok(Object.prototype.hasOwnProperty.call(copy, "__proto__"));
+  assert.equal(copy.y, undefined);
+});
+
+test("remove", () => {
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad({ f: [1] }, [{ op: "remove", path: "/f/1" }]);
+  bad({ f: [1] }, [{ op: "remove", path: "/f/-" }]);
+  bad({ a: 1 }, [{ op: "remove", path: "" }]);
+});
+
+test("replace", () => {
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok({ foo: ["a", "b"] }, [{ op: "replace", path: "/foo/0", value: "z" }], { foo: ["z", "b"] });
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad({ f: ["a"] }, [{ op: "replace", path: "/f/1", value: 1 }]);
+  bad({ f: ["a"] }, [{ op: "replace", path: "/f/-", value: 1 }]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: 5 }], 5);
+});
+
+test("move", () => {
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  bad({}, [{ op: "move", from: "/a", path: "/b" }]);
+  bad({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  bad({}, [{ op: "move", from: "/a", path: "/a" }]);
+  ok({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "" }], { b: 1 });
+});
+
+test("copy", () => {
+  ok({ foo: { waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "copy", from: "/foo/waldo", path: "/qux/thud" }], {
+    foo: { waldo: "fred" },
+    qux: { corge: "grault", thud: "fred" },
+  });
+  ok({ a: { x: 1 } }, [
+    { op: "copy", from: "/a", path: "/b" },
+    { op: "add", path: "/b/y", value: 2 },
+  ], { a: { x: 1 }, b: { x: 1, y: 2 } });
+  bad({}, [{ op: "copy", from: "/a", path: "/b" }]);
+});
+
+test("test", () => {
+  const doc = { a: { b: { d: null, c: [1, 2] } } };
+  ok(doc, [{ op: "test", path: "/a/b", value: { c: [1, 2], d: null } }], doc);
+  ok({ n: 1 }, [{ op: "test", path: "/n", value: 1.0 }], { n: 1 });
+  ok(doc, [{ op: "test", path: "", value: doc }], doc);
+  const fails: [unknown, unknown][] = [
+    ["1", 1], [null, 0], [[], {}], [[1, 2], [2, 1]], [{ a: 1 }, { a: 1, b: 2 }], [{ a: 1, b: 2 }, { a: 1 }],
+    [true, 1], [false, null], ["a", "b"], [{ a: 1 }, { a: 2 }],
+  ];
+  for (const [a, b] of fails) bad({ v: a }, [{ op: "test", path: "/v", value: b }]);
+  bad({}, [{ op: "test", path: "/x", value: 1 }]);
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: 2 }, { op: "add", path: "/b", value: 1 }]);
+});
+
+test("sequential application and error type", () => {
+  ok({}, [{ op: "add", path: "/a", value: {} }, { op: "add", path: "/a/b", value: 1 }], { a: { b: 1 } });
+  try {
+    applyPatch({}, [{ op: "remove", path: "/a" }]);
+    assert.fail();
+  } catch (e) {
+    assert.ok(e instanceof JsonPatchError && e instanceof Error);
+  }
+});
