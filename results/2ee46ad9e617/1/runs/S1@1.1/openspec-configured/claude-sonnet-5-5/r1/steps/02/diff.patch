--- a/src/index.ts
+++ b/src/index.ts
@@ -57,3 +57,194 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+/** Thrown when a JSON Patch is invalid (RFC 6902 §3) or an operation fails (RFC 6902 §5). */
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Container = Record<string, unknown> | unknown[];
+
+const isObject = (v: unknown): v is Record<string, unknown> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+// Defined with defineProperty so that "__proto__" is an ordinary own member, not a prototype write.
+function setMember(obj: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function cloneJson(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(cloneJson);
+  if (typeof value === "object" && value !== null) {
+    const out: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) {
+      setMember(out, key, cloneJson((value as Record<string, unknown>)[key]));
+    }
+    return out;
+  }
+  return value;
+}
+
+// RFC 6902 §4.6 equality.
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((x, i) => jsonEqual(x, b[i]))
+    );
+  }
+  if (isObject(a) && isObject(b)) {
+    const ka = Object.keys(a);
+    return (
+      ka.length === Object.keys(b).length &&
+      ka.every((k) => hasOwn(b, k) && jsonEqual(a[k], b[k]))
+    );
+  }
+  return a === b;
+}
+
+function tokensOf(pointer: string): string[] {
+  try {
+    return parseTokens(pointer);
+  } catch (e) {
+    throw new JsonPatchError((e as Error).message);
+  }
+}
+
+interface Operation {
+  op: string;
+  path: string[];
+  from?: string[];
+  value?: unknown;
+}
+
+function parseOperation(raw: unknown, index: number): Operation {
+  const where = `operation ${index}`;
+  if (!isObject(raw)) throw new JsonPatchError(`${where}: must be an object`);
+  const { op, path, from } = raw;
+  if (typeof op !== "string" || !["add", "remove", "replace", "move", "copy", "test"].includes(op)) {
+    throw new JsonPatchError(`${where}: missing or unknown "op"`);
+  }
+  if (typeof path !== "string") throw new JsonPatchError(`${where}: "path" must be a string`);
+  const result: Operation = { op, path: tokensOf(path) };
+  if (op === "add" || op === "replace" || op === "test") {
+    if (!hasOwn(raw, "value")) throw new JsonPatchError(`${where}: "${op}" requires "value"`);
+    result.value = raw.value;
+  }
+  if (op === "move" || op === "copy") {
+    if (typeof from !== "string") throw new JsonPatchError(`${where}: "${op}" requires a string "from"`);
+    result.from = tokensOf(from);
+  }
+  return result;
+}
+
+function parentOf(doc: unknown, tokens: string[]): Container {
+  let current = doc;
+  for (const token of tokens.slice(0, -1)) {
+    current = childOf(current, token);
+  }
+  if (typeof current !== "object" || current === null) {
+    throw new JsonPatchError("Parent of target location is not an object or array");
+  }
+  return current as Container;
+}
+
+function childOf(parent: unknown, token: string): unknown {
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= parent.length) {
+      throw new JsonPatchError(`No array element "${token}"`);
+    }
+    return parent[Number(token)];
+  }
+  if (isObject(parent) && hasOwn(parent, token)) return parent[token];
+  throw new JsonPatchError(`No member "${token}"`);
+}
+
+function getAt(doc: unknown, tokens: string[]): unknown {
+  let current = doc;
+  for (const token of tokens) current = childOf(current, token);
+  return current;
+}
+
+function addAt(doc: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(doc, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (key === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(key) && Number(key) <= parent.length) {
+      parent.splice(Number(key), 0, value);
+    } else {
+      throw new JsonPatchError(`Invalid array index "${key}"`);
+    }
+  } else {
+    setMember(parent, key, value);
+  }
+  return doc;
+}
+
+function removeAt(doc: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) throw new JsonPatchError("Cannot remove the whole document");
+  getAt(doc, tokens); // target must exist
+  const parent = parentOf(doc, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(key), 1);
+  else delete (parent as Record<string, unknown>)[key];
+  return doc;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the resulting document.
+ * Neither `document` nor `patch` is modified, and the result shares no structure with them.
+ * Throws JsonPatchError if the patch is invalid or any operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchError("A JSON Patch must be an array");
+  const ops = patch.map(parseOperation);
+  let doc = cloneJson(document);
+  for (const o of ops) {
+    switch (o.op) {
+      case "add":
+        doc = addAt(doc, o.path, cloneJson(o.value));
+        break;
+      case "remove":
+        doc = removeAt(doc, o.path);
+        break;
+      case "replace":
+        getAt(doc, o.path);
+        doc = o.path.length === 0 ? cloneJson(o.value) : addReplace(doc, o.path, cloneJson(o.value));
+        break;
+      case "move": {
+        const from = o.from!;
+        if (from.length < o.path.length && from.every((t, i) => t === o.path[i])) {
+          throw new JsonPatchError('"from" must not be a proper prefix of "path"');
+        }
+        const value = getAt(doc, from);
+        if (from.length === o.path.length && from.every((t, i) => t === o.path[i])) break;
+        doc = removeAt(doc, from);
+        doc = addAt(doc, o.path, value);
+        break;
+      }
+      case "copy":
+        doc = addAt(doc, o.path, cloneJson(getAt(doc, o.from!)));
+        break;
+      case "test":
+        if (!jsonEqual(getAt(doc, o.path), o.value)) {
+          throw new JsonPatchError("test failed: value does not match");
+        }
+        break;
+    }
+  }
+  return doc;
+}
+
+function addReplace(doc: unknown, tokens: string[], value: unknown): unknown {
+  const parent = parentOf(doc, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(key)] = value;
+  else setMember(parent, key, value);
+  return doc;
+}
