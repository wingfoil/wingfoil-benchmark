index 0000000000000000000000000000000000000000..1b0e7bc23bc124fb97fd00fab4adf1ff90aa0b7f
--- /dev/null
+++ b/test/json-merge-patch.test.ts
@@ -0,0 +1,75 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+const ok = (target: unknown, patch: unknown, expected: unknown) =>
+  assert.deepEqual(applyMergePatch(target, patch), expected);
+
+test("RFC 7396 §3 example table", () => {
+  ok({ a: "b" }, { a: "c" }, { a: "c" });
+  ok({ a: "b" }, { b: "c" }, { a: "b", b: "c" });
+  ok({ a: "b" }, { a: null }, {});
+  ok({ a: "b", b: "c" }, { a: null }, { b: "c" });
+  ok({ a: ["b"] }, { a: "c" }, { a: "c" });
+  ok({ a: "c" }, { a: ["b"] }, { a: ["b"] });
+  ok({ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } });
+  ok({ a: [{ b: "c" }] }, { a: [1] }, { a: [1] });
+  ok(["a", "b"], ["c", "d"], ["c", "d"]);
+  ok({ a: "b" }, ["c"], ["c"]);
+  ok({ a: "foo" }, null, null);
+  ok({ a: "foo" }, "bar", "bar");
+  ok({ e: null }, { a: 1 }, { e: null, a: 1 });
+  ok([1, 2], { a: "b", c: null }, { a: "b" });
+  ok({}, { a: { bb: { ccc: null } } }, { a: { bb: {} } });
+});
+
+test("null removes; missing key is a no-op", () => {
+  ok({ a: "b" }, { b: null }, { a: "b" });
+});
+
+test("arrays replace", () => {
+  ok({ a: [1, 2] }, { a: [3] }, { a: [3] });
+});
+
+test("non-object target", () => {
+  for (const t of [["a", "b"], 5, "x", null, undefined]) {
+    ok(t, { a: "b" }, { a: "b" });
+    ok(t, {}, {});
+  }
+});
+
+test("non-object patch replaces", () => {
+  for (const p of [["c"], "x", 1, null, true]) ok({ a: "foo" }, p, p);
+});
+
+test("empty patch object", () => {
+  ok({ a: { b: 1 } }, {}, { a: { b: 1 } });
+});
+
+test("hostile keys", () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true},"a":1}');
+  const result = applyMergePatch({}, patch) as Record<string, unknown>;
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.ok(Object.prototype.hasOwnProperty.call(result, "__proto__"));
+  assert.deepEqual(JSON.parse(JSON.stringify(result)), { ["__proto__"]: { polluted: true }, a: 1 });
+  // inherited members are not read or treated as present
+  ok({}, { constructor: { a: 1 }, toString: null }, { constructor: { a: 1 } });
+  const nested = applyMergePatch({}, JSON.parse('{"a":{"__proto__":{"x":1}}}')) as any;
+  assert.equal(nested.a.x, undefined);
+});
+
+test("no mutation and no sharing", () => {
+  const target = { a: { b: 1 }, c: [1] };
+  const patch = { d: { e: [1] }, a: { f: 2 } };
+  const t0 = structuredClone(target), p0 = structuredClone(patch);
+  const r = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, t0);
+  assert.deepEqual(patch, p0);
+  assert.notEqual(r.a, target.a);
+  assert.notEqual(r.c, target.c);
+  assert.notEqual(r.d, patch.d);
+  assert.notEqual(r.d.e, patch.d.e);
+  const arr = applyMergePatch(target, [{ x: 1 }]) as any[];
+  assert.notEqual(arr[0], undefined);
+});
