+++ b/test/json-pointer.test.ts
@@ -0,0 +1,111 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer, JsonPointerError } from "../src/index.ts";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+const throws = (doc: unknown, p: any) =>
+  assert.throws(() => resolvePointer(doc, p), JsonPointerError);
+
+test("empty pointer refers to whole document", () => {
+  const d = { a: 1 };
+  assert.equal(resolvePointer(d, ""), d);
+  assert.equal(resolvePointer(null, ""), null);
+  assert.equal(resolvePointer(5, ""), 5);
+  assert.equal(resolvePointer("x", ""), "x");
+});
+
+test("RFC 6901 §5 examples", () => {
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("pointer syntax validation", () => {
+  throws({ a: 1 }, "a");
+  throws({ a: { b: 1 } }, "a/b");
+  throws({}, undefined);
+  throws({}, null);
+  throws({}, 1);
+});
+
+test("escape handling", () => {
+  assert.equal(resolvePointer({ "~1": 7 }, "/~01"), 7);
+  throws({}, "/a~");
+  throws({ a: 1 }, "/a~2");
+  throws({}, "/~x");
+});
+
+test("object member lookup", () => {
+  assert.equal(resolvePointer({ foo: { bar: "baz" } }, "/foo/bar"), "baz");
+  assert.equal(resolvePointer({ "": 0 }, "/"), 0);
+  assert.equal(resolvePointer({ a: { "": 1 } }, "/a/"), 1);
+  throws({ a: 1 }, "/b");
+});
+
+test("inherited and hostile names", () => {
+  for (const p of ["/__proto__", "/constructor", "/toString", "/__proto__/x", "/constructor/prototype"]) {
+    throws({}, p);
+  }
+  throws([], "/__proto__");
+  const parsed = JSON.parse('{"__proto__":{"x":1}}');
+  assert.equal(resolvePointer(parsed, "/__proto__/x"), 1);
+});
+
+test("array element lookup", () => {
+  assert.equal(resolvePointer(["a", "b"], "/0"), "a");
+  assert.equal(resolvePointer(["a", "b"], "/1"), "b");
+  throws(["a", "b"], "/2");
+  throws(["a", "b"], "/99999999999999999999");
+  for (const p of ["/01", "/-1", "/+1", "/1.0", "/1e0", "/ 1", "/length", "/"]) {
+    throws(["a", "b"], p);
+  }
+  throws([], "/0");
+});
+
+test("'-' refers to a nonexistent element", () => {
+  throws(["a"], "/-");
+  throws([], "/-");
+});
+
+test("null and falsy values are values", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  const d = { a: false, b: 0, c: "" };
+  assert.equal(resolvePointer(d, "/a"), false);
+  assert.equal(resolvePointer(d, "/b"), 0);
+  assert.equal(resolvePointer(d, "/c"), "");
+  assert.equal(resolvePointer([null], "/0"), null);
+});
+
+test("primitives cannot be traversed", () => {
+  const d = { a: "str", b: null, c: 1, d: true };
+  for (const p of ["/a/0", "/a/length", "/b/x", "/c/x", "/d/x"]) throws(d, p);
+  throws(null, "/a");
+});
+
+test("document is not mutated; references are returned", () => {
+  const d = { a: { b: [1, { c: 2 }] } };
+  const copy = structuredClone(d);
+  assert.equal(resolvePointer(d, "/a"), d.a);
+  assert.equal(resolvePointer(d, "/a/b/1"), d.a.b[1]);
+  assert.deepEqual(d, copy);
+});
