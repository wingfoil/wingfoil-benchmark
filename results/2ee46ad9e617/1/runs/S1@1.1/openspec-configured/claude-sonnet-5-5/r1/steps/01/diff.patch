@@ -0,0 +1,59 @@
+/** Thrown when a JSON Pointer is invalid (RFC 6901 §3) or does not resolve (§4). */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+const hasOwn = (o: object, key: string): boolean =>
+  Object.prototype.hasOwnProperty.call(o, key);
+
+// RFC 6901 §3: array-index = %x30 / ( %x31-39 *DIGIT )
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function parseTokens(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Invalid JSON Pointer: must be empty or start with "/": ${pointer}`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((raw) => {
+      if (/~(?![01])/.test(raw)) {
+        throw new JsonPointerError(`Invalid JSON Pointer: bad "~" escape in token "${raw}"`);
+      }
+      // RFC 6901 §4: decode ~1 first, then ~0.
+      return raw.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/**
+ * Returns the value of `document` that `pointer` refers to (RFC 6901).
+ * Throws JsonPointerError if the pointer is invalid or does not resolve to a value.
+ * The document is not modified; objects and arrays are returned by reference.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  const tokens = parseTokens(pointer);
+  let current: unknown = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new JsonPointerError(`Pointer does not resolve: no array element "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null) {
+      if (!hasOwn(current, token)) {
+        throw new JsonPointerError(`Pointer does not resolve: no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Pointer does not resolve: cannot apply token "${token}" to a primitive`);
+    }
+  }
+  return current;
+}
diff --git a/test/json-pointer.test.ts b/test/json-pointer.test.ts
