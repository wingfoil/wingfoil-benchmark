+++ b/test/json-patch-diff.test.ts
@@ -0,0 +1,105 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const rt = (from: unknown, to: unknown) => {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+};
+const long = Array.from({ length: 50 }, (_, i) => ({ id: i, tags: ["a", "b"] }));
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(rt({ a: 1, b: [1, 2] }, { b: [1, 2], a: 1 }), []);
+  assert.deepEqual(rt(null, null), []);
+});
+
+test("inputs are not mutated and patch shares nothing", () => {
+  const from = { a: [1, 2], o: { x: 1 } };
+  const to = { a: [1, 2, { n: 1 }], p: { y: [1] } };
+  const f = structuredClone(from);
+  const t = structuredClone(to);
+  const patch = createPatch(from, to) as any[];
+  for (const op of patch) if (op.value && typeof op.value === "object") op.value.zzz = 1;
+  assert.deepEqual(from, f);
+  assert.deepEqual(to, t);
+});
+
+test("root and type changes", () => {
+  assert.deepEqual(rt(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepEqual(rt({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(rt({ a: { b: 1 } }, { a: [1] }), [{ op: "replace", path: "/a", value: [1] }]);
+  rt([1], { a: 1 });
+});
+
+test("small nested change stays small", () => {
+  const from = { a: { b: { c: 1, d: long } }, z: long };
+  const to = structuredClone(from);
+  to.a.b.c = 2;
+  assert.deepEqual(rt(from, to), [{ op: "replace", path: "/a/b/c", value: 2 }]);
+});
+
+test("object add, remove, null", () => {
+  assert.deepEqual(rt({ a: 1, b: 2, c: 1 }, { a: 1, c: null, d: [] }), [
+    { op: "remove", path: "/b" },
+    { op: "replace", path: "/c", value: null },
+    { op: "add", path: "/d", value: [] },
+  ]);
+});
+
+test("key escaping and __proto__", () => {
+  const to = JSON.parse('{"a/b":2,"m~n":2,"__proto__":{"x":2}}');
+  const from = JSON.parse('{"a/b":1,"m~n":1,"__proto__":{"x":1}}');
+  const patch = rt(from, to) as any[];
+  assert.deepEqual(patch.map((o) => o.path), ["/a~1b", "/m~0n", "/__proto__/x"]);
+  rt({}, JSON.parse('{"__proto__":{"polluted":1}}'));
+  assert.equal(({} as any).polluted, undefined);
+});
+
+test("array insert and remove are single operations", () => {
+  for (const idx of [0, 25, 50]) {
+    const to = long.slice();
+    const item = { id: 999 };
+    to.splice(idx, 0, item);
+    assert.deepEqual(rt(long, to), [{ op: "add", path: `/${idx}`, value: item }]);
+    assert.deepEqual(rt(to, long), [{ op: "remove", path: `/${idx}` }]);
+  }
+});
+
+test("array move costs at most two operations", () => {
+  const to = long.slice(1).concat(long[0]);
+  assert.ok(rt(long, to).length <= 2);
+  assert.ok(rt(to, long).length <= 2);
+  const mid = long.slice();
+  mid.splice(40, 0, mid.splice(5, 1)[0]);
+  assert.ok(rt(long, mid).length <= 2);
+});
+
+test("array item changed in place", () => {
+  const to = structuredClone(long);
+  to[7].tags[1] = "c";
+  assert.deepEqual(rt(long, to), [{ op: "replace", path: "/7/tags/1", value: "c" }]);
+});
+
+test("duplicates, nested arrays, empty arrays", () => {
+  rt([1, 1, 1], [1, 1]);
+  rt([1, 1], [1, 2, 1, 1]);
+  rt([[1, 2], [3]], [[3], [1, 2, 4]]);
+  rt([], [1, 2]);
+  rt([1, 2], []);
+});
+
+test("randomized round trip", () => {
+  let seed = 12345;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) % n);
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 4 : 6);
+    if (k === 0) return rnd(3);
+    if (k === 1) return null;
+    if (k === 2) return "s" + rnd(2);
+    if (k === 3) return rnd(2) === 0;
+    if (k === 4) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let i = 0; i < 2000; i++) rt(gen(0), gen(0));
+});
