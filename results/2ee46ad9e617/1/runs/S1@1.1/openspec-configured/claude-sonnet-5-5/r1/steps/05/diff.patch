index bedb39f90b5bf00a382e78504ca78a9c0e618d1b..8451def62bc258d92f23dff7d9f8389f331a3db7 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -271,3 +271,93 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+const escapeToken = (key: string): string => key.replace(/~/g, "~0").replace(/\//g, "~1");
+
+type PatchOp =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+function diffInto(ops: PatchOp[], path: string, a: unknown, b: unknown): void {
+  if (jsonEqual(a, b)) return;
+  if (Array.isArray(a) && Array.isArray(b)) {
+    diffArrays(ops, path, a, b);
+  } else if (isObject(a) && isObject(b)) {
+    for (const key of Object.keys(a)) {
+      if (!hasOwn(b, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(b)) {
+      const p = `${path}/${escapeToken(key)}`;
+      if (hasOwn(a, key)) diffInto(ops, p, a[key], b[key]);
+      else ops.push({ op: "add", path: p, value: cloneJson(b[key]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: cloneJson(b) });
+  }
+}
+
+function diffArrays(ops: PatchOp[], path: string, a: unknown[], b: unknown[]): void {
+  let start = 0;
+  while (start < a.length && start < b.length && jsonEqual(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && jsonEqual(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const n = endA - start;
+  const m = endB - start;
+  // lcs[i][j]: longest common subsequence of a[start+i..endA) and b[start+j..endB)
+  const lcs: Uint32Array[] = Array.from({ length: n + 1 }, () => new Uint32Array(m + 1));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(a[start + i], b[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  let index = start; // position in the array as transformed so far
+  let i = 0;
+  let j = 0;
+  while (i < n || j < m) {
+    if (i < n && j < m && jsonEqual(a[start + i], b[start + j])) {
+      index++;
+      i++;
+      j++;
+      continue;
+    }
+    // Collect the run of unmatched items up to the next common item.
+    let ri = i;
+    let rj = j;
+    while ((ri < n || rj < m) && !(ri < n && rj < m && jsonEqual(a[start + ri], b[start + rj]))) {
+      if (rj >= m || (ri < n && lcs[ri + 1][rj] >= lcs[ri][rj + 1])) ri++;
+      else rj++;
+    }
+    const removed = ri - i;
+    const added = rj - j;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) {
+      diffInto(ops, `${path}/${index}`, a[start + i + k], b[start + j + k]);
+      index++;
+    }
+    for (let k = paired; k < removed; k++) ops.push({ op: "remove", path: `${path}/${index}` });
+    for (let k = paired; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${index}`, value: cloneJson(b[start + j + k]) });
+      index++;
+    }
+    i = ri;
+    j = rj;
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ * The patch only describes what changed: nested changes are addressed by their own path, and array
+ * items that are inserted, removed or moved produce `add`/`remove` of those items only.
+ * Neither argument is modified and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  const ops: PatchOp[] = [];
+  diffInto(ops, "", from, to);
+  return ops;
+}
