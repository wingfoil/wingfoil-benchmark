+/** Splits a JSON Pointer (RFC 6901 §3) into unescaped reference tokens (§4). */
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new TypeError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new Error(`Invalid JSON Pointer "${pointer}": "~" must be followed by "0" or "1"`);
+      }
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/** Returns the value of `document` that `pointer` (RFC 6901) refers to; throws if invalid or unresolvable. */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const token of parsePointer(pointer)) {
+    if (Array.isArray(current)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`Pointer "${pointer}": "${token}" is not a valid array index`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new Error(`Pointer "${pointer}": index ${token} is out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(`Pointer "${pointer}": member "${token}" not found`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`Pointer "${pointer}": cannot resolve "${token}" in a non-container value`);
+    }
+  }
+  return current;
+}
