@@ -0,0 +1,43 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("RFC 6902 appendix A", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), { baz: "boo", foo: "bar" });
+  assert.deepEqual(
+    applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(applyPatch({ foo: [1] }, [{ op: "test", path: "/foo", value: [1] }]), { foo: [1] });
+  assert.throws(() => applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]));
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]), { foo: "bar", child: { grandchild: {} } });
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]));
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]), { foo: ["bar", ["abc", "def"]] });
+  assert.deepEqual(applyPatch({ foo: 1, bar: [1, 2] }, [{ op: "copy", from: "/foo", path: "/baz" }]), { foo: 1, bar: [1, 2], baz: 1 });
+});
+
+test("edge cases", () => {
+  const input = { a: { b: 1 } };
+  const out = applyPatch(input, [{ op: "copy", from: "/a", path: "/c" }, { op: "add", path: "/c/b", value: 2 }]) as any;
+  assert.deepEqual(input, { a: { b: 1 } });
+  assert.equal(out.a.b, 1);
+  assert.deepEqual(applyPatch(1, [{ op: "add", path: "", value: [2] }]), [2]);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/x" }]));
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/x", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/2", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/-", value: 1 }]));
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "bogus", path: "" }]));
+  assert.throws(() => applyPatch({}, {}));
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "test", path: "", value: { b: 2, a: 1 } }]), { a: 1, b: 2 });
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]));
+  const p = applyPatch({}, [{ op: "add", path: "/__proto__", value: 1 }]) as any;
+  assert.equal(Object.getPrototypeOf(p), Object.prototype);
+  assert.equal(Object.keys(p)[0], "__proto__");
+});
