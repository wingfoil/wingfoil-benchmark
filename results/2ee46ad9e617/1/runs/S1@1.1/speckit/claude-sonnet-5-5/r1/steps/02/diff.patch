+
+type Json = unknown;
+type Container = Record<string, Json> | Json[];
+
+const has = (o: object, k: string) => Object.prototype.hasOwnProperty.call(o, k);
+
+function clone(value: Json): Json {
+  if (Array.isArray(value)) return value.map(clone);
+  if (typeof value === "object" && value !== null) {
+    const out: Record<string, Json> = {};
+    for (const k of Object.keys(value)) {
+      Object.defineProperty(out, k, {
+        value: clone((value as Record<string, Json>)[k]),
+        enumerable: true,
+        writable: true,
+        configurable: true,
+      });
+    }
+    return out;
+  }
+  return value;
+}
+
+function jsonEqual(a: Json, b: Json): boolean {
+  if (a === b) return true;
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (typeof a === "object" && a !== null) {
+    if (typeof b !== "object" || b === null || Array.isArray(b)) return false;
+    const ka = Object.keys(a);
+    if (ka.length !== Object.keys(b).length) return false;
+    return ka.every(
+      (k) =>
+        has(b, k) && jsonEqual((a as Record<string, Json>)[k], (b as Record<string, Json>)[k]),
+    );
+  }
+  return false;
+}
+
+function setMember(obj: Record<string, Json>, key: string, value: Json): void {
+  Object.defineProperty(obj, key, { value, enumerable: true, writable: true, configurable: true });
+}
+
+function arrayIndex(token: string, max: number, path: string): number {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`Path "${path}": "${token}" is not a valid array index`);
+  }
+  const index = Number(token);
+  if (index > max) throw new Error(`Path "${path}": index ${token} is out of range`);
+  return index;
+}
+
+/** Finds the container holding the last token of `path`; the parent must exist. */
+function parentOf(doc: Json, tokens: string[], path: string): Container {
+  let current = doc;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      current = current[arrayIndex(token, current.length - 1, path)];
+    } else if (typeof current === "object" && current !== null && has(current, token)) {
+      current = (current as Record<string, Json>)[token];
+    } else {
+      throw new Error(`Path "${path}": "${token}" not found`);
+    }
+  }
+  if (typeof current !== "object" || current === null) {
+    throw new Error(`Path "${path}": parent is not an object or array`);
+  }
+  return current as Container;
+}
+
+function addAt(doc: Json, path: string, value: Json): Json {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(doc, tokens, path);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    const index = last === "-" ? parent.length : arrayIndex(last, parent.length, path);
+    parent.splice(index, 0, value);
+  } else {
+    setMember(parent, last, value);
+  }
+  return doc;
+}
+
+function removeAt(doc: Json, path: string): { doc: Json; removed: Json } {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) throw new Error("Cannot remove the document root");
+  const parent = parentOf(doc, tokens, path);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    const index = arrayIndex(last, parent.length - 1, path);
+    return { doc, removed: parent.splice(index, 1)[0] };
+  }
+  if (!has(parent, last)) throw new Error(`Path "${path}": member "${last}" not found`);
+  const removed = parent[last];
+  delete parent[last];
+  return { doc, removed };
+}
+
+function requireString(op: Record<string, Json>, key: string, i: number): string {
+  if (typeof op[key] !== "string") {
+    throw new Error(`Operation ${i}: "${key}" must be a string`);
+  }
+  return op[key] as string;
+}
+
+/** Applies a JSON Patch (RFC 6902) to `document`, returning a new document; throws on invalid patch or failed operation. */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new TypeError("JSON Patch must be an array");
+  let doc = clone(document);
+  patch.forEach((raw: unknown, i: number) => {
+    if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+      throw new Error(`Operation ${i}: must be an object`);
+    }
+    const op = raw as Record<string, Json>;
+    const name = op.op;
+    const path = requireString(op, "path", i);
+    const needsValue = name === "add" || name === "replace" || name === "test";
+    if (needsValue && !has(op, "value")) throw new Error(`Operation ${i}: missing "value"`);
+    switch (name) {
+      case "add":
+        doc = addAt(doc, path, clone(op.value));
+        break;
+      case "remove":
+        doc = removeAt(doc, path).doc;
+        break;
+      case "replace": {
+        const tokens = parsePointer(path);
+        if (tokens.length === 0) {
+          doc = clone(op.value);
+        } else {
+          resolvePointer(doc, path);
+          doc = removeAt(doc, path).doc;
+          doc = addAt(doc, path, clone(op.value));
+        }
+        break;
+      }
+      case "move": {
+        const from = requireString(op, "from", i);
+        const f = parsePointer(from);
+        const t = parsePointer(path);
+        if (f.length < t.length && f.every((tok, k) => tok === t[k])) {
+          throw new Error(`Operation ${i}: cannot move a location into itself`);
+        }
+        resolvePointer(doc, from);
+        if (from === path) break;
+        const r = removeAt(doc, from);
+        doc = addAt(r.doc, path, r.removed);
+        break;
+      }
+      case "copy": {
+        const from = requireString(op, "from", i);
+        doc = addAt(doc, path, clone(resolvePointer(doc, from)));
+        break;
+      }
+      case "test":
+        if (!jsonEqual(resolvePointer(doc, path), op.value)) {
+          throw new Error(`Operation ${i}: test failed at "${path}"`);
+        }
+        break;
+      default:
+        throw new Error(`Operation ${i}: unknown op ${JSON.stringify(name)}`);
+    }
+  });
+  return doc;
+}
