index 0000000000000000000000000000000000000000..831c8861e0778a5f081e1407512f5b99658daec9
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,79 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (a: unknown, b: unknown) => {
+  const ca = structuredClone(a);
+  const cb = structuredClone(b);
+  const patch = createPatch(a, b);
+  assert.deepEqual(a, ca);
+  assert.deepEqual(b, cb);
+  assert.deepEqual(applyPatch(a, patch), b);
+  return patch as any[];
+};
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small nested change gives one operation", () => {
+  const p = roundTrip({ a: { b: { c: 1, d: 2 } }, e: [1, 2] }, { a: { b: { c: 1, d: 3 } }, e: [1, 2] });
+  assert.deepEqual(p, [{ op: "replace", path: "/a/b/d", value: 3 }]);
+});
+
+test("add and remove members; root and type changes", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1, c: 3 }).length, 2);
+  assert.deepEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  roundTrip({ a: 1 }, [1]);
+  roundTrip(null, { a: null });
+  roundTrip({ a: [] }, { a: {} });
+});
+
+test("pointer escaping and unsafe keys", () => {
+  const p = roundTrip({ "a/b": 1, "m~n": 1 }, { "a/b": 2, "m~n": 2 });
+  assert.deepEqual(p.map((o) => o.path).sort(), ["/a~1b", "/m~0n"]);
+  const to = JSON.parse('{"__proto__":{"x":1}}');
+  roundTrip({}, to);
+  assert.equal(({} as any).x, undefined);
+});
+
+test("array insert and remove touch only that item", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(roundTrip([{ a: 1 }, { b: 2 }], [{ b: 2 }]), [{ op: "remove", path: "/0" }]);
+});
+
+test("array move does not rewrite items between", () => {
+  const p = roundTrip(["a", "b", "c", "d", "e"], ["a", "c", "d", "e", "b"]);
+  assert.ok(p.length <= 2 && p.every((o) => ["move", "add", "remove"].includes(o.op)));
+  const q = roundTrip(["a", "b", "c", "d", "e"], ["e", "a", "b", "c", "d"]);
+  assert.ok(q.length <= 2 && q.every((o) => ["move", "add", "remove"].includes(o.op)));
+});
+
+test("modified array item is patched in place", () => {
+  assert.deepEqual(roundTrip([{ a: 1, b: 2 }, { c: 3 }], [{ a: 1, b: 5 }, { c: 3 }]), [
+    { op: "replace", path: "/0/b", value: 5 },
+  ]);
+});
+
+test("patch values are not shared with inputs", () => {
+  const to = { a: { b: [1] } };
+  const p = createPatch({}, to) as any[];
+  assert.notEqual(p[0].value, to.a);
+  assert.notEqual(p[0].value.b, to.a.b);
+});
+
+test("randomized round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) % n);
+  const gen = (d: number): unknown => {
+    const t = rnd(d > 2 ? 3 : 5);
+    if (t === 0) return rnd(4);
+    if (t === 1) return ["x", "y", null, true][rnd(4)];
+    if (t === 2) return rnd(2);
+    if (t === 3) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => [["a", "b", "c/d", "~"][rnd(4)], gen(d + 1)]));
+  };
+  for (let i = 0; i < 500; i++) roundTrip(gen(0), gen(0));
+});
