--- a/src/index.ts
+++ b/src/index.ts
@@ -227,3 +227,88 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: Json };
+
+const escapeToken = (token: string) => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+/** Returns, for each matched pair of the longest common subsequence of `a` and `b`, the indexes `[i, j]`. */
+function commonPairs(a: Json[], b: Json[]): [number, number][] {
+  const n = a.length;
+  const m = b.length;
+  const table: Uint32Array[] = Array.from({ length: n + 1 }, () => new Uint32Array(m + 1));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      table[i][j] = jsonEqual(a[i], b[j])
+        ? table[i + 1][j + 1] + 1
+        : Math.max(table[i + 1][j], table[i][j + 1]);
+    }
+  }
+  const pairs: [number, number][] = [];
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (jsonEqual(a[i], b[j])) pairs.push([i++, j++]);
+    else if (table[i + 1][j] >= table[i][j + 1]) i++;
+    else j++;
+  }
+  return pairs;
+}
+
+function diffArrays(from: Json[], to: Json[], path: string, ops: Operation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && jsonEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const a = from.slice(start, endFrom);
+  const b = to.slice(start, endTo);
+  const pairs = commonPairs(a, b);
+  pairs.push([a.length, b.length]); // sentinel closing the last gap
+
+  let cursor = start; // index in the array being patched, which already equals `to` before it
+  let i = 0;
+  let j = 0;
+  for (const [mi, mj] of pairs) {
+    const removed = mi - i;
+    const added = mj - j;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) diff(a[i + k], b[j + k], `${path}/${cursor + k}`, ops);
+    cursor += paired;
+    for (let k = paired; k < removed; k++) ops.push({ op: "remove", path: `${path}/${cursor}` });
+    for (let k = paired; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${cursor++}`, value: clone(b[j + k]) });
+    }
+    cursor++; // skip the matched item
+    i = mi + 1;
+    j = mj + 1;
+  }
+}
+
+function diff(from: Json, to: Json, path: string, ops: Operation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (has(from, key)) diff(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/** Returns a JSON Patch (RFC 6902) that turns `from` into `to`, describing only what changed; inputs are not mutated. */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const ops: Operation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
