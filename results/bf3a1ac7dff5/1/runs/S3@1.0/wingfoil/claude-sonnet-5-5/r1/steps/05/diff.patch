diff --git a/test/rental.test.ts b/test/rental.test.ts
index 0553e7fdf13e442a647f99c943b3218a39da41c0..32415a9169cd548367346ff27495d103169ef10e 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -200,3 +200,36 @@ test('addEquipment validates the hourly price', () => {
   assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: -1 }));
   service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 0 });
 });
+
+test('cancelling before the rental starts refunds the whole total and frees the item', () => {
+  const service = setup();
+  const booking = service.book({ itemId: 'board-1', start: day(10), end: day(13) });
+  assert.deepEqual(service.cancel(booking.id, '2026-07-09T12:30:00Z'), { bookingId: booking.id, refund: 6750 });
+  assert.deepEqual(service.availability({ start: day(10), end: day(13), kind: 'board' }), ['board-1']);
+  service.book({ itemId: 'board-1', start: day(10), end: day(13) });
+});
+
+test('cancelling once the rental has started refunds nothing', () => {
+  const service = setup();
+  const booking = service.book({ itemId: 'board-1', start: day(10), end: day(11) });
+  assert.equal(service.cancel(booking.id, day(10)).refund, 0);
+  const later = service.book({ itemId: 'sail-1', start: day(10), end: day(12) });
+  assert.equal(service.cancel(later.id, day(11)).refund, 0);
+});
+
+test('a booking can only be cancelled once', () => {
+  const service = setup();
+  const booking = service.book({ itemId: 'board-1', start: day(10), end: day(11) });
+  service.cancel(booking.id, day(9));
+  assert.throws(() => service.cancel(booking.id, day(9)));
+});
+
+test('cancel rejects an unknown booking and an invalid time, and leaves the booking in place', () => {
+  const service = setup();
+  const booking = service.book({ itemId: 'board-1', start: day(10), end: day(11) });
+  assert.throws(() => service.cancel('booking-99', day(9)));
+  assert.throws(() => service.cancel(booking.id, 'garbage'));
+  assert.throws(() => service.cancel(booking.id, '2026-07-09T10:00:00+02:00'));
+  assert.throws(() => service.book({ itemId: 'board-1', start: day(10), end: day(11) }));
+  assert.equal(service.cancel(booking.id, day(9)).refund, 2500);
+});
