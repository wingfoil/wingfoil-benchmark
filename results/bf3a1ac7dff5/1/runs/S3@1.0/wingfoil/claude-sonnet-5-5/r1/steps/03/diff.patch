 const MS_PER_DAY = 24 * 60 * 60 * 1000;
+const DISCOUNT_FROM_DAYS = 3;
+const DISCOUNT_PERCENT = 10;
 const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?Z$/;
 
 function parseMidnight(value: string): number {
@@ -76,7 +78,10 @@ export function createRentalService(): RentalService {
