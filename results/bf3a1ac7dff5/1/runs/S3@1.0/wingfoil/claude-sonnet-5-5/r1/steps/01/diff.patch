+/** The kinds of equipment the school rents. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item. `dailyPrice` is an integer number of euro cents per day. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** A rental period for one item; `start` and `end` are UTC midnights as ISO-8601 strings, `end` exclusive. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** What renting an item for a period costs; `total` is an integer number of euro cents. */
+export interface Quote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed booking. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** The in-memory rental service of the booking desk. */
+export interface RentalService {
+  /** Registers an item; throws if it is invalid or its id is already used. */
+  addEquipment(item: Equipment): void;
+  /** Prices a rental; throws for an unknown item or a period that is not whole UTC days. */
+  quote(request: RentalRequest): Quote;
+  /** Books an item; throws like `quote`, and when the item is not free for the whole period. */
+  book(request: RentalRequest): Booking;
+}
+
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?Z$/;
+
+function parseMidnight(value: string): number {
+  const time = typeof value === 'string' && UTC_MIDNIGHT.test(value) ? Date.parse(value) : NaN;
+  if (Number.isNaN(time)) {
+    throw new Error(`Not a UTC midnight ISO-8601 time: ${String(value)}`);
+  }
+  return time;
+}
+
+/** Creates a rental service that keeps equipment and bookings in memory. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Array<{ itemId: string; start: number; end: number }> = [];
+  let nextBookingNumber = 1;
+
+  function price(request: RentalRequest): { quote: Quote; start: number; end: number } {
+    const item = equipment.get(request.itemId);
+    if (!item) {
+      throw new Error(`Unknown item: ${request.itemId}`);
+    }
+    const start = parseMidnight(request.start);
+    const end = parseMidnight(request.end);
+    if (end <= start) {
+      throw new Error('The period must end after it starts');
+    }
+    const days = (end - start) / MS_PER_DAY;
+    const quote = { itemId: request.itemId, start: request.start, end: request.end, total: days * item.dailyPrice };
+    return { quote, start, end };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item.id !== 'string' || item.id === '') {
+        throw new Error('Equipment id must be a non-empty string');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error(`Unknown equipment kind: ${String(item.kind)}`);
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of cents');
+      }
+      if (equipment.has(item.id)) {
+        throw new Error(`Equipment already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, start, end } = price(request);
+      const clash = bookings.some((b) => b.itemId === request.itemId && b.start < end && start < b.end);
+      if (clash) {
+        throw new Error(`${request.itemId} is not free for the whole period`);
+      }
+      bookings.push({ itemId: request.itemId, start, end });
+      return { id: `booking-${nextBookingNumber++}`, ...quote };
+    },
+  };
+}
