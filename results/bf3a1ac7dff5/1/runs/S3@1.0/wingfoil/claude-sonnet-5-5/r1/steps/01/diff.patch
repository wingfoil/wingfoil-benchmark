@@ -0,0 +1,94 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  return service;
+}
+
+const day = (d: number) => `2026-07-${String(d).padStart(2, '0')}T00:00:00.000Z`;
+
+test('quote multiplies the daily price by the number of days', () => {
+  const quote = setup().quote({ itemId: 'board-1', start: day(10), end: day(13) });
+  assert.deepEqual(quote, { itemId: 'board-1', start: day(10), end: day(13), total: 7500 });
+});
+
+test('quote accepts ISO strings without milliseconds', () => {
+  const quote = setup().quote({
+    itemId: 'sail-1',
+    start: '2026-07-10T00:00:00Z',
+    end: '2026-07-11T00:00:00Z',
+  });
+  assert.equal(quote.total, 1500);
+});
+
+test('quote rejects an unknown item', () => {
+  assert.throws(() => setup().quote({ itemId: 'nope', start: day(10), end: day(11) }));
+});
+
+test('quote rejects periods that are not whole UTC days', () => {
+  const service = setup();
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-10T10:00:00Z', end: day(11) }));
+  assert.throws(() => service.quote({ itemId: 'board-1', start: day(10), end: '2026-07-11T00:00:00+02:00' }));
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-10', end: day(11) }));
+  assert.throws(() => service.quote({ itemId: 'board-1', start: 'garbage', end: day(11) }));
+});
+
+test('quote rejects empty or reversed periods', () => {
+  const service = setup();
+  assert.throws(() => service.quote({ itemId: 'board-1', start: day(10), end: day(10) }));
+  assert.throws(() => service.quote({ itemId: 'board-1', start: day(11), end: day(10) }));
+});
+
+test('book returns a booking with an id and the quoted total', () => {
+  const booking = setup().book({ itemId: 'board-1', start: day(10), end: day(12) });
+  assert.equal(typeof booking.id, 'string');
+  assert.deepEqual(
+    { ...booking, id: undefined },
+    { id: undefined, itemId: 'board-1', start: day(10), end: day(12), total: 5000 },
+  );
+});
+
+test('bookings get distinct ids', () => {
+  const service = setup();
+  const a = service.book({ itemId: 'board-1', start: day(10), end: day(11) });
+  const b = service.book({ itemId: 'board-1', start: day(11), end: day(12) });
+  assert.notEqual(a.id, b.id);
+});
+
+test('book rejects overlapping periods for the same item', () => {
+  const service = setup();
+  service.book({ itemId: 'board-1', start: day(10), end: day(13) });
+  assert.throws(() => service.book({ itemId: 'board-1', start: day(12), end: day(14) }));
+  assert.throws(() => service.book({ itemId: 'board-1', start: day(9), end: day(11) }));
+  assert.throws(() => service.book({ itemId: 'board-1', start: day(11), end: day(12) }));
+  assert.throws(() => service.book({ itemId: 'board-1', start: day(8), end: day(15) }));
+});
+
+test('back-to-back periods and other items do not conflict', () => {
+  const service = setup();
+  service.book({ itemId: 'board-1', start: day(10), end: day(13) });
+  service.book({ itemId: 'board-1', start: day(13), end: day(14) });
+  service.book({ itemId: 'board-1', start: day(9), end: day(10) });
+  service.book({ itemId: 'sail-1', start: day(10), end: day(13) });
+});
+
+test('book rejects unknown items and invalid periods without booking', () => {
+  const service = setup();
+  assert.throws(() => service.book({ itemId: 'nope', start: day(10), end: day(11) }));
+  assert.throws(() => service.book({ itemId: 'board-1', start: day(11), end: day(10) }));
+  service.book({ itemId: 'board-1', start: day(10), end: day(11) });
+});
+
+test('addEquipment validates the item', () => {
+  const service = createRentalService();
+  assert.throws(() => service.addEquipment({ id: '', kind: 'board', dailyPrice: 100 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'kayak' as 'board', dailyPrice: 100 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10.5 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
+  service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100 });
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100 }));
+});
