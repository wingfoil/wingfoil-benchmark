diff --git a/test/rental.test.ts b/test/rental.test.ts
index a007b1b4e4f58e0721d39af5b740c28379581998..0553e7fdf13e442a647f99c943b3218a39da41c0 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -142,3 +142,61 @@ test('book shows the same reduced total as quote', () => {
   const booking = setup().book({ itemId: 'sail-1', start: day(10), end: day(14) });
   assert.equal(booking.total, 5400);
 });
+
+const at = (d: number, h: number) => `2026-07-${String(d).padStart(2, '0')}T${String(h).padStart(2, '0')}:00:00.000Z`;
+
+function setupHourly() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-h', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  return service;
+}
+
+test('a rental shorter than a day costs the hourly price for each hour', () => {
+  const quote = setupHourly().quote({ itemId: 'board-h', start: at(10, 13), end: at(10, 17) });
+  assert.deepEqual(quote, { itemId: 'board-h', start: at(10, 13), end: at(10, 17), total: 2400 });
+});
+
+test('an hourly rental may cross midnight and start at midnight', () => {
+  const service = setupHourly();
+  assert.equal(service.quote({ itemId: 'board-h', start: at(10, 22), end: at(11, 2) }).total, 2400);
+  assert.equal(service.quote({ itemId: 'board-h', start: at(10, 0), end: at(10, 23) }).total, 13800);
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  const service = setupHourly();
+  assert.throws(() => service.quote({ itemId: 'sail-1', start: at(10, 13), end: at(10, 17) }));
+  assert.throws(() => service.book({ itemId: 'sail-1', start: at(10, 13), end: at(10, 17) }));
+});
+
+test('hourly periods must start and end on the hour', () => {
+  const service = setupHourly();
+  assert.throws(() => service.quote({ itemId: 'board-h', start: '2026-07-10T13:30:00Z', end: at(10, 17) }));
+  assert.throws(() => service.quote({ itemId: 'board-h', start: at(10, 13), end: '2026-07-10T17:00:01Z' }));
+  assert.throws(() => service.quote({ itemId: 'board-h', start: at(10, 13), end: '2026-07-10T17:00:00+02:00' }));
+  assert.throws(() => service.quote({ itemId: 'board-h', start: at(10, 17), end: at(10, 13) }));
+});
+
+test('a rental of a day or more must still be whole days', () => {
+  const service = setupHourly();
+  assert.throws(() => service.quote({ itemId: 'board-h', start: at(10, 10), end: at(11, 10) }));
+  assert.throws(() => service.quote({ itemId: 'board-h', start: at(10, 0), end: at(11, 10) }));
+  assert.equal(service.quote({ itemId: 'board-h', start: at(10, 0), end: at(11, 0) }).total, 2500);
+});
+
+test('hourly bookings conflict only when their hours overlap', () => {
+  const service = setupHourly();
+  const booking = service.book({ itemId: 'board-h', start: at(10, 13), end: at(10, 15) });
+  assert.equal(booking.total, 1200);
+  assert.throws(() => service.book({ itemId: 'board-h', start: at(10, 14), end: at(10, 16) }));
+  service.book({ itemId: 'board-h', start: at(10, 15), end: at(10, 17) });
+  assert.throws(() => service.book({ itemId: 'board-h', start: at(10, 0), end: at(11, 0) }));
+  assert.deepEqual(service.availability({ start: day(10), end: day(11), kind: 'board' }), []);
+});
+
+test('addEquipment validates the hourly price', () => {
+  const service = createRentalService();
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 10.5 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: -1 }));
+  service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 0 });
+});
