   const bookings: Array<{ itemId: string; start: number; end: number }> = [];
   let nextBookingNumber = 1;
 
+  function isFree(itemId: string, start: number, end: number): boolean {
+    return !bookings.some((b) => b.itemId === itemId && b.start < end && start < b.end);
+  }
+
   function price(request: RentalRequest): { quote: Quote; start: number; end: number } {
     const item = equipment.get(request.itemId);
     if (!item) {
@@ -90,12 +103,26 @@ export function createRentalService(): RentalService {
 
     book(request) {
       const { quote, start, end } = price(request);
-      const clash = bookings.some((b) => b.itemId === request.itemId && b.start < end && start < b.end);
-      if (clash) {
+      if (!isFree(request.itemId, start, end)) {
         throw new Error(`${request.itemId} is not free for the whole period`);
       }
       bookings.push({ itemId: request.itemId, start, end });
       return { id: `booking-${nextBookingNumber++}`, ...quote };
     },
+
+    availability(query) {
+      const start = parseMidnight(query.start);
+      const end = parseMidnight(query.end);
+      if (end <= start) {
+        throw new Error('The period must end after it starts');
+      }
+      if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+        throw new Error(`Unknown equipment kind: ${String(query.kind)}`);
+      }
+      return [...equipment.values()]
+        .filter((item) => (query.kind === undefined || item.kind === query.kind) && isFree(item.id, start, end))
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
diff --git a/test/rental.test.ts b/test/rental.test.ts
index 4385d06041342d09f23fd88757c83a5cbc627f9a..a2c9514414826689ce08fc525b1624087e037d60 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -92,3 +92,32 @@ test('addEquipment validates the item', () => {
   service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100 });
   assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100 }));
 });
+
+test('availability lists the free items of a kind, sorted', () => {
+  const service = setup();
+  service.addEquipment({ id: 'board-0', kind: 'board', dailyPrice: 2000 });
+  service.book({ itemId: 'board-1', start: day(10), end: day(13) });
+  assert.deepEqual(service.availability({ start: day(11), end: day(12), kind: 'board' }), ['board-0']);
+  assert.deepEqual(service.availability({ start: day(13), end: day(14), kind: 'board' }), ['board-0', 'board-1']);
+});
+
+test('availability without a kind covers every kind', () => {
+  const service = setup();
+  service.book({ itemId: 'sail-1', start: day(10), end: day(11) });
+  assert.deepEqual(service.availability({ start: day(10), end: day(12) }), ['board-1']);
+  assert.deepEqual(service.availability({ start: day(11), end: day(12) }), ['board-1', 'sail-1']);
+});
+
+test('availability excludes items booked for any part of the period', () => {
+  const service = setup();
+  service.book({ itemId: 'board-1', start: day(12), end: day(13) });
+  assert.deepEqual(service.availability({ start: day(10), end: day(14), kind: 'board' }), []);
+});
+
+test('availability rejects invalid periods and unknown kinds', () => {
+  const service = setup();
+  assert.throws(() => service.availability({ start: day(11), end: day(10) }));
+  assert.throws(() => service.availability({ start: day(10), end: day(10) }));
+  assert.throws(() => service.availability({ start: '2026-07-10', end: day(11) }));
+  assert.throws(() => service.availability({ start: day(10), end: day(11), kind: 'kayak' as 'board' }));
+});
