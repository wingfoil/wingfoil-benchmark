+
+test('availability lists free items of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a1', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'b0', kind: 'board', dailyPrice: 2000 });
+  s.book({ itemId: 'b1', start: d(2), end: d(4) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(3) }), ['a1', 'b0']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3), kind: 'board' }), ['b0']);
+  assert.deepEqual(s.availability({ start: d(4), end: d(5), kind: 'board' }), ['b0', 'b1']);
+  assert.throws(() => s.availability({ start: d(3), end: d(3) }));
+});
