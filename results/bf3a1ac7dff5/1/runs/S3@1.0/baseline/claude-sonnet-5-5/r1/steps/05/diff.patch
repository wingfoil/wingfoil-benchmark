+
+test('cancel refunds before the start, frees the equipment, and works once', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(5), end: d(7) });
+  assert.deepEqual(s.cancel(a.id, h(10)), { bookingId: a.id, refund: a.total });
+  assert.deepEqual(s.availability({ start: d(5), end: d(7), kind: 'board' }).includes('b1'), true);
+  assert.throws(() => s.cancel(a.id, h(11)));
+  assert.throws(() => s.cancel('nope', h(11)));
+  assert.throws(() => s.cancel(a.id, 'garbage'));
+  const b = s.book({ itemId: 'b1', start: d(5), end: d(7) });
+  assert.equal(s.cancel(b.id, d(5)).refund, 0);
+});
