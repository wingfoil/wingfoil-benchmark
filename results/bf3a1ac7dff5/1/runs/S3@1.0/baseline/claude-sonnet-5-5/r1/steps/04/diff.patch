index 184cec09832d6cfb97b38345195097b05887c09a..b6fbf6ac55694e32927b89a00599d975a836766d 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -46,3 +46,25 @@ test('availability lists free items of a kind, sorted', () => {
   assert.deepEqual(s.availability({ start: d(4), end: d(5), kind: 'board' }), ['b0', 'b1']);
   assert.throws(() => s.availability({ start: d(3), end: d(3) }));
 });
+
+const h = (hour: number, day = 1) => `2026-07-${String(day).padStart(2, '0')}T${String(hour).padStart(2, '0')}:00:00Z`;
+
+test('rents by the hour at the hourly price, without discount', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  assert.equal(s.quote({ itemId: 'h1', start: h(10), end: h(13) }).total, 1800);
+  assert.equal(s.quote({ itemId: 'h1', start: h(10), end: h(9, 2) }).total, 23 * 600);
+  assert.equal(s.book({ itemId: 'h1', start: h(10), end: h(12) }).total, 1200);
+  assert.throws(() => s.book({ itemId: 'h1', start: h(11), end: h(13) }));
+  s.book({ itemId: 'h1', start: h(12), end: h(14) });
+  assert.deepEqual(s.availability({ start: h(9), end: h(10) }), ['h1']);
+});
+
+test('hourly rentals need an hourly price and whole hours', () => {
+  const s = setup();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  assert.throws(() => s.quote({ itemId: 'b1', start: h(10), end: h(12) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-07-01T10:30:00Z', end: h(12) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: h(10), end: h(12, 2) }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+});
