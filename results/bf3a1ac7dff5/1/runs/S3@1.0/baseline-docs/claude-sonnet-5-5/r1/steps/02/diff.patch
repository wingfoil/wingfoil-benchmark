diff --git a/test/rental.test.ts b/test/rental.test.ts
index b8ea0af25c56ddba336c4821af566ad146c295d2..cecbc45ef731e36c1a0956c54263f1508f6142f2 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -92,4 +92,43 @@ describe('rental service', () => {
       assert.throws(() => service.book({ itemId: 'board-1', start: day(1), end: day(2) }));
     });
   });
+
+  describe('availability', () => {
+    beforeEach(() => {
+      service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2000 });
+      service.addEquipment({ id: 'a-sail', kind: 'sail', dailyPrice: 1000 });
+    });
+
+    it('lists every free item of any kind, sorted', () => {
+      assert.deepEqual(service.availability({ start: day(1), end: day(2) }), ['a-sail', 'board-1', 'board-2', 'sail-1']);
+    });
+
+    it('filters by kind', () => {
+      assert.deepEqual(service.availability({ start: day(1), end: day(2), kind: 'board' }), ['board-1', 'board-2']);
+    });
+
+    it('leaves out items booked for part of the period', () => {
+      service.book({ itemId: 'board-1', start: day(3), end: day(5) });
+      assert.deepEqual(service.availability({ start: day(1), end: day(4), kind: 'board' }), ['board-2']);
+      assert.deepEqual(service.availability({ start: day(4), end: day(8), kind: 'board' }), ['board-2']);
+    });
+
+    it('keeps items booked back-to-back', () => {
+      service.book({ itemId: 'board-1', start: day(3), end: day(5) });
+      assert.deepEqual(service.availability({ start: day(1), end: day(3), kind: 'board' }), ['board-1', 'board-2']);
+      assert.deepEqual(service.availability({ start: day(5), end: day(6), kind: 'board' }), ['board-1', 'board-2']);
+    });
+
+    it('returns an empty list when nothing is free', () => {
+      service.book({ itemId: 'board-1', start: day(1), end: day(3) });
+      service.book({ itemId: 'board-2', start: day(1), end: day(3) });
+      assert.deepEqual(service.availability({ start: day(2), end: day(3), kind: 'board' }), []);
+    });
+
+    it('rejects invalid periods and kinds', () => {
+      assert.throws(() => service.availability({ start: day(2), end: day(2) }));
+      assert.throws(() => service.availability({ start: '2026-07-01T10:00:00Z', end: day(2) }));
+      assert.throws(() => service.availability({ start: day(1), end: day(2), kind: 'boat' as 'board' }));
+    });
+  });
 });
