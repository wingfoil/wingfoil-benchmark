@@ -46,6 +46,15 @@ export interface RentalService {
   availability(query: AvailabilityQuery): string[];
 }
 
+const LONG_STAY_DAYS = 3;
+const LONG_STAY_PERCENT_PAID = 90;
+
+/** Total in euro cents for `days` days: 10% off from 3 days, rounded to the nearest cent. */
+function rentalTotal(dailyPrice: number, days: number): number {
+  const full = dailyPrice * days;
+  return days >= LONG_STAY_DAYS ? Math.round((full * LONG_STAY_PERCENT_PAID) / 100) : full;
+}
+
 interface StoredBooking {
   booking: Booking;
   period: Period;
