diff --git a/test/diff.test.ts b/test/diff.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b5c99014c2192c290e22a353a9f45313ddfa398c
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,62 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+import type { JsonValue } from "../src/index.ts";
+
+const roundTrips: Array<[string, JsonValue, JsonValue]> = [
+  ["equal documents", { a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }],
+  ["primitive replaced", 1, 2],
+  ["type change at root", { a: 1 }, [1]],
+  ["member added, removed, changed", { a: 1, b: 2 }, { b: 3, c: 4 }],
+  ["null member", { a: 1 }, { a: null }],
+  ["nested change", { a: { b: { c: 1 } } }, { a: { b: { c: 2 } } }],
+  ["array append", [1, 2], [1, 2, 3]],
+  ["array prepend", [2, 3], [1, 2, 3]],
+  ["array insert in middle", [1, 4], [1, 2, 3, 4]],
+  ["array shrink", [1, 2, 3, 4, 5], [1, 5]],
+  ["array element changed", [1, { a: 1 }, 3], [1, { a: 2 }, 3]],
+  ["array to empty", [1, 2], []],
+  ["escaped member names", { "a/b": 1, "~": 2 }, { "a/b": 2, "~": 3, "c~/": 1 }],
+  ["empty member name", { "": 1 }, { "": 2 }],
+  ["__proto__ member", JSON.parse('{"__proto__": 1}'), JSON.parse('{"__proto__": 2}')],
+  ["member order is irrelevant", { a: 1, b: 2 }, { b: 2, a: 1 }],
+];
+
+for (const [name, from, to] of roundTrips) {
+  test(`createPatch round-trips: ${name}`, () => {
+    assert.deepEqual(applyPatch(from, createPatch(from, to)), to);
+  });
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(createPatch({ a: [1, 2] }, { a: [1, 2] }), []);
+});
+
+test("a small change gives a small patch", () => {
+  const from = { big: { x: [1, 2, 3], y: "long" }, n: 1 };
+  const to = { big: { x: [1, 2, 3], y: "long" }, n: 2 };
+  assert.deepEqual(createPatch(from, to), [{ op: "replace", path: "/n", value: 2 }]);
+});
+
+test("array insertion is a single add", () => {
+  assert.deepEqual(createPatch([1, 4], [1, 2, 4]), [{ op: "add", path: "/1", value: 2 }]);
+});
+
+test("array removal is a single remove", () => {
+  assert.deepEqual(createPatch([1, 2, 4], [1, 4]), [{ op: "remove", path: "/1" }]);
+});
+
+test("member names are escaped in paths", () => {
+  assert.deepEqual(createPatch({ "a/b~": 1 }, { "a/b~": 2 }), [{ op: "replace", path: "/a~1b~0", value: 2 }]);
+});
+
+test("inputs are not mutated and the patch shares no structure with them", () => {
+  const from = { a: 1 };
+  const to = { b: { c: [1] } };
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, { a: 1 });
+  assert.deepEqual(to, { b: { c: [1] } });
+  const value = (patch.find((op) => op.op === "add") as { value: { c: number[] } }).value;
+  assert.notEqual(value, to.b);
+  assert.notEqual(value.c, to.b.c);
+});
