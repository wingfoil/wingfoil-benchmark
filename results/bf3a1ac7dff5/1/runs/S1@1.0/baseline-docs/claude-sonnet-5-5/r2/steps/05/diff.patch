@@ -0,0 +1,88 @@
+import { jsonEqual } from "./patch.ts";
+import type { PatchOperation } from "./patch.ts";
+import type { JsonValue } from "./pointer.ts";
+
+type JsonObject = { [member: string]: JsonValue };
+
+function isObject(value: JsonValue): value is JsonObject {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Escapes a member name as a JSON Pointer reference token (RFC 6901, section 3). */
+function escapeToken(token: string): string {
+  return token.replaceAll("~", "~0").replaceAll("/", "~1");
+}
+
+function diffObjects(from: JsonObject, to: JsonObject, path: string): PatchOperation[] {
+  const operations: PatchOperation[] = [];
+  for (const name of Object.keys(from)) {
+    if (!Object.hasOwn(to, name)) {
+      operations.push({ op: "remove", path: `${path}/${escapeToken(name)}` });
+    }
+  }
+  for (const [name, value] of Object.entries(to)) {
+    const memberPath = `${path}/${escapeToken(name)}`;
+    if (Object.hasOwn(from, name)) {
+      operations.push(...diff(from[name], value, memberPath));
+    } else {
+      operations.push({ op: "add", path: memberPath, value: structuredClone(value) });
+    }
+  }
+  return operations;
+}
+
+/**
+ * Diffs two arrays by skipping their common prefix and suffix, then comparing the remaining
+ * elements pairwise; surplus elements of `from` are removed and surplus elements of `to` added.
+ */
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string): PatchOperation[] {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+    start++;
+  }
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && jsonEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+  const operations: PatchOperation[] = [];
+  const common = Math.min(fromEnd, toEnd) - start;
+  for (let i = start; i < start + common; i++) {
+    operations.push(...diff(from[i], to[i], `${path}/${i}`));
+  }
+  for (let i = start + common; i < fromEnd; i++) {
+    operations.push({ op: "remove", path: `${path}/${start + common}` });
+  }
+  for (let i = start + common; i < toEnd; i++) {
+    operations.push({ op: "add", path: `${path}/${i}`, value: structuredClone(to[i]) });
+  }
+  return operations;
+}
+
+function diff(from: JsonValue, to: JsonValue, path: string): PatchOperation[] {
+  if (jsonEqual(from, to)) {
+    return [];
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    return diffArrays(from, to, path);
+  }
+  if (isObject(from) && isObject(to)) {
+    return diffObjects(from, to, path);
+  }
+  return [{ op: "replace", path, value: structuredClone(to) }];
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch is limited to what changed: objects are compared member by member and arrays element
+ * by element, so only the differing places are described. Equal documents give an empty patch.
+ * Neither argument is mutated, and the patch shares no structure with them.
+ *
+ * @param from - the original parsed JSON document.
+ * @param to - the new parsed JSON document.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  return diff(from, to, "");
+}
