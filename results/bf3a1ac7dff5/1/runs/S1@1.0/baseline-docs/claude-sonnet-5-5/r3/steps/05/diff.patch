@@ -46,3 +46,16 @@ shares no structure with them. Because `null` means "remove", a merge patch cann
 ```ts
 applyMergePatch({ a: "b", c: { d: 1 } }, { a: null, c: { e: 2 } }); // { c: { d: 1, e: 2 } }
 ```
+
+## Creating a patch
+
+`createPatch(from, to)` returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with
+`applyPatch`, made of `add`, `remove` and `replace` operations only. It describes what changed and
+nothing more: objects are compared member by member and arrays element by element, recursively, and
+equal documents give an empty patch. Arrays are compared by position, so inserting at the front of an
+array rewrites the elements after it instead of detecting the shift. Neither argument is mutated and
+the values in the patch share no structure with them.
+
+```ts
+createPatch({ a: 1, b: [1, 2] }, { a: 1, b: [1, 3] }); // [{ op: "replace", path: "/b/1", value: 3 }]
+```
diff --git a/src/index.ts b/src/index.ts
index 8b048d4bfc002d82b40c87d3780c8c59c0c0ba38..61aa7e8adbb39fbe16834d92b815f677bc39696b 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -260,3 +260,70 @@ export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue
   }
   return result as JsonValue;
 }
+
+/** Encodes one reference token (RFC 6901 §3); `~` must be encoded before `/`. */
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Appends to `operations` the operations turning `from` into `to`, found at `path`. */
+function diff(from: JsonValue, to: JsonValue, path: string, operations: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, operations);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from as Record<string, JsonValue>, to as Record<string, JsonValue>, path, operations);
+  } else if (!jsonEqual(from, to)) {
+    operations.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/** Diffs member by member; names are visited in the order of each document. */
+function diffObjects(
+  from: Record<string, JsonValue>,
+  to: Record<string, JsonValue>,
+  path: string,
+  operations: PatchOperation[],
+): void {
+  for (const name of Object.keys(from)) {
+    if (!Object.hasOwn(to, name)) {
+      operations.push({ op: "remove", path: `${path}/${encodeToken(name)}` });
+    }
+  }
+  for (const name of Object.keys(to)) {
+    const child = `${path}/${encodeToken(name)}`;
+    if (Object.hasOwn(from, name)) {
+      diff(from[name], to[name], child, operations);
+    } else {
+      operations.push({ op: "add", path: child, value: structuredClone(to[name]) });
+    }
+  }
+}
+
+/** Diffs element by element, then drops the surplus tail (last first) or appends the new one. */
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, operations: PatchOperation[]): void {
+  const common = Math.min(from.length, to.length);
+  for (let index = 0; index < common; index++) {
+    diff(from[index], to[index], `${path}/${index}`, operations);
+  }
+  for (let index = from.length - 1; index >= common; index--) {
+    operations.push({ op: "remove", path: `${path}/${index}` });
+  }
+  for (let index = common; index < to.length; index++) {
+    operations.push({ op: "add", path: `${path}/${index}`, value: structuredClone(to[index]) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied.
+ *
+ * The patch only describes what changed: objects are compared member by member and
+ * arrays element by element, so a small difference yields a small patch. Arrays are
+ * compared by position, so inserting at the front of an array rewrites the elements
+ * after it rather than detecting the shift. Equal documents give an empty patch.
+ * Neither argument is mutated and the values in the patch share no structure with them.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  const operations: PatchOperation[] = [];
+  diff(from, to, "", operations);
+  return operations;
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eb363d3b12050a6497779133be1114620375975c
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { applyPatch, createPatch, type JsonValue } from "../src/index.ts";
+
+// Each case is [description, from, to, expected patch].
+const cases: [string, JsonValue, JsonValue, unknown][] = [
+  ["identical documents", { a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }, []],
+  ["member order is irrelevant", { a: 1, b: 2 }, { b: 2, a: 1 }, []],
+  ["changed member", { a: 1, b: 2 }, { a: 1, b: 3 }, [{ op: "replace", path: "/b", value: 3 }]],
+  ["added member", { a: 1 }, { a: 1, b: 2 }, [{ op: "add", path: "/b", value: 2 }]],
+  ["removed member", { a: 1, b: 2 }, { a: 1 }, [{ op: "remove", path: "/b" }]],
+  ["nested change", { a: { b: { c: 1, d: 2 } } }, { a: { b: { c: 1, d: 3 } } }, [{ op: "replace", path: "/a/b/d", value: 3 }]],
+  ["escaped member names", { "a/b": 1, "~": 1 }, { "a/b": 2, "~": 2 }, [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/~0", value: 2 },
+  ]],
+  ["changed array element", { a: [1, 2, 3] }, { a: [1, 9, 3] }, [{ op: "replace", path: "/a/1", value: 9 }]],
+  ["appended array elements", [1], [1, 2, 3], [
+    { op: "add", path: "/1", value: 2 },
+    { op: "add", path: "/2", value: 3 },
+  ]],
+  ["truncated array", [1, 2, 3], [1], [
+    { op: "remove", path: "/2" },
+    { op: "remove", path: "/1" },
+  ]],
+  ["array becomes object", { a: [1] }, { a: { 0: 1 } }, [{ op: "replace", path: "/a", value: { 0: 1 } }]],
+  ["null replaced by value", { a: null }, { a: 1 }, [{ op: "replace", path: "/a", value: 1 }]],
+  ["scalar root", 1, 2, [{ op: "replace", path: "", value: 2 }]],
+  ["root changes type", { a: 1 }, [1], [{ op: "replace", path: "", value: [1] }]],
+  ["__proto__ member", JSON.parse('{"__proto__":1}'), JSON.parse('{"__proto__":2}'), [{ op: "replace", path: "/__proto__", value: 2 }]],
+];
+
+for (const [name, from, to, expected] of cases) {
+  test(`createPatch: ${name}`, () => {
+    const patch = createPatch(from, to);
+    assert.deepEqual(patch, expected);
+    assert.deepEqual(applyPatch(from, patch), to);
+  });
+}
+
+test("createPatch does not mutate its inputs", () => {
+  const from = { a: [1, 2], b: { c: 1 } };
+  const to = { a: [1], b: { c: 1, d: [2] } };
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  createPatch(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+});
+
+test("createPatch values share no structure with the target", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  assert.notEqual((patch[0] as { value: unknown }).value, to.a);
+  assert.deepEqual(applyPatch({}, patch), to);
+});
