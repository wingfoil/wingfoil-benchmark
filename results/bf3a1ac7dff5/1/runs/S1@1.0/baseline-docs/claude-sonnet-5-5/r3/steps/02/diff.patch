 ```
 
 Run the tests with `npm test`.
+
+## JSON Patch (RFC 6902)
+
+`applyPatch(document, patch)` applies a JSON Patch, an array of `add`, `remove`, `replace`, `move`,
+`copy` and `test` operations, and returns the resulting document as a new value. Neither the document
+nor the patch is mutated, and the result shares no structure with them. It throws an `Error` if the
+patch is not an array of valid operations (unknown `op`, missing or non-string `path`/`from`, missing
+`value`, invalid pointer) or if an operation fails: unresolved location, array index out of range or
+not canonical, failed `test`, moving a value into one of its own children, or removing the whole
+document (which RFC 6902 leaves undefined). Members of an operation that the RFC does not define are
+ignored. Pointers follow `resolvePointer`: only own members are followed.
+
+```ts
+applyPatch({ a: [1] }, [{ op: "add", path: "/a/-", value: 2 }]); // { a: [1, 2] }
+```
diff --git a/src/index.ts b/src/index.ts
index 0f9a4ae5a58d802cd17d2445a630db1dc33f9d48..9d13327e64e5b9bbdbd2db8d86d9d9043144c7af 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -59,3 +59,179 @@ function step(parent: unknown, token: string): unknown {
 export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
   return parsePointer(pointer).reduce<unknown>(step, document) as JsonValue;
 }
+
+/** One operation of a JSON Patch (RFC 6902 §4). */
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; path: string; from: string };
+
+/** Container being edited: its parent value and the last token of the pointer. */
+type Location = { parent: unknown; token: string };
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Deep equality of two JSON values (RFC 6902 §4.6): object member order is irrelevant. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) &&
+      Array.isArray(b) &&
+      a.length === b.length &&
+      a.every((item, index) => jsonEqual(item, b[index]))
+    );
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.hasOwn(b, key) && jsonEqual(a[key], b[key]))
+    );
+  }
+  return a === b;
+}
+
+/** Finds the existing parent of the location a non-empty token list designates. */
+function locate(document: unknown, tokens: string[]): Location {
+  return {
+    parent: tokens.slice(0, -1).reduce<unknown>(step, document),
+    token: tokens[tokens.length - 1],
+  };
+}
+
+/** Sets an own member, even one named `__proto__`, without touching the prototype. */
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
+
+/** Adds `value` at the location (RFC 6902 §4.1); returns the new document. */
+function addValue(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const { parent, token } = locate(document, tokens);
+  if (Array.isArray(parent)) {
+    const index = token === "-" ? parent.length : Number(token);
+    if (token !== "-" && !ARRAY_INDEX.test(token)) {
+      throw new Error(`JSON Patch: invalid array index "${token}"`);
+    }
+    if (index > parent.length) {
+      throw new Error(`JSON Patch: array index "${token}" is out of range`);
+    }
+    parent.splice(index, 0, value);
+  } else if (isObject(parent)) {
+    setMember(parent, token, value);
+  } else {
+    throw new Error(`JSON Patch: cannot add "${token}" to a scalar`);
+  }
+  return document;
+}
+
+/** Removes the value at the location (RFC 6902 §4.2); returns the new document. */
+function removeValue(document: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) {
+    throw new Error("JSON Patch: cannot remove the whole document");
+  }
+  const { parent, token } = locate(document, tokens);
+  step(parent, token);
+  if (Array.isArray(parent)) {
+    parent.splice(Number(token), 1);
+  } else {
+    delete (parent as Record<string, unknown>)[token];
+  }
+  return document;
+}
+
+/** Replaces the existing value at the location (RFC 6902 §4.3). */
+function replaceValue(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const { parent, token } = locate(document, tokens);
+  step(parent, token);
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else {
+    setMember(parent as Record<string, unknown>, token, value);
+  }
+  return document;
+}
+
+/** Moves the value at `from` to `path` (RFC 6902 §4.4). */
+function moveValue(document: unknown, from: string[], path: string[]): unknown {
+  const value = from.reduce<unknown>(step, document);
+  if (path.length > from.length && from.every((token, index) => token === path[index])) {
+    throw new Error("JSON Patch: cannot move a value into one of its children");
+  }
+  return addValue(removeValue(document, from), path, value);
+}
+
+function checkString(operation: Record<string, unknown>, member: string): string {
+  const text = operation[member];
+  if (typeof text !== "string") {
+    throw new Error(`JSON Patch: "${member}" must be a string`);
+  }
+  return text;
+}
+
+function checkValue(operation: Record<string, unknown>): JsonValue {
+  if (!Object.hasOwn(operation, "value")) {
+    throw new Error(`JSON Patch: "${operation.op}" requires a "value"`);
+  }
+  return structuredClone(operation.value) as JsonValue;
+}
+
+/** Applies one operation to `document`, which it may edit; returns the new document. */
+function applyOperation(document: unknown, operation: unknown): unknown {
+  if (!isObject(operation)) {
+    throw new Error("JSON Patch: each operation must be an object");
+  }
+  const path = parsePointer(checkString(operation, "path"));
+  switch (operation.op) {
+    case "add":
+      return addValue(document, path, checkValue(operation));
+    case "remove":
+      return removeValue(document, path);
+    case "replace":
+      return replaceValue(document, path, checkValue(operation));
+    case "move":
+      return moveValue(document, parsePointer(checkString(operation, "from")), path);
+    case "copy": {
+      const from = parsePointer(checkString(operation, "from"));
+      return addValue(document, path, structuredClone(from.reduce<unknown>(step, document)));
+    }
+    case "test":
+      if (!jsonEqual(path.reduce<unknown>(step, document), checkValue(operation))) {
+        throw new Error("JSON Patch: test failed, values differ");
+      }
+      return document;
+    default:
+      throw new Error(`JSON Patch: unknown operation "${String(operation.op)}"`);
+  }
+}
+
+/**
+ * Applies `patch`, a JSON Patch (RFC 6902), to `document` and returns the result.
+ *
+ * Neither argument is mutated and the result shares no structure with them: the
+ * document is cloned and values taken from the patch are cloned as they are added.
+ * Operations apply in order; as the work happens on the clone, a failing operation
+ * leaves the caller with nothing but the error.
+ *
+ * @throws Error if `patch` is not an array of valid operations, a pointer is invalid,
+ * or an operation fails (unresolved location, out-of-range index, failed `test`,
+ * removing the whole document, or moving a value into one of its own children).
+ */
+export function applyPatch(document: JsonValue, patch: PatchOperation[]): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("JSON Patch: a patch must be an array of operations");
+  }
+  return patch.reduce<unknown>(applyOperation, structuredClone(document)) as JsonValue;
+}
