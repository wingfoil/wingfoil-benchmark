+++ b/test/patch.test.ts
@@ -0,0 +1,113 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { applyPatch } from "../src/index.ts";
+
+// Each case is [description, document, patch, expected result]; RFC 6902 Appendix A.
+const succeeding: [string, unknown, unknown, unknown][] = [
+  ["A.1 adding an object member", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" }],
+  ["A.2 adding an array element", { foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] }],
+  ["A.3 removing an object member", { baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }],
+  ["A.4 removing an array element", { foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }],
+  ["A.5 replacing a value", { baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" }],
+  [
+    "A.6 moving a value",
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  ],
+  ["A.7 moving an array element", { foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], { foo: ["all", "cows", "eat", "grass"] }],
+  ["A.8 testing a value: success", { baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], { baz: "qux", foo: ["a", 2, "c"] }],
+  ["A.10 adding a nested member object", { foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } }],
+  ["A.11 ignoring unrecognized elements", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" }],
+  ["A.14 escape ordering", { "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }],
+  ["A.16 adding an array value", { foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] }],
+  ["copying a value", { a: { b: [1] } }, [{ op: "copy", from: "/a/b", path: "/c" }], { a: { b: [1] }, c: [1] }],
+  ["add at the root replaces the document", { a: 1 }, [{ op: "add", path: "", value: [1] }], [1]],
+  ["replace at the root", { a: 1 }, [{ op: "replace", path: "", value: null }], null],
+  ["add replaces an existing member", { a: 1 }, [{ op: "add", path: "/a", value: 2 }], { a: 2 }],
+  ["add appends at index equal to length", [1], [{ op: "add", path: "/1", value: 2 }], [1, 2]],
+  ["move onto itself changes nothing", { a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 }],
+  ["move into a sibling prefix name", { a: 1, ab: {} }, [{ op: "move", from: "/a", path: "/ab/a" }], { ab: { a: 1 } }],
+  ["test compares objects regardless of key order", { a: { x: 1, y: [1, { z: null }] } }, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }], { a: { x: 1, y: [1, { z: null }] } }],
+  ["an empty patch returns the document", { a: 1 }, [], { a: 1 }],
+  ["operations apply in order", {}, [{ op: "add", path: "/a", value: 1 }, { op: "move", from: "/a", path: "/b" }], { b: 1 }],
+  ["a __proto__ member is an ordinary member", {}, [{ op: "add", path: "/__proto__", value: { x: 1 } }], JSON.parse('{"__proto__":{"x":1}}')],
+];
+
+for (const [name, document, patch, expected] of succeeding) {
+  test(`applyPatch: ${name}`, () => {
+    assert.deepEqual(applyPatch(document as never, patch as never), expected);
+  });
+}
+
+const failing: [string, unknown, unknown][] = [
+  ["A.9 testing a value: error", { baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]],
+  ["A.12 adding to a nonexistent target", { foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]],
+  ["A.13 invalid JSON patch document", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", op2: 1 }, { op: "add", path: "/baz" }]],
+  ["patch is not an array", {}, { op: "add", path: "/a", value: 1 }],
+  ["operation is not an object", {}, [null]],
+  ["unknown operation", {}, [{ op: "merge", path: "/a" }]],
+  ["missing path", {}, [{ op: "remove" }]],
+  ["path is not a string", {}, [{ op: "remove", path: 1 }]],
+  ["add without value", {}, [{ op: "add", path: "/a" }]],
+  ["replace without value", { a: 1 }, [{ op: "replace", path: "/a" }]],
+  ["test without value", { a: 1 }, [{ op: "test", path: "/a" }]],
+  ["move without from", { a: 1 }, [{ op: "move", path: "/b" }]],
+  ["copy without from", { a: 1 }, [{ op: "copy", path: "/b" }]],
+  ["invalid pointer", {}, [{ op: "add", path: "a", value: 1 }]],
+  ["remove a missing member", {}, [{ op: "remove", path: "/a" }]],
+  ["remove a missing element", [1], [{ op: "remove", path: "/1" }]],
+  ["remove with the - token", [1], [{ op: "remove", path: "/-" }]],
+  ["remove the root", { a: 1 }, [{ op: "remove", path: "" }]],
+  ["replace a missing member", {}, [{ op: "replace", path: "/a", value: 1 }]],
+  ["replace past the end of an array", [1], [{ op: "replace", path: "/1", value: 1 }]],
+  ["add beyond the end of an array", [1], [{ op: "add", path: "/2", value: 1 }]],
+  ["add at a non-canonical index", [1], [{ op: "add", path: "/01", value: 1 }]],
+  ["add at a negative index", [1], [{ op: "add", path: "/-1", value: 1 }]],
+  ["add under a scalar", { a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]],
+  ["move from a missing location", {}, [{ op: "move", from: "/a", path: "/b" }]],
+  ["move into its own child", { a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/c" }]],
+  ["copy from a missing location", {}, [{ op: "copy", from: "/a", path: "/b" }]],
+  ["test a missing location", {}, [{ op: "test", path: "/a", value: 1 }]],
+  ["test with a different type", { a: 1 }, [{ op: "test", path: "/a", value: "1" }]],
+  ["test with arrays of different length", { a: [1] }, [{ op: "test", path: "/a", value: [1, 2] }]],
+  ["test with objects of different keys", { a: { x: 1 } }, [{ op: "test", path: "/a", value: { y: 1 } }]],
+  ["a later failure fails the whole patch", {}, [{ op: "add", path: "/a", value: 1 }, { op: "remove", path: "/b" }]],
+  ["inherited members are not followed", {}, [{ op: "remove", path: "/toString" }]],
+];
+
+for (const [name, document, patch] of failing) {
+  test(`applyPatch throws: ${name}`, () => {
+    assert.throws(() => applyPatch(document as never, patch as never), Error);
+  });
+}
+
+test("applyPatch does not mutate the document or the patch", () => {
+  const document = { a: { b: [1, 2] }, c: 1 };
+  const patch = [
+    { op: "add", path: "/a/b/-", value: { n: 1 } },
+    { op: "copy", from: "/a", path: "/d" },
+    { op: "remove", path: "/c" },
+  ];
+  const documentBefore = structuredClone(document);
+  const patchBefore = structuredClone(patch);
+  applyPatch(document, patch as never);
+  assert.deepEqual(document, documentBefore);
+  assert.deepEqual(patch, patchBefore);
+});
+
+test("applyPatch shares no structure between the result, the patch and copies", () => {
+  const value = { n: [1] };
+  const result = applyPatch({}, [
+    { op: "add", path: "/a", value },
+    { op: "copy", from: "/a", path: "/b" },
+  ]) as { a: { n: number[] }; b: { n: number[] } };
+  result.a.n.push(2);
+  assert.deepEqual(value, { n: [1] });
+  assert.deepEqual(result.b, { n: [1] });
+});
+
+test("applyPatch does not reach the prototype chain", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/__proto__/polluted", value: 1 }]), Error);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
