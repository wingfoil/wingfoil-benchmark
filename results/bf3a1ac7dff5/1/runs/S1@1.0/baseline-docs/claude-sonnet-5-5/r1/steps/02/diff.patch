diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7108a05ba3093fd127c1685d473ec5290bad4327
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,167 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { applyPatch, type JsonValue } from "../src/index.ts";
+
+type Patch = Parameters<typeof applyPatch>[1];
+
+test("add sets a member, replaces an existing one and inserts into arrays", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), {
+    foo: "bar",
+    baz: "qux",
+  });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), {
+    foo: ["bar", "qux", "baz"],
+  });
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: "x" }]), {
+    foo: ["bar", "x"],
+  });
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/1", value: "x" }]), {
+    foo: ["bar", "x"],
+  });
+});
+
+test("add with the empty path replaces the whole document", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+});
+
+test("add fails on a missing parent, a bad index or a primitive parent", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/x/y", value: 1 }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/2", value: 1 }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/01", value: 1 }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/x", value: 1 }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]));
+});
+
+test("remove deletes members and array elements", () => {
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(applyPatch({ a: [1, 2, 3] }, [{ op: "remove", path: "/a/1" }]), { a: [1, 3] });
+});
+
+test("remove fails on a missing target", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "/b" }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "remove", path: "/a/1" }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "remove", path: "/a/-" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]));
+});
+
+test("replace changes an existing value", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch({ a: [1, 2] }, [{ op: "replace", path: "/a/1", value: 9 }]), { a: [1, 9] });
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+});
+
+test("replace fails on a missing target", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "replace", path: "/b", value: 2 }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "replace", path: "/a/1", value: 2 }]));
+});
+
+test("move relocates a value", () => {
+  assert.deepEqual(
+    applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [
+      { op: "move", from: "/foo/waldo", path: "/qux/thud" },
+    ]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+});
+
+test("move fails on a missing source or into its own child", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "/b", path: "/c" }]));
+  assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]));
+});
+
+test("copy duplicates a value without sharing it", () => {
+  const result = applyPatch({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }]) as {
+    a: object;
+    b: object;
+  };
+  assert.deepEqual(result, { a: { x: 1 }, b: { x: 1 } });
+  assert.notEqual(result.a, result.b);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", from: "/b", path: "/c" }]));
+});
+
+test("test checks deep equality and fails otherwise", () => {
+  const doc = { a: { x: [1, { y: null }], z: "s" }, n: 1 };
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/a", value: { z: "s", x: [1, { y: null }] } }]), doc);
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "", value: doc }]), doc);
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/n", value: "1" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/x", value: [1] }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/x/1", value: {} }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/missing", value: null }]));
+});
+
+test("operations apply in order and a failure aborts the whole patch", () => {
+  assert.deepEqual(
+    applyPatch({}, [
+      { op: "add", path: "/a", value: 1 },
+      { op: "copy", from: "/a", path: "/b" },
+    ]),
+    { a: 1, b: 1 },
+  );
+  assert.throws(() =>
+    applyPatch({ a: 1 }, [
+      { op: "remove", path: "/a" },
+      { op: "test", path: "/a", value: 1 },
+    ]),
+  );
+});
+
+test("does not mutate the document or the patch, and shares nothing with them", () => {
+  const doc = { a: [1, 2], o: { k: 1 } };
+  const snapshot = structuredClone(doc);
+  const value = { deep: [1] };
+  const patch: Patch = [
+    { op: "add", path: "/a/0", value: 0 },
+    { op: "remove", path: "/o/k" },
+    { op: "add", path: "/v", value },
+  ];
+  const result = applyPatch(doc, patch) as { v: object };
+  assert.deepEqual(doc, snapshot);
+  assert.deepEqual(value, { deep: [1] });
+  assert.notEqual(result.v, value);
+  assert.deepEqual(applyPatch(doc, []), doc);
+  assert.notEqual(applyPatch(doc, []), doc);
+});
+
+test("handles escaped pointer tokens and never touches the prototype", () => {
+  assert.deepEqual(applyPatch({ "a/b": 1, "m~n": 2 }, [
+    { op: "replace", path: "/a~1b", value: 3 },
+    { op: "remove", path: "/m~0n" },
+  ]), { "a/b": 3 });
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]);
+  assert.equal(Object.hasOwn(result as object, "__proto__"), true);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/__proto__" }]));
+});
+
+test("rejects invalid patches", () => {
+  const bad = (patch: unknown): void => {
+    assert.throws(() => applyPatch({ a: 1 }, patch as Patch));
+  };
+  bad({});
+  bad(null);
+  bad([null]);
+  bad([[]]);
+  bad([{ path: "/a" }]);
+  bad([{ op: "frobnicate", path: "/a" }]);
+  bad([{ op: "remove" }]);
+  bad([{ op: "remove", path: 1 }]);
+  bad([{ op: "remove", path: "a" }]);
+  bad([{ op: "remove", path: "/a~2" }]);
+  bad([{ op: "add", path: "/b" }]);
+  bad([{ op: "replace", path: "/a" }]);
+  bad([{ op: "test", path: "/a" }]);
+  bad([{ op: "move", path: "/b" }]);
+  bad([{ op: "copy", path: "/b", from: 1 }]);
+  bad([{ op: "copy", path: "/b", from: "x" }]);
+});
+
+test("a test operation accepts an explicit null value", () => {
+  const doc: JsonValue = { a: null };
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/a", value: null }]), doc);
+});
