 the empty path) and moving a value into its own child. `add` and `replace` with the empty path replace
 the whole document.
 
+`createPatch(from, to)`, exported from `src/index.ts`, returns a JSON Patch that turns `from` into `to`
+when given to `applyPatch`, and sends only what changed. Objects are compared member by member and
+recursively; arrays are compared after skipping their common head and tail, then element by element, so
+an insertion or removal costs one operation rather than a rewrite of the array. A value is replaced as a
+whole only when its type differs or it is a changed primitive. Equal documents give an empty patch.
+Neither argument is mutated and the patch shares no structure with them.
+
 ## JSON Merge Patch (RFC 7386)
 
 `applyMergePatch(target, patch)`, exported from `src/index.ts`, applies a JSON Merge Patch to `target`
diff --git a/src/index.ts b/src/index.ts
index a6d3bfd8ce43067af484c24ba29bc884893b2d9e..7d5b249c993a3dbcaf76288bb195d2f487faa588 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -244,3 +244,88 @@ function merge(target: JsonValue, patch: JsonValue): JsonValue {
 export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
   return merge(structuredClone(target), patch);
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffValues(from: JsonValue, to: JsonValue, path: string, patch: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, patch);
+  } else if (isMergeObject(from) && isMergeObject(to)) {
+    diffObjects(from, to, path, patch);
+  } else if (!deepEqual(from, to)) {
+    patch.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+function diffObjects(
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  path: string,
+  patch: PatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      patch.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const memberPath = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) {
+      diffValues(from[key], to[key], memberPath, patch);
+    } else {
+      patch.push({ op: "add", path: memberPath, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+function commonPrefixLength(from: JsonValue[], to: JsonValue[]): number {
+  let length = 0;
+  while (length < from.length && length < to.length && deepEqual(from[length], to[length])) {
+    length++;
+  }
+  return length;
+}
+
+function commonSuffixLength(from: JsonValue[], to: JsonValue[], limit: number): number {
+  let length = 0;
+  while (
+    length < limit &&
+    deepEqual(from[from.length - 1 - length], to[to.length - 1 - length])
+  ) {
+    length++;
+  }
+  return length;
+}
+
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, patch: PatchOperation[]): void {
+  const start = commonPrefixLength(from, to);
+  const suffix = commonSuffixLength(from, to, Math.min(from.length, to.length) - start);
+  const fromEnd = from.length - suffix;
+  const toEnd = to.length - suffix;
+  const shared = Math.min(fromEnd, toEnd) - start;
+  for (let i = start; i < start + shared; i++) {
+    diffValues(from[i], to[i], `${path}/${i}`, patch);
+  }
+  for (let i = fromEnd - 1; i >= start + shared; i--) {
+    patch.push({ op: "remove", path: `${path}/${i}` });
+  }
+  for (let i = start + shared; i < toEnd; i++) {
+    patch.push({ op: "add", path: `${path}/${i}`, value: structuredClone(to[i]) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch is minimal in spirit: it only names what changed. Objects are compared member by member
+ * and recursively, arrays are compared after skipping their common head and tail, and a value is
+ * replaced as a whole only when its type differs or it is a changed primitive. Equal documents give
+ * an empty patch. Neither argument is mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  const patch: PatchOperation[] = [];
+  diffValues(from, to, "", patch);
+  return patch;
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..43a6e50b9942f26d7e264a6480de0062b3700f2e
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,72 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { applyPatch, createPatch, type JsonValue } from "../src/index.ts";
+
+function assertRoundTrip(from: JsonValue, to: JsonValue): void {
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  assert.deepEqual(applyPatch(from, createPatch(from, to)), to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(createPatch({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+  assert.deepEqual(createPatch({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+});
+
+test("a small change in a large document yields a single targeted operation", () => {
+  const from = { a: { b: [1, 2, 3], c: "x" }, d: true };
+  const to = { a: { b: [1, 2, 3], c: "y" }, d: true };
+  assert.deepEqual(createPatch(from, to), [{ op: "replace", path: "/a/c", value: "y" }]);
+});
+
+test("members are added and removed individually", () => {
+  assert.deepEqual(createPatch({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("array changes touch only the differing elements", () => {
+  assert.deepEqual(createPatch([1, 2, 3], [1, 2, 3, 4]), [{ op: "add", path: "/3", value: 4 }]);
+  assert.deepEqual(createPatch([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(createPatch([1, 3], [1, 2, 3]), [{ op: "add", path: "/1", value: 2 }]);
+  assert.deepEqual(createPatch([{ a: 1 }, 2], [{ a: 5 }, 2]), [{ op: "replace", path: "/0/a", value: 5 }]);
+});
+
+test("a change of type replaces the value, including the root", () => {
+  assert.deepEqual(createPatch({ a: [1] }, { a: { x: 1 } }), [{ op: "replace", path: "/a", value: { x: 1 } }]);
+  assert.deepEqual(createPatch(null, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(createPatch({ a: null }, { a: 0 }), [{ op: "replace", path: "/a", value: 0 }]);
+});
+
+test("keys with special characters are escaped", () => {
+  assert.deepEqual(createPatch({ "a/b": 1, "~": 1 }, { "a/b": 2, "~": 1 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+  ]);
+  assertRoundTrip({ "~/": { "/": 1 } }, { "~/": { "/": 2 }, "~0": 1 });
+});
+
+test("__proto__ is handled as an ordinary member", () => {
+  const from = JSON.parse('{"__proto__": {"a": 1}}');
+  const to = JSON.parse('{"__proto__": {"a": 2}}');
+  assert.deepEqual(createPatch(from, to), [{ op: "replace", path: "/__proto__/a", value: 2 }]);
+  assertRoundTrip(from, to);
+});
+
+test("the patch shares no structure with the inputs and inputs are not mutated", () => {
+  const to = { a: { b: [1] } };
+  const patch = createPatch({}, to);
+  (patch[0] as { value: { b: number[] } }).value.b.push(2);
+  assert.deepEqual(to, { a: { b: [1] } });
+});
+
+test("round trips on assorted documents", () => {
+  assertRoundTrip([1, 2, 3, 4, 5], [1, 9, 3, 5]);
+  assertRoundTrip([1, 2], [3, 4, 5, 6]);
+  assertRoundTrip([[1], [2, 3]], [[1, 0], []]);
+  assertRoundTrip([1, 2, 1, 2, 1], [1, 2, 1]);
+  assertRoundTrip({ a: [{ b: 1 }, { c: 2 }], d: null }, { a: [{ b: 1 }], e: [] });
+  assertRoundTrip("x", { y: 1 });
+});
