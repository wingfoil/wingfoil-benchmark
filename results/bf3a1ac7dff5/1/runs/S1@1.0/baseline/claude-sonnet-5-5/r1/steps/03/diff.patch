diff --git a/test/patch.test.ts b/test/patch.test.ts
index 8a444c9d01f54924caa4cd240f2a8d707e75b9d6..33349b118aa899c6dea297672e978e1742856b5c 100644
--- a/test/patch.test.ts
+++ b/test/patch.test.ts
@@ -40,3 +40,22 @@ test("root replace and __proto__", () => {
   assert.equal(Object.getPrototypeOf(out), Object.prototype);
   assert.equal(Object.keys(out).length, 1);
 });
+
+test("RFC 6902 edge cases", () => {
+  // move: remove then add, so the index is checked against the shortened array
+  assert.deepEqual(applyPatch([1, 2], [{ op: "move", from: "/0", path: "/1" }]), [2, 1]);
+  assert.throws(() => applyPatch([1, 2], [{ op: "move", from: "/0", path: "/2" }]));
+  // move onto itself is allowed when the location exists
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  // test needs an existing target; types are compared strictly
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/b", value: null }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]));
+  // "-" is only valid for add
+  assert.throws(() => applyPatch({ a: [] }, [{ op: "replace", path: "/a/-", value: 1 }]));
+  // a failing patch does not modify the input
+  const doc = { a: 1 };
+  assert.throws(() =>
+    applyPatch(doc, [{ op: "add", path: "/b", value: 2 }, { op: "remove", path: "/zz" }]),
+  );
+  assert.deepEqual(doc, { a: 1 });
+});
