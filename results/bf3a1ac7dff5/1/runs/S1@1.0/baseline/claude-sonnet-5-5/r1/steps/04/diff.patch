index 4494537f93521065a936c0df6018ed0a6d534b1f..e06983138c05bb55448bb900900ccd77b2deeae0 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -238,3 +238,25 @@ export function applyPatch(document: JsonValue, patch: unknown): JsonValue {
   }
   return result;
 }
+
+function mergePatch(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isObject(patch)) return clone(patch);
+  const result: Record<string, JsonValue> = isObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setKey(result, key, mergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a target document and returns the result.
+ * The inputs are not mutated.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  return mergePatch(isObject(target) ? clone(target) : target, patch);
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..18b6a8a07fb194df669a1ed43eb59841dc5709e9
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,32 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [any, any, any][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, r] of cases) assert.deepEqual(applyMergePatch(t, p), r);
+});
+
+test("does not mutate inputs", () => {
+  const t = { a: { b: 1 } };
+  const p = { a: { c: { d: null } } };
+  applyMergePatch(t, p);
+  assert.deepEqual(t, { a: { b: 1 } });
+  assert.deepEqual(p, { a: { c: { d: null } } });
+});
