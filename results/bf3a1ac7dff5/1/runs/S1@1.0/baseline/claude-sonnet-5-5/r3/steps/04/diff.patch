--- a/src/index.ts
+++ b/src/index.ts
@@ -236,3 +236,25 @@ export function applyPatch(document: JsonValue, patch: unknown): JsonValue {
   }
   return result;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the resulting document.
+ * Neither argument is mutated.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isObject(patch)) return clone(patch);
+
+  const result: { [key: string]: JsonValue } = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) setMember(result, key, clone(target[key]));
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(has(result, key) ? result[key] : {}, value));
+    }
+  }
+  return result;
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..83e8e85899fc77e9613aac2e115f412f06f857ee
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,20 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 example, without mutating the target", () => {
+  const target = { a: "b", c: { d: "e", f: "g" } };
+  assert.deepEqual(applyMergePatch(target, { a: "z", c: { f: null } }), { a: "z", c: { d: "e" } });
+  assert.equal(target.c.f, "g");
+});
+
+test("arrays and non-objects replace", () => {
+  assert.deepEqual(applyMergePatch({ a: [{ b: 1 }] }, { a: [1] }), { a: [1] });
+  assert.deepEqual(applyMergePatch({ a: 1 }, [1]), [1]);
+  assert.deepEqual(applyMergePatch([1], { a: 1 }), { a: 1 });
+  assert.equal(applyMergePatch({ a: 1 }, null), null);
+});
+
+test("nulls are stripped from new objects", () => {
+  assert.deepEqual(applyMergePatch({}, { a: { b: null, c: 1 } }), { a: { c: 1 } });
+});
