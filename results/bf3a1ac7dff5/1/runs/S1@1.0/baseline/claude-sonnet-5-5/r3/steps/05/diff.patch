index 0000000000000000000000000000000000000000..1b637a0299a7f77eae664816aa88008b4cc69f86
--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,17 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+test("createPatch is minimal and round-trips", () => {
+  assert.deepEqual(createPatch({ a: [1, 2, 3], b: 1 }, { a: [1, 9, 3], b: 1 }), [
+    { op: "replace", path: "/a/1", value: 9 },
+  ]);
+  assert.deepEqual(createPatch({ a: 1 }, { a: 1 }), []);
+  assert.deepEqual(createPatch({ "a/b": 1, "~": 2 }, { "a/b": 1 }), [{ op: "remove", path: "/~0" }]);
+  assert.deepEqual(createPatch(1, { a: 1 }), [{ op: "replace", path: "", value: { a: 1 } }]);
+  const from = { x: [1, 2, 3, 4, 5], y: { z: 1 } };
+  const to = { x: [1, 3, 4, 5, 6, 7], y: { z: 1, w: [] } };
+  const copy = structuredClone(from);
+  assert.deepEqual(applyPatch(from, createPatch(from, to)), to);
+  assert.deepEqual(from, copy);
+});
