@@ -67,3 +67,19 @@ test("__proto__ member is plain data", () => {
   assert.equal(Object.getPrototypeOf(out), Object.prototype);
   assert.equal(Object.hasOwn(out, "__proto__"), true);
 });
+
+test("RFC 6902 edge cases", () => {
+  // move: removal happens before the add, so indexes are checked against the shortened array
+  ok({ a: [1, 2, 3] }, [{ op: "move", from: "/a/0", path: "/a/2" }], { a: [2, 3, 1] });
+  bad({ a: [1, 2, 3] }, [{ op: "move", from: "/a/0", path: "/a/3" }]);
+  // moving a child over its parent is allowed, moving a parent into its child is not
+  ok({ a: { b: 1 } }, [{ op: "move", from: "/a/b", path: "/a" }], { a: 1 });
+  // members not defined for an operation are ignored
+  ok({ a: [1] }, [{ op: "add", path: "/a/-", value: 2, from: 5, extra: true }], { a: [1, 2] });
+  // "-" is only valid for add; test/replace/remove need an existing element
+  bad({ a: [1] }, [{ op: "test", path: "/a/-", value: 1 }]);
+  bad([1, 2], [{ op: "replace", path: "/-", value: 5 }]);
+  // an error in a later operation produces no result
+  bad({ a: 1 }, [{ op: "add", path: "/b", value: 1 }, { op: "test", path: "/b", value: 2 }]);
+  bad({}, [{ op: "Add", path: "/a", value: 1 }]);
+});
