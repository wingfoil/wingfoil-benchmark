--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,52 @@
+/**
+ * JSON Pointer (RFC 6901).
+ */
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in token "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/**
+ * Returns the value of `document` that `pointer` refers to.
+ *
+ * Throws if `pointer` is not a valid JSON Pointer, or if it does not resolve to a value of the
+ * document (missing member, out-of-range index, "-" index, or traversal through a scalar).
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return document;
+  if (pointer[0] !== "/") {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`);
+  }
+
+  const tokens = pointer.slice(1).split("/").map(unescapeToken);
+  let current: unknown = document;
+
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token)) {
+        throw new Error(`JSON Pointer does not resolve: "${token}" is not a valid array index`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new Error(`JSON Pointer does not resolve: index ${token} is out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new Error(`JSON Pointer does not resolve: no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer does not resolve: cannot descend into a scalar at "${token}"`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..52e664ea36d06d2ffbf6736263652392fb72b78b
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,63 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// Examples from RFC 6901 section 5.
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("escape order: ~01 is the token ~1", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("null and falsy values resolve", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer([false], "/0"), false);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("invalid pointers throw", () => {
+  assert.throws(() => resolvePointer(doc, "foo"));
+  assert.throws(() => resolvePointer(doc, "/a~"));
+  assert.throws(() => resolvePointer(doc, "/a~2"));
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer(doc, "/nope"));
+  assert.throws(() => resolvePointer(doc, "/foo/2"));
+  assert.throws(() => resolvePointer(doc, "/foo/-"));
+  assert.throws(() => resolvePointer(doc, "/foo/00"));
+  assert.throws(() => resolvePointer(doc, "/foo/+1"));
+  assert.throws(() => resolvePointer(doc, "/foo/1.0"));
+  assert.throws(() => resolvePointer(doc, "/foo/length"));
+  assert.throws(() => resolvePointer(doc, "/foo/0/x"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer({}, "/constructor"));
+  assert.throws(() => resolvePointer("abc", "/0"));
+});
