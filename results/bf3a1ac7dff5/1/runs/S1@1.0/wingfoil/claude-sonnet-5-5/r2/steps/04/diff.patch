+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document.
+ *
+ * A non-object `patch` replaces the target; an object `patch` is merged member by member into
+ * the target (or into `{}` when the target is not an object): a `null` member deletes the
+ * member, any other value is merged recursively. Arrays are replaced, never merged. The inputs
+ * are never mutated and the result shares no structure with them. Only own members are addressed.
+ *
+ * @param target the JSON document to update.
+ * @param patch the merge patch.
+ * @returns the merged document, as a new value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result: Record<string, unknown> = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) {
+      setMember(result, key, structuredClone(target[key]));
+    }
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(Object.hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
