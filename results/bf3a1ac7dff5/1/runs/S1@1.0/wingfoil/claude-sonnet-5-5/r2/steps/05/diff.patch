--- a/src/index.ts
+++ b/src/index.ts
@@ -263,3 +263,76 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+/** Encodes one reference token for a JSON Pointer (RFC 6901 section 3). */
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Appends to `operations` the changes that turn the array `from` into `to`, below `path`. */
+function diffArrays(from: unknown[], to: unknown[], path: string, operations: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+    start++;
+  }
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && jsonEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+  const shared = Math.min(fromEnd, toEnd);
+  for (let i = start; i < shared; i++) {
+    diffValues(from[i], to[i], `${path}/${i}`, operations);
+  }
+  // Removing at the same index each time keeps the later indexes valid.
+  for (let i = shared; i < fromEnd; i++) {
+    operations.push({ op: "remove", path: `${path}/${shared}` });
+  }
+  for (let i = shared; i < toEnd; i++) {
+    operations.push({ op: "add", path: `${path}/${i}`, value: structuredClone(to[i]) });
+  }
+}
+
+/** Appends to `operations` the changes that turn `from` into `to`, located at `path`. */
+function diffValues(from: unknown, to: unknown, path: string, operations: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, operations);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) {
+        operations.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      const memberPath = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(from, key)) {
+        diffValues(from[key], to[key], memberPath, operations);
+      } else {
+        operations.push({ op: "add", path: memberPath, value: structuredClone(to[key]) });
+      }
+    }
+  } else if (!jsonEqual(from, to)) {
+    operations.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch describes only what changed: objects are compared member by member and arrays by
+ * element, after skipping their common leading and trailing elements, so a small difference
+ * deep in a document gives a single small operation. Object member order is irrelevant. The
+ * output is deterministic. Neither input is mutated and the patch shares no structure with
+ * them. Only own members of objects are considered. The patch is not guaranteed to be the
+ * shortest possible one.
+ *
+ * @param from the original JSON document.
+ * @param to the new JSON document.
+ * @returns an array of `add`, `remove` and `replace` operations; empty when the documents are equal.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const operations: PatchOperation[] = [];
+  diffValues(from, to, "", operations);
+  return operations;
+}
