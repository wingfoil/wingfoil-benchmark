index 0000000000000000000000000000000000000000..cab0e5497cd0f3d792773870fcc51a73b2f1f2be
--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,80 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown) {
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a small change deep in a document yields one operation", () => {
+  const from = { a: { b: { c: 1, d: [1, 2, 3] } }, big: { x: 1, y: 2 } };
+  const to = { a: { b: { c: 2, d: [1, 2, 3] } }, big: { x: 1, y: 2 } };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/c", value: 2 }]);
+});
+
+test("object members are added and removed", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("member order is irrelevant", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+});
+
+test("keys are escaped in pointers", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "~": 1 }, { "a/b": 2, "~": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/~0", value: 2 },
+  ]);
+});
+
+test("__proto__ members are handled as own members", () => {
+  const from = JSON.parse('{"__proto__": {"a": 1}}');
+  const to = JSON.parse('{"__proto__": {"a": 2}}');
+  roundTrip(from, to);
+});
+
+test("appending, inserting and removing array items stays small", () => {
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 2, 3, 4]), [{ op: "add", path: "/3", value: 4 }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [0, 1, 2, 3]), [{ op: "add", path: "/0", value: 0 }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+});
+
+test("arrays of objects recurse into changed elements", () => {
+  assert.deepEqual(roundTrip([{ a: 1 }, { a: 2 }], [{ a: 1 }, { a: 3 }]), [
+    { op: "replace", path: "/1/a", value: 3 },
+  ]);
+});
+
+test("arrays with several differences round-trip", () => {
+  roundTrip([1, 2, 3, 4, 5], [9, 2, 8, 5, 6, 7]);
+  roundTrip([1, 2, 3, 4, 5], [5]);
+  roundTrip([], [1, 2]);
+  roundTrip([[1], [2]], [[1, 2], []]);
+});
+
+test("type changes and root replacement", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepEqual(roundTrip({ a: [] }, { a: {} }), [{ op: "replace", path: "/a", value: {} }]);
+  assert.deepEqual(roundTrip({ a: null }, { a: 1 }), [{ op: "replace", path: "/a", value: 1 }]);
+});
+
+test("the patch shares no structure with the inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0].value as { b: number }).b = 2;
+  assert.equal(to.a.b, 1);
+});
