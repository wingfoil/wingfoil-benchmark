index 0000000000000000000000000000000000000000..9f1a0f69010ad706135866d4754c168b14ad5a94
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,185 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+// RFC 6902 appendix A examples.
+test("A.1 adding an object member", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), {
+    foo: "bar",
+    baz: "qux",
+  });
+});
+
+test("A.2 adding an array element", () => {
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), {
+    foo: ["bar", "qux", "baz"],
+  });
+});
+
+test("A.3 removing an object member", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+});
+
+test("A.4 removing an array element", () => {
+  assert.deepEqual(applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), {
+    foo: ["bar", "baz"],
+  });
+});
+
+test("A.5 replacing a value", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), {
+    baz: "boo",
+    foo: "bar",
+  });
+});
+
+test("A.6 moving a value", () => {
+  assert.deepEqual(
+    applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [
+      { op: "move", from: "/foo/waldo", path: "/qux/thud" },
+    ]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+});
+
+test("A.7 moving an array element", () => {
+  assert.deepEqual(
+    applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]),
+    { foo: ["all", "cows", "eat", "grass"] },
+  );
+});
+
+test("A.8/A.9 testing a value", () => {
+  assert.deepEqual(applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "qux" }]), { baz: "qux" });
+  assert.throws(() => applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]));
+});
+
+test("A.10 adding a nested member object", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]), {
+    foo: "bar",
+    child: { grandchild: {} },
+  });
+});
+
+test("A.12 adding to a nonexistent target fails", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]));
+});
+
+test("A.14 ~ escape ordering", () => {
+  assert.deepEqual(
+    applyPatch({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }]),
+    { "/": 9, "~1": 10 },
+  );
+});
+
+test("A.15/A.16 add and test details", () => {
+  assert.throws(() => applyPatch({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]));
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]), {
+    foo: ["bar", ["abc", "def"]],
+  });
+});
+
+test("empty path targets the whole document", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]));
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "test", path: "", value: { a: 1 } }]), { a: 1 });
+});
+
+test("add replaces an existing member, and appends at index length", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/1", value: 2 }]), [1, 2]);
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/2", value: 2 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/01", value: 2 }]));
+});
+
+test("remove and replace need an existing target", () => {
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/-" }]));
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/1", value: 1 }]));
+});
+
+test("copy duplicates a value without aliasing", () => {
+  const result = applyPatch({ a: { x: 1 } }, [
+    { op: "copy", from: "/a", path: "/b" },
+    { op: "add", path: "/b/y", value: 2 },
+  ]) as Record<string, unknown>;
+  assert.deepEqual(result, { a: { x: 1 }, b: { x: 1, y: 2 } });
+  assert.throws(() => applyPatch({}, [{ op: "copy", from: "/a", path: "/b" }]));
+});
+
+test("move to itself is a no-op, into its own child fails", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/a", path: "/b" }]));
+});
+
+test("test compares deeply, ignoring member order, and distinguishes types", () => {
+  const d = { a: { x: 1, y: [1, { z: null }] } };
+  const ok = (value: unknown) => applyPatch(d, [{ op: "test", path: "/a", value }]);
+  ok({ y: [1, { z: null }], x: 1 });
+  assert.throws(() => ok({ x: 1, y: [1, { z: 0 }] }));
+  assert.throws(() => ok({ x: 1 }));
+  assert.throws(() => applyPatch([1], [{ op: "test", path: "/0", value: "1" }]));
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/a", value: null }]));
+  assert.throws(() => applyPatch([[]], [{ op: "test", path: "/0", value: {} }]));
+});
+
+test("operations apply in order and a failure leaves the input untouched", () => {
+  const input = { a: [1, 2] };
+  assert.deepEqual(
+    applyPatch(input, [
+      { op: "add", path: "/a/-", value: 3 },
+      { op: "remove", path: "/a/0" },
+    ]),
+    { a: [2, 3] },
+  );
+  assert.throws(() =>
+    applyPatch(input, [
+      { op: "add", path: "/b", value: 1 },
+      { op: "remove", path: "/zzz" },
+    ]),
+  );
+  assert.deepEqual(input, { a: [1, 2] });
+});
+
+test("input document and patch values are not mutated or aliased", () => {
+  const input = { a: { b: 1 } };
+  const value = { n: 1 };
+  const patch = [{ op: "add", path: "/c", value }];
+  const result = applyPatch(input, patch) as { c: { n: number } };
+  result.c.n = 2;
+  assert.deepEqual(input, { a: { b: 1 } });
+  assert.deepEqual(value, { n: 1 });
+  assert.deepEqual(patch, [{ op: "add", path: "/c", value: { n: 1 } }]);
+  assert.notEqual(applyPatch(input, []), input);
+});
+
+test("invalid patches throw", () => {
+  const bad = (patch: unknown) => assert.throws(() => applyPatch({}, patch as never));
+  bad({});
+  bad(null);
+  bad([null]);
+  bad([[]]);
+  bad([{ path: "/a", value: 1 }]);
+  bad([{ op: "bogus", path: "/a" }]);
+  bad([{ op: "add", value: 1 }]);
+  bad([{ op: "add", path: 1, value: 1 }]);
+  bad([{ op: "add", path: "a", value: 1 }]);
+  bad([{ op: "add", path: "/a" }]);
+  bad([{ op: "replace", path: "/a" }]);
+  bad([{ op: "test", path: "/a" }]);
+  bad([{ op: "move", path: "/a" }]);
+  bad([{ op: "copy", path: "/a" }]);
+  bad([{ op: "move", from: "x", path: "/a" }]);
+});
+
+test("only own members are reached", () => {
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/constructor" }]));
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/__proto__", value: {} }]));
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as object;
+  assert.equal(Object.hasOwn(result, "__proto__"), true);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
