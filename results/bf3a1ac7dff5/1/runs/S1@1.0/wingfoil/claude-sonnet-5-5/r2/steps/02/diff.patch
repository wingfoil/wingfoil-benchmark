+
+/**
+ * Returns the value that a JSON Pointer (RFC 6901) refers to in a JSON document.
+ *
+ * @param document the JSON document to look into.
+ * @param pointer a JSON Pointer string; `""` refers to the whole document.
+ * @throws Error when `pointer` is not a valid JSON Pointer, or when it does not
+ *   resolve to a value of `document` (missing member, out-of-range or `-` array
+ *   index, or a step into a primitive value).
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  return walk(document, parsePointer(pointer), pointer);
+}
+
+/** One operation of a JSON Patch (RFC 6902 section 4). */
+export interface PatchOperation {
+  op: "add" | "remove" | "replace" | "move" | "copy" | "test";
+  path: string;
+  value?: unknown;
+  from?: string;
+}
+
+type Container = JsonValue[] | Record<string, unknown>;
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Structural equality of two JSON values; member order is irrelevant (RFC 6902 section 4.6). */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]))
+    );
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.hasOwn(b, key) && jsonEqual(a[key], b[key]))
+    );
+  }
+  return a === b;
+}
+
+/** Resolves the container holding the target of `tokens`, which must not be empty. */
+function parentOf(document: unknown, tokens: string[], pointer: string): Container {
+  const parent = walk(document, tokens.slice(0, -1), pointer);
+  if (typeof parent !== "object" || parent === null) {
+    throw new Error(`JSON Pointer "${pointer}" does not resolve: parent is not an object or array`);
+  }
+  return parent as Container;
+}
+
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty, so that a "__proto__" member is an own member and never changes the prototype.
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Adds `value` at `pointer`; returns the new document (only differs from `document` for the root). */
+function addValue(document: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = parentOf(document, tokens, pointer);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (key === "-") {
+      parent.push(value as JsonValue);
+    } else if (ARRAY_INDEX.test(key) && Number(key) <= parent.length) {
+      parent.splice(Number(key), 0, value as JsonValue);
+    } else {
+      throw new Error(`Cannot add at "${pointer}": invalid array index "${key}"`);
+    }
+  } else {
+    setMember(parent, key, value);
+  }
+  return document;
+}
+
+/** Removes the value at `pointer`, which must exist; returns the new document. */
+function removeValue(document: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    throw new Error("Cannot remove the whole document");
+  }
+  walk(document, tokens, pointer);
+  const parent = parentOf(document, tokens, pointer);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(Number(key), 1);
+  } else {
+    delete parent[key];
+  }
+  return document;
+}
+
+function requireString(operation: Record<string, unknown>, field: string, index: number): string {
+  const value = operation[field];
+  if (typeof value !== "string") {
+    throw new Error(`Invalid patch: operation ${index} needs a string "${field}" member`);
+  }
+  return value;
+}
+
+function applyOperation(document: unknown, operation: unknown, index: number): unknown {
+  if (!isObject(operation)) {
+    throw new Error(`Invalid patch: operation ${index} is not an object`);
+  }
+  const path = requireString(operation, "path", index);
+  parsePointer(path);
+  const requireValue = (): unknown => {
+    if (!Object.hasOwn(operation, "value")) {
+      throw new Error(`Invalid patch: operation ${index} needs a "value" member`);
+    }
+    return structuredClone(operation.value);
+  };
+
+  switch (operation.op) {
+    case "add":
+      return addValue(document, path, requireValue());
+    case "remove":
+      return removeValue(document, path);
+    case "replace": {
+      const value = requireValue();
+      walk(document, parsePointer(path), path);
+      return addValue(path === "" ? document : removeValue(document, path), path, value);
+    }
+    case "move": {
+      const from = requireString(operation, "from", index);
+      const fromTokens = parsePointer(from);
+      const value = walk(document, fromTokens, from);
+      if (from === path) {
+        return document;
+      }
+      if (path.startsWith(`${from}/`)) {
+        throw new Error(`Cannot move "${from}" into one of its own children "${path}"`);
+      }
+      return addValue(removeValue(document, from), path, value);
+    }
+    case "copy": {
+      const from = requireString(operation, "from", index);
+      return addValue(document, path, structuredClone(resolvePointer(document, from)));
+    }
+    case "test": {
+      const value = requireValue();
+      if (!jsonEqual(resolvePointer(document, path), value)) {
+        throw new Error(`Test failed: value at "${path}" differs from the expected value`);
+      }
+      return document;
+    }
+    default:
+      throw new Error(`Invalid patch: operation ${index} has unknown "op" ${JSON.stringify(operation.op)}`);
+  }
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document.
+ *
+ * The operations run in order; the input `document` and `patch` are never mutated, and the
+ * result shares no structure with them. Only own members of objects are addressed.
+ *
+ * @param document the JSON document to patch.
+ * @param patch an array of operations (`add`, `remove`, `replace`, `move`, `copy`, `test`).
+ * @returns the patched document, as a new value.
+ * @throws Error when `patch` is not a valid JSON Patch, or when an operation fails (target
+ *   that does not exist, invalid array index, failed `test`). No partial result is returned.
+ */
+export function applyPatch(document: unknown, patch: PatchOperation[]): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid patch: must be an array of operations");
+  }
+  let result = structuredClone(document);
+  patch.forEach((operation, index) => {
+    result = applyOperation(result, operation, index);
+  });
+  return result;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
