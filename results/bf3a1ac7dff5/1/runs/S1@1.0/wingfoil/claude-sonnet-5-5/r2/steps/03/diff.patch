--- /dev/null
+++ b/docs/memory/task/task-003-make-applypatch-conform-to-rfc-6902-edge-cases.md
@@ -0,0 +1,19 @@
+---
+id: task-003-make-applypatch-conform-to-rfc-6902-edge-cases
+type: task
+title: "Make applyPatch conform to RFC 6902 edge cases"
+status: pending
+---
+
+# Summary
+
+Reviewed `applyPatch` against RFC 6902 (checking, application and errors). Most behaviour already
+conformed: the appendix A cases, root paths, array index rules, move/copy/test semantics and atomicity.
+Two invalid patches were accepted and are now rejected:
+
+- a sparse patch array (`[ , {...}]`): `forEach` skipped the holes, so a missing operation passed
+  silently. Operations are now iterated by index, and a hole fails as "not an object".
+- an operation whose `value` is `undefined` (present but not a JSON value): it was accepted and
+  produced a member that vanishes on serialisation. `value` must now be defined (`null` is valid).
+
+Test added first in `test/patch.test.ts`. Design: dl-003.
diff --git a/src/index.ts b/src/index.ts
index 14c7fd29d76284ef1ce9338f03ab07ac7b73cef7..65a7f8938dec5c7a3487b142d14b9c444d99eb46 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -164,7 +164,7 @@ function applyOperation(document: unknown, operation: unknown, index: number): u
   const path = requireString(operation, "path", index);
   parsePointer(path);
   const requireValue = (): unknown => {
-    if (!Object.hasOwn(operation, "value")) {
+    if (operation.value === undefined) {
       throw new Error(`Invalid patch: operation ${index} needs a "value" member`);
     }
     return structuredClone(operation.value);
@@ -225,8 +225,8 @@ export function applyPatch(document: unknown, patch: PatchOperation[]): unknown
     throw new Error("Invalid patch: must be an array of operations");
   }
   let result = structuredClone(document);
-  patch.forEach((operation, index) => {
-    result = applyOperation(result, operation, index);
-  });
+  for (let index = 0; index < patch.length; index++) {
+    result = applyOperation(result, patch[index], index);
+  }
   return result;
 }
