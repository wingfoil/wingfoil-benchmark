index 0000000000000000000000000000000000000000..2b5015fad25ae26066b8c77c895220b24beec03f
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,58 @@
+/** A JSON value, as produced by `JSON.parse`. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Decodes one reference token; `~1` first, then `~0`, so `~01` yields `~1` (RFC 6901 section 4). */
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in token "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/**
+ * Returns the value that a JSON Pointer (RFC 6901) refers to in a JSON document.
+ *
+ * @param document the JSON document to look into.
+ * @param pointer a JSON Pointer string; `""` refers to the whole document.
+ * @throws Error when `pointer` is not a valid JSON Pointer, or when it does not
+ *   resolve to a value of `document` (missing member, out-of-range or `-` array
+ *   index, or a step into a primitive value).
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: must be a string");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`);
+  }
+  const tokens = pointer.slice(1).split("/").map(unescapeToken);
+
+  let current: unknown = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`JSON Pointer "${pointer}" does not resolve: no array element "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new Error(`JSON Pointer "${pointer}" does not resolve: no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: cannot step into a primitive value`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..49a0a12e7a49addfc6473ce0d778d5976a6fa859
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,74 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// RFC 6901 section 5 example document.
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("unescaping order: ~01 is the key ~1", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("resolves falsy values, including null", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer({ a: false }, "/a"), false);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("invalid pointer syntax throws", () => {
+  assert.throws(() => resolvePointer(doc, "foo"));
+  assert.throws(() => resolvePointer(doc, "#/foo"));
+  assert.throws(() => resolvePointer(doc, "/a~"));
+  assert.throws(() => resolvePointer(doc, "/a~2"));
+  assert.throws(() => resolvePointer(doc, 5 as unknown as string));
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer(doc, "/missing"));
+  assert.throws(() => resolvePointer(doc, "/foo/2"));
+  assert.throws(() => resolvePointer(doc, "/foo/-"));
+  assert.throws(() => resolvePointer(doc, "/foo/bar"));
+  assert.throws(() => resolvePointer(doc, "/a~1b/x"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+});
+
+test("array indexes must be canonical", () => {
+  assert.throws(() => resolvePointer(doc, "/foo/01"));
+  assert.throws(() => resolvePointer(doc, "/foo/+1"));
+  assert.throws(() => resolvePointer(doc, "/foo/-0"));
+  assert.throws(() => resolvePointer(doc, "/foo/1.0"));
+  assert.throws(() => resolvePointer(doc, "/foo/length"));
+  assert.throws(() => resolvePointer(doc, "/foo/"));
+});
+
+test("inherited properties are not values of the document", () => {
+  assert.throws(() => resolvePointer({}, "/constructor"));
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer({ a: "s" }, "/a/length"));
+});
