diff --git a/src/index.test.ts b/src/index.test.ts
index 56a4cdb94b55e240143a971a58f3acdc4113c42f..2fc49ecde4a9896ec9cd666cbc89eab981f6e8be 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -1,6 +1,6 @@
 import { test } from "node:test";
 import assert from "node:assert/strict";
-import { applyPatch, resolvePointer } from "./index.ts";
+import { applyMergePatch, applyPatch, resolvePointer } from "./index.ts";
 
 // Examples from RFC 6901, section 5.
 const rfc = {
@@ -240,3 +240,47 @@ test("applyPatch replace keeps the position of an object member", () => {
   const result = applyPatch({ a: 1, b: 2, c: 3 }, [{ op: "replace", path: "/a", value: 9 }]);
   assert.deepEqual(Object.keys(result as object), ["a", "b", "c"]);
 });
+
+// RFC 7386, section 3 example and appendix A test cases.
+const mergeCases: [unknown, unknown, unknown][] = [
+  [{ a: "b" }, { a: "c" }, { a: "c" }],
+  [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  [{ a: "b" }, { a: null }, {}],
+  [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+  [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+  [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  [["a", "b"], ["c", "d"], ["c", "d"]],
+  [{ a: "b" }, ["c"], ["c"]],
+  [{ a: "foo" }, null, null],
+  [{ a: "foo" }, "bar", "bar"],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: "b", c: null }, { a: "b" }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+
+test("applies the RFC 7386 test cases", () => {
+  for (const [target, patch, expected] of mergeCases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("applyMergePatch mutates and aliases neither argument", () => {
+  const target = { a: { b: 1 }, list: [1] };
+  const patch = { a: { c: { d: 2 } }, list: [{ x: 1 }] };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 }, list: [1] });
+  assert.notEqual(result.a.c, (patch.a as any).c);
+  assert.notEqual(result.list, patch.list);
+  assert.notEqual(result.list[0], patch.list[0]);
+});
+
+test("applyMergePatch keeps member order and treats __proto__ as an ordinary member", () => {
+  const result = applyMergePatch({ a: 1, b: 2 }, { a: 3 }) as object;
+  assert.deepEqual(Object.keys(result), ["a", "b"]);
+  const polluted = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as any;
+  assert.equal(({} as any).x, undefined);
+  assert.equal(Object.getPrototypeOf(polluted), Object.prototype);
+  assert.deepEqual(Object.keys(polluted), ["__proto__"]);
+});
diff --git a/src/index.ts b/src/index.ts
index 2a978432244138534b86806952fa6624ce70c2ba..75a806cbfcc5dff391668547f955fddf3acf09da 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -217,3 +217,30 @@ export function applyPatch(document: unknown, patch: PatchOperation[]): unknown
   const operations = Array.from(patch, validateOperation);
   return operations.reduce(applyOperation, structuredClone(document));
 }
+
+function mergeInto(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return structuredClone(patch);
+  const result: Record<string, unknown> = isObject(target) ? structuredClone(target) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, mergeInto(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies the JSON Merge Patch `patch` (RFC 7386) to `target` and returns the result as a new value.
+ *
+ * A patch that is not an object (including an array or null) replaces the target as a whole. An
+ * object patch is merged member by member: a null removes the member, any other value is merged
+ * recursively, and a non-object target is first treated as an empty object. Arrays are replaced, never
+ * merged. Neither argument is mutated, and the result shares no structure with them. Existing members
+ * keep their position and new ones follow in patch order.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return mergeInto(target, patch);
+}
