+++ b/src/index.ts
@@ -0,0 +1,50 @@
+/** Matches an array index token: "0" or a number without leading zeros (RFC 6901, section 4). */
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Matches a "~" that is not followed by "0" or "1", which RFC 6901 makes invalid. */
+const BAD_ESCAPE = /~(?![01])/;
+
+function parseTokens(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new TypeError("A JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (!pointer.startsWith("/")) {
+    throw new SyntaxError(`Invalid JSON Pointer "${pointer}": it must be empty or start with "/"`);
+  }
+  if (BAD_ESCAPE.test(pointer)) {
+    throw new SyntaxError(`Invalid JSON Pointer "${pointer}": "~" must be followed by "0" or "1"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => token.replace(/~1/g, "/").replace(/~0/g, "~"));
+}
+
+function step(current: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(current)) {
+    if (ARRAY_INDEX.test(token) && Number(token) < current.length) {
+      return current[Number(token)];
+    }
+  } else if (
+    typeof current === "object" &&
+    current !== null &&
+    Object.prototype.hasOwnProperty.call(current, token)
+  ) {
+    return (current as Record<string, unknown>)[token];
+  }
+  throw new RangeError(`JSON Pointer "${pointer}" does not resolve to a value of the document`);
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer `pointer` refers to (RFC 6901).
+ *
+ * The empty pointer refers to the whole document. Only own properties of objects and existing
+ * array elements resolve; the "-" array token never does.
+ *
+ * @throws SyntaxError when `pointer` is not a valid JSON Pointer string.
+ * @throws RangeError when `pointer` does not resolve to a value of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  return parseTokens(pointer).reduce((current, token) => step(current, token, pointer), document);
+}
