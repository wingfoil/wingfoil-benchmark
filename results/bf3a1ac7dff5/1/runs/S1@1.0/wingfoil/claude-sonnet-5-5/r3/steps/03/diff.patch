+++ b/src/index.test.ts
@@ -230,3 +230,13 @@ test("applyPatch rejects invalid patches", () => {
 test("applyPatch validates the whole patch before applying it", () => {
   assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: 1 }, { op: "nope", path: "/a" }]), TypeError);
 });
+
+test("applyPatch rejects a patch array with holes", () => {
+  assert.throws(() => applyPatch({}, new Array(1) as never), TypeError);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: 1 }, , { op: "remove", path: "/a" }] as never), TypeError);
+});
+
+test("applyPatch replace keeps the position of an object member", () => {
+  const result = applyPatch({ a: 1, b: 2, c: 3 }, [{ op: "replace", path: "/a", value: 9 }]);
+  assert.deepEqual(Object.keys(result as object), ["a", "b", "c"]);
+});
