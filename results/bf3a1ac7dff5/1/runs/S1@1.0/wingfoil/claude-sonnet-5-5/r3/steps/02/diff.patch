+  });
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/-", value: 2 }]), [1, 2]);
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/1", value: 2 }]), [1, 2]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [true] }]), [true]);
+  assert.deepEqual(applyPatch(1, [{ op: "add", path: "", value: null }]), null);
+});
+
+test("applyPatch add fails on a missing parent, a bad index or a scalar parent", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/a/b", value: 1 }]), RangeError);
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/2", value: 1 }]), RangeError);
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/01", value: 1 }]), RangeError);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]), RangeError);
+});
+
+test("applyPatch remove", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), {
+    foo: ["bar", "baz"],
+  });
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/a" }]), RangeError);
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/-" }]), RangeError);
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/1" }]), RangeError);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]), RangeError);
+});
+
+test("applyPatch replace", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), {
+    baz: "boo",
+    foo: "bar",
+  });
+  assert.deepEqual(applyPatch([1, 2], [{ op: "replace", path: "/1", value: 3 }]), [1, 3]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]), RangeError);
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/-", value: 1 }]), RangeError);
+});
+
+test("applyPatch move", () => {
+  assert.deepEqual(
+    applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [
+      { op: "move", from: "/foo/waldo", path: "/qux/thud" },
+    ]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]), RangeError);
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/a", path: "/b" }]), RangeError);
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/a", path: "/a" }]), RangeError);
+});
+
+test("applyPatch copy duplicates the value rather than sharing it", () => {
+  const result = applyPatch({ a: { x: 1 } }, [
+    { op: "copy", from: "/a", path: "/b" },
+    { op: "add", path: "/b/y", value: 2 },
+  ]) as { a: object; b: object };
+  assert.deepEqual(result, { a: { x: 1 }, b: { x: 1, y: 2 } });
+  assert.throws(() => applyPatch({}, [{ op: "copy", from: "/a", path: "/b" }]), RangeError);
+});
+
+test("applyPatch test compares by deep equality", () => {
+  const doc = { a: { b: [1, { c: null }] }, n: 1 };
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/a", value: { b: [1, { c: null }] } }]), doc);
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "", value: { n: 1, a: { b: [1, { c: null }] } } }]), doc);
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/n", value: "1" }]), RangeError);
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/b", value: [{ c: null }, 1] }]), RangeError);
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a", value: { b: [1, { c: null }], d: 1 } }]), RangeError);
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/missing", value: null }]), RangeError);
+  assert.throws(() => applyPatch([], [{ op: "test", path: "", value: {} }]), RangeError);
