index 5db175d5a06dd4e921f713516cbf293403a5b4b4..7ba1f44f9fe147201d1c355cdcaf0d73e1bee0e9 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -48,3 +48,162 @@ function step(current: unknown, token: string, pointer: string): unknown {
 export function resolvePointer(document: unknown, pointer: string): unknown {
   return parseTokens(pointer).reduce((current, token) => step(current, token, pointer), document);
 }
+
+/** A JSON Patch operation (RFC 6902, section 4). */
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; from: string; path: string };
+
+type Container = Record<string, unknown> | unknown[];
+
+const hasOwn = (target: object, key: string): boolean => Object.prototype.hasOwnProperty.call(target, key);
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function requirePointer(operation: Record<string, unknown>, member: string, index: number): string {
+  const pointer = operation[member];
+  if (typeof pointer !== "string") {
+    throw new TypeError(`Invalid JSON Patch: operation ${index} needs a string "${member}"`);
+  }
+  parseTokens(pointer);
+  return pointer;
+}
+
+function validateOperation(operation: unknown, index: number): PatchOperation {
+  if (!isObject(operation)) {
+    throw new TypeError(`Invalid JSON Patch: operation ${index} must be an object`);
+  }
+  const { op } = operation;
+  switch (op) {
+    case "add":
+    case "replace":
+    case "test":
+      requirePointer(operation, "path", index);
+      if (!hasOwn(operation, "value") || operation.value === undefined) {
+        throw new TypeError(`Invalid JSON Patch: operation ${index} ("${op}") needs a "value"`);
+      }
+      break;
+    case "remove":
+      requirePointer(operation, "path", index);
+      break;
+    case "move":
+    case "copy":
+      requirePointer(operation, "path", index);
+      requirePointer(operation, "from", index);
+      break;
+    default:
+      throw new TypeError(`Invalid JSON Patch: operation ${index} has an unknown "op"`);
+  }
+  return operation as PatchOperation;
+}
+
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]))
+    );
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((key) => hasOwn(b, key) && jsonEqual(a[key], b[key]));
+  }
+  return a === b;
+}
+
+function fail(message: string): never {
+  throw new RangeError(message);
+}
+
+/** Returns the container holding the target of `tokens` (which must be non-empty) and its last token. */
+function locateParent(document: unknown, tokens: string[], pointer: string): [Container, string] {
+  const parent = tokens.slice(0, -1).reduce((current, token) => step(current, token, pointer), document);
+  if (typeof parent !== "object" || parent === null) {
+    fail(`JSON Pointer "${pointer}" has a parent that is not an object or an array`);
+  }
+  return [parent as Container, tokens[tokens.length - 1]];
+}
+
+function setMember(parent: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty keeps "__proto__" an ordinary own member instead of changing the prototype.
+  Object.defineProperty(parent, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function addAt(document: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parseTokens(pointer);
+  if (tokens.length === 0) return value;
+  const [parent, key] = locateParent(document, tokens, pointer);
+  if (Array.isArray(parent)) {
+    const index = key === "-" ? parent.length : ARRAY_INDEX.test(key) ? Number(key) : -1;
+    if (index < 0 || index > parent.length) fail(`JSON Pointer "${pointer}" is not a valid array position to add at`);
+    parent.splice(index, 0, value);
+  } else {
+    setMember(parent, key, value);
+  }
+  return document;
+}
+
+function removeAt(document: unknown, pointer: string): unknown {
+  const tokens = parseTokens(pointer);
+  if (tokens.length === 0) fail("The whole document cannot be removed");
+  const [parent, key] = locateParent(document, tokens, pointer);
+  step(parent, key, pointer);
+  if (Array.isArray(parent)) {
+    parent.splice(Number(key), 1);
+  } else {
+    delete parent[key];
+  }
+  return document;
+}
+
+function applyOperation(document: unknown, operation: PatchOperation): unknown {
+  switch (operation.op) {
+    case "add":
+      return addAt(document, operation.path, structuredClone(operation.value));
+    case "remove":
+      return removeAt(document, operation.path);
+    case "replace":
+      resolvePointer(document, operation.path);
+      return parseTokens(operation.path).length === 0
+        ? structuredClone(operation.value)
+        : addAt(removeAt(document, operation.path), operation.path, structuredClone(operation.value));
+    case "copy":
+      return addAt(document, operation.path, structuredClone(resolvePointer(document, operation.from)));
+    case "move": {
+      const value = resolvePointer(document, operation.from);
+      if (operation.from === operation.path) return document;
+      if (operation.path.startsWith(`${operation.from}/`)) {
+        fail(`Cannot move "${operation.from}" into one of its own children`);
+      }
+      return addAt(removeAt(document, operation.from), operation.path, value);
+    }
+    case "test":
+      if (!jsonEqual(resolvePointer(document, operation.path), operation.value)) {
+        fail(`The value at "${operation.path}" is not the expected one`);
+      }
+      return document;
+  }
+}
+
+/**
+ * Applies the JSON Patch `patch` (RFC 6902) to `document` and returns the result as a new value.
+ *
+ * Neither argument is mutated, and the result shares no structure with them. The patch is validated
+ * as a whole before any operation runs, then operations apply in order; if one fails, nothing is
+ * returned, so the patch is atomic. Removing the whole document is rejected. A "replace" at a
+ * position is a removal followed by an addition, so on arrays it keeps the element count.
+ *
+ * @throws TypeError when `patch` is not an array of well-formed operations.
+ * @throws SyntaxError when a "path" or "from" is not a valid JSON Pointer.
+ * @throws RangeError when an operation fails: unresolvable target, invalid array position, a move
+ *   into its own child, or a "test" whose value differs.
+ */
+export function applyPatch(document: unknown, patch: PatchOperation[]): unknown {
+  if (!Array.isArray(patch)) {
+    throw new TypeError("A JSON Patch must be an array of operations");
+  }
+  const operations = patch.map(validateOperation);
+  return operations.reduce(applyOperation, structuredClone(document));
+}
