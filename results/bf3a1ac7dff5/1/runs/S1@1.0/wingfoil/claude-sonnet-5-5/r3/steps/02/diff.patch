+
+test("applyPatch applies operations in order and does not mutate its inputs", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const patch = [
+    { op: "add", path: "/a/-", value: { z: 1 } },
+    { op: "remove", path: "/b/c" },
+    { op: "move", from: "/a/0", path: "/b/first" },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const result = applyPatch(doc, patch);
+  assert.deepEqual(result, { a: [2, { z: 1 }], b: { first: 1 } });
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  const added = applyPatch({}, [{ op: "add", path: "/v", value: patch[0].value }]) as { v: object };
+  assert.notEqual(added.v, patch[0].value);
+});
+
+test("applyPatch is atomic: a failing operation leaves the input untouched", () => {
+  const doc = { a: 1 };
+  assert.throws(() =>
+    applyPatch(doc, [
+      { op: "add", path: "/b", value: 2 },
+      { op: "test", path: "/a", value: 9 },
+    ]),
+  );
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("applyPatch an empty patch returns an equal copy", () => {
+  const doc = { a: [1] };
+  const result = applyPatch(doc, []);
+  assert.deepEqual(result, doc);
+  assert.notEqual(result, doc);
+});
+
+test("applyPatch does not reach inherited properties or pollute prototypes", () => {
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/toString" }]), RangeError);
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/constructor", value: 1 }]), RangeError);
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as Record<string, unknown>;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(Object.prototype.hasOwnProperty.call(result, "__proto__"), true);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("applyPatch rejects invalid patches", () => {
+  const bad: unknown[] = [
+    null,
+    {},
+    "x",
+    [null],
+    [[]],
+    [{}],
+    [{ op: "add", path: "/a" }],
+    [{ op: "add", value: 1 }],
+    [{ op: "add", path: 1, value: 1 }],
+    [{ op: "remove" }],
+    [{ op: "replace", path: "/a" }],
+    [{ op: "move", path: "/a" }],
+    [{ op: "copy", from: "/a" }],
+    [{ op: "move", from: 1, path: "/a" }],
+    [{ op: "test", path: "/a" }],
+    [{ op: "frobnicate", path: "/a" }],
+  ];
+  for (const patch of bad) {
+    assert.throws(() => applyPatch({ a: 1 }, patch as never), TypeError, JSON.stringify(patch));
+  }
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "a", value: 1 }]), SyntaxError);
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "a", path: "/b" }]), SyntaxError);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a~2", value: 1 }]), SyntaxError);
+});
+
+test("applyPatch validates the whole patch before applying it", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: 1 }, { op: "nope", path: "/a" }]), TypeError);
+});
