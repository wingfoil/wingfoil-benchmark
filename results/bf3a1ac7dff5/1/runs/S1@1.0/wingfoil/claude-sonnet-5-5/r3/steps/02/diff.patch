+
+// JSON Patch (RFC 6902).
+
+test("applyPatch add: object member, array insertion, append and root", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), {
+    foo: "bar",
+    baz: "qux",
