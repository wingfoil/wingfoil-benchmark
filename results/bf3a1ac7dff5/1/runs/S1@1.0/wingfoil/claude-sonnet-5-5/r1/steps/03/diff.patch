+
+# Task — Make applyPatch validation conform to RFC 6902
+
+Reviewed `applyPatch` against RFC 6902 (all six operations, error cases, atomicity). Two deviations:
+a hole in a sparse patch array was silently skipped, and a `value` that is not JSON (`undefined`,
+`NaN`, `Infinity`, `BigInt`, functions, `Date`, nested `undefined`) was accepted. Both now throw.
+Tests added to `test/patch.test.ts` (red first); README updated. Other behaviour was already conformant.
diff --git a/src/index.ts b/src/index.ts
index 93bd6fe19229855767f5f3e187828f73138dbf7b..9305cade0fa927d0f8a59e39f991fd9fbccf875d 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -176,11 +176,32 @@ function requireString(operation: Record<string, unknown>, name: string): string
   return value;
 }
 
+/** Whether `value` is made only of what JSON can express (plain objects and arrays, finite numbers). */
+function isJsonValue(value: unknown): value is JsonValue {
+  if (value === null || typeof value === "boolean" || typeof value === "string") {
+    return true;
+  }
+  if (typeof value === "number") {
+    return Number.isFinite(value);
+  }
+  if (Array.isArray(value)) {
+    return Array.from(value).every(isJsonValue) && Object.keys(value).length === value.length;
+  }
+  if (typeof value === "object") {
+    const prototype = Object.getPrototypeOf(value);
+    return (prototype === Object.prototype || prototype === null) && Object.values(value).every(isJsonValue);
+  }
+  return false;
+}
+
 function requireValue(operation: Record<string, unknown>): JsonValue {
   if (!Object.prototype.hasOwnProperty.call(operation, "value")) {
     throw new Error(`Invalid JSON Patch: "${String(operation.op)}" needs a "value"`);
   }
-  return operation.value as JsonValue;
+  if (!isJsonValue(operation.value)) {
+    throw new Error(`Invalid JSON Patch: the "value" of "${String(operation.op)}" is not a JSON value`);
+  }
+  return operation.value;
 }
 
 function applyOperation(document: JsonValue, operation: unknown): JsonValue {
@@ -239,5 +260,5 @@ export function applyPatch(document: unknown, patch: PatchOperation[] | unknown)
   if (!Array.isArray(patch)) {
     throw new Error("Invalid JSON Patch: a patch must be an array of operations");
   }
-  return patch.reduce<JsonValue>(applyOperation, structuredClone(document) as JsonValue);
+  return Array.from(patch).reduce<JsonValue>(applyOperation, structuredClone(document) as JsonValue);
 }
