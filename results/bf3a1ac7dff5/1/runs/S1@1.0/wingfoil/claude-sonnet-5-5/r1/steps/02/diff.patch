+
+/** One operation of a JSON Patch document (RFC 6902 section 4). */
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; path: string; from: string };
+
+type Container = JsonValue[] | { [key: string]: JsonValue };
+
+/** Sets an own member without ever triggering the `__proto__` setter. */
+function setMember(target: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function isContainer(value: unknown): value is Container {
+  return typeof value === "object" && value !== null;
+}
+
+/** Returns the container that holds the target of `tokens` (which must not be empty). */
+function parentOf(document: JsonValue, tokens: string[]): Container {
+  const parent = tokens.slice(0, -1).reduce<unknown>(resolveToken, document);
+  if (!isContainer(parent)) {
+    throw new Error(`JSON Patch: cannot reach "/${tokens.join("/")}" through a primitive value`);
+  }
+  return parent;
+}
+
+function arrayIndex(array: JsonValue[], token: string, max: number): number {
+  if (!ARRAY_INDEX.test(token) || Number(token) > max) {
+    throw new Error(`JSON Patch: "${token}" is not a valid index of the array`);
+  }
+  return Number(token);
+}
+
+/** Implements the `add` operation on `document`, returning the new document. */
+function addValue(document: JsonValue, tokens: string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = parentOf(document, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    const index = last === "-" ? parent.length : arrayIndex(parent, last, parent.length);
+    parent.splice(index, 0, value);
+  } else {
+    setMember(parent, last, value);
+  }
+  return document;
+}
+
+/** Implements the `remove` operation; the target must exist. */
+function removeValue(document: JsonValue, tokens: string[]): JsonValue {
+  if (tokens.length === 0) {
+    throw new Error("JSON Patch: cannot remove the whole document");
+  }
+  const parent = parentOf(document, tokens);
+  const last = tokens[tokens.length - 1];
+  resolveToken(parent, last);
+  if (Array.isArray(parent)) {
+    parent.splice(Number(last), 1);
+  } else {
+    delete parent[last];
+  }
+  return document;
+}
+
+/** Implements the `replace` operation; the target must exist. */
+function replaceValue(document: JsonValue, tokens: string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = parentOf(document, tokens);
+  const last = tokens[tokens.length - 1];
+  resolveToken(parent, last);
+  if (Array.isArray(parent)) {
+    parent[Number(last)] = value;
+  } else {
+    setMember(parent, last, value);
+  }
+  return document;
+}
+
+/** Deep equality of two JSON values, ignoring the order of object members (RFC 6902 section 4.6). */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((x, i) => jsonEqual(x, b[i]))
+    );
+  }
+  if (isContainer(a) && isContainer(b)) {
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every(
+        (key) =>
+          Object.prototype.hasOwnProperty.call(b, key) &&
+          jsonEqual((a as Record<string, unknown>)[key], (b as Record<string, unknown>)[key]),
+      )
+    );
+  }
+  return a === b;
+}
+
+function requireString(operation: Record<string, unknown>, name: string): string {
+  const value = operation[name];
+  if (typeof value !== "string") {
+    throw new Error(`Invalid JSON Patch: "${String(operation.op)}" needs a string "${name}"`);
+  }
+  return value;
+}
+
+function requireValue(operation: Record<string, unknown>): JsonValue {
+  if (!Object.prototype.hasOwnProperty.call(operation, "value")) {
+    throw new Error(`Invalid JSON Patch: "${String(operation.op)}" needs a "value"`);
+  }
+  return operation.value as JsonValue;
+}
+
+function applyOperation(document: JsonValue, operation: unknown): JsonValue {
+  if (!isContainer(operation) || Array.isArray(operation)) {
+    throw new Error("Invalid JSON Patch: an operation must be an object");
+  }
+  const op = operation as Record<string, unknown>;
+  const path = parsePointer(requireString(op, "path"));
+  switch (op.op) {
+    case "add":
+      return addValue(document, path, structuredClone(requireValue(op)));
+    case "remove":
+      return removeValue(document, path);
+    case "replace": {
+      return replaceValue(document, path, structuredClone(requireValue(op)));
+    }
+    case "test":
+      if (!jsonEqual(resolvePointer(document, requireString(op, "path")), requireValue(op))) {
+        throw new Error(`JSON Patch: test failed at "${requireString(op, "path")}"`);
+      }
+      return document;
+    case "move":
+    case "copy":
+      return transfer(document, op, path);
+    default:
+      throw new Error(`Invalid JSON Patch: unknown operation "${String(op.op)}"`);
+  }
+}
+
+/** Implements `move` and `copy`: reads the value at `from`, then adds it at `path`. */
+function transfer(document: JsonValue, op: Record<string, unknown>, path: string[]): JsonValue {
+  const fromPointer = requireString(op, "from");
+  const from = parsePointer(fromPointer);
+  const value = structuredClone(resolvePointer(document, fromPointer));
+  if (op.op === "copy") {
+    return addValue(document, path, value);
+  }
+  if (from.length < path.length && from.every((token, i) => token === path[i])) {
+    throw new Error("JSON Patch: cannot move a value into one of its own children");
+  }
+  if (from.length === path.length && from.every((token, i) => token === path[i])) {
+    return document;
+  }
+  return addValue(removeValue(document, from), path, value);
+}
+
+/**
+ * Applies the JSON Patch `patch` (RFC 6902) to `document` and returns the resulting document.
+ *
+ * The input is never mutated: operations run on a copy, and the patch is atomic, so a failing
+ * operation leaves nothing half-applied. Throws an `Error` when `patch` is not a valid patch (not an
+ * array, unknown `op`, missing or mistyped member, invalid pointer) or when an operation fails
+ * (unresolvable path, failed `test`, move into own child).
+ */
+export function applyPatch(document: unknown, patch: PatchOperation[] | unknown): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: a patch must be an array of operations");
+  }
+  return patch.reduce<JsonValue>(applyOperation, structuredClone(document) as JsonValue);
+}
