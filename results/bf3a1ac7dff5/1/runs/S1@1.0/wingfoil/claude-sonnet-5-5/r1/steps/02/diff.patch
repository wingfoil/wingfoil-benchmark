+++ b/test/patch.test.ts
@@ -0,0 +1,90 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("add: member, array insert, append with '-', whole document", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(applyPatch({ foo: ["a", "c"] }, [{ op: "add", path: "/foo/1", value: "b" }]), { foo: ["a", "b", "c"] });
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/-", value: 2 }, { op: "add", path: "/2", value: 3 }]), [1, 2, 3]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+});
+
+test("add: errors", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/3", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/01", value: 1 }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]));
+});
+
+test("remove", () => {
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(applyPatch([1, 2, 3], [{ op: "remove", path: "/1" }]), [1, 3]);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/1" }]));
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/-" }]));
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "" }]));
+});
+
+test("replace", () => {
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "replace", path: "/a", value: 3 }]), { a: 3, b: 2 });
+  assert.deepEqual(applyPatch([1, 2], [{ op: "replace", path: "/0", value: 9 }]), [9, 2]);
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/-", value: 1 }]));
+});
+
+test("move", () => {
+  assert.deepEqual(applyPatch({ a: { b: 1 }, c: [1, 2] }, [{ op: "move", from: "/a/b", path: "/c/1" }]), { a: {}, c: [1, 1, 2] });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/x", path: "/y" }]));
+  assert.throws(() => applyPatch({}, [{ op: "move", path: "/y" }]));
+});
+
+test("copy yields an independent value", () => {
+  const result = applyPatch({ a: { b: 1 } }, [{ op: "copy", from: "/a", path: "/c" }, { op: "replace", path: "/c/b", value: 2 }]);
+  assert.deepEqual(result, { a: { b: 1 }, c: { b: 2 } });
+  assert.throws(() => applyPatch({}, [{ op: "copy", from: "/x", path: "/y" }]));
+});
+
+test("test", () => {
+  const doc = { a: { x: 1, y: [1, { z: null }] }, n: 1 };
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }]), doc);
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/n", value: "1" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a", value: { x: 1 } }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/y", value: [1] }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/missing", value: null }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/n" }]));
+});
+
+test("invalid patches", () => {
+  assert.throws(() => applyPatch({}, { op: "add" }));
+  assert.throws(() => applyPatch({}, [null]));
+  assert.throws(() => applyPatch({}, [{ op: "nope", path: "" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "a", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/~2", value: 1 }]));
+});
+
+test("does not mutate input or patch, and is atomic", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const value = { k: [1] };
+  const patch = [{ op: "add", path: "/d", value }, { op: "remove", path: "/a/0" }, { op: "move", from: "/b", path: "/e" }];
+  const snapshot = structuredClone({ doc, patch });
+  const result = applyPatch(doc, patch) as Record<string, unknown>;
+  assert.deepEqual({ doc, patch }, snapshot);
+  (result.d as { k: number[] }).k.push(2);
+  assert.deepEqual(value, { k: [1] });
+  assert.throws(() => applyPatch(doc, [{ op: "remove", path: "/a/0" }, { op: "remove", path: "/zz" }]));
+  assert.deepEqual(doc, snapshot.doc);
+});
+
+test("escapes and prototype keys", () => {
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a~1b", value: 1 }, { op: "add", path: "/m~0n", value: 2 }]), { "a/b": 1, "m~n": 2 });
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as object;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/constructor" }]));
+});
