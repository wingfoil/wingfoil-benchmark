new file mode 100644
index 0000000000000000000000000000000000000000..28d63c442ef0783781c0c69e4aa9fded43b315d3
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,66 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown) {
+  const before = structuredClone(from);
+  const after = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, before);
+  assert.deepEqual(to, after);
+  return patch;
+}
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+});
+
+test("a small change gives a small patch", () => {
+  const from = { name: "x", tags: ["a", "b"], deep: { list: [1, 2, 3], k: "v" } };
+  const to = { name: "x", tags: ["a", "b"], deep: { list: [1, 2, 4], k: "v" } };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/deep/list/2", value: 4 }]);
+});
+
+test("object members are added, removed and replaced", () => {
+  const patch = roundTrip({ a: 1, b: 2 }, { b: 3, c: 4 });
+  assert.equal(patch.length, 3);
+});
+
+test("array growth and shrinkage", () => {
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3, 4]), [
+    { op: "add", path: "/2", value: 3 },
+    { op: "add", path: "/3", value: 4 },
+  ]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2]), [
+    { op: "remove", path: "/3" },
+    { op: "remove", path: "/2" },
+  ]);
+});
+
+test("type changes and the root", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  roundTrip(1, 2);
+  roundTrip(null, { a: null });
+  roundTrip({ a: [] }, { a: {} });
+});
+
+test("special keys are escaped and __proto__ is safe", () => {
+  const from = JSON.parse('{"a/b":1,"c~d":1,"":1,"__proto__":{"x":1}}');
+  const to = JSON.parse('{"a/b":2,"c~d":2,"":2,"__proto__":{"x":2}}');
+  roundTrip(from, to);
+  assert.deepEqual(createPatch({ "a/b": 1 }, { "a/b": 2 }), [{ op: "replace", path: "/a~1b", value: 2 }]);
+});
+
+test("patch values are not shared with the inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to) as { value: { b: number } }[];
+  patch[0].value.b = 9;
+  assert.equal(to.a.b, 1);
+});
+
+test("non-JSON input is rejected", () => {
+  assert.throws(() => createPatch({ a: undefined }, {}));
+  assert.throws(() => createPatch({}, { a: NaN }));
+});
