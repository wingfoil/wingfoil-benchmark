diff --git a/src/index.ts b/src/index.ts
index 7fbb1ec7ec2da8cd712c80e40fd84cd8a00cb30b..369e2c43a0f49b0e0edb6843c20252a0ba08725d 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -305,3 +305,71 @@ export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
   }
   return mergeValue(target, patch);
 }
+
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, out: PatchOperation[]): void {
+  const common = Math.min(from.length, to.length);
+  for (let i = 0; i < common; i++) {
+    diff(from[i], to[i], `${path}/${i}`, out);
+  }
+  for (let i = from.length - 1; i >= common; i--) {
+    out.push({ op: "remove", path: `${path}/${i}` });
+  }
+  for (let i = common; i < to.length; i++) {
+    out.push({ op: "add", path: `${path}/${i}`, value: structuredClone(to[i]) });
+  }
+}
+
+function diffObjects(
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  path: string,
+  out: PatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    const child = `${path}/${encodeToken(key)}`;
+    if (Object.prototype.hasOwnProperty.call(to, key)) {
+      diff(from[key], to[key], child, out);
+    } else {
+      out.push({ op: "remove", path: child });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (!Object.prototype.hasOwnProperty.call(from, key)) {
+      out.push({ op: "add", path: `${path}/${encodeToken(key)}`, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+function diff(from: JsonValue, to: JsonValue, path: string, out: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isPlainObject(from) && isPlainObject(to)) {
+    diffObjects(from, to, path, out);
+  } else if (!jsonEqual(from, to)) {
+    out.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * Only what changed is described: objects are compared member by member and arrays index by index
+ * (a shorter or longer array yields trailing `remove` or `add` operations), recursively. A value whose
+ * type differs is replaced whole. Equal documents give an empty patch. Neither input is mutated or
+ * shared with the patch. Throws an `Error` when `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  if (!isJsonValue(from)) {
+    throw new Error("Invalid createPatch input: `from` is not a JSON value");
+  }
+  if (!isJsonValue(to)) {
+    throw new Error("Invalid createPatch input: `to` is not a JSON value");
+  }
+  const out: PatchOperation[] = [];
+  diff(from, to, "", out);
+  return out;
+}
