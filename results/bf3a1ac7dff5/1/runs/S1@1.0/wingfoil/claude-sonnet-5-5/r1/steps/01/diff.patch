+++ b/test/pointer.test.ts
@@ -0,0 +1,76 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// The example document of RFC 6901 section 5.
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+const rfcCases: Array<[string, unknown]> = [
+  ["", doc],
+  ["/foo", ["bar", "baz"]],
+  ["/foo/0", "bar"],
+  ["/", 0],
+  ["/a~1b", 1],
+  ["/c%d", 2],
+  ["/e^f", 3],
+  ["/g|h", 4],
+  ["/i\\j", 5],
+  ['/k"l', 6],
+  ["/ ", 7],
+  ["/m~0n", 8],
+];
+
+for (const [pointer, expected] of rfcCases) {
+  test(`RFC 6901 example "${pointer}"`, () => {
+    assert.deepEqual(resolvePointer(doc, pointer), expected);
+  });
+}
+
+test("decodes ~01 as ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+});
+
+test("returns falsy values such as null and false", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer({ a: [false] }, "/a/0"), false);
+});
+
+test("the document itself may be a primitive", () => {
+  assert.equal(resolvePointer(5, ""), 5);
+});
+
+for (const pointer of ["foo", "a/b", "/a~", "/a~2", "/~x"]) {
+  test(`rejects invalid pointer "${pointer}"`, () => {
+    assert.throws(() => resolvePointer(doc, pointer), /Invalid JSON Pointer/);
+  });
+}
+
+for (const pointer of [
+  "/missing",
+  "/foo/2",
+  "/foo/-",
+  "/foo/01",
+  "/foo/+1",
+  "/foo/1.0",
+  "/foo/bar",
+  "/foo/0/x",
+  "/foo/",
+  "/a~1b/c",
+  "/__proto__",
+  "/constructor",
+]) {
+  test(`throws when "${pointer}" does not resolve`, () => {
+    assert.throws(() => resolvePointer(doc, pointer), /does not resolve/);
+  });
+}
