@@ -0,0 +1,63 @@
+/** Any value a JSON document can hold. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/** Decodes one reference token (RFC 6901 section 4): `~1` becomes `/`, then `~0` becomes `~`. */
+function decodeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in token "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function resolveToken(current: unknown, token: string): JsonValue {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token)) {
+      throw new Error(`JSON Pointer does not resolve: "${token}" is not an index of the array`);
+    }
+    const index = Number(token);
+    if (index >= current.length) {
+      throw new Error(`JSON Pointer does not resolve: index ${token} is out of bounds`);
+    }
+    return current[index] as JsonValue;
+  }
+  if (typeof current === "object" && current !== null) {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new Error(`JSON Pointer does not resolve: no member "${token}"`);
+    }
+    return (current as Record<string, JsonValue>)[token];
+  }
+  throw new Error(`JSON Pointer does not resolve: cannot take "${token}" of a primitive value`);
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer `pointer` (RFC 6901) refers to.
+ *
+ * The empty pointer refers to the whole document. Throws an `Error` when `pointer` is not a valid
+ * JSON Pointer, or when it does not resolve to a value of `document` (missing member, array index
+ * out of bounds, the `-` past-the-end index, or a step into a primitive).
+ */
+export function resolvePointer(document: unknown, pointer: string): JsonValue {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") {
+    return document as JsonValue;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`);
+  }
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+  let current: unknown = document;
+  for (const token of tokens) {
+    current = resolveToken(current, token);
+  }
+  return current as JsonValue;
+}
