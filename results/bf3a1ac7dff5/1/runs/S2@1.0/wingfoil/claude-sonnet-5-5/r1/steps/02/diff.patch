+++ b/test/coupon-reports.test.ts
@@ -0,0 +1,35 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createShop } from '../src/index.ts';
+
+function shop() {
+  const s = createShop();
+  s.catalog.add({ sku: 'NB-1', name: 'Notebook', priceCents: 500, vatClass: 'standard', weightGrams: 100 });
+  s.inventory.restock('NB-1', 100);
+  s.coupons.add({ code: 'TEN', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31' });
+  s.coupons.add({ code: 'AUTUMN', kind: 'percent', value: 10, validFrom: '2026-09-01', validUntil: '2026-11-30' });
+  return s;
+}
+
+describe('coupon reports', () => {
+  it('applies a percentage coupon to the subtotal after volume discounts', () => {
+    const { orders } = shop();
+    const order = orders.place({
+      customer: 'c-1',
+      date: '2026-03-02',
+      coupon: 'TEN',
+      lines: [{ sku: 'NB-1', quantity: 12 }],
+    });
+    assert.equal(order.totals.couponDiscountCents, 540);
+    assert.equal(order.totals.goodsCents, 4860);
+  });
+
+  it('accepts a coupon on its last day, not the day after', () => {
+    const { orders } = shop();
+    const lines = [{ sku: 'NB-1', quantity: 1 }];
+    const last = orders.place({ customer: 'c-1', date: '2026-11-30', coupon: 'AUTUMN', lines });
+    assert.equal(last.coupon, 'AUTUMN');
+    assert.throws(() => orders.place({ customer: 'c-1', date: '2026-12-01', coupon: 'AUTUMN', lines }), /expired/);
+  });
+});
