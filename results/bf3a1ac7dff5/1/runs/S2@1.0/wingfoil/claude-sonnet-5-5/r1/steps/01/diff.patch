@@ -0,0 +1,37 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createShop } from '../src/index.ts';
+import { lineVat } from '../src/tax.ts';
+
+function shop() {
+  const s = createShop();
+  s.catalog.add({ sku: 'LB-220', name: 'Lamp base', priceCents: 1999, vatClass: 'standard', weightGrams: 300 });
+  s.catalog.add({ sku: 'FIFTY', name: 'Fifty', priceCents: 5000, vatClass: 'standard', weightGrams: 300 });
+  s.inventory.restock('LB-220', 10);
+  s.inventory.restock('FIFTY', 10);
+  return s;
+}
+
+describe('reported fixes', () => {
+  it('finds a product by a lower-case SKU and orders it', () => {
+    const { catalog, orders } = shop();
+    assert.equal(catalog.get(' lb-220 ').sku, 'LB-220');
+    const order = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'lb-220', quantity: 1 }] });
+    assert.equal(order.lines[0]?.sku, 'LB-220');
+  });
+
+  it('ships free when the goods come to exactly €50.00, not below', () => {
+    const { orders } = shop();
+    const exact = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'FIFTY', quantity: 1 }] });
+    assert.equal(exact.totals.shippingCents, 0);
+    const below = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'LB-220', quantity: 1 }] });
+    assert.equal(below.totals.shippingCents, 490);
+  });
+
+  it('rounds the VAT of a line half up', () => {
+    assert.equal(lineVat(199, 'standard'), 44);
+    assert.equal(lineVat(1, 'reduced'), 0);
+    assert.equal(lineVat(5, 'reduced'), 1);
+  });
+});
