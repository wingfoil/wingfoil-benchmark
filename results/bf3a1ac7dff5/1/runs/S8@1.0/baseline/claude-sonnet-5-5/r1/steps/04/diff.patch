--- /dev/null
+++ b/src/domain/import.ts
@@ -0,0 +1,48 @@
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of the import text that could not be added, and why. */
+export interface RejectedLine {
+  /** The line number in the text, counting from 1. */
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks it added, and the lines it could not add. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may be
+ * empty for a normal one, tags are separated by spaces, and blank lines are skipped. A line that cannot be
+ * added is reported and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: 'the line has more than three fields (title;priority;tags)' });
+      return;
+    }
+    const [title = '', priorityText = '', tagText = ''] = fields;
+    const priorityName = priorityText.trim().toLowerCase();
+    const tags = tagText.split(/\s+/).filter((tag) => tag !== '');
+    const result = list.add({
+      title,
+      ...(priorityName === '' ? {} : { priority: priorityName as Priority }),
+      tags,
+    });
+    if (result.ok) imported++;
+    else rejected.push({ line, reason: result.error.message });
+  });
+  return { imported, rejected };
+}
