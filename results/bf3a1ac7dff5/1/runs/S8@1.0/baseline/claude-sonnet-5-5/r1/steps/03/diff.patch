index deee9d01ac1cc56f1fda69427572a2d06a22f7ff..d928752da62f80d93f628f05a8b63debdb7e92cb 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -33,6 +33,43 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/** The longest title a task may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Why `title` cannot be a task title, or `undefined` when it can.
+ *
+ * @param title - the title as typed
+ */
+export function titleProblem(title: unknown): string | undefined {
+  if (typeof title !== 'string' || title.trim() === '') return 'the title is empty';
+  if (title.trim().length > MAX_TITLE_LENGTH) {
+    return `the title is ${title.trim().length} characters long; the limit is ${MAX_TITLE_LENGTH}`;
+  }
+  return undefined;
+}
+
+/**
+ * Why `priority` is not a priority, or `undefined` when it is.
+ *
+ * @param priority - the priority as given
+ */
+export function priorityProblem(priority: unknown): string | undefined {
+  if (PRIORITIES.includes(priority as Priority)) return undefined;
+  return `the priority ${JSON.stringify(priority)} is not one of ${PRIORITIES.join(', ')}`;
+}
+
+/**
+ * Why `tag` cannot be a tag, or `undefined` when it can.
+ *
+ * @param tag - the tag as given
+ */
+export function tagProblem(tag: unknown): string | undefined {
+  if (typeof tag !== 'string' || tag === '') return 'a tag is empty';
+  if (/\s/.test(tag)) return `the tag "${tag}" contains a space`;
+  return undefined;
+}
+
