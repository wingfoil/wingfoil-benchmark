+describe('input validation', () => {
+  it('rejects invalid input and leaves the list unchanged', () => {
+    const list = createTodoList();
+    list.add({ title: 'Keep' });
+    const results = [
+      list.add({ title: '   ' }),
+      list.add({ title: 'x'.repeat(121) }),
+      list.add({ title: 'Ok', priority: 'urgent' as never }),
+      list.add({ title: 'Ok', tags: ['fine', 'a b'] }),
+      list.add({ title: 'Ok', tags: [''] }),
+      list.rename('Keep', ' '),
+      list.rename('Keep', 'y'.repeat(121)),
+      list.tag('Keep', ''),
+      list.tag('Keep', 'a b'),
+    ];
+    for (const r of results) {
+      assert.equal(r.ok, false);
+      if (!r.ok) assert.equal(r.error.code, 'invalid-input');
+    }
+    assert.equal(list.list().length, 1);
+    assert.deepEqual(valueOf(list.find('Keep')).tags, []);
+    assert.equal(valueOf(list.add({ title: 'x'.repeat(120) })).title.length, 120);
+  });
+});
