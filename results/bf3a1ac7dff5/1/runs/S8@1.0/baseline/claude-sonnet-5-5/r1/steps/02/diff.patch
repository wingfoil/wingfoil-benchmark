+
+describe('task timestamps', () => {
+  it('sets updatedAt on every change and keeps createdAt', async () => {
+    const list = createTodoList();
+    const added = valueOf(list.add({ title: 'Sweep' }));
+    const changes = [
+      () => list.complete('Sweep'),
+      () => list.reopen('Sweep'),
+      () => list.rename('Sweep', 'Mop'),
+      () => list.tag('Mop', 'home'),
+      () => list.untag('Mop', 'home'),
+    ];
+    let previous = added.updatedAt;
+    for (const change of changes) {
+      await new Promise((resolve) => setTimeout(resolve, 5));
+      const task = valueOf(change());
+      assert.equal(task.createdAt, added.createdAt);
+      assert.ok(task.updatedAt > previous);
+      previous = task.updatedAt;
+    }
+  });
+});
