+
+describe('task ids', () => {
+  it('gives each task an id no other task has, even after a removal', () => {
+    const list = createTodoList();
+    const first = valueOf(list.add({ title: 'a' }));
+    const second = valueOf(list.add({ title: 'b' }));
+    list.remove('b');
+    const third = valueOf(list.add({ title: 'c' }));
+    assert.equal(new Set([first.id, second.id, third.id]).size, 3);
+  });
+
+  it('gets a task by id, and keeps the id through a rename', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'Old' }));
+    valueOf(list.rename(id, 'New'));
+    assert.equal(valueOf(list.get(id)).title, 'New');
+    assert.equal(valueOf(list.find('New')).id, id);
+  });
+
+  it('fails to get an unknown id', () => {
+    const result = createTodoList().get('nope');
+    assert.equal(result.ok, false);
+    if (!result.ok) assert.equal(result.error.code, 'not-found');
+  });
+
+  it('accepts an id wherever a title is accepted', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'Task' }));
+    assert.equal(valueOf(list.tag(id, 'x')).tags[0], 'x');
+    assert.equal(valueOf(list.untag(id, 'x')).tags.length, 0);
+    assert.equal(valueOf(list.complete(id)).status, 'done');
+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.equal(valueOf(list.find(id)).title, 'Task');
+    valueOf(list.remove(id));
+    assert.equal(list.get(id).ok, false);
+  });
+
+  it('refuses to rename to another task\'s title, and allows the same title', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'a' }));
+    list.add({ title: 'b' });
+    assert.equal(list.rename(id, 'b').ok, false);
+    assert.equal(list.rename(id, 'a').ok, true);
+  });
+});
