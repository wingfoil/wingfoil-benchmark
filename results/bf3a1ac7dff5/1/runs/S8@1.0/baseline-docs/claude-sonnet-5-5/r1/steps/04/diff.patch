diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c4f26240b67a8f8fe1d32112ce93fdf4ca75f2e7
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,27 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds every line with its priority and tags, skipping blank lines', () => {
+    const list = createTodoList(() => '2026-01-01T00:00:00.000Z');
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\nBuy milk;;\nCall mum');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const [insurance] = list.list({ priority: 'high' });
+    assert.deepEqual(insurance?.tags, ['admin', 'money']);
+    assert.equal(list.list({ priority: 'normal' }).length, 2);
+  });
+
+  it('rejects bad lines with their number and keeps importing the rest', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const report = importTasks(list, ';high;\r\nFine;urgent;\nExisting;;\nOk;low;a b\nToo;low;x;y\n  ;;');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(
+      report.rejected.map((r) => r.line),
+      [1, 2, 3, 5, 6],
+    );
+    assert.equal(list.list().length, 2);
+  });
+});
