index 0000000000000000000000000000000000000000..876928bd6c1e4d60007194c06896a94e4329823c
--- /dev/null
+++ b/src/domain/import.ts
@@ -0,0 +1,51 @@
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of the text that could not be added, with its number (from 1) and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks it added, and the lines it could not add. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+const FIELD_COUNT = 3;
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may
+ * be empty for a normal one, the tags are separated by spaces, and blank lines are skipped. A line
+ * that cannot be added is reported and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  text.split(/\r\n|\r|\n/).forEach((content, index) => {
+    if (content.trim() === '') return;
+    const reason = importLine(list, content);
+    if (reason === undefined) imported += 1;
+    else rejected.push({ line: index + 1, reason });
+  });
+  return { imported, rejected };
+}
+
+function importLine(list: TaskList, content: string): string | undefined {
+  const fields = content.split(';');
+  if (fields.length > FIELD_COUNT) {
+    return `expected at most ${FIELD_COUNT} fields (title;priority;tags) but found ${fields.length}`;
+  }
+  const [title = '', priority = '', tags = ''] = fields;
+  const added = list.add({
+    title,
+    // An unknown priority is reported by `add`, which checks it.
+    ...(priority.trim() === '' ? {} : { priority: priority.trim() as Priority }),
+    tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+  });
+  return added.ok ? undefined : added.error.message;
+}
