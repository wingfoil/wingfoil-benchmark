+
+describe('task timestamps', () => {
+  function steppingList() {
+    let minute = 0;
+    return createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, minute++)).toISOString());
+  }
+
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    const list = steppingList();
+    const added = valueOf(list.add({ title: 'a' }));
+    assert.equal(added.updatedAt, added.createdAt);
+    const steps = [
+      valueOf(list.complete('a')),
+      valueOf(list.reopen('a')),
+      valueOf(list.rename('a', 'b')),
+      valueOf(list.tag('b', 'x')),
+      valueOf(list.untag('b', 'x')),
+    ];
+    let previous = added.updatedAt;
+    for (const task of steps) {
+      assert.equal(task.createdAt, added.createdAt);
+      assert.ok(task.updatedAt > previous);
+      previous = task.updatedAt;
+    }
+    assert.equal(valueOf(list.get(added.id)).updatedAt, previous);
+  });
+
+  it('leaves updatedAt alone when nothing changes or the change fails', () => {
+    const list = steppingList();
+    const added = valueOf(list.add({ title: 'a', tags: ['x'] }));
+    assert.equal(list.complete('a').ok, true);
+    const done = valueOf(list.find('a'));
+    assert.equal(list.complete('a').ok, false);
+    assert.equal(valueOf(list.tag('a', 'x')).updatedAt, done.updatedAt);
+    assert.equal(valueOf(list.untag('a', 'nope')).updatedAt, done.updatedAt);
+    assert.equal(valueOf(list.rename('a', 'a')).updatedAt, done.updatedAt);
+    assert.equal(added.createdAt < done.updatedAt, true);
+  });
+
+  it('uses the wall clock by default', () => {
+    const task = valueOf(createTodoList().add({ title: 'a' }));
+    assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
+  });
+});
