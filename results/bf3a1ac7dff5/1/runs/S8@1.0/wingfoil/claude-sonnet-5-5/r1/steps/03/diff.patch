+/** The most characters a title may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a title: after trimming it must not be empty nor longer than {@link MAX_TITLE_LENGTH}.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title must not be empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title must not be longer than ${MAX_TITLE_LENGTH} characters`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be one of `low`, `normal` and `high`.
+ *
+ * @param priority - the priority as given
+ */
+export function validatePriority(priority: unknown): Result<Priority> {
+  return PRIORITIES.includes(priority as Priority)
+    ? ok(priority as Priority)
+    : err('invalid-input', `the priority "${String(priority)}" is not one of ${PRIORITIES.join(', ')}`);
+}
+
+/**
+ * Checks a tag: it must not be empty nor contain whitespace.
+ *
+ * @param tag - the tag as given
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'a tag must not be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" must not contain a space`);
+  return ok(tag);
+}
