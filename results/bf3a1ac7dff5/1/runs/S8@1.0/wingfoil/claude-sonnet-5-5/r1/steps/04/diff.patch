+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of an import that could not be added: its number, counted from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks it added, and the lines it could not add. */
+export interface ImportOutcome {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may be
+ * empty for a normal one, and the tags are separated by spaces. Blank lines are skipped; a line that
+ * cannot be added is reported and the others are still added.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportOutcome {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((content, index) => {
+    if (content.trim() === '') return;
+    const fields = content.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line: index + 1, reason: 'a line has at most three fields: title;priority;tags' });
+      return;
+    }
+    const [title = '', priority = '', tags = ''] = fields;
+    const added = list.add({
+      title,
+      priority: priority.trim() === '' ? undefined : (priority.trim() as Priority),
+      tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+    });
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
