@@ -0,0 +1,44 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds every valid line, with priority and tags', () => {
+    const list = createTodoList(() => '2026-01-01T00:00:00.000Z');
+    const outcome = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;;');
+    assert.deepEqual(outcome, { imported: 2, rejected: [] });
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok);
+    assert.equal(milk.value.priority, 'normal');
+  });
+
+  it('skips blank lines but counts them in line numbers, and handles CRLF', () => {
+    const list = createTodoList();
+    const outcome = importTasks(list, 'A;;\r\n\r\n   \r\nB;urgent;\r\nC;;');
+    assert.equal(outcome.imported, 2);
+    assert.equal(outcome.rejected.length, 1);
+    assert.equal(outcome.rejected[0]?.line, 4);
+    assert.match(outcome.rejected[0]?.reason ?? '', /urgent/);
+  });
+
+  it('rejects empty titles, extra fields and duplicates, adding the rest', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const outcome = importTasks(list, ';high;x\nOne;low;a;b\nTwo\nExisting;;\nTwo;;');
+    assert.equal(outcome.imported, 1);
+    assert.deepEqual(
+      outcome.rejected.map((r) => r.line),
+      [1, 2, 4, 5],
+    );
+    assert.equal(list.list().length, 2);
+  });
+
+  it('imports nothing from empty text', () => {
+    assert.deepEqual(importTasks(createTodoList(), ''), { imported: 0, rejected: [] });
+  });
+});
