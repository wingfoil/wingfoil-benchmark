diff --git a/test/rental-service.test.mjs b/test/rental-service.test.mjs
index 9dbf4fd9e03bdc16172e92ac40998fdfaa2883ee..09b8c0a92ea8ede0f9f97c2fbbaaa32078027ad6 100644
--- a/test/rental-service.test.mjs
+++ b/test/rental-service.test.mjs
@@ -115,3 +115,26 @@ test('validates availability periods and kinds', () => {
   assert.throws(() => rentals.availability({ start: day(11), end: day(10) }));
   assert.throws(() => rentals.availability({ start: day(10), end: day(11), kind: 'mast' }));
 });
+
+test('cancels a booking with a full refund at least 24 hours before it starts and releases its equipment', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+  const booking = rentals.book({ itemId: 'board-1', start: day(10), end: day(13) });
+
+  assert.deepEqual(rentals.cancel(booking.id, day(9)), {
+    bookingId: booking.id,
+    refund: 6_750,
+  });
+  assert.deepEqual(rentals.availability({ start: day(10), end: day(13) }), ['board-1']);
+  assert.doesNotThrow(() => rentals.book({ itemId: 'board-1', start: day(10), end: day(13) }));
+});
+
+test('gives no refund within 24 hours of a booking and rejects repeated or unknown cancellations', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+  const booking = rentals.book({ itemId: 'board-1', start: day(10), end: day(11) });
+
+  assert.deepEqual(rentals.cancel(booking.id, hour(9, 1)), { bookingId: booking.id, refund: 0 });
+  assert.throws(() => rentals.cancel(booking.id, hour(9, 2)));
+  assert.throws(() => rentals.cancel('booking-404', day(1)));
+});
