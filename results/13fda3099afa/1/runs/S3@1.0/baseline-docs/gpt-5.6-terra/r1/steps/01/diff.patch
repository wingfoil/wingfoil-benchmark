@@ -0,0 +1,141 @@
+/** A rentable board or sail, with its price in euro cents per calendar day. */
+export interface Equipment {
+  id: string;
+  kind: 'board' | 'sail';
+  dailyPrice: number;
+}
+
+/** The half-open UTC date range to price or reserve. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The price calculated for a rental period, in euro cents. */
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed rental booking. */
+export interface RentalBooking extends RentalQuote {
+  id: string;
+}
+
+/** In-memory operations available at the rental desk. */
+export interface RentalService {
+  /** Registers equipment that may be quoted or booked. */
+  addEquipment(item: Equipment): void;
+  /** Calculates a price for a valid rental period. */
+  quote(request: RentalRequest): RentalQuote;
+  /** Reserves an available item for a valid rental period. */
+  book(request: RentalRequest): RentalBooking;
+}
+
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1_000;
+const MIDNIGHT_UTC = /^(\d{4})-(\d{2})-(\d{2})T00:00:00(?:\.0+)?Z$/;
+
+/**
+ * Creates an isolated, in-memory rental service.
+ *
+ * Booking identifiers are deterministic and unique within the returned service.
+ */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: RentalBooking[] = [];
+  let nextBookingNumber = 1;
+
+  return {
+    addEquipment(item: Equipment): void {
+      validateEquipment(item);
+      if (equipment.has(item.id)) {
+        throw new Error(`Equipment already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { ...item });
+    },
+
+    quote(request: RentalRequest): RentalQuote {
+      const item = equipment.get(request?.itemId);
+      if (item === undefined) {
+        throw new Error(`Unknown equipment: ${request?.itemId ?? ''}`);
+      }
+      const period = validatePeriod(request);
+      const total = item.dailyPrice * period.days;
+      if (!Number.isSafeInteger(total)) {
+        throw new Error('Rental total exceeds the supported money range');
+      }
+      return { ...request, total };
+    },
+
+    book(request: RentalRequest): RentalBooking {
+      const quote = this.quote(request);
+      const requestedPeriod = validatePeriod(request);
+      const isUnavailable = bookings.some((booking) =>
+        booking.itemId === request.itemId && periodsOverlap(requestedPeriod, validatePeriod(booking)),
+      );
+      if (isUnavailable) {
+        throw new Error(`Equipment is not available: ${request.itemId}`);
+      }
+
+      const booking: RentalBooking = { id: `booking-${nextBookingNumber}`, ...quote };
+      nextBookingNumber += 1;
+      bookings.push(booking);
+      return { ...booking };
+    },
+  };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item !== 'object' || item === null) {
+    throw new Error('Equipment must be an object');
+  }
+  if (typeof item.id !== 'string' || item.id.length === 0) {
+    throw new Error('Equipment id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error('Equipment kind must be board or sail');
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('Equipment dailyPrice must be a non-negative integer number of cents');
+  }
+}
+
+function validatePeriod(request: RentalRequest): { start: number; end: number; days: number } {
+  if (typeof request !== 'object' || request === null) {
+    throw new Error('Rental request must be an object');
+  }
+  const start = parseMidnightUtc(request.start, 'start');
+  const end = parseMidnightUtc(request.end, 'end');
+  if (end <= start) {
+    throw new Error('Rental end must be after its start');
+  }
+  return { start, end, days: (end - start) / DAY_IN_MILLISECONDS };
+}
+
+function parseMidnightUtc(value: unknown, field: string): number {
+  if (typeof value !== 'string') {
+    throw new Error(`Rental ${field} must be an ISO-8601 UTC string`);
+  }
+  const match = MIDNIGHT_UTC.exec(value);
+  if (match === null) {
+    throw new Error(`Rental ${field} must be midnight UTC`);
+  }
+  const timestamp = Date.parse(value);
+  const date = new Date(timestamp);
+  if (
+    Number.isNaN(timestamp) ||
+    date.getUTCFullYear() !== Number(match[1]) ||
+    date.getUTCMonth() + 1 !== Number(match[2]) ||
+    date.getUTCDate() !== Number(match[3])
+  ) {
+    throw new Error(`Rental ${field} must be a valid ISO-8601 UTC date`);
+  }
+  return timestamp;
+}
+
+function periodsOverlap(
+  first: { start: number; end: number },
+  second: { start: number; end: number },
+): boolean {
+  return first.start < second.end && second.start < first.end;
+}
diff --git a/test/rental-service.test.mjs b/test/rental-service.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9ac126a44e4ddb8b6fb150e89bb914e5b6c34ab2
--- /dev/null
+++ b/test/rental-service.test.mjs
@@ -0,0 +1,51 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { createRentalService } from '../src/index.ts';
+
+const day = (dayOfMonth) => `2026-06-${String(dayOfMonth).padStart(2, '0')}T00:00:00Z`;
+
+test('quotes and books a whole-day rental', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+
+  assert.deepEqual(rentals.quote({ itemId: 'board-1', start: day(10), end: day(13) }), {
+    itemId: 'board-1',
+    start: day(10),
+    end: day(13),
+    total: 7_500,
+  });
+  assert.deepEqual(rentals.book({ itemId: 'board-1', start: day(10), end: day(13) }), {
+    id: 'booking-1',
+    itemId: 'board-1',
+    start: day(10),
+    end: day(13),
+    total: 7_500,
+  });
+});
+
+test('rejects unknown equipment and invalid periods', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1_800 });
+
+  assert.throws(() => rentals.quote({ itemId: 'missing', start: day(10), end: day(11) }));
+  assert.throws(() => rentals.quote({ itemId: 'sail-1', start: '2026-06-10T12:00:00Z', end: day(11) }));
+  assert.throws(() => rentals.quote({ itemId: 'sail-1', start: '2026-02-30T00:00:00Z', end: day(11) }));
+  assert.throws(() => rentals.quote({ itemId: 'sail-1', start: day(11), end: day(10) }));
+});
+
+test('validates equipment money and identifiers', () => {
+  const rentals = createRentalService();
+
+  assert.throws(() => rentals.addEquipment({ id: '', kind: 'board', dailyPrice: 1_000 }));
+  assert.throws(() => rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1.5 }));
+});
+
+test('prevents overlapping bookings but permits adjacent ones', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1_800 });
+  rentals.book({ itemId: 'sail-1', start: day(10), end: day(13) });
+
+  assert.throws(() => rentals.book({ itemId: 'sail-1', start: day(12), end: day(14) }));
+  assert.doesNotThrow(() => rentals.book({ itemId: 'sail-1', start: day(13), end: day(14) }));
+});
