@@ -49,3 +49,24 @@ test('prevents overlapping bookings but permits adjacent ones', () => {
   assert.throws(() => rentals.book({ itemId: 'sail-1', start: day(12), end: day(14) }));
   assert.doesNotThrow(() => rentals.book({ itemId: 'sail-1', start: day(13), end: day(14) }));
 });
+
+test('lists sorted equipment that is available for a whole period', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 1_800 });
+  rentals.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2_500 });
+  rentals.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1_800 });
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+  rentals.book({ itemId: 'sail-1', start: day(10), end: day(13) });
+  rentals.book({ itemId: 'board-2', start: day(11), end: day(12) });
+
+  assert.deepEqual(rentals.availability({ start: day(10), end: day(13) }), ['board-1', 'sail-2']);
+  assert.deepEqual(rentals.availability({ start: day(10), end: day(13), kind: 'board' }), ['board-1']);
+  assert.deepEqual(rentals.availability({ start: day(13), end: day(14), kind: 'sail' }), ['sail-1', 'sail-2']);
+});
+
+test('validates availability periods and kinds', () => {
+  const rentals = createRentalService();
+
+  assert.throws(() => rentals.availability({ start: day(11), end: day(10) }));
+  assert.throws(() => rentals.availability({ start: day(10), end: day(11), kind: 'mast' }));
+});
