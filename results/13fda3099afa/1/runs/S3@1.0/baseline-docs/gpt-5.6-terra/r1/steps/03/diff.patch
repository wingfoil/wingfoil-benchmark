+function calculateRentalTotal(dailyPrice: number, days: number): number {
+  const fullPrice = dailyPrice * days;
+  if (!Number.isSafeInteger(fullPrice)) {
+    throw new Error('Rental total exceeds the supported money range');
+  }
+  if (days < LONG_RENTAL_MINIMUM_DAYS) {
+    return fullPrice;
+  }
+
+  const tens = Math.floor(fullPrice / 10);
+  const remainder = fullPrice % 10;
+  return tens * LONG_RENTAL_PRICE_TENTHS + Math.round(remainder * LONG_RENTAL_PRICE_TENTHS / 10);
+}
