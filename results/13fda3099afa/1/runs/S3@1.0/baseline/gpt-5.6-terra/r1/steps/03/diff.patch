+/** Returns 90% of a euro-cent total, rounded to the nearest cent. */
+function discountedLongRentalTotal(fullPrice: number): number {
+  // Splitting quotient and remainder avoids losing precision for safe integer totals.
+  const tens = Math.floor(fullPrice / 10);
+  const remainder = fullPrice % 10;
+  return tens * 9 + Math.round((remainder * 9) / 10);
