+
+/** Returns the booking's unused prepaid value, rounded to the nearest cent. */
+function unusedRentalRefund(booking: StoredBooking, cancelledAt: number): number {
+  if (cancelledAt <= booking.startTime) {
+    return booking.total;
+  }
+  if (cancelledAt >= booking.endTime) {
+    return 0;
+  }
+
+  const unusedDuration = BigInt(booking.endTime - cancelledAt);
+  const bookingDuration = BigInt(booking.endTime - booking.startTime);
+  const refund = (BigInt(booking.total) * unusedDuration * 2n + bookingDuration) /
+    (bookingDuration * 2n);
+  return Number(refund);
 }
 
