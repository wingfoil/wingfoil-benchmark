+function parseCancellationTime(value: string): number {
+  if (typeof value !== 'string' || !UTC_ISO_TIMESTAMP.test(value)) {
+    throw new Error('Cancellation time must be an ISO-8601 UTC timestamp.');
+  }
+
+  const time = Date.parse(value);
+  if (
+    !Number.isFinite(time) ||
+    new Date(time).toISOString().slice(0, 10) !== value.slice(0, 10)
+  ) {
+    throw new Error('Cancellation time must be an ISO-8601 UTC timestamp.');
+  }
+
+  return time;
