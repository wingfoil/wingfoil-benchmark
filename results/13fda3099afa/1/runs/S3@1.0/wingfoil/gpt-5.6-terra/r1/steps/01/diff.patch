diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..37d45530d7cc6feb0a07154101fd718c744bad59
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,134 @@
+/** Equipment available for rent, priced in integer euro cents per day. */
+export interface Equipment {
+  id: string;
+  kind: 'board' | 'sail';
+  dailyPrice: number;
+}
+
+/** A whole-day UTC period; start is inclusive and end is exclusive. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** A rental price in integer euro cents, preserving the requested timestamps. */
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed rental with an identifier unique within its service instance. */
+export interface RentalBooking extends RentalQuote {
+  id: string;
+}
+
+/** An isolated, in-memory equipment inventory and booking calendar. */
+export interface RentalService {
+  /** Register equipment; reject invalid data and duplicate IDs. */
+  addEquipment(item: Equipment): void;
+  /** Price a valid period without reserving equipment or checking availability. */
+  quote(request: RentalRequest): RentalQuote;
+  /** Reserve the entire period; reject invalid input or overlapping bookings. */
+  book(request: RentalRequest): RentalBooking;
+}
+
+interface Period {
+  startMs: number;
+  endMs: number;
+}
+
+interface InventoryItem {
+  equipment: Equipment;
+  bookings: Period[];
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const UTC_MIDNIGHT = /^(\d{4}-\d{2}-\d{2})T00:00(?::00(?:\.0+)?)?(?:Z|\+00:00)$/;
+
+function requireObject(value: unknown, label: string): asserts value is Record<string, unknown> {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    throw new Error(`${label} must be an object`);
+  }
+}
+
+function parseMidnight(value: string): number {
+  const match = typeof value === 'string' ? UTC_MIDNIGHT.exec(value) : null;
+  if (!match) {
+    throw new Error('Rental times must be ISO-8601 timestamps at midnight UTC');
+  }
+  const milliseconds = Date.parse(value);
+  // Date.parse normalizes some impossible dates, such as February 30.
+  if (!Number.isFinite(milliseconds) || new Date(milliseconds).toISOString().slice(0, 10) !== match[1]) {
+    throw new Error('Rental times must contain a valid calendar date');
+  }
+  return milliseconds;
+}
+
+/**
+ * Create a rental service with no runtime dependencies or persistent storage.
+ * Money must fit in a nonnegative safe integer. Booking IDs start at booking-1.
+ */
+export function createRentalService(): RentalService {
+  const inventory = new Map<string, InventoryItem>();
+  let nextBookingId = 1n;
+
+  function price(request: RentalRequest): Period & { item: InventoryItem; quote: RentalQuote } {
+    requireObject(request, 'Rental request');
+    if (typeof request.itemId !== 'string') {
+      throw new Error('Item ID must be a string');
+    }
+    const item = inventory.get(request.itemId);
+    if (!item) {
+      throw new Error(`Unknown equipment: ${request.itemId}`);
+    }
+    const startMs = parseMidnight(request.start);
+    const endMs = parseMidnight(request.end);
+    if (endMs <= startMs) {
+      throw new Error('Rental end must be after its start');
+    }
+    const total = ((endMs - startMs) / DAY_MS) * item.equipment.dailyPrice;
+    if (!Number.isSafeInteger(total)) {
+      throw new Error('Rental total exceeds the safe integer range for euro cents');
+    }
+    return {
+      item,
+      startMs,
+      endMs,
+      quote: { itemId: request.itemId, start: request.start, end: request.end, total },
+    };
+  }
+
+  return {
+    addEquipment(item: Equipment): void {
+      requireObject(item, 'Equipment');
+      if (typeof item.id !== 'string' || (item.kind !== 'board' && item.kind !== 'sail')) {
+        throw new Error('Equipment requires a string ID and kind board or sail');
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('Daily price must be a nonnegative safe integer of euro cents');
+      }
+      if (inventory.has(item.id)) {
+        throw new Error(`Equipment already exists: ${item.id}`);
+      }
+      inventory.set(item.id, {
+        equipment: { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice },
+        bookings: [],
+      });
+    },
+
+    quote(request: RentalRequest): RentalQuote {
+      return price(request).quote;
+    },
+
+    book(request: RentalRequest): RentalBooking {
+      const { item, startMs, endMs, quote } = price(request);
+      if (item.bookings.some(existing => startMs < existing.endMs && endMs > existing.startMs)) {
+        throw new Error('Equipment is not free for the whole rental period');
+      }
+      const booking: RentalBooking = { id: `booking-${nextBookingId}`, ...quote };
+      item.bookings.push({ startMs, endMs });
+      nextBookingId += 1n;
+      return booking;
+    },
+  };
+}
diff --git a/test/rental.test.js b/test/rental.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..5d48ff61d1e6a67d2ffe5293f911ede071da751b
--- /dev/null
+++ b/test/rental.test.js
@@ -0,0 +1,139 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createRentalService } from '../dist/index.js';
+
+const start = '2026-06-01T00:00:00Z';
+const end = '2026-06-04T00:00:00Z';
+const request = { itemId: 'board-1', start, end };
+
+function stockedService() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1250 });
+  return service;
+}
+
+test('quotes whole days in integer cents for boards and sails', () => {
+  const service = stockedService();
+  assert.deepEqual(service.quote(request), { ...request, total: 7500 });
+  assert.deepEqual(service.quote({ ...request, itemId: 'sail-1' }), {
+    ...request, itemId: 'sail-1', total: 3750,
+  });
+  service.addEquipment({ id: 'free', kind: 'board', dailyPrice: 0 });
+  assert.equal(service.quote({ ...request, itemId: 'free' }).total, 0);
+});
+
+test('rejects malformed equipment and duplicate identifiers without changing existing equipment', () => {
+  const service = stockedService();
+  for (const item of [
+    null, {}, { id: 1, kind: 'board', dailyPrice: 100 },
+    { id: 'x', kind: 'fin', dailyPrice: 100 },
+    ...[-1, 1.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 1, '100'].map(
+      dailyPrice => ({ id: 'x', kind: 'sail', dailyPrice }),
+    ),
+  ]) {
+    assert.throws(() => service.addEquipment(item));
+  }
+  assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1 }));
+  assert.equal(service.quote(request).total, 7500);
+});
+
+test('quote and book reject unknown equipment and invalid request objects', () => {
+  const service = stockedService();
+  for (const method of ['quote', 'book']) {
+    for (const invalid of [null, {}, { ...request, itemId: 1 }, { ...request, itemId: 'missing' }]) {
+      assert.throws(() => service[method](invalid));
+    }
+  }
+});
+
+test('quote and book reject invalid calendars, non-UTC times, partial days, and empty or reversed periods', () => {
+  const service = stockedService();
+  const invalidTimes = [
+    '2026-02-30T00:00:00Z', '2026-13-01T00:00:00Z', 'not a date',
+    '2026-06-01', '2026-06-01T00:00:00', '2026-06-01T00:00:00+01:00',
+    '2026-06-01T01:00:00Z', '2026-06-01T00:00:00.001Z',
+    '2026-06-01T24:00:00Z', 1, null,
+  ];
+  for (const method of ['quote', 'book']) {
+    for (const time of invalidTimes) {
+      assert.throws(() => service[method]({ ...request, start: time }));
+      assert.throws(() => service[method]({ ...request, end: time }));
+    }
+    assert.throws(() => service[method]({ ...request, end: start }));
+    assert.throws(() => service[method]({ ...request, start: end, end: start }));
+  }
+});
+
+test('accepts UTC offsets and zero fractional seconds, preserving the supplied strings', () => {
+  const service = stockedService();
+  const period = { itemId: 'board-1', start: '2026-02-28T00:00:00.000+00:00', end: '2026-03-01T00:00:00.000Z' };
+  assert.deepEqual(service.quote(period), { ...period, total: 2500 });
+  assert.deepEqual(service.book(period), { id: 'booking-1', ...period, total: 2500 });
+});
+
+test('counts leap days, month boundaries, and daylight-saving transitions as UTC days', () => {
+  const service = stockedService();
+  for (const [from, until, days] of [
+    ['2028-02-28', '2028-03-01', 2],
+    ['2026-03-28', '2026-03-30', 2],
+    ['2026-12-31', '2027-01-01', 1],
+  ]) {
+    assert.equal(service.quote({ ...request, start: `${from}T00:00:00Z`, end: `${until}T00:00:00Z` }).total, days * 2500);
+  }
+});
+
+test('rejects totals that cannot be represented exactly as integer cents', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'large', kind: 'board', dailyPrice: Number.MAX_SAFE_INTEGER });
+  const period = { ...request, itemId: 'large' };
+  assert.equal(service.quote({ ...period, end: '2026-06-02T00:00:00Z' }).total, Number.MAX_SAFE_INTEGER);
+  assert.throws(() => service.quote(period));
+  assert.throws(() => service.book(period));
+});
+
+test('book returns sequential unique identifiers and quote does not reserve equipment', () => {
+  const service = stockedService();
+  service.quote(request);
+  service.quote(request);
+  assert.deepEqual(service.book(request), { id: 'booking-1', ...request, total: 7500 });
+  assert.equal(service.book({ ...request, itemId: 'sail-1' }).id, 'booking-2');
+  assert.equal(service.quote(request).total, 7500);
+});
+
+test('rejects every overlap shape and allows adjacent periods and different equipment', () => {
+  const service = stockedService();
+  service.book(request);
+  for (const [from, until] of [
+    ['2026-06-01', '2026-06-04'], ['2026-06-02', '2026-06-03'],
+    ['2026-05-31', '2026-06-05'], ['2026-05-31', '2026-06-02'],
+    ['2026-06-03', '2026-06-05'],
+  ]) {
+    assert.throws(() => service.book({ ...request, start: `${from}T00:00:00Z`, end: `${until}T00:00:00Z` }));
+  }
+  assert.equal(service.book({ ...request, start: '2026-05-31T00:00:00Z', end: start }).id, 'booking-2');
+  service.book({ ...request, start: end, end: '2026-06-05T00:00:00Z' });
+  service.book({ ...request, itemId: 'sail-1' });
+});
+
+test('checks the entire booking history using instants rather than timestamp spelling', () => {
+  const service = stockedService();
+  service.book(request);
+  service.book({ ...request, start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  assert.throws(() => service.book({ ...request, start: '2026-06-01T00:00:00.000+00:00' }));
+});
+
+test('service instances and caller-owned objects cannot change stored state', () => {
+  const service = createRentalService();
+  const item = { id: 'board-1', kind: 'board', dailyPrice: 2500 };
+  service.addEquipment(item);
+  item.dailyPrice = 1;
+  const input = { ...request };
+  const booking = service.book(input);
+  input.start = '2026-07-01T00:00:00Z';
+  booking.end = start;
+  assert.throws(() => service.book(request));
+  assert.equal(service.quote(request).total, 7500);
+  assert.equal(stockedService().book(request).id, 'booking-1');
+  assert.throws(() => createRentalService().quote(request));
+});
