+    availability(query: RentalAvailabilityQuery): string[] {
+      const { startMs, endMs, kind } = availabilityPeriod(query);
+      return [...inventory.values()]
+        .filter(({ equipment, bookings }) =>
+          (kind === undefined || equipment.kind === kind) &&
+          !bookings.some(existing => startMs < existing.endMs && endMs > existing.startMs),
+        )
+        .map(({ equipment }) => equipment.id)
+        .sort();
+    },
   };
