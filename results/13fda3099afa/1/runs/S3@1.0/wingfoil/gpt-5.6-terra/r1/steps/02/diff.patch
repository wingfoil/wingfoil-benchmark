+  function availabilityPeriod(query: RentalAvailabilityQuery): Period & { kind?: Equipment['kind'] } {
+    requireObject(query, 'Availability query');
+    if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+      throw new Error('Availability kind must be board or sail');
+    }
+    const startMs = parseMidnight(query.start);
+    const endMs = parseMidnight(query.end);
+    if (endMs <= startMs) {
+      throw new Error('Availability end must be after its start');
+    }
+    return { startMs, endMs, kind: query.kind };
+  }
