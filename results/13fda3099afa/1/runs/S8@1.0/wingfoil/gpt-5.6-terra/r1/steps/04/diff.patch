 export { PRIORITIES } from './domain/task.ts';
 export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 
+/** A source row that could not be imported, including its one-based line number. */
+export interface RejectedImport {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of importing task rows into a list. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedImport[];
+}
+
 /**
  * A new, empty task list for the app, kept in memory.
  *
@@ -16,3 +28,38 @@ export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 export function createTodoList(now: () => Date = () => new Date()): TaskList {
   return createTaskList(() => now().toISOString());
 }
+
+/**
+ * Add valid task rows from semicolon-separated text to a list.
+ *
+ * @param list - the list that receives valid tasks
+ * @param text - one `title;priority;tags` task row per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: RejectedImport[] = [];
+
+  for (const [index, row] of text.split(/\r?\n/).entries()) {
+    if (row.trim().length === 0) continue;
+    const fields = row.split(';');
+    if (fields.length !== 3) {
+      rejected.push({
+        line: index + 1,
+        reason: 'task rows must contain title, priority, and tags separated by semicolons',
+      });
+      continue;
+    }
+    const [title, priorityField, tagsField] = fields;
+    const priority = priorityField.trim();
+    const tags = tagsField.trim() === '' ? [] : tagsField.trim().split(/\s+/);
+    const result = list.add({
+      title,
+      ...(priority === '' ? {} : { priority: priority as Priority }),
+      tags,
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  }
+
+  return { imported, rejected };
+}
