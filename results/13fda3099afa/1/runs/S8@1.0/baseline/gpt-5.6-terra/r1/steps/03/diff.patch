+/** Check whether a title can be used for a task. */
+export function validateTitle(title: string): Result<void> {
+  const normalized = title.trim();
+  if (normalized.length === 0) return err('invalid-input', 'title must not be empty or only spaces');
+  if (normalized.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `title must be at most ${MAX_TITLE_LENGTH} characters long`);
+  }
+  return ok(undefined);
+}
+
+/** Check whether a priority is one of the supported values. */
+export function validatePriority(priority: string | undefined): Result<void> {
+  if (priority !== undefined && !PRIORITIES.includes(priority as Priority)) {
+    return err('invalid-input', 'priority must be "low", "normal", or "high"');
+  }
+  return ok(undefined);
+}
+
+/** Check whether a tag has a usable, single-word name. */
+export function validateTag(tag: string): Result<void> {
+  if (tag.length === 0) return err('invalid-input', 'tag must not be empty');
+  if (tag.includes(' ')) return err('invalid-input', 'tag must not contain spaces');
+  return ok(undefined);
+}
