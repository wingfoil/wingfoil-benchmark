+++ b/src/import.ts
@@ -0,0 +1,53 @@
+import type { TaskList } from './domain/list.ts';
+import type { Priority } from './domain/task.ts';
+
+/** A line that could not be imported, and the reason it was rejected. */
+export interface RejectedTaskImport {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of importing task records into a list. */
+export interface TaskImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedTaskImport[];
+}
+
+/**
+ * Add task records from a spreadsheet-style, line-separated export.
+ *
+ * Each non-blank line must have the form `title;priority;tags`. An empty
+ * priority uses the list's normal priority, and tags are separated by spaces.
+ */
+export function importTasks(list: TaskList, text: string): TaskImportResult {
+  let imported = 0;
+  const rejected: RejectedTaskImport[] = [];
+
+  for (const [index, line] of text.split(/\r?\n/).entries()) {
+    if (line.trim().length === 0) continue;
+
+    const fields = line.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'expected title;priority;tags' });
+      continue;
+    }
+
+    const [title, priorityField, tagsField] = fields;
+    const priority = priorityField.trim();
+    const tags = tagsField.trim() === '' ? [] : tagsField.trim().split(/\s+/);
+    const result = list.add({
+      title,
+      // `add` validates this parsed value before creating a task.
+      priority: priority === '' ? undefined : (priority as Priority),
+      tags,
+    });
+
+    if (result.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line: index + 1, reason: result.error.message });
+    }
+  }
+
+  return { imported, rejected };
+}
