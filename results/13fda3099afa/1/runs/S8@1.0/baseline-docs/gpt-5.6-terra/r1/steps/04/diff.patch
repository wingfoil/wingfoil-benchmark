 /**
  * A new, empty task list for the app, kept in memory.
  *
@@ -16,3 +33,46 @@ export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 export function createTodoList(now: () => string = () => new Date().toISOString()): TaskList {
   return createTaskList(now);
 }
+
+/**
+ * Imports semicolon-separated `title;priority;tags` rows into a task list.
+ * Blank rows are ignored; tags are separated by whitespace and an omitted priority is normal.
+ *
+ * @param list - the task list to add each valid row to
+ * @param text - the newline-separated spreadsheet rows to import
+ */
+export function importTasks(list: TaskList, text: string): TaskImportResult {
+  const rejected: RejectedTaskImport[] = [];
+  let imported = 0;
+
+  for (const [index, line] of text.split(/\r?\n/).entries()) {
+    if (line.trim().length === 0) continue;
+
+    const input = parseImportedTask(line);
+    if (input === undefined) {
+      rejected.push({ line: index + 1, reason: 'expected title;priority;tags' });
+      continue;
+    }
+
+    const added = list.add(input);
+    if (added.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line: index + 1, reason: added.error.message });
+    }
+  }
+
+  return { imported, rejected };
+}
+
+function parseImportedTask(line: string): NewTask | undefined {
+  const fields = line.split(';');
+  if (fields.length !== 3) return undefined;
+
+  const [title, priority, tags] = fields;
+  return {
+    title,
+    ...(priority.trim().length === 0 ? {} : { priority: priority.trim() as Priority }),
+    tags: tags.trim().length === 0 ? [] : tags.trim().split(/\s+/),
+  };
+}
