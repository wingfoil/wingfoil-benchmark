index 0000000000000000000000000000000000000000..cbc39db8e975448942613c8f2d2eec1b974acaf5
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,63 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @param document The JSON document to traverse.
+ * @param pointer The JSON Pointer string. An empty pointer refers to the document itself.
+ * @returns The value selected by the pointer.
+ * @throws {Error} If the pointer is malformed or does not select a value in the document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== 'string' || (pointer !== '' && !pointer.startsWith('/'))) {
+    throw new Error('Pointer is not a valid JSON Pointer.');
+  }
+
+  if (pointer === '') {
+    return document;
+  }
+
+  let value = document;
+
+  for (const referenceToken of pointer.slice(1).split('/')) {
+    const token = decodeReferenceToken(referenceToken);
+
+    if (Array.isArray(value)) {
+      value = resolveArrayIndex(value, token);
+    } else if (isObject(value)) {
+      if (!Object.hasOwn(value, token)) {
+        throw new Error(`JSON Pointer does not resolve to a value: ${pointer}`);
+      }
+      value = value[token];
+    } else {
+      throw new Error(`JSON Pointer does not resolve to a value: ${pointer}`);
+    }
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  for (let index = 0; index < token.length; index += 1) {
+    if (token[index] === '~' && token[index + 1] !== '0' && token[index + 1] !== '1') {
+      throw new Error('Pointer is not a valid JSON Pointer.');
+    }
+  }
+
+  return token.replace(/~[01]/g, (escape) => (escape === '~0' ? '~' : '/'));
+}
+
+function resolveArrayIndex(array: unknown[], token: string): unknown {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error('JSON Pointer does not resolve to a value.');
+  }
+
+  const index = Number(token);
+  if (!Number.isSafeInteger(index) || index >= array.length) {
+    throw new Error('JSON Pointer does not resolve to a value.');
+  }
+
+  return array[index];
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null;
+}
diff --git a/test/index.test.mjs b/test/index.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..62b9b260ed696bc34971379960d0ef2fe49ad434
--- /dev/null
+++ b/test/index.test.mjs
@@ -0,0 +1,53 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { resolvePointer } from '../dist/index.js';
+
+const document = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k\"l': 6,
+  ' ': 7,
+  'm~n': 8,
+  '~1': 9,
+  nested: { value: null },
+};
+
+test('resolves the RFC 6901 example pointers', () => {
+  assert.equal(resolvePointer(document, ''), document);
+  assert.equal(resolvePointer(document, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(document, '/'), 0);
+  assert.equal(resolvePointer(document, '/a~1b'), 1);
+  assert.equal(resolvePointer(document, '/c%d'), 2);
+  assert.equal(resolvePointer(document, '/e^f'), 3);
+  assert.equal(resolvePointer(document, '/g|h'), 4);
+  assert.equal(resolvePointer(document, '/i\\j'), 5);
+  assert.equal(resolvePointer(document, '/k\"l'), 6);
+  assert.equal(resolvePointer(document, '/ '), 7);
+  assert.equal(resolvePointer(document, '/m~0n'), 8);
+  assert.equal(resolvePointer(document, '/~01'), 9);
+});
+
+test('returns values including falsey values and null', () => {
+  assert.equal(resolvePointer(document, '/nested/value'), null);
+});
+
+test('rejects malformed pointers and unresolved values', () => {
+  assert.throws(() => resolvePointer(document, /** @type {string} */ (1)), /valid JSON Pointer/i);
+  assert.throws(() => resolvePointer(document, 'foo'), /valid JSON Pointer/i);
+  assert.throws(() => resolvePointer(document, '/m~2n'), /valid JSON Pointer/i);
+  assert.throws(() => resolvePointer(document, '/foo/01'), /resolve/i);
+  assert.throws(() => resolvePointer(document, '/foo/-'), /resolve/i);
+  assert.throws(() => resolvePointer(document, '/foo/2'), /resolve/i);
+  assert.throws(() => resolvePointer(document, '/missing'), /resolve/i);
+  assert.throws(() => resolvePointer(document, '/nested/value/child'), /resolve/i);
+});
+
+test('does not resolve inherited object members', () => {
+  assert.throws(() => resolvePointer({}, '/toString'), /resolve/i);
+});
