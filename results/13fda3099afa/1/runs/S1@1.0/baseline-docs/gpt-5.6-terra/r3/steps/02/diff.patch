+  switch (op) {
+    case 'add': {
+      const value = requiredValue(operation, 'add');
+      return addValue(document, tokens, cloneJsonValue(value));
+    }
+    case 'remove':
+      return removeValue(document, tokens).document;
+    case 'replace': {
+      const value = requiredValue(operation, 'replace');
+      getValue(document, tokens);
+      return replaceValue(document, tokens, cloneJsonValue(value));
+    }
+    case 'move': {
+      const from = requiredFrom(operation);
+      const fromTokens = parsePointer(from);
+      if (isDescendant(tokens, fromTokens)) {
+        throw new Error('Cannot move a value into one of its descendants.');
+      }
+      const value = getValue(document, fromTokens);
+      const withoutSource = removeValue(document, fromTokens).document;
+      return addValue(withoutSource, tokens, value);
+    }
+    case 'copy': {
+      const from = requiredFrom(operation);
+      const value = getValue(document, parsePointer(from));
+      return addValue(document, tokens, cloneJsonValue(value));
+    }
+    case 'test': {
+      const value = requiredValue(operation, 'test');
+      if (!jsonEqual(getValue(document, tokens), value)) {
