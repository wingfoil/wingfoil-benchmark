+ * @param document The JSON document to patch.
+ * @param patch The ordered array of JSON Patch operation objects.
+ * @returns A new document containing the result of all operations.
+ * @throws {Error} If the document or patch is invalid, or an operation cannot be applied.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
