+    throw new Error('Patch operation must be an object.');
+  }
+
+  const { op, path } = operation;
+  if (typeof op !== 'string' || typeof path !== 'string') {
+    throw new Error('Patch operation must have string op and path members.');
+  }
+  const tokens = parsePointer(path);
