 const document = {
   foo: ['bar', 'baz'],
@@ -125,3 +125,46 @@ test('stops at the first unsuccessful operation without changing the input', ()
   );
   assert.deepEqual(original, { state: 'initial' });
 });
+
+test('applies RFC 7386 JSON Merge Patch without changing either input', () => {
+  const target = {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  };
+  const patch = {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: 'Hello!',
+    author: { givenName: 'John' },
+    tags: ['example'],
+    content: 'This will be unchanged',
+    phoneNumber: '+01-123-456-7890',
+  });
+  assert.deepEqual(target, {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  });
+  assert.deepEqual(patch, {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  });
+});
+
+test('replaces non-object targets and validates JSON Merge Patch inputs', () => {
+  assert.deepEqual(applyMergePatch(['a', 'b'], { enabled: true }), { enabled: true });
+  assert.deepEqual(applyMergePatch({ value: true }, null), null);
+  assert.deepEqual(applyMergePatch({ value: true }, ['replacement']), ['replacement']);
+  assert.throws(() => applyMergePatch({ value: true }, { invalid: undefined }), /patch must be a JSON value/i);
+  assert.throws(() => applyMergePatch({ value: undefined }, {}), /target must be a JSON value/i);
+});
