--- a/README.md
+++ b/README.md
@@ -28,3 +28,16 @@ import { applyPatch } from 'json-toolkit';
 applyPatch({ users: ['Ada'] }, [{ op: 'add', path: '/users/-', value: 'Lin' }]);
 // { users: ['Ada', 'Lin'] }
 ```
+
+## JSON Merge Patch
+
+`applyMergePatch(target, patch)` applies an [RFC 7386 JSON Merge Patch](https://www.rfc-editor.org/rfc/rfc7386)
+and returns a new JSON document. Object properties with a `null` patch value are removed; arrays and
+other non-object values replace the target.
+
+```ts
+import { applyMergePatch } from 'json-toolkit';
+
+applyMergePatch({ profile: { name: 'Ada', role: 'admin' } }, { profile: { role: null } });
+// { profile: { name: 'Ada' } }
+```
diff --git a/src/index.ts b/src/index.ts
index 1fada77832f81dc418b7dd3e5bde9c0e08624dc6..12bcd116a9a337d2b690de1e6226958631ba6e6b 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -58,6 +58,42 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   return result;
 }
 
+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document without mutating either input.
+ *
+ * Object members whose patch value is null are removed. Arrays and non-object values replace
+ * their targets completely.
+ *
+ * @param target The JSON document to patch.
+ * @param patch The JSON Merge Patch document.
+ * @returns A new document containing the merged result.
+ * @throws {Error} If the target or patch is not a valid JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJsonValue(target, 'Target');
+  assertJsonValue(patch, 'Patch');
+
+  return mergePatch(cloneJsonValue(target), patch);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonObject(patch)) {
+    return cloneJsonValue(patch);
+  }
+
+  const result: Record<string, unknown> = isJsonObject(target) ? target : {};
+  for (const [name, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[name];
+    } else {
+      const currentValue = Object.hasOwn(result, name) ? result[name] : undefined;
+      setObjectMember(result, name, mergePatch(currentValue, value));
+    }
+  }
+
+  return result;
+}
+
 function applyOperation(document: unknown, operation: unknown): unknown {
   if (!isObject(operation) || Array.isArray(operation)) {
     throw new Error('Patch operation must be an object.');
@@ -321,3 +357,7 @@ function resolveArrayIndex(array: unknown[], token: string): unknown {
 function isObject(value: unknown): value is Record<string, unknown> {
   return typeof value === 'object' && value !== null;
 }
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return isObject(value) && !Array.isArray(value);
+}
