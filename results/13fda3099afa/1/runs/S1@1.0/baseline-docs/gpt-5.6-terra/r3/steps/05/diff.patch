+/** A single RFC 6902 operation produced by {@link createPatch}. */
+export type JsonPatchOperation =
+  | { op: 'add' | 'replace'; path: string; value: unknown }
+  | { op: 'remove'; path: string };
+
+/**
+ * Creates an RFC 6902 JSON Patch that transforms one JSON document into another.
+ *
+ * The returned patch uses JSON Pointers to change only the differing members or array items;
+ * neither input document is mutated.
+ *
+ * @param from The original JSON document.
+ * @param to The desired JSON document.
+ * @returns An ordered JSON Patch that transforms `from` into `to`.
+ * @throws {Error} If either input is not a valid JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  assertJsonValue(from, 'From document');
+  assertJsonValue(to, 'To document');
+
+  const patch: JsonPatchOperation[] = [];
+  createPatchAt(from, to, '', patch);
+  return patch;
+}
+
