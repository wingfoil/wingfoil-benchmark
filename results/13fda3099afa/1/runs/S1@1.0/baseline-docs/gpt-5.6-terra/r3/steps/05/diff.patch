+function createPatchAt(from: unknown, to: unknown, path: string, patch: JsonPatchOperation[]): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    for (const key of Object.keys(from)) {
+      const memberPath = appendPointerToken(path, key);
+      if (!Object.hasOwn(to, key)) {
+        patch.push({ op: 'remove', path: memberPath });
+      } else {
+        createPatchAt(from[key], to[key], memberPath, patch);
+      }
+    }
+    for (const key of Object.keys(to)) {
+      if (!Object.hasOwn(from, key)) {
+        patch.push({ op: 'add', path: appendPointerToken(path, key), value: cloneJsonValue(to[key]) });
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatch(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: 'replace', path, value: cloneJsonValue(to) });
+}
+
+function createArrayPatch(from: unknown[], to: unknown[], path: string, patch: JsonPatchOperation[]): void {
+  const matches = longestCommonSubsequence(from, to);
+  let fromIndex = 0;
+  let toIndex = 0;
+  let resultIndex = 0;
+
+  for (const [matchingFromIndex, matchingToIndex] of matches) {
+    resultIndex = createArrayGapPatch(
+      from,
+      fromIndex,
+      matchingFromIndex,
+      to,
+      toIndex,
+      matchingToIndex,
+      path,
+      resultIndex,
+      patch,
+    );
+    fromIndex = matchingFromIndex + 1;
+    toIndex = matchingToIndex + 1;
+    resultIndex += 1;
+  }
+
+  createArrayGapPatch(from, fromIndex, from.length, to, toIndex, to.length, path, resultIndex, patch);
+}
+
+function createArrayGapPatch(
+  from: unknown[],
+  fromStart: number,
+  fromEnd: number,
+  to: unknown[],
+  toStart: number,
+  toEnd: number,
+  path: string,
+  resultIndex: number,
+  patch: JsonPatchOperation[],
+): number {
+  const pairedLength = Math.min(fromEnd - fromStart, toEnd - toStart);
+  for (let offset = 0; offset < pairedLength; offset += 1) {
+    createPatchAt(from[fromStart + offset], to[toStart + offset], appendPointerToken(path, String(resultIndex)), patch);
+    resultIndex += 1;
+  }
+  for (let index = fromStart + pairedLength; index < fromEnd; index += 1) {
+    patch.push({ op: 'remove', path: appendPointerToken(path, String(resultIndex)) });
+  }
+  for (let index = toStart + pairedLength; index < toEnd; index += 1) {
+    patch.push({ op: 'add', path: appendPointerToken(path, String(resultIndex)), value: cloneJsonValue(to[index]) });
+    resultIndex += 1;
+  }
+  return resultIndex;
+}
+
+function longestCommonSubsequence(from: unknown[], to: unknown[]): Array<[number, number]> {
+  const lengths = Array.from({ length: from.length + 1 }, () => new Array<number>(to.length + 1).fill(0));
+  for (let fromIndex = from.length - 1; fromIndex >= 0; fromIndex -= 1) {
+    for (let toIndex = to.length - 1; toIndex >= 0; toIndex -= 1) {
+      lengths[fromIndex][toIndex] = jsonEqual(from[fromIndex], to[toIndex])
+        ? lengths[fromIndex + 1][toIndex + 1] + 1
+        : Math.max(lengths[fromIndex + 1][toIndex], lengths[fromIndex][toIndex + 1]);
+    }
+  }
+
+  const matches: Array<[number, number]> = [];
+  let fromIndex = 0;
+  let toIndex = 0;
+  while (fromIndex < from.length && toIndex < to.length) {
+    if (jsonEqual(from[fromIndex], to[toIndex])) {
+      matches.push([fromIndex, toIndex]);
+      fromIndex += 1;
+      toIndex += 1;
+    } else if (lengths[fromIndex + 1][toIndex] >= lengths[fromIndex][toIndex + 1]) {
+      fromIndex += 1;
+    } else {
+      toIndex += 1;
+    }
+  }
+  return matches;
+}
+
+function appendPointerToken(path: string, token: string): string {
+  return `${path}/${token.replace(/~/g, '~0').replace(/\//g, '~1')}`;
+}
