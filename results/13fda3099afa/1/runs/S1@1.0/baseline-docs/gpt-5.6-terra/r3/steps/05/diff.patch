+
+test('creates a granular RFC 6902 patch without changing either document', () => {
+  const from = {
+    profile: { name: 'Ada', role: 'admin' },
+    stale: true,
+    list: ['one', 'two', 'three'],
+    'a/b': 1,
+  };
+  const to = {
+    profile: { name: 'Ada', role: 'user' },
+    list: ['one', 'inserted', 'three'],
+    'a/b': 2,
+    fresh: { enabled: true },
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'replace', path: '/profile/role', value: 'user' },
+    { op: 'remove', path: '/stale' },
+    { op: 'replace', path: '/list/1', value: 'inserted' },
+    { op: 'replace', path: '/a~1b', value: 2 },
+    { op: 'add', path: '/fresh', value: { enabled: true } },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    profile: { name: 'Ada', role: 'admin' },
+    stale: true,
+    list: ['one', 'two', 'three'],
+    'a/b': 1,
+  });
+  assert.deepEqual(to, {
+    profile: { name: 'Ada', role: 'user' },
+    list: ['one', 'inserted', 'three'],
+    'a/b': 2,
+    fresh: { enabled: true },
+  });
+});
+
+test('creates compact array and root patches and validates its inputs', () => {
+  assert.deepEqual(createPatch({ unchanged: [1] }, { unchanged: [1] }), []);
+  assert.deepEqual(createPatch(['a', 'c'], ['a', 'b', 'c']), [{ op: 'add', path: '/1', value: 'b' }]);
+  assert.deepEqual(createPatch(['a', 'b', 'c'], ['a', 'c']), [{ op: 'remove', path: '/1' }]);
+  assert.deepEqual(createPatch({ old: true }, ['new']), [{ op: 'replace', path: '', value: ['new'] }]);
+  assert.throws(() => createPatch({ valid: true }, { invalid: undefined }), /to document must be a JSON value/i);
+  assert.throws(() => createPatch({ invalid: undefined }, {}), /from document must be a JSON value/i);
+});
