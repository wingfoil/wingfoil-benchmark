@@ -15,3 +15,17 @@ import { resolvePointer } from 'json-toolkit';
 
 resolvePointer({ services: [{ name: 'api' }] }, '/services/0/name'); // 'api'
 ```
+
+## JSON Patch
+
+`applyPatch(document, patch)` applies an [RFC 6902 JSON Patch](https://www.rfc-editor.org/rfc/rfc6902)
+without mutating the supplied document. It supports `add`, `remove`, `replace`, `move`, `copy`, and
+`test`, and throws if the patch is malformed or an operation cannot be applied.
+
+```ts
+import { applyPatch } from 'json-toolkit';
+
+applyPatch({ services: ['api'] }, [
+  { op: 'add', path: '/services/-', value: 'worker' },
+]); // { services: ['api', 'worker'] }
+```
