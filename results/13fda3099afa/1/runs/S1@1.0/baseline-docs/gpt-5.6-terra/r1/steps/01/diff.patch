index 0000000000000000000000000000000000000000..b63a03a4c5561b7ac6ed4d9c8c388c78cfc5b211
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,74 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @param document The JSON document to traverse.
+ * @param pointer A JSON Pointer string. The empty string identifies the whole document.
+ * @returns The value addressed by the pointer.
+ * @throws {Error} If the pointer is invalid or does not identify a value in the document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== 'string' || (pointer !== '' && !pointer.startsWith('/'))) {
+    throw new Error('Invalid JSON Pointer');
+  }
+
+  if (pointer === '') {
+    return document;
+  }
+
+  let value = document;
+
+  for (const token of pointer.slice(1).split('/')) {
+    const referenceToken = decodeReferenceToken(token);
+
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(referenceToken)) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+
+      const index = Number(referenceToken);
+      if (index >= value.length) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+
+      value = value[index];
+      continue;
+    }
+
+    if (value === null || typeof value !== 'object' || !Object.hasOwn(value, referenceToken)) {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+
+    value = (value as Record<string, unknown>)[referenceToken];
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  let decoded = '';
+
+  for (let index = 0; index < token.length; index += 1) {
+    const character = token[index];
+    if (character !== '~') {
+      decoded += character;
+      continue;
+    }
+
+    const escape = token[index + 1];
+    if (escape === '0') {
+      decoded += '~';
+    } else if (escape === '1') {
+      decoded += '/';
+    } else {
+      throw new Error('Invalid JSON Pointer');
+    }
+
+    index += 1;
+  }
+
+  return decoded;
+}
+
+function isArrayIndex(token: string): boolean {
+  return token === '0' || /^[1-9][0-9]*$/.test(token);
+}
diff --git a/test/index.test.mjs b/test/index.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5c75b2b8ba9b1430fd1a7655acb0c3ca53813f0c
--- /dev/null
+++ b/test/index.test.mjs
@@ -0,0 +1,42 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { resolvePointer } from '../src/index.ts';
+
+const document = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k\"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+test('resolves the JSON Pointer examples from RFC 6901', () => {
+  assert.deepEqual(resolvePointer(document, ''), document);
+  assert.equal(resolvePointer(document, '/foo'), document.foo);
+  assert.equal(resolvePointer(document, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(document, '/'), 0);
+  assert.equal(resolvePointer(document, '/a~1b'), 1);
+  assert.equal(resolvePointer(document, '/c%d'), 2);
+  assert.equal(resolvePointer(document, '/e^f'), 3);
+  assert.equal(resolvePointer(document, '/g|h'), 4);
+  assert.equal(resolvePointer(document, '/i\\j'), 5);
+  assert.equal(resolvePointer(document, '/k\"l'), 6);
+  assert.equal(resolvePointer(document, '/ '), 7);
+  assert.equal(resolvePointer(document, '/m~0n'), 8);
+});
+
+test('throws when a pointer is malformed or cannot resolve', () => {
+  for (const pointer of ['foo', '/m~n', '/m~2n', '/foo/01', '/foo/-', '/foo/2', '/missing']) {
+    assert.throws(() => resolvePointer(document, pointer));
+  }
+});
+
+test('distinguishes missing members from members whose value is undefined', () => {
+  assert.equal(resolvePointer({ value: undefined }, '/value'), undefined);
+});
