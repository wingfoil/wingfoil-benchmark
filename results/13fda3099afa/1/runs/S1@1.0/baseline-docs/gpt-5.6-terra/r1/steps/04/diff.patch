+test('applies the RFC 7386 merge patch examples without mutating either input', () => {
+  const target = {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  };
+  const patch = {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: 'Hello!',
+    author: { givenName: 'John' },
+    tags: ['example'],
+    content: 'This will be unchanged',
+    phoneNumber: '+01-123-456-7890',
+  });
+  assert.deepEqual(target, {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  });
+  assert.deepEqual(patch, {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  });
+});
+
+test('replaces non-object targets and patches, and treats null members as removals', () => {
+  assert.deepEqual(applyMergePatch('target', { value: 1 }), { value: 1 });
+  assert.deepEqual(applyMergePatch({ value: 1 }, ['replacement']), ['replacement']);
+  assert.equal(applyMergePatch({ value: 1 }, null), null);
+  assert.deepEqual(applyMergePatch({ keep: true }, { missing: null }), { keep: true });
+});
+
+test('rejects merge patch documents outside the JSON data model', () => {
+  assert.throws(() => applyMergePatch({ value: true }, { value: undefined }));
+  assert.throws(() => applyMergePatch({ value: Number.NaN }, {}));
+});
