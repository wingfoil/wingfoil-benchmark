+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document without changing either input.
+ *
+ * Object members whose patch value is `null` are removed. Other object members are merged
+ * recursively; a patch that is not an object replaces the target value in its entirety.
+ *
+ * @param target The JSON document to update.
+ * @param patch The JSON Merge Patch document to apply.
+ * @returns A new JSON document containing the merged result.
+ * @throws {Error} If the target or patch is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJsonValue(target, 'Invalid JSON document');
+  assertJsonValue(patch, 'Invalid JSON Merge Patch');
+
+  return mergePatch(target, patch);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonObject(patch)) {
+    return cloneJsonValue(patch);
+  }
+
+  const result = isJsonObject(target)
+    ? cloneJsonValue(target) as Record<string, unknown>
+    : {};
+
+  for (const [key, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[key];
+    } else {
+      defineJsonProperty(result, key, mergePatch(result[key], value));
+    }
+  }
+
+  return result;
+}
