+/**
+ * Creates an RFC 6902 JSON Patch that changes one JSON document into another.
+ *
+ * The generated patch uses member- and element-level operations whenever possible, so unchanged
+ * portions of a document are not sent again. Neither input is changed.
+ *
+ * @param from The original JSON document.
+ * @param to The desired JSON document.
+ * @returns A JSON Patch that transforms `from` into `to`.
+ * @throws {Error} If either input is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  assertJsonValue(from, 'Invalid JSON document');
+  assertJsonValue(to, 'Invalid JSON document');
+
+  const patch: unknown[] = [];
+  createValuePatch(from, to, [], patch);
+  return patch;
+}
