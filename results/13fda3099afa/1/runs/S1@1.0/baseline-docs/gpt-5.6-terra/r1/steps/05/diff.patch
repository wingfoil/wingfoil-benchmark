+test('creates a compact JSON Patch for nested object and array changes without mutating inputs', () => {
+  const from = {
+    unchanged: { value: true },
+    service: { name: 'api', settings: { retries: 2 } },
+    tags: ['stable', 'internal'],
+  };
+  const to = {
+    unchanged: { value: true },
+    service: { name: 'api', settings: { retries: 3 } },
+    tags: ['stable', 'public', 'internal'],
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'replace', path: '/service/settings/retries', value: 3 },
+    { op: 'add', path: '/tags/1', value: 'public' },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    unchanged: { value: true },
+    service: { name: 'api', settings: { retries: 2 } },
+    tags: ['stable', 'internal'],
+  });
+  assert.deepEqual(to, {
+    unchanged: { value: true },
+    service: { name: 'api', settings: { retries: 3 } },
+    tags: ['stable', 'public', 'internal'],
