index 0000000000000000000000000000000000000000..9b428633a18e1028f6208702778b6171ab420adf
--- /dev/null
+++ b/test/applyPatch.test.mjs
@@ -0,0 +1,48 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyPatch } from "../src/index.ts";
+
+test("applies all RFC 6902 operations without mutating the document", () => {
+  const document = {
+    foo: ["bar", "baz"],
+    object: { source: { value: 1 } },
+  };
+
+  const result = applyPatch(document, [
+    { op: "add", path: "/foo/1", value: "qux" },
+    { op: "remove", path: "/foo/0" },
+    { op: "replace", path: "/foo/1", value: "boo" },
+    { op: "copy", from: "/object/source", path: "/copied" },
+    { op: "move", from: "/object/source/value", path: "/moved" },
+    { op: "test", path: "/copied/value", value: 1 },
+  ]);
+
+  assert.deepEqual(result, {
+    foo: ["qux", "boo"],
+    object: { source: {} },
+    copied: { value: 1 },
+    moved: 1,
+  });
+  assert.deepEqual(document, {
+    foo: ["bar", "baz"],
+    object: { source: { value: 1 } },
+  });
+  assert.notEqual(result, document);
+  assert.notEqual(result.copied, document.object.source);
+});
+
+test("supports root replacement and array append", () => {
+  assert.deepEqual(applyPatch({ value: 1 }, [{ op: "replace", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch(["a"], [{ op: "add", path: "/-", value: "b" }]), ["a", "b"]);
+});
+
+test("rejects invalid patches and operations that cannot be applied", () => {
+  assert.throws(() => applyPatch({}, { op: "add", path: "/a", value: 1 }));
+  assert.throws(() => applyPatch({}, [{ op: "unknown", path: "" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "missing", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/missing" }]));
+  assert.throws(() => applyPatch([], [{ op: "add", path: "/01", value: 1 }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: 2 }]));
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+});
