+/**
+ * Applies an RFC 6902 JSON Patch to a JSON document.
+ *
+ * The input document is never modified. Invalid patch documents and operations
+ * that cannot be applied throw an error.
+ *
+ * @param document The JSON document to update.
+ * @param patch The JSON Patch operation array.
+ * @returns A new JSON document containing the applied changes.
+ * @throws {Error} If the document or patch is invalid, or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  assertJsonValue(document, "document");
+  if (!Array.isArray(patch)) {
+    throw new Error("A JSON Patch must be an array of operations.");
+  }
+
+  let result = cloneJsonValue(document);
+  for (const operation of patch) {
+    result = applyOperation(result, operation);
+  }
+  return result;
+}
+
+type PatchOperation = Record<string, unknown>;
+
+function applyOperation(document: unknown, rawOperation: unknown): unknown {
+  if (!isObject(rawOperation) || Array.isArray(rawOperation)) {
+    throw new Error("Each JSON Patch operation must be an object.");
+  }
+
+  const operation = rawOperation as PatchOperation;
+  const op = operation.op;
+  const path = operation.path;
+  if (!Object.hasOwn(operation, "op") || !Object.hasOwn(operation, "path")
+    || typeof op !== "string" || typeof path !== "string") {
+    throw new Error("Each JSON Patch operation requires string 'op' and 'path' members.");
+  }
+  const tokens = parsePointer(path);
+
+  switch (op) {
+    case "add":
+      return addValue(document, tokens, operationValue(operation, "add"));
+    case "remove":
+      return removeValue(document, tokens);
+    case "replace":
+      return replaceValue(document, tokens, operationValue(operation, "replace"));
+    case "copy": {
+      const value = getValue(document, parsePointer(operationFrom(operation, "copy")));
+      return addValue(document, tokens, cloneJsonValue(value));
+    }
+    case "move": {
+      const fromTokens = parsePointer(operationFrom(operation, "move"));
+      if (isProperDescendant(tokens, fromTokens)) {
+        throw new Error("A JSON Patch move destination cannot be a child of its source.");
+      }
+      const value = getValue(document, fromTokens);
+      return addValue(removeValue(document, fromTokens), tokens, value);
+    }
+    case "test": {
+      const expected = operationValue(operation, "test");
+      if (!jsonEqual(getValue(document, tokens), expected)) {
+        throw new Error("JSON Patch test operation failed.");
+      }
+      return document;
+    }
+    default:
+      throw new Error(`Unsupported JSON Patch operation '${op}'.`);
+  }
+}
+
+function operationValue(operation: PatchOperation, op: string): unknown {
+  if (!Object.hasOwn(operation, "value")) {
+    throw new Error(`JSON Patch '${op}' operation requires a 'value' member.`);
+  }
+  assertJsonValue(operation.value, `JSON Patch '${op}' value`);
+  return cloneJsonValue(operation.value);
+}
+
+function operationFrom(operation: PatchOperation, op: string): string {
+  if (!Object.hasOwn(operation, "from") || typeof operation.from !== "string") {
+    throw new Error(`JSON Patch '${op}' operation requires a string 'from' member.`);
+  }
+  return operation.from;
+}
+
+function addValue(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const { parent, token } = parentAt(document, tokens);
+  if (Array.isArray(parent)) {
+    const index = addArrayIndex(token, parent.length);
+    parent.splice(index, 0, value);
+  } else {
+    setObjectMember(parent, token, value);
+  }
+  return document;
+}
+
+function removeValue(document: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) {
+    throw new Error("A JSON Patch remove operation cannot remove the document root.");
+  }
+  const { parent, token } = parentAt(document, tokens);
+  if (Array.isArray(parent)) {
+    parent.splice(existingArrayIndex(token, parent.length), 1);
+  } else {
+    if (!Object.hasOwn(parent, token)) {
+      throw new Error(`JSON Pointer token '${token}' does not exist.`);
+    }
+    delete parent[token];
+  }
+  return document;
+}
+
+function replaceValue(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const { parent, token } = parentAt(document, tokens);
+  if (Array.isArray(parent)) {
+    parent[existingArrayIndex(token, parent.length)] = value;
+  } else {
+    if (!Object.hasOwn(parent, token)) {
+      throw new Error(`JSON Pointer token '${token}' does not exist.`);
+    }
+    setObjectMember(parent, token, value);
+  }
+  return document;
+}
+
+function getValue(document: unknown, tokens: string[]): unknown {
+  let value = document;
+  for (const token of tokens) {
+    value = resolveToken(value, token);
+  }
+  return value;
+}
+
+function parentAt(document: unknown, tokens: string[]): { parent: Record<string, unknown> | unknown[]; token: string } {
+  const token = tokens[tokens.length - 1];
+  const parent = getValue(document, tokens.slice(0, -1));
+  if (!isObject(parent)) {
+    throw new Error("JSON Patch path parent must be an object or array.");
+  }
+  return { parent: parent as Record<string, unknown> | unknown[], token };
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error("A JSON Pointer must be empty or start with '/'.");
+  }
+  return pointer.slice(1).split("/").map(decodeToken);
+}
+
+function addArrayIndex(token: string, length: number): number {
+  if (token === "-") {
+    return length;
+  }
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`JSON Pointer token '${token}' is not a valid array index.`);
+  }
+  const index = Number(token);
+  if (!Number.isSafeInteger(index) || index > length) {
+    throw new Error(`JSON Patch array index '${token}' is out of bounds.`);
+  }
+  return index;
+}
+
+function existingArrayIndex(token: string, length: number): number {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`JSON Pointer token '${token}' is not a valid array index.`);
+  }
+  const index = Number(token);
+  if (!Number.isSafeInteger(index) || index >= length) {
+    throw new Error(`JSON Pointer array index '${token}' does not exist.`);
+  }
+  return index;
+}
+
+function isProperDescendant(path: string[], ancestor: string[]): boolean {
+  return path.length > ancestor.length && ancestor.every((token, index) => path[index] === token);
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null;
+}
+
+function setObjectMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { configurable: true, enumerable: true, value, writable: true });
+}
+
+function assertJsonValue(value: unknown, name: string, seen = new Set<object>()): void {
+  if (value === null || typeof value === "string" || typeof value === "boolean") {
+    return;
+  }
+  if (typeof value === "number") {
+    if (Number.isFinite(value)) return;
+  } else if (Array.isArray(value)) {
+    if (seen.has(value)) throw new Error(`${name} must not contain cycles.`);
+    seen.add(value);
+    if (Object.getOwnPropertySymbols(value).length > 0
+      || Object.keys(value).some((key, index) => key !== String(index))) {
+      throw new Error(`${name} must be a JSON value.`);
+    }
+    for (const item of value) assertJsonValue(item, name, seen);
+    seen.delete(value);
+    return;
+  } else if (isObject(value)) {
+    const prototype = Object.getPrototypeOf(value);
+    if (prototype !== Object.prototype && prototype !== null
+      || Object.getOwnPropertySymbols(value).length > 0) {
+      throw new Error(`${name} must be a JSON value.`);
+    }
+    if (seen.has(value)) throw new Error(`${name} must not contain cycles.`);
+    seen.add(value);
+    for (const key of Object.keys(value)) assertJsonValue(value[key], name, seen);
+    seen.delete(value);
+    return;
+  }
+  throw new Error(`${name} must be a JSON value.`);
+}
+
+function cloneJsonValue(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(cloneJsonValue);
+  if (isObject(value)) {
+    const clone: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setObjectMember(clone, key, cloneJsonValue(value[key]));
+    return clone;
+  }
+  return value;
+}
+
+function jsonEqual(left: unknown, right: unknown): boolean {
+  if (left === right) return true;
+  if (Array.isArray(left) && Array.isArray(right)) {
+    return left.length === right.length && left.every((value, index) => jsonEqual(value, right[index]));
+  }
+  if (isObject(left) && isObject(right) && !Array.isArray(left) && !Array.isArray(right)) {
+    const leftKeys = Object.keys(left);
+    const rightKeys = Object.keys(right);
+    return leftKeys.length === rightKeys.length
+      && leftKeys.every((key) => Object.hasOwn(right, key) && jsonEqual(left[key], right[key]));
+  }
+  return false;
+}
+
 function decodeToken(token: string): string {
   let decoded = "";
 
