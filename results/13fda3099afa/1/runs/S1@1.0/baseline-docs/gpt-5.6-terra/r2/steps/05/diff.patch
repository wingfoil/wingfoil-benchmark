+
+function createObjectPatchOperations(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  path: string,
+  patch: PatchOperation[],
+): void {
+  const fromKeys = Object.keys(from).sort();
+  const toKeys = Object.keys(to).sort();
+
+  for (const key of fromKeys) {
+    if (Object.hasOwn(to, key)) {
+      createPatchOperations(from[key], to[key], appendPointer(path, key), patch);
+    }
+  }
+  for (const key of fromKeys) {
+    if (!Object.hasOwn(to, key)) {
+      patch.push({ op: "remove", path: appendPointer(path, key) });
+    }
+  }
+  for (const key of toKeys) {
+    if (!Object.hasOwn(from, key)) {
+      patch.push({ op: "add", path: appendPointer(path, key), value: cloneJsonValue(to[key]) });
+    }
+  }
