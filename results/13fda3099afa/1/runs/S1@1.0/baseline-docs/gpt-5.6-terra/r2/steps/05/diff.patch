diff --git a/test/createPatch.test.mjs b/test/createPatch.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6d4a6378a715ee986f3d4ac446ff44707589291e
--- /dev/null
+++ b/test/createPatch.test.mjs
@@ -0,0 +1,66 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyPatch, createPatch } from "../src/index.ts";
+
+test("creates a focused patch for nested object changes without mutating either input", () => {
+  const from = {
+    profile: { name: "Ada", title: "Engineer" },
+    unchanged: { active: true },
+  };
+  const to = {
+    profile: { name: "Ada", title: "Architect", location: "London" },
+    unchanged: { active: true },
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "replace", path: "/profile/title", value: "Architect" },
+    { op: "add", path: "/profile/location", value: "London" },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    profile: { name: "Ada", title: "Engineer" },
+    unchanged: { active: true },
+  });
+  assert.deepEqual(to, {
+    profile: { name: "Ada", title: "Architect", location: "London" },
+    unchanged: { active: true },
+  });
+});
+
+test("uses granular array operations for insertions, removals, and element updates", () => {
+  const from = { values: ["first", "second", "third"], other: true };
+  const to = { values: ["first", "updated", "new", "third"], other: true };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "replace", path: "/values/1", value: "updated" },
+    { op: "add", path: "/values/2", value: "new" },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.equal(patch.some((operation) => operation.path === "/values"), false);
+
+  const removalPatch = createPatch({ values: ["first", "middle", "last"] }, {
+    values: ["first", "last"],
+  });
+  assert.deepEqual(removalPatch, [{ op: "remove", path: "/values/1" }]);
+});
+
+test("escapes JSON Pointer tokens and replaces the document root when needed", () => {
+  const patch = createPatch({ "a/b~c": 1 }, ["replacement"]);
+
+  assert.deepEqual(createPatch({ "a/b~c": 1 }, { "a/b~c": 2 }), [
+    { op: "replace", path: "/a~1b~0c", value: 2 },
+  ]);
+  assert.deepEqual(patch, [{ op: "replace", path: "", value: ["replacement"] }]);
+  assert.deepEqual(applyPatch({ "a/b~c": 1 }, patch), ["replacement"]);
+});
+
+test("returns an empty patch for equal values and rejects non-JSON inputs", () => {
+  assert.deepEqual(createPatch({ value: [1, null] }, { value: [1, null] }), []);
+  assert.throws(() => createPatch({ value: undefined }, {}));
+  assert.throws(() => createPatch({}, { value: Number.POSITIVE_INFINITY }));
+});
