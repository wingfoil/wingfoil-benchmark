+  let suffixLength = 0;
+  while (suffixLength < from.length - prefixLength && suffixLength < to.length - prefixLength
+    && jsonEqual(from[from.length - suffixLength - 1], to[to.length - suffixLength - 1])) {
+    suffixLength += 1;
+  }
+
+  const fromChangedLength = from.length - prefixLength - suffixLength;
+  const toChangedLength = to.length - prefixLength - suffixLength;
+  const sharedLength = Math.min(fromChangedLength, toChangedLength);
