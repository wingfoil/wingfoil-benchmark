+/**
+ * Creates an RFC 6902 JSON Patch that changes one JSON document into another.
+ *
+ * The returned patch targets changed values directly, preserving unchanged
+ * portions of objects and arrays. Neither input document is modified.
+ *
+ * @param from The original JSON document.
+ * @param to The desired JSON document.
+ * @returns The JSON Patch operations that transform `from` into `to`.
+ * @throws {Error} If either input is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  assertJsonValue(from, "from");
+  assertJsonValue(to, "to");
+
+  const patch: PatchOperation[] = [];
+  createPatchOperations(from, to, "", patch);
+  return patch;
+}
