index 0000000000000000000000000000000000000000..58a3799de24df0685d1662503b5a1f4ed73ed64f
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,91 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @param document The JSON document to traverse.
+ * @param pointer An RFC 6901 JSON Pointer string.
+ * @returns The JSON value identified by the pointer.
+ * @throws {Error} If the pointer is malformed or does not identify a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== 'string') {
+    throw new Error('A JSON Pointer must be a string.');
+  }
+
+  if (pointer === '') {
+    if (document === undefined) {
+      throw new Error('The JSON Pointer does not resolve to a value.');
+    }
+
+    return document;
+  }
+
+  if (!pointer.startsWith('/')) {
+    throw new Error('A non-empty JSON Pointer must begin with a slash.');
+  }
+
+  let value = document;
+
+  for (const encodedToken of pointer.slice(1).split('/')) {
+    const token = decodeReferenceToken(encodedToken);
+
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(token)) {
+        throw new Error('The JSON Pointer does not resolve to an array value.');
+      }
+
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= value.length) {
+        throw new Error('The JSON Pointer does not resolve to an array value.');
+      }
+
+      value = value[index];
+    } else if (isJsonObject(value)) {
+      if (!Object.hasOwn(value, token)) {
+        throw new Error('The JSON Pointer does not resolve to an object value.');
+      }
+
+      value = value[token];
+    } else {
+      throw new Error('The JSON Pointer cannot traverse a primitive value.');
+    }
+
+    if (value === undefined) {
+      throw new Error('The JSON Pointer does not resolve to a value.');
+    }
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  let decoded = '';
+
+  for (let index = 0; index < token.length; index += 1) {
+    const character = token[index];
+    if (character !== '~') {
+      decoded += character;
+      continue;
+    }
+
+    const escape = token[index + 1];
+    if (escape === '0') {
+      decoded += '~';
+    } else if (escape === '1') {
+      decoded += '/';
+    } else {
+      throw new Error('A JSON Pointer contains an invalid escape sequence.');
+    }
+
+    index += 1;
+  }
+
+  return decoded;
+}
+
+function isArrayIndex(token: string): boolean {
+  return token === '0' || /^[1-9][0-9]*$/u.test(token);
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null;
+}
diff --git a/test/resolvePointer.test.mjs b/test/resolvePointer.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..92222022fb209faf69e2c78a89620fe05a1c224d
--- /dev/null
+++ b/test/resolvePointer.test.mjs
@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+const { resolvePointer } = await import('../dist/index.js');
+
+const document = {
+  '': 'empty-key',
+  a: { b: ['zero', { 'c/d': 'escaped slash', 'm~n': 'escaped tilde' }] },
+};
+
+test('resolves the document root and RFC 6901 reference tokens', () => {
+  assert.equal(resolvePointer(document, ''), document);
+  assert.equal(resolvePointer(document, '/'), 'empty-key');
+  assert.equal(resolvePointer(document, '/a/b/1/c~1d'), 'escaped slash');
+  assert.equal(resolvePointer(document, '/a/b/1/m~0n'), 'escaped tilde');
+});
+
+test('rejects invalid or unresolvable pointers', () => {
+  for (const pointer of ['a', '/a/b/01', '/a/b/-', '/a/b/2', '/a/b/1/c~2d', '/a/b/1/m~']) {
+    assert.throws(() => resolvePointer(document, pointer));
+  }
+});
