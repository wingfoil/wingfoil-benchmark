+function createPatchOperations(
+  from: JsonValue,
+  to: JsonValue,
+  path: string[],
+  patch: JsonPatchOperation[],
+): void {
+  if (jsonEquals(from, to)) {
+    return;
+  }
+
+  if (isMergePatchObject(from) && isMergePatchObject(to)) {
+    createObjectPatchOperations(from, to, path, patch);
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatchOperations(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: 'replace', path: formatPointer(path), value: to });
+}
+
+function createObjectPatchOperations(
+  from: JsonObject,
+  to: JsonObject,
+  path: string[],
+  patch: JsonPatchOperation[],
+): void {
+  const sourceKeys = Object.keys(from).sort();
+  const targetKeys = Object.keys(to).sort();
+
+  for (const key of sourceKeys) {
+    if (!Object.hasOwn(to, key)) {
+      patch.push({ op: 'remove', path: formatPointer([...path, key]) });
+    }
+  }
+  for (const key of sourceKeys) {
+    if (Object.hasOwn(to, key)) {
+      createPatchOperations(from[key], to[key], [...path, key], patch);
+    }
+  }
+  for (const key of targetKeys) {
+    if (!Object.hasOwn(from, key)) {
+      patch.push({ op: 'add', path: formatPointer([...path, key]), value: to[key] });
+    }
+  }
+}
+
+function createArrayPatchOperations(
+  from: JsonValue[],
+  to: JsonValue[],
+  path: string[],
+  patch: JsonPatchOperation[],
+): void {
+  if (from.length === to.length) {
+    for (let index = 0; index < from.length; index += 1) {
+      createPatchOperations(from[index], to[index], [...path, String(index)], patch);
+    }
+    return;
+  }
+
+  const longestCommonSubsequences = createLongestCommonSubsequenceTable(from, to);
+  let sourceIndex = 0;
+  let targetIndex = 0;
+  let patchIndex = 0;
+
+  while (sourceIndex < from.length || targetIndex < to.length) {
+    if (sourceIndex < from.length && targetIndex < to.length && jsonEquals(from[sourceIndex], to[targetIndex])) {
+      sourceIndex += 1;
+      targetIndex += 1;
+      patchIndex += 1;
+    } else if (
+      sourceIndex < from.length
+      && (targetIndex === to.length || longestCommonSubsequences[sourceIndex + 1][targetIndex]
+        >= longestCommonSubsequences[sourceIndex][targetIndex + 1])
+    ) {
+      patch.push({ op: 'remove', path: formatPointer([...path, String(patchIndex)]) });
+      sourceIndex += 1;
+    } else {
+      patch.push({ op: 'add', path: formatPointer([...path, String(patchIndex)]), value: to[targetIndex] });
+      targetIndex += 1;
+      patchIndex += 1;
+    }
+  }
+}
+
+function createLongestCommonSubsequenceTable(from: JsonValue[], to: JsonValue[]): number[][] {
+  const table = Array.from({ length: from.length + 1 }, () => Array<number>(to.length + 1).fill(0));
+
+  for (let sourceIndex = from.length - 1; sourceIndex >= 0; sourceIndex -= 1) {
+    for (let targetIndex = to.length - 1; targetIndex >= 0; targetIndex -= 1) {
+      table[sourceIndex][targetIndex] = jsonEquals(from[sourceIndex], to[targetIndex])
+        ? table[sourceIndex + 1][targetIndex + 1] + 1
+        : Math.max(table[sourceIndex + 1][targetIndex], table[sourceIndex][targetIndex + 1]);
+    }
+  }
+
+  return table;
+}
+
+function formatPointer(path: string[]): string {
+  return path.map((token) => `/${token.replaceAll('~', '~0').replaceAll('/', '~1')}`).join('');
+}
