+/** A JSON Patch operation generated by {@link createPatch}. */
+export type JsonPatchOperation =
+  | { op: 'add' | 'replace'; path: string; value: JsonValue }
+  | { op: 'remove'; path: string };
+
+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ *
+ * The returned patch contains only operations needed for the change and neither input is mutated.
+ * @throws {Error} If either input is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const source = cloneJsonValue(from, 'The source JSON document is invalid.');
+  const target = cloneJsonValue(to, 'The target JSON document is invalid.');
+  const patch: JsonPatchOperation[] = [];
+
+  createPatchOperations(source, target, [], patch);
+  return patch;
+}
