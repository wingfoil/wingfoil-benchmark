index 0000000000000000000000000000000000000000..8d92074c555e108081adc8042a6f8a7d3c27a69b
--- /dev/null
+++ b/test/createPatch.test.mjs
@@ -0,0 +1,54 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+const { applyPatch, createPatch } = await import('../dist/index.js');
+
+test('creates an empty patch for equal JSON values', () => {
+  assert.deepEqual(createPatch({ a: [1, { b: true }] }, { a: [1, { b: true }] }), []);
+});
+
+test('creates localized operations for nested object changes', () => {
+  const from = { profile: { name: 'Ada', title: 'Engineer' }, enabled: true };
+  const to = { profile: { name: 'Ada', team: 'Research' }, enabled: false };
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'replace', path: '/enabled', value: false },
+    { op: 'remove', path: '/profile/title' },
+    { op: 'add', path: '/profile/team', value: 'Research' },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, { profile: { name: 'Ada', title: 'Engineer' }, enabled: true });
+  assert.deepEqual(to, { profile: { name: 'Ada', team: 'Research' }, enabled: false });
+});
+
+test('escapes reference tokens and handles root replacement', () => {
+  const patch = createPatch({ 'a/b': { 'm~n': 1 } }, ['replacement']);
+
+  assert.deepEqual(patch, [{ op: 'replace', path: '', value: ['replacement'] }]);
+  assert.deepEqual(applyPatch({ 'a/b': { 'm~n': 1 } }, patch), ['replacement']);
+  assert.deepEqual(createPatch({ 'a/b': { 'm~n': 1 } }, { 'a/b': { 'm~n': 2 } }), [
+    { op: 'replace', path: '/a~1b/m~0n', value: 2 },
+  ]);
+});
+
+test('uses small indexed operations for array changes', () => {
+  assert.deepEqual(createPatch(['a', 'c'], ['a', 'b', 'c']), [
+    { op: 'add', path: '/1', value: 'b' },
+  ]);
+  assert.deepEqual(createPatch(['a', 'b', 'c'], ['a', 'c']), [
+    { op: 'remove', path: '/1' },
+  ]);
+  assert.deepEqual(createPatch([{ id: 1, state: 'old' }], [{ id: 1, state: 'new' }]), [
+    { op: 'replace', path: '/0/state', value: 'new' },
+  ]);
+});
+
+test('rejects non-JSON values without mutating inputs', () => {
+  const from = { value: 1 };
+  const to = { value: undefined };
+
+  assert.throws(() => createPatch(from, to));
+  assert.deepEqual(from, { value: 1 });
+  assert.deepEqual(to, { value: undefined });
+});
