 }
 
+/**
+ * Applies an RFC 7386 JSON Merge Patch without mutating either supplied value.
+ *
+ * @param target The JSON document to update.
+ * @param patch The JSON Merge Patch document.
+ * @returns The merged JSON document.
+ * @throws {Error} If the target or patch is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  const document = cloneJsonValue(target, 'The JSON document is invalid.');
+  const mergePatch = cloneJsonValue(patch, 'The JSON Merge Patch document is invalid.');
+
+  return mergeJsonValue(document, mergePatch);
+}
+
 function applyOperation(document: PatchDocument, operation: unknown): PatchDocument {
   if (!isJsonObject(operation) || Array.isArray(operation)) {
     throw new Error('A JSON Patch operation must be an object.');
@@ -125,6 +140,23 @@ type JsonValue = null | boolean | number | string | JsonValue[] | JsonObject;
 type JsonObject = { [member: string]: JsonValue };
 type PatchDocument = JsonValue | undefined;
 
+function mergeJsonValue(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isMergePatchObject(patch)) {
+    return patch;
+  }
+
+  const result: JsonObject = isMergePatchObject(target) ? target : {};
+  for (const member of Object.keys(patch)) {
+    const value = patch[member];
+    if (value === null) {
+      delete result[member];
+    } else {
+      setObjectMember(result, member, mergeJsonValue(result[member], value));
+    }
+  }
+  return result;
+}
+
 function parsePointer(pointer: string): string[] {
   if (pointer === '') {
     return [];
@@ -332,3 +364,7 @@ function isArrayIndex(token: string): boolean {
 function isJsonObject(value: unknown): value is Record<string, unknown> {
   return typeof value === 'object' && value !== null;
 }
+
+function isMergePatchObject(value: unknown): value is JsonObject {
+  return isJsonObject(value) && !Array.isArray(value);
+}
diff --git a/test/applyMergePatch.test.mjs b/test/applyMergePatch.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..232a3218a4a96b3a61a7bb11c776d46c38c59fb3
--- /dev/null
+++ b/test/applyMergePatch.test.mjs
@@ -0,0 +1,46 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+const { applyMergePatch } = await import('../dist/index.js');
+
+// Red-first: these RFC 7386 merge semantics are not implemented yet.
+test('merges object members and removes members assigned null', () => {
+  const target = { a: 'b', c: { d: 'e', f: 'g' } };
+  const patch = { a: 'z', c: { f: null } };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    a: 'z',
+    c: { d: 'e' },
+  });
+  assert.deepEqual(target, { a: 'b', c: { d: 'e', f: 'g' } });
+  assert.deepEqual(patch, { a: 'z', c: { f: null } });
+});
+
+test('treats non-object targets as empty objects and replaces with non-object patches', () => {
+  assert.deepEqual(applyMergePatch(['old'], { nested: { remove: null }, value: 1 }), {
+    nested: {},
+    value: 1,
+  });
+  assert.deepEqual(applyMergePatch({ value: 1 }, ['replacement']), ['replacement']);
+  assert.equal(applyMergePatch({ value: 1 }, null), null);
+});
+
+test('creates independent nested values and rejects non-JSON inputs', () => {
+  const target = { kept: true };
+  const patch = { added: { items: [1] } };
+  const result = applyMergePatch(target, patch);
+
+  result.added.items.push(2);
+  assert.deepEqual(target, { kept: true });
+  assert.deepEqual(patch, { added: { items: [1] } });
+  assert.throws(() => applyMergePatch({}, { value: undefined }));
+  assert.throws(() => applyMergePatch(undefined, {}));
+});
+
+test('treats __proto__ as an ordinary JSON object member', () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"safe":true}}'));
+
+  assert.equal(Object.hasOwn(result, '__proto__'), true);
+  assert.deepEqual(result.__proto__, { safe: true });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
