+/**
+ * Applies an RFC 6902 JSON Patch without mutating the supplied document.
+ *
+ * @param document The JSON document to update.
+ * @param patch The array of JSON Patch operations.
+ * @returns A new JSON document containing the applied operations.
+ * @throws {Error} If the document or patch is invalid, or an operation cannot be applied.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  let result = cloneJsonValue(document, 'The JSON document is invalid.');
+
+  if (!Array.isArray(patch)) {
+    throw new Error('A JSON Patch must be an array of operations.');
+  }
+
+  for (const operation of patch) {
+    result = applyOperation(result, operation);
+  }
+
+  return result;
+}
+
+function applyOperation(document: JsonValue, operation: unknown): JsonValue {
+  if (!isJsonObject(operation) || Array.isArray(operation)) {
+    throw new Error('A JSON Patch operation must be an object.');
+  }
+
+  const op = requiredStringMember(operation, 'op');
+  const path = parsePointer(requiredStringMember(operation, 'path'));
+
+  switch (op) {
+    case 'add':
+      return addValue(document, path, requiredJsonMember(operation, 'value'));
+    case 'remove':
+      return removeValue(document, path);
+    case 'replace':
+      getValue(document, path);
+      return addValue(document, path, requiredJsonMember(operation, 'value'));
+    case 'move': {
+      const from = parsePointer(requiredStringMember(operation, 'from'));
+      if (isProperDescendant(path, from)) {
+        throw new Error('A JSON Patch move cannot move a value into one of its children.');
+      }
+      if (samePointer(path, from)) {
+        return document;
+      }
+      const value = getValue(document, from);
+      return addValue(removeValue(document, from), path, value);
+    }
+    case 'copy': {
+      const value = getValue(document, parsePointer(requiredStringMember(operation, 'from')));
+      return addValue(document, path, value);
+    }
+    case 'test':
+      if (!jsonEquals(getValue(document, path), requiredJsonMember(operation, 'value'))) {
+        throw new Error('A JSON Patch test operation failed.');
+      }
+      return document;
+    default:
+      throw new Error('A JSON Patch operation has an unsupported op member.');
+  }
+}
+
+type JsonValue = null | boolean | number | string | JsonValue[] | JsonObject;
+type JsonObject = { [member: string]: JsonValue };
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === '') {
+    return [];
+  }
+  if (!pointer.startsWith('/')) {
+    throw new Error('A non-empty JSON Pointer must begin with a slash.');
+  }
+  return pointer.slice(1).split('/').map(decodeReferenceToken);
+}
+
+function getValue(document: JsonValue, path: string[]): JsonValue {
+  let value = document;
+  for (const token of path) {
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(token) || Number(token) >= value.length) {
+        throw new Error('The JSON Patch path does not resolve to an array value.');
+      }
+      value = value[Number(token)];
+    } else if (isJsonObject(value) && Object.hasOwn(value, token)) {
+      value = value[token];
+    } else {
+      throw new Error('The JSON Patch path does not resolve to a value.');
+    }
+  }
+  return value;
+}
+
+function addValue(document: JsonValue, path: string[], value: JsonValue): JsonValue {
+  if (path.length === 0) {
+    return cloneJsonValue(value, 'A JSON Patch value is invalid.');
+  }
+
+  const { parent, token } = getParent(document, path);
+  if (Array.isArray(parent)) {
+    if (token === '-') {
+      parent.push(cloneJsonValue(value, 'A JSON Patch value is invalid.'));
+    } else if (isArrayIndex(token) && Number(token) <= parent.length) {
+      parent.splice(Number(token), 0, cloneJsonValue(value, 'A JSON Patch value is invalid.'));
+    } else {
+      throw new Error('A JSON Patch add path has an invalid array index.');
+    }
+  } else {
+    setObjectMember(parent, token, cloneJsonValue(value, 'A JSON Patch value is invalid.'));
+  }
+  return document;
+}
+
+function removeValue(document: JsonValue, path: string[]): JsonValue {
+  if (path.length === 0) {
+    throw new Error('A JSON Patch cannot remove the document root.');
+  }
+
+  const { parent, token } = getParent(document, path);
+  if (Array.isArray(parent)) {
+    if (!isArrayIndex(token) || Number(token) >= parent.length) {
+      throw new Error('A JSON Patch remove path does not resolve to an array value.');
+    }
+    parent.splice(Number(token), 1);
+  } else {
+    if (!Object.hasOwn(parent, token)) {
+      throw new Error('A JSON Patch remove path does not resolve to a value.');
+    }
+    delete parent[token];
+  }
+  return document;
+}
+
+function getParent(document: JsonValue, path: string[]): { parent: JsonValue[] | JsonObject; token: string } {
+  const parent = getValue(document, path.slice(0, -1));
+  if (Array.isArray(parent) || isJsonObject(parent)) {
+    return { parent, token: path[path.length - 1] };
+  }
+  throw new Error('A JSON Patch path cannot add a member to a primitive value.');
+}
+
+function requiredStringMember(operation: Record<string, unknown>, member: string): string {
+  if (!Object.hasOwn(operation, member) || typeof operation[member] !== 'string') {
+    throw new Error(`A JSON Patch operation requires a string ${member} member.`);
+  }
+  return operation[member];
+}
+
+function requiredJsonMember(operation: Record<string, unknown>, member: string): JsonValue {
+  if (!Object.hasOwn(operation, member)) {
+    throw new Error(`A JSON Patch operation requires a ${member} member.`);
+  }
+  return cloneJsonValue(operation[member], `A JSON Patch ${member} member is invalid.`);
+}
+
+function cloneJsonValue(value: unknown, errorMessage: string, seen = new Set<object>()): JsonValue {
+  if (value === null || typeof value === 'boolean' || typeof value === 'string') {
+    return value;
+  }
+  if (typeof value === 'number') {
+    if (Number.isFinite(value)) {
+      return value;
+    }
+    throw new Error(errorMessage);
+  }
+  if (Array.isArray(value)) {
+    if (seen.has(value)) {
+      throw new Error(errorMessage);
+    }
+    seen.add(value);
+    const clone = value.map((item) => cloneJsonValue(item, errorMessage, seen));
+    seen.delete(value);
+    return clone;
+  }
+  if (isJsonObject(value) && !Array.isArray(value) && isPlainObject(value)) {
+    if (seen.has(value)) {
+      throw new Error(errorMessage);
+    }
+    seen.add(value);
+    const clone: JsonObject = {};
+    for (const key of Object.keys(value)) {
+      setObjectMember(clone, key, cloneJsonValue(value[key], errorMessage, seen));
+    }
+    seen.delete(value);
+    return clone;
+  }
+  throw new Error(errorMessage);
+}
+
+function jsonEquals(left: JsonValue, right: JsonValue): boolean {
+  if (typeof left !== typeof right || left === null || right === null) {
+    return left === right;
+  }
+  if (typeof left === 'number' || typeof left === 'string' || typeof left === 'boolean') {
+    return left === right;
+  }
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return Array.isArray(left) && Array.isArray(right)
+      && left.length === right.length
+      && left.every((value, index) => jsonEquals(value, right[index]));
+  }
+  const leftObject = left as JsonObject;
+  const rightObject = right as JsonObject;
+  const leftKeys = Object.keys(leftObject);
+  const rightKeys = Object.keys(rightObject);
+  return leftKeys.length === rightKeys.length
+    && leftKeys.every((key) => Object.hasOwn(rightObject, key) && jsonEquals(leftObject[key], rightObject[key]));
+}
+
+function samePointer(left: string[], right: string[]): boolean {
+  return left.length === right.length && left.every((token, index) => token === right[index]);
+}
+
+function isProperDescendant(path: string[], ancestor: string[]): boolean {
+  return path.length > ancestor.length && ancestor.every((token, index) => token === path[index]);
+}
+
+function setObjectMember(object: JsonObject, member: string, value: JsonValue): void {
+  Object.defineProperty(object, member, {
+    configurable: true,
+    enumerable: true,
+    value,
+    writable: true,
+  });
+}
+
+function isPlainObject(value: object): boolean {
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
+
 function decodeReferenceToken(token: string): string {
   let decoded = '';
 
