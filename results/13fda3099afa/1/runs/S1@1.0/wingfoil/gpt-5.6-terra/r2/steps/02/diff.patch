@@ -16,3 +16,17 @@ resolvePointer({ users: [{ name: 'Ada' }] }, '/users/0/name'); // 'Ada'
 ```
 
 Use `~0` for a literal `~` and `~1` for a literal `/` in reference tokens.
+
+## JSON Patch
+
+`applyPatch(document, patch)` applies an [RFC 6902 JSON Patch](https://www.rfc-editor.org/rfc/rfc6902)
+and returns a new document. It supports `add`, `remove`, `replace`, `move`, `copy`, and `test` and
+throws if an operation is malformed or cannot be applied.
+
+```ts
+import { applyPatch } from 'json-toolkit';
+
+applyPatch({ users: ['Ada'] }, [
+  { op: 'add', path: '/users/-', value: 'Grace' },
+]); // { users: ['Ada', 'Grace'] }
+```
