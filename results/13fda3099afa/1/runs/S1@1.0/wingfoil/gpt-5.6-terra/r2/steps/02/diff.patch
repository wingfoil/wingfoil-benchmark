+++ b/test/applyPatch.test.mjs
@@ -0,0 +1,70 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+const { applyPatch } = await import('../dist/index.js');
+
+test('applies all RFC 6902 operations without mutating the document', () => {
+  const document = {
+    foo: ['bar', 'baz'],
+    nested: { value: 1 },
+    source: { copied: true },
+  };
+
+  const result = applyPatch(document, [
+    { op: 'add', path: '/foo/1', value: 'qux' },
+    { op: 'add', path: '/foo/-', value: 'tail' },
+    { op: 'remove', path: '/foo/0' },
+    { op: 'replace', path: '/nested/value', value: 2 },
+    { op: 'move', from: '/foo/0', path: '/foo/2' },
+    { op: 'copy', from: '/source', path: '/duplicate' },
+    { op: 'test', path: '/duplicate', value: { copied: true } },
+  ]);
+
+  assert.deepEqual(result, {
+    foo: ['baz', 'tail', 'qux'],
+    nested: { value: 2 },
+    source: { copied: true },
+    duplicate: { copied: true },
+  });
+  assert.deepEqual(document, {
+    foo: ['bar', 'baz'],
+    nested: { value: 1 },
+    source: { copied: true },
+  });
+  assert.notEqual(result.duplicate, document.source);
+});
+
+test('supports root replacement and escaped object member paths', () => {
+  assert.deepEqual(
+    applyPatch({ 'a/b': { 'm~n': 1 } }, [
+      { op: 'replace', path: '/a~1b/m~0n', value: 2 },
+      { op: 'add', path: '', value: ['root'] },
+    ]),
+    ['root'],
+  );
+});
+
+test('treats __proto__ as an ordinary JSON object member', () => {
+  const result = applyPatch({}, [{ op: 'add', path: '/__proto__', value: { safe: true } }]);
+
+  assert.equal(Object.hasOwn(result, '__proto__'), true);
+  assert.deepEqual(result.__proto__, { safe: true });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
+
+test('rejects malformed patches and failed operations', () => {
+  const document = { array: ['first'], object: { value: true } };
+
+  for (const patch of [
+    [{ op: 'add', path: '/array/2', value: 'nope' }],
+    [{ op: 'remove', path: '' }],
+    [{ op: 'replace', path: '/missing', value: 1 }],
+    [{ op: 'move', from: '/object', path: '/object/child' }],
+    [{ op: 'test', path: '/object/value', value: false }],
+    [{ op: 'copy', path: '/copy' }],
+    [{ op: 'unknown', path: '/value' }],
+    { op: 'add', path: '/value', value: 1 },
+  ]) {
+    assert.throws(() => applyPatch(document, patch));
+  }
+});
