@@ -44,6 +44,100 @@ interface PatchOperation {
   value?: unknown;
 }
 
+type PatchChange =
+  | { op: 'remove'; path: string }
+  | { op: 'add' | 'replace'; path: string; value: unknown };
+
+/**
+ * Creates an RFC 6902 JSON Patch transforming from into to without modifying either input.
+ * Changes descend into objects and arrays; operation values are independent copies.
+ * @throws {Error} If either input is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): PatchChange[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new Error('JSON Patch source and target must be JSON values');
+  }
+  const patch: PatchChange[] = [];
+  diffJson(from, to, '', patch);
+  return patch;
+}
+
+function diffJson(from: unknown, to: unknown, path: string, patch: PatchChange[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(from, to, path, patch);
+  } else if (isJsonObject(from) && isJsonObject(to)) {
+    const sourceKeys = Object.keys(from).sort();
+    const targetKeys = Object.keys(to).sort();
+    for (const key of sourceKeys) {
+      if (!Object.hasOwn(to, key)) patch.push({ op: 'remove', path: childPath(path, key) });
+    }
+    for (const key of sourceKeys) {
+      if (Object.hasOwn(to, key)) diffJson(from[key], to[key], childPath(path, key), patch);
+    }
+    for (const key of targetKeys) {
+      if (!Object.hasOwn(from, key)) {
+        patch.push({ op: 'add', path: childPath(path, key), value: cloneJson(to[key]) });
+      }
+    }
+  } else {
+    patch.push({ op: 'replace', path, value: cloneJson(to) });
+  }
+}
+
+function childPath(path: string, token: string): string {
+  return `${path}/${token.replace(/~/g, '~0').replace(/\//g, '~1')}`;
+}
+
+function diffArray(from: unknown[], to: unknown[], path: string, patch: PatchChange[]): void {
+  // Trim equal runs so a local edit in a large array needs only a small alignment table.
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+  let sourceEnd = from.length;
+  let targetEnd = to.length;
+  while (sourceEnd > start && targetEnd > start && jsonEqual(from[sourceEnd - 1], to[targetEnd - 1])) {
+    sourceEnd--;
+    targetEnd--;
+  }
+  const source = from.slice(start, sourceEnd);
+  const target = to.slice(start, targetEnd);
+  const costs = arrayEditCosts(source, target);
+  let i = 0;
+  let j = 0;
+  while (i < source.length || j < target.length) {
+    // j counts elements already produced, including insertions but excluding removals.
+    const elementPath = childPath(path, String(start + j));
+    if (i < source.length && j < target.length && jsonEqual(source[i], target[j])) {
+      i++;
+      j++;
+    } else if (i < source.length && j < target.length && costs[i][j] === 1 + costs[i + 1][j + 1]) {
+      // Prefer recursive edits on ties, preserving locality inside aligned containers.
+      diffJson(source[i], target[j], elementPath, patch);
+      i++;
+      j++;
+    } else if (i < source.length && costs[i][j] === 1 + costs[i + 1][j]) {
+      patch.push({ op: 'remove', path: elementPath });
+      i++;
+    } else {
+      patch.push({ op: 'add', path: elementPath, value: cloneJson(target[j]) });
+      j++;
+    }
+  }
+}
+
+function arrayEditCosts(from: unknown[], to: unknown[]): Uint32Array[] {
+  const costs = Array.from({ length: from.length + 1 }, () => new Uint32Array(to.length + 1));
+  for (let i = from.length; i >= 0; i--) {
+    for (let j = to.length; j >= 0; j--) {
+      if (i === from.length) costs[i][j] = to.length - j;
+      else if (j === to.length) costs[i][j] = from.length - i;
+      else if (jsonEqual(from[i], to[j])) costs[i][j] = costs[i + 1][j + 1];
+      else costs[i][j] = 1 + Math.min(costs[i + 1][j + 1], costs[i + 1][j], costs[i][j + 1]);
+    }
+  }
+  return costs;
+}
+
