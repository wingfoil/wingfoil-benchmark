+function isJsonArray(value: unknown[]): boolean {
+  const keys = Object.keys(value);
+  return keys.length === value.length &&
+    keys.every((key, index) => key === String(index) && isDataProperty(value, key)) &&
+    Reflect.ownKeys(value).length === keys.length + 1;
