+
+test('rejects JavaScript values that cannot represent JSON documents or JSON values', () => {
+  const sparse = [];
+  sparse.length = 1;
+
+  for (const document of [NaN, Infinity, new Date(), sparse]) {
+    assert.throws(() => applyPatch(document, []));
+  }
+  for (const value of [NaN, Infinity, new Date(), sparse]) {
+    assert.throws(() => applyPatch({}, [{ op: 'add', path: '/value', value }]));
+  }
+});
+
+test('stops at the first failed operation and leaves the caller document unchanged', () => {
+  const document = { value: 1 };
+  const patch = [
+    { op: 'replace', path: '/value', value: 2 },
+    { op: 'test', path: '/value', value: 3 },
+    { op: 'replace', path: '/value', value: 4 },
+  ];
+
+  assert.throws(() => applyPatch(document, patch), /test operation failed/);
+  assert.deepEqual(document, { value: 1 });
+});
