+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document without modifying either input.
+ * @throws {Error} If the target or patch is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonValue(target) || !isJsonValue(patch)) {
+    throw new Error('JSON Merge Patch target and patch must be JSON values');
+  }
+  return mergePatch(target, patch);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonObject(patch)) return cloneJson(patch);
+
+  const result = isJsonObject(target) ? cloneJson(target) as JsonObject : {};
+  for (const key of Object.keys(patch)) {
+    const patchValue = patch[key];
+    if (patchValue === null) {
+      delete result[key];
+    } else {
+      const targetValue = Object.hasOwn(result, key) ? result[key] : undefined;
+      defineMember(result, key, mergePatch(targetValue, patchValue));
+    }
+  }
+  return result;
+}
