diff --git a/tests/merge-patch.test.mjs b/tests/merge-patch.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a7a954c84a71a118aca6e29c75be9f4b24cd55a7
--- /dev/null
+++ b/tests/merge-patch.test.mjs
@@ -0,0 +1,70 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { applyMergePatch } from '../src/index.ts';
+
+test('applies the RFC 7386 section 3 example without mutating either input', () => {
+  const target = {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  };
+  const patch = {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  };
+
+  const result = applyMergePatch(target, patch);
+
+  assert.deepEqual(result, {
+    title: 'Hello!',
+    author: { givenName: 'John' },
+    tags: ['example'],
+    content: 'This will be unchanged',
+    phoneNumber: '+01-123-456-7890',
+  });
+  assert.deepEqual(target, {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  });
+  assert.deepEqual(patch, {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  });
+  assert.notStrictEqual(result, target);
+  assert.notStrictEqual(result.author, target.author);
+  assert.notStrictEqual(result.tags, patch.tags);
+});
+
+test('replaces targets for non-object patches and treats non-object targets as empty objects', () => {
+  assert.deepEqual(applyMergePatch({ value: 1 }, ['replacement']), ['replacement']);
+  assert.equal(applyMergePatch('old', null), null);
+  assert.deepEqual(applyMergePatch(['old'], { added: true }), { added: true });
+});
+
+test('handles null removals, including special property names, and ignores absent members', () => {
+  const target = JSON.parse('{"keep":1,"remove":2,"__proto__":{"old":true}}');
+  const patch = JSON.parse('{"remove":null,"missing":null,"__proto__":{"safe":true}}');
+
+  const result = applyMergePatch(target, patch);
+
+  assert.deepEqual(result, { keep: 1, ['__proto__']: { old: true, safe: true } });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(target, { keep: 1, remove: 2, ['__proto__']: { old: true } });
+});
+
+test('rejects JavaScript values that are not JSON documents', () => {
+  const sparse = [];
+  sparse.length = 1;
+
+  for (const value of [NaN, Infinity, new Date(), sparse]) {
+    assert.throws(() => applyMergePatch(value, {}));
+    assert.throws(() => applyMergePatch({}, value));
+  }
+});
