index 0000000000000000000000000000000000000000..f45eff1f4d5a300d21c6e790270692e4be4aad71
--- /dev/null
+++ b/tests/patch.test.mjs
@@ -0,0 +1,74 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { applyPatch } from '../src/index.ts';
+
+test('applies RFC 6902 section A.1 add operations without mutating the source', () => {
+  const document = { foo: 'bar' };
+  const result = applyPatch(document, [{ op: 'add', path: '/baz', value: 'qux' }]);
+
+  assert.deepEqual(result, { foo: 'bar', baz: 'qux' });
+  assert.deepEqual(document, { foo: 'bar' });
+  assert.notStrictEqual(result, document);
+});
+
+test('supports all operations, including array insertion and append', () => {
+  const document = { foo: ['bar', 'baz'], obj: { source: { nested: true }, old: 1 } };
+  const result = applyPatch(
+    document,
+    [
+      { op: 'add', path: '/foo/1', value: 'qux' },
+      { op: 'add', path: '/foo/-', value: 'last' },
+      { op: 'remove', path: '/obj/old' },
+      { op: 'replace', path: '/foo/0', value: 'new' },
+      { op: 'copy', from: '/obj/source', path: '/copied' },
+      { op: 'move', from: '/foo/2', path: '/foo/0' },
+      { op: 'test', path: '/copied', value: { nested: true } },
+    ],
+  );
+
+  assert.deepEqual(result, {
+    foo: ['baz', 'new', 'qux', 'last'],
+    obj: { source: { nested: true } },
+    copied: { nested: true },
+  });
+  assert.notStrictEqual(result.copied, result.obj.source);
+  assert.deepEqual(document, { foo: ['bar', 'baz'], obj: { source: { nested: true }, old: 1 } });
+});
+
+test('permits root replacement and removal, including an empty patch', () => {
+  assert.deepEqual(applyPatch({ value: 1 }, [{ op: 'replace', path: '', value: [1] }]), [1]);
+  assert.equal(applyPatch({ value: 1 }, [{ op: 'remove', path: '' }]), undefined);
+  const document = { value: 1 };
+  const result = applyPatch(document, []);
+  assert.deepEqual(result, document);
+  assert.notStrictEqual(result, document);
+});
+
+test('rejects invalid patch documents and failing operations', () => {
+  const document = { foo: ['bar'], nested: { value: 1 } };
+  const cases = [
+    null,
+    {},
+    [{ path: '/foo', value: 1 }],
+    [{ op: 'add', path: '/foo/2', value: 'x' }],
+    [{ op: 'remove', path: '/missing' }],
+    [{ op: 'replace', path: '/missing', value: 1 }],
+    [{ op: 'move', from: '/nested', path: '/nested/value/child' }],
+    [{ op: 'copy', from: '/missing', path: '/copy' }],
+    [{ op: 'move', from: '/missing', path: '/missing' }],
+    [{ op: 'test', path: '/nested', value: { value: 2 } }],
+    [{ op: 'unknown', path: '/foo' }],
+    [{ op: 'add', path: 'foo', value: 1 }],
+  ];
+  for (const patch of cases) assert.throws(() => applyPatch(document, patch));
+  assert.deepEqual(document, { foo: ['bar'], nested: { value: 1 } });
+});
+
+test('supports escaped pointer tokens and rejects inherited-member operations', () => {
+  const result = applyPatch(
+    { 'a/b': { 'm~n': 1 } },
+    [{ op: 'replace', path: '/a~1b/m~0n', value: 2 }],
+  );
+  assert.deepEqual(result, { 'a/b': { 'm~n': 2 } });
+  assert.throws(() => applyPatch({}, [{ op: 'replace', path: '/toString', value: 1 }]));
+});
