index d1f98820cc7742cf6e12104616fe080fb1d4ec77..4801e77a4c5937b119bf4b3296b635f6ba241f3a 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -34,3 +34,217 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return value;
 }
+
+type JsonObject = Record<string, unknown>;
+
+interface PatchOperation {
+  op: string;
+  path: string;
+  from?: string;
+  value?: unknown;
+}
+
+/**
+ * Applies an RFC 6902 JSON Patch to a JSON document without modifying the input.
+ * @throws {Error} If the patch is malformed or an operation cannot be applied.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error('JSON Patch must be an array');
+  }
+
+  let result = cloneJson(document);
+  for (const operation of patch) {
+    const parsed = parseOperation(operation);
+    switch (parsed.op) {
+      case 'add':
+        requireValue(parsed);
+        result = add(result, parsed.path, cloneJson(parsed.value));
+        break;
+      case 'remove':
+        result = remove(result, parsed.path);
+        break;
+      case 'replace':
+        requireValue(parsed);
+        result = replace(result, parsed.path, cloneJson(parsed.value));
+        break;
+      case 'move': {
+        const from = requireFrom(parsed);
+        const fromTokens = parsePointer(from);
+        const pathTokens = parsePointer(parsed.path);
+        if (isProperPrefix(fromTokens, pathTokens)) {
+          throw new Error('Cannot move a value into one of its children');
+        }
+        const value = get(result, fromTokens);
+        if (from === parsed.path) break;
+        result = add(remove(result, from), parsed.path, value);
+        break;
+      }
+      case 'copy': {
+        const value = get(result, parsePointer(requireFrom(parsed)));
+        result = add(result, parsed.path, cloneJson(value));
+        break;
+      }
+      case 'test':
+        requireValue(parsed);
+        if (!jsonEqual(get(result, parsePointer(parsed.path)), parsed.value)) {
+          throw new Error('JSON Patch test operation failed');
+        }
+        break;
+      default:
+        throw new Error('Unknown JSON Patch operation');
+    }
+  }
+  return result;
+}
+
+function parseOperation(operation: unknown): PatchOperation {
+  if (operation === null || typeof operation !== 'object' || Array.isArray(operation) ||
+      !Object.hasOwn(operation, 'op') || !Object.hasOwn(operation, 'path') ||
+      typeof (operation as PatchOperation).op !== 'string' ||
+      typeof (operation as PatchOperation).path !== 'string') {
+    throw new Error('Invalid JSON Patch operation');
+  }
+  parsePointer((operation as PatchOperation).path);
+  return operation as PatchOperation;
+}
+
+function requireFrom(operation: PatchOperation): string {
+  if (!Object.hasOwn(operation, 'from') || typeof operation.from !== 'string') {
+    throw new Error('JSON Patch operation requires a string from member');
+  }
+  return operation.from;
+}
+
+function requireValue(operation: PatchOperation): void {
+  if (!Object.hasOwn(operation, 'value') || !isJsonValue(operation.value)) {
+    throw new Error('JSON Patch operation requires a JSON value member');
+  }
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === '') return [];
+  if (!pointer.startsWith('/') || /~(?:[^01]|$)/u.test(pointer)) {
+    throw new Error('Invalid JSON Pointer syntax');
+  }
+  return pointer.slice(1).split('/').map((token) => token.replace(/~1/g, '/').replace(/~0/g, '~'));
+}
+
+function get(document: unknown, tokens: string[]): unknown {
+  let value = document;
+  for (const token of tokens) {
+    value = getMember(value, token);
+  }
+  return value;
+}
+
+function getParent(document: unknown, pointer: string): [unknown, string] {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) throw new Error('JSON Patch path identifies the document root');
+  return [get(document, tokens.slice(0, -1)), tokens[tokens.length - 1]];
+}
+
+function getMember(value: unknown, token: string): unknown {
+  if (Array.isArray(value)) {
+    const index = parseArrayIndex(token, value.length - 1);
+    if (index === undefined || !Object.hasOwn(value, token)) {
+      throw new Error('JSON Patch path does not resolve to an array element');
+    }
+    return value[index];
+  }
+  if (value !== null && typeof value === 'object' && Object.hasOwn(value, token)) {
+    return (value as JsonObject)[token];
+  }
+  throw new Error('JSON Patch path does not resolve to an object member');
+}
+
+function add(document: unknown, path: string, value: unknown): unknown {
+  if (path === '') return value;
+  const [parent, token] = getParent(document, path);
+  if (Array.isArray(parent)) {
+    const index = token === '-' ? parent.length : parseArrayIndex(token, parent.length);
+    if (index === undefined) throw new Error('Invalid JSON Patch array insertion index');
+    parent.splice(index, 0, value);
+  } else if (parent !== null && typeof parent === 'object') {
+    defineMember(parent as JsonObject, token, value);
+  } else {
+    throw new Error('JSON Patch path does not identify a container');
+  }
+  return document;
+}
+
+function remove(document: unknown, path: string): unknown {
+  if (path === '') return undefined;
+  const [parent, token] = getParent(document, path);
+  if (Array.isArray(parent)) {
+    const index = parseArrayIndex(token, parent.length - 1);
+    if (index === undefined || !Object.hasOwn(parent, token)) {
+      throw new Error('JSON Patch path does not resolve to an array element');
+    }
+    parent.splice(index, 1);
+  } else if (parent !== null && typeof parent === 'object' && Object.hasOwn(parent, token)) {
+    delete (parent as JsonObject)[token];
+  } else {
+    throw new Error('JSON Patch path does not resolve to an object member');
+  }
+  return document;
+}
+
+function replace(document: unknown, path: string, value: unknown): unknown {
+  if (path === '') return value;
+  get(document, parsePointer(path));
+  const [parent, token] = getParent(document, path);
+  if (Array.isArray(parent)) parent[Number(token)] = value;
+  else defineMember(parent as JsonObject, token, value);
+  return document;
+}
+
+function parseArrayIndex(token: string, maximum: number): number | undefined {
+  const index = Number(token);
+  return Number.isSafeInteger(index) && index >= 0 && index <= maximum && String(index) === token
+    ? index
+    : undefined;
+}
+
+function isProperPrefix(prefix: string[], value: string[]): boolean {
+  return prefix.length < value.length && prefix.every((token, index) => token === value[index]);
+}
+
+function defineMember(object: JsonObject, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function cloneJson(value: unknown): unknown {
+  if (value === null || typeof value === 'string' || typeof value === 'boolean' || typeof value === 'number') {
+    return value;
+  }
+  if (Array.isArray(value)) return value.map(cloneJson);
+  if (typeof value === 'object') {
+    const copy: JsonObject = {};
+    for (const key of Object.keys(value)) defineMember(copy, key, cloneJson((value as JsonObject)[key]));
+    return copy;
+  }
+  throw new Error('Expected a JSON value');
+}
+
+function isJsonValue(value: unknown): boolean {
+  if (value === null || typeof value === 'string' || typeof value === 'boolean') return true;
+  if (typeof value === 'number') return Number.isFinite(value);
+  if (Array.isArray(value)) return value.every(isJsonValue);
+  if (typeof value === 'object') return Object.values(value).every(isJsonValue);
+  return false;
+}
+
+function jsonEqual(left: unknown, right: unknown): boolean {
+  if (typeof left !== typeof right || left === null || right === null) return left === right;
+  if (typeof left === 'number' || typeof left === 'string' || typeof left === 'boolean') return left === right;
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return Array.isArray(left) && Array.isArray(right) && left.length === right.length &&
+      left.every((value, index) => jsonEqual(value, right[index]));
+  }
+  const leftObject = left as JsonObject;
+  const rightObject = right as JsonObject;
+  const keys = Object.keys(leftObject);
+  return keys.length === Object.keys(rightObject).length &&
+    keys.every((key) => Object.hasOwn(rightObject, key) && jsonEqual(leftObject[key], rightObject[key]));
+}
