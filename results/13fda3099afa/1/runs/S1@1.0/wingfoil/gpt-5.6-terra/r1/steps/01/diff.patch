+++ b/src/index.ts
@@ -0,0 +1,36 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer string against a JSON document.
+ * The empty pointer returns the document itself; returned values are not copied.
+ * @throws {Error} If the pointer is malformed or does not resolve to a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== 'string') {
+    throw new Error('JSON Pointer must be a string');
+  }
+  if (pointer === '') {
+    return document;
+  }
+  if (!pointer.startsWith('/') || /~(?:[^01]|$)/u.test(pointer)) {
+    throw new Error('Invalid JSON Pointer syntax');
+  }
+
+  let value: unknown = document;
+  for (const encodedToken of pointer.slice(1).split('/')) {
+    const token = encodedToken.replace(/~1/g, '/').replace(/~0/g, '~');
+
+    if (Array.isArray(value)) {
+      const index = Number(token);
+      // Round-tripping excludes signs, leading zeroes, whitespace and exponents.
+      if (!Number.isSafeInteger(index) || index < 0 || String(index) !== token ||
+          index >= value.length || !Object.hasOwn(value, token)) {
+        throw new Error('JSON Pointer does not resolve to an array element');
+      }
+      value = value[index];
+    } else if (value !== null && typeof value === 'object' && Object.hasOwn(value, token)) {
+      value = (value as Record<string, unknown>)[token];
+    } else {
+      throw new Error('JSON Pointer does not resolve to an object member');
+    }
+  }
+  return value;
+}
diff --git a/tests/pointer.test.mjs b/tests/pointer.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9c7ab5f0da847cb8b2e126044d767d5431c13161
--- /dev/null
+++ b/tests/pointer.test.mjs
@@ -0,0 +1,83 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { resolvePointer } from '../src/index.ts';
+
+test('resolves the RFC 6901 section 5 examples', () => {
+  const document = {
+    foo: ['bar', 'baz'], '': 0, 'a/b': 1, 'c%d': 2, 'e^f': 3,
+    'g|h': 4, 'i\\j': 5, 'k"l': 6, ' ': 7, 'm~n': 8,
+  };
+  const cases = [
+    ['', document], ['/foo', document.foo], ['/foo/0', 'bar'], ['/', 0],
+    ['/a~1b', 1], ['/c%d', 2], ['/e^f', 3], ['/g|h', 4],
+    ['/i\\j', 5], ['/k"l', 6], ['/ ', 7], ['/m~0n', 8],
+  ];
+  for (const [pointer, expected] of cases) {
+    assert.strictEqual(resolvePointer(document, pointer), expected);
+  }
+});
+
+test('resolves nested values and preserves primitive roots', () => {
+  const document = { rows: [{ active: false, count: 0, name: '', extra: null }] };
+  for (const [key, value] of Object.entries(document.rows[0])) {
+    assert.strictEqual(resolvePointer(document, `/rows/0/${key}`), value);
+  }
+  for (const root of [null, false, 0, '', 'hello']) {
+    assert.strictEqual(resolvePointer(root, ''), root);
+    assert.throws(() => resolvePointer(root, '/value'));
+  }
+});
+
+test('decodes escapes once and compares keys without normalization or URI decoding', () => {
+  const document = {
+    '~1': 1, '/': 2, '~': 3, '': { '': 4 },
+    'é': 5, 'e\u0301': 6, '😀': 7, '\u0000': 8,
+    '%2F': 9, '01': 10, '-': 11,
+  };
+  for (const [pointer, expected] of [
+    ['/~01', 1], ['/~1', 2], ['/~0', 3], ['//', 4],
+    ['/é', 5], ['/e\u0301', 6], ['/😀', 7], ['/\u0000', 8],
+    ['/%2F', 9], ['/01', 10], ['/-', 11],
+  ]) {
+    assert.strictEqual(resolvePointer(document, pointer), expected);
+  }
+});
+
+test('rejects malformed pointer strings and non-string pointers', () => {
+  for (const pointer of ['foo', '#', '#/foo', '/~', '/~2', '/~00~', '/a~b',
+    null, undefined, 0, {}, ['/foo']]) {
+    assert.throws(() => resolvePointer({ foo: 1 }, pointer));
+  }
+});
+
+test('accepts only existing canonical array indices', () => {
+  const document = Array.from({ length: 12 }, (_, index) => index);
+  assert.strictEqual(resolvePointer(document, '/0'), 0);
+  assert.strictEqual(resolvePointer(document, '/11'), 11);
+  for (const token of ['', '-', '00', '01', '-1', '+1', '1.0', '1e0',
+    ' 1', '1 ', '1\n', '12', '999999999999999999999999', 'length', 'map']) {
+    assert.throws(() => resolvePointer(document, `/${token}`));
+  }
+  assert.throws(() => resolvePointer([], '/0'));
+  assert.throws(() => resolvePointer(new Array(1), '/0'));
+});
+
+test('rejects missing members and traversal through primitives', () => {
+  const document = { a: { b: 1 }, array: [null], text: 'abc' };
+  for (const pointer of ['/missing', '/a/missing', '/a/b/c', '/array/0/a', '/text/0']) {
+    assert.throws(() => resolvePointer(document, pointer));
+  }
+});
+
+test('only resolves own object members, including special property names', () => {
+  const document = JSON.parse('{"__proto__":{"value":1},"constructor":2,"toString":3}');
+  assert.strictEqual(resolvePointer(document, '/__proto__/value'), 1);
+  assert.strictEqual(resolvePointer(document, '/constructor'), 2);
+  assert.strictEqual(resolvePointer(document, '/toString'), 3);
+  for (const pointer of ['/__proto__', '/constructor', '/toString']) {
+    assert.throws(() => resolvePointer({}, pointer));
+  }
+  const bare = Object.create(null);
+  bare.value = 4;
+  assert.strictEqual(resolvePointer(bare, '/value'), 4);
+});
