index 0000000000000000000000000000000000000000..a14c2398baddf472806ddc8dc619b1651391c968
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,52 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @param document The document whose value is selected.
+ * @param pointer An RFC 6901 JSON Pointer.
+ * @returns The value selected by `pointer`.
+ * @throws {Error} If the pointer is malformed or does not select a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string" || (pointer !== "" && !pointer.startsWith("/"))) {
+    throw new Error("Invalid JSON Pointer");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+
+  let value = document;
+
+  for (const encodedToken of pointer.slice(1).split("/")) {
+    const token = decodeReferenceToken(encodedToken);
+
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(token) || !Object.hasOwn(value, Number(token))) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+
+      value = value[Number(token)];
+      continue;
+    }
+
+    if (typeof value !== "object" || value === null || !Object.hasOwn(value, token)) {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+
+    value = (value as Record<string, unknown>)[token];
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  if (/~(?:[^01]|$)/.test(token)) {
+    throw new Error("Invalid JSON Pointer escape sequence");
+  }
+
+  return token.replaceAll("~1", "/").replaceAll("~0", "~");
+}
+
+function isArrayIndex(token: string): boolean {
+  return /^(?:0|[1-9][0-9]*)$/.test(token) && Number.isSafeInteger(Number(token));
+}
diff --git a/test/index.test.js b/test/index.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..f637dbba803a755af194f90e87c3f1aaa4001625
--- /dev/null
+++ b/test/index.test.js
@@ -0,0 +1,28 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { resolvePointer } from "../dist/index.js";
+
+const document = {
+  "": "empty-key",
+  a: { b: ["zero", { c: "value" }] },
+  "a/b": "slash",
+  "m~n": "tilde",
+};
+
+test("resolves the whole document and nested object and array values", () => {
+  assert.equal(resolvePointer(document, ""), document);
+  assert.equal(resolvePointer(document, "/a/b/1/c"), "value");
+  assert.equal(resolvePointer(document, "/"), "empty-key");
+});
+
+test("decodes RFC 6901 reference-token escapes", () => {
+  assert.equal(resolvePointer(document, "/a~1b"), "slash");
+  assert.equal(resolvePointer(document, "/m~0n"), "tilde");
+});
+
+test("throws for invalid pointers and targets that do not resolve", () => {
+  for (const pointer of ["a/b", "/m~2n", "/m~", "/a/b/01", "/a/b/-", "/missing"]) {
+    assert.throws(() => resolvePointer(document, pointer));
+  }
+});
