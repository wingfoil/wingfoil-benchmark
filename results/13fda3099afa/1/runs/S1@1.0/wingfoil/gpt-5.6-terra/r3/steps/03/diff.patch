diff --git a/test/index.test.js b/test/index.test.js
index f9e41a9009a68a921370be955d07cd78e2c29f0d..ed334ab455d930aa4b7c29bd16d98baad6343fe4 100644
--- a/test/index.test.js
+++ b/test/index.test.js
@@ -84,3 +84,35 @@ test("rejects malformed patches and failing operations", () => {
     assert.throws(() => applyPatch(document, patch));
   }
 });
+
+test("rejects non-JSON operation objects and inherited required members", () => {
+  const inheritedOperation = Object.create({ op: "add", path: "/value", value: 2 });
+  const inheritedFrom = Object.create({ from: "/value" });
+  inheritedFrom.op = "copy";
+  inheritedFrom.path = "/copy";
+
+  assert.throws(() => applyPatch({ value: 1 }, [inheritedOperation]));
+  assert.throws(() => applyPatch({ value: 1 }, [inheritedFrom]));
+});
+
+test("rejects sparse arrays, which are not JSON values", () => {
+  const sparseArray = new Array(1);
+
+  assert.throws(() => applyPatch(sparseArray, []));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/value", value: sparseArray }]));
+});
+
+test("requires the source of an identity move to exist", () => {
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/missing", path: "/missing" }]));
+});
+
+test("leaves the supplied document unchanged when a later operation fails", () => {
+  const source = { value: 1 };
+
+  assert.throws(() => applyPatch(source, [
+    { op: "replace", path: "/value", value: 2 },
+    { op: "test", path: "/value", value: 3 },
+  ]));
+
+  assert.deepEqual(source, { value: 1 });
+});
