+  const to = { items: [{ name: "Ada", enabled: true }, { name: "Grace", enabled: true }] };
+
+  assert.deepEqual(createPatch(from, to), [
+    { op: "replace", path: "/items/0/enabled", value: true },
+    { op: "add", path: "/items/1", value: { name: "Grace", enabled: true } },
+  ]);
+});
+
+test("creates root replacements, validates JSON input, and keeps patch values independent", () => {
+  assert.deepEqual(createPatch({ old: true }, [1, 2]), [{ op: "replace", path: "", value: [1, 2] }]);
+
+  const from = {};
+  const to = { value: { nested: 2 } };
+  const patch = createPatch(from, to);
