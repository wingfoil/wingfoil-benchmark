+
+test("creates a localized patch for a nested object change", () => {
+  const from = {
+    stable: true,
+    profile: { name: "Ada", preferences: { theme: "light", contrast: "high" } },
+  };
+  const to = {
+    stable: true,
+    profile: { name: "Ada", preferences: { theme: "dark", contrast: "high" } },
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: "replace", path: "/profile/preferences/theme", value: "dark" }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    stable: true,
+    profile: { name: "Ada", preferences: { theme: "light", contrast: "high" } },
+  });
+  assert.deepEqual(to, {
+    stable: true,
+    profile: { name: "Ada", preferences: { theme: "dark", contrast: "high" } },
+  });
+});
+
+test("creates localized array edits and escapes object-member paths", () => {
+  const from = { items: ["Ada", "Linus"], "a/b": { "m~n": 1 } };
+  const to = { items: ["Ada", "Grace", "Linus"], "a/b": { "m~n": 2 } };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "add", path: "/items/1", value: "Grace" },
+    { op: "replace", path: "/a~1b/m~0n", value: 2 },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("keeps a changed array element local when the array also grows", () => {
