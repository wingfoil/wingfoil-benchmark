@@ -106,6 +128,104 @@ function mergePatch(target: JsonValue | undefined, patch: JsonValue): JsonValue
   return result;
 }
 
+function createPatchOperations(from: JsonValue, to: JsonValue, path: string[], patch: PatchOperation[]): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) {
+        patch.push({ op: "remove", path: formatPointer([...path, key]) });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      if (!Object.hasOwn(from, key)) {
+        patch.push({ op: "add", path: formatPointer([...path, key]), value: cloneJson(to[key]) });
+      } else {
+        createPatchOperations(from[key], to[key], [...path, key], patch);
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatchOperations(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: "replace", path: formatPointer(path), value: cloneJson(to) });
+}
+
+function createArrayPatchOperations(
+  from: JsonValue[], to: JsonValue[], path: string[], patch: PatchOperation[],
+): void {
+  const matches = longestCommonSubsequence(from, to);
+  let fromStart = 0;
+  let toStart = 0;
+  let currentIndex = 0;
+
+  for (const [fromMatch, toMatch] of matches) {
+    currentIndex = createArraySegmentPatchOperations(
+      from, to, fromStart, fromMatch, toStart, toMatch, path, currentIndex, patch,
+    );
+    fromStart = fromMatch + 1;
+    toStart = toMatch + 1;
+    currentIndex += 1;
+  }
+
+  createArraySegmentPatchOperations(from, to, fromStart, from.length, toStart, to.length, path, currentIndex, patch);
+}
+
+function createArraySegmentPatchOperations(
+  from: JsonValue[], to: JsonValue[], fromStart: number, fromEnd: number,
+  toStart: number, toEnd: number, path: string[], currentIndex: number, patch: PatchOperation[],
+): number {
+  const fromLength = fromEnd - fromStart;
+  const toLength = toEnd - toStart;
+
+  const sharedLength = Math.min(fromLength, toLength);
+  for (let offset = 0; offset < sharedLength; offset += 1) {
+    createPatchOperations(from[fromStart + offset]!, to[toStart + offset]!, [...path, String(currentIndex + offset)], patch);
+  }
+
+  for (let offset = sharedLength; offset < fromLength; offset += 1) {
+    patch.push({ op: "remove", path: formatPointer([...path, String(currentIndex + sharedLength)]) });
+  }
+  for (let offset = sharedLength; offset < toLength; offset += 1) {
+    patch.push({ op: "add", path: formatPointer([...path, String(currentIndex + offset)]), value: cloneJson(to[toStart + offset]!) });
+  }
+  return currentIndex + toLength;
+}
+
+function longestCommonSubsequence(from: JsonValue[], to: JsonValue[]): Array<[number, number]> {
+  const lengths = Array.from({ length: from.length + 1 }, () => Array<number>(to.length + 1).fill(0));
+
+  for (let fromIndex = from.length - 1; fromIndex >= 0; fromIndex -= 1) {
+    for (let toIndex = to.length - 1; toIndex >= 0; toIndex -= 1) {
+      lengths[fromIndex]![toIndex] = jsonEqual(from[fromIndex]!, to[toIndex]!)
+        ? lengths[fromIndex + 1]![toIndex + 1]! + 1
+        : Math.max(lengths[fromIndex + 1]![toIndex]!, lengths[fromIndex]![toIndex + 1]!);
+    }
+  }
+
+  const matches: Array<[number, number]> = [];
+  let fromIndex = 0;
+  let toIndex = 0;
+  while (fromIndex < from.length && toIndex < to.length) {
+    if (jsonEqual(from[fromIndex]!, to[toIndex]!)) {
+      matches.push([fromIndex, toIndex]);
+      fromIndex += 1;
+      toIndex += 1;
+    } else if (lengths[fromIndex + 1]![toIndex]! >= lengths[fromIndex]![toIndex + 1]!) {
+      fromIndex += 1;
+    } else {
+      toIndex += 1;
+    }
+  }
+  return matches;
+}
