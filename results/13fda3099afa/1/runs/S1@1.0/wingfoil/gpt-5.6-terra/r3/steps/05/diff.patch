+/**
+ * Creates an RFC 6902 JSON Patch that changes one JSON document into another.
+ *
+ * The generated patch targets individual object members and array elements
+ * whenever possible. Neither input is changed, and patch values are cloned so
+ * they do not share mutable containers with either input.
+ *
+ * @param from The JSON document to change.
+ * @param to The desired JSON document.
+ * @returns JSON Patch operations that transform `from` into `to`.
+ * @throws {Error} If either input is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new Error("Invalid JSON document");
+  }
+
+  const patch: PatchOperation[] = [];
+  createPatchOperations(from, to, [], patch);
+  return patch;
+}
+
 /**
