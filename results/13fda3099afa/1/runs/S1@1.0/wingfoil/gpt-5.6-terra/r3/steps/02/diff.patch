--- a/src/index.ts
+++ b/src/index.ts
@@ -39,6 +39,255 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   return value;
 }
 
+type JsonPrimitive = null | boolean | number | string;
+type JsonValue = JsonPrimitive | JsonValue[] | { [key: string]: JsonValue };
+type PatchOperation = Record<string, unknown>;
+
+/**
+ * Applies an RFC 6902 JSON Patch without changing the supplied document.
+ *
+ * @param document The JSON document to update.
+ * @param patch The array of JSON Patch operations to apply in order.
+ * @returns A new JSON document containing the applied changes.
+ * @throws {Error} If either input is invalid or an operation cannot be applied.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!isJsonValue(document)) {
+    throw new Error("Invalid JSON document");
+  }
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch");
+  }
+
+  let result = cloneJson(document);
+  for (const rawOperation of patch) {
+    result = applyOperation(result, rawOperation);
+  }
+  return result;
+}
+
+function applyOperation(document: JsonValue, rawOperation: unknown): JsonValue {
+  if (!isRecord(rawOperation) || typeof rawOperation.op !== "string" || typeof rawOperation.path !== "string") {
+    throw new Error("Invalid JSON Patch operation");
+  }
+
+  const operation = rawOperation as PatchOperation;
+  const op = rawOperation.op;
+  const path = parsePointer(rawOperation.path);
+
+  switch (op) {
+    case "add":
+      return add(document, path, operation);
+    case "remove":
+      return remove(document, path);
+    case "replace":
+      return replace(document, path, operation);
+    case "move":
+      return move(document, path, operation);
+    case "copy":
+      return copy(document, path, operation);
+    case "test":
+      return test(document, path, operation);
+    default:
+      throw new Error(`Unsupported JSON Patch operation: ${op}`);
+  }
+}
+
+function add(document: JsonValue, path: string[], operation: PatchOperation): JsonValue {
+  const value = requiredValue(operation);
+  if (path.length === 0) {
+    return cloneJson(value);
+  }
+
+  const { parent, token } = resolveParent(document, path);
+  if (Array.isArray(parent)) {
+    const index = arrayInsertionIndex(token, parent.length);
+    parent.splice(index, 0, cloneJson(value));
+  } else {
+    defineJsonProperty(parent, token, cloneJson(value));
+  }
+  return document;
+}
+
+function remove(document: JsonValue, path: string[]): JsonValue {
+  if (path.length === 0) {
+    return null;
+  }
+
+  const { parent, token } = resolveParent(document, path);
+  if (Array.isArray(parent)) {
+    parent.splice(existingArrayIndex(token, parent.length), 1);
+  } else if (Object.hasOwn(parent, token)) {
+    delete parent[token];
+  } else {
+    throw new Error("JSON Patch remove target does not exist");
+  }
+  return document;
+}
+
+function replace(document: JsonValue, path: string[], operation: PatchOperation): JsonValue {
+  const value = requiredValue(operation);
+  if (path.length === 0) {
+    return cloneJson(value);
+  }
+
+  const { parent, token } = resolveParent(document, path);
+  if (Array.isArray(parent)) {
+    parent[existingArrayIndex(token, parent.length)] = cloneJson(value);
+  } else if (Object.hasOwn(parent, token)) {
+    defineJsonProperty(parent, token, cloneJson(value));
+  } else {
+    throw new Error("JSON Patch replace target does not exist");
+  }
+  return document;
+}
+
+function move(document: JsonValue, path: string[], operation: PatchOperation): JsonValue {
+  const from = requiredFrom(operation);
+  if (path.length === from.length && path.every((token, index) => token === from[index])) {
+    return document;
+  }
+  if (isProperDescendant(path, from)) {
+    throw new Error("Cannot move a value into one of its children");
+  }
+  const value = getValue(document, from);
+  return add(remove(document, from), path, { value });
+}
+
+function copy(document: JsonValue, path: string[], operation: PatchOperation): JsonValue {
+  return add(document, path, { value: getValue(document, requiredFrom(operation)) });
+}
+
+function test(document: JsonValue, path: string[], operation: PatchOperation): JsonValue {
+  if (!jsonEqual(getValue(document, path), requiredValue(operation))) {
+    throw new Error("JSON Patch test operation failed");
+  }
+  return document;
+}
+
+function requiredValue(operation: PatchOperation): JsonValue {
+  if (!Object.hasOwn(operation, "value") || !isJsonValue(operation.value)) {
+    throw new Error("JSON Patch operation requires a JSON value");
+  }
+  return operation.value;
+}
+
+function requiredFrom(operation: PatchOperation): string[] {
+  if (typeof operation.from !== "string") {
+    throw new Error("JSON Patch move and copy operations require a from path");
+  }
+  return parsePointer(operation.from);
+}
+
+function resolveParent(document: JsonValue, path: string[]): { parent: JsonValue[] | { [key: string]: JsonValue }; token: string } {
+  const token = path.at(-1)!;
+  const parent = getValue(document, path.slice(0, -1));
+  if (Array.isArray(parent) || isJsonObject(parent)) {
+    return { parent, token };
+  }
+  throw new Error("JSON Patch path parent is not a container");
+}
+
+function getValue(document: JsonValue, path: string[]): JsonValue {
+  let value = document;
+  for (const token of path) {
+    if (Array.isArray(value)) {
+      value = value[existingArrayIndex(token, value.length)]!;
+    } else if (isJsonObject(value) && Object.hasOwn(value, token)) {
+      value = value[token];
+    } else {
+      throw new Error("JSON Patch path does not exist");
+    }
+  }
+  return value;
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer !== "" && !pointer.startsWith("/")) {
+    throw new Error("Invalid JSON Pointer");
+  }
+  return pointer === "" ? [] : pointer.slice(1).split("/").map(decodeReferenceToken);
+}
+
+function existingArrayIndex(token: string, length: number): number {
+  if (!isArrayIndex(token) || Number(token) >= length) {
+    throw new Error("JSON Patch array element does not exist");
+  }
+  return Number(token);
+}
+
+function arrayInsertionIndex(token: string, length: number): number {
+  if (token === "-") {
+    return length;
+  }
+  if (!isArrayIndex(token) || Number(token) > length) {
+    throw new Error("Invalid JSON Patch array insertion index");
+  }
+  return Number(token);
+}
+
+function isProperDescendant(path: string[], ancestor: string[]): boolean {
+  return path.length > ancestor.length && ancestor.every((token, index) => path[index] === token);
+}
+
+function jsonEqual(left: JsonValue, right: JsonValue): boolean {
+  if (left === right) {
+    return true;
+  }
+  if (Array.isArray(left) && Array.isArray(right)) {
+    return left.length === right.length && left.every((value, index) => jsonEqual(value, right[index]!));
+  }
+  if (isJsonObject(left) && isJsonObject(right)) {
+    const leftKeys = Object.keys(left);
+    return leftKeys.length === Object.keys(right).length
+      && leftKeys.every((key) => Object.hasOwn(right, key) && jsonEqual(left[key], right[key]));
+  }
+  return false;
+}
+
+function cloneJson(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(cloneJson);
+  }
+  if (isJsonObject(value)) {
+    const clone: { [key: string]: JsonValue } = {};
+    for (const key of Object.keys(value)) {
+      defineJsonProperty(clone, key, cloneJson(value[key]));
+    }
+    return clone;
+  }
+  return value;
+}
+
+function defineJsonProperty(object: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function isJsonValue(value: unknown): value is JsonValue {
+  if (value === null || typeof value === "string" || typeof value === "boolean") {
+    return true;
+  }
+  if (typeof value === "number") {
+    return Number.isFinite(value);
+  }
+  if (Array.isArray(value)) {
+    return value.every(isJsonValue);
+  }
+  return isJsonObject(value) && Object.values(value).every(isJsonValue);
+}
+
+function isJsonObject(value: unknown): value is { [key: string]: JsonValue } {
+  if (!isRecord(value)) {
+    return false;
+  }
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
 function decodeReferenceToken(token: string): string {
   if (/~(?:[^01]|$)/.test(token)) {
     throw new Error("Invalid JSON Pointer escape sequence");
