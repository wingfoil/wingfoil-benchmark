+test("applies add, remove, replace, move, copy, and test operations", () => {
+  const source = {
+    foo: ["bar", "baz"],
+    nested: { copied: false },
+  };
+
+  const result = applyPatch(source, [
+    { op: "add", path: "/foo/1", value: "qux" },
+    { op: "remove", path: "/foo/0" },
+    { op: "replace", path: "/foo/1", value: "boo" },
+    { op: "copy", from: "/nested", path: "/copied" },
+    { op: "move", from: "/foo/0", path: "/foo/-" },
+    { op: "test", path: "/copied", value: { copied: false } },
+  ]);
+
+  assert.deepEqual(result, {
+    foo: ["boo", "qux"],
+    nested: { copied: false },
+    copied: { copied: false },
+  });
+  assert.deepEqual(source, {
+    foo: ["bar", "baz"],
+    nested: { copied: false },
+  });
+  assert.notEqual(result, source);
+});
+
+test("supports document-root and escaped-object-key operations", () => {
+  assert.deepEqual(applyPatch({ old: true }, [{ op: "add", path: "", value: [1, 2] }]), [1, 2]);
+  assert.equal(applyPatch({ old: true }, [{ op: "remove", path: "" }]), null);
+  assert.deepEqual(
+    applyPatch({ "a/b": { "m~n": 1 } }, [
