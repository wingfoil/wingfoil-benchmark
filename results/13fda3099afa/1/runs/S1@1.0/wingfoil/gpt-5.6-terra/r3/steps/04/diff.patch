+/**
+ * Applies an RFC 7386 JSON Merge Patch without changing either input.
+ *
+ * Object patches recursively merge members, with null members deleting keys.
+ * All other patches replace the target, including arrays and root-level null.
+ *
+ * @param target The JSON document to update.
+ * @param patch The JSON Merge Patch document.
+ * @returns A merged JSON document with independently cloned containers.
+ * @throws {Error} If either input is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonValue(target)) {
+    throw new Error("Invalid JSON document");
+  }
+  if (!isJsonValue(patch)) {
+    throw new Error("Invalid JSON Merge Patch");
+  }
+
+  return mergePatch(cloneJson(target), patch);
+}
+
+function mergePatch(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return cloneJson(patch);
+  }
+
+  const result = isJsonObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const previous = Object.hasOwn(result, key) ? result[key] : undefined;
+      defineJsonProperty(result, key, mergePatch(previous, value));
+    }
+  }
+  return result;
+}
