index 0000000000000000000000000000000000000000..c901b3bd12dd305c17dfef20d14090def05bbe6c
--- /dev/null
+++ b/test/merge-patch.test.js
@@ -0,0 +1,89 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyMergePatch } from "../dist/index.js";
+
+// RFC 7386 Appendix A: https://www.rfc-editor.org/rfc/rfc7386#appendix-A
+const examples = [
+  [{ a: "b" }, { a: "c" }, { a: "c" }],
+  [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  [{ a: "b" }, { a: null }, {}],
+  [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+  [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+  [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  [["a", "b"], ["c", "d"], ["c", "d"]],
+  [{ a: "b" }, ["c"], ["c"]],
+  [{ a: "foo" }, null, null],
+  [{ a: "foo" }, "bar", "bar"],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: "b", c: null }, { a: "b" }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+
+for (const [index, [target, patch, expected]] of examples.entries()) {
+  test(`applies RFC 7386 Appendix A example ${index + 1}`, () => {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  });
+}
+
+test("handles every JSON root type and empty object patches", () => {
+  for (const target of [null, false, 0, "text", [1], { kept: null }]) {
+    assert.deepEqual(applyMergePatch(target, {}), target?.kept === null ? { kept: null } : {});
+    assert.deepEqual(applyMergePatch(target, { nested: { removed: null } }),
+      target?.kept === null ? { kept: null, nested: {} } : { nested: {} });
+    for (const patch of [null, false, 0, "", [null, { kept: null }]]) {
+      assert.deepEqual(applyMergePatch(target, patch), patch);
+    }
+  }
+});
+
+test("does not mutate or share mutable containers with either input", () => {
+  const target = { kept: { list: [{ value: 1 }] }, merged: { old: true, removed: true } };
+  const patch = { merged: { removed: null, added: [{ value: 2 }] } };
+  const originalTarget = structuredClone(target);
+  const originalPatch = structuredClone(patch);
+
+  const result = applyMergePatch(target, patch);
+  assert.deepEqual(result, {
+    kept: { list: [{ value: 1 }] }, merged: { old: true, added: [{ value: 2 }] },
+  });
+  result.kept.list[0].value = 3;
+  result.merged.added[0].value = 4;
+  assert.deepEqual(target, originalTarget);
+  assert.deepEqual(patch, originalPatch);
+
+  const replacement = [{ nested: [] }];
+  const replaced = applyMergePatch(target, replacement);
+  replaced[0].nested.push(1);
+  assert.deepEqual(replacement, [{ nested: [] }]);
+});
+
+test("treats prototype-related and escaped names as ordinary own JSON members", () => {
+  const target = JSON.parse('{"__proto__":{"kept":true},"constructor":{"old":true},"a/b":{"~":1},"":1}');
+  const patch = JSON.parse('{"__proto__":{"added":true},"constructor":{"new":true},"toString":{"value":1},"a/b":{"~":null},"":null}');
+  const result = applyMergePatch(target, patch);
+  assert.deepEqual(result, JSON.parse('{"__proto__":{"kept":true,"added":true},"constructor":{"old":true,"new":true},"toString":{"value":1},"a/b":{}}'));
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(applyMergePatch({}, JSON.parse('{"__proto__":{"value":1}}')),
+    JSON.parse('{"__proto__":{"value":1}}'));
+  assert.deepEqual(applyMergePatch(target, JSON.parse('{"__proto__":null}')),
+    { constructor: { old: true }, "a/b": { "~": 1 }, "": 1 });
+});
+
+test("accepts objects with null prototypes", () => {
+  const target = Object.assign(Object.create(null), { kept: 1, removed: true });
+  const patch = Object.assign(Object.create(null), { removed: null, added: 2 });
+  assert.deepEqual(applyMergePatch(target, patch), { kept: 1, added: 2 });
+});
+
+test("rejects non-JSON values in either argument before applying changes", () => {
+  for (const invalid of [undefined, NaN, Infinity, 1n, Symbol("value"), () => {},
+    new Date(0), new Array(1), { nested: undefined }, [undefined], Object.create({ inherited: 1 })]) {
+    assert.throws(() => applyMergePatch(invalid, {}), /Invalid JSON document/);
+    const target = { kept: true };
+    assert.throws(() => applyMergePatch(target, invalid), /Invalid JSON Merge Patch/);
+    assert.deepEqual(target, { kept: true });
+  }
+});
