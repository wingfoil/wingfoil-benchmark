diff --git a/test/index.test.mjs b/test/index.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ca9cc051954db0251dc4fe52fa421b7428851d9c
--- /dev/null
+++ b/test/index.test.mjs
@@ -0,0 +1,44 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyPatch } from "../src/index.ts";
+
+test("validates the complete JSON Patch document", () => {
+  const patch = [{
+    op: "add",
+    path: "/answer",
+    value: 42,
+    ignoredByRfc6902: () => "not JSON",
+  }];
+
+  assert.throws(() => applyPatch({}, patch), /Value is not valid JSON/);
+});
+
+test("does not expose partial changes when an operation fails", () => {
+  const document = { items: ["first"] };
+  const patch = [
+    { op: "add", path: "/items/-", value: "second" },
+    { op: "test", path: "/items/0", value: "not first" },
+  ];
+
+  assert.throws(() => applyPatch(document, patch), /test operation failed/);
+  assert.deepEqual(document, { items: ["first"] });
+  assert.deepEqual(patch, [
+    { op: "add", path: "/items/-", value: "second" },
+    { op: "test", path: "/items/0", value: "not first" },
+  ]);
+});
+
+test("honors RFC 6902 move and array-index rules", () => {
+  assert.deepEqual(
+    applyPatch({ values: ["a", "b", "c"] }, [
+      { op: "move", from: "/values/0", path: "/values/2" },
+    ]),
+    { values: ["b", "c", "a"] },
+  );
+
+  assert.throws(
+    () => applyPatch(["a"], [{ op: "add", path: "/01", value: "b" }]),
+    /array insertion index is invalid/,
+  );
+});
