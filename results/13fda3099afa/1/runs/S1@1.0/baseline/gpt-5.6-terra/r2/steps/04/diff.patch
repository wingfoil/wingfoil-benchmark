+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document.
+ *
+ * Object-valued patches are applied recursively; a null member removes that
+ * member. Any non-object patch replaces the target wholesale. The target and
+ * patch are cloned before use, so neither input is mutated and the result does
+ * not share JSON containers with either input.
+ *
+ * @throws {Error} When either argument is not valid JSON.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return mergePatch(cloneJson(target), cloneJson(patch));
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  // RFC 7386: only an object patch is merged. Arrays, null, and primitive
+  // values replace the target exactly as supplied.
+  if (!isJsonObject(patch)) return patch;
+
+  const result: Record<string, unknown> = isJsonObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setObjectMember(result, key, mergePatch(result[key], value));
+    }
+  }
+  return result;
+}
+
