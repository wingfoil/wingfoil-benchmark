-import { applyPatch } from "../src/index.ts";
+import { applyMergePatch, applyPatch } from "../src/index.ts";
+
+test("applies the RFC 7386 merge-patch example", () => {
+  const target = {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+  assert.deepEqual(target, {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  });
+});
+
+test("replaces non-object targets and patches, without sharing containers", () => {
+  const patch = { nested: { value: true }, removed: null };
+  const result = applyMergePatch(["old"], patch);
+
+  assert.deepEqual(result, { nested: { value: true } });
+  assert.notStrictEqual(result, patch);
+  assert.notStrictEqual(result.nested, patch.nested);
+  assert.deepEqual(applyMergePatch({ value: 1 }, ["replacement"]), ["replacement"]);
+});
+
+test("validates Merge Patch inputs as JSON", () => {
+  assert.throws(() => applyMergePatch({}, { invalid: undefined }), /Value is not valid JSON/);
+});
 
