+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ *
+ * Both inputs must be valid JSON. The inputs are validated and detached before
+ * comparison, and values placed in the returned patch are cloned, so this
+ * function never shares mutable JSON containers with either input.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const source = cloneJson(from);
+  const target = cloneJson(to);
+  const patch: JsonPatchOperation[] = [];
+  diffJson(source, target, [], patch);
+  return patch;
+}
+
+type JsonPatchOperation =
+  | { op: "add"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "replace"; path: string; value: unknown };
+
+function diffJson(
+  from: unknown,
+  to: unknown,
+  path: readonly string[],
+  patch: JsonPatchOperation[],
+): void {
+  if (jsonEqual(from, to)) return;
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) patch.push({ op: "remove", path: formatPointer([...path, key]) });
+    }
+    for (const key of Object.keys(to)) {
+      if (!Object.hasOwn(from, key)) {
+        patch.push({ op: "add", path: formatPointer([...path, key]), value: cloneJson(to[key]) });
+      } else {
+        diffJson(from[key], to[key], [...path, key], patch);
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: "replace", path: formatPointer(path), value: cloneJson(to) });
+}
+
+function diffArray(
+  from: readonly unknown[],
+  to: readonly unknown[],
+  path: readonly string[],
+  patch: JsonPatchOperation[],
+): void {
+  // Exact matches are anchors. This means insertions and removals in the
+  // middle of an array stay small instead of causing every following element
+  // to be replaced. The unmatched spans are compared positionally, allowing
+  // changes inside corresponding object or array elements to remain granular.
+  const anchors = arrayAnchors(from, to);
+  let fromIndex = 0;
+  let toIndex = 0;
+  let currentIndex = 0;
+
+  for (const [nextFrom, nextTo] of [...anchors, [from.length, to.length] as const]) {
+    const shared = Math.min(nextFrom - fromIndex, nextTo - toIndex);
+    for (let offset = 0; offset < shared; offset += 1) {
+      diffJson(from[fromIndex + offset], to[toIndex + offset], [...path, String(currentIndex + offset)], patch);
+    }
+    currentIndex += shared;
+
+    for (let index = fromIndex + shared; index < nextFrom; index += 1) {
+      patch.push({ op: "remove", path: formatPointer([...path, String(currentIndex)]) });
+    }
+    for (let index = toIndex + shared; index < nextTo; index += 1) {
+      patch.push({ op: "add", path: formatPointer([...path, String(currentIndex)]), value: cloneJson(to[index]) });
+      currentIndex += 1;
+    }
+
+    if (nextFrom < from.length) {
+      // The anchored item is already in the working array.
+      currentIndex += 1;
+      fromIndex = nextFrom + 1;
+      toIndex = nextTo + 1;
+    }
+  }
+}
+
+function arrayAnchors(from: readonly unknown[], to: readonly unknown[]): Array<readonly [number, number]> {
+  // Retaining a direction for each cell permits LCS reconstruction while using
+  // only two rows of lengths. For exceptionally large, wholly different
+  // arrays, positional comparison still avoids replacing the entire document.
+  const cells = from.length * to.length;
+  if (cells > 4_000_000) return prefixAndSuffixAnchors(from, to);
+
+  const width = to.length + 1;
+  const directions = new Uint8Array(from.length * to.length);
+  let next = new Uint32Array(width);
+  for (let fromIndex = from.length - 1; fromIndex >= 0; fromIndex -= 1) {
+    const current = new Uint32Array(width);
+    for (let toIndex = to.length - 1; toIndex >= 0; toIndex -= 1) {
+      const cell = fromIndex * to.length + toIndex;
+      if (jsonEqual(from[fromIndex], to[toIndex])) {
+        current[toIndex] = next[toIndex + 1] + 1;
+        directions[cell] = 1;
+      } else if (next[toIndex] >= current[toIndex + 1]) {
+        current[toIndex] = next[toIndex];
+        directions[cell] = 2;
+      } else {
+        current[toIndex] = current[toIndex + 1];
+        directions[cell] = 3;
+      }
+    }
+    next = current;
+  }
+
+  const anchors: Array<readonly [number, number]> = [];
+  let fromIndex = 0;
+  let toIndex = 0;
+  while (fromIndex < from.length && toIndex < to.length) {
+    const direction = directions[fromIndex * to.length + toIndex];
+    if (direction === 1) {
+      anchors.push([fromIndex, toIndex]);
+      fromIndex += 1;
+      toIndex += 1;
+    } else if (direction === 2) {
+      fromIndex += 1;
+    } else {
+      toIndex += 1;
+    }
+  }
+  return anchors;
+}
+
+function prefixAndSuffixAnchors(
+  from: readonly unknown[],
+  to: readonly unknown[],
+): Array<readonly [number, number]> {
+  let prefix = 0;
+  while (prefix < from.length && prefix < to.length && jsonEqual(from[prefix], to[prefix])) prefix += 1;
+
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > prefix && toEnd > prefix && jsonEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd -= 1;
+    toEnd -= 1;
+  }
+
+  const anchors: Array<readonly [number, number]> = [];
+  for (let index = 0; index < prefix; index += 1) anchors.push([index, index]);
+  for (; fromEnd < from.length; fromEnd += 1, toEnd += 1) anchors.push([fromEnd, toEnd]);
+  return anchors;
+}
+
+function formatPointer(tokens: readonly string[]): string {
+  if (tokens.length === 0) return "";
+  return `/${tokens.map((token) => token.replace(/~/g, "~0").replace(/\//g, "~1")).join("/")}`;
+}
+
 function mergePatch(target: unknown, patch: unknown): unknown {
   // RFC 7386: only an object patch is merged. Arrays, null, and primitive
   // values replace the target exactly as supplied.
