+test("creates a granular JSON Patch for nested object changes", () => {
+  const from = {
+    unchanged: { value: true },
+    account: { name: "Ada", settings: { theme: "light", alerts: true } },
+  };
+  const to = {
+    unchanged: { value: true },
+    account: { name: "Ada", settings: { theme: "dark" }, role: "admin" },
+  };
+
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/account/settings/alerts" },
+    { op: "replace", path: "/account/settings/theme", value: "dark" },
+    { op: "add", path: "/account/role", value: "admin" },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    unchanged: { value: true },
+    account: { name: "Ada", settings: { theme: "light", alerts: true } },
+  });
+});
+
+test("creates small array edits and escapes JSON Pointer tokens", () => {
+  const from = { "a/b~c": ["first", "third"] };
+  const to = { "a/b~c": ["first", "second", "third"] };
+
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [{ op: "add", path: "/a~1b~0c/1", value: "second" }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
