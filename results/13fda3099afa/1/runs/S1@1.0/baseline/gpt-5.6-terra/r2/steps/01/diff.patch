+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @throws {Error} When `pointer` is malformed or does not identify a value in
+ * the document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("A JSON Pointer must be a string");
+  }
+
+  // The empty pointer identifies the complete document.
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error("A non-empty JSON Pointer must begin with '/'");
+  }
+
+  let value = document;
+  for (const encodedToken of pointer.slice(1).split("/")) {
+    const token = decodeReferenceToken(encodedToken);
+
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(token) || !Object.hasOwn(value, Number(token))) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+      value = value[Number(token)];
+      continue;
+    }
+
+    if (value === null || typeof value !== "object" || !Object.hasOwn(value, token)) {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+
+    value = (value as Record<string, unknown>)[token];
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  // RFC 6901 permits only ~0 and ~1 as escape sequences. Decode in one pass
+  // so that a sequence such as "~01" correctly becomes "~1", not "/".
+  let decoded = "";
+  for (let index = 0; index < token.length; index += 1) {
+    if (token[index] !== "~") {
+      decoded += token[index];
+      continue;
+    }
+
+    const escape = token[index + 1];
+    if (escape === "0") {
+      decoded += "~";
+    } else if (escape === "1") {
+      decoded += "/";
+    } else {
+      throw new Error("Invalid JSON Pointer escape sequence");
+    }
+    index += 1;
+  }
+  return decoded;
+}
+
+function isArrayIndex(token: string): boolean {
+  // The '-' token is reserved by JSON Patch and does not refer to an array
+  // element in JSON Pointer. Leading zeroes are invalid except for "0".
+  return /^(?:0|[1-9][0-9]*)$/.test(token) && Number(token) < 2 ** 32 - 1;
+}
