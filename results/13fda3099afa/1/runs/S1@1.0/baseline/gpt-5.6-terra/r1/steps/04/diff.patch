+import { applyMergePatch, applyPatch } from "../src/index.ts";
+
+test("applies the RFC 7386 merge patch examples", () => {
+  const cases = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("merge patch leaves both inputs unchanged and safely handles __proto__", () => {
+  const target = { nested: { keep: true, remove: 1 } };
+  const patch = JSON.parse('{"nested":{"remove":null,"added":[1]},"__proto__":{"safe":true}}');
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    nested: { keep: true, added: [1] },
+    ["__proto__"]: { safe: true },
+  });
+  assert.deepEqual(target, { nested: { keep: true, remove: 1 } });
+  assert.deepEqual(patch, JSON.parse('{"nested":{"remove":null,"added":[1]},"__proto__":{"safe":true}}'));
+  assert.equal(Object.prototype.safe, undefined);
+});
+
+test("merge patch accepts only JSON documents", () => {
+  assert.throws(() => applyMergePatch({ a: 1 }, { a: undefined }), /valid JSON document/);
+  assert.throws(() => applyMergePatch({ a: undefined }, {}), /JSON document/);
+});
 
