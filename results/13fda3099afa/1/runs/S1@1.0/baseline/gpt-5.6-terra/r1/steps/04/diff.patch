+/**
+ * Applies an RFC 7386 JSON Merge Patch without changing either input.
+ *
+ * A non-object patch replaces the target entirely.  Within an object patch,
+ * a null member removes that member from an object target; null otherwise has
+ * its usual JSON value semantics when used as the patch document itself.
+ *
+ * @throws {Error} If the target or patch is not a JSON document.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonValue(target)) {
+    throw new Error("A JSON Merge Patch can only be applied to a JSON document");
+  }
+  if (!isJsonValue(patch)) {
+    throw new Error("A JSON Merge Patch must be a valid JSON document");
+  }
+
+  return mergePatch(target, patch);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonObject(patch)) {
+    return cloneJson(patch);
+  }
+
+  // RFC 7386: an object patch applied to any non-object target starts with
+  // an empty object. Arrays are consequently replaced rather than merged.
+  const result: JsonObject = isJsonObject(target) ? cloneJson(target) as JsonObject : {};
+
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setObjectMember(result, key, mergePatch(result[key], value));
+    }
+  }
+
+  return result;
+}
+
