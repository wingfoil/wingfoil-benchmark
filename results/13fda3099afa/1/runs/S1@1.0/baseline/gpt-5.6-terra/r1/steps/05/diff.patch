+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ *
+ * The returned patch uses the smallest affected containers practical for each
+ * change: object members are compared recursively and array elements are
+ * aligned so that insertions and removals do not cause the whole array to be
+ * replaced. Neither input is changed.
+ *
+ * @throws {Error} If either input is not a JSON document.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new Error("A JSON Patch can only be created between JSON documents");
+  }
+
+  const patch: JsonPatchOperation[] = [];
+  createPatchAt(from, to, "", patch);
+  return patch;
+}
