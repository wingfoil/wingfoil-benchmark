-import { applyMergePatch, applyPatch } from "../src/index.ts";
+import { applyMergePatch, applyPatch, createPatch } from "../src/index.ts";
+
+test("creates a focused JSON Patch without changing either source document", () => {
+  const from = {
+    unchanged: { value: true },
+    nested: { before: 1, remove: "old" },
+    items: ["first", { state: "old" }, "last"],
+  };
+  const to = {
+    unchanged: { value: true },
+    nested: { before: 2, added: "new" },
+    items: ["first", { state: "new" }, "inserted", "last"],
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/nested/remove" },
+    { op: "replace", path: "/nested/before", value: 2 },
+    { op: "add", path: "/nested/added", value: "new" },
+    { op: "replace", path: "/items/1/state", value: "new" },
+    { op: "add", path: "/items/2", value: "inserted" },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    unchanged: { value: true },
+    nested: { before: 1, remove: "old" },
+    items: ["first", { state: "old" }, "last"],
+  });
+  assert.deepEqual(to, {
+    unchanged: { value: true },
+    nested: { before: 2, added: "new" },
+    items: ["first", { state: "new" }, "inserted", "last"],
+  });
+});
+
+test("creates valid pointers and preserves shifted array items", () => {
+  const from = { "a/b~c": ["keep", "remove", "also keep"] };
+  const to = { "a/b~c": ["keep", "also keep", "added"] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/a~1b~0c/1" },
+    { op: "add", path: "/a~1b~0c/2", value: "added" },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("creates an empty patch for equal JSON and rejects non-JSON inputs", () => {
+  assert.deepEqual(createPatch({ value: [1] }, { value: [1] }), []);
+  assert.throws(() => createPatch({ value: undefined }, {}), /JSON documents/);
+  assert.throws(() => createPatch({}, { value: undefined }), /JSON documents/);
+});
 
