diff --git a/test/index.test.mjs b/test/index.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..bd566437cdd9a60784ca216ec51c689b6ea46ad5
--- /dev/null
+++ b/test/index.test.mjs
@@ -0,0 +1,54 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyPatch } from "../src/index.ts";
+
+test("a move to the same valid location is a no-op", () => {
+  const document = { foo: 1 };
+
+  assert.deepEqual(
+    applyPatch(document, [{ op: "move", from: "/foo", path: "/foo" }]),
+    document,
+  );
+});
+
+test("a same-location move still requires an existing source", () => {
+  assert.throws(
+    () => applyPatch({}, [{ op: "move", from: "/missing", path: "/missing" }]),
+    /JSON Pointer does not resolve/,
+  );
+});
+
+test("a same-location move still requires valid JSON Pointers", () => {
+  assert.throws(
+    () => applyPatch({}, [{ op: "move", from: "missing", path: "missing" }]),
+    /JSON Pointer/,
+  );
+});
+
+test("replace overwrites an array element without inserting one", () => {
+  assert.deepEqual(
+    applyPatch(["foo"], [{ op: "replace", path: "/0", value: "bar" }]),
+    ["bar"],
+  );
+});
+
+test("the whole patch, including ignored members, must be JSON", () => {
+  assert.throws(
+    () => applyPatch({}, [{ op: "add", path: "/a", value: 1, ignored: undefined }]),
+    /valid JSON array/,
+  );
+});
+
+test("a failed patch leaves its input document unchanged", () => {
+  const document = { value: 1 };
+
+  assert.throws(
+    () => applyPatch(document, [
+      { op: "replace", path: "/value", value: 2 },
+      { op: "test", path: "/value", value: 3 },
+    ]),
+    /test operation failed/,
+  );
+  assert.deepEqual(document, { value: 1 });
+});
