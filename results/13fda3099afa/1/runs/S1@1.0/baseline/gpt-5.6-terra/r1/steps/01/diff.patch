+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @throws {Error} If `pointer` is not a valid JSON Pointer or it does not
+ * refer to a value in `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("A JSON Pointer must be a string");
+  }
+
+  // The empty string identifies the complete document.
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error("A non-empty JSON Pointer must start with '/'");
+  }
+
+  let value = document;
+
+  for (const token of pointer.slice(1).split("/")) {
+    const referenceToken = decodeReferenceToken(token);
+
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(referenceToken) || !hasArrayElement(value, referenceToken)) {
+        throw new Error(`JSON Pointer does not resolve at token ${JSON.stringify(referenceToken)}`);
+      }
+
+      value = value[Number(referenceToken)];
+      continue;
+    }
+
+    if (value === null || typeof value !== "object" || !Object.hasOwn(value, referenceToken)) {
+      throw new Error(`JSON Pointer does not resolve at token ${JSON.stringify(referenceToken)}`);
+    }
+
+    value = (value as Record<string, unknown>)[referenceToken];
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  let decoded = "";
+
+  for (let index = 0; index < token.length; index += 1) {
+    const character = token[index];
+
+    if (character !== "~") {
+      decoded += character;
+      continue;
+    }
+
+    const escape = token[index + 1];
+    if (escape === "0") {
+      decoded += "~";
+    } else if (escape === "1") {
+      decoded += "/";
+    } else {
+      throw new Error(`Invalid JSON Pointer escape in token ${JSON.stringify(token)}`);
+    }
+
+    index += 1;
+  }
+
+  return decoded;
+}
+
+function isArrayIndex(token: string): boolean {
+  return token === "0" || /^[1-9][0-9]*$/.test(token);
+}
+
+function hasArrayElement(array: unknown[], index: string): boolean {
+  // RFC 6901 prohibits leading zeroes. Comparing decimal strings also avoids
+  // precision loss for an arbitrarily long, out-of-range array index.
+  const length = String(array.length);
+  if (index.length > length.length || (index.length === length.length && index >= length)) {
+    return false;
+  }
+
+  return Object.hasOwn(array, Number(index));
+}
