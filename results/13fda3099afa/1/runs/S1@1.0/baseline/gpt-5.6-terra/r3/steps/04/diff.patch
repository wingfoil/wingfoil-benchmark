+/**
+ * Applies an RFC 7386 JSON Merge Patch without changing either supplied
+ * document. Object-valued patches merge recursively; every other patch value
+ * replaces the target value. Within an object-valued patch, `null` removes a
+ * member (if present).
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  // Work with copies so merging never exposes or changes either caller-owned
+  // JSON document. This also gives Merge Patch the same JSON-value validation
+  // guarantees as JSON Patch.
+  const targetDocument = cloneJson(target, "target JSON document");
+  const patchDocument = cloneJson(patch, "JSON Merge Patch document");
+
+  return mergePatch(targetDocument, patchDocument);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonObject(patch)) {
+    // Arrays are deliberately not merged element-by-element: RFC 7386 treats
+    // them like all other non-object patch values.
+    return patch;
+  }
+
+  const result: Record<string, unknown> = isJsonObject(target) ? target : {};
+
+  for (const [key, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[key];
+    } else {
+      setObjectMember(result, key, mergePatch(result[key], value));
+    }
+  }
+
+  return result;
+}
+
 const removedDocument = Symbol("removed JSON document");
 
