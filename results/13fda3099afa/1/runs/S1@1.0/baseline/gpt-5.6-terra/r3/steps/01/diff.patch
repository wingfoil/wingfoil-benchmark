@@ -0,0 +1,73 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * The empty pointer denotes the document itself. Every other pointer must
+ * begin with `/`; its reference tokens use `~0` for `~` and `~1` for `/`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("JSON Pointer must be a string");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error("Invalid JSON Pointer: non-empty pointers must start with '/'");
+  }
+
+  let current: unknown = document;
+
+  for (const encodedToken of pointer.slice(1).split("/")) {
+    const token = decodeReferenceToken(encodedToken);
+
+    if (Array.isArray(current)) {
+      if (!isArrayIndex(token) || Number(token) >= current.length) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+      current = current[Number(token)];
+    } else if (isJsonObject(current)) {
+      if (!Object.hasOwn(current, token)) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+      current = current[token];
+    } else {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+  }
+
+  return current;
+}
+
+function decodeReferenceToken(token: string): string {
+  let result = "";
+
+  for (let index = 0; index < token.length; index += 1) {
+    const character = token[index];
+    if (character !== "~") {
+      result += character;
+      continue;
+    }
+
+    const escape = token[index + 1];
+    if (escape === "0") {
+      result += "~";
+    } else if (escape === "1") {
+      result += "/";
+    } else {
+      throw new Error("Invalid JSON Pointer: '~' must be followed by '0' or '1'");
+    }
+    index += 1;
+  }
+
+  return result;
+}
+
+function isArrayIndex(token: string): boolean {
+  return /^(?:0|[1-9][0-9]*)$/.test(token);
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
