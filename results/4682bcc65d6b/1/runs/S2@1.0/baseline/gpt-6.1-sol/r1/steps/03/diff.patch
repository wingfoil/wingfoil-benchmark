   });
+
+  it('returns a single-use welcome code on cancellation and tracks its replacement order', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'WELCOME', kind: 'fixed', value: 100, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const request = { customer: 'paolo', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'welcome' };
+    const first = orders.place(request);
+    assert.equal(coupons.usedBy('WELCOME'), first.id);
+    assert.throws(() => orders.place(request), CouponError);
+
+    orders.cancel(first.id, request.date);
+    assert.equal(coupons.usedBy('WELCOME'), undefined);
+
+    const corrected = orders.place({ ...request, coupon: 'WELCOME' });
+    assert.equal(corrected.totals.couponDiscountCents, 100);
+    assert.equal(coupons.usedBy('welcome'), corrected.id);
+    assert.throws(() => orders.place(request), CouponError);
+  });
 });
