diff --git a/test/reports.test.ts b/test/reports.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..98b3fbfa3bcd59bb3565d7e014506924bcb088a0
--- /dev/null
+++ b/test/reports.test.ts
@@ -0,0 +1,62 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createShop } from '../src/index.ts';
+import { lineVat } from '../src/tax.ts';
+
+describe('reported order issues', () => {
+  it('looks up and orders mixed-case, padded SKUs under their canonical code', () => {
+    const { catalog, inventory, orders } = createShop();
+    const product = catalog.add({ sku: 'LB-220', name: 'Lamp', priceCents: 199, vatClass: 'standard', weightGrams: 100 });
+    inventory.restock('LB-220', 5);
+    assert.equal(catalog.find(' lb-220 '), product);
+    assert.equal(catalog.get('Lb-220'), product);
+    const request = {
+      customer: 'c-1', date: '2026-10-25',
+      lines: [{ sku: 'lb-220', quantity: 1 }, { sku: ' LB-220 ', quantity: 2 }],
+    };
+    const quote = orders.quote(request);
+    const order = orders.place(request);
+    assert.deepEqual(order.lines, quote.lines);
+    assert.equal(order.lines.length, 1);
+    assert.equal(order.lines[0]?.sku, 'LB-220');
+    assert.equal(order.lines[0]?.quantity, 3);
+    assert.equal(inventory.available('LB-220'), 2);
+  });
+
+  for (const [goods, shipping, shippingVat] of [[4999, 490, 108], [5000, 0, 0], [5001, 0, 0]]) {
+    it(`charges ${shipping} cents shipping on ${goods} cents of goods after discounts`, () => {
+      const { catalog, inventory, coupons, orders } = createShop();
+      catalog.add({ sku: 'BOX', name: 'Box', priceCents: 6000, vatClass: 'standard', weightGrams: 100 });
+      inventory.restock('BOX', 1);
+      coupons.add({ code: 'SAVE', kind: 'fixed', value: 6000 - goods, validFrom: '2026-01-01', validUntil: '2026-12-31' });
+      const order = orders.place({ customer: 'c-1', date: '2026-10-25', lines: [{ sku: 'BOX', quantity: 1 }], coupon: 'SAVE' });
+      assert.equal(order.totals.goodsCents, goods);
+      assert.equal(order.totals.shippingCents, shipping);
+      assert.equal(order.totals.shippingVatCents, shippingVat);
+    });
+  }
+
+  it('rounds VAT half up for every class, including exact half cents', () => {
+    assert.equal(lineVat(199, 'standard'), 44);
+    assert.equal(lineVat(102, 'standard'), 22);
+    assert.equal(lineVat(25, 'standard'), 6);
+    assert.equal(lineVat(5, 'reduced'), 1);
+    assert.equal(lineVat(12, 'super-reduced'), 0);
+    assert.equal(lineVat(13, 'super-reduced'), 1);
+    assert.equal(lineVat(199, 'exempt'), 0);
+  });
+
+  it('rounds each discounted line before summing VAT and the order total', () => {
+    const { catalog, inventory, coupons, orders } = createShop();
+    for (const sku of ['ITEM-A', 'ITEM-B']) {
+      catalog.add({ sku, name: sku, priceCents: 200, vatClass: 'standard', weightGrams: 100 });
+      inventory.restock(sku, 1);
+    }
+    coupons.add({ code: 'SAVE', kind: 'fixed', value: 2, validFrom: '2026-01-01', validUntil: '2026-12-31' });
+    const order = orders.place({ customer: 'c-1', date: '2026-10-25', lines: [{ sku: 'ITEM-A', quantity: 1 }, { sku: 'ITEM-B', quantity: 1 }], coupon: 'SAVE' });
+    assert.deepEqual(order.lines.map((line) => [line.netCents, line.vatCents]), [[199, 44], [199, 44]]);
+    assert.equal(order.totals.vatCents, 88);
+    assert.equal(order.totals.totalCents, 398 + 490 + 88 + 108);
+  });
+});
