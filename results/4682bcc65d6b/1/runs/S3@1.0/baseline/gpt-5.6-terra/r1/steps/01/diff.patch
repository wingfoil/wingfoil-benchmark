+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** The rental price for one whole day, in euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+export interface Booking extends RentalQuote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): RentalQuote;
+  book(request: RentalRequest): Booking;
+}
+
+interface StoredBooking extends Booking {
+  startTime: number;
+  endTime: number;
+}
+
+const MIDNIGHT_UTC = /^(\d{4,})-(\d{2})-(\d{2})T00:00:00(?:\.000)?Z$/;
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1000;
+
+/**
+ * Creates an in-memory service for the school's board and sail rentals.
+ */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookingsByItem = new Map<string, StoredBooking[]>();
+  let nextBookingNumber = 1;
+
+  function getEquipment(itemId: unknown): Equipment {
+    if (typeof itemId !== 'string') {
+      throw new Error('Rental itemId must be a string.');
+    }
+
+    const item = equipment.get(itemId);
+    if (!item) {
+      throw new Error(`Unknown equipment: "${itemId}".`);
+    }
+    return item;
+  }
+
+  function addEquipment(item: Equipment): void {
+    validateEquipment(item);
+
+    if (equipment.has(item.id)) {
+      throw new Error(`Equipment with id "${item.id}" already exists.`);
+    }
+
+    equipment.set(item.id, { ...item });
+    bookingsByItem.set(item.id, []);
+  }
+
+  function quote(request: RentalRequest): RentalQuote {
+    const period = validatePeriod(request);
+    const item = getEquipment(request.itemId);
+    const total = item.dailyPrice * period.days;
+
+    if (!Number.isSafeInteger(total)) {
+      throw new Error('Rental total must be a safe integer number of euro cents.');
+    }
+
+    return {
+      itemId: request.itemId,
+      start: request.start,
+      end: request.end,
+      total,
+    };
+  }
+
+  function book(request: RentalRequest): Booking {
+    const rentalQuote = quote(request);
+    const period = validatePeriod(request);
+    const itemBookings = bookingsByItem.get(request.itemId)!;
+
+    if (itemBookings.some((booking) => periodsOverlap(period.startTime, period.endTime, booking))) {
+      throw new Error(`Equipment "${request.itemId}" is not available for this period.`);
+    }
+
+    const booking: StoredBooking = {
+      id: `booking-${nextBookingNumber++}`,
+      ...rentalQuote,
+      startTime: period.startTime,
+      endTime: period.endTime,
+    };
+    itemBookings.push(booking);
+
+    return toBooking(booking);
+  }
+
+  return { addEquipment, quote, book };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (!item || typeof item.id !== 'string' || item.id.length === 0) {
+    throw new Error('Equipment id must be a non-empty string.');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error('Equipment kind must be "board" or "sail".');
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('Equipment dailyPrice must be a non-negative integer number of euro cents.');
+  }
+}
+
+function validatePeriod(request: RentalRequest): {
+  startTime: number;
+  endTime: number;
+  days: number;
+} {
+  if (!request || typeof request.start !== 'string' || typeof request.end !== 'string') {
+    throw new Error('Rental start and end must be ISO-8601 strings.');
+  }
+
+  const startTime = parseMidnightUtc(request.start, 'start');
+  const endTime = parseMidnightUtc(request.end, 'end');
+
+  if (endTime <= startTime) {
+    throw new Error('Rental end must be after its start.');
+  }
+
+  return { startTime, endTime, days: (endTime - startTime) / DAY_IN_MILLISECONDS };
+}
+
+function parseMidnightUtc(value: string, name: 'start' | 'end'): number {
+  const match = MIDNIGHT_UTC.exec(value);
+  if (!match) {
+    throw new Error(`Rental ${name} must be at midnight UTC.`);
+  }
+
+  const timestamp = Date.parse(value);
+  if (!Number.isFinite(timestamp) || new Date(timestamp).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`Rental ${name} must be a valid ISO-8601 date.`);
+  }
+  return timestamp;
+}
+
+function periodsOverlap(
+  startTime: number,
+  endTime: number,
+  booking: StoredBooking,
+): boolean {
+  return startTime < booking.endTime && booking.startTime < endTime;
+}
+
+function toBooking(booking: StoredBooking): Booking {
+  const { startTime: _startTime, endTime: _endTime, ...publicBooking } = booking;
+  return publicBooking;
+}
