diff --git a/test/rental.test.mjs b/test/rental.test.mjs
index 2f7d1a864b88138ed036f101988b01898e9fd2e5..88c6f541a1d6c787abf6870402f3ba79316d7fbb 100644
--- a/test/rental.test.mjs
+++ b/test/rental.test.mjs
@@ -10,6 +10,72 @@ function setup() {
   return service;
 }
 
+test('cancellation refunds the booked total at or before the 24-hour cutoff', () => {
+  for (const at of ['2026-05-29T12:34:56.789Z', '2026-05-31T00:00:00+00:00']) {
+    const service = setup();
+    const booking = service.book(request('2026-06-01T00:00:00Z', '2026-06-04T00:00:00Z'));
+    assert.equal(booking.total, 6750);
+    booking.total = 1;
+    booking.start = '2026-07-01T00:00:00Z';
+    assert.deepEqual(service.cancel(booking.id, at), { bookingId: booking.id, refund: 6750 });
+  }
+});
+
+test('late cancellations refund zero and all cancellations release equipment only once', () => {
+  for (const at of ['2026-05-31T00:00:00.001Z', '2026-05-31T23:59:59Z',
+    '2026-06-01T00:00:00Z', '2026-06-05T00:00:00Z']) {
+    const service = setup();
+    const booking = service.book(request());
+    const sail = service.book(request(undefined, undefined, 'sail'));
+    assert.deepEqual(service.availability(request()), []);
+    assert.deepEqual(service.cancel(booking.id, at), { bookingId: booking.id, refund: 0 });
+    assert.deepEqual(service.availability(request()), ['board']);
+    const replacement = service.book(request());
+    assert.notEqual(replacement.id, booking.id);
+    assert.throws(() => service.cancel(booking.id, '2026-05-01T00:00:00Z'));
+    assert.deepEqual(service.availability(request()), []);
+    assert.throws(() => service.book(request()));
+    assert.deepEqual(service.cancel(sail.id, '2026-05-01T00:00:00Z'), {
+      bookingId: sail.id, refund: 2400,
+    });
+  }
+});
+
+test('hourly cancellation uses the same exact 24-hour cutoff', () => {
+  for (const [at, refund] of [
+    ['2026-05-31T13:00+00:00', 1400],
+    ['2026-05-31T13:00:00.001Z', 0],
+  ]) {
+    const service = createRentalService();
+    service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 2500, hourlyPrice: 700 });
+    const input = request('2026-06-01T13:00:00Z', '2026-06-01T15:00:00Z');
+    const booking = service.book(input);
+    assert.deepEqual(service.cancel(booking.id, at), { bookingId: booking.id, refund });
+    assert.deepEqual(service.availability(input), ['board']);
+    assert.doesNotThrow(() => service.book(input));
+  }
+});
+
+test('invalid cancellation attempts leave reservations intact', () => {
+  const service = setup();
+  const booking = service.book(request());
+  const at = '2026-05-01T00:00:00Z';
+  for (const id of ['missing', '', undefined, null, 1]) {
+    assert.throws(() => service.cancel(id, at));
+  }
+  assert.throws(() => setup().cancel(booking.id, at));
+  for (const invalid of ['invalid', '2026-02-30T12:30:00Z', '2026-05-01',
+    '2026-05-01T12:30:00', '2026-05-01T12:30:00+01:00',
+    '2026-05-01T24:00:00Z', '2026-05-01T12:60:00Z', '2026-05-01T12:30:60Z',
+    undefined, null, 0]) {
+    assert.throws(() => service.cancel(booking.id, invalid));
+    assert.deepEqual(service.availability(request()), ['sail']);
+    assert.throws(() => service.book(request()));
+  }
+  assert.deepEqual(service.cancel(booking.id, at), { bookingId: booking.id, refund: 5000 });
+  assert.throws(() => service.cancel(booking.id, at));
+});
+
