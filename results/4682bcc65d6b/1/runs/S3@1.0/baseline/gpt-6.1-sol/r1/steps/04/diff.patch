-    throw new Error('Rental times must be valid ISO-8601 midnights in UTC');
+    throw new Error('Rental times must be valid ISO-8601 whole hours in UTC');
   }
   return value;
 }
 
+function period(startTimestamp: string, endTimestamp: string) {
+  const start = hour(startTimestamp);
+  const end = hour(endTimestamp);
+  if (end <= start) throw new Error('Rental end must be after its start');
+  const hourly = end - start < DAY_MS;
+  if (!hourly && (start % DAY_MS !== 0 || end % DAY_MS !== 0)) {
+    throw new Error('Rentals of a day or more must start and end at midnight in UTC');
+  }
+  return { start, end, hourly };
+}
