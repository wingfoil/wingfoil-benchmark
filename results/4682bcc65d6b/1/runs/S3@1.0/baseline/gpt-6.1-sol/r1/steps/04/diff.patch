+
+test('hourly quotes and bookings charge each hour, including across midnight', () => {
+  for (const [start, end, total] of [
+    ['2026-06-01T13:00:00Z', '2026-06-01T17:00:00Z', 2800],
+    ['2026-06-01T23:00+00:00', '2026-06-02T02:00:00.000Z', 2100],
+    ['2026-06-01T00:00:00Z', '2026-06-01T23:00:00Z', 16100],
+  ]) {
+    const service = createRentalService();
+    service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 2500, hourlyPrice: 700 });
+    const input = request(start, end);
+    assert.deepEqual(service.quote(input), { ...input, total });
+    assert.equal(service.book(input).total, total);
+    assert.equal(service.quote(input).total, total);
+  }
+});
+
+test('hourly prices are optional, validated, copied, and checked for safe totals', () => {
+  const service = setup();
+  const input = request('2026-06-01T13:00:00Z', '2026-06-01T15:00:00Z');
+  assert.throws(() => service.quote(input));
+  assert.throws(() => service.book(input));
+  for (const hourlyPrice of [-1, 1.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 1, null, '100']) {
+    assert.throws(() => service.addEquipment({ id: 'bad', kind: 'board', dailyPrice: 1, hourlyPrice }));
+  }
+  const item = { id: 'free', kind: 'sail', dailyPrice: 100, hourlyPrice: 0 };
+  service.addEquipment(item);
+  item.hourlyPrice = 100;
+  assert.equal(service.book({ ...input, itemId: 'free' }).total, 0);
+  service.addEquipment({ id: 'expensive', kind: 'board', dailyPrice: 1, hourlyPrice: Number.MAX_SAFE_INTEGER });
+  assert.equal(service.quote({ ...input, itemId: 'expensive', end: '2026-06-01T14:00:00Z' }).total, Number.MAX_SAFE_INTEGER);
+  assert.throws(() => service.quote({ ...input, itemId: 'expensive' }));
+  assert.throws(() => service.book({ ...input, itemId: 'expensive' }));
+});
+
+test('hourly rentals preserve daily pricing and reject unsupported periods', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 2500, hourlyPrice: 700 });
+  assert.equal(service.quote(request('2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z')).total, 2500);
+  assert.equal(service.quote(request('2026-06-01T00:00:00Z', '2026-06-04T00:00:00Z')).total, 6750);
+  for (const [start, end] of [
+    ['2026-06-01T13:30:00Z', '2026-06-01T15:00:00Z'],
+    ['2026-06-01T13:00:01Z', '2026-06-01T15:00:00Z'],
+    ['2026-06-01T13:00:00Z', '2026-06-01T15:00:00.001Z'],
+    ['2026-06-01T13:00:00+01:00', '2026-06-01T15:00:00Z'],
+    ['2026-02-30T13:00:00Z', '2026-03-01T15:00:00Z'],
+    ['2026-06-01T24:00:00Z', '2026-06-02T01:00:00Z'],
+    ['2026-06-01T13:00:00Z', '2026-06-01T13:00:00Z'],
+    ['2026-06-01T15:00:00Z', '2026-06-01T13:00:00Z'],
+    ['2026-06-01T13:00:00Z', '2026-06-02T13:00:00Z'],
+    ['2026-06-01T00:00:00Z', '2026-06-02T01:00:00Z'],
+  ]) {
+    for (const operation of [service.quote, service.book]) {
+      assert.throws(() => operation(request(start, end)));
+    }
+    assert.throws(() => service.availability({ start, end }));
+  }
+});
+
+test('hourly availability and conflicts share daily booking boundaries', () => {
+  const service = setup();
+  service.addEquipment({ id: 'hourly', kind: 'board', dailyPrice: 2500, hourlyPrice: 700 });
+  const input = request('2026-06-01T13:00:00Z', '2026-06-01T16:00:00Z', 'hourly');
+  assert.deepEqual(service.availability(input), ['hourly']);
+  assert.deepEqual(service.availability({ ...input, kind: 'sail' }), []);
+  service.book(input);
+  for (const [start, end] of [[13, 16], [14, 15], [12, 17], [12, 14], [15, 17]]) {
+    const overlap = request(`2026-06-01T${start}:00:00Z`, `2026-06-01T${end}:00:00Z`, 'hourly');
+    assert.throws(() => service.book(overlap));
+    assert.deepEqual(service.availability(overlap), []);
+  }
+  assert.throws(() => service.book(request(undefined, undefined, 'hourly')));
+  assert.deepEqual(service.availability(request()), ['board', 'sail']);
+  service.book(request('2026-06-01T12:00:00Z', input.start, 'hourly'));
+  service.book(request(input.end, '2026-06-02T00:00:00Z', 'hourly'));
+  service.book(request('2026-06-02T00:00:00Z', '2026-06-03T00:00:00Z', 'hourly'));
+  const blocked = request('2026-06-02T10:00:00Z', '2026-06-02T11:00:00Z', 'hourly');
+  assert.throws(() => service.book(blocked));
+  assert.deepEqual(service.availability(blocked), []);
+});
