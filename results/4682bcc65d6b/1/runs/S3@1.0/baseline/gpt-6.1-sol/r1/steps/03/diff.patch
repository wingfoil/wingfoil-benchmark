+test('quotes and bookings discount the full price for rentals of at least three days', () => {
+  for (const [days, boardTotal, sailTotal] of [
+    [1, 2500, 1200], [2, 5000, 2400], [3, 6750, 3240], [4, 9000, 4320],
+  ]) {
+    const service = setup();
+    for (const [itemId, total] of [['board', boardTotal], ['sail', sailTotal]]) {
+      const input = request('2026-06-01T00:00:00Z', `2026-06-0${days + 1}T00:00:00Z`, itemId);
+      assert.deepEqual(service.quote(input), { ...input, total });
+      const booking = service.book(input);
+      assert.deepEqual(booking, { id: booking.id, ...input, total });
+    }
+  }
+});
+
+test('discounts round the full total to cents and preserve precision for large prices', () => {
+  for (const [dailyPrice, total] of [
+    [0, 0], [101, 273], [102, 275], [105, 284],
+    [3002399751580330, 8106479329266891],
+  ]) {
+    const service = createRentalService();
+    service.addEquipment({ id: 'board', kind: 'board', dailyPrice });
+    const input = request('2026-06-01T00:00:00Z', '2026-06-04T00:00:00Z');
+    assert.equal(service.quote(input).total, total);
+    assert.equal(service.book(input).total, total);
+  }
+});
+
