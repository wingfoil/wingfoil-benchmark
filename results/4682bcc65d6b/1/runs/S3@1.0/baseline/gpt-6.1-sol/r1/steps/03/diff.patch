     const start = midnight(request.start);
     const end = midnight(request.end);
     if (end <= start) throw new Error('Rental end must be after its start');
-    const total = ((end - start) / DAY_MS) * item.dailyPrice;
-    if (!Number.isSafeInteger(total)) throw new Error('Rental total exceeds safe integer cents');
+    const days = (end - start) / DAY_MS;
+    const fullPrice = days * item.dailyPrice;
+    if (!Number.isSafeInteger(fullPrice)) throw new Error('Rental total exceeds safe integer cents');
+    // Round the discounted full price to cents, with half cents rounded up.
+    // Integer arithmetic keeps rounding exact even for large safe totals.
+    const total = days >= 3 ? Number((BigInt(fullPrice) * 9n + 5n) / 10n) : fullPrice;
     return { itemId: request.itemId, start: request.start, end: request.end, total };
   }
 
