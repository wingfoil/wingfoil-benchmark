diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ea3f44db894985b95446ef0f225569209450239d
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,96 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+import type { Result } from '../src/index.ts';
+
+function valueOf<T>(result: Result<T>): T {
+  if (!result.ok) assert.fail(result.error.message);
+  return result.value;
+}
+
+describe('bulk import', () => {
+  it('imports priorities, empty fields, trimmed titles and space-separated tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, [
+      ' Renew the insurance ; high ; admin  money admin ',
+      'Buy milk;;',
+      'Read;low; leisure\tbooks ',
+      'Call;normal;work',
+    ].join('\n'));
+
+    assert.deepEqual(result, { imported: 4, rejected: [] });
+    const insurance = valueOf(list.find('Renew the insurance'));
+    assert.equal(insurance.priority, 'high');
+    assert.deepEqual(insurance.tags, ['admin', 'money']);
+    assert.equal(insurance.status, 'open');
+    assert.equal(insurance.id, 'task-1');
+    assert.equal(insurance.createdAt, insurance.updatedAt);
+    assert.ok(Number.isFinite(Date.parse(insurance.createdAt)));
+    const milk = valueOf(list.find('Buy milk'));
+    assert.equal(milk.priority, 'normal');
+    assert.deepEqual(milk.tags, []);
+    assert.equal(valueOf(list.find('Read')).priority, 'low');
+    assert.deepEqual(valueOf(list.find('Read')).tags, ['leisure', 'books']);
+    assert.equal(valueOf(list.find('Call')).priority, 'normal');
+  });
+
+  it('reports every failure in line order and imports later valid lines', (t) => {
+    t.mock.timers.enable({ apis: ['Date'], now: 1_000 });
+    const list = createTodoList();
+    const existing = valueOf(list.add({ title: 'Existing' }));
+    t.mock.timers.tick(60_000);
+
+    const result = importTasks(list, [
+      '',
+      ' Existing ;;',
+      'First;high;home',
+      'First;low;',
+      ' ;normal;',
+      `${'x'.repeat(121)};;`,
+      'Bad priority;urgent;',
+      'Missing fields',
+      'Extra;normal;tag;field',
+      '   ',
+      'Last;;',
+    ].join('\n'));
+
+    assert.deepEqual(result, {
+      imported: 2,
+      rejected: [
+        { line: 2, reason: 'there is already a task "Existing"' },
+        { line: 4, reason: 'there is already a task "First"' },
+        { line: 5, reason: 'title must not be empty or only whitespace' },
+        { line: 6, reason: 'title must be at most 120 characters' },
+        { line: 7, reason: 'priority must be low, normal or high' },
+        { line: 8, reason: 'expected title;priority;tags (three fields)' },
+        { line: 9, reason: 'expected title;priority;tags (three fields)' },
+      ],
+    });
+    assert.strictEqual(valueOf(list.get(existing.id)), existing);
+    assert.equal(list.openCount(), 3);
+    assert.equal(valueOf(list.find('First')).id, 'task-2');
+    assert.equal(valueOf(list.find('Last')).id, 'task-3');
+  });
+
+  it('skips empty input and whitespace-only lines without changing the list', () => {
+    const list = createTodoList();
+    const existing = valueOf(list.add({ title: 'Existing' }));
+    for (const text of ['', '\n\r\n \t\r\n']) {
+      assert.deepEqual(importTasks(list, text), { imported: 0, rejected: [] });
+      assert.deepEqual(list.list(), [existing]);
+    }
+    assert.equal(valueOf(list.add({ title: 'Next' })).id, 'task-2');
+  });
+
+  for (const newline of ['\n', '\r\n', '\r']) {
+    it(`counts physical lines with ${JSON.stringify(newline)} line endings`, () => {
+      const list = createTodoList();
+      assert.deepEqual(importTasks(list, ['First;;', '', 'invalid', 'Last;;', ''].join(newline)), {
+        imported: 2,
+        rejected: [{ line: 3, reason: 'expected title;priority;tags (three fields)' }],
+      });
+      assert.equal(list.openCount(), 2);
+    });
+  }
+});
