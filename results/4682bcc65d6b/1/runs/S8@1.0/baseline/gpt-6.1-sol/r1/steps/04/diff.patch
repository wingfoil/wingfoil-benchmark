+++ b/src/domain/import.ts
@@ -0,0 +1,46 @@
+import type { TaskList } from './list.ts';
+import { PRIORITIES } from './task.ts';
+
+/** A line that could not be imported, with its one-based position in the input. */
+export interface ImportRejection {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The tasks added and the lines rejected by a bulk import. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
+/** Import title;priority;tags lines in order, skipping blank lines and reporting each failure. */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: ImportRejection[] = [];
+
+  for (const [index, line] of text.split(/\r\n|\n|\r/u).entries()) {
+    if (line.trim() === '') continue;
+    const fields = line.split(';').map((field) => field.trim());
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'expected title;priority;tags (three fields)' });
+      continue;
+    }
+
+    const [title, priorityText, tagsText] = fields;
+    const priority = PRIORITIES.find((value) => value === priorityText);
+    if (priorityText !== '' && priority === undefined) {
+      rejected.push({ line: index + 1, reason: 'priority must be low, normal or high' });
+      continue;
+    }
+
+    const result = list.add({
+      title,
+      priority,
+      tags: tagsText === '' ? [] : tagsText.split(/\s+/u),
+    });
+    if (result.ok) imported++;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  }
+
+  return { imported, rejected };
+}
