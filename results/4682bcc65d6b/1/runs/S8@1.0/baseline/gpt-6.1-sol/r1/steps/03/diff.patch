diff --git a/src/domain/task.ts b/src/domain/task.ts
index 67c0eb2d4d08118ca8b9e6f5392b1f9c5ed663c9..3b229cb2b1305d82aeddb181e3b02a4be4efe4ba 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -30,6 +30,35 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/** Validate a title using the same trimming as task creation and renaming. */
+export function validateTitle(title: string): Result<void> {
+  const trimmed = title.trim();
+  if (trimmed.length === 0) return err('validation', 'title must not be empty or only whitespace');
+  if (trimmed.length > 120) return err('validation', 'title must be at most 120 characters');
+  return ok(undefined);
+}
+
+/** Tags are nonempty words without whitespace. */
+export function validateTag(tag: string): Result<void> {
+  if (tag.length === 0) return err('validation', 'tag must not be empty');
+  if (/\s/u.test(tag)) return err('validation', 'tag must not contain spaces or other whitespace');
+  return ok(undefined);
+}
+
+/** Check every field before a new task is created. */
+export function validateNewTask(input: NewTask): Result<void> {
+  const title = validateTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined && !PRIORITIES.includes(input.priority)) {
+    return err('validation', 'priority must be low, normal or high');
+  }
+  for (const tag of input.tags ?? []) {
+    const validated = validateTag(tag);
+    if (!validated.ok) return validated;
+  }
+  return ok(undefined);
+}
+
