diff --git a/test/validation.test.ts b/test/validation.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..243d6b4745710ec7ac397cbc74307ff4c2f0172a
--- /dev/null
+++ b/test/validation.test.ts
@@ -0,0 +1,93 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, summarize } from '../src/index.ts';
+import type { NewTask, Priority, Result } from '../src/index.ts';
+
+function valueOf<T>(result: Result<T>): T {
+  if (!result.ok) assert.fail(result.error.message);
+  return result.value;
+}
+
+function validationError(result: Result<unknown>, message: RegExp): void {
+  assert.equal(result.ok, false);
+  if (!result.ok) {
+    assert.equal(result.error.code, 'validation');
+    assert.match(result.error.message, message);
+  }
+}
+
+describe('input validation', () => {
+  const invalidTitles = ['', '   ', '\t\n', 'x'.repeat(121)];
+  const invalidTags = ['', ' ', 'two words', ' leading', 'trailing ', 'a\tb', 'a\nb'];
+
+  for (const title of invalidTitles) {
+    it(`rejects adding or renaming to ${JSON.stringify(title)} without changing the list`, (t) => {
+      t.mock.timers.enable({ apis: ['Date'], now: 1_000 });
+      const list = createTodoList();
+      const original = valueOf(list.add({ title: 'Original', tags: ['home'] }));
+      const other = valueOf(list.add({ title: 'Other' }));
+      const before = list.list();
+      t.mock.timers.tick(60_000);
+
+      validationError(list.add({ title }), /title.*(empty|120)/i);
+      for (const reference of [original.id, original.title]) {
+        validationError(list.rename(reference, title), /title.*(empty|120)/i);
+      }
+      assert.deepEqual(list.list(), before);
+      assert.strictEqual(valueOf(list.get(original.id)), original);
+      assert.strictEqual(valueOf(list.find(original.title)), original);
+      assert.strictEqual(valueOf(list.get(other.id)), other);
+      assert.equal(list.openCount(), 2);
+      assert.equal(valueOf(list.add({ title: 'Next' })).id, 'task-3');
+    });
+  }
+
+  for (const tag of invalidTags) {
+    it(`rejects adding or tagging with ${JSON.stringify(tag)} atomically`, (t) => {
+      t.mock.timers.enable({ apis: ['Date'], now: 1_000 });
+      const list = createTodoList();
+      const original = valueOf(list.add({ title: 'Original', tags: ['home'] }));
+      const before = list.list();
+      const summary = summarize(before);
+      t.mock.timers.tick(60_000);
+
+      validationError(list.add({ title: 'New', tags: ['valid', tag] }), /tag.*(empty|space)/i);
+      for (const reference of [original.id, original.title]) {
+        validationError(list.tag(reference, tag), /tag.*(empty|space)/i);
+      }
+      assert.deepEqual(list.list(), before);
+      assert.strictEqual(valueOf(list.get(original.id)), original);
+      assert.strictEqual(valueOf(list.find(original.title)), original);
+      assert.deepEqual(summarize(list.list()), summary);
+      assert.equal(valueOf(list.add({ title: 'Next' })).id, 'task-2');
+    });
+  }
+
+  it('rejects unsupported priorities at runtime without changing the list', () => {
+    const list = createTodoList();
+    const original = valueOf(list.add({ title: 'Original' }));
+    for (const priority of ['', 'urgent', 'HIGH', ' normal ', null, 1]) {
+      const input: NewTask = { title: 'New', priority: priority as Priority };
+      validationError(list.add(input), /priority.*low.*normal.*high/i);
+      assert.deepEqual(list.list(), [original]);
+      assert.strictEqual(valueOf(list.get(original.id)), original);
+    }
+    assert.equal(valueOf(list.add({ title: 'Next' })).id, 'task-2');
+  });
+
+  it('accepts boundary titles, supported priorities and valid tags', () => {
+    const list = createTodoList();
+    for (const priority of ['low', 'normal', 'high'] as const) {
+      const task = valueOf(list.add({ title: priority, priority, tags: ['home', 'a-b', 'home'] }));
+      assert.equal(task.priority, priority);
+      assert.deepEqual(task.tags, ['home', 'a-b']);
+    }
+    const title = 'x'.repeat(120);
+    const task = valueOf(list.add({ title: ` ${title} ` }));
+    assert.equal(task.title, title);
+    const renamed = valueOf(list.rename(task.id, ` ${'y'.repeat(120)} `));
+    assert.equal(renamed.title, 'y'.repeat(120));
+    assert.deepEqual(valueOf(list.tag(task.id, 'work')).tags, ['work']);
+  });
+});
