+
+/** The outcome of importing task rows from a semicolon-separated text block. */
+export interface ImportTasksResult {
+  readonly imported: number;
+  readonly rejected: readonly { readonly line: number; readonly reason: string }[];
+}
+
+/**
+ * Add tasks described one per line as `title;priority;tags`.
+ * Empty priorities use the normal priority, and tags are separated by spaces.
+ *
+ * @param list - the list to add tasks to
+ * @param text - task rows to import
+ */
+export function importTasks(list: TaskList, text: string): ImportTasksResult {
+  let imported = 0;
+  const rejected: { line: number; reason: string }[] = [];
+
+  text.split(/\r?\n/).forEach((row, index) => {
+    if (row.trim().length === 0) return;
+
+    const fields = row.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'line must contain title, priority and tags separated by semicolons' });
+      return;
+    }
+
+    const [title, rawPriority, rawTags] = fields;
+    const priority = rawPriority.trim();
+    const result = list.add({
+      title,
+      ...(priority.length === 0 ? {} : { priority: priority as Priority }),
+      tags: rawTags.trim().length === 0 ? [] : rawTags.trim().split(/\s+/),
+    });
+
+    if (result.ok) imported++;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  });
+
+  return { imported, rejected };
+}
