+
+/** Checks the fields accepted when a task is added, without changing the list. */
+function validateNewTask(input: NewTask): Result<void> {
+  const titleValidation = validateTitle(input.title);
+  if (!titleValidation.ok) return titleValidation;
+
+  if (input.priority !== undefined && !PRIORITIES.includes(input.priority)) {
+    return err('invalid-input', 'priority must be low, normal, or high');
+  }
+
+  for (const tag of input.tags ?? []) {
+    const tagValidation = validateTag(tag);
+    if (!tagValidation.ok) return tagValidation;
+  }
+  return ok(undefined);
+}
+
+/** A title is stored trimmed, and must be present and at most 120 characters long. */
+function validateTitle(title: string): Result<void> {
+  const trimmed = title.trim();
+  if (trimmed.length === 0) return err('invalid-input', 'title must not be empty');
+  if (trimmed.length > 120) return err('invalid-input', 'title must be 120 characters or fewer');
+  return ok(undefined);
+}
+
+/** Tags are literal labels: empty labels and labels containing spaces are not allowed. */
+function validateTag(tag: string): Result<void> {
+  if (tag.length === 0) return err('invalid-input', 'tag must not be empty');
+  if (tag.includes(' ')) return err('invalid-input', 'tag must not contain spaces');
+  return ok(undefined);
+}
