 export type { TaskFilter, TaskList } from './domain/list.ts';
 export type { Result, TodoError, TodoErrorCode } from './domain/result.ts';
@@ -14,3 +15,54 @@ export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 export function createTodoList(): TaskList {
   return createTaskList();
 }
+
+/** A line from a bulk import that could not be added to the task list. */
+export interface RejectedTaskImport {
+  /** The one-based line number in the imported text. */
+  readonly line: number;
+  /** Why this line could not be imported. */
+  readonly reason: string;
+}
+
+/** The outcome of importing tasks from text. */
+export interface TaskImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedTaskImport[];
+}
+
+/**
+ * Adds the valid `title;priority;tags` lines in text to a task list.
+ *
+ * Empty priority fields use the normal priority, and tags are separated by
+ * whitespace. Blank lines are ignored.
+ */
+export function importTasks(list: TaskList, text: string): TaskImportResult {
+  let imported = 0;
+  const rejected: RejectedTaskImport[] = [];
+
+  for (const [index, line] of text.split(/\r?\n/).entries()) {
+    if (line.trim().length === 0) continue;
+
+    const fields = line.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'line must use title;priority;tags format' });
+      continue;
+    }
+
+    const [title, priorityField, tagsField] = fields;
+    const priority = priorityField.trim();
+    const result = list.add({
+      title,
+      ...(priority === '' ? {} : { priority: priority as Priority }),
+      tags: tagsField.trim() === '' ? [] : tagsField.trim().split(/\s+/),
+    });
+
+    if (result.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line: index + 1, reason: result.error.message });
+    }
+  }
+
+  return { imported, rejected };
+}
