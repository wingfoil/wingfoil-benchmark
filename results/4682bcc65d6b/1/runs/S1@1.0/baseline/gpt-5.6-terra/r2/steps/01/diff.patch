+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @throws {Error} when `pointer` is not a JSON Pointer or does not identify a
+ * value in `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("A JSON Pointer must be a string");
+  }
+
+  // The empty string is the pointer to the document itself.
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error("Invalid JSON Pointer: it must be empty or start with '/'");
+  }
+
+  let value = document;
+
+  for (const encodedToken of pointer.slice(1).split("/")) {
+    const token = decodeReferenceToken(encodedToken);
+
+    if (Array.isArray(value)) {
+      // RFC 6901 permits only the canonical decimal form of an array index.
+      // "-" is meaningful to JSON Patch, but does not identify an array value.
+      if (!/^(?:0|[1-9][0-9]*)$/.test(token) || !hasOwn(value, token)) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+
+      value = value[Number(token)];
+      continue;
+    }
+
+    if (value === null || typeof value !== "object" || !hasOwn(value, token)) {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+
+    value = (value as Record<string, unknown>)[token];
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  let decoded = "";
+
+  for (let index = 0; index < token.length; index += 1) {
+    const character = token[index];
+
+    if (character !== "~") {
+      decoded += character;
+      continue;
+    }
+
+    const escape = token[index + 1];
+    if (escape === "0") {
+      decoded += "~";
+    } else if (escape === "1") {
+      decoded += "/";
+    } else {
+      throw new Error("Invalid JSON Pointer escape sequence");
+    }
+
+    index += 1;
+  }
+
+  return decoded;
+}
+
+function hasOwn(value: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(value, key);
+}
