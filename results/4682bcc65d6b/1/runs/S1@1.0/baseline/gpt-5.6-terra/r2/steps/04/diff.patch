+/**
+ * Applies an RFC 7386 JSON Merge Patch without mutating the source document.
+ *
+ * Object-valued patches are merged recursively. A `null` member deletes the
+ * corresponding object member; every other non-object patch replaces its
+ * target value (including arrays, which are never merged element-by-element).
+ *
+ * @throws {Error} when `target` or `patch` is not a valid JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  const jsonTarget = cloneJsonValue(target, "target JSON document");
+  const jsonPatch = cloneJsonValue(patch, "JSON Merge Patch");
+  return mergePatch(jsonTarget, jsonPatch);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return patch;
+  }
+
+  const result: Record<string, unknown> = isObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      defineJsonProperty(result, key, mergePatch(result[key], value));
+    }
+  }
+  return result;
+}
+
