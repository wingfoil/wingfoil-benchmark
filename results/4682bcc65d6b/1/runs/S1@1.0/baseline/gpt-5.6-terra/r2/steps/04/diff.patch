 import assert from "node:assert/strict";
 import test from "node:test";
 
-import { applyPatch } from "../src/index.ts";
+import { applyMergePatch, applyPatch } from "../src/index.ts";
+
+test("applies the RFC 7386 merge-patch example without mutating the target", () => {
+  const target = {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+  assert.deepEqual(target, {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  });
+});
+
+test("merge patch replaces non-object targets and can replace a document with null", () => {
+  assert.deepEqual(applyMergePatch([1, 2], { enabled: true }), { enabled: true });
+  assert.equal(applyMergePatch({ value: true }, null), null);
+});
+
+test("merge patch handles prototype-like JSON member names as data", () => {
+  assert.deepEqual(
+    applyMergePatch({}, JSON.parse('{"__proto__":{"value":1}}')),
+    JSON.parse('{"__proto__":{"value":1}}'),
+  );
+});
+
+test("merge patch rejects non-JSON inputs", () => {
+  assert.throws(() => applyMergePatch({ value: undefined }, {}), /not a valid JSON value/);
+  assert.throws(() => applyMergePatch({}, { value: Number.NaN }), /not a valid JSON value/);
+});
 
