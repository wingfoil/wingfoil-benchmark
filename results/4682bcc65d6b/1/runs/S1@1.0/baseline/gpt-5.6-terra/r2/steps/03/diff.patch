diff --git a/test/applyPatch.test.js b/test/applyPatch.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..4489c01b9bde349ff514a80b30534cd167e19b7c
--- /dev/null
+++ b/test/applyPatch.test.js
@@ -0,0 +1,43 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyPatch } from "../src/index.ts";
+
+test("valid but unrecognised operation members are ignored", () => {
+  assert.deepEqual(
+    applyPatch({ value: 1 }, [{
+      op: "test",
+      path: "/value",
+      value: 1,
+      extension: { enabled: true },
+    }]),
+    { value: 1 },
+  );
+});
+
+test("a patch must be JSON even when invalid data is in an ignored member", () => {
+  assert.throws(() => applyPatch({}, [{
+    op: "add",
+    path: "/value",
+    value: true,
+    extension: undefined,
+  }]));
+});
+
+test("a cyclic patch fails normally instead of overflowing the stack", () => {
+  const operation = { op: "add", path: "/value", value: true };
+  operation.extension = operation;
+
+  assert.throws(() => applyPatch({}, [operation]), /not a valid JSON value/);
+});
+
+test("a failed operation does not mutate its source document", () => {
+  const document = { value: 1 };
+
+  assert.throws(() => applyPatch(document, [
+    { op: "replace", path: "/value", value: 2 },
+    { op: "test", path: "/value", value: 3 },
+  ]));
+
+  assert.deepEqual(document, { value: 1 });
+});
