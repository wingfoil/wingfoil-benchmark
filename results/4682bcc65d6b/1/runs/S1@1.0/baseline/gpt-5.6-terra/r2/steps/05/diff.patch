-import { applyMergePatch, applyPatch } from "../src/index.ts";
+import { applyMergePatch, applyPatch, createPatch } from "../src/index.ts";
+
+test("creates a small patch for a nested change without mutating its inputs", () => {
+  const from = {
+    profile: { name: "Ada", preferences: { theme: "light", notices: true } },
+    roles: ["reader", "editor"],
+  };
+  const to = {
+    profile: { name: "Ada", preferences: { theme: "dark", notices: true } },
+    roles: ["reader", "editor"],
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: "replace", path: "/profile/preferences/theme", value: "dark" }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    profile: { name: "Ada", preferences: { theme: "light", notices: true } },
+    roles: ["reader", "editor"],
+  });
+  assert.deepEqual(to, {
+    profile: { name: "Ada", preferences: { theme: "dark", notices: true } },
+    roles: ["reader", "editor"],
+  });
+});
+
+test("creates granular object and array changes with escaped JSON Pointer tokens", () => {
+  const from = { "a/b": [1, 3], obsolete: true };
+  const to = { "a/b": [1, 2, 3], "~key": { enabled: true } };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/obsolete" },
+    { op: "add", path: "/a~1b/1", value: 2 },
+    { op: "add", path: "/~0key", value: { enabled: true } },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("creates a root replacement and rejects non-JSON source documents", () => {
+  assert.deepEqual(createPatch({ value: true }, ["replacement"]), [
+    { op: "replace", path: "", value: ["replacement"] },
+  ]);
+  assert.throws(() => createPatch({ value: undefined }, {}), /not a valid JSON value/);
+});
 
