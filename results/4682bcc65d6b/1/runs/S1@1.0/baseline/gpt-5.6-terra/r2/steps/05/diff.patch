+function diffJsonValue(
+  source: unknown,
+  target: unknown,
+  path: string,
+  patch: Record<string, unknown>[],
+): void {
+  if (jsonEquals(source, target)) {
+    return;
+  }
+
+  if (Array.isArray(source) && Array.isArray(target)) {
+    diffArray(source, target, path, patch);
+    return;
+  }
+
+  if (isObject(source) && isObject(target)) {
+    diffObject(source, target, path, patch);
+    return;
+  }
+
+  patch.push({ op: "replace", path, value: target });
+}
+
+function diffObject(
+  source: Record<string, unknown>,
+  target: Record<string, unknown>,
+  path: string,
+  patch: Record<string, unknown>[],
+): void {
+  // Removing first means that additions and replacements can use their final
+  // paths, even for object members such as "__proto__".
+  for (const key of Object.keys(source)) {
+    if (!hasOwn(target, key)) {
+      patch.push({ op: "remove", path: childPointer(path, key) });
+    }
+  }
+
+  for (const key of Object.keys(target)) {
+    const memberPath = childPointer(path, key);
+    if (!hasOwn(source, key)) {
+      patch.push({ op: "add", path: memberPath, value: target[key] });
+    } else {
+      diffJsonValue(source[key], target[key], memberPath, patch);
+    }
+  }
+}
+
+function diffArray(
+  source: unknown[],
+  target: unknown[],
+  path: string,
+  patch: Record<string, unknown>[],
+): void {
+  // Keep equal runs at either end intact. This produces concise add/remove
+  // operations for the common case of an insertion or deletion in an array.
+  let prefixLength = 0;
+  while (
+    prefixLength < source.length
+    && prefixLength < target.length
+    && jsonEquals(source[prefixLength], target[prefixLength])
+  ) {
+    prefixLength += 1;
+  }
+
+  let suffixLength = 0;
+  while (
+    suffixLength < source.length - prefixLength
+    && suffixLength < target.length - prefixLength
+    && jsonEquals(source[source.length - 1 - suffixLength], target[target.length - 1 - suffixLength])
+  ) {
+    suffixLength += 1;
+  }
+
+  const sourceMiddleLength = source.length - prefixLength - suffixLength;
+  const targetMiddleLength = target.length - prefixLength - suffixLength;
+  const sharedLength = Math.min(sourceMiddleLength, targetMiddleLength);
+
+  // Match positions inside the changed run so a small edit inside an array
+  // element is still represented as a small patch.
+  for (let offset = 0; offset < sharedLength; offset += 1) {
+    const index = prefixLength + offset;
+    diffJsonValue(source[index], target[index], childPointer(path, String(index)), patch);
+  }
+
+  // Remove from the end to avoid changing the indexes of remaining entries.
+  for (let index = sourceMiddleLength - 1; index >= sharedLength; index -= 1) {
+    patch.push({ op: "remove", path: childPointer(path, String(prefixLength + index)) });
+  }
+
+  // After removals, appending each remaining target entry at this point keeps
+  // the untouched suffix in place.
+  for (let index = sharedLength; index < targetMiddleLength; index += 1) {
+    patch.push({
+      op: "add",
+      path: childPointer(path, String(prefixLength + index)),
+      value: target[prefixLength + index],
+    });
+  }
+}
