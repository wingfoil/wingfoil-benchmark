+/**
+ * Applies an RFC 7386 JSON Merge Patch without modifying either supplied
+ * value.
+ *
+ * @param target The JSON document to patch.
+ * @param patch The JSON Merge Patch document.
+ * @returns A new JSON value containing the merged document.
+ * @throws {TypeError} If `target` or `patch` is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonValue(target)) {
+    throw new TypeError("A JSON Merge Patch target must be a JSON value");
+  }
+  if (!isJsonValue(patch)) {
+    throw new TypeError("A JSON Merge Patch must be a JSON value");
+  }
+
+  return mergePatch(cloneJson(target), patch);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  // Per RFC 7386, a non-object patch replaces its target in its entirety.
+  if (!isJsonObject(patch)) {
+    return cloneJson(patch);
+  }
+
+  // Applying an object patch to anything other than an object starts with an
+  // empty object. Arrays are values, rather than objects, for Merge Patch.
+  const result = isJsonObject(target) ? target : {};
+
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = hasOwn(result, key) ? result[key] : undefined;
+      setMember(result, key, mergePatch(current, value));
+    }
+  }
+
+  return result;
+}
