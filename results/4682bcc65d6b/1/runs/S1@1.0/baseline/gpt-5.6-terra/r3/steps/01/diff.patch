+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @param document The document to resolve the pointer within.
+ * @param pointer An RFC 6901 JSON Pointer.
+ * @throws {TypeError} If `pointer` is not a JSON Pointer string.
+ * @throws {Error} If the pointer does not identify a value in `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new TypeError("A JSON Pointer must be a string");
+  }
+
+  // The empty string identifies the whole document. Every other JSON Pointer
+  // consists of slash-prefixed reference tokens (including empty tokens).
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new TypeError("A non-empty JSON Pointer must start with '/'");
+  }
+
+  let current: unknown = document;
+
+  for (const encodedToken of pointer.slice(1).split("/")) {
+    // RFC 6901 specifies this order: decode ~1 before ~0. Other tilde
+    // sequences are not valid escape sequences.
+    if (/(?:~[^01]|~$)/.test(encodedToken)) {
+      throw new TypeError(`Invalid JSON Pointer escape sequence in ${JSON.stringify(encodedToken)}`);
+    }
+
+    const token = encodedToken.replace(/~1/g, "/").replace(/~0/g, "~");
+
+    if (Array.isArray(current)) {
+      if (!isArrayIndex(token)) {
+        throw new Error(`JSON Pointer does not resolve: invalid array index ${JSON.stringify(token)}`);
+      }
+
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new Error(`JSON Pointer does not resolve: array index ${token} is out of bounds`);
+      }
+
+      current = current[index];
+      continue;
+    }
+
+    if (current !== null && typeof current === "object") {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(`JSON Pointer does not resolve: missing member ${JSON.stringify(token)}`);
+      }
+
+      current = (current as Record<string, unknown>)[token];
+      continue;
+    }
+
+    throw new Error("JSON Pointer does not resolve: cannot dereference a primitive value");
+  }
+
+  return current;
+}
+
+function isArrayIndex(token: string): boolean {
+  // RFC 6901 section 4 permits "0" or a non-zero digit followed by digits.
+  // The additional safe-integer check prevents numeric precision from making a
+  // syntactically valid but unrepresentable token resolve incorrectly.
+  return /^(?:0|[1-9][0-9]*)$/.test(token) && Number.isSafeInteger(Number(token));
+}
