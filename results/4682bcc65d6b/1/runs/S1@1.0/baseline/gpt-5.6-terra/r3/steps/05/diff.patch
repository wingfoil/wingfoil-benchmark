+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ *
+ * The returned operations contain copies of values from `to`, so neither
+ * input is modified now or by a later change to the returned patch.
+ *
+ * @throws {TypeError} If either value is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): Array<Record<string, unknown>> {
+  if (!isJsonValue(from)) {
+    throw new TypeError("A JSON Patch source must be a JSON value");
+  }
+  if (!isJsonValue(to)) {
+    throw new TypeError("A JSON Patch target must be a JSON value");
+  }
+
+  const patch: Array<Record<string, unknown>> = [];
+  createPatchAt(from, to, [], patch);
+  return patch;
+}
