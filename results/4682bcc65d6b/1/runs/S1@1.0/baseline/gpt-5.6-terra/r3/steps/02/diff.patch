+
+function requiredValue(record: Record<string, unknown>, operationIndex: number): unknown {
+  if (!hasOwn(record, "value")) {
+    throw patchError(operationIndex, "has no 'value' member");
+  }
+  if (!isJsonValue(record.value)) {
+    throw patchError(operationIndex, "has a non-JSON 'value' member");
+  }
+  return record.value;
