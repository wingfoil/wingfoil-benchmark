+        throw new Error(`JSON Pointer does not resolve: invalid array index ${JSON.stringify(token)}`);
+      }
+      current = current[Number(token)];
+    } else if (isJsonObject(current)) {
+      if (!hasOwn(current, token)) {
+        throw new Error(`JSON Pointer does not resolve: missing member ${JSON.stringify(token)}`);
+      }
+      current = current[token];
+    } else {
+      throw new Error("JSON Pointer does not resolve: cannot dereference a primitive value");
+    }
