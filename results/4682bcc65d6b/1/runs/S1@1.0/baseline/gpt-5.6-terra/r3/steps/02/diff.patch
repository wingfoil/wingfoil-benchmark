+/**
+ * Applies an RFC 6902 JSON Patch without modifying the supplied document.
+ *
+ * @param document The JSON document to patch.
+ * @param patch An array of RFC 6902 patch operations.
+ * @returns A new JSON value containing the patched document.
+ * @throws {TypeError} If the document or patch is not valid JSON Patch input.
+ * @throws {Error} If an operation cannot be applied.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!isJsonValue(document)) {
+    throw new TypeError("A JSON Patch document must be a JSON value");
+  }
+
+  if (!Array.isArray(patch)) {
+    throw new TypeError("A JSON Patch must be an array of operations");
+  }
+
+  let result = cloneJson(document);
+
+  for (let index = 0; index < patch.length; index += 1) {
+    result = applyOperation(result, patch[index], index);
+  }
+
+  return result;
+}
+
+function applyOperation(document: unknown, operation: unknown, operationIndex: number): unknown {
+  if (operation === null || typeof operation !== "object" || Array.isArray(operation)) {
+    throw patchError(operationIndex, "must be an object");
+  }
+
+  const record = operation as Record<string, unknown>;
+  if (!hasOwn(record, "op") || typeof record.op !== "string") {
+    throw patchError(operationIndex, "has no string 'op' member");
+  }
+  if (!hasOwn(record, "path") || typeof record.path !== "string") {
+    throw patchError(operationIndex, "has no string 'path' member");
+  }
+
+  const path = parsePointer(record.path, operationIndex, "path");
+
+  switch (record.op) {
+    case "add":
+      return add(document, path, requiredValue(record, operationIndex));
+    case "remove":
+      return remove(document, path);
+    case "replace":
+      return replace(document, path, requiredValue(record, operationIndex));
+    case "move": {
+      const from = requiredPointer(record, operationIndex, "from");
+      if (isProperPrefix(from, path)) {
+        throw patchError(operationIndex, "cannot move a value into one of its children");
+      }
+      const value = get(document, from);
+      // Moving the entire document onto itself is a no-op. It is the only
+      // move involving a root source that does not violate the prefix rule.
+      if (from.length === 0 && path.length === 0) {
+        return document;
+      }
+      return add(remove(document, from, true), path, cloneJson(value));
+    }
+    case "copy":
+      return add(document, path, cloneJson(get(document, requiredPointer(record, operationIndex, "from"))));
+    case "test": {
+      const expected = requiredValue(record, operationIndex);
+      if (!jsonEqual(get(document, path), expected)) {
