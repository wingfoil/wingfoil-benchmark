+/**
+ * Applies an RFC 7386 JSON Merge Patch without changing either supplied value.
+ *
+ * Object-valued patches merge member by member; a null member removes that
+ * member. All other patch values replace the target value, including arrays.
+ *
+ * @throws {Error} If `target` or `patch` is not a valid JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  // Validate and take ownership of both inputs before making any changes. This
+  // also ensures the returned document never shares mutable JSON containers
+  // with either caller-supplied value.
+  const result = cloneJsonValue(target);
+  const mergePatch = cloneJsonValue(patch);
+
+  return mergePatchValue(result, mergePatch);
+}
+
+function mergePatchValue(target: unknown, patch: unknown): unknown {
+  // RFC 7386 treats arrays as complete values, rather than objects to merge.
+  if (!isJsonObject(patch)) {
+    return patch;
+  }
+
+  const result: Record<string, unknown> = isJsonObject(target) ? target : {};
+
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setObjectMember(result, key, mergePatchValue(result[key], value));
+    }
+  }
+
+  return result;
+}
