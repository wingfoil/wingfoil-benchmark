+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @throws {Error} If `pointer` is malformed or does not identify a value in
+ * the document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("A JSON Pointer must be a string");
+  }
+
+  // The empty pointer identifies the complete document.
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error("A non-empty JSON Pointer must start with '/'");
+  }
+
+  let value: unknown = document;
+
+  for (const referenceToken of pointer.slice(1).split("/")) {
+    const token = decodeReferenceToken(referenceToken);
+
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(token)) {
+        throw new Error(`Invalid array index in JSON Pointer: ${token}`);
+      }
+
+      const index = Number(token);
+      if (index >= value.length || !Object.prototype.hasOwnProperty.call(value, index)) {
+        throw new Error(`JSON Pointer does not resolve to a value: ${pointer}`);
+      }
+
+      value = value[index];
+      continue;
+    }
+
+    if (value === null || typeof value !== "object") {
+      throw new Error(`JSON Pointer does not resolve to a value: ${pointer}`);
+    }
+
+    if (!Object.prototype.hasOwnProperty.call(value, token)) {
+      throw new Error(`JSON Pointer does not resolve to a value: ${pointer}`);
+    }
+
+    value = (value as Record<string, unknown>)[token];
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  let decoded = "";
+
+  for (let index = 0; index < token.length; index += 1) {
+    const character = token[index];
+    if (character !== "~") {
+      decoded += character;
+      continue;
+    }
+
+    const escape = token[index + 1];
+    if (escape === "0") {
+      decoded += "~";
+    } else if (escape === "1") {
+      decoded += "/";
+    } else {
+      throw new Error(`Invalid escape sequence in JSON Pointer token: ${token}`);
+    }
+    index += 1;
+  }
+
+  return decoded;
+}
+
+function isArrayIndex(token: string): boolean {
+  // RFC 6901 permits "0" or a non-zero digit followed by decimal digits.
+  return /^(?:0|[1-9][0-9]*)$/.test(token);
+}
