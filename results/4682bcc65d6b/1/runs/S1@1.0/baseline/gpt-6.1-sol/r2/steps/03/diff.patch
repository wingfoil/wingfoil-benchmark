diff --git a/test/patch.test.mjs b/test/patch.test.mjs
index 31b67521bcf520aeda81355266ce3d8d40499c51..d8c55b6e0e571f1f7503ab87fc980667ed1581f2 100644
--- a/test/patch.test.mjs
+++ b/test/patch.test.mjs
@@ -156,3 +156,102 @@ test('results share no mutable values with inputs or copied subtrees, even on fa
   ]));
   assert.equal(document.child.n, 1);
 });
+
+test('operation objects must be JSON objects, including null-prototype objects', () => {
+  for (const operation of [new Date(), new Number(1), new String('x'), /x/,
+    new (class Operation {})()]) {
+    Object.assign(operation, { op: 'add', path: '/x', value: 1 });
+    assert.throws(() => applyPatch({}, [operation]));
+  }
+  const operation = Object.assign(Object.create(null), { op: 'add', path: '/x', value: 1 });
+  assert.deepEqual(applyPatch({}, [operation]), { x: 1 });
+});
+
+test('JSON arrays use indexed elements rather than custom iterators', () => {
+  const document = [1, 2];
+  const value = [3, 4];
+  const patch = [{ op: 'add', path: '/-', value }];
+  for (const array of [document, value, patch]) {
+    array[Symbol.iterator] = () => { throw new Error('iterator must not run'); };
+  }
+  assert.deepEqual(applyPatch(document, patch), [1, 2, [3, 4]]);
+});
+
+test('array holes cannot be supplied by inherited properties', () => {
+  function inheritedElement(value) {
+    const array = new Array(1);
+    const prototype = Object.create(Array.prototype);
+    prototype[0] = value;
+    Object.setPrototypeOf(array, prototype);
+    return array;
+  }
+  for (const array of [new Array(1), inheritedElement(1)]) {
+    assert.throws(() => applyPatch(array, []));
+    for (const op of ['add', 'replace', 'test']) {
+      assert.throws(() => applyPatch([], [{ op, path: '', value: array }]));
+    }
+  }
+  assert.throws(() => applyPatch({}, inheritedElement({ op: 'remove', path: '' })));
+  assert.throws(() => applyPatch({}, new Array(1)));
+});
+
+test('rejects non-JSON documents and required values without coercing them', () => {
+  const cycle = {};
+  cycle.self = cycle;
+  for (const value of [undefined, NaN, Infinity, -Infinity, 1n, Symbol('x'),
+    () => {}, new Date(), new Map(), cycle, { nested: undefined }, [undefined]]) {
+    assert.throws(() => applyPatch(value, []));
+    for (const op of ['add', 'replace', 'test']) {
+      assert.throws(() => applyPatch(null, [{ op, path: '', value }]));
+    }
+  }
+  // Members not defined for an operation are ignored, even if they are not JSON values.
+  assert.deepEqual(applyPatch({ x: 1 }, [{ op: 'remove', path: '/x', from: cycle, value: cycle }]), {});
+});
+
+test('each failure terminates evaluation and leaves both inputs unchanged', () => {
+  const failures = [
+    { op: 'test', path: '/items/0', value: 99 },
+    { op: 'remove', path: '/missing' },
+    { op: 'replace', path: '/missing', value: 1 },
+    { op: 'add', path: '/missing/child', value: 1 },
+    { op: 'move', from: '/items/0', path: '/missing/child' },
+    { op: 'copy', from: '/items', path: '/missing/child' },
+    { op: 'unknown', path: '' },
+    { op: 'add', path: '/~2', value: 1 },
+  ];
+  for (const failure of failures) {
+    const document = { items: [{ n: 1 }, { n: 2 }] };
+    const patch = [
+      { op: 'add', path: '/new', value: { values: [1] } },
+      { op: 'replace', path: '/new/values/0', value: 2 },
+      failure,
+    ];
+    const originalDocument = structuredClone(document);
+    const originalPatch = structuredClone(patch);
+    let reachedLaterOperation = false;
+    Object.defineProperty(patch, 3, { get() {
+      reachedLaterOperation = true;
+      return { op: 'add', path: '', value: 'unexpected' };
+    } });
+    assert.throws(() => applyPatch(document, patch));
+    assert.equal(reachedLaterOperation, false);
+    assert.deepEqual(document, originalDocument);
+    assert.deepEqual(patch.slice(0, 3), originalPatch);
+  }
+});
+
+test('copy and move use add semantics for existing members and array destinations', () => {
+  for (const op of ['copy', 'move']) {
+    assert.deepEqual(applyPatch({ source: 1, target: 2 }, [
+      { op, from: '/source', path: '/target' },
+    ]), op === 'copy' ? { source: 1, target: 1 } : { target: 1 });
+    assert.deepEqual(applyPatch([1, 2, 3], [{ op, from: '/0', path: '/1' }]),
+      op === 'copy' ? [1, 1, 2, 3] : [2, 1, 3]);
+    assert.throws(() => applyPatch([1], [{ op, from: '/-', path: '/0' }]));
+    assert.throws(() => applyPatch([1], [{ op, from: '/0', path: '/01' }]));
+  }
+  assert.deepEqual(applyPatch({ '-': 1, '01': 2 }, [
+    { op: 'move', from: '/-', path: '/01' },
+  ]), { '01': 1 });
+});
