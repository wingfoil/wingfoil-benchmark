+type CreatedPatchOperation =
+  | { op: "remove"; path: string }
+  | { op: "add" | "replace"; path: string; value: JsonValue };
+
+/**
+ * Create an RFC 6902 patch transforming from into to, without modifying either.
+ * Equal values produce no operations. Objects and arrays are diffed recursively;
+ * replacements target individual changed values rather than their containers.
+ * Patch values are independent copies. Both inputs must be JSON values.
+ */
+export function createPatch(from: unknown, to: unknown): CreatedPatchOperation[] {
+  const before = cloneJson(from);
+  const after = cloneJson(to);
+  const patch: CreatedPatchOperation[] = [];
+  const childPath = (path: string, key: string) =>
+    `${path}/${key.replace(/~/gu, "~0").replace(/\//gu, "~1")}`;
+
+  function diff(left: JsonValue, right: JsonValue, path: string): void {
+    if (equalJson(left, right)) return;
+    if (Array.isArray(left) && Array.isArray(right)) {
+      diffArray(left, right, path);
+    } else if (isJsonObject(left) && isJsonObject(right)) {
+      for (const key of Object.keys(left)) {
+        if (!Object.hasOwn(right, key)) patch.push({ op: "remove", path: childPath(path, key) });
+      }
+      for (const key of Object.keys(right)) {
+        const nextPath = childPath(path, key);
+        if (Object.hasOwn(left, key)) diff(left[key], right[key], nextPath);
+        else patch.push({ op: "add", path: nextPath, value: right[key] });
+      }
+    } else {
+      patch.push({ op: "replace", path, value: right });
+    }
+  }
+
+  function diffArray(left: JsonValue[], right: JsonValue[], path: string): void {
+    // Trim unchanged ends before aligning the middle. A single insertion or
+    // deletion in a large array therefore needs no edit-distance table.
+    let start = 0;
+    let leftEnd = left.length;
+    let rightEnd = right.length;
+    while (start < leftEnd && start < rightEnd && equalJson(left[start], right[start])) start++;
+    while (leftEnd > start && rightEnd > start && equalJson(left[leftEnd - 1], right[rightEnd - 1])) {
+      leftEnd--;
+      rightEnd--;
+    }
+    const rows = leftEnd - start;
+    const columns = rightEnd - start;
+    if (rows === 0 || columns === 0) {
+      for (let i = 0; i < rows; i++) {
+        patch.push({ op: "remove", path: childPath(path, String(start)) });
+      }
+      for (let j = 0; j < columns; j++) {
+        patch.push({ op: "add", path: childPath(path, String(start + j)), value: right[start + j] });
+      }
+      return;
+    }
+    // Suffix edit distances allow forward emission with indices referring to
+    // the document after all preceding operations. Substitutions recurse.
+    const costs = Array.from({ length: rows + 1 }, () => new Uint32Array(columns + 1));
+    for (let i = rows; i >= 0; i--) {
+      for (let j = columns; j >= 0; j--) {
+        if (i === rows) costs[i][j] = columns - j;
+        else if (j === columns) costs[i][j] = rows - i;
+        else if (equalJson(left[start + i], right[start + j])) costs[i][j] = costs[i + 1][j + 1];
+        else costs[i][j] = 1 + Math.min(costs[i + 1][j + 1], costs[i + 1][j], costs[i][j + 1]);
+      }
+    }
+    let i = 0;
+    let j = 0;
+    while (i < rows || j < columns) {
+      const nextPath = childPath(path, String(start + j));
+      if (i < rows && j < columns && equalJson(left[start + i], right[start + j])) {
+        i++;
+        j++;
+      } else if (i < rows && j < columns && costs[i][j] === 1 + costs[i + 1][j + 1]) {
+        diff(left[start + i++], right[start + j++], nextPath);
+      } else if (i < rows && costs[i][j] === 1 + costs[i + 1][j]) {
+        patch.push({ op: "remove", path: nextPath });
+        i++;
+      } else {
+        patch.push({ op: "add", path: nextPath, value: right[start + j++] });
+      }
+    }
+  }
+
+  diff(before, after, "");
+  return patch;
+}
