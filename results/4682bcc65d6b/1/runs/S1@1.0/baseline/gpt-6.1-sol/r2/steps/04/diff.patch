+/**
+ * Apply a JSON Merge Patch (RFC 7386), returning an independent JSON value.
+ * Object members merge recursively; null members delete keys. All other patch
+ * values replace the target, including arrays and root-level null.
+ * Neither input is modified. An undefined target represents an absent document.
+ * @throws If either input is not a JSON value (except an undefined target).
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  const document = target === undefined ? undefined : cloneJson(target);
+  const changes = cloneJson(patch);
+
+  function merge(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+    if (!isJsonObject(patch)) return patch;
+    const result: { [key: string]: JsonValue } = isJsonObject(target)
+      ? target as { [key: string]: JsonValue }
+      : {};
+    for (const key of Object.keys(patch)) {
+      const value = patch[key] as JsonValue;
+      if (value === null) {
+        delete result[key];
+      } else {
+        const previous = Object.hasOwn(result, key) ? result[key] : undefined;
+        setMember(result, key, merge(previous, value));
+      }
+    }
+    return result;
+  }
+
+  return merge(document, changes);
+}
