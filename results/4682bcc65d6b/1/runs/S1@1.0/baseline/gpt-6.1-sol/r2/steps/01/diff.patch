index 0000000000000000000000000000000000000000..f91a9429550c22db5fe7453dc93a8023032db9d5
--- /dev/null
+++ b/test/pointer.test.mjs
@@ -0,0 +1,84 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { resolvePointer } from '../src/index.ts';
+
+test('RFC 6901 section 5 examples', () => {
+  const document = {
+    foo: ['bar', 'baz'], '': 0, 'a/b': 1, 'c%d': 2, 'e^f': 3,
+    'g|h': 4, 'i\\j': 5, 'k"l': 6, ' ': 7, 'm~n': 8,
+  };
+  const examples = [
+    ['', document], ['/foo', document.foo], ['/foo/0', 'bar'], ['/', 0],
+    ['/a~1b', 1], ['/c%d', 2], ['/e^f', 3], ['/g|h', 4],
+    ['/i\\j', 5], ['/k"l', 6], ['/ ', 7], ['/m~0n', 8],
+  ];
+  for (const [pointer, expected] of examples) {
+    assert.strictEqual(resolvePointer(document, pointer), expected);
+  }
+});
+
+test('empty pointers preserve every JSON root value', () => {
+  for (const document of [null, false, true, 0, '', 'hello', [], {}]) {
+    assert.strictEqual(resolvePointer(document, ''), document);
+  }
+});
+
+test('decodes tokens once and preserves empty tokens, Unicode and literal characters', () => {
+  const document = {
+    '~1': 'escaped', '': { '': [false, null, 0, ''] },
+    '雪😀': 1, '\u0000': 2, '\n': 3, '%2F': 4,
+    'é': 5, 'e\u0301': 6,
+  };
+  for (const [pointer, expected] of [
+    ['/~01', 'escaped'], ['///0', false], ['///1', null],
+    ['///2', 0], ['///3', ''], ['/雪😀', 1], ['/\u0000', 2],
+    ['/\n', 3], ['/%2F', 4], ['/é', 5], ['/e\u0301', 6],
+  ]) {
+    assert.strictEqual(resolvePointer(document, pointer), expected);
+  }
+});
+
+test('rejects malformed pointers, including malformed later tokens', () => {
+  for (const pointer of ['foo', '#', '#/foo', ' /foo', '/~', '/~2', '/~x', '/~~0', '/~\n', '/a/~2', null, 0, {}]) {
+    assert.throws(() => resolvePointer({ a: {} }, pointer), Error);
+  }
+});
+
+test('arrays require canonical existing indices', () => {
+  const document = ['first', { nested: 'second' }];
+  assert.equal(resolvePointer(document, '/1/nested'), 'second');
+  for (const token of ['', '-', '2', '01', '00', '-1', '-0', '+0', '1.0', '1e0', ' 0', '0 ', '0\n', 'length', 'map', 'Infinity', 'NaN', '9007199254740993', '999999999999999999999999999999']) {
+    assert.throws(() => resolvePointer(document, `/${token}`), Error);
+  }
+  assert.throws(() => resolvePointer(new Array(1), '/0'), Error);
+});
+
+test('object keys are unrestricted by array index rules and must be own properties', () => {
+  const document = JSON.parse('{"__proto__":{"safe":true},"constructor":1,"toString":2,"hasOwnProperty":3,"01":4,"-":5}');
+  for (const [pointer, expected] of [
+    ['/__proto__/safe', true], ['/constructor', 1], ['/toString', 2],
+    ['/hasOwnProperty', 3], ['/01', 4], ['/-', 5],
+  ]) {
+    assert.equal(resolvePointer(document, pointer), expected);
+  }
+  for (const pointer of ['/__proto__', '/constructor', '/toString', '/missing']) {
+    assert.throws(() => resolvePointer({}, pointer), Error);
+  }
+  assert.throws(() => resolvePointer(Object.create({ inherited: 1 }), '/inherited'), Error);
+  assert.equal(resolvePointer(Object.assign(Object.create(null), { key: 1 }), '/key'), 1);
+});
+
+test('cannot traverse primitive values or continue beyond a missing member', () => {
+  for (const document of [null, false, true, 0, 'hello']) {
+    assert.throws(() => resolvePointer(document, '/0'), Error);
+    assert.throws(() => resolvePointer({ value: document }, '/value/child'), Error);
+  }
+  assert.throws(() => resolvePointer({}, '/missing/child'), Error);
+});
+
+test('resolution returns references without modifying the document', () => {
+  const child = Object.freeze({ value: 1 });
+  const document = Object.freeze({ children: Object.freeze([child]) });
+  assert.strictEqual(resolvePointer(document, '/children/0'), child);
+  assert.deepEqual(document, { children: [{ value: 1 }] });
+});
