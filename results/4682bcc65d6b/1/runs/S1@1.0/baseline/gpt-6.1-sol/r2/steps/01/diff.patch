@@ -0,0 +1,49 @@
+/**
+ * Resolve a JSON Pointer string (RFC 6901) against a JSON document.
+ * The empty pointer returns the document itself. URI fragments must be decoded
+ * by the caller into a JSON Pointer string before use.
+ * @throws If the pointer is malformed or any reference token cannot be resolved.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (
+    typeof pointer !== "string" ||
+    (pointer !== "" && !pointer.startsWith("/")) ||
+    /~(?:[^01]|$)/u.test(pointer)
+  ) {
+    throw new Error("Invalid JSON Pointer");
+  }
+
+  if (pointer === "") return document;
+
+  let value: unknown = document;
+  for (const encodedToken of pointer.slice(1).split("/")) {
+    // Decode in one pass so that ~01 becomes ~1, not /.
+    const token = encodedToken.replace(/~[01]/gu, (escape) =>
+      escape === "~1" ? "/" : "~",
+    );
+
+    if (value === null || typeof value !== "object") {
+      throw new Error("JSON Pointer traverses a non-container value");
+    }
+
+    if (Array.isArray(value)) {
+      const index = Number(token);
+      // Round-tripping rejects leading zeros, signs, whitespace and exponents.
+      if (
+        !Number.isSafeInteger(index) ||
+        index < 0 ||
+        String(index) !== token ||
+        index >= value.length
+      ) {
+        throw new Error("JSON Pointer does not reference an array element");
+      }
+    }
+
+    if (!Object.hasOwn(value, token)) {
+      throw new Error("JSON Pointer references a missing value");
+    }
+    value = (value as Record<string, unknown>)[token];
+  }
+
+  return value;
+}
