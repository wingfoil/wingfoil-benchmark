+
+const hasOwn = (value: object, key: string): boolean =>
+  Object.prototype.hasOwnProperty.call(value, key);
+
+function setMember(object: object, key: string, value: unknown): void {
+  // Treat __proto__ and other JavaScript property names as ordinary JSON keys.
+  Object.defineProperty(object, key, {
