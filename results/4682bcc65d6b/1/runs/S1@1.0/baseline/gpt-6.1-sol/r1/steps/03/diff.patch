diff --git a/test/patch.test.mjs b/test/patch.test.mjs
index 02ffcddaf3d349db66740aadeaa56e023ff421c6..464c7a3f841c496284bf43b4c943a62a34b17b61 100644
--- a/test/patch.test.mjs
+++ b/test/patch.test.mjs
@@ -166,3 +166,79 @@ test("special property names are own data members and cannot modify prototypes",
   }
   assert.throws(() => applyPatch({}, [Object.create({ op: "remove", path: "" })]));
 });
+
+test("operation objects and all their members must represent JSON", () => {
+  const cycle = {};
+  cycle.self = cycle;
+  for (const extra of [undefined, NaN, Infinity, -Infinity, 1n, () => {}, Symbol(),
+    new Date(), new Map(), new Set(), /x/, new Number(1), cycle, new Array(1),
+    { nested: undefined }, [Infinity]]) {
+    assert.throws(() => applyPatch({}, [{ op: "add", path: "/x", value: 1, extra }]));
+  }
+  for (const operation of [new Date(), new Map(), new (class Operation {})()]) {
+    operation.op = "add";
+    operation.path = "/x";
+    operation.value = 1;
+    assert.throws(() => applyPatch({}, [operation]));
+  }
+  const operation = Object.assign(Object.create(null), { op: "add", path: "/x", value: 1 });
+  assert.deepEqual(applyPatch({}, [operation]), { x: 1 });
+});
+
+test("unrecognized operation members have no semantics when they contain valid JSON", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [
+    { op: "add", path: "/b", value: 2, from: "/~bad", metadata: { op: "unknown" } },
+    { op: "remove", path: "/a", from: null, value: { ignored: true } },
+    { op: "copy", from: "/b", path: "/c", value: false },
+    { op: "test", path: "/c", value: 2, from: [] },
+  ]), { b: 2, c: 2 });
+});
+
+test("patch arrays use own entries rather than inherited entries or custom iteration", () => {
+  const patch = new Array(1);
+  const prototype = Object.create(Array.prototype);
+  prototype[0] = { op: "add", path: "/unexpected", value: true };
+  Object.setPrototypeOf(patch, prototype);
+  assert.throws(() => applyPatch({}, patch));
+  const ordinary = [{ op: "add", path: "/expected", value: true }];
+  ordinary[Symbol.iterator] = function* () {
+    yield { op: "remove", path: "" };
+  };
+  assert.deepEqual(applyPatch({}, ordinary), { expected: true });
+});
+
+test("errors terminate evaluation immediately and leave both inputs unchanged", () => {
+  const document = { a: [1, 2], b: {} };
+  const failures = [
+    { op: "test", path: "/a/0", value: 99 },
+    { op: "move", from: "/a/0", path: "/missing/child" },
+    { op: "move", from: "/a/0", path: "/a/2" },
+    { op: "copy", from: "/missing", path: "/b/x" },
+    { op: "replace", path: "/b/missing", value: 0 },
+    { op: "unknown", path: "" },
+    { op: "add", path: "/x", value: undefined },
+  ];
+  for (const failure of failures) {
+    const patch = [{ op: "add", path: "/b/new", value: { x: 3 } }, failure];
+    const before = structuredClone(patch);
+    Object.defineProperty(patch, 2, {
+      get() { assert.fail("must not inspect operations after the first error"); },
+    });
+    assert.throws(() => applyPatch(document, patch));
+    assert.deepEqual(document, { a: [1, 2], b: {} });
+    assert.deepEqual(patch.slice(0, 2), before);
+  }
+});
+
+test("an absent root cannot be read, traversed, removed or replaced", () => {
+  for (const operation of [
+    { op: "remove", path: "" },
+    { op: "replace", path: "", value: null },
+    { op: "test", path: "", value: null },
+    { op: "copy", from: "", path: "" },
+    { op: "move", from: "", path: "" },
+    { op: "add", path: "/a", value: 1 },
+  ]) {
+    assert.throws(() => applyPatch(null, [{ op: "remove", path: "" }, operation]));
+  }
+});
