diff --git a/test/merge-patch.test.mjs b/test/merge-patch.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a2a333881a33060420939e12dce3d1148eecfbe9
--- /dev/null
+++ b/test/merge-patch.test.mjs
@@ -0,0 +1,87 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 Appendix A examples", () => {
+  const examples = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of examples) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("handles every root type and absent targets", () => {
+  for (const target of [undefined, null, false, 0, "", [], { keep: true }]) {
+    for (const patch of [null, false, 0, "", [null, { keep: null }]]) {
+      assert.deepEqual(applyMergePatch(target, patch), patch);
+    }
+    assert.deepEqual(applyMergePatch(target, { added: { absent: null }, missing: null }),
+      { ...(target && !Array.isArray(target) ? target : {}), added: {} });
+  }
+  assert.deepEqual(applyMergePatch({ a: [1], b: null, c: 2 }, { a: {}, b: {}, c: {} }),
+    { a: {}, b: {}, c: {} });
+});
+
+test("deep copies both inputs, including untouched and replaced subtrees", () => {
+  const target = Object.freeze({ keep: Object.freeze([Object.freeze({ x: 1 })]),
+    nested: Object.freeze({ old: true }) });
+  const patch = Object.freeze({ nested: Object.freeze({ old: null, new: true }),
+    added: Object.freeze([Object.freeze({ value: null })]) });
+  const result = applyMergePatch(target, patch);
+  assert.deepEqual(result, { keep: [{ x: 1 }], nested: { new: true }, added: [{ value: null }] });
+  result.keep[0].x = 9;
+  result.added[0].value = 9;
+  assert.equal(target.keep[0].x, 1);
+  assert.equal(patch.added[0].value, null);
+  assert.notStrictEqual(applyMergePatch(target, {}).keep, target.keep);
+  const replacement = applyMergePatch({}, patch.added);
+  replacement[0].value = false;
+  assert.equal(patch.added[0].value, null);
+});
+
+test("treats special names as own data members without touching prototypes", () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true},"constructor":{"prototype":{"polluted":true}},"toString":{"x":1},"":{"a/b":2}}');
+  const result = applyMergePatch({}, patch);
+  assert.deepEqual(result, patch);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(Object.prototype.polluted, undefined);
+  assert.deepEqual(applyMergePatch(result, JSON.parse('{"__proto__":null,"constructor":null,"toString":null}')),
+    { "": { "a/b": 2 } });
+  assert.deepEqual(applyMergePatch({}, { toString: null, constructor: null }), {});
+  const target = Object.assign(Object.create(null), { a: { keep: 1 } });
+  const changes = Object.assign(Object.create(null), { a: { add: 2 } });
+  assert.deepEqual(applyMergePatch(target, changes), { a: { keep: 1, add: 2 } });
+});
+
+test("rejects non-JSON inputs without modifying either input", () => {
+  const cycle = {};
+  cycle.self = cycle;
+  const invalid = [NaN, Infinity, -Infinity, 1n, Symbol(), () => {}, new Date(),
+    new Map(), new Set(), /x/, new Number(1), cycle, new Array(1),
+    { nested: undefined }, [Infinity], new (class Value {})()];
+  for (const value of invalid) {
+    assert.throws(() => applyMergePatch(value, null));
+    assert.throws(() => applyMergePatch({}, value));
+  }
+  assert.throws(() => applyMergePatch({}, undefined));
+  const target = { a: { x: 1 } };
+  const patch = { a: { x: 2 }, invalid: undefined };
+  assert.throws(() => applyMergePatch(target, patch));
+  assert.deepEqual(target, { a: { x: 1 } });
+  assert.deepEqual(patch, { a: { x: 2 }, invalid: undefined });
+});
