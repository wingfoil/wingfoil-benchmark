+/**
+ * Apply an RFC 7386 JSON Merge Patch without mutating or retaining references
+ * to either input. An undefined target represents an absent document.
+ * Throws if either input is not JSON (except for an undefined target).
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  const document = target === undefined ? undefined : cloneJson(target);
+  const changes = cloneJson(patch);
+
+  const merge = (current: unknown, change: unknown): unknown => {
+    if (change === null || typeof change !== "object" || Array.isArray(change)) {
+      return change;
+    }
+    const result: Record<string, unknown> =
+      current !== null && typeof current === "object" && !Array.isArray(current)
+        ? current as Record<string, unknown>
+        : {};
+    for (const key of Object.keys(change)) {
+      const value = (change as Record<string, unknown>)[key];
+      if (value === null) {
+        delete result[key];
+      } else {
+        setMember(result, key, merge(hasOwn(result, key) ? result[key] : undefined, value));
+      }
+    }
+    return result;
+  };
+
+  return merge(document, changes);
+}
