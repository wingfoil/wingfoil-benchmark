+import assert from "node:assert/strict";
+import test from "node:test";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from, to) {
+  const patch = createPatch(from, to);
+  // Exercise the actual wire representation, too.
+  assert.deepEqual(applyPatch(from, JSON.parse(JSON.stringify(patch))), to);
+  return patch;
+}
+
+test("emits no operations for JSON equality, regardless of object member order", () => {
+  for (const value of [null, false, 0, "", [], {}, { nested: [1, null, {}] }]) {
+    assert.deepEqual(createPatch(value, structuredClone(value)), []);
+  }
+  assert.deepEqual(createPatch({ a: 1, b: [{ c: 2, d: 3 }] },
+    { b: [{ d: 3, c: 2 }], a: 1 }), []);
+  assert.deepEqual(createPatch(-0, 0), []);
+});
+
+test("changes only the affected object members, including nested array members", () => {
+  const from = { keep: "x".repeat(10000), users: [{ name: "Ada", active: true }], old: 1 };
+  const to = { keep: from.keep, users: [{ name: "Grace", active: true }], added: null };
+  assert.deepEqual(roundTrip(from, to), [
+    { op: "remove", path: "/old" },
+    { op: "replace", path: "/users/0/name", value: "Grace" },
+    { op: "add", path: "/added", value: null },
+  ]);
+});
+
+test("replaces scalar values and incompatible container types at their location", () => {
+  const values = [null, false, true, 0, 1, "", "a", [], {}, [1], { a: 1 }];
+  for (const from of values) {
+    for (const to of values) roundTrip(from, to);
+  }
+  assert.deepEqual(createPatch({ a: [] }, { a: {} }), [
+    { op: "replace", path: "/a", value: {} },
+  ]);
+  assert.deepEqual(createPatch(null, [1]), [{ op: "replace", path: "", value: [1] }]);
+});
+
+test("aligns array insertions and removals without resending unchanged elements", () => {
+  const large = { data: "unchanged".repeat(1000) };
+  assert.deepEqual(roundTrip([large, 2, 3], [0, large, 2, 3]), [
+    { op: "add", path: "/0", value: 0 },
+  ]);
+  assert.deepEqual(roundTrip([large, 2, 3], [large, 3]), [
+    { op: "remove", path: "/1" },
+  ]);
+  assert.deepEqual(roundTrip([1, large, 2, 3, 4], [0, 1, large, 2, 9, 3, 4, 5]), [
+    { op: "add", path: "/0", value: 0 },
+    { op: "add", path: "/4", value: 9 },
+    { op: "add", path: "/7", value: 5 },
+  ]);
+  assert.deepEqual(roundTrip([0, 1, large, 2, 9, 3, 4, 5], [1, large, 2, 3, 4]), [
+    { op: "remove", path: "/0" },
+    { op: "remove", path: "/3" },
+    { op: "remove", path: "/5" },
+  ]);
+  assert.deepEqual(roundTrip([[{ x: 1, keep: large }]], [[{ x: 2, keep: large }]]), [
+    { op: "replace", path: "/0/0/x", value: 2 },
+  ]);
+});
+
+test("escapes pointer tokens and handles prototype-like names as JSON data", () => {
+  const from = JSON.parse('{"":{"a/b":{"~1":1}},"__proto__":{"x":1},"constructor":0,"toString":1}');
+  const to = JSON.parse('{"":{"a/b":{"~1":2}},"__proto__":{"x":2},"constructor":{},"new/~":3}');
+  assert.deepEqual(roundTrip(from, to), [
+    { op: "remove", path: "/toString" },
+    { op: "replace", path: "//a~1b/~01", value: 2 },
+    { op: "replace", path: "/__proto__/x", value: 2 },
+    { op: "replace", path: "/constructor", value: {} },
+    { op: "add", path: "/new~1~0", value: 3 },
+  ]);
+  const nullPrototype = Object.assign(Object.create(null), { a: 1 });
+  assert.deepEqual(createPatch(nullPrototype, { a: 1 }), []);
+  assert.deepEqual(createPatch(nullPrototype, { a: 2 }), [
+    { op: "replace", path: "/a", value: 2 },
+  ]);
+  assert.equal(Object.prototype.x, undefined);
+});
+
+test("does not mutate frozen inputs and detaches operation values from inputs", () => {
+  const from = Object.freeze({ old: Object.freeze([1]), replaced: 0 });
+  const to = Object.freeze({ added: Object.freeze([Object.freeze({ x: 1 })]),
+    replaced: Object.freeze({ nested: Object.freeze([2]) }) });
+  const patch = roundTrip(from, to);
+  patch.find(op => op.path === "/added").value[0].x = 9;
+  patch.find(op => op.path === "/replaced").value.nested.push(3);
+  assert.deepEqual(from, { old: [1], replaced: 0 });
+  assert.deepEqual(to, { added: [{ x: 1 }], replaced: { nested: [2] } });
+  const mutable = { a: { x: 1 } };
+  const detached = createPatch({}, mutable);
+  mutable.a.x = 2;
+  assert.equal(detached[0].value.x, 1);
+});
+
+test("rejects invalid JSON even in equal or otherwise unchanged subtrees", () => {
+  const cycle = {};
+  cycle.self = cycle;
+  const invalid = [undefined, NaN, Infinity, -Infinity, 1n, Symbol(), () => {},
+    new Date(), new Map(), /x/, new Number(1), cycle, new Array(1),
+    { nested: undefined }, [Infinity], new (class Value {})()];
+  for (const value of invalid) {
+    assert.throws(() => createPatch(value, null));
+    assert.throws(() => createPatch(null, value));
+    assert.throws(() => createPatch(value, value));
+    assert.throws(() => createPatch({ keep: value, x: 1 }, { keep: value, x: 2 }));
+  }
+  const shared = { x: [1] };
+  assert.deepEqual(createPatch([shared, shared], [{ x: [1] }, { x: [1] }]), []);
+});
+
+test("round trips generated documents, including duplicate and reordered array values", () => {
+  let seed = 12345;
+  const random = n => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed % n;
+  };
+  const value = depth => {
+    const kind = random(depth ? 6 : 4);
+    if (kind < 4) return [null, false, random(4), String(random(4))][kind];
+    if (kind === 4) return Array.from({ length: random(7) }, () => value(depth - 1));
+    return Object.fromEntries(Array.from({ length: random(5) }, (_, i) =>
+      [["", "a/b", "~", "__proto__"][i], value(depth - 1)]));
+  };
+  for (let i = 0; i < 500; i++) {
+    const from = value(3);
+    const to = value(3);
+    roundTrip(from, to);
+    roundTrip(to, from);
+    const a = Array.from({ length: random(12) }, () => value(1));
+    const b = Array.from({ length: random(12) }, () => value(1));
+    roundTrip(a, b);
+    roundTrip(b, a);
+  }
+});
