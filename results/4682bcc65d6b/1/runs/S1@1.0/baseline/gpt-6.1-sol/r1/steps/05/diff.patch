+/** The operations emitted by createPatch. */
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+/**
+ * Create an RFC 6902 JSON Patch from two JSON values.
+ * Descends into objects and arrays, preserving unchanged members and elements.
+ * Neither input is mutated, and operation values are independent deep copies.
+ * Throws if either input is not JSON.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  // Validate even equal/unchanged subtrees, and detach all emitted values.
+  const source = cloneJson(from);
+  const target = cloneJson(to);
+  const patch: PatchOperation[] = [];
+  const childPath = (path: string, key: string): string =>
+    `${path}/${key.replace(/~/g, "~0").replace(/\//g, "~1")}`;
+
+  const diff = (left: unknown, right: unknown, path: string): void => {
+    if (jsonEqual(left, right)) return;
+    if (Array.isArray(left) && Array.isArray(right)) {
+      const matches: [number, number][] = [];
+      arrayMatches(left, right, 0, left.length, 0, right.length, matches);
+      // A sentinel lets the final unmatched run use the same logic as the rest.
+      matches.push([left.length, right.length]);
+      let leftStart = 0;
+      let rightStart = 0;
+      for (const [leftEnd, rightEnd] of matches) {
+        const paired = Math.min(leftEnd - leftStart, rightEnd - rightStart);
+        for (let i = 0; i < paired; i++) {
+          diff(left[leftStart + i], right[rightStart + i], childPath(path, String(rightStart + i)));
+        }
+        // Earlier operations have already shifted this run to its target index.
+        for (let i = leftStart + paired; i < leftEnd; i++) {
+          patch.push({ op: "remove", path: childPath(path, String(rightStart + paired)) });
+        }
+        for (let i = rightStart + paired; i < rightEnd; i++) {
+          patch.push({ op: "add", path: childPath(path, String(i)), value: right[i] });
+        }
+        leftStart = leftEnd + 1;
+        rightStart = rightEnd + 1;
+      }
+    } else if (left !== null && right !== null &&
+               typeof left === "object" && typeof right === "object" &&
+               !Array.isArray(left) && !Array.isArray(right)) {
+      const before = left as Record<string, unknown>;
+      const after = right as Record<string, unknown>;
+      for (const key of Object.keys(before)) {
+        if (!hasOwn(after, key)) patch.push({ op: "remove", path: childPath(path, key) });
+      }
+      for (const key of Object.keys(after)) {
+        const location = childPath(path, key);
+        if (hasOwn(before, key)) diff(before[key], after[key], location);
+        else patch.push({ op: "add", path: location, value: after[key] });
+      }
+    } else {
+      patch.push({ op: "replace", path, value: right });
+    }
+  };
+
+  diff(source, target, "");
+  return patch;
+}
+
+// Find unchanged array anchors using a longest common subsequence. Hirschberg's
+// split avoids storing a quadratic table; equal ends also make isolated edits cheap.
+function arrayMatches(
+  left: unknown[], right: unknown[],
+  leftStart: number, leftEnd: number, rightStart: number, rightEnd: number,
+  matches: [number, number][],
+): void {
+  while (leftStart < leftEnd && rightStart < rightEnd &&
+         jsonEqual(left[leftStart], right[rightStart])) {
+    matches.push([leftStart++, rightStart++]);
+  }
+  let suffix = 0;
+  while (leftStart < leftEnd && rightStart < rightEnd &&
+         jsonEqual(left[leftEnd - 1], right[rightEnd - 1])) {
+    leftEnd--;
+    rightEnd--;
+    suffix++;
+  }
+  if (leftEnd - leftStart === 1) {
+    for (let j = rightStart; j < rightEnd; j++) {
+      if (jsonEqual(left[leftStart], right[j])) {
+        matches.push([leftStart, j]);
+        break;
+      }
+    }
+  } else if (leftStart < leftEnd && rightStart < rightEnd) {
+    const middle = Math.floor((leftStart + leftEnd) / 2);
+    const split = arraySplit(left, right, leftStart, middle, leftEnd, rightStart, rightEnd);
+    arrayMatches(left, right, leftStart, middle, rightStart, split, matches);
+    arrayMatches(left, right, middle, leftEnd, split, rightEnd, matches);
+  }
+  for (let i = 0; i < suffix; i++) matches.push([leftEnd + i, rightEnd + i]);
+}
+
+function arraySplit(
+  left: unknown[], right: unknown[],
+  start: number, middle: number, end: number, rightStart: number, rightEnd: number,
+): number {
+  const width = rightEnd - rightStart;
+  const lengths = (begin: number, finish: number, step: number): number[] => {
+    const row = new Array<number>(width + 1).fill(0);
+    for (let i = begin; i !== finish; i += step) {
+      let diagonal = 0;
+      for (let j = 1; j <= width; j++) {
+        const previous = row[j];
+        const index = step === 1 ? rightStart + j - 1 : rightEnd - j;
+        row[j] = jsonEqual(left[i], right[index])
+          ? diagonal + 1 : Math.max(row[j], row[j - 1]);
+        diagonal = previous;
+      }
+    }
+    return row;
+  };
+  const forward = lengths(start, middle, 1);
+  const backward = lengths(end - 1, middle - 1, -1);
+  let best = 0;
+  for (let j = 1; j <= width; j++) {
+    if (forward[j] + backward[width - j] > forward[best] + backward[width - best]) best = j;
+  }
+  return rightStart + best;
+}
