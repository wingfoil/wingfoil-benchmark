+
+test('rejects non-JSON documents and operation values instead of silently converting them', () => {
+  const cycle = {};
+  cycle.self = cycle;
+  const symbolMember = { [Symbol('member')]: 1 };
+  const hiddenMember = Object.defineProperty({}, 'hidden', { value: 1 });
+  for (const value of [
+    undefined, NaN, Infinity, -Infinity, 1n, Symbol('value'), () => {},
+    new Date(), new Map(), new Set(), /pattern/, new Number(1), new String('a'),
+    new Boolean(false), new Uint8Array([1]), new (class { value = 1; })(),
+    cycle, { nested: cycle }, { nested: undefined }, [undefined], new Array(1),
+    symbolMember, hiddenMember,
+  ]) {
+    assert.throws(() => applyPatch(value, []), Error);
+    // Replacing the entire root must not bypass document validation.
+    assert.throws(() => applyPatch(value, [op('add', '', null)]), Error);
+    for (const name of ['add', 'replace', 'test']) {
+      assert.throws(() => applyPatch({ a: null }, [op(name, '/a', value)]), Error);
+    }
+  }
+});
+
+test('accepts null-prototype records and repeated references without introducing aliases', () => {
+  const child = Object.assign(Object.create(null), { n: 1 });
+  const operation = Object.assign(Object.create(null), { op: 'add', path: '/added', value: child });
+  const result = applyPatch({ a: child, b: child }, [operation]);
+  assert.deepEqual(result, { a: { n: 1 }, b: { n: 1 }, added: { n: 1 } });
+  result.a.n = 2;
+  assert.equal(result.b.n, 1);
+  assert.equal(result.added.n, 1);
+  assert.equal(child.n, 1);
+});
+
+test('does not execute accessors while validating JSON data or required operation members', () => {
+  let reads = 0;
+  const accessor = { enumerable: true, get() { reads++; return 1; } };
+  const document = Object.defineProperty({}, 'a', accessor);
+  assert.throws(() => applyPatch(document, []));
+  assert.throws(() => applyPatch({}, [op('add', '/a', document)]));
+  assert.throws(() => applyPatch([0], [op('add', '/-', Object.defineProperty([], '0', accessor))]));
+  for (const key of ['op', 'path', 'value', 'from']) {
+    const operation = { op: key === 'from' ? 'copy' : 'add', path: '', value: 1, from: '' };
+    Object.defineProperty(operation, key, accessor);
+    assert.throws(() => applyPatch({}, [operation]));
+  }
+  assert.equal(reads, 0);
+});
+
