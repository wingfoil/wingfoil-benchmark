+/** Operations emitted by createPatch. */
+export type PatchOperation =
+  | { op: 'remove'; path: string }
+  | { op: 'add' | 'replace'; path: string; value: unknown };
+
+function memberPath(path: string, key: string): string {
+  return `${path}/${key.replace(/~/gu, '~0').replace(/\//gu, '~1')}`;
+}
+
+// LCS lengths for each prefix (or reversed suffix) of a target range.
+// Keeping only one row avoids allocating a quadratic-size table.
+function matchingLengths(
+  from: unknown[], start: number, end: number,
+  to: unknown[], first: number, last: number, reverse: boolean,
+): Uint32Array {
+  const lengths = new Uint32Array(last - first + 1);
+  for (let i = 0; i < end - start; i++) {
+    let diagonal = 0;
+    for (let j = 1; j < lengths.length; j++) {
+      const previous = lengths[j];
+      lengths[j] = equalJson(from[reverse ? end - 1 - i : start + i],
+        to[reverse ? last - j : first + j - 1])
+        ? diagonal + 1 : Math.max(lengths[j], lengths[j - 1]);
+      diagonal = previous;
+    }
+  }
+  return lengths;
+}
+
+function matchingSplit(
+  from: unknown[], start: number, middle: number, end: number,
+  to: unknown[], first: number, last: number,
+): number {
+  const left = matchingLengths(from, start, middle, to, first, last, false);
+  const right = matchingLengths(from, middle, end, to, first, last, true);
+  let split = 0;
+  for (let j = 1; j < left.length; j++) {
+    if (left[j] + right[last - first - j] > left[split] + right[last - first - split]) split = j;
+  }
+  return first + split;
+}
+
+// Hirschberg's LCS alignment preserves equal elements through insertions and
+// deletions, using linear auxiliary space. Trim common ends for small edits.
+function arrayMatches(
+  from: unknown[], start: number, end: number,
+  to: unknown[], first: number, last: number, matches: [number, number][],
+): void {
+  while (start < end && first < last && equalJson(from[start], to[first])) {
+    matches.push([start++, first++]);
+  }
+  let suffix = 0;
+  while (start < end && first < last && equalJson(from[end - 1], to[last - 1])) {
+    end--;
+    last--;
+    suffix++;
+  }
+  if (end - start === 1) {
+    for (let j = first; j < last; j++) {
+      if (equalJson(from[start], to[j])) {
+        matches.push([start, j]);
+        break;
+      }
+    }
+  } else if (start < end && first < last) {
+    const middle = start + Math.floor((end - start) / 2);
+    const split = matchingSplit(from, start, middle, end, to, first, last);
+    arrayMatches(from, start, middle, to, first, split, matches);
+    arrayMatches(from, middle, end, to, split, last, matches);
+  }
+  for (let i = 0; i < suffix; i++) matches.push([end + i, last + i]);
+}
+
+// Inputs are private validated clones, so emitted values cannot alias inputs.
+function diffJson(from: unknown, to: unknown, path: string, patch: PatchOperation[]): void {
+  if (equalJson(from, to)) return;
+  if (isJsonObject(from) && isJsonObject(to)) {
+    for (const key of Object.keys(from)) {
+      const child = memberPath(path, key);
+      if (!Object.hasOwn(to, key)) patch.push({ op: 'remove', path: child });
+      else diffJson(from[key], to[key], child, patch);
+    }
+    for (const key of Object.keys(to)) {
+      if (!Object.hasOwn(from, key)) patch.push({ op: 'add', path: memberPath(path, key), value: to[key] });
+    }
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    const matches: [number, number][] = [];
+    arrayMatches(from, 0, from.length, to, 0, to.length, matches);
+    // The sentinel flushes the final unmatched range. Target indices also
+    // describe current indices after all preceding operations have run.
+    matches.push([from.length, to.length]);
+    let oldIndex = 0;
+    let newIndex = 0;
+    for (const [oldEnd, newEnd] of matches) {
+      const paired = Math.min(oldEnd - oldIndex, newEnd - newIndex);
+      for (let i = 0; i < paired; i++) {
+        diffJson(from[oldIndex + i], to[newIndex + i], `${path}/${newIndex + i}`, patch);
+      }
+      for (let i = oldIndex + paired; i < oldEnd; i++) {
+        patch.push({ op: 'remove', path: `${path}/${newIndex + paired}` });
+      }
+      for (let i = newIndex + paired; i < newEnd; i++) {
+        patch.push({ op: 'add', path: `${path}/${i}`, value: to[i] });
+      }
+      oldIndex = oldEnd + 1;
+      newIndex = newEnd + 1;
+    }
+  } else {
+    patch.push({ op: 'replace', path, value: to });
+  }
+}
+
+/**
+ * Create an RFC 6902 patch transforming from into to without mutating either.
+ * Recurses into objects and arrays, omitting unchanged values. Both inputs must
+ * be JSON data; returned operation values are independent of the inputs.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const source = cloneJson(from);
+  const target = cloneJson(to);
+  const patch: PatchOperation[] = [];
+  diffJson(source, target, '', patch);
+  return patch;
+}
