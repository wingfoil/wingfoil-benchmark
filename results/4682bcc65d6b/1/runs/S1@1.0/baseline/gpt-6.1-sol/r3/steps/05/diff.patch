+++ b/test/create-patch.test.mjs
@@ -0,0 +1,142 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { applyPatch, createPatch } from '../src/index.ts';
+
+function freeze(value) {
+  if (value !== null && typeof value === 'object') {
+    Object.values(value).forEach(freeze);
+    Object.freeze(value);
+  }
+  return value;
+}
+
+test('emits only changed leaves, additions, and removals in nested objects', () => {
+  const from = freeze({ settings: { theme: 'dark', alerts: true }, gone: [1], stable: 'x'.repeat(10000) });
+  const to = freeze({ settings: { theme: 'light', alerts: true }, added: { n: null }, stable: from.stable });
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [
+    { op: 'replace', path: '/settings/theme', value: 'light' },
+    { op: 'remove', path: '/gone' },
+    { op: 'add', path: '/added', value: { n: null } },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test('equal JSON values produce no operations, regardless of member order or aliases', () => {
+  const shared = { x: [1, null] };
+  for (const [from, to] of [
+    [null, null], [false, false], [0, -0], ['', ''], [[], []],
+    [{ a: 1, b: [2] }, { b: [2], a: 1 }],
+    [{ a: shared, b: shared }, { b: { x: [1, null] }, a: { x: [1, null] } }],
+    [Object.assign(Object.create(null), { a: 1 }), { a: 1 }],
+  ]) assert.deepEqual(createPatch(from, to), []);
+});
+
+test('supports scalar roots and changes between JSON types', () => {
+  const values = [null, false, true, 0, 1, '', 'hello', [], {}, [1], { a: 1 }];
+  for (const from of values) {
+    for (const to of values) assert.deepEqual(applyPatch(from, createPatch(from, to)), to);
+  }
+  assert.deepEqual(createPatch({ a: [1] }, { a: null }), [
+    { op: 'replace', path: '/a', value: null },
+  ]);
+  assert.deepEqual(createPatch(0, { a: 1 }), [
+    { op: 'replace', path: '', value: { a: 1 } },
+  ]);
+});
+
+test('escapes JSON Pointers and handles prototype-related and empty member names', () => {
+  const from = JSON.parse('{"":{"a/b":{"~1":1}},"__proto__":{"n":1},"constructor":0}');
+  const to = JSON.parse('{"":{"a/b":{"~1":2}},"__proto__":{"n":2},"toString":3}');
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [
+    { op: 'replace', path: '//a~1b/~01', value: 2 },
+    { op: 'replace', path: '/__proto__/n', value: 2 },
+    { op: 'remove', path: '/constructor' },
+    { op: 'add', path: '/toString', value: 3 },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  const special = JSON.parse('{"__proto__":{"safe":true}}');
+  assert.deepEqual(applyPatch({}, createPatch({}, special)), special);
+  assert.equal(Object.hasOwn(Object.prototype, 'safe'), false);
+});
+
+test('array insertions and deletions preserve unchanged elements', () => {
+  for (const index of [0, 1, 3]) {
+    const from = ['a', 'b', 'c'];
+    const to = from.toSpliced(index, 0, 'new');
+    assert.deepEqual(createPatch(from, to), [{ op: 'add', path: `/${index}`, value: 'new' }]);
+    assert.deepEqual(createPatch(to, from), [{ op: 'remove', path: `/${index}` }]);
+  }
+  const from = [0, 1, 2, 3, 4, 5];
+  const to = [0, 'a', 1, 2, 4, 'b', 5];
+  const patch = createPatch(from, to);
+  assert.equal(patch.length, 3);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test('a small edit inside an array element sends only the changed leaf', () => {
+  const from = { items: [{ id: 1, data: { label: 'before', large: 'x'.repeat(10000) } }, { id: 2 }] };
+  const to = structuredClone(from);
+  to.items[0].data.label = 'after';
+  assert.deepEqual(createPatch(freeze(from), freeze(to)), [
+    { op: 'replace', path: '/items/0/data/label', value: 'after' },
+  ]);
+});
+
+test('large arrays with a single insertion yield a single small operation', () => {
+  const from = Array.from({ length: 10000 }, (_, id) => ({ id }));
+  const to = from.toSpliced(5000, 0, { id: 'new' });
+  assert.deepEqual(createPatch(from, to), [{ op: 'add', path: '/5000', value: { id: 'new' } }]);
+});
+
+test('returned values are independent of inputs and of repeated references', () => {
+  const shared = { nested: [1] };
+  const from = freeze({ keep: 1 });
+  const to = { keep: 1, a: shared, b: shared };
+  const patch = createPatch(from, to);
+  patch[0].value.nested.push(2);
+  assert.deepEqual(to.a.nested, [1]);
+  assert.deepEqual(patch[1].value.nested, [1]);
+  shared.nested.push(3);
+  assert.deepEqual(patch[1].value.nested, [1]);
+  const root = createPatch(null, { a: shared });
+  root[0].value.a.nested.push(4);
+  assert.deepEqual(shared.nested, [1, 3]);
+});
+
+test('validates both entire inputs even when identical or being replaced', () => {
+  const cycle = {};
+  cycle.self = cycle;
+  let reads = 0;
+  const accessor = Object.defineProperty({}, 'a', { enumerable: true, get() { reads++; return 1; } });
+  const customArray = [1];
+  customArray[Symbol.iterator] = () => { throw new Error('Iterator executed'); };
+  const invalid = [
+    undefined, NaN, Infinity, -Infinity, 1n, Symbol(), () => {},
+    new Date(), new Map(), new (class { a = 1; })(), cycle,
+    { nested: undefined }, [undefined], new Array(1), accessor,
+    Object.defineProperty({}, 'hidden', { value: 1 }), { [Symbol()]: 1 }, customArray,
+  ];
+  for (const value of invalid) {
+    assert.throws(() => createPatch(value, null), Error);
+    assert.throws(() => createPatch(null, value), Error);
+    assert.throws(() => createPatch(value, value), Error);
+  }
+  assert.equal(reads, 0);
+});
+
+test('round-trips all small arrays across multiple shifts and duplicate alignments', () => {
+  const arrays = [[]];
+  let level = [[]];
+  for (let length = 1; length <= 4; length++) {
+    level = level.flatMap(array => [0, 1, { a: 1 }].map(value => [...array, value]));
+    arrays.push(...level);
+  }
+  for (const from of arrays) {
+    for (const to of arrays) {
+      const patch = createPatch(from, to);
+      assert.deepEqual(applyPatch(from, JSON.parse(JSON.stringify(patch))), to);
+    }
+  }
+});
