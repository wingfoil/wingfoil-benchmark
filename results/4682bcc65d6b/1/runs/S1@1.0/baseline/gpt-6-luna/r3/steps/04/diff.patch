+/** Apply an RFC 7386 JSON Merge Patch and return a new document. */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJson(target, "Target document");
+  assertJson(patch, "JSON Merge Patch");
+  return mergePatchValue(target, patch);
+}
+
+function mergePatchValue(target: unknown, patch: unknown): unknown {
+  // Per RFC 7386, any non-object patch replaces the target completely.
+  // Arrays are JSON values, but are not JSON objects for merge purposes.
+  if (patch === null || typeof patch !== "object" || Array.isArray(patch)) {
+    return cloneJson(patch);
+  }
+
+  const result: Record<string, unknown> =
+    target !== null && typeof target === "object" && !Array.isArray(target)
+      ? cloneJson(target) as Record<string, unknown>
+      : {};
+
+  for (const key of Object.keys(patch)) {
+    const value = (patch as Record<string, unknown>)[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      Object.defineProperty(result, key, {
+        value: mergePatchValue(
+          Object.prototype.hasOwnProperty.call(result, key) ? result[key] : undefined,
+          value,
+        ),
+        writable: true,
+        enumerable: true,
+        configurable: true,
+      });
+    }
+  }
+
+  return result;
+}
