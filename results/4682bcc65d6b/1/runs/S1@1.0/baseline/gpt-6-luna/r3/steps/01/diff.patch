@@ -0,0 +1,49 @@
+/** Resolve a JSON Pointer (RFC 6901) against a JSON document. */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("JSON Pointer must be a string");
+  }
+
+  if (pointer === "") return document;
+  if (!pointer.startsWith("/")) {
+    throw new Error("A JSON Pointer must be empty or start with '/'");
+  }
+
+  const tokens = pointer.slice(1).split("/").map((token) => {
+    // RFC 6901 permits only these two tilde escapes. Decode ~1 first so
+    // that an escaped tilde followed by 1 is not decoded a second time.
+    if (/~(?![01])/.test(token)) {
+      throw new Error("Invalid escape sequence in JSON Pointer");
+    }
+    return token.replace(/~1/g, "/").replace(/~0/g, "~");
+  });
+
+  let value: unknown = document;
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      // The array index grammar disallows leading zeroes and the '-' token
+      // (which is only meaningful to JSON Patch, not JSON Pointer lookup).
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`Invalid array index in JSON Pointer: ${token}`);
+      }
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= value.length) {
+        throw new Error(`JSON Pointer does not resolve: ${token}`);
+      }
+      value = value[index];
+      continue;
+    }
+
+    if (value !== null && typeof value === "object") {
+      if (!Object.prototype.hasOwnProperty.call(value, token)) {
+        throw new Error(`JSON Pointer does not resolve: ${token}`);
+      }
+      value = (value as Record<string, unknown>)[token];
+      continue;
+    }
+
+    throw new Error(`JSON Pointer does not resolve: ${token}`);
+  }
+
+  return value;
+}
