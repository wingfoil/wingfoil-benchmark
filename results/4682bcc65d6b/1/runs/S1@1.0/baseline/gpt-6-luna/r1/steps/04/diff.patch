+
+/** Apply an RFC 7386 JSON Merge Patch and return the merged document. */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  // A non-object patch replaces the entire target, including when the patch is
+  // null or an array.
+  if (!isJsonObject(patch)) return cloneJson(patch);
+
+  // Object patches always operate on an object. A non-object target is treated
+  // as an empty object before applying the patch.
+  const result: Record<string, unknown> = isJsonObject(target)
+    ? cloneJson(target) as Record<string, unknown>
+    : {};
+
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setObjectMember(result, key, applyMergePatch(result[key], value));
+    }
+  }
+  return result;
+}
