+/** Resolve a value in a JSON document using an RFC 6901 JSON Pointer. */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new TypeError("JSON Pointer must be a string");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new TypeError("A non-empty JSON Pointer must start with '/'");
+  }
+
+  const tokens = pointer.slice(1).split("/").map((token) => {
+    // RFC 6901 permits only ~0 and ~1 escapes. Validate before replacing so
+    // strings such as ~01 correctly decode to ~1 rather than /.
+    if (/~(?![01])/.test(token)) {
+      throw new TypeError("Invalid escape sequence in JSON Pointer");
+    }
+    return token.replace(/~1/g, "/").replace(/~0/g, "~");
+  });
+
+  let value = document;
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      // Array indices are decimal integers without leading zeroes. The '-'
+      // token is reserved for appending in other JSON Pointer applications
+      // and never identifies an existing value.
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new RangeError(`Invalid array index in JSON Pointer: ${token}`);
+      }
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= value.length) {
+        throw new RangeError(`JSON Pointer does not resolve: ${pointer}`);
+      }
+      value = value[index];
+      continue;
+    }
+
+    if (value !== null && typeof value === "object" && Object.hasOwn(value, token)) {
+      value = (value as Record<string, unknown>)[token];
+      continue;
+    }
+
+    throw new RangeError(`JSON Pointer does not resolve: ${pointer}`);
+  }
+
+  return value;
+}
