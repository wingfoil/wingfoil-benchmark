+/**
+ * Resolve a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * The empty pointer refers to the whole document. Non-empty pointers must
+ * begin with `/`; each subsequent reference token is decoded and traversed
+ * through an object member or array element.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("JSON Pointer must be a string");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error("Invalid JSON Pointer: a non-empty pointer must start with '/'");
+  }
+
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+  let value = document;
+
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      // RFC 6901 array indices are unsigned decimal integers without leading
+      // zeroes (except for the index 0 itself). The '-' token is not a value
+      // reference; it is used by JSON Patch to denote an append position.
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`JSON Pointer does not resolve to a value: invalid array index '${token}'`);
+      }
+
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= value.length) {
+        throw new Error(`JSON Pointer does not resolve to a value: array index '${token}' is out of bounds`);
+      }
+      value = value[index];
+      continue;
+    }
+
+    if (value !== null && typeof value === "object") {
+      if (!Object.prototype.hasOwnProperty.call(value, token)) {
+        throw new Error(`JSON Pointer does not resolve to a value: member '${token}' does not exist`);
+      }
+      value = (value as Record<string, unknown>)[token];
+      continue;
+    }
+
+    throw new Error(`JSON Pointer does not resolve to a value at token '${token}'`);
+  }
+
+  return value;
+}
+
+function decodeToken(token: string): string {
+  // RFC 6901 defines only these two escapes. Validate before replacement so
+  // malformed or incomplete escapes cannot silently become literal tildes.
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: malformed escape in token '${token}'`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
