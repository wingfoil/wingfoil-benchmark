+/** Apply an RFC 7386 JSON Merge Patch without changing either input. */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  // Merge Patch is defined for JSON values. Validate both inputs up front so
+  // invalid JavaScript values cannot be silently dropped or changed by cloning.
+  assertJson(target);
+  assertJson(patch);
+  return mergePatchValue(target, patch);
+}
+
+function mergePatchValue(target: unknown, patch: unknown): unknown {
+  // Any non-object patch replaces the entire target, including null and arrays.
+  if (patch === null || typeof patch !== "object" || Array.isArray(patch)) {
+    return cloneJson(patch);
+  }
+
+  // An object patch applied to a non-object target starts with an empty object.
+  const result: Record<string, unknown> = target !== null && typeof target === "object" && !Array.isArray(target)
+    ? cloneJson(target) as Record<string, unknown>
+    : {};
+
+  for (const key of Object.keys(patch)) {
+    const value = (patch as Record<string, unknown>)[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      Object.defineProperty(result, key, {
+        value: mergePatchValue(result[key], value),
+        enumerable: true,
+        writable: true,
+        configurable: true,
+      });
+    }
+  }
+  return result;
+}
+
 function parsePointer(pointer: string): string[] {
   if (pointer === "") return [];
   if (!pointer.startsWith("/")) throw new Error("Invalid JSON Pointer: a non-empty pointer must start with '/'");
