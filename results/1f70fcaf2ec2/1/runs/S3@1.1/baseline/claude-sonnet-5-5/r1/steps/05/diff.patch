+test('cancel refunds fully 24h or more before start, nothing later, once only', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(10), end: d(12) });
+  assert.deepEqual(s.cancel(a.id, '2026-07-09T00:00:00Z'), { bookingId: a.id, refund: a.total });
+  assert.throws(() => s.cancel(a.id, '2026-07-09T00:00:00Z'));
+  assert.throws(() => s.cancel('nope', '2026-07-09T00:00:00Z'));
+  const b = s.book({ itemId: 'b1', start: d(10), end: d(12) });
+  assert.equal(s.cancel(b.id, '2026-07-09T00:00:01Z').refund, 0);
+  assert.deepEqual(s.availability({ start: d(10), end: d(12) }), ['b1']);
