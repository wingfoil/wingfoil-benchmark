diff --git a/test/rental.test.ts b/test/rental.test.ts
index 4318b3a13eaad2cdac5f72dfa18d2d424758ffea..9897d26176dcd6d5175e2e1e8f7b87b9d7fc2079 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -42,3 +42,19 @@ test('availability lists free items of a kind, sorted', () => {
   assert.deepEqual(s.availability({ start: d(3), end: d(4), kind: 'board' }), ['b0', 'b1']);
   assert.throws(() => s.availability({ start: d(3), end: d(3) }));
 });
+
+test('hourly rental is priced per hour and needs an hourly price', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 5000, hourlyPrice: 900 });
+  s.addEquipment({ id: 'n', kind: 'board', dailyPrice: 5000 });
+  const t = (h: number) => `2026-07-01T${String(h).padStart(2, '0')}:00:00Z`;
+  assert.equal(s.quote({ itemId: 'h', start: t(10), end: t(13) }).total, 2700);
+  assert.throws(() => s.quote({ itemId: 'n', start: t(10), end: t(13) }));
+  assert.throws(() => s.quote({ itemId: 'h', start: '2026-07-01T10:30:00Z', end: t(13) }));
+  assert.throws(() => s.quote({ itemId: 'h', start: t(10), end: '2026-07-02T10:00:00Z' }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+  s.book({ itemId: 'h', start: t(10), end: t(13) });
+  assert.throws(() => s.book({ itemId: 'h', start: t(12), end: t(14) }));
+  s.book({ itemId: 'h', start: t(13), end: t(14) });
+  assert.deepEqual(s.availability({ start: t(0), end: '2026-07-02T00:00:00Z' }), ['n']);
+});
