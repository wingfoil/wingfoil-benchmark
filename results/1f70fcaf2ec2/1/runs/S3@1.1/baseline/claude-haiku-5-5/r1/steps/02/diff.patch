diff --git a/test/rental.test.js b/test/rental.test.js
index ba18295436241e49d6f75f0d077deffb6d07d452..e4838ce0971609e7d17a34c141981f136bb1795b 100644
--- a/test/rental.test.js
+++ b/test/rental.test.js
@@ -129,3 +129,73 @@ test('addEquipment rejects invalid items and duplicate ids', () => {
   service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100 });
   assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100 }), /already exists/);
 });
+
+test('availability lists the free equipment of every kind, sorted, when no kind is given', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 1200 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1200 });
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    ['board-1', 'sail-1', 'sail-2'],
+  );
+});
+
+test('availability only lists equipment of the requested kind', () => {
+  const service = serviceWithBoard();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1200 });
+  const period = { start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' };
+  assert.deepEqual(service.availability({ ...period, kind: 'board' }), ['board-1']);
+  assert.deepEqual(service.availability({ ...period, kind: 'sail' }), ['sail-1']);
+});
+
+test('availability leaves out equipment booked for any part of the period', () => {
+  const service = serviceWithBoard();
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+  service.book({ itemId: 'board-1', start: '2026-07-03T00:00:00Z', end: '2026-07-05T00:00:00Z' });
+  const overlapping = { start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' };
+  assert.deepEqual(service.availability(overlapping), ['board-2']);
+  assert.deepEqual(service.availability({ ...overlapping, kind: 'board' }), ['board-2']);
+});
+
+test('availability keeps equipment whose bookings only touch the period', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.deepEqual(
+    service.availability({ start: '2026-07-04T00:00:00Z', end: '2026-07-06T00:00:00Z' }),
+    ['board-1'],
+  );
+  assert.deepEqual(
+    service.availability({ start: '2026-06-29T00:00:00Z', end: '2026-07-01T00:00:00Z' }),
+    ['board-1'],
+  );
+});
+
+test('availability does not reserve anything', () => {
+  const service = serviceWithBoard();
+  const period = { start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' };
+  service.availability(period);
+  assert.equal(service.book({ itemId: 'board-1', ...period }).total, 2500);
+});
+
+test('availability returns an empty list when nothing is free or no equipment matches', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.deepEqual(service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }), []);
+  assert.deepEqual(
+    service.availability({ start: '2026-07-10T00:00:00Z', end: '2026-07-11T00:00:00Z', kind: 'sail' }),
+    [],
+  );
+  assert.deepEqual(createRentalService().availability({ start: '2026-07-10T00:00:00Z', end: '2026-07-11T00:00:00Z' }), []);
+});
+
+test('availability rejects invalid periods and kinds', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.availability({ start: '2026-07-01T10:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.throws(() => service.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+  assert.throws(() => service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+  assert.throws(
+    () => service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'kite' }),
+    /kind/,
+  );
+});
