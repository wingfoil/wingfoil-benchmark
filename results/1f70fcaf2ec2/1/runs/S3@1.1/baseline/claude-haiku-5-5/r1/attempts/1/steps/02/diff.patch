diff --git a/test/rental.test.mjs b/test/rental.test.mjs
index 38cfe08615cd6758fd38df15f13d4f79cc137ed0..50f2f4fef3d66eedab2580a01e919a8b8fbfeaf1 100644
--- a/test/rental.test.mjs
+++ b/test/rental.test.mjs
@@ -91,3 +91,34 @@ test('equipment must be valid and unique', () => {
   service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100 });
   assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100 }), /already exists/);
 });
+
+test('availability lists the free equipment, sorted, optionally by kind', () => {
+  const service = serviceWithBoard();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  service.addEquipment({ id: 'board-0', kind: 'board', dailyPrice: 2000 });
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  const period = { start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' };
+  assert.deepEqual(service.availability(period), ['board-0', 'sail-1']);
+  assert.deepEqual(service.availability({ ...period, kind: 'board' }), ['board-0']);
+  assert.deepEqual(service.availability({ ...period, kind: 'sail' }), ['sail-1']);
+});
+
+test('availability treats touching periods as free and overlapping ones as busy', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.deepEqual(
+    service.availability({ start: '2026-07-04T00:00:00Z', end: '2026-07-05T00:00:00Z' }),
+    ['board-1'],
+  );
+  assert.deepEqual(
+    service.availability({ start: '2026-06-30T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    [],
+  );
+});
+
+test('availability validates its period and kind', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.availability({ start: '2026-07-01', end: '2026-07-02' }));
+  assert.throws(() => service.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.throws(() => service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'kite' }));
+});
