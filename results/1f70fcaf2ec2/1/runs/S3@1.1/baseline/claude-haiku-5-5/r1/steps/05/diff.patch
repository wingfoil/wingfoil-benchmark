diff --git a/test/rental.test.js b/test/rental.test.js
index 93f1661c1d44fe3930755ccae1a02f54c59607e5..3e0fb2a2bbf226da78bc5d4cd670e0bc2540c09c 100644
--- a/test/rental.test.js
+++ b/test/rental.test.js
@@ -312,3 +312,69 @@ test('addEquipment rejects an hourly price that is not a non-negative integer nu
   assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: -1 }), /hourly price/);
   service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 0 });
 });
+
+test('cancel before the rental starts refunds the whole total', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.deepEqual(service.cancel(booking.id, '2026-06-30T09:00:00Z'), { bookingId: booking.id, refund: 6750 });
+});
+
+test('cancel at or after the start of the rental refunds nothing', () => {
+  const service = serviceWithBoard();
+  const atStart = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  const during = service.book({ itemId: 'board-1', start: '2026-07-10T00:00:00Z', end: '2026-07-11T00:00:00Z' });
+  assert.equal(service.cancel(atStart.id, '2026-07-01T00:00:00Z').refund, 0);
+  assert.equal(service.cancel(during.id, '2026-07-10T12:30:00.500Z').refund, 0);
+});
+
+test('cancel frees the equipment for the cancelled period', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  const period = { start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' };
+  assert.deepEqual(service.availability(period), []);
+  service.cancel(booking.id, '2026-06-30T00:00:00Z');
+  assert.deepEqual(service.availability(period), ['board-1']);
+  assert.doesNotThrow(() => service.book({ itemId: 'board-1', ...period }));
+});
+
+test('cancel frees only the cancelled booking, not the others on the same item', () => {
+  const service = serviceWithBoard();
+  const first = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  service.book({ itemId: 'board-1', start: '2026-07-05T00:00:00Z', end: '2026-07-06T00:00:00Z' });
+  service.cancel(first.id, '2026-06-30T00:00:00Z');
+  assert.deepEqual(
+    service.availability({ start: '2026-07-05T00:00:00Z', end: '2026-07-06T00:00:00Z' }),
+    [],
+  );
+});
+
+test('a booking can only be cancelled once', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  service.cancel(booking.id, '2026-06-30T00:00:00Z');
+  assert.throws(() => service.cancel(booking.id, '2026-06-29T00:00:00Z'), /already cancelled/);
+});
+
+test('cancel rejects an unknown booking', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.cancel('nope', '2026-06-30T00:00:00Z'), /unknown booking/);
+});
+
+test('cancel rejects an invalid time and leaves the booking active', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  assert.throws(() => service.cancel(booking.id, '2026-07-01'), /at must be an ISO-8601 UTC time/);
+  assert.throws(() => service.cancel(booking.id, '2026-02-30T00:00:00Z'), /not a valid date/);
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    [],
+  );
+  assert.equal(service.cancel(booking.id, '2026-06-30T00:00:00Z').refund, 2500);
+});
+
+test('cancel of an hourly booking frees its hours', () => {
+  const service = serviceWithHourlyBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T14:00:00Z', end: '2026-07-01T17:00:00Z' });
+  assert.equal(service.cancel(booking.id, '2026-07-01T13:00:00Z').refund, 2400);
+  assert.equal(service.book({ itemId: 'board-1', start: '2026-07-01T15:00:00Z', end: '2026-07-01T16:00:00Z' }).total, 800);
+});
