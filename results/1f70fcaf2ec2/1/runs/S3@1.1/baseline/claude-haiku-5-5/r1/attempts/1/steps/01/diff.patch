index 0000000000000000000000000000000000000000..0b794d3abb3bd1c04a708f4ec1baaa728abe5ea8
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,124 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface EquipmentItem {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one day of rental, in euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  /** Midnight UTC, ISO-8601, e.g. "2026-07-01T00:00:00Z". */
+  start: string;
+  /** Midnight UTC of the day after the last rented day. */
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  /** Total price, in euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: EquipmentItem): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^(\d{4}-\d{2}-\d{2})T00:00:00(?:\.0+)?Z$/;
+
+function parseMidnightUtc(value: unknown, name: string): number {
+  const match = typeof value === 'string' ? MIDNIGHT_UTC.exec(value) : null;
+  if (match === null) {
+    throw new Error(`${name} must be midnight UTC in ISO-8601, e.g. 2026-07-01T00:00:00Z`);
+  }
+  const time = Date.parse(match[0]);
+  // Rejects calendar dates that do not exist, such as 2026-02-30.
+  if (Number.isNaN(time) || new Date(time).toISOString().slice(0, 10) !== match[1]) {
+    throw new Error(`${name} is not a valid date: ${match[0]}`);
+  }
+  return time;
+}
+
+interface Stored {
+  booking: Booking;
+  startMs: number;
+  endMs: number;
+}
+
+export function createRentalService(): RentalService {
+  const items = new Map<string, EquipmentItem>();
+  const bookings: Stored[] = [];
+  let bookingCount = 0;
+
+  function checkRequest(request: RentalRequest): { quote: Quote; startMs: number; endMs: number } {
+    const item = typeof request.itemId === 'string' ? items.get(request.itemId) : undefined;
+    if (item === undefined) {
+      throw new Error(`Unknown item: ${String(request.itemId)}`);
+    }
+    const startMs = parseMidnightUtc(request.start, 'start');
+    const endMs = parseMidnightUtc(request.end, 'end');
+    if (endMs <= startMs) {
+      throw new Error('end must be after start');
+    }
+    const days = (endMs - startMs) / DAY_MS;
+    return {
+      quote: {
+        itemId: item.id,
+        start: request.start,
+        end: request.end,
+        total: days * item.dailyPrice,
+      },
+      startMs,
+      endMs,
+    };
+  }
+
+  return {
+    addEquipment(item: EquipmentItem): void {
+      if (typeof item.id !== 'string' || item.id === '') {
+        throw new Error('Equipment id must be a non-empty string');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error(`Equipment kind must be 'board' or 'sail', got: ${String(item.kind)}`);
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice <= 0) {
+        throw new Error('dailyPrice must be a positive integer number of euro cents');
+      }
+      if (items.has(item.id)) {
+        throw new Error(`Equipment already exists: ${item.id}`);
+      }
+      items.set(item.id, { ...item });
+    },
+
+    quote(request: RentalRequest): Quote {
+      return checkRequest(request).quote;
+    },
+
+    book(request: RentalRequest): Booking {
+      const { quote, startMs, endMs } = checkRequest(request);
+      const clash = bookings.find(
+        (stored) =>
+          stored.booking.itemId === quote.itemId &&
+          stored.startMs < endMs &&
+          startMs < stored.endMs,
+      );
+      if (clash !== undefined) {
+        throw new Error(`Item ${quote.itemId} is already booked for an overlapping period`);
+      }
+      bookingCount += 1;
+      const booking: Booking = { id: `booking-${bookingCount}`, ...quote };
+      bookings.push({ booking, startMs, endMs });
+      return { ...booking };
+    },
+  };
+}
diff --git a/test/rental.test.mjs b/test/rental.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..38cfe08615cd6758fd38df15f13d4f79cc137ed0
--- /dev/null
+++ b/test/rental.test.mjs
@@ -0,0 +1,93 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function serviceWithBoard() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  return service;
+}
+
+test('quote multiplies the daily price by the number of days', () => {
+  const service = serviceWithBoard();
+  assert.deepEqual(
+    service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' }),
+    { itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z', total: 7500 },
+  );
+});
+
+test('book returns an id together with the quote', () => {
+  const service = serviceWithBoard();
+  const { id, ...rest } = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  assert.equal(typeof id, 'string');
+  assert.deepEqual(rest, { itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', total: 2500 });
+});
+
+test('an unknown item is rejected', () => {
+  const service = serviceWithBoard();
+  const request = { itemId: 'sail-9', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' };
+  assert.throws(() => service.quote(request), /Unknown item/);
+  assert.throws(() => service.book(request), /Unknown item/);
+});
+
+test('periods must start and end at midnight UTC', () => {
+  const service = serviceWithBoard();
+  const badTimes = [
+    ['2026-07-01T10:00:00Z', '2026-07-02T00:00:00Z'],
+    ['2026-07-01T00:00:00Z', '2026-07-02T12:00:00Z'],
+    ['2026-07-01T00:00:00+02:00', '2026-07-02T00:00:00Z'],
+    ['2026-07-01', '2026-07-02'],
+    ['2026-02-30T00:00:00Z', '2026-03-01T00:00:00Z'],
+  ];
+  for (const [start, end] of badTimes) {
+    assert.throws(() => service.quote({ itemId: 'board-1', start, end }));
+  }
+});
+
+test('a period must end after it starts', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+});
+
+test('an item cannot be booked for overlapping periods', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-03T00:00:00Z', end: '2026-07-05T00:00:00Z' }), /overlapping/);
+  assert.throws(() => service.book({ itemId: 'board-1', start: '2026-06-30T00:00:00Z', end: '2026-07-02T00:00:00Z' }), /overlapping/);
+  assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' }), /overlapping/);
+});
+
+test('periods that only touch do not overlap', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  const second = service.book({ itemId: 'board-1', start: '2026-07-04T00:00:00Z', end: '2026-07-05T00:00:00Z' });
+  assert.equal(second.total, 2500);
+});
+
+test('quote does not check availability', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.equal(
+    service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }).total,
+    2500,
+  );
+});
+
+test('different items do not block each other', () => {
+  const service = serviceWithBoard();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  const booking = service.book({ itemId: 'sail-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.equal(booking.total, 4500);
+});
+
+test('equipment must be valid and unique', () => {
+  const service = createRentalService();
+  assert.throws(() => service.addEquipment({ id: '', kind: 'board', dailyPrice: 100 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'kite', dailyPrice: 100 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 0 }));
+  service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100 });
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100 }), /already exists/);
+});
