+
+function serviceWithHourlyBoard() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 800 });
+  return service;
+}
+
+test('quote charges the hourly price for each hour of a rental shorter than a day', () => {
+  const service = serviceWithHourlyBoard();
+  assert.deepEqual(
+    service.quote({ itemId: 'board-1', start: '2026-07-01T14:00:00Z', end: '2026-07-01T17:00:00Z' }),
+    { itemId: 'board-1', start: '2026-07-01T14:00:00Z', end: '2026-07-01T17:00:00Z', total: 2400 },
+  );
+});
+
+test('quote charges hourly rentals that cross midnight by the hour', () => {
+  const service = serviceWithHourlyBoard();
+  assert.equal(service.quote({ itemId: 'board-1', start: '2026-07-01T22:00:00Z', end: '2026-07-02T02:00:00Z' }).total, 3200);
+});
+
+test('quote charges a rental of exactly one day at the daily price, not the hourly price', () => {
+  const service = serviceWithHourlyBoard();
+  assert.equal(service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }).total, 2500);
+});
+
+test('quote does not apply the long-stay discount to hourly rentals', () => {
+  const service = serviceWithHourlyBoard();
+  assert.equal(service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-01T23:00:00Z' }).total, 18400);
+});
+
+test('quote rejects hourly rentals of an item without an hourly price', () => {
+  const service = serviceWithBoard();
+  const afternoon = { itemId: 'board-1', start: '2026-07-01T14:00:00Z', end: '2026-07-01T17:00:00Z' };
+  assert.throws(() => service.quote(afternoon), /cannot be rented by the hour/);
+  assert.throws(() => service.book(afternoon), /cannot be rented by the hour/);
+});
+
+test('book reserves only the hours rented', () => {
+  const service = serviceWithHourlyBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T14:00:00Z', end: '2026-07-01T17:00:00Z' });
+  assert.equal(booking.total, 2400);
+  assert.throws(
+    () => service.book({ itemId: 'board-1', start: '2026-07-01T16:00:00Z', end: '2026-07-01T18:00:00Z' }),
+    /overlapping/,
+  );
+  assert.equal(service.book({ itemId: 'board-1', start: '2026-07-01T17:00:00Z', end: '2026-07-01T18:00:00Z' }).total, 800);
+});
+
+test('availability leaves out equipment booked for part of an hourly period', () => {
+  const service = serviceWithHourlyBoard();
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+  service.book({ itemId: 'board-1', start: '2026-07-01T14:00:00Z', end: '2026-07-01T17:00:00Z' });
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T16:00:00Z', end: '2026-07-01T18:00:00Z' }),
+    ['board-2'],
+  );
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T17:00:00Z', end: '2026-07-01T18:00:00Z' }),
+    ['board-1', 'board-2'],
+  );
+});
+
+test('addEquipment rejects an hourly price that is not a non-negative integer number of cents', () => {
+  const service = createRentalService();
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 8.5 }), /hourly price/);
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: -1 }), /hourly price/);
+  service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 0 });
+});
