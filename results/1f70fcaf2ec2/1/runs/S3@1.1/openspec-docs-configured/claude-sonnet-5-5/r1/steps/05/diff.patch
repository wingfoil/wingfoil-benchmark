diff --git a/src/index.test.ts b/src/index.test.ts
index 92b832fabbe341864e86e69c86b25caf3b0db958..7740fdfc76c1d6578b7d5276195ae9f2b58215f2 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -114,3 +114,22 @@ test('hourly rentals need an hourly price and whole hours', () => {
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
   assert.throws(() => s.addEquipment({ id: 'y', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
 });
+
+test('cancel refunds before the start, releases the equipment and works once', () => {
+  const s = setup();
+  const a = s.book(r('b1', '2026-07-01T00:00:00Z', '2026-07-04T00:00:00Z'));
+  assert.deepEqual(s.cancel(a.id, '2026-06-30T23:59:59Z'), { bookingId: a.id, refund: 6750 });
+  assert.throws(() => s.cancel(a.id, '2026-06-30T23:59:59Z'));
+  assert.deepEqual(s.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' }), ['b1', 's1']);
+  const b = s.book(r('b1', '2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z'));
+  assert.notEqual(b.id, a.id);
+});
+
+test('cancel after the start refunds nothing; unknown, invalid or finished are rejected', () => {
+  const s = setup();
+  const a = s.book(r('b1', '2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.throws(() => s.cancel('nope', '2026-06-01T00:00:00Z'));
+  assert.throws(() => s.cancel(a.id, 'yesterday'));
+  assert.throws(() => s.cancel(a.id, '2026-07-03T00:00:00Z'));
+  assert.deepEqual(s.cancel(a.id, '2026-07-01T00:00:00Z'), { bookingId: a.id, refund: 0 });
+});
