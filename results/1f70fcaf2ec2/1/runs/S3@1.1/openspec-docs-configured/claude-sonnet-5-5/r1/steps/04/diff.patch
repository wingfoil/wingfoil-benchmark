diff --git a/src/index.test.ts b/src/index.test.ts
index d9ed87a1dfc802c4c6b40f7d53fa43511ca89368..92b832fabbe341864e86e69c86b25caf3b0db958 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -86,3 +86,31 @@ test('availability lists the sorted ids of equipment free for the whole period',
   assert.throws(() => q('2026-07-01', '2026-07-02'));
   assert.throws(() => q('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z', 'kite' as 'board'));
 });
+
+test('rentals shorter than a day on the hour are priced per hour', () => {
+  const s = setup();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 4000, hourlyPrice: 900 });
+  const q = s.quote(r('h1', '2026-07-01T14:00:00Z', '2026-07-01T17:00:00Z'));
+  assert.deepEqual(q, {
+    itemId: 'h1',
+    start: '2026-07-01T14:00:00.000Z',
+    end: '2026-07-01T17:00:00.000Z',
+    total: 2700,
+  });
+  assert.equal(s.quote(r('h1', '2026-07-01T20:00:00Z', '2026-07-02T10:00:00Z')).total, 12600);
+  assert.equal(s.book(r('h1', '2026-07-01T14:00:00Z', '2026-07-01T15:00:00Z')).total, 900);
+  assert.throws(() => s.book(r('h1', '2026-07-01T14:30:00Z', '2026-07-01T16:00:00Z')));
+  assert.throws(() => s.book(r('h1', '2026-07-01T14:00:00Z', '2026-07-01T16:00:00Z')));
+  assert.deepEqual(s.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'board' }), ['b1']);
+});
+
+test('hourly rentals need an hourly price and whole hours', () => {
+  const s = setup();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 4000, hourlyPrice: 900 });
+  assert.throws(() => s.quote(r('b1', '2026-07-01T14:00:00Z', '2026-07-01T16:00:00Z')));
+  assert.throws(() => s.quote(r('h1', '2026-07-01T14:30:00Z', '2026-07-01T16:00:00Z')));
+  assert.throws(() => s.quote(r('h1', '2026-07-01T16:00:00Z', '2026-07-01T14:00:00Z')));
+  assert.throws(() => s.quote(r('h1', '2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z')));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'y', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+});
