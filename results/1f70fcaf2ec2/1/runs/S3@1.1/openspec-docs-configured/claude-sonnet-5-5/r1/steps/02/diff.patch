diff --git a/src/index.test.ts b/src/index.test.ts
index b951ec0d35ff87d50c202c3dd25ac77e98aed104..2a1c5786cec0b1d64a363ab955b1e9615eb9798b 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -62,3 +62,17 @@ test('addEquipment validates its input', () => {
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'kite' as 'board', dailyPrice: 100 }));
 });
+
+test('availability lists the sorted ids of equipment free for the whole period', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 2000 });
+  s.book(r('b1', '2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  const q = (start: string, end: string, kind?: 'board' | 'sail') => s.availability({ start, end, kind });
+  assert.deepEqual(q('2026-07-02T00:00:00Z', '2026-07-04T00:00:00Z'), ['a0', 's1']);
+  assert.deepEqual(q('2026-07-02T00:00:00Z', '2026-07-04T00:00:00Z', 'board'), ['a0']);
+  assert.deepEqual(q('2026-07-03T00:00:00Z', '2026-07-04T00:00:00Z', 'board'), ['a0', 'b1']);
+  assert.deepEqual(q('2026-06-30T00:00:00Z', '2026-07-01T00:00:00Z'), ['a0', 'b1', 's1']);
+  assert.throws(() => q('2026-07-04T00:00:00Z', '2026-07-02T00:00:00Z'));
+  assert.throws(() => q('2026-07-01', '2026-07-02'));
+  assert.throws(() => q('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z', 'kite' as 'board'));
+});
