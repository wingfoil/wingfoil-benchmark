+++ b/src/index.test.ts
@@ -0,0 +1,64 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  return s;
+}
+const r = (itemId: string, start: string, end: string) => ({ itemId, start, end });
+
+test('quote multiplies the daily price by the number of days', () => {
+  const q = setup().quote(r('b1', '2026-07-01T00:00:00Z', '2026-07-04T00:00:00.000Z'));
+  assert.deepEqual(q, {
+    itemId: 'b1',
+    start: '2026-07-01T00:00:00.000Z',
+    end: '2026-07-04T00:00:00.000Z',
+    total: 7500,
+  });
+});
+
+test('quote and book reject unknown items and invalid periods', () => {
+  const s = setup();
+  const bad = [
+    r('nope', '2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z'),
+    r('b1', '2026-07-01T10:00:00Z', '2026-07-02T00:00:00Z'),
+    r('b1', '2026-07-01T00:00:00Z', '2026-07-02T12:00:00Z'),
+    r('b1', '2026-07-02T00:00:00Z', '2026-07-01T00:00:00Z'),
+    r('b1', '2026-07-01T00:00:00Z', '2026-07-01T00:00:00Z'),
+    r('b1', '2026-07-01', '2026-07-02'),
+    r('b1', '2026-07-01T00:00:00+02:00', '2026-07-02T00:00:00Z'),
+    r('b1', '2026-02-30T00:00:00Z', '2026-03-02T00:00:00Z'),
+  ];
+  for (const req of bad) {
+    assert.throws(() => s.quote(req));
+    assert.throws(() => s.book(req));
+  }
+});
+
+test('book returns a booking with an id and refuses overlaps', () => {
+  const s = setup();
+  const a = s.book(r('b1', '2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.equal(a.total, 5000);
+  assert.ok(a.id);
+  assert.throws(() => s.book(r('b1', '2026-07-02T00:00:00Z', '2026-07-04T00:00:00Z')));
+  assert.throws(() => s.book(r('b1', '2026-06-29T00:00:00Z', '2026-07-02T00:00:00Z')));
+  assert.throws(() => s.book(r('b1', '2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z')));
+});
+
+test('adjacent periods and other items do not clash', () => {
+  const s = setup();
+  const a = s.book(r('b1', '2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  const b = s.book(r('b1', '2026-07-03T00:00:00Z', '2026-07-04T00:00:00Z'));
+  const c = s.book(r('s1', '2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.equal(new Set([a.id, b.id, c.id]).size, 3);
+});
+
+test('addEquipment validates its input', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'kite' as 'board', dailyPrice: 100 }));
+});
