diff --git a/src/index.ts b/src/index.ts
index aba83be060cb2e73074cb4b7503028a9d5d5a98c..9ebd564e056e0c02b45c916bf9e0918ac4b46d47 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -23,10 +23,17 @@ export interface Booking extends Quote {
   id: string;
 }
 
+export interface AvailabilityQuery {
+  start: string;
+  end: string;
+  kind?: EquipmentKind;
+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  availability(query: AvailabilityQuery): string[];
 }
 
 const DAY_MS = 86_400_000;
@@ -93,5 +100,22 @@ export function createRentalService(): RentalService {
       counter += 1;
       return { id: `booking-${counter}`, itemId: request.itemId, start: request.start, end: request.end, total };
     },
+
+    availability(query) {
+      const start = parseUtc(query?.start, 'start');
+      const end = parseUtc(query.end, 'end');
+      if (end <= start) throw new Error('end must be after start');
+      const { kind } = query;
+      if (kind !== undefined && kind !== 'board' && kind !== 'sail') {
+        throw new Error("kind must be 'board' or 'sail'");
+      }
+      const free: string[] = [];
+      for (const item of items.values()) {
+        if (kind !== undefined && item.kind !== kind) continue;
+        const taken = bookings.get(item.id) ?? [];
+        if (!taken.some((b) => start < b.end && b.start < end)) free.push(item.id);
+      }
+      return free.sort();
+    },
   };
 }
diff --git a/test/rental.test.ts b/test/rental.test.ts
index 4d82c9c67cfec43f05062f0babba0604fbcef368..405a0a78198013f12b65bbb35bea67121969b322 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -73,5 +73,47 @@ test('book throws for unknown item or bad period and leaves no trace', () => {
 });
 
 test('no cancel operation is exposed', () => {
-  assert.deepEqual(Object.keys(createRentalService()).sort(), ['addEquipment', 'book', 'quote']);
+  assert.deepEqual(Object.keys(createRentalService()).sort(), ['addEquipment', 'availability', 'book', 'quote']);
+});
+
+test('availability lists free items of any kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2000 });
+  s.book({ itemId: 'b1', start: D(10), end: D(13) });
+  assert.deepEqual(s.availability({ start: D(11), end: D(12) }), ['b2', 's1']);
+});
+
+test('availability filters by kind', () => {
+  const s = setup();
+  assert.deepEqual(s.availability({ start: D(11), end: D(12), kind: 'sail' }), ['s1']);
+  assert.deepEqual(s.availability({ start: D(11), end: D(12), kind: 'board' }), ['b1']);
+});
+
+test('availability excludes overlaps but keeps touching periods', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: D(10), end: D(13) });
+  assert.deepEqual(s.availability({ start: D(12), end: D(15), kind: 'board' }), []);
+  assert.deepEqual(s.availability({ start: D(8), end: D(11), kind: 'board' }), []);
+  assert.deepEqual(s.availability({ start: D(9), end: D(14), kind: 'board' }), []);
+  assert.deepEqual(s.availability({ start: D(13), end: D(15), kind: 'board' }), ['b1']);
+  assert.deepEqual(s.availability({ start: D(8), end: D(10), kind: 'board' }), ['b1']);
+});
+
+test('availability returns an empty array when nothing matches', () => {
+  assert.deepEqual(createRentalService().availability({ start: D(10), end: D(11) }), []);
+});
+
+test('availability rejects invalid period or kind', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: '2026-07-10T09:00:00Z', end: D(11) }));
+  assert.throws(() => s.availability({ start: D(10), end: D(10) }));
+  assert.throws(() => s.availability({ start: D(11), end: D(10) }));
+  assert.throws(() => s.availability({ start: 'garbage', end: D(11) }));
+  assert.throws(() => s.availability({ start: D(10), end: D(11), kind: 'kayak' as any }));
+});
+
+test('availability does not reserve', () => {
+  const s = setup();
+  s.availability({ start: D(10), end: D(13) });
+  assert.doesNotThrow(() => s.book({ itemId: 'b1', start: D(10), end: D(13) }));
 });
