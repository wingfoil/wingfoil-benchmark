@@ -0,0 +1,77 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+const D = (d: number) => `2026-07-${String(d).padStart(2, '0')}T00:00:00.000Z`;
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  return s;
+}
+
+test('addEquipment rejects invalid and duplicate items', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'kayak' as any, dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: '', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+});
+
+test('quote totals days times daily price', () => {
+  const s = setup();
+  assert.deepEqual(s.quote({ itemId: 'b1', start: D(10), end: D(13) }), {
+    itemId: 'b1', start: D(10), end: D(13), total: 7500,
+  });
+  assert.equal(s.quote({ itemId: 'b1', start: '2026-07-10T00:00:00Z', end: '2026-07-11T00:00:00Z' }).total, 2500);
+});
+
+test('quote rejects unknown item and bad periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'nope', start: D(10), end: D(11) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-10T09:00:00Z', end: D(11) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: D(10), end: '2026-07-11T00:00:00+02:00' }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: 'garbage', end: D(11) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-02-30T00:00:00Z', end: D(11) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: D(10), end: D(10) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: D(11), end: D(10) }));
+});
+
+test('quote does not reserve', () => {
+  const s = setup();
+  s.quote({ itemId: 'b1', start: D(10), end: D(13) });
+  assert.doesNotThrow(() => s.book({ itemId: 'b1', start: D(10), end: D(13) }));
+});
+
+test('book returns a booking with unique id and quoted total', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: D(10), end: D(12) });
+  const b = s.book({ itemId: 's1', start: D(10), end: D(12) });
+  assert.equal(a.total, 5000);
+  assert.equal(a.itemId, 'b1');
+  assert.notEqual(a.id, b.id);
+});
+
+test('book refuses overlaps but allows touching periods and other items', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: D(10), end: D(13) });
+  assert.throws(() => s.book({ itemId: 'b1', start: D(12), end: D(14) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: D(9), end: D(11) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: D(11), end: D(12) }));
+  assert.doesNotThrow(() => s.book({ itemId: 'b1', start: D(13), end: D(15) }));
+  assert.doesNotThrow(() => s.book({ itemId: 'b1', start: D(8), end: D(10) }));
+  assert.doesNotThrow(() => s.book({ itemId: 's1', start: D(10), end: D(13) }));
+});
+
+test('book throws for unknown item or bad period and leaves no trace', () => {
+  const s = setup();
+  assert.throws(() => s.book({ itemId: 'nope', start: D(10), end: D(11) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: '2026-07-10T01:00:00Z', end: D(11) }));
+  assert.doesNotThrow(() => s.book({ itemId: 'b1', start: D(10), end: D(11) }));
+});
+
+test('no cancel operation is exposed', () => {
+  assert.deepEqual(Object.keys(createRentalService()).sort(), ['addEquipment', 'book', 'quote']);
+});
