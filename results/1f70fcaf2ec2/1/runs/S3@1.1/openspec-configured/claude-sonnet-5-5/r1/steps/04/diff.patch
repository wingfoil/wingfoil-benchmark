+++ b/test/rental.test.ts
@@ -132,3 +132,46 @@ test('availability does not reserve', () => {
   s.availability({ start: D(10), end: D(13) });
   assert.doesNotThrow(() => s.book({ itemId: 'b1', start: D(10), end: D(13) }));
 });
+
+const T = (d: number, h: number) => `2026-07-${String(d).padStart(2, '0')}T${String(h).padStart(2, '0')}:00:00.000Z`;
+
+function hourly() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  return s;
+}
+
+test('addEquipment validates hourlyPrice', () => {
+  const s = createRentalService();
+  assert.doesNotThrow(() => s.addEquipment({ id: 'a', kind: 'board', dailyPrice: 1, hourlyPrice: 0 }));
+  assert.doesNotThrow(() => s.addEquipment({ id: 'b', kind: 'board', dailyPrice: 1, hourlyPrice: 600 }));
+  assert.throws(() => s.addEquipment({ id: 'c', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'd', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: 'e', kind: 'board', dailyPrice: 1, hourlyPrice: null as any }));
+});
+
+test('quote prices hourly periods per hour', () => {
+  const s = hourly();
+  assert.equal(s.quote({ itemId: 'b1', start: T(10, 13), end: T(10, 17) }).total, 2400);
+  assert.equal(s.quote({ itemId: 'b1', start: T(10, 22), end: T(11, 2) }).total, 2400);
+  assert.equal(s.quote({ itemId: 'b1', start: T(10, 0), end: T(10, 23) }).total, 13800);
+  assert.equal(s.quote({ itemId: 'b1', start: T(10, 0), end: T(11, 0) }).total, 2500);
+});
+
+test('hourly quote rejects items without hourly price and bad periods', () => {
+  const s = hourly();
+  assert.throws(() => s.quote({ itemId: 's1', start: T(10, 13), end: T(10, 17) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-10T09:30:00Z', end: T(10, 17) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: T(10, 9), end: '2026-07-10T17:00:01Z' }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: T(10, 9), end: T(11, 9) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: T(10, 9), end: T(13, 0) }));
+});
+
+test('hourly bookings total like the quote and overlap on exact times', () => {
+  const s = hourly();
+  assert.equal(s.book({ itemId: 'b1', start: T(10, 13), end: T(10, 17) }).total, 2400);
+  assert.throws(() => s.book({ itemId: 'b1', start: T(10, 16), end: T(10, 18) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: D(10), end: D(11) }));
+  assert.doesNotThrow(() => s.book({ itemId: 'b1', start: T(10, 17), end: T(10, 19) }));
+});
