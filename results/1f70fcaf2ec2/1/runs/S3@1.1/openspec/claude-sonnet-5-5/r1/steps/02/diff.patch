diff --git a/src/rental.test.ts b/src/rental.test.ts
index ee8f518ef363b106ffc4aa02de0c80c2dfdd617b..8ca5dd6ebfb8f5ffcb2c74bb93b4c029a6092d50 100644
--- a/src/rental.test.ts
+++ b/src/rental.test.ts
@@ -56,3 +56,46 @@ test('overlaps rejected, touching allowed, failure changes nothing', () => {
 test('no cancellation operation is exposed', () => {
   assert.equal('cancel' in createRentalService(), false);
 });
+
+function availabilitySetup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 1 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1 });
+  s.addEquipment({ id: 'b10', kind: 'board', dailyPrice: 1 });
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 });
+  s.book({ itemId: 'b1', start: d('01'), end: d('04') });
+  return s;
+}
+
+test('availability lists free ids sorted, any kind or filtered', () => {
+  const s = availabilitySetup();
+  assert.deepEqual(s.availability({ start: d('02'), end: d('03') }), ['b10', 'b2', 's1']);
+  assert.deepEqual(s.availability({ start: d('02'), end: d('03'), kind: 'board' }), ['b10', 'b2']);
+  assert.deepEqual(s.availability({ start: d('02'), end: d('03'), kind: 'sail' }), ['s1']);
+});
+
+test('availability excludes partial overlaps but not touching bookings', () => {
+  const s = availabilitySetup();
+  assert.ok(!s.availability({ start: d('03'), end: d('06') }).includes('b1'));
+  assert.ok(!s.availability({ start: d('01'), end: d('02') }).includes('b1'));
+  assert.ok(s.availability({ start: d('04'), end: d('06') }).includes('b1'));
+});
+
+test('availability can be empty', () => {
+  const s = createRentalService();
+  assert.deepEqual(s.availability({ start: d('01'), end: d('02') }), []);
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 });
+  assert.deepEqual(s.availability({ start: d('01'), end: d('02'), kind: 'sail' }), []);
+  s.book({ itemId: 'b1', start: d('01'), end: d('02') });
+  assert.deepEqual(s.availability({ start: d('01'), end: d('02') }), []);
+});
+
+test('availability rejects invalid period or kind and does not reserve', () => {
+  const s = availabilitySetup();
+  assert.throws(() => s.availability({ start: '2026-07-01T10:00:00.000Z', end: d('02') }));
+  assert.throws(() => s.availability({ start: d('02'), end: d('02') }));
+  assert.throws(() => s.availability({ start: d('02'), end: d('03'), kind: 'kayak' as any }));
+  assert.throws(() => s.availability({ start: d('02'), end: d('03'), kind: null as any }));
+  s.availability({ start: d('05'), end: d('06') });
+  assert.ok(s.book({ itemId: 's1', start: d('05'), end: d('06') }));
+});
