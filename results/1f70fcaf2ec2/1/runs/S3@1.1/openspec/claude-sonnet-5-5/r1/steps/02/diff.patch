 }
 
+export interface AvailabilityQuery {
+  start: string;
+  end: string;
+  kind?: EquipmentKind;
+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  availability(query: AvailabilityQuery): string[];
 }
 
 export function createRentalService(): RentalService {
@@ -82,5 +89,17 @@ export function createRentalService(): RentalService {
       bookings.set(item.id, existing);
       return booking;
     },
+
+    availability(query) {
+      const period = parsePeriod(query);
+      const kind = query.kind;
+      if (kind !== undefined && kind !== 'board' && kind !== 'sail') {
+        throw new Error("kind must be 'board' or 'sail'");
+      }
+      return [...equipment.values()]
+        .filter((item) => (kind === undefined || item.kind === kind) && !(bookings.get(item.id) ?? []).some((b) => overlaps(b, period)))
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
