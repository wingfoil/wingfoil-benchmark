+/**
+ * Validates a UTC period and returns it in canonical form with its length.
+ * A period is either whole days (both bounds at midnight) or, when `allowHourly` is set,
+ * an hourly period (both bounds on the hour, under a day long); `hours` is set only for the latter.
+ */
+export function parsePeriod(
+  period: Period,
+  allowHourly = false,
+): { start: string; end: string; startMs: number; endMs: number; days: number; hours?: number } {
+  const startMs = parseOnTheHour(period?.start, 'start');
+  const endMs = parseOnTheHour(period?.end, 'end');
   if (endMs <= startMs) {
     throw new Error('end must be after start');
   }
