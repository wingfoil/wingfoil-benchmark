+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+const d = (n: string) => `2026-07-${n}T00:00:00.000Z`;
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2500 });
+  return s;
+}
+
+test('addEquipment validates', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'kayak' as any, dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 12.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'sail', dailyPrice: 1 }));
+  assert.equal(s.quote({ itemId: 'b1', start: d('01'), end: d('02') }).total, 2500);
+});
+
+test('quote totals in cents and does not reserve', () => {
+  const s = setup();
+  assert.deepEqual(s.quote({ itemId: 'b1', start: d('01'), end: d('04') }), { itemId: 'b1', start: d('01'), end: d('04'), total: 7500 });
+  assert.ok(s.book({ itemId: 'b1', start: d('01'), end: d('04') }));
+});
+
+test('unknown item and invalid period throw', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'nope', start: d('01'), end: d('02') }));
+  assert.throws(() => s.book({ itemId: 'nope', start: d('01'), end: d('02') }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T10:00:00.000Z', end: d('02') }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d('02'), end: d('01') }));
+});
+
+test('book returns unique ids and the quoted total', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d('01'), end: d('03') });
+  const b = s.book({ itemId: 'b2', start: d('01'), end: d('03') });
+  assert.notEqual(a.id, b.id);
+  assert.equal(a.total, 5000);
+  assert.equal(a.itemId, 'b1');
+});
+
+test('overlaps rejected, touching allowed, failure changes nothing', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: d('01'), end: d('04') });
+  assert.throws(() => s.book({ itemId: 'b1', start: d('03'), end: d('05') }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d('02'), end: d('03') }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d('01'), end: d('10') }));
+  s.book({ itemId: 'b1', start: d('04'), end: d('06') });
+  s.book({ itemId: 'b2', start: d('01'), end: d('04') });
+});
+
+test('no cancellation operation is exposed', () => {
+  assert.equal('cancel' in createRentalService(), false);
+});
diff --git a/src/rental.ts b/src/rental.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bed7d89285cfff3bb85990a8b4e8340ff5671602
--- /dev/null
+++ b/src/rental.ts
@@ -0,0 +1,86 @@
+import { randomUUID } from 'node:crypto';
+import { overlaps, parsePeriod } from './period.ts';
+
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings = new Map<string, Array<Booking & { startMs: number; endMs: number }>>();
+
+  function price(request: RentalRequest) {
+    const item = equipment.get(request?.itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${request?.itemId}`);
+    }
+    const period = parsePeriod(request);
+    const total = item.dailyPrice * period.days;
+    if (!Number.isSafeInteger(total)) {
+      throw new Error('total is too large');
+    }
+    return { item, period, total };
+  }
+
+  return {
+    addEquipment(item) {
+      if (!item || typeof item.id !== 'string' || item.id === '') {
+        throw new Error('id must be a non-empty string');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error("kind must be 'board' or 'sail'");
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of cents');
+      }
+      if (equipment.has(item.id)) {
+        throw new Error(`equipment already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      const { item, period, total } = price(request);
+      return { itemId: item.id, start: period.start, end: period.end, total };
+    },
+
+    book(request) {
+      const { item, period, total } = price(request);
+      const existing = bookings.get(item.id) ?? [];
+      if (existing.some((b) => overlaps(b, period))) {
+        throw new Error(`${item.id} is not free for the whole period`);
+      }
+      const booking = { id: randomUUID(), itemId: item.id, start: period.start, end: period.end, total };
+      existing.push({ ...booking, startMs: period.startMs, endMs: period.endMs });
+      bookings.set(item.id, existing);
+      return booking;
+    },
+  };
+}
