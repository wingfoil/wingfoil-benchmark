+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { overlaps, parsePeriod } from './period.ts';
+
+test('valid period counts days', () => {
+  const p = parsePeriod({ start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00Z' });
+  assert.equal(p.days, 2);
+  assert.equal(p.end, '2026-07-03T00:00:00.000Z');
+});
+
+test('rejects non-midnight, offsets, non-dates, reversed and empty', () => {
+  const bad = [
+    ['2026-07-01T10:00:00.000Z', '2026-07-03T00:00:00.000Z'],
+    ['2026-07-01T00:00:00+02:00', '2026-07-03T00:00:00.000Z'],
+    ['not a date', '2026-07-03T00:00:00.000Z'],
+    ['2026-02-30T00:00:00.000Z', '2026-07-03T00:00:00.000Z'],
+    ['2026-07-03T00:00:00.000Z', '2026-07-01T00:00:00.000Z'],
+    ['2026-07-01T00:00:00.000Z', '2026-07-01T00:00:00.000Z'],
+  ];
+  for (const [start, end] of bad) assert.throws(() => parsePeriod({ start, end }), start);
+});
+
+test('touching periods do not overlap, intersecting ones do', () => {
+  const p = (s: string, e: string) => parsePeriod({ start: `2026-07-${s}T00:00:00.000Z`, end: `2026-07-${e}T00:00:00.000Z` });
+  assert.equal(overlaps(p('01', '03'), p('03', '05')), false);
+  assert.equal(overlaps(p('01', '04'), p('03', '05')), true);
+  assert.equal(overlaps(p('01', '10'), p('04', '05')), true);
+});
