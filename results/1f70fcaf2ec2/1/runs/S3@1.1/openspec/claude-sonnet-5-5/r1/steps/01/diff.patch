index 0000000000000000000000000000000000000000..df49f664ab9f3148d0b337e86edf1b2d262a7e27
--- /dev/null
+++ b/src/period.ts
@@ -0,0 +1,39 @@
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00:00(\.000)?Z$/;
+
+export interface Period {
+  start: string;
+  end: string;
+}
+
+function parseMidnight(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC string at midnight`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms) || ms % DAY_MS !== 0 || new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a valid date`);
+  }
+  return ms;
+}
+
+/** Validates a whole-day UTC period; returns it in canonical form with its length in days. */
+export function parsePeriod(period: Period): { start: string; end: string; startMs: number; endMs: number; days: number } {
+  const startMs = parseMidnight(period?.start, 'start');
+  const endMs = parseMidnight(period?.end, 'end');
+  if (endMs <= startMs) {
+    throw new Error('end must be after start');
+  }
+  return {
+    start: new Date(startMs).toISOString(),
+    end: new Date(endMs).toISOString(),
+    startMs,
+    endMs,
+    days: (endMs - startMs) / DAY_MS,
+  };
+}
+
+/** Half-open intervals [start, end): periods that only touch do not overlap. */
+export function overlaps(a: { startMs: number; endMs: number }, b: { startMs: number; endMs: number }): boolean {
+  return a.startMs < b.endMs && b.startMs < a.endMs;
+}
