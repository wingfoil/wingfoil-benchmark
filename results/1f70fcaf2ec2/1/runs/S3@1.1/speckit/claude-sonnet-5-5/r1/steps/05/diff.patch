+
+test('cancel refunds in full before start, frees the item, and only works once', () => {
+  const s = mk();
+  const b = s.book(r('2026-05-04T00:00:00Z', '2026-05-06T00:00:00Z'));
+  assert.deepEqual(s.cancel(b.id, '2026-05-03T10:00:00Z'), { bookingId: b.id, refund: b.total });
+  assert.doesNotThrow(() => s.book(r('2026-05-04T00:00:00Z', '2026-05-06T00:00:00Z')));
+  assert.throws(() => s.cancel(b.id, '2026-05-03T11:00:00Z'));
+});
+test('cancel after start refunds nothing; after end or bad input is rejected', () => {
+  const s = mk();
+  const b = s.book(r('2026-05-04T00:00:00Z', '2026-05-06T00:00:00Z'));
+  assert.throws(() => s.cancel(b.id, 'nope'));
+  assert.throws(() => s.cancel(b.id, '2026-05-06T00:00:00Z'));
+  assert.throws(() => s.cancel('booking-99', '2026-05-03T00:00:00Z'));
+  assert.equal(s.cancel(b.id, '2026-05-05T00:00:00Z').refund, 0);
+});
