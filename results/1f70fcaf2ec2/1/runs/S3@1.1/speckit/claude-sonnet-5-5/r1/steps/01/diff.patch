@@ -0,0 +1,29 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+const mk = () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2550 });
+  return s;
+};
+const r = (start: string, end: string) => ({ itemId: 'b1', start, end });
+
+test('quote multiplies days by daily price', () => {
+  assert.equal(mk().quote(r('2026-05-01T00:00:00Z', '2026-05-04T00:00:00Z')).total, 7650);
+});
+test('rejects bad periods and unknown items', () => {
+  const s = mk();
+  assert.throws(() => s.quote(r('2026-05-01T10:00:00Z', '2026-05-02T00:00:00Z')));
+  assert.throws(() => s.quote(r('2026-05-02T00:00:00Z', '2026-05-02T00:00:00Z')));
+  assert.throws(() => s.quote(r('2026-05-01T00:00:00+02:00', '2026-05-02T00:00:00Z')));
+  assert.throws(() => s.quote({ itemId: 'x', start: '2026-05-01T00:00:00Z', end: '2026-05-02T00:00:00Z' }));
+});
+test('book prevents overlaps but allows adjacent periods', () => {
+  const s = mk();
+  const a = s.book(r('2026-05-01T00:00:00Z', '2026-05-03T00:00:00Z'));
+  assert.equal(a.total, 5100);
+  assert.throws(() => s.book(r('2026-05-02T00:00:00Z', '2026-05-04T00:00:00Z')));
+  const b = s.book(r('2026-05-03T00:00:00Z', '2026-05-04T00:00:00Z'));
+  assert.notEqual(a.id, b.id);
+});
