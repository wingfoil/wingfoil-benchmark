@@ -27,3 +27,23 @@ test('book prevents overlaps but allows adjacent periods', () => {
   const b = s.book(r('2026-05-03T00:00:00Z', '2026-05-04T00:00:00Z'));
   assert.notEqual(a.id, b.id);
 });
+
+test('availability lists free items, sorted, optionally by kind', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 1000 });
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1000 });
+  s.book(r('2026-05-02T00:00:00Z', '2026-05-04T00:00:00Z'));
+  const q = { start: '2026-05-01T00:00:00Z', end: '2026-05-03T00:00:00Z' };
+  assert.deepEqual(s.availability(q), ['b2', 's1']);
+  assert.deepEqual(s.availability({ ...q, kind: 'board' }), ['b2']);
+  assert.deepEqual(s.availability({ ...q, kind: 'sail' }), ['s1']);
+  assert.deepEqual(s.availability({ start: '2026-05-04T00:00:00Z', end: '2026-05-05T00:00:00Z' }), ['b1', 'b2', 's1']);
+  assert.deepEqual(s.availability({ start: '2026-04-30T00:00:00Z', end: '2026-05-02T00:00:00Z', kind: 'board' }), ['b1', 'b2']);
+});
+test('availability validates the query', () => {
+  const s = mk();
+  assert.throws(() => s.availability({ start: '2026-05-01T10:00:00Z', end: '2026-05-02T00:00:00Z' }));
+  assert.throws(() => s.availability({ start: '2026-05-02T00:00:00Z', end: '2026-05-02T00:00:00Z' }));
+  assert.throws(() => s.availability({ start: '2026-05-01T00:00:00Z', end: '2026-05-02T00:00:00Z', kind: 'x' as never }));
+});
