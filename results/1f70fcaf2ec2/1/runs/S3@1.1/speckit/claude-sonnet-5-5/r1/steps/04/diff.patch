+
+test('hourly rental: hours x hourly price, no discount, quote and book', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2550, hourlyPrice: 800 });
+  assert.equal(s.quote(r('2026-05-01T13:00:00Z', '2026-05-01T16:00:00Z')).total, 2400);
+  assert.equal(s.book(r('2026-05-01T13:00:00Z', '2026-05-01T16:00:00Z')).total, 2400);
+  assert.equal(s.quote(r('2026-05-01T00:00:00Z', '2026-05-01T23:00:00Z')).total, 18400);
+  assert.throws(() => s.book(r('2026-05-01T15:00:00Z', '2026-05-01T17:00:00Z')));
+  assert.equal(s.book(r('2026-05-01T16:00:00Z', '2026-05-01T17:00:00Z')).total, 800);
+  assert.throws(() => s.book(r('2026-05-01T00:00:00Z', '2026-05-02T00:00:00Z')));
+});
