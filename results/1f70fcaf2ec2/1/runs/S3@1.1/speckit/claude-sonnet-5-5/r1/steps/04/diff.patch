+  assert.throws(() => h.quote(r('2026-05-01T13:30:00Z', '2026-05-01T16:00:00Z')));
+  assert.throws(() => h.quote(r('2026-05-01T13:00:00Z', '2026-05-01T16:00:30Z')));
+  assert.throws(() => h.quote(r('2026-05-01T10:00:00Z', '2026-05-02T10:00:00Z')));
