   if (Number.isNaN(ms)) throw new Error(`${label} is not a valid date`);
-  if (ms % DAY_MS !== 0) throw new Error(`${label} must be at midnight UTC`);
   return ms;
 }
 
+/** Parses a period; shorter than a day it must be on the hour, otherwise at midnight. */
+function parsePeriod(start: unknown, end: unknown) {
+  const startMs = parseInstant(start, 'start');
+  const endMs = parseInstant(end, 'end');
+  if (endMs <= startMs) throw new Error('end must be after start');
+  const unit = endMs - startMs < DAY_MS ? HOUR_MS : DAY_MS;
+  if (startMs % unit !== 0) throw new Error(unit === HOUR_MS ? 'start must be on the hour' : 'start must be at midnight UTC');
+  if (endMs % unit !== 0) throw new Error(unit === HOUR_MS ? 'end must be on the hour' : 'end must be at midnight UTC');
+  return { startMs, endMs, hourly: unit === HOUR_MS };
+}
