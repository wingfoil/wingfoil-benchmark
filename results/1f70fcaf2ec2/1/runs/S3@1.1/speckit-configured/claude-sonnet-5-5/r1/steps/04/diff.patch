@@ -0,0 +1,59 @@
+import { test } from 'node:test';
+import assert from 'node:assert';
+import { createRentalService } from '../src/index.js';
+
+const T = (h: number, day = 1) => `2026-06-${String(day).padStart(2, '0')}T${String(h).padStart(2, '0')}:00:00Z`;
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2500 });
+  return s;
+}
+
+test('an hourly rental costs the hourly price for each hour', () => {
+  const s = setup();
+  assert.strictEqual(s.quote({ itemId: 'b1', start: T(9), end: T(10) }).total, 600);
+  assert.strictEqual(s.quote({ itemId: 'b1', start: T(9), end: T(14) }).total, 3000);
+  assert.strictEqual(s.quote({ itemId: 'b1', start: T(0), end: T(23) }).total, 13800);
+  assert.strictEqual(s.quote({ itemId: 'b1', start: T(22), end: T(3, 2) }).total, 3000);
+  assert.strictEqual(s.book({ itemId: 'b1', start: T(9), end: T(11) }).total, 1200);
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'b2', start: T(9), end: T(11) }));
+  assert.throws(() => s.book({ itemId: 'b2', start: T(9), end: T(11) }));
+});
+
+test('a day or more is still priced by the day and must be whole days', () => {
+  const s = setup();
+  assert.strictEqual(s.quote({ itemId: 'b1', start: T(0), end: T(0, 2) }).total, 2500);
+  assert.throws(() => s.quote({ itemId: 'b1', start: T(9), end: T(9, 2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: T(0), end: T(1, 2) }));
+});
+
+test('hourly periods must start and end on the hour', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-06-01T09:30:00Z', end: T(11) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: T(9), end: '2026-06-01T11:00:01Z' }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: T(9), end: T(9) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: T(11), end: T(9) }));
+});
+
+test('hourly bookings conflict by overlap; back-to-back is free', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: T(9), end: T(11) });
+  assert.throws(() => s.book({ itemId: 'b1', start: T(10), end: T(12) }));
+  s.book({ itemId: 'b1', start: T(11), end: T(12) });
+  assert.deepStrictEqual(s.availability({ start: T(9), end: T(10) }), ['b2']);
+});
+
+test('addEquipment validates hourlyPrice', () => {
+  const s = createRentalService();
+  for (const hourlyPrice of [-1, 1.5, NaN]) {
+    assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice }));
+  }
+  s.addEquipment({ id: 'free', kind: 'board', dailyPrice: 1, hourlyPrice: 0 });
+  assert.strictEqual(s.quote({ itemId: 'free', start: T(9), end: T(10) }).total, 0);
+});
