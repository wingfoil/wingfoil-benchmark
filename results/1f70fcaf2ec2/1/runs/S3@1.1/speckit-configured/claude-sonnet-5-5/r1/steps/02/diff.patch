   assert.throws(() => s.addEquipment({ id: 'k', kind: 'board', dailyPrice: -1 }));
 });
+
+test('availability lists free ids, sorted, optionally by kind', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  assert.deepStrictEqual(s.availability({ start: D(1), end: D(2) }), ['b1', 'b2', 's1']);
+  assert.deepStrictEqual(s.availability({ start: D(1), end: D(2), kind: 'board' }), ['b1', 'b2']);
+  assert.deepStrictEqual(s.availability({ start: D(1), end: D(2), kind: 'sail' }), ['s1']);
+  assert.deepStrictEqual(createRentalService().availability({ start: D(1), end: D(2) }), []);
+});
+
+test('availability excludes overlapping bookings but not back-to-back ones', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: D(2), end: D(4) });
+  const ids = (start: string, end: string) => s.availability({ start, end, kind: 'board' });
+  assert.deepStrictEqual(ids(D(1), D(3)), []);
+  assert.deepStrictEqual(ids(D(3), D(6)), []);
+  assert.deepStrictEqual(ids(D(1), D(6)), []);
+  assert.deepStrictEqual(ids(D(2), D(4)), []);
+  assert.deepStrictEqual(ids(D(4), D(6)), ['b1']);
+  assert.deepStrictEqual(ids(D(1), D(2)), ['b1']);
+  assert.deepStrictEqual(s.availability({ start: D(2), end: D(4) }), ['s1']);
+});
+
+test('availability agrees with book and does not change state', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: D(2), end: D(4) });
+  s.availability({ start: D(1), end: D(10) });
+  assert.throws(() => s.book({ itemId: 'b1', start: D(3), end: D(5) }));
+  assert.ok(s.book({ itemId: 'b1', start: D(4), end: D(5) }));
+});
+
+test('availability rejects bad periods and kinds', () => {
