diff --git a/src/rental.ts b/src/rental.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e44b829b3fa6e2b6244461b6a2de61b3b9110f2d
--- /dev/null
+++ b/src/rental.ts
@@ -0,0 +1,120 @@
+import { randomUUID } from 'node:crypto';
+
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one day of rental, in integer euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  /** ISO-8601 UTC, midnight. */
+  start: string;
+  /** ISO-8601 UTC, midnight; the start of the day after the last rented day. */
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  /** Euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?Z$/;
+
+/** Parses a midnight-UTC ISO-8601 instant, throwing if it is anything else. */
+function parseMidnightUtc(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC string at midnight`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms) || ms % DAY_MS !== 0) {
+    throw new Error(`${name} is not a valid date`);
+  }
+  // Reject dates that Date silently rolls over (e.g. February 30).
+  if (new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a valid date`);
+  }
+  return ms;
+}
+
+/** Rule 3: a period is whole days, from midnight UTC to a later midnight UTC. */
+function parsePeriod(request: RentalRequest): { startMs: number; endMs: number; days: number } {
+  const startMs = parseMidnightUtc(request.start, 'start');
+  const endMs = parseMidnightUtc(request.end, 'end');
+  if (endMs <= startMs) {
+    throw new Error('end must be after start');
+  }
+  return { startMs, endMs, days: (endMs - startMs) / DAY_MS };
+}
+
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Array<Booking & { startMs: number; endMs: number }> = [];
+
+  function price(request: RentalRequest) {
+    const item = equipment.get(request.itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${String(request.itemId)}`);
+    }
+    const period = parsePeriod(request);
+    const quote: Quote = {
+      itemId: item.id,
+      start: request.start,
+      end: request.end,
+      total: item.dailyPrice * period.days,
+    };
+    return { quote, ...period };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item.id !== 'string' || item.id === '') {
+        throw new Error('id must be a non-empty string');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error("kind must be 'board' or 'sail'");
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of cents');
+      }
+      if (equipment.has(item.id)) {
+        throw new Error(`duplicate item: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, startMs, endMs } = price(request);
+      const clash = bookings.some(
+        (b) => b.itemId === quote.itemId && startMs < b.endMs && b.startMs < endMs,
+      );
+      if (clash) {
+        throw new Error(`item ${quote.itemId} is not free for that period`);
+      }
+      const booking: Booking = { id: randomUUID(), ...quote };
+      bookings.push({ ...booking, startMs, endMs });
+      return booking;
+    },
+  };
+}
diff --git a/test/rental.test.ts b/test/rental.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..64449846397361d10a75758126db14f3413f3242
--- /dev/null
+++ b/test/rental.test.ts
@@ -0,0 +1,87 @@
+import { test } from 'node:test';
+import assert from 'node:assert';
+import { createRentalService } from '../src/index.js';
+
+const D = (day: number) => `2026-06-${String(day).padStart(2, '0')}T00:00:00Z`;
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  return s;
+}
+
+test('quote multiplies the daily price by the number of days', () => {
+  const s = setup();
+  assert.deepStrictEqual(s.quote({ itemId: 'b1', start: D(1), end: D(4) }), {
+    itemId: 'b1', start: D(1), end: D(4), total: 7500,
+  });
+  assert.strictEqual(s.quote({ itemId: 'b1', start: D(1), end: D(2) }).total, 2500);
+});
+
+test('quote spans month and leap-day boundaries', () => {
+  const s = setup();
+  assert.strictEqual(
+    s.quote({ itemId: 's1', start: '2028-02-28T00:00:00Z', end: '2028-03-01T00:00:00Z' }).total,
+    3000,
+  );
+});
+
+test('quote and book reject unknown items', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'x', start: D(1), end: D(2) }));
+  assert.throws(() => s.book({ itemId: 'x', start: D(1), end: D(2) }));
+});
+
+test('periods must be whole UTC days with end after start', () => {
+  const s = setup();
+  const bad = [
+    [D(1), D(1)],
+    [D(2), D(1)],
+    ['2026-06-01T10:00:00Z', D(3)],
+    [D(1), '2026-06-03T00:00:00+02:00'],
+    [D(1), '2026-06-03T00:00:00'],
+    [D(1), '2026-06-03'],
+    [D(1), '2026-02-30T00:00:00Z'],
+    [D(1), 'nonsense'],
+  ];
+  for (const [start, end] of bad) {
+    assert.throws(() => s.quote({ itemId: 'b1', start, end }), `${start} ${end}`);
+    assert.throws(() => s.book({ itemId: 'b1', start, end }), `${start} ${end}`);
+  }
+});
+
+test('book returns a booking with a unique id', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: D(1), end: D(3) });
+  const b = s.book({ itemId: 'b1', start: D(3), end: D(4) });
+  assert.deepStrictEqual({ ...a, id: '' }, { id: '', itemId: 'b1', start: D(1), end: D(3), total: 5000 });
+  assert.ok(a.id && b.id && a.id !== b.id);
+});
+
+test('overlapping bookings of the same item are refused', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: D(5), end: D(8) });
+  for (const [start, end] of [[D(5), D(8)], [D(4), D(6)], [D(7), D(9)], [D(6), D(7)], [D(1), D(20)]]) {
+    assert.throws(() => s.book({ itemId: 'b1', start, end }), `${start} ${end}`);
+  }
+  // back-to-back and other items are fine
+  s.book({ itemId: 'b1', start: D(8), end: D(9) });
+  s.book({ itemId: 'b1', start: D(4), end: D(5) });
+  s.book({ itemId: 's1', start: D(5), end: D(8) });
+});
+
+test('quote does not reserve the item', () => {
+  const s = setup();
+  s.quote({ itemId: 'b1', start: D(1), end: D(2) });
+  s.book({ itemId: 'b1', start: D(1), end: D(2) });
+});
+
+test('addEquipment validates its input', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: '', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'k', kind: 'kite' as 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'k', kind: 'board', dailyPrice: 12.5 }));
+  assert.throws(() => s.addEquipment({ id: 'k', kind: 'board', dailyPrice: -1 }));
+});
