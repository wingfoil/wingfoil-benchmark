index 5fa14092d2cf59b13405f3c6c4336e7701c5661d..d58a068627580d215f3a3fb3d4fb99f8a5633b92 100644
--- a/src/rental.ts
+++ b/src/rental.ts
@@ -49,6 +49,19 @@ export interface RentalService {
 const DAY_MS = 24 * 60 * 60 * 1000;
 const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?Z$/;
 
+/** A rental of at least this many days gets the long-stay discount. */
+const LONG_STAY_MIN_DAYS = 3;
+const LONG_STAY_PERCENT_OFF = 10;
+
+/** Total in cents; long stays get the discount on the whole price, rounded to the nearest cent, halves up. */
+function rentalTotal(dailyPrice: number, days: number): number {
+  const full = dailyPrice * days;
+  if (days < LONG_STAY_MIN_DAYS) {
+    return full;
+  }
+  return Math.floor((full * (100 - LONG_STAY_PERCENT_OFF) + 50) / 100);
+}
+
 /** Parses a midnight-UTC ISO-8601 instant, throwing if it is anything else. */
 function parseMidnightUtc(value: unknown, name: string): number {
   if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
@@ -94,7 +107,7 @@ export function createRentalService(): RentalService {
       itemId: item.id,
       start: request.start,
       end: request.end,
-      total: item.dailyPrice * period.days,
+      total: rentalTotal(item.dailyPrice, period.days),
     };
     return { quote, ...period };
   }
