diff --git a/src/rental.ts b/src/rental.ts
index e19cd115149257a0da0b496389548877ee0d7c87..a6085db7bee1954c49565e029fcec9bab2392c15 100644
--- a/src/rental.ts
+++ b/src/rental.ts
@@ -56,13 +56,23 @@ const ON_THE_HOUR_UTC = /^\d{4}-\d{2}-\d{2}T\d{2}:00:00(\.0+)?Z$/;
 const LONG_STAY_MIN_DAYS = 3;
 const LONG_STAY_PERCENT_OFF = 10;
 
+/** Throws when a computed amount is no longer an exactly represented integer. */
+function assertSafeTotal(amount: number): void {
+  if (!Number.isSafeInteger(amount)) {
+    throw new Error('total is too large to be computed exactly');
+  }
+}
+
 /** Total in cents; long stays get the discount on the whole price, rounded to the nearest cent, halves up. */
 function rentalTotal(dailyPrice: number, days: number): number {
   const full = dailyPrice * days;
   if (days < LONG_STAY_MIN_DAYS) {
+    assertSafeTotal(full);
     return full;
   }
-  return Math.floor((full * (100 - LONG_STAY_PERCENT_OFF) + 50) / 100);
+  const scaled = full * (100 - LONG_STAY_PERCENT_OFF) + 50;
+  assertSafeTotal(scaled);
+  return Math.floor(scaled / 100);
 }
 
 /** Parses an on-the-hour ISO-8601 UTC instant, throwing if it is anything else. */
@@ -131,6 +141,7 @@ export function createRentalService(): RentalService {
         throw new Error(`item ${item.id} cannot be rented by the hour`);
       }
       total = item.hourlyPrice * period.hours;
+      assertSafeTotal(total);
     } else {
       total = rentalTotal(item.dailyPrice, period.days ?? 0);
     }
