   assert.strictEqual(quoted, 9000);
   assert.strictEqual(s.book(request).total, quoted);
 });
+
+test('totals beyond the safe integer range are refused', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'big', kind: 'board', dailyPrice: Math.floor(Number.MAX_SAFE_INTEGER / 90) + 1 });
+  assert.throws(() => rentals.quote({ itemId: 'big', start: '2025-06-01T00:00:00Z', end: '2025-06-04T00:00:00Z' }));
+  const huge = Number.MAX_SAFE_INTEGER;
+  rentals.addEquipment({ id: 'huge', kind: 'sail', dailyPrice: huge });
+  assert.throws(() => rentals.quote({ itemId: 'huge', start: '2025-06-01T00:00:00Z', end: '2025-06-03T00:00:00Z' }), /too large/);
+});
