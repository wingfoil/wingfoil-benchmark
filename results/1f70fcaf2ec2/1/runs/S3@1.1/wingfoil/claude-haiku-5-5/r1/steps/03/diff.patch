 const DAY_MS = 24 * 60 * 60 * 1000;
+/** A rental of at least this many days gets the long-stay discount. */
+const LONG_STAY_DAYS = 3;
+/** Long-stay discount, in percent of the full price. */
+const LONG_STAY_PERCENT = 10;
 const MIDNIGHT_UTC = /^(\d{4}-\d{2}-\d{2})T00:00:00(?:\.000)?Z$/;
 const KINDS: readonly string[] = ['board', 'sail'];
 
@@ -109,11 +113,16 @@ export function createRentalService(): RentalService {
     }
     const period = toPeriod(request);
     const days = (period.endMs - period.startMs) / DAY_MS;
+    const fullPrice = item.dailyPrice * days;
+    // Integer arithmetic: the discounted price in cents, rounded half up.
+    const total = days >= LONG_STAY_DAYS
+      ? Math.floor((fullPrice * (100 - LONG_STAY_PERCENT) + 50) / 100)
+      : fullPrice;
     const quote = {
       itemId: request.itemId,
       start: request.start,
       end: request.end,
-      total: item.dailyPrice * days,
+      total,
     };
     return { quote, period };
   }
