   return ms;
 }
 
-function toPeriod(request: RentalRequest): Period {
+function toPeriod(request: Pick<RentalRequest, 'start' | 'end'>): Period {
   const startMs = parseMidnightUtc(request.start, 'start');
   const endMs = parseMidnightUtc(request.end, 'end');
   if (endMs <= startMs) {
@@ -130,5 +141,17 @@ export function createRentalService(): RentalService {
       bookingCount += 1;
       return { id: `booking-${bookingCount}`, ...quote };
     },
+
+    availability(query) {
+      const period = toPeriod(query);
+      if (query.kind !== undefined && !KINDS.includes(query.kind)) {
+        throw new Error(`kind must be 'board' or 'sail', got ${JSON.stringify(query.kind)}`);
+      }
+      return [...items.values()]
+        .filter((item) => query.kind === undefined || item.kind === query.kind)
+        .filter((item) => !(bookedPeriods.get(item.id) ?? []).some((booked) => overlaps(booked, period)))
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
diff --git a/test/rental.test.ts b/test/rental.test.ts
index 62456a719f4b2869f6fdc76488e5b31c6dc35c6a..cd3c5bc80ed1969b268b84cd233ca9d38a4279de 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -185,3 +185,81 @@ describe('book', () => {
     assert.equal(service.book({ itemId: 'board-1', start: '2026-06-03T00:00:00Z', end: '2026-06-04T00:00:00Z' }).total, 1500);
   });
 });
+
+describe('availability', () => {
+  const june = { start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' };
+
+  function serviceWithFleet() {
+    const service = createRentalService();
+    service.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 2000 });
+    service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 1500 });
+    service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 2000 });
+    return service;
+  }
+
+  it('is a method of the rental service (AC9)', () => {
+    assert.equal(typeof createRentalService().availability, 'function');
+  });
+
+  it('returns all free equipment, sorted, when no kind is given (AC10, happy path)', () => {
+    assert.deepEqual(serviceWithFleet().availability(june), ['board-1', 'board-2', 'sail-1', 'sail-2']);
+  });
+
+  it('returns only the free equipment of the given kind, sorted (AC11)', () => {
+    const service = serviceWithFleet();
+    assert.deepEqual(service.availability({ ...june, kind: 'board' }), ['board-1', 'board-2']);
+    assert.deepEqual(service.availability({ ...june, kind: 'sail' }), ['sail-1', 'sail-2']);
+  });
+
+  it('treats an explicit undefined kind as any kind (AC10)', () => {
+    assert.deepEqual(serviceWithFleet().availability({ ...june, kind: undefined }), ['board-1', 'board-2', 'sail-1', 'sail-2']);
+  });
+
+  it('excludes an item booked for an overlapping period (AC12)', () => {
+    const service = serviceWithFleet();
+    service.book({ itemId: 'board-1', start: '2026-06-02T00:00:00Z', end: '2026-06-04T00:00:00Z' });
+    assert.deepEqual(service.availability(june), ['board-2', 'sail-1', 'sail-2']);
+    assert.deepEqual(service.availability({ ...june, kind: 'board' }), ['board-2']);
+  });
+
+  it('includes an item whose booking ends where the query starts or starts where it ends (AC12)', () => {
+    const service = serviceWithFleet();
+    service.book({ itemId: 'board-1', start: '2026-05-30T00:00:00Z', end: '2026-06-01T00:00:00Z' });
+    service.book({ itemId: 'board-2', start: '2026-06-03T00:00:00Z', end: '2026-06-05T00:00:00Z' });
+    assert.deepEqual(service.availability({ ...june, kind: 'board' }), ['board-1', 'board-2']);
+  });
+
+  it('returns an empty array when nothing is free (AC14)', () => {
+    const service = serviceWithFleet();
+    service.book({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' });
+    service.book({ itemId: 'board-2', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' });
+    assert.deepEqual(service.availability({ ...june, kind: 'board' }), []);
+  });
+
+  it('returns an empty array when there is no equipment at all (AC14)', () => {
+    assert.deepEqual(createRentalService().availability(june), []);
+  });
+
+  it('does not reserve anything (AC14)', () => {
+    const service = serviceWithFleet();
+    service.availability(june);
+    assert.equal(service.book({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' }).total, 3000);
+  });
+
+  it('throws for a period that is not whole UTC days (AC13)', () => {
+    const service = serviceWithFleet();
+    assert.throws(() => service.availability({ start: '2026-06-01T09:00:00Z', end: '2026-06-03T00:00:00Z' }));
+  });
+
+  it('throws for an empty or reversed period (AC13)', () => {
+    const service = serviceWithFleet();
+    assert.throws(() => service.availability({ start: '2026-06-01T00:00:00Z', end: '2026-06-01T00:00:00Z' }));
+    assert.throws(() => service.availability({ start: '2026-06-03T00:00:00Z', end: '2026-06-01T00:00:00Z' }));
+  });
+
+  it('throws for an unknown kind (AC13)', () => {
+    const service = serviceWithFleet();
+    assert.throws(() => service.availability({ ...june, kind: 'kite' as 'board' }));
+  });
+});
