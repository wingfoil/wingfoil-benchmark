@@ -0,0 +1,187 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import * as lakeside from '../src/index.ts';
+import { createRentalService } from '../src/index.ts';
+
+function serviceWithBoard() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+  return service;
+}
+
+describe('exports', () => {
+  it('exports createRentalService as a function (AC1)', () => {
+    assert.equal(typeof lakeside.createRentalService, 'function');
+  });
+});
+
+describe('addEquipment', () => {
+  it('accepts a board and a sail (AC7, happy path)', () => {
+    const service = createRentalService();
+    service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 2000 });
+    assert.equal(service.quote({ itemId: 'sail-1', start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' }).total, 2000);
+  });
+
+  it('rejects an unknown kind (AC7)', () => {
+    const service = createRentalService();
+    assert.throws(() => service.addEquipment({ id: 'x', kind: 'kite' as 'board', dailyPrice: 1500 }));
+  });
+
+  it('rejects a non-integer price (AC7)', () => {
+    const service = createRentalService();
+    assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 15.5 }));
+  });
+
+  it('rejects a negative price (AC7)', () => {
+    const service = createRentalService();
+    assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
+  });
+
+  it('rejects an empty id (AC7)', () => {
+    const service = createRentalService();
+    assert.throws(() => service.addEquipment({ id: '', kind: 'board', dailyPrice: 1500 }));
+  });
+
+  it('rejects a duplicate id', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'sail', dailyPrice: 900 }));
+  });
+});
+
+describe('quote', () => {
+  it('returns the total for whole days in integer cents (AC2, happy path)', () => {
+    const service = serviceWithBoard();
+    const quote = service.quote({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-04T00:00:00Z' });
+    assert.deepEqual(quote, {
+      itemId: 'board-1',
+      start: '2026-06-01T00:00:00Z',
+      end: '2026-06-04T00:00:00Z',
+      total: 4500,
+    });
+  });
+
+  it('accepts midnight written with milliseconds', () => {
+    const service = serviceWithBoard();
+    const quote = service.quote({
+      itemId: 'board-1',
+      start: '2026-06-01T00:00:00.000Z',
+      end: '2026-06-02T00:00:00.000Z',
+    });
+    assert.equal(quote.total, 1500);
+  });
+
+  it('does not reserve the item', () => {
+    const service = serviceWithBoard();
+    const request = { itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' };
+    service.quote(request);
+    assert.equal(service.book(request).total, 1500);
+  });
+
+  it('throws for an unknown item (AC3)', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.quote({ itemId: 'nope', start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' }));
+  });
+
+  it('throws when the start is not midnight UTC (AC4)', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-06-01T09:00:00Z', end: '2026-06-02T00:00:00Z' }));
+  });
+
+  it('throws when the end is not midnight UTC (AC4)', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-02T12:00:00Z' }));
+  });
+
+  it('throws for a time with a non-UTC offset (AC4)', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-06-01T02:00:00+02:00', end: '2026-06-02T02:00:00+02:00' }));
+  });
+
+  it('throws for a string that is not ISO-8601 (AC4)', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: 'tomorrow', end: '2026-06-02T00:00:00Z' }));
+  });
+
+  it('throws for a date that does not exist (AC4)', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-02-30T00:00:00Z', end: '2026-03-02T00:00:00Z' }));
+  });
+
+  it('throws for an empty period (AC4)', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-01T00:00:00Z' }));
+  });
+
+  it('throws for a reversed period (AC4)', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-06-02T00:00:00Z', end: '2026-06-01T00:00:00Z' }));
+  });
+});
+
+describe('book', () => {
+  it('returns an id and the quoted details (AC5, happy path)', () => {
+    const service = serviceWithBoard();
+    const request = { itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' };
+    const booking = service.book(request);
+    assert.equal(typeof booking.id, 'string');
+    assert.deepEqual({ ...booking, id: undefined }, { ...service.quote(request), id: undefined });
+    assert.equal(booking.total, 3000);
+  });
+
+  it('gives each booking its own id', () => {
+    const service = serviceWithBoard();
+    const first = service.book({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' });
+    const second = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+    assert.notEqual(first.id, second.id);
+  });
+
+  it('throws for an unknown item (AC3)', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.book({ itemId: 'nope', start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' }));
+  });
+
+  it('throws for a period that is not whole days (AC4)', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.book({ itemId: 'board-1', start: '2026-06-01T10:00:00Z', end: '2026-06-02T00:00:00Z' }));
+  });
+
+  it('throws when the item is already booked for the same period (AC6)', () => {
+    const service = serviceWithBoard();
+    const request = { itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' };
+    service.book(request);
+    assert.throws(() => service.book(request));
+  });
+
+  it('throws when a period overlaps an existing booking by one day (AC6)', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: '2026-06-02T00:00:00Z', end: '2026-06-04T00:00:00Z' });
+    assert.throws(() => service.book({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' }));
+  });
+
+  it('throws when a period contains an existing booking (AC6)', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: '2026-06-02T00:00:00Z', end: '2026-06-03T00:00:00Z' });
+    assert.throws(() => service.book({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-05T00:00:00Z' }));
+  });
+
+  it('allows back-to-back periods (AC6)', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' });
+    assert.equal(service.book({ itemId: 'board-1', start: '2026-06-03T00:00:00Z', end: '2026-06-04T00:00:00Z' }).total, 1500);
+  });
+
+  it('does not conflict across different items (AC6)', () => {
+    const service = serviceWithBoard();
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 2000 });
+    service.book({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' });
+    assert.equal(service.book({ itemId: 'sail-1', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' }).total, 4000);
+  });
+
+  it('does not book when the period is refused', () => {
+    const service = serviceWithBoard();
+    service.book({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' });
+    assert.throws(() => service.book({ itemId: 'board-1', start: '2026-06-02T00:00:00Z', end: '2026-06-03T00:00:00Z' }));
+    assert.equal(service.book({ itemId: 'board-1', start: '2026-06-03T00:00:00Z', end: '2026-06-04T00:00:00Z' }).total, 1500);
+  });
+});
