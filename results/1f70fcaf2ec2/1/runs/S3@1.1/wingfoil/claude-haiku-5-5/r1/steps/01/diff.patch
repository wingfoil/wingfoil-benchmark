@@ -0,0 +1,134 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one rental day, in euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  /** Midnight UTC, ISO-8601. */
+  start: string;
+  /** Midnight UTC, ISO-8601: the start of the day after the last rented day. */
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  /** Total price, in euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  /** Registers an item that can be quoted and booked. Ids must be unique. */
+  addEquipment(item: Equipment): void;
+  /** Prices a rental without reserving the item. Does not check availability. */
+  quote(request: RentalRequest): Quote;
+  /** Reserves the item for the period; throws if it overlaps an existing booking. */
+  book(request: RentalRequest): Booking;
+}
+
+interface Period {
+  startMs: number;
+  endMs: number;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^(\d{4}-\d{2}-\d{2})T00:00:00(?:\.000)?Z$/;
+const KINDS: readonly string[] = ['board', 'sail'];
+
+function parseMidnightUtc(value: string, label: string): number {
+  const match = typeof value === 'string' ? MIDNIGHT_UTC.exec(value) : null;
+  if (!match) {
+    throw new Error(`${label} must be midnight UTC in ISO-8601, got ${JSON.stringify(value)}`);
+  }
+  const ms = Date.parse(`${match[1]}T00:00:00Z`);
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== match[1]) {
+    throw new Error(`${label} is not a valid date: ${value}`);
+  }
+  return ms;
+}
+
+function toPeriod(request: RentalRequest): Period {
+  const startMs = parseMidnightUtc(request.start, 'start');
+  const endMs = parseMidnightUtc(request.end, 'end');
+  if (endMs <= startMs) {
+    throw new Error('the period must end after it starts');
+  }
+  return { startMs, endMs };
+}
+
+function overlaps(a: Period, b: Period): boolean {
+  return a.startMs < b.endMs && b.startMs < a.endMs;
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item.id !== 'string' || item.id === '') {
+    throw new Error('equipment id must be a non-empty string');
+  }
+  if (!KINDS.includes(item.kind)) {
+    throw new Error(`equipment kind must be 'board' or 'sail', got ${JSON.stringify(item.kind)}`);
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+  }
+}
+
+/**
+ * Creates an in-memory rental service. All money is in euro cents and all
+ * times are UTC midnights; state lives only as long as the returned object.
+ */
+export function createRentalService(): RentalService {
+  const items = new Map<string, Equipment>();
+  const bookedPeriods = new Map<string, Period[]>();
+  let bookingCount = 0;
+
+  function priceRequest(request: RentalRequest): { quote: Quote; period: Period } {
+    const item = items.get(request.itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${request.itemId}`);
+    }
+    const period = toPeriod(request);
+    const days = (period.endMs - period.startMs) / DAY_MS;
+    const quote = {
+      itemId: request.itemId,
+      start: request.start,
+      end: request.end,
+      total: item.dailyPrice * days,
+    };
+    return { quote, period };
+  }
+
+  return {
+    addEquipment(item) {
+      validateEquipment(item);
+      if (items.has(item.id)) {
+        throw new Error(`duplicate equipment id: ${item.id}`);
+      }
+      items.set(item.id, { ...item });
+    },
+
+    quote(request) {
+      return priceRequest(request).quote;
+    },
+
+    book(request) {
+      const { quote, period } = priceRequest(request);
+      const periods = bookedPeriods.get(request.itemId) ?? [];
+      if (periods.some((booked) => overlaps(booked, period))) {
+        throw new Error(`item ${request.itemId} is already booked for an overlapping period`);
+      }
+      bookedPeriods.set(request.itemId, [...periods, period]);
+      bookingCount += 1;
+      return { id: `booking-${bookingCount}`, ...quote };
+    },
+  };
+}
diff --git a/test/rental.test.ts b/test/rental.test.ts
