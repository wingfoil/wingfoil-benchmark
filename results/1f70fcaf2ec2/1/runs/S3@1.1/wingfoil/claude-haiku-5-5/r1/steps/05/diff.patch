diff --git a/test/rental.test.ts b/test/rental.test.ts
index 804d297a21d9150c720ee8ee8a3d9a17d60c5750..08c46f7ec61a9e7282b49d6069f911b4fc2269ac 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -466,3 +466,73 @@ describe('hourly rental', () => {
     assert.throws(() => service.availability({ start: '2026-06-01T09:30:00Z', end: '2026-06-01T11:00:00Z' }));
   });
 });
+
+describe('cancel', () => {
+  const twoDays = { start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' };
+  // Exactly 24 hours before the start of `twoDays`.
+  const dayBefore = '2026-05-31T00:00:00Z';
+
+  it('refunds the full total when cancelled at least 24 hours before the start (AC29, happy path)', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', ...twoDays });
+    assert.deepEqual(service.cancel(booking.id, '2026-05-30T12:00:00Z'), { bookingId: booking.id, refund: 3000 });
+  });
+
+  it('refunds the full total at exactly 24 hours before the start (AC31)', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', ...twoDays });
+    assert.equal(service.cancel(booking.id, dayBefore).refund, 3000);
+  });
+
+  it('refunds nothing when cancelled less than 24 hours before the start (AC30)', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', ...twoDays });
+    assert.equal(service.cancel(booking.id, '2026-05-31T00:00:00.001Z').refund, 0);
+  });
+
+  it('refunds nothing when cancelled after the start (AC30)', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', ...twoDays });
+    assert.equal(service.cancel(booking.id, '2026-06-01T06:00:00Z').refund, 0);
+  });
+
+  it('refuses an unknown booking id (AC32)', () => {
+    const service = serviceWithBoard();
+    assert.throws(() => service.cancel('booking-99', dayBefore));
+  });
+
+  it('refuses an at that is not an ISO-8601 UTC time, and changes no state (AC32)', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', ...twoDays });
+    assert.throws(() => service.cancel(booking.id, '2026-06-01'));
+    assert.throws(() => service.cancel(booking.id, '2026-05-31T00:00:00+02:00'));
+    assert.throws(() => service.cancel(booking.id, '2026-02-30T00:00:00Z'));
+    assert.equal(service.cancel(booking.id, dayBefore).refund, 3000);
+  });
+
+  it('refuses a second cancellation of the same booking, and changes no state (AC33)', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', ...twoDays });
+    assert.equal(service.cancel(booking.id, dayBefore).refund, 3000);
+    assert.throws(() => service.cancel(booking.id, dayBefore));
+    assert.deepEqual(service.availability(twoDays), ['board-1']);
+  });
+
+  it('releases the booked period so the item can be booked and listed again (AC34)', () => {
+    const service = serviceWithBoard();
+    const booking = service.book({ itemId: 'board-1', ...twoDays });
+    assert.deepEqual(service.availability(twoDays), []);
+    service.cancel(booking.id, '2026-05-31T23:00:00Z');
+    assert.deepEqual(service.availability(twoDays), ['board-1']);
+    assert.equal(service.book({ itemId: 'board-1', ...twoDays }).total, 3000);
+  });
+
+  it('keeps the periods of other bookings of the same item (AC35)', () => {
+    const service = serviceWithBoard();
+    const first = service.book({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' });
+    service.book({ itemId: 'board-1', start: '2026-06-02T00:00:00Z', end: '2026-06-03T00:00:00Z' });
+    service.cancel(first.id, dayBefore);
+    assert.deepEqual(service.availability({ start: '2026-06-02T00:00:00Z', end: '2026-06-03T00:00:00Z' }), []);
+    assert.deepEqual(service.availability({ start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' }), ['board-1']);
+  });
+});
