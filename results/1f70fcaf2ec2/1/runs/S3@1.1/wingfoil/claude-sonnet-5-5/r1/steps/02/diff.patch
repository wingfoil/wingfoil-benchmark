+
+# Add availability query to rental service
+
+Add `availability(query)` to the rental service, with `query = { start, end, kind? }`. It returns the ids of
+the equipment of that kind (any kind when `kind` is omitted) that is free for the whole period, sorted.
+
+Rules: the period is validated like in `quote`/`book` (whole days, UTC midnight, end after start; throws
+otherwise); an invalid `kind` throws; an item is free when no booking overlaps the period (end exclusive).
diff --git a/src/index.ts b/src/index.ts
index 3d2934978aabbb86ca7916471fa6006bb0207743..15c0ee34ae87dcf53e54f5c090c227da10484afc 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -25,6 +25,13 @@ export interface Booking extends Quote {
   id: string;
 }
 
+/** What the desk asks about availability; `kind` narrows the answer to one kind of equipment. */
+export interface AvailabilityQuery {
+  start: string;
+  end: string;
+  kind?: EquipmentKind;
+}
+
 /** The booking desk's in-memory rental service. */
 export interface RentalService {
   /** Registers an item; throws on an invalid item or a duplicate id. */
@@ -33,6 +40,8 @@ export interface RentalService {
   quote(request: RentalRequest): Quote;
   /** Books an item; throws like `quote`, and when the item is not free for the whole period. */
   book(request: RentalRequest): Booking;
+  /** Lists, sorted, the ids of the items (of `kind` if given) free for the whole period; throws on an invalid period or kind. */
+  availability(query: AvailabilityQuery): string[];
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
@@ -106,5 +115,22 @@ export function createRentalService(): RentalService {
       bookings.push({ ...booking, from, to });
       return booking;
     },
+
+    availability(query) {
+      const from = parseMidnight(query?.start, 'start');
+      const to = parseMidnight(query?.end, 'end');
+      if (to <= from) {
+        throw new Error('end must be after start');
+      }
+      const { kind } = query;
+      if (kind !== undefined && kind !== 'board' && kind !== 'sail') {
+        throw new Error("kind must be 'board' or 'sail'");
+      }
+      return [...equipment.values()]
+        .filter((item) => kind === undefined || item.kind === kind)
+        .filter((item) => !bookings.some((b) => b.itemId === item.id && b.from < to && from < b.to))
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
