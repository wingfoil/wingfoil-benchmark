+test('availability lists the sorted free ids, optionally by kind', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 100 });
+  s.book(r('b1', '2026-06-02T00:00:00Z', '2026-06-04T00:00:00Z'));
+  const q = (start: string, end: string, kind?: 'board' | 'sail') => s.availability({ start, end, kind });
+  assert.deepEqual(q('2026-06-01T00:00:00Z', '2026-06-05T00:00:00Z'), ['a0', 's1']);
+  assert.deepEqual(q('2026-06-01T00:00:00Z', '2026-06-05T00:00:00Z', 'board'), ['a0']);
+  assert.deepEqual(q('2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z', 'board'), ['a0', 'b1']);
+  assert.deepEqual(q('2026-06-04T00:00:00Z', '2026-06-05T00:00:00Z'), ['a0', 'b1', 's1']);
+  assert.throws(() => q('2026-06-02T00:00:00Z', '2026-06-02T00:00:00Z'));
+  assert.throws(() => q('2026-06-01', '2026-06-02'));
+  assert.throws(() => s.availability({ start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z', kind: 'x' as never }));
