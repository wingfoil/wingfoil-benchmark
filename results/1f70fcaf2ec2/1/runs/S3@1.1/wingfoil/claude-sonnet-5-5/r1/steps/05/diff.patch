+test('cancel refunds in full before the start, frees the equipment, and works once', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1000 });
+  const b = s.book(r('x', '2026-06-01T00:00:00Z', '2026-06-03T00:00:00Z'));
+  assert.deepEqual(s.availability({ start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' }), []);
+  assert.deepEqual(s.cancel(b.id, '2026-05-31T12:30:00Z'), { bookingId: b.id, refund: 2000 });
+  assert.deepEqual(s.availability({ start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' }), ['x']);
+  s.book(r('x', '2026-06-01T00:00:00Z', '2026-06-03T00:00:00Z'));
