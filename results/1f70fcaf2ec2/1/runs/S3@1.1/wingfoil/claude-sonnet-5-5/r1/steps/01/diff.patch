@@ -0,0 +1,110 @@
+/** The kinds of equipment the school rents. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item; `dailyPrice` is an integer number of euro cents per day. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** A rental period for an item; `start` and `end` are ISO-8601 UTC midnights, `end` exclusive. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** What renting an item for a period costs; `total` is in euro cents. */
+export interface Quote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed booking. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** The booking desk's in-memory rental service. */
+export interface RentalService {
+  /** Registers an item; throws on an invalid item or a duplicate id. */
+  addEquipment(item: Equipment): void;
+  /** Prices a rental; throws for an unknown item or a disallowed period. */
+  quote(request: RentalRequest): Quote;
+  /** Books an item; throws like `quote`, and when the item is not free for the whole period. */
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?(Z|\+00:00)$/;
+
+function parseMidnight(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !UTC_MIDNIGHT.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC midnight`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms) || ms % DAY_MS !== 0) {
+    throw new Error(`${name} must be an ISO-8601 UTC midnight`);
+  }
+  return ms;
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item?.id !== 'string' || item.id === '') {
+    throw new Error('equipment id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error("equipment kind must be 'board' or 'sail'");
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('dailyPrice must be a non-negative integer number of cents');
+  }
+}
+
+/** Creates an empty rental service that keeps everything in memory. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Array<Booking & { from: number; to: number }> = [];
+
+  function price(request: RentalRequest) {
+    const item = equipment.get(request?.itemId);
+    if (item === undefined) {
+      throw new Error(`unknown item: ${String(request?.itemId)}`);
+    }
+    const from = parseMidnight(request.start, 'start');
+    const to = parseMidnight(request.end, 'end');
+    if (to <= from) {
+      throw new Error('end must be after start');
+    }
+    const total = ((to - from) / DAY_MS) * item.dailyPrice;
+    if (!Number.isSafeInteger(total)) {
+      throw new Error('total is too large');
+    }
+    return { from, to, quote: { itemId: item.id, start: request.start, end: request.end, total } };
+  }
+
+  return {
+    addEquipment(item) {
+      validateEquipment(item);
+      if (equipment.has(item.id)) {
+        throw new Error(`equipment already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { from, to, quote } = price(request);
+      const clash = bookings.some((b) => b.itemId === quote.itemId && b.from < to && from < b.to);
+      if (clash) {
+        throw new Error(`item ${quote.itemId} is not free for the whole period`);
+      }
+      const booking = { id: `booking-${bookings.length + 1}`, ...quote };
+      bookings.push({ ...booking, from, to });
+      return booking;
+    },
+  };
+}
