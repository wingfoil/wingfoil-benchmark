@@ -0,0 +1,63 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2550 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  return s;
+}
+const r = (itemId: string, start: string, end: string) => ({ itemId, start, end });
+
+test('quote prices whole days in cents', () => {
+  const q = setup().quote(r('b1', '2026-06-01T00:00:00Z', '2026-06-04T00:00:00Z'));
+  assert.deepEqual(q, { ...r('b1', '2026-06-01T00:00:00Z', '2026-06-04T00:00:00Z'), total: 7650 });
+});
+
+test('quote and book reject unknown items and bad periods', () => {
+  const s = setup();
+  const bad = [
+    r('nope', '2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z'),
+    r('b1', '2026-06-01T10:00:00Z', '2026-06-02T00:00:00Z'),
+    r('b1', '2026-06-01T00:00:00Z', '2026-06-02T12:00:00Z'),
+    r('b1', '2026-06-01T00:00:00+02:00', '2026-06-02T00:00:00Z'),
+    r('b1', '2026-06-01', '2026-06-02'),
+    r('b1', '2026-06-02T00:00:00Z', '2026-06-02T00:00:00Z'),
+    r('b1', '2026-06-03T00:00:00Z', '2026-06-02T00:00:00Z'),
+    r('b1', '2026-02-30T00:00:00Z', '2026-03-02T00:00:00Z'),
+  ];
+  for (const req of bad) {
+    assert.throws(() => s.quote(req));
+    assert.throws(() => s.book(req));
+  }
+});
+
+test('book returns an identified booking with the quoted total', () => {
+  const s = setup();
+  const a = s.book(r('b1', '2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z'));
+  const b = s.book(r('s1', '2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z'));
+  assert.equal(a.total, 2550);
+  assert.equal(a.itemId, 'b1');
+  assert.notEqual(a.id, b.id);
+});
+
+test('overlapping bookings of one item are refused, adjacent ones allowed', () => {
+  const s = setup();
+  s.book(r('b1', '2026-06-02T00:00:00Z', '2026-06-04T00:00:00Z'));
+  assert.throws(() => s.book(r('b1', '2026-06-01T00:00:00Z', '2026-06-03T00:00:00Z')));
+  assert.throws(() => s.book(r('b1', '2026-06-03T00:00:00Z', '2026-06-05T00:00:00Z')));
+  assert.throws(() => s.book(r('b1', '2026-06-01T00:00:00Z', '2026-06-10T00:00:00Z')));
+  s.book(r('b1', '2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z'));
+  s.book(r('b1', '2026-06-04T00:00:00Z', '2026-06-05T00:00:00Z'));
+  s.book(r('s1', '2026-06-02T00:00:00Z', '2026-06-04T00:00:00Z'));
+});
+
+test('quote does not reserve; invalid equipment is refused', () => {
+  const s = setup();
+  s.quote(r('b1', '2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z'));
+  s.book(r('b1', '2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z'));
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'mast' as 'board', dailyPrice: 10 }));
+});
