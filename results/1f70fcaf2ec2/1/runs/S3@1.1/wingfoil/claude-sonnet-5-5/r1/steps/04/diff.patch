+function parseHour(value: unknown, name: string): number {
+  const ms = typeof value === 'string' && UTC_HOUR.test(value) ? Date.parse(value) : NaN;
+  if (Number.isNaN(ms) || ms % HOUR_MS !== 0) {
+    throw new Error(`${name} must be an ISO-8601 UTC hour`);
   }
   return ms;
 }
 
+/** Parses a period: whole days between midnights, or a rental shorter than a day on the hour. */
+function parsePeriod(start: unknown, end: unknown): { from: number; to: number; hourly: boolean } {
+  const from = parseHour(start, 'start');
+  const to = parseHour(end, 'end');
+  if (to <= from) {
+    throw new Error('end must be after start');
+  }
+  if (to - from < DAY_MS) {
+    return { from, to, hourly: true };
+  }
+  if (from % DAY_MS !== 0 || to % DAY_MS !== 0) {
+    throw new Error('a rental of a day or more must start and end at UTC midnight');
+  }
+  return { from, to, hourly: false };
+}
