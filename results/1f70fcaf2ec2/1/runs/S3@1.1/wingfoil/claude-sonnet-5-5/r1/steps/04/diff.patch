+
+test('hourly rentals are priced per hour and need an hourly price', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2550, hourlyPrice: 700 });
+  s.addEquipment({ id: 'd1', kind: 'sail', dailyPrice: 1000 });
+  assert.equal(s.quote(r('h1', '2026-06-01T10:00:00Z', '2026-06-01T13:00:00Z')).total, 2100);
+  assert.equal(s.quote(r('h1', '2026-06-01T22:00:00Z', '2026-06-02T02:00:00Z')).total, 2800);
+  assert.equal(s.quote(r('h1', '2026-06-01T00:00:00Z', '2026-06-01T23:00:00Z')).total, 16100);
+  assert.equal(s.quote(r('h1', '2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z')).total, 2550);
+  assert.throws(() => s.quote(r('d1', '2026-06-01T10:00:00Z', '2026-06-01T13:00:00Z')));
+  assert.throws(() => s.book(r('d1', '2026-06-01T10:00:00Z', '2026-06-01T13:00:00Z')));
+  assert.throws(() => s.quote(r('h1', '2026-06-01T10:30:00Z', '2026-06-01T13:00:00Z')));
+  assert.throws(() => s.quote(r('h1', '2026-06-01T10:00:00Z', '2026-06-02T10:00:00Z')));
+  assert.throws(() => s.quote(r('h1', '2026-06-01T10:00:00Z', '2026-06-01T24:00:00Z')));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: 'y', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+});
+
+test('hourly bookings clash only when hours overlap', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2550, hourlyPrice: 700 });
+  s.book(r('h1', '2026-06-01T10:00:00Z', '2026-06-01T13:00:00Z'));
+  s.book(r('h1', '2026-06-01T13:00:00Z', '2026-06-01T15:00:00Z'));
+  assert.throws(() => s.book(r('h1', '2026-06-01T12:00:00Z', '2026-06-01T14:00:00Z')));
+  assert.throws(() => s.book(r('h1', '2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z')));
+  assert.deepEqual(s.availability({ start: '2026-06-01T15:00:00Z', end: '2026-06-01T16:00:00Z' }), ['h1']);
+  assert.deepEqual(s.availability({ start: '2026-06-01T09:00:00Z', end: '2026-06-01T11:00:00Z' }), []);
+});
