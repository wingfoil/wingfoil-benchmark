 const DAY_MS = 24 * 60 * 60 * 1000;
+const LONG_STAY_DAYS = 3;
 const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?(Z|\+00:00)$/;
 
 function parseMidnight(value: unknown, name: string): number {
@@ -85,11 +86,14 @@ export function createRentalService(): RentalService {
     if (to <= from) {
       throw new Error('end must be after start');
     }
-    const total = ((to - from) / DAY_MS) * item.dailyPrice;
-    if (!Number.isSafeInteger(total)) {
+    const days = (to - from) / DAY_MS;
+    const full = days * item.dailyPrice;
+    // Long stays get 10% off, in integer cents rounded half up.
+    const discounted = days >= LONG_STAY_DAYS ? Math.floor((full * 9 + 5) / 10) : full;
+    if (!Number.isSafeInteger(full) || !Number.isSafeInteger(full * 9)) {
       throw new Error('total is too large');
     }
