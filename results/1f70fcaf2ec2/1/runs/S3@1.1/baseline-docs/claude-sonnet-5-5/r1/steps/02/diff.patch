diff --git a/test/rental.test.ts b/test/rental.test.ts
index c401fcd1b3cece15f3a119a74758b22e67172075..f1e4a90ec35070ae5bdaa3fe3c0ea87c7f682cb4 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -67,3 +67,34 @@ test('addEquipment validates items', () => {
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10.5 }));
   assert.throws(() => s.addEquipment({ id: '', kind: 'board', dailyPrice: 10 }));
 });
+
+test('availability lists the sorted ids free for the whole period', () => {
+  const s = setup();
+  s.addEquipment({ id: 'board-0', kind: 'board', dailyPrice: 3000 });
+  s.book({ itemId: 'board-1', start: d(2), end: d(4) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(3) }), ['board-0', 'sail-1']);
+  assert.deepEqual(s.availability({ start: d(5), end: d(6) }), ['board-0', 'board-1', 'sail-1']);
+});
+
+test('availability filters by kind', () => {
+  const s = setup();
+  assert.deepEqual(s.availability({ start: d(1), end: d(2), kind: 'sail' }), ['sail-1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(2), kind: 'board' }), ['board-1']);
+});
+
+test('availability treats bookings as half-open periods', () => {
+  const s = setup();
+  s.book({ itemId: 'board-1', start: d(2), end: d(4) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(2), kind: 'board' }), ['board-1']);
+  assert.deepEqual(s.availability({ start: d(4), end: d(5), kind: 'board' }), ['board-1']);
+  assert.deepEqual(s.availability({ start: d(3), end: d(5), kind: 'board' }), []);
+  assert.deepEqual(s.availability({ start: d(1), end: d(9), kind: 'board' }), []);
+});
+
+test('availability rejects disallowed periods and unknown kinds', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: d(2), end: d(2) }));
+  assert.throws(() => s.availability({ start: d(3), end: d(2) }));
+  assert.throws(() => s.availability({ start: 'garbage', end: d(2) }));
+  assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'kayak' as 'board' }));
+});
