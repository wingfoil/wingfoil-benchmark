diff --git a/test/rental.test.ts b/test/rental.test.ts
index a1c1695fbcd5c25a6f420e8d403bd0a94a8300c2..de9f5d8c06eba1c000871cae5f52badff40e571e 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -113,3 +113,52 @@ test('availability rejects disallowed periods and unknown kinds', () => {
   assert.throws(() => s.availability({ start: 'garbage', end: d(2) }));
   assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'kayak' as 'board' }));
 });
+
+const h = (hour: number, day = 1) => `2026-07-${String(day).padStart(2, '0')}T${String(hour).padStart(2, '0')}:00:00.000Z`;
+
+function hourlySetup() {
+  const s = setup();
+  s.addEquipment({ id: 'board-h', kind: 'board', dailyPrice: 4500, hourlyPrice: 1200 });
+  return s;
+}
+
+test('a rental shorter than a day is priced per hour', () => {
+  const s = hourlySetup();
+  assert.deepEqual(s.quote({ itemId: 'board-h', start: h(14), end: h(17) }), {
+    itemId: 'board-h', start: h(14), end: h(17), total: 3600,
+  });
+  assert.equal(s.quote({ itemId: 'board-h', start: h(22), end: h(2, 2) }).total, 4800);
+  assert.equal(s.quote({ itemId: 'board-h', start: h(10), end: h(9, 2) }).total, 23 * 1200);
+  assert.equal(s.book({ itemId: 'board-h', start: h(14), end: h(15) }).total, 1200);
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  const s = hourlySetup();
+  assert.throws(() => s.quote({ itemId: 'board-1', start: h(14), end: h(17) }));
+  assert.throws(() => s.book({ itemId: 'board-1', start: h(14), end: h(17) }));
+});
+
+test('hourly periods must be on the hour and periods of a day or more on whole days', () => {
+  const s = hourlySetup();
+  assert.throws(() => s.quote({ itemId: 'board-h', start: '2026-07-01T14:30:00.000Z', end: h(17) }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: h(14), end: '2026-07-01T17:00:01.000Z' }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: h(10), end: h(10, 3) }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: h(17), end: h(14) }));
+  assert.equal(s.quote({ itemId: 'board-h', start: d(1), end: d(2) }).total, 4500);
+});
+
+test('hourly bookings conflict only when the hours overlap', () => {
+  const s = hourlySetup();
+  s.book({ itemId: 'board-h', start: h(10), end: h(12) });
+  assert.throws(() => s.book({ itemId: 'board-h', start: h(11), end: h(13) }));
+  assert.throws(() => s.book({ itemId: 'board-h', start: d(1), end: d(2) }));
+  s.book({ itemId: 'board-h', start: h(12), end: h(13) });
+  assert.deepEqual(s.availability({ start: h(9), end: h(10), kind: 'board' }), ['board-1', 'board-h']);
+  assert.deepEqual(s.availability({ start: h(11), end: h(12), kind: 'board' }), ['board-1']);
+});
+
+test('addEquipment validates the hourly price', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+});
