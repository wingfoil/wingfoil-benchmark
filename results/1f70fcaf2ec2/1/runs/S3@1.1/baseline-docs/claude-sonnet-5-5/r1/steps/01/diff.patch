--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,113 @@
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?Z$/;
+
+/** The kinds of equipment the school rents. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item; `dailyPrice` is an integer number of euro cents per day. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** A rental period for an item: `start` and `end` are midnight-UTC ISO-8601 strings, `end` exclusive. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The cost of renting an item for a period; `total` is in euro cents. */
+export interface Quote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed booking; `id` identifies it. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** The in-memory rental service of the booking desk. */
+export interface RentalService {
+  /** Registers an item for rental; throws on an invalid item or a duplicate id. */
+  addEquipment(item: Equipment): void;
+  /** Prices a rental; throws for an unknown item or a disallowed period. */
+  quote(request: RentalRequest): Quote;
+  /** Books an item; throws like `quote`, and when the item is not free for the whole period. */
+  book(request: RentalRequest): Booking;
+}
+
+function parseMidnightUtc(value: unknown, label: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${label} must be an ISO-8601 UTC string at midnight`);
+  }
+  const time = Date.parse(value);
+  if (Number.isNaN(time) || new Date(time).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${label} is not a valid date`);
+  }
+  return time;
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item?.id !== 'string' || item.id === '') {
+    throw new Error('Equipment id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error("Equipment kind must be 'board' or 'sail'");
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('Equipment dailyPrice must be a non-negative integer number of cents');
+  }
+}
+
+/** Creates an empty rental service that keeps all its data in memory. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Booking[] = [];
+
+  function price(request: RentalRequest): { quote: Quote; start: number; end: number } {
+    const item = equipment.get(request?.itemId);
+    if (!item) {
+      throw new Error(`Unknown item: ${String(request?.itemId)}`);
+    }
+    const start = parseMidnightUtc(request.start, 'start');
+    const end = parseMidnightUtc(request.end, 'end');
+    if (end <= start) {
+      throw new Error('end must be after start');
+    }
+    const days = (end - start) / DAY_MS;
+    const total = item.dailyPrice * days;
+    if (!Number.isSafeInteger(total)) {
+      throw new Error('total is too large');
+    }
+    return { quote: { itemId: item.id, start: request.start, end: request.end, total }, start, end };
+  }
+
+  return {
+    addEquipment(item) {
+      validateEquipment(item);
+      if (equipment.has(item.id)) {
+        throw new Error(`Equipment already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, start, end } = price(request);
+      const taken = bookings.some(
+        (b) => b.itemId === quote.itemId && Date.parse(b.start) < end && start < Date.parse(b.end),
+      );
+      if (taken) {
+        throw new Error(`Item ${quote.itemId} is not free for the whole period`);
+      }
+      const booking: Booking = { id: `booking-${bookings.length + 1}`, ...quote };
+      bookings.push(booking);
+      return { ...booking };
+    },
+  };
+}
diff --git a/test/rental.test.ts b/test/rental.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c401fcd1b3cece15f3a119a74758b22e67172075
--- /dev/null
+++ b/test/rental.test.ts
@@ -0,0 +1,69 @@
+import { strict as assert } from 'node:assert';
+import { test } from 'node:test';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 4500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 2000 });
+  return service;
+}
+
+const d = (day: number) => `2026-07-${String(day).padStart(2, '0')}T00:00:00.000Z`;
+
+test('quote prices whole days in cents', () => {
+  assert.deepEqual(setup().quote({ itemId: 'board-1', start: d(1), end: d(4) }), {
+    itemId: 'board-1', start: d(1), end: d(4), total: 13500,
+  });
+});
+
+test('quote accepts the form without milliseconds', () => {
+  const q = setup().quote({ itemId: 'sail-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  assert.equal(q.total, 2000);
+});
+
+test('quote rejects unknown items and disallowed periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'nope', start: d(1), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: d(2), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: d(3), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: '2026-07-01T10:00:00.000Z', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00+02:00', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: '2026-02-30T00:00:00.000Z', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: 'garbage', end: d(2) }));
+});
+
+test('book returns a booking with an id and distinct ids per booking', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'board-1', start: d(1), end: d(2) });
+  const b = s.book({ itemId: 'board-1', start: d(2), end: d(3) });
+  assert.equal(a.total, 4500);
+  assert.equal(a.itemId, 'board-1');
+  assert.notEqual(a.id, b.id);
+});
+
+test('book refuses overlapping periods for the same item only', () => {
+  const s = setup();
+  s.book({ itemId: 'board-1', start: d(5), end: d(8) });
+  assert.throws(() => s.book({ itemId: 'board-1', start: d(7), end: d(9) }));
+  assert.throws(() => s.book({ itemId: 'board-1', start: d(4), end: d(6) }));
+  assert.throws(() => s.book({ itemId: 'board-1', start: d(1), end: d(20) }));
+  assert.throws(() => s.book({ itemId: 'board-1', start: d(6), end: d(7) }));
+  s.book({ itemId: 'board-1', start: d(8), end: d(9) });
+  s.book({ itemId: 'board-1', start: d(4), end: d(5) });
+  s.book({ itemId: 'sail-1', start: d(5), end: d(8) });
+});
+
+test('a failed book leaves no booking behind', () => {
+  const s = setup();
+  assert.throws(() => s.book({ itemId: 'nope', start: d(1), end: d(2) }));
+  s.book({ itemId: 'board-1', start: d(1), end: d(2) });
+});
+
+test('addEquipment validates items', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'kayak' as 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10.5 }));
+  assert.throws(() => s.addEquipment({ id: '', kind: 'board', dailyPrice: 10 }));
+});
