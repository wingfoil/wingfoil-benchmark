@@ -172,5 +198,19 @@ export function createRentalService(): RentalService {
         .map((item) => item.id)
         .sort();
     },
+
+    cancel(bookingId, at) {
+      const booking = bookings.find((b) => b.id === bookingId);
+      if (!booking) {
+        throw new Error(`Unknown booking: ${String(bookingId)}`);
+      }
+      const atTime = parseInstantUtc(at, 'at');
+      if (cancelled.has(booking.id)) {
+        throw new Error(`Booking ${booking.id} is already cancelled`);
+      }
+      cancelled.add(booking.id);
+      const refund = Date.parse(booking.start) - atTime >= FULL_REFUND_NOTICE_MS ? booking.total : 0;
+      return { bookingId: booking.id, refund };
+    },
