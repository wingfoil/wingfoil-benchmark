diff --git a/test/rental.test.ts b/test/rental.test.ts
index de9f5d8c06eba1c000871cae5f52badff40e571e..87200aec078d211e62a425fcf1b5a1f037bd590a 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -162,3 +162,49 @@ test('addEquipment validates the hourly price', () => {
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
 });
+
+const at = (day: number, hour = 0) => `2026-06-${String(day).padStart(2, '0')}T${String(hour).padStart(2, '0')}:00:00.000Z`;
+
+test('cancel refunds the full total at least 24 hours before the start', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'board-1', start: d(10), end: d(12) });
+  assert.deepEqual(s.cancel(b.id, '2026-07-09T00:00:00Z'), { bookingId: b.id, refund: 9000 });
+});
+
+test('cancel refunds nothing less than 24 hours before the start, or after it', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'board-1', start: d(10), end: d(12) });
+  const b = s.book({ itemId: 'sail-1', start: d(10), end: d(12) });
+  assert.equal(s.cancel(a.id, '2026-07-09T00:00:01Z').refund, 0);
+  assert.equal(s.cancel(b.id, d(11)).refund, 0);
+});
+
+test('cancel refunds the discounted total actually paid', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'board-1', start: d(10), end: d(13) });
+  assert.equal(s.cancel(b.id, at(1)).refund, 12150);
+});
+
+test('a cancelled booking releases its equipment and ids stay sequential', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'board-1', start: d(10), end: d(12) });
+  s.cancel(b.id, at(1));
+  assert.deepEqual(s.availability({ start: d(10), end: d(12), kind: 'board' }), ['board-1']);
+  assert.equal(s.book({ itemId: 'board-1', start: d(10), end: d(12) }).id, 'booking-2');
+});
+
+test('a booking can only be cancelled once, even if the first cancellation was invalid in time', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'board-1', start: d(10), end: d(12) });
+  s.cancel(b.id, at(1));
+  assert.throws(() => s.cancel(b.id, at(2)), /already cancelled/);
+});
+
+test('cancel rejects unknown bookings and invalid instants', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'board-1', start: d(10), end: d(12) });
+  assert.throws(() => s.cancel('booking-9', at(1)), /Unknown booking/);
+  assert.throws(() => s.cancel(b.id, 'tomorrow'), /at must be/);
+  assert.throws(() => s.cancel(b.id, '2026-02-31T00:00:00Z'), /not a valid date/);
+  assert.equal(s.cancel(b.id, at(1)).refund, 9000);
+});
