+function parseInstantUtc(value: unknown, label: string): number {
+  if (typeof value !== 'string' || !INSTANT_UTC.test(value)) {
+    throw new Error(`${label} must be an ISO-8601 UTC string`);
+  }
+  const time = Date.parse(value);
+  if (Number.isNaN(time) || new Date(time).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${label} is not a valid date`);
+  }
+  return time;
+}
