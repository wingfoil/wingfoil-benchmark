+
+test('rentals shorter than a day are priced per hour', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2500, hourlyPrice: 700 });
+  s.addEquipment({ id: 'n', kind: 'board', dailyPrice: 2500 });
+  const q = (itemId: string, start: string, end: string) => ({ itemId, start, end });
+  assert.equal(s.quote(q('h', '2027-05-01T09:00:00Z', '2027-05-01T12:00:00Z')).total, 2100);
+  assert.equal(s.quote(q('h', '2027-05-01T10:00:00Z', '2027-05-02T09:00:00Z')).total, 23 * 700);
+  assert.throws(() => s.quote(q('n', '2027-05-01T09:00:00Z', '2027-05-01T12:00:00Z')));
+  assert.throws(() => s.quote(q('h', '2027-05-01T09:30:00Z', '2027-05-01T12:00:00Z')));
+  assert.throws(() => s.quote(q('h', '2027-05-01T10:00:00Z', '2027-05-02T10:00:00Z')));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+  s.book(q('h', '2027-05-01T09:00:00Z', '2027-05-01T12:00:00Z'));
+  assert.throws(() => s.book(q('h', '2027-05-01T11:00:00Z', '2027-05-01T13:00:00Z')));
+  s.book(q('h', '2027-05-01T12:00:00Z', '2027-05-01T13:00:00Z'));
+});
