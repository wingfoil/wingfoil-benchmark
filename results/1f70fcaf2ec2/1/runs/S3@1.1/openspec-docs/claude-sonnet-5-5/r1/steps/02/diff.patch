@@ -30,3 +30,15 @@ test('book rejects overlaps but allows adjacent periods', () => {
   assert.notEqual(a.id, b.id);
   assert.equal(a.total, 5000);
 });
+
+test('availability lists free items of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a1', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 1000 });
+  s.book(r('2027-05-02T00:00:00Z', '2027-05-04T00:00:00Z'));
+  const q = { start: '2027-05-01T00:00:00Z', end: '2027-05-03T00:00:00Z' };
+  assert.deepEqual(s.availability(q), ['a0', 'a1']);
+  assert.deepEqual(s.availability({ ...q, kind: 'board' }), ['a0']);
+  assert.deepEqual(s.availability({ start: '2027-05-04T00:00:00Z', end: '2027-05-05T00:00:00Z' }), ['a0', 'a1', 'b1']);
+  assert.throws(() => s.availability({ ...q, end: q.start }));
+});
