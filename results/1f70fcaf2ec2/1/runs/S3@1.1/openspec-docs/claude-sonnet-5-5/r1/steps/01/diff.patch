--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,105 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one day of rental, in euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  /** ISO-8601 UTC, midnight. */
+  start: string;
+  /** ISO-8601 UTC, midnight: the start of the day after the last rented day. */
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  /** Euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00(?::00(?:\.0+)?)?(?:Z|[+-]00:00)$/;
+
+function parseDay(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !UTC_MIDNIGHT.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 string at midnight UTC`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms) || ms % DAY_MS !== 0) {
+    throw new Error(`${name} must be an ISO-8601 string at midnight UTC`);
+  }
+  return ms;
+}
+
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: { id: string; itemId: string; start: number; end: number }[] = [];
+  let nextId = 1;
+
+  function price(request: RentalRequest) {
+    const item = equipment.get(request?.itemId);
+    if (!item) throw new Error(`unknown item: ${String(request?.itemId)}`);
+    const start = parseDay(request.start, 'start');
+    const end = parseDay(request.end, 'end');
+    if (end <= start) throw new Error('end must be after start');
+    const total = ((end - start) / DAY_MS) * item.dailyPrice;
+    if (!Number.isSafeInteger(total)) throw new Error('total is too large');
+    return {
+      quote: {
+        itemId: item.id,
+        start: new Date(start).toISOString(),
+        end: new Date(end).toISOString(),
+        total,
+      },
+      start,
+      end,
+    };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item?.id !== 'string' || item.id === '') {
+        throw new Error('equipment id must be a non-empty string');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error("equipment kind must be 'board' or 'sail'");
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+      }
+      if (equipment.has(item.id)) throw new Error(`duplicate equipment id: ${item.id}`);
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, start, end } = price(request);
+      const clash = bookings.some(
+        (b) => b.itemId === quote.itemId && start < b.end && b.start < end,
+      );
+      if (clash) throw new Error(`item ${quote.itemId} is not free for the whole period`);
+      const id = String(nextId++);
+      bookings.push({ id, itemId: quote.itemId, start, end });
+      return { id, ...quote };
+    },
+  };
+}
diff --git a/test/rental.test.ts b/test/rental.test.ts
