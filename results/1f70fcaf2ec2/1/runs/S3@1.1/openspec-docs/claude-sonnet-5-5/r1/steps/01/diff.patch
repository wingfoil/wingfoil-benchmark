index 0000000000000000000000000000000000000000..a708e4a8071b18affdff9dc1d62f3d701e666b6d
--- /dev/null
+++ b/test/rental.test.ts
@@ -0,0 +1,32 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  return s;
+}
+const r = (start: string, end: string) => ({ itemId: 'b1', start, end });
+
+test('quote multiplies days by daily price', () => {
+  const q = setup().quote(r('2027-05-01T00:00:00Z', '2027-05-04T00:00:00Z'));
+  assert.equal(q.total, 7500);
+});
+
+test('rejects unknown item and non-midnight or inverted periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'x', start: '2027-05-01T00:00:00Z', end: '2027-05-02T00:00:00Z' }));
+  assert.throws(() => s.quote(r('2027-05-01T10:00:00Z', '2027-05-02T00:00:00Z')));
+  assert.throws(() => s.quote(r('2027-05-01T00:00:00+02:00', '2027-05-02T00:00:00Z')));
+  assert.throws(() => s.quote(r('2027-05-02T00:00:00Z', '2027-05-02T00:00:00Z')));
+});
+
+test('book rejects overlaps but allows adjacent periods', () => {
+  const s = setup();
+  const a = s.book(r('2027-05-01T00:00:00Z', '2027-05-03T00:00:00Z'));
+  assert.throws(() => s.book(r('2027-05-02T00:00:00Z', '2027-05-04T00:00:00Z')));
+  const b = s.book(r('2027-05-03T00:00:00Z', '2027-05-04T00:00:00Z'));
+  assert.notEqual(a.id, b.id);
+  assert.equal(a.total, 5000);
+});
