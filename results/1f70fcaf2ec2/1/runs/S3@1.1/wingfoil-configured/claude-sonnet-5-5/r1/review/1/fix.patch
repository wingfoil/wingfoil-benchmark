--- a/src/index.ts
+++ b/src/index.ts
@@ -49,7 +49,7 @@ export interface RentalService {
   availability(query: AvailabilityQuery): string[];
   /**
    * Cancels a booking at `at` (ISO-8601 UTC); the equipment is free again. A booking can be cancelled once.
-   * Refund policy: the whole total when `at` is before the booking starts, nothing from its start on.
+   * Refund policy: the whole total when `at` is at least 24 h before the booking starts, nothing after that.
    */
   cancel(bookingId: string, at: string): Cancellation;
 }
@@ -201,7 +201,7 @@ export function createRentalService(): RentalService {
         throw new Error(`booking ${booking.id} is already cancelled`);
       }
       booking.cancelled = true;
-      return { bookingId: booking.id, refund: atMs < booking.start ? booking.total : 0 };
+      return { bookingId: booking.id, refund: booking.start - atMs >= DAY_MS ? booking.total : 0 };
     },
   };
 }
