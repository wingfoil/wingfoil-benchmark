@@ -92,3 +92,37 @@ test('long-stay total is rounded to whole cents and booking shows it', () => {
   assert.equal(s.quote({ itemId: 'x', start: d(1), end: d(4) }).total, 2714); // 3015 * 0.9 = 2713.5
   assert.equal(s.book({ itemId: 'x', start: d(1), end: d(4) }).total, 2714);
