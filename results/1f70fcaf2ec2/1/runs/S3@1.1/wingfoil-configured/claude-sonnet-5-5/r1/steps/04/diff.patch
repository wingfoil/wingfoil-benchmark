+
+test('hourly rentals are priced per hour, without long-stay discount', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 5000, hourlyPrice: 900 });
+  const t = (h: number) => `2026-04-01T${String(h).padStart(2, '0')}:00:00Z`;
+  assert.equal(s.quote({ itemId: 'h', start: t(9), end: t(10) }).total, 900);
+  assert.equal(s.quote({ itemId: 'h', start: t(9), end: t(17) }).total, 7200);
+  assert.equal(s.quote({ itemId: 'h', start: t(0), end: t(23) }).total, 20700);
+  assert.equal(s.quote({ itemId: 'h', start: t(10), end: '2026-04-02T00:00:00Z' }).total, 12600);
+  assert.equal(s.book({ itemId: 'h', start: t(9), end: t(12) }).total, 2700);
+  assert.throws(() => s.book({ itemId: 'h', start: t(11), end: t(13) })); // overlaps
+  s.book({ itemId: 'h', start: t(12), end: t(13) });
+});
+
+test('hourly rentals need an hourly price and whole hours', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 5000, hourlyPrice: 900 });
+  s.addEquipment({ id: 'n', kind: 'board', dailyPrice: 5000 });
+  assert.throws(() => s.quote({ itemId: 'n', start: '2026-04-01T09:00:00Z', end: '2026-04-01T10:00:00Z' }));
+  assert.throws(() => s.book({ itemId: 'n', start: '2026-04-01T09:00:00Z', end: '2026-04-01T10:00:00Z' }));
+  assert.throws(() => s.quote({ itemId: 'h', start: '2026-04-01T09:30:00Z', end: '2026-04-01T11:00:00Z' }));
+  assert.throws(() => s.quote({ itemId: 'h', start: '2026-04-01T09:00:00Z', end: '2026-04-01T10:00:00.500Z' }));
+  // a day or more must stay on midnights
+  assert.throws(() => s.quote({ itemId: 'h', start: '2026-04-01T09:00:00Z', end: '2026-04-02T09:00:00Z' }));
+  assert.throws(() => s.quote({ itemId: 'h', start: d(1), end: '2026-04-02T09:00:00Z' }));
+  assert.equal(s.quote({ itemId: 'h', start: d(1), end: d(2) }).total, 5000);
+});
+
+test('addEquipment validates hourlyPrice', () => {
+  const s = createRentalService();
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'board', dailyPrice: 10, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'board', dailyPrice: 10, hourlyPrice: -1 }));
+  s.addEquipment({ id: 'a', kind: 'board', dailyPrice: 10, hourlyPrice: 0 });
+});
