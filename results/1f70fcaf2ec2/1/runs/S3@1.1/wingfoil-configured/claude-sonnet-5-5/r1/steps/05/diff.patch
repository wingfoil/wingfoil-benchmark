   assert.throws(() => s.addEquipment({ id: 'a', kind: 'board', dailyPrice: 10, hourlyPrice: -1 }));
   s.addEquipment({ id: 'a', kind: 'board', dailyPrice: 10, hourlyPrice: 0 });
 });
+
+test('cancel frees the equipment and refunds before the start only', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1000 });
+  const b = s.book({ itemId: 'x', start: d(10), end: d(12) });
+  assert.deepEqual(s.availability({ start: d(10), end: d(12) }), []);
+  assert.deepEqual(s.cancel(b.id, d(9)), { bookingId: b.id, refund: 2000 });
+  assert.deepEqual(s.availability({ start: d(10), end: d(12) }), ['x']);
+  s.book({ itemId: 'x', start: d(10), end: d(12) });
+});
+
+test('cancel after the start refunds nothing', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1000 });
+  const a = s.book({ itemId: 'x', start: d(10), end: d(12) });
+  const b = s.book({ itemId: 'x', start: d(12), end: d(13) });
+  assert.equal(s.cancel(a.id, d(10)).refund, 0);
+  assert.equal(s.cancel(b.id, '2026-04-11T23:59:59Z').refund, 1000);
+});
+
+test('a booking can only be cancelled once, and must exist', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1000 });
+  const b = s.book({ itemId: 'x', start: d(10), end: d(12) });
+  s.cancel(b.id, d(1));
+  assert.throws(() => s.cancel(b.id, d(1)));
+  assert.throws(() => s.cancel('nope', d(1)));
+  assert.throws(() => s.cancel(s.book({ itemId: 'x', start: d(10), end: d(11) }).id, 'bad'));
+});
