   function price(request: RentalRequest): { item: Equipment; start: number; end: number; quote: Quote } {
     const item = equipment.get(request?.itemId);
@@ -155,12 +166,12 @@ export function createRentalService(): RentalService {
 
     book(request) {
       const { item, start, end, quote } = price(request);
-      const clash = bookings.some((b) => b.itemId === item.id && b.start < end && start < b.end);
+      const clash = bookings.some((b) => !b.cancelled && b.itemId === item.id && b.start < end && start < b.end);
       if (clash) {
         throw new Error(`item ${item.id} is not free for the whole period`);
       }
       const id = `booking-${bookings.length + 1}`;
-      bookings.push({ id, itemId: item.id, start, end });
+      bookings.push({ id, itemId: item.id, start, end, total: quote.total, cancelled: false });
       return { id, ...quote };
     },
 
@@ -175,9 +186,22 @@ export function createRentalService(): RentalService {
       }
       return [...equipment.values()]
         .filter((item) => query.kind === undefined || item.kind === query.kind)
-        .filter((item) => !bookings.some((b) => b.itemId === item.id && b.start < end && start < b.end))
+        .filter((item) => !bookings.some((b) => !b.cancelled && b.itemId === item.id && b.start < end && start < b.end))
         .map((item) => item.id)
         .sort();
     },
+
+    cancel(bookingId, at) {
+      const atMs = parseUtc(at, 'at');
+      const booking = bookings.find((b) => b.id === bookingId);
+      if (!booking) {
+        throw new Error(`unknown booking: ${String(bookingId)}`);
+      }
+      if (booking.cancelled) {
+        throw new Error(`booking ${booking.id} is already cancelled`);
+      }
+      booking.cancelled = true;
+      return { bookingId: booking.id, refund: atMs < booking.start ? booking.total : 0 };
+    },
   };
 }
