+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
   /** Ids of the equipment free for the whole period, sorted. */
   availability(query: AvailabilityQuery): string[];
+  /**
+   * Cancels a booking at `at` (ISO-8601 UTC); the equipment is free again. A booking can be cancelled once.
+   * Refund policy: the whole total when `at` is before the booking starts, nothing from its start on.
+   */
+  cancel(bookingId: string, at: string): Cancellation;
 }
 
 const HOUR_MS = 60 * 60 * 1000;
@@ -75,7 +86,7 @@ function parseMidnightUtc(value: unknown, name: string): number {
 
 export function createRentalService(): RentalService {
   const equipment = new Map<string, Equipment>();
-  const bookings: { id: string; itemId: string; start: number; end: number }[] = [];
