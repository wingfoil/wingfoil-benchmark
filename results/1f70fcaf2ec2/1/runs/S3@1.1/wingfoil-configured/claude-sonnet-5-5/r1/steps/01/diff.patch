@@ -0,0 +1,54 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2550 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  return s;
+}
+const d = (day: number) => `2026-04-${String(day).padStart(2, '0')}T00:00:00Z`;
+
+test('quote multiplies days by daily price in cents', () => {
+  const q = setup().quote({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.deepEqual(q, { itemId: 'b1', start: '2026-04-01T00:00:00.000Z', end: '2026-04-04T00:00:00.000Z', total: 7650 });
+});
+
+test('quote and book reject unknown items and bad periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'x', start: d(1), end: d(2) }));
+  assert.throws(() => s.book({ itemId: 'x', start: d(1), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(2), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(3), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-04-01T10:00:00Z', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-04-01T00:00:00+02:00', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-04-01', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: 'nonsense', end: d(2) }));
+});
+
+test('book returns an identified booking and blocks overlaps', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.equal(a.total, 5100);
+  assert.throws(() => s.book({ itemId: 'b1', start: d(2), end: d(4) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(1), end: d(2) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(1), end: d(10) }));
+  const b = s.book({ itemId: 'b1', start: d(3), end: d(5) }); // adjacent is fine
+  assert.notEqual(a.id, b.id);
+  s.book({ itemId: 's1', start: d(1), end: d(3) }); // other item is free
+});
+
+test('a failed booking does not block the period', () => {
+  const s = setup();
+  assert.throws(() => s.book({ itemId: 'b1', start: d(2), end: d(2) }));
+  s.book({ itemId: 'b1', start: d(1), end: d(3) });
+});
+
+test('addEquipment validates input', () => {
+  const s = createRentalService();
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'board', dailyPrice: 10.5 }));
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'kayak' as never, dailyPrice: 10 }));
+  s.addEquipment({ id: 'a', kind: 'board', dailyPrice: 10 });
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'sail', dailyPrice: 10 }));
+});
