diff --git a/src/index.ts b/src/index.ts
index 122173671b7124a813c863f72f63ac6e7ca86427..bb079121d16d579ade2d69ce19823564a2ad3d99 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -27,10 +27,21 @@ export interface Booking extends Quote {
   id: string;
 }
 
+export interface AvailabilityQuery {
+  /** ISO-8601 UTC, midnight. */
+  start: string;
+  /** ISO-8601 UTC, midnight, the start of the day after the last day wanted. */
+  end: string;
+  /** Only equipment of this kind; any kind when omitted. */
+  kind?: EquipmentKind;
+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  /** Ids, sorted, of the equipment free for the whole period. */
+  availability(query: AvailabilityQuery): string[];
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
@@ -108,5 +119,27 @@ export function createRentalService(): RentalService {
       bookings.push(booking);
       return { ...booking };
     },
+
+    availability(query) {
+      const startMs = parseMidnightUtc(query.start, 'start');
+      const endMs = parseMidnightUtc(query.end, 'end');
+      if (endMs <= startMs) {
+        throw new Error('end must be after start');
+      }
+      if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+        throw new Error(`Unknown equipment kind: ${String(query.kind)}`);
+      }
+      return [...equipment.values()]
+        .filter((item) => query.kind === undefined || item.kind === query.kind)
+        .filter(
+          (item) =>
+            !bookings.some(
+              (b) =>
+                b.itemId === item.id && Date.parse(b.start) < endMs && startMs < Date.parse(b.end),
+            ),
+        )
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
diff --git a/test/rental.test.ts b/test/rental.test.ts
index f0ac2b51b29eecc67ac7249bdc8ea32651b6429b..2bba3a084a4b0942872d9aa7dce8b26df69dbc75 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -96,3 +96,45 @@ test('addEquipment validates input', () => {
   assert.throws(() => s.addEquipment({ id: '', kind: 'board', dailyPrice: 100 }));
   assert.throws(() => s.addEquipment({ id: 'b2', kind: 'kayak' as never, dailyPrice: 100 }));
 });
+
+test('availability lists free items of the kind, or of any kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 100 });
+  const period = { start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' };
+  assert.deepEqual(s.availability(period), ['a0', 'b1', 's1']);
+  assert.deepEqual(s.availability({ ...period, kind: 'board' }), ['a0', 'b1']);
+  assert.deepEqual(s.availability({ ...period, kind: 'sail' }), ['s1']);
+});
+
+test('availability excludes items booked during any part of the period', () => {
+  const s = setup();
+  s.book(req('b1', '2026-07-02T00:00:00Z', '2026-07-05T00:00:00Z'));
+  const overlapping = [
+    ['2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'],
+    ['2026-07-04T00:00:00Z', '2026-07-06T00:00:00Z'],
+    ['2026-07-03T00:00:00Z', '2026-07-04T00:00:00Z'],
+    ['2026-07-01T00:00:00Z', '2026-07-09T00:00:00Z'],
+  ];
+  for (const [start, end] of overlapping) {
+    assert.deepEqual(s.availability({ start, end, kind: 'board' }), [], `${start} ${end}`);
+  }
+  assert.deepEqual(s.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-05T00:00:00Z' }), ['s1']);
+});
+
+test('availability treats adjacent bookings as free', () => {
+  const s = setup();
+  s.book(req('b1', '2026-07-02T00:00:00Z', '2026-07-05T00:00:00Z'));
+  assert.deepEqual(s.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }), ['b1', 's1']);
+  assert.deepEqual(s.availability({ start: '2026-07-05T00:00:00Z', end: '2026-07-06T00:00:00Z' }), ['b1', 's1']);
+});
+
+test('availability is empty without equipment of the kind and rejects bad queries', () => {
+  const s = createRentalService();
+  assert.deepEqual(s.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }), []);
+  const t = setup();
+  assert.throws(() => t.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+  assert.throws(() => t.availability({ start: '2026-07-01', end: '2026-07-02' }));
+  assert.throws(() =>
+    t.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'kayak' as never }),
+  );
+});
