diff --git a/test/rental.test.ts b/test/rental.test.ts
index fd9ca3c274da2b20d29f5c2dacba22c53281e8da..3ffdf5d05dd91449739c132b6a92517c5f6f35ec 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -157,3 +157,50 @@ test('long stay: fractional cents round half up', () => {
   s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 5 }); // 15 * 0.9 = 13.5
   assert.equal(s.quote(req('x', '2026-07-01T00:00:00Z', '2026-07-04T00:00:00Z')).total, 14);
 });
+
+function hourly() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2500, hourlyPrice: 700 });
+  s.addEquipment({ id: 'd', kind: 'board', dailyPrice: 2500 });
+  return s;
+}
+
+test('hourly: each hour at the hourly price, no long-stay discount', () => {
+  const s = hourly();
+  assert.equal(s.quote(req('h', '2026-07-01T13:00:00Z', '2026-07-01T14:00:00Z')).total, 700);
+  assert.equal(s.quote(req('h', '2026-07-01T09:00:00Z', '2026-07-01T16:00:00Z')).total, 4900);
+  assert.equal(s.quote(req('h', '2026-07-01T10:00:00Z', '2026-07-02T09:00:00Z')).total, 16100);
+  assert.equal(s.book(req('h', '2026-07-01T00:00:00Z', '2026-07-01T03:00:00Z')).total, 2100);
+});
+
+test('hourly: item without hourly price cannot be rented by the hour', () => {
+  const s = hourly();
+  assert.throws(() => s.quote(req('d', '2026-07-01T13:00:00Z', '2026-07-01T14:00:00Z')));
+  assert.throws(() => s.book(req('d', '2026-07-01T13:00:00Z', '2026-07-01T14:00:00Z')));
+});
+
+test('hourly: must start and end on the hour; a day or more stays daily', () => {
+  const s = hourly();
+  assert.throws(() => s.quote(req('h', '2026-07-01T13:30:00Z', '2026-07-01T15:00:00Z')));
+  assert.throws(() => s.quote(req('h', '2026-07-01T13:00:00Z', '2026-07-01T15:30:00Z')));
+  assert.throws(() => s.quote(req('h', '2026-07-01T13:00:00+02:00', '2026-07-01T15:00:00Z')));
+  assert.throws(() => s.quote(req('h', '2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z')));
+  assert.equal(s.quote(req('h', '2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z')).total, 2500);
+});
+
+test('hourly: bookings conflict by the hour, adjacent hours are fine', () => {
+  const s = hourly();
+  s.book(req('h', '2026-07-01T10:00:00Z', '2026-07-01T12:00:00Z'));
+  s.book(req('h', '2026-07-01T12:00:00Z', '2026-07-01T13:00:00Z'));
+  s.book(req('h', '2026-07-01T09:00:00Z', '2026-07-01T10:00:00Z'));
+  assert.throws(() => s.book(req('h', '2026-07-01T11:00:00Z', '2026-07-01T12:00:00Z')));
+  assert.throws(() => s.book(req('h', '2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z')));
+  assert.deepEqual(s.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }), ['d']);
+});
+
+test('addEquipment validates hourlyPrice', () => {
+  const s = createRentalService();
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'board', dailyPrice: 100, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'board', dailyPrice: 100, hourlyPrice: -1 }));
+  s.addEquipment({ id: 'a', kind: 'board', dailyPrice: 100, hourlyPrice: 0 });
+});
