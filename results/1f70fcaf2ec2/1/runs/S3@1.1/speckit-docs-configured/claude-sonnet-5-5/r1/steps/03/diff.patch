--- a/src/index.ts
+++ b/src/index.ts
@@ -45,6 +45,17 @@ export interface RentalService {
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
+/** Rule 5: a rental of at least this many days gets the long-stay discount. */
+const LONG_STAY_MIN_DAYS = 3;
+/** Rule 5: the long-stay price is this many tenths of the full price (10% off). */
+const LONG_STAY_TENTHS = 9;
+
+/** Rule 5: full price in cents, less 10% from 3 days; rounded half up to a whole cent. */
+function rentalTotal(days: number, dailyPrice: number): number {
+  const full = days * dailyPrice;
+  return days >= LONG_STAY_MIN_DAYS ? Math.floor((full * LONG_STAY_TENTHS + 5) / 10) : full;
+}
+
 const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00(:00(\.0+)?)?(Z|\+00:00)$/;
 
 /** Rule 2 and 3: an ISO-8601 string at midnight UTC, as milliseconds since the epoch. */
@@ -78,7 +89,7 @@ export function createRentalService(): RentalService {
     const start = new Date(startMs).toISOString();
     const end = new Date(endMs).toISOString();
     return {
-      quote: { itemId: item.id, start, end, total: days * item.dailyPrice },
+      quote: { itemId: item.id, start, end, total: rentalTotal(days, item.dailyPrice) },
       startMs,
       endMs,
     };
