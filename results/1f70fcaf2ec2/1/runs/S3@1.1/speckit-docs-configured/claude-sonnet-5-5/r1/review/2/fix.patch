diff --git a/test/rental.test.ts b/test/rental.test.ts
index b98f5e30537464b008c67c9fec7e99f07157bf08..e5ef2a34f82f08bae6f4dd580613507348662600 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -218,3 +218,17 @@ test('a total beyond the safe-integer range is rejected', () => {
   s.addEquipment({ id: 'big', kind: 'board', dailyPrice: Number.MAX_SAFE_INTEGER });
   assert.throws(() => s.quote(req('big', '2026-07-01T00:00:00Z', '2026-07-05T00:00:00Z')));
 });
+
+test('an hourly total beyond the safe-integer range is rejected', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'big', kind: 'board', dailyPrice: 1, hourlyPrice: Number.MAX_SAFE_INTEGER });
+  assert.throws(() => s.quote(req('big', '2026-07-01T10:00:00Z', '2026-07-01T12:00:00Z')), /too large/);
+  assert.equal(s.quote(req('big', '2026-07-01T10:00:00Z', '2026-07-01T11:00:00Z')).total, Number.MAX_SAFE_INTEGER);
+});
+
+test('a short stay is not rejected for discount arithmetic it never uses', () => {
+  const s = createRentalService();
+  const dailyPrice = Math.floor(Number.MAX_SAFE_INTEGER / 2);
+  s.addEquipment({ id: 'big', kind: 'board', dailyPrice });
+  assert.equal(s.quote(req('big', '2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z')).total, dailyPrice * 2);
+});
