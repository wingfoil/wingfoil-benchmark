diff --git a/test/rental.test.ts b/test/rental.test.ts
index f8f825be59235c210f0cf78d6af4503194a5e1f2..1747b1cfcad49ec159a5f21bad554477d6a0cdfa 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -193,3 +193,40 @@ test('addEquipment validates the hourly price', () => {
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
   assert.doesNotThrow(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 0 }));
 });
+
+test('cancel refunds the full total at least 24 hours before the start', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'board-1', start: day(10), end: day(13) });
+  assert.deepStrictEqual(s.cancel(b.id, '2026-06-09T00:00:00Z'), { bookingId: b.id, refund: 6750 });
+});
+
+test('cancel refunds nothing less than 24 hours before the start or after it', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'board-1', start: day(10), end: day(11) });
+  const b = s.book({ itemId: 'sail-1', start: day(10), end: day(11) });
+  assert.strictEqual(s.cancel(a.id, '2026-06-09T00:00:01Z').refund, 0);
+  assert.strictEqual(s.cancel(b.id, day(12)).refund, 0);
+});
+
+test('a cancelled booking frees its equipment', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'board-1', start: day(10), end: day(11) });
+  s.cancel(b.id, day(1));
+  assert.deepStrictEqual(s.availability({ start: day(10), end: day(11), kind: 'board' }), ['board-1']);
+  assert.notStrictEqual(s.book({ itemId: 'board-1', start: day(10), end: day(11) }).id, b.id);
+});
+
+test('a booking can only be cancelled once', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'board-1', start: day(10), end: day(11) });
+  s.cancel(b.id, day(1));
+  assert.throws(() => s.cancel(b.id, day(2)), /already cancelled/);
+});
+
+test('cancel rejects an unknown booking and an invalid time', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'board-1', start: day(10), end: day(11) });
+  assert.throws(() => s.cancel('nope', day(1)), /unknown booking/);
+  assert.throws(() => s.cancel(b.id, 'yesterday'), /at must be/);
+  assert.strictEqual(s.cancel(b.id, day(1)).refund, 2500);
+});
