+++ b/src/index.ts
@@ -0,0 +1,115 @@
+/** The kinds of equipment the school rents out. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item. `dailyPrice` is the price of one day, in integer euro cents. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/**
+ * A rental period: `start` and `end` are ISO-8601 UTC strings at midnight.
+ * `end` is the start of the day after the last rented day.
+ */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The price of a rental request; `total` is in integer euro cents. */
+export interface Quote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed booking; `id` identifies it. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** The in-memory rental service of the booking desk. */
+export interface RentalService {
+  /** Registers an item for rental; throws on an invalid item or a duplicate id. */
+  addEquipment(item: Equipment): void;
+  /** Prices a rental; throws for an unknown item or a disallowed period. */
+  quote(request: RentalRequest): Quote;
+  /** Books an item; throws like `quote`, and when the item is not free for the whole period. */
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00(:00(\.0+)?)?(Z|[+-]00:?00)$/;
+
+function parseMidnightUtc(value: unknown, label: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${label} must be an ISO-8601 UTC string at midnight`);
+  }
+  const time = Date.parse(value);
+  if (Number.isNaN(time) || new Date(time).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${label} is not a valid date`);
+  }
+  return time;
+}
+
+function parsePeriod(request: RentalRequest): { start: number; end: number; days: number } {
+  const start = parseMidnightUtc(request?.start, 'start');
+  const end = parseMidnightUtc(request?.end, 'end');
+  if (end <= start) {
+    throw new Error('end must be after start');
+  }
+  return { start, end, days: (end - start) / DAY_MS };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item?.id !== 'string' || item.id === '') {
+    throw new Error('id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error("kind must be 'board' or 'sail'");
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+  }
+}
+
+/** Creates an empty rental service that keeps equipment and bookings in memory. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Array<{ id: string; itemId: string; start: number; end: number }> = [];
+
+  function price(request: RentalRequest): { quote: Quote; start: number; end: number } {
+    const item = equipment.get(request?.itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${String(request?.itemId)}`);
+    }
+    const { start, end, days } = parsePeriod(request);
+    const { itemId, start: s, end: e } = request;
+    return { quote: { itemId, start: s, end: e, total: item.dailyPrice * days }, start, end };
+  }
+
+  return {
+    addEquipment(item) {
+      validateEquipment(item);
+      if (equipment.has(item.id)) {
+        throw new Error(`equipment already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, start, end } = price(request);
+      const clash = bookings.some((b) => b.itemId === quote.itemId && start < b.end && b.start < end);
+      if (clash) {
+        throw new Error(`item ${quote.itemId} is not free for the whole period`);
+      }
+      const id = `booking-${bookings.length + 1}`;
+      bookings.push({ id, itemId: quote.itemId, start, end });
+      return { id, ...quote };
+    },
+  };
+}
diff --git a/test/rental.test.ts b/test/rental.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..503d5c847e7ab0acdc16403ea6e00a5a5bb551db
--- /dev/null
+++ b/test/rental.test.ts
@@ -0,0 +1,73 @@
+import { test } from 'node:test';
+import assert from 'node:assert';
+import { createRentalService } from '../src/index.ts';
+
+const day = (d: number) => `2026-06-${String(d).padStart(2, '0')}T00:00:00.000Z`;
+
+function setup() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  return service;
+}
+
+test('quote prices whole days in cents', () => {
+  const q = setup().quote({ itemId: 'board-1', start: day(1), end: day(4) });
+  assert.deepStrictEqual(q, { itemId: 'board-1', start: day(1), end: day(4), total: 7500 });
+});
+
+test('quote accepts the Z form without milliseconds', () => {
+  const q = setup().quote({ itemId: 'sail-1', start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' });
+  assert.strictEqual(q.total, 1500);
+});
+
+test('quote rejects unknown items and disallowed periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'nope', start: day(1), end: day(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: '2026-06-01T10:00:00Z', end: day(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: day(1), end: '2026-06-02T00:00:00+02:00' }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: day(2), end: day(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: day(3), end: day(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: 'garbage', end: day(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: '2026-02-30T00:00:00Z', end: day(2) }));
+});
+
+test('book returns a booking with distinct ids', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'board-1', start: day(1), end: day(3) });
+  const b = s.book({ itemId: 'sail-1', start: day(1), end: day(3) });
+  assert.deepStrictEqual({ ...a, id: '' }, { id: '', itemId: 'board-1', start: day(1), end: day(3), total: 5000 });
+  assert.notStrictEqual(a.id, b.id);
+});
+
+test('book rejects overlapping periods for the same item only', () => {
+  const s = setup();
+  s.book({ itemId: 'board-1', start: day(2), end: day(5) });
+  assert.throws(() => s.book({ itemId: 'board-1', start: day(1), end: day(3) }));
+  assert.throws(() => s.book({ itemId: 'board-1', start: day(4), end: day(6) }));
+  assert.throws(() => s.book({ itemId: 'board-1', start: day(3), end: day(4) }));
+  assert.throws(() => s.book({ itemId: 'board-1', start: day(1), end: day(9) }));
+  assert.doesNotThrow(() => s.book({ itemId: 'sail-1', start: day(2), end: day(5) }));
+});
+
+test('back-to-back periods do not overlap', () => {
+  const s = setup();
+  s.book({ itemId: 'board-1', start: day(2), end: day(5) });
+  assert.doesNotThrow(() => s.book({ itemId: 'board-1', start: day(5), end: day(6) }));
+  assert.doesNotThrow(() => s.book({ itemId: 'board-1', start: day(1), end: day(2) }));
+});
+
+test('a failed booking does not block the period', () => {
+  const s = setup();
+  assert.throws(() => s.book({ itemId: 'board-1', start: '2026-06-01T05:00:00Z', end: day(3) }));
+  assert.doesNotThrow(() => s.book({ itemId: 'board-1', start: day(1), end: day(3) }));
+});
+
+test('addEquipment validates items', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: '', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'kayak' as 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
+});
