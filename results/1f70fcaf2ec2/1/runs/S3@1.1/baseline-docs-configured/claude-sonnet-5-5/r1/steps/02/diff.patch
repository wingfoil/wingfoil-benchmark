diff --git a/test/rental.test.ts b/test/rental.test.ts
index 503d5c847e7ab0acdc16403ea6e00a5a5bb551db..a75d96f2f4ffc6e5f1478ea850e7da0f826e865a 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -71,3 +71,46 @@ test('addEquipment validates items', () => {
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
 });
+
+function stocked() {
+  const s = setup();
+  s.addEquipment({ id: 'board-0', kind: 'board', dailyPrice: 2000 });
+  s.addEquipment({ id: 'sail-0', kind: 'sail', dailyPrice: 1000 });
+  return s;
+}
+
+test('availability lists free equipment sorted, of one kind or of any', () => {
+  const s = stocked();
+  assert.deepStrictEqual(s.availability({ start: day(1), end: day(3) }), ['board-0', 'board-1', 'sail-0', 'sail-1']);
+  assert.deepStrictEqual(s.availability({ start: day(1), end: day(3), kind: 'sail' }), ['sail-0', 'sail-1']);
+});
+
+test('availability excludes items booked for any part of the period', () => {
+  const s = stocked();
+  s.book({ itemId: 'board-1', start: day(2), end: day(5) });
+  assert.deepStrictEqual(s.availability({ start: day(1), end: day(3), kind: 'board' }), ['board-0']);
+  assert.deepStrictEqual(s.availability({ start: day(4), end: day(9), kind: 'board' }), ['board-0']);
+  assert.deepStrictEqual(s.availability({ start: day(3), end: day(4), kind: 'board' }), ['board-0']);
+  assert.deepStrictEqual(s.availability({ start: day(1), end: day(9), kind: 'board' }), ['board-0']);
+});
+
+test('availability treats back-to-back periods as free', () => {
+  const s = stocked();
+  s.book({ itemId: 'board-1', start: day(2), end: day(5) });
+  assert.deepStrictEqual(s.availability({ start: day(5), end: day(6), kind: 'board' }), ['board-0', 'board-1']);
+  assert.deepStrictEqual(s.availability({ start: day(1), end: day(2), kind: 'board' }), ['board-0', 'board-1']);
+});
+
+test('availability is empty when nothing matches', () => {
+  const s = setup();
+  s.book({ itemId: 'sail-1', start: day(1), end: day(2) });
+  assert.deepStrictEqual(s.availability({ start: day(1), end: day(2), kind: 'sail' }), []);
+  assert.deepStrictEqual(createRentalService().availability({ start: day(1), end: day(2) }), []);
+});
+
+test('availability rejects disallowed periods and kinds', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: '2026-06-01T10:00:00Z', end: day(2) }));
+  assert.throws(() => s.availability({ start: day(2), end: day(2) }));
+  assert.throws(() => s.availability({ start: day(1), end: day(2), kind: 'kayak' as 'board' }));
+});
