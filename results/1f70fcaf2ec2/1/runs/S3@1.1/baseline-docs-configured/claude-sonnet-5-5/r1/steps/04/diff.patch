diff --git a/test/rental.test.ts b/test/rental.test.ts
index 7c767ccf096b6576372f2f0d38ced0c4a07e0837..f8f825be59235c210f0cf78d6af4503194a5e1f2 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -128,7 +128,68 @@ test('availability is empty when nothing matches', () => {
 
 test('availability rejects disallowed periods and kinds', () => {
   const s = setup();
-  assert.throws(() => s.availability({ start: '2026-06-01T10:00:00Z', end: day(2) }));
+  assert.throws(() => s.availability({ start: '2026-06-01T10:30:00Z', end: day(2) }));
   assert.throws(() => s.availability({ start: day(2), end: day(2) }));
   assert.throws(() => s.availability({ start: day(1), end: day(2), kind: 'kayak' as 'board' }));
 });
+
+const at = (d: number, h: number) => `2026-06-${String(d).padStart(2, '0')}T${String(h).padStart(2, '0')}:00:00.000Z`;
+
+function hourly() {
+  const s = setup();
+  s.addEquipment({ id: 'board-h', kind: 'board', dailyPrice: 3000, hourlyPrice: 800 });
+  return s;
+}
+
+test('quote prices an hourly rental at the hourly price per hour, without discount', () => {
+  const s = hourly();
+  assert.strictEqual(s.quote({ itemId: 'board-h', start: at(1, 14), end: at(1, 15) }).total, 800);
+  assert.strictEqual(s.quote({ itemId: 'board-h', start: at(1, 9), end: at(1, 17) }).total, 6400);
+  assert.strictEqual(s.quote({ itemId: 'board-h', start: at(1, 0), end: at(1, 23) }).total, 18400);
+  assert.strictEqual(s.quote({ itemId: 'board-h', start: at(1, 22), end: at(2, 2) }).total, 3200);
+});
+
+test('a rental of a full day or more is still priced by the day', () => {
+  const s = hourly();
+  assert.strictEqual(s.quote({ itemId: 'board-h', start: day(1), end: day(2) }).total, 3000);
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  const s = hourly();
+  assert.throws(() => s.quote({ itemId: 'board-1', start: at(1, 9), end: at(1, 10) }));
+  assert.throws(() => s.book({ itemId: 'board-1', start: at(1, 9), end: at(1, 10) }));
+});
+
+test('periods must start and end on the hour, and long ones at midnight', () => {
+  const s = hourly();
+  assert.throws(() => s.quote({ itemId: 'board-h', start: '2026-06-01T09:30:00Z', end: at(1, 11) }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: at(1, 9), end: '2026-06-01T10:00:30Z' }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: at(1, 9), end: at(2, 9) }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: at(1, 9), end: day(3) }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: at(1, 9), end: at(1, 9) }));
+});
+
+test('hourly bookings block overlapping periods only', () => {
+  const s = hourly();
+  const b = s.book({ itemId: 'board-h', start: at(1, 10), end: at(1, 13) });
+  assert.strictEqual(b.total, 2400);
+  assert.throws(() => s.book({ itemId: 'board-h', start: at(1, 12), end: at(1, 14) }));
+  assert.throws(() => s.book({ itemId: 'board-h', start: day(1), end: day(2) }));
+  assert.doesNotThrow(() => s.book({ itemId: 'board-h', start: at(1, 13), end: at(1, 14) }));
+  assert.doesNotThrow(() => s.book({ itemId: 'board-h', start: at(1, 9), end: at(1, 10) }));
+});
+
+test('availability by the hour lists only equipment with an hourly price', () => {
+  const s = hourly();
+  assert.deepStrictEqual(s.availability({ start: at(1, 9), end: at(1, 10) }), ['board-h']);
+  s.book({ itemId: 'board-h', start: at(1, 9), end: at(1, 10) });
+  assert.deepStrictEqual(s.availability({ start: at(1, 9), end: at(1, 10) }), []);
+  assert.deepStrictEqual(s.availability({ start: day(1), end: day(2), kind: 'board' }), ['board-1']);
+});
+
+test('addEquipment validates the hourly price', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+  assert.doesNotThrow(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 0 }));
+});
