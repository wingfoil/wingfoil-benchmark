diff --git a/src/index.test.ts b/src/index.test.ts
index f79a80e50480861fd4ff8de9071bb9978421a2f7..c5a25573d33bffee7fabc04b7f7c5b0b5adc0f59 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -72,3 +72,20 @@ test('hourly rentals need an hourly price and whole hours', () => {
   assert.throws(() => s.quote(h('2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z')));
   assert.throws(() => s.addEquipment({ id: 'n', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
 });
+
+test('cancelling refunds before start, frees the equipment, and works only once', () => {
+  const s = setup();
+  const b = s.book(req('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.deepEqual(s.cancel(b.id, '2026-06-30T12:00:00Z'), { bookingId: b.id, refund: 5000 });
+  assert.equal(s.book(req('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z')).total, 5000);
+  assert.throws(() => s.cancel(b.id, '2026-06-30T13:00:00Z'), /already cancelled/);
+  assert.throws(() => s.cancel('nope', '2026-06-30T13:00:00Z'));
+});
+
+test('cancelling after the start refunds nothing; after the end is rejected', () => {
+  const s = setup();
+  const b = s.book(req('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.throws(() => s.cancel(b.id, 'garbage'));
+  assert.throws(() => s.cancel(b.id, '2026-07-03T00:00:00Z'));
+  assert.equal(s.cancel(b.id, '2026-07-02T00:00:00Z').refund, 0);
+});
