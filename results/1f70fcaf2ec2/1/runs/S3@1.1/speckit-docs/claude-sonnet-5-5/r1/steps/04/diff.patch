--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -52,3 +52,23 @@ test('lists free equipment by kind, sorted', () => {
   assert.deepEqual(s.availability({ start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z' }), ['a0', 'a1', 'b1']);
   assert.throws(() => s.availability({ start: q.end, end: q.start }));
 });
+
+test('rentals shorter than a day are priced per hour', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  const r = { itemId: 'h', start: '2026-07-01T13:00:00Z', end: '2026-07-01T17:00:00Z' };
+  assert.equal(s.quote(r).total, 2400);
+  assert.equal(s.book(r).total, 2400);
+  assert.throws(() => s.book({ ...r, start: '2026-07-01T16:00:00Z', end: '2026-07-01T18:00:00Z' }));
+  assert.deepEqual(s.availability({ start: '2026-07-01T17:00:00Z', end: '2026-07-01T18:00:00Z' }), ['h']);
+});
+
+test('hourly rentals need an hourly price and whole hours', () => {
+  const s = setup();
+  assert.throws(() => s.quote(req('2026-07-01T13:00:00Z', '2026-07-01T17:00:00Z')));
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  const h = (start: string, end: string) => ({ itemId: 'h', start, end });
+  assert.throws(() => s.quote(h('2026-07-01T13:30:00Z', '2026-07-01T17:00:00Z')));
+  assert.throws(() => s.quote(h('2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z')));
+  assert.throws(() => s.addEquipment({ id: 'n', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+});
