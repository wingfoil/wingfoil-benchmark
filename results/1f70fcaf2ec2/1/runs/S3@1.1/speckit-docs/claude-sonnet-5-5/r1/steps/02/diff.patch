@@ -27,3 +27,15 @@ test('prevents overlapping bookings but allows adjacent ones', () => {
   const b = s.book(req('2026-07-03T00:00:00Z', '2026-07-04T00:00:00Z'));
   assert.equal(b.total, 2500);
 });
+
+test('lists free equipment by kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a1', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 1000 });
+  s.book(req('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  const q = { start: '2026-07-02T00:00:00Z', end: '2026-07-04T00:00:00Z' };
+  assert.deepEqual(s.availability(q), ['a0', 'a1']);
+  assert.deepEqual(s.availability({ ...q, kind: 'board' }), ['a0']);
+  assert.deepEqual(s.availability({ start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z' }), ['a0', 'a1', 'b1']);
+  assert.throws(() => s.availability({ start: q.end, end: q.start }));
+});
