     },
+
+    availability(query) {
+      const start = parseMidnightUtc(query?.start, 'start');
+      const end = parseMidnightUtc(query?.end, 'end');
+      if (end <= start) throw new Error('end must be after start');
+      const kind = query.kind;
+      if (kind !== undefined && kind !== 'board' && kind !== 'sail') throw new Error(`Invalid kind: ${String(kind)}`);
+      return [...items.values()]
+        .filter((item) => kind === undefined || item.kind === kind)
+        .filter((item) => !bookings.some((b) => b.itemId === item.id && start < b.end && b.start < end))
+        .map((item) => item.id)
+        .sort();
+    },
   };
