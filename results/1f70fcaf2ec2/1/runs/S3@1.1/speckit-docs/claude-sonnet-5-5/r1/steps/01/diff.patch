+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number; // euro cents per day
+}
+
+export interface RentalRequest {
+  itemId: string;
+  start: string; // ISO-8601, midnight UTC
+  end: string; // ISO-8601, midnight UTC, start of the day after the last day
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  total: number; // euro cents
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00(?::00(?:\.0+)?)?(?:Z|[+-]00:?00)$/;
+
+function parseMidnightUtc(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC midnight, got ${String(value)}`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms) || ms % DAY_MS !== 0) {
+    throw new Error(`${name} is not a valid midnight UTC: ${value}`);
+  }
+  return ms;
+}
+
+export function createRentalService(): RentalService {
+  const items = new Map<string, Equipment>();
+  const bookings: { itemId: string; start: number; end: number }[] = [];
+  let nextBookingId = 1;
+
+  function price(request: RentalRequest) {
+    const item = items.get(request?.itemId);
+    if (!item) throw new Error(`Unknown item: ${String(request?.itemId)}`);
+    const start = parseMidnightUtc(request.start, 'start');
+    const end = parseMidnightUtc(request.end, 'end');
+    if (end <= start) throw new Error('end must be after start');
+    const total = item.dailyPrice * ((end - start) / DAY_MS);
+    if (!Number.isSafeInteger(total)) throw new Error('total is too large');
+    return {
+      item,
+      start,
+      end,
+      quote: {
+        itemId: item.id,
+        start: new Date(start).toISOString(),
+        end: new Date(end).toISOString(),
+        total,
+      },
+    };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item?.id !== 'string' || item.id === '') throw new Error('id must be a non-empty string');
+      if (item.kind !== 'board' && item.kind !== 'sail') throw new Error(`Invalid kind: ${String(item.kind)}`);
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+      }
+      if (items.has(item.id)) throw new Error(`Item already exists: ${item.id}`);
+      items.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { item, start, end, quote } = price(request);
+      const clash = bookings.some((b) => b.itemId === item.id && start < b.end && b.start < end);
+      if (clash) throw new Error(`Item ${item.id} is not free for the whole period`);
+      bookings.push({ itemId: item.id, start, end });
+      return { id: `booking-${nextBookingId++}`, ...quote };
+    },
+  };
+}
