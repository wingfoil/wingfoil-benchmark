+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+const setup = () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  return s;
+};
+const req = (start: string, end: string) => ({ itemId: 'b1', start, end });
+
+test('quotes whole days', () => {
+  assert.equal(setup().quote(req('2026-07-01T00:00:00Z', '2026-07-04T00:00:00Z')).total, 7500);
+});
+
+test('rejects bad periods and unknown items', () => {
+  const s = setup();
+  assert.throws(() => s.quote(req('2026-07-01T10:00:00Z', '2026-07-04T00:00:00Z')));
+  assert.throws(() => s.quote(req('2026-07-04T00:00:00Z', '2026-07-04T00:00:00Z')));
+  assert.throws(() => s.quote({ itemId: 'x', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+});
+
+test('prevents overlapping bookings but allows adjacent ones', () => {
+  const s = setup();
+  s.book(req('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.throws(() => s.book(req('2026-07-02T00:00:00Z', '2026-07-04T00:00:00Z')));
+  const b = s.book(req('2026-07-03T00:00:00Z', '2026-07-04T00:00:00Z'));
+  assert.equal(b.total, 2500);
+});
