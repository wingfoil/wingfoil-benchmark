+describe('input validation', () => {
+  const code = (r: { ok: boolean; error?: { code: string } }) => (r.ok ? 'ok' : r.error?.code);
+
+  it('rejects invalid input and leaves the list unchanged', () => {
+    const list = createTodoList();
+    list.add({ title: 'Keep me' });
+    assert.equal(code(list.add({ title: '   ' })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'x'.repeat(121) })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'ok', priority: 'urgent' as never })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'ok', tags: ['a b'] })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'ok', tags: [''] })), 'invalid-input');
+    assert.equal(code(list.rename('Keep me', ' ')), 'invalid-input');
+    assert.equal(code(list.rename('Keep me', 'y'.repeat(121))), 'invalid-input');
+    assert.equal(code(list.tag('Keep me', '')), 'invalid-input');
+    assert.equal(code(list.tag('Keep me', 'a b')), 'invalid-input');
+    assert.deepEqual(list.list().map((t) => [t.title, t.tags.length]), [['Keep me', 0]]);
+    assert.equal(code(list.add({ title: 'x'.repeat(120) })), 'ok');
+  });
+});
