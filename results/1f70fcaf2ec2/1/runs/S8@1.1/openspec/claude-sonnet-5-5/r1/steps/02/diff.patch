+describe('task timestamps', () => {
+  function clocked() {
+    let tick = 0;
+    const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)).toISOString());
+    return list;
+  }
+
+  it('sets createdAt and updatedAt alike on add', () => {
+    const task = valueOf(clocked().add({ title: 'a' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    const list = clocked();
+    list.add({ title: 'a' });
+    const steps = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.rename('a', 'b'),
+      () => list.tag('b', 'x'),
+      () => list.untag('b', 'x'),
+    ];
+    let last = '2026-01-01T00:00:00.000Z';
+    for (const step of steps) {
+      const task = valueOf(step());
+      assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+      assert.ok(task.updatedAt > last);
+      last = task.updatedAt;
+    }
+  });
+
+  it('leaves updatedAt alone when a change fails', () => {
+    const list = clocked();
+    list.add({ title: 'a' });
+    const done = valueOf(list.complete('a'));
+    assert.equal(list.complete('a').ok, false);
+    assert.deepEqual(valueOf(list.get(done.id)), done);
+  });
+});
