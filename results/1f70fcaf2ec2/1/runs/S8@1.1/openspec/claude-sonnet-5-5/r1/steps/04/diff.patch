@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('imports a full line', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money');
+    assert.deepEqual(report, { imported: 1, rejected: [] });
+    const [task] = list.list();
+    assert.equal(task?.title, 'Renew the insurance');
+    assert.equal(task?.priority, 'high');
+    assert.deepEqual(task?.tags, ['admin', 'money']);
+  });
+
+  it('defaults priority and tags', () => {
+    const list = createTodoList();
+    assert.equal(importTasks(list, 'Buy milk;;\nBake bread').imported, 2);
+    assert.ok(list.list().every((task) => task.priority === 'normal' && task.tags.length === 0));
+  });
+
+  it('skips blank lines but counts them', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'A\n\n  \nB;urgent;');
+    assert.equal(report.imported, 1);
+    assert.equal(report.rejected.length, 1);
+    assert.equal(report.rejected[0]?.line, 4);
+    assert.match(report.rejected[0]?.reason ?? '', /urgent/);
+  });
+
+  it('rejects bad titles, tags, duplicates and extra fields; others still import', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const report = importTasks(list, [';high;admin', 'Existing', 'Ok', 'Ok', 'Task;high;admin;extra', 'Fine;low;x'].join('\n'));
+    assert.equal(report.imported, 2);
+    assert.deepEqual(report.rejected.map((r) => r.line), [1, 2, 4, 5]);
+    assert.equal(list.list().length, 3);
+  });
+
+  it('handles CRLF', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'A;high;t\r\nB;;u\r\n');
+    assert.equal(report.imported, 2);
+    assert.deepEqual(list.find('A').ok && list.find('A').value.tags, ['t']);
+    assert.ok(list.find('B').ok);
+  });
+
+  it('does not use up an id on a rejected line', () => {
+    const list = createTodoList();
+    importTasks(list, 'A;nope;\nB');
+    const b = list.find('B');
+    assert.ok(b.ok && b.value.id === 'task-1');
+  });
+});
