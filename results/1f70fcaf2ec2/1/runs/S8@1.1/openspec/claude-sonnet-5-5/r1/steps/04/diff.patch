+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of the imported text that could not be added: its number, from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds tasks to a list from text with one task per line, as `title;priority;tags`. The priority may be
+ * empty for a normal one; tags are separated by spaces. Blank lines are skipped, but still count in the
+ * line numbers. Each line is added as `list.add` would, and a line it refuses is reported, not imported.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import, separated by `\n` or `\r\n`
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r?\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `the line has ${fields.length} fields; the most allowed is 3 (title;priority;tags)` });
+      return;
+    }
+    const [title = '', priority = '', tags = ''] = fields;
+    const trimmedPriority = priority.trim();
+    const result = list.add({
+      title,
+      ...(trimmedPriority === '' ? {} : { priority: trimmedPriority as Priority }),
+      tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line, reason: result.error.message });
+  });
+  return { imported, rejected };
+}
