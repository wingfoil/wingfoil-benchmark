+/** The longest title a task may have, once surrounding spaces are trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a title: it must not be empty or only spaces, nor longer than 120 characters once trimmed.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title must not be empty or only spaces');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; the most allowed is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be `low`, `normal` or `high`.
+ *
+ * @param priority - the priority as given
+ */
+export function validatePriority(priority: unknown): Result<Priority> {
+  if (PRIORITIES.includes(priority as Priority)) return ok(priority as Priority);
+  return err('invalid-input', `the priority "${String(priority)}" is not one of ${PRIORITIES.join(', ')}`);
+}
+
+/**
+ * Checks a tag: it must not be empty or contain a space.
+ *
+ * @param tag - the tag as given
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'a tag must not be empty');
+  if (tag.includes(' ')) return err('invalid-input', `the tag "${tag}" must not contain a space`);
+  return ok(tag);
+}
+
