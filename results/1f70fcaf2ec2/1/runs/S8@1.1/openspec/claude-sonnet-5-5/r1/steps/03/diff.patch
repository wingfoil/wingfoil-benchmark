+describe('input validation', () => {
+  const rejected = (result: { ok: boolean; error?: { code: string } }) => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+  };
+
+  it('rejects bad titles on add and leaves ids alone', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: '' }));
+    rejected(list.add({ title: '   ' }));
+    rejected(list.add({ title: 'x'.repeat(121) }));
+    assert.equal(list.list().length, 0);
+    const task = valueOf(list.add({ title: 'x'.repeat(120) }));
+    assert.equal(task.id, 'task-1');
+  });
+
+  it('rejects an unknown priority and bad tags on add', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: 'a', priority: 'urgent' as never }));
+    rejected(list.add({ title: 'a', tags: ['ok', ''] }));
+    rejected(list.add({ title: 'a', tags: ['two words'] }));
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects bad titles on rename and bad tags on tag, changing nothing', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'Task' }));
+    rejected(list.rename('Task', ' '));
+    rejected(list.rename('Task', 'x'.repeat(121)));
+    rejected(list.tag('Task', ''));
+    rejected(list.tag('Task', 'a b'));
+    assert.deepEqual(valueOf(list.find('Task')), before);
+  });
+});
