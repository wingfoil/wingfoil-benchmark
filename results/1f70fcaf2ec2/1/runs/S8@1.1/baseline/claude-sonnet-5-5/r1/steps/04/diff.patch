@@ -0,0 +1,58 @@
+import type { TaskList } from './list.ts';
+import { priorityProblem } from './task.ts';
+import type { Priority } from './task.ts';
+
+/** A line of the text that could not be added, and why. */
+export interface RejectedLine {
+  /** The line's number in the text, counting from 1. */
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks it added, and the lines it could not add. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may be
+ * empty (or left out) for a normal one; tags are separated by spaces. Blank lines are skipped, and a line
+ * that cannot be added is reported without stopping the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the tasks, one per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+
+  text.split(/\r\n|\n|\r/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: 'a line has at most three parts: title;priority;tags' });
+      return;
+    }
+    const [title, priorityText = '', tagsText = ''] = fields as [string, string?, string?];
+    const priorityName = priorityText.trim().toLowerCase();
+    if (priorityName !== '') {
+      const problem = priorityProblem(priorityName);
+      if (problem !== undefined) {
+        rejected.push({ line, reason: problem });
+        return;
+      }
+    }
+    const tags = tagsText.split(/\s+/).filter((tag) => tag !== '');
+    const added = list.add({
+      title,
+      ...(priorityName === '' ? {} : { priority: priorityName as Priority }),
+      tags,
+    });
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+
+  return { imported, rejected };
+}
