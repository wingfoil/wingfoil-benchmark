diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cb479aedece3e8e07d82c7460a19913e1d6ab543
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+test('imports valid lines and reports the others by line number', () => {
+  const list = createTodoList();
+  const result = importTasks(
+    list,
+    'Renew the insurance;high;admin money\n\nBuy milk\nWalk dog;urgent;\n;low;x\nBuy milk;;\nA;b;c;d\r\nPlain; ;',
+  );
+  assert.equal(result.imported, 3);
+  assert.deepEqual(result.rejected.map((r) => r.line), [4, 5, 6, 7]);
+  const insurance = list.find('Renew the insurance');
+  assert.ok(insurance.ok);
+  assert.equal(insurance.value.priority, 'high');
+  assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+});
