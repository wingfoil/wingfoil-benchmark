diff --git a/src/domain/task.ts b/src/domain/task.ts
index 62511f786a20c6ab6cca0848590b06f2258566fb..8b3aa56257b663618fbe650f523d8f88645abcd3 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -133,3 +133,59 @@ function timestamp(): string {
 function unique(tags: readonly string[]): string[] {
   return tags.filter((tag, index) => tags.indexOf(tag) === index);
 }
+
+/** The longest title a task can have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Why `title` cannot be a task's title, or `undefined` when it can.
+ *
+ * @param title - the title as typed
+ */
+export function titleProblem(title: unknown): string | undefined {
+  if (typeof title !== 'string' || title.trim() === '') return 'a title cannot be empty';
+  if (title.trim().length > MAX_TITLE_LENGTH) {
+    return `a title cannot be longer than ${MAX_TITLE_LENGTH} characters`;
+  }
+  return undefined;
+}
+
+/**
+ * Why `priority` is not a priority, or `undefined` when it is.
+ *
+ * @param priority - the priority as given
+ */
+export function priorityProblem(priority: unknown): string | undefined {
+  if (PRIORITIES.includes(priority as Priority)) return undefined;
+  return `the priority must be one of ${PRIORITIES.join(', ')}, not "${String(priority)}"`;
+}
+
+/**
+ * Why `tag` cannot be a tag, or `undefined` when it can.
+ *
+ * @param tag - the tag as typed
+ */
+export function tagProblem(tag: unknown): string | undefined {
+  if (typeof tag !== 'string' || tag === '') return 'a tag cannot be empty';
+  if (/\s/.test(tag)) return `a tag cannot contain a space, but "${tag}" does`;
+  return undefined;
+}
+
+/**
+ * Why `input` cannot be added as a task, or `undefined` when it can.
+ *
+ * @param input - the new task as given
+ */
+export function newTaskProblem(input: NewTask): string | undefined {
+  const problem = titleProblem(input.title);
+  if (problem !== undefined) return problem;
+  if (input.priority !== undefined) {
+    const bad = priorityProblem(input.priority);
+    if (bad !== undefined) return bad;
+  }
+  for (const tag of input.tags ?? []) {
+    const bad = tagProblem(tag);
+    if (bad !== undefined) return bad;
+  }
+  return undefined;
+}
