+
+describe('timestamps', () => {
+  it('sets updatedAt on every change and keeps createdAt', async () => {
+    const list = createTodoList();
+    const added = valueOf(list.add({ title: 'Sweep' }));
+    let previous = added;
+    const steps = [
+      () => list.complete('Sweep'),
+      () => list.reopen('Sweep'),
+      () => list.rename('Sweep', 'Sweep up'),
+      () => list.tag('Sweep up', 'home'),
+      () => list.untag('Sweep up', 'home'),
+    ];
+    for (const step of steps) {
+      await new Promise((resolve) => setTimeout(resolve, 5));
+      const next = valueOf(step());
+      assert.equal(next.createdAt, added.createdAt);
+      assert.ok(next.updatedAt > previous.updatedAt);
+      previous = next;
+    }
+  });
+});
