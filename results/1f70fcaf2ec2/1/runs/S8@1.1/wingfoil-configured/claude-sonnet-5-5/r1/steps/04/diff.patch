diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bd5ca888ca1d10b328a59b83d9bba78ac68b640c
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,32 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds every valid line, skipping blank ones', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\n  \nBuy milk;;\nCall mum\n');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok);
+    assert.equal(milk.value.priority, 'normal');
+    assert.deepEqual(milk.value.tags, []);
+  });
+
+  it('reports rejected lines with their number and keeps going', () => {
+    const list = createTodoList();
+    const report = importTasks(list, ';high;x\r\nA;urgent;\n\nB;low;t\nB;low;t\nC;;a;b\n' + 'D'.repeat(121));
+    assert.equal(report.imported, 1);
+    assert.deepEqual(
+      report.rejected.map((r) => r.line),
+      [1, 2, 5, 6, 7],
+    );
+    assert.ok(report.rejected.every((r) => r.reason.length > 0));
+    assert.equal(list.list().length, 1);
+  });
+});
