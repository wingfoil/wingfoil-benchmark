diff --git a/src/domain/task.ts b/src/domain/task.ts
index aeed3935b91ef691fa431b7182a98ed6c6b12153..7d40545b17505c18e4cffdc90cab450cc5fa61f3 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -7,6 +7,9 @@ export type Priority = 'low' | 'normal' | 'high';
 /** Every priority, from the least urgent to the most. */
 export const PRIORITIES: readonly Priority[] = ['low', 'normal', 'high'];
 
+/** The longest title a task can have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
 /** Whether a task still has to be done. */
 export type Status = 'open' | 'done';
 
@@ -31,6 +34,66 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/**
+ * Checks a title: after trimming it must not be empty nor longer than `MAX_TITLE_LENGTH` characters.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: unknown): Result<string> {
+  if (typeof title !== 'string') return err('invalid-input', 'the title must be text');
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'the title is empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; the limit is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be `low`, `normal` or `high`.
+ *
+ * @param priority - the priority as given
+ */
+export function validatePriority(priority: unknown): Result<Priority> {
+  const known = PRIORITIES.find((candidate) => candidate === priority);
+  return known === undefined
+    ? err('invalid-input', `the priority ${JSON.stringify(priority)} is not one of ${PRIORITIES.join(', ')}`)
+    : ok(known);
+}
+
+/**
+ * Checks a tag: it must not be empty nor contain a space.
+ *
+ * @param tag - the tag as given
+ */
+export function validateTag(tag: unknown): Result<string> {
+  if (typeof tag !== 'string') return err('invalid-input', 'the tag must be text');
+  if (tag === '') return err('invalid-input', 'the tag is empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space`);
+  return ok(tag);
+}
+
+/**
+ * Checks everything a new task is made of: its title, its priority if given, and each of its tags.
+ *
+ * @param input - the task as typed
+ */
+export function validateNewTask(input: NewTask): Result<NewTask> {
+  const title = validateTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined) {
+    const priority = validatePriority(input.priority);
+    if (!priority.ok) return priority;
+  }
+  const tags = input.tags ?? [];
+  if (!Array.isArray(tags)) return err('invalid-input', 'the tags must be a list');
+  for (const tag of tags) {
+    const checked = validateTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok(input);
+}
+
 /**
  * A new open task. Its priority is `normal` unless given; its tags keep the order given, each once.
  *
