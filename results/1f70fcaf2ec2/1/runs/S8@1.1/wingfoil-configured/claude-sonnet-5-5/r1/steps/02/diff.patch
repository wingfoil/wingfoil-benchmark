+describe('task timestamps', () => {
+  function clockList() {
+    let t = Date.parse('2026-01-01T00:00:00.000Z');
+    return createTodoList(() => new Date((t += 1000)));
+  }
+
+  it('gives a new task equal ISO-8601 createdAt and updatedAt', () => {
+    const task = valueOf(clockList().add({ title: 'a' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:01.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+    assert.match(valueOf(createTodoList().add({ title: 'b' })).createdAt, /^\d{4}-\d\d-\d\dT[\d:.]+Z$/);
+  });
+
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    const list = clockList();
+    const created = valueOf(list.add({ title: 'a' }));
+    const steps = [
+      valueOf(list.complete('a')),
+      valueOf(list.reopen('a')),
+      valueOf(list.rename('a', 'b')),
+      valueOf(list.tag('b', 'x')),
+      valueOf(list.untag('b', 'x')),
+    ];
+    steps.forEach((task, i) => {
+      assert.equal(task.createdAt, created.createdAt);
+      assert.equal(task.updatedAt, `2026-01-01T00:00:0${i + 2}.000Z`);
+    });
+    assert.equal(valueOf(list.get(created.id)).updatedAt, steps[4].updatedAt);
+  });
+
+  it('leaves updatedAt alone when a change is refused or alters nothing', () => {
+    const list = clockList();
+    const created = valueOf(list.add({ title: 'a', tags: ['x'] }));
+    assert.equal(list.reopen('a').ok, false);
+    assert.equal(valueOf(list.tag('a', 'x')).updatedAt, created.updatedAt);
+    assert.equal(valueOf(list.untag('a', 'y')).updatedAt, created.updatedAt);
+    assert.equal(valueOf(list.find('a')).updatedAt, created.updatedAt);
+  });
+});
