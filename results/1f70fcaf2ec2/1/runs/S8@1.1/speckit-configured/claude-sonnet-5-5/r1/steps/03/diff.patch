index 500711a381483a770108d7052c01d0884887735a..8c7f49dd4a9550e3f34751900845075bc8d80605 100644
--- a/test/list.test.ts
+++ b/test/list.test.ts
@@ -179,3 +179,40 @@ describe('task timestamps', () => {
     assert.equal(valueOf(list.get(created.id)).updatedAt, created.updatedAt);
   });
 });
+
+describe('input validation', () => {
+  const rejected = (result: { ok: boolean; error?: { code: string; message: string } }) => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+    assert.notEqual(result.error?.message, '');
+  };
+
+  it('rejects a bad title on add and on rename', () => {
+    const list = createTodoList();
+    list.add({ title: 'Keep me' });
+    for (const title of ['', '   ', 'x'.repeat(121)]) {
+      rejected(list.add({ title }));
+      rejected(list.rename('Keep me', title));
+    }
+    assert.equal(list.list().length, 1);
+    assert.equal(valueOf(list.find('Keep me')).title, 'Keep me');
+    assert.equal(list.add({ title: ` ${'x'.repeat(120)} ` }).ok, true);
+  });
+
+  it('rejects an unknown priority', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: 'A', priority: 'urgent' as 'high' }));
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a bad tag on add and on tag, leaving the task untouched', () => {
+    let tick = 0;
+    const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)));
+    rejected(list.add({ title: 'A', tags: ['ok', 'not ok'] }));
+    assert.equal(list.list().length, 0);
+    const before = valueOf(list.add({ title: 'B' }));
+    rejected(list.tag('B', ''));
+    rejected(list.tag('B', 'two words'));
+    assert.deepEqual(valueOf(list.find('B')), before);
+  });
+});
