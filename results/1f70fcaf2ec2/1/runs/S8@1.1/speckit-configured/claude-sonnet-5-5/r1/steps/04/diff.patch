+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('imports valid lines, skipping blank ones', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin money\n\n  \nBuy milk;;\r\nCall mum');
+    assert.deepEqual(result, { imported: 3, rejected: [] });
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok);
+    assert.equal(milk.value.priority, 'normal');
+  });
+
+  it('rejects bad lines with their number and keeps importing', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const result = importTasks(list, 'Good\n\n;high;x\nBad prio;urgent;\nExisting;;\nGood;;\na;b;c;d');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(
+      result.rejected.map((r) => r.line),
+      [3, 4, 5, 6, 7],
+    );
+    assert.ok(result.rejected.every((r) => r.reason.length > 0));
+    assert.equal(list.list().length, 2);
+  });
+});
