+import type { TaskList } from './list.ts';
+
+/** A line of imported text that could not be added, with its number (from 1) and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks were added, and the lines that were not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds tasks to a list from text with one `title;priority;tags` task per line. The priority may be
+ * empty for a normal one, tags are separated by spaces, and blank lines are skipped.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  text.split(/\r?\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `expected "title;priority;tags" but found ${fields.length} fields` });
+      return;
+    }
+    const [title, priority = '', tags = ''] = fields;
+    const wanted = priority.trim();
+    const added = list.add({
+      title,
+      ...(wanted === '' ? {} : { priority: wanted as 'low' }),
+      tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+    });
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
