+
+describe('task ids', () => {
+  it('gives each task a distinct string id', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'A' }));
+    const b = valueOf(list.add({ title: 'B' }));
+    assert.equal(typeof a.id, 'string');
+    assert.notEqual(a.id, b.id);
+  });
+
+  it('keeps the id after a rename, and get finds the task', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'Old' }));
+    const renamed = valueOf(list.rename(task.id, 'New'));
+    assert.equal(renamed.id, task.id);
+    assert.equal(valueOf(list.get(task.id)).title, 'New');
+    assert.equal(list.find('Old').ok, false);
+    assert.equal(valueOf(list.find('New')).id, task.id);
+  });
+
+  it('fails get for an unknown id', () => {
+    const result = createTodoList().get('nope');
+    assert.equal(result.ok, false);
+    if (!result.ok) assert.equal(result.error.code, 'not-found');
+  });
+
+  it('accepts an id in every method that takes a title', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'Task' }));
+    assert.equal(valueOf(list.find(id)).title, 'Task');
+    assert.equal(valueOf(list.tag(id, 'x')).tags[0], 'x');
+    assert.deepEqual(valueOf(list.untag(id, 'x')).tags, []);
+    assert.equal(valueOf(list.complete(id)).status, 'done');
+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.equal(valueOf(list.rename(id, 'Other')).title, 'Other');
+    assert.equal(valueOf(list.remove(id)).id, id);
+    assert.equal(list.get(id).ok, false);
+    assert.equal(list.openCount(), 0);
+  });
+
+  it('does not reuse the id of a removed task', () => {
+    const list = createTodoList();
+    const first = valueOf(list.add({ title: 'A' }));
+    list.remove(first.id);
+    assert.notEqual(valueOf(list.add({ title: 'B' })).id, first.id);
+  });
+
+  it('refuses to rename onto another task by id, but allows keeping the title', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'A' }));
+    list.add({ title: 'B' });
+    const clash = list.rename(a.id, 'B');
+    assert.equal(clash.ok, false);
+    if (!clash.ok) assert.equal(clash.error.code, 'duplicate');
+    assert.equal(list.rename(a.id, ' A ').ok, true);
+  });
+});
