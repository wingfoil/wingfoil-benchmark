+
+describe('input validation', () => {
+  function rejected(result: { ok: boolean; error?: { code: string; message: string } }) {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+    assert.ok(result.error?.message);
+  }
+
+  it('rejects bad titles on add and rename', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: '' }));
+    rejected(list.add({ title: '   ' }));
+    rejected(list.add({ title: 'x'.repeat(121) }));
+    assert.equal(list.add({ title: 'x'.repeat(120) }).ok, true);
+    list.add({ title: 'Sweep' });
+    rejected(list.rename('Sweep', '  '));
+    rejected(list.rename('Sweep', 'y'.repeat(121)));
+    assert.equal(list.find('Sweep').ok, true);
+    assert.equal(list.list().length, 2);
+  });
+
+  it('rejects a bad priority', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: 'Sweep', priority: 'urgent' as never }));
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects bad tags on add and tag, changing nothing', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: 'Sweep', tags: ['ok', ''] }));
+    rejected(list.add({ title: 'Sweep', tags: ['two words'] }));
+    assert.equal(list.list().length, 0);
+    list.add({ title: 'Sweep' });
+    rejected(list.tag('Sweep', ''));
+    rejected(list.tag('Sweep', 'a b'));
+    assert.deepEqual(valueOf(list.find('Sweep')).tags, []);
+  });
+});
