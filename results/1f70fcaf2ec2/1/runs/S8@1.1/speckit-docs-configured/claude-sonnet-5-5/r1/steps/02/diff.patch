+
+describe('task timestamps', () => {
+  function clockList() {
+    let tick = 0;
+    const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)).toISOString());
+    return list;
+  }
+
+  it('gives a new task the same createdAt and updatedAt', () => {
+    const task = valueOf(clockList().add({ title: 'Sweep' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    const list = clockList();
+    const created = valueOf(list.add({ title: 'Sweep' })).createdAt;
+    const steps = [
+      valueOf(list.complete('Sweep')),
+      valueOf(list.reopen('Sweep')),
+      valueOf(list.rename('Sweep', 'Mop')),
+      valueOf(list.tag('Mop', 'home')),
+      valueOf(list.untag('Mop', 'home')),
+    ];
+    steps.forEach((task, index) => {
+      assert.equal(task.createdAt, created);
+      assert.equal(task.updatedAt, `2026-01-01T00:00:0${index + 1}.000Z`);
+    });
+  });
+
+  it('leaves updatedAt alone when a change fails', () => {
+    const list = clockList();
+    const before = valueOf(list.add({ title: 'Sweep' }));
+    assert.equal(list.reopen('Sweep').ok, false);
+    assert.deepEqual(valueOf(list.get(before.id)), before);
+  });
+});
