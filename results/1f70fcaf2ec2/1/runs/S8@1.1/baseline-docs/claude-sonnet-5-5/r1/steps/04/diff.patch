@@ -0,0 +1,55 @@
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+import { validatePriority } from './validate.ts';
+
+/** A line of the text that could not be imported, and why. */
+export interface RejectedLine {
+  /** The line's number in the text, counting from 1 and counting blank lines. */
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks it added, and the lines it could not add. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+const FIELD_COUNT = 3;
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may
+ * be empty for a normal one, the tags are separated by spaces, and the last fields may be left out.
+ * Blank lines are skipped; a line that cannot be added is reported and the others are still added.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const reason = importLine(list, raw);
+    if (reason === undefined) imported += 1;
+    else rejected.push({ line: index + 1, reason });
+  });
+  return { imported, rejected };
+}
+
+function importLine(list: TaskList, raw: string): string | undefined {
+  const fields = raw.split(';');
+  if (fields.length > FIELD_COUNT) {
+    return `expected at most ${FIELD_COUNT} fields (title;priority;tags) but found ${fields.length}`;
+  }
+  const [title = '', priorityText = '', tagsText = ''] = fields.map((field) => field.trim());
+  let priority: Priority | undefined;
+  if (priorityText !== '') {
+    const valid = validatePriority(priorityText);
+    if (!valid.ok) return valid.error.message;
+    priority = valid.value as Priority;
+  }
+  const tags = tagsText === '' ? [] : tagsText.split(/\s+/);
+  const added = list.add({ title, priority, tags });
+  return added.ok ? undefined : added.error.message;
+}
