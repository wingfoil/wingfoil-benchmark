+
+describe('bulk import', () => {
+  it('adds every valid line, with priority and tags', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;;\n\nWalk the dog');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = valueOf(list.find('Renew the insurance'));
+    assert.equal(insurance.priority, 'high');
+    assert.deepEqual(insurance.tags, ['admin', 'money']);
+    assert.equal(valueOf(list.find('Buy milk')).priority, 'normal');
+  });
+
+  it('rejects bad lines by their number, counting blank lines, and imports the rest', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const report = importTasks(list, 'Good;low;a\r\n\n;high;x\nBad prio;urgent;\nExisting;;\nToo;many;a;b\nFine');
+    assert.equal(report.imported, 2);
+    assert.deepEqual(report.rejected.map((r) => r.line), [3, 4, 5, 6]);
+    assert.ok(report.rejected.every((r) => r.reason.length > 0));
+    assert.equal(list.list().length, 3);
+  });
+});
