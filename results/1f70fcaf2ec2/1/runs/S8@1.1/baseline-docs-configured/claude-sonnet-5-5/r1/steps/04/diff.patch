+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+import { validatePriority } from './validate.ts';
+
+/** A line of the text that could not be added, with its number (from 1) and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+const MAX_FIELDS = 3;
+
+function parseLine(text: string): Result<{ title: string; priority?: Priority; tags: string[] }> {
+  const fields = text.split(';');
+  if (fields.length > MAX_FIELDS) {
+    return err('invalid-input', `the line has ${fields.length} fields: use title;priority;tags`);
+  }
+  const [title = '', priority = '', tags = ''] = fields.map((field) => field.trim());
+  const tagList = tags === '' ? [] : tags.split(/\s+/);
+  if (priority === '') return ok({ title, tags: tagList });
+  const valid = validatePriority(priority);
+  return valid.ok ? ok({ title, priority: priority as Priority, tags: tagList }) : valid;
+}
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may be
+ * empty for a normal one, and the tags are separated by spaces. Blank lines are skipped; a line that
+ * cannot be added is reported and does not stop the others.
+ *
+ * @param list - the task list to add to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((content, index) => {
+    if (content.trim() === '') return;
+    const parsed = parseLine(content);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
