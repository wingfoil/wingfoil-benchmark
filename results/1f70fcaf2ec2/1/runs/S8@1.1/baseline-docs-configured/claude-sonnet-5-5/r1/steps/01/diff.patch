+
+describe('task ids', () => {
+  it('gives each task an id of its own, kept when the task is renamed', () => {
+    const list = createTodoList();
+    const first = valueOf(list.add({ title: 'a' }));
+    const second = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(first.id, second.id);
+    const renamed = valueOf(list.rename(first.id, 'c'));
+    assert.equal(renamed.id, first.id);
+    assert.deepEqual(valueOf(list.get(first.id)), renamed);
+  });
+
+  it('does not give the id of a removed task to a new one', () => {
+    const list = createTodoList();
+    const first = valueOf(list.add({ title: 'a' }));
+    list.remove(first.id);
+    assert.notEqual(valueOf(list.add({ title: 'b' })).id, first.id);
+    assert.equal(list.get(first.id).ok, false);
+  });
+
+  it('reports an unknown id as not found', () => {
+    const result = createTodoList().get('nope');
+    assert.equal(result.ok, false);
+    if (!result.ok) assert.equal(result.error.code, 'not-found');
+  });
+
+  it('accepts an id wherever a title is accepted', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'a' }));
+    assert.equal(valueOf(list.find(id)).title, 'a');
+    assert.equal(valueOf(list.complete(id)).status, 'done');
+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.deepEqual(valueOf(list.tag(id, 'x')).tags, ['x']);
+    assert.deepEqual(valueOf(list.untag(id, 'x')).tags, []);
+    assert.equal(valueOf(list.rename(id, 'a')).title, 'a');
+    assert.equal(valueOf(list.remove(id)).id, id);
+    assert.equal(list.find(id).ok, false);
+  });
+
+  it('refuses to rename a task to the title of another, by id too', () => {
+    const list = createTodoList();
+    list.add({ title: 'a' });
+    const { id } = valueOf(list.add({ title: 'b' }));
+    const result = list.rename(id, 'a');
+    assert.equal(result.ok, false);
+    if (!result.ok) assert.equal(result.error.code, 'duplicate');
+  });
+});
