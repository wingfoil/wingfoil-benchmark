+describe('input validation', () => {
+  const invalid = (r: { ok: boolean; error?: { code: string; message: string } }) => {
+    assert.equal(r.ok, false);
+    assert.equal(r.error?.code, 'invalid-input');
+  };
+
+  it('rejects bad titles, priorities and tags on add, changing nothing', () => {
+    const list = createTodoList();
+    invalid(list.add({ title: '' }));
+    invalid(list.add({ title: '   ' }));
+    invalid(list.add({ title: 'x'.repeat(121) }));
+    invalid(list.add({ title: 'ok', priority: 'urgent' as never }));
+    invalid(list.add({ title: 'ok', tags: ['fine', ''] }));
+    invalid(list.add({ title: 'ok', tags: ['a b'] }));
+    assert.equal(list.list().length, 0);
+    assert.equal(list.add({ title: 'x'.repeat(120) }).ok, true);
+  });
+
+  it('rejects bad titles and tags on rename and tag, changing nothing', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'Sweep' }));
+    invalid(list.rename('Sweep', '  '));
+    invalid(list.rename('Sweep', 'y'.repeat(121)));
+    invalid(list.tag('Sweep', ''));
+    invalid(list.tag('Sweep', 'two words'));
+    assert.deepEqual(valueOf(list.get(task.id)), task);
+  });
+});
