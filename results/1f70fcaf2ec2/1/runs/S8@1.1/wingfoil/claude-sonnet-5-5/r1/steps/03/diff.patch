+
+/** The longest title a task may have, in characters. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a title: it must not be empty or only spaces, nor longer than 120 characters once trimmed.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'the title is empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title has ${trimmed.length} characters; the most is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be one of `low`, `normal` and `high`.
+ *
+ * @param priority - the priority as given
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  const found = PRIORITIES.find((candidate) => candidate === priority);
+  if (found === undefined) {
+    return err('invalid-input', `the priority "${priority}" is not one of ${PRIORITIES.join(', ')}`);
+  }
+  return ok(found);
+}
+
+/**
+ * Checks a tag: it must not be empty nor contain a space.
+ *
+ * @param tag - the tag as given
+ */
+export function validateTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'a tag is empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space`);
+  return ok(tag);
+}
