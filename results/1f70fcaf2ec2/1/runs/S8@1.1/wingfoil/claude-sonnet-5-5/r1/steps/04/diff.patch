+
+# Bulk import tasks helper
+
+- `importTasks(list, text)`, exported from `src/index.ts`: one task per line, as `title;priority;tags`.
+  Priority may be empty (normal); tags are separated by spaces. Blank lines are skipped.
+- Every valid line is added to the list. Returns `{ imported, rejected }`: `imported` counts the tasks
+  added; `rejected` lists `{ line, reason }` for each line not added, `line` counting from 1 in the text
+  (blank lines count). A line with more than three fields is rejected, as is any line `list.add` refuses
+  (empty or long title, bad priority, duplicate title). A rejected line does not stop the others.
+
diff --git a/src/domain/import.ts b/src/domain/import.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3ebbe4f053b9930f7ca3907933ed5a8b15475466
--- /dev/null
+++ b/src/domain/import.ts
@@ -0,0 +1,52 @@
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+import { validatePriority } from './task.ts';
+
+/** A line of an import that could not be added: its number in the text, from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may
+ * be empty for a normal one; tags are separated by spaces. Blank lines are skipped. A line that cannot
+ * be added is reported and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  text.split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `the line has ${fields.length} fields; the most is 3` });
+      return;
+    }
+    const [title = '', priorityText = '', tagsText = ''] = fields;
+    let priority: Priority = 'normal';
+    if (priorityText.trim() !== '') {
+      const checked = validatePriority(priorityText.trim());
+      if (!checked.ok) {
+        rejected.push({ line, reason: checked.error.message });
+        return;
+      }
+      priority = checked.value;
+    }
+    const tags = tagsText.split(/\s+/).filter((tag) => tag !== '');
+    const added = list.add({ title, priority, tags });
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
