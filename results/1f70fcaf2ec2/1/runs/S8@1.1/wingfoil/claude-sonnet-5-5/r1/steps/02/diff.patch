+
+describe('task timestamps', () => {
+  it('stamps creation and every change', () => {
+    let time = Date.parse('2026-01-01T00:00:00.000Z');
+    const list = createTodoList(() => new Date(time));
+    const created = valueOf(list.add({ title: 'a' }));
+    assert.equal(created.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(created.updatedAt, created.createdAt);
+    for (const [change, run] of [
+      ['complete', () => list.complete('a')],
+      ['reopen', () => list.reopen('a')],
+      ['rename', () => list.rename('a', 'b')],
+      ['tag', () => list.tag('b', 'x')],
+      ['untag', () => list.untag('b', 'x')],
+    ] as const) {
+      time += 1000;
+      const task = valueOf(run());
+      assert.equal(task.createdAt, created.createdAt, change);
+      assert.equal(task.updatedAt, new Date(time).toISOString(), change);
+    }
+  });
+
+  it('leaves updatedAt alone when a change fails', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'a' }));
+    assert.equal(list.reopen('a').ok, false);
+    assert.equal(valueOf(list.get(task.id)).updatedAt, task.updatedAt);
+  });
+});
