@@ -0,0 +1,44 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds every valid line, skipping blank lines', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\r\nBuy milk;;\nWalk dog\n');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok);
+    assert.equal(milk.value.priority, 'normal');
+    assert.deepEqual(milk.value.tags, []);
+  });
+
+  it('rejects bad lines with their number and keeps importing', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const report = importTasks(
+      list,
+      ['Ok;low;a', ';high;x', 'Bad;urgent;x', 'Existing;;', 'Ok;;', 'a;b;c;d', 'X'.repeat(121)].join('\n'),
+    );
+    assert.equal(report.imported, 1);
+    assert.deepEqual(
+      report.rejected.map((r) => r.line),
+      [2, 3, 4, 5, 6, 7],
+    );
+    assert.ok(report.rejected.every((r) => r.reason !== ''));
+  });
+
+  it('counts blank lines in line numbers', () => {
+    const report = importTasks(createTodoList(), '\n\nA;nope;');
+    assert.equal(report.rejected[0]?.line, 3);
+  });
+
+  it('imports nothing from empty text', () => {
+    assert.deepEqual(importTasks(createTodoList(), ''), { imported: 0, rejected: [] });
+  });
+});
