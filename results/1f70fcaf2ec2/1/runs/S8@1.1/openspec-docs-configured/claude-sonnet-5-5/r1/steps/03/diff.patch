+/** The most characters a task title can have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * The title, trimmed, or an error when it is empty or too long.
+ *
+ * @param title - the title to check
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'the title cannot be empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title cannot be longer than ${MAX_TITLE_LENGTH} characters`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority, or an error when it is not `low`, `normal` or `high`.
+ *
+ * @param priority - the priority to check
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  if (!(PRIORITIES as readonly string[]).includes(priority)) {
+    return err('invalid-input', `the priority "${priority}" is not one of: ${PRIORITIES.join(', ')}`);
+  }
+  return ok(priority as Priority);
+}
+
+/**
+ * The tag, or an error when it is empty or contains a space.
+ *
+ * @param tag - the tag to check
+ */
+export function validateTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'a tag cannot be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" cannot contain a space`);
+  return ok(tag);
+}
