+
+describe('input validation', () => {
+  const code = (result: { ok: boolean; error?: { code: string } }) => (result.ok ? 'ok' : result.error?.code);
+
+  it('rejects bad titles, priorities and tags when adding', () => {
+    const list = createTodoList();
+    assert.equal(code(list.add({ title: '' })), 'invalid-input');
+    assert.equal(code(list.add({ title: '   ' })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'x'.repeat(121) })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'x'.repeat(120) })), 'ok');
+    assert.equal(code(list.add({ title: 'a', priority: 'urgent' as never })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'b', tags: [''] })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'c', tags: ['ok', 'a b'] })), 'invalid-input');
+    assert.equal(list.list().length, 1);
+  });
+
+  it('rejects a bad title when renaming, and changes nothing', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'Keep' }));
+    assert.equal(code(list.rename('Keep', '  ')), 'invalid-input');
+    assert.equal(code(list.rename('Keep', 'x'.repeat(121))), 'invalid-input');
+    assert.deepEqual(valueOf(list.find('Keep')), task);
+  });
+
+  it('rejects a bad tag, and changes nothing', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'Keep' }));
+    assert.equal(code(list.tag('Keep', '')), 'invalid-input');
+    assert.equal(code(list.tag('Keep', 'two words')), 'invalid-input');
+    assert.deepEqual(valueOf(list.find('Keep')), task);
+  });
+
+  it('does not use up an id when an add is rejected', () => {
+    const list = createTodoList();
+    list.add({ title: '' });
+    assert.equal(valueOf(list.add({ title: 'First' })).id, 'task-1');
+  });
+});
