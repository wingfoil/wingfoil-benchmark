+describe('task timestamps', () => {
+  function clockList() {
+    let tick = 0;
+    const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)).toISOString());
+    return list;
+  }
+  const at = (second: number) => new Date(Date.UTC(2026, 0, 1, 0, 0, second)).toISOString();
+
+  it('gives a new task the same created and updated time', () => {
+    const task = valueOf(clockList().add({ title: 'A' }));
+    assert.equal(task.createdAt, at(0));
+    assert.equal(task.updatedAt, at(0));
+  });
+
+  it('sets updatedAt on every change, by title and by id, and keeps createdAt', () => {
+    const list = clockList();
+    const task = valueOf(list.add({ title: 'A' }));
+    assert.equal(valueOf(list.complete('A')).updatedAt, at(1));
+    assert.equal(valueOf(list.reopen(task.id)).updatedAt, at(2));
+    assert.equal(valueOf(list.rename('A', 'B')).updatedAt, at(3));
+    assert.equal(valueOf(list.tag(task.id, 'x')).updatedAt, at(4));
+    const last = valueOf(list.untag('B', 'x'));
+    assert.equal(last.updatedAt, at(5));
+    assert.equal(last.createdAt, at(0));
+    assert.equal(valueOf(list.get(task.id)).updatedAt, at(5));
+  });
+
+  it('leaves updatedAt alone when an operation fails', () => {
+    const list = clockList();
+    list.add({ title: 'A' });
+    list.add({ title: 'B' });
+    list.complete('A');
+    const before = valueOf(list.find('A'));
+    assert.equal(list.complete('A').ok, false);
+    assert.equal(list.reopen('B').ok, false);
+    const dup = list.rename('A', 'B');
+    assert.equal(dup.ok, false);
+    if (!dup.ok) assert.equal(dup.error.code, 'duplicate');
+    const missing = list.tag('nope', 'x');
+    if (!missing.ok) assert.equal(missing.error.code, 'not-found');
+    assert.deepEqual(valueOf(list.find('A')), before);
+    assert.equal(valueOf(list.find('B')).updatedAt, at(1));
+  });
+});
