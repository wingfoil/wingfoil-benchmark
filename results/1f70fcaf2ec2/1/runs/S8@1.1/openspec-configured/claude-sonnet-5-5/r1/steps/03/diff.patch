+/** The longest title a task can have, in characters, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * The trimmed title, or an `invalid-input` failure when it is empty or too long.
+ *
+ * @param title - the title to check
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'the title is empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is too long: ${trimmed.length} characters, at most ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority, or an `invalid-input` failure when it is not one of `low`, `normal` and `high`.
+ *
+ * @param priority - the priority to check
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  if (!(PRIORITIES as readonly string[]).includes(priority)) {
+    return err('invalid-input', `the priority "${priority}" is not valid: use ${PRIORITIES.join(', ')}`);
+  }
+  return ok(priority as Priority);
+}
+
+/**
+ * The tag, or an `invalid-input` failure when it is empty or contains a space.
+ *
+ * @param tag - the tag to check
+ */
+export function validateTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'a tag is empty');
+  if (tag.includes(' ')) return err('invalid-input', `the tag "${tag}" contains a space`);
+  return ok(tag);
+}
