index 0000000000000000000000000000000000000000..9fb776e8bca7d0c192b8f8db931c1d38e73e0685
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,62 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createTodoList, importTasks } from '../src/index.ts';
+
+const fresh = () => createTodoList(() => '2026-01-01T00:00:00Z');
+
+test('imports a full line', () => {
+  const list = fresh();
+  assert.deepEqual(importTasks(list, 'Renew the insurance;high;admin money'), { imported: 1, rejected: [] });
+  const task = list.list()[0];
+  assert.equal(task.priority, 'high');
+  assert.deepEqual(task.tags, ['admin', 'money']);
+});
+
+test('empty priority, title only and spaces', () => {
+  const list = fresh();
+  const result = importTasks(list, 'A;;home\nB\nC;\nD;high\r\n  E ; low ;  x   y ');
+  assert.deepEqual(result, { imported: 5, rejected: [] });
+  assert.equal(list.find('A').ok && list.find('A').value.priority, 'normal');
+  assert.deepEqual(list.find('B').ok && list.find('B').value.tags, []);
+  const e = list.find('E');
+  assert.ok(e.ok);
+  assert.equal(e.value.priority, 'low');
+  assert.deepEqual(e.value.tags, ['x', 'y']);
+});
+
+test('skips blank lines but counts them', () => {
+  assert.deepEqual(importTasks(fresh(), ''), { imported: 0, rejected: [] });
+  const result = importTasks(fresh(), 'A;;\n\n  \nB;bad;');
+  assert.equal(result.imported, 1);
+  assert.equal(result.rejected.length, 1);
+  assert.equal(result.rejected[0].line, 4);
+});
+
+test('rejects invalid lines and imports the others', () => {
+  const list = fresh();
+  const long = 'x'.repeat(121);
+  const result = importTasks(list, `;high;x\n${long}\nA;urgent;x\nB;;a;b\nC;;h;extra\nOk;;`);
+  assert.equal(result.imported, 1);
+  assert.deepEqual(result.rejected.map((r) => r.line), [1, 2, 3, 4, 5]);
+  assert.match(result.rejected[0].reason, /empty/);
+  assert.match(result.rejected[1].reason, /too long/);
+  assert.match(result.rejected[2].reason, /urgent/);
+  assert.match(result.rejected[3].reason, /three fields/);
+  assert.equal(list.list().length, 1);
+});
+
+test('rejects duplicates, in the list and in the text', () => {
+  const list = fresh();
+  list.add({ title: 'Pay rent' });
+  const result = importTasks(list, 'Pay rent;high;\nNew;;\nNew;high;');
+  assert.equal(result.imported, 1);
+  assert.deepEqual(result.rejected.map((r) => r.line), [1, 3]);
+  assert.match(result.rejected[0].reason, /already/);
+  const rent = list.find('Pay rent');
+  assert.ok(rent.ok);
+  assert.equal(rent.value.priority, 'normal');
+});
+
+test('tags split on runs of spaces', () => {
+  assert.deepEqual(importTasks(fresh(), 'A;;a  b'), { imported: 1, rejected: [] });
+});
