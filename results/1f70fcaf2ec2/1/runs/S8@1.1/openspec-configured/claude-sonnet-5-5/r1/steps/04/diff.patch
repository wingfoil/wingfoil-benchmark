index 0000000000000000000000000000000000000000..312a6c745947fbb07c48ab4a9d1254e1b0e80943
--- /dev/null
+++ b/src/domain/import.ts
@@ -0,0 +1,55 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { TaskList } from './list.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** A line of an import that could not be added: its number, counting from 1, and why. */
+export interface ImportRejection {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and the lines that were rejected. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
+/**
+ * The task described by one line, `title;priority;tags`. The priority may be empty, and the tags are
+ * separated by spaces. Fails with `invalid-input` when the line has more than three fields; the values
+ * themselves are checked when the task is added.
+ *
+ * @param line - one non-blank line of an import
+ */
+export function parseTaskLine(line: string): Result<NewTask> {
+  const fields = line.split(';');
+  if (fields.length > 3) return err('invalid-input', 'a line has at most three fields: title;priority;tags');
+  const [title, priority = '', tags = ''] = fields;
+  return ok({
+    title: title.trim(),
+    priority: (priority.trim() || 'normal') as Priority,
+    tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+  });
+}
+
+/**
+ * Adds to the list every valid task of the text, one per line as `title;priority;tags`. Blank lines are
+ * skipped; lines that cannot be added are reported with their number, counting from 1, and the rest are
+ * still imported.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: ImportRejection[] = [];
+  text.split(/\r?\n/).forEach((line, index) => {
+    if (line.trim() === '') return;
+    const parsed = parseTaskLine(line);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
