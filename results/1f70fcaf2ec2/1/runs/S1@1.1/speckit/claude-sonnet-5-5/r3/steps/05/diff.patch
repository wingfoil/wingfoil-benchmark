 const doc = {
   foo: ["bar", "baz"],
@@ -197,3 +197,63 @@ test("merge patch rejects non-JSON values", () => {
   assert.throws(() => applyMergePatch({}, { a: undefined }));
   assert.throws(() => applyMergePatch({}, { a: NaN }));
 });
+
+function roundTrip(from: unknown, to: unknown) {
+  const f = structuredClone(from);
+  const t = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, f);
+  assert.deepEqual(to, t);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("createPatch: equal values and small changes", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+  assert.deepEqual(roundTrip({ a: 1, b: { c: 2, d: 3 } }, { a: 1, b: { c: 2, d: 4 } }), [
+    { op: "replace", path: "/b/d", value: 4 },
+  ]);
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+  assert.deepEqual(roundTrip(1, "x"), [{ op: "replace", path: "", value: "x" }]);
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+});
+
+test("createPatch: escaping and __proto__", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "m~n": 1 }, { "a/b": 2, "m~n": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/m~0n", value: 2 },
+  ]);
+  const p = JSON.parse('{"__proto__": 1}');
+  roundTrip({}, p);
+  roundTrip(p, JSON.parse('{"__proto__": 2}'));
+});
+
+test("createPatch: array insert, remove, move", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [0, 1, 2, 3, 4]), [
+    { op: "add", path: "/0", value: 0 },
+    { op: "add", path: "/4", value: 4 },
+  ]);
+  const move = roundTrip([1, 2, 3, 4, 5, 6], [1, 6, 2, 3, 4, 5]);
+  assert.equal(move.length, 2);
+  roundTrip([{ id: 1 }, { id: 2 }, { id: 3 }], [{ id: 2 }, { id: 3 }, { id: 1 }]);
+  assert.deepEqual(roundTrip([{ id: 1, v: 1 }, { id: 2 }], [{ id: 1, v: 2 }, { id: 2 }]), [
+    { op: "replace", path: "/0/v", value: 2 },
+  ]);
+});
+
+test("createPatch: random round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) % 2147483648), seed % n);
+  const arr = () => Array.from({ length: rnd(8) }, () => (rnd(4) === 0 ? { k: rnd(3) } : rnd(5)));
+  for (let i = 0; i < 500; i++) roundTrip({ x: arr(), y: [arr()] }, { x: arr(), y: [arr(), arr()] });
+});
+
+test("createPatch: rejects non-JSON", () => {
+  assert.throws(() => createPatch({ a: undefined }, {}));
+  assert.throws(() => createPatch({}, NaN));
+});
diff --git a/src/index.ts b/src/index.ts
index 2fcbed7a75f04f448d6f3a560721dd81b57df70b..c8f1c22058eb8460430125f06d5105e9515f2cca 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -258,3 +258,95 @@ export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
   assertJson(target);
   return mergePatch(target, patch);
 }
+
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: JsonValue };
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(a: JsonValue[], b: JsonValue[], path: string, ops: Operation[]): void {
+  let start = 0;
+  while (start < a.length && start < b.length && equal(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && equal(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+
+  // Longest common subsequence of the middle parts.
+  const n = endA - start;
+  const m = endB - start;
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = equal(a[start + i], b[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  // Index in the array as it stands after the operations emitted so far.
+  let index = start;
+  const gap = (ai: number, aj: number, bi: number, bj: number): void => {
+    const removed = aj - ai;
+    const added = bj - bi;
+    const paired = Math.min(removed, added);
+    for (let t = 0; t < paired; t++) diff(a[ai + t], b[bi + t], `${path}/${index + t}`, ops);
+    for (let t = paired; t < removed; t++) ops.push({ op: "remove", path: `${path}/${index + paired}` });
+    for (let t = paired; t < added; t++) {
+      ops.push({ op: "add", path: `${path}/${index + t}`, value: clone(b[bi + t]) });
+    }
+    index += added;
+  };
+
+  let i = 0;
+  let j = 0;
+  let gi = 0;
+  let gj = 0;
+  while (i < n && j < m) {
+    if (equal(a[start + i], b[start + j])) {
+      gap(start + gi, start + i, start + gj, start + j);
+      i++;
+      j++;
+      index++;
+      gi = i;
+      gj = j;
+    } else if (lcs[i + 1][j] >= lcs[i][j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  gap(start + gi, endA, start + gj, endB);
+}
+
+function diff(a: JsonValue, b: JsonValue, path: string, ops: Operation[]): void {
+  if (Array.isArray(a) && Array.isArray(b)) {
+    diffArrays(a, b, path, ops);
+  } else if (isObject(a) && isObject(b)) {
+    for (const key of Object.keys(a)) {
+      if (!Object.hasOwn(b, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(b)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (!Object.hasOwn(a, key)) ops.push({ op: "add", path: child, value: clone(b[key]) });
+      else diff(a[key], b[key], child, ops);
+    }
+  } else if (!equal(a, b)) {
+    ops.push({ op: "replace", path, value: clone(b) });
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied.
+ * Neither argument is mutated. Throws if either is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  assertJson(from);
+  assertJson(to);
+  const ops: Operation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
