+
+test("RFC 7386 Appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("merge patch does not mutate or share structure", () => {
+  const target = { a: { b: 1 }, l: [1] };
+  const patch = { a: { c: { d: 2 } }, l: [3] };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 }, l: [1] });
+  assert.deepEqual(patch, { a: { c: { d: 2 } }, l: [3] });
+  assert.notEqual(result.a.c, patch.a.c);
+  assert.notEqual(result.l, patch.l);
+  assert.notEqual(result.a, target.a);
+});
+
+test("merge patch treats __proto__ as an ordinary key", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as any;
+  assert.equal(Object.hasOwn(result, "__proto__"), true);
+  assert.equal(({} as any).x, undefined);
+  assert.equal(result.x, undefined);
+});
+
+test("merge patch rejects non-JSON values", () => {
+  assert.throws(() => applyMergePatch({}, { a: undefined }));
+  assert.throws(() => applyMergePatch({}, { a: NaN }));
+});
diff --git a/src/index.ts b/src/index.ts
index 825f883f969b02f73f2006a48269b9bf0ddac683..2fcbed7a75f04f448d6f3a560721dd81b57df70b 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -234,3 +234,27 @@ export function applyPatch(document: unknown, patch: unknown): JsonValue {
   }
   return result;
 }
+
+function mergePatch(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isObject(patch)) return clone(patch);
+  const result: { [key: string]: JsonValue } = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) setMember(result, key, clone(target[key]));
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) delete result[key];
+    else setMember(result, key, mergePatch(Object.hasOwn(result, key) ? result[key] : undefined, value));
+  }
+  return result;
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a document and returns the result as a new value.
+ * Neither argument is mutated. Throws if the patch or the target is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
+  assertJson(patch);
+  assertJson(target);
+  return mergePatch(target, patch);
+}
