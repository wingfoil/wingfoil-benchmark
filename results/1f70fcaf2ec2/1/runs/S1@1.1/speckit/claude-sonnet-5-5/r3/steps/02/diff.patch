+  );
+  assert.deepEqual(ap({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(ap({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }]), { baz: "qux", foo: ["a", 2, "c"] });
+  assert.throws(() => ap({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]));
+  assert.deepEqual(ap({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]), { foo: "bar", child: { grandchild: {} } });
+  assert.deepEqual(ap({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }]), { foo: "bar", baz: "qux" });
+  assert.throws(() => ap({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]));
+  assert.throws(() => ap({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }, { op: "add", path: "/a", value: 1 }]));
+  assert.deepEqual(ap({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }]), { "/": 9, "~1": 10 });
+  assert.throws(() => ap({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]));
+  assert.deepEqual(ap({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]), { foo: ["bar", ["abc", "def"]] });
+  assert.deepEqual(ap({ foo: 1, bar: [1, 2, 3, 4] }, [{ op: "remove", path: "/bar" }]), { foo: 1 });
+  assert.deepEqual(ap({ foo: [1, 2, 3] }, [{ op: "copy", from: "/foo/0", path: "/foo/-" }]), { foo: [1, 2, 3, 1] });
+});
+
+test("root, copy and move edge cases", () => {
+  assert.deepEqual(ap({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(ap({ a: 1 }, [{ op: "replace", path: "", value: null }]), null);
+  assert.throws(() => ap({ a: 1 }, [{ op: "remove", path: "" }]));
+  assert.deepEqual(ap({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.throws(() => ap({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => ap({ a: 1 }, [{ op: "move", from: "/x", path: "/a" }]));
+  assert.deepEqual(ap({ a: { b: 1 } }, [{ op: "test", path: "", value: { a: { b: 1 } } }]), { a: { b: 1 } });
+  assert.throws(() => ap({ a: [1] }, [{ op: "test", path: "/a", value: [1, 2] }]));
+  assert.throws(() => ap({ a: 1 }, [{ op: "test", path: "/a", value: true }]));
+  assert.deepEqual(ap({ a: null }, [{ op: "test", path: "/a", value: null }]), { a: null });
+});
+
+test("invalid patches and failing operations throw", () => {
+  const bad: unknown[] = [
+    {},
+    [null],
+    [{ path: "/a", value: 1 }],
+    [{ op: "bogus", path: "/a" }],
+    [{ op: "add", path: "/a" }],
+    [{ op: "add", path: "a", value: 1 }],
+    [{ op: "add", path: 1, value: 1 }],
+    [{ op: "move", path: "/a" }],
+    [{ op: "copy", from: 1, path: "/a" }],
+    [{ op: "add", path: "/arr/4", value: 1 }],
+    [{ op: "add", path: "/arr/01", value: 1 }],
+    [{ op: "add", path: "/arr/x", value: 1 }],
+    [{ op: "remove", path: "/arr/3" }],
+    [{ op: "remove", path: "/arr/-" }],
+    [{ op: "remove", path: "/nope" }],
+    [{ op: "replace", path: "/nope", value: 1 }],
+    [{ op: "replace", path: "/arr/3", value: 1 }],
+    [{ op: "copy", from: "/nope", path: "/x" }],
+    [{ op: "remove", path: "/toString" }],
+  ];
+  for (const p of bad) assert.throws(() => ap({ arr: [1, 2, 3] }, p), undefined, JSON.stringify(p));
+});
+
+test("does not mutate or alias inputs", () => {
+  const document = { a: { b: [1, 2] }, c: 1 };
+  const value = { x: [1] };
+  const patch = [
+    { op: "add", path: "/a/b/0", value: 0 },
+    { op: "add", path: "/v", value },
+    { op: "copy", from: "/a", path: "/a2" },
+    { op: "move", from: "/c", path: "/d" },
+  ];
+  const docCopy = structuredClone(document);
+  const patchCopy = structuredClone(patch);
+  const out = ap(document, patch) as any;
+  assert.deepEqual(document, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  out.v.x.push(2);
+  out.a2.b.push(9);
+  assert.deepEqual(value, { x: [1] });
+  assert.deepEqual(out.a.b, [0, 1, 2]);
+  const proto = ap({}, [{ op: "add", path: "/__proto__", value: { p: 1 } }]) as any;
+  assert.equal(Object.getPrototypeOf(proto), Object.prototype);
+  assert.deepEqual(Object.keys(proto), ["__proto__"]);
+});
