--- a/src/index.ts
+++ b/src/index.ts
@@ -51,3 +51,171 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+type Container = JsonValue[] | { [key: string]: JsonValue };
+
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+function isObject(value: unknown): value is { [key: string]: JsonValue } {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setMember(target: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(target, key, { value, enumerable: true, writable: true, configurable: true });
+}
+
+function clone(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) return value.map(clone);
+  if (isObject(value)) {
+    const copy: { [key: string]: JsonValue } = {};
+    for (const key of Object.keys(value)) setMember(copy, key, clone(value[key]));
+    return copy;
+  }
+  return value;
+}
+
+function equal(a: JsonValue, b: JsonValue): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => equal(v, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((k) => Object.hasOwn(b, k) && equal(a[k], b[k]))
+    );
+  }
+  return a === b;
+}
+
+function parent(root: JsonValue, tokens: string[]): Container {
+  let current: JsonValue = root;
+  for (const token of tokens.slice(0, -1)) {
+    current = child(current, token);
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new Error("Patch path does not resolve: parent is a scalar");
+  }
+  return current;
+}
+
+function child(container: JsonValue, token: string): JsonValue {
+  if (Array.isArray(container)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= container.length) {
+      throw new Error(`Patch path does not resolve: bad array index "${token}"`);
+    }
+    return container[Number(token)];
+  }
+  if (isObject(container)) {
+    if (!Object.hasOwn(container, token)) {
+      throw new Error(`Patch path does not resolve: no member "${token}"`);
+    }
+    return container[token];
+  }
+  throw new Error(`Patch path does not resolve: cannot descend into a scalar at "${token}"`);
+}
+
+function getAt(root: JsonValue, tokens: string[]): JsonValue {
+  return tokens.reduce<JsonValue>(child, root);
+}
+
+function addAt(root: JsonValue, tokens: string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) return value;
+  const target = parent(root, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(target)) {
+    if (token === "-") {
+      target.push(value);
+    } else if (ARRAY_INDEX.test(token) && Number(token) <= target.length) {
+      target.splice(Number(token), 0, value);
+    } else {
+      throw new Error(`Cannot add: bad array index "${token}"`);
+    }
+  } else {
+    setMember(target, token, value);
+  }
+  return root;
+}
+
+function removeAt(root: JsonValue, tokens: string[]): JsonValue {
+  if (tokens.length === 0) throw new Error("Cannot remove the document root");
+  const target = parent(root, tokens);
+  const token = tokens[tokens.length - 1];
+  child(target, token); // must exist
+  if (Array.isArray(target)) target.splice(Number(token), 1);
+  else delete target[token];
+  return root;
+}
+
+function replaceAt(root: JsonValue, tokens: string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) return value;
+  const target = parent(root, tokens);
+  const token = tokens[tokens.length - 1];
+  child(target, token); // must exist
+  if (Array.isArray(target)) target[Number(token)] = value;
+  else setMember(target, token, value);
+  return root;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a document and returns the result as a new value.
+ * Neither argument is mutated. Throws if the patch is invalid or any operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): JsonValue {
+  if (!Array.isArray(patch)) throw new Error("Invalid JSON Patch: not an array");
+  let result = clone(document as JsonValue);
+
+  for (const operation of patch as unknown[]) {
+    if (!isObject(operation)) throw new Error("Invalid JSON Patch: operation is not an object");
+    const { op } = operation;
+    if (typeof op !== "string") throw new Error("Invalid JSON Patch: missing op");
+    if (!["add", "remove", "replace", "move", "copy", "test"].includes(op)) {
+      throw new Error(`Invalid JSON Patch: unknown op "${op}"`);
+    }
+    const path = parsePointer(operation.path);
+    const needsValue = op === "add" || op === "replace" || op === "test";
+    if (needsValue && !Object.hasOwn(operation, "value")) {
+      throw new Error(`Invalid JSON Patch: "${op}" requires a value`);
+    }
+    const from = op === "move" || op === "copy" ? parsePointer(operation.from) : [];
+    const value = needsValue ? clone(operation.value) : null;
+
+    switch (op) {
+      case "add":
+        result = addAt(result, path, value);
+        break;
+      case "remove":
+        result = removeAt(result, path);
+        break;
+      case "replace":
+        result = replaceAt(result, path, value);
+        break;
+      case "copy":
+        result = addAt(result, path, clone(getAt(result, from)));
+        break;
+      case "move": {
+        const moved = getAt(result, from);
+        if (from.length === path.length && from.every((t, i) => t === path[i])) break;
+        if (from.length < path.length && from.every((t, i) => t === path[i])) {
+          throw new Error("Cannot move a value into one of its own children");
+        }
+        result = addAt(removeAt(result, from), path, moved);
+        break;
+      }
+      case "test":
+        if (!equal(getAt(result, path), value)) throw new Error("Test operation failed");
+        break;
+    }
+  }
+  return result;
+}
