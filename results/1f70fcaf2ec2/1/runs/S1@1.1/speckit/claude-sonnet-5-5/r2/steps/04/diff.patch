   return root;
 }
+
+const isObject = (v: Json): v is Record<string, Json> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch);
+  const result = isObject(target) ? (clone(target) as Record<string, Json>) : {};
+  for (const k of Object.keys(patch)) {
+    const v = patch[k];
+    if (v === null) delete result[k];
+    else setMember(result, k, applyMergePatch(has(result, k) ? result[k] : undefined, v));
+  }
+  return result;
+}
diff --git a/test/merge-patch.test.ts b/test/merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2b4b8f45920c864e8a77c7fc0164e4ce72d89ef4
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,34 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, e] of cases) assert.deepEqual(applyMergePatch(t, p), e);
+});
+
+test("does not mutate inputs and handles __proto__", () => {
+  const t = { a: { b: 1 } };
+  const p = JSON.parse('{"a":{"c":2},"__proto__":{"x":1}}');
+  const r = applyMergePatch(t, p) as any;
+  assert.deepEqual(t, { a: { b: 1 } });
+  assert.equal(({} as any).x, undefined);
+  assert.equal(r.a.c, 2);
+  assert.deepEqual(Object.keys(r), ["a", "__proto__"]);
+});
