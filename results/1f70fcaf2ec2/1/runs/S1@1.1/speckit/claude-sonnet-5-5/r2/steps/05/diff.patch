@@ -0,0 +1,78 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const rt = (a: unknown, b: unknown) => {
+  const before = JSON.stringify(a);
+  const patch = createPatch(a, b);
+  assert.equal(JSON.stringify(a), before);
+  assert.deepEqual(applyPatch(a, patch), b);
+  return patch as any[];
+};
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(rt({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small nested change is one operation", () => {
+  const p = rt({ a: { b: { c: 1, d: 2 } }, x: [1, 2] }, { a: { b: { c: 1, d: 3 } }, x: [1, 2] });
+  assert.deepEqual(p, [{ op: "replace", path: "/a/b/d", value: 3 }]);
+});
+
+test("root and type changes", () => {
+  assert.deepEqual(rt(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  rt({ a: 1 }, [1]);
+  rt([1], null);
+});
+
+test("array insert and remove touch one item", () => {
+  assert.deepEqual(rt([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(rt([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(rt([{ a: 1 }, { b: 2 }], [{ b: 2 }]), [{ op: "remove", path: "/0" }]);
+});
+
+test("array move is at most a remove and an add", () => {
+  const p = rt(["a", "b", "c", "d", "e"], ["b", "c", "d", "e", "a"]);
+  assert.ok(p.length <= 2);
+  assert.ok(rt(["a", "b", "c", "d", "e"], ["a", "e", "b", "c", "d"]).length <= 2);
+});
+
+test("item edited in place is patched inside", () => {
+  assert.deepEqual(rt([{ id: 1, n: "x" }, { id: 2 }], [{ id: 1, n: "y" }, { id: 2 }]), [
+    { op: "replace", path: "/0/n", value: "y" },
+  ]);
+});
+
+test("escaping and special names", () => {
+  const a = JSON.parse('{"a/b":1,"c~d":1,"":1,"__proto__":{"x":1}}');
+  const b = JSON.parse('{"a/b":2,"c~d":2,"":2,"__proto__":{"x":2}}');
+  rt(a, b);
+  rt({}, b);
+  assert.equal(({} as any).x, undefined);
+});
+
+test("inputs are not shared with the patch", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to) as any[];
+  patch[0].value.b = 5;
+  assert.equal(to.a.b, 1);
+});
+
+test("randomized round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) % 2147483648), seed % n);
+  const gen = (d: number): unknown => {
+    const t = rnd(d > 2 ? 3 : 5);
+    if (t === 0) return rnd(4);
+    if (t === 1) return ["x", "y", null][rnd(3)];
+    if (t === 2) return rnd(2) === 0;
+    if (t === 3) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let i = 0; i < 3000; i++) {
+    const a = gen(0);
+    const b = rnd(2) ? gen(0) : JSON.parse(JSON.stringify(a));
+    if (Array.isArray(b) && b.length > 1 && rnd(2)) b.push(b.shift());
+    rt(a, b);
+  }
+});
