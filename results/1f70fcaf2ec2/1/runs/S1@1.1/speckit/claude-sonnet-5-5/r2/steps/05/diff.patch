   return result;
 }
+
+type Operation = { op: string; path: string; value?: Json };
+
+const escapeToken = (t: string) => t.replace(/~/g, "~0").replace(/\//g, "~1");
+
+function canonical(v: Json): string {
+  if (Array.isArray(v)) return `[${v.map(canonical).join(",")}]`;
+  if (isObject(v)) {
+    return `{${Object.keys(v)
+      .sort()
+      .map((k) => `${JSON.stringify(k)}:${canonical(v[k])}`)
+      .join(",")}}`;
+  }
+  return JSON.stringify(v);
+}
+
+function diffArrays(a: Json[], b: Json[], path: string, ops: Operation[]): void {
+  const ka = a.map(canonical);
+  const kb = b.map(canonical);
+  let start = 0;
+  while (start < a.length && start < b.length && ka[start] === kb[start]) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && ka[endA - 1] === kb[endB - 1]) {
+    endA--;
+    endB--;
+  }
+
+  // anchors: pairs [i, j] of equal items that stay in place relative to each other
+  const anchors: [number, number][] = [];
+  for (let i = 0; i < start; i++) anchors.push([i, i]);
+  const n = endA - start;
+  const m = endB - start;
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] =
+        ka[start + i] === kb[start + j] ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  for (let i = 0, j = 0; i < n && j < m; ) {
+    if (ka[start + i] === kb[start + j]) anchors.push([start + i, start + j]), i++, j++;
+    else if (lcs[i + 1][j] >= lcs[i][j + 1]) i++;
+    else j++;
+  }
+  for (let k = 0; k < a.length - endA; k++) anchors.push([endA + k, endB + k]);
+
+  const fromMatched = new Set(anchors.map(([i]) => i));
+  const toMatched = new Set(anchors.map(([, j]) => j));
+
+  // equal items that are unanchored on both sides are moves: removed here, added back at the destination
+  const pendingByKey = new Map<string, number[]>();
+  for (let i = 0; i < a.length; i++) {
+    if (fromMatched.has(i)) continue;
+    const list = pendingByKey.get(ka[i]) ?? [];
+    list.push(i);
+    pendingByKey.set(ka[i], list);
+  }
+  const removed = new Set<number>();
+  const moveDest = new Set<number>();
+  for (let j = 0; j < b.length; j++) {
+    if (toMatched.has(j)) continue;
+    const src = pendingByKey.get(kb[j])?.shift();
+    if (src !== undefined) {
+      removed.add(src);
+      moveDest.add(j);
+    }
+  }
+
+  // remaining unmatched items inside the same gap are the same item, edited in place
+  const paired = new Map<number, number>(); // to index -> from index
+  const bounds = [...anchors, [a.length, b.length] as [number, number]];
+  let prevI = -1;
+  let prevJ = -1;
+  for (const [ai, aj] of bounds) {
+    const fs: number[] = [];
+    const ts: number[] = [];
+    for (let i = prevI + 1; i < ai; i++) if (!fromMatched.has(i) && !removed.has(i)) fs.push(i);
+    for (let j = prevJ + 1; j < aj; j++) if (!toMatched.has(j) && !moveDest.has(j)) ts.push(j);
+    for (let k = 0; k < Math.min(fs.length, ts.length); k++) paired.set(ts[k], fs[k]);
+    prevI = ai;
+    prevJ = aj;
+  }
+  const pairedFrom = new Set(paired.values());
+
+  for (let i = a.length - 1; i >= 0; i--) {
+    if (!fromMatched.has(i) && !pairedFrom.has(i)) ops.push({ op: "remove", path: `${path}/${i}` });
+  }
+  for (let j = 0; j < b.length; j++) {
+    if (paired.has(j)) diff(a[paired.get(j)!], b[j], `${path}/${j}`, ops);
+    else if (!toMatched.has(j)) ops.push({ op: "add", path: `${path}/${j}`, value: clone(b[j]) });
+  }
+}
+
+function diff(a: Json, b: Json, path: string, ops: Operation[]): void {
+  if (deepEqual(a, b)) return;
+  if (Array.isArray(a) && Array.isArray(b)) {
+    diffArrays(a, b, path, ops);
+  } else if (isObject(a) && isObject(b)) {
+    for (const k of Object.keys(a)) {
+      if (!has(b, k)) ops.push({ op: "remove", path: `${path}/${escapeToken(k)}` });
+    }
+    for (const k of Object.keys(b)) {
+      const p = `${path}/${escapeToken(k)}`;
+      if (has(a, k)) diff(a[k], b[k], p, ops);
+      else ops.push({ op: "add", path: p, value: clone(b[k]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(b) });
+  }
+}
+
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const ops: Operation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
