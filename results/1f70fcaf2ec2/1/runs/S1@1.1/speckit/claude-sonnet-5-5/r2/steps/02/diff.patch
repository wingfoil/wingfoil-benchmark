@@ -0,0 +1,137 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) =>
+  assert.deepEqual(applyPatch(doc, patch as any), expected);
+const bad = (doc: unknown, patch: unknown) =>
+  assert.throws(() => applyPatch(doc, patch as any));
+
+test("RFC 6902 appendix A examples", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  ok({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  });
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", op2: 1 }, { op: "bogus", path: "/x" }]);
+  ok({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 });
+  bad({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]);
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] });
+  ok({ foo: 1 }, [{ op: "copy", from: "/foo", path: "/bar" }], { foo: 1, bar: 1 });
+});
+
+test("root replacement and empty patch", () => {
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: null }], null);
+  ok({ a: 1 }, [], { a: 1 });
+  bad({ a: 1 }, [{ op: "remove", path: "" }]);
+});
+
+test("does not mutate inputs or alias the patch", () => {
+  const doc = { a: [1, { b: 2 }] };
+  const snapshot = structuredClone(doc);
+  const value = { x: [1] };
+  const patch = [{ op: "add", path: "/c", value }, { op: "copy", from: "/a", path: "/d" }, { op: "remove", path: "/a/0" }];
+  const patchSnap = structuredClone(patch);
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, snapshot);
+  assert.deepEqual(patch, patchSnap);
+  assert.notEqual(out.c, value);
+  out.c.x.push(2);
+  assert.deepEqual(value, { x: [1] });
+  assert.notEqual(out.d, out.a);
+  assert.deepEqual(out.d, [1, { b: 2 }]);
+});
+
+test("failed patch throws, leaving input untouched", () => {
+  const doc = { a: 1 };
+  bad(doc, [{ op: "add", path: "/b", value: 2 }, { op: "remove", path: "/zzz" }]);
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("invalid patches", () => {
+  bad({}, { op: "add" });
+  bad({}, null);
+  bad({}, [null]);
+  bad({}, [[]]);
+  bad({}, [{ path: "/a", value: 1 }]);
+  bad({}, [{ op: "nope", path: "/a" }]);
+  bad({}, [{ op: "add", value: 1 }]);
+  bad({}, [{ op: "add", path: 1, value: 1 }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({ a: 1 }, [{ op: "replace", path: "/a" }]);
+  bad({ a: 1 }, [{ op: "test", path: "/a" }]);
+  bad({ a: 1 }, [{ op: "move", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "copy", path: "/b", from: 1 }]);
+  bad({}, [{ op: "add", path: "a", value: 1 }]);
+  bad({}, [{ op: "add", path: "/a~2", value: 1 }]);
+  ok({}, [{ op: "add", path: "/a", value: null }], { a: null });
+});
+
+test("array index rules", () => {
+  bad([1], [{ op: "add", path: "/2", value: 0 }]);
+  ok([1], [{ op: "add", path: "/1", value: 0 }], [1, 0]);
+  bad([1], [{ op: "add", path: "/01", value: 0 }]);
+  bad([1], [{ op: "add", path: "/-1", value: 0 }]);
+  bad([1], [{ op: "remove", path: "/-" }]);
+  bad([1], [{ op: "remove", path: "/1" }]);
+  bad([1], [{ op: "replace", path: "/1", value: 0 }]);
+  bad([1], [{ op: "replace", path: "/-", value: 0 }]);
+  bad([1], [{ op: "test", path: "/-", value: 1 }]);
+  bad([1], [{ op: "copy", from: "/-", path: "/0" }]);
+  bad(1, [{ op: "add", path: "/a", value: 0 }]);
+});
+
+test("missing targets", () => {
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad({}, [{ op: "move", from: "/a", path: "/b" }]);
+  bad({}, [{ op: "copy", from: "/a", path: "/b" }]);
+  bad({}, [{ op: "test", path: "/a", value: undefined }]);
+});
+
+test("move edge cases", () => {
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  bad({}, [{ op: "move", from: "/a", path: "/a" }]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "" }], 1);
+});
+
+test("test op equality", () => {
+  ok({ a: { x: 1, y: [1, 2] } }, [{ op: "test", path: "/a", value: { y: [1, 2], x: 1 } }], { a: { x: 1, y: [1, 2] } });
+  bad({ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]);
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+  bad({ a: 0 }, [{ op: "test", path: "/a", value: false }]);
+  bad({ a: null }, [{ op: "test", path: "/a", value: 0 }]);
+  bad({ a: [] }, [{ op: "test", path: "/a", value: {} }]);
+  bad({ a: { x: 1 } }, [{ op: "test", path: "/a", value: { x: 1, y: 2 } }]);
+  ok({ a: null }, [{ op: "test", path: "/a", value: null }], { a: null });
+});
+
+test("__proto__ is plain data", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: 1 } }]) as any;
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal((out as any).polluted, undefined);
+  assert.equal(({} as any).polluted, undefined);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+  const parsed = JSON.parse('{"__proto__":{"k":1}}');
+  const out2 = applyPatch(parsed, [{ op: "copy", from: "/__proto__", path: "/c" }]) as any;
+  assert.equal(Object.getPrototypeOf(out2), Object.prototype);
+  assert.deepEqual(out2.c, { k: 1 });
+});
