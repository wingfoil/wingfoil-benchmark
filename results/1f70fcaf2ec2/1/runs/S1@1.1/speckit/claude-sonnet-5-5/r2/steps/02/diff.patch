 }
+
+type Json = unknown;
+type Container = Record<string, Json> | Json[];
+
+const has = (o: object, k: string) => Object.prototype.hasOwnProperty.call(o, k);
+
+function setMember(o: Record<string, Json>, k: string, v: Json): void {
+  Object.defineProperty(o, k, { value: v, writable: true, enumerable: true, configurable: true });
+}
+
+function clone(value: Json): Json {
+  if (Array.isArray(value)) return value.map(clone);
+  if (typeof value === "object" && value !== null) {
+    const out: Record<string, Json> = {};
+    for (const k of Object.keys(value)) setMember(out, k, clone((value as Record<string, Json>)[k]));
+    return out;
+  }
+  return value;
+}
+
+function deepEqual(a: Json, b: Json): boolean {
+  if (a === b) return true;
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((x, i) => deepEqual(x, b[i]));
+  }
+  if (typeof a === "object" && a !== null) {
+    if (typeof b !== "object" || b === null || Array.isArray(b)) return false;
+    const ka = Object.keys(a);
+    return (
+      ka.length === Object.keys(b).length &&
+      ka.every((k) => has(b, k) && deepEqual((a as Record<string, Json>)[k], (b as Record<string, Json>)[k]))
+    );
+  }
+  return false;
+}
+
+function parent(root: Json, tokens: string[]): Container {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) current = child(current, token);
+  if (typeof current !== "object" || current === null) {
+    throw new Error("JSON Patch: parent of the target is not an object or array");
+  }
+  return current as Container;
+}
+
+function child(current: Json, token: string): Json {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+      throw new Error(`JSON Patch: no array element "${token}"`);
+    }
+    return current[Number(token)];
+  }
+  if (typeof current === "object" && current !== null && has(current, token)) {
+    return (current as Record<string, Json>)[token];
+  }
+  throw new Error(`JSON Patch: path does not exist at "${token}"`);
+}
+
+function get(root: Json, tokens: string[]): Json {
+  let current = root;
+  for (const token of tokens) current = child(current, token);
+  return current;
+}
+
+function add(root: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  const p = parent(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(p)) {
+    if (key === "-") p.push(value);
+    else if (ARRAY_INDEX.test(key) && Number(key) <= p.length) p.splice(Number(key), 0, value);
+    else throw new Error(`JSON Patch: invalid array index "${key}"`);
+  } else {
+    setMember(p, key, value);
+  }
+  return root;
+}
+
+function remove(root: Json, tokens: string[]): Json {
+  if (tokens.length === 0) throw new Error("JSON Patch: cannot remove the document root");
+  get(root, tokens); // target must exist
+  const p = parent(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(p)) p.splice(Number(key), 1);
+  else delete (p as Record<string, Json>)[key];
+  return root;
+}
+
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new TypeError("JSON Patch must be an array of operations");
+  let root = clone(document);
+  for (const op of patch) {
+    if (typeof op !== "object" || op === null || Array.isArray(op)) {
+      throw new TypeError("JSON Patch operation must be an object");
+    }
+    const o = op as Record<string, unknown>;
+    const pointer = (name: string): string[] => {
+      if (!has(o, name) || typeof o[name] !== "string") {
+        throw new TypeError(`JSON Patch operation requires a string "${name}"`);
+      }
+      return parse(o[name] as string);
+    };
+    const value = (): Json => {
+      if (!has(o, "value")) throw new TypeError('JSON Patch operation requires a "value"');
+      return clone(o.value);
+    };
+    switch (o.op) {
+      case "add": {
+        const path = pointer("path");
+        root = add(root, path, value());
+        break;
+      }
+      case "remove":
+        root = remove(root, pointer("path"));
+        break;
+      case "replace": {
+        const path = pointer("path");
+        const v = value();
+        get(root, path);
+        root = path.length === 0 ? v : add(remove(root, path), path, v);
+        break;
+      }
+      case "move": {
+        const from = pointer("from");
+        const path = pointer("path");
+        const v = get(root, from);
+        if (from.length < path.length && from.every((t, i) => t === path[i])) {
+          throw new Error("JSON Patch: cannot move a value into one of its own children");
+        }
+        if (from.length === path.length && from.every((t, i) => t === path[i])) break;
+        root = add(remove(root, from), path, v);
+        break;
+      }
+      case "copy": {
+        const from = pointer("from");
+        const path = pointer("path");
+        root = add(root, path, clone(get(root, from)));
+        break;
+      }
+      case "test": {
+        const path = pointer("path");
+        const v = value();
+        if (!deepEqual(get(root, path), v)) throw new Error("JSON Patch: test failed");
+        break;
+      }
+      default:
+        throw new Error(`JSON Patch: unknown operation ${JSON.stringify(o.op)}`);
+    }
+  }
+  return root;
+}
