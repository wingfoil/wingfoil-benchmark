+
+test("move onto its own location is a no-op; sparse patches are invalid", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "", path: "" }]), { a: 1 });
+  assert.deepEqual(applyPatch({ a: [1, 2] }, [{ op: "move", from: "/a/0", path: "/a/0" }]), { a: [1, 2] });
