index 0000000000000000000000000000000000000000..0d31cb2b8fbd9664d8576620d22e0599aca227c0
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,39 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) assert.deepEqual(applyMergePatch(target, patch), expected);
+});
+
+test("does not mutate or alias inputs", () => {
+  const target = { a: { b: 1 } };
+  const patch = { c: { d: [1] } };
+  const out = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 } });
+  assert.notEqual(out.c, patch.c);
+  assert.notEqual(out.a, target.a);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const out = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as any;
+  assert.equal(Object.hasOwn(out, "__proto__"), true);
+  assert.equal(({} as any).x, undefined);
+});
