--- /dev/null
+++ b/src/patch.ts
@@ -0,0 +1,154 @@
+import { ARRAY_INDEX, parsePointer } from "./pointer.ts";
+
+type Container = Record<string, unknown> | unknown[];
+
+const OPS = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => deepEqual(item, b[i]));
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.hasOwn(b, key) && deepEqual(a[key], b[key]))
+    );
+  }
+  return false;
+}
+
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty so that a member named "__proto__" is an ordinary own member
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Walks to the parent of the location designated by `tokens`; the parent must exist. */
+function parentOf(document: unknown, tokens: string[], path: string): Container {
+  let current = document;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`Path "${path}" does not exist: no array element "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (isObject(current) && Object.hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path "${path}" does not exist: no value at "${token}"`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new Error(`Path "${path}" does not exist: parent is not an object or array`);
+  }
+  return current;
+}
+
+function arrayIndex(parent: unknown[], token: string, path: string, allowEnd: boolean): number {
+  if (allowEnd && token === "-") return parent.length;
+  const index = ARRAY_INDEX.test(token) ? Number(token) : -1;
+  if (index < 0 || index > parent.length || (index === parent.length && !allowEnd)) {
+    throw new Error(`Path "${path}" does not exist: invalid array index "${token}"`);
+  }
+  return index;
+}
+
+function getAt(document: unknown, path: string): unknown {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return document;
+  const parent = parentOf(document, tokens, path);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) return parent[arrayIndex(parent, token, path, false)];
+  if (!Object.hasOwn(parent, token)) throw new Error(`Path "${path}" does not exist`);
+  return parent[token];
+}
+
+function addAt(document: unknown, path: string, value: unknown): unknown {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(document, tokens, path);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(arrayIndex(parent, token, path, true), 0, value);
+  else setMember(parent, token, value);
+  return document;
+}
+
+function removeAt(document: unknown, path: string): unknown {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) throw new Error("Cannot remove the document root");
+  const parent = parentOf(document, tokens, path);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(arrayIndex(parent, token, path, false), 1);
+  else if (Object.hasOwn(parent, token)) delete parent[token];
+  else throw new Error(`Path "${path}" does not exist`);
+  return document;
+}
+
+function requireString(operation: Record<string, unknown>, member: string, index: number): string {
+  const value = operation[member];
+  if (typeof value !== "string") {
+    throw new TypeError(`Patch operation ${index}: "${member}" must be a string`);
+  }
+  return value;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the result as a new value.
+ * Neither argument is modified. Throws if the patch is invalid or any operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new TypeError("JSON Patch must be an array of operations");
+  let result = structuredClone(document);
+  patch.forEach((operation: unknown, i) => {
+    if (!isObject(operation)) throw new TypeError(`Patch operation ${i} must be an object`);
+    const op = operation.op;
+    if (typeof op !== "string" || !OPS.has(op)) {
+      throw new Error(`Patch operation ${i}: unknown or missing "op"`);
+    }
+    const path = requireString(operation, "path", i);
+    const from = op === "move" || op === "copy" ? requireString(operation, "from", i) : "";
+    let value: unknown;
+    if (op === "add" || op === "replace" || op === "test") {
+      if (!Object.hasOwn(operation, "value")) {
+        throw new TypeError(`Patch operation ${i}: "value" is required for "${op}"`);
+      }
+      value = structuredClone(operation.value);
+    }
+    switch (op) {
+      case "add":
+        result = addAt(result, path, value);
+        break;
+      case "remove":
+        result = removeAt(result, path);
+        break;
+      case "replace":
+        getAt(result, path);
+        result = path === "" ? value : addAt(removeAt(result, path), path, value);
+        break;
+      case "move": {
+        const fromTokens = parsePointer(from);
+        const pathTokens = parsePointer(path);
+        if (fromTokens.length < pathTokens.length && fromTokens.every((t, k) => t === pathTokens[k])) {
+          throw new Error(`Patch operation ${i}: cannot move "${from}" into one of its children`);
+        }
+        const moved = getAt(result, from);
+        result = addAt(removeAt(result, from), path, moved);
+        break;
+      }
+      case "copy":
+        result = addAt(result, path, structuredClone(getAt(result, from)));
+        break;
+      case "test":
+        if (!deepEqual(getAt(result, path), value)) {
+          throw new Error(`Patch operation ${i}: test failed at "${path}"`);
+        }
+        break;
+    }
+  });
+  return result;
+}
