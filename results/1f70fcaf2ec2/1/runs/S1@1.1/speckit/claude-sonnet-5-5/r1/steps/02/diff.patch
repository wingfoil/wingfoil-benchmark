diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..770c9ce401f2a096df78c6edda47b752777d4907
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,83 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("RFC 6902 appendix A examples", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(applyPatch({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+  assert.deepEqual(applyPatch({ baz: "qux" }, [{ op: "replace", path: "/baz", value: "boo" }]), { baz: "boo" });
+  assert.deepEqual(
+    applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(applyPatch({ foo: { bar: 1 } }, [{ op: "copy", from: "/foo", path: "/baz" }]), { foo: { bar: 1 }, baz: { bar: 1 } });
+  assert.deepEqual(applyPatch({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }]), { baz: "qux", foo: ["a", 2, "c"] });
+});
+
+test("failures throw", () => {
+  const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch));
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: 2 }]);
+  bad({ a: 1 }, [{ op: "test", path: "/b", value: 1 }]);
+  bad({ a: 1 }, [{ op: "remove", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "replace", path: "/b", value: 1 }]);
+  bad({ a: 1 }, [{ op: "add", path: "/b/c", value: 1 }]);
+  bad([1], [{ op: "add", path: "/3", value: 1 }]);
+  bad([1], [{ op: "add", path: "/01", value: 1 }]);
+  bad([1], [{ op: "remove", path: "/-" }]);
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b/c" }]);
+  bad({ a: 1 }, [{ op: "add", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "bogus", path: "/a" }]);
+  bad({ a: 1 }, [{ op: "move", path: "/a" }]);
+  bad({ a: 1 }, [{ op: "add", value: 1 }]);
+  bad({ a: 1 }, { op: "add" });
+  bad({ a: 1 }, ["x"]);
+  bad({ a: 1 }, [{ op: "remove", path: "a" }]);
+});
+
+test("root operations and null/false values", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: null }]), null);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "/a", value: false }]), { a: false });
+  assert.deepEqual(applyPatch({ a: 1 }, []), { a: 1 });
+});
+
+test("test compares deeply, ignoring member order", () => {
+  applyPatch({ a: { x: 1, y: [1, { z: 2 }] } }, [{ op: "test", path: "/a", value: { y: [1, { z: 2 }], x: 1 } }]);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]));
+  assert.throws(() => applyPatch({ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]));
+});
+
+test("inputs are not mutated and results do not alias them", () => {
+  const doc = { a: { b: [1, 2] } };
+  const value = { n: 1 };
+  const patch = [
+    { op: "add", path: "/a/b/0", value: 0 },
+    { op: "copy", from: "/a", path: "/c" },
+    { op: "add", path: "/v", value },
+    { op: "remove", path: "/a/b/1" },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.notEqual(out.a, doc.a);
+  assert.notEqual(out.v, value);
+  assert.notEqual(out.c, out.a);
+  out.v.n = 9;
+  assert.equal(value.n, 1);
+});
+
+test("failed patch leaves input untouched; __proto__ is an ordinary member", () => {
+  const doc = { a: 1 };
+  assert.throws(() => applyPatch(doc, [{ op: "add", path: "/b", value: 2 }, { op: "remove", path: "/zz" }]));
+  assert.deepEqual(doc, { a: 1 });
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as any;
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/toString" }]));
+});
