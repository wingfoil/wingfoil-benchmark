@@ -0,0 +1,61 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function check(from: unknown, to: unknown, maxOps?: number) {
+  const a = structuredClone(from);
+  const b = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, a);
+  assert.deepEqual(to, b);
+  assert.deepEqual(applyPatch(from, patch), to);
+  if (maxOps !== undefined) assert.ok(patch.length <= maxOps, JSON.stringify(patch));
+  return patch;
+}
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(check({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small change is small", () => {
+  assert.deepEqual(check({ a: { b: 1, c: [1, 2] }, d: 1 }, { a: { b: 2, c: [1, 2] }, d: 1 }), [
+    { op: "replace", path: "/a/b", value: 2 },
+  ]);
+});
+
+test("root, type changes, escaping", () => {
+  check(1, 2);
+  check({ a: 1 }, [1]);
+  check(null, { a: null });
+  check({ "a/b": 1, "~": 1 }, { "a/b": 2, x: 1 });
+  check({}, { ["__proto__"]: 1 });
+});
+
+test("array insert/remove/move touch only the item", () => {
+  const big = Array.from({ length: 10 }, (_, i) => ({ id: i }));
+  check(big, [...big.slice(0, 4), { id: 99 }, ...big.slice(4)], 1);
+  check(big, [...big.slice(0, 4), ...big.slice(5)], 1);
+  check(big, [big[0], ...big.slice(2, 8), big[1], ...big.slice(8)], 2);
+  check(big, [big[9], ...big.slice(0, 9)], 2);
+  check(big, big.slice().reverse());
+  check([1, 1, 1], [1, 1]);
+  check([1, 2, 3], [4, 1, 2, 3, 5]);
+});
+
+test("array element modified in place", () => {
+  assert.deepEqual(check([{ a: 1 }, { b: 2 }], [{ a: 1 }, { b: 3 }]), [{ op: "replace", path: "/1/b", value: 3 }]);
+});
+
+test("randomised round trip", () => {
+  let seed = 7;
+  const rnd = (n: number) => (seed = (seed * 1103515245 + 12345) % 2147483648) % n;
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 3 : 5);
+    if (k === 0) return rnd(3);
+    if (k === 1) return "s" + rnd(3);
+    if (k === 2) return null;
+    if (k === 3) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let n = 0; n < 2000; n++) check(gen(0), gen(0));
+});
