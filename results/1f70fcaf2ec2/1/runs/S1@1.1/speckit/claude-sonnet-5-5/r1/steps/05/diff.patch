+import { deepEqual, isObject } from "./patch.ts";
+
+type Operation = { op: "add" | "replace"; path: string; value: unknown } | { op: "remove"; path: string };
+
+const escapeToken = (token: string): string => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: Operation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && deepEqual(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && deepEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const a = from.slice(start, endFrom);
+  const b = to.slice(start, endTo);
+
+  // longest common subsequence of the differing middle part
+  const lcs: number[][] = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lcs[i][j] = deepEqual(a[i], b[j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  let index = start; // position in the array as it stands after the operations emitted so far
+  const flush = (removed: unknown[], added: unknown[]): void => {
+    const paired = Math.min(removed.length, added.length);
+    for (let k = 0; k < paired; k++) diffValues(removed[k], added[k], `${path}/${index + k}`, ops);
+    for (let k = paired; k < removed.length; k++) ops.push({ op: "remove", path: `${path}/${index + paired}` });
+    for (let k = paired; k < added.length; k++) {
+      ops.push({ op: "add", path: `${path}/${index + k}`, value: structuredClone(added[k]) });
+    }
+    index += added.length;
+  };
+
+  let i = 0;
+  let j = 0;
+  let removed: unknown[] = [];
+  let added: unknown[] = [];
+  while (i < a.length || j < b.length) {
+    if (i < a.length && j < b.length && deepEqual(a[i], b[j]) && lcs[i][j] === lcs[i + 1][j + 1] + 1) {
+      flush(removed, added);
+      removed = [];
+      added = [];
+      index++;
+      i++;
+      j++;
+    } else if (j < b.length && (i === a.length || lcs[i][j + 1] >= lcs[i + 1][j])) {
+      added.push(b[j++]);
+    } else {
+      removed.push(a[i++]);
+    }
+  }
+  flush(removed, added);
+}
+
+function diffValues(from: unknown, to: unknown, path: string, ops: Operation[]): void {
+  if (deepEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(from, key)) diffValues(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: structuredClone(to[key]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only what changed.
+ * Neither argument is modified.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const ops: Operation[] = [];
+  diffValues(from, to, "", ops);
+  return ops;
+}
