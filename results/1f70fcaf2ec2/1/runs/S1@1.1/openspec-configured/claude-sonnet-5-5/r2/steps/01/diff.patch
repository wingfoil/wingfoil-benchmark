@@ -0,0 +1,56 @@
+/** Error thrown when a JSON Pointer is invalid (RFC 6901 §3) or does not resolve (RFC 6901 §4). */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function decodeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new JsonPointerError(`Invalid escape in reference token "${token}"`);
+  }
+  // ~1 before ~0, so that "~01" decodes to "~1" (RFC 6901 §4)
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ * Returns the referenced value itself (not a copy); the document is never mutated.
+ * Throws JsonPointerError if the pointer is invalid or refers to no value.
+ * The URI fragment form (RFC 6901 §6) must be percent-decoded by the caller.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("Pointer must be a string");
+  }
+  if (pointer === "") return document;
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Pointer must be empty or start with "/": "${pointer}"`);
+  }
+
+  let current = document;
+  for (const raw of pointer.slice(1).split("/")) {
+    const token = decodeToken(raw);
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token)) {
+        throw new JsonPointerError(`"${token}" is not a valid array index`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new JsonPointerError(`Array index ${token} is out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new JsonPointerError(`No member "${token}" in object`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Cannot apply token "${token}" to a non-container value`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..69d6242a2af85d93e54a70ba2405da0471b364ef
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,105 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer, JsonPointerError } from "../src/index.ts";
+
+const ok = (doc: unknown, p: string, expected: unknown) =>
+  assert.deepEqual(resolvePointer(doc, p), expected);
+const bad = (doc: unknown, p: unknown) =>
+  assert.throws(() => resolvePointer(doc, p as string), JsonPointerError);
+
+test("empty pointer returns whole document", () => {
+  const doc = { a: 1 };
+  assert.equal(resolvePointer(doc, ""), doc);
+  for (const v of [null, 5, "x"]) ok(v, "", v);
+});
+
+test("syntax", () => {
+  bad({ a: 1 }, "a");
+  bad({ a: { b: 1 } }, "a/b");
+  ok({ "": 1 }, "/", 1);
+  ok({ "": { "": 2 } }, "//", 2);
+  for (const p of [undefined, null, 1, {}]) bad({}, p);
+});
+
+test("escaping", () => {
+  ok({ "a/b": 1, "m~n": 2 }, "/a~1b", 1);
+  ok({ "a/b": 1, "m~n": 2 }, "/m~0n", 2);
+  const d = { "~1": "x", "/": "y" };
+  ok(d, "/~01", "x");
+  ok(d, "/~1", "y");
+  for (const p of ["/a~", "/a~2", "/~x"]) bad({}, p);
+});
+
+test("object lookup", () => {
+  const d = { a: { b: 0 }, c: null, d: false, e: "" };
+  ok(d, "/a/b", 0);
+  ok(d, "/c", null);
+  ok(d, "/d", false);
+  ok(d, "/e", "");
+  bad({ a: 1 }, "/x");
+  for (const p of ["/toString", "/constructor", "/__proto__"]) bad({}, p);
+  ok({ "0": "x" }, "/0", "x");
+});
+
+test("hostile __proto__ key", () => {
+  const d = JSON.parse('{"__proto__":{"x":1}}');
+  ok(d, "/__proto__/x", 1);
+  assert.equal(({} as any).x, undefined);
+});
+
+test("duplicate member names", () => {
+  const d = JSON.parse('{"a":1,"a":2}');
+  ok(d, "/a", d.a);
+});
+
+test("array lookup", () => {
+  const d = ["a", "b"];
+  ok(d, "/0", "a");
+  ok(d, "/1", "b");
+  bad(d, "/2");
+  for (const p of ["/01", "/-1", "/+1", "/1.0", "/1e0", "/ 1", "/a", "/-", "/length", "/99999999999999999999"]) {
+    bad(d, p);
+  }
+});
+
+test("scalars have no children", () => {
+  bad({ a: 1 }, "/a/b");
+  bad({ a: "str" }, "/a/0");
+  bad({ a: null }, "/a/b");
+});
+
+test("errors are JsonPointerError and Error", () => {
+  try {
+    resolvePointer({}, "/x");
+    assert.fail();
+  } catch (e) {
+    assert.ok(e instanceof JsonPointerError && e instanceof Error);
+  }
+});
+
+test("document is not mutated", () => {
+  const d = { a: [1, { b: 2 }], "~": 3 };
+  const copy = structuredClone(d);
+  resolvePointer(d, "/a/1/b");
+  bad(d, "/a/5");
+  assert.deepEqual(d, copy);
+});
+
+test("RFC 6901 §5 example", () => {
+  const doc = {
+    foo: ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4,
+    "i\\j": 5, 'k"l': 6, " ": 7, "m~n": 8,
+  };
+  ok(doc, "", doc);
+  ok(doc, "/foo", ["bar", "baz"]);
+  ok(doc, "/foo/0", "bar");
+  ok(doc, "/", 0);
+  ok(doc, "/a~1b", 1);
+  ok(doc, "/c%d", 2);
+  ok(doc, "/e^f", 3);
+  ok(doc, "/g|h", 4);
+  ok(doc, "/i\\j", 5);
+  ok(doc, '/k"l', 6);
+  ok(doc, "/ ", 7);
+  ok(doc, "/m~0n", 8);
+});
