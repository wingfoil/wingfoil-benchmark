+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, JsonPatchError } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) =>
+  assert.deepEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) =>
+  assert.throws(() => applyPatch(doc, patch), JsonPatchError);
+
+test("structure", () => {
+  ok({ a: 1 }, [], { a: 1 });
+  for (const p of [{}, null, "x", 1]) bad({}, p);
+  for (const op of [null, [], "x", {}, { op: "Add", path: "", value: 1 }, { op: "add", value: 1 },
+    { op: "add", path: 1, value: 1 }, { op: "add", path: "" }, { op: "move", path: "/a" },
+    { op: "copy", path: "/a", from: 1 }, { op: "add", path: "a", value: 1 },
+    { op: "add", path: "/a~2", value: 1 }]) bad({}, [op]);
+  ok({}, [{ op: "add", path: "/a", value: null }], { a: null });
+  ok({ a: 1 }, [{ op: "remove", path: "/a", comment: "x" }], {});
+  bad({ a: 1 }, [{ op: "remove", path: "/a" }, { op: "remove", path: "/a" }]);
+});
+
+test("no mutation or aliasing", () => {
+  const doc = { a: { b: [1, 2] }, c: 1 };
+  const snap = structuredClone(doc);
+  const value = { x: 1 };
+  const patch = [{ op: "add", path: "/d", value }, { op: "copy", from: "/d", path: "/e" },
+    { op: "move", from: "/c", path: "/f" }, { op: "replace", path: "/a/b/0", value: 9 },
+    { op: "remove", path: "/a/b/1" }];
+  const res = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, snap);
+  res.d.x = 2;
+  assert.equal(value.x, 1);
+  assert.equal(res.e.x, 1);
+  assert.notEqual(res.d, res.e);
+});
+
+test("add", () => {
+  ok({ a: 1 }, [{ op: "add", path: "/b", value: 2 }], { a: 1, b: 2 });
+  ok({ a: 1 }, [{ op: "add", path: "/a", value: 9 }], { a: 9 });
+  const add = (p: string) => applyPatch(["a", "b"], [{ op: "add", path: p, value: "x" }]);
+  assert.deepEqual(add("/1"), ["a", "x", "b"]);
+  assert.deepEqual(add("/0"), ["x", "a", "b"]);
+  assert.deepEqual(add("/2"), ["a", "b", "x"]);
+  assert.deepEqual(add("/-"), ["a", "b", "x"]);
+  for (const p of ["/3", "/01", "/-1", "/+1", "/1.0", "/a"]) assert.throws(() => add(p), JsonPatchError);
+  ok({ z: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  bad({}, [{ op: "add", path: "/a/b", value: 1 }]);
+  bad({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]);
+  bad({ a: null }, [{ op: "add", path: "/a/b", value: 1 }]);
+  ok({}, [{ op: "add", path: "/", value: 1 }, { op: "add", path: "/a~1b", value: 2 },
+    { op: "add", path: "/m~0n", value: 3 }], { "": 1, "a/b": 2, "m~n": 3 });
+});
+
+test("hostile key", () => {
+  const res = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as any;
+  assert.ok(Object.hasOwn(res, "__proto__"));
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(res), Object.prototype);
+  const parsed = JSON.parse('{"__proto__":{"p":1}}');
+  const r2 = applyPatch(parsed, []) as any;
+  assert.ok(Object.hasOwn(r2, "__proto__"));
+});
+
+test("remove and replace", () => {
+  ok({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }], { b: 2 });
+  ok(["a", "b", "c"], [{ op: "remove", path: "/1" }], ["a", "c"]);
+  for (const p of ["/x", "/3", "/-", "/toString", ""]) bad(["a", "b", "c"].length ? { a: [1, 2, 3] } : {}, [{ op: "remove", path: p === "" ? "" : "/a" + p }]);
+  bad({}, [{ op: "remove", path: "/toString" }]);
+  ok({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }], { a: 2 });
+  ok(["a", "b", "c"], [{ op: "replace", path: "/1", value: "x" }], ["a", "x", "c"]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad([1], [{ op: "replace", path: "/1", value: 1 }]);
+  bad([1], [{ op: "replace", path: "/-", value: 1 }]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: null }], null);
+});
+
+test("move and copy", () => {
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/b" }], { b: 1 });
+  ok(["a", "b", "c"], [{ op: "move", from: "/0", path: "/2" }], ["b", "c", "a"]);
+  ok(["a", "b", "c"], [{ op: "move", from: "/2", path: "/0" }], ["c", "a", "b"]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  bad({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/ab" }], { ab: 1 });
+  bad({}, [{ op: "move", from: "/a", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "move", from: "", path: "/a" }]);
+  ok({ a: { x: [1] } }, [{ op: "copy", from: "/a", path: "/b" }], { a: { x: [1] }, b: { x: [1] } });
+  ok(["a", "b"], [{ op: "copy", from: "/0", path: "/-" }], ["a", "b", "a"]);
+  bad({}, [{ op: "copy", from: "/a", path: "/b" }]);
+});
+
+test("test op", () => {
+  const t = (doc: unknown, path: string, value: unknown) => applyPatch(doc, [{ op: "test", path, value }]);
+  assert.deepEqual(t({ a: [1, { b: 2, c: 3 }] }, "/a", [1, { c: 3, b: 2 }]), { a: [1, { b: 2, c: 3 }] });
+  assert.doesNotThrow(() => t({ a: 1 }, "/a", 1.0));
+  assert.doesNotThrow(() => t({ a: null }, "/a", null));
+  assert.doesNotThrow(() => t([1], "", [1]));
+  for (const [d, v] of [[1, "1"], [null, 0], [0, false], [[], {}], [{}, []], [[1, 2], [2, 1]], [[1], [1, 2]],
+    [{ a: 1 }, { b: 1 }], [{ a: 1 }, { a: 2 }], [{ a: 1 }, { a: 1, b: 2 }]] as [unknown, unknown][]) {
+    assert.throws(() => t({ k: d }, "/k", v), JsonPatchError);
+  }
+  bad({}, [{ op: "test", path: "/a", value: null }]);
+  bad({}, [{ op: "test", path: "", value: 1 }, { op: "add", path: "/a", value: 1 }]);
+});
+
+test("RFC 6902 Appendix A", () => {
+  const a = (d: unknown, p: unknown[], e: unknown) => ok(d, p, e);
+  a({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  a({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  a({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  a({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  a({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  a({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+  a({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }],
+    { foo: ["all", "cows", "eat", "grass"] });
+  a({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }],
+    { baz: "qux", foo: ["a", 2, "c"] });
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  a({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  a({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  bad({ foo: "bar", baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }].slice(0, 1));
+  a({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 });
+  bad({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]);
+  a({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] });
+});
