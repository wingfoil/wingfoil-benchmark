index 4521c85d683fe26846a87f9fcf6f250192295630..55fb7f0d75fd264932aaef72e388c15353759641 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -54,3 +54,200 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+/** Error thrown for an invalid JSON Patch (RFC 6902 §3) or a failed operation (RFC 6902 §5). */
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Json = unknown;
+type Container = Json[] | Record<string, Json>;
+
+function setMember(obj: object, key: string, value: Json): void {
+  // defineProperty so an own "__proto__" member is created instead of invoking the setter
+  Object.defineProperty(obj, key, { value, enumerable: true, writable: true, configurable: true });
+}
+
+/** Prototype-safe deep clone of a JSON value. */
+function clone(value: Json): Json {
+  if (Array.isArray(value)) return value.map(clone);
+  if (typeof value === "object" && value !== null) {
+    const out = {};
+    for (const key of Object.keys(value)) setMember(out, key, clone((value as Record<string, Json>)[key]));
+    return out;
+  }
+  return value;
+}
+
+/** JSON equality per RFC 6902 §4.6. */
+function jsonEqual(a: Json, b: Json): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (typeof a === "object" && a !== null) {
+    if (typeof b !== "object" || b === null || Array.isArray(b)) return false;
+    const ka = Object.keys(a);
+    if (ka.length !== Object.keys(b).length) return false;
+    return ka.every(
+      (k) =>
+        Object.hasOwn(b, k) &&
+        jsonEqual((a as Record<string, Json>)[k], (b as Record<string, Json>)[k]),
+    );
+  }
+  return a === b;
+}
+
+/** Splits a JSON Pointer (RFC 6901 §3-§4) into decoded reference tokens. */
+function tokenize(pointer: string): string[] {
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") throw new JsonPatchError(`Invalid JSON Pointer "${pointer}"`);
+  try {
+    return pointer.slice(1).split("/").map(decodeToken);
+  } catch {
+    throw new JsonPatchError(`Invalid JSON Pointer "${pointer}"`);
+  }
+}
+
+function isContainer(v: Json): v is Container {
+  return typeof v === "object" && v !== null;
+}
+
+/** Walks to the parent of the location named by `tokens` (which must be non-empty). */
+function parentOf(doc: Json, tokens: string[]): Container {
+  let current = doc;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new JsonPatchError(`Path does not exist at "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (isContainer(current) && Object.hasOwn(current, token)) {
+      current = (current as Record<string, Json>)[token];
+    } else {
+      throw new JsonPatchError(`Path does not exist at "${token}"`);
+    }
+  }
+  if (!isContainer(current)) throw new JsonPatchError("Parent of target is not a container");
+  return current;
+}
+
+function exists(doc: Json, tokens: string[]): boolean {
+  if (tokens.length === 0) return true;
+  const parent = parentOf(doc, tokens);
+  const last = tokens[tokens.length - 1];
+  return Array.isArray(parent)
+    ? ARRAY_INDEX.test(last) && Number(last) < parent.length
+    : Object.hasOwn(parent, last);
+}
+
+function getAt(doc: Json, tokens: string[]): Json {
+  if (!exists(doc, tokens)) throw new JsonPatchError("Target location does not exist");
+  if (tokens.length === 0) return doc;
+  const parent = parentOf(doc, tokens);
+  const last = tokens[tokens.length - 1];
+  return Array.isArray(parent) ? parent[Number(last)] : (parent as Record<string, Json>)[last];
+}
+
+function addAt(doc: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(doc, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (last === "-") parent.push(value);
+    else if (ARRAY_INDEX.test(last) && Number(last) <= parent.length) {
+      parent.splice(Number(last), 0, value);
+    } else throw new JsonPatchError(`Invalid array index "${last}"`);
+  } else {
+    setMember(parent, last, value);
+  }
+  return doc;
+}
+
+function removeAt(doc: Json, tokens: string[]): Json {
+  if (tokens.length === 0) throw new JsonPatchError("Cannot remove the whole document");
+  if (!exists(doc, tokens)) throw new JsonPatchError("Target location does not exist");
+  const parent = parentOf(doc, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete (parent as Record<string, Json>)[last];
+  return doc;
+}
+
+const OPS = ["add", "remove", "replace", "move", "copy", "test"];
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a document and returns the result as a new value.
+ * Neither argument is mutated and the result shares no structure with them.
+ * Throws JsonPatchError if the patch is invalid or any operation fails (RFC 6902 §5).
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchError("Patch must be an array");
+  for (const [i, op] of patch.entries()) {
+    if (typeof op !== "object" || op === null || Array.isArray(op)) {
+      throw new JsonPatchError(`Operation ${i} must be an object`);
+    }
+    const o = op as Record<string, unknown>;
+    if (typeof o.op !== "string" || !OPS.includes(o.op)) {
+      throw new JsonPatchError(`Operation ${i} has an invalid "op"`);
+    }
+    if (typeof o.path !== "string") throw new JsonPatchError(`Operation ${i} needs a string "path"`);
+    if (["add", "replace", "test"].includes(o.op) && o.value === undefined) {
+      throw new JsonPatchError(`Operation ${i} needs a "value"`);
+    }
+    if (["move", "copy"].includes(o.op) && typeof o.from !== "string") {
+      throw new JsonPatchError(`Operation ${i} needs a string "from"`);
+    }
+  }
+
+  let doc = clone(document);
+  patch.forEach((raw, i) => {
+    const o = raw as Record<string, unknown>;
+    try {
+      const path = tokenize(o.path as string);
+      switch (o.op) {
+        case "add":
+          doc = addAt(doc, path, clone(o.value));
+          break;
+        case "remove":
+          doc = removeAt(doc, path);
+          break;
+        case "replace":
+          if (!exists(doc, path)) throw new JsonPatchError("Target location does not exist");
+          if (path.length === 0) doc = clone(o.value);
+          else {
+            const parent = parentOf(doc, path);
+            const last = path[path.length - 1];
+            if (Array.isArray(parent)) parent[Number(last)] = clone(o.value);
+            else setMember(parent, last, clone(o.value));
+          }
+          break;
+        case "move": {
+          const from = tokenize(o.from as string);
+          if (!exists(doc, from)) throw new JsonPatchError("Location 'from' does not exist");
+          const same = from.length === path.length && from.every((t, k) => t === path[k]);
+          if (same) break;
+          if (from.length < path.length && from.every((t, k) => t === path[k])) {
+            throw new JsonPatchError("Cannot move a location into one of its children");
+          }
+          const value = getAt(doc, from);
+          doc = removeAt(doc, from);
+          doc = addAt(doc, path, value);
+          break;
+        }
+        case "copy":
+          doc = addAt(doc, path, clone(getAt(doc, tokenize(o.from as string))));
+          break;
+        case "test":
+          if (!jsonEqual(getAt(doc, path), o.value)) throw new JsonPatchError("Test failed");
+          break;
+      }
+    } catch (e) {
+      if (e instanceof JsonPatchError) throw new JsonPatchError(`Operation ${i} (${o.op}): ${e.message}`);
+      throw e;
+    }
+  });
+  return doc;
+}
