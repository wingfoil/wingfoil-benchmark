index 63f1b9eb1f5dcb8e5df497a19e158a5e965fc962..1566a57605a756a6a142689e12922edd385ef14f 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -275,3 +275,111 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+type PatchOp = { op: string; path: string; value?: Json };
+
+/** Escapes a member name or index as a JSON Pointer reference token (RFC 6901 §3). */
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffValues(from: Json, to: Json, path: string, ops: PatchOp[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) diffArrays(from, to, path, ops);
+  else if (isObject(from) && isObject(to)) diffObjects(from, to, path, ops);
+  else ops.push({ op: "replace", path, value: clone(to) });
+}
+
+/** Diffs two items that replace each other in an array; unrelated containers are simply replaced. */
+function diffPaired(from: Json, to: Json, path: string, ops: PatchOp[]): void {
+  const nested: PatchOp[] = [];
+  diffValues(from, to, path, nested);
+  const replace: PatchOp = { op: "replace", path, value: to };
+  if (JSON.stringify(nested).length < JSON.stringify([replace]).length) ops.push(...nested);
+  else ops.push({ op: "replace", path, value: clone(to) });
+}
+
+function diffObjects(
+  from: Record<string, Json>,
+  to: Record<string, Json>,
+  path: string,
+  ops: PatchOp[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+  }
+  for (const key of Object.keys(to)) {
+    const child = `${path}/${encodeToken(key)}`;
+    if (Object.hasOwn(from, key)) diffValues(from[key], to[key], child, ops);
+    else ops.push({ op: "add", path: child, value: clone(to[key]) });
+  }
+}
+
+function diffArrays(from: Json[], to: Json[], path: string, ops: PatchOp[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && jsonEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+
+  // longest common subsequence of the differing middle; lcs[i][j] is for from[i..], to[j..]
+  const n = endFrom - start;
+  const m = endTo - start;
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(from[start + i], to[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  // `at` is the index in the array as it stands after the operations emitted so far
+  let at = start;
+  const flushGap = (removed: number[], added: number[]): void => {
+    const paired = Math.min(removed.length, added.length);
+    for (let k = 0; k < paired; k++) {
+      diffPaired(from[removed[k]], to[added[k]], `${path}/${at + k}`, ops);
+    }
+    for (let k = paired; k < removed.length; k++) ops.push({ op: "remove", path: `${path}/${at + paired}` });
+    for (let k = paired; k < added.length; k++) {
+      ops.push({ op: "add", path: `${path}/${at + k}`, value: clone(to[added[k]]) });
+    }
+    at += added.length;
+  };
+
+  let i = 0;
+  let j = 0;
+  let removed: number[] = [];
+  let added: number[] = [];
+  while (i < n || j < m) {
+    if (i < n && j < m && jsonEqual(from[start + i], to[start + j]) && lcs[i][j] === lcs[i + 1][j + 1] + 1) {
+      flushGap(removed, added);
+      removed = [];
+      added = [];
+      at++;
+      i++;
+      j++;
+    } else if (i < n && (j === m || lcs[i + 1][j] >= lcs[i][j + 1])) {
+      removed.push(start + i++);
+    } else {
+      added.push(start + j++);
+    }
+  }
+  flushGap(removed, added);
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied.
+ * Only what differs is described: unchanged members and array items are not mentioned, an array
+ * insertion or removal is a single `add` or `remove`, and a moved item is a `remove` plus an `add`.
+ * Neither argument is mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  const ops: PatchOp[] = [];
+  diffValues(from, to, "", ops);
+  return ops;
+}
