index 0000000000000000000000000000000000000000..b3d1d0e7b47be026b86fcb68b2907f923fb1e625
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,133 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const rt = (from: unknown, to: unknown) => {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+};
+
+test("identical documents", () => {
+  assert.deepEqual(rt({ a: 1, b: [1, { c: null }] }, { b: [1, { c: null }], a: 1 }), []);
+  for (const v of [1, "x", null, true, [], {}]) assert.deepEqual(rt(v, structuredClone(v)), []);
+});
+
+test("small change is one replace", () => {
+  const from = { a: { b: [1, 2, { c: 1, d: "keep" }] }, e: "x" };
+  const to = structuredClone(from);
+  (to.a.b[2] as any).c = 2;
+  assert.deepEqual(rt(from, to), [{ op: "replace", path: "/a/b/2/c", value: 2 }]);
+});
+
+test("object members added and removed", () => {
+  assert.deepEqual(rt({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("type change and root replacement", () => {
+  assert.deepEqual(rt({ a: {} }, { a: [] }), [{ op: "replace", path: "/a", value: [] }]);
+  assert.deepEqual(rt({ a: null }, { a: 1 }), [{ op: "replace", path: "/a", value: 1 }]);
+  assert.deepEqual(rt({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(rt(1, { a: 1 }), [{ op: "replace", path: "", value: { a: 1 } }]);
+});
+
+test("null and falsy values", () => {
+  assert.deepEqual(rt({}, { a: null }), [{ op: "add", path: "/a", value: null }]);
+  assert.deepEqual(rt({ a: null }, {}), [{ op: "remove", path: "/a" }]);
+  for (const x of [null, false, 0, ""]) for (const y of [null, false, 0, ""]) rt({ a: x }, { a: y });
+});
+
+test("escaping and hostile keys", () => {
+  const keys = ["a/b", "a~b", "~1", "", "__proto__"];
+  for (const k of keys) {
+    const to = {};
+    Object.defineProperty(to, k, { value: { x: 1 }, enumerable: true, configurable: true, writable: true });
+    const patch = rt({}, to) as any[];
+    assert.equal(patch.length, 1);
+    const res = applyPatch(to, createPatch(to, {})) as any;
+    assert.deepEqual(Object.keys(res), []);
+    assert.equal(({} as any).x, undefined);
+  }
+  assert.deepEqual(rt({ "a/b": 1 }, { "a/b": 2 }), [{ op: "replace", path: "/a~1b", value: 2 }]);
+  assert.deepEqual(rt({ "a~b": 1 }, { "a~b": 2 }), [{ op: "replace", path: "/a~0b", value: 2 }]);
+});
+
+test("array insert and remove", () => {
+  const base = [{ id: 1 }, { id: 2 }, { id: 3 }];
+  assert.deepEqual(rt(base, [{ id: 0 }, ...base]), [{ op: "add", path: "/0", value: { id: 0 } }]);
+  assert.deepEqual(rt(base, [base[0], { id: 9 }, base[1], base[2]]), [{ op: "add", path: "/1", value: { id: 9 } }]);
+  assert.deepEqual(rt(base, [...base, { id: 4 }]), [{ op: "add", path: "/3", value: { id: 4 } }]);
+  assert.deepEqual(rt(base, base.slice(1)), [{ op: "remove", path: "/0" }]);
+  assert.deepEqual(rt(base, [base[0], base[2]]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(rt(base, base.slice(0, 2)), [{ op: "remove", path: "/2" }]);
+});
+
+test("array item moved", () => {
+  const from = [1, 2, 3, 4, 5, 6];
+  for (const to of [[2, 3, 4, 5, 6, 1], [6, 1, 2, 3, 4, 5], [1, 5, 2, 3, 4, 6]]) {
+    const patch = rt(from, to) as any[];
+    assert.ok(patch.length <= 2);
+    assert.ok(patch.every((o: any) => o.op === "add" || o.op === "remove" || o.op === "move"));
+  }
+});
+
+test("array item changed in place", () => {
+  assert.deepEqual(rt([{ a: 1, b: 2 }, 5], [{ a: 1, b: 3 }, 5]), [{ op: "replace", path: "/0/b", value: 3 }]);
+  assert.deepEqual(rt([1, 2, 3], [1, 9, 3]), [{ op: "replace", path: "/1", value: 9 }]);
+});
+
+test("duplicates and differing lengths", () => {
+  rt([1, 1, 1], [1, 1]);
+  rt([1, 1], [1, 1, 1, 1]);
+  rt([1, 2, 1, 2, 1], [2, 1, 2]);
+  assert.equal(rt([0, 0, 0, 0], [0, 0, 0]).length, 1);
+});
+
+test("no mutation and no aliasing", () => {
+  const from = { a: [1, { x: 1 }], b: 1 };
+  const to = { a: [1, { x: 1 }, { y: { z: 1 } }], c: { d: [1] } };
+  const f = structuredClone(from);
+  const t = structuredClone(to);
+  const patch = createPatch(from, to) as any[];
+  assert.deepEqual(from, f);
+  assert.deepEqual(to, t);
+  for (const op of patch) if (op.value && typeof op.value === "object") {
+    op.value.mutated = true;
+  }
+  assert.deepEqual(to, t);
+});
+
+test("randomized round trip", () => {
+  let seed = 12345;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff), seed % n);
+  const gen = (depth: number): unknown => {
+    const k = rnd(depth > 2 ? 4 : 6);
+    if (k === 0) return rnd(3);
+    if (k === 1) return ["a", "b/", "~"][rnd(3)];
+    if (k === 2) return null;
+    if (k === 3) return rnd(2) === 0;
