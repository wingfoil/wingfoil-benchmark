index 55fb7f0d75fd264932aaef72e388c15353759641..63f1b9eb1f5dcb8e5df497a19e158a5e965fc962 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -251,3 +251,27 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   });
   return doc;
 }
+
+function isObject(value: Json): value is Record<string, Json> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7396 §2) to a JSON document and returns the merged document.
+ * A non-object patch replaces the target; `null` members of an object patch remove members.
+ * Neither argument is mutated and the result shares no references with them.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch);
+  const result = (isObject(target) ? clone(target) : {}) as Record<string, Json>;
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = Object.hasOwn(result, key) ? result[key] : undefined;
+      setMember(result, key, applyMergePatch(current, value));
+    }
+  }
+  return result;
+}
