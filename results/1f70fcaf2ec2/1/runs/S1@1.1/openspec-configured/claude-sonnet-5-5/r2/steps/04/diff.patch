@@ -0,0 +1,68 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+const ok = (target: unknown, patch: unknown, expected: unknown) =>
+  assert.deepEqual(applyMergePatch(target, patch), expected);
+
+test("RFC 7396 §3 examples", () => {
+  ok({ a: "b" }, { a: "c" }, { a: "c" });
+  ok({ a: "b" }, { b: "c" }, { a: "b", b: "c" });
+  ok({ a: "b" }, { a: null }, {});
+  ok({ a: "b", b: "c" }, { a: null }, { b: "c" });
+  ok({ a: ["b"] }, { a: "c" }, { a: "c" });
+  ok({ a: "c" }, { a: ["b"] }, { a: ["b"] });
+  ok({ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } });
+  ok({ a: [{ b: "c" }] }, { a: [1] }, { a: [1] });
+  ok(["a", "b"], ["c", "d"], ["c", "d"]);
+  ok({ a: "b" }, ["c"], ["c"]);
+  ok({ a: "foo" }, null, null);
+  ok({ a: "foo" }, "bar", "bar");
+  ok({ e: null }, { a: 1 }, { e: null, a: 1 });
+  ok([1, 2], { a: "b", c: null }, { a: "b" });
+  ok({}, { a: { bb: { ccc: null } } }, { a: { bb: {} } });
+});
+
+test("edge cases", () => {
+  ok({ a: 1 }, { b: null }, { a: 1 });
+  ok({ a: 1 }, { a: [1, null] }, { a: [1, null] });
+  for (const p of [1, true, "x", null, [1]]) ok({ a: 1 }, p, p);
+  for (const t of [["a"], "s", 1, true, null]) ok(t, { a: "b" }, { a: "b" });
+  ok({ a: 1 }, { a: { b: null, c: 2 } }, { a: { c: 2 } });
+  ok({ a: 1 }, {}, { a: 1 });
+  ok([1], {}, {});
+});
+
+test("no mutation or aliasing", () => {
+  const target = { a: { b: [1] }, c: 1 };
+  const patch = { a: { d: { e: 1 } }, c: null, f: [{ g: 1 }] };
+  const ts = structuredClone(target);
+  const ps = structuredClone(patch);
+  const res = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, ts);
+  assert.deepEqual(patch, ps);
+  res.a.b.push(2);
+  res.a.d.e = 2;
+  res.f[0].g = 2;
+  assert.deepEqual(target, ts);
+  assert.deepEqual(patch, ps);
+  const arr = [{ x: 1 }];
+  (applyMergePatch({}, arr) as any)[0].x = 2;
+  assert.equal(arr[0].x, 1);
+});
+
+test("hostile keys", () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true},"constructor":{"prototype":{"p":1}}}');
+  const res = applyMergePatch({}, patch) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(({} as any).p, undefined);
+  assert.equal(Object.getPrototypeOf(res), Object.prototype);
+  assert.deepEqual(Object.getOwnPropertyDescriptor(res, "__proto__")?.value, { polluted: true });
+  const target = JSON.parse('{"__proto__":{"x":1}}');
+  const removed = applyMergePatch(target, JSON.parse('{"__proto__":null}')) as any;
+  assert.equal(Object.hasOwn(removed, "__proto__"), false);
+  const merged = applyMergePatch(target, JSON.parse('{"__proto__":{"y":2}}')) as any;
+  assert.deepEqual(Object.getOwnPropertyDescriptor(merged, "__proto__")?.value, { x: 1, y: 2 });
+  // inherited members are not treated as present
+  assert.equal(Object.hasOwn(applyMergePatch({}, JSON.parse('{"toString":null}')) as object, "toString"), false);
+});
