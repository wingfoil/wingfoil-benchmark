+
+/** Thrown when a JSON Patch is invalid (RFC 6902 §3, §4) or one of its operations fails (RFC 6902 §5). */
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Container = unknown[] | Record<string, unknown>;
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setMember(target: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty keeps "__proto__" an ordinary own member instead of reaching the prototype.
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function cloneJson(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(cloneJson);
+  if (isObject(value)) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(copy, key, cloneJson(value[key]));
+    return copy;
+  }
+  return value;
+}
+
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((k) => Object.hasOwn(b, k) && jsonEqual(a[k], b[k]))
+    );
+  }
+  return a === b;
+}
+
+function tokensOf(pointer: unknown, member: string): string[] {
+  if (typeof pointer !== "string") throw new JsonPatchError(`'${member}' must be a string`);
+  try {
+    return parsePointer(pointer);
+  } catch (e) {
+    throw new JsonPatchError(`Invalid '${member}': ${(e as Error).message}`);
+  }
+}
+
+/** Walks to the container holding the last token's target; every step must exist. */
+function parentOf(document: unknown, tokens: string[]): Container {
+  let current = document;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new JsonPatchError(`No array element for token '${token}'`);
+      }
+      current = current[Number(token)];
+    } else if (isObject(current)) {
+      if (!Object.hasOwn(current, token)) throw new JsonPatchError(`No member for token '${token}'`);
+      current = current[token];
+    } else {
+      throw new JsonPatchError(`Cannot apply token '${token}' to a non-container value`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new JsonPatchError("Target parent is not an object or array");
+  }
+  return current;
+}
+
+function getAt(document: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) return document;
+  const parent = parentOf(document, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(key) || Number(key) >= parent.length) {
+      throw new JsonPatchError(`No array element for token '${key}'`);
+    }
+    return parent[Number(key)];
+  }
+  if (!Object.hasOwn(parent, key)) throw new JsonPatchError(`No member for token '${key}'`);
+  return parent[key];
+}
+
+function addAt(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(document, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (key === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(key) && Number(key) <= parent.length) {
+      parent.splice(Number(key), 0, value);
+    } else {
+      throw new JsonPatchError(`Invalid array index '${key}'`);
+    }
+  } else {
+    setMember(parent, key, value);
+  }
+  return document;
+}
+
+function removeAt(document: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) throw new JsonPatchError("Cannot remove the whole document");
+  getAt(document, tokens); // must exist
+  const parent = parentOf(document, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(key), 1);
+  else delete parent[key];
+  return document;
+}
+
+function replaceAt(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  getAt(document, tokens); // must exist
+  const parent = parentOf(document, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(key)] = value;
+  else setMember(parent, key, value);
+  return document;
+}
+
+function requireValue(op: Record<string, unknown>, name: string): unknown {
+  if (!Object.hasOwn(op, "value")) throw new JsonPatchError(`'${name}' operation requires 'value'`);
+  return op.value;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the result as a new value.
+ * Neither `document` nor `patch` is mutated. Throws JsonPatchError if the patch is invalid
+ * or any operation fails; in that case nothing is returned (RFC 6902 §5).
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchError("A JSON Patch must be an array");
+  let result = cloneJson(document);
+  for (const op of patch) {
+    if (!isObject(op)) throw new JsonPatchError("Each patch operation must be an object");
+    const name = op.op;
+    const path = tokensOf(op.path, "path");
+    switch (name) {
+      case "add":
+        result = addAt(result, path, cloneJson(requireValue(op, name)));
+        break;
+      case "remove":
+        result = removeAt(result, path);
+        break;
+      case "replace":
+        result = replaceAt(result, path, cloneJson(requireValue(op, name)));
+        break;
+      case "move": {
+        const from = tokensOf(op.from, "from");
+        const isPrefix = from.length < path.length && from.every((t, i) => t === path[i]);
+        if (isPrefix) throw new JsonPatchError("'from' must not be a proper prefix of 'path'");
+        const value = getAt(result, from);
+        if (from.length === path.length && from.every((t, i) => t === path[i])) break;
+        result = removeAt(result, from);
+        result = addAt(result, path, value);
+        break;
+      }
+      case "copy": {
+        const from = tokensOf(op.from, "from");
+        result = addAt(result, path, cloneJson(getAt(result, from)));
+        break;
+      }
+      case "test":
+        if (!jsonEqual(getAt(result, path), requireValue(op, name))) {
+          throw new JsonPatchError("Test operation failed: values differ");
+        }
+        break;
+      default:
+        throw new JsonPatchError(`Unknown operation: ${String(name)}`);
+    }
+  }
+  return result;
+}
