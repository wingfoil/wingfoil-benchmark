+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, JsonPatchError } from "../src/index.ts";
+
+const J = (s: string): unknown => JSON.parse(s);
+const ok = (doc: string, patch: string, expected: string) =>
+  assert.deepEqual(applyPatch(J(doc), J(patch)), J(expected));
+const bad = (doc: unknown, patch: unknown) =>
+  assert.throws(() => applyPatch(doc, patch), JsonPatchError);
+
+test("structure", () => {
+  ok('{"a":1}', "[]", '{"a":1}');
+  for (const p of [{}, null, "x", undefined, 1]) bad({}, p);
+  for (const o of [null, [], 1, "x"]) bad({}, [o]);
+  for (const o of [undefined, 1, "merge", "ADD"]) bad({}, [{ op: o, path: "" }]);
+  for (const p of [undefined, 1, "a", "/a~2"]) bad({}, [{ op: "add", path: p, value: 1 }]);
+  for (const op of ["add", "replace", "test"]) bad({ a: 1 }, [{ op, path: "/a" }]);
+  ok("{}", '[{"op":"add","path":"/a","value":null}]', '{"a":null}');
+  for (const op of ["move", "copy"]) {
+    bad({ a: 1 }, [{ op, path: "/b" }]);
+    bad({ a: 1 }, [{ op, path: "/b", from: "a" }]);
+    bad({ a: 1 }, [{ op, path: "/b", from: 1 }]);
+  }
+  ok('{"a":1}', '[{"op":"add","path":"/b","value":2,"comment":"x"}]', '{"a":1,"b":2}');
+});
+
+test("no mutation, atomicity, error type", () => {
+  const doc = J('{"a":{"b":[1,2]}}');
+  const patch = J('[{"op":"add","path":"/a/b/-","value":{"x":1}},{"op":"copy","from":"/a","path":"/c"}]');
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const res = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  res.a.b[2].x = 99;
+  res.c.b.push(5);
+  assert.deepEqual(patch, patchCopy);
+  assert.deepEqual(doc, docCopy);
+  bad(doc, [{ op: "add", path: "/a", value: 1 }, { op: "remove", path: "/missing" }]);
+  assert.deepEqual(doc, docCopy);
+  assert.ok(new JsonPatchError("x") instanceof Error);
+});
+
+test("add", () => {
+  ok('{"foo":"bar"}', '[{"op":"add","path":"/baz","value":"qux"}]', '{"foo":"bar","baz":"qux"}');
+  ok('{"foo":"bar"}', '[{"op":"add","path":"/foo","value":1}]', '{"foo":1}');
+  ok('{"foo":["bar","baz"]}', '[{"op":"add","path":"/foo/1","value":"qux"}]', '{"foo":["bar","qux","baz"]}');
+  ok('{"foo":["bar","baz"]}', '[{"op":"add","path":"/foo/-","value":"x"}]', '{"foo":["bar","baz","x"]}');
+  ok('{"foo":["bar","baz"]}', '[{"op":"add","path":"/foo/2","value":"x"}]', '{"foo":["bar","baz","x"]}');
+  for (const i of ["3", "-1", "01", "1.0", "x", "+1"]) {
+    bad({ foo: ["bar", "baz"] }, [{ op: "add", path: `/foo/${i}`, value: 1 }]);
+  }
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: 1 }]);
+  ok('{"a":1}', '[{"op":"add","path":"","value":[1]}]', "[1]");
+  for (const s of ["s", 1, true, null]) bad({ a: s }, [{ op: "add", path: "/a/b", value: 1 }]);
+});
+
+test("remove", () => {
+  ok('{"baz":"qux","foo":"bar"}', '[{"op":"remove","path":"/baz"}]', '{"foo":"bar"}');
+  ok('{"foo":["bar","qux","baz"]}', '[{"op":"remove","path":"/foo/1"}]', '{"foo":["bar","baz"]}');
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad({ a: [1] }, [{ op: "remove", path: "/a/1" }]);
+  bad({ a: [1] }, [{ op: "remove", path: "/a/-" }]);
+  bad({ a: 1 }, [{ op: "remove", path: "" }]);
+});
+
+test("replace", () => {
+  ok('{"baz":"qux","foo":"bar"}', '[{"op":"replace","path":"/baz","value":"boo"}]', '{"baz":"boo","foo":"bar"}');
+  ok('{"foo":["a","b"]}', '[{"op":"replace","path":"/foo/0","value":"x"}]', '{"foo":["x","b"]}');
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad({ a: [1] }, [{ op: "replace", path: "/a/1", value: 1 }]);
+  bad({ a: [1] }, [{ op: "replace", path: "/a/-", value: 1 }]);
+  ok("{}", '[{"op":"replace","path":"","value":5}]', "5");
+});
+
+test("move", () => {
+  ok(
+    '{"foo":{"bar":"baz","waldo":"fred"},"qux":{"corge":"grault"}}',
+    '[{"op":"move","from":"/foo/waldo","path":"/qux/thud"}]',
+    '{"foo":{"bar":"baz"},"qux":{"corge":"grault","thud":"fred"}}',
+  );
+  ok('{"foo":["all","grass","cows","eat"]}', '[{"op":"move","from":"/foo/1","path":"/foo/3"}]', '{"foo":["all","cows","eat","grass"]}');
+  bad({}, [{ op: "move", from: "/a", path: "/b" }]);
+  bad({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  ok('{"a":1}', '[{"op":"move","from":"/a","path":"/a"}]', '{"a":1}');
+  bad({}, [{ op: "move", from: "/a", path: "/a" }]);
+});
+
+test("copy", () => {
+  ok('{"foo":{"a":1}}', '[{"op":"copy","from":"/foo","path":"/bar"}]', '{"foo":{"a":1},"bar":{"a":1}}');
+  ok(
+    '{"foo":{"a":1}}',
+    '[{"op":"copy","from":"/foo","path":"/bar"},{"op":"add","path":"/bar/b","value":2}]',
+    '{"foo":{"a":1},"bar":{"a":1,"b":2}}',
+  );
+  bad({}, [{ op: "copy", from: "/a", path: "/b" }]);
+});
+
+test("test", () => {
+  ok('{"a":{"x":[1,2],"y":null}}', '[{"op":"test","path":"/a","value":{"y":null,"x":[1,2]}}]', '{"a":{"x":[1,2],"y":null}}');
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+  bad({ a: null }, [{ op: "test", path: "/a", value: 0 }]);
+  bad({ a: [] }, [{ op: "test", path: "/a", value: {} }]);
+  bad({ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]);
+  bad({ a: { x: 1 } }, [{ op: "test", path: "/a", value: { x: 1, y: 2 } }]);
+  bad({}, [{ op: "test", path: "/a", value: 1 }]);
+  ok('{"a":1}', '[{"op":"test","path":"","value":{"a":1}}]', '{"a":1}');
+  ok('{"a":1.0}', '[{"op":"test","path":"/a","value":1}]', '{"a":1}');
+});
+
+test("escaping and hostile keys", () => {
+  const r = applyPatch({}, [
+    { op: "add", path: "/a~1b", value: 1 },
+    { op: "add", path: "/m~0n", value: 2 },
+  ]) as Record<string, unknown>;
+  assert.deepEqual(Object.keys(r), ["a/b", "m~n"]);
+  bad({}, [{ op: "add", path: "/__proto__/polluted", value: true }]);
+  assert.equal(({} as any).polluted, undefined);
+  const p = applyPatch({}, J('[{"op":"add","path":"/__proto__","value":{"x":1}}]')) as any;
+  assert.ok(Object.hasOwn(p, "__proto__"));
+  assert.equal(({} as any).x, undefined);
+  assert.equal(Object.getPrototypeOf(p), Object.prototype);
+  const q = applyPatch(J('{"__proto__":{"y":1}}'), []) as any;
+  assert.ok(Object.hasOwn(q, "__proto__"));
+  assert.equal(q.y, undefined);
+  for (const k of ["toString", "constructor"]) {
+    for (const op of ["remove", "replace", "test"]) bad({}, [{ op, path: `/${k}`, value: 1 }]);
+    bad({}, [{ op: "move", from: `/${k}`, path: "/z" }]);
+  }
+});
