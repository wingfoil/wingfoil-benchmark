index a479a01373a56ebe155aeda08db9c7d22ee12864..3bb05991a6ae3edecdb0a1e2f6afab13ab8f031f 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -251,3 +251,157 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+type PatchOp = Record<string, unknown>;
+
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Pairs equal items of `a` and `b` along a longest common subsequence (RFC 6902 has no notion of identity). */
+function commonItems(a: unknown[], b: unknown[]): Map<number, number> {
+  const pairs = new Map<number, number>();
+  let start = 0;
+  while (start < a.length && start < b.length && jsonEqual(a[start], b[start])) {
+    pairs.set(start, start);
+    start++;
+  }
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && jsonEqual(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+    pairs.set(endA, endB);
+  }
+  const n = endA - start;
+  const m = endB - start;
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(a[start + i], b[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (jsonEqual(a[start + i], b[start + j])) {
+      pairs.set(start + i, start + j);
+      i++;
+      j++;
+    } else if (lcs[i + 1][j] >= lcs[i][j + 1]) i++;
+    else j++;
+  }
+  return pairs;
+}
+
+function diffArrays(a: unknown[], b: unknown[], base: string, ops: PatchOp[]): void {
+  const anchorOf = commonItems(a, b); // from index -> to index
+  const source: (number | undefined)[] = new Array(b.length).fill(undefined); // to index -> from index
+  const kind: ("anchor" | "move" | "edit" | "add")[] = new Array(b.length).fill("add");
+  for (const [i, j] of anchorOf) {
+    source[j] = i;
+    kind[j] = "anchor";
+  }
+  const used = new Set(anchorOf.keys());
+
+  // Unchanged items found elsewhere are moves.
+  for (let j = 0; j < b.length; j++) {
+    if (kind[j] !== "add") continue;
+    for (let i = 0; i < a.length; i++) {
+      if (!used.has(i) && jsonEqual(a[i], b[j])) {
+        used.add(i);
+        source[j] = i;
+        kind[j] = "move";
+        break;
+      }
+    }
+  }
+
+  // Items left over between the same two anchors are edited in place.
+  const anchorsBeforeFrom = (i: number) => [...anchorOf.keys()].filter((k) => k < i).length;
+  const anchorsBeforeTo = (j: number) => [...anchorOf.values()].filter((k) => k < j).length;
+  const gapFrom = new Map<number, number[]>();
+  for (let i = 0; i < a.length; i++) {
+    if (used.has(i)) continue;
+    const g = anchorsBeforeFrom(i);
+    gapFrom.set(g, [...(gapFrom.get(g) ?? []), i]);
+  }
+  for (let j = 0; j < b.length; j++) {
+    if (kind[j] !== "add") continue;
+    const candidates = gapFrom.get(anchorsBeforeTo(j));
+    const i = candidates?.shift();
+    if (i !== undefined) {
+      used.add(i);
+      source[j] = i;
+      kind[j] = "edit";
+    }
+  }
+
+  // 1. Remove what is gone, highest index first.
+  const current: (number | "new")[] = a.map((_, i) => i);
+  for (let i = a.length - 1; i >= 0; i--) {
+    if (used.has(i)) continue;
+    ops.push({ op: "remove", path: `${base}/${i}` });
+    current.splice(i, 1);
+  }
+
+  // 2. Move displaced items next to their predecessor in the target order; anchors never move.
+  let previous: number | undefined;
+  for (let j = 0; j < b.length; j++) {
+    const id = source[j];
+    if (id === undefined) continue;
+    if (kind[j] === "move") {
+      const from = current.indexOf(id);
+      current.splice(from, 1);
+      const to = previous === undefined ? 0 : current.indexOf(previous) + 1;
+      current.splice(to, 0, id);
+      if (from !== to) ops.push({ op: "move", from: `${base}/${from}`, path: `${base}/${to}` });
+    }
+    previous = id;
+  }
+
+  // 3. Insert new items and describe edits, in ascending target index so earlier indices are final.
+  for (let j = 0; j < b.length; j++) {
+    if (kind[j] === "add") {
+      ops.push({ op: "add", path: `${base}/${j}`, value: cloneJson(b[j]) });
+      current.splice(j, 0, "new");
+    } else if (kind[j] === "edit") {
+      diffInto(a[source[j] as number], b[j], `${base}/${j}`, ops);
+    }
+  }
+}
+
+function diffInto(from: unknown, to: unknown, base: string, ops: PatchOp[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, base, ops);
+  } else if (isObject(from) && isObject(to)) {
+    const fromKeys = Object.keys(from);
+    for (const key of fromKeys) {
+      if (!Object.hasOwn(to, key)) ops.push({ op: "remove", path: `${base}/${encodeToken(key)}` });
+    }
+    for (const key of fromKeys) {
+      if (Object.hasOwn(to, key)) diffInto(from[key], to[key], `${base}/${encodeToken(key)}`, ops);
+    }
+    for (const key of Object.keys(to)) {
+      if (!Object.hasOwn(from, key)) {
+        ops.push({ op: "add", path: `${base}/${encodeToken(key)}`, value: cloneJson(to[key]) });
+      }
+    }
+  } else if (!jsonEqual(from, to)) {
+    ops.push({ op: "replace", path: base, value: cloneJson(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only what differs.
+ * Objects and arrays are compared recursively; array items that are inserted, removed or moved yield
+ * `add`, `remove` and `move` operations without rewriting the items around them.
+ * Neither input is mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): Record<string, unknown>[] {
+  const ops: PatchOp[] = [];
+  diffInto(from, to, "", ops);
+  return ops;
+}
