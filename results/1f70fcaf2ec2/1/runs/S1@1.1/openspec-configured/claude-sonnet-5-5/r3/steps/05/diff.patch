+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const J = (s: string): unknown => JSON.parse(s);
+const patchOf = (a: string, b: string) => createPatch(J(a), J(b));
+const roundTrip = (a: unknown, b: unknown) => {
+  const fromCopy = structuredClone(a);
+  const toCopy = structuredClone(b);
+  const patch = createPatch(a, b);
+  assert.deepEqual(a, fromCopy);
+  assert.deepEqual(b, toCopy);
+  assert.deepEqual(applyPatch(a, patch), b);
+  return patch;
+};
+
+test("equal documents and whole-document replacement", () => {
+  assert.deepEqual(patchOf('{"a":1,"b":[1,{"c":2}]}', '{"b":[1,{"c":2}],"a":1}'), []);
+  assert.deepEqual(patchOf("1", "1"), []);
+  assert.deepEqual(patchOf("1", "2"), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepEqual(patchOf("null", "1"), [{ op: "replace", path: "", value: 1 }]);
+  assert.deepEqual(patchOf("[1]", '{"a":1}'), [{ op: "replace", path: "", value: { a: 1 } }]);
+  assert.deepEqual(patchOf('{"a":1}', "[1]"), [{ op: "replace", path: "", value: [1] }]);
+});
+
+test("objects are described member by member", () => {
+  assert.deepEqual(patchOf('{"a":1,"b":2}', '{"b":3,"c":4}'), [
+    { op: "remove", path: "/a" },
+    { op: "replace", path: "/b", value: 3 },
+    { op: "add", path: "/c", value: 4 },
+  ]);
+  assert.deepEqual(patchOf('{"a":{"b":{"c":[1,2]},"d":1},"e":[1,2,3]}', '{"a":{"b":{"c":[1,2]},"d":2},"e":[1,2,3]}'), [
+    { op: "replace", path: "/a/d", value: 2 },
+  ]);
+  assert.deepEqual(patchOf('{"a":null}', '{"a":1}'), [{ op: "replace", path: "/a", value: 1 }]);
+  assert.deepEqual(patchOf('{"a":1}', '{"a":null}'), [{ op: "replace", path: "/a", value: null }]);
+  assert.deepEqual(patchOf("{}", '{"a":null}'), [{ op: "add", path: "/a", value: null }]);
+});
+
+test("pointer escaping, empty key and __proto__", () => {
+  assert.deepEqual(patchOf('{"a/b":1,"m~n":1}', '{"a/b":2,"m~n":2}'), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/m~0n", value: 2 },
+  ]);
+  assert.deepEqual(patchOf('{"":1}', '{"":2}'), [{ op: "replace", path: "/", value: 2 }]);
+  const a = J('{"__proto__":{"x":1},"k":1}');
+  const b = J('{"__proto__":{"x":2},"k":1}');
+  assert.deepEqual(createPatch(a, b), [{ op: "replace", path: "/__proto__/x", value: 2 }]);
+  roundTrip(a, b);
+  roundTrip(J("{}"), J('{"__proto__":{"polluted":true}}'));
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("inputs are not mutated or aliased", () => {
+  const to = J('{"a":{"x":[1]}}') as { a: { x: number[] } };
+  const patch = roundTrip({}, to);
+  to.a.x.push(2);
+  assert.deepEqual(patch, [{ op: "add", path: "/a", value: { x: [1] } }]);
+});
+
+test("array insertions and removals", () => {
+  assert.deepEqual(patchOf("[1,2,3]", "[1,9,2,3]"), [{ op: "add", path: "/1", value: 9 }]);
+  assert.deepEqual(patchOf('[{"id":1},{"id":2},{"id":3}]', '[{"id":2},{"id":3}]'), [{ op: "remove", path: "/0" }]);
+  assert.deepEqual(patchOf("[1,2]", "[1,2,3]"), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(patchOf("[1,2,3]", "[1,2]"), [{ op: "remove", path: "/2" }]);
+  assert.deepEqual(patchOf("[]", "[1]"), [{ op: "add", path: "/0", value: 1 }]);
+  assert.equal(createPatch(J("[1,2,3,4]"), J("[1,3]")).length, 2);
+});
+
+test("array item changed in place", () => {
+  assert.deepEqual(patchOf('[{"id":1,"v":1},{"id":2,"v":1}]', '[{"id":1,"v":1},{"id":2,"v":2}]'), [
+    { op: "replace", path: "/1/v", value: 2 },
+  ]);
+  assert.deepEqual(patchOf('[1,2,3]', "[1,5,3]"), [{ op: "replace", path: "/1", value: 5 }]);
+});
+
+test("array moves", () => {
+  assert.deepEqual(patchOf("[1,2,3,4]", "[2,3,4,1]"), [{ op: "move", from: "/0", path: "/3" }]);
+  assert.deepEqual(patchOf("[1,2,3,4]", "[4,1,2,3]"), [{ op: "move", from: "/3", path: "/0" }]);
+  assert.deepEqual(patchOf('[{"a":1},{"b":2},{"c":3}]', '[{"a":1},{"c":3},{"b":2}]').length, 1);
+});
+
+test("arrays with duplicates", () => {
+  assert.equal(patchOf("[1,1,1]", "[1,1,1,1]").length, 1);
+  assert.equal(patchOf("[1,1,1,1]", "[1,1,1]").length, 1);
+  assert.equal(patchOf("[1,2,1,2]", "[1,2,2]").length, 1);
+  assert.equal(patchOf("[1,1,2]", "[2,1,1]").length, 1);
+  roundTrip(J("[1,2,1,2]"), J("[2,1,2,1]"));
+});
+
+test("randomised round trips", () => {
+  let seed = 12345;
+  const rnd = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  const value = (depth: number): unknown => {
+    const t = rnd(depth > 2 ? 4 : 6);
+    if (t === 0) return rnd(3);
+    if (t === 1) return null;
+    if (t === 2) return ["a", "b/c", "~", ""][rnd(4)];
+    if (t === 3) return rnd(2) === 0;
+    if (t === 4) return Array.from({ length: rnd(6) }, () => value(depth + 1));
+    const o: Record<string, unknown> = {};
+    for (let i = rnd(4); i > 0; i--) Object.defineProperty(o, ["a", "b", "c/d", "__proto__"][rnd(4)], { value: value(depth + 1), enumerable: true, writable: true, configurable: true });
+    return o;
+  };
+  const mutate = (v: unknown): unknown => {
+    if (Array.isArray(v)) {
+      const copy = v.map((x) => (rnd(4) === 0 ? mutate(x) : structuredClone(x)));
+      for (let k = rnd(3); k > 0; k--) {
+        const op = rnd(3);
+        if (op === 0) copy.splice(rnd(copy.length + 1), 0, value(2));
+        else if (op === 1 && copy.length) copy.splice(rnd(copy.length), 1);
+        else if (copy.length) copy.splice(rnd(copy.length), 0, ...copy.splice(rnd(copy.length), 1));
+      }
+      return copy;
+    }
+    if (typeof v === "object" && v !== null) {
+      const o = structuredClone(v) as Record<string, unknown>;
+      for (const k of Object.keys(o)) if (rnd(4) === 0) o[k] = mutate(o[k]);
+      return o;
+    }
+    return rnd(2) ? v : value(2);
+  };
+  for (let n = 0; n < 3000; n++) {
+    const a = value(0);
+    roundTrip(a, rnd(3) === 0 ? value(0) : mutate(a));
+  }
+});
