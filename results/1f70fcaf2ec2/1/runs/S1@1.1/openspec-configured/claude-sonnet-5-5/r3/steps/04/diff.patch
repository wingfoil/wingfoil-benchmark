index 16c3820bcbeada7e43c67acad5da7d7df3a97af9..a479a01373a56ebe155aeda08db9c7d22ee12864 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -231,3 +231,23 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7396 §2) to `target` and returns the result as a new value.
+ * A non-object patch replaces the target; in an object patch, `null` members remove the member
+ * and other members are merged recursively. Neither input is mutated.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return cloneJson(patch);
+  const result = isObject(target) ? (cloneJson(target) as Record<string, unknown>) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = Object.hasOwn(result, key) ? result[key] : undefined;
+      setMember(result, key, applyMergePatch(current, value));
+    }
+  }
+  return result;
+}
