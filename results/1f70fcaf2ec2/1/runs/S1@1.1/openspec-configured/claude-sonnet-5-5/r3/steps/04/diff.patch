+++ b/test/merge-patch.test.ts
@@ -0,0 +1,87 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+const J = (s: string): unknown => JSON.parse(s);
+const ok = (target: string, patch: string, expected: string) =>
+  assert.deepEqual(applyMergePatch(J(target), J(patch)), J(expected));
+
+test("object patches merge recursively", () => {
+  ok('{"a":"b"}', '{"a":"c","d":"e"}', '{"a":"c","d":"e"}');
+  ok('{"a":"b","c":"d"}', '{"a":null}', '{"c":"d"}');
+  ok('{"a":"b"}', '{"c":null}', '{"a":"b"}');
+  ok('{"a":{"b":"c","x":1}}', '{"a":{"b":"d","c":null}}', '{"a":{"b":"d","x":1}}');
+  ok('{"a":1}', "{}", '{"a":1}');
+  ok('{"a":"b"}', '{"a":{"x":1}}', '{"a":{"x":1}}');
+  ok("{}", '{"a":{"b":null,"c":1}}', '{"a":{"c":1}}');
+  for (const t of [[1], 1, "x", null, undefined]) {
+    assert.deepEqual(applyMergePatch(t, J('{"a":1}')), { a: 1 });
+  }
+});
+
+test("RFC 7396 §3 example set", () => {
+  const cases: [string, string, string][] = [
+    ['{"a":"b"}', '{"a":"c"}', '{"a":"c"}'],
+    ['{"a":"b"}', '{"b":"c"}', '{"a":"b","b":"c"}'],
+    ['{"a":"b"}', '{"a":null}', "{}"],
+    ['{"a":"b","b":"c"}', '{"a":null}', '{"b":"c"}'],
+    ['{"a":["b"]}', '{"a":"c"}', '{"a":"c"}'],
+    ['{"a":"c"}', '{"a":["b"]}', '{"a":["b"]}'],
+    ['{"a":{"b":"c"}}', '{"a":{"b":"d","c":null}}', '{"a":{"b":"d"}}'],
+    ['{"a":[{"b":"c"}]}', '{"a":[1]}', '{"a":[1]}'],
+    ['["a","b"]', '["c","d"]', '["c","d"]'],
+    ['{"a":"b"}', '["c"]', '["c"]'],
+    ['{"a":"foo"}', "null", "null"],
+    ['{"a":"foo"}', '"bar"', '"bar"'],
+    ['{"e":null}', '{"a":1}', '{"e":null,"a":1}'],
+    ["[1,2]", '{"a":"b","c":null}', '{"a":"b"}'],
+    ["{}", '{"a":{"bb":{"ccc":null}}}', '{"a":{"bb":{}}}'],
+  ];
+  for (const [t, p, e] of cases) ok(t, p, e);
+});
+
+test("non-object patches replace the target", () => {
+  ok('{"a":"b"}', '["c"]', '["c"]');
+  ok('{"a":[1,2,3]}', '{"a":[4]}', '{"a":[4]}');
+  ok("{}", '{"a":[1,null]}', '{"a":[1,null]}');
+  for (const p of ['"x"', "1", "true", "false", "null"]) {
+    ok('{"a":1}', p, p);
+    ok("[1]", p, p);
+  }
+});
+
+test("no mutation, no aliasing", () => {
+  const target = J('{"a":{"b":[1,2],"c":1},"d":{"e":1}}');
+  const patch = J('{"a":{"c":null,"n":{"x":[1]}},"d":[{"k":1}],"z":{"y":1}}');
+  const t0 = structuredClone(target);
+  const p0 = structuredClone(patch);
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, t0);
+  assert.deepEqual(patch, p0);
+  result.a.b.push(3);
+  result.a.n.x.push(2);
+  result.d[0].k = 2;
+  result.z.y = 2;
+  assert.deepEqual(target, t0);
+  assert.deepEqual(patch, p0);
+  const arr = [1];
+  const r = applyMergePatch({}, arr) as number[];
+  r.push(2);
+  assert.deepEqual(arr, [1]);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const result = applyMergePatch({}, J('{"__proto__":{"polluted":true}}')) as any;
+  assert.ok(Object.hasOwn(result, "__proto__"));
+  assert.deepEqual(Object.getOwnPropertyDescriptor(result, "__proto__")!.value, { polluted: true });
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal((Object.prototype as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+
+  const removed = applyMergePatch(result, J('{"__proto__":null}'));
+  assert.ok(!Object.hasOwn(removed as object, "__proto__"));
+
+  const nested = applyMergePatch(J('{"a":{}}'), J('{"a":{"__proto__":{"x":1}}}')) as any;
+  assert.ok(Object.hasOwn(nested.a, "__proto__"));
+  assert.equal(({} as any).x, undefined);
+});
