@@ -0,0 +1,52 @@
+/** Thrown when a JSON Pointer is invalid (RFC 6901 §3) or does not resolve (RFC 6901 §4). */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function decodeToken(token: string): string {
+  return token.replace(/~(.?)/g, (_, c: string) => {
+    if (c === "0") return "~";
+    if (c === "1") return "/";
+    throw new JsonPointerError(`Invalid escape sequence in JSON Pointer token: ~${c}`);
+  });
+}
+
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError("JSON Pointer must be empty or start with '/'");
+  }
+  return pointer.slice(1).split("/").map(decodeToken);
+}
+
+/**
+ * Returns the value of `document` referred to by `pointer` (RFC 6901).
+ * Throws JsonPointerError if the pointer is invalid or does not resolve to a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const token of parsePointer(pointer)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new JsonPointerError(`No array element for token '${token}'`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new JsonPointerError(`No member for token '${token}'`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Cannot apply token '${token}' to a non-container value`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
