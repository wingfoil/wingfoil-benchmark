index 0000000000000000000000000000000000000000..f964033bdee1d6e5895479ea20eae0fb29c9ab02
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,92 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer, JsonPointerError } from "../src/index.ts";
+
+const rfc = JSON.parse(
+  '{"foo":["bar","baz"],"":0,"a/b":1,"c%d":2,"e^f":3,"g|h":4,"i\\\\j":5,"k\\"l":6," ":7,"m~n":8}',
+);
+
+test("RFC 6901 §5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  const cases: [string, unknown][] = [
+    ["/foo/0", "bar"], ["/", 0], ["/a~1b", 1], ["/c%d", 2], ["/e^f", 3],
+    ["/g|h", 4], ["/i\\j", 5], ['/k"l', 6], ["/ ", 7], ["/m~0n", 8],
+  ];
+  for (const [p, v] of cases) assert.equal(resolvePointer(rfc, p), v, p);
+});
+
+test("empty pointer on scalar documents", () => {
+  for (const v of [null, 0, false, "s"]) assert.equal(resolvePointer(v, ""), v);
+});
+
+test("syntax errors", () => {
+  for (const p of ["a", "a/b"]) assert.throws(() => resolvePointer({ a: 1 }, p), JsonPointerError);
+  for (const p of [undefined, null, 1] as any[]) {
+    assert.throws(() => resolvePointer({}, p), JsonPointerError);
+  }
+});
+
+test("escapes", () => {
+  assert.equal(resolvePointer({ "a/b": 1 }, "/a~1b"), 1);
+  assert.equal(resolvePointer({ "m~n": 8 }, "/m~0n"), 8);
+  assert.equal(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+  for (const p of ["/a~", "/a~2", "/~x"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), JsonPointerError);
+  }
+});
+
+test("object members", () => {
+  assert.equal(resolvePointer({ foo: { bar: 5 } }, "/foo/bar"), 5);
+  assert.equal(resolvePointer({ "": 0 }, "/"), 0);
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"), JsonPointerError);
+});
+
+test("inherited and hostile names", () => {
+  for (const p of ["/__proto__", "/constructor", "/toString", "/hasOwnProperty"]) {
+    assert.throws(() => resolvePointer({}, p), JsonPointerError, p);
+  }
+  assert.equal(resolvePointer(JSON.parse('{"__proto__":7}'), "/__proto__"), 7);
+});
+
+test("null and falsy values are values", () => {
+  const d = { a: null, b: 0, c: false, d: "" };
+  for (const k of Object.keys(d)) {
+    assert.equal(resolvePointer(d, "/" + k), (d as any)[k]);
+  }
+});
+
+test("array elements", () => {
+  const d = { foo: ["bar", "baz"] };
+  assert.equal(resolvePointer(d, "/foo/1"), "baz");
+  assert.throws(() => resolvePointer(d, "/foo/2"), JsonPointerError);
+  assert.throws(() => resolvePointer(d, "/foo/-"), JsonPointerError);
+  for (const t of ["01", "+1", "-1", "1.0", "1e0", " 1", "", "length"]) {
+    assert.throws(() => resolvePointer(d, "/foo/" + t), JsonPointerError, t);
+  }
+});
+
+test("scalars cannot be traversed", () => {
+  for (const a of ["str", 1, null]) {
+    assert.throws(() => resolvePointer({ a }, "/a/b"), JsonPointerError);
+  }
+});
+
+test("does not mutate the document", () => {
+  const deepFreeze = (o: any): any => {
+    if (o && typeof o === "object") Object.values(o).forEach(deepFreeze);
+    return Object.freeze(o);
+  };
+  const d = deepFreeze(JSON.parse(JSON.stringify(rfc)));
+  assert.equal(resolvePointer(d, "/foo/1"), "baz");
+  assert.deepEqual(d, rfc);
+});
