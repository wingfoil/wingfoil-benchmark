index 0000000000000000000000000000000000000000..2a5ed410bfc76ced5af9ac04ffeff9bcb77c2424
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,68 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+const ok = (target: unknown, patch: unknown, expected: unknown) =>
+  assert.deepEqual(applyMergePatch(target, patch), expected);
+
+test("members are merged, null removes (§2)", () => {
+  ok({ a: "b", c: { d: "e" } }, { a: "z", c: { f: "g" } }, { a: "z", c: { d: "e", f: "g" } });
+  ok({ a: "b", f: "g" }, { a: null }, { f: "g" });
+  ok({ a: 1 }, { b: null }, { a: 1 });
+  ok({ a: { b: 1, c: 2 } }, { a: { b: null } }, { a: { c: 2 } });
+});
+
+test("arrays and scalars replace", () => {
+  ok({ a: ["g", "h"] }, { a: ["z"] }, { a: ["z"] });
+  ok({ a: { b: 1 } }, { a: "x" }, { a: "x" });
+  ok({ a: "b" }, { a: { bb: { cc: null } } }, { a: { bb: {} } });
+  ok({}, { a: [1, null] }, { a: [1, null] });
+});
+
+test("non-object patch replaces the document", () => {
+  for (const p of [["x"], "s", 1, true, null]) {
+    ok({ a: 1 }, p, p);
+    ok(["y"], p, p);
+  }
+});
+
+test("non-object target is treated as {}", () => {
+  for (const t of [["a"], "s", 1, null, undefined]) {
+    ok(t, { b: "c" }, { b: "c" });
+    ok(t, {}, {});
+    ok(t, { b: null }, {});
+  }
+  ok({ a: 1 }, {}, { a: 1 });
+});
+
+test("inputs are not mutated and result is independent", () => {
+  const target = { a: { b: 1 }, l: [{ x: 1 }], r: 1 };
+  const patch = { a: { c: 2 }, n: { d: [1] }, r: null };
+  const t0 = structuredClone(target);
+  const p0 = structuredClone(patch);
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, t0);
+  assert.deepEqual(patch, p0);
+  result.a.b = 9;
+  result.l[0].x = 9;
+  result.n.d.push(2);
+  assert.deepEqual(target, t0);
+  assert.deepEqual(patch, p0);
+});
+
+test("__proto__ keys are safe", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"polluted":true}}')) as any;
+  assert.equal(Object.hasOwn(result, "__proto__"), true);
+  assert.deepEqual(Object.getOwnPropertyDescriptor(result, "__proto__")!.value, { polluted: true });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as any).polluted, undefined);
+
+  const removed = applyMergePatch(JSON.parse('{"__proto__":{"a":1},"b":2}'), JSON.parse('{"__proto__":null}'));
+  assert.equal(Object.hasOwn(removed as object, "__proto__"), false);
+  assert.deepEqual(removed, { b: 2 });
+  assert.equal(Object.getPrototypeOf(removed), Object.prototype);
+
+  const nested = applyMergePatch({}, JSON.parse('{"a":{"__proto__":{"p":1}}}')) as any;
+  assert.equal(nested.a.p, undefined);
+  assert.equal(({} as any).p, undefined);
+});
