@@ -0,0 +1,57 @@
+/** Error thrown for an invalid JSON Pointer or one that does not resolve (RFC 6901 §3, §4). */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const VALID_ESCAPES = /^(?:[^~]|~[01])*$/;
+
+function parse(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Invalid JSON Pointer: must be empty or start with "/": ${pointer}`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (!VALID_ESCAPES.test(token)) {
+        throw new JsonPointerError(`Invalid JSON Pointer: "~" must be followed by 0 or 1: ${pointer}`);
+      }
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/**
+ * Returns the value of `document` that `pointer` refers to (RFC 6901 §4).
+ * Throws a JsonPointerError if the pointer is invalid or does not resolve.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const token of parse(pointer)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token)) {
+        throw new JsonPointerError(`Cannot resolve "${token}" in array: not a valid index`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new JsonPointerError(`Array index ${token} is out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new JsonPointerError(`Member "${token}" does not exist`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Cannot resolve "${token}" in a scalar value`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
