index 0000000000000000000000000000000000000000..ee3af7ac370b3e3da730b49493e393c48d00b38f
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,88 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer, JsonPointerError } from "../src/index.ts";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+const fails = (doc: unknown, p: any) =>
+  assert.throws(() => resolvePointer(doc, p), JsonPointerError);
+
+test("RFC 6901 §5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("empty pointer on scalars and null", () => {
+  for (const v of [null, 0, "x", false]) assert.equal(resolvePointer(v, ""), v);
+});
+
+test("syntax errors", () => {
+  fails(rfc, "a");
+  fails(rfc, "a/b");
+  fails(rfc, "#/a");
+  for (const p of [undefined, null, 1, {}]) fails(rfc, p);
+});
+
+test("escapes", () => {
+  assert.equal(resolvePointer({ "~1": 3, "/": 4 }, "/~01"), 3);
+  fails({ a: 1 }, "/a~");
+  fails({ a: 1 }, "/a~2");
+  fails({ a: 1 }, "/~x");
+});
+
+test("objects", () => {
+  assert.equal(resolvePointer({ foo: { bar: 5 } }, "/foo/bar"), 5);
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer({ a: false }, "/a"), false);
+  fails({ a: 1 }, "/b");
+  assert.equal(resolvePointer({ "0": "x" }, "/0"), "x");
+});
+
+test("hostile and inherited names", () => {
+  for (const k of ["__proto__", "constructor", "toString", "hasOwnProperty"]) fails({}, "/" + k);
+  fails([], "/constructor");
+  assert.equal(resolvePointer(JSON.parse('{"__proto__":1}'), "/__proto__"), 1);
+});
+
+test("arrays", () => {
+  assert.equal(resolvePointer({ foo: ["bar", "baz"] }, "/foo/1"), "baz");
+  fails([], "/0");
+  fails(["a", "b"], "/2");
+  fails([1, 2], "/-");
+  for (const p of ["/01", "/+1", "/-1", "/1.0", "/1e0", "/ 1", "/", "/length", "/99999999999999999999"])
+    fails([1, 2], p);
+});
+
+test("scalars cannot be traversed", () => {
+  fails({ a: 1 }, "/a/b");
+  fails({ a: "str" }, "/a/0");
+  fails({ a: null }, "/a/b");
+});
+
+test("document is not mutated", () => {
+  const doc = { a: [1, { b: "c" }], "": null };
+  const copy = structuredClone(doc);
+  resolvePointer(doc, "/a/1/b");
+  assert.deepEqual(doc, copy);
+});
