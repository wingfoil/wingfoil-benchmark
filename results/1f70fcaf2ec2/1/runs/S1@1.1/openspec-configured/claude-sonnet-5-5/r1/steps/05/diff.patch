@@ -264,3 +264,83 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+type PatchOperation = { op: "add" | "remove" | "replace"; path: string; value?: unknown };
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffValue(ops: PatchOperation[], path: string, a: unknown, b: unknown): void {
+  if (equal(a, b)) return;
+  if (Array.isArray(a) && Array.isArray(b)) {
+    diffArray(ops, path, a, b);
+  } else if (isObject(a) && isObject(b)) {
+    for (const key of Object.keys(a)) {
+      if (!Object.hasOwn(b, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(b)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(a, key)) diffValue(ops, child, a[key], b[key]);
+      else ops.push({ op: "add", path: child, value: clone(b[key]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(b) });
+  }
+}
+
+function diffArray(ops: PatchOperation[], path: string, a: unknown[], b: unknown[]): void {
+  let start = 0;
+  while (start < a.length && start < b.length && equal(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && equal(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const x = a.slice(start, endA);
+  const y = b.slice(start, endB);
+  // lcs[i][j]: length of the longest common subsequence of x[i..] and y[j..]
+  const lcs = Array.from({ length: x.length + 1 }, () => new Array<number>(y.length + 1).fill(0));
+  for (let i = x.length - 1; i >= 0; i--) {
+    for (let j = y.length - 1; j >= 0; j--) {
+      lcs[i][j] = equal(x[i], y[j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  let i = 0;
+  let j = 0;
+  let index = start; // position in the array as it is after the operations emitted so far
+  while (i < x.length || j < y.length) {
+    if (i < x.length && j < y.length && equal(x[i], y[j])) {
+      i++;
+      j++;
+      index++;
+      continue;
+    }
+    const removed: unknown[] = [];
+    const added: unknown[] = [];
+    while ((i < x.length || j < y.length) && !(i < x.length && j < y.length && equal(x[i], y[j]))) {
+      if (j >= y.length || (i < x.length && lcs[i + 1][j] >= lcs[i][j + 1])) removed.push(x[i++]);
+      else added.push(y[j++]);
+    }
+    const paired = Math.min(removed.length, added.length);
+    for (let k = 0; k < paired; k++) diffValue(ops, `${path}/${index + k}`, removed[k], added[k]);
+    for (let k = paired; k < removed.length; k++) ops.push({ op: "remove", path: `${path}/${index + paired}` });
+    for (let k = paired; k < added.length; k++) {
+      ops.push({ op: "add", path: `${path}/${index + k}`, value: clone(added[k]) });
+    }
+    index += added.length;
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied. Neither argument is mutated.
+ * The patch descends into objects and arrays and lists only the differences (RFC 6902 §4.1-4.3); array
+ * items are aligned by longest common subsequence, so an inserted or removed item yields a single `add` or
+ * `remove`, and a moved item a `remove` and an `add`. Paths are escaped per RFC 6901 §3.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  const ops: PatchOperation[] = [];
+  diffValue(ops, "", from, to);
+  return ops;
+}
