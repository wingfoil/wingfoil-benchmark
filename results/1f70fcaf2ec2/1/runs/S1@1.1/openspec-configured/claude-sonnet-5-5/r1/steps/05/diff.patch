index 0000000000000000000000000000000000000000..4753373dff34ef347431da9f67aef43a0fb11aa2
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,109 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function check(from: unknown, to: unknown, expected?: unknown[]) {
+  const before = JSON.stringify([from, to]);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.equal(JSON.stringify([from, to]), before);
+  if (expected) assert.deepEqual(patch, expected);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  for (const v of [1, null, "s", {}, [], { a: [1, { b: null }] }]) check(v, structuredClone(v), []);
+});
+
+test("root values that differ are replaced", () => {
+  check(1, { a: 1 }, [{ op: "replace", path: "", value: { a: 1 } }]);
+  check([], {}, [{ op: "replace", path: "", value: {} }]);
+  check(null, {}, [{ op: "replace", path: "", value: {} }]);
+});
+
+test("patch values are independent copies", () => {
+  const to = { a: { b: [1] } };
+  const patch = createPatch({}, to) as { value: { b: number[] } }[];
+  patch[0].value.b.push(2);
+  assert.deepEqual(to, { a: { b: [1] } });
+});
+
+test("one deep change yields one operation", () => {
+  const from = { a: { b: { c: 1, d: [1, 2] } }, e: "x" };
+  const to = { a: { b: { c: 2, d: [1, 2] } }, e: "x" };
+  check(from, to, [{ op: "replace", path: "/a/b/c", value: 2 }]);
+});
+
+test("object members added, removed and changed", () => {
+  check({ a: 1, b: 2 }, { b: 3, c: 4 }, [
+    { op: "remove", path: "/a" },
+    { op: "replace", path: "/b", value: 3 },
+    { op: "add", path: "/c", value: 4 },
+  ]);
+});
+
+test("null and type changes are replacements", () => {
+  check({ a: 1 }, { a: null }, [{ op: "replace", path: "/a", value: null }]);
+  check({ a: { x: 1 } }, { a: [1] }, [{ op: "replace", path: "/a", value: [1] }]);
+  check({ a: [1] }, { a: { x: 1 } }, [{ op: "replace", path: "/a", value: { x: 1 } }]);
+});
+
+test("escaped and hostile keys", () => {
+  const to = JSON.parse('{"a/b":1,"m~n":2,"":3,"__proto__":{"x":1},"constructor":4}');
+  const patch = check({}, to) as { path: string }[];
+  assert.deepEqual(patch.map((o) => o.path), ["/a~1b", "/m~0n", "/", "/__proto__", "/constructor"]);
+  const result = applyPatch({}, patch) as object;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+  check(JSON.parse('{"__proto__":{"x":1}}'), JSON.parse('{"__proto__":{"x":2}}'), [
+    { op: "replace", path: "/__proto__/x", value: 2 },
+  ]);
+});
+
+test("array insertion", () => {
+  check([1, 2, 3], [1, 9, 2, 3], [{ op: "add", path: "/1", value: 9 }]);
+  check([1, 2, 3], [9, 1, 2, 3], [{ op: "add", path: "/0", value: 9 }]);
+  check([1, 2, 3], [1, 2, 3, 9], [{ op: "add", path: "/3", value: 9 }]);
+});
+
+test("array removal", () => {
+  check([1, 2, 3], [1, 3], [{ op: "remove", path: "/1" }]);
+  check([1, 2, 3], [2, 3], [{ op: "remove", path: "/0" }]);
+  check([1, 2, 3], [1, 2], [{ op: "remove", path: "/2" }]);
+});
+
+test("array move touches only the moved item", () => {
+  for (const to of [["b", "c", "d", "a"], ["a", "d", "b", "c"]]) {
+    const patch = check(["a", "b", "c", "d"], to) as { op: string }[];
+    assert.ok(patch.length <= 2);
+    assert.ok(patch.every((o) => o.op === "remove" || o.op === "add" || o.op === "move"));
+  }
+});
+
+test("array item changed in place descends into it", () => {
+  check([{ a: 1, b: 2 }, { c: 3 }], [{ a: 1, b: 2 }, { c: 4 }], [{ op: "replace", path: "/1/c", value: 4 }]);
+  check([1, 2, 3], [1, 5, 3], [{ op: "replace", path: "/1", value: 5 }]);
+});
+
+test("duplicates, empty arrays and several edits round-trip", () => {
+  check([], [1, 2]);
+  check([1, 2], []);
+  check([1, 1, 1], [1, 1]);
+  check([1, 2, 1, 2], [2, 1, 2, 1]);
+  check([1, 2, 3, 4, 5, 6], [0, 2, 3, 7, 8, 6, 9]);
+  check({ a: [[1], [2]] }, { a: [[1, 1], [2], [3]] });
+});
+
+test("random documents round-trip", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff), seed % n);
+  const gen = (d: number): unknown => {
+    const t = rnd(d > 2 ? 3 : 5);
+    if (t === 0) return rnd(4);
+    if (t === 1) return null;
+    if (t === 2) return "s" + rnd(3);
+    if (t === 3) return Array.from({ length: rnd(5) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let n = 0; n < 500; n++) check(gen(0), gen(0));
+});
