--- a/src/index.ts
+++ b/src/index.ts
@@ -55,3 +55,192 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+/** Error thrown for an invalid JSON Patch or a failed patch operation (RFC 6902 §3, §5). */
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Container = Record<string, unknown> | unknown[];
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setOwn(target: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(clone);
+  if (isObject(value)) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setOwn(copy, key, clone(value[key]));
+    return copy;
+  }
+  return value;
+}
+
+/** Deep equality of JSON values (RFC 6902 §4.6). */
+function equal(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => equal(v, b[i]));
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((k) => Object.hasOwn(b, k) && equal(a[k], b[k]))
+    );
+  }
+  return a === b;
+}
+
+function tokens(pointer: string): string[] {
+  try {
+    return parse(pointer);
+  } catch (e) {
+    throw new JsonPatchError((e as Error).message);
+  }
+}
+
+function fail(message: string): never {
+  throw new JsonPatchError(message);
+}
+
+/** Walks to the parent container of the location named by `path` (which must not be empty). */
+function parentOf(root: unknown, path: string[]): Container {
+  let current = root;
+  for (const token of path.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) fail(`Path element "${token}" does not exist`);
+      current = current[Number(token)];
+    } else if (isObject(current) && Object.hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      fail(`Path element "${token}" does not exist`);
+    }
+  }
+  if (Array.isArray(current) || isObject(current)) return current;
+  return fail("Parent of the target location is not an object or array");
+}
+
+function getAt(root: unknown, path: string[]): unknown {
+  if (path.length === 0) return root;
+  const parent = parentOf(root, path);
+  const last = path[path.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(last) || Number(last) >= parent.length) fail(`Target "${last}" does not exist`);
+    return parent[Number(last)];
+  }
+  if (!Object.hasOwn(parent, last)) fail(`Target "${last}" does not exist`);
+  return parent[last];
+}
+
+function addAt(root: unknown, path: string[], value: unknown): unknown {
+  if (path.length === 0) return value;
+  const parent = parentOf(root, path);
+  const last = path[path.length - 1];
+  if (Array.isArray(parent)) {
+    if (last === "-") {
+      parent.push(value);
+    } else {
+      if (!ARRAY_INDEX.test(last) || Number(last) > parent.length) fail(`Invalid array index "${last}"`);
+      parent.splice(Number(last), 0, value);
+    }
+  } else {
+    setOwn(parent, last, value);
+  }
+  return root;
+}
+
+function removeAt(root: unknown, path: string[]): unknown {
+  if (path.length === 0) fail("Cannot remove the whole document");
+  getAt(root, path); // the target must exist
+  const parent = parentOf(root, path);
+  const last = path[path.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete parent[last];
+  return root;
+}
+
+function member(op: Record<string, unknown>, name: string, index: number): unknown {
+  if (!Object.hasOwn(op, name)) fail(`Operation ${index}: missing "${name}"`);
+  return op[name];
+}
+
+function pointerMember(op: Record<string, unknown>, name: string, index: number): string[] {
+  const value = member(op, name, index);
+  if (typeof value !== "string") fail(`Operation ${index}: "${name}" must be a string`);
+  return tokens(value);
+}
+
+interface Operation {
+  op: string;
+  path: string[];
+  from?: string[];
+  value?: unknown;
+}
+
+function validate(patch: unknown): Operation[] {
+  if (!Array.isArray(patch)) fail("A JSON Patch must be an array");
+  return patch.map((raw: unknown, i: number): Operation => {
+    if (!isObject(raw)) fail(`Operation ${i} must be an object`);
+    const op = raw.op;
+    if (typeof op !== "string" || !["add", "remove", "replace", "move", "copy", "test"].includes(op)) {
+      fail(`Operation ${i}: "op" must be one of add, remove, replace, move, copy, test`);
+    }
+    const result: Operation = { op, path: pointerMember(raw, "path", i) };
+    if (op === "add" || op === "replace" || op === "test") result.value = member(raw, "value", i);
+    if (op === "move" || op === "copy") result.from = pointerMember(raw, "from", i);
+    return result;
+  });
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the result as a new value.
+ * Neither the document nor the patch is mutated. Throws a JsonPatchError if the patch is invalid
+ * or an operation fails; no partial result is returned (RFC 6902 §5).
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  const operations = validate(patch);
+  let result = clone(document);
+  for (const { op, path, from, value } of operations) {
+    switch (op) {
+      case "add":
+        result = addAt(result, path, clone(value));
+        break;
+      case "remove":
+        result = removeAt(result, path);
+        break;
+      case "replace":
+        if (path.length > 0) getAt(result, path);
+        result = path.length === 0 ? clone(value) : addAfterRemove(result, path, clone(value));
+        break;
+      case "move": {
+        const source = from!;
+        if (source.length < path.length && source.every((t, i) => t === path[i])) {
+          fail("The \"from\" location must not be a proper prefix of \"path\"");
+        }
+        const moved = getAt(result, source);
+        if (source.length === path.length && source.every((t, i) => t === path[i])) break;
+        result = addAt(removeAt(result, source), path, moved);
+        break;
+      }
+      case "copy":
+        result = addAt(result, path, clone(getAt(result, from!)));
+        break;
+      case "test":
+        if (!equal(getAt(result, path), value)) fail("Test failed: value does not match");
+        break;
+    }
+  }
+  return result;
+}
+
+function addAfterRemove(root: unknown, path: string[], value: unknown): unknown {
+  return addAt(removeAt(root, path), path, value);
+}
