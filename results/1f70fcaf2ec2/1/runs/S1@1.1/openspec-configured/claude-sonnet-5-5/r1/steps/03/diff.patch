+++ b/test/patch.test.ts
@@ -0,0 +1,125 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, JsonPatchError } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) =>
+  assert.deepEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) =>
+  assert.throws(() => applyPatch(doc, patch), JsonPatchError);
+
+test("structure validation (§3)", () => {
+  for (const p of [{}, null, "x", 1]) bad({}, p);
+  ok({ a: 1 }, [], { a: 1 });
+  for (const o of [null, [], { path: "/a" }, { op: 1, path: "" }, { op: "nop", path: "" }]) bad({}, [o]);
+  bad({}, [{ op: "remove" }]);
+  bad({}, [{ op: "remove", path: 1 }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "/a" }]);
+  bad({}, [{ op: "test", path: "/a" }]);
+  bad({ a: 1 }, [{ op: "move", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "copy", path: "/b", from: 1 }]);
+  ok({ a: 1 }, [{ op: "remove", path: "/a", comment: "x" }], {});
+  ok({}, [{ op: "add", path: "/a", value: null }], { a: null });
+  bad({}, [{ op: "add", path: "a", value: 1 }]);
+  bad({}, [{ op: "add", path: "/a~2", value: 1 }]);
+  bad({}, [{ op: "move", from: "x", path: "/a" }]);
+});
+
+test("sequential and atomic", () => {
+  ok({}, [{ op: "add", path: "/a", value: 1 }, { op: "replace", path: "/a", value: 2 }], { a: 2 });
+  const doc = { a: 1 };
+  bad(doc, [{ op: "add", path: "/b", value: 1 }, { op: "remove", path: "/zz" }]);
+  assert.deepEqual(doc, { a: 1 });
+  bad({}, [{ op: "add", path: "/a", value: 1 }, { op: "nop", path: "" }]);
+});
+
+test("no mutation or shared references", () => {
+  const doc = { a: { x: [1] } };
+  const value = { y: { z: 1 } };
+  const patch = [{ op: "add", path: "/b", value }, { op: "add", path: "/a/x/-", value: 2 }];
+  const snapshot = structuredClone({ doc, patch });
+  const result = applyPatch(doc, patch) as any;
+  assert.deepEqual({ doc, patch }, snapshot);
+  result.b.y.z = 9;
+  assert.equal(value.y.z, 1);
+  assert.notEqual(applyPatch(doc, []), doc);
+  assert.notEqual((applyPatch(doc, []) as any).a, doc.a);
+});
+
+test("add (§4.1)", () => {
+  ok({ a: 1 }, [{ op: "add", path: "/b", value: 2 }], { a: 1, b: 2 });
+  ok({ a: 1 }, [{ op: "add", path: "/a", value: 2 }], { a: 2 });
+  ok({ a: ["p", "q"] }, [{ op: "add", path: "/a/1", value: "x" }], { a: ["p", "x", "q"] });
+  ok({ a: ["p", "q"] }, [{ op: "add", path: "/a/-", value: "x" }], { a: ["p", "q", "x"] });
+  ok({ a: ["p", "q"] }, [{ op: "add", path: "/a/2", value: "x" }], { a: ["p", "q", "x"] });
+  for (const p of ["/a/3", "/a/01", "/a/-1", "/a/x"]) bad({ a: ["p", "q"] }, [{ op: "add", path: p, value: 1 }]);
+  bad({}, [{ op: "add", path: "/a/b", value: 1 }]);
+  bad({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]);
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({}, [{ op: "add", path: "/", value: 1 }], { "": 1 });
+  ok({}, [{ op: "add", path: "/a~1b", value: 1 }, { op: "add", path: "/m~0n", value: 2 }], { "a/b": 1, "m~n": 2 });
+});
+
+test("hostile keys", () => {
+  const r = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as any;
+  assert.ok(Object.hasOwn(r, "__proto__"));
+  assert.equal(Object.getPrototypeOf(r), Object.prototype);
+  assert.equal(({} as any).x, undefined);
+  const parsed = JSON.parse('{"__proto__":{"y":1}}');
+  const c = applyPatch(parsed, []) as any;
+  assert.ok(Object.hasOwn(c, "__proto__"));
+  assert.equal(c.y, undefined);
+  bad({}, [{ op: "remove", path: "/__proto__" }]);
+  bad({}, [{ op: "replace", path: "/constructor", value: 1 }]);
+});
+
+test("remove (§4.2)", () => {
+  ok({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }], { b: 2 });
+  ok({ a: ["p", "q"] }, [{ op: "remove", path: "/a/0" }], { a: ["q"] });
+  bad({}, [{ op: "remove", path: "" }]);
+  bad({}, [{ op: "remove", path: "/x" }]);
+  bad({ a: [1, 2] }, [{ op: "remove", path: "/a/5" }]);
+  bad({ a: [1, 2] }, [{ op: "remove", path: "/a/-" }]);
+});
+
+test("replace (§4.3)", () => {
+  ok({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }], { a: 2 });
+  ok({ a: [1] }, [{ op: "replace", path: "/a/0", value: 2 }], { a: [2] });
+  bad({ a: 1 }, [{ op: "replace", path: "/b", value: 2 }]);
+  bad({ a: [1] }, [{ op: "replace", path: "/a/1", value: 2 }]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: 5 }], 5);
+});
+
+test("move (§4.4)", () => {
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/b" }], { b: 1 });
+  ok({ a: ["p", "q", "r"] }, [{ op: "move", from: "/a/0", path: "/a/2" }], { a: ["q", "r", "p"] });
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  bad({}, [{ op: "move", from: "/a", path: "/a" }]);
+  bad({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  bad({}, [{ op: "move", from: "/a", path: "/b" }]);
+});
+
+test("copy (§4.5)", () => {
+  const r = applyPatch({ a: { x: 1 } }, [
+    { op: "copy", from: "/a", path: "/b" },
+    { op: "replace", path: "/b/x", value: 2 },
+  ]);
+  assert.deepEqual(r, { a: { x: 1 }, b: { x: 2 } });
+  bad({}, [{ op: "copy", from: "/a", path: "/b" }]);
+});
+
+test("test (§4.6)", () => {
+  const doc = { a: { y: null, x: [1, 2] } };
+  ok(doc, [{ op: "test", path: "/a", value: { x: [1, 2], y: null } }], doc);
+  ok(doc, [{ op: "test", path: "", value: { a: { x: [1, 2], y: null } } }], doc);
+  ok({ a: 1 }, [{ op: "test", path: "/a", value: 1.0 }], { a: 1 });
+  const t = (d: unknown, v: unknown) => bad(d, [{ op: "test", path: "/a", value: v }]);
+  t({ a: 1 }, "1");
+  t({ a: 0 }, false);
+  t({ a: [1, 2] }, [2, 1]);
+  t({ a: { x: 1 } }, { x: 1, y: 2 });
+  t({ a: { x: 1, y: 2 } }, { x: 1 });
+  t({ a: {} }, []);
+  t({}, null);
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: 2 }, { op: "add", path: "/b", value: 1 }]);
+});
