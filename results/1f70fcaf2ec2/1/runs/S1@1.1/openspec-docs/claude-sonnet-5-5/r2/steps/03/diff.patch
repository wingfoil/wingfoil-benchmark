diff --git a/test/patch.test.ts b/test/patch.test.ts
index 45fad9f803af282c51a7a227f03397dcb16d24fd..74f42e0d58166a381e175ab24f1386ef0a55b504 100644
--- a/test/patch.test.ts
+++ b/test/patch.test.ts
@@ -23,3 +23,27 @@ test("throws on failures and invalid patches", () => {
   assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
   assert.throws(() => applyPatch({}, {}));
 });
+
+test("RFC 6902 appendix A edge cases", () => {
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc"] }]), {
+    foo: ["bar", ["abc"]],
+  });
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]));
+  assert.throws(() => applyPatch([1, 2], [{ op: "add", path: "/3", value: 9 }]));
+  assert.deepEqual(applyPatch({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }]), {
+    "/": 9,
+    "~1": 10,
+  });
+  assert.throws(() => applyPatch({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]));
+});
+
+test("a failing patch leaves the input untouched", () => {
+  const doc = { a: [1] };
+  assert.throws(() =>
+    applyPatch(doc, [
+      { op: "add", path: "/a/-", value: 2 },
+      { op: "test", path: "/a/0", value: 99 },
+    ]),
+  );
+  assert.deepEqual(doc, { a: [1] });
+});
