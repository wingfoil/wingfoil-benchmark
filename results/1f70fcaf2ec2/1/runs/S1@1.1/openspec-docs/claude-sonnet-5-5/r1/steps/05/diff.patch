   }
   return result;
 }
+
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: JsonValue }
+  | { op: "remove"; path: string };
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: PatchOperation[]): void {
+  // Longest common subsequence, so that inserted and removed items do not disturb their neighbours.
+  const n = from.length;
+  const m = to.length;
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = deepEqual(from[i], to[j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  // `pos` is the index in the array being patched, which equals the index in `to` at each step.
+  let pos = 0;
+  let i = 0;
+  let j = 0;
+  while (i < n || j < m) {
+    if (i < n && j < m && deepEqual(from[i], to[j])) {
+      i++;
+      j++;
+      pos++;
+      continue;
+    }
+    // Collect the run of differing items up to the next common item.
+    const gapFrom: unknown[] = [];
+    const gapTo: unknown[] = [];
+    while (i < n || j < m) {
+      if (i < n && j < m && deepEqual(from[i], to[j])) {
+        break;
+      }
+      if (i < n && (j >= m || lcs[i + 1][j] >= lcs[i][j + 1])) {
+        gapFrom.push(from[i++]);
+      } else {
+        gapTo.push(to[j++]);
+      }
+    }
+    const paired = Math.min(gapFrom.length, gapTo.length);
+    for (let k = 0; k < paired; k++) {
+      diffValues(gapFrom[k], gapTo[k], `${path}/${pos + k}`, ops);
+    }
+    for (let k = paired; k < gapFrom.length; k++) {
+      ops.push({ op: "remove", path: `${path}/${pos + paired}` });
+    }
+    for (let k = paired; k < gapTo.length; k++) {
+      ops.push({ op: "add", path: `${path}/${pos + k}`, value: clone(gapTo[k]) as JsonValue });
+    }
+    pos += gapTo.length;
+  }
+}
+
+function diffValues(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) {
+        ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(from, key)) {
+        diffValues(from[key], to[key], child, ops);
+      } else {
+        ops.push({ op: "add", path: child, value: clone(to[key]) as JsonValue });
+      }
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) as JsonValue });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied. Neither input is mutated.
+ * The patch is minimal in granularity: only the differing members and array items are touched.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffValues(from, to, "", ops);
+  return ops;
+}
diff --git a/test/createpatch.test.ts b/test/createpatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..18e9ffb9e3d5cc25f6807a490ce7a18f9a8bdf83
--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,42 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createPatch, applyPatch } from "../src/index.ts";
+
+function check(from: unknown, to: unknown, expected?: unknown) {
+  const a = structuredClone(from);
+  const b = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, a);
+  assert.deepEqual(to, b);
+  assert.deepEqual(applyPatch(from, patch), to);
+  if (expected !== undefined) assert.deepEqual(patch, expected);
+}
+
+test("identical documents give an empty patch", () => check({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }, []));
+test("small nested change", () =>
+  check({ a: { b: 1, c: [1, 2] }, d: 1 }, { a: { b: 2, c: [1, 2] }, d: 1 }, [
+    { op: "replace", path: "/a/b", value: 2 },
+  ]));
+test("root replacement", () => check(1, { a: 1 }, [{ op: "replace", path: "", value: { a: 1 } }]));
+test("escaping and member add/remove", () =>
+  check({ "a/b": 1, "~": 2 }, { "~": 2, "c/d": 3 }, [
+    { op: "remove", path: "/a~1b" },
+    { op: "add", path: "/c~1d", value: 3 },
+  ]));
+test("array insert", () => check([1, 2, 3], [1, 9, 2, 3], [{ op: "add", path: "/1", value: 9 }]));
+test("array removal", () => check([1, 2, 3, 4], [1, 3, 4], [{ op: "remove", path: "/1" }]));
+test("array move", () => {
+  check([1, 2, 3, 4], [1, 3, 4, 2]);
+  assert.ok(createPatch([1, 2, 3, 4], [1, 3, 4, 2]).length <= 2);
+});
+test("array item changed in place", () =>
+  check([{ a: 1 }, { b: 2 }], [{ a: 1 }, { b: 3 }], [{ op: "replace", path: "/1/b", value: 3 }]));
+test("array to different type and null", () => {
+  check([1], { a: 1 });
+  check({ a: null }, { a: [] });
+  check([], [[1], [2]]);
+});
+test("random roundtrips", () => {
+  const rnd = () => Array.from({ length: Math.floor(Math.random() * 8) }, () => Math.floor(Math.random() * 4));
+  for (let i = 0; i < 300; i++) check({ x: rnd() }, { x: rnd() });
+});
