   }
   return result;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the merged document.
+ * Neither input is mutated. A non-object patch replaces the target; in an object patch, a null
+ * member removes the corresponding target member and any other member is merged recursively.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return clone(patch);
+  }
+  const result: Record<string, unknown> = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) {
+      setMember(result, key, clone(target[key]));
+    }
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(Object.hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fdfdbc7dd1abca8ca5a1fb89135b32496a61f0f9
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,25 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 example", () => {
+  const target = { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["example", "sample"], content: "x" };
+  const patch = { title: "Hello!", phoneNumber: "+01-123-456-7890", author: { familyName: null }, tags: ["example"] };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!", author: { givenName: "John" }, tags: ["example"], content: "x", phoneNumber: "+01-123-456-7890",
+  });
+  assert.equal(target.author.familyName, "Doe");
+});
+
+test("non-object patch replaces; nulls dropped in new objects", () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, [1]), [1]);
+  assert.deepEqual(applyMergePatch([1], { a: 1 }), { a: 1 });
+  assert.deepEqual(applyMergePatch({}, { a: { b: null, c: 1 } }), { a: { c: 1 } });
+  assert.equal(applyMergePatch({ a: 1 }, null), null);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const out = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as object;
+  assert.equal(Object.hasOwn(out, "__proto__"), true);
+  assert.equal(({} as any).x, undefined);
+});
