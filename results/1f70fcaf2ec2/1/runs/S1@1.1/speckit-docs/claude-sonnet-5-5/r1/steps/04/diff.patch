+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the result as a new value.
+ * The input document and patch are not mutated.
+ *
+ * A non-object patch replaces the target; in an object patch, a `null` member removes the member from
+ * the target and any other member is merged recursively. Arrays are replaced, not merged.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return clone(patch);
+  }
+  const result: Record<string, unknown> = isObject(target) ? clone(target) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
diff --git a/test/merge-patch.test.ts b/test/merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f712cf54db87f948922d8b4d5997d69df1c418cc
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,33 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, e] of cases) assert.deepEqual(applyMergePatch(t, p), e);
+});
+
+test("does not mutate inputs and handles __proto__", () => {
+  const t = { a: { b: 1 } };
+  const p = JSON.parse('{"a":{"c":2},"__proto__":{"x":1}}');
+  const r = applyMergePatch(t, p) as Record<string, unknown>;
+  assert.deepEqual(t, { a: { b: 1 } });
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+  assert.deepEqual(Object.keys(r), ["a", "__proto__"]);
+});
