diff --git a/src/index.ts b/src/index.ts
index dbd59c7fe0e9026d9a79f768c8d36c0a4587a971..e65eee90cf2aacde51e233843e977f71cefb54d5 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -46,3 +46,190 @@ function unescapeToken(token: string, pointer: string): string {
   // Single pass, so that "~01" becomes "~1" and not "/".
   return token.replace(/~([01])/g, (_, c: string) => (c === "0" ? "~" : "/"));
 }
+
+type Container = Record<string, unknown> | unknown[];
+
+const hasOwn = (o: object, k: string): boolean => Object.prototype.hasOwnProperty.call(o, k);
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty so that a "__proto__" member is an ordinary own member.
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone<T>(value: T): T {
+  if (Array.isArray(value)) {
+    return value.map(clone) as T;
+  }
+  if (isObject(value)) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) {
+      setMember(copy, key, clone(value[key]));
+    }
+    return copy as T;
+  }
+  return value;
+}
+
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((k) => hasOwn(b, k) && jsonEqual(a[k], b[k]));
+  }
+  return a === b;
+}
+
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new TypeError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new SyntaxError(`Invalid JSON Pointer: must be empty or start with "/": ${JSON.stringify(pointer)}`);
+  }
+  return pointer.slice(1).split("/").map((t) => unescapeToken(t, pointer));
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (allowEnd && token === "-") return length;
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`"${token}" is not a valid array index`);
+  }
+  const index = Number(token);
+  if (allowEnd ? index > length : index >= length) {
+    throw new Error(`array index ${token} is out of range`);
+  }
+  return index;
+}
+
+/** Returns the container holding the target of `tokens` (which must be non-empty). */
+function parentOf(root: unknown, tokens: string[]): Container {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      current = current[arrayIndex(token, current.length, false)];
+    } else if (isObject(current) && hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`path does not resolve at "${token}"`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new Error("path does not resolve: parent is not a container");
+  }
+  return current;
+}
+
+function getValue(root: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) return root;
+  const parent = parentOf(root, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) return parent[arrayIndex(token, parent.length, false)];
+  if (!hasOwn(parent, token)) throw new Error(`no member "${token}"`);
+  return parent[token];
+}
+
+function addValue(root: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(token, parent.length, true), 0, value);
+  } else {
+    setMember(parent, token, value);
+  }
+  return root;
+}
+
+function removeValue(root: unknown, tokens: string[]): { root: unknown; removed: unknown } {
+  if (tokens.length === 0) {
+    // Removing the whole document leaves no document; RFC 6902 does not define it.
+    throw new Error("cannot remove the root of the document");
+  }
+  const parent = parentOf(root, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    return { root, removed: parent.splice(arrayIndex(token, parent.length, false), 1)[0] };
+  }
+  if (!hasOwn(parent, token)) throw new Error(`no member "${token}"`);
+  const removed = parent[token];
+  delete parent[token];
+  return { root, removed };
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result as a new value.
+ * The input document and patch are not mutated.
+ *
+ * Throws if the patch is malformed or if any operation fails (the whole patch is then discarded).
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new TypeError("JSON Patch must be an array of operations");
+  }
+  let result = clone(document);
+
+  patch.forEach((operation: unknown, i: number) => {
+    try {
+      if (!isObject(operation)) throw new TypeError("operation must be an object");
+      const { op } = operation;
+      const path = parsePointer(operation.path);
+      const needValue = op === "add" || op === "replace" || op === "test";
+      const needFrom = op === "move" || op === "copy";
+      if (!needValue && !needFrom && op !== "remove") {
+        throw new Error(`unknown op ${JSON.stringify(op)}`);
+      }
+      if (needValue && !hasOwn(operation, "value")) throw new Error(`"${op}" requires a "value"`);
+      const from = needFrom ? parsePointer(operation.from) : [];
+
+      switch (op) {
+        case "add":
+          result = addValue(result, path, clone(operation.value));
+          break;
+        case "remove":
+          result = removeValue(result, path).root;
+          break;
+        case "replace":
+          getValue(result, path); // must exist
+          if (path.length === 0) {
+            result = clone(operation.value);
+          } else {
+            result = removeValue(result, path).root;
+            result = addValue(result, path, clone(operation.value));
+          }
+          break;
+        case "move": {
+          if (from.length < path.length && from.every((t, k) => t === path[k])) {
+            throw new Error('"from" must not be a proper prefix of "path"');
+          }
+          getValue(result, from);
+          if (from.length === path.length && from.every((t, k) => t === path[k])) break;
+          const removed = removeValue(result, from);
+          result = addValue(removed.root, path, removed.removed);
+          break;
+        }
+        case "copy":
+          result = addValue(result, path, clone(getValue(result, from)));
+          break;
+        case "test":
+          if (!jsonEqual(getValue(result, path), operation.value)) {
+            throw new Error("test failed: value does not match");
+          }
+          break;
+      }
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      throw new (error instanceof TypeError || error instanceof SyntaxError ? error.constructor as ErrorConstructor : Error)(
+        `Patch operation ${i} failed: ${message}`,
+      );
+    }
+  });
+  return result;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7fce7d648080d6856009cd368f678bbad96f245a
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,74 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) => assert.deepEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch));
+
+test("add", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ foo: ["a"] }, [{ op: "add", path: "/foo/-", value: "b" }], { foo: ["a", "b"] });
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  bad({ foo: ["a"] }, [{ op: "add", path: "/foo/3", value: 1 }]);
+  bad({ foo: ["a"] }, [{ op: "add", path: "/foo/01", value: 1 }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+});
+
+test("remove and replace", () => {
+  ok({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }], { b: 2 });
+  ok([1, 2, 3], [{ op: "remove", path: "/1" }], [1, 3]);
+  bad({ a: 1 }, [{ op: "remove", path: "/b" }]);
+  bad([1], [{ op: "remove", path: "/-" }]);
+  ok({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }], { a: 2 });
+  ok([1, 2], [{ op: "replace", path: "/1", value: 9 }], [1, 9]);
+  ok(1, [{ op: "replace", path: "", value: 2 }], 2);
+  bad({ a: 1 }, [{ op: "replace", path: "/b", value: 2 }]);
+});
+
+test("move and copy", () => {
+  ok({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }],
+    { foo: ["all", "cows", "eat", "grass"] });
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  bad({}, [{ op: "move", from: "/x", path: "/y" }]);
+  const src = { a: { b: 1 } };
+  const out = applyPatch(src, [{ op: "copy", from: "/a", path: "/c" }]) as any;
+  out.c.b = 2;
+  assert.equal(out.a.b, 1);
+  bad({}, [{ op: "copy", from: "/x", path: "/y" }]);
+});
+
+test("test", () => {
+  ok({ a: { x: 1, y: [1, 2] } }, [{ op: "test", path: "/a", value: { y: [1, 2], x: 1 } }], { a: { x: 1, y: [1, 2] } });
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+  bad({ a: 1 }, [{ op: "test", path: "/b", value: null }]);
+  ok({ a: null }, [{ op: "test", path: "/a", value: null }], { a: null });
+});
+
+test("invalid patches and immutability", () => {
+  bad({}, {});
+  bad({}, [1]);
+  bad({}, [{ op: "nope", path: "" }]);
+  bad({}, [{ op: "remove" }]);
+  bad({}, [{ op: "move", path: "/a" }]);
+  bad({}, [{ op: "remove", path: "a" }]);
+  const doc = { a: [1, { b: 2 }] };
+  const snapshot = JSON.stringify(doc);
+  const patch = [{ op: "add", path: "/c", value: { d: 1 } }, { op: "remove", path: "/a/0" }];
+  const out = applyPatch(doc, patch) as any;
+  out.c.d = 5;
+  assert.equal(JSON.stringify(doc), snapshot);
+  assert.deepEqual(patch[0].value, { d: 1 });
+  bad(doc, [{ op: "remove", path: "/a/0" }, { op: "remove", path: "/zz" }]);
+  assert.equal(JSON.stringify(doc), snapshot);
+});
+
+test("__proto__ member is plain data", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as any;
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(({} as any).x, undefined);
+});
