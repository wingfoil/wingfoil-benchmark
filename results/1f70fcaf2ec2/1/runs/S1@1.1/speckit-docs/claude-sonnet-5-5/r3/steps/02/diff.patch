index e5b59885cf0d0d045156c15f3b342cd82541e884..8f4e0e5e15bcdc0fe491f91927766f76536c8819 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -51,3 +51,174 @@ export function resolvePointer(document: unknown, pointer: string): any {
   }
   return current;
 }
+
+function parseTokens(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new Error("Invalid JSON Pointer: must be empty or start with '/'");
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+function isObject(value: unknown): value is Record<string, JsonValue> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function has(object: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(object, key);
+}
+
+function setMember(object: Record<string, JsonValue>, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => deepEqual(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => has(b, key) && deepEqual(a[key], b[key]))
+    );
+  }
+  return false;
+}
+
+function parentOf(root: JsonValue, tokens: string[]): JsonValue {
+  let current: JsonValue = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`Path does not exist at "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (isObject(current) && has(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path does not exist at "${token}"`);
+    }
+  }
+  return current;
+}
+
+function getValue(root: JsonValue, tokens: string[]): JsonValue {
+  if (tokens.length === 0) return root;
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(last) || Number(last) >= parent.length) {
+      throw new Error(`Path does not exist at "${last}"`);
+    }
+    return parent[Number(last)];
+  }
+  if (isObject(parent) && has(parent, last)) return parent[last];
+  throw new Error(`Path does not exist at "${last}"`);
+}
+
+function addValue(root: JsonValue, tokens: string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (last === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(last) && Number(last) <= parent.length) {
+      parent.splice(Number(last), 0, value);
+    } else {
+      throw new Error(`Invalid array index "${last}"`);
+    }
+  } else if (isObject(parent)) {
+    setMember(parent, last, value);
+  } else {
+    throw new Error("Cannot add to a scalar");
+  }
+  return root;
+}
+
+function removeValue(root: JsonValue, tokens: string[]): JsonValue {
+  getValue(root, tokens); // throws if the target does not exist
+  if (tokens.length === 0) {
+    throw new Error("Cannot remove the document root");
+  }
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete (parent as Record<string, JsonValue>)[last];
+  return root;
+}
+
+const OPERATIONS = ["add", "remove", "replace", "move", "copy", "test"];
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result as a new value.
+ * The input document and patch are not mutated. Throws if the patch is invalid or an
+ * operation fails; in that case no partial result is returned.
+ */
+export function applyPatch(document: JsonValue, patch: unknown): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: not an array");
+  }
+  let result: JsonValue = structuredClone(document);
+
+  for (const op of patch) {
+    if (!isObject(op)) throw new Error("Invalid JSON Patch: operation is not an object");
+    const name = op.op;
+    if (typeof name !== "string" || !OPERATIONS.includes(name)) {
+      throw new Error(`Invalid JSON Patch: unknown operation "${String(name)}"`);
+    }
+    const path = parseTokens(op.path);
+    if ((name === "add" || name === "replace" || name === "test") && !has(op, "value")) {
+      throw new Error(`Invalid JSON Patch: "${name}" requires a "value"`);
+    }
+    const value = op.value as JsonValue;
+
+    switch (name) {
+      case "add":
+        result = addValue(result, path, structuredClone(value));
+        break;
+      case "remove":
+        result = removeValue(result, path);
+        break;
+      case "replace":
+        getValue(result, path);
+        result = path.length === 0 ? structuredClone(value) : addReplace(result, path, structuredClone(value));
+        break;
+      case "move":
+      case "copy": {
+        const from = parseTokens(op.from);
+        const moved = structuredClone(getValue(result, from));
+        if (name === "copy") {
+          result = addValue(result, path, moved);
+          break;
+        }
+        const isPrefix = from.length < path.length && from.every((t, i) => t === path[i]);
+        if (isPrefix) throw new Error("Cannot move a value into one of its children");
+        if (from.length === path.length && from.every((t, i) => t === path[i])) break;
+        result = removeValue(result, from);
+        result = addValue(result, path, moved);
+        break;
+      }
+      case "test":
+        if (!deepEqual(getValue(result, path), value)) {
+          throw new Error(`Test failed at "${op.path}"`);
+        }
+        break;
+    }
+  }
+  return result;
+}
+
+function addReplace(root: JsonValue, tokens: string[], value: JsonValue): JsonValue {
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(last)] = value;
+  else setMember(parent as Record<string, JsonValue>, last, value);
+  return root;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7664ef087630137ba2478085a09d318374183b58
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,48 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("add/remove/replace", () => {
+  const doc = { foo: "bar", a: [1, 2] };
+  const out = applyPatch(doc, [
+    { op: "add", path: "/baz", value: "qux" },
+    { op: "add", path: "/a/1", value: 9 },
+    { op: "add", path: "/a/-", value: 3 },
+    { op: "remove", path: "/foo" },
+    { op: "replace", path: "/baz", value: "boo" },
+  ]);
+  assert.deepEqual(out, { a: [1, 9, 2, 3], baz: "boo" });
+  assert.deepEqual(doc, { foo: "bar", a: [1, 2] });
+});
+
+test("move/copy/test", () => {
+  const out = applyPatch({ a: { b: 1 }, c: [1, 2, 3] }, [
+    { op: "move", path: "/d", from: "/a/b" },
+    { op: "copy", path: "/e", from: "/c" },
+    { op: "move", path: "/c/0", from: "/c/2" },
+    { op: "test", path: "/e", value: [1, 2, 3] },
+    { op: "test", path: "/a", value: {} },
+  ]);
+  assert.deepEqual(out, { a: {}, c: [3, 1, 2], d: 1, e: [1, 2, 3] });
+});
+
+test("errors", () => {
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/a", value: 1 }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]));
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/2", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/01", value: 1 }]));
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "bogus", path: "/a" }]));
+  assert.throws(() => applyPatch({}, {} as any));
+});
+
+test("root and special keys", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  const out: any = applyPatch({}, [{ op: "add", path: "/__proto__", value: 1 }]);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(Object.keys(out)[0], "__proto__");
+});
