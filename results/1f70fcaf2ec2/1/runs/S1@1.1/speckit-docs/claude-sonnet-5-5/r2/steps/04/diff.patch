--- a/src/index.ts
+++ b/src/index.ts
@@ -217,3 +217,29 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isPlainObject(patch)) return structuredClone(patch);
+  const result: Record<string, unknown> = isPlainObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, mergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
+
+/**
+ * Apply a JSON Merge Patch (RFC 7386) to a JSON document and return the result.
+ * The input target and patch are never mutated.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return mergePatch(structuredClone(target), patch);
+}
diff --git a/test/merge-patch.test.ts b/test/merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..843dccbc6524b2c0d65907a9a53c005dde8ddd56
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,25 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix example", () => {
+  const target = { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["example", "sample"], content: "x" };
+  const patch = { title: "Hello!", phoneNumber: "+01-123-456-7890", author: { familyName: null }, tags: ["example"] };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!", author: { givenName: "John" }, tags: ["example"], content: "x", phoneNumber: "+01-123-456-7890",
+  });
+  assert.equal(target.author.familyName, "Doe");
+});
+
+test("non-object patch replaces target; non-object target becomes object", () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, [1]), [1]);
+  assert.equal(applyMergePatch({ a: 1 }, null), null);
+  assert.deepEqual(applyMergePatch([1], { a: 1 }), { a: 1 });
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: { b: { c: null } } }), { a: { b: {} } });
+});
+
+test("__proto__ is data", () => {
+  const r = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as object;
+  assert.equal(Object.getPrototypeOf(r), Object.prototype);
+  assert.deepEqual(Object.keys(r), ["__proto__"]);
+});
