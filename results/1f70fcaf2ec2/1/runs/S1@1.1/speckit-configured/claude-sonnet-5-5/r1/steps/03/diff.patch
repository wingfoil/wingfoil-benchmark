+
+/** Replaces the value at an existing location in place (RFC 6902 section 4.3). */
+function replace(root: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const key = tokens[tokens.length - 1];
+  const parent = container(root, tokens.slice(0, -1), pointer);
+  child(parent, key, pointer);
+  if (Array.isArray(parent)) {
+    parent[Number(key)] = value;
+  } else {
+    setMember(parent, key, value);
+  }
+  return root;
+}
