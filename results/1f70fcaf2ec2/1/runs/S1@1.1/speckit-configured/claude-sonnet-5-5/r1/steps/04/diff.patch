diff --git a/src/merge-patch.ts b/src/merge-patch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..40b8b06fbe12f94b3d3ab3487afbb7474a1e6d30
--- /dev/null
+++ b/src/merge-patch.ts
@@ -0,0 +1,59 @@
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty creates an own member even for "__proto__", which plain assignment would not.
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone(value: unknown): unknown {
+  if (Array.isArray(value)) {
+    return value.map(clone);
+  }
+  if (isObject(value)) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) {
+      setMember(copy, key, clone(value[key]));
+    }
+    return copy;
+  }
+  return value;
+}
+
+function own(object: Record<string, unknown>, key: string): unknown {
+  return Object.hasOwn(object, key) ? object[key] : undefined;
+}
+
+function merge(target: unknown, patch: unknown): unknown {
+  if (Array.isArray(patch)) {
+    return clone(patch);
+  }
+  if (!isObject(patch)) {
+    return patch;
+  }
+  const result: Record<string, unknown> = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) {
+      setMember(result, key, clone(target[key]));
+    }
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, merge(own(result, key), value));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7396, section 2) to a JSON document and returns the merged document.
+ * An object patch is merged member by member (`null` removes a member); any other patch replaces the target.
+ * Neither argument is modified and the result shares no structure with them.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return merge(target, patch);
+}
diff --git a/test/merge-patch.test.js b/test/merge-patch.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..9d9fc2aa5e80431c0b1fb113919b08512d409458
--- /dev/null
+++ b/test/merge-patch.test.js
@@ -0,0 +1,80 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { applyMergePatch } from "../dist/index.js";
+
+test("RFC 7396 section 3 example", () => {
+  const target = { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["example", "sample"], content: "This will be unchanged" };
+  const patch = { title: "Hello!", phoneNumber: "+01-123-456-7890", author: { familyName: null }, tags: ["example"] };
+  assert.deepStrictEqual(applyMergePatch(target, patch), {
+    title: "Hello!", author: { givenName: "John" }, tags: ["example"], content: "This will be unchanged", phoneNumber: "+01-123-456-7890",
+  });
+});
+
+test("RFC 7396 Appendix A cases", () => {
+  const cases = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, r] of cases) assert.deepStrictEqual(applyMergePatch(t, p), r);
+});
+
+test("primitives and empty patch", () => {
+  assert.deepStrictEqual(applyMergePatch(1, {}), {});
+  assert.deepStrictEqual(applyMergePatch({ a: 1 }, {}), { a: 1 });
+  assert.strictEqual(applyMergePatch({ a: 1 }, 5), 5);
+});
+
+test("does not mutate or share structure", () => {
+  const target = { a: { b: 1 }, l: [1] };
+  const patch = { a: { c: 2 }, n: { x: [1, { y: 1 }] }, arr: [{ z: 1 }] };
+  const t0 = structuredClone(target), p0 = structuredClone(patch);
+  const r = applyMergePatch(target, patch);
+  assert.deepStrictEqual(target, t0);
+  assert.deepStrictEqual(patch, p0);
+  assert.notStrictEqual(r.a, target.a);
+  assert.notStrictEqual(r.l, target.l);
+  assert.notStrictEqual(r.n, patch.n);
+  assert.notStrictEqual(r.n.x[1], patch.n.x[1]);
+  assert.notStrictEqual(r.arr, patch.arr);
+  assert.notStrictEqual(applyMergePatch({}, [{ q: 1 }])[0], undefined);
+});
+
+test("prototype pollution safe", () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true},"constructor":{"prototype":{"p2":1}},"a":{"__proto__":{"p3":1}}}');
+  const r = applyMergePatch({}, patch);
+  assert.strictEqual({}.polluted, undefined);
+  assert.strictEqual({}.p2, undefined);
+  assert.strictEqual(Object.getPrototypeOf(r), Object.prototype);
+  assert.deepStrictEqual(Object.keys(r), ["__proto__", "constructor", "a"]);
+  assert.deepStrictEqual(Object.getOwnPropertyDescriptor(r, "__proto__").value, { polluted: true });
+  const r2 = applyMergePatch(JSON.parse('{"__proto__":{"k":1}}'), JSON.parse('{"__proto__":{"k":null}}'));
+  assert.deepStrictEqual(Object.getOwnPropertyDescriptor(r2, "__proto__").value, {});
+});
+
+test("inherited members are not read", () => {
+  const r = applyMergePatch({}, { toString: { a: 1 } });
+  assert.deepStrictEqual(r, { toString: { a: 1 } });
+  assert.deepStrictEqual(applyMergePatch({}, { toString: null }), {});
+});
+
+test("member order preserved", () => {
+  assert.deepStrictEqual(Object.keys(applyMergePatch({ a: 1, b: 2 }, { a: 3, c: 4 })), ["a", "b", "c"]);
+});
+
+test("nulls inside arrays and untouched target members are kept", () => {
+  assert.deepStrictEqual(applyMergePatch({}, { a: [{ b: null }] }), { a: [{ b: null }] });
+  assert.deepStrictEqual(applyMergePatch({ k: { x: null } }, { z: 1 }), { k: { x: null }, z: 1 });
+});
