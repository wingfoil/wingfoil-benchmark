@@ -0,0 +1,57 @@
+/** Error thrown when a JSON Pointer is invalid or does not resolve to a value of the document. */
+export class PointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "PointerError";
+  }
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function decodeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new PointerError(`Invalid escape in reference token "${token}": "~" must be followed by "0" or "1"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/**
+ * Resolves a JSON Pointer against a JSON document and returns the referenced value.
+ *
+ * Implements JSON Pointer, RFC 6901: syntax (section 3) and evaluation (section 4). The URI fragment
+ * representation (section 6) is not supported. Only own members are followed, so keys such as
+ * `__proto__` or `constructor` never reach inherited values. The document is not modified and the
+ * referenced value is returned as is, not copied.
+ *
+ * @throws {PointerError} if `pointer` is not a valid JSON Pointer, or does not resolve to a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new PointerError("A JSON Pointer must be a string");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (pointer[0] !== "/") {
+    throw new PointerError(`Invalid JSON Pointer "${pointer}": a non-empty pointer must start with "/"`);
+  }
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+
+  let current: unknown = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new PointerError(`"${token}" is not an existing index of the array`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new PointerError(`The object has no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new PointerError(`Cannot resolve "${token}": the value is not an object or an array`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.js b/test/pointer.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..579b4620284f348a7e7cce75e75188ffb2c593f5
--- /dev/null
+++ b/test/pointer.test.js
@@ -0,0 +1,114 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { resolvePointer, PointerError } from "../dist/index.js";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.strictEqual(resolvePointer(rfc, ""), rfc);
+  assert.deepStrictEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.strictEqual(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.strictEqual(resolvePointer(rfc, "/"), 0);
+  assert.strictEqual(resolvePointer(rfc, "/a~1b"), 1);
+  assert.strictEqual(resolvePointer(rfc, "/c%d"), 2);
+  assert.strictEqual(resolvePointer(rfc, "/e^f"), 3);
+  assert.strictEqual(resolvePointer(rfc, "/g|h"), 4);
+  assert.strictEqual(resolvePointer(rfc, "/i\\j"), 5);
+  assert.strictEqual(resolvePointer(rfc, '/k"l'), 6);
+  assert.strictEqual(resolvePointer(rfc, "/ "), 7);
+  assert.strictEqual(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("escape order: ~01 is ~1", () => {
+  assert.strictEqual(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+});
+
+test("empty pointer returns any document, including primitives and null", () => {
+  assert.strictEqual(resolvePointer(null, ""), null);
+  assert.strictEqual(resolvePointer(5, ""), 5);
+});
+
+test("null is a value, not missing", () => {
+  assert.strictEqual(resolvePointer({ a: null }, "/a"), null);
+  assert.throws(() => resolvePointer({ a: null }, "/b"), PointerError);
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"), PointerError);
+});
+
+test("invalid syntax", () => {
+  for (const p of ["foo", "a/b", "~0", "#/a"]) {
+    assert.throws(() => resolvePointer({}, p), PointerError, p);
+  }
+  assert.throws(() => resolvePointer({}, undefined), PointerError);
+  assert.throws(() => resolvePointer({}, 1), PointerError);
+});
+
+test("invalid escapes", () => {
+  for (const p of ["/a~", "/a~2", "/~", "/~a/b", "/a/b~"]) {
+    assert.throws(() => resolvePointer({ a: { b: 1 } }, p), PointerError, p);
+  }
+});
+
+test("arrays", () => {
+  const doc = [10, 20, 30];
+  assert.strictEqual(resolvePointer(doc, "/0"), 10);
+  assert.strictEqual(resolvePointer(doc, "/2"), 30);
+  for (const p of ["/3", "/-", "/01", "/00", "/+1", "/-1", "/1.0", "/1e0", "/a", "/", "/length", "/ 1", "/0x1"]) {
+    assert.throws(() => resolvePointer(doc, p), PointerError, p);
+  }
+  const big = Array.from({ length: 12 }, (_, i) => i);
+  assert.strictEqual(resolvePointer(big, "/10"), 10);
+});
+
+test("empty-string key and numeric-looking object keys", () => {
+  assert.strictEqual(resolvePointer({ "": { "": 1 } }, "//"), 1);
+  assert.strictEqual(resolvePointer({ "01": "a", "0": "b" }, "/01"), "a");
+});
+
+test("primitives cannot be descended into", () => {
+  for (const d of [{ a: "str" }, { a: 1 }, { a: true }]) {
+    assert.throws(() => resolvePointer(d, "/a/0"), PointerError);
+    assert.throws(() => resolvePointer(d, "/a/length"), PointerError);
+  }
+});
+
+test("only own properties resolve", () => {
+  for (const k of ["__proto__", "constructor", "prototype", "toString", "hasOwnProperty"]) {
+    assert.throws(() => resolvePointer({}, "/" + k), PointerError, k);
+    assert.throws(() => resolvePointer([], "/" + k), PointerError, k);
+  }
+  assert.throws(() => resolvePointer({ a: 1 }, "/constructor/name"), PointerError);
+  const own = JSON.parse('{"__proto__": {"x": 1}, "constructor": 2}');
+  assert.deepStrictEqual(resolvePointer(own, "/__proto__"), { x: 1 });
+  assert.strictEqual(resolvePointer(own, "/__proto__/x"), 1);
+  assert.strictEqual(resolvePointer(own, "/constructor"), 2);
+});
+
+test("does not mutate and returns the referenced value", () => {
+  const doc = { a: [{ b: 1 }] };
+  const snapshot = structuredClone(doc);
+  assert.strictEqual(resolvePointer(doc, "/a/0"), doc.a[0]);
+  assert.deepStrictEqual(doc, snapshot);
+  assert.strictEqual(Object.prototype.hasOwnProperty.call(Object.prototype, "x"), false);
+});
+
+test("errors are PointerError instances", () => {
+  try {
+    resolvePointer({}, "/x");
+    assert.fail();
+  } catch (e) {
+    assert.ok(e instanceof PointerError);
+    assert.ok(e instanceof Error);
+    assert.strictEqual(e.name, "PointerError");
+  }
+});
