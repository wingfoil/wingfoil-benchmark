@@ -0,0 +1,192 @@
+import { ARRAY_INDEX, parsePointer } from "./pointer.js";
+
+/** Error thrown when a JSON Patch is invalid or one of its operations fails. */
+export class PatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "PatchError";
+  }
+}
+
+type Container = Record<string, unknown> | unknown[];
+
+const OPS = ["add", "remove", "replace", "move", "copy", "test"];
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty creates an own member even for "__proto__", which plain assignment would not.
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone(value: unknown): unknown {
+  if (Array.isArray(value)) {
+    return value.map(clone);
+  }
+  if (isObject(value)) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) {
+      setMember(copy, key, clone(value[key]));
+    }
+    return copy;
+  }
+  return value;
+}
+
+/** Structural equality of JSON values (RFC 6902 section 4.6). */
+function equal(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => equal(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((k) => Object.hasOwn(b, k) && equal(a[k], b[k]));
+  }
+  return a === b;
+}
+
+function container(root: unknown, tokens: string[], pointer: string): Container {
+  let current = root;
+  for (const token of tokens) {
+    current = child(current, token, pointer);
+  }
+  if (typeof current !== "object" || current === null) {
+    throw new PatchError(`The parent of "${pointer}" is not an object or an array`);
+  }
+  return current as Container;
+}
+
+function child(parent: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= parent.length) {
+      throw new PatchError(`"${token}" in "${pointer}" is not an existing index of the array`);
+    }
+    return parent[Number(token)];
+  }
+  if (isObject(parent) && Object.hasOwn(parent, token)) {
+    return parent[token];
+  }
+  throw new PatchError(`"${pointer}" does not exist in the document`);
+}
+
+function get(root: unknown, pointer: string): unknown {
+  let current = root;
+  for (const token of parsePointer(pointer)) {
+    current = child(current, token, pointer);
+  }
+  return current;
+}
+
+function add(root: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const key = tokens[tokens.length - 1];
+  const parent = container(root, tokens.slice(0, -1), pointer);
+  if (Array.isArray(parent)) {
+    if (key === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(key) && Number(key) <= parent.length) {
+      parent.splice(Number(key), 0, value);
+    } else {
+      throw new PatchError(`"${key}" in "${pointer}" is not a valid index to add to the array`);
+    }
+  } else {
+    setMember(parent, key, value);
+  }
+  return root;
+}
+
+function remove(root: unknown, pointer: string): { root: unknown; removed: unknown } {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    throw new PatchError("The whole document cannot be removed");
+  }
+  const key = tokens[tokens.length - 1];
+  const parent = container(root, tokens.slice(0, -1), pointer);
+  const removed = child(parent, key, pointer);
+  if (Array.isArray(parent)) {
+    parent.splice(Number(key), 1);
+  } else {
+    delete parent[key];
+  }
+  return { root, removed };
+}
+
+/**
+ * Applies a JSON Patch to a JSON document and returns the resulting document.
+ *
+ * Implements JSON Patch, RFC 6902: the operations `add`, `remove`, `replace`, `move`, `copy` and `test`
+ * (section 4), applied in order, each to the result of the previous one (section 5). Paths are JSON
+ * Pointers (RFC 6901). Neither `document` nor `patch` is modified and the result shares no structure
+ * with them. The patch is atomic: if it is invalid or any operation fails, nothing is returned.
+ * Removing the whole document (`remove` with path `""`) is rejected, since no document would remain.
+ *
+ * @throws {PatchError} if the patch is invalid or an operation fails (including a failed `test`).
+ * @throws {PointerError} if a `path` or `from` is not a valid JSON Pointer.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new PatchError("A JSON Patch must be an array of operations");
+  }
+  let result = clone(document);
+  patch.forEach((operation: unknown, index: number) => {
+    if (!isObject(operation)) {
+      throw new PatchError(`Operation ${index} is not an object`);
+    }
+    const { op, path, from } = operation;
+    if (typeof op !== "string" || !OPS.includes(op)) {
+      throw new PatchError(`Operation ${index} has a missing or unknown "op"`);
+    }
+    if (typeof path !== "string") {
+      throw new PatchError(`Operation ${index} ("${op}") needs a string "path"`);
+    }
+    const needsValue = op === "add" || op === "replace" || op === "test";
+    if (needsValue && !Object.hasOwn(operation, "value")) {
+      throw new PatchError(`Operation ${index} ("${op}") needs a "value"`);
+    }
+    if ((op === "move" || op === "copy") && typeof from !== "string") {
+      throw new PatchError(`Operation ${index} ("${op}") needs a string "from"`);
+    }
+    const value = operation.value;
+    switch (op) {
+      case "add":
+        result = add(result, path, clone(value));
+        break;
+      case "remove":
+        result = remove(result, path).root;
+        break;
+      case "replace":
+        get(result, path);
+        result = parsePointer(path).length === 0 ? clone(value) : add(remove(result, path).root, path, clone(value));
+        break;
+      case "move": {
+        const source = parsePointer(from as string);
+        const target = parsePointer(path);
+        if (source.length < target.length && source.every((t, i) => t === target[i])) {
+          throw new PatchError(`Cannot move "${from}" into one of its own children "${path}"`);
+        }
+        if (from === path) {
+          get(result, path);
+          break;
+        }
+        const moved = remove(result, from as string);
+        result = add(moved.root, path, moved.removed);
+        break;
+      }
+      case "copy":
+        result = add(result, path, clone(get(result, from as string)));
+        break;
+      case "test":
+        if (!equal(get(result, path), value)) {
+          throw new PatchError(`Test failed: the value at "${path}" differs from the expected value`);
+        }
+        break;
+    }
+  });
+  return result;
+}
