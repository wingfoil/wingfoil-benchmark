+import { test } from "node:test";
+import assert from "node:assert";
+import { applyPatch, PatchError, PointerError } from "../dist/index.js";
+
+const ap = (doc, patch) => applyPatch(doc, patch);
+const badPointer = (doc, patch) => assert.throws(() => applyPatch(doc, patch), PointerError);
+const bad = (doc, patch) => assert.throws(() => applyPatch(doc, patch), PatchError);
+
+test("RFC 6902 Appendix A examples", () => {
+  assert.deepStrictEqual(ap({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepStrictEqual(ap({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepStrictEqual(ap({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+  assert.deepStrictEqual(ap({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+  assert.deepStrictEqual(ap({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), { baz: "boo", foo: "bar" });
+  assert.deepStrictEqual(
+    ap({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+  assert.deepStrictEqual(ap({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepStrictEqual(ap({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }]), { baz: "qux", foo: ["a", 2, "c"] });
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  assert.deepStrictEqual(ap({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]), { foo: "bar", child: { grandchild: {} } });
+  assert.deepStrictEqual(ap({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }]), { foo: "bar", baz: "qux" });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  assert.deepStrictEqual(ap({ foo: "bar", baz: ["qux"] }, [{ op: "copy", from: "/foo", path: "/x" }]).x, "bar");
+  assert.deepStrictEqual(ap({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }]), { "/": 9, "~1": 10 });
+  bad({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]);
+  assert.deepStrictEqual(ap({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]), { foo: ["bar", ["abc", "def"]] });
+});
+
+test("root path", () => {
+  assert.deepStrictEqual(ap({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepStrictEqual(ap({ a: 1 }, [{ op: "replace", path: "", value: null }]), null);
+  assert.deepStrictEqual(ap({ a: { b: 1 } }, [{ op: "copy", from: "/a", path: "" }]), { b: 1 });
+  assert.deepStrictEqual(ap({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "" }]), { b: 1 });
+  assert.deepStrictEqual(ap({ a: 1 }, [{ op: "test", path: "", value: { a: 1 } }]), { a: 1 });
+  bad({ a: 1 }, [{ op: "remove", path: "" }]);
+  assert.deepStrictEqual(ap({ a: 1 }, []), { a: 1 });
+});
+
+test("add edge cases", () => {
+  assert.deepStrictEqual(ap([1], [{ op: "add", path: "/1", value: 2 }]), [1, 2]);
+  assert.deepStrictEqual(ap([1], [{ op: "add", path: "/0", value: 0 }]), [0, 1]);
+  bad([1], [{ op: "add", path: "/2", value: 2 }]);
+  bad([1], [{ op: "add", path: "/01", value: 2 }]);
+  bad([1], [{ op: "add", path: "/x", value: 2 }]);
+  assert.deepStrictEqual(ap({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepStrictEqual(ap({}, [{ op: "add", path: "/a", value: null }]), { a: null });
+  bad(5, [{ op: "add", path: "/a", value: 1 }]);
+  bad({ a: null }, [{ op: "add", path: "/a/b", value: 1 }]);
+});
+
+test("remove/replace edge cases", () => {
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad([1], [{ op: "remove", path: "/1" }]);
+  bad([1], [{ op: "remove", path: "/-" }]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad([1], [{ op: "replace", path: "/1", value: 1 }]);
+  assert.deepStrictEqual(ap({ a: 1 }, [{ op: "replace", path: "/a", value: null }]), { a: null });
+});
+
+test("move/copy edge cases", () => {
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  assert.deepStrictEqual(ap({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  bad({ a: 1 }, [{ op: "move", from: "/b", path: "/c" }]);
+  bad({ a: 1 }, [{ op: "copy", from: "/b", path: "/c" }]);
+  const r = ap({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }, { op: "add", path: "/b/y", value: 2 }]);
+  assert.deepStrictEqual(r, { a: { x: 1 }, b: { x: 1, y: 2 } });
+});
+
+test("test operation equality", () => {
+  const eq = (a, b) => ap(null, [{ op: "replace", path: "", value: a }, { op: "test", path: "", value: b }]);
+  eq({ a: 1, b: [1, 2] }, { b: [1, 2], a: 1 });
+  eq(1.0, 1);
+  bad(null, [{ op: "test", path: "", value: 1 }]);
+  assert.throws(() => eq([1, 2], [2, 1]), PatchError);
+  assert.throws(() => eq(1, "1"), PatchError);
+  assert.throws(() => eq(null, {}), PatchError);
+  assert.throws(() => eq({ a: 1 }, { a: 1, b: 2 }), PatchError);
+  assert.throws(() => eq({ a: 1, b: 2 }, { a: 1 }), PatchError);
+  bad({}, [{ op: "test", path: "/a", value: null }]);
+  assert.deepStrictEqual(ap({ a: null }, [{ op: "test", path: "/a", value: null }]), { a: null });
+});
+
+test("invalid patches", () => {
+  bad({}, {});
+  bad({}, null);
+  bad({}, "x");
+  bad({}, [null]);
+  bad({}, [[]]);
+  bad({}, [{ path: "/a", value: 1 }]);
+  bad({}, [{ op: "bogus", path: "/a" }]);
+  bad({}, [{ op: 1, path: "/a" }]);
+  bad({}, [{ op: "add", value: 1 }]);
+  bad({}, [{ op: "add", path: 1, value: 1 }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "/a" }]);
+  bad({}, [{ op: "test", path: "/a" }]);
+  bad({}, [{ op: "remove" }]);
+  bad({ a: 1 }, [{ op: "move", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "copy", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "move", from: 1, path: "/b" }]);
+  badPointer({ a: 1 }, [{ op: "add", path: "a", value: 1 }]);
+  badPointer({ a: 1 }, [{ op: "add", path: "/a~2", value: 1 }]);
+  badPointer({ a: 1 }, [{ op: "move", from: "a", path: "/b" }]);
+});
+
+test("does not mutate inputs and is atomic", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const patch = [{ op: "add", path: "/a/-", value: { z: 1 } }, { op: "remove", path: "/b/c" }, { op: "test", path: "/a/0", value: 99 }];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  bad(doc, patch);
+  assert.deepStrictEqual(doc, docCopy);
+  assert.deepStrictEqual(patch, patchCopy);
+  const ok = ap(doc, patch.slice(0, 2));
+  assert.deepStrictEqual(doc, docCopy);
+  assert.deepStrictEqual(patch, patchCopy);
+  ok.a[2].z = 5;
+  assert.strictEqual(patch[0].value.z, 1);
+  assert.notStrictEqual(ok.a, doc.a);
+});
+
+test("sequential operations", () => {
+  assert.deepStrictEqual(ap({}, [{ op: "add", path: "/a", value: [] }, { op: "add", path: "/a/-", value: 1 }, { op: "copy", from: "/a/0", path: "/b" }]), { a: [1], b: 1 });
+});
+
+test("prototype pollution", () => {
+  const r = ap({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]);
+  assert.strictEqual({}.polluted, undefined);
+  assert.strictEqual(Object.getPrototypeOf(r), Object.prototype);
+  assert.strictEqual(Object.hasOwn(r, "__proto__"), true);
+  assert.strictEqual(Object.getPrototypeOf(r.__proto__), Object.prototype);
+  bad({}, [{ op: "add", path: "/__proto__/x", value: 1 }]);
+  bad({}, [{ op: "add", path: "/constructor/prototype/x", value: 1 }]);
+  bad({}, [{ op: "remove", path: "/toString" }]);
+  assert.strictEqual({}.x, undefined);
+  const parsed = JSON.parse('{"__proto__": {"a": 1}}');
+  const out = ap(parsed, [{ op: "add", path: "/__proto__/b", value: 2 }]);
+  assert.deepStrictEqual(Object.getOwnPropertyDescriptor(out, "__proto__").value, { a: 1, b: 2 });
+  assert.strictEqual(Object.getPrototypeOf(out), Object.prototype);
+  const t = ap({}, [{ op: "add", path: "/a", value: JSON.parse('{"__proto__": 1}') }]);
+  assert.strictEqual(Object.getPrototypeOf(t.a), Object.prototype);
+});
