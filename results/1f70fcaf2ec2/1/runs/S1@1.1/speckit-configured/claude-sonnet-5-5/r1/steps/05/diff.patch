@@ -0,0 +1,128 @@
+import { clone, equal, isObject } from "./patch.js";
+
+/** A JSON Patch operation produced by `createPatch`. */
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffObjects(from: Record<string, unknown>, to: Record<string, unknown>, path: string, ops: PatchOperation[]): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const child = `${path}/${escapeToken(key)}`;
+    if (!Object.hasOwn(from, key)) {
+      ops.push({ op: "add", path: child, value: clone(to[key]) });
+    } else {
+      diff(from[key], to[key], child, ops);
+    }
+  }
+}
+
+type Edit = { kind: "keep" } | { kind: "del" } | { kind: "ins"; value: unknown };
+
+/** Edit script between two arrays, aligned on their longest common subsequence. */
+function editScript(from: unknown[], to: unknown[]): Edit[] {
+  const n = from.length;
+  const m = to.length;
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = equal(from[i], to[j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  const edits: Edit[] = [];
+  let i = 0;
+  let j = 0;
+  while (i < n || j < m) {
+    if (i < n && j < m && equal(from[i], to[j])) {
+      edits.push({ kind: "keep" });
+      i++;
+      j++;
+    } else if (i < n && (j === m || lcs[i + 1][j] >= lcs[i][j + 1])) {
+      edits.push({ kind: "del" });
+      i++;
+    } else {
+      edits.push({ kind: "ins", value: to[j] });
+      j++;
+    }
+  }
+  return edits;
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && equal(from[start], to[start])) start++;
+  let end = 0;
+  while (end < from.length - start && end < to.length - start && equal(from[from.length - 1 - end], to[to.length - 1 - end])) end++;
+  const edits = editScript(from.slice(start, from.length - end), to.slice(start, to.length - end));
+
+  // `position` is the index, at the time the next operation is applied, of the next item.
+  // Consecutive deletions followed by insertions are paired: the item stays and is compared in place.
+  let position = start;
+  let fromIndex = start;
+  let k = 0;
+  while (k < edits.length) {
+    if (edits[k].kind === "keep") {
+      position++;
+      fromIndex++;
+      k++;
+      continue;
+    }
+    const deleted: number[] = [];
+    const inserted: unknown[] = [];
+    for (; k < edits.length && edits[k].kind !== "keep"; k++) {
+      const edit = edits[k];
+      if (edit.kind === "del") deleted.push(fromIndex++);
+      else if (edit.kind === "ins") inserted.push(edit.value);
+    }
+    const pairs = Math.min(deleted.length, inserted.length);
+    for (let p = 0; p < pairs; p++) {
+      diff(from[deleted[p]], inserted[p], `${path}/${position}`, ops);
+      position++;
+    }
+    for (let p = pairs; p < deleted.length; p++) {
+      ops.push({ op: "remove", path: `${path}/${position}` });
+    }
+    for (let p = pairs; p < inserted.length; p++) {
+      ops.push({ op: "add", path: `${path}/${position}`, value: clone(inserted[p]) });
+      position++;
+    }
+  }
+}
+
+function diff(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (equal(from, to)) return;
+  const nested: PatchOperation[] = [];
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, nested);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from, to, path, nested);
+  }
+  if (nested.length === 0) {
+    ops.push({ op: "replace", path, value: clone(to) });
+  } else {
+    ops.push(...nested);
+  }
+}
+
+/**
+ * Creates a JSON Patch that turns `from` into `to`.
+ *
+ * Produces a JSON Patch, RFC 6902, of `add`, `remove` and `replace` operations (section 4) meant to be applied in
+ * order (section 5), with escaped JSON Pointer paths (RFC 6901 section 3). Only what differs is described: unchanged
+ * members and array items are not mentioned, an item inserted into or deleted from an array is a single `add` or
+ * `remove`, and a moved item is a `remove` and an `add` without touching the items in between. Equal values give
+ * `[]`. Neither argument is modified and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
