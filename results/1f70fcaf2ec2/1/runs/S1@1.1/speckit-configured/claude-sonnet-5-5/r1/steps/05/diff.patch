diff --git a/test/diff.test.js b/test/diff.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..f9513a178f3ff366b2cd847830631b8dd0573604
--- /dev/null
+++ b/test/diff.test.js
@@ -0,0 +1,87 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { createPatch, applyPatch } from "../dist/index.js";
+
+const rt = (from, to) => {
+  const f = structuredClone(from), t = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepStrictEqual(from, f);
+  assert.deepStrictEqual(to, t);
+  assert.deepStrictEqual(applyPatch(from, patch), to);
+  return patch;
+};
+
+test("equal documents give an empty patch", () => {
+  assert.deepStrictEqual(rt({ a: [1, { b: null }] }, { a: [1, { b: null }] }), []);
+  assert.deepStrictEqual(rt(null, null), []);
+});
+
+test("root and type changes", () => {
+  assert.deepStrictEqual(rt(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepStrictEqual(rt({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepStrictEqual(rt({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+});
+
+test("small change deep inside is small", () => {
+  const big = { a: { b: { c: [1, 2, 3], d: "x" } }, e: "y".repeat(100) };
+  const next = structuredClone(big);
+  next.a.b.d = "z";
+  assert.deepStrictEqual(rt(big, next), [{ op: "replace", path: "/a/b/d", value: "z" }]);
+});
+
+test("object add and remove, escaping", () => {
+  assert.deepStrictEqual(rt({ "a/b": 1, "m~n": 2, k: 3 }, { "m~n": 2, k: 3, "x/~": 4 }), [
+    { op: "remove", path: "/a~1b" },
+    { op: "add", path: "/x~1~0", value: 4 },
+  ]);
+  assert.deepStrictEqual(rt({}, { "": 1 }), [{ op: "add", path: "/", value: 1 }]);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const to = JSON.parse('{"__proto__": {"x": 1}}');
+  const patch = rt({}, to);
+  assert.deepStrictEqual(patch, [{ op: "add", path: "/__proto__", value: { x: 1 } }]);
+  assert.strictEqual({}.x, undefined);
+});
+
+test("array insert and delete are single operations", () => {
+  assert.deepStrictEqual(rt([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepStrictEqual(rt([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepStrictEqual(rt([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepStrictEqual(rt([], [1]), [{ op: "add", path: "/0", value: 1 }]);
+  assert.deepStrictEqual(rt([{ a: 1 }, { a: 2 }], [{ a: 2 }]), [{ op: "remove", path: "/0" }]);
+});
+
+test("array item changed in place", () => {
+  assert.deepStrictEqual(rt([{ a: 1, b: 2 }, 5], [{ a: 1, b: 3 }, 5]), [{ op: "replace", path: "/0/b", value: 3 }]);
+  assert.deepStrictEqual(rt([1, 2, 3], [1, 7, 3]), [{ op: "replace", path: "/1", value: 7 }]);
+});
+
+test("array move does not rewrite items in between", () => {
+  const from = [1, 2, 3, 4, 5, 6];
+  for (const to of [[2, 3, 4, 5, 6, 1], [6, 1, 2, 3, 4, 5], [1, 2, 6, 3, 4, 5]]) {
+    const patch = rt(from, to);
+    assert.ok(patch.length <= 2, JSON.stringify(patch));
+    assert.ok(patch.every((o) => ["move", "remove", "add"].includes(o.op)));
+  }
+});
+
+test("mixed array edits round-trip", () => {
+  rt([1, [1, 2], { a: [1] }, "x"], [0, [1, 2, 3], { a: [] }, "y", "z"]);
+  rt([1, 1, 1, 2], [2, 1, 1]);
+});
+
+test("random round-trip", () => {
+  let seed = 7;
+  const rnd = (n) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff), seed % n);
+  const gen = (d) => {
+    const k = rnd(d > 2 ? 4 : 6);
+    if (k === 0) return rnd(4);
+    if (k === 1) return null;
+    if (k === 2) return "s" + rnd(3);
+    if (k === 3) return rnd(2) === 0;
+    if (k === 4) return Array.from({ length: rnd(5) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let i = 0; i < 500; i++) rt(gen(0), gen(0));
+});
