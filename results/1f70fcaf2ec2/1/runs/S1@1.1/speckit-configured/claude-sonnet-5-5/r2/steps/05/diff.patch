+
+/** A JSON Patch operation as produced by `createPatch` (RFC 6902 section 4). */
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffValues(from: unknown, to: unknown, path: string, out: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isContainer(from) && isContainer(to) && !Array.isArray(from) && !Array.isArray(to)) {
+    const a = from as Record<string, unknown>;
+    const b = to as Record<string, unknown>;
+    for (const key of Object.keys(a)) {
+      if (!Object.hasOwn(b, key)) out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(b)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(a, key)) diffValues(a[key], b[key], child, out);
+      else out.push({ op: "add", path: child, value: clone(b[key]) });
+    }
+  } else {
+    out.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/** Edits an array in place: items kept by a longest common subsequence are left alone. */
+function diffArrays(from: unknown[], to: unknown[], path: string, out: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+  let endA = from.length;
+  let endB = to.length;
+  while (endA > start && endB > start && jsonEqual(from[endA - 1], to[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const n = endA - start;
+  const m = endB - start;
+  // lcs[i][j]: length of the longest common subsequence of from[start+i..endA) and to[start+j..endB).
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i]![j] = jsonEqual(from[start + i], to[start + j])
+        ? lcs[i + 1]![j + 1]! + 1
+        : Math.max(lcs[i + 1]![j]!, lcs[i]![j + 1]!);
+    }
+  }
+
+  let index = start; // position in the array as it is after the operations emitted so far
+  let i = 0;
+  let j = 0;
+  const flush = (removed: number[], added: number[]): void => {
+    // Items replaced at the same place are diffed in depth; the surplus is removed or added.
+    const paired = Math.min(removed.length, added.length);
+    for (let k = 0; k < paired; k++) diffValues(from[start + removed[k]!], to[start + added[k]!], `${path}/${index++}`, out);
+    for (let k = paired; k < removed.length; k++) out.push({ op: "remove", path: `${path}/${index}` });
+    for (let k = paired; k < added.length; k++) {
+      out.push({ op: "add", path: `${path}/${index++}`, value: clone(to[start + added[k]!]) });
+    }
+    removed.length = 0;
+    added.length = 0;
+  };
+  const removed: number[] = [];
+  const added: number[] = [];
+  while (i < n || j < m) {
+    if (i < n && j < m && jsonEqual(from[start + i], to[start + j]) && lcs[i]![j] === lcs[i + 1]![j + 1]! + 1) {
+      flush(removed, added);
+      index++;
+      i++;
+      j++;
+    } else if (i < n && (j === m || lcs[i + 1]![j]! >= lcs[i]![j + 1]!)) {
+      removed.push(i++);
+    } else {
+      added.push(j++);
+    }
+  }
+  flush(removed, added);
+}
+
+/**
+ * Produces a JSON Patch (RFC 6902 sections 4.1-4.3) that turns `from` into `to` when
+ * given to `applyPatch`. Only what changed is described: object members are compared
+ * one by one, and arrays are compared with a longest common subsequence, so an item
+ * that is inserted or deleted yields a single `add` or `remove`, and a moved item a
+ * `remove` and an `add`, without touching the items around it. Equal documents give
+ * an empty patch. Neither argument is modified and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diffValues(from, to, "", out);
+  return out;
+}
