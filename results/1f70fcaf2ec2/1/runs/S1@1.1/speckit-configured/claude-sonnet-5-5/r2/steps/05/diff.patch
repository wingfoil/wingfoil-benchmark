index 0000000000000000000000000000000000000000..bacb5a1ff076017aeaf490ca314c397d5168246d
--- /dev/null
+++ b/tests/create-patch.test.ts
@@ -0,0 +1,84 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const before = JSON.stringify(from);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.equal(JSON.stringify(from), before);
+  return patch;
+};
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+});
+
+test("small change in a large document is a single operation", () => {
+  const from = { a: { b: { c: 1, d: [1, 2] } }, big: { x: 1, y: 2 } };
+  const to = { a: { b: { c: 2, d: [1, 2] } }, big: { x: 1, y: 2 } };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/c", value: 2 }]);
+});
+
+test("object members: add, remove, replace, escaping, null", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "m~n": 2 }, { "a/b": 1, "m~n": null, "": 3 }), [
+    { op: "replace", path: "/m~0n", value: null },
+    { op: "add", path: "/", value: 3 },
+  ]);
+  roundTrip({ a: 1 }, {});
+  roundTrip({}, { a: { b: [] } });
+});
+
+test("root replacement and type changes", () => {
+  assert.deepEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  roundTrip({ a: 1 }, [1]);
+  roundTrip([1], { a: 1 });
+  roundTrip({ a: [1] }, { a: { 0: 1 } });
+  roundTrip(null, { a: null });
+});
+
+test("array insertion and deletion touch one item", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [2, 3, 4]), [{ op: "remove", path: "/0" }]);
+  assert.deepEqual(roundTrip([{ a: 1 }, { a: 2 }], [{ a: 1 }]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([1], [1, 2]), [{ op: "add", path: "/1", value: 2 }]);
+});
+
+test("array move does not rewrite items in between", () => {
+  const patch = roundTrip([1, 2, 3, 4, 5], [2, 3, 4, 1, 5]);
+  assert.ok(patch.length <= 2);
+  assert.ok(patch.every((o) => o.op !== "replace"));
+});
+
+test("changed array items are diffed in depth", () => {
+  assert.deepEqual(roundTrip([{ a: 1, b: 2 }, 5], [{ a: 1, b: 3 }, 5]), [{ op: "replace", path: "/0/b", value: 3 }]);
+});
+
+test("random documents round-trip", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) % 2147483648), seed % n);
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 3 : 5);
+    if (k === 0) return rnd(4);
+    if (k === 1) return ["x", null][rnd(2)];
+    if (k === 2) return rnd(2) === 0;
+    if (k === 3) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let i = 0; i < 500; i++) roundTrip(gen(0), gen(0));
+});
+
+test("patch shares no structure with inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0] as { value: { b: number } }).value.b = 9;
+  assert.equal(to.a.b, 1);
+});
+
+test("__proto__ keys are plain members", () => {
+  const to = JSON.parse('{"__proto__":{"x":1}}');
+  const result = applyPatch({}, createPatch({}, to)) as object;
+  assert.equal(({} as { x?: number }).x, undefined);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+});
