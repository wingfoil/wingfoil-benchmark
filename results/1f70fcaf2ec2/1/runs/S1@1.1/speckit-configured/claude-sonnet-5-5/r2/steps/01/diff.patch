@@ -0,0 +1,64 @@
+/** Base class of the errors thrown by JSON Pointer functions. */
+export class JsonPointerError extends Error {
+  readonly pointer: string;
+
+  constructor(message: string, pointer: string) {
+    super(message);
+    this.name = new.target.name;
+    this.pointer = pointer;
+  }
+}
+
+/** The string is not a valid JSON Pointer (RFC 6901 section 3). */
+export class JsonPointerSyntaxError extends JsonPointerError {}
+
+/** The pointer is valid but does not refer to a value of the document (RFC 6901 section 4). */
+export class JsonPointerResolveError extends JsonPointerError {}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function unescapeToken(token: string, pointer: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new JsonPointerSyntaxError(`Invalid escape sequence in JSON Pointer "${pointer}"`, pointer);
+  }
+  // "~1" first, then "~0", so that "~01" becomes "~1" (RFC 6901 section 4).
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/**
+ * Resolves a JSON Pointer against a JSON document, as specified by RFC 6901
+ * (syntax in section 3, evaluation in section 4). The document is not modified.
+ *
+ * @returns the referenced value; the empty pointer refers to the whole document.
+ * @throws {JsonPointerSyntaxError} when `pointer` is not a valid JSON Pointer.
+ * @throws {JsonPointerResolveError} when the pointer does not refer to a value of
+ *   the document: missing member, array index out of range, the `-` index, an
+ *   invalid array index, or a reference through a non-container value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerSyntaxError("JSON Pointer must be a string", String(pointer));
+  }
+  if (pointer === "") return document;
+  if (pointer[0] !== "/") {
+    throw new JsonPointerSyntaxError(`JSON Pointer "${pointer}" must be empty or start with "/"`, pointer);
+  }
+
+  let current: unknown = document;
+  for (const raw of pointer.slice(1).split("/")) {
+    const token = unescapeToken(raw, pointer);
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || !Object.hasOwn(current, token)) {
+        throw new JsonPointerResolveError(`"${token}" is not an existing array index (pointer "${pointer}")`, pointer);
+      }
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new JsonPointerResolveError(`No member "${token}" (pointer "${pointer}")`, pointer);
+      }
+    } else {
+      throw new JsonPointerResolveError(`Cannot resolve "${token}" in a non-container value (pointer "${pointer}")`, pointer);
+    }
+    current = (current as Record<string, unknown>)[token];
+  }
+  return current;
+}
diff --git a/tests/pointer.test.ts b/tests/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5191a4e3e377052ded6f29ab1fd105b221354684
--- /dev/null
+++ b/tests/pointer.test.ts
@@ -0,0 +1,86 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  resolvePointer,
+  JsonPointerError,
+  JsonPointerSyntaxError,
+  JsonPointerResolveError,
+} from "../src/index.ts";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("returns falsy values and scalars documents", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer({ a: false }, "/a"), false);
+  assert.equal(resolvePointer({ a: "" }, "/a"), "");
+  assert.equal(resolvePointer(5, ""), 5);
+  assert.equal(resolvePointer([1, 2], "/1"), 2);
+  assert.equal(resolvePointer([10, 20], "/0"), 10);
+});
+
+test("empty-name members and escape order", () => {
+  assert.equal(resolvePointer({ "": { "": 9 } }, "//"), 9);
+  assert.equal(resolvePointer({ "~1": 1, "/": 2 }, "/~01"), 1);
+});
+
+test("invalid syntax throws JsonPointerSyntaxError", () => {
+  for (const p of ["foo", "a/b", "/a~", "/a~2", "/~", "/a~x"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), JsonPointerSyntaxError, p);
+  }
+  assert.throws(() => resolvePointer({}, undefined as unknown as string), JsonPointerSyntaxError);
+  assert.throws(() => resolvePointer({}, 1 as unknown as string), JsonPointerError);
+});
+
+test("unresolvable references throw JsonPointerResolveError", () => {
+  const doc = { a: [1, 2], s: "str", n: null, o: {} };
+  for (const p of [
+    "/missing", "/a/2", "/a/-", "/a/01", "/a/+1", "/a/-1", "/a/1.0", "/a/x", "/a/",
+    "/a/99999999999999999999", "/s/0", "/s/length", "/n/x", "/o/x", "/a/0/x",
+  ]) {
+    assert.throws(() => resolvePointer(doc, p), JsonPointerResolveError, p);
+  }
+  assert.throws(() => resolvePointer(1, "/a"), JsonPointerError);
+});
+
+test("only own members are resolved", () => {
+  const doc = { a: [1] };
+  for (const p of ["/__proto__", "/constructor", "/toString", "/a/length", "/a/constructor", "/a/__proto__"]) {
+    assert.throws(() => resolvePointer(doc, p), JsonPointerResolveError, p);
+  }
+  const parsed = JSON.parse('{"__proto__": {"x": 1}}');
+  assert.deepEqual(resolvePointer(parsed, "/__proto__"), { x: 1 });
+  assert.equal(resolvePointer(parsed, "/__proto__/x"), 1);
+});
+
+test("does not mutate the document", () => {
+  const doc = { a: [1, { b: 2 }] };
+  const copy = structuredClone(doc);
+  resolvePointer(doc, "/a/1/b");
+  assert.deepEqual(doc, copy);
+});
