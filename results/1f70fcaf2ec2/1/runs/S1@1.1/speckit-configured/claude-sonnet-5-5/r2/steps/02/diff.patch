+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, JsonPatchError } from "../src/index.ts";
+
+type Op = Record<string, unknown>;
+const ok = (doc: unknown, patch: Op[], expected: unknown) => assert.deepEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch as never), JsonPatchError);
+
+test("RFC 6902 Appendix A examples", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  assert.deepEqual(applyPatch({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }]), { baz: "qux", foo: ["a", 2, "c"] });
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", op2: 1 }, { op: "bogus", path: "/x" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/foo", value: "qux" }], { foo: "qux" });
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] });
+  ok({ foo: "bar", baz: "qux" }, [{ op: "copy", from: "/foo", path: "/dup" }], { foo: "bar", baz: "qux", dup: "bar" });
+});
+
+test("array index rules", () => {
+  ok([1], [{ op: "add", path: "/1", value: 2 }], [1, 2]);
+  bad([1], [{ op: "add", path: "/2", value: 2 }]);
+  bad([1], [{ op: "add", path: "/01", value: 2 }]);
+  bad([1], [{ op: "add", path: "/x", value: 2 }]);
+  bad([1], [{ op: "remove", path: "/-" }]);
+  bad([1], [{ op: "remove", path: "/1" }]);
+  bad([1], [{ op: "replace", path: "/1", value: 0 }]);
+  bad({ a: [1] }, [{ op: "add", path: "/a/-/b", value: 0 }]);
+});
+
+test("root path", () => {
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: null }], null);
+  ok({ a: { b: 1 } }, [{ op: "copy", from: "/a", path: "" }], { b: 1 });
+  ok({ a: { b: 1 } }, [{ op: "test", path: "", value: { a: { b: 1 } } }], { a: { b: 1 } });
+  bad({ a: 1 }, [{ op: "remove", path: "" }]);
+});
+
+test("move rules", () => {
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  bad({ a: 1 }, [{ op: "move", from: "/zz", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "copy", from: "/zz", path: "/b" }]);
+  ok({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "" }], { b: 1 });
+});
+
+test("test operation equality", () => {
+  const t = (a: unknown, b: unknown) => applyPatch({ x: a }, [{ op: "test", path: "/x", value: b }]);
+  t({ a: 1, b: [1, { c: null }] }, { b: [1, { c: null }], a: 1 });
+  t(1, 1.0);
+  t(null, null);
+  t("", "");
+  for (const [a, b] of [[1, "1"], [null, 0], [null, false], [[1], [1, 2]], [{ a: 1 }, { a: 1, b: 1 }], [{ a: 1 }, { b: 1 }], [[], {}], [true, 1]]) {
+    assert.throws(() => t(a, b), JsonPatchError);
+  }
+  bad({}, [{ op: "test", path: "/missing", value: null }]);
+  ok({ a: null }, [{ op: "test", path: "/a", value: null }], { a: null });
+});
+
+test("invalid patches", () => {
+  bad({}, {});
+  bad({}, null);
+  bad({}, [null]);
+  bad({}, [[]]);
+  bad({}, ["add"]);
+  bad({}, [{ path: "/a", value: 1 }]);
+  bad({}, [{ op: 1, path: "/a", value: 1 }]);
+  bad({}, [{ op: "nope", path: "/a" }]);
+  bad({}, [{ op: "add", value: 1 }]);
+  bad({}, [{ op: "add", path: 1, value: 1 }]);
+  bad({}, [{ op: "add", path: "a", value: 1 }]);
+  bad({}, [{ op: "add", path: "/a~2", value: 1 }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "/a" }]);
+  bad({ a: 1 }, [{ op: "test", path: "/a" }]);
+  bad({ a: 1 }, [{ op: "move", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "copy", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "copy", from: 1, path: "/b" }]);
+  bad({ a: 1 }, [{ op: "copy", from: "a", path: "/b" }]);
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+});
+
+test("errors carry the operation index and distinguish kinds", () => {
+  try {
+    applyPatch({}, [{ op: "add", path: "/a", value: 1 }, { op: "remove", path: "/zz" }]);
+    assert.fail();
+  } catch (e) {
+    assert.ok(e instanceof JsonPatchError);
+    assert.equal(e.index, 1);
+  }
+});
+
+test("atomic, non-mutating, non-aliasing", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const snapshot = structuredClone(doc);
+  assert.throws(() => applyPatch(doc, [{ op: "add", path: "/a/-", value: 3 }, { op: "remove", path: "/b/c" }, { op: "test", path: "/a", value: 0 }]));
+  assert.deepEqual(doc, snapshot);
+
+  const value = { n: [1] };
+  const patch = [{ op: "add", path: "/v", value }, { op: "copy", from: "/v", path: "/w" }];
+  const patchSnap = structuredClone(patch);
+  const out = applyPatch(doc, patch) as { v: { n: number[] }; w: { n: number[] }; b: unknown };
+  assert.deepEqual(doc, snapshot);
+  assert.deepEqual(patch, patchSnap);
+  out.v.n.push(2);
+  assert.deepEqual(value, { n: [1] });
+  assert.deepEqual(out.w, { n: [1] });
+  assert.notEqual(out.b, doc.b);
+  assert.deepEqual(applyPatch(doc, []), doc);
+  assert.notEqual(applyPatch(doc, []), doc);
+});
+
+test("prototype safety", () => {
+  bad({}, [{ op: "remove", path: "/__proto__" }]);
+  bad({}, [{ op: "replace", path: "/constructor", value: 1 }]);
+  bad({}, [{ op: "add", path: "/__proto__/polluted", value: 1 }]);
+  bad({}, [{ op: "add", path: "/constructor/prototype/polluted", value: 1 }]);
+  bad({ a: [] }, [{ op: "add", path: "/a/length", value: 1 }]);
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: 1 } }]) as Record<string, unknown>;
+  assert.equal(Object.hasOwn(out, "__proto__"), true);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  const parsed = JSON.parse('{"__proto__":{"x":1}}');
+  const out2 = applyPatch(parsed, [{ op: "add", path: "/__proto__/y", value: 2 }]) as Record<string, unknown>;
+  assert.deepEqual(Object.getOwnPropertyDescriptor(out2, "__proto__")?.value, { x: 1, y: 2 });
+  assert.equal(Object.getPrototypeOf(out2), Object.prototype);
+  assert.equal(({} as Record<string, unknown>).y, undefined);
+});
