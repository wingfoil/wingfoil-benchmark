index 06c1083026a1093f055fbce47aee8e7542d72156..16cb14cd92ae07509ad37f36266a677f36043e97 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -62,3 +62,180 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+/** Base class of the errors thrown by `applyPatch`; `index` is the position of the offending operation, or -1 for the patch itself. */
+export class JsonPatchError extends Error {
+  readonly index: number;
+
+  constructor(message: string, index: number) {
+    super(message);
+    this.name = new.target.name;
+    this.index = index;
+  }
+}
+
+/** The patch is not a valid JSON Patch document (RFC 6902 sections 3 and 4). */
+export class JsonPatchInvalidError extends JsonPatchError {}
+
+/** A valid operation could not be applied, or a `test` failed (RFC 6902 sections 4 and 5). */
+export class JsonPatchOperationError extends JsonPatchError {}
+
+type Container = unknown[] | Record<string, unknown>;
+
+function isContainer(value: unknown): value is Container {
+  return typeof value === "object" && value !== null;
+}
+
+/** Deep copy using own members only; member names such as `__proto__` stay plain own members. */
+function clone(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(clone);
+  if (!isContainer(value)) return value;
+  const copy: Record<string, unknown> = {};
+  for (const key of Object.keys(value)) setMember(copy, key, clone((value as Record<string, unknown>)[key]));
+  return copy;
+}
+
+function setMember(target: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** JSON equality of RFC 6902 section 4.6; object member order is irrelevant. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (isContainer(a) && isContainer(b)) {
+    const ka = Object.keys(a);
+    return (
+      ka.length === Object.keys(b).length &&
+      ka.every((k) => Object.hasOwn(b, k) && jsonEqual((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]))
+    );
+  }
+  return a === b;
+}
+
+function tokens(pointer: unknown, what: string): string[] {
+  if (typeof pointer !== "string") throw new JsonPatchInvalidError(`"${what}" must be a string`, -1);
+  try {
+    resolvePointer(null, pointer);
+  } catch (e) {
+    // Resolving against `null` always fails; only syntax errors make the pointer itself invalid.
+    if (e instanceof JsonPointerSyntaxError) throw new JsonPatchInvalidError(`"${what}": ${e.message}`, -1);
+  }
+  return pointer === "" ? [] : pointer.slice(1).split("/").map((t) => t.replace(/~1/g, "/").replace(/~0/g, "~"));
+}
+
+function fail(message: string): never {
+  throw new JsonPatchOperationError(message, -1);
+}
+
+/** Finds the container holding the last token of `path`; every step must exist (RFC 6902 section 4). */
+function parentOf(root: unknown, path: string[]): Container {
+  let current = root;
+  for (const token of path.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || !Object.hasOwn(current, token)) fail(`"${token}" is not an existing array index`);
+    } else if (!isContainer(current) || !Object.hasOwn(current, token)) {
+      fail(`Cannot resolve "${token}"`);
+    }
+    current = (current as Record<string, unknown>)[token];
+  }
+  if (!isContainer(current)) fail(`Parent of "${path[path.length - 1]}" is not an object or array`);
+  return current;
+}
+
+function getAt(root: unknown, path: string[]): unknown {
+  if (path.length === 0) return root;
+  const parent = parentOf(root, path);
+  const key = path[path.length - 1] as string;
+  if (!Object.hasOwn(parent, key) || (Array.isArray(parent) && !ARRAY_INDEX.test(key))) fail(`No value at "${key}"`);
+  return (parent as Record<string, unknown>)[key];
+}
+
+function addAt(root: unknown, path: string[], value: unknown): unknown {
+  if (path.length === 0) return value;
+  const parent = parentOf(root, path);
+  const key = path[path.length - 1] as string;
+  if (Array.isArray(parent)) {
+    if (key === "-") parent.push(value);
+    else if (ARRAY_INDEX.test(key) && Number(key) <= parent.length) parent.splice(Number(key), 0, value);
+    else fail(`"${key}" is not a valid array index for add`);
+  } else {
+    setMember(parent as Record<string, unknown>, key, value);
+  }
+  return root;
+}
+
+function removeAt(root: unknown, path: string[]): unknown {
+  if (path.length === 0) fail("Cannot remove the whole document");
+  getAt(root, path);
+  const parent = parentOf(root, path);
+  const key = path[path.length - 1] as string;
+  if (Array.isArray(parent)) parent.splice(Number(key), 1);
+  else delete (parent as Record<string, unknown>)[key];
+  return root;
+}
+
+function applyOperation(root: unknown, op: unknown): unknown {
+  if (typeof op !== "object" || op === null || Array.isArray(op)) {
+    throw new JsonPatchInvalidError("Patch operation must be an object", -1);
+  }
+  const o = op as Record<string, unknown>;
+  const name = o["op"];
+  if (typeof name !== "string") throw new JsonPatchInvalidError('Operation "op" must be a string', -1);
+  if (!["add", "remove", "replace", "move", "copy", "test"].includes(name)) {
+    throw new JsonPatchInvalidError(`Unknown operation "${name}"`, -1);
+  }
+  const path = tokens(Object.hasOwn(o, "path") ? o["path"] : undefined, "path");
+  const needsValue = name === "add" || name === "replace" || name === "test";
+  if (needsValue && !Object.hasOwn(o, "value")) throw new JsonPatchInvalidError(`"${name}" requires "value"`, -1);
+  const from = name === "move" || name === "copy" ? tokens(Object.hasOwn(o, "from") ? o["from"] : undefined, "from") : [];
+
+  switch (name) {
+    case "add":
+      return addAt(root, path, clone(o["value"]));
+    case "remove":
+      return removeAt(root, path);
+    case "replace":
+      getAt(root, path);
+      return path.length === 0 ? clone(o["value"]) : addAt(removeAt(root, path), path, clone(o["value"]));
+    case "move": {
+      const value = getAt(root, from);
+      if (from.length < path.length && from.every((t, i) => t === path[i])) fail('"from" is a proper prefix of "path"');
+      if (from.length === path.length && from.every((t, i) => t === path[i])) return root;
+      return addAt(removeAt(root, from), path, value);
+    }
+    case "copy":
+      return addAt(root, path, clone(getAt(root, from)));
+    default:
+      if (!jsonEqual(getAt(root, path), o["value"])) fail("Test failed: values are not equal");
+      return root;
+  }
+}
+
+/**
+ * Applies a JSON Patch, as specified by RFC 6902 (operations in section 4, error
+ * handling and atomicity in section 5), to a JSON document. Paths are JSON Pointers
+ * (RFC 6901). Operations apply in order, each to the result of the previous one.
+ * Neither argument is modified and the result shares no structure with them; when
+ * the patch is invalid or an operation fails nothing is returned.
+ *
+ * @returns the patched document as a new value.
+ * @throws {JsonPatchInvalidError} when `patch` is not a valid patch document.
+ * @throws {JsonPatchOperationError} when an operation fails, including a failed `test`.
+ */
+export function applyPatch(document: unknown, patch: readonly unknown[]): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchInvalidError("A JSON Patch must be an array of operations", -1);
+  let result = clone(document);
+  patch.forEach((op, index) => {
+    try {
+      result = applyOperation(result, op);
+    } catch (e) {
+      if (e instanceof JsonPatchError) {
+        throw new (e.constructor as new (m: string, i: number) => JsonPatchError)(`Operation ${index}: ${e.message}`, index);
+      }
+      throw e;
+    }
+  });
+  return result;
+}
