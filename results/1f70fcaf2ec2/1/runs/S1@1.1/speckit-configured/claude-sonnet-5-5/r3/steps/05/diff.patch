new file mode 100644
index 0000000000000000000000000000000000000000..a96a582b7906b6dc4d7b5e5b107e5c6943097903
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,103 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { applyPatch, createPatch, JsonPatchError } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown): any[] {
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to) as any[];
+  assert.deepStrictEqual(from, fromCopy);
+  assert.deepStrictEqual(to, toCopy);
+  assert.deepStrictEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepStrictEqual(roundTrip({ a: [1, { b: null }] }, { a: [1, { b: null }] }), []);
+  assert.deepStrictEqual(roundTrip(1, 1), []);
+});
+
+test("root replacement", () => {
+  assert.deepStrictEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepStrictEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  roundTrip(null, {});
+});
+
+test("small change in a large document is small", () => {
+  const from = { a: { b: { c: 1, d: 2 } }, big: [1, 2, 3], other: "x" };
+  const to = { a: { b: { c: 1, d: 3 } }, big: [1, 2, 3], other: "x" };
+  assert.deepStrictEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/d", value: 3 }]);
+});
+
+test("object members added, removed, null vs missing", () => {
+  const p = roundTrip({ a: 1, b: 2 }, { b: 2, c: null });
+  assert.deepStrictEqual(p.sort((x, y) => x.path.localeCompare(y.path)), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: null },
+  ]);
+  assert.deepStrictEqual(roundTrip({ a: null }, {}), [{ op: "remove", path: "/a" }]);
+});
+
+test("key escaping and special keys", () => {
+  assert.deepStrictEqual(roundTrip({ "a/b": 1, "m~n": 1 }, { "a/b": 2, "m~n": 1 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+  ]);
+  roundTrip({}, JSON.parse('{"__proto__":{"x":1},"constructor":2,"":3}'));
+  roundTrip(JSON.parse('{"__proto__":{"x":1}}'), JSON.parse('{"__proto__":{"x":2}}'));
+  assert.strictEqual(({} as any).x, undefined);
+});
+
+test("array insert and delete touch only that item", () => {
+  assert.deepStrictEqual(roundTrip([1, 2, 3], [1, 9, 2, 3]), [{ op: "add", path: "/1", value: 9 }]);
+  assert.deepStrictEqual(roundTrip([1, 2, 3], [1, 2, 3, 4]), [{ op: "add", path: "/3", value: 4 }]);
+  assert.deepStrictEqual(roundTrip([1, 2, 3], [2, 3]), [{ op: "remove", path: "/0" }]);
+  assert.deepStrictEqual(roundTrip([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+  assert.deepStrictEqual(roundTrip({ l: [{ a: 1 }, { a: 2 }] }, { l: [{ a: 0 }, { a: 1 }, { a: 2 }] }), [
+    { op: "add", path: "/l/0", value: { a: 0 } },
+  ]);
+  assert.deepStrictEqual(roundTrip([], [1]), [{ op: "add", path: "/0", value: 1 }]);
+  assert.deepStrictEqual(roundTrip([1], []), [{ op: "remove", path: "/0" }]);
+});
+
+test("array move does not rewrite items in between", () => {
+  const p = roundTrip([1, 2, 3, 4, 5], [1, 3, 4, 5, 2]);
+  assert.ok(p.length <= 2);
+  assert.ok(p.every((o) => o.op === "move" || o.op === "remove" || o.op === "add"));
+  const q = roundTrip(["a", "b", "c", "d"], ["d", "a", "b", "c"]);
+  assert.ok(q.length <= 2);
+});
+
+test("modified array items are diffed in place", () => {
+  assert.deepStrictEqual(roundTrip([{ a: 1 }, { b: 2 }], [{ a: 1 }, { b: 3 }]), [
+    { op: "replace", path: "/1/b", value: 3 },
+  ]);
+  roundTrip([1, [2, 3], 4], [[2, 3, 5], 4, 7]);
+});
+
+test("random round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) % n);
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 4 : 6);
+    if (k === 0) return rnd(3);
+    if (k === 1) return "s" + rnd(3);
+    if (k === 2) return null;
+    if (k === 3) return rnd(2) === 0;
+    if (k === 4) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let i = 0; i < 500; i++) roundTrip(gen(0), gen(0));
+});
+
+test("result shares no structure with inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to) as any[];
+  patch[0].value.b = 2;
+  assert.strictEqual(to.a.b, 1);
+});
+
+test("rejects non-JSON input", () => {
+  assert.throws(() => createPatch({ a: undefined }, {}), JsonPatchError);
+  assert.throws(() => createPatch({}, NaN), JsonPatchError);
+  assert.throws(() => createPatch(new Date(), {}), JsonPatchError);
+});
