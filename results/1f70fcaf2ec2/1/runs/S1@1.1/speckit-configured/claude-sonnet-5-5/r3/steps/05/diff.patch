+
+/** One operation of a JSON Patch produced by {@link createPatch}. */
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+// RFC 6901 section 3: "~" is written "~0" and "/" is written "~1" (in that order)
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+// Longest common subsequence of two arrays (items compared as JSON values), as index pairs
+function commonItems(a: unknown[], b: unknown[]): [number, number][] {
+  const lengths: Uint32Array[] = [];
+  for (let i = 0; i <= a.length; i++) lengths.push(new Uint32Array(b.length + 1));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lengths[i][j] = jsonEqual(a[i], b[j])
+        ? lengths[i + 1][j + 1] + 1
+        : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  const pairs: [number, number][] = [];
+  let i = 0;
+  let j = 0;
+  while (i < a.length && j < b.length) {
+    if (jsonEqual(a[i], b[j])) pairs.push([i++, j++]);
+    else if (lengths[i + 1][j] >= lengths[i][j + 1]) i++;
+    else j++;
+  }
+  return pairs;
+}
+
+// RFC 6902 sections 4.1 to 4.3, on values that are already validated copies
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+  let end = 0;
+  while (
+    end < from.length - start &&
+    end < to.length - start &&
+    jsonEqual(from[from.length - 1 - end], to[to.length - 1 - end])
+  ) {
+    end++;
+  }
+  const a = from.slice(start, from.length - end);
+  const b = to.slice(start, to.length - end);
+  // `index` is the position in the array being patched, which already matches `to` up to there
+  let index = start;
+  let i = 0;
+  let j = 0;
+  const gap = (nextA: number, nextB: number): void => {
+    const removed = nextA - i;
+    const added = nextB - j;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) diff(a[i + k], b[j + k], `${path}/${index + k}`, ops);
+    for (let k = paired; k < removed; k++) ops.push({ op: "remove", path: `${path}/${index + paired}` });
+    for (let k = paired; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${index + k}`, value: b[j + k] });
+    }
+    index += added;
+  };
+  for (const [matchA, matchB] of commonItems(a, b)) {
+    gap(matchA, matchB);
+    i = matchA + 1;
+    j = matchB + 1;
+    index++;
+  }
+  gap(a.length, b.length);
+}
+
+function diff(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${encodeToken(key)}`;
+      if (Object.hasOwn(from, key)) diff(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: to[key] });
+    }
+  } else if (!jsonEqual(from, to)) {
+    ops.push({ op: "replace", path, value: to });
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902, section 3 and operations `add`, `remove` and `replace` of
+ * section 4) that turns `from` into `to` when given to {@link applyPatch}. Paths are JSON
+ * Pointers (RFC 6901, with `~` and `/` escaped).
+ *
+ * The patch holds only what changed. Objects are compared member by member and nested
+ * containers are descended into; a changed primitive or a value whose type changed is
+ * replaced. For arrays, items that are kept are left alone: an inserted or deleted item is
+ * one `add` or `remove`, a moved item is a `remove` plus an `add`, and a modified item is
+ * patched in place. Arrays are matched with a longest-common-subsequence search, quadratic
+ * in the length of the part of the arrays that differs.
+ *
+ * Neither argument is modified, and the patch shares no structure with them.
+ *
+ * @throws {JsonPatchError} if `from` or `to` is not a JSON value (RFC 8259).
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const source = clone(from);
+  const target = clone(to);
+  const ops: PatchOperation[] = [];
+  diff(source, target, "", ops);
+  return ops;
+}
