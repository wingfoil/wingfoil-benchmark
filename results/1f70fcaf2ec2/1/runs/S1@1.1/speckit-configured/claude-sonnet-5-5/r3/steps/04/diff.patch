@@ -273,3 +273,50 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+/** Error thrown when the target or the patch of a JSON Merge Patch is not a JSON value. */
+export class JsonMergePatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonMergePatchError";
+  }
+}
+
+// RFC 7396 section 2: MergePatch(Target, Patch), on values that are already validated copies
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return patch;
+  const result: Record<string, unknown> = isObject(target) ? target : {};
+  for (const name of Object.keys(patch)) {
+    const value = patch[name];
+    if (value === null) {
+      delete result[name];
+    } else {
+      setMember(result, name, mergePatch(Object.hasOwn(result, name) ? result[name] : undefined, value));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies a JSON Merge Patch to a JSON document, as specified by RFC 7396 (section 2).
+ *
+ * A patch that is not an object replaces the target. An object patch is merged member by
+ * member into the target (or into `{}` if the target is not an object): a `null` member
+ * removes the member from the target, any other value is merged recursively. Arrays are
+ * replaced, never merged. Neither argument is modified: the result is a new value that
+ * shares no structure with them.
+ *
+ * @throws {JsonMergePatchError} if the target or the patch is not a JSON value (RFC 8259).
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  let copy: unknown;
+  let patchCopy: unknown;
+  try {
+    copy = clone(target);
+    patchCopy = clone(patch);
+  } catch (error) {
+    if (error instanceof JsonPatchError) throw new JsonMergePatchError(error.message);
+    throw error;
+  }
+  return mergePatch(copy, patchCopy);
+}
diff --git a/test/merge-patch.test.ts b/test/merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..635806177e4d7e680e4aa8b8b117c22000a34b3d
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,61 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { applyMergePatch, JsonMergePatchError } from "../src/index.ts";
+
+// RFC 7396 section 3 test cases
+const cases: [unknown, unknown, unknown][] = [
+  [{ a: "b" }, { a: "c" }, { a: "c" }],
+  [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  [{ a: "b" }, { a: null }, {}],
+  [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+  [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+  [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  [["a", "b"], ["c", "d"], ["c", "d"]],
+  [{ a: "b" }, ["c"], ["c"]],
+  [{ a: "foo" }, null, null],
+  [{ a: "foo" }, "bar", "bar"],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: "b", c: null }, { a: "b" }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  [null, { a: 1 }, { a: 1 }],
+  [5, {}, {}],
+  [{ a: 1 }, {}, { a: 1 }],
+];
+for (const [target, patch, expected] of cases) {
+  test(`merge ${JSON.stringify(target)} + ${JSON.stringify(patch)}`, () => {
+    assert.deepStrictEqual(applyMergePatch(target, patch), expected);
+  });
+}
+
+test("inputs are not mutated and result shares no structure", () => {
+  const target = { a: { b: 1 }, c: [1] };
+  const patch = { a: { d: [2] }, e: { f: 1 } };
+  const t = structuredClone(target);
+  const p = structuredClone(patch);
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepStrictEqual(target, t);
+  assert.deepStrictEqual(patch, p);
+  assert.notStrictEqual(result.c, target.c);
+  assert.notStrictEqual(result.a.d, patch.a.d);
+  assert.notStrictEqual(result.e, patch.e);
+});
+
+test("__proto__ is a plain data key", () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true},"constructor":{"x":1}}');
+  const result = applyMergePatch({}, patch) as any;
+  assert.strictEqual(({} as any).polluted, undefined);
+  assert.strictEqual(Object.getPrototypeOf(result), Object.prototype);
+  assert.ok(Object.hasOwn(result, "__proto__"));
+  assert.deepStrictEqual(result.constructor, { x: 1 });
+  const removed = applyMergePatch(result, JSON.parse('{"__proto__":null}')) as any;
+  assert.ok(!Object.hasOwn(removed, "__proto__"));
+});
+
+test("rejects values that are not JSON", () => {
+  for (const bad of [undefined, NaN, new Date(), new Map(), 1n, () => 1, { a: undefined }]) {
+    assert.throws(() => applyMergePatch({}, bad), JsonMergePatchError);
+    assert.throws(() => applyMergePatch(bad, {}), JsonMergePatchError);
+  }
+});
