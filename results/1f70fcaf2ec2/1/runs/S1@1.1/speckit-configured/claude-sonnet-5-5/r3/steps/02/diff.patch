+
+/** Error thrown for an invalid JSON Patch document or an operation that fails to apply. */
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Container = Record<string, unknown> | unknown[];
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isContainer(value: unknown): value is Container {
+  return typeof value === "object" && value !== null;
+}
+
+function clone<T>(value: T): T {
+  try {
+    return structuredClone(value);
+  } catch {
+    throw new JsonPatchError("Value is not a JSON value");
+  }
+}
+
+// RFC 6901 syntax (section 3) into decoded reference tokens (section 4)
+function parsePointer(pointer: string): string[] {
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new JsonPatchError(`Invalid JSON Pointer: ${pointer}`);
+  }
+  try {
+    return pointer.slice(1).split("/").map(decodeToken);
+  } catch {
+    throw new JsonPatchError(`Invalid JSON Pointer: ${pointer}`);
+  }
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (allowEnd && token === "-") return length;
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new JsonPatchError(`Invalid array index: ${token}`);
+  }
+  const index = Number(token);
+  if (index > length || (index === length && !allowEnd)) {
+    throw new JsonPatchError(`Array index out of range: ${token}`);
+  }
+  return index;
+}
+
+function getValue(root: unknown, tokens: string[]): unknown {
+  let current = root;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      current = current[arrayIndex(token, current.length, false)];
+    } else if (isObject(current) && Object.hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new JsonPatchError(`Path does not exist at '${token}'`);
+    }
+  }
+  return current;
+}
+
+function setMember(target: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty keeps "__proto__" a plain data key instead of invoking the prototype setter
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+// RFC 6902 section 4.1
+function addValue(root: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  const parent = getValue(root, tokens.slice(0, -1));
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(key, parent.length, true), 0, value);
+  } else if (isObject(parent)) {
+    setMember(parent, key, value);
+  } else {
+    throw new JsonPatchError("Parent of the target is not a container");
+  }
+  return root;
+}
+
+// RFC 6902 section 4.2
+function removeValue(root: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) throw new JsonPatchError("Cannot remove the whole document");
+  getValue(root, tokens); // the target must exist
+  const parent = getValue(root, tokens.slice(0, -1)) as Container;
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(key), 1);
+  else delete parent[key];
+  return root;
+}
+
+// RFC 6902 section 4.3
+function replaceValue(root: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  getValue(root, tokens); // the target must exist
+  const parent = getValue(root, tokens.slice(0, -1)) as Container;
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(key)] = value;
+  else setMember(parent, key, value);
+  return root;
+}
+
+// RFC 6902 section 4.6: equality of JSON values
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((k) => Object.hasOwn(b, k) && jsonEqual(a[k], b[k]))
+    );
+  }
+  return a === b;
+}
+
+function member(op: Record<string, unknown>, name: string): unknown {
+  if (!Object.hasOwn(op, name)) throw new JsonPatchError(`Operation is missing '${name}'`);
+  return op[name];
+}
+
+function pointerMember(op: Record<string, unknown>, name: string): string[] {
+  const value = member(op, name);
+  if (typeof value !== "string") throw new JsonPatchError(`'${name}' must be a string`);
+  return parsePointer(value);
+}
+
+/**
+ * Applies a JSON Patch to a JSON document, as specified by RFC 6902 (section 3 document
+ * structure, section 4 operations `add`, `remove`, `replace`, `move`, `copy` and `test`,
+ * section 5 error handling). Paths are JSON Pointers (RFC 6901).
+ *
+ * Operations are applied in order. Neither argument is modified: the result is a new value
+ * that shares no structure with the document or the patch. If the patch is invalid or any
+ * operation fails, nothing is returned and the whole patch has no effect.
+ *
+ * @throws {JsonPatchError} if the patch is not an array of valid operations, or an
+ * operation fails (missing target, invalid index, `move` into its own child, failed `test`).
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchError("A JSON Patch must be an array");
+  let result = clone(document);
+  for (const op of patch as unknown[]) {
+    if (!isObject(op)) throw new JsonPatchError("A patch operation must be an object");
+    const name = member(op, "op");
+    const path = pointerMember(op, "path");
+    switch (name) {
+      case "add":
+        result = addValue(result, path, clone(member(op, "value")));
+        break;
+      case "remove":
+        result = removeValue(result, path);
+        break;
+      case "replace":
+        result = replaceValue(result, path, clone(member(op, "value")));
+        break;
+      case "move":
+      case "copy": {
+        const from = pointerMember(op, "from");
+        const value = clone(getValue(result, from));
+        if (name === "move") {
+          // RFC 6902 section 4.4: "from" must not be a proper prefix of "path"
+          if (from.length < path.length && from.every((t, i) => t === path[i])) {
+            throw new JsonPatchError("Cannot move a value into one of its children");
+          }
+          result = removeValue(result, from);
+        }
+        result = addValue(result, path, value);
+        break;
+      }
+      case "test":
+        if (!jsonEqual(getValue(result, path), member(op, "value"))) {
+          throw new JsonPatchError("Test operation failed");
+        }
+        break;
+      default:
+        throw new JsonPatchError(`Unknown operation: ${String(name)}`);
+    }
+  }
+  return result;
+}
