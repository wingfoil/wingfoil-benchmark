+import { test } from "node:test";
+import assert from "node:assert";
+import { applyPatch, JsonPatchError } from "../src/index.ts";
+
+type Case = [string, unknown, unknown, unknown];
+// RFC 6902 Appendix A examples
+const ok: Case[] = [
+  ["A.1 add member", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" }],
+  ["A.2 add array element", { foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] }],
+  ["A.3 remove member", { baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }],
+  ["A.4 remove element", { foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }],
+  ["A.5 replace", { baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" }],
+  ["A.6 move member", { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } }],
+  ["A.7 move element", { foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], { foo: ["all", "cows", "eat", "grass"] }],
+  ["A.8 test ok", { baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], { baz: "qux", foo: ["a", 2, "c"] }],
+  ["A.10 add nested", { foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } }],
+  ["A.11 add existing member", { foo: "bar" }, [{ op: "add", path: "/foo", value: ["bar", "baz"] }], { foo: ["bar", "baz"] }],
+  ["A.14 tilde escape", { "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }],
+  ["A.15 test number vs string", { "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }],
+  ["A.16 add array value", { foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] }],
+  ["copy", { a: { b: [1] } }, [{ op: "copy", from: "/a", path: "/c" }], { a: { b: [1] }, c: { b: [1] } }],
+  ["replace root", { a: 1 }, [{ op: "add", path: "", value: [1] }], [1]],
+  ["replace whole via replace", 1, [{ op: "replace", path: "", value: null }], null],
+  ["add at length", [1], [{ op: "add", path: "/1", value: 2 }], [1, 2]],
+  ["empty patch", { a: 1 }, [], { a: 1 }],
+  ["null value test", { a: null }, [{ op: "test", path: "/a", value: null }], { a: null }],
+  ["object order ignored", { a: { x: 1, y: 2 } }, [{ op: "test", path: "/a", value: { y: 2, x: 1 } }], { a: { x: 1, y: 2 } }],
+  ["extra members ignored", { a: 1 }, [{ op: "remove", path: "/a", value: 5, foo: 1 }], {}],
+  ["move same path", { a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 }],
+  ["move into own sibling-prefix name", { a: 1 }, [{ op: "move", from: "/a", path: "/ab" }], { ab: 1 }],
+];
+for (const [name, doc, patch, expected] of ok) {
+  test(`applies: ${name}`, () => {
+    const copy = structuredClone(doc);
+    assert.deepStrictEqual(applyPatch(doc, patch), expected);
+    assert.deepStrictEqual(doc, copy);
+  });
+}
+
+const bad: [string, unknown, unknown][] = [
+  ["A.9 test fails", { baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]],
+  ["A.12 add missing parent", { foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]],
+  ["A.15 test type", { a: 10 }, [{ op: "test", path: "/a", value: "10" }]],
+  ["patch not array", {}, { op: "add", path: "/a", value: 1 }],
+  ["op not object", {}, [null]],
+  ["op is array", {}, [[]]],
+  ["missing op", {}, [{ path: "/a", value: 1 }]],
+  ["unknown op", {}, [{ op: "frob", path: "/a" }]],
+  ["op not string", {}, [{ op: 1, path: "/a" }]],
+  ["missing path", {}, [{ op: "add", value: 1 }]],
+  ["path not string", {}, [{ op: "remove", path: 1 }]],
+  ["add without value", {}, [{ op: "add", path: "/a" }]],
+  ["replace without value", { a: 1 }, [{ op: "replace", path: "/a" }]],
+  ["test without value", { a: 1 }, [{ op: "test", path: "/a" }]],
+  ["move without from", { a: 1 }, [{ op: "move", path: "/b" }]],
+  ["copy from not string", { a: 1 }, [{ op: "copy", from: 1, path: "/b" }]],
+  ["remove missing", {}, [{ op: "remove", path: "/a" }]],
+  ["replace missing", {}, [{ op: "replace", path: "/a", value: 1 }]],
+  ["replace '-'", [1], [{ op: "replace", path: "/-", value: 1 }]],
+  ["remove '-'", [1], [{ op: "remove", path: "/-" }]],
+  ["move missing from", {}, [{ op: "move", from: "/a", path: "/b" }]],
+  ["copy missing from", {}, [{ op: "copy", from: "/a", path: "/b" }]],
+  ["move into own child", { a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]],
+  ["move from root", { a: 1 }, [{ op: "move", from: "", path: "/a" }]],
+  ["add index > length", [1], [{ op: "add", path: "/2", value: 1 }]],
+  ["leading zero index", [1, 2], [{ op: "add", path: "/01", value: 1 }]],
+  ["non numeric index", [1], [{ op: "add", path: "/x", value: 1 }]],
+  ["negative index", [1], [{ op: "add", path: "/-1", value: 1 }]],
+  ["remove out of range", [1], [{ op: "remove", path: "/1" }]],
+  ["invalid pointer", {}, [{ op: "add", path: "a", value: 1 }]],
+  ["invalid escape", {}, [{ op: "add", path: "/a~2", value: 1 }]],
+  ["add into primitive", { a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]],
+  ["inherited key not found", {}, [{ op: "remove", path: "/toString" }]],
+  ["test array order", { a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]],
+  ["test missing member", {}, [{ op: "test", path: "/a", value: null }]],
+  ["test null vs object", { a: null }, [{ op: "test", path: "/a", value: {} }]],
+  ["test array vs object", { a: [] }, [{ op: "test", path: "/a", value: {} }]],
+];
+for (const [name, doc, patch] of bad) {
+  test(`throws: ${name}`, () => {
+    const copy = structuredClone(doc);
+    assert.throws(() => applyPatch(doc, patch), JsonPatchError);
+    assert.deepStrictEqual(doc, copy);
+  });
+}
+
+test("failure part-way leaves input unchanged", () => {
+  const doc = { a: { b: 1 } };
+  assert.throws(() => applyPatch(doc, [{ op: "remove", path: "/a/b" }, { op: "remove", path: "/zz" }]), JsonPatchError);
+  assert.deepStrictEqual(doc, { a: { b: 1 } });
+});
+
+test("result does not alias patch values or input", () => {
+  const value = { x: [1] };
+  const doc = { k: { y: 1 } };
+  const out = applyPatch(doc, [{ op: "add", path: "/v", value }, { op: "copy", from: "/v", path: "/w" }]) as any;
+  assert.notStrictEqual(out.v, value);
+  assert.notStrictEqual(out.k, doc.k);
+  assert.notStrictEqual(out.w, out.v);
+  out.v.x.push(2);
+  assert.deepStrictEqual(value, { x: [1] });
+});
+
+test("__proto__ is a plain key and does not pollute", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: 1 } }]) as any;
+  assert.strictEqual(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepStrictEqual(Object.keys(out), ["__proto__"]);
+  assert.strictEqual(({} as any).polluted, undefined);
+  const out2 = applyPatch({}, [{ op: "add", path: "/__proto__", value: 1 }, { op: "add", path: "/constructor", value: 2 }]) as any;
+  assert.strictEqual(Object.getPrototypeOf(out2), Object.prototype);
+  assert.strictEqual(Object.hasOwn(out2, "constructor"), true);
+});
