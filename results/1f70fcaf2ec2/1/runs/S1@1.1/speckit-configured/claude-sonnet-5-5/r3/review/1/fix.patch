@@ -131,3 +131,12 @@ for (const [name, value] of [
 test("throws: non-JSON document", () => {
   assert.throws(() => applyPatch({ a: new Date(0) }, []), JsonPatchError);
 });
+
+test("applyPatch rejects circular input with JsonPatchError", () => {
+  const circular: Record<string, unknown> = {};
+  circular.self = circular;
+  assert.throws(() => applyPatch(circular, []), JsonPatchError);
+  const arr: unknown[] = [];
+  arr.push(arr);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: arr }]), JsonPatchError);
+});
