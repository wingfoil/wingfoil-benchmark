diff --git a/src/index.ts b/src/index.ts
index a6e38b98d387318d7fd60eaed77d71fd575a65c8..219d84a43d2b74677a4004a4831bdacb1b048d9c 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -81,23 +81,30 @@ function isContainer(value: unknown): value is Container {
 }
 
 // RFC 8259: only null, booleans, finite numbers, strings, arrays and plain objects are JSON values
-function assertJson(value: unknown): void {
+function assertJson(value: unknown, ancestors: object[] = []): void {
   if (value === null || typeof value === "string" || typeof value === "boolean") return;
   if (typeof value === "number" && Number.isFinite(value)) return;
+  if (typeof value === "object" && ancestors.includes(value)) {
+    throw new JsonPatchError("Value is not a JSON value (circular reference)");
+  }
   if (Array.isArray(value)) {
+    ancestors.push(value);
     for (let i = 0; i < value.length; i++) {
       if (!(i in value)) throw new JsonPatchError("Value is not a JSON value");
-      assertJson(value[i]);
+      assertJson(value[i], ancestors);
     }
+    ancestors.pop();
     return;
   }
   if (typeof value === "object") {
     const proto = Object.getPrototypeOf(value);
     if (proto === Object.prototype || proto === null) {
+      ancestors.push(value);
       for (const key of Reflect.ownKeys(value)) {
         if (typeof key === "symbol") throw new JsonPatchError("Value is not a JSON value");
-        assertJson((value as Record<string, unknown>)[key]);
+        assertJson((value as Record<string, unknown>)[key], ancestors);
       }
+      ancestors.pop();
       return;
     }
   }
diff --git a/test/patch.test.ts b/test/patch.test.ts
index 4ade6a76716f0b4252148096f11bbd63ae9349ba..9e52a6fa99622dc250e2b67f1a80554357042cc1 100644
