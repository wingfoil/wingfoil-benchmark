diff --git a/specs/003-patch-conformance/spec.md b/specs/003-patch-conformance/spec.md
new file mode 100644
index 0000000000000000000000000000000000000000..c90b6e5e8ee050286750c1f2c0bde400edc97ae0
--- /dev/null
+++ b/specs/003-patch-conformance/spec.md
@@ -0,0 +1,9 @@
+# Spec 003: applyPatch conformance review (RFC 6902 sections 3, 4, 5; RFC 8259)
+
+Review of operations against RFC 6902 found one deviation: values that are not JSON values
+(`Date`, `Map`, `NaN`, `undefined`, ...) were silently accepted or coerced (`NaN` to `null`, `Date` kept).
+They are now rejected with `JsonPatchError` before any change, in the document, `add`/`replace` values and
+`test` values. Tests added in `test/patch.test.ts`.
+
+Open point surfaced, unchanged: `remove` with path `""` is rejected (RFC 6902 does not define the result;
+documented in README).
diff --git a/src/index.ts b/src/index.ts
index 225a11cd22a5997562fe41f312c3b7fa089d6e33..a6531e8e5f57bb762f1fa98c5849054b590eab1c 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -80,12 +80,33 @@ function isContainer(value: unknown): value is Container {
   return typeof value === "object" && value !== null;
 }
 
-function clone<T>(value: T): T {
-  try {
-    return structuredClone(value);
-  } catch {
-    throw new JsonPatchError("Value is not a JSON value");
+// RFC 8259: only null, booleans, finite numbers, strings, arrays and plain objects are JSON values
+function assertJson(value: unknown): void {
+  if (value === null || typeof value === "string" || typeof value === "boolean") return;
+  if (typeof value === "number" && Number.isFinite(value)) return;
+  if (Array.isArray(value)) {
+    for (let i = 0; i < value.length; i++) {
+      if (!(i in value)) throw new JsonPatchError("Value is not a JSON value");
+      assertJson(value[i]);
+    }
+    return;
+  }
+  if (typeof value === "object") {
+    const proto = Object.getPrototypeOf(value);
+    if (proto === Object.prototype || proto === null) {
+      for (const key of Reflect.ownKeys(value)) {
+        if (typeof key === "symbol") throw new JsonPatchError("Value is not a JSON value");
+        assertJson((value as Record<string, unknown>)[key]);
+      }
+      return;
+    }
   }
+  throw new JsonPatchError("Value is not a JSON value");
+}
+
+function clone<T>(value: T): T {
+  assertJson(value);
+  return structuredClone(value);
 }
 
 // RFC 6901 syntax (section 3) into decoded reference tokens (section 4)
@@ -240,7 +261,9 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
         break;
       }
       case "test":
-        if (!jsonEqual(getValue(result, path), member(op, "value"))) {
+        const expected = member(op, "value");
+        assertJson(expected);
+        if (!jsonEqual(getValue(result, path), expected)) {
           throw new JsonPatchError("Test operation failed");
         }
         break;
