index 0000000000000000000000000000000000000000..fa26cdc003d8e3fa58a8e3ada22553571fcf6b90
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,93 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+const rfcDocument = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+const rfcExamples: [string, unknown][] = [
+  ["", rfcDocument],
+  ["/foo", ["bar", "baz"]],
+  ["/foo/0", "bar"],
+  ["/", 0],
+  ["/a~1b", 1],
+  ["/c%d", 2],
+  ["/e^f", 3],
+  ["/g|h", 4],
+  ["/i\\j", 5],
+  ['/k"l', 6],
+  ["/ ", 7],
+  ["/m~0n", 8],
+];
+
+for (const [pointer, expected] of rfcExamples) {
+  test(`RFC 6901 example ${JSON.stringify(pointer)}`, () => {
+    assert.deepEqual(resolvePointer(rfcDocument, pointer), expected);
+  });
+}
+
+test("resolves falsy values", () => {
+  assert.equal(resolvePointer({ a: null, b: false, c: "" }, "/a"), null);
+  assert.equal(resolvePointer({ a: null, b: false, c: "" }, "/b"), false);
+  assert.equal(resolvePointer({ a: null, b: false, c: "" }, "/c"), "");
+});
+
+test("resolves a pointer on a primitive document", () => {
+  assert.equal(resolvePointer(5, ""), 5);
+});
+
+test("unescapes ~01 as ~1, not as /", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("resolves nested arrays and objects", () => {
+  assert.equal(resolvePointer({ a: [{ b: [10, 20] }] }, "/a/0/b/1"), 20);
+});
+
+for (const pointer of ["foo", "a/b", " /foo", "/a~", "/a~2", "/~x", "/a/~"]) {
+  test(`rejects invalid pointer ${JSON.stringify(pointer)}`, () => {
+    assert.throws(() => resolvePointer({ a: 1 }, pointer));
+  });
+}
+
+test("rejects a non-string pointer", () => {
+  assert.throws(() => resolvePointer({}, undefined as unknown as string));
+});
+
+const unresolvable: [string, unknown, string][] = [
+  ["missing object member", { a: 1 }, "/b"],
+  ["member of a primitive", { a: 1 }, "/a/b"],
+  ["member of null", { a: null }, "/a/b"],
+  ["array index out of range", [1, 2], "/2"],
+  ["the '-' array token", [1, 2], "/-"],
+  ["leading zero index", [1, 2], "/01"],
+  ["signed index", [1, 2], "/+1"],
+  ["negative index", [1, 2], "/-1"],
+  ["non-numeric index", [1, 2], "/a"],
+  ["decimal index", [1, 2], "/1.0"],
+  ["empty index", [1, 2], "/"],
+  ["inherited property", {}, "/toString"],
+  ["inherited __proto__", {}, "/__proto__"],
+  ["array length", [1], "/length"],
+];
+
+for (const [name, document, pointer] of unresolvable) {
+  test(`throws on ${name}`, () => {
+    assert.throws(() => resolvePointer(document, pointer));
+  });
+}
+
+test("resolves an own member named __proto__", () => {
+  const document = JSON.parse('{"__proto__": 1}');
+  assert.equal(resolvePointer(document, "/__proto__"), 1);
+});
