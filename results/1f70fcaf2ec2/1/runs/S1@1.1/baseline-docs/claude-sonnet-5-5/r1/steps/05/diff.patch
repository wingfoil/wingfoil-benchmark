diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3cc5b6c0da535321de7f7c3a0f45dfabb1ee54d5
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,67 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown) {
+  const before = structuredClone(from);
+  const target = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, before);
+  assert.deepEqual(to, target);
+  return patch;
+}
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a small change deep in a document is a single operation", () => {
+  assert.deepEqual(roundTrip({ a: { b: { c: 1, d: 2 } }, e: [1] }, { a: { b: { c: 1, d: 3 } }, e: [1] }), [
+    { op: "replace", path: "/a/b/d", value: 3 },
+  ]);
+});
+
+test("object members are added and removed, with escaped pointers", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "m~n": 2 }, { "m~n": 2, c: null }), [
+    { op: "remove", path: "/a~1b" },
+    { op: "add", path: "/c", value: null },
+  ]);
+});
+
+test("root and type changes are replaced", () => {
+  assert.deepEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  roundTrip({ a: [1] }, { a: { 0: 1 } });
+  roundTrip([1], null);
+});
+
+test("an inserted or removed array item does not rewrite its neighbours", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([], [1]), [{ op: "add", path: "/0", value: 1 }]);
+});
+
+test("a moved array item is not rewritten along with the items between", () => {
+  const patch = roundTrip(["a", "b", "c", "d", "e"], ["a", "e", "b", "c", "d"]);
+  assert.ok(patch.length <= 2);
+  roundTrip([{ id: 1 }, { id: 2 }, { id: 3 }], [{ id: 3 }, { id: 1 }, { id: 2 }]);
+});
+
+test("a changed array item is patched in place", () => {
+  assert.deepEqual(roundTrip([{ id: 1, v: 1 }, { id: 2, v: 2 }], [{ id: 1, v: 1 }, { id: 2, v: 3 }]), [
+    { op: "replace", path: "/1/v", value: 3 },
+  ]);
+});
+
+test("mixed array edits round-trip", () => {
+  roundTrip([1, 2, 3, 4, 5, 6], [6, 2, 7, 8, 4]);
+  roundTrip([[1, 2], [3]], [[3], [1, 2, 5]]);
+  roundTrip([1, 1, 1], [1, 1]);
+});
+
+test("the patch shares no structure with the inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0] as { value: { b: number } }).value.b = 2;
+  assert.equal(to.a.b, 1);
+});
