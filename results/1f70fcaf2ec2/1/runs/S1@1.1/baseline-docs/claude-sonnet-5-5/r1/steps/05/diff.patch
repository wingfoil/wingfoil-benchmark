+++ b/src/create-patch.ts
@@ -0,0 +1,95 @@
+import { deepEqual, isObject, type PatchOperation } from "./patch.ts";
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function child(path: string, token: string | number): string {
+  return `${path}/${escapeToken(String(token))}`;
+}
+
+/** Returns, for the longest common subsequence of `a` and `b`, the matched index pairs in order. */
+function commonPairs(a: unknown[], b: unknown[]): [number, number][] {
+  const lengths = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lengths[i][j] = deepEqual(a[i], b[j]) ? lengths[i + 1][j + 1] + 1 : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  const pairs: [number, number][] = [];
+  let i = 0;
+  let j = 0;
+  while (i < a.length && j < b.length) {
+    if (deepEqual(a[i], b[j])) {
+      pairs.push([i++, j++]);
+    } else if (lengths[i + 1][j] >= lengths[i][j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
+
+function diffGap(from: unknown[], to: unknown[], path: string, start: number, out: PatchOperation[]): void {
+  const paired = Math.min(from.length, to.length);
+  for (let k = 0; k < paired; k++) {
+    diff(from[k], to[k], child(path, start + k), out);
+  }
+  for (let k = paired; k < from.length; k++) {
+    out.push({ op: "remove", path: child(path, start + paired) });
+  }
+  for (let k = paired; k < to.length; k++) {
+    out.push({ op: "add", path: child(path, start + k), value: structuredClone(to[k]) });
+  }
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, out: PatchOperation[]): void {
+  const anchors = [...commonPairs(from, to), [from.length, to.length] as [number, number]];
+  let fromStart = 0;
+  let toStart = 0;
+  for (const [fromAnchor, toAnchor] of anchors) {
+    diffGap(from.slice(fromStart, fromAnchor), to.slice(toStart, toAnchor), path, toStart, out);
+    fromStart = fromAnchor + 1;
+    toStart = toAnchor + 1;
+  }
+}
+
+function diffObjects(from: Record<string, unknown>, to: Record<string, unknown>, path: string, out: PatchOperation[]): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      out.push({ op: "remove", path: child(path, key) });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (Object.hasOwn(from, key)) {
+      diff(from[key], to[key], child(path, key), out);
+    } else {
+      out.push({ op: "add", path: child(path, key), value: structuredClone(to[key]) });
+    }
+  }
+}
+
+function diff(from: unknown, to: unknown, path: string, out: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from, to, path, out);
+  } else if (!deepEqual(from, to)) {
+    out.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch holds only what changed: objects are compared member by member and arrays by their
+ * longest common run of items, so an inserted or removed item is an `add` or `remove`, and a moved
+ * item is a `remove` followed by an `add`, without rewriting the items around it. Neither input is
+ * mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diff(from, to, "", out);
+  return out;
+}
