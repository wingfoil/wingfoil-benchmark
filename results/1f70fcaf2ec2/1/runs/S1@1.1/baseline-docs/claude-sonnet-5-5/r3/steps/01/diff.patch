index ff92be649ff3f610b38798b3310751534d032814..a617d479079fd14fe861df0eb6aeabc5e9091f74 100644
--- a/README.md
+++ b/README.md
@@ -3,3 +3,19 @@
 A small TypeScript library, with no runtime dependency, of building blocks for our services that store,
 exchange and update JSON: configuration files, API payloads and stored records. It is imported by the
 other projects of the team, so its behaviour must follow the published standards it implements.
+
+## JSON Pointer (RFC 6901)
+
+`resolvePointer(document, pointer)`, exported from `src/index.ts`, returns the value a JSON Pointer
+refers to.
+
+```ts
+resolvePointer({ foo: ["bar", "baz"] }, "/foo/1"); // "baz"
+resolvePointer({ a: 1 }, "");                      // the whole document
+```
+
+It throws an `Error` when the pointer is syntactically invalid (not empty and not starting with `/`, or
+a `~` not followed by `0` or `1`), and when it resolves to nothing: a missing member, an out-of-range or
+non-canonical array index (`01`, `-1`), the `-` token, or a step into a primitive. Inherited properties
+(`/constructor`, `/__proto__` on a plain object) are never resolved: only own members are, so
+untrusted pointers cannot reach prototypes. Run the tests with `npm test`.
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9d7c4664174632a63a2ec717f66591682d12bd23
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,60 @@
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/** Decodes one reference token (RFC 6901 §4); `~1` and `~0` are decoded in a single pass so `~01` gives `~1`. */
+function unescapeToken(token: string, pointer: string): string {
+  return token.replace(/~(.?)/g, (_, code: string) => {
+    if (code === "0") return "~";
+    if (code === "1") return "/";
+    throw new Error(`Invalid JSON Pointer ${JSON.stringify(pointer)}: bad escape in "${token}"`);
+  });
+}
+
+/** Splits a pointer into decoded reference tokens, throwing if the syntax is invalid (RFC 6901 §3). */
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: must be a string");
+  }
+  if (pointer === "") return [];
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer ${JSON.stringify(pointer)}: must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => unescapeToken(token, pointer));
+}
+
+/** Looks up the child of `value` named by `token`; arrays only accept canonical indexes (no sign, no leading zeros, no `-`). */
+function child(value: unknown, token: string): { found: true; value: unknown } | { found: false } {
+  if (Array.isArray(value)) {
+    const index = ARRAY_INDEX.test(token) ? Number(token) : -1;
+    return index >= 0 && index < value.length ? { found: true, value: value[index] } : { found: false };
+  }
+  if (typeof value === "object" && value !== null && Object.hasOwn(value, token)) {
+    return { found: true, value: (value as Record<string, unknown>)[token] };
+  }
+  return { found: false };
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * Only own members and existing array elements resolve, so pointers such as `/constructor` or
+ * `/-` never reach inherited properties or the "past the end" position.
+ *
+ * @param document - The JSON document to read from.
+ * @param pointer - A JSON Pointer string, e.g. `"/foo/0"`; `""` designates the whole document.
+ * @returns The value the pointer refers to (which may be `null`, `false`, `0` or `""`).
+ * @throws If `pointer` is not a valid JSON Pointer, or if it refers to no value of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const token of parsePointer(pointer)) {
+    const next = child(current, token);
+    if (!next.found) {
+      throw new Error(`JSON Pointer ${JSON.stringify(pointer)} does not resolve to a value of the document`);
+    }
+    current = next.value;
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e7c0ddecefa1f75c3e6b4b8df53452a1efc77837
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,120 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// The document of RFC 6901, section 5, and its published pointer/value pairs.
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+const examples: [string, unknown][] = [
+  ["", rfc],
+  ["/foo", ["bar", "baz"]],
+  ["/foo/0", "bar"],
+  ["/", 0],
+  ["/a~1b", 1],
+  ["/c%d", 2],
+  ["/e^f", 3],
+  ["/g|h", 4],
+  ["/i\\j", 5],
+  ['/k"l', 6],
+  ["/ ", 7],
+  ["/m~0n", 8],
+];
+
+for (const [pointer, expected] of examples) {
+  test(`RFC 6901 example ${JSON.stringify(pointer)}`, () => {
+    assert.deepEqual(resolvePointer(rfc, pointer), expected);
+  });
+}
+
+test("resolves falsy and null values", () => {
+  const doc = { a: null, b: false, c: 0, d: "", e: [null] };
+  assert.equal(resolvePointer(doc, "/a"), null);
+  assert.equal(resolvePointer(doc, "/b"), false);
+  assert.equal(resolvePointer(doc, "/c"), 0);
+  assert.equal(resolvePointer(doc, "/d"), "");
+  assert.equal(resolvePointer(doc, "/e/0"), null);
+});
+
+test("empty pointer returns any document, including primitives", () => {
+  assert.equal(resolvePointer(null, ""), null);
+  assert.equal(resolvePointer(5, ""), 5);
+});
+
+test("decodes ~01 as ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+});
+
+test("resolves nested objects and arrays", () => {
+  assert.equal(resolvePointer({ a: [{ b: [10, 20] }] }, "/a/0/b/1"), 20);
+});
+
+test("rejects a pointer that does not start with /", () => {
+  for (const p of ["foo", "a/b", " /a"]) {
+    assert.throws(() => resolvePointer({ foo: 1 }, p), /invalid/i);
+  }
+});
+
+test("rejects bad escapes", () => {
+  for (const p of ["/~", "/~2", "/a~", "/~a/b"]) {
+    assert.throws(() => resolvePointer({}, p), /invalid/i);
+  }
+});
+
+test("rejects non-string pointers", () => {
+  assert.throws(() => resolvePointer({}, undefined as never), /invalid/i);
+  assert.throws(() => resolvePointer({}, 1 as never), /invalid/i);
+});
+
+test("throws when an object member is missing", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"), /does not resolve/i);
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"), /does not resolve/i);
+  assert.throws(() => resolvePointer({ a: {} }, "/a/"), /does not resolve/i);
+});
+
+test("does not resolve inherited properties", () => {
+  for (const p of ["/__proto__", "/constructor", "/toString", "/hasOwnProperty"]) {
+    assert.throws(() => resolvePointer({}, p), /does not resolve/i);
+  }
+  assert.throws(() => resolvePointer([], "/length"), /does not resolve/i);
+  assert.throws(() => resolvePointer({ a: [] }, "/a/constructor"), /does not resolve/i);
+});
+
+test("resolves an own member named __proto__", () => {
+  const doc = JSON.parse('{"__proto__": 3}');
+  assert.equal(resolvePointer(doc, "/__proto__"), 3);
+});
+
+test("throws when an array index is out of range", () => {
+  assert.throws(() => resolvePointer(["a"], "/1"), /does not resolve/i);
+});
+
+test("throws on the '-' array token, which names no element", () => {
+  assert.throws(() => resolvePointer(["a"], "/-"), /does not resolve/i);
+});
+
+test("throws on array indexes that are not canonical", () => {
+  for (const p of ["/01", "/+1", "/-1", "/1.0", "/1e0", "/0x1", "/ 1", "/", "/a"]) {
+    assert.throws(() => resolvePointer(["a", "b", "c"], p), /does not resolve/i);
+  }
+});
+
+test("digit-only token on an object is a member name", () => {
+  assert.equal(resolvePointer({ "0": "x" }, "/0"), "x");
+});
+
+test("throws when descending into a primitive or null", () => {
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"), /does not resolve/i);
+  assert.throws(() => resolvePointer("abc", "/0"), /does not resolve/i);
+  assert.throws(() => resolvePointer({ a: "abc" }, "/a/0"), /does not resolve/i);
+});
