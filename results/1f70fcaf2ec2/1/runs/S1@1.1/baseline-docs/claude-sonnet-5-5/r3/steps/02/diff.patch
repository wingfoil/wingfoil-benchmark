diff --git a/src/patch.ts b/src/patch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..77dee630779f0b61def5663d5cbfef31f9b6b07f
--- /dev/null
+++ b/src/patch.ts
@@ -0,0 +1,142 @@
+import { ARRAY_INDEX, child, parsePointer, resolvePointer } from "./pointer.ts";
+
+type Json = unknown;
+type Operation = { op: string; path: string; from?: string; value?: Json };
+
+const OPERATIONS = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Checks one patch element (RFC 6902 §4): known `op`, string `path`, and the members that `op` requires. */
+function validate(operation: unknown, position: number): Operation {
+  const where = `Invalid JSON Patch: operation ${position}`;
+  if (!isObject(operation)) throw new Error(`${where} is not an object`);
+  const { op, path } = operation;
+  if (typeof op !== "string" || !OPERATIONS.has(op)) throw new Error(`${where} has an unknown "op"`);
+  if (typeof path !== "string") throw new Error(`${where} has no string "path"`);
+  const needsValue = op === "add" || op === "replace" || op === "test";
+  if (needsValue && !Object.hasOwn(operation, "value")) throw new Error(`${where} (${op}) has no "value"`);
+  const needsFrom = op === "move" || op === "copy";
+  if (needsFrom && typeof operation.from !== "string") throw new Error(`${where} (${op}) has no string "from"`);
+  return operation as Operation;
+}
+
+/** Sets an own member, never touching the prototype even for the key `__proto__`. */
+function setMember(target: Record<string, unknown>, key: string, value: Json): void {
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Finds the container holding the location `tokens` designates, which must exist and be an array or object. */
+function parentOf(root: Json, tokens: string[], path: string): Json {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    const next = child(current, token);
+    if (!next.found) throw new Error(`JSON Patch path ${JSON.stringify(path)} does not exist`);
+    current = next.value;
+  }
+  if (typeof current !== "object" || current === null) {
+    throw new Error(`JSON Patch path ${JSON.stringify(path)} does not exist`);
+  }
+  return current;
+}
+
+/** Index of an existing array element, or -1 when `token` is not a canonical index of it. */
+function existingIndex(array: unknown[], token: string): number {
+  const index = ARRAY_INDEX.test(token) ? Number(token) : -1;
+  return index < array.length ? index : -1;
+}
+
+/** Adds `value` at `path` (RFC 6902 §4.1), returning the new root. */
+function add(root: Json, path: string, value: Json): Json {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens, path);
+  const key = tokens[tokens.length - 1];
+  if (!Array.isArray(parent)) {
+    setMember(parent as Record<string, unknown>, key, value);
+  } else if (key === "-") {
+    parent.push(value);
+  } else {
+    const index = ARRAY_INDEX.test(key) ? Number(key) : -1;
+    if (index < 0 || index > parent.length) throw new Error(`JSON Patch index ${JSON.stringify(path)} is out of range`);
+    parent.splice(index, 0, value);
+  }
+  return root;
+}
+
+/** Removes the value at `path` (RFC 6902 §4.2), returning the new root; the root itself cannot be removed. */
+function remove(root: Json, path: string): Json {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) throw new Error("JSON Patch cannot remove the whole document");
+  const parent = parentOf(root, tokens, path);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    const index = existingIndex(parent, key);
+    if (index < 0) throw new Error(`JSON Patch path ${JSON.stringify(path)} does not exist`);
+    parent.splice(index, 1);
+  } else if (Object.hasOwn(parent, key)) {
+    delete (parent as Record<string, unknown>)[key];
+  } else {
+    throw new Error(`JSON Patch path ${JSON.stringify(path)} does not exist`);
+  }
+  return root;
+}
+
+/** Deep equality of two JSON values (RFC 6902 §4.6): object member order is irrelevant. */
+function equal(a: Json, b: Json): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((item, i) => equal(item, b[i]));
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((k) => Object.hasOwn(b, k) && equal(a[k], b[k]));
+  }
+  return a === b;
+}
+
+function applyOperation(root: Json, { op, path, from, value }: Operation): Json {
+  switch (op) {
+    case "add":
+      return add(root, path, structuredClone(value));
+    case "remove":
+      return remove(root, path);
+    case "replace":
+      resolvePointer(root, path);
+      return path === "" ? structuredClone(value) : add(remove(root, path), path, structuredClone(value));
+    case "move": {
+      const source = from as string;
+      const moved = resolvePointer(root, source);
+      if (source === path) return root;
+      if (path.startsWith(`${source}/`)) throw new Error("JSON Patch cannot move a value into one of its own children");
+      return add(remove(root, source), path, moved);
+    }
+    case "copy":
+      return add(root, path, structuredClone(resolvePointer(root, from as string)));
+    default:
+      if (!equal(resolvePointer(root, path), value)) throw new Error(`JSON Patch test failed at ${JSON.stringify(path)}`);
+      return root;
+  }
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document.
+ *
+ * Operations run in order on a deep copy, so neither `document` nor `patch` is mutated and a failing
+ * patch has no partial effect. Unrecognized members of an operation are ignored, as the RFC requires.
+ * Removing the whole document is rejected, since no JSON value would be left.
+ *
+ * @param document - The JSON document to patch.
+ * @param patch - An array of operations (`add`, `remove`, `replace`, `move`, `copy`, `test`).
+ * @returns The patched document, sharing no structure with the inputs.
+ * @throws If the patch is not a valid array of operations, or an operation fails (including a failed `test`).
+ */
+export function applyPatch(document: unknown, patch: unknown[]): unknown {
+  if (!Array.isArray(patch)) throw new Error("Invalid JSON Patch: must be an array of operations");
+  let root = structuredClone(document);
+  patch.forEach((operation, position) => {
+    root = applyOperation(root, validate(operation, position));
+  });
+  return root;
+}
diff --git a/src/pointer.ts b/src/pointer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4895333e1e60466eb33ed696ed5fe4869505c453
--- /dev/null
+++ b/src/pointer.ts
@@ -0,0 +1,60 @@
+export const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/** Decodes one reference token (RFC 6901 §4); `~1` and `~0` are decoded in a single pass so `~01` gives `~1`. */
+function unescapeToken(token: string, pointer: string): string {
+  return token.replace(/~(.?)/g, (_, code: string) => {
+    if (code === "0") return "~";
+    if (code === "1") return "/";
+    throw new Error(`Invalid JSON Pointer ${JSON.stringify(pointer)}: bad escape in "${token}"`);
+  });
+}
+
+/** Splits a pointer into decoded reference tokens, throwing if the syntax is invalid (RFC 6901 §3). */
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: must be a string");
+  }
+  if (pointer === "") return [];
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer ${JSON.stringify(pointer)}: must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => unescapeToken(token, pointer));
+}
+
+/** Looks up the child of `value` named by `token`; arrays only accept canonical indexes (no sign, no leading zeros, no `-`). */
+export function child(value: unknown, token: string): { found: true; value: unknown } | { found: false } {
+  if (Array.isArray(value)) {
+    const index = ARRAY_INDEX.test(token) ? Number(token) : -1;
+    return index >= 0 && index < value.length ? { found: true, value: value[index] } : { found: false };
+  }
+  if (typeof value === "object" && value !== null && Object.hasOwn(value, token)) {
+    return { found: true, value: (value as Record<string, unknown>)[token] };
+  }
+  return { found: false };
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * Only own members and existing array elements resolve, so pointers such as `/constructor` or
+ * `/-` never reach inherited properties or the "past the end" position.
+ *
+ * @param document - The JSON document to read from.
+ * @param pointer - A JSON Pointer string, e.g. `"/foo/0"`; `""` designates the whole document.
+ * @returns The value the pointer refers to (which may be `null`, `false`, `0` or `""`).
+ * @throws If `pointer` is not a valid JSON Pointer, or if it refers to no value of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const token of parsePointer(pointer)) {
+    const next = child(current, token);
+    if (!next.found) {
+      throw new Error(`JSON Pointer ${JSON.stringify(pointer)} does not resolve to a value of the document`);
+    }
+    current = next.value;
+  }
+  return current;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..44a333d5a4780358353522e0935d657a3c52c7d8
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,154 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+// Examples of RFC 6902, appendix A.
+const appendixA: [string, unknown, unknown[], unknown][] = [
+  ["A.1 add object member", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" }],
+  [
+    "A.2 add array element",
+    { foo: ["bar", "baz"] },
+    [{ op: "add", path: "/foo/1", value: "qux" }],
+    { foo: ["bar", "qux", "baz"] },
+  ],
+  ["A.3 remove object member", { baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }],
+  ["A.4 remove array element", { foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }],
+  [
+    "A.5 replace value",
+    { baz: "qux", foo: "bar" },
+    [{ op: "replace", path: "/baz", value: "boo" }],
+    { baz: "boo", foo: "bar" },
+  ],
+  [
+    "A.6 move value",
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  ],
+  [
+    "A.7 move array element",
+    { foo: ["all", "grass", "cows", "eat"] },
+    [{ op: "move", from: "/foo/1", path: "/foo/3" }],
+    { foo: ["all", "cows", "eat", "grass"] },
+  ],
+  ["A.8 test success", { baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], { baz: "qux", foo: ["a", 2, "c"] }],
+  [
+    "A.10 add nested member",
+    { foo: "bar" },
+    [{ op: "add", path: "/child", value: { grandchild: {} } }],
+    { foo: "bar", child: { grandchild: {} } },
+  ],
+  ["A.11 ignore unrecognized elements", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" }],
+  ["A.14 ~ escape ordering", { "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }],
+  ["A.16 add array value", { foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] }],
+];
+
+for (const [name, doc, patch, expected] of appendixA) {
+  test(name, () => assert.deepEqual(applyPatch(doc, patch), expected));
+}
+
+const failing: [string, unknown, unknown[]][] = [
+  ["A.9 test failure", { baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]],
+  ["A.12 add to nonexistent target", { foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]],
+  ["A.13 invalid JSON in patch", { foo: "bar" }, [{ op: "add", path: "/baz" }]],
+  ["unknown op", {}, [{ op: "frobnicate", path: "" }]],
+  ["op not a string", {}, [{ op: 1, path: "" }]],
+  ["operation not an object", {}, [null]],
+  ["missing path", {}, [{ op: "remove" }]],
+  ["patch not an array", {}, {} as unknown as unknown[]],
+  ["add index past the end", [1], [{ op: "add", path: "/2", value: 0 }]],
+  ["add non-canonical index", [1], [{ op: "add", path: "/01", value: 0 }]],
+  ["add negative index", [1], [{ op: "add", path: "/-1", value: 0 }]],
+  ["remove missing member", {}, [{ op: "remove", path: "/a" }]],
+  ["remove with '-'", [1], [{ op: "remove", path: "/-" }]],
+  ["remove root", {}, [{ op: "remove", path: "" }]],
+  ["replace missing member", {}, [{ op: "replace", path: "/a", value: 1 }]],
+  ["replace without value", { a: 1 }, [{ op: "replace", path: "/a" }]],
+  ["move without from", { a: 1 }, [{ op: "move", path: "/b" }]],
+  ["move from missing", { a: 1 }, [{ op: "move", from: "/x", path: "/b" }]],
+  ["move into own child", { a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]],
+  ["copy from missing", { a: 1 }, [{ op: "copy", from: "/x", path: "/b" }]],
+  ["test missing path", {}, [{ op: "test", path: "/a", value: null }]],
+  ["test without value", { a: 1 }, [{ op: "test", path: "/a" }]],
+  ["invalid pointer", {}, [{ op: "add", path: "a", value: 1 }]],
+  ["step into primitive", { a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]],
+  ["inherited member", {}, [{ op: "remove", path: "/constructor" }]],
+];
+
+for (const [name, doc, patch] of failing) {
+  test(`throws: ${name}`, () => assert.throws(() => applyPatch(doc, patch), Error));
+}
+
+test("replaces and adds at the root", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch(1, [{ op: "add", path: "", value: { b: 2 } }]), { b: 2 });
+});
+
+test("add replaces an existing object member", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+});
+
+test("add appends at index equal to the length", () => {
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/1", value: 2 }]), [1, 2]);
+});
+
+test("move to the same location is a no-op", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+});
+
+test("move to the root replaces the document", () => {
+  assert.deepEqual(applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "" }]), { b: 1 });
+});
+
+test("copy duplicates without aliasing", () => {
+  const result = applyPatch({ a: { x: 1 } }, [
+    { op: "copy", from: "/a", path: "/b" },
+    { op: "add", path: "/b/y", value: 2 },
+  ]) as { a: object; b: object };
+  assert.deepEqual(result, { a: { x: 1 }, b: { x: 1, y: 2 } });
+});
+
+test("test compares deeply, ignoring member order, and distinguishes types", () => {
+  const doc = { a: { x: 1, y: [1, { z: null }] }, n: 1, s: "1" };
+  applyPatch(doc, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }]);
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/n", value: "1" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/y", value: [{ z: null }, 1] }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a", value: { x: 1 } }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/n", value: null }]));
+});
+
+test("does not mutate the document or the patch", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const patch = [
+    { op: "add", path: "/a/-", value: { k: [] } },
+    { op: "remove", path: "/b/c" },
+    { op: "move", from: "/a/0", path: "/d" },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const result = applyPatch(doc, patch) as { a: unknown[] };
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  (result.a[result.a.length - 1] as { k: unknown[] }).k.push(1);
+  assert.deepEqual(patch, patchCopy);
+});
+
+test("a failing operation leaves the input untouched", () => {
+  const doc = { a: 1 };
+  assert.throws(() => applyPatch(doc, [{ op: "add", path: "/b", value: 2 }, { op: "remove", path: "/zz" }]));
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("an empty patch returns an equal copy", () => {
+  const doc = { a: [1] };
+  const result = applyPatch(doc, []);
+  assert.deepEqual(result, doc);
+  assert.notEqual(result, doc);
+});
+
+test("a __proto__ member is an ordinary own member", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as object;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(Object.hasOwn(result, "__proto__"), true);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
