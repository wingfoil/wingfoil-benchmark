diff --git a/test/diff.test.ts b/test/diff.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0626b610061deb8c492f49f4cd250950376e6fb7
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,88 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown): unknown[] {
+  const before = structuredClone(from);
+  const after = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, before);
+  assert.deepEqual(to, after);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+});
+
+test("a small change in a large document yields one operation", () => {
+  const from = { name: "x", tags: ["a", "b"], nested: { deep: { n: 1 }, other: [1, 2, 3] } };
+  const to = structuredClone(from);
+  to.nested.deep.n = 2;
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/nested/deep/n", value: 2 }]);
+});
+
+test("members are added and removed", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("null, type changes and root replacement", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+  assert.deepEqual(roundTrip({ a: [1] }, { a: { 0: 1 } }), [{ op: "replace", path: "/a", value: { 0: 1 } }]);
+  assert.deepEqual(roundTrip(1, "x"), [{ op: "replace", path: "", value: "x" }]);
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+});
+
+test("keys are escaped, and __proto__ is an ordinary member", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "m~n": 1 }, { "a/b": 2, "m~n": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/m~0n", value: 2 },
+  ]);
+  const proto = JSON.parse('{"__proto__": {"x": 1}}');
+  assert.deepEqual(roundTrip({}, proto), [{ op: "add", path: "/__proto__", value: { x: 1 } }]);
+  assert.deepEqual(roundTrip(proto, JSON.parse('{"__proto__": {"x": 2}}')), [{ op: "replace", path: "/__proto__/x", value: 2 }]);
+});
+
+test("an array that gains an item only adds it", () => {
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 2, 9, 3]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2], [0, 1, 2]), [{ op: "add", path: "/0", value: 0 }]);
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(roundTrip([], [{ a: 1 }]), [{ op: "add", path: "/0", value: { a: 1 } }]);
+});
+
+test("an array that loses an item only removes it", () => {
+  assert.deepEqual(roundTrip([{ a: 1 }, { a: 2 }, { a: 3 }], [{ a: 1 }, { a: 3 }]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 2]), [{ op: "remove", path: "/2" }]);
+  assert.deepEqual(roundTrip([1], []), [{ op: "remove", path: "/0" }]);
+});
+
+test("a moved item does not rewrite the items in between", () => {
+  const patch = roundTrip(["a", "b", "c", "d", "e"], ["b", "c", "d", "a", "e"]);
+  assert.equal(patch.length, 2);
+  assert.deepEqual(roundTrip(["a", "b", "c", "d"], ["d", "a", "b", "c"]).length, 2);
+});
+
+test("a changed item is patched in place, even inside an array", () => {
+  assert.deepEqual(roundTrip([{ id: 1, v: "a" }, { id: 2, v: "b" }], [{ id: 1, v: "a" }, { id: 2, v: "c" }]), [
+    { op: "replace", path: "/1/v", value: "c" },
+  ]);
+  assert.deepEqual(roundTrip([[1, 2], [3]], [[1, 2, 5], [3]]), [{ op: "add", path: "/0/2", value: 5 }]);
+});
+
+test("duplicates, mixed edits and reordering round-trip", () => {
+  roundTrip([1, 1, 2, 1], [1, 2, 1, 1, 1]);
+  roundTrip([1, 2, 3, 4, 5, 6], [6, 2, 9, 4, 1, 7, 8]);
+  roundTrip({ a: [3, 2, 1] }, { a: [1, 2, 3] });
+});
+
+test("the patch shares no structure with the inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to) as { value: { b: number } }[];
+  patch[0].value.b = 99;
+  assert.equal(to.a.b, 1);
+});
