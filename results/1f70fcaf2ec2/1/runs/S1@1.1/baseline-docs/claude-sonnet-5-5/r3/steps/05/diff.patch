+++ b/src/diff.ts
@@ -0,0 +1,89 @@
+import { equal, isObject } from "./patch.ts";
+
+type Json = unknown;
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: Json };
+
+/** Encodes one reference token (RFC 6901 §3); `~` is encoded first so `/` does not become `~01`. */
+function escapeToken(token: string): string {
+  return token.replaceAll("~", "~0").replaceAll("/", "~1");
+}
+
+/** Lengths of the longest common subsequences of `a[i..]` and `b[j..]`, indexed `[i][j]`. */
+function commonLengths(a: Json[], b: Json[]): number[][] {
+  const lengths = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lengths[i][j] = equal(a[i], b[j]) ? lengths[i + 1][j + 1] + 1 : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  return lengths;
+}
+
+/** Turns a run of unmatched old items and new items into operations at `path`, starting at output index `index`. */
+function diffGap(path: string, index: number, removed: Json[], added: Json[], out: Operation[]): number {
+  const paired = Math.min(removed.length, added.length);
+  for (let k = 0; k < paired; k++) diffValue(`${path}/${index + k}`, removed[k], added[k], out);
+  for (let k = paired; k < removed.length; k++) out.push({ op: "remove", path: `${path}/${index + paired}` });
+  for (let k = paired; k < added.length; k++) out.push({ op: "add", path: `${path}/${index + k}`, value: structuredClone(added[k]) });
+  return index + added.length;
+}
+
+/**
+ * Diffs two arrays by their longest common subsequence: items outside it are removed or added, and the
+ * ones that stay are never touched. A moved item is therefore a removal plus an addition.
+ */
+function diffArray(path: string, from: Json[], to: Json[], out: Operation[]): void {
+  const lengths = commonLengths(from, to);
+  let i = 0;
+  let j = 0;
+  let index = 0;
+  while (i < from.length || j < to.length) {
+    const gapStart = { i, j };
+    while ((i < from.length || j < to.length) && !(i < from.length && j < to.length && equal(from[i], to[j]))) {
+      if (j === to.length || (i < from.length && lengths[i + 1][j] >= lengths[i][j + 1])) i++;
+      else j++;
+    }
+    index = diffGap(path, index, from.slice(gapStart.i, i), to.slice(gapStart.j, j), out);
+    if (i < from.length && j < to.length) {
+      i++;
+      j++;
+      index++;
+    }
+  }
+}
+
+function diffObject(path: string, from: Record<string, unknown>, to: Record<string, unknown>, out: Operation[]): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+  }
+  for (const key of Object.keys(to)) {
+    const member = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) diffValue(member, from[key], to[key], out);
+    else out.push({ op: "add", path: member, value: structuredClone(to[key]) });
+  }
+}
+
+function diffValue(path: string, from: Json, to: Json, out: Operation[]): void {
+  if (equal(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) diffArray(path, from, to, out);
+  else if (isObject(from) && isObject(to)) diffObject(path, from, to, out);
+  else out.push({ op: "replace", path, value: structuredClone(to) });
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch holds only what changed: unchanged members and array items are left alone, a changed
+ * member is patched in place, and an array that gains or loses items gets `add` or `remove` operations
+ * for those items only. A moved array item is expressed as a `remove` and an `add`. Object member order
+ * is not significant. Neither argument is mutated, and the patch shares no structure with them.
+ *
+ * @param from - The original JSON document.
+ * @param to - The target JSON document.
+ * @returns The operations (`add`, `remove`, `replace`), empty when the documents are equal.
+ */
+export function createPatch(from: Json, to: Json): Operation[] {
+  const out: Operation[] = [];
+  diffValue("", from, to, out);
+  return out;
+}
