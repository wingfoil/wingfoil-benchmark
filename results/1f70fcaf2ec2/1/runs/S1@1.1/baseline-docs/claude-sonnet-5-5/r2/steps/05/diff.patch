index 0c58ac527422536f767e2cfb36153f6531d105fa..241392cfe6bd4d6cce2ea0573b557945317fae36 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -280,3 +280,118 @@ export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue
   }
   return mergeValue(target, patch);
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function isSameKind(a: JsonValue, b: JsonValue): boolean {
+  return Array.isArray(a) ? Array.isArray(b) : isObject(a) && isObject(b);
+}
+
+function diffObjects(from: { [key: string]: JsonValue }, to: { [key: string]: JsonValue }, path: string, out: PatchOperation[]): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const memberPath = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) {
+      diffValues(from[key], to[key], memberPath, out);
+    } else {
+      out.push({ op: "add", path: memberPath, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+/** Builds the table of longest common subsequence lengths of the suffixes of `from` and `to`. */
+function commonSuffixLengths(from: JsonValue[], to: JsonValue[]): number[][] {
+  const table = Array.from({ length: from.length + 1 }, () => new Array<number>(to.length + 1).fill(0));
+  for (let i = from.length - 1; i >= 0; i--) {
+    for (let j = to.length - 1; j >= 0; j--) {
+      table[i][j] = deepEqual(from[i], to[j]) ? table[i + 1][j + 1] + 1 : Math.max(table[i + 1][j], table[i][j + 1]);
+    }
+  }
+  return table;
+}
+
+/**
+ * Turns a run of removed items and a run of added items, which sit at `index` of the array being
+ * rewritten, into operations: items are paired up and patched in place, the surplus is removed or added.
+ * Returns the index following the run.
+ */
+function diffRun(removed: JsonValue[], added: JsonValue[], index: number, path: string, out: PatchOperation[]): number {
+  const paired = Math.min(removed.length, added.length);
+  for (let k = 0; k < paired; k++) {
+    diffValues(removed[k], added[k], `${path}/${index + k}`, out);
+  }
+  for (let k = paired; k < removed.length; k++) {
+    out.push({ op: "remove", path: `${path}/${index + paired}` });
+  }
+  for (let k = paired; k < added.length; k++) {
+    out.push({ op: "add", path: `${path}/${index + k}`, value: structuredClone(added[k]) });
+  }
+  return index + added.length;
+}
+
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, out: PatchOperation[]): void {
+  const table = commonSuffixLengths(from, to);
+  let i = 0;
+  let j = 0;
+  let index = 0;
+  while (i < from.length || j < to.length) {
+    if (i < from.length && j < to.length && deepEqual(from[i], to[j])) {
+      i++;
+      j++;
+      index++;
+      continue;
+    }
+    const removedStart = i;
+    const addedStart = j;
+    while ((i < from.length || j < to.length) && !(i < from.length && j < to.length && deepEqual(from[i], to[j]))) {
+      if (j === to.length || (i < from.length && table[i + 1][j] >= table[i][j + 1])) {
+        i++;
+      } else {
+        j++;
+      }
+    }
+    index = diffRun(from.slice(removedStart, i), to.slice(addedStart, j), index, path, out);
+  }
+}
+
+function diffValues(from: JsonValue, to: JsonValue, path: string, out: PatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (!isSameKind(from, to)) {
+    out.push({ op: "replace", path, value: structuredClone(to) });
+  } else if (Array.isArray(from)) {
+    diffArrays(from, to as JsonValue[], path, out);
+  } else {
+    diffObjects(from as { [key: string]: JsonValue }, to as { [key: string]: JsonValue }, path, out);
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch is minimal in granularity: unchanged members and items are left alone and changed ones are
+ * patched at the deepest place that differs. Items added to or removed from an array are added or
+ * removed individually; an item that moved is removed and added back, never causing the items around
+ * it to be rewritten. Values are not shared with the inputs and neither input is mutated. A `from`
+ * and a `to` that differ in kind (object, array or scalar) yield a single `replace` of the whole document.
+ *
+ * @throws Error if `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  if (!isJsonValue(from)) {
+    throw new Error("Invalid JSON document: `from` must be a JSON value");
+  }
+  if (!isJsonValue(to)) {
+    throw new Error("Invalid JSON document: `to` must be a JSON value");
+  }
+  const operations: PatchOperation[] = [];
+  diffValues(from, to, "", operations);
+  return operations;
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bf1027e612bad063f9863ef6f5545de4e4830594
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,120 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { applyPatch, createPatch, type JsonValue } from "../src/index.ts";
+
+const patchOf = (from: unknown, to: unknown) => createPatch(from as JsonValue, to as JsonValue);
+
+function roundTrip(from: unknown, to: unknown) {
+  const patch = patchOf(from, to);
+  assert.deepEqual(applyPatch(from as JsonValue, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a change in one nested place yields a single operation", () => {
+  const patch = roundTrip({ a: { b: { c: 1, d: 2 } }, e: [1, 2] }, { a: { b: { c: 1, d: 3 } }, e: [1, 2] });
+  assert.deepEqual(patch, [{ op: "replace", path: "/a/b/d", value: 3 }]);
+});
+
+test("members are added and removed", () => {
+  const patch = roundTrip({ a: 1, b: 2 }, { a: 1, c: 3 });
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("the whole document is replaced when the types differ", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip(null, { a: 1 }), [{ op: "replace", path: "", value: { a: 1 } }]);
+});
+
+test("member names are escaped in pointers", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "m~n": 1 }, { "a/b": 2, "m~n": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/m~0n", value: 2 },
+  ]);
+});
+
+test("__proto__ is an ordinary member name", () => {
+  const from = JSON.parse('{"__proto__": {"x": 1}}');
+  const to = JSON.parse('{"__proto__": {"x": 2}}');
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/__proto__/x", value: 2 }]);
+});
+
+test("an item added to or removed from an array does not rewrite its neighbours", () => {
+  assert.deepEqual(roundTrip([1, 2, 4, 5], [1, 2, 3, 4, 5]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4, 5], [1, 2, 4, 5]), [{ op: "remove", path: "/2" }]);
+  assert.deepEqual(roundTrip([1, 2], [0, 1, 2]), [{ op: "add", path: "/0", value: 0 }]);
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(roundTrip([{ a: 1 }, { b: 2 }, { c: 3 }], [{ b: 2 }, { c: 3 }]), [{ op: "remove", path: "/0" }]);
+});
+
+test("an item moved within an array does not rewrite the items in between", () => {
+  const patch = roundTrip([1, 2, 3, 4, 5, 6], [1, 3, 4, 5, 2, 6]);
+  assert.ok(patch.length <= 2);
+  assert.ok(patch.every((operation) => operation.op !== "replace"));
+  assert.ok(roundTrip(["a", "b", "c", "d"], ["d", "a", "b", "c"]).length <= 2);
+});
+
+test("a modified array item is patched in place", () => {
+  const patch = roundTrip([{ id: 1, n: "a" }, { id: 2, n: "b" }], [{ id: 1, n: "a" }, { id: 2, n: "c" }]);
+  assert.deepEqual(patch, [{ op: "replace", path: "/1/n", value: "c" }]);
+});
+
+test("insertion before a modified item keeps indexes consistent", () => {
+  roundTrip([{ a: 1 }, { b: 1 }, 9], [0, { a: 1 }, { b: 2 }, 9, 10]);
+  roundTrip([1, 2, 3, 4, 5], [5, 4, 3, 2, 1]);
+  roundTrip([[1, 2], [3]], [[3], [1, 2, 7]]);
+});
+
+test("duplicates and nulls in arrays", () => {
+  roundTrip([1, 1, 2, null, 1], [1, null, 1, 1, 2, 2]);
+  roundTrip([], [null]);
+  roundTrip([null], []);
+});
+
+test("neither input is mutated and the patch shares no structure with them", () => {
+  const from = { a: [1, 2], b: { c: 1 } };
+  const to = { a: [1, 2, { x: [1] }], d: { e: 1 } };
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = patchOf(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  for (const operation of patch) {
+    if ("value" in operation) {
+      assert.notEqual(operation.value, to.a[2]);
+      assert.notEqual(operation.value, to.d);
+    }
+  }
+});
+
+test("randomised documents round-trip", () => {
+  let seed = 12345;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return seed % n;
+  };
+  const gen = (depth: number): JsonValue => {
+    const kind = rand(depth > 2 ? 3 : 5);
+    if (kind === 0) return rand(4);
+    if (kind === 1) return ["x", "y", null, true][rand(4)];
+    if (kind === 2) return rand(2);
+    if (kind === 3) return Array.from({ length: rand(6) }, () => gen(depth + 1));
+    return Object.fromEntries(Array.from({ length: rand(4) }, () => [`k${rand(4)}`, gen(depth + 1)]));
+  };
+  for (let i = 0; i < 500; i++) {
+    roundTrip(gen(0), gen(0));
+  }
+});
+
+test("values that are not JSON values are rejected", () => {
+  assert.throws(() => patchOf(undefined, 1), Error);
+  assert.throws(() => patchOf({ a: 1 }, { a: NaN }), Error);
+  assert.throws(() => patchOf({ a: new Date() }, {}), Error);
+  assert.throws(() => patchOf([], new Array(2)), Error);
+});
