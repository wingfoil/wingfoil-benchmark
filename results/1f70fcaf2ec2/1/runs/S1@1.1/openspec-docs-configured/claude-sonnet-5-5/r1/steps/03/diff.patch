index 0bbc6f9fae9e78da24a4ec667b65e41a2e007577..63f5ee2eedd18b61e4311ac7cdd2dc2713c5c08b 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -145,6 +145,8 @@ const OPS = new Set(["add", "remove", "replace", "move", "copy", "test"]);
 
 function member(op: Record<string, unknown>, name: string): unknown {
   if (!hasOwn(op, name)) throw new Error(`Invalid JSON Patch: operation lacks required member "${name}"`);
+  // undefined is not a JSON value (RFC 8259); only reachable from JS callers, never from parsed JSON.
+  if (op[name] === undefined) throw new Error(`Invalid JSON Patch: member "${name}" must be a JSON value`);
   return op[name];
 }
 
