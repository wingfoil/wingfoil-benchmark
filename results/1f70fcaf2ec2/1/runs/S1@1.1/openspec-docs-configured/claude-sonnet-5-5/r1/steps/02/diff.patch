+
+// RFC 6902 section 4.1 (add) on a non-empty location. Returns the (possibly new) document.
+function addAt(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(document, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (token === "-") {
+      parent.push(value);
+    } else {
+      if (!ARRAY_INDEX.test(token)) throw new Error(`JSON Patch: "${token}" is not a valid array index`);
+      const index = Number(token);
+      if (index > parent.length) throw new Error(`JSON Patch: index ${token} is out of range`);
+      parent.splice(index, 0, value);
+    }
