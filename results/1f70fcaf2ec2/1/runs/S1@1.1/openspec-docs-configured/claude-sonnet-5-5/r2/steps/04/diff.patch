   return result;
 }
+
+
+/**
+ * JSON Merge Patch, RFC 7396 (which obsoletes RFC 7386; the algorithm is the one in section 2).
+ */
+
+function isObject(value: Json): value is Record<string, Json> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7396 section 2) to `target` and returns the result as a new value;
+ * neither argument is modified. A non-object patch replaces the target as a whole (arrays are
+ * replaced, not merged); an object patch is merged member by member, where a null member removes
+ * the member from the target. If the target is not an object it is treated as an empty object, so
+ * null members inside the patch are dropped rather than stored. Merging never throws: every JSON
+ * value is a valid patch.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch);
+  const result: Record<string, Json> = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) setMember(result, key, clone(target[key]));
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
diff --git a/test/merge-patch.test.ts b/test/merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..151b071457c4008a487f7fa6d3744b69b3344ad6
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,59 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch as mp } from "../src/index.ts";
+
+test("RFC 7396 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, r] of cases) assert.deepEqual(mp(t, p), r);
+});
+
+test("section 2: non-object target is treated as empty object; nulls in arrays are kept", () => {
+  assert.deepEqual(mp(1, { a: null, b: 2 }), { b: 2 });
+  assert.deepEqual(mp(undefined, { a: { b: null, c: 1 } }), { a: { c: 1 } });
+  assert.deepEqual(mp({ a: 1 }, { a: [null, 1] }), { a: [null, 1] });
+  assert.deepEqual(mp({ a: 1 }, {}), { a: 1 });
+});
+
+test("inputs are not mutated and the result shares no structure", () => {
+  const target = { a: { b: 1 }, c: [1] };
+  const patch = { a: { d: { e: 1 } }, f: [{ g: 1 }] };
+  const t = structuredClone(target);
+  const p = structuredClone(patch);
+  const out = mp(target, patch) as any;
+  assert.deepEqual(target, t);
+  assert.deepEqual(patch, p);
+  out.a.d.e = 2;
+  out.f[0].g = 2;
+  out.c.push(2);
+  assert.deepEqual(target, t);
+  assert.deepEqual(patch, p);
+});
+
+test("hostile keys such as __proto__ are plain members", () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}, "a": {"__proto__": {"x": 1}}}');
+  const out = mp({}, patch) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepEqual(Object.keys(out), ["__proto__", "a"]);
+  assert.deepEqual(Object.getOwnPropertyDescriptor(out, "__proto__")!.value, { polluted: true });
+  const removed = mp(out, JSON.parse('{"__proto__": null}')) as any;
+  assert.deepEqual(Object.keys(removed), ["a"]);
+  const target = JSON.parse('{"__proto__": {"k": 1}}');
+  assert.deepEqual(Object.getOwnPropertyDescriptor(mp(target, { z: 1 }), "__proto__")!.value, { k: 1 });
+});
