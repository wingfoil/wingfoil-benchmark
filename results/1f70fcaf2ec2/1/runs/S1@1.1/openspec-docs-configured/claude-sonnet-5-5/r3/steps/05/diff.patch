+
+// ---------------------------------------------------------------------------
+// JSON Patch generation (RFC 6902)
+// ---------------------------------------------------------------------------
+
+/** RFC 6901 section 3: escape "~" before "/" when building a reference token. */
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(a: unknown[], b: unknown[], path: string, ops: PatchOperation[]): void {
+  // Trim the common prefix and suffix, then align the rest by longest common subsequence.
+  let start = 0;
+  while (start < a.length && start < b.length && jsonEqual(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && jsonEqual(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const n = endA - start;
+  const m = endB - start;
+  // lcs[i][j]: length of the LCS of a[start+i..endA) and b[start+j..endB)
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(a[start + i], b[start + j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  let index = start; // position in the array as it is after the operations emitted so far
+  let i = 0;
+  let j = 0;
+  while (i < n || j < m) {
+    if (i < n && j < m && jsonEqual(a[start + i], b[start + j])) {
+      i++;
+      j++;
+      index++;
+      continue;
+    }
+    // Collect the run of removed and added items up to the next matched pair.
+    const removed: unknown[] = [];
+    const added: unknown[] = [];
+    while ((i < n || j < m) && !(i < n && j < m && jsonEqual(a[start + i], b[start + j]))) {
+      if (j >= m || (i < n && lcs[i + 1][j] >= lcs[i][j + 1])) removed.push(a[start + i++]);
+      else added.push(b[start + j++]);
+    }
+    const paired = Math.min(removed.length, added.length);
+    for (let k = 0; k < paired; k++) diffValues(removed[k], added[k], `${path}/${index++}`, ops);
+    for (let k = paired; k < removed.length; k++) ops.push({ op: "remove", path: `${path}/${index}` });
+    for (let k = paired; k < added.length; k++) {
+      ops.push({ op: "add", path: `${path}/${index++}`, value: clone(added[k]) as JsonValue });
+    }
+  }
+}
+
+function diffValues(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (has(from, key)) diffValues(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: clone(to[key]) as JsonValue });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) as JsonValue });
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to`. Neither argument is mutated.
+ * Only the differing parts are described: object members are added, removed or diffed recursively
+ * (section 4.1-4.3), and arrays are aligned by longest common subsequence so that an inserted or
+ * deleted item yields one "add"/"remove" (a moved item yields a "remove" plus an "add") without
+ * touching the items around it. Applying the result with applyPatch(from, patch) equals `to`.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffValues(from, to, "", ops);
+  return ops;
+}
diff --git a/test/createpatch.test.ts b/test/createpatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f81c757bdf53a5f6af7ed60128c605b0873732a4
--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,79 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const j = (s: string) => JSON.parse(s);
+
+function roundTrip(from: unknown, to: unknown) {
+  const f = JSON.stringify(from);
+  const t = JSON.stringify(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.equal(JSON.stringify(from), f);
+  assert.equal(JSON.stringify(to), t);
+  return patch;
+}
+
+test("equal documents give an empty patch (RFC 6902 section 4)", () => {
+  assert.deepEqual(roundTrip(j('{"a":[1,{"b":null}]}'), j('{"a":[1,{"b":null}]}')), []);
+});
+
+test("small change deep in a document is a single operation", () => {
+  const patch = roundTrip(j('{"a":{"b":{"c":1,"d":2}},"e":[1,2]}'), j('{"a":{"b":{"c":1,"d":3}},"e":[1,2]}'));
+  assert.deepEqual(patch, [{ op: "replace", path: "/a/b/d", value: 3 }]);
+});
+
+test("object members added and removed; null is a value (section 4.1-4.3)", () => {
+  assert.deepEqual(roundTrip(j('{"a":1,"b":2}'), j('{"a":null,"c":3}')).length, 3);
+  assert.deepEqual(roundTrip({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+});
+
+test("root replacement and type changes", () => {
+  assert.deepEqual(roundTrip(1, "x"), [{ op: "replace", path: "", value: "x" }]);
+  assert.deepEqual(roundTrip([1], { a: 1 }), [{ op: "replace", path: "", value: { a: 1 } }]);
+  assert.deepEqual(roundTrip({ a: [] }, { a: {} }), [{ op: "replace", path: "/a", value: {} }]);
+});
+
+test("keys are escaped (RFC 6901 section 3)", () => {
+  const patch = roundTrip(j('{"a/b":1,"m~n":1}'), j('{"a/b":2,"m~n":2}'));
+  assert.deepEqual(patch.map((o) => o.path), ["/a~1b", "/m~0n"]);
+});
+
+test("hostile __proto__ key", () => {
+  const patch = roundTrip(j('{"__proto__":{"x":1}}'), j('{"__proto__":{"x":2},"y":{"__proto__":1}}'));
+  assert.equal(({} as any).x, undefined);
+  assert.equal(patch.length, 2);
+  roundTrip(j("{}"), j('{"__proto__":{"polluted":true}}'));
+  assert.equal(({} as any).polluted, undefined);
+});
+
+test("array insert and delete touch only that item", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([], [1]), [{ op: "add", path: "/0", value: 1 }]);
+  assert.deepEqual(roundTrip([{ a: 1 }, { a: 2 }], [{ a: 0 }, { a: 1 }, { a: 2 }]).length, 1);
+});
+
+test("array move does not rewrite items in between", () => {
+  const patch = roundTrip(["a", "b", "c", "d", "e"], ["a", "c", "d", "e", "b"]);
+  assert.equal(patch.length, 2);
+  assert.ok(patch.every((o) => o.op === "remove" || o.op === "add" || o.op === "move"));
+  roundTrip(["a", "b", "c", "d", "e"], ["e", "a", "b", "c", "d"]);
+});
+
+test("array item changed in place is diffed recursively", () => {
+  assert.deepEqual(roundTrip([{ a: 1, b: 2 }, 5], [{ a: 1, b: 3 }, 5]), [{ op: "replace", path: "/0/b", value: 3 }]);
+});
+
+test("duplicates and nested arrays round-trip", () => {
+  roundTrip([1, 1, 2, 1], [1, 2, 1, 1, 1]);
+  roundTrip([[1, 2], [3]], [[3], [1, 2, 4]]);
+  roundTrip(j('{"a":[1,[2,3],{"b":[4]}]}'), j('{"a":[0,[3],{"b":[4,5]},6]}'));
+});
+
+test("output does not alias inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to) as any;
+  patch[0].value.b = 2;
+  assert.equal(to.a.b, 1);
+});
