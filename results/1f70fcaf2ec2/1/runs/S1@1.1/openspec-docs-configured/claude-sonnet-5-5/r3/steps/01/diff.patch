--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,60 @@
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+// RFC 6901 section 3: array-index = %x30 / ( %x31-39 *(%x30-39) )
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** RFC 6901 section 4: unescape ~1 before ~0; any other "~" sequence is invalid. */
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in reference token "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ * Throws if the pointer is syntactically invalid (section 3) or does not
+ * resolve to a value of the document (section 4). Never mutates the document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: pointer must be a string");
+  }
+  if (pointer === "") return document;
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+
+  const tokens = pointer.slice(1).split("/").map(unescapeToken);
+  let current: unknown = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (token === "-") {
+        throw new Error('JSON Pointer does not resolve: "-" refers to a nonexistent array element');
+      }
+      if (!ARRAY_INDEX.test(token)) {
+        throw new Error(`JSON Pointer does not resolve: "${token}" is not a valid array index`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new Error(`JSON Pointer does not resolve: index ${token} is out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      // Own properties only: "__proto__", "constructor", etc. must not reach the prototype chain.
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(`JSON Pointer does not resolve: member "${token}" not found`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer does not resolve: cannot descend into a scalar with "${token}"`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1afab320814ef1acea61b825d1065c1b7f95fee3
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,115 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// The example document of RFC 6901 section 5.
+const doc = JSON.parse(`{
+  "foo": ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\\\j": 5,
+  "k\\"l": 6,
+  " ": 7,
+  "m~n": 8
+}`);
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("escape order: ~01 is the key ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+  assert.equal(resolvePointer({ "~1": "x", "/": "y" }, "/~1"), "y");
+});
+
+test("invalid pointers throw", () => {
+  assert.throws(() => resolvePointer(doc, "foo"));
+  assert.throws(() => resolvePointer(doc, "~0"));
+  assert.throws(() => resolvePointer({ "~": 1 }, "/~"));
+  assert.throws(() => resolvePointer({ "~2": 1 }, "/~2"));
+  assert.throws(() => resolvePointer({ "a~": 1 }, "/a~"));
+  assert.throws(() => resolvePointer(doc, undefined as unknown as string));
+});
+
+test("null and falsy values are resolved, not treated as missing", () => {
+  const d = { a: null, b: false, c: 0, d: "", e: [null] };
+  assert.equal(resolvePointer(d, "/a"), null);
+  assert.equal(resolvePointer(d, "/b"), false);
+  assert.equal(resolvePointer(d, "/c"), 0);
+  assert.equal(resolvePointer(d, "/d"), "");
+  assert.equal(resolvePointer(d, "/e/0"), null);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("missing members throw", () => {
+  assert.throws(() => resolvePointer(doc, "/nope"));
+  assert.throws(() => resolvePointer(doc, "/foo/bar/baz"));
+  assert.throws(() => resolvePointer({ a: {} }, "/a/b"));
+});
+
+test("arrays: index rules", () => {
+  const d = { a: ["x", "y", "z"] };
+  assert.equal(resolvePointer(d, "/a/2"), "z");
+  assert.throws(() => resolvePointer(d, "/a/3"));
+  assert.throws(() => resolvePointer(d, "/a/-"), /nonexistent/);
+  assert.throws(() => resolvePointer(d, "/a/01"));
+  assert.throws(() => resolvePointer(d, "/a/+1"));
+  assert.throws(() => resolvePointer(d, "/a/-1"));
+  assert.throws(() => resolvePointer(d, "/a/1.0"));
+  assert.throws(() => resolvePointer(d, "/a/ 1"));
+  assert.throws(() => resolvePointer(d, "/a/"));
+  assert.throws(() => resolvePointer(d, "/a/length"));
+  assert.throws(() => resolvePointer(d, "/a/1e0"));
+});
+
+test("'-' is an ordinary key on objects", () => {
+  assert.equal(resolvePointer({ "-": 1 }, "/-"), 1);
+});
+
+test("numeric-looking keys on objects", () => {
+  assert.equal(resolvePointer({ "01": "a", "0": "b" }, "/01"), "a");
+});
+
+test("cannot descend into scalars", () => {
+  assert.throws(() => resolvePointer({ a: "str" }, "/a/0"));
+  assert.throws(() => resolvePointer({ a: "str" }, "/a/length"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+  assert.throws(() => resolvePointer(5, "/a"));
+});
+
+test("hostile keys do not reach the prototype chain", () => {
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer({}, "/constructor"));
+  assert.throws(() => resolvePointer({}, "/constructor/prototype"));
+  assert.throws(() => resolvePointer({}, "/toString"));
+  assert.throws(() => resolvePointer([], "/__proto__"));
+  const parsed = JSON.parse('{"__proto__": {"x": 1}}');
+  assert.deepEqual(resolvePointer(parsed, "/__proto__"), { x: 1 });
+  assert.equal(resolvePointer(parsed, "/__proto__/x"), 1);
+});
+
+test("duplicate keys: the last one wins, as JSON.parse does", () => {
+  assert.equal(resolvePointer(JSON.parse('{"a":1,"a":2}'), "/a"), 2);
+});
+
+test("does not mutate the document", () => {
+  const d = { a: [1, { b: 2 }] };
+  const copy = structuredClone(d);
+  resolvePointer(d, "/a/1/b");
+  assert.deepEqual(d, copy);
+});
