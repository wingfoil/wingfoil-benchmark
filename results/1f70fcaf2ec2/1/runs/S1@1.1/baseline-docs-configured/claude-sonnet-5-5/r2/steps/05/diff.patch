index 8f8266101a5fb670cd36a332ef7005bbcf73eb3b..1c5c9814981d3ae0d1a2d02f3586f1d02d295347 100644
--- a/README.md
+++ b/README.md
@@ -63,3 +63,23 @@ not an object (an array, a scalar or `null`) replaces the target wholesale, so a
 patched, and a `null` value cannot be set inside an object (use JSON Patch for that). The function never
 throws, never mutates the target or the patch, and the result shares no structure with them. Keys such as
 `__proto__` are stored as ordinary own members and never reach the prototype.
+
+## Creating a JSON Patch
+
+`createPatch(from, to)` returns a JSON Patch (RFC 6902) that turns `from` into `to` when passed to
+`applyPatch`, so a client can send only what changed.
+
+```ts
+import { createPatch } from "./src/index.js";
+
+createPatch({ a: 1, b: [1, 2, 4] }, { a: 2, b: [1, 2, 3, 4] });
+// [{ op: "replace", path: "/a", value: 2 }, { op: "add", path: "/b/2", value: 3 }]
+```
+
+Objects are compared member by member, recursively, giving `add`, `remove` and `replace` operations on the
+members that differ. Arrays are aligned on their longest common run of equal items: an item gained or lost
+is added or removed alone, a moved item is removed and added back (no `move` operation is emitted), and an
+item that changed in place is patched inside. A value whose type changed is replaced, and equal documents
+give an empty patch. The patch is not guaranteed to be the shortest possible. Neither input is mutated and
+the patch shares no structure with them. Member order is not significant in JSON, so the result may order
+members differently from `to`.
diff --git a/src/index.ts b/src/index.ts
index 3c1031d0395370dc98325efb14a5e68dee01e614..899b74f9e7c282a0d02f0d2ed3eac1a99efee32a 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -303,3 +303,102 @@ function mergeValue(target: JsonValue | undefined, patch: JsonValue): JsonValue
 export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
   return mergeValue(target, patch);
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+// Table of longest-common-subsequence lengths of the suffixes of `a` and `b`.
+function lcsTable(a: JsonValue[], b: JsonValue[]): number[][] {
+  const table = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      table[i][j] = jsonEqual(a[i], b[j]) ? table[i + 1][j + 1] + 1 : Math.max(table[i + 1][j], table[i][j + 1]);
+    }
+  }
+  return table;
+}
+
+// Emits the operations for one run of items that differ between two matched items: the items both sides
+// have in common positions are diffed in place, the surplus is removed or added. `index` is where the run
+// starts in the array being rebuilt, which already equals `to` before it.
+function diffRun(from: JsonValue[], to: JsonValue[], path: string, index: number, operations: PatchOperation[]): void {
+  const paired = Math.min(from.length, to.length);
+  for (let k = 0; k < paired; k++) diffValues(from[k], to[k], `${path}/${index + k}`, operations);
+  for (let k = paired; k < from.length; k++) operations.push({ op: "remove", path: `${path}/${index + paired}` });
+  for (let k = paired; k < to.length; k++) {
+    operations.push({ op: "add", path: `${path}/${index + k}`, value: structuredClone(to[k]) });
+  }
+}
+
+// Items outside the longest common subsequence are the only ones touched, so an insertion, a removal or a
+// move never rewrites the items around it (a move is a removal plus an addition).
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, operations: PatchOperation[]): void {
+  const table = lcsTable(from, to);
+  let i = 0;
+  let j = 0;
+  let runFrom = 0;
+  let runTo = 0;
+  while (i < from.length && j < to.length) {
+    if (jsonEqual(from[i], to[j])) {
+      diffRun(from.slice(runFrom, i), to.slice(runTo, j), path, runTo, operations);
+      i++;
+      j++;
+      runFrom = i;
+      runTo = j;
+    } else if (table[i + 1][j] >= table[i][j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  diffRun(from.slice(runFrom), to.slice(runTo), path, runTo, operations);
+}
+
+function diffObjects(
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  path: string,
+  operations: PatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) operations.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+  }
+  for (const key of Object.keys(to)) {
+    const memberPath = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) {
+      diffValues(from[key], to[key], memberPath, operations);
+    } else {
+      operations.push({ op: "add", path: memberPath, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+function diffValues(from: JsonValue, to: JsonValue, path: string, operations: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, operations);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from as { [key: string]: JsonValue }, to as { [key: string]: JsonValue }, path, operations);
+  } else if (!jsonEqual(from, to)) {
+    operations.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied with {@link applyPatch}.
+ *
+ * The patch holds only what changed. Objects are compared member by member and nested values recursively.
+ * Arrays are aligned on their longest common subsequence of equal items, so an item that is added or removed
+ * gives one `add` or `remove`, and a move gives a `remove` plus an `add`, without touching the items around
+ * them. Items that changed in place are patched recursively, and a value whose type changed is replaced
+ * (section 4.3). Equal documents give an empty patch. Neither input is mutated and the patch shares no
+ * structure with them. Member names are escaped per RFC 6901 section 3, and `__proto__` is an ordinary name.
+ *
+ * @param from - The original parsed JSON value.
+ * @param to - The wanted parsed JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  const operations: PatchOperation[] = [];
+  diffValues(from, to, "", operations);
+  return operations;
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3ffb9004e7008d3df8e2164458ad26b21453fc3d
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,88 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch, type JsonValue } from "../src/index.ts";
+
+const json = (text: string) => JSON.parse(text) as JsonValue;
+
+// Asserts the patch round-trips and returns it, leaving the inputs unchanged (RFC 6902 section 5).
+function patchOf(from: JsonValue, to: JsonValue) {
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(patchOf(json('{"a":[1,{"b":2}]}'), json('{"a":[1,{"b":2}]}')), []);
+});
+
+test("object members are added, removed and replaced individually", () => {
+  const patch = patchOf(json('{"a":1,"b":2,"c":{"d":3,"e":4}}'), json('{"a":1,"c":{"d":5,"e":4},"f":6}'));
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/b" },
+    { op: "replace", path: "/c/d", value: 5 },
+    { op: "add", path: "/f", value: 6 },
+  ]);
+});
+
+test("a change of type or of scalar replaces the value, null included", () => {
+  assert.deepEqual(patchOf(json('{"a":{"b":1}}'), json('{"a":[1]}')), [{ op: "replace", path: "/a", value: [1] }]);
+  assert.deepEqual(patchOf(json('{"a":1}'), json('{"a":null}')), [{ op: "replace", path: "/a", value: null }]);
+  assert.deepEqual(patchOf(json("[1]"), json('{"a":1}')), [{ op: "replace", path: "", value: { a: 1 } }]);
+  assert.deepEqual(patchOf(1, 2), [{ op: "replace", path: "", value: 2 }]);
+});
+
+test("member names are escaped in pointers (RFC 6901 section 3)", () => {
+  const patch = patchOf(json('{"a/b":1,"m~n":2,"":3}'), json('{"a/b":9,"m~n":8,"":7}'));
+  assert.deepEqual(patch.map((o) => o.path).sort(), ["/", "/a~1b", "/m~0n"]);
+});
+
+test("__proto__ members are ordinary members", () => {
+  const to = json('{"__proto__":{"x":1}}');
+  const patch = patchOf({}, to);
+  assert.deepEqual(patch, [{ op: "add", path: "/__proto__", value: { x: 1 } }]);
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+});
+
+test("an item added to an array is added alone", () => {
+  assert.deepEqual(patchOf(json("[1,2,4,5]"), json("[1,2,3,4,5]")), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(patchOf(json("[1]"), json("[1,2]")), [{ op: "add", path: "/1", value: 2 }]);
+  assert.deepEqual(patchOf(json("[]"), json("[1]")), [{ op: "add", path: "/0", value: 1 }]);
+});
+
+test("an item removed from an array is removed alone", () => {
+  assert.deepEqual(patchOf(json("[1,2,3,4,5]"), json("[2,3,4,5]")), [{ op: "remove", path: "/0" }]);
+  assert.deepEqual(patchOf(json('[{"a":1},{"a":2},{"a":3}]'), json('[{"a":1},{"a":3}]')), [
+    { op: "remove", path: "/1" },
+  ]);
+});
+
+test("a moved item is removed and added back, leaving the items between untouched", () => {
+  const patch = patchOf(json('["a","b","c","d","e"]'), json('["b","c","d","e","a"]'));
+  assert.ok(patch.length <= 2);
+  assert.ok(patch.every((o) => o.op !== "replace"));
+  patchOf(json('["a","b","c","d","e"]'), json('["a","e","b","c","d"]'));
+});
+
+test("a changed array item is patched in place", () => {
+  assert.deepEqual(patchOf(json('{"l":[{"a":1,"b":2},{"a":3}]}'), json('{"l":[{"a":1,"b":9},{"a":3}]}')), [
+    { op: "replace", path: "/l/0/b", value: 9 },
+  ]);
+});
+
+test("insertions, removals and changes combine in one array", () => {
+  patchOf(json("[1,2,3,4,5,6]"), json("[0,1,3,4,7,5,6,8]"));
+  patchOf(json("[1,2,3]"), json("[3,2,1]"));
+  patchOf(json("[[1,2],[3]]"), json("[[3],[1,2,5]]"));
+  patchOf(json("[1,1,1]"), json("[1,1]"));
+});
+
+test("the patch shares no structure with the inputs", () => {
+  const to = json('{"a":{"b":[1]}}');
+  const patch = createPatch({}, to);
+  (patch[0] as { value: { b: number[] } }).value.b.push(2);
+  assert.deepEqual(to, { a: { b: [1] } });
+});
