+    }
+    case "copy": {
+      const value = walk(root, parsePointer(operation.from), operation.from);
+      return add(root, operation.path, structuredClone(value));
+    }
+    case "test": {
+      const actual = walk(root, parsePointer(operation.path), operation.path);
+      if (!jsonEqual(actual, operation.value)) {
+        throw new Error(`test failed at ${JSON.stringify(operation.path)}: the value is not the expected one`);
+      }
+      return root;
+    }
+  }
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the resulting document. The operations
+ * apply in order. The input is not mutated: the result is a new value.
+ *
+ * Throws when `patch` is not a valid JSON Patch, or when one of its operations fails.
+ */
+export function applyPatch(document: JsonValue, patch: JsonPatch): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("invalid JSON Patch: expected an array of operations");
+  }
+  // The operations work on a copy, so that a failing patch leaves the input as it was.
+  let result = structuredClone(document);
+  patch.forEach((entry, index) => {
+    result = applyOperation(result, checkOperation(entry, index));
+  });
+  return result;
 }
