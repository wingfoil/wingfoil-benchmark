@@ -335,3 +335,149 @@ export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue
   }
   return merge(structuredClone(target), patch);
 }
+
+/** The largest alignment table, in cells, that `createPatch` builds for the elements of an array. */
+const MAX_ALIGNMENT_CELLS = 1_000_000;
+
+/** Escapes a member name as a reference token of a JSON Pointer (RFC 6901, section 3): "~" first, then "/". */
+function escapeToken(name: string): string {
+  return name.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/**
+ * Pairs the elements of `from` and `to` that are equal, as index pairs in increasing order. The common
+ * prefix and suffix are paired first; the middle is aligned by its longest common subsequence when the
+ * table fits in MAX_ALIGNMENT_CELLS, and is left unpaired otherwise.
+ */
+function alignElements(from: JsonValue[], to: JsonValue[]): [number, number][] {
+  const pairs: [number, number][] = [];
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+    pairs.push([start, start]);
+    start++;
+  }
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && jsonEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const rows = endFrom - start;
+  const columns = endTo - start;
+  if (rows * columns <= MAX_ALIGNMENT_CELLS) {
+    // lengths[i][j]: the length of the longest common subsequence of from[start + i..] and to[start + j..].
+    const lengths = Array.from({ length: rows + 1 }, () => new Array<number>(columns + 1).fill(0));
+    for (let i = rows - 1; i >= 0; i--) {
+      for (let j = columns - 1; j >= 0; j--) {
+        lengths[i][j] = jsonEqual(from[start + i], to[start + j])
+          ? lengths[i + 1][j + 1] + 1
+          : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+      }
+    }
+    let i = 0;
+    let j = 0;
+    while (i < rows && j < columns) {
+      if (jsonEqual(from[start + i], to[start + j])) {
+        pairs.push([start + i, start + j]);
+        i++;
+        j++;
+      } else if (lengths[i + 1][j] >= lengths[i][j + 1]) {
+        i++;
+      } else {
+        j++;
+      }
+    }
+  }
+  for (let k = 0; k < from.length - endFrom; k++) {
+    pairs.push([endFrom + k, endTo + k]);
+  }
+  return pairs;
+}
+
+/** Appends the operations that turn `from` into `to` at `path` (see `createPatch`). */
+function diffValue(path: string, from: JsonValue, to: JsonValue, operations: PatchOperation[]): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(path, from, to, operations);
+  } else if (isJsonObject(from) && isJsonObject(to)) {
+    diffObject(path, from, to, operations);
+  } else {
+    operations.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Appends the operations that turn the object `from` into `to`. Members only in `from` are removed,
+ * members only in `to` are added, and the others are compared in turn.
+ */
+function diffObject(
+  path: string,
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  operations: PatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      operations.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const childPath = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) {
+      diffValue(childPath, from[key], to[key], operations);
+    } else {
+      operations.push({ op: "add", path: childPath, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+/**
+ * Appends the operations that turn the array `from` into `to`. Equal elements are aligned, and the
+ * elements between two aligned pairs are paired by position: a pair is compared in turn, and the surplus
+ * of either side is removed or added. Each operation is written for the array as the earlier ones left it.
+ */
+function diffArray(path: string, from: JsonValue[], to: JsonValue[], operations: PatchOperation[]): void {
+  const pairs = alignElements(from, to);
+  pairs.push([from.length, to.length]);
+  // `fromNext` and `toNext` are the first elements after the last aligned pair. The array now holds
+  // to[0..toNext) followed by from[fromNext..].
+  let fromNext = 0;
+  let toNext = 0;
+  for (const [fromMatch, toMatch] of pairs) {
+    const gapFrom = fromMatch - fromNext;
+    const gapTo = toMatch - toNext;
+    const paired = Math.min(gapFrom, gapTo);
+    for (let k = 0; k < paired; k++) {
+      diffValue(`${path}/${toNext + k}`, from[fromNext + k], to[toNext + k], operations);
+    }
+    // Each removal takes the element that the previous one moved into place, so they share an index.
+    for (let k = paired; k < gapFrom; k++) {
+      operations.push({ op: "remove", path: `${path}/${toNext + paired}` });
+    }
+    for (let k = paired; k < gapTo; k++) {
+      operations.push({ op: "add", path: `${path}/${toNext + k}`, value: structuredClone(to[toNext + k]) });
+    }
+    fromNext = fromMatch + 1;
+    toNext = toMatch + 1;
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied: `applyPatch(from, patch)`
+ * equals `to`. The patch describes only what changed. Objects are compared member by member, and arrays
+ * element by element, so that an added, removed or moved element is one or two operations and the
+ * elements around it are not rewritten. A value that changed type, or a scalar that changed, is replaced
+ * whole. The inputs are not mutated, and the patch shares no object with them.
+ *
+ * Throws when `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatch {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new Error("invalid JSON document: it contains a value that is not a JSON value");
+  }
+  const operations: PatchOperation[] = [];
+  diffValue("", from, to, operations);
+  return operations;
+}
