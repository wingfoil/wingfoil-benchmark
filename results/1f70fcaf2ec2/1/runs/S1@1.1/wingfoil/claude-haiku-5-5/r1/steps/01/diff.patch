+/** A JSON value: a JSON document, or any value inside one. */
+export type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
+
+/** An array index as RFC 6901 writes it: "0", or a digit string without a leading zero. */
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** A "~" that is not the start of an escape sequence "~0" or "~1". */
+const INVALID_ESCAPE = /~(?![01])/;
+
+/**
+ * Splits a JSON Pointer (RFC 6901) into its unescaped reference tokens.
+ * Throws when the pointer is not a valid JSON Pointer.
+ */
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("invalid JSON Pointer: expected a string");
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`invalid JSON Pointer ${JSON.stringify(pointer)}: it must be empty or start with "/"`);
+  }
+  return pointer.slice(1).split("/").map((token) => {
+    if (INVALID_ESCAPE.test(token)) {
+      throw new Error(`invalid JSON Pointer ${JSON.stringify(pointer)}: "~" must be escaped as "~0" or "~1"`);
+    }
+    // "~1" is unescaped before "~0", so that "~01" becomes "~1" and not "/".
+    return token.replace(/~1/g, "/").replace(/~0/g, "~");
+  });
+}
+
+/** Returns the member or element of `parent` that `token` names. Throws when there is none. */
+function child(parent: JsonValue, token: string, pointer: string): JsonValue {
+  if (Array.isArray(parent)) {
+    if (ARRAY_INDEX.test(token) && Number(token) < parent.length) {
+      return parent[Number(token)];
+    }
+  } else if (typeof parent === "object" && parent !== null && Object.hasOwn(parent, token)) {
+    return parent[token];
+  }
+  throw new Error(`JSON Pointer ${JSON.stringify(pointer)} does not resolve: no value at ${JSON.stringify(token)}`);
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document and returns the value it refers to.
+ * The empty pointer refers to the whole document.
+ *
+ * Throws when `pointer` is not a valid JSON Pointer, or when it does not resolve to a value of
+ * `document`.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  let current = document;
+  for (const token of parsePointer(pointer)) {
+    current = child(current, token, pointer);
+  }
+  return current;
+}
