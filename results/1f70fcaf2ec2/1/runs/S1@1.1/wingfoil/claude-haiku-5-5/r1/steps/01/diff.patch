+++ b/src/index.test.ts
@@ -0,0 +1,106 @@
+import { test, describe } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "./index.ts";
+
+// The example document of RFC 6901, section 5.
+const rfcDocument = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+describe("resolvePointer", () => {
+  test("the empty pointer refers to the whole document", () => {
+    assert.equal(resolvePointer(rfcDocument, ""), rfcDocument);
+    assert.equal(resolvePointer(5, ""), 5);
+  });
+
+  test("resolves the RFC 6901 section 5 examples", () => {
+    assert.deepEqual(resolvePointer(rfcDocument, "/foo"), ["bar", "baz"]);
+    assert.equal(resolvePointer(rfcDocument, "/foo/0"), "bar");
+    assert.equal(resolvePointer(rfcDocument, "/"), 0);
+    assert.equal(resolvePointer(rfcDocument, "/a~1b"), 1);
+    assert.equal(resolvePointer(rfcDocument, "/c%d"), 2);
+    assert.equal(resolvePointer(rfcDocument, "/e^f"), 3);
+    assert.equal(resolvePointer(rfcDocument, "/g|h"), 4);
+    assert.equal(resolvePointer(rfcDocument, "/i\\j"), 5);
+    assert.equal(resolvePointer(rfcDocument, '/k"l'), 6);
+    assert.equal(resolvePointer(rfcDocument, "/ "), 7);
+    assert.equal(resolvePointer(rfcDocument, "/m~0n"), 8);
+  });
+
+  test("unescapes ~1 before ~0", () => {
+    const document = { "~1": "tilde-one", "/": "slash" };
+    assert.equal(resolvePointer(document, "/~01"), "tilde-one");
+    assert.equal(resolvePointer(document, "/~1"), "slash");
+  });
+
+  test("returns falsy values as values, not as missing", () => {
+    const document = { zero: 0, no: false, empty: "", none: null };
+    assert.equal(resolvePointer(document, "/zero"), 0);
+    assert.equal(resolvePointer(document, "/no"), false);
+    assert.equal(resolvePointer(document, "/empty"), "");
+    assert.equal(resolvePointer(document, "/none"), null);
+  });
+
+  test("resolves a numeric token on an object as a member name", () => {
+    assert.equal(resolvePointer({ "0": "member" }, "/0"), "member");
+  });
+
+  test("resolves an own property named like a prototype member", () => {
+    const document = JSON.parse('{"__proto__": "own", "constructor": "own too"}');
+    assert.equal(resolvePointer(document, "/__proto__"), "own");
+    assert.equal(resolvePointer(document, "/constructor"), "own too");
+  });
+
+  test("throws when the pointer does not start with a slash", () => {
+    assert.throws(() => resolvePointer(rfcDocument, "foo"), /invalid JSON Pointer/);
+    assert.throws(() => resolvePointer(rfcDocument, "~1"), /invalid JSON Pointer/);
+    assert.throws(() => resolvePointer(rfcDocument, " /foo"), /invalid JSON Pointer/);
+  });
+
+  test("throws when a tilde is not followed by 0 or 1", () => {
+    assert.throws(() => resolvePointer(rfcDocument, "/a~2"), /invalid JSON Pointer/);
+    assert.throws(() => resolvePointer(rfcDocument, "/a~"), /invalid JSON Pointer/);
+    assert.throws(() => resolvePointer(rfcDocument, "/a~x/b"), /invalid JSON Pointer/);
+  });
+
+  test("throws when the pointer is not a string", () => {
+    assert.throws(() => resolvePointer(rfcDocument, undefined as unknown as string), /invalid JSON Pointer/);
+  });
+
+  test("throws when a member is missing", () => {
+    assert.throws(() => resolvePointer(rfcDocument, "/missing"), /does not resolve/);
+    assert.throws(() => resolvePointer(rfcDocument, "/foo/bar"), /does not resolve/);
+  });
+
+  test("throws when a member is inherited rather than own", () => {
+    assert.throws(() => resolvePointer({}, "/constructor"), /does not resolve/);
+    assert.throws(() => resolvePointer({}, "/toString"), /does not resolve/);
+  });
+
+  test("throws when an array index is out of range", () => {
+    assert.throws(() => resolvePointer(rfcDocument, "/foo/2"), /does not resolve/);
+    assert.throws(() => resolvePointer([], "/0"), /does not resolve/);
+  });
+
+  test("throws when an array index is not canonical", () => {
+    assert.throws(() => resolvePointer(rfcDocument, "/foo/-"), /does not resolve/);
+    assert.throws(() => resolvePointer(rfcDocument, "/foo/01"), /does not resolve/);
+    assert.throws(() => resolvePointer(rfcDocument, "/foo/+1"), /does not resolve/);
+    assert.throws(() => resolvePointer(rfcDocument, "/foo/1e0"), /does not resolve/);
+  });
+
+  test("throws when the pointer steps into a scalar or null", () => {
+    assert.throws(() => resolvePointer(rfcDocument, "/foo/0/length"), /does not resolve/);
+    assert.throws(() => resolvePointer({ a: null }, "/a/b"), /does not resolve/);
+    assert.throws(() => resolvePointer(7, "/a"), /does not resolve/);
+  });
+});
