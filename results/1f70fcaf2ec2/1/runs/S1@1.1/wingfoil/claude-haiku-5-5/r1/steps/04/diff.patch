+
+describe("applyMergePatch", () => {
+  // The examples of RFC 7386, section 3: each row is a target, a patch and the merged result.
+  const rfcExamples: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { c: null } } }, { a: { bb: {} } }],
+  ];
+
+  test("the RFC 7386 section 3 examples give the documented results", () => {
+    for (const [target, patch, result] of rfcExamples) {
+      assert.deepEqual(applyMergePatch(target as never, patch as never), result);
+    }
+  });
+
+  test("a null member removes the target member, or does nothing when there is none", () => {
+    assert.deepEqual(applyMergePatch({ a: 1, b: 2 }, { a: null }), { b: 2 });
+    assert.deepEqual(applyMergePatch({ a: 1 }, { z: null }), { a: 1 });
+  });
+
+  test("nested objects are merged recursively, and their nulls remove members", () => {
+    assert.deepEqual(applyMergePatch({ a: { b: 1, c: 2 } }, { a: { c: null, d: 3 } }), { a: { b: 1, d: 3 } });
+  });
+
+  test("a non-object target is replaced by an empty object before an object patch is merged", () => {
+    assert.deepEqual(applyMergePatch(5, { a: 1, b: null }), { a: 1 });
+    assert.deepEqual(applyMergePatch(null, { a: { b: null } }), { a: {} });
+    assert.deepEqual(applyMergePatch([1, 2], { a: "b" }), { a: "b" });
+  });
+
+  test("arrays are replaced whole, and null elements inside them are kept", () => {
+    assert.deepEqual(applyMergePatch({ a: [1, 2] }, { a: [null, { x: null }] }), { a: [null, { x: null }] });
+    assert.deepEqual(applyMergePatch({ a: [1] }, { a: [] }), { a: [] });
+  });
+
+  test("a patch that is not an object replaces the target, including with null", () => {
+    assert.equal(applyMergePatch({ a: 1 }, 7), 7);
+    assert.equal(applyMergePatch({ a: 1 }, null), null);
+    assert.deepEqual(applyMergePatch({ a: 1 }, false as never), false);
+  });
+
+  test("a member named __proto__ is merged as a plain member", () => {
+    const patch = JSON.parse('{"__proto__": {"x": 1}}') as never;
+    const result = applyMergePatch({}, patch) as Record<string, unknown>;
+    assert.equal(Object.getPrototypeOf(result), Object.prototype);
+    assert.deepEqual(Object.getOwnPropertyDescriptor(result, "__proto__")?.value, { x: 1 });
+  });
+
+  test("neither input is mutated, and the result shares no object with the patch", () => {
+    const target = { a: { b: 1 }, c: [1] };
+    const patch = { a: { d: { e: 2 } }, f: { g: 3 } };
+    const targetBefore = structuredClone(target);
+    const patchBefore = structuredClone(patch);
+    const result = applyMergePatch(target, patch) as Record<string, any>;
+    assert.deepEqual(target, targetBefore);
+    assert.deepEqual(patch, patchBefore);
+    result.f.g = 99;
+    result.a.d.e = 99;
+    assert.deepEqual(patch, patchBefore);
+  });
+
+  test("a target or patch that is not JSON is rejected", () => {
+    assert.throws(() => applyMergePatch({ a: undefined } as never, {}), /not a JSON value/);
+    assert.throws(() => applyMergePatch(new Date(0) as never, {}), /not a JSON value/);
+    assert.throws(() => applyMergePatch({}, { a: NaN } as never), /not a JSON value/);
+    assert.throws(() => applyMergePatch({}, undefined as never), /not a JSON value/);
+  });
+});
