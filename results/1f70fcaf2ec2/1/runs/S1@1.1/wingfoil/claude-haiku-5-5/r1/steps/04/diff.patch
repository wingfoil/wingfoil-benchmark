+
+/** Whether `value` is a JSON object: a JSON value that is neither an array nor a scalar. */
+function isJsonObject(value: JsonValue): value is { [key: string]: JsonValue } {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Merges `patch` into `target` (RFC 7386, section 2) and returns the result. The target is changed in
+ * place, so the caller passes a copy it owns.
+ */
+function merge(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result: { [key: string]: JsonValue } = isJsonObject(target) ? target : {};
+  for (const [name, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[name];
+    } else {
+      setMember(result, name, merge(Object.hasOwn(result, name) ? result[name] : {}, value));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the merged document. A member of
+ * `patch` whose value is `null` removes that member from the target; any other object member merges
+ * recursively; a patch that is not an object replaces the target. Arrays are replaced whole. The inputs
+ * are not mutated: the result is a new value.
+ *
+ * Throws when `target` or `patch` is not a JSON value.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonValue(target)) {
+    throw new Error("invalid JSON document: it contains a value that is not a JSON value");
+  }
+  if (!isJsonValue(patch)) {
+    throw new Error("invalid JSON Merge Patch: it contains a value that is not a JSON value");
+  }
+  return merge(structuredClone(target), patch);
+}
