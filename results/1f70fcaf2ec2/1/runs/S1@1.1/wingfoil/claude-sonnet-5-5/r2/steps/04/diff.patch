+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document.
+ *
+ * @param target the JSON document to patch; it is not modified
+ * @param patch the merge patch; a non-object patch replaces the target, null members delete
+ * @returns the merged document, as a new value
+ */
+export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
+  if (!isObject(patch)) {
+    return clone(patch);
+  }
+  const result: { [key: string]: JsonValue } = isObject(target) ? (clone(target) as { [key: string]: JsonValue }) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
