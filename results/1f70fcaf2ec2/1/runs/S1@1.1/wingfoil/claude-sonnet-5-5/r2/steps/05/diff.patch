+
+/** A JSON Patch operation as produced by {@link createPatch}. */
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: JsonValue }
+  | { op: "remove"; path: string };
+
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Lengths of the longest common suffixes of from[i..] and to[j..], for every i and j. */
+function commonSuffixLengths(from: unknown[], to: unknown[]): number[][] {
+  const table = Array.from({ length: from.length + 1 }, () => new Array<number>(to.length + 1).fill(0));
+  for (let i = from.length - 1; i >= 0; i--) {
+    for (let j = to.length - 1; j >= 0; j--) {
+      table[i][j] = equal(from[i], to[j]) ? table[i + 1][j + 1] + 1 : Math.max(table[i + 1][j], table[i][j + 1]);
+    }
+  }
+  return table;
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, out: PatchOperation[]): void {
+  const lcs = commonSuffixLengths(from, to);
+  let i = 0;
+  let j = 0;
+  let index = 0; // position in the array as the operations so far leave it
+  while (i < from.length || j < to.length) {
+    if (i < from.length && j < to.length && equal(from[i], to[j])) {
+      i++;
+      j++;
+      index++;
+      continue;
+    }
+    // a run of items to drop and a run of items to insert, up to the next common item
+    const dropStart = i;
+    const addStart = j;
+    while ((i < from.length || j < to.length) && !(i < from.length && j < to.length && equal(from[i], to[j]))) {
+      if (j === to.length || (i < from.length && lcs[i + 1][j] >= lcs[i][j + 1])) i++;
+      else j++;
+    }
+    const dropped = from.slice(dropStart, i);
+    const added = to.slice(addStart, j);
+    const paired = Math.min(dropped.length, added.length);
+    for (let k = 0; k < paired; k++) {
+      diffValues(dropped[k], added[k], `${path}/${index++}`, out);
+    }
+    for (const _ of dropped.slice(paired)) {
+      out.push({ op: "remove", path: `${path}/${index}` });
+    }
+    for (const value of added.slice(paired)) {
+      out.push({ op: "add", path: `${path}/${index++}`, value: clone(value) });
+    }
+  }
+}
+
+function diffValues(from: unknown, to: unknown, path: string, out: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!hasOwn(to, key)) {
+        out.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${encodeToken(key)}`;
+      if (hasOwn(from, key)) {
+        diffValues(from[key], to[key], child, out);
+      } else {
+        out.push({ op: "add", path: child, value: clone(to[key]) });
+      }
+    }
+  } else if (!equal(from, to)) {
+    out.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Computes a JSON Patch (RFC 6902) that turns one JSON document into another.
+ *
+ * Objects are compared member by member and nested values recursively; arrays are aligned on their
+ * longest common subsequence, so an inserted or removed item is a single add or remove, and a moved
+ * item is a remove plus an add, without touching the items around it.
+ *
+ * @param from the original document; it is not modified
+ * @param to the target document; it is not modified
+ * @returns operations (add, remove, replace) such that `applyPatch(from, patch)` equals `to`; empty if they are equal
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diffValues(from, to, "", out);
+  return out;
+}
