+function roundTrip(from: unknown, to: unknown) {
+  const before = JSON.stringify(from);
+  const after = JSON.stringify(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.equal(JSON.stringify(from), before);
+  assert.equal(JSON.stringify(to), after);
+  return patch;
+}
+
+test("createPatch: equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("createPatch: a small change in a large document is a single operation", () => {
+  const from = { a: { b: { c: 1, d: [1, 2, 3] } }, e: "x" };
+  const to = { a: { b: { c: 1, d: [1, 2, 4] } }, e: "x" };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/d/2", value: 4 }]);
+});
+
+test("createPatch: object members are added, removed and escaped", () => {
+  const patch = roundTrip({ "a/b": 1, "m~n": 2, gone: 3 }, { "a/b": 1, "m~n": 5, new: 4 });
+  assert.equal(patch.length, 3);
+  assert.ok(patch.some((o) => o.path === "/m~0n"));
+});
+
+test("createPatch: root and type changes replace the value", () => {
+  assert.deepEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  roundTrip({ a: [1] }, { a: { 0: 1 } });
+  roundTrip(null, { a: null });
+  roundTrip([], {});
+});
+
+test("createPatch: an inserted or deleted array item is one operation", () => {
+  const items = [{ id: 1 }, { id: 2 }, { id: 3 }, { id: 4 }];
+  assert.deepEqual(roundTrip(items, [items[0], { id: 9 }, ...items.slice(1)]), [
+    { op: "add", path: "/1", value: { id: 9 } },
+  ]);
+  assert.deepEqual(roundTrip(items, [items[0], items[2], items[3]]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip(items, [...items, { id: 5 }]), [{ op: "add", path: "/4", value: { id: 5 } }]);
+});
+
+test("createPatch: a moved array item does not rewrite the items between", () => {
+  const patch = roundTrip([1, 2, 3, 4, 5, 6], [1, 6, 2, 3, 4, 5]);
+  assert.ok(patch.length <= 2);
+  const patch2 = roundTrip([1, 2, 3, 4, 5, 6], [2, 3, 4, 5, 6, 1]);
+  assert.ok(patch2.length <= 2);
+});
+
+test("createPatch: a changed array item is patched in place", () => {
+  assert.deepEqual(roundTrip([{ a: 1, b: 2 }, 5], [{ a: 1, b: 3 }, 5]), [
+    { op: "replace", path: "/0/b", value: 3 },
+  ]);
+});
+
+test("createPatch: patch does not share structure with its inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to) as { value: { b: number } }[];
+  patch[0].value.b = 2;
+  assert.equal(to.a.b, 1);
+});
+
+test("createPatch: random documents round-trip", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) % 2147483648), seed % n);
+  const gen = (depth: number): unknown => {
+    const k = rnd(depth > 2 ? 4 : 6);
+    if (k === 0) return rnd(3);
+    if (k === 1) return "s" + rnd(3);
+    if (k === 2) return null;
+    if (k === 3) return rnd(2) === 0;
+    if (k === 4) return Array.from({ length: rnd(6) }, () => gen(depth + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(depth + 1)]));
+  };
+  for (let i = 0; i < 300; i++) roundTrip(gen(0), gen(0));
+});
