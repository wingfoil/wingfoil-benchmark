+     content it carries. -->
+
+Review `applyPatch` against RFC 6902 (checking and application of operations, errors included) and make
+it conform. Review outcome: every case examined (move to self, move as remove+add, prefix rule, missing
+or non-string members, unknown members ignored, array index syntax, "-", atomic failure, deep equality in
+`test`) already conforms; regression tests for these edge cases were added in `src/index.test.ts`.
+Open point: removing the whole document is rejected (the RFC is silent on the resulting document).
diff --git a/src/index.test.ts b/src/index.test.ts
index ac22f104a7011b559663f9e4c83605a945f182fd..076d1cb5755115efd24a3b5f56d4836455d9aecb 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -116,3 +116,23 @@ test("test op uses deep JSON equality; __proto__ stays a plain member", () => {
   assert.equal(Object.getPrototypeOf(out), Object.prototype);
   assert.deepEqual(Object.keys(out), ["__proto__"]);
 });
+
+test("RFC 6902 edge cases", () => {
+  // move to the same location is a no-op, but the location must exist
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "/b", path: "/b" }]));
+  // move is a remove followed by an add
+  assert.deepEqual(applyPatch({ a: [1, 2] }, [{ op: "move", from: "/a/0", path: "/a/-" }]), { a: [2, 1] });
+  assert.throws(() => applyPatch({ a: [1, 2] }, [{ op: "move", from: "/a/0", path: "/a/2" }]));
+  // "from" may be an ancestor-free prefix of nothing, but never a proper prefix of "path"
+  assert.deepEqual(applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a/b", path: "/a" }]), { a: 1 });
+  // members that are not defined by the RFC are ignored
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a", value: 1, extra: true }]), { a: 1 });
+  // a failing operation leaves nothing behind: the input is untouched and an error is thrown
+  const input = { a: [1] };
+  assert.throws(() => applyPatch(input, [{ op: "add", path: "/a/-", value: 2 }, { op: "test", path: "/a/0", value: 9 }]));
+  assert.deepEqual(input, { a: [1] });
+  // op names are case sensitive; array indexes are plain decimal
+  assert.throws(() => applyPatch({}, [{ op: "ADD", path: "/a", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/1e0", value: 1 }]));
+});
