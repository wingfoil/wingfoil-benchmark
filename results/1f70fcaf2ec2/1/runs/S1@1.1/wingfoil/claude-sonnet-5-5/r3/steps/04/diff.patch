   return root;
 }
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document.
+ *
+ * @param target the JSON document to patch; it is not modified
+ * @param patch the merge patch: object members set or replace members, `null` members remove them,
+ *   any non-object patch replaces the target as a whole
+ * @returns the merged document, as a new value
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isPlainObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result: object = {};
+  if (isPlainObject(target)) {
+    for (const key of Object.keys(target)) {
+      setMember(result, key, structuredClone(target[key]));
+    }
+  }
+  const current = result as Record<string, unknown>;
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete current[key];
+    } else {
+      const base = Object.prototype.hasOwnProperty.call(current, key) ? current[key] : undefined;
+      setMember(result, key, applyMergePatch(base, value));
+    }
+  }
+  return result;
+}
