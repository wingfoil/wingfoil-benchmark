@@ -0,0 +1,114 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ap = (d: unknown, p: unknown) => applyPatch(d, p);
+
+test("RFC 6902 appendix A examples", () => {
+  assert.deepEqual(ap({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(ap({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(ap({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+  assert.deepEqual(ap({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+  assert.deepEqual(ap({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), { baz: "boo", foo: "bar" });
+  assert.deepEqual(
+    ap({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(ap({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  assert.deepEqual(
+    ap({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "copy", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(ap({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }]), {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  });
+  assert.throws(() => ap({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]));
+  assert.deepEqual(ap({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]), { foo: "bar", child: { grandchild: {} } });
+  assert.deepEqual(ap({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }]), { foo: "bar", baz: "qux" });
+  assert.throws(() => ap({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]));
+  assert.throws(() => ap({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", op2: 1 }, { op: "bogus", path: "/x" }]));
+  assert.deepEqual(ap({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }, { op: "add", path: "/baz", value: "boo" }]), { foo: "bar", baz: "boo" });
+});
+
+test("add: root, append, bounds", () => {
+  assert.deepEqual(ap({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(ap({ a: [1] }, [{ op: "add", path: "/a/-", value: 2 }]), { a: [1, 2] });
+  assert.deepEqual(ap({ a: [1] }, [{ op: "add", path: "/a/1", value: 2 }]), { a: [1, 2] });
+  assert.throws(() => ap({ a: [1] }, [{ op: "add", path: "/a/2", value: 2 }]));
+  assert.throws(() => ap({ a: [1] }, [{ op: "add", path: "/a/01", value: 2 }]));
+  assert.throws(() => ap({ a: [1] }, [{ op: "add", path: "/a/x", value: 2 }]));
+  assert.throws(() => ap({ a: 1 }, [{ op: "add", path: "/a/b", value: 2 }]));
+  assert.throws(() => ap({}, [{ op: "add", path: "/a" }]));
+  assert.deepEqual(ap({}, [{ op: "add", path: "/a", value: null }]), { a: null });
+});
+
+test("remove and replace require an existing target", () => {
+  assert.throws(() => ap({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => ap({ a: [1] }, [{ op: "remove", path: "/a/1" }]));
+  assert.throws(() => ap({ a: [1] }, [{ op: "remove", path: "/a/-" }]));
+  assert.throws(() => ap({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => ap({ a: [1] }, [{ op: "replace", path: "/a/1", value: 1 }]));
+  assert.deepEqual(ap({ a: [1, 2] }, [{ op: "replace", path: "/a/1", value: 9 }]), { a: [1, 9] });
+  assert.deepEqual(ap({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+  assert.throws(() => ap({ a: 1 }, [{ op: "remove", path: "" }]));
+});
+
+test("move and copy", () => {
+  assert.throws(() => ap({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b/c" }]));
+  assert.throws(() => ap({}, [{ op: "move", from: "/a", path: "/b" }]));
+  assert.throws(() => ap({}, [{ op: "copy", from: "/a", path: "/b" }]));
+  assert.throws(() => ap({ a: 1 }, [{ op: "move", path: "/b" }]));
+  assert.deepEqual(ap({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.deepEqual(ap({ a: 1 }, [{ op: "move", from: "/a", path: "" }]), 1);
+  const copied = ap({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }]) as any;
+  copied.a.x = 2;
+  assert.equal(copied.b.x, 1);
+});
+
+test("test compares deeply", () => {
+  const d = { a: { x: 1, y: [1, { z: null }] } };
+  assert.deepEqual(ap(d, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }]), d);
+  assert.throws(() => ap(d, [{ op: "test", path: "/a", value: { x: 1 } }]));
+  assert.throws(() => ap(d, [{ op: "test", path: "/a/y", value: { 0: 1, 1: { z: null } } }]));
+  assert.throws(() => ap(d, [{ op: "test", path: "/missing", value: 1 }]));
+  assert.throws(() => ap({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]));
+  assert.deepEqual(ap({ a: null }, [{ op: "test", path: "/a", value: null }]), { a: null });
+});
+
+test("invalid patches", () => {
+  assert.throws(() => ap({}, {}));
+  assert.throws(() => ap({}, [null]));
+  assert.throws(() => ap({}, [[]]));
+  assert.throws(() => ap({}, [{ path: "/a", value: 1 }]));
+  assert.throws(() => ap({}, [{ op: "nope", path: "/a", value: 1 }]));
+  assert.throws(() => ap({}, [{ op: "add", value: 1 }]));
+  assert.throws(() => ap({}, [{ op: "add", path: "a", value: 1 }]));
+  assert.throws(() => ap({}, [{ op: "add", path: "/~2", value: 1 }]));
+});
+
+test("does not mutate input or patch; failure leaves input intact", () => {
+  const d = { a: [1, 2], b: { c: 1 } };
+  const p = [{ op: "add", path: "/a/-", value: { n: 1 } }, { op: "move", from: "/b", path: "/e" }, { op: "remove", path: "/a/0" }];
+  const dCopy = structuredClone(d);
+  const pCopy = structuredClone(p);
+  const out = ap(d, p) as any;
+  assert.deepEqual(d, dCopy);
+  assert.deepEqual(p, pCopy);
+  out.a[1].n = 99;
+  assert.deepEqual(p, pCopy);
+  assert.throws(() => ap(d, [{ op: "remove", path: "/a/0" }, { op: "remove", path: "/zz" }]));
+  assert.deepEqual(d, dCopy);
+});
+
+test("special member names are plain members", () => {
+  const out = ap({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as any;
+  assert.equal(Object.prototype.hasOwnProperty.call(out, "__proto__"), true);
+  assert.equal(({} as any).x, undefined);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.throws(() => ap({}, [{ op: "remove", path: "/__proto__" }]));
+  assert.throws(() => ap({ a: [] }, [{ op: "remove", path: "/a/length" }]));
+  assert.deepEqual(ap({ "a/b": 1, "m~n": 2 }, [{ op: "replace", path: "/a~1b", value: 3 }, { op: "remove", path: "/m~0n" }]), { "a/b": 3 });
+});
