@@ -0,0 +1,69 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown) {
+  const f = structuredClone(from);
+  const t = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, f);
+  assert.deepEqual(to, t);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a small change gives a small patch", () => {
+  const patch = roundTrip({ a: { b: 1, c: [1, 2] }, d: "x" }, { a: { b: 2, c: [1, 2] }, d: "x" });
+  assert.deepEqual(patch, [{ op: "replace", path: "/a/b", value: 2 }]);
+});
+
+test("object members added and removed, keys escaped", () => {
+  const patch = roundTrip({ "a/b": 1, "~": 2 }, { "~": 2, "c/d": 3 });
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/a~1b" },
+    { op: "add", path: "/c~1d", value: 3 },
+  ]);
+});
+
+test("array insert and delete do not rewrite neighbours", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([{ a: 1 }, { a: 2 }], [{ a: 2 }]), [{ op: "remove", path: "/0" }]);
+});
+
+test("array move touches only the moved item", () => {
+  const patch = roundTrip([1, 2, 3, 4, 5], [1, 5, 2, 3, 4]);
+  assert.equal(patch.length, 2);
+});
+
+test("type changes, root and null", () => {
+  roundTrip(1, 2);
+  roundTrip({ a: 1 }, [1]);
+  roundTrip({ a: null }, { a: { b: [] } });
+  roundTrip([1, [2, 3]], [[2, 3], 1]);
+  roundTrip(null, { a: 1 });
+});
+
+test("__proto__ member", () => {
+  const to = JSON.parse('{"__proto__": {"x": 1}}');
+  roundTrip({}, to);
+  roundTrip(to, {});
+});
+
+test("randomized round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) % 2147483648), seed % n);
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 3 : 5);
+    if (k === 0) return rnd(3);
+    if (k === 1) return "s" + rnd(3);
+    if (k === 2) return null;
+    if (k === 3) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let i = 0; i < 2000; i++) roundTrip(gen(0), gen(0));
+});
