   return result;
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function hasOwn(object: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(object, key);
+}
+
+/** Pairs of indices (into `a` and `b`) of a longest common subsequence of deeply equal items. */
+function commonItems(a: unknown[], b: unknown[]): [number, number][] {
+  let start = 0;
+  while (start < a.length && start < b.length && deepEqual(a[start], b[start])) {
+    start++;
+  }
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && deepEqual(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const n = endA - start;
+  const m = endB - start;
+  // lengths[i][j]: LCS length of a[start + i ..) and b[start + j ..)
+  const lengths: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lengths[i][j] = deepEqual(a[start + i], b[start + j])
+        ? lengths[i + 1][j + 1] + 1
+        : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  const pairs: [number, number][] = [];
+  for (let i = 0; i < start; i++) {
+    pairs.push([i, i]);
+  }
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (deepEqual(a[start + i], b[start + j])) {
+      pairs.push([start + i, start + j]);
+      i++;
+      j++;
+    } else if (lengths[i + 1][j] >= lengths[i][j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  for (let k = 0; endA + k < a.length; k++) {
+    pairs.push([endA + k, endB + k]);
+  }
+  return pairs;
+}
+
+function diffArrays(a: unknown[], b: unknown[], path: string, ops: PatchOperation[]): void {
+  // Anchors end with a sentinel so that the trailing gap is handled like any other.
+  const anchors = [...commonItems(a, b), [a.length, b.length] as [number, number]];
+  let ia = 0;
+  let ib = 0;
+  let out = 0; // index in the array as patched so far
+  for (const [anchorA, anchorB] of anchors) {
+    const removed = anchorA - ia;
+    const added = anchorB - ib;
+    const paired = Math.min(removed, added);
+    for (let p = 0; p < paired; p++) {
+      diffValues(a[ia + p], b[ib + p], `${path}/${out + p}`, ops);
+    }
+    for (let p = paired; p < removed; p++) {
+      ops.push({ op: "remove", path: `${path}/${out + paired}` });
+    }
+    for (let p = paired; p < added; p++) {
+      ops.push({ op: "add", path: `${path}/${out + p}`, value: structuredClone(b[ib + p]) });
+    }
+    out += added + 1;
+    ia = anchorA + 1;
+    ib = anchorB + 1;
+  }
+}
+
+function diffValues(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isPlainObject(from) && isPlainObject(to) && !Array.isArray(from) && !Array.isArray(to)) {
+    for (const key of Object.keys(from)) {
+      if (!hasOwn(to, key)) {
+        ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (hasOwn(from, key)) {
+        diffValues(from[key], to[key], child, ops);
+      } else {
+        ops.push({ op: "add", path: child, value: structuredClone(to[key]) });
+      }
+    }
+  } else {
+    ops.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Computes a JSON Patch (RFC 6902) that turns one JSON document into another.
+ *
+ * The patch is minimal in structure: it descends into objects and arrays and only touches what
+ * differs. Array items that are inserted or deleted produce `add` / `remove` operations, and the
+ * items around them are left alone; a moved item is expressed as a `remove` plus an `add`.
+ *
+ * @param from the original document; it is not modified
+ * @param to the target document; it is not modified
+ * @returns the array of operations that, applied to `from`, gives `to`
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffValues(from, to, "", ops);
+  return ops;
+}
