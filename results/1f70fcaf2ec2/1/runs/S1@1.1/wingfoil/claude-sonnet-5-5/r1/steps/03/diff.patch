+/** Replaces the existing target in place, so that member order and array positions are kept. */
+function replaceAt(doc: JsonValue, pointer: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const [parent, last] = parentOf(doc, tokens);
+  if (Array.isArray(parent)) parent[Number(last)] = value;
+  else setMember(parent as object, last, value);
+  return doc;
+}
