@@ -0,0 +1,41 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, e] of cases) assert.deepEqual(applyMergePatch(t, p), e);
+});
+
+test("does not mutate or share structure", () => {
+  const target = { a: { b: 1 }, c: [1] };
+  const patch = { a: { d: { e: 2 } }, f: [3] };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 }, c: [1] });
+  assert.deepEqual(patch, { a: { d: { e: 2 } }, f: [3] });
+  assert.notEqual(result.a.d, patch.a.d);
+  assert.notEqual(result.f, patch.f);
+  assert.notEqual(result.c, target.c);
+});
+
+test("__proto__ is an ordinary key", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as any;
+  assert.equal(({} as any).x, undefined);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+});
