@@ -0,0 +1,63 @@
+/** A parsed JSON value. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+/**
+ * Parses a JSON Pointer (RFC 6901) into its unescaped reference tokens.
+ * Throws if the string is not a valid JSON Pointer.
+ */
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new TypeError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new SyntaxError(`Invalid JSON Pointer: must be empty or start with "/": ${pointer}`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new SyntaxError(`Invalid JSON Pointer: bad escape "~" in ${pointer}`);
+      }
+      // Order matters: ~1 first, so "~01" becomes "~1" and not "/".
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer `pointer` refers to (RFC 6901).
+ *
+ * Throws a `SyntaxError` if `pointer` is not a valid JSON Pointer, and an `Error` if it does not
+ * resolve to a value of the document (missing member, out-of-range or `-` array index, or a
+ * primitive in the path). Only own members of objects are considered.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current: unknown = document;
+  for (const token of parsePointer(pointer)) {
+    if (Array.isArray(current)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`JSON Pointer does not resolve: "${token}" is not an array index`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new Error(`JSON Pointer does not resolve: index ${token} is out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(`JSON Pointer does not resolve: no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer does not resolve: cannot descend into a primitive at "${token}"`);
+    }
+  }
+  return current;
+}
