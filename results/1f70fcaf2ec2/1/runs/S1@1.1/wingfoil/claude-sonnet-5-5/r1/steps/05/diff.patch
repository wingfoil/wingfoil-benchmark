+/** A JSON Patch operation as produced by `createPatch`. */
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: JsonValue }
+  | { op: "remove"; path: string };
+
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && deepEqual(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && deepEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const a = from.slice(start, endFrom);
+  const b = to.slice(start, endTo);
+
+  // Longest common subsequence of the differing middle parts.
+  const lcs: number[][] = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lcs[i][j] = deepEqual(a[i], b[j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  // `pos` is the index in the array being patched, which already matches `to` before it.
+  let pos = start;
+  let i = 0;
+  let j = 0;
+  const flush = (removed: unknown[], added: unknown[]): void => {
+    const paired = Math.min(removed.length, added.length);
+    for (let k = 0; k < paired; k++) diff(removed[k], added[k], `${path}/${pos + k}`, ops);
+    for (let k = paired; k < removed.length; k++) ops.push({ op: "remove", path: `${path}/${pos + paired}` });
+    for (let k = paired; k < added.length; k++) {
+      ops.push({ op: "add", path: `${path}/${pos + k}`, value: clone(added[k]) });
+    }
+    pos += added.length;
+  };
+  let removed: unknown[] = [];
+  let added: unknown[] = [];
+  while (i < a.length || j < b.length) {
+    if (i < a.length && j < b.length && deepEqual(a[i], b[j]) && lcs[i][j] === lcs[i + 1][j + 1] + 1) {
+      flush(removed, added);
+      removed = [];
+      added = [];
+      pos++;
+      i++;
+      j++;
+    } else if (i < a.length && (j === b.length || lcs[i + 1][j] >= lcs[i][j + 1])) {
+      removed.push(a[i++]);
+    } else {
+      added.push(b[j++]);
+    }
+  }
+  flush(removed, added);
+}
+
+function diff(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (deepEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (has(from, key)) diff(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ * Neither input is mutated, and the patch shares no structure with either.
+ *
+ * The patch is minimal in scope: unchanged members are left alone, and array items that are added,
+ * removed or moved are expressed as `add` and `remove` operations rather than by rewriting the items
+ * around them. Equal documents give an empty patch.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
