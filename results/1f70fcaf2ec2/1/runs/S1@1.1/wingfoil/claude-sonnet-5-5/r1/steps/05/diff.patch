@@ -0,0 +1,66 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const before = JSON.stringify(from);
+  const patch = createPatch(from, to);
+  assert.equal(JSON.stringify(from), before);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+};
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small change deep in a document", () => {
+  assert.deepEqual(roundTrip({ a: { b: 1, c: [1, 2] }, d: 1 }, { a: { b: 1, c: [1, 3] }, d: 1 }), [
+    { op: "replace", path: "/a/c/1", value: 3 },
+  ]);
+});
+
+test("object members, escaping, root and type changes", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "m~n": 2 }, { "m~n": 3, x: 1 }), [
+    { op: "remove", path: "/a~1b" },
+    { op: "replace", path: "/m~0n", value: 3 },
+    { op: "add", path: "/x", value: 1 },
+  ]);
+  assert.deepEqual(roundTrip(1, "x"), [{ op: "replace", path: "", value: "x" }]);
+  roundTrip({ a: [1] }, { a: { 0: 1 } });
+  roundTrip({ a: null }, { a: [] });
+  roundTrip(null, { a: 1 });
+});
+
+test("array insert, delete and move do not rewrite neighbours", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.equal(roundTrip(["a", "b", "c", "d", "e"], ["a", "c", "d", "e", "b"]).length, 2);
+  assert.equal(roundTrip([{ x: 1 }, { x: 2 }, { x: 3 }], [{ x: 3 }, { x: 1 }, { x: 2 }]).length, 2);
+  assert.deepEqual(roundTrip([], [1, 2]), [
+    { op: "add", path: "/0", value: 1 },
+    { op: "add", path: "/1", value: 2 },
+  ]);
+  roundTrip([1, 2, 3], []);
+});
+
+test("changed items in an array are patched in place", () => {
+  assert.deepEqual(roundTrip([{ a: 1, b: 1 }, { a: 2 }], [{ a: 1, b: 2 }, { a: 2 }]), [
+    { op: "replace", path: "/0/b", value: 2 },
+  ]);
+  roundTrip([1, 2, 3, 4, 5], [2, 9, 4, 5, 6, 7]);
+});
+
+test("random round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff), seed % n);
+  const arr = () => Array.from({ length: rnd(7) }, () => rnd(5));
+  for (let k = 0; k < 500; k++) roundTrip({ l: arr() }, { l: arr() });
+});
+
+test("patch does not share structure with inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0] as { value: { b: number } }).value.b = 2;
+  assert.equal(to.a.b, 1);
+});
