+---
+id: task-002-implement-json-patch-applypatch-rfc-6902
+type: task
+title: "Implement JSON Patch applyPatch (RFC 6902)"
+status: approved
+format: 1
+---
+
+<!-- task body. `wingfoil memory add` copies this scaffold, setting only `id`, `title` and
+     `status` (and any `--tags` or `--set` value). Fill the required frontmatter fields and replace
+     these placeholder comments yourself; `wingfoil memory submit` then checks the required fields,
+     moves `status` forward and commits the document as you left it, naming in the commit body the
+     content it carries. -->
+
+Implement JSON Patch (RFC 6902): export `applyPatch(document, patch)` from `src/index.ts`, with the
+operations add, remove, replace, move, copy and test. It returns the patched document as a new value,
+never mutating its input, and throws if the patch is invalid or an operation fails.
+
+# Acceptance
+
+- Patch must be an array of operation objects; `op` one of the six, `path` a valid JSON Pointer (RFC 6901);
+  `value` required (own member) for add/replace/test; `from` a valid pointer for move/copy. Otherwise throws.
+- add: inserts into arrays (index 0..length, or `-` to append) or sets/replaces an object member; parent must exist; `""` replaces the document.
+- remove: target must exist. replace: target must exist. Removing the whole document throws.
+- move: removes at `from`, adds at `path`; `from` must exist; moving into one's own child throws.
+- copy: copies a deep clone of the value at `from` to `path`.
+- test: deep equality (object member order irrelevant); throws on mismatch.
+- Input and patch are never mutated; the result shares no structure with them. A failing operation leaves no partial result (throws).
+- Keys such as `__proto__` are handled as ordinary members.
+
+# Outcome
+
+Implemented in `src/index.ts` (`applyPatch`), tested in `test/patch.test.ts` (`npm test`, all passing).
diff --git a/src/index.ts b/src/index.ts
index e3986f40ced402b83edbb6349f50de9f6f3d54ef..0f9eb69dc426710381ac08d45bee2c87ead82ba7 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -61,3 +61,152 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+
+const has = (o: object, k: string): boolean => Object.prototype.hasOwnProperty.call(o, k);
+
+/** Sets an own enumerable member, safely even for keys such as `__proto__`. */
+function setMember(obj: object, key: string, value: unknown): void {
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Deep-copies a JSON value; the copy shares no structure with the original. */
+function clone(value: unknown): JsonValue {
+  if (Array.isArray(value)) return value.map(clone);
+  if (typeof value === "object" && value !== null) {
+    const out: Record<string, JsonValue> = {};
+    for (const key of Object.keys(value)) setMember(out, key, clone((value as Record<string, unknown>)[key]));
+    return out;
+  }
+  return value as JsonValue;
+}
+
+/** JSON equality: numbers, strings, booleans and null by value; objects regardless of member order. */
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => deepEqual(v, b[i]))
+    );
+  }
+  if (typeof a === "object" && a !== null && typeof b === "object" && b !== null) {
+    const ka = Object.keys(a);
+    return (
+      ka.length === Object.keys(b).length &&
+      ka.every((k) => has(b, k) && deepEqual((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]))
+    );
+  }
+  return a === b;
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Returns the container holding the target of `tokens` (which must be non-empty) and the last token. */
+function parentOf(doc: unknown, tokens: string[]): [unknown, string] {
+  const parentPointer = tokens.slice(0, -1).map((t) => "/" + escapeToken(t)).join("");
+  return [resolvePointer(doc, parentPointer), tokens[tokens.length - 1]];
+}
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function addAt(doc: JsonValue, pointer: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const [parent, last] = parentOf(doc, tokens);
+  if (Array.isArray(parent)) {
+    if (last === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(last) && Number(last) <= parent.length) {
+      parent.splice(Number(last), 0, value);
+    } else {
+      throw new Error(`add: invalid array index "${last}" in ${pointer}`);
+    }
+  } else if (typeof parent === "object" && parent !== null) {
+    setMember(parent, last, value);
+  } else {
+    throw new Error(`add: parent of ${pointer} is not a container`);
+  }
+  return doc;
+}
+
+/** Removes the target (which must exist) and returns the new document together with the removed value. */
+function removeAt(doc: JsonValue, pointer: string): [JsonValue, JsonValue] {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) throw new Error("cannot remove the whole document");
+  const target = resolvePointer(doc, pointer) as JsonValue; // throws if missing
+  const [parent, last] = parentOf(doc, tokens);
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete (parent as Record<string, unknown>)[last];
+  return [doc, target];
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the result as a new value.
+ * Neither `document` nor `patch` is mutated, and the result shares no structure with either.
+ *
+ * Throws if the patch is invalid, or if an operation fails (including a failed `test`); no partial
+ * result is returned.
+ */
+export function applyPatch(document: unknown, patch: unknown): JsonValue {
+  if (!Array.isArray(patch)) throw new TypeError("JSON Patch must be an array");
+  let doc = clone(document);
+  patch.forEach((raw: unknown, i: number) => {
+    if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+      throw new TypeError(`Invalid JSON Patch: operation ${i} is not an object`);
+    }
+    const op = raw as Record<string, unknown>;
+    const name = has(op, "op") ? op.op : undefined;
+    if (typeof name !== "string" || !["add", "remove", "replace", "move", "copy", "test"].includes(name)) {
+      throw new TypeError(`Invalid JSON Patch: operation ${i} has a missing or unknown "op"`);
+    }
+    if (!has(op, "path") || typeof op.path !== "string") {
+      throw new TypeError(`Invalid JSON Patch: operation ${i} needs a string "path"`);
+    }
+    const path = op.path;
+    parsePointer(path);
+    if ((name === "add" || name === "replace" || name === "test") && (!has(op, "value") || op.value === undefined)) {
+      throw new TypeError(`Invalid JSON Patch: operation ${i} (${name}) needs a "value"`);
+    }
+    let from = "";
+    if (name === "move" || name === "copy") {
+      if (!has(op, "from") || typeof op.from !== "string") {
+        throw new TypeError(`Invalid JSON Patch: operation ${i} (${name}) needs a string "from"`);
+      }
+      from = op.from;
+      parsePointer(from);
+    }
+
+    switch (name) {
+      case "add":
+        doc = addAt(doc, path, clone(op.value));
+        break;
+      case "remove":
+        doc = removeAt(doc, path)[0];
+        break;
+      case "replace":
+        resolvePointer(doc, path); // must exist
+        doc = parsePointer(path).length === 0 ? clone(op.value) : addAt(removeAt(doc, path)[0], path, clone(op.value));
+        break;
+      case "move": {
+        const fromTokens = parsePointer(from);
+        const pathTokens = parsePointer(path);
+        resolvePointer(doc, from); // must exist
+        if (from === path) break;
+        if (fromTokens.length < pathTokens.length && fromTokens.every((t, k) => t === pathTokens[k])) {
+          throw new Error(`move: cannot move ${from} into its own child ${path}`);
+        }
+        const [rest, value] = removeAt(doc, from);
+        doc = addAt(rest, path, value);
+        break;
+      }
+      case "copy":
+        doc = addAt(doc, path, clone(resolvePointer(doc, from)));
+        break;
+      case "test":
+        if (!deepEqual(resolvePointer(doc, path), op.value)) throw new Error(`test failed at ${path}`);
+        break;
+    }
+  });
+  return doc;
+}
