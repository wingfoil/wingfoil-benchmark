@@ -0,0 +1,100 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) => assert.deepEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch));
+
+test("RFC 6902 appendix A examples", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  ok({ foo: { bar: "baz" } }, [{ op: "copy", from: "/foo/bar", path: "/foo/qux" }], { foo: { bar: "baz", qux: "baz" } });
+  ok({ baz: "qux" }, [{ op: "test", path: "/baz", value: "qux" }], { baz: "qux" });
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+});
+
+test("root operations", () => {
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: 2 }], 2);
+  ok({ a: 1 }, [], { a: 1 });
+  bad({ a: 1 }, [{ op: "remove", path: "" }]);
+});
+
+test("failures", () => {
+  bad({ a: 1 }, [{ op: "remove", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "replace", path: "/b", value: 1 }]);
+  bad([1], [{ op: "add", path: "/2", value: 1 }]);
+  bad([1], [{ op: "add", path: "/01", value: 1 }]);
+  bad([1], [{ op: "remove", path: "/-" }]);
+  bad([1], [{ op: "replace", path: "/1", value: 1 }]);
+  bad({ a: 1 }, [{ op: "move", from: "/b", path: "/c" }]);
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b/c" }]);
+  bad({ a: 1 }, [{ op: "copy", from: "/b", path: "/c" }]);
+  bad({ a: 1 }, [{ op: "test", path: "/b", value: 1 }]);
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+});
+
+test("invalid patches", () => {
+  bad({}, { op: "add", path: "/a", value: 1 });
+  bad({}, [null]);
+  bad({}, [[]]);
+  bad({}, [{ path: "/a", value: 1 }]);
+  bad({}, [{ op: "nope", path: "/a" }]);
+  bad({}, [{ op: "add", value: 1 }]);
+  bad({}, [{ op: "add", path: "a", value: 1 }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "" }]);
+  bad({}, [{ op: "test", path: "" }]);
+  bad({}, [{ op: "move", path: "/a" }]);
+  bad({ a: 1 }, [{ op: "copy", from: "x", path: "/b" }]);
+});
+
+test("move to itself is a no-op; test is order-insensitive", () => {
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  ok({ a: { x: 1, y: [1, 2] } }, [{ op: "test", path: "/a", value: { y: [1, 2], x: 1 } }], { a: { x: 1, y: [1, 2] } });
+  bad({ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]);
+});
+
+test("does not mutate or share structure", () => {
+  const doc = { a: { b: [1, 2] }, c: 1 };
+  const patch = [
+    { op: "add", path: "/d", value: { z: [1] } },
+    { op: "copy", from: "/a", path: "/e" },
+    { op: "remove", path: "/a/b/0" },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.deepEqual(out.e, { b: [1, 2] });
+  out.d.z.push(2);
+  assert.deepEqual(patch[0].value, { z: [1] });
+  assert.notEqual(applyPatch(doc, []), doc);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as any;
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(({} as any).x, undefined);
+  bad({}, [{ op: "remove", path: "/__proto__" }]);
+});
+
+test("escaped keys", () => {
+  ok({ "a/b": { "~": 1 } }, [{ op: "add", path: "/a~1b/~0x", value: 2 }], { "a/b": { "~": 1, "~x": 2 } });
+});
