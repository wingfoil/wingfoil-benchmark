@@ -0,0 +1,57 @@
+/** Error thrown for an invalid JSON Pointer or one that does not resolve to a value. */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+/** Unescapes one reference token (RFC 6901 section 4): `~1` to `/` first, then `~0` to `~`. */
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new JsonPointerError(`Invalid escape sequence in token "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/**
+ * Resolves a JSON Pointer against a JSON document, as specified in RFC 6901
+ * (syntax: section 3, evaluation: section 4, array indices: section 4 and ABNF in section 3).
+ *
+ * The empty pointer refers to the whole document. The `-` array token refers to a nonexistent
+ * element and so does not resolve. Only own members are considered. The document is not modified.
+ *
+ * @throws {JsonPointerError} if `pointer` is not a valid JSON Pointer, or does not resolve to a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("A JSON Pointer must be a string");
+  }
+  if (pointer === "") return document;
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  const tokens = pointer.slice(1).split("/").map(unescapeToken);
+
+  let current = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new JsonPointerError(`"${token}" is not a valid array index`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new JsonPointerError(`Array index ${token} is out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new JsonPointerError(`No member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Cannot resolve "${token}" in a primitive value`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
