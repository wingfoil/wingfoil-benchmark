@@ -0,0 +1,68 @@
+/** Any value a parsed JSON document (RFC 8259) can contain. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+/** Thrown when a string is not a valid JSON Pointer or does not resolve in a document. */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Invalid JSON Pointer: must be empty or start with "/": ${pointer}`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new JsonPointerError(`Invalid JSON Pointer: "~" must be followed by 0 or 1: ${pointer}`);
+      }
+      // RFC 6901 section 4: ~1 is decoded first, then ~0.
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/**
+ * Resolves a JSON Pointer against a JSON document, as specified in RFC 6901
+ * (syntax: section 3, evaluation: section 4). The document is not modified.
+ *
+ * The empty pointer refers to the whole document. Array indexes must be "0" or
+ * digits without leading zeros; "-" (the element after the last) never resolves.
+ * Only own properties of objects are considered.
+ *
+ * @throws {JsonPointerError} if the pointer is not valid, or does not resolve to a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current: unknown = document;
+  for (const token of parsePointer(pointer)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new JsonPointerError(`Pointer does not resolve: no array element "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new JsonPointerError(`Pointer does not resolve: no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Pointer does not resolve: cannot descend into a scalar at "${token}"`);
+    }
+  }
+  return current;
+}
