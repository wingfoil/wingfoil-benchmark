@@ -0,0 +1,104 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { resolvePointer } from "../src/index.ts";
+
+// RFC 6901 section 5 example document
+const doc = JSON.parse(`{
+  "foo": ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\\\j": 5,
+  "k\\"l": 6,
+  " ": 7,
+  "m~n": 8
+}`);
+
+test("RFC 6901 section 5 examples", () => {
+  assert.strictEqual(resolvePointer(doc, ""), doc);
+  assert.deepStrictEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.strictEqual(resolvePointer(doc, "/foo/0"), "bar");
+  assert.strictEqual(resolvePointer(doc, "/"), 0);
+  assert.strictEqual(resolvePointer(doc, "/a~1b"), 1);
+  assert.strictEqual(resolvePointer(doc, "/c%d"), 2);
+  assert.strictEqual(resolvePointer(doc, "/e^f"), 3);
+  assert.strictEqual(resolvePointer(doc, "/g|h"), 4);
+  assert.strictEqual(resolvePointer(doc, "/i\\j"), 5);
+  assert.strictEqual(resolvePointer(doc, '/k"l'), 6);
+  assert.strictEqual(resolvePointer(doc, "/ "), 7);
+  assert.strictEqual(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("escape order: ~01 is the key ~1, not /", () => {
+  assert.strictEqual(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+});
+
+test("whole-document pointer works for any value", () => {
+  assert.strictEqual(resolvePointer(null, ""), null);
+  assert.strictEqual(resolvePointer(5, ""), 5);
+});
+
+test("null is a value, missing is an error", () => {
+  assert.strictEqual(resolvePointer({ a: null }, "/a"), null);
+  assert.throws(() => resolvePointer({ a: null }, "/b"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+});
+
+test("invalid pointer syntax throws", () => {
+  assert.throws(() => resolvePointer(doc, "foo"));
+  assert.throws(() => resolvePointer(doc, "~0"));
+  assert.throws(() => resolvePointer(doc, "/a~"));
+  assert.throws(() => resolvePointer(doc, "/a~2"));
+  assert.throws(() => resolvePointer(doc, "/a~b"));
+  assert.throws(() => resolvePointer(doc, undefined as unknown as string));
+  assert.throws(() => resolvePointer(doc, 1 as unknown as string));
+});
+
+test("array indexes", () => {
+  const a = [10, 20, 30];
+  assert.strictEqual(resolvePointer(a, "/0"), 10);
+  assert.strictEqual(resolvePointer(a, "/2"), 30);
+  assert.throws(() => resolvePointer(a, "/3"));
+  assert.throws(() => resolvePointer(a, "/-"));
+  assert.throws(() => resolvePointer(a, "/01"));
+  assert.throws(() => resolvePointer(a, "/+1"));
+  assert.throws(() => resolvePointer(a, "/-1"));
+  assert.throws(() => resolvePointer(a, "/1.0"));
+  assert.throws(() => resolvePointer(a, "/1e0"));
+  assert.throws(() => resolvePointer(a, "/ 1"));
+  assert.throws(() => resolvePointer(a, "/"));
+  assert.throws(() => resolvePointer(a, "/length"));
+  assert.throws(() => resolvePointer([], "/0"));
+});
+
+test("'-' and numeric tokens on objects are plain keys", () => {
+  assert.strictEqual(resolvePointer({ "-": 1, "0": 2 }, "/-"), 1);
+  assert.strictEqual(resolvePointer({ "0": 2 }, "/0"), 2);
+});
+
+test("scalars cannot be traversed", () => {
+  assert.throws(() => resolvePointer("abc", "/0"));
+  assert.throws(() => resolvePointer("abc", "/length"));
+  assert.throws(() => resolvePointer(1, "/a"));
+  assert.throws(() => resolvePointer(true, "/a"));
+});
+
+test("only own properties resolve (prototype safety)", () => {
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer({}, "/constructor"));
+  assert.throws(() => resolvePointer({}, "/constructor/prototype"));
+  assert.throws(() => resolvePointer({}, "/toString"));
+  assert.throws(() => resolvePointer([], "/constructor"));
+  const parsed = JSON.parse('{"__proto__": {"x": 1}}');
+  assert.deepStrictEqual(resolvePointer(parsed, "/__proto__"), { x: 1 });
+  assert.strictEqual(resolvePointer(parsed, "/__proto__/x"), 1);
+});
+
+test("does not mutate the document", () => {
+  const d = { a: [1, { b: 2 }] };
+  const copy = structuredClone(d);
+  resolvePointer(d, "/a/1/b");
+  assert.deepStrictEqual(d, copy);
+});
