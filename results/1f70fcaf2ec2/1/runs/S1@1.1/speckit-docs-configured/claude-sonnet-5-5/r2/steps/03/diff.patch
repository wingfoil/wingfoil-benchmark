diff --git a/src/index.ts b/src/index.ts
index d7801e215fd2a3b8a3fd246c4a997eebad227bc1..7e40b7bc871f9d878a934899a271c1b3e9422e79 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -92,8 +92,10 @@ function clone(value: unknown): JsonValue {
     if (!Number.isFinite(value)) throw new JsonPatchError("Not a JSON value: non-finite number");
     return value;
   }
-  if (Array.isArray(value)) return value.map(clone);
+  if (Array.isArray(value)) return Array.from(value, clone);
   if (typeof value === "object") {
+    const proto = Object.getPrototypeOf(value);
+    if (proto !== Object.prototype && proto !== null) throw new JsonPatchError("Not a JSON value: not a plain object");
     const copy: { [key: string]: JsonValue } = {};
     for (const key of Object.keys(value)) {
       Object.defineProperty(copy, key, {
@@ -204,14 +206,14 @@ function removeValue(document: JsonValue, tokens: string[]): JsonValue {
 export function applyPatch(document: unknown, patch: PatchOperation[]): JsonValue {
   if (!Array.isArray(patch)) throw new JsonPatchError("A JSON Patch must be an array of operations");
   let result = clone(document);
-  patch.forEach((operation: unknown, i) => {
+  for (let i = 0; i < patch.length; i++) {
     try {
-      result = applyOperation(result, operation);
+      result = applyOperation(result, patch[i]);
     } catch (e) {
       if (e instanceof JsonPatchError) throw new JsonPatchError(`Operation ${i}: ${e.message}`);
       throw e;
     }
-  });
+  }
   return result;
 }
 
diff --git a/test/patch.test.ts b/test/patch.test.ts
index 300cfd5e0d3443d2eb06fe65dc2d0e63164fc415..5bbba65ab12dea5e5ad7c668089a9d9e9d164b5f 100644
--- a/test/patch.test.ts
+++ b/test/patch.test.ts
@@ -168,3 +168,15 @@ test("prototype pollution is not possible", () => {
   assert.strictEqual(Object.getPrototypeOf(cloned), Object.prototype);
   assert.ok(Object.hasOwn(cloned, "__proto__"));
 });
+
+// RFC 6902 section 3: a patch is an array of operation objects; sparse holes are not objects
+test("a sparse patch array is invalid", () => {
+  bad({ a: 1 }, [, { op: "test", path: "/a", value: 1 }]);
+});
+test("a sparse array in a value is not a JSON value", () => {
+  bad({}, [{ op: "add", path: "/a", value: [1, , 3] }]);
+});
+test("non-plain objects are not JSON values", () => {
+  bad({}, [{ op: "add", path: "/a", value: new Date() }]);
+  bad({}, [{ op: "add", path: "/a", value: new Map() }]);
+});
