+/** Error thrown when a JSON Patch is invalid or one of its operations fails (RFC 6902). */
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+function setMember(target: object, key: string, value: unknown): void {
+  // defineProperty creates an own property even for "__proto__", so the prototype is never touched.
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
