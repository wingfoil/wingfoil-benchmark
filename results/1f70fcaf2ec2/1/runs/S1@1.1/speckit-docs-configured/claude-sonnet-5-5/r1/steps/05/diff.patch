--- a/src/index.ts
+++ b/src/index.ts
@@ -277,3 +277,100 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+/** A JSON Patch operation as produced by {@link createPatch} (RFC 6902 section 4). */
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: JsonValue }
+  | { op: "remove"; path: string };
+
+// RFC 6901 section 3: "~" is escaped as "~0" and "/" as "~1".
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Pairs of indices (into `a` and `b`) of a longest common subsequence under jsonEqual. */
+function commonIndices(a: unknown[], b: unknown[]): [number, number][] {
+  const n = a.length;
+  const m = b.length;
+  // lengths[i][j]: LCS length of a.slice(i) and b.slice(j)
+  const lengths = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lengths[i][j] = jsonEqual(a[i], b[j])
+        ? lengths[i + 1][j + 1] + 1
+        : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  const pairs: [number, number][] = [];
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (jsonEqual(a[i], b[j])) pairs.push([i++, j++]);
+    else if (lengths[i + 1][j] >= lengths[i][j + 1]) i++;
+    else j++;
+  }
+  return pairs;
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: PatchOperation[]): void {
+  // Items kept by the longest common subsequence stay untouched; each gap between kept items
+  // is patched item by item, then the surplus is removed or added. `index` is the position
+  // in the array as it stands after the operations emitted so far.
+  const kept = commonIndices(from, to);
+  kept.push([from.length, to.length]);
+  let fromPos = 0;
+  let toPos = 0;
+  let index = 0;
+  for (const [fromEnd, toEnd] of kept) {
+    const removed = fromEnd - fromPos;
+    const added = toEnd - toPos;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) {
+      diffValues(from[fromPos + k], to[toPos + k], `${path}/${index + k}`, ops);
+    }
+    index += paired;
+    for (let k = paired; k < removed; k++) ops.push({ op: "remove", path: `${path}/${index}` });
+    for (let k = paired; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${index++}`, value: clone(to[toPos + k]) as JsonValue });
+    }
+    index++; // the kept item
+    fromPos = fromEnd + 1;
+    toPos = toEnd + 1;
+  }
+}
+
+function diffValues(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    const has = (o: object, k: string) => Object.prototype.hasOwnProperty.call(o, k);
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (has(from, key)) diffValues(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: clone(to[key]) as JsonValue });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) as JsonValue });
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch is minimal in the sense of describing only what changed: objects are compared
+ * member by member (`add`, `remove`, `replace`, section 4), and arrays are compared with a
+ * longest common subsequence so that an inserted or deleted item is a single `add` or
+ * `remove` and items around it are left alone; a moved item is a `remove` plus an `add`.
+ * Equality is JSON equality (section 4.6), so member order is irrelevant. Neither input is
+ * modified and the patch shares no structure with them. Prototype keys such as `__proto__`
+ * are ordinary member names, and `~` and `/` in names are escaped as in RFC 6901 section 3.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffValues(from, to, "", ops);
+  return ops;
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eaf89ac87955a290ba1952b873c86ec462a7cfd3
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,111 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepStrictEqual(from, fromCopy);
+  assert.deepStrictEqual(to, toCopy);
+  assert.deepStrictEqual(applyPatch(from, patch), to);
+  return patch;
+};
+
+test("identical documents give an empty patch", () => {
+  assert.deepStrictEqual(roundTrip({ a: [1, { b: null }] }, { a: [1, { b: null }] }), []);
+  assert.deepStrictEqual(roundTrip({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+  assert.deepStrictEqual(roundTrip(1, 1), []);
+});
+
+test("root replacement for different types or primitives", () => {
+  assert.deepStrictEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepStrictEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  roundTrip(null, { a: 1 });
+  roundTrip([], {});
+});
+
+test("object members: add, remove, replace, nested", () => {
+  assert.deepStrictEqual(roundTrip({ a: 1, b: 2 }, { a: 1, b: 3 }), [{ op: "replace", path: "/b", value: 3 }]);
+  assert.deepStrictEqual(roundTrip({ a: 1 }, { a: 1, b: 2 }), [{ op: "add", path: "/b", value: 2 }]);
+  assert.deepStrictEqual(roundTrip({ a: 1, b: 2 }, { a: 1 }), [{ op: "remove", path: "/b" }]);
+  assert.deepStrictEqual(
+    roundTrip({ big: { x: { y: 1, z: [1, 2] }, w: "same" } }, { big: { x: { y: 2, z: [1, 2] }, w: "same" } }),
+    [{ op: "replace", path: "/big/x/y", value: 2 }],
+  );
+});
+
+test("null versus missing", () => {
+  assert.deepStrictEqual(roundTrip({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+  assert.deepStrictEqual(roundTrip({}, { a: null }), [{ op: "add", path: "/a", value: null }]);
+  assert.deepStrictEqual(roundTrip({ a: null }, {}), [{ op: "remove", path: "/a" }]);
+});
+
+test("pointer escaping and prototype keys", () => {
+  assert.deepStrictEqual(roundTrip({ "a/b": 1, "m~n": 1, "": 1 }, { "a/b": 2, "m~n": 2, "": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/m~0n", value: 2 },
+    { op: "replace", path: "/", value: 2 },
+  ]);
+  const to = JSON.parse('{"__proto__": {"x": 1}, "constructor": 2}');
+  const patch = roundTrip({}, to);
+  assert.strictEqual(patch.length, 2);
+  assert.strictEqual(({} as Record<string, unknown>).x, undefined);
+  roundTrip(JSON.parse('{"__proto__": 1}'), JSON.parse('{"__proto__": 2}'));
+});
+
+test("array item added or removed leaves neighbours alone", () => {
+  assert.deepStrictEqual(roundTrip([1, 2, 3], [1, 2, 9, 3]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepStrictEqual(roundTrip([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+  assert.deepStrictEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepStrictEqual(roundTrip([0, 1], [1]), [{ op: "remove", path: "/0" }]);
+  assert.deepStrictEqual(roundTrip([{ id: 1 }, { id: 2 }], [{ id: 0 }, { id: 1 }, { id: 2 }]), [
+    { op: "add", path: "/0", value: { id: 0 } },
+  ]);
+  assert.deepStrictEqual(roundTrip([1, 1, 1], [1, 1]), [{ op: "remove", path: "/2" }]);
+  roundTrip([], [1, 2]);
+  roundTrip([1, 2], []);
+});
+
+test("array item changed in place is patched, not replaced", () => {
+  assert.deepStrictEqual(roundTrip([{ a: 1, b: 2 }, 5], [{ a: 1, b: 3 }, 5]), [
+    { op: "replace", path: "/0/b", value: 3 },
+  ]);
+});
+
+test("array item moved does not rewrite items in between", () => {
+  const patch = roundTrip(["a", "b", "c", "d", "e"], ["b", "c", "d", "e", "a"]);
+  assert.ok(patch.length <= 2);
+  assert.ok(patch.every((o: { op: string }) => ["move", "add", "remove"].includes(o.op)));
+  const patch2 = roundTrip([{ id: 1 }, { id: 2 }, { id: 3 }, { id: 4 }], [{ id: 1 }, { id: 4 }, { id: 2 }, { id: 3 }]);
+  assert.ok(patch2.length <= 2);
+});
+
+test("patch does not share structure with inputs", () => {
+  const to = { a: { b: [1] } };
+  const patch = createPatch({}, to) as { value: { b: number[] } }[];
+  patch[0].value.b.push(2);
+  assert.deepStrictEqual(to, { a: { b: [1] } });
+});
+
+test("mixed changes round trip", () => {
+  roundTrip(
+    { list: [1, 2, 3, 4, 5], o: { k: [{ a: 1 }, { a: 2 }], gone: true }, s: "x" },
+    { list: [5, 1, 2, 9, 4], o: { k: [{ a: 2 }, { a: 1, c: 0 }], new: [] }, s: "y" },
+  );
+});
+
+test("randomised round trips", () => {
+  let seed = 12345;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff), seed % n);
+  const gen = (d: number): unknown => {
+    const t = rnd(d > 2 ? 4 : 6);
+    if (t === 0) return rnd(3);
+    if (t === 1) return null;
+    if (t === 2) return "s" + rnd(2);
+    if (t === 3) return rnd(2) === 0;
+    if (t === 4) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let i = 0; i < 500; i++) roundTrip(gen(0), gen(0));
+});
