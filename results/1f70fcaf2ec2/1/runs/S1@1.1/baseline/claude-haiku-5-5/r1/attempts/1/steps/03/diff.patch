+
+test("rejects patch values that are not JSON, whatever the operation", () => {
+  const values = [undefined, NaN, Infinity, () => 1, Symbol("s"), 1n, new Date(0), new Map(), new (class A {})(), [1, , 2], { a: undefined }];
+  for (const value of values) {
+    for (const op of [{ op: "add", path: "/b", value }, { op: "replace", path: "/a", value }, { op: "test", path: "/a", value }]) {
+      assert.throws(() => applyPatch({ a: 1 }, [op]), JsonPatchError, String(value));
+    }
+    assert.throws(() => applyPatch({ a: [] }, [{ op: "add", path: "/a/-", value }]), JsonPatchError, String(value));
+  }
+});
+
+test("rejects a document that is not JSON with a JsonPatchError", () => {
+  for (const document of [undefined, { f: () => 1 }, { d: new Date(0) }, { a: NaN }]) {
+    assert.throws(() => applyPatch(document, []), JsonPatchError);
+    assert.throws(() => applyPatch(document, [{ op: "add", path: "/b", value: 1 }]), JsonPatchError);
+  }
+});
+
