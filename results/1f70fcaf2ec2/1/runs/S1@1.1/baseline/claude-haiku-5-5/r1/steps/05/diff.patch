@@ -0,0 +1,170 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch, createPatch, type JsonPatch, type JsonValue } from '../src/index.ts';
+
+function roundTrip(from: JsonValue, to: JsonValue): JsonPatch {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test('equal documents give an empty patch', () => {
+  assert.deepEqual(createPatch({ a: [1, { b: null }] }, { a: [1, { b: null }] }), []);
+  assert.deepEqual(createPatch({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+  assert.deepEqual(createPatch(1, 1), []);
+});
+
+test('a changed primitive is a single replace of that member', () => {
+  assert.deepEqual(createPatch({ a: { b: 1, c: 2 } }, { a: { b: 1, c: 3 } }), [
+    { op: 'replace', path: '/a/c', value: 3 },
+  ]);
+});
+
+test('an added or removed member is a single add or remove', () => {
+  assert.deepEqual(createPatch({ a: 1 }, { a: 1, b: [2] }), [{ op: 'add', path: '/b', value: [2] }]);
+  assert.deepEqual(createPatch({ a: 1, b: 2 }, { a: 1 }), [{ op: 'remove', path: '/b' }]);
+});
+
+test('a change of type replaces the whole value, including the document', () => {
+  assert.deepEqual(createPatch({ a: [1] }, { a: { b: 1 } }), [{ op: 'replace', path: '/a', value: { b: 1 } }]);
+  assert.deepEqual(createPatch({ a: 1 }, [1]), [{ op: 'replace', path: '', value: [1] }]);
+  assert.deepEqual(createPatch(null, 'x'), [{ op: 'replace', path: '', value: 'x' }]);
+});
+
+test('an array item inserted in the middle is a single add, and the items around it are not rewritten', () => {
+  const from = { list: ['a', 'b', 'c', 'd'] };
+  assert.deepEqual(createPatch(from, { list: ['a', 'b', 'x', 'c', 'd'] }), [
+    { op: 'add', path: '/list/2', value: 'x' },
+  ]);
+});
+
+test('an array item appended or prepended is a single add', () => {
+  assert.deepEqual(createPatch({ list: [1, 2] }, { list: [1, 2, 3] }), [{ op: 'add', path: '/list/2', value: 3 }]);
+  assert.deepEqual(createPatch({ list: [1, 2] }, { list: [0, 1, 2] }), [{ op: 'add', path: '/list/0', value: 0 }]);
+});
+
+test('an array item removed is a single remove', () => {
+  assert.deepEqual(createPatch({ list: ['a', 'b', 'c'] }, { list: ['a', 'c'] }), [
+    { op: 'remove', path: '/list/1' },
+  ]);
+  assert.deepEqual(createPatch({ list: [1, 2, 3] }, { list: [2, 3] }), [{ op: 'remove', path: '/list/0' }]);
+});
+
+test('an array item moved forward or backward is a single move', () => {
+  assert.deepEqual(createPatch({ list: ['a', 'b', 'c', 'd'] }, { list: ['b', 'c', 'd', 'a'] }), [
+    { op: 'move', from: '/list/0', path: '/list/3' },
+  ]);
+  assert.deepEqual(createPatch({ list: ['a', 'b', 'c', 'd'] }, { list: ['d', 'a', 'b', 'c'] }), [
+    { op: 'move', from: '/list/3', path: '/list/0' },
+  ]);
+});
+
+test('an array item that moved with its contents changed is a single change of its contents', () => {
+  const patch = roundTrip({ list: [{ id: 1 }, { id: 2 }, { id: 3 }] }, { list: [{ id: 2 }, { id: 3 }, { id: 4 }] });
+  assert.equal(patch.length, 2);
+});
+
+test('a change inside an item of a long array is a single replace of that field', () => {
+  const from = { items: Array.from({ length: 1000 }, (_, i) => ({ id: i, name: `item ${i}`, tags: ['x'] })) };
+  const to = structuredClone(from);
+  to.items[500].name = 'changed';
+  assert.deepEqual(createPatch(from, to), [{ op: 'replace', path: '/items/500/name', value: 'changed' }]);
+});
+
+test('a single change in a long array of numbers gives a single operation', () => {
+  const from = Array.from({ length: 20000 }, (_, i) => i);
+  const to = [...from.slice(0, 12000), 'changed', ...from.slice(12001)];
+  assert.deepEqual(createPatch(from, to), [{ op: 'replace', path: '/12000', value: 'changed' }]);
+});
+
+test('pointer characters in member names are escaped', () => {
+  assert.deepEqual(createPatch({ 'a/b': 1, 'c~d': 1 }, { 'a/b': 2, 'c~d': 2 }), [
+    { op: 'replace', path: '/a~1b', value: 2 },
+    { op: 'replace', path: '/c~0d', value: 2 },
+  ]);
+});
+
+test('the patch turns the document into the target in all the cases above', () => {
+  roundTrip({ a: [1, 2, 3], b: { c: 'd' } }, { a: [3, 2, 1, 4], b: null });
+  roundTrip([[1, 2], [3]], [[3], [1, 2], []]);
+  roundTrip({ a: [] }, { a: [[], {}] });
+});
+
+test('neither input is mutated, and the patch shares no structure with them', () => {
+  const from: JsonValue = { list: [{ id: 1 }], other: { x: [1] } };
+  const to: JsonValue = { list: [{ id: 1 }, { id: 2, extra: [3] }], other: { x: [1, 2] } };
+  const fromSnapshot = structuredClone(from);
+  const toSnapshot = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, fromSnapshot);
+  assert.deepEqual(to, toSnapshot);
+  const added = patch[0] as unknown as { value: { extra: number[] } };
+  added.value.extra.push(99);
+  assert.deepEqual(to, toSnapshot);
+});
+
+test('rejects values that are not JSON values', () => {
+  assert.throws(() => createPatch(undefined as unknown as JsonValue, 1), TypeError);
+  assert.throws(() => createPatch({}, { a: NaN }), TypeError);
+  assert.throws(() => createPatch([1], [() => 1] as unknown as JsonValue), TypeError);
+});
+
+test('random documents round-trip, with and without small changes', () => {
+  let seed = 12345;
+  const random = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  const randomValue = (depth: number): JsonValue => {
+    const kind = random(depth > 2 ? 4 : 6);
+    switch (kind) {
+      case 0:
+        return random(5);
+      case 1:
+        return `s${random(4)}`;
+      case 2:
+        return random(2) === 0;
+      case 3:
+        return null;
+      case 4:
+        return Array.from({ length: random(6) }, () => randomValue(depth + 1));
+      default:
+        return Object.fromEntries(
+          Array.from({ length: random(4) }, () => [`k${random(4)}`, randomValue(depth + 1)]),
+        );
+    }
+  };
+  // Changes a few random places of a document, which shuffles, inserts, removes and edits items.
+  const mutate = (value: JsonValue, depth: number): JsonValue => {
+    if (Array.isArray(value)) {
+      const copy = value.map((item) => mutate(item, depth + 1));
+      const edits = random(3);
+      for (let e = 0; e < edits; e++) {
+        const action = random(4);
+        const at = random(copy.length + 1);
+        if (action === 0) copy.splice(at, 0, randomValue(depth + 1));
+        else if (action === 1 && copy.length > 0) copy.splice(Math.min(at, copy.length - 1), 1);
+        else if (action === 2 && copy.length > 1) {
+          const [item] = copy.splice(random(copy.length), 1);
+          copy.splice(random(copy.length + 1), 0, item);
+        }
+      }
+      return copy;
+    }
+    if (value !== null && typeof value === 'object') {
+      const copy: Record<string, JsonValue> = {};
+      for (const [key, item] of Object.entries(value)) {
+        if (random(5) !== 0) copy[key] = mutate(item, depth + 1);
+      }
+      if (random(3) === 0) copy[`k${random(4)}`] = randomValue(depth + 1);
+      return copy;
+    }
+    return random(4) === 0 ? randomValue(depth) : value;
+  };
+
+  for (let i = 0; i < 2000; i++) {
+    const from = randomValue(0);
+    roundTrip(from, randomValue(0));
+    roundTrip(from, mutate(from, 0));
+  }
+});
