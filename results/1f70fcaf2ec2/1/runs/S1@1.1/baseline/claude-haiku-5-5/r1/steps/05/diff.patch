+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch describes only what changed: a member that is added, removed or changed is one operation, and
+ * unchanged parts are left out. In an array, an added or removed item is an `add` or `remove` of that item,
+ * and an item that moved is a `move`, so the items around it are not rewritten.
+ *
+ * Neither input is mutated, and the patch does not share structure with either of them.
+ *
+ * Throws when `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatch {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new TypeError('A JSON Patch can only be created between JSON values');
+  }
+  const patch: JsonPatch = [];
+  diffValues('', from, to, patch);
+  return patch;
+}
+
+/**
+ * Appends to `patch` the operations that turn `from`, the value at `path`, into `to`.
+ */
+function diffValues(path: string, from: JsonValue, to: JsonValue, patch: JsonPatch): void {
+  if (jsonEquals(from, to)) {
+    return;
+  }
+  if (isObject(from) && isObject(to)) {
+    diffObjects(path, from, to, patch);
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(path, from, to, patch);
+  } else {
+    patch.push({ op: 'replace', path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Appends to `patch` the operations that turn the object `from`, the value at `path`, into `to`.
+ */
+function diffObjects(
+  path: string,
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  patch: JsonPatch,
+): void {
+  const has = (object: object, key: string) => Object.prototype.hasOwnProperty.call(object, key);
+  for (const key of Object.keys(from)) {
+    if (!has(to, key)) {
+      patch.push({ op: 'remove', path: memberPath(path, key) });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (!has(from, key)) {
+      patch.push({ op: 'add', path: memberPath(path, key), value: structuredClone(to[key]) });
+    }
+  }
+  for (const key of Object.keys(from)) {
+    if (has(to, key)) {
+      diffValues(memberPath(path, key), from[key], to[key], patch);
+    }
+  }
+}
+
+/**
+ * An item of an array while `diffArrays` simulates the patch on it: its value, the index it must end up at
+ * (when it is kept or moved), and whether it is moved there rather than kept in order with the other items.
+ */
+type ArrayItem = { value: JsonValue; target?: number; moved: boolean };
+
+/**
+ * Appends to `patch` the operations that turn the array `from`, the value at `path`, into `to`.
+ *
+ * The items of `from` that are kept are a longest common subsequence of the two arrays, so they stay in
+ * their order and are not touched. Each other item of `from` is moved to its place in `to` when an equal item
+ * is needed there, and removed otherwise. Each other item of `to` is added, except where it takes the place of
+ * a removed item, which is then changed in place (diffed further when both are objects or arrays).
+ *
+ * The operations are generated by simulating them on a working copy of `from`, so that each index is the index
+ * of its item at the moment the operation applies.
+ */
+function diffArrays(path: string, from: JsonValue[], to: JsonValue[], patch: JsonPatch): void {
+  const fromKeys = from.map(canonicalKey);
+  const toKeys = to.map(canonicalKey);
+  const items: ArrayItem[] = from.map((value) => ({ value, moved: false }));
+  const placed = to.map(() => false);
+
+  for (const [i, j] of longestCommonSubsequence(fromKeys, toKeys)) {
+    items[i].target = j;
+    placed[j] = true;
+  }
+  const unplacedTo = new Map<string, number[]>();
+  toKeys.forEach((key, j) => {
+    if (!placed[j]) {
+      const indices = unplacedTo.get(key);
+      if (indices) {
+        indices.push(j);
+      } else {
+        unplacedTo.set(key, [j]);
+      }
+    }
+  });
+  items.forEach((item, i) => {
+    const j = item.target === undefined ? unplacedTo.get(fromKeys[i])?.shift() : undefined;
+    if (j !== undefined) {
+      item.target = j;
+      item.moved = true;
+      placed[j] = true;
+    }
+  });
+
+  const indexPath = (index: number) => memberPath(path, String(index));
+  const move = (source: number, destination: number) => {
+    patch.push({ op: 'move', from: indexPath(source), path: indexPath(destination) });
+    const [item] = items.splice(source, 1);
+    items.splice(destination, 0, item);
+  };
+
+  // Invariant: the first `index` items of the working copy are the first `index` items of `to`.
+  let index = 0;
+  while (index < to.length) {
+    if (index < items.length && items[index].target === index) {
+      index++;
+    } else if (placed[index]) {
+      // The item that belongs here is further along. Clear out the item in the way, or bring the one that
+      // belongs here forward. A moved item in the way is moved to the end, where it stays out of the way.
+      const item = items[index];
+      if (item.target === undefined) {
+        patch.push({ op: 'remove', path: indexPath(index) });
+        items.splice(index, 1);
+      } else if (item.moved) {
+        move(index, items.length - 1);
+      } else {
+        move(items.findIndex((other) => other.target === index), index);
+      }
+    } else if (index < items.length && items[index].target === undefined) {
+      // A removed item is where an added one belongs: change it in place.
+      const item = items[index];
+      diffValues(indexPath(index), item.value, to[index], patch);
+      item.target = index;
+      placed[index] = true;
+      index++;
+    } else {
+      patch.push({ op: 'add', path: indexPath(index), value: structuredClone(to[index]) });
+      items.splice(index, 0, { value: to[index], target: index, moved: false });
+      placed[index] = true;
+      index++;
+    }
+  }
+  while (items.length > to.length) {
+    patch.push({ op: 'remove', path: indexPath(items.length - 1) });
+    items.pop();
+  }
+}
+
+/**
+ * Returns the JSON Pointer of the member `key` of the value at `path`.
+ */
+function memberPath(path: string, key: string): string {
+  return `${path}/${key.replace(/~/g, '~0').replace(/\//g, '~1')}`;
+}
+
+/**
+ * Returns a string that is the same for two JSON values exactly when they are equal, as RFC 6902 section 4.6
+ * defines equality: object members are sorted by name.
+ */
+function canonicalKey(value: JsonValue): string {
+  if (Array.isArray(value)) {
+    return `[${value.map(canonicalKey).join(',')}]`;
+  }
+  if (isObject(value)) {
+    const members = Object.keys(value)
+      .sort()
+      .map((key) => `${JSON.stringify(key)}:${canonicalKey(value[key])}`);
+    return `{${members.join(',')}}`;
+  }
+  return JSON.stringify(value);
+}
+
+/**
+ * Returns the pairs `[i, j]` of a longest common subsequence of `a` and `b`, in increasing order.
+ */
+function longestCommonSubsequence(a: string[], b: string[]): [number, number][] {
+  // A common prefix or suffix belongs to some longest common subsequence, so it is taken off first.
+  let start = 0;
+  while (start < a.length && start < b.length && a[start] === b[start]) {
+    start++;
+  }
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && a[endA - 1] === b[endB - 1]) {
+    endA--;
+    endB--;
+  }
+  const pairs: [number, number][] = [];
+  for (let i = 0; i < start; i++) {
+    pairs.push([i, i]);
+  }
+  for (const [i, j] of myersMatches(a.slice(start, endA), b.slice(start, endB))) {
+    pairs.push([i + start, j + start]);
+  }
+  for (let i = endA; i < a.length; i++) {
+    pairs.push([i, i - endA + endB]);
+  }
+  return pairs;
+}
+
+/**
+ * Returns the matched pairs of a longest common subsequence of `a` and `b`, using Myers' O((n + m)·d)
+ * algorithm, where d is the number of differences, so that a small change to a long array is cheap.
+ */
+function myersMatches(a: string[], b: string[]): [number, number][] {
+  const n = a.length;
+  const m = b.length;
+  const offset = n + m + 1;
+  // `v[offset + k]` is the furthest x reached on diagonal k (where k = x - y) after the current round.
+  const v = new Int32Array(2 * (n + m) + 3);
+  // `snapshots[d]` holds the values of `v` for diagonals -d to d, after round d, at index `k + d`.
+  const snapshots: Int32Array[] = [];
+  for (let d = 0; ; d++) {
+    for (let k = -d; k <= d; k += 2) {
+      const down = k === -d || (k !== d && v[offset + k - 1] < v[offset + k + 1]);
+      let x = down ? v[offset + k + 1] : v[offset + k - 1] + 1;
+      let y = x - k;
+      while (x < n && y < m && a[x] === b[y]) {
+        x++;
+        y++;
+      }
+      v[offset + k] = x;
+      if (x >= n && y >= m) {
+        return backtrackMatches(snapshots, d, n, m);
+      }
+    }
+    snapshots.push(v.slice(offset - d, offset + d + 1));
+  }
+}
+
+/**
+ * Walks back through the rounds of `myersMatches`, from the end of both arrays, and returns the matched pairs.
+ */
+function backtrackMatches(snapshots: Int32Array[], rounds: number, n: number, m: number): [number, number][] {
+  const pairs: [number, number][] = [];
+  let x = n;
+  let y = m;
+  for (let d = rounds; d > 0; d--) {
+    const previous = snapshots[d - 1];
+    const at = (k: number) => previous[k + d - 1];
+    const k = x - y;
+    const down = k === -d || (k !== d && at(k - 1) < at(k + 1));
+    const previousK = down ? k + 1 : k - 1;
+    const previousX = at(previousK);
+    // The edit of this round goes from (previousX, previousY) to the middle point; the rest is a diagonal.
+    const middleX = down ? previousX : previousX + 1;
+    const middleY = middleX - k;
+    while (x > middleX && y > middleY) {
+      pairs.push([x - 1, y - 1]);
+      x--;
+      y--;
+    }
+    x = previousX;
+    y = previousX - previousK;
+  }
+  while (x > 0 && y > 0) {
+    pairs.push([x - 1, y - 1]);
+    x--;
+    y--;
+  }
+  return pairs.reverse();
+}
