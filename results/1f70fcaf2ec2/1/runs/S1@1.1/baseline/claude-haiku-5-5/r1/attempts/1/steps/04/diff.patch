+/**
+ * JSON Merge Patch (RFC 7386): a partial update, written as a document shaped like the target. Object members
+ * are merged recursively, a `null` member removes the member of the target, and any other value, including an
+ * array, replaces the target value as a whole.
+ */
+
+/**
+ * Applies a JSON Merge Patch to `target`, and returns the merged document. `target` is not modified: the result
+ * is a new value that shares no object with either input.
+ *
+ * @throws {JsonPatchError} if `target` or `patch` is not JSON.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJson(target, "document");
+  assertJson(patch, "merge patch");
+
+  // The merge changes the copy in place, so the input survives.
+  return mergeInto(structuredClone(target), patch);
+}
+
+/** Merges `patch` into `target`, which it may change in place, and returns the merged value. */
+function mergeInto(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return structuredClone(patch);
+  }
+
+  // A patch object applied to a value that is not an object starts from an empty object.
+  const result: Record<string, unknown> = isObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = (patch as Record<string, unknown>)[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = Object.hasOwn(result, key) ? result[key] : undefined;
+      defineMember(result, key, mergeInto(current, value));
+    }
+  }
+  return result;
+}
+
+/** True for a JSON object, which is neither null nor an array. */
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
