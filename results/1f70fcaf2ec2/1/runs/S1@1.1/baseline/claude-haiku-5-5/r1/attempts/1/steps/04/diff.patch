@@ -0,0 +1,60 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+// Examples from RFC 7386, appendix A.
+test("replaces and adds members", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: "c" }), { a: "c" });
+  assert.deepEqual(applyMergePatch({ a: "b" }, { b: "c" }), { a: "b", b: "c" });
+});
+
+test("removes members set to null", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: null }), {});
+  assert.deepEqual(applyMergePatch({ a: "b", b: "c" }, { a: null }), { b: "c" });
+  assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+});
+
+test("replaces arrays as a whole", () => {
+  assert.deepEqual(applyMergePatch({ a: ["b"] }, { a: "c" }), { a: "c" });
+  assert.deepEqual(applyMergePatch({ a: "c" }, { a: ["b"] }), { a: ["b"] });
+  assert.deepEqual(applyMergePatch({ a: [{ b: "c" }] }, { a: [1] }), { a: [1] });
+  assert.deepEqual(applyMergePatch(["a", "b"], ["c", "d"]), ["c", "d"]);
+  assert.deepEqual(applyMergePatch({ a: "b" }, ["c"]), ["c"]);
+});
+
+test("merges nested objects recursively", () => {
+  assert.deepEqual(applyMergePatch({ a: { b: "c" } }, { a: { b: "d", c: null } }), { a: { b: "d" } });
+  assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+});
+
+test("replaces the whole document when the patch is not an object", () => {
+  assert.equal(applyMergePatch({ a: "foo" }, null), null);
+  assert.equal(applyMergePatch({ a: "foo" }, "bar"), "bar");
+});
+
+test("treats a non-object target as an empty object when the patch is an object", () => {
+  assert.deepEqual(applyMergePatch([1, 2], { a: "b", c: null }), { a: "b" });
+  assert.deepEqual(applyMergePatch("text", { a: 1 }), { a: 1 });
+});
+
+test("sets a __proto__ member as an ordinary member", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__": {"x": 1}}'));
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.equal(({}).x, undefined);
+});
+
+test("does not modify its inputs or share objects with them", () => {
+  const target = { a: { b: "c" } };
+  const patch = { d: { e: [1] } };
+  const result = applyMergePatch(target, patch);
+
+  assert.deepEqual(target, { a: { b: "c" } });
+  assert.deepEqual(patch, { d: { e: [1] } });
+  result.d.e.push(2);
+  assert.deepEqual(patch, { d: { e: [1] } });
+});
+
+test("rejects values that are not JSON", () => {
+  assert.throws(() => applyMergePatch({}, { a: undefined }));
+  assert.throws(() => applyMergePatch({ a: NaN }, {}));
+});
