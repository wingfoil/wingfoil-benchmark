+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the resulting document.
+ *
+ * An object patch merges into the target member by member: a `null` member removes the member from the
+ * target, and any other member is merged recursively. A patch that is not an object replaces the target
+ * entirely. The input is not mutated: the merge is applied to a copy of `target`, and the copy is returned.
+ *
+ * Throws when `patch` is not a JSON value.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonValue(patch)) {
+    throw new TypeError('A JSON Merge Patch must be a JSON value');
+  }
+  return mergeValue(structuredClone(target), patch);
+}
+
+/**
+ * Merges `patch` into `target`, which it may modify, and returns the result. A `target` that is not an
+ * object is treated as an empty object when `patch` is an object, as RFC 7386 requires.
+ */
+function mergeValue(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result = isObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = Object.prototype.hasOwnProperty.call(result, key) ? result[key] : undefined;
+      setMember(result, key, mergeValue(current, value));
+    }
+  }
+  return result;
+}
+
 /**
