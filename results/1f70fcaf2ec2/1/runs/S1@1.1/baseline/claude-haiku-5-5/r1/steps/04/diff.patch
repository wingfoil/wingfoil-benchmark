+++ b/test/merge-patch.test.ts
@@ -0,0 +1,56 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyMergePatch, type JsonValue } from '../src/index.ts';
+
+// The examples of RFC 7386, section 3.
+test('RFC 7386 examples', () => {
+  const cases: [JsonValue, JsonValue, JsonValue][] = [
+    [{ a: 'b' }, { a: 'c' }, { a: 'c' }],
+    [{ a: 'b' }, { b: 'c' }, { a: 'b', b: 'c' }],
+    [{ a: 'b' }, { a: null }, {}],
+    [{ a: 'b', b: 'c' }, { a: null }, { b: 'c' }],
+    [{ a: ['b'] }, { a: 'c' }, { a: 'c' }],
+    [{ a: 'c' }, { a: ['b'] }, { a: ['b'] }],
+    [{ a: { b: 'c' } }, { a: { b: 'd', c: null } }, { a: { b: 'd' } }],
+    [{ a: [{ b: 'c' }] }, { a: [1] }, { a: [1] }],
+    [['a', 'b'], ['c', 'd'], ['c', 'd']],
+    [{ a: 'b' }, ['c'], ['c']],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: 'b', c: null }, { a: 'b' }],
+    [{}, { a: { bb: { c: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test('a non-object target is replaced by an object when the patch is an object', () => {
+  assert.deepEqual(applyMergePatch('x', { a: 1 }), { a: 1 });
+  assert.deepEqual(applyMergePatch(null, { a: { b: 1 } }), { a: { b: 1 } });
+});
+
+test('a null patch replaces the target', () => {
+  assert.equal(applyMergePatch({ a: 1 }, null), null);
+});
+
+test('a "__proto__" member is merged as an ordinary member', () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}}') as JsonValue;
+  const result = applyMergePatch({}, patch) as Record<string, JsonValue>;
+  assert.deepEqual(Object.keys(result), ['__proto__']);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test('the inputs are not mutated and the result shares no structure with them', () => {
+  const target = { a: { b: 1 } };
+  const patch = { a: { c: { d: 2 } } };
+  const result = applyMergePatch(target, patch) as { a: { b: number; c: { d: number } } };
+  assert.deepEqual(target, { a: { b: 1 } });
+  assert.deepEqual(patch, { a: { c: { d: 2 } } });
+  result.a.c.d = 3;
+  assert.deepEqual(patch, { a: { c: { d: 2 } } });
+});
+
+test('a patch that is not a JSON value is rejected', () => {
+  assert.throws(() => applyMergePatch({}, { a: undefined } as unknown as JsonValue), TypeError);
+  assert.throws(() => applyMergePatch({}, { a: NaN } as unknown as JsonValue), TypeError);
+});
