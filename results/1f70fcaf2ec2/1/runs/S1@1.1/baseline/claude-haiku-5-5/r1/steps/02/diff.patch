+/**
+ * An operation of a JSON Patch, as defined by RFC 6902, section 4.
+ */
+export type JsonPatchOperation =
+  | { op: 'add' | 'replace' | 'test'; path: string; value: JsonValue }
+  | { op: 'remove'; path: string }
+  | { op: 'move' | 'copy'; path: string; from: string };
+
+/**
+ * A JSON Patch, as defined by RFC 6902: a sequence of operations applied in order.
+ */
+export type JsonPatch = JsonPatchOperation[];
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the resulting document.
+ *
+ * The input is not mutated: the patch is applied to a copy of `document`, and the copy is returned.
+ *
+ * Throws when `patch` is not a valid JSON Patch, or when one of its operations fails. In that case no
+ * part of `document` has been changed.
+ */
+export function applyPatch(document: JsonValue, patch: JsonPatch): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new TypeError('A JSON Patch must be an array of operations');
+  }
+  // Validate every operation before applying any, so that a malformed patch is reported as such.
+  const operations = Array.from(patch, validateOperation);
+  let result = structuredClone(document);
+  for (const operation of operations) {
+    result = applyOperation(result, operation);
+  }
+  return result;
+}
+
+/**
+ * Checks that `operation` is a well-formed JSON Patch operation, and returns it typed as such.
+ */
+function validateOperation(operation: unknown, index: number): JsonPatchOperation {
+  const at = `operation ${index}`;
+  if (typeof operation !== 'object' || operation === null || Array.isArray(operation)) {
+    throw new TypeError(`Invalid JSON Patch: ${at} must be an object`);
+  }
+  const members = operation as Record<string, unknown>;
+  const has = (name: string) => Object.prototype.hasOwnProperty.call(members, name);
+  if (typeof members.path !== 'string') {
+    throw new TypeError(`Invalid JSON Patch: ${at} must have a string "path"`);
+  }
+  parsePointer(members.path);
+  switch (members.op) {
+    case 'add':
+    case 'replace':
+    case 'test':
+      if (!has('value')) {
+        throw new TypeError(`Invalid JSON Patch: ${at} ("${members.op}") must have a "value"`);
+      }
+      return operation as JsonPatchOperation;
+    case 'remove':
+      return operation as JsonPatchOperation;
+    case 'move':
+    case 'copy':
+      if (typeof members.from !== 'string') {
+        throw new TypeError(`Invalid JSON Patch: ${at} ("${members.op}") must have a string "from"`);
+      }
+      parsePointer(members.from);
+      return operation as JsonPatchOperation;
+    default:
+      throw new TypeError(`Invalid JSON Patch: ${at} has an unknown "op" ${JSON.stringify(members.op)}`);
+  }
+}
+
+/**
+ * Applies one validated operation to `document`, which it may modify, and returns the resulting document.
+ */
+function applyOperation(document: JsonValue, operation: JsonPatchOperation): JsonValue {
+  const { path } = operation;
+  switch (operation.op) {
+    case 'add':
+      return addValue(document, path, structuredClone(operation.value));
+    case 'remove':
+      return removeValue(document, path).document;
+    case 'replace':
+      if (path === '') {
+        return structuredClone(operation.value);
+      }
+      replaceValue(document, path, structuredClone(operation.value));
+      return document;
+    case 'move': {
+      const { from } = operation;
+      if (path.startsWith(`${from}/`)) {
+        throw new RangeError(`Cannot move ${JSON.stringify(from)} into one of its children ${JSON.stringify(path)}`);
+      }
+      const removed = removeValue(document, from);
+      return addValue(removed.document, path, removed.value);
+    }
+    case 'copy':
+      return addValue(document, path, structuredClone(resolvePointer(document, operation.from)));
+    case 'test':
+      if (!jsonEquals(resolvePointer(document, path), operation.value)) {
+        throw new Error(`Test operation failed: the value at ${JSON.stringify(path)} is not the expected value`);
+      }
+      return document;
+  }
+}
+
+/**
+ * Adds `value` at `pointer` in `document`, which it may modify, and returns the resulting document.
+ */
+function addValue(document: JsonValue, pointer: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const token = tokens.pop() as string;
+  const parent = tokens.reduce((current, t) => child(current, t, pointer), document);
+  if (Array.isArray(parent)) {
+    if (token === '-') {
+      parent.push(value);
+      return document;
+    }
+    if (!ARRAY_INDEX.test(token) || Number(token) > parent.length) {
+      throw new RangeError(`JSON Pointer ${JSON.stringify(pointer)} does not resolve: cannot insert at index "${token}"`);
+    }
+    parent.splice(Number(token), 0, value);
+    return document;
+  }
+  if (isObject(parent)) {
+    setMember(parent, token, value);
+    return document;
+  }
+  throw new RangeError(`JSON Pointer ${JSON.stringify(pointer)} does not resolve: "${token}" applied to a primitive value`);
+}
+
+/**
+ * Replaces the existing value at `pointer` (which must not be the whole document) in `document`, which it
+ * may modify.
+ */
+function replaceValue(document: JsonValue, pointer: string, value: JsonValue): void {
+  const tokens = parsePointer(pointer);
+  const token = tokens.pop() as string;
+  const parent = tokens.reduce((current, t) => child(current, t, pointer), document);
+  child(parent, token, pointer); // Throws when there is no value to replace.
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else if (isObject(parent)) {
+    setMember(parent, token, value);
+  }
+}
+
+/**
+ * Removes the value at `pointer` from `document`, which it may modify. Returns the resulting document and
+ * the removed value.
+ */
+function removeValue(document: JsonValue, pointer: string): { document: JsonValue; value: JsonValue } {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    throw new RangeError('Cannot remove the whole document');
+  }
+  const token = tokens.pop() as string;
+  const parent = tokens.reduce((current, t) => child(current, t, pointer), document);
+  const value = child(parent, token, pointer);
+  if (Array.isArray(parent)) {
+    parent.splice(Number(token), 1);
+  } else if (isObject(parent)) {
+    delete parent[token];
+  }
+  return { document, value };
+}
+
+/**
+ * Sets the own member `key` of `object` to `value`. Uses a property definition rather than an assignment,
+ * so that a key such as "__proto__" becomes an ordinary member.
+ */
+function setMember(object: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function isObject(value: JsonValue): value is { [key: string]: JsonValue } {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+/**
+ * Compares two JSON values for equality, as RFC 6902 section 4.6 defines it: objects are equal when they
+ * have the same members with equal values, regardless of order; arrays are equal when their elements are
+ * equal in order.
+ */
+function jsonEquals(a: JsonValue, b: JsonValue): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) &&
+      Array.isArray(b) &&
+      a.length === b.length &&
+      a.every((item, i) => jsonEquals(item, b[i]))
+    );
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.prototype.hasOwnProperty.call(b, key) && jsonEquals(a[key], b[key]))
+    );
+  }
+  return false;
+}
+
 /**
  * Returns the member of `parent` designated by `token`.
  */
diff --git a/test/apply-patch.test.ts b/test/apply-patch.test.ts
