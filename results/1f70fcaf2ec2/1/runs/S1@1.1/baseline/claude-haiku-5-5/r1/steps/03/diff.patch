+  switch (typeof value) {
+    case 'boolean':
+    case 'string':
+      return true;
+    case 'number':
+      return Number.isFinite(value);
+    case 'object':
+      break;
+    default:
+      return false;
+  }
+  if (value === null) {
+    return true;
+  }
+  if (ancestors.has(value)) {
+    return false;
+  }
+  // An array, or an object literal (or one with no prototype). Checking the prototype's prototype rather
+  // than comparing against this realm's Object.prototype also accepts objects from other realms.
+  const isArray = Array.isArray(value);
