+test('rejects add, replace and test with a "value" that is not a JSON value', () => {
+  const cyclic: Record<string, unknown> = {};
+  cyclic.self = cyclic;
+  const values: unknown[] = [
+    undefined,
+    NaN,
+    Infinity,
+    -Infinity,
+    1n,
+    () => 1,
+    Symbol('s'),
+    new Date(0),
