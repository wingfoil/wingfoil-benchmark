+    [, 1],
+    cyclic,
+  ];
+  for (const value of values) {
+    for (const op of ['add', 'replace', 'test']) {
+      assert.throws(() => applyPatch({ a: 1 }, [{ op, path: '/a', value }] as unknown as JsonPatch), TypeError, op);
+    }
+  }
