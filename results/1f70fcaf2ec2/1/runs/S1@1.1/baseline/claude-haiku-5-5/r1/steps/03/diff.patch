+    const prototype = Object.getPrototypeOf(value);
+    if (prototype !== null && Object.getPrototypeOf(prototype) !== null) {
+      return false;
+    }
+  }
+  ancestors.add(value);
+  const children = isArray ? Array.from({ length: value.length }, (_, i) => value[i]) : Object.values(value);
+  const result = children.every((child) => isJsonValue(child, ancestors));
+  ancestors.delete(value);
+  return result;
