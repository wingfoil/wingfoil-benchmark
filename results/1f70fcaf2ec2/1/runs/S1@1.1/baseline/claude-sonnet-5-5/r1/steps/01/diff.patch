index 0000000000000000000000000000000000000000..0372c5de8e8feaa1950c053586008a87c72a761b
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,64 @@
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new JsonPointerError(`Invalid JSON Pointer "${pointer}": "~" must be followed by 0 or 1`);
+      }
+      return token.replace(/~[01]/g, (m) => (m === "~1" ? "/" : "~"));
+    });
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a document and returns the referenced value.
+ * Throws if the pointer is syntactically invalid or does not resolve to a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current: unknown = document;
+  for (const token of parsePointer(pointer)) {
+    if (Array.isArray(current)) {
+      if (token === "-") {
+        throw new JsonPointerError(`Pointer "${pointer}" refers to the nonexistent element after the end of the array`);
+      }
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new JsonPointerError(`Pointer "${pointer}": "${token}" is not a valid array index`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new JsonPointerError(`Pointer "${pointer}": array index ${token} out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new JsonPointerError(`Pointer "${pointer}": member "${token}" not found`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Pointer "${pointer}": cannot traverse into a primitive value`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9e4baefcc97096b81771d564a8cce702088324c9
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,61 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// RFC 6901 section 5 example
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("escape order: ~01 is the literal '~1'", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("null and falsy values resolve", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer([false], "/0"), false);
+});
+
+test("invalid pointers throw", () => {
+  assert.throws(() => resolvePointer(doc, "foo"));
+  assert.throws(() => resolvePointer(doc, "/a~"));
+  assert.throws(() => resolvePointer(doc, "/a~2"));
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer(doc, "/nope"));
+  assert.throws(() => resolvePointer(doc, "/foo/2"));
+  assert.throws(() => resolvePointer(doc, "/foo/-"));
+  assert.throws(() => resolvePointer(doc, "/foo/00"));
+  assert.throws(() => resolvePointer(doc, "/foo/+1"));
+  assert.throws(() => resolvePointer(doc, "/foo/1.0"));
+  assert.throws(() => resolvePointer(doc, "/foo/length"));
+  assert.throws(() => resolvePointer(doc, "/foo/0/x"));
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer({}, "/constructor"));
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+});
