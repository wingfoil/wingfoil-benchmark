index 2bfb25a14a443013f4d8b9d30f1684fac2940c6b..775d247479af1a3177255481a794017f9234d42f 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -244,3 +244,26 @@ function addReplace(root: unknown, tokens: string[], value: unknown, path: strin
   else setMember(parent as Record<string, unknown>, last, value);
   return root;
 }
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a target document and returns the result as a new value.
+ * Neither argument is mutated. A non-object patch replaces the target; in an object patch, `null`
+ * members remove the corresponding target member and other members are merged recursively.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): any {
+  if (!isPlainObject(patch)) return clone(patch);
+  const result: Record<string, unknown> = isPlainObject(target) ? clone(target) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(Object.hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..14e650a651cedc85ff1aeeb28b77cc7b733eb93e
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,35 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("does not mutate inputs and handles __proto__", () => {
+  const target = { a: { b: 1 } };
+  const patch = JSON.parse('{"a":{"c":2},"__proto__":{"x":1}}');
+  const out = applyMergePatch(target, patch);
+  assert.deepEqual(target, { a: { b: 1 } });
+  assert.equal(({} as any).x, undefined);
+  assert.deepEqual(Object.keys(out), ["a", "__proto__"]);
+});
