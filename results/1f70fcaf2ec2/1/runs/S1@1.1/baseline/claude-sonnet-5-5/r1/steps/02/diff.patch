+++ b/test/patch.test.ts
@@ -0,0 +1,33 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("add/remove/replace/move/copy/test", () => {
+  const doc = { foo: "bar", list: [1, 2, 3], o: { a: 1 } };
+  const copy = structuredClone(doc);
+  const out = applyPatch(doc, [
+    { op: "add", path: "/list/-", value: 4 },
+    { op: "add", path: "/list/0", value: 0 },
+    { op: "remove", path: "/foo" },
+    { op: "replace", path: "/o/a", value: 2 },
+    { op: "move", from: "/o", path: "/p" },
+    { op: "copy", from: "/p", path: "/q" },
+    { op: "test", path: "/q", value: { a: 2 } },
+  ]);
+  assert.deepEqual(out, { list: [0, 1, 2, 3, 4], p: { a: 2 }, q: { a: 2 } });
+  assert.deepEqual(doc, copy);
+});
+
+test("errors", () => {
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/a", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/2", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/01", value: 1 }]));
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => applyPatch({}, [{ op: "bogus", path: "" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "" }]));
+  assert.throws(() => applyPatch({}, {}));
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "test", path: "", value: { b: 2, a: 1 } }]), { a: 1, b: 2 });
+});
