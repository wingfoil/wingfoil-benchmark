new file mode 100644
index 0000000000000000000000000000000000000000..5bda416df15373bd86b9cb43395b14a99e1b4f0f
--- /dev/null
+++ b/src/merge-patch.ts
@@ -0,0 +1,26 @@
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty so that a member named "__proto__" stays an ordinary own member.
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** RFC 7386 MergePatch. Neither argument is modified. */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return patch === undefined ? patch : structuredClone(patch);
+  const result: Record<string, unknown> = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) setMember(result, key, target[key]);
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(Object.hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
