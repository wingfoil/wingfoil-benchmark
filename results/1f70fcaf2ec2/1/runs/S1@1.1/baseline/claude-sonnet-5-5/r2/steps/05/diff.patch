+++ b/src/diff.ts
@@ -0,0 +1,94 @@
+import { clone, equal, isObject } from "./patch.ts";
+
+type Operation = { op: "add" | "replace"; path: string; value: unknown } | { op: "remove"; path: string };
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Computes, for two arrays, the pairs of indexes of a longest common subsequence of equal items. */
+function commonItems(a: unknown[], b: unknown[]): Array<[number, number]> {
+  let start = 0;
+  while (start < a.length && start < b.length && equal(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && equal(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const n = endA - start;
+  const m = endB - start;
+  // lengths[i][j]: LCS length of a[start+i..endA) and b[start+j..endB)
+  const lengths = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lengths[i][j] = equal(a[start + i], b[start + j])
+        ? lengths[i + 1][j + 1] + 1
+        : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  const pairs: Array<[number, number]> = [];
+  for (let i = 0; i < start; i++) pairs.push([i, i]);
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (equal(a[start + i], b[start + j])) {
+      pairs.push([start + i, start + j]);
+      i++;
+      j++;
+    } else if (lengths[i + 1][j] >= lengths[i][j + 1]) i++;
+    else j++;
+  }
+  for (let k = 0; k < a.length - endA; k++) pairs.push([endA + k, endB + k]);
+  return pairs;
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: Operation[]): void {
+  const pairs = commonItems(from, to);
+  pairs.push([from.length, to.length]); // sentinel closing the last gap
+  let prevFrom = 0;
+  let prevTo = 0;
+  let position = 0; // index in the array as transformed so far
+  for (const [matchFrom, matchTo] of pairs) {
+    const removed = matchFrom - prevFrom;
+    const added = matchTo - prevTo;
+    const shared = Math.min(removed, added);
+    for (let k = 0; k < shared; k++) {
+      diffValues(from[prevFrom + k], to[prevTo + k], `${path}/${position + k}`, ops);
+    }
+    for (let k = shared; k < removed; k++) ops.push({ op: "remove", path: `${path}/${position + shared}` });
+    for (let k = shared; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${position + k}`, value: clone(to[prevTo + k]) });
+    }
+    position += added + 1;
+    prevFrom = matchFrom + 1;
+    prevTo = matchTo + 1;
+  }
+}
+
+function diffValues(from: unknown, to: unknown, path: string, ops: Operation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (!Object.hasOwn(from, key)) ops.push({ op: "add", path: child, value: clone(to[key]) });
+      else diffValues(from[key], to[key], child, ops);
+    }
+  } else if (!equal(from, to)) {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to`. Neither input is mutated.
+ * Array items that were inserted, removed or moved are added/removed individually.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const ops: Operation[] = [];
+  diffValues(from, to, "", ops);
+  return ops;
+}
