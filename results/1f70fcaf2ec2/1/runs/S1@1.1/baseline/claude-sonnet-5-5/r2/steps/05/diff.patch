diff --git a/test/diff.test.ts b/test/diff.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5dd9ae193ac42a3f5e553c5624db18cd18f2fcd9
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,40 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createPatch, applyPatch } from "../src/index.ts";
+
+function check(from: unknown, to: unknown) {
+  const f = JSON.stringify(from), t = JSON.stringify(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.equal(JSON.stringify(from), f);
+  assert.equal(JSON.stringify(to), t);
+  return patch;
+}
+
+test("small changes give small patches", () => {
+  assert.deepEqual(check({ a: 1, b: { c: [1, 2] } }, { a: 1, b: { c: [1, 3] } }), [{ op: "replace", path: "/b/c/1", value: 3 }]);
+  assert.deepEqual(check({ "a/b": 1, "~": 2 }, { "a/b": 1 }), [{ op: "remove", path: "/~0" }]);
+  assert.deepEqual(check([1], [1]), []);
+  assert.deepEqual(check(1, [1]), [{ op: "replace", path: "", value: [1] }]);
+});
+
+test("array insert, remove, move", () => {
+  const big = [{ x: 1 }, { x: 2 }, { x: 3 }, { x: 4 }];
+  assert.deepEqual(check(big, [big[0], { x: 9 }, ...big.slice(1)]), [{ op: "add", path: "/1", value: { x: 9 } }]);
+  assert.deepEqual(check(big, [big[0], big[2], big[3]]), [{ op: "remove", path: "/1" }]);
+  assert.equal(check(big, [big[1], big[2], big[3], big[0]]).length, 2);
+});
+
+test("random round trips", () => {
+  let s = 7;
+  const r = (n: number) => (s = (s * 1103515245 + 12345) % 2147483648) % n;
+  const gen = (d: number): unknown => {
+    const k = r(d > 2 ? 3 : 5);
+    if (k === 0) return r(3);
+    if (k === 1) return "s" + r(2);
+    if (k === 2) return null;
+    if (k === 3) return Array.from({ length: r(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: r(4) }, () => ["k" + r(4), gen(d + 1)]));
+  };
+  for (let i = 0; i < 3000; i++) check(gen(0), gen(0));
+});
