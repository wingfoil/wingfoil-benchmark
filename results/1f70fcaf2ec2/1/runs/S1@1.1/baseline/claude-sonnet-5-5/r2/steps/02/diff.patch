index 0000000000000000000000000000000000000000..9cf715c12a0f99233f3056a1533d425c30d848a2
--- /dev/null
+++ b/src/patch.ts
@@ -0,0 +1,181 @@
+import { parsePointer } from "./pointer.ts";
+
+type Container = unknown[] | Record<string, unknown>;
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty so that a member named "__proto__" stays an ordinary own member.
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone<T>(value: T): T {
+  if (Array.isArray(value)) return value.map(clone) as T;
+  if (isObject(value)) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(copy, key, clone(value[key]));
+    return copy as T;
+  }
+  return value;
+}
+
+function equal(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => equal(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.hasOwn(b, key) && equal(a[key], b[key]))
+    );
+  }
+  return a === b;
+}
+
+function parseIndex(token: string, max: number, pointer: string): number {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`Invalid array index "${token}" in "${pointer}"`);
+  }
+  const index = Number(token);
+  if (index > max) throw new Error(`Array index ${token} out of range in "${pointer}"`);
+  return index;
+}
+
+/** Finds the container holding the target of `tokens` (which must be non-empty). */
+function parentOf(root: unknown, tokens: string[], pointer: string): Container {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      current = current[parseIndex(token, current.length - 1, pointer)];
+    } else if (isObject(current) && Object.hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path does not resolve: "${pointer}"`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new Error(`Path does not resolve: "${pointer}"`);
+  }
+  return current;
+}
+
+function getValue(root: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return root;
+  const parent = parentOf(root, tokens, pointer);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) return parent[parseIndex(last, parent.length - 1, pointer)];
+  if (!Object.hasOwn(parent, last)) throw new Error(`Path does not resolve: "${pointer}"`);
+  return parent[last];
+}
+
+function addValue(root: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens, pointer);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    const index = last === "-" ? parent.length : parseIndex(last, parent.length, pointer);
+    parent.splice(index, 0, value);
+  } else {
+    setMember(parent, last, value);
+  }
+  return root;
+}
+
+function removeValue(root: unknown, pointer: string): { root: unknown; removed: unknown } {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) throw new Error("Cannot remove the document root");
+  const parent = parentOf(root, tokens, pointer);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    const index = parseIndex(last, parent.length - 1, pointer);
+    return { root, removed: parent.splice(index, 1)[0] };
+  }
+  if (!Object.hasOwn(parent, last)) throw new Error(`Path does not resolve: "${pointer}"`);
+  const removed = parent[last];
+  delete parent[last];
+  return { root, removed };
+}
+
+const OPERATIONS = ["add", "remove", "replace", "move", "copy", "test"];
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result as a new value.
+ * The input document and patch are not mutated. Throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new TypeError("JSON Patch must be an array of operations");
+
+  let result = clone(document);
+  for (const operation of patch) {
+    if (!isObject(operation)) throw new TypeError("JSON Patch operation must be an object");
+    const { op, path } = operation;
+    if (typeof op !== "string" || !OPERATIONS.includes(op)) {
+      throw new Error(`Unknown JSON Patch operation: ${String(op)}`);
+    }
+    if (typeof path !== "string") throw new TypeError(`Operation "${op}" requires a string "path"`);
+    if ((op === "add" || op === "replace" || op === "test") && !Object.hasOwn(operation, "value")) {
+      throw new Error(`Operation "${op}" requires a "value"`);
+    }
+    let from = "";
+    if (op === "move" || op === "copy") {
+      if (typeof operation.from !== "string") {
+        throw new TypeError(`Operation "${op}" requires a string "from"`);
+      }
+      from = operation.from;
+    }
+
+    switch (op) {
+      case "add":
+        result = addValue(result, path, clone(operation.value));
+        break;
+      case "remove":
+        result = removeValue(result, path).root;
+        break;
+      case "replace":
+        getValue(result, path); // the target must exist
+        result = parsePointer(path).length === 0
+          ? clone(operation.value)
+          : addValueReplacing(result, path, clone(operation.value));
+        break;
+      case "move": {
+        const fromTokens = parsePointer(from);
+        const pathTokens = parsePointer(path);
+        if (
+          fromTokens.length < pathTokens.length &&
+          fromTokens.every((token, i) => token === pathTokens[i])
+        ) {
+          throw new Error(`Cannot move "${from}" into one of its own children "${path}"`);
+        }
+        getValue(result, from);
+        if (from === path) break;
+        const removed = removeValue(result, from);
+        result = addValue(removed.root, path, removed.removed);
+        break;
+      }
+      case "copy":
+        result = addValue(result, path, clone(getValue(result, from)));
+        break;
+      case "test":
+        if (!equal(getValue(result, path), operation.value)) {
+          throw new Error(`Test failed at "${path}"`);
+        }
+        break;
+    }
+  }
+  return result;
+}
+
+function addValueReplacing(root: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  const parent = parentOf(root, tokens, pointer);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[parseIndex(last, parent.length - 1, pointer)] = value;
+  else setMember(parent, last, value);
+  return root;
+}
