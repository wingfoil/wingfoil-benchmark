+++ b/test/patch.test.ts
@@ -0,0 +1,53 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ap = (d: unknown, p: unknown) => applyPatch(d, p);
+
+test("RFC 6902 appendix A examples", () => {
+  assert.deepEqual(ap({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(ap({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(ap({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+  assert.deepEqual(ap({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+  assert.deepEqual(ap({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), { baz: "boo", foo: "bar" });
+  assert.deepEqual(
+    ap({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(ap({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(ap({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "copy", from: "/foo/1", path: "/baz" }]), { baz: 2, foo: ["a", 2, "c"] });
+  assert.deepEqual(ap({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }]), { baz: "qux", foo: ["a", 2, "c"] });
+  assert.deepEqual(ap({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]), { foo: ["bar", ["abc", "def"]] });
+});
+
+test("failures throw", () => {
+  const bad: unknown[][] = [
+    [{ op: "test", path: "/a", value: "x" }],
+    [{ op: "remove", path: "/missing" }],
+    [{ op: "replace", path: "/missing", value: 1 }],
+    [{ op: "add", path: "/x/y", value: 1 }],
+    [{ op: "add", path: "/arr/5", value: 1 }],
+    [{ op: "add", path: "/arr/01", value: 1 }],
+    [{ op: "move", from: "/o", path: "/o/c" }],
+    [{ op: "copy", from: "/nope", path: "/z" }],
+    [{ op: "add", path: "/z" }],
+    [{ op: "bogus", path: "/z" }],
+    [{ op: "move", path: "/z" }],
+    [null as unknown],
+  ];
+  for (const p of bad) assert.throws(() => ap({ a: 1, arr: [1], o: {} }, p));
+  assert.throws(() => ap({}, { op: "add" }));
+});
+
+test("does not mutate or alias; root ops; equality", () => {
+  const doc = { a: { b: [1, 2] } };
+  const patch = [{ op: "add", path: "/c", value: { z: 1 } }, { op: "copy", from: "/a", path: "/d" }, { op: "remove", path: "/a/b/0" }];
+  const out = ap(doc, patch) as any;
+  assert.deepEqual(doc, { a: { b: [1, 2] } });
+  assert.deepEqual(out.d, { b: [1, 2] });
+  out.c.z = 2;
+  assert.equal(patch[0].value!.z, 1);
+  assert.deepEqual(ap({ a: 1 }, [{ op: "replace", path: "", value: [1] }]), [1]);
+  assert.deepEqual(ap({ a: 1, b: 2 }, [{ op: "test", path: "", value: { b: 2, a: 1 } }]), { a: 1, b: 2 });
+  assert.throws(() => ap([1], [{ op: "test", path: "/0", value: "1" }]));
+});
