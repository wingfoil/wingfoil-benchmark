@@ -222,3 +222,21 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   }
   return doc;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to `target` and returns the result as a new value.
+ * Neither input is mutated. A non-object patch replaces the target; in an object patch,
+ * `null` members delete the corresponding member and arrays are replaced wholesale.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch);
+  const result: Record<string, Json> = isObject(target) ? (clone(target) as Record<string, Json>) : {};
+  for (const [key, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(Object.hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
