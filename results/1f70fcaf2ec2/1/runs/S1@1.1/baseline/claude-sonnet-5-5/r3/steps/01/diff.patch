--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,47 @@
+/** Splits a JSON Pointer (RFC 6901) into its unescaped reference tokens. */
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new TypeError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (!pointer.startsWith("/")) {
+    throw new SyntaxError(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new SyntaxError(`Invalid JSON Pointer "${pointer}": "~" must be followed by "0" or "1"`);
+      }
+      return token.replace(/~[01]/g, (m) => (m === "~1" ? "/" : "~"));
+    });
+}
+
+/**
+ * Returns the value of `document` referred to by the JSON Pointer `pointer` (RFC 6901).
+ * Throws if the pointer is syntactically invalid or does not resolve to a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const token of parsePointer(pointer)) {
+    if (Array.isArray(current)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`Pointer "${pointer}" does not resolve: "${token}" is not a valid array index`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new Error(`Pointer "${pointer}" does not resolve: index ${token} is out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new Error(`Pointer "${pointer}" does not resolve: no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`Pointer "${pointer}" does not resolve: cannot descend into a scalar value`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2746b3dc77eb26b9a0104084bc6e4bbc13536c31
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,62 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// Document and pointers from RFC 6901 section 5.
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("escape order: ~01 is ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("falsy and null values resolve", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer([false], "/0"), false);
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["foo", "/a~", "/a~2", "#/foo", "/~"]) {
+    assert.throws(() => resolvePointer({ a: 1, foo: 1 }, p), p);
+  }
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: "str" }, "/a/length"));
+  assert.throws(() => resolvePointer([1], "/1"));
+  assert.throws(() => resolvePointer([1], "/-"));
+  assert.throws(() => resolvePointer([1, 2], "/01"));
+  assert.throws(() => resolvePointer([1], "/length"));
+  assert.throws(() => resolvePointer([1], "/+0"));
+  assert.throws(() => resolvePointer({}, "/toString"));
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer({}, "/constructor"));
+});
