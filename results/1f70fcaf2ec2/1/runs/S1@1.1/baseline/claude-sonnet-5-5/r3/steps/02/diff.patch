--- a/src/index.ts
+++ b/src/index.ts
@@ -45,3 +45,180 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+type Json = unknown;
+
+function clone(value: Json): Json {
+  if (Array.isArray(value)) return value.map(clone);
+  if (typeof value === "object" && value !== null) {
+    const out: Record<string, Json> = {};
+    for (const [k, v] of Object.entries(value)) {
+      Object.defineProperty(out, k, { value: clone(v), writable: true, enumerable: true, configurable: true });
+    }
+    return out;
+  }
+  return value;
+}
+
+function deepEqual(a: Json, b: Json): boolean {
+  if (a === b) return true;
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => deepEqual(v, b[i]));
+  }
+  if (typeof a === "object" && a !== null) {
+    if (typeof b !== "object" || b === null || Array.isArray(b)) return false;
+    const ka = Object.keys(a);
+    if (ka.length !== Object.keys(b).length) return false;
+    return ka.every(
+      (k) =>
+        Object.hasOwn(b, k) &&
+        deepEqual((a as Record<string, Json>)[k], (b as Record<string, Json>)[k]),
+    );
+  }
+  return false;
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Walks to the container of the pointer's last token. */
+function locate(doc: Json, tokens: string[], pointer: string): Json {
+  let current = doc;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`Path "${pointer}" does not exist`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null && Object.hasOwn(current, token)) {
+      current = (current as Record<string, Json>)[token];
+    } else {
+      throw new Error(`Path "${pointer}" does not exist`);
+    }
+  }
+  if (typeof current !== "object" || current === null) {
+    throw new Error(`Path "${pointer}" does not exist`);
+  }
+  return current;
+}
+
+function setMember(obj: object, key: string, value: Json): void {
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function addAt(doc: Json, pointer: string, value: Json): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = locate(doc, tokens, pointer);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (key === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(key) && Number(key) <= parent.length) {
+      parent.splice(Number(key), 0, value);
+    } else {
+      throw new Error(`Cannot add at "${pointer}": invalid array index`);
+    }
+  } else {
+    setMember(parent, key, value);
+  }
+  return doc;
+}
+
+/** Removes the value at `pointer`; returns the new document. */
+function removeAt(doc: Json, pointer: string): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return undefined;
+  const parent = locate(doc, tokens, pointer);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(key) || Number(key) >= parent.length) {
+      throw new Error(`Path "${pointer}" does not exist`);
+    }
+    parent.splice(Number(key), 1);
+  } else {
+    if (!Object.hasOwn(parent, key)) throw new Error(`Path "${pointer}" does not exist`);
+    delete (parent as Record<string, Json>)[key];
+  }
+  return doc;
+}
+
+const isObject = (v: Json): v is Record<string, Json> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the result as a new value.
+ * The input document and patch are never mutated. Throws if the patch is invalid or an
+ * operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new TypeError("JSON Patch must be an array of operations");
+  let doc = clone(document);
+
+  for (const op of patch) {
+    if (!isObject(op)) throw new TypeError("JSON Patch operation must be an object");
+    if (typeof op.path !== "string") throw new TypeError('Operation requires a string "path"');
+    const path = op.path;
+    const needValue = () => {
+      if (!Object.hasOwn(op, "value") || op.value === undefined) {
+        throw new TypeError(`Operation "${String(op.op)}" requires a "value"`);
+      }
+      return clone(op.value);
+    };
+    const needFrom = () => {
+      if (typeof op.from !== "string") throw new TypeError(`Operation "${String(op.op)}" requires a string "from"`);
+      return op.from;
+    };
+
+    switch (op.op) {
+      case "add":
+        doc = addAt(doc, path, needValue());
+        break;
+      case "remove":
+        doc = removeAt(doc, path);
+        break;
+      case "replace": {
+        const value = needValue();
+        resolvePointer(doc, path); // must exist
+        const tokens = parsePointer(path);
+        if (tokens.length === 0) {
+          doc = value;
+        } else {
+          const parent = locate(doc, tokens, path) as Record<string, Json>;
+          setMember(parent, tokens[tokens.length - 1], value);
+        }
+        break;
+      }
+      case "move": {
+        const from = needFrom();
+        const fromTokens = parsePointer(from);
+        const pathTokens = parsePointer(path);
+        const value = resolvePointer(doc, from);
+        if (from === path) break;
+        if (
+          pathTokens.length > fromTokens.length &&
+          fromTokens.every((t, i) => t === pathTokens[i])
+        ) {
+          throw new Error(`Cannot move "${from}" into one of its own children`);
+        }
+        doc = removeAt(doc, from);
+        doc = addAt(doc, path, value);
+        break;
+      }
+      case "copy": {
+        const from = needFrom();
+        doc = addAt(doc, path, clone(resolvePointer(doc, from)));
+        break;
+      }
+      case "test": {
+        const value = needValue();
+        if (!deepEqual(resolvePointer(doc, path), value)) {
+          throw new Error(`Test failed at "${path}"`);
+        }
+        break;
+      }
+      default:
+        throw new TypeError(`Unknown operation "${String(op.op)}"`);
+    }
+  }
+  return doc;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9d60e47aeaa679b40e5a7ffdad6c842674e3789b
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,47 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("RFC 6902 appendix examples", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(applyPatch({ foo: ["a"] }, [{ op: "add", path: "/foo/-", value: "b" }]), { foo: ["a", "b"] });
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+  assert.deepEqual(applyPatch({ baz: "qux" }, [{ op: "replace", path: "/baz", value: "boo" }]), { baz: "boo" });
+  assert.deepEqual(
+    applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(applyPatch({ foo: { a: 1 } }, [{ op: "copy", from: "/foo", path: "/bar" }]), { foo: { a: 1 }, bar: { a: 1 } });
+  assert.deepEqual(applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "qux" }]), { baz: "qux" });
+});
+
+test("failures", () => {
+  assert.throws(() => applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]));
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/3", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/01", value: 1 }]));
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "nope", path: "/a" }]));
+  assert.throws(() => applyPatch({}, {}));
+});
+
+test("does not mutate and handles root/null/__proto__", () => {
+  const doc = { a: [1, { b: 2 }] };
+  const patch = [{ op: "add", path: "/c", value: { d: 1 } }, { op: "remove", path: "/a/1/b" }];
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, { a: [1, { b: 2 }] });
+  out.c.d = 9;
+  assert.equal((patch[0] as any).value.d, 1);
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: null }]), null);
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/x", value: null }, { op: "test", path: "/x", value: null }]), { x: null });
+  const p = applyPatch({}, [{ op: "add", path: "/__proto__", value: { z: 1 } }]) as any;
+  assert.equal(({} as any).z, undefined);
+  assert.ok(Object.hasOwn(p, "__proto__"));
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "test", path: "", value: { b: 2, a: 1 } }]), { a: 1, b: 2 });
+});
