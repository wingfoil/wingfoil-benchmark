@@ -0,0 +1,167 @@
+import { parsePointer } from "./json-pointer.ts";
+
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Container = Record<string, unknown> | unknown[];
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const OPERATIONS = ["add", "remove", "replace", "move", "copy", "test"];
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone<T>(value: T): T {
+  if (Array.isArray(value)) return value.map(clone) as T;
+  if (isObject(value)) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(copy, key, clone(value[key]));
+    return copy as T;
+  }
+  return value;
+}
+
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.hasOwn(b, key) && jsonEqual(a[key], b[key]))
+    );
+  }
+  return a === b;
+}
+
+/** Parses a pointer, wrapping nothing: pointer errors propagate as JsonPointerError. */
+function pointerTokens(value: unknown, what: string): string[] {
+  if (typeof value !== "string") throw new JsonPatchError(`"${what}" must be a JSON Pointer string`);
+  return parsePointer(value);
+}
+
+function arrayIndex(token: string, length: number, max: number): number {
+  if (!ARRAY_INDEX.test(token)) throw new JsonPatchError(`Invalid array index ${JSON.stringify(token)}`);
+  const index = Number(token);
+  if (index > max || index > length) throw new JsonPatchError(`Array index ${token} is out of range`);
+  return index;
+}
+
+/** Finds the container holding the target of `tokens` (which must be non-empty). */
+function parentOf(document: unknown, tokens: string[]): Container {
+  let current = document;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      current = current[arrayIndex(token, current.length, current.length - 1)];
+    } else if (isObject(current) && Object.hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new JsonPatchError(`Cannot resolve ${JSON.stringify(token)}`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new JsonPatchError("Parent of the target is not an object or array");
+  }
+  return current;
+}
+
+function get(document: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) return document;
+  const parent = parentOf(document, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) return parent[arrayIndex(token, parent.length, parent.length - 1)];
+  if (!Object.hasOwn(parent, token)) throw new JsonPatchError(`No member ${JSON.stringify(token)}`);
+  return parent[token];
+}
+
+function add(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(document, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    const index = token === "-" ? parent.length : arrayIndex(token, parent.length, parent.length);
+    parent.splice(index, 0, value);
+  } else {
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+function remove(document: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) throw new JsonPatchError("Cannot remove the whole document");
+  const parent = parentOf(document, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(token, parent.length, parent.length - 1), 1);
+  } else {
+    if (!Object.hasOwn(parent, token)) throw new JsonPatchError(`No member ${JSON.stringify(token)}`);
+    delete parent[token];
+  }
+  return document;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result as a new value.
+ * Neither argument is mutated; throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchError("A JSON Patch must be an array");
+
+  // Validate the whole patch before touching anything.
+  const operations = patch.map((operation) => {
+    if (!isObject(operation)) throw new JsonPatchError("Each patch operation must be an object");
+    const op = operation.op;
+    if (typeof op !== "string" || !OPERATIONS.includes(op)) {
+      throw new JsonPatchError(`Invalid or missing "op": ${JSON.stringify(op)}`);
+    }
+    const path = pointerTokens(operation.path, "path");
+    if (["add", "replace", "test"].includes(op) && !Object.hasOwn(operation, "value")) {
+      throw new JsonPatchError(`Operation "${op}" requires "value"`);
+    }
+    const from = op === "move" || op === "copy" ? pointerTokens(operation.from, "from") : [];
+    return { op, path, from, value: operation.value };
+  });
+
+  let result = clone(document);
+  for (const { op, path, from, value } of operations) {
+    switch (op) {
+      case "add":
+        result = add(result, path, clone(value));
+        break;
+      case "remove":
+        result = remove(result, path);
+        break;
+      case "replace":
+        get(result, path);
+        result = path.length === 0 ? clone(value) : add(remove(result, path), path, clone(value));
+        break;
+      case "move": {
+        const moved = get(result, from);
+        if (from.length < path.length && from.every((token, i) => token === path[i])) {
+          throw new JsonPatchError("Cannot move a value into one of its own children");
+        }
+        if (from.length === path.length && from.every((token, i) => token === path[i])) break;
+        result = add(remove(result, from), path, moved);
+        break;
+      }
+      case "copy":
+        result = add(result, path, clone(get(result, from)));
+        break;
+      case "test":
+        if (!jsonEqual(get(result, path), value)) throw new JsonPatchError("Test operation failed");
+        break;
+    }
+  }
+  return result;
+}
diff --git a/test/json-patch.test.ts b/test/json-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c7527f64aeb69b17977e4a184e62767dfc5cb592
--- /dev/null
+++ b/test/json-patch.test.ts
@@ -0,0 +1,135 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) =>
+  assert.deepEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch));
+
+test("RFC 6902 Appendix A examples", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  ok(
+    { foo: { bar: "baz" }, qux: {} },
+    [{ op: "copy", from: "/foo/bar", path: "/qux/x" }],
+    { foo: { bar: "baz" }, qux: { x: "baz" } },
+  );
+  ok({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  });
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  ok({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 });
+  bad({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }, { op: "bogus", path: "/x" }]);
+});
+
+test("does not mutate input or alias values", () => {
+  const doc = { a: { b: [1, 2] }, c: 1 };
+  const value = { x: [1] };
+  const patch = [
+    { op: "add", path: "/d", value },
+    { op: "copy", from: "/a", path: "/e" },
+    { op: "remove", path: "/c" },
+    { op: "replace", path: "/a/b/0", value: 9 },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const result = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  result.d.x.push(2);
+  result.e.b.push(3);
+  assert.deepEqual(value, { x: [1] });
+  assert.deepEqual(result.a.b, [9, 2]);
+  assert.notEqual(applyPatch(doc, []), doc);
+  ok(doc, [], doc);
+});
+
+test("invalid patches", () => {
+  for (const patch of [
+    {}, null, [1], [null], [{ path: "/a" }], [{ op: "bogus", path: "/a" }], [{ op: 1, path: "/a" }],
+    [{ op: "add", path: "/a" }], [{ op: "replace", path: "/a" }], [{ op: "test", path: "/a" }],
+    [{ op: "remove" }], [{ op: "remove", path: 1 }], [{ op: "move", path: "/a" }], [{ op: "copy", path: "/a" }],
+    [{ op: "move", from: 1, path: "/a" }], [{ op: "add", path: "a", value: 1 }], [{ op: "add", path: "/a~2", value: 1 }],
+  ]) {
+    bad({ a: 1 }, patch);
+  }
+  ok({}, [{ op: "add", path: "/a", value: null }], { a: null });
+});
+
+test("add", () => {
+  ok({ a: 1 }, [{ op: "add", path: "/b", value: 2 }, { op: "add", path: "/a", value: 3 }], { a: 3, b: 2 });
+  ok([1], [{ op: "add", path: "/-", value: 2 }], [1, 2]);
+  ok([1], [{ op: "add", path: "/1", value: 2 }], [1, 2]);
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({}, [{ op: "add", path: "/", value: 1 }], { "": 1 });
+  for (const path of ["/3", "/01", "/x", "/-1", "/1.0"]) bad([1], [{ op: "add", path, value: 0 }]);
+  bad({}, [{ op: "add", path: "/a/b", value: 1 }]);
+  bad({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]);
+  bad([], [{ op: "add", path: "/-/a", value: 1 }]);
+  const result = applyPatch({}, JSON.parse('[{"op":"add","path":"/__proto__","value":1}]')) as any;
+  assert.ok(Object.hasOwn(result, "__proto__"));
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as any).x, undefined);
+  const parsed = applyPatch(JSON.parse('{"__proto__":{"a":1}}'), [{ op: "add", path: "/__proto__/b", value: 2 }]) as any;
+  assert.deepEqual(JSON.parse(JSON.stringify(parsed)), { ["__proto__"]: { a: 1, b: 2 } });
+});
+
+test("remove and replace", () => {
+  ok({ a: 1, b: [1, 2, 3] }, [{ op: "remove", path: "/a" }, { op: "remove", path: "/b/1" }], { b: [1, 3] });
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad([1], [{ op: "remove", path: "/1" }]);
+  bad([1], [{ op: "remove", path: "/-" }]);
+  bad({}, [{ op: "remove", path: "" }]);
+  bad({}, [{ op: "remove", path: "/toString" }]);
+  ok({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }], { a: 2 });
+  ok([1, 2], [{ op: "replace", path: "/0", value: 9 }], [9, 2]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: null }], null);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad([1], [{ op: "replace", path: "/1", value: 2 }]);
+  bad([1], [{ op: "replace", path: "/-", value: 2 }]);
+});
+
+test("move and copy", () => {
+  ok({ a: { b: 1 }, c: 2 }, [{ op: "move", from: "/a/b", path: "/d" }], { a: {}, c: 2, d: 1 });
+  ok(["a", "b", "c"], [{ op: "move", from: "/0", path: "/2" }], ["b", "c", "a"]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "" }], 1);
+  ok({ "a/b": {} }, [{ op: "move", from: "/a~1b", path: "/c" }], { c: {} });
+  bad({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  bad({ a: {} }, [{ op: "move", from: "", path: "/a/b" }]);
+  bad({}, [{ op: "move", from: "/a", path: "/b" }]);
+  bad({}, [{ op: "move", from: "/a", path: "/a" }]);
+  ok({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }, { op: "add", path: "/b/y", value: 2 }], {
+    a: { x: 1 },
+    b: { x: 1, y: 2 },
+  });
+  bad({}, [{ op: "copy", from: "/a", path: "/b" }]);
+});
+
+test("test operation equality", () => {
+  const t = (doc: unknown, value: unknown) => applyPatch(doc, [{ op: "test", path: "/v", value }]);
+  t({ v: { x: [1, { y: null }], z: "s" } }, { z: "s", x: [1, { y: null }] });
+  t({ v: 1.0 }, 1);
+  t({ v: null }, null);
+  for (const [a, b] of [[1, "1"], [[1, 2], [2, 1]], [{ a: 1 }, { a: 1, b: 2 }], [0, null], [{}, []], [true, 1], [{ a: 1, b: 2 }, { a: 1 }]]) {
+    assert.throws(() => t({ v: a }, b));
+  }
+  bad({}, [{ op: "test", path: "/v", value: 1 }]);
+  ok({ a: 1 }, [{ op: "test", path: "", value: { a: 1 } }], { a: 1 });
+  bad({}, [{ op: "test", path: "/a", value: 1 }, { op: "add", path: "/b", value: 1 }]);
+});
