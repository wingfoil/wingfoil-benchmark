index 0000000000000000000000000000000000000000..e985145f6ff2a8827994454b6fef4e20c444dfe3
--- /dev/null
+++ b/test/json-merge-patch.test.ts
@@ -0,0 +1,51 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+const cases: [string, string, string][] = [
+  ['{"a":"b"}', '{"a":"c"}', '{"a":"c"}'],
+  ['{"a":"b"}', '{"b":"c"}', '{"a":"b","b":"c"}'],
+  ['{"a":"b"}', '{"a":null}', '{}'],
+  ['{"a":"b","b":"c"}', '{"a":null}', '{"b":"c"}'],
+  ['{"a":["b"]}', '{"a":"c"}', '{"a":"c"}'],
+  ['{"a":"c"}', '{"a":["b"]}', '{"a":["b"]}'],
+  ['{"a":{"b":"c"}}', '{"a":{"b":"d","c":null}}', '{"a":{"b":"d"}}'],
+  ['{"a":[{"b":"c"}]}', '{"a":[1]}', '{"a":[1]}'],
+  ['["a","b"]', '["c","d"]', '["c","d"]'],
+  ['{"a":"b"}', '["c"]', '["c"]'],
+  ['{"a":"foo"}', 'null', 'null'],
+  ['{"a":"foo"}', '"bar"', '"bar"'],
+  ['{"e":null}', '{"a":1}', '{"e":null,"a":1}'],
+  ['[1,2]', '{"a":"b","c":null}', '{"a":"b"}'],
+  ['{}', '{"a":{"bb":{"ccc":null}}}', '{"a":{"bb":{}}}'],
+  ['{}', '{"a":{"b":null,"c":1}}', '{"a":{"c":1}}'],
+  ['1', '{"a":1}', '{"a":1}'],
+];
+
+for (const [t, p, r] of cases) {
+  test(`RFC 7386: ${t} + ${p}`, () => {
+    assert.deepEqual(applyMergePatch(JSON.parse(t), JSON.parse(p)), JSON.parse(r));
+  });
+}
+
+test("does not mutate or alias inputs", () => {
+  const target = { a: { b: 1 }, l: [1] };
+  const patch = { a: { c: { d: 1 } }, m: [{ x: 1 }] };
+  const t0 = structuredClone(target);
+  const p0 = structuredClone(patch);
+  const out = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, t0);
+  assert.deepEqual(patch, p0);
+  assert.notEqual(out.a, target.a);
+  assert.notEqual(out.l, target.l);
+  assert.notEqual(out.a.c, patch.a.c);
+  assert.notEqual(out.m, patch.m);
+  assert.notEqual(out.m[0], patch.m[0]);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const out = applyMergePatch({}, JSON.parse('{"__proto__":{"polluted":true}}')) as any;
+  assert.ok(Object.prototype.hasOwnProperty.call(out, "__proto__"));
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(out.polluted, undefined);
+});
