@@ -0,0 +1,124 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+import { escapeToken } from "../src/json-pointer.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+};
+
+test("escapeToken", () => {
+  assert.equal(escapeToken("a/b~c"), "a~1b~0c");
+});
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(createPatch({ a: [1, { b: 2 }], c: null }, { c: null, a: [1, { b: 2 }] }), []);
+});
+
+test("root replacement", () => {
+  assert.deepEqual(createPatch(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepEqual(createPatch({}, []), [{ op: "replace", path: "", value: [] }]);
+  roundTrip(null, { a: 1 });
+});
+
+test("small nested change", () => {
+  const patch = roundTrip({ a: { b: 1, c: [1, 2] }, d: "x" }, { a: { b: 2, c: [1, 2] }, d: "x" });
+  assert.deepEqual(patch, [{ op: "replace", path: "/a/b", value: 2 }]);
+});
+
+test("members added, removed and escaped", () => {
+  const patch = roundTrip({ x: 1, "a/b~c": 1 }, { y: 2, "a/b~c": 2 });
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/x" },
+    { op: "replace", path: "/a~1b~0c", value: 2 },
+    { op: "add", path: "/y", value: 2 },
+  ]);
+});
+
+test("inputs untouched and not aliased", () => {
+  const from = { a: [1, 2] };
+  const to = { a: [1, 2], b: { c: [1] } };
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  (patch[0] as { value: { c: number[] } }).value.c.push(9);
+  assert.deepEqual(to, toCopy);
+});
+
+test("__proto__ members", () => {
+  const to = JSON.parse('{"__proto__":{"x":1}}');
+  const patch = createPatch({}, to);
+  assert.deepEqual(patch, [{ op: "add", path: "/__proto__", value: { x: 1 } }]);
+  assert.deepEqual(Object.keys(applyPatch({}, patch) as object), ["__proto__"]);
+});
+
+test("array insertion and removal touch only that item", () => {
+  assert.deepEqual(roundTrip([1, 2, 4], [1, 2, 3, 4]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [2, 3]), [{ op: "remove", path: "/0" }]);
+  assert.deepEqual(roundTrip([{ a: 1 }, { b: 2 }], [{ b: 2 }]), [{ op: "remove", path: "/0" }]);
+  assert.deepEqual(roundTrip([1], [1, 2]), [{ op: "add", path: "/1", value: 2 }]);
+});
+
+test("array move does not rewrite items in between", () => {
+  for (const [from, to] of [
+    [["a", "b", "c", "d"], ["a", "c", "d", "b"]],
+    [["a", "b", "c", "d"], ["d", "a", "b", "c"]],
+    [[{ k: 1 }, { k: 2 }, { k: 3 }], [{ k: 2 }, { k: 3 }, { k: 1 }]],
+  ]) {
+    const patch = roundTrip(from, to);
+    assert.ok(patch.length <= 2, JSON.stringify(patch));
+    assert.ok(patch.every((o) => o.op === "move" || o.op === "remove" || o.op === "add"));
+  }
+  assert.deepEqual(roundTrip(["a", "b", "c"], ["b", "c", "a"]), [
+    { op: "remove", path: "/0" },
+    { op: "add", path: "/2", value: "a" },
+  ]);
+});
+
+test("changed item inside an array", () => {
+  assert.deepEqual(roundTrip([{ a: 1, b: 1 }, 5], [{ a: 1, b: 2 }, 5]), [
+    { op: "replace", path: "/0/b", value: 2 },
+  ]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 9, 3]), [{ op: "replace", path: "/1", value: 9 }]);
+});
+
+test("randomized round trip", () => {
+  let seed = 12345;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  const value = (depth: number): unknown => {
+    const r = rand(depth > 2 ? 4 : 7);
+    if (r === 0) return rand(4);
+    if (r === 1) return ["x", "y"][rand(2)];
+    if (r === 2) return null;
+    if (r === 3) return rand(2) === 0;
+    if (r <= 5) return Array.from({ length: rand(6) }, () => value(depth + 1));
+    const o: Record<string, unknown> = {};
+    for (let i = rand(4); i > 0; i--) o[["a", "b", "c/d"][rand(3)]] = value(depth + 1);
+    return o;
+  };
+  const mutate = (v: unknown): unknown => {
+    if (Array.isArray(v)) {
+      const copy = v.map((x) => (rand(4) === 0 ? mutate(x) : x));
+      for (let i = rand(3); i > 0; i--) {
+        const k = rand(3);
+        if (k === 0 && copy.length) copy.splice(rand(copy.length), 1);
+        else if (k === 1) copy.splice(rand(copy.length + 1), 0, value(2));
+        else if (copy.length) copy.splice(rand(copy.length + 1), 0, ...copy.splice(rand(copy.length), 1));
+      }
+      return copy;
+    }
+    return rand(2) ? value(1) : v;
+  };
+  for (let n = 0; n < 3000; n++) {
+    const from = Array.from({ length: rand(8) }, () => value(1));
+    roundTrip(from, mutate(from));
+    roundTrip(value(0), value(0));
+  }
+});
