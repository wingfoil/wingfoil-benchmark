+++ b/src/json-patch-creation.ts
@@ -0,0 +1,131 @@
+import { clone, isObject, jsonEqual } from "./json-patch.ts";
+import { escapeToken } from "./json-pointer.ts";
+
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "move"; from: string; path: string };
+
+/** An item of the array being transformed; `gap` is set for unmatched items of `from`. */
+interface Entry {
+  value: unknown;
+  gap: number;
+  moved: boolean;
+}
+
+function diffObjects(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  path: string,
+  ops: PatchOperation[],
+): void {
+  const fromKeys = Object.keys(from);
+  for (const key of fromKeys) {
+    if (!Object.hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+  }
+  for (const key of fromKeys) {
+    if (Object.hasOwn(to, key)) diff(from[key], to[key], `${path}/${escapeToken(key)}`, ops);
+  }
+  for (const key of Object.keys(to)) {
+    if (!Object.hasOwn(from, key)) ops.push({ op: "add", path: `${path}/${escapeToken(key)}`, value: clone(to[key]) });
+  }
+}
+
+/** Pairs of indices (into `from` and `to`) of a longest common subsequence of equal items. */
+function commonSubsequence(from: unknown[], to: unknown[]): Array<[number, number]> {
+  const n = from.length;
+  const m = to.length;
+  const lengths = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lengths[i][j] = jsonEqual(from[i], to[j])
+        ? lengths[i + 1][j + 1] + 1
+        : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  const pairs: Array<[number, number]> = [];
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (jsonEqual(from[i], to[j])) pairs.push([i++, j++]);
+    else if (lengths[i + 1][j] >= lengths[i][j + 1]) i++;
+    else j++;
+  }
+  return pairs;
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: PatchOperation[]): void {
+  // Matched items stay where they are; the others, grouped in the gaps between matches, change.
+  const matches = commonSubsequence(from, to);
+  matches.push([from.length, to.length]);
+
+  const working: Entry[] = from.map((value) => ({ value, gap: -1, moved: false }));
+  const fromGap = new Array<number>(from.length).fill(-1);
+  const toGap = new Array<number>(to.length).fill(-1);
+  let previous: [number, number] = [-1, -1];
+  matches.forEach(([i, j], gap) => {
+    for (let k = previous[0] + 1; k < i; k++) fromGap[k] = working[k].gap = gap;
+    for (let k = previous[1] + 1; k < j; k++) toGap[k] = gap;
+    previous = [i, j];
+  });
+
+  // An added item equal to a removed item that is not yet behind us is a move of that item.
+  const source = new Map<number, number>();
+  const taken = new Set<number>();
+  toGap.forEach((gap, a) => {
+    if (gap < 0) return;
+    const f = from.findIndex((item, k) => fromGap[k] >= gap && !taken.has(k) && jsonEqual(item, to[a]));
+    if (f >= 0) {
+      taken.add(f);
+      source.set(a, f);
+      working[f].moved = true;
+    }
+  });
+
+  let q = 0; // position in `working` of the next item of `to`
+  let a = 0;
+  matches.forEach(([i, j], gap) => {
+    for (; a < j; a++, q++) {
+      const at = `${path}/${q}`;
+      const f = source.get(a);
+      if (f !== undefined) {
+        const s = working.indexOf(working[f]);
+        if (s !== q) {
+          ops.push({ op: "move", from: `${path}/${s}`, path: at });
+          working.splice(q, 0, ...working.splice(s, 1));
+        }
+        working[q].moved = false;
+        working[q].gap = -1;
+      } else if (working[q] && working[q].gap === gap && !working[q].moved) {
+        diff(working[q].value, to[a], at, ops);
+        working[q] = { value: to[a], gap: -1, moved: false };
+      } else {
+        ops.push({ op: "add", path: at, value: clone(to[a]) });
+        working.splice(q, 0, { value: to[a], gap: -1, moved: false });
+      }
+    }
+    // What is left of this gap's removed items sits right before the matched item.
+    while (working[q] && working[q].gap === gap) {
+      ops.push({ op: "remove", path: `${path}/${q}` });
+      working.splice(q, 1);
+    }
+    q++;
+    a++;
+  });
+}
+
+function diff(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) diffArrays(from, to, path, ops);
+  else if (isObject(from) && isObject(to)) diffObjects(from, to, path, ops);
+  else if (!jsonEqual(from, to)) ops.push({ op: "replace", path, value: clone(to) });
+}
+
+/**
+ * Creates the JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only what
+ * changed. Neither argument is mutated and the patch shares no object or array with them.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
