+
+function checkPatch(from: unknown, to: unknown) {
+  const before = structuredClone([from, to]);
+  const patch = createPatch(from, to);
+  assert.deepEqual([from, to], before);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("createPatch: equal documents give an empty patch", () => {
+  assert.deepEqual(checkPatch({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("createPatch: nested change touches only that place", () => {
+  assert.deepEqual(checkPatch({ a: { b: 1, c: [1, 2] }, d: 4 }, { a: { b: 2, c: [1, 2] }, d: 4 }), [
+    { op: "replace", path: "/a/b", value: 2 },
+  ]);
+});
+
+test("createPatch: object members, escaping and root replacement", () => {
+  assert.deepEqual(checkPatch({ "a/b": 1, x: 1 }, { "a/b": 1, "m~n": 2 }), [
+    { op: "remove", path: "/x" },
+    { op: "add", path: "/m~0n", value: 2 },
+  ]);
+  assert.deepEqual(checkPatch([1], { a: 1 }), [{ op: "replace", path: "", value: { a: 1 } }]);
+  checkPatch(null, 1);
+  checkPatch({ a: null }, { a: [] });
+});
+
+test("createPatch: array insert and remove", () => {
+  assert.deepEqual(checkPatch([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(checkPatch([{ a: 1 }, { b: 2 }, { c: 3 }], [{ a: 1 }, { c: 3 }]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(checkPatch([], [1]), [{ op: "add", path: "/0", value: 1 }]);
+});
+
+test("createPatch: array move does not rewrite items in between", () => {
+  const patch = checkPatch(["a", "b", "c", "d", "e"], ["a", "c", "d", "e", "b"]);
+  assert.ok(patch.length <= 2);
+  assert.ok(patch.every((o) => o.op !== "replace"));
+  checkPatch(["a", "b", "c", "d", "e"], ["e", "a", "b", "c", "d"]);
+});
+
+test("createPatch: edited array items are patched in place; results share nothing", () => {
+  assert.deepEqual(checkPatch([{ a: 1 }, { a: 2 }], [{ a: 1 }, { a: 3 }]), [{ op: "replace", path: "/1/a", value: 3 }]);
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0].value as { b: number }).b = 5;
+  assert.equal(to.a.b, 1);
+});
+
+test("createPatch: randomized round trip", () => {
+  let seed = 7;
+  const rnd = (n: number) => (seed = (seed * 1103515245 + 12345) % 2147483648) % n;
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 3 : 5);
+    if (k === 0) return rnd(4);
+    if (k === 1) return ["x", "y", null][rnd(3)];
+    if (k === 2) return rnd(2) === 0;
+    if (k === 3) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => [["a", "b/", "~"][rnd(3)], gen(d + 1)]));
+  };
+  for (let i = 0; i < 2000; i++) checkPatch(gen(0), gen(0));
+});
