index c27ed63230a346ef3fec2fec1369b004587940e0..afbb8c9d64d558e2b0008536010d076fabf3aaac 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -239,3 +239,99 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+type PatchOperation = { op: "add" | "remove" | "replace"; path: string; value?: unknown };
+
+function isContainer(value: unknown): value is object {
+  return typeof value === "object" && value !== null;
+}
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Pairs of indices (in `a`, in `b`) of a longest common subsequence under deep equality. */
+function commonItems(a: unknown[], b: unknown[]): Array<[number, number]> {
+  const table: number[][] = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      table[i][j] = deepEqual(a[i], b[j]) ? table[i + 1][j + 1] + 1 : Math.max(table[i + 1][j], table[i][j + 1]);
+    }
+  }
+  const pairs: Array<[number, number]> = [];
+  let i = 0;
+  let j = 0;
+  while (i < a.length && j < b.length) {
+    if (deepEqual(a[i], b[j])) {
+      pairs.push([i++, j++]);
+    } else if (table[i + 1][j] >= table[i][j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && deepEqual(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && deepEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const midFrom = from.slice(start, endFrom);
+  const midTo = to.slice(start, endTo);
+  // Sentinel closes the last gap. Everything before target index `p` already equals the target.
+  const anchors = [...commonItems(midFrom, midTo), [midFrom.length, midTo.length] as [number, number]];
+  let prevFrom = 0;
+  let prevTo = 0;
+  for (const [i, j] of anchors) {
+    const removed = i - prevFrom;
+    const added = j - prevTo;
+    const paired = Math.min(removed, added);
+    const p = start + prevTo;
+    for (let t = 0; t < paired; t++) {
+      diffValues(midFrom[prevFrom + t], midTo[prevTo + t], `${path}/${p + t}`, ops);
+    }
+    for (let t = paired; t < removed; t++) {
+      ops.push({ op: "remove", path: `${path}/${p + paired}` });
+    }
+    for (let t = paired; t < added; t++) {
+      ops.push({ op: "add", path: `${path}/${p + t}`, value: structuredClone(midTo[prevTo + t]) });
+    }
+    prevFrom = i + 1;
+    prevTo = j + 1;
+  }
+}
+
+function diffValues(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isContainer(from) && isContainer(to) && !Array.isArray(from) && !Array.isArray(to)) {
+    const source = from as Record<string, unknown>;
+    const target = to as Record<string, unknown>;
+    for (const key of Object.keys(source)) {
+      if (!Object.hasOwn(target, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(target)) {
+      const childPath = `${path}/${escapeToken(key)}`;
+      if (!Object.hasOwn(source, key)) {
+        ops.push({ op: "add", path: childPath, value: structuredClone(target[key]) });
+      } else {
+        diffValues(source[key], target[key], childPath, ops);
+      }
+    }
+  } else if (!deepEqual(from, to)) {
+    ops.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/** Returns an RFC 6902 JSON Patch that turns `from` into `to`; neither input is mutated. */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffValues(from, to, "", ops);
+  return ops;
+}
