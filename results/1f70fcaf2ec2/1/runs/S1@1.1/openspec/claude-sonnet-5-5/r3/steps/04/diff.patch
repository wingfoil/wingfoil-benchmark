+
+test("applyMergePatch: RFC 7386 Appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("applyMergePatch: removing an absent member, nested nulls, null in arrays", () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, { b: null }), { a: 1 });
+  assert.deepEqual(applyMergePatch({}, { a: { b: null, c: 1 } }), { a: { c: 1 } });
+  assert.deepEqual(applyMergePatch({}, { a: [null] }), { a: [null] });
+  assert.deepEqual(applyMergePatch({ a: { b: 1, c: 2 } }, { a: { b: null, d: 3 } }), { a: { c: 2, d: 3 } });
+  assert.deepEqual(applyMergePatch(["a"], { b: 1 }), { b: 1 });
+  assert.deepEqual(applyMergePatch(5, { b: 1 }), { b: 1 });
+});
+
+test("applyMergePatch: does not mutate or share structure with inputs", () => {
+  const target = { a: { b: 1 }, l: [{ x: 1 }], keep: { k: 1 } };
+  const patch = { a: { c: 2 }, l: [{ y: 2 }], n: { m: 1 } };
+  const t0 = structuredClone(target);
+  const p0 = structuredClone(patch);
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, t0);
+  assert.deepEqual(patch, p0);
+  result.keep.k = 9;
+  result.l[0].y = 9;
+  result.n.m = 9;
+  assert.deepEqual(target, t0);
+  assert.deepEqual(patch, p0);
+});
+
+test("applyMergePatch: __proto__ and inherited names are safe", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"polluted":true}}')) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.getOwnPropertyDescriptor(result, "__proto__")?.value, { polluted: true });
+  assert.deepEqual(applyMergePatch({}, { constructor: { a: 1 } }), { constructor: { a: 1 } });
+  assert.deepEqual(applyMergePatch({}, { toString: null }), {});
+});
