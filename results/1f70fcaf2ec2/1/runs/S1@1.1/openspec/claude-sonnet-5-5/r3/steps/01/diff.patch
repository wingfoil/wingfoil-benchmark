@@ -0,0 +1,79 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "./index.ts";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("whole document of any type", () => {
+  for (const d of [null, 1, "s", [1], { a: 1 }]) assert.equal(resolvePointer(d, ""), d);
+});
+
+test("invalid syntax throws", () => {
+  const doc = { a: { b: 1 }, "a~2b": 1, "a~": 1 };
+  for (const p of ["a/b", "/a~2b", "/a~", "/~", "x"]) assert.throws(() => resolvePointer(doc, p), p);
+  assert.throws(() => resolvePointer(doc, undefined as unknown as string));
+  assert.throws(() => resolvePointer(doc, 1 as unknown as string));
+});
+
+test("escape order", () => {
+  assert.equal(resolvePointer({ "~1": 5 }, "/~01"), 5);
+});
+
+test("objects", () => {
+  assert.equal(resolvePointer({ foo: { bar: 1 } }, "/foo/bar"), 1);
+  for (const p of ["/b", "/toString", "/__proto__", "/constructor", "/hasOwnProperty"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), p);
+  }
+  assert.equal(resolvePointer(JSON.parse('{"__proto__": 3}'), "/__proto__"), 3);
+});
+
+test("arrays", () => {
+  assert.equal(resolvePointer({ a: ["x", "y"] }, "/a/1"), "y");
+  for (const p of ["/2", "/01", "/-1", "/+1", "/1.0", "/length", "/-", "/", "/ 1", "/1e0"]) {
+    assert.throws(() => resolvePointer(["x", "y"], p), p);
+  }
+});
+
+test("falsy values and scalars", () => {
+  const doc = { a: null, b: false, c: 0, d: "", s: "text" };
+  assert.equal(resolvePointer(doc, "/a"), null);
+  assert.equal(resolvePointer(doc, "/b"), false);
+  assert.equal(resolvePointer(doc, "/c"), 0);
+  assert.equal(resolvePointer(doc, "/d"), "");
+  for (const p of ["/s/0", "/s/length", "/a/x", "/c/x", "/b/x"]) {
+    assert.throws(() => resolvePointer(doc, p), p);
+  }
+});
+
+test("document is not modified", () => {
+  const doc = { a: [1, { b: 2 }] };
+  const copy = structuredClone(doc);
+  resolvePointer(doc, "/a/1/b");
+  assert.deepEqual(doc, copy);
+});
