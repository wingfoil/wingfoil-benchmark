+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) => assert.deepEqual(applyPatch(doc, patch), expected);
+const fails = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch), Error);
+
+test("patch validity", () => {
+  ok({ a: 1 }, [], { a: 1 });
+  fails({}, {});
+  fails({}, "x");
+  fails({}, [{ op: "merge", path: "/a", value: 1 }]);
+  fails({}, [{ path: "/a", value: 1 }]);
+  fails({}, [{ op: 1, path: "/a", value: 1 }]);
+  fails({}, [null]);
+  fails({}, [{ op: "add", value: 1 }]);
+  fails({}, [{ op: "add", path: "a", value: 1 }]);
+  fails({}, [{ op: "add", path: "/a" }]);
+  fails({}, [{ op: "replace", path: "/a" }]);
+  fails({ a: 1 }, [{ op: "test", path: "/a" }]);
+  fails({ a: 1 }, [{ op: "move", path: "/b" }]);
+  fails({ a: 1 }, [{ op: "copy", path: "/b", from: "x" }]);
+  fails({ a: 1 }, [{ op: "add", path: "/b", value: 1 }, { op: "nope", path: "/a" }]);
+  ok({}, [{ op: "add", path: "/a", value: null }], { a: null });
+  ok({ a: 1 }, [{ op: "remove", path: "/a", value: 5, extra: true }], {});
+});
+
+test("operations apply in order, input is not mutated", () => {
+  const doc = { a: 1, l: [1, { x: 1 }] };
+  const patch = [
+    { op: "add", path: "/b", value: { y: [1] } },
+    { op: "replace", path: "/b", value: { z: 3 } },
+    { op: "copy", from: "/l/1", path: "/c" },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const result = applyPatch(doc, patch) as any;
+  assert.deepEqual(result, { a: 1, l: [1, { x: 1 }], b: { z: 3 }, c: { x: 1 } });
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  result.l[1].x = 2;
+  result.b.z = 4;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.equal(result.c.x, 1);
+});
+
+test("add", () => {
+  ok({ a: 1 }, [{ op: "add", path: "/b", value: 2 }], { a: 1, b: 2 });
+  ok({ a: 1 }, [{ op: "add", path: "/a", value: 2 }], { a: 2 });
+  ok({ a: ["p", "q"] }, [{ op: "add", path: "/a/1", value: "x" }], { a: ["p", "x", "q"] });
+  ok({ a: ["p", "q"] }, [{ op: "add", path: "/a/-", value: "x" }], { a: ["p", "q", "x"] });
+  ok({ a: ["p", "q"] }, [{ op: "add", path: "/a/2", value: "x" }], { a: ["p", "q", "x"] });
+  for (const index of ["3", "01", "-1", "x", "1.5"]) {
+    fails({ a: ["p", "q"] }, [{ op: "add", path: `/a/${index}`, value: "x" }]);
+  }
+  fails({ a: 1 }, [{ op: "add", path: "/x/y", value: 1 }]);
+  fails({ a: 1 }, [{ op: "add", path: "/a/y", value: 1 }]);
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ "": 0 }, [{ op: "add", path: "/", value: 1 }], { "": 1 });
+});
+
+test("remove", () => {
+  ok({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }], { b: 2 });
+  ok({ a: ["p", "q"] }, [{ op: "remove", path: "/a/0" }], { a: ["q"] });
+  fails({ a: 1 }, [{ op: "remove", path: "/b" }]);
+  fails({ a: [1] }, [{ op: "remove", path: "/a/1" }]);
+  fails({ a: [1] }, [{ op: "remove", path: "/a/-" }]);
+  fails({ a: 1 }, [{ op: "remove", path: "" }]);
+});
+
+test("replace", () => {
+  ok({ a: [1, 2] }, [{ op: "replace", path: "/a/0", value: 9 }], { a: [9, 2] });
+  ok({ a: 1, b: 2 }, [{ op: "replace", path: "/a", value: 3 }], { a: 3, b: 2 });
+  assert.deepEqual(Object.keys(applyPatch({ a: 1, b: 2 }, [{ op: "replace", path: "/a", value: 3 }]) as object), ["a", "b"]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: 5 }], 5);
+  fails({ a: 1 }, [{ op: "replace", path: "/b", value: 1 }]);
+  fails({ a: [1] }, [{ op: "replace", path: "/a/1", value: 1 }]);
+  fails({ a: [1] }, [{ op: "replace", path: "/a/-", value: 1 }]);
+});
+
+test("move", () => {
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/b" }], { b: 1 });
+  ok({ a: ["p", "q", "r"] }, [{ op: "move", from: "/a/0", path: "/a/2" }], { a: ["q", "r", "p"] });
+  ok({ a: { b: 1 } }, [{ op: "move", from: "/a/b", path: "/c" }], { a: {}, c: 1 });
+  fails({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  fails({ a: 1 }, [{ op: "move", from: "", path: "/b" }]);
+  fails({ a: 1 }, [{ op: "move", from: "/x", path: "/b" }]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  fails({ a: 1 }, [{ op: "move", from: "/x", path: "/x" }]);
+  ok({ a: { b: 1 } }, [{ op: "move", from: "/a/b", path: "" }], 1);
+});
+
+test("copy", () => {
+  ok({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }], { a: { x: 1 }, b: { x: 1 } });
+  ok({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }, { op: "replace", path: "/b/x", value: 2 }], {
+    a: { x: 1 },
+    b: { x: 2 },
+  });
+  ok({ a: [1, 2] }, [{ op: "copy", from: "/a/0", path: "/a/-" }], { a: [1, 2, 1] });
+  fails({ a: 1 }, [{ op: "copy", from: "/x", path: "/b" }]);
+});
+
+test("test", () => {
+  ok({ a: { x: 1, y: 2 } }, [{ op: "test", path: "/a", value: { y: 2, x: 1 } }], { a: { x: 1, y: 2 } });
+  ok({ a: [1, { b: null }] }, [{ op: "test", path: "/a", value: [1, { b: null }] }], { a: [1, { b: null }] });
+  ok({ a: 1 }, [{ op: "test", path: "", value: { a: 1 } }], { a: 1 });
+  ok({ a: 1 }, [{ op: "test", path: "/a", value: 1.0 }], { a: 1 });
+  fails({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+  fails({ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]);
+  fails({ a: [1] }, [{ op: "test", path: "/a", value: [1, 2] }]);
+  fails({ a: { x: 1 } }, [{ op: "test", path: "/a", value: { x: 1, y: 2 } }]);
+  fails({ a: { x: 1, y: 2 } }, [{ op: "test", path: "/a", value: { x: 1 } }]);
+  fails({ a: null }, [{ op: "test", path: "/a", value: 0 }]);
+  fails({ a: 1 }, [{ op: "test", path: "/b", value: 1 }]);
+  fails({ a: 1 }, [{ op: "test", path: "/a", value: 2 }, { op: "add", path: "/b", value: 1 }]);
+});
+
+test("special member names", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as any;
+  assert.equal(Object.hasOwn(result, "__proto__"), true);
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  ok({ "a/b": 1, "m~n": 2 }, [{ op: "move", from: "/a~1b", path: "/m~0n" }], { "m~n": 1 });
+});
+
+test("RFC 6902 appendix A examples", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  ok({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  });
+  fails({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  fails({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" });
+});
