@@ -0,0 +1,199 @@
+import { parsePointer } from "./json-pointer.ts";
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const OPERATIONS = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+
+type Container = unknown[] | Record<string, unknown>;
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setMember(target: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty keeps names such as "__proto__" as plain own members
+  Object.defineProperty(target, key, { value, enumerable: true, writable: true, configurable: true });
+}
+
+function clone(value: unknown): unknown {
+  if (Array.isArray(value)) {
+    return value.map(clone);
+  }
+  if (isObject(value)) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) {
+      setMember(copy, key, clone(value[key]));
+    }
+    return copy;
+  }
+  return value;
+}
+
+function equal(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => equal(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) {
+      return false;
+    }
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((k) => Object.hasOwn(b, k) && equal(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** Finds the container holding the target of `tokens` (which must be non-empty); throws if it does not exist. */
+function parentOf(document: unknown, tokens: string[]): Container {
+  let current = document;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`no array element "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (isObject(current) && Object.hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`no member "${token}"`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new Error("the parent of the target is a scalar");
+  }
+  return current;
+}
+
+function get(document: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) {
+    return document;
+  }
+  const parent = parentOf(document, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= parent.length) {
+      throw new Error(`no array element "${token}"`);
+    }
+    return parent[Number(token)];
+  }
+  if (!Object.hasOwn(parent, token)) {
+    throw new Error(`no member "${token}"`);
+  }
+  return parent[token];
+}
+
+/** Each of these returns the new document (the root may be replaced). */
+function add(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = parentOf(document, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (token === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(token) && Number(token) <= parent.length) {
+      parent.splice(Number(token), 0, value);
+    } else {
+      throw new Error(`invalid array index "${token}"`);
+    }
+  } else {
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+function remove(document: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) {
+    throw new Error("cannot remove the whole document");
+  }
+  get(document, tokens); // the target must exist
+  const parent = parentOf(document, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(Number(token), 1);
+  } else {
+    delete parent[token];
+  }
+  return document;
+}
+
+function replace(document: unknown, tokens: string[], value: unknown): unknown {
+  get(document, tokens); // the target must exist
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = parentOf(document, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else {
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+function pointerTokens(operation: Record<string, unknown>, member: string): string[] {
+  const pointer = operation[member];
+  if (typeof pointer !== "string") {
+    throw new Error(`"${member}" must be a string`);
+  }
+  return parsePointer(pointer);
+}
+
+function applyOperation(document: unknown, operation: unknown): unknown {
+  if (!isObject(operation)) {
+    throw new Error("operation must be an object");
+  }
+  const op = operation.op;
+  if (typeof op !== "string" || !OPERATIONS.has(op)) {
+    throw new Error(`unknown or missing "op"`);
+  }
+  const path = pointerTokens(operation, "path");
+  const needsValue = op === "add" || op === "replace" || op === "test";
+  if (needsValue && !Object.hasOwn(operation, "value")) {
+    throw new Error(`"${op}" requires "value"`);
+  }
+  const from = op === "move" || op === "copy" ? pointerTokens(operation, "from") : [];
+
+  switch (op) {
+    case "add":
+      return add(document, path, clone(operation.value));
+    case "remove":
+      return remove(document, path);
+    case "replace":
+      return replace(document, path, clone(operation.value));
+    case "move": {
+      const value = get(document, from);
+      if (from.length < path.length && from.every((token, i) => token === path[i])) {
+        throw new Error("cannot move a value into one of its children");
+      }
+      if (from.length === path.length && from.every((token, i) => token === path[i])) {
+        return document;
+      }
+      return add(remove(document, from), path, value);
+    }
+    case "copy":
+      return add(document, path, clone(get(document, from)));
+    default:
+      if (!equal(get(document, path), operation.value)) {
+        throw new Error("test failed: values are not equal");
+      }
+      return document;
+  }
+}
+
+/** Applies an RFC 6902 JSON Patch to `document`, returning a new document; throws if the patch or an operation fails. */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: must be an array of operations");
+  }
+  let result = clone(document);
+  patch.forEach((operation, index) => {
+    try {
+      result = applyOperation(result, operation);
+    } catch (error) {
+      throw new Error(`JSON Patch operation ${index} failed: ${(error as Error).message}`);
+    }
+  });
+  return result;
+}
