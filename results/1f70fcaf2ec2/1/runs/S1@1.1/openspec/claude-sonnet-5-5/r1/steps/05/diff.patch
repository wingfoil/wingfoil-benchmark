index 0000000000000000000000000000000000000000..9ec6665227f24ead8a8357ce29668c9b949d0218
--- /dev/null
+++ b/src/create-patch.ts
@@ -0,0 +1,94 @@
+import { clone, equal, isObject } from "./json-patch.ts";
+
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: unknown };
+
+function escapeToken(token: string): string {
+  return token.replaceAll("~", "~0").replaceAll("/", "~1");
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: Operation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && equal(from[start], to[start])) {
+    start++;
+  }
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && equal(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+
+  // Longest common subsequence of the middle parts, as pairs of matching indices.
+  const n = endFrom - start;
+  const m = endTo - start;
+  const table: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      table[i][j] = equal(from[start + i], to[start + j])
+        ? table[i + 1][j + 1] + 1
+        : Math.max(table[i + 1][j], table[i][j + 1]);
+    }
+  }
+  const matches: [number, number][] = [];
+  for (let i = 0, j = 0; i < n && j < m; ) {
+    if (equal(from[start + i], to[start + j])) {
+      matches.push([start + i, start + j]);
+      i++;
+      j++;
+    } else if (table[i + 1][j] >= table[i][j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  matches.push([endFrom, endTo]); // sentinel closing the last gap
+
+  // Every item of `to` before index j is already in place, so j is the current position in the array.
+  let i = start;
+  let j = start;
+  for (const [mi, mj] of matches) {
+    const removed = mi - i;
+    const added = mj - j;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) {
+      diff(from[i + k], to[j + k], `${path}/${j + k}`, ops);
+    }
+    for (let k = paired; k < removed; k++) {
+      ops.push({ op: "remove", path: `${path}/${j + paired}` });
+    }
+    for (let k = paired; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${j + k}`, value: clone(to[j + k]) });
+    }
+    i = mi + 1;
+    j = mj + 1;
+  }
+}
+
+function diff(from: unknown, to: unknown, path: string, ops: Operation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(to, key)) {
+        diff(from[key], to[key], child, ops);
+      } else {
+        ops.push({ op: "remove", path: child });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      if (!Object.hasOwn(from, key)) {
+        ops.push({ op: "add", path: `${path}/${escapeToken(key)}`, value: clone(to[key]) });
+      }
+    }
+  } else if (!equal(from, to)) {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/** Creates a minimal RFC 6902 JSON Patch that turns `from` into `to`; neither input is mutated. */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const ops: Operation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
