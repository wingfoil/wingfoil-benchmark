+++ b/test/create-patch.test.ts
@@ -0,0 +1,69 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const f = structuredClone(from);
+  const t = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, f);
+  assert.deepEqual(to, t);
+  return patch;
+};
+
+test("objects and scalars", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, { a: 1 }), []);
+  assert.deepEqual(roundTrip({ a: { b: { c: 1, d: 2 } }, z: 1 }, { a: { b: { c: 9, d: 2 } }, z: 1 }), [
+    { op: "replace", path: "/a/b/c", value: 9 },
+  ]);
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, c: 3 }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+  assert.deepEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip({ a: null }, { a: {} }), [{ op: "replace", path: "/a", value: {} }]);
+  roundTrip(null, { a: 1 });
+});
+
+test("escaping and odd names", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "m~n": 1 }, { "a/b": 2, "m~n": 2 }).map((o) => o.path), ["/a~1b", "/m~0n"]);
+  const to = JSON.parse('{"__proto__":{"x":1}}');
+  roundTrip({}, to);
+});
+
+test("patch shares no structure with inputs", () => {
+  const to = { a: { b: [1] } };
+  const patch = createPatch({}, to);
+  (patch[0].value as { b: number[] }).b.push(2);
+  assert.deepEqual(to, { a: { b: [1] } });
+});
+
+test("arrays", () => {
+  assert.deepEqual(roundTrip([1, 2, 4], [1, 2, 3, 4]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [2, 3]), [{ op: "remove", path: "/0" }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 2]), [{ op: "remove", path: "/2" }]);
+  assert.deepEqual(roundTrip([{ id: 1, v: 1 }, { id: 2 }], [{ id: 1, v: 2 }, { id: 2 }]), [
+    { op: "replace", path: "/0/v", value: 2 },
+  ]);
+  const moved = roundTrip(["a", "b", "c", "d"], ["b", "c", "d", "a"]);
+  assert.ok(moved.length <= 2);
+  assert.deepEqual(moved, [{ op: "remove", path: "/0" }, { op: "add", path: "/3", value: "a" }]);
+});
+
+test("randomized round trip", () => {
+  let seed = 7;
+  const rnd = (n: number) => (seed = (seed * 1103515245 + 12345) % 2147483648) % n;
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 3 : 5);
+    if (k === 0) return rnd(4);
+    if (k === 1) return ["x", "y", null][rnd(3)];
+    if (k === 2) return rnd(2) === 0;
+    if (k === 3) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => [["a", "b/c", "~"][rnd(3)], gen(d + 1)]));
+  };
+  for (let i = 0; i < 3000; i++) {
+    roundTrip(gen(0), gen(0));
+  }
+});
