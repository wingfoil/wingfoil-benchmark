--- /dev/null
+++ b/src/json-pointer.ts
@@ -0,0 +1,44 @@
+const INVALID_ESCAPE = /~(?![01])/;
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: must be a string");
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (INVALID_ESCAPE.test(token)) {
+        throw new Error(`Invalid JSON Pointer "${pointer}": "~" must be followed by "0" or "1"`);
+      }
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/** Returns the value of `document` referred to by an RFC 6901 JSON Pointer; throws if invalid or unresolvable. */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const token of parsePointer(pointer)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`JSON Pointer "${pointer}" does not resolve: no array element "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new Error(`JSON Pointer "${pointer}" does not resolve: no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: cannot apply "${token}" to a scalar`);
+    }
+  }
+  return current;
+}
diff --git a/test/json-pointer.test.ts b/test/json-pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fbf4d091371d532ab146160533dad8e5a0f18dcb
--- /dev/null
+++ b/test/json-pointer.test.ts
@@ -0,0 +1,76 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("escape order: ~01 is the member ~1", () => {
+  assert.equal(resolvePointer({ "~1": 3 }, "/~01"), 3);
+});
+
+test("invalid syntax throws", () => {
+  for (const p of ["a/b", "foo", "/a~2b", "/a~", "/~"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), p);
+  }
+  assert.throws(() => resolvePointer({}, undefined as unknown as string));
+  assert.throws(() => resolvePointer({}, 1 as unknown as string));
+});
+
+test("falsy values are returned", () => {
+  const d = { a: null, b: false, c: 0, d: "" };
+  assert.equal(resolvePointer(d, "/a"), null);
+  assert.equal(resolvePointer(d, "/b"), false);
+  assert.equal(resolvePointer(d, "/c"), 0);
+  assert.equal(resolvePointer(d, "/d"), "");
+});
+
+test("digit-only member on object", () => {
+  assert.equal(resolvePointer({ "0": "x" }, "/0"), "x");
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+  assert.throws(() => resolvePointer([1], "/1"));
+  assert.throws(() => resolvePointer([1], "/-"));
+  for (const p of ["/01", "/+1", "/-1", "/1.0", "/a", "/"]) {
+    assert.throws(() => resolvePointer([1, 2], p), p);
+  }
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer("str", "/0"));
+});
+
+test("inherited properties do not resolve", () => {
+  for (const p of ["/constructor", "/__proto__", "/toString"]) {
+    assert.throws(() => resolvePointer({}, p), p);
+  }
+  for (const p of ["/length", "/constructor", "/__proto__"]) {
+    assert.throws(() => resolvePointer([], p), p);
+  }
+});
