+
+## Outcome
+
+Request: review `applyPatch` and make it conform to RFC 6902, errors included (§4, §5).
+
+- The whole patch is now validated (operation shape, `op`, `path`, `from`, `value`, pointer syntax) before any
+  operation is applied; previously an invalid later operation could be masked by an earlier failing one, an
+  unknown `op` with a bad pointer reported `SyntaxError`, and holes in a sparse patch array were silently skipped.
+- Tests added in `test/patch.test.ts`; `npm test` passes (32/32). README updated.
diff --git a/src/index.ts b/src/index.ts
index 8a5e5ebaa2cf789690a66c99450f90a0e67ac976..1cd9786f4021b912ac47699d6d18c9ace91aa1dc 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -161,18 +161,13 @@ export function applyPatch(document: unknown, patch: unknown): JsonValue {
   if (!Array.isArray(patch)) {
     throw new TypeError("Invalid JSON Patch: must be an array of operations");
   }
+  // §4: the patch must be a valid JSON Patch document before any operation runs, so an invalid
+  // operation is reported as such whatever the earlier operations would have done. Index loop: a
+  // sparse array hole is not an operation, and forEach would skip it.
+  const prepared: Prepared[] = [];
+  for (let index = 0; index < patch.length; index++) prepared.push(prepare(patch[index], index));
   let root = clone(document);
-  patch.forEach((raw: unknown, index: number) => {
-    if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
-      throw new TypeError(`Invalid JSON Patch: operation ${index} must be an object`);
-    }
-    const operation = raw as Record<string, unknown>;
-    const op = Object.hasOwn(operation, "op") ? operation.op : undefined;
-    if (typeof op !== "string") {
-      throw new TypeError(`Invalid JSON Patch: operation ${index} needs a string "op"`);
-    }
-    const path = pointerMember(operation, "path", index);
-    const tokens = parseTokens(path);
+  for (const { op, operation, index, path, tokens } of prepared) {
     switch (op) {
       case "add":
         root = addAt(root, tokens, path, valueMember(operation, index));
@@ -207,9 +202,36 @@ export function applyPatch(document: unknown, patch: unknown): JsonValue {
           throw new Error(`JSON Patch: test failed at ${JSON.stringify(path)}`);
         }
         break;
-      default:
-        throw new TypeError(`Invalid JSON Patch: operation ${index} has unknown op ${JSON.stringify(op)}`);
     }
-  });
+  }
   return root;
 }
+
+interface Prepared {
+  op: string;
+  operation: Record<string, unknown>;
+  index: number;
+  path: string;
+  tokens: string[];
+}
+
+const OPERATIONS = ["add", "remove", "replace", "move", "copy", "test"];
+
+/** Validates the shape of one operation (RFC 6902 §4) and parses its pointers. */
+function prepare(raw: unknown, index: number): Prepared {
+  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+    throw new TypeError(`Invalid JSON Patch: operation ${index} must be an object`);
+  }
+  const operation = raw as Record<string, unknown>;
+  const op = Object.hasOwn(operation, "op") ? operation.op : undefined;
+  if (typeof op !== "string") {
+    throw new TypeError(`Invalid JSON Patch: operation ${index} needs a string "op"`);
+  }
+  if (!OPERATIONS.includes(op)) {
+    throw new TypeError(`Invalid JSON Patch: operation ${index} has unknown op ${JSON.stringify(op)}`);
+  }
+  const path = pointerMember(operation, "path", index);
+  if (op === "add" || op === "replace" || op === "test") valueMember(operation, index);
+  if (op === "move" || op === "copy") parseTokens(pointerMember(operation, "from", index));
+  return { op, operation, index, path, tokens: parseTokens(path) };
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
index e8d35d38644a8ccb86c9f67eab40f32310b36134..1d5496030190335d5271d819246cf5a0e2162d53 100644
--- a/test/patch.test.ts
+++ b/test/patch.test.ts
@@ -143,3 +143,14 @@ test("no prototype pollution", () => {
   assert.equal(copy.a, undefined);
   assert.ok(Object.hasOwn(copy, "__proto__"));
 });
+
+test("RFC 6902 §4: invalid patch is rejected before any operation runs", () => {
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/x", value: 1 }, { op: "bogus", path: "/x" }]), TypeError);
+  assert.throws(() => applyPatch({}, [{ op: "bogus", path: "bad" }]), TypeError);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/x" }, { op: "add", path: "/y" }]), TypeError);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/x" }, { op: "move", path: "/y" }]), TypeError);
+});
+test("RFC 6902 §4: a hole in the patch array is not an operation", () => {
+  // eslint-disable-next-line no-sparse-arrays
+  assert.throws(() => applyPatch({}, [, { op: "add", path: "/a", value: 1 }]), TypeError);
+});
