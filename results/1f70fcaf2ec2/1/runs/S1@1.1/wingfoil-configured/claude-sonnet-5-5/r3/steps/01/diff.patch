+++ b/src/index.ts
@@ -0,0 +1,58 @@
+/** A parsed JSON value. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Splits a pointer into unescaped reference tokens (RFC 6901 §3, §4). */
+function parseTokens(pointer: string): string[] {
+  if (pointer === "") return [];
+  if (!pointer.startsWith("/")) {
+    throw new SyntaxError(`Invalid JSON Pointer: must be empty or start with "/": ${JSON.stringify(pointer)}`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new SyntaxError(`Invalid JSON Pointer: "~" must be followed by 0 or 1: ${JSON.stringify(pointer)}`);
+      }
+      // §4: "~1" first, then "~0", so that "~01" yields "~1" and not "/".
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document and returns the referenced value.
+ *
+ * The empty pointer refers to the whole document. Only own members of objects and indices of arrays
+ * resolve; the "-" array token (§4) refers to a nonexistent element and therefore never resolves.
+ * The document is not mutated.
+ *
+ * @throws {SyntaxError} when `pointer` is not a valid JSON Pointer (§3).
+ * @throws {Error} when `pointer` does not resolve to a value of `document` (§4).
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new TypeError("Invalid JSON Pointer: must be a string");
+  }
+  let current: unknown = document;
+  for (const token of parseTokens(pointer)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`JSON Pointer ${JSON.stringify(pointer)} does not resolve: no array element ${JSON.stringify(token)}`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null && Object.hasOwn(current, token)) {
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer ${JSON.stringify(pointer)} does not resolve: no member ${JSON.stringify(token)}`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..36822f3e70c739bf8f0be9fc0415e19ca15bbabb
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,83 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// RFC 6901 §5 example document.
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 §5 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("escape order: ~01 is the token ~1", () => {
+  assert.equal(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+});
+
+test("null values and falsy values resolve", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer([false], "/0"), false);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("document with empty-name nested members", () => {
+  assert.equal(resolvePointer({ "": { "": 1 } }, "//"), 1);
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["foo", "a/b", "/~", "/~2", "/a~", "/~a"]) {
+    assert.throws(() => resolvePointer({ foo: 1 }, p), SyntaxError, p);
+  }
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer(doc, "/nope"));
+  assert.throws(() => resolvePointer(doc, "/foo/2"));
+  assert.throws(() => resolvePointer(doc, "/foo/-"));
+  assert.throws(() => resolvePointer(doc, "/foo/00"));
+  assert.throws(() => resolvePointer(doc, "/foo/01"));
+  assert.throws(() => resolvePointer(doc, "/foo/+1"));
+  assert.throws(() => resolvePointer(doc, "/foo/1.0"));
+  assert.throws(() => resolvePointer(doc, "/foo/length"));
+  assert.throws(() => resolvePointer(doc, "/foo/bar"));
+  assert.throws(() => resolvePointer(doc, "/foo/0/x"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+  assert.throws(() => resolvePointer([], "/"));
+});
+
+test("inherited properties never resolve", () => {
+  for (const p of ["/__proto__", "/constructor", "/toString", "/hasOwnProperty", "/__proto__/x"]) {
+    assert.throws(() => resolvePointer({}, p), p);
+  }
+  const parsed = JSON.parse('{"__proto__": 5}');
+  assert.equal(resolvePointer(parsed, "/__proto__"), 5);
+});
+
+test("document is not mutated", () => {
+  const d = { a: [1, { b: 2 }] };
+  const copy = structuredClone(d);
+  resolvePointer(d, "/a/1/b");
+  assert.deepEqual(d, copy);
+});
