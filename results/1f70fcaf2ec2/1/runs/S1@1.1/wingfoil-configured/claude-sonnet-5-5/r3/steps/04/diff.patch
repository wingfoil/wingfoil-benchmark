diff --git a/src/index.ts b/src/index.ts
index 1cd9786f4021b912ac47699d6d18c9ace91aa1dc..f0efe92516e946d45aced470f017a0aefd50b233 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -235,3 +235,26 @@ function prepare(raw: unknown, index: number): Prepared {
   if (op === "move" || op === "copy") parseTokens(pointerMember(operation, "from", index));
   return { op, operation, index, path, tokens: parseTokens(path) };
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386 §2) to `target` and returns the merged document as a new value.
+ *
+ * An object patch merges member by member: `null` removes the member, any other value is merged
+ * recursively into the existing member. A patch that is not an object (including an array) replaces
+ * the target. A non-object target is treated as an empty object when the patch is an object.
+ * Neither argument is mutated and the result shares no structure with either; `__proto__` is a plain member name.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
+  if (typeof patch !== "object" || patch === null || Array.isArray(patch)) return clone(patch);
+  const result: Record<string, JsonValue> =
+    typeof target === "object" && target !== null && !Array.isArray(target) ? (clone(target) as Record<string, JsonValue>) : {};
+  for (const key of Object.keys(patch)) {
+    const value = (patch as Record<string, unknown>)[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(Object.hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
diff --git a/test/merge-patch.test.ts b/test/merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9118f7d2fa1f172cf32eaf94d7867065163c4a50
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,48 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 §3 example", () => {
+  const target = { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["example", "sample"], content: "This will be unchanged" };
+  const patch = { title: "Hello!", phoneNumber: "+01-123-456-7890", author: { familyName: null }, tags: ["example"] };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!", author: { givenName: "John" }, tags: ["example"], content: "This will be unchanged", phoneNumber: "+01-123-456-7890",
+  });
+});
+test("RFC 7386 Appendix A cases", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, e] of cases) assert.deepEqual(applyMergePatch(t, p), e);
+});
+test("does not mutate or share structure", () => {
+  const target = { a: { b: 1 } };
+  const patch = { c: { d: [1] } };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 } });
+  assert.notEqual(result.a, target.a);
+  assert.notEqual(result.c, patch.c);
+  assert.notEqual(result.c.d, patch.c.d);
+});
+test("__proto__ is a plain member", () => {
+  const patch = JSON.parse('{"__proto__":{"x":1}}');
+  const result = applyMergePatch({}, patch) as any;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as any).x, undefined);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.deepEqual(applyMergePatch(result, JSON.parse('{"__proto__":null}')), {});
+});
