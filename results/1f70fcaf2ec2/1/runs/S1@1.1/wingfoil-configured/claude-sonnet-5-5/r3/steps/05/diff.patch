+
+/** Escapes a member name as a JSON Pointer reference token (RFC 6901 §3, §5). */
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+type Operation = { op: "add" | "replace"; path: string; value: JsonValue } | { op: "remove"; path: string };
+
+/** Appends to `out` the operations turning `a` into `b`, both found at `path` (RFC 6902 §4). */
+function diffValue(a: unknown, b: unknown, path: string, out: Operation[]): void {
+  if (jsonEqual(a, b)) return;
+  if (Array.isArray(a) && Array.isArray(b)) {
+    diffArray(a, b, path, out);
+  } else if (
+    typeof a === "object" && a !== null && !Array.isArray(a) &&
+    typeof b === "object" && b !== null && !Array.isArray(b)
+  ) {
+    const from = a as Record<string, unknown>;
+    const to = b as Record<string, unknown>;
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(from, key)) diffValue(from[key], to[key], child, out);
+      else out.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+  } else {
+    out.push({ op: "replace", path, value: clone(b) });
+  }
+}
+
+/**
+ * Diffs two arrays: items common to both (longest common subsequence) are left alone; between them,
+ * items are paired up and diffed in place, and the surplus is removed or added. Indices are those of
+ * the array as already patched, since operations apply in order.
+ */
+function diffArray(a: unknown[], b: unknown[], path: string, out: Operation[]): void {
+  let start = 0;
+  while (start < a.length && start < b.length && jsonEqual(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && jsonEqual(a[endA - 1], b[endB - 1])) { endA--; endB--; }
+
+  const n = endA - start;
+  const m = endB - start;
+  // lcs[i][j]: length of the longest common subsequence of a[start+i..endA) and b[start+j..endB).
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(a[start + i], b[start + j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  let index = start; // position in the array being patched
+  let i = 0;
+  let j = 0;
+  const flush = (ai: number, bj: number): void => {
+    const common = Math.min(ai - i, bj - j);
+    for (let k = 0; k < common; k++) diffValue(a[start + i + k], b[start + j + k], `${path}/${index + k}`, out);
+    for (let k = common; k < ai - i; k++) out.push({ op: "remove", path: `${path}/${index + common}` });
+    for (let k = common; k < bj - j; k++) {
+      out.push({ op: "add", path: `${path}/${index + k}`, value: clone(b[start + j + k]) });
+    }
+    index += bj - j;
+    i = ai;
+    j = bj;
+  };
+  let ai = 0;
+  let bj = 0;
+  while (ai < n && bj < m) {
+    if (jsonEqual(a[start + ai], b[start + bj])) {
+      flush(ai, bj);
+      ai++; bj++; i = ai; j = bj; index++;
+    } else if (lcs[ai + 1][bj] >= lcs[ai][bj + 1]) {
+      ai++;
+    } else {
+      bj++;
+    }
+  }
+  flush(n, m);
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only what changed.
+ * Neither argument is mutated and the patch shares no structure with either.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const out: Operation[] = [];
+  diffValue(from, to, "", out);
+  return out;
+}
