+
+/** Sets an own data member without ever invoking the `__proto__` setter. */
+function setMember(target: object, key: string, value: unknown): void {
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Deep copy of a JSON value; own `__proto__` members are copied as plain members. */
+function clone(value: unknown): JsonValue {
+  if (Array.isArray(value)) return value.map(clone);
+  if (typeof value === "object" && value !== null) {
+    const copy: Record<string, JsonValue> = {};
+    for (const key of Object.keys(value)) setMember(copy, key, clone((value as Record<string, unknown>)[key]));
+    return copy;
+  }
+  return value as JsonValue;
+}
+
+/** JSON equality (RFC 6902 §4.6): member order is irrelevant, numbers compare by value. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (typeof a === "object" && a !== null && typeof b === "object" && b !== null) {
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((k) => Object.hasOwn(b, k) && jsonEqual((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]))
+    );
+  }
+  return a === b;
+}
+
+/** Splits a path into the tokens of its parent and its last token; `null` for the whole document. */
+function splitTarget(tokens: string[]): { parent: string[]; last: string } | null {
+  return tokens.length === 0 ? null : { parent: tokens.slice(0, -1), last: tokens[tokens.length - 1] };
+}
+
+/** Adds `value` at `tokens` in `root` (mutating the working copy `root`); returns the new root. */
+function addAt(root: JsonValue, tokens: string[], path: string, value: JsonValue): JsonValue {
+  const target = splitTarget(tokens);
+  if (target === null) return value;
+  const parent = walk(root, target.parent, path);
+  if (Array.isArray(parent)) {
+    if (target.last === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(target.last) && Number(target.last) <= parent.length) {
+      parent.splice(Number(target.last), 0, value);
+    } else {
+      throw new Error(`JSON Patch: invalid array index ${JSON.stringify(target.last)} in ${JSON.stringify(path)}`);
+    }
+  } else if (typeof parent === "object" && parent !== null) {
+    setMember(parent, target.last, value);
+  } else {
+    throw new Error(`JSON Patch: parent of ${JSON.stringify(path)} is not an object or array`);
+  }
+  return root;
+}
+
+/** Removes the value at `tokens` (which must exist); returns the new root and the removed value. */
+function removeAt(root: JsonValue, tokens: string[], path: string): { root: JsonValue; removed: JsonValue } {
+  const target = splitTarget(tokens);
+  const removed = walk(root, tokens, path) as JsonValue;
+  if (target === null) return { root: null, removed };
+  const parent = walk(root, target.parent, path);
+  if (Array.isArray(parent)) parent.splice(Number(target.last), 1);
+  else delete (parent as Record<string, JsonValue>)[target.last];
+  return { root, removed };
+}
+
+function pointerMember(operation: Record<string, unknown>, name: "path" | "from", index: number): string {
+  const value = Object.hasOwn(operation, name) ? operation[name] : undefined;
+  if (typeof value !== "string") {
+    throw new TypeError(`Invalid JSON Patch: operation ${index} needs a string "${name}"`);
+  }
+  return value;
+}
+
+function valueMember(operation: Record<string, unknown>, index: number): JsonValue {
+  if (!Object.hasOwn(operation, "value") || operation.value === undefined) {
+    throw new TypeError(`Invalid JSON Patch: operation ${index} needs a "value"`);
+  }
+  return clone(operation.value);
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result as a new value.
+ *
+ * Operations run in order on a private copy, so neither `document` nor `patch` is mutated, the result
+ * shares no structure with either, and a failing patch leaves no partial effect (§5).
+ *
+ * @throws {TypeError} when `patch` is not a valid JSON Patch document (§4): not an array, an operation
+ *   that is not an object, a missing or unknown `op`, or a missing/ill-typed `path`, `from` or `value`.
+ * @throws {SyntaxError} when a `path` or `from` is not a valid JSON Pointer (RFC 6901 §3).
+ * @throws {Error} when an operation fails: the target does not exist, an array index is out of range,
+ *   the parent is a primitive, `move` into its own child, or a `test` that does not hold.
+ */
+export function applyPatch(document: unknown, patch: unknown): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new TypeError("Invalid JSON Patch: must be an array of operations");
+  }
+  let root = clone(document);
+  patch.forEach((raw: unknown, index: number) => {
+    if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+      throw new TypeError(`Invalid JSON Patch: operation ${index} must be an object`);
+    }
+    const operation = raw as Record<string, unknown>;
+    const op = Object.hasOwn(operation, "op") ? operation.op : undefined;
+    if (typeof op !== "string") {
+      throw new TypeError(`Invalid JSON Patch: operation ${index} needs a string "op"`);
+    }
+    const path = pointerMember(operation, "path", index);
+    const tokens = parseTokens(path);
+    switch (op) {
+      case "add":
+        root = addAt(root, tokens, path, valueMember(operation, index));
+        break;
+      case "remove":
+        root = removeAt(root, tokens, path).root;
+        break;
+      case "replace": {
+        const value = valueMember(operation, index);
+        walk(root, tokens, path); // §4.3: the target must exist
+        root = addAt(removeAt(root, tokens, path).root, tokens, path, value);
+        break;
+      }
+      case "move":
+      case "copy": {
+        const from = pointerMember(operation, "from", index);
+        const fromTokens = parseTokens(from);
+        if (op === "copy") {
+          root = addAt(root, tokens, path, clone(walk(root, fromTokens, from)));
+          break;
+        }
+        // §4.4: "from" must not be a proper prefix of "path".
+        if (fromTokens.length < tokens.length && fromTokens.every((t, i) => t === tokens[i])) {
+          throw new Error(`JSON Patch: cannot move ${JSON.stringify(from)} into its own child ${JSON.stringify(path)}`);
+        }
+        const moved = removeAt(root, fromTokens, from);
+        root = addAt(moved.root, tokens, path, moved.removed);
+        break;
+      }
+      case "test":
+        if (!jsonEqual(walk(root, tokens, path), valueMember(operation, index))) {
+          throw new Error(`JSON Patch: test failed at ${JSON.stringify(path)}`);
+        }
+        break;
+      default:
+        throw new TypeError(`Invalid JSON Patch: operation ${index} has unknown op ${JSON.stringify(op)}`);
+    }
+  });
+  return root;
+}
