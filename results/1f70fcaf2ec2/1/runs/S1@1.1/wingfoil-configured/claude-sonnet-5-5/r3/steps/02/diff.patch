@@ -0,0 +1,145 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) => assert.deepEqual(applyPatch(doc, patch), expected);
+
+test("RFC 6902 A.1 adding an object member", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+});
+test("RFC 6902 A.2 adding an array element", () => {
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+});
+test("RFC 6902 A.3 removing an object member", () => {
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+});
+test("RFC 6902 A.4 removing an array element", () => {
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+});
+test("RFC 6902 A.5 replacing a value", () => {
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+});
+test("RFC 6902 A.6 moving a value", () => {
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+});
+test("RFC 6902 A.7 moving an array element", () => {
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+});
+test("RFC 6902 A.8/A.9 testing values", () => {
+  ok({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  });
+  assert.throws(() => applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]));
+});
+test("RFC 6902 A.10 adding a nested member object", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+});
+test("RFC 6902 A.11 ignoring unrecognized elements", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" });
+});
+test("RFC 6902 A.12/A.13/A.14/A.15 failures", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]));
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", op2: 1 }, { op: "bar" }]));
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", op: "bar" }]));
+  assert.throws(() => applyPatch({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "9" }]));
+});
+test("RFC 6902 A.16 adding an array value", () => {
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] });
+});
+
+test("add: whole document, replace member, append, bounds", () => {
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "add", path: "/a", value: 2 }], { a: 2 });
+  ok([1], [{ op: "add", path: "/1", value: 2 }], [1, 2]);
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/2", value: 2 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/01", value: 2 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/-1", value: 2 }]));
+  assert.throws(() => applyPatch(1, [{ op: "add", path: "/a", value: 2 }]));
+});
+test("add: null value is allowed, missing value is not", () => {
+  ok({}, [{ op: "add", path: "/a", value: null }], { a: null });
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]), TypeError);
+});
+test("remove and replace require an existing target", () => {
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/-", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/1" }]));
+  ok({ a: 1 }, [{ op: "replace", path: "", value: 5 }], 5);
+  ok([1, 2], [{ op: "replace", path: "/0", value: 9 }], [9, 2]);
+  ok({ a: 1 }, [{ op: "remove", path: "" }], null);
+});
+test("move: same location, missing source, into own child", () => {
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/a", path: "/b" }]));
+  assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", path: "/b" }]), TypeError);
+});
+test("copy duplicates deeply", () => {
+  const result = applyPatch({ a: { b: [1] } }, [{ op: "copy", from: "/a", path: "/c" }, { op: "add", path: "/c/b/-", value: 2 }]) as any;
+  assert.deepEqual(result, { a: { b: [1] }, c: { b: [1, 2] } });
+  assert.throws(() => applyPatch({}, [{ op: "copy", from: "/a", path: "/b" }]));
+});
+test("test: deep equality ignores member order, distinguishes types", () => {
+  const doc = { a: { x: 1, y: [1, { z: null }] }, n: 1 };
+  ok(doc, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }], doc);
+  ok(doc, [{ op: "test", path: "", value: doc }], doc);
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/n", value: "1" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a", value: { x: 1 } }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/y", value: [1] }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/y", value: {} }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/missing", value: null }]));
+});
+test("invalid patches throw", () => {
+  for (const bad of [null, {}, "x", [1], [null], [[]], [{}], [{ op: "add" }], [{ op: "nope", path: "" }], [{ op: 1, path: "" }], [{ op: "remove", path: 1 }]]) {
+    assert.throws(() => applyPatch({}, bad), TypeError);
+  }
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "a" }]), SyntaxError);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/~2" }]), SyntaxError);
+});
+test("empty patch returns an equal copy", () => {
+  const doc = { a: [1] };
+  const result = applyPatch(doc, []);
+  assert.deepEqual(result, doc);
+  assert.notEqual(result, doc);
+});
+test("does not mutate input or alias document and patch", () => {
+  const doc = { a: { b: [1, 2] }, c: 1 };
+  const snapshot = structuredClone(doc);
+  const value = { v: [1] };
+  const patch = [
+    { op: "add", path: "/a/b/0", value: 0 },
+    { op: "move", from: "/c", path: "/d" },
+    { op: "add", path: "/e", value },
+    { op: "remove", path: "/a/b/1" },
+  ];
+  const patchSnapshot = structuredClone(patch);
+  const result = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, snapshot);
+  assert.deepEqual(patch, patchSnapshot);
+  assert.notEqual(result.e, value);
+  result.a.b.push(9);
+  assert.deepEqual(doc, snapshot);
+  assert.throws(() => applyPatch(doc, [{ op: "remove", path: "/c" }, { op: "remove", path: "/zz" }]));
+  assert.deepEqual(doc, snapshot);
+});
+test("no prototype pollution", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.ok(Object.hasOwn(result, "__proto__"));
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/__proto__" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/constructor/prototype/x", value: 1 }]));
+  assert.equal(({} as any).x, undefined);
+  const parsed = JSON.parse('{"__proto__":{"a":1}}');
+  const copy = applyPatch(parsed, []) as any;
+  assert.equal(copy.a, undefined);
+  assert.ok(Object.hasOwn(copy, "__proto__"));
+});
