diff --git a/test/patch.test.ts b/test/patch.test.ts
index adaed6c880a7fb3549d237088b276694ee58feec..7c260a998e84adeb7e8149949679f7135276f4f0 100644
--- a/test/patch.test.ts
+++ b/test/patch.test.ts
@@ -133,3 +133,17 @@ test("__proto__ and constructor keys do not pollute prototypes", () => {
   assert.equal(Object.getPrototypeOf(copy), Object.prototype);
   assert.equal(copy.a, undefined);
 });
+
+// RFC 6902 section 4: each operation object is an object with its own "op" and "path" members.
+test("a hole in a sparse patch array is an invalid operation", () => {
+  // eslint-disable-next-line no-sparse-arrays
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: 1 }, , ]));
+  assert.throws(() => applyPatch({}, new Array(1)));
+});
+
+test("inherited members of an operation are not read", () => {
+  const inherited = Object.create({ op: "add", path: "/a", value: 1 });
+  assert.throws(() => applyPatch({}, [inherited]));
+  const op = Object.assign(Object.create({ path: "/a" }), { op: "add", value: 1 });
+  assert.throws(() => applyPatch({}, [op]));
+});
