index d5c93d39630db0b31015efe7b191d051c3d19a33..2d76c1221dfbd2be7ed5d49aa1d4762e1f4a0077 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -51,3 +51,216 @@ function step(value: unknown, token: string, pointer: string): unknown {
   }
   throw new Error(`JSON Pointer "${pointer}" does not resolve: cannot traverse a primitive value`);
 }
+
+type Container = unknown[] | Record<string, unknown>;
+
+/** Splits a JSON Pointer into its decoded reference tokens (RFC 6901 section 4). */
+function parseTokens(pointer: string): string[] {
+  if (pointer === "") {
+    return [];
+  }
+  if (pointer[0] !== "/") {
+    throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((raw) => unescapeToken(raw, pointer));
+}
+
+/** Deep-copies a JSON value; members are defined, not assigned, so a `__proto__` key stays an own member. */
+function clone(value: unknown): unknown {
+  if (Array.isArray(value)) {
+    return value.map(clone);
+  }
+  if (typeof value === "object" && value !== null) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) {
+      setMember(copy, key, clone((value as Record<string, unknown>)[key]));
+    }
+    return copy;
+  }
+  return value;
+}
+
+function setMember(target: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Parses an array index token (RFC 6901 section 4): `0` or digits without leading zeros. */
+function parseIndex(token: string, path: string): number {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`Invalid path "${path}": "${token}" is not an array index`);
+  }
+  return Number(token);
+}
+
+/** Returns the container holding the target of `tokens` (all but the last token must exist). */
+function parentOf(root: unknown, tokens: string[], path: string): Container {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      const index = parseIndex(token, path);
+      if (index >= current.length) {
+        throw new Error(`Path "${path}" does not exist: index ${token} is out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null && Object.hasOwn(current, token)) {
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`Path "${path}" does not exist at "${token}"`);
+    }
+  }
+  if (typeof current !== "object" || current === null) {
+    throw new Error(`Path "${path}" does not exist: parent is not an object or array`);
+  }
+  return current as Container;
+}
+
+function getValue(root: unknown, path: string): unknown {
+  return resolvePointer(root, path);
+}
+
+/** RFC 6902 section 4.1 (add) and 4.3 (replace of a missing member is an error, handled by the caller). */
+function addValue(root: unknown, path: string, value: unknown): unknown {
+  const tokens = parseTokens(path);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = parentOf(root, tokens, path);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (token === "-") {
+      parent.push(value);
+      return root;
+    }
+    const index = parseIndex(token, path);
+    if (index > parent.length) {
+      throw new Error(`Cannot add at "${path}": index ${token} is out of range`);
+    }
+    parent.splice(index, 0, value);
+  } else {
+    setMember(parent, token, value);
+  }
+  return root;
+}
+
+/** RFC 6902 section 4.2 (remove); the target must exist. */
+function removeValue(root: unknown, path: string): unknown {
+  const tokens = parseTokens(path);
+  if (tokens.length === 0) {
+    throw new Error("Cannot remove the root of the document");
+  }
+  getValue(root, path);
+  const parent = parentOf(root, tokens, path);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(parseIndex(token, path), 1);
+  } else {
+    delete (parent as Record<string, unknown>)[token];
+  }
+  return root;
+}
+
+/** JSON equality as RFC 6902 section 4.6: objects ignore member order, arrays do not. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (typeof a === "object" && a !== null && typeof b === "object" && b !== null) {
+    const keysA = Object.keys(a);
+    return (
+      keysA.length === Object.keys(b).length &&
+      keysA.every(
+        (k) =>
+          Object.hasOwn(b, k) && jsonEqual((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]),
+      )
+    );
+  }
+  return a === b;
+}
+
+function member(operation: Record<string, unknown>, name: string, index: number): string {
+  const value = operation[name];
+  if (typeof value !== "string") {
+    throw new Error(`Invalid patch: operation ${index} needs a string "${name}" member`);
+  }
+  return value;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document.
+ *
+ * @param document - The JSON value to patch; it is not mutated.
+ * @param patch - An array of operations (`add`, `remove`, `replace`, `move`, `copy`, `test`), applied in order.
+ * @returns The patched document, as a new value that shares no structure with `document` or `patch`.
+ * @throws {Error} If `patch` is not a valid JSON Patch, or an operation fails (RFC 6902 section 5).
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid patch: must be an array of operations");
+  }
+  let result = clone(document);
+  patch.forEach((raw: unknown, i: number) => {
+    if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+      throw new Error(`Invalid patch: operation ${i} is not an object`);
+    }
+    const operation = raw as Record<string, unknown>;
+    const op = member(operation, "op", i);
+    const path = member(operation, "path", i);
+    parseTokens(path);
+    const needsValue = op === "add" || op === "replace" || op === "test";
+    if (needsValue && !Object.hasOwn(operation, "value")) {
+      throw new Error(`Invalid patch: operation ${i} (${op}) needs a "value" member`);
+    }
+    switch (op) {
+      case "add":
+        result = addValue(result, path, clone(operation.value));
+        break;
+      case "remove":
+        result = removeValue(result, path);
+        break;
+      case "replace":
+        getValue(result, path);
+        result = parseTokens(path).length === 0 ? clone(operation.value) : replaceValue(result, path, clone(operation.value));
+        break;
+      case "move": {
+        const from = member(operation, "from", i);
+        const fromTokens = parseTokens(from);
+        const pathTokens = parseTokens(path);
+        const value = getValue(result, from);
+        if (pathTokens.length > fromTokens.length && fromTokens.every((t, k) => t === pathTokens[k])) {
+          throw new Error(`Cannot move "${from}" into its own child "${path}"`);
+        }
+        if (from !== path) {
+          result = addValue(removeValue(result, from), path, value);
+        }
+        break;
+      }
+      case "copy":
+        result = addValue(result, path, clone(getValue(result, member(operation, "from", i))));
+        break;
+      case "test":
+        if (!jsonEqual(getValue(result, path), operation.value)) {
+          throw new Error(`Test failed: value at "${path}" differs from the expected value`);
+        }
+        break;
+      default:
+        throw new Error(`Invalid patch: operation ${i} has unknown op "${op}"`);
+    }
+  });
+  return result;
+}
+
+/** Replaces an existing non-root target in place (RFC 6902 section 4.3). */
+function replaceValue(root: unknown, path: string, value: unknown): unknown {
+  const tokens = parseTokens(path);
+  const parent = parentOf(root, tokens, path);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent[parseIndex(token, path)] = value;
+  } else {
+    setMember(parent, token, value);
+  }
+  return root;
+}
