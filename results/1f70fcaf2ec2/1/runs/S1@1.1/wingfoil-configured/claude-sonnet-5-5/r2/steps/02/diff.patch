@@ -0,0 +1,135 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+// RFC 6902 appendix A examples.
+const examples: [string, unknown, unknown, unknown][] = [
+  ["A.1 add object member", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" }],
+  ["A.2 add array element", { foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] }],
+  ["A.3 remove member", { baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }],
+  ["A.4 remove element", { foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }],
+  ["A.5 replace value", { baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" }],
+  [
+    "A.6 move value",
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  ],
+  ["A.7 move element", { foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], { foo: ["all", "cows", "eat", "grass"] }],
+  ["A.8 test success", { baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], { baz: "qux", foo: ["a", 2, "c"] }],
+  ["A.10 add nested member", { foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } }],
+  ["A.11 ignore unrecognized elements", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" }],
+  ["A.14 ~ escape ordering", { "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }],
+  ["A.16 add array value", { foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] }],
+];
+
+for (const [name, doc, patch, expected] of examples) {
+  test(`RFC 6902 ${name}`, () => {
+    assert.deepEqual(applyPatch(doc, patch), expected);
+  });
+}
+
+const failures: [string, unknown, unknown][] = [
+  ["A.9 test failure", { baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]],
+  ["A.12 add to nonexistent target", { foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]],
+  ["A.15 string vs number", { "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]],
+  ["patch not an array", {}, { op: "add", path: "/a", value: 1 }],
+  ["operation not an object", {}, [null]],
+  ["unknown op", {}, [{ op: "frob", path: "/a" }]],
+  ["missing op", {}, [{ path: "/a", value: 1 }]],
+  ["missing path", {}, [{ op: "remove" }]],
+  ["invalid path syntax", {}, [{ op: "add", path: "a", value: 1 }]],
+  ["add missing value", {}, [{ op: "add", path: "/a" }]],
+  ["replace missing value", { a: 1 }, [{ op: "replace", path: "/a" }]],
+  ["test missing value", { a: 1 }, [{ op: "test", path: "/a" }]],
+  ["move missing from", { a: 1 }, [{ op: "move", path: "/b" }]],
+  ["copy missing from", { a: 1 }, [{ op: "copy", path: "/b" }]],
+  ["remove missing member", {}, [{ op: "remove", path: "/a" }]],
+  ["remove root", {}, [{ op: "remove", path: "" }]],
+  ["replace missing member", {}, [{ op: "replace", path: "/a", value: 1 }]],
+  ["replace array end", [1], [{ op: "replace", path: "/1", value: 1 }]],
+  ["add index past end", [1], [{ op: "add", path: "/2", value: 1 }]],
+  ["add leading-zero index", [1, 2], [{ op: "add", path: "/01", value: 1 }]],
+  ["remove with '-'", [1], [{ op: "remove", path: "/-" }]],
+  ["move from missing", { a: 1 }, [{ op: "move", from: "/x", path: "/b" }]],
+  ["move into own child", { a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]],
+  ["copy from missing", { a: 1 }, [{ op: "copy", from: "/x", path: "/b" }]],
+  ["traverse primitive", { a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]],
+  ["later op fails", { a: 1 }, [{ op: "add", path: "/b", value: 1 }, { op: "test", path: "/b", value: 2 }]],
+];
+
+for (const [name, doc, patch] of failures) {
+  test(`throws: ${name}`, () => {
+    assert.throws(() => applyPatch(doc, patch), Error);
+  });
+}
+
+test("whole-document add and replace with empty path", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+});
+
+test("add replaces an existing member; empty-string key works", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/", value: 1 }]), { "": 1 });
+});
+
+test("add at index equal to length appends", () => {
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/1", value: 2 }]), [1, 2]);
+});
+
+test("replace array element and null value", () => {
+  assert.deepEqual(applyPatch([1, 2], [{ op: "replace", path: "/0", value: null }]), [null, 2]);
+});
+
+test("move to same location is a no-op; copy duplicates", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  const out = applyPatch({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }]) as any;
+  assert.deepEqual(out, { a: { x: 1 }, b: { x: 1 } });
+  assert.notEqual(out.a, out.b);
+});
+
+test("test ignores object member order, not array order", () => {
+  assert.deepEqual(applyPatch({ a: { x: 1, y: 2 } }, [{ op: "test", path: "/a", value: { y: 2, x: 1 } }]), { a: { x: 1, y: 2 } });
+  assert.throws(() => applyPatch({ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]));
+  assert.throws(() => applyPatch({ a: null }, [{ op: "test", path: "/a", value: {} }]));
+});
+
+test("does not mutate the document or the patch, nor share structure", () => {
+  const doc = { a: { b: [1, 2] }, c: 1 };
+  const snapshot = structuredClone(doc);
+  const value = { z: [1] };
+  const patch = [
+    { op: "add", path: "/a/b/0", value: 0 },
+    { op: "remove", path: "/c" },
+    { op: "add", path: "/d", value },
+    { op: "copy", from: "/a", path: "/e" },
+  ];
+  const patchSnapshot = structuredClone(patch);
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, snapshot);
+  assert.deepEqual(patch, patchSnapshot);
+  assert.notEqual(out.d, value);
+  out.d.z.push(2);
+  assert.deepEqual(value, { z: [1] });
+});
+
+test("a failing patch leaves the document untouched", () => {
+  const doc = { a: 1 };
+  assert.throws(() => applyPatch(doc, [{ op: "add", path: "/b", value: 1 }, { op: "remove", path: "/x" }]));
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("__proto__ and constructor keys do not pollute prototypes", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as any;
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(({} as any).polluted, undefined);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/__proto__/polluted", value: true }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/constructor/prototype/x", value: true }]));
+  assert.equal(({} as any).x, undefined);
+  const parsed = JSON.parse('{"__proto__":{"a":1}}');
+  const copy = applyPatch(parsed, []) as any;
+  assert.equal(Object.getPrototypeOf(copy), Object.prototype);
+  assert.equal(copy.a, undefined);
+});
