@@ -0,0 +1,83 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown) {
+  const f = structuredClone(from);
+  const t = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, f);
+  assert.deepEqual(to, t);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small change in a big document is a single operation", () => {
+  const patch = roundTrip({ a: { b: 1, c: [1, 2] }, d: "x" }, { a: { b: 1, c: [1, 3] }, d: "x" });
+  assert.deepEqual(patch, [{ op: "replace", path: "/a/c/1", value: 3 }]);
+});
+
+test("object members added, removed, escaped", () => {
+  const patch = roundTrip({ "a/b": 1, "~": 2, gone: 3 }, { "a/b": 1, "~": 5, new: { x: 1 } });
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/gone" },
+    { op: "replace", path: "/~0", value: 5 },
+    { op: "add", path: "/new", value: { x: 1 } },
+  ]);
+});
+
+test("root replacement and type changes", () => {
+  assert.deepEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  roundTrip({ a: 1 }, [1]);
+  roundTrip({ a: null }, { a: {} });
+  roundTrip([1], { a: 1 });
+  roundTrip(null, "s");
+});
+
+test("array insert and remove do not rewrite neighbours", () => {
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 9, 2, 3]), [{ op: "add", path: "/1", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 2, 3, 4]), [{ op: "add", path: "/3", value: 4 }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [2, 3]), [{ op: "remove", path: "/0" }]);
+});
+
+test("array item move touches only the moved item", () => {
+  const patch = roundTrip([1, 2, 3, 4, 5], [2, 3, 4, 1, 5]);
+  assert.equal(patch.length, 2);
+  roundTrip([{ id: 1 }, { id: 2 }, { id: 3 }], [{ id: 3 }, { id: 1 }, { id: 2 }]);
+});
+
+test("array items changed in place are diffed recursively", () => {
+  const patch = roundTrip([{ a: 1, b: 2 }, { c: 3 }], [{ a: 1, b: 5 }, { c: 3 }]);
+  assert.deepEqual(patch, [{ op: "replace", path: "/0/b", value: 5 }]);
+});
+
+test("randomised round trips", () => {
+  let seed = 12345;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) % 2147483648), seed % n);
+  const arr = () => Array.from({ length: rnd(8) }, () => rnd(5));
+  const val = (d: number): unknown => {
+    const k = rnd(d > 2 ? 3 : 5);
+    if (k === 0) return rnd(4);
+    if (k === 1) return null;
+    if (k === 2) return "s" + rnd(3);
+    if (k === 3) return Array.from({ length: rnd(6) }, () => val(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), val(d + 1)]));
+  };
+  for (let i = 0; i < 2000; i++) {
+    roundTrip(arr(), arr());
+    roundTrip(val(0), val(0));
+  }
+});
+
+test("__proto__ keys are plain members and the result shares no structure", () => {
+  const to = JSON.parse('{"__proto__": {"x": 1}, "o": {"y": 1}}');
+  const patch = roundTrip({}, to);
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+  (patch[1].value as { y: number }).y = 9;
+  assert.equal(to.o.y, 1);
+});
