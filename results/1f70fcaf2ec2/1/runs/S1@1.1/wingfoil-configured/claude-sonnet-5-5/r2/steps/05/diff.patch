+
+/** Encodes a reference token: `~` to `~0` then `/` to `~1` (RFC 6901 section 3). */
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+type Operation = { op: string; path: string; value?: unknown };
+
+/** Appends to `ops` the operations turning `from` into `to` at `path`. */
+function diffValue(from: unknown, to: unknown, path: string, ops: Operation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(from, to, path, ops);
+  } else if (
+    typeof from === "object" && from !== null && !Array.isArray(from) &&
+    typeof to === "object" && to !== null && !Array.isArray(to)
+  ) {
+    const source = from as Record<string, unknown>;
+    const target = to as Record<string, unknown>;
+    for (const key of Object.keys(source)) {
+      if (!Object.hasOwn(target, key)) {
+        ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+      }
+    }
+    for (const key of Object.keys(target)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(source, key)) {
+        diffValue(source[key], target[key], child, ops);
+      } else {
+        ops.push({ op: "add", path: child, value: clone(target[key]) });
+      }
+    }
+  } else if (!jsonEqual(from, to)) {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Diffs two arrays: items common to both, in order (a longest common subsequence), are kept; between them,
+ * items are replaced in place (recursively) while both sides have some, and added or removed otherwise.
+ * A moved item is thus removed and added back, and the items around it are untouched.
+ */
+function diffArray(from: unknown[], to: unknown[], path: string, ops: Operation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+    start++;
+  }
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && jsonEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const n = endFrom - start;
+  const m = endTo - start;
+  // lcs[i][j]: length of the longest common subsequence of from[start+i..endFrom) and to[start+j..endTo).
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(from[start + i], to[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  let index = start; // position in the array as transformed so far
+  let i = 0;
+  let j = 0;
+  const flush = (removeUntil: number, addUntil: number): void => {
+    const removed = removeUntil - i;
+    const added = addUntil - j;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) {
+      diffValue(from[start + i + k], to[start + j + k], `${path}/${index + k}`, ops);
+    }
+    for (let k = paired; k < removed; k++) {
+      ops.push({ op: "remove", path: `${path}/${index + paired}` });
+    }
+    for (let k = paired; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${index + k}`, value: clone(to[start + j + k]) });
+    }
+    index += added;
+    i = removeUntil;
+    j = addUntil;
+  };
+  while (i < n && j < m) {
+    if (jsonEqual(from[start + i], to[start + j])) {
+      flush(i, j);
+      index++;
+      i++;
+      j++;
+    } else {
+      // Skip to the next common item along an optimal alignment.
+      let ni = i;
+      let nj = j;
+      while (ni < n && nj < m && !jsonEqual(from[start + ni], to[start + nj])) {
+        if (lcs[ni + 1][nj] >= lcs[ni][nj + 1]) ni++;
+        else nj++;
+      }
+      // With no common item left, the rest of both arrays is one gap.
+      if (ni === n || nj === m) {
+        break;
+      }
+      flush(ni, nj);
+    }
+  }
+  flush(n, m);
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * Only what differs is described: objects are compared member by member, arrays item by item (items added
+ * or removed are `add`/`remove` operations, a moved item is removed and added back).
+ *
+ * @param from - The original JSON value; it is not mutated.
+ * @param to - The target JSON value; it is not mutated.
+ * @returns An array of operations, empty when the values are equal; values in it share no structure with the inputs.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const ops: Operation[] = [];
+  diffValue(from, to, "", ops);
+  return ops;
+}
