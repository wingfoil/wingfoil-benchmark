new file mode 100644
index 0000000000000000000000000000000000000000..6ea02c802b0f59743cff56ca3ab9ee20f5c04897
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,50 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+// RFC 7386 appendix A examples.
+const examples: [unknown, unknown, unknown][] = [
+  [{ a: "b" }, { a: "c" }, { a: "c" }],
+  [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  [{ a: "b" }, { a: null }, {}],
+  [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+  [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+  [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  [["a", "b"], ["c", "d"], ["c", "d"]],
+  [{ a: "b" }, ["c"], ["c"]],
+  [{ a: "foo" }, null, null],
+  [{ a: "foo" }, "bar", "bar"],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: "b", c: null }, { a: "b" }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+for (const [target, patch, expected] of examples) {
+  test(`RFC 7386 A: ${JSON.stringify(target)} + ${JSON.stringify(patch)}`, () => {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  });
+}
+
+test("does not mutate target or patch and shares no structure", () => {
+  const target = { a: { b: 1 }, l: [1] };
+  const patch = { a: { c: { d: 2 } }, l: [2] };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 }, l: [1] });
+  assert.deepEqual(patch, { a: { c: { d: 2 } }, l: [2] });
+  assert.notEqual(result.a.c, patch.a.c);
+  assert.notEqual(result.l, patch.l);
+});
+
+test("__proto__ is a plain member, no prototype pollution", () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true},"a":{"__proto__":{"x":1}}}');
+  const result = applyMergePatch({}, patch) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__", "a"]);
+  assert.equal(Object.hasOwn(result.__proto__, "polluted"), true);
+});
+
+test("inherited target members are ignored", () => {
+  assert.deepEqual(applyMergePatch({}, { constructor: { a: 1 } }), { constructor: { a: 1 } });
+});
