@@ -265,3 +265,30 @@ function replaceValue(root: unknown, path: string, value: unknown): unknown {
   }
   return root;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386 section 2) to a JSON document.
+ *
+ * A non-object patch replaces the target; an object patch is merged member by member into the target
+ * (or into `{}` when the target is not an object), where a `null` member removes the target member.
+ *
+ * @param target - The JSON value to patch; it is not mutated.
+ * @param patch - The merge patch, any JSON value.
+ * @returns The merged document, as a new value that shares no structure with `target` or `patch`.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (typeof patch !== "object" || patch === null || Array.isArray(patch)) {
+    return clone(patch);
+  }
+  const result: Record<string, unknown> =
+    typeof target === "object" && target !== null && !Array.isArray(target) ? (clone(target) as Record<string, unknown>) : {};
+  for (const key of Object.keys(patch)) {
+    const value = (patch as Record<string, unknown>)[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(Object.hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
