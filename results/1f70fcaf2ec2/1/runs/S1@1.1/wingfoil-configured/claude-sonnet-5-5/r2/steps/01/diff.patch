--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,53 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @param document - The JSON value to evaluate the pointer against; it is not mutated.
+ * @param pointer - A JSON Pointer string in the syntax of RFC 6901 section 3.
+ * @returns The value the pointer refers to (RFC 6901 section 4).
+ * @throws {Error} If `pointer` is not a valid JSON Pointer, or does not resolve to a value of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (pointer[0] !== "/") {
+    throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  let current = document;
+  for (const raw of pointer.slice(1).split("/")) {
+    current = step(current, unescapeToken(raw, pointer), pointer);
+  }
+  return current;
+}
+
+/** Decodes `~1` to `/` then `~0` to `~` (RFC 6901 section 4); a bare `~` is invalid (section 3). */
+function unescapeToken(raw: string, pointer: string): string {
+  if (/~(?![01])/.test(raw)) {
+    throw new Error(`Invalid JSON Pointer "${pointer}": "~" must be followed by "0" or "1"`);
+  }
+  return raw.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/** Evaluates one reference token against a value (RFC 6901 section 4). */
+function step(value: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(value)) {
+    if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: "${token}" is not an array index`);
+    }
+    const index = Number(token);
+    if (index >= value.length) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: index ${token} is out of range`);
+    }
+    return value[index];
+  }
+  if (typeof value === "object" && value !== null) {
+    if (!Object.hasOwn(value, token)) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: no member "${token}"`);
+    }
+    return (value as Record<string, unknown>)[token];
+  }
+  throw new Error(`JSON Pointer "${pointer}" does not resolve: cannot traverse a primitive value`);
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d0d6bd7448c2d3712ed13e535e52719c547f0249
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,103 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// RFC 6901 section 5 example document.
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+const examples: [string, unknown][] = [
+  ["", doc],
+  ["/foo", ["bar", "baz"]],
+  ["/foo/0", "bar"],
+  ["/", 0],
+  ["/a~1b", 1],
+  ["/c%d", 2],
+  ["/e^f", 3],
+  ["/g|h", 4],
+  ["/i\\j", 5],
+  ['/k"l', 6],
+  ["/ ", 7],
+  ["/m~0n", 8],
+];
+
+for (const [pointer, expected] of examples) {
+  test(`RFC 6901 section 5 example "${pointer}"`, () => {
+    assert.deepEqual(resolvePointer(doc, pointer), expected);
+  });
+}
+
+test("escape order: ~01 decodes to ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+});
+
+test("null and falsy values resolve", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer([false], "/0"), false);
+});
+
+test("root may be a primitive", () => {
+  assert.equal(resolvePointer(null, ""), null);
+  assert.equal(resolvePointer(5, ""), 5);
+});
+
+test("nested arrays and objects", () => {
+  assert.equal(resolvePointer({ a: [{ b: [10, 20] }] }, "/a/0/b/1"), 20);
+});
+
+test("invalid syntax throws", () => {
+  for (const p of ["foo", "a/b", "/a~", "/a~2", "/~", "#/a"]) {
+    assert.throws(() => resolvePointer({ a: 1, foo: 1 }, p), `pointer ${p}`);
+  }
+});
+
+test("non-string pointer throws", () => {
+  assert.throws(() => resolvePointer({}, undefined as unknown as string));
+});
+
+test("missing member throws", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+  assert.throws(() => resolvePointer({ a: { b: 1 } }, "/a/c"));
+});
+
+test("array index errors throw", () => {
+  const d = { a: [1, 2] };
+  for (const p of ["/a/2", "/a/-", "/a/01", "/a/-1", "/a/1.0", "/a/x", "/a/", "/a/ 1", "/a/+1"]) {
+    assert.throws(() => resolvePointer(d, p), `pointer ${p}`);
+  }
+  assert.equal(resolvePointer(d, "/a/0"), 1);
+});
+
+test("array properties other than indices do not resolve", () => {
+  assert.throws(() => resolvePointer({ a: [1] }, "/a/length"));
+});
+
+test("primitives and null cannot be traversed", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: "str" }, "/a/0"));
+});
+
+test("inherited properties do not resolve (prototype safety)", () => {
+  for (const p of ["/__proto__", "/constructor", "/toString", "/constructor/prototype"]) {
+    assert.throws(() => resolvePointer({}, p), `pointer ${p}`);
+  }
+  assert.equal(resolvePointer(JSON.parse('{"__proto__": 1}'), "/__proto__"), 1);
+});
+
+test("document is not mutated", () => {
+  const d = { a: [1, { b: 2 }] };
+  const copy = structuredClone(d);
+  resolvePointer(d, "/a/1/b");
+  assert.deepEqual(d, copy);
+});
