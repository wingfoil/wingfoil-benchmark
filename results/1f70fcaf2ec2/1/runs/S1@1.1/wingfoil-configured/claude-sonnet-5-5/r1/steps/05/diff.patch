+++ b/src/index.ts
@@ -257,3 +257,100 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: Json };
+
+const escapeToken = (token: string): string => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+/** Pairs of indexes (i, j) with a[i] equal to b[j], in order, forming a longest common subsequence. */
+function commonItems(a: Json[], b: Json[]): [number, number][] {
+  const width = b.length + 1;
+  const table = new Uint32Array((a.length + 1) * width);
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      table[i * width + j] = jsonEqual(a[i], b[j])
+        ? table[(i + 1) * width + j + 1] + 1
+        : Math.max(table[(i + 1) * width + j], table[i * width + j + 1]);
+    }
+  }
+  const pairs: [number, number][] = [];
+  let i = 0;
+  let j = 0;
+  while (i < a.length && j < b.length) {
+    if (jsonEqual(a[i], b[j])) pairs.push([i++, j++]);
+    else if (table[(i + 1) * width + j] >= table[i * width + j + 1]) i++;
+    else j++;
+  }
+  return pairs;
+}
+
+function diffArrays(from: Json[], to: Json[], path: string, ops: Operation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+  let end = 0;
+  while (
+    end < from.length - start &&
+    end < to.length - start &&
+    jsonEqual(from[from.length - 1 - end], to[to.length - 1 - end])
+  ) {
+    end++;
+  }
+  const a = from.slice(start, from.length - end);
+  const b = to.slice(start, to.length - end);
+  // Index of the next item in the array as already patched.
+  let index = start;
+  let ia = 0;
+  let ib = 0;
+  const gap = (nextA: number, nextB: number): void => {
+    const removed = nextA - ia;
+    const added = nextB - ib;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) diffValues(a[ia + k], b[ib + k], `${path}/${index + k}`, ops);
+    for (let k = paired; k < removed; k++) ops.push({ op: "remove", path: `${path}/${index + paired}` });
+    for (let k = paired; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${index + k}`, value: clone(b[ib + k]) });
+    }
+    index += added;
+    ia = nextA;
+    ib = nextB;
+  };
+  for (const [pa, pb] of commonItems(a, b)) {
+    gap(pa, pb);
+    ia++;
+    ib++;
+    index++;
+  }
+  gap(a.length, b.length);
+}
+
+function diffValues(from: Json, to: Json, path: string, ops: Operation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (hasOwn(from, key)) diffValues(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied
+ * with `applyPatch`. The patch is minimal in the sense that unchanged members
+ * and array items are left alone: objects are compared member by member, and
+ * arrays by their longest common run of equal items, so an inserted or removed
+ * item yields a single `add` or `remove` (a moved item, a `remove` plus an
+ * `add`). Neither input is modified, and the patch shares nothing with them.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const ops: Operation[] = [];
+  diffValues(from, to, "", ops);
+  return ops;
+}
