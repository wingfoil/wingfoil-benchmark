+
+Implement JSON Patch (RFC 6902) and export `applyPatch(document, patch)` from `src/index.ts`.
+
+- Operations: add, remove, replace, move, copy, test (§4), paths as JSON Pointers (RFC 6901).
+- Returns a new document; neither the document nor the patch is mutated or aliased.
+- Throws on an invalid patch (not an array, operation not an object, missing/unknown `op`, missing `path`, `value` or `from`) and when an operation fails (missing target, bad array index, failed `test`, `move` into own child).
+- `add` to an array inserts (index 0..length, `-` appends); to an object sets/replaces; `""` replaces the whole document.
+- `test` uses JSON equality (§4.6): object member order is irrelevant.
+- No prototype pollution (`__proto__` etc. are plain own keys). Tests in `test/patch.test.ts`; README updated.
diff --git a/src/index.ts b/src/index.ts
index 402c352561cfb1220bbf94176e678d78121cbf67..b5d956dbc031840f5baf21824d33af90a6f52b25 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -62,3 +62,172 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
