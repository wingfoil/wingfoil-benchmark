index 0000000000000000000000000000000000000000..b6fa9eccafa375807829af0d9478f97c3a24bfdc
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,108 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) =>
+  assert.deepEqual(applyPatch(doc, patch), expected);
+
+// RFC 6902 Appendix A examples.
+test("A.1 adding an object member", () =>
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" }));
+test("A.2 adding an array element", () =>
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] }));
+test("A.3 removing an object member", () =>
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }));
+test("A.4 removing an array element", () =>
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }));
+test("A.5 replacing a value", () =>
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" }));
+test("A.6 moving a value", () =>
+  ok({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } }));
+test("A.7 moving an array element", () =>
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }],
+    { foo: ["all", "cows", "eat", "grass"] }));
+test("A.8/A.9 testing a value", () => {
+  ok({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }],
+    { baz: "qux", foo: ["a", 2, "c"] });
+  assert.throws(() => applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]));
+});
+test("A.10 adding a nested member object", () =>
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } }));
+test("A.12 adding to a nonexistent target fails", () =>
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }])));
+test("A.14 ~ escape ordering", () => {
+  ok({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 });
+});
+test("A.16 adding an array value", () =>
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] }));
+
+test("copy duplicates and does not alias", () => {
+  const out = applyPatch({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }, { op: "add", path: "/b/y", value: 2 }]) as any;
+  assert.deepEqual(out, { a: { x: 1 }, b: { x: 1, y: 2 } });
+});
+test("root replacement and add at root", () => {
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: null }], null);
+});
+test("add replaces existing member; null values work", () => {
+  ok({ a: 1 }, [{ op: "add", path: "/a", value: null }], { a: null });
+  ok({ a: null }, [{ op: "test", path: "/a", value: null }], { a: null });
+});
+test("test: member order irrelevant, types strict", () => {
+  ok({ a: { x: 1, y: 2 } }, [{ op: "test", path: "/a", value: { y: 2, x: 1 } }], { a: { x: 1, y: 2 } });
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "test", path: "/a", value: { 0: 1 } }]));
+});
+test("move: into own child fails; same path is a no-op", () => {
+  assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/c" }]));
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+});
+test("failures: missing targets and bad indexes", () => {
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/a", path: "/b" }]));
+  assert.throws(() => applyPatch({}, [{ op: "copy", from: "/a", path: "/b" }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/2", value: 0 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/01", value: 0 }]));
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/1" }]));
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/-", value: 0 }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 0 }]));
+});
+test("invalid patches", () => {
+  for (const bad of [null, {}, "x", [1], [null], [{}], [{ op: "nope", path: "" }], [{ op: "add", value: 1 }],
+    [{ op: "add", path: 1, value: 1 }], [{ op: "add", path: "/a" }], [{ op: "test", path: "/a" }],
+    [{ op: "replace", path: "/a" }], [{ op: "move", path: "/a" }], [{ op: "copy", path: "/a" }],
+    [{ op: "add", path: "a", value: 1 }], [{ op: "add", path: "/~2", value: 1 }]]) {
+    assert.throws(() => applyPatch({ a: 1 }, bad as any), undefined, JSON.stringify(bad));
+  }
+});
+test("does not mutate document or patch, and shares no structure", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const patch = [{ op: "add", path: "/d", value: { e: [1] } }, { op: "remove", path: "/a/0" }, { op: "move", from: "/b", path: "/f" }];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  out.d.e.push(2);
+  assert.deepEqual(patch, patchCopy);
+  assert.deepEqual(applyPatch(doc, []), doc);
+  assert.notEqual(applyPatch(doc, []), doc);
+});
+test("no prototype pollution", () => {
+  const out = applyPatch({}, JSON.parse('[{"op":"add","path":"/__proto__","value":{"polluted":1}},{"op":"add","path":"/constructor","value":1}]')) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(out.polluted, undefined);
+  assert.deepEqual(Object.keys(out), ["__proto__", "constructor"]);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/__proto__" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/__proto__/x", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/constructor", value: 1 }]));
+});
+test("failed patch leaves input untouched (atomic)", () => {
+  const doc = { a: 1 };
+  assert.throws(() => applyPatch(doc, [{ op: "add", path: "/b", value: 2 }, { op: "remove", path: "/zz" }]));
+  assert.deepEqual(doc, { a: 1 });
+});
