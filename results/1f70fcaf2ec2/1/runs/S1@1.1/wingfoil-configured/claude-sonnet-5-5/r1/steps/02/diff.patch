   return current;
 }
+
+/**
+ * JSON Patch, RFC 6902.
+ */
+
+type Json = unknown;
+type Container = Record<string, Json> | Json[];
+
+/** Deep-copies JSON data; "__proto__" is kept as a plain own key. */
+function clone(value: Json): Json {
+  if (Array.isArray(value)) return value.map(clone);
+  if (typeof value === "object" && value !== null) {
+    const out: Record<string, Json> = {};
+    for (const key of Object.keys(value)) setMember(out, key, clone((value as Record<string, Json>)[key]));
+    return out;
+  }
+  return value;
+}
+
+function setMember(o: Record<string, Json>, key: string, value: Json): void {
+  Object.defineProperty(o, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** JSON equality (RFC 6902 §4.6): member order is irrelevant. */
+function jsonEqual(a: Json, b: Json): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (typeof a === "object" && a !== null) {
+    if (typeof b !== "object" || b === null || Array.isArray(b)) return false;
+    const ka = Object.keys(a);
+    const kb = Object.keys(b);
+    return (
+      ka.length === kb.length &&
+      ka.every((k) => hasOwn(b, k) && jsonEqual((a as Record<string, Json>)[k], (b as Record<string, Json>)[k]))
+    );
+  }
+  return a === b;
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Walks to the container holding the last token of `tokens` (which must be non-empty). */
+function parentOf(root: Json, tokens: string[]): Container {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`JSON Patch: path does not exist at "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null && hasOwn(current, token)) {
+      current = (current as Record<string, Json>)[token];
+    } else {
+      throw new Error(`JSON Patch: path does not exist at "${token}"`);
+    }
+  }
+  if (typeof current !== "object" || current === null) {
+    throw new Error("JSON Patch: parent of target is not an object or array");
+  }
+  return current as Container;
+}
+
+function getAt(root: Json, tokens: string[]): Json {
+  if (tokens.length === 0) return root;
+  const parent = parentOf(root, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= parent.length) {
+      throw new Error(`JSON Patch: no array element "${token}"`);
+    }
+    return parent[Number(token)];
+  }
+  if (!hasOwn(parent, token)) throw new Error(`JSON Patch: no member "${token}"`);
+  return parent[token];
+}
+
+function addAt(root: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (token === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(token) && Number(token) <= parent.length) {
+      parent.splice(Number(token), 0, value);
+    } else {
+      throw new Error(`JSON Patch: invalid array index "${token}"`);
+    }
+  } else {
+    setMember(parent, token, value);
+  }
+  return root;
+}
+
+function removeAt(root: Json, tokens: string[]): Json {
+  if (tokens.length === 0) throw new Error("JSON Patch: cannot remove the document root");
+  getAt(root, tokens); // validates existence
+  const parent = parentOf(root, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(token), 1);
+  else delete parent[token];
+  return root;
+}
+
+function replaceAt(root: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  getAt(root, tokens); // validates existence
+  const parent = parentOf(root, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(token)] = value;
+  else setMember(parent, token, value);
+  return root;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result as
+ * a new value. Neither `document` nor `patch` is modified.
+ *
+ * @throws Error (SyntaxError for a malformed pointer) if the patch is invalid
+ *   or an operation fails (RFC 6902 §5: processing stops at the first error).
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new TypeError("JSON Patch must be an array of operations");
+  let result = clone(document);
+  for (const op of patch) {
+    if (typeof op !== "object" || op === null || Array.isArray(op)) {
+      throw new TypeError("JSON Patch operation must be an object");
+    }
+    const o = op as Record<string, Json>;
+    if (typeof o.op !== "string") throw new TypeError("JSON Patch operation lacks a string 'op'");
+    if (!["add", "remove", "replace", "move", "copy", "test"].includes(o.op)) {
+      throw new Error(`JSON Patch: unknown operation "${o.op}"`);
+    }
+    const path = parsePointer(o.path as string);
+    const needsValue = o.op === "add" || o.op === "replace" || o.op === "test";
+    if (needsValue && !hasOwn(o, "value")) throw new Error(`JSON Patch: "${o.op}" requires "value"`);
+    const from = o.op === "move" || o.op === "copy" ? parsePointer(o.from as string) : [];
+    switch (o.op) {
+      case "add":
+        result = addAt(result, path, clone(o.value));
+        break;
+      case "remove":
+        result = removeAt(result, path);
+        break;
+      case "replace":
+        result = replaceAt(result, path, clone(o.value));
+        break;
+      case "move": {
+        // §4.4: "from" must not be a proper prefix of "path".
+        if (path.length > from.length && from.every((t, i) => t === path[i])) {
+          throw new Error("JSON Patch: cannot move a value into one of its children");
+        }
+        const value = getAt(result, from);
+        if (from.length === path.length && from.every((t, i) => t === path[i])) break;
+        result = removeAt(result, from);
+        result = addAt(result, path, value);
+        break;
+      }
+      case "copy":
+        result = addAt(result, path, clone(getAt(result, from)));
+        break;
+      case "test":
+        if (!jsonEqual(getAt(result, path), o.value)) throw new Error("JSON Patch: test failed");
+        break;
+    }
+  }
+  return result;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
