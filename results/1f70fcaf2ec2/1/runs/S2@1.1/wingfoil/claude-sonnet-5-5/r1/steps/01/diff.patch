+describe('reported defects', () => {
+  const widget = { sku: 'LB-220', name: 'Lamp', priceCents: 199, vatClass: 'standard', weightGrams: 100 } as const;
+
+  it('finds a product by a lower-case SKU', () => {
+    const { catalog } = createShop();
