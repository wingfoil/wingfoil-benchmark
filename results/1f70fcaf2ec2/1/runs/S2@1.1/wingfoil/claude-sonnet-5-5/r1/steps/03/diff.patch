@@ -80,3 +80,20 @@ describe('orders', () => {
     assert.match(text, /Total\s+€/);
   });
 });
+
+describe('regressions', () => {
+  it('gives a single-use coupon back when its order is cancelled', () => {
+    const s = shop();
+    s.coupons.add({ code: 'WELCOME', kind: 'fixed', value: 100, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = s.orders.place({ customer: 'Paolo', date: '2026-03-01', lines: [{ sku: 'MUG-01', quantity: 1 }], coupon: 'welcome' });
+    s.orders.cancel(first.id, '2026-03-01');
+    const second = s.orders.place({ customer: 'Paolo', date: '2026-03-01', lines: [{ sku: 'MUG-01', quantity: 2 }], coupon: 'WELCOME' });
+    assert.equal(second.totals.couponDiscountCents, 100);
+  });
+
+  it('ships free when the goods come to exactly 50.00', () => {
+    const order = shop().orders.quote({ customer: 'Ann', date: '2026-03-01', lines: [{ sku: 'MUG-01', quantity: 5 }] });
+    assert.equal(order.totals.goodsCents, 5000);
+    assert.equal(order.totals.shippingCents, 0);
+  });
+});
