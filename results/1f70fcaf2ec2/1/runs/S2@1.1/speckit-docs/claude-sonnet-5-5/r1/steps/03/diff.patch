+
+  it('gives a single-use coupon back when its order is cancelled', () => {
+    const { catalog, coupons, orders, inventory } = createShop();
+    catalog.add({ sku: 'SH-1', name: 'Shirt', priceCents: 2000, vatClass: 'standard', weightGrams: 100 });
+    inventory.restock('SH-1', 10);
+    coupons.add({ code: 'WELCOME', kind: 'fixed', value: 500, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = orders.place({ customer: 'Paolo', date: '2026-06-01', lines: [{ sku: 'SH-1', quantity: 1 }], coupon: 'WELCOME' });
+    orders.cancel(first.id, '2026-06-01');
+    assert.equal(coupons.usedBy('WELCOME'), undefined);
+    const second = orders.place({ customer: 'Paolo', date: '2026-06-01', lines: [{ sku: 'SH-1', quantity: 1 }], coupon: 'welcome' });
+    assert.equal(coupons.usedBy('WELCOME'), second.id);
+  });
+
+  it('charges no shipping on a placed order whose goods are exactly €50.00', () => {
+    const { catalog, orders, inventory } = createShop();
+    catalog.add({ sku: 'FS-1', name: 'Thing', priceCents: 2500, vatClass: 'standard', weightGrams: 100 });
+    inventory.restock('FS-1', 10);
+    const order = orders.place({ customer: 'c', date: '2026-06-01', lines: [{ sku: 'FS-1', quantity: 2 }] });
+    assert.equal(order.totals.goodsCents, 5000);
+    assert.equal(order.totals.shippingCents, 0);
+  });
 });
