@@ -0,0 +1,37 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createShop } from '../src/index.ts';
+
+function shop() {
+  const s = createShop();
+  s.catalog.add({ sku: 'LB-220', name: 'Lamp bulb', priceCents: 199, vatClass: 'standard', weightGrams: 100 });
+  s.catalog.add({ sku: 'FIFTY', name: 'Fifty', priceCents: 5000, vatClass: 'exempt', weightGrams: 100 });
+  s.catalog.add({ sku: 'FIFTY-1', name: 'Just under', priceCents: 4999, vatClass: 'exempt', weightGrams: 100 });
+  for (const sku of ['LB-220', 'FIFTY', 'FIFTY-1']) s.inventory.restock(sku, 10);
+  return s;
+}
+
+describe('reported defects', () => {
+  it('finds a product by a lower-case SKU', () => {
+    const { catalog, orders } = shop();
+    assert.equal(catalog.find('lb-220')?.sku, 'LB-220');
+    assert.equal(catalog.get(' lb-220 ').sku, 'LB-220');
+    const order = orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'lb-220', quantity: 1 }] });
+    assert.equal(order.lines[0]?.sku, 'LB-220');
+  });
+
+  it('ships free at exactly 50.00 of goods, not at 49.99', () => {
+    const { orders } = shop();
+    const exact = orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'FIFTY', quantity: 1 }] });
+    assert.equal(exact.totals.shippingCents, 0);
+    const under = orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'FIFTY-1', quantity: 1 }] });
+    assert.equal(under.totals.shippingCents, 490);
+  });
+
+  it('rounds line VAT half up: 1.99 at 22% is 0.44', () => {
+    const { orders } = shop();
+    const order = orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'LB-220', quantity: 1 }] });
+    assert.equal(order.lines[0]?.vatCents, 44);
+  });
+});
