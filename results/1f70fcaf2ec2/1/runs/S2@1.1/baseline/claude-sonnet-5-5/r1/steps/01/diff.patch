+describe('reported fixes', () => {
+  it('accepts a lower-case SKU', () => {
+    const { orders } = shop();
+    const order = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'mug-01', quantity: 1 }] });
+    assert.equal(order.lines[0]?.sku, 'MUG-01');
+  });
+
+  it('ships free when the goods come to exactly €50.00', () => {
+    const { orders } = shop();
+    const order = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 5 }] });
+    assert.equal(order.totals.goodsCents, 5000);
+    assert.equal(order.totals.shippingCents, 0);
+  });
+
+  it('rounds line VAT half up', () => {
+    const s = shop();
+    s.catalog.add({ sku: 'PEN-1', name: 'Pen', priceCents: 199, vatClass: 'standard', weightGrams: 10 });
+    s.inventory.restock('PEN-1', 5);
+    const order = s.orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'PEN-1', quantity: 1 }] });
+    assert.equal(order.lines[0]?.vatCents, 44);
+  });
+});
