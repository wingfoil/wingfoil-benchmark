+++ b/test/rules.test.ts
@@ -0,0 +1,24 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createShop } from '../src/index.ts';
+import { lineVat } from '../src/tax.ts';
+import { shippingCost } from '../src/shipping.ts';
+
+describe('shipping and VAT rules', () => {
+  it('ships free from exactly €50.00', () => {
+    assert.equal(shippingCost(5000, 500), 0);
+    assert.equal(shippingCost(4999, 500), 490);
+  });
+
+  it('rounds line VAT half up', () => {
+    assert.equal(lineVat(199, 'standard'), 44);
+  });
+
+  it('accepts a lower-case SKU on an order', () => {
+    const { catalog, orders } = createShop();
+    catalog.add({ sku: 'LB-220', name: 'Lamp', priceCents: 199, vatClass: 'standard', weightGrams: 100 });
+    const quote = orders.quote({ customer: 'Giulia', date: '2026-01-05', lines: [{ sku: 'lb-220', quantity: 1 }] });
+    assert.equal(quote.totals.vatCents, 44);
+  });
+});
