diff --git a/test/inventory.test.ts b/test/inventory.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..75ed591d61311562545042df26044a6c3f423f9e
--- /dev/null
+++ b/test/inventory.test.ts
@@ -0,0 +1,27 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createShop } from '../src/index.ts';
+
+describe('inventory SKUs', () => {
+  it('keys stock by the canonical SKU, so an order sees stock restocked in any spelling', () => {
+    const { catalog, inventory, orders } = createShop();
+    catalog.add({ sku: 'MUG-01', name: 'Enamel mug', priceCents: 1000, vatClass: 'standard', weightGrams: 300 });
+    inventory.restock(' mug-01', 10);
+    assert.equal(inventory.onHand('MUG-01'), 10);
+    assert.equal(inventory.available(' Mug-01 '), 10);
+    orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 2 }] });
+    assert.equal(inventory.available('mug-01'), 8);
+  });
+
+  it('adjusts, reports low stock and lists movements under the canonical SKU', () => {
+    const { inventory } = createShop();
+    inventory.restock('tea-7', 3);
+    inventory.adjust(' TEA-7', 2);
+    assert.deepEqual(inventory.lowStock(['tea-7']), [{ sku: 'TEA-7', available: 2 }]);
+    assert.deepEqual(inventory.movements('Tea-7').map((m) => [m.sku, m.kind, m.quantity]), [
+      ['TEA-7', 'restock', 3],
+      ['TEA-7', 'adjust', -1],
+    ]);
+  });
+});
