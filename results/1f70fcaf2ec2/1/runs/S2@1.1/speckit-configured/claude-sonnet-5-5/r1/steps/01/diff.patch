+
+describe('reported defects', () => {
+  function bugShop() {
+    const s = createShop();
+    s.catalog.add({ sku: 'LB-220', name: 'Lamp', priceCents: 199, vatClass: 'standard', weightGrams: 300 });
+    s.catalog.add({ sku: 'FIFTY', name: 'Fifty', priceCents: 5000, vatClass: 'standard', weightGrams: 300 });
+    s.catalog.add({ sku: 'FIFTY-1', name: 'Almost', priceCents: 4999, vatClass: 'standard', weightGrams: 300 });
+    s.catalog.add({ sku: 'HALF', name: 'Half', priceCents: 25, vatClass: 'standard', weightGrams: 1 });
+    for (const sku of ['LB-220', 'FIFTY', 'FIFTY-1', 'HALF']) s.inventory.restock(sku, 10);
+    return s;
+  }
+
+  it('accepts a lower-case SKU and shows it in capitals', () => {
+    const { orders, catalog } = bugShop();
+    const order = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: ' lb-220 ', quantity: 1 }] });
+    assert.equal(order.lines[0]?.sku, 'LB-220');
+    assert.equal(catalog.get('lb-220').sku, 'LB-220');
+  });
+
+  it('ships free at exactly €50.00 of goods, not at €49.99', () => {
+    const { orders } = bugShop();
+    const at = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'FIFTY', quantity: 1 }] });
+    assert.equal(at.totals.shippingCents, 0);
+    const below = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'FIFTY-1', quantity: 1 }] });
+    assert.equal(below.totals.shippingCents, 490);
+  });
+
+  it('rounds line VAT half up', () => {
+    const { orders } = bugShop();
+    const a = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'LB-220', quantity: 1 }] });
+    assert.equal(a.lines[0]?.vatCents, 44);
+    const b = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'HALF', quantity: 1 }] });
+    assert.equal(b.lines[0]?.vatCents, 6);
+  });
+});
