diff --git a/test/coupons.test.ts b/test/coupons.test.ts
index 7f4bc5c1af7ffb577552379a6840f6e22ed6d11f..0d460de7f665f73daaa152786487a2788c20958b 100644
--- a/test/coupons.test.ts
+++ b/test/coupons.test.ts
@@ -46,4 +46,15 @@ describe('coupons', () => {
     assert.equal(coupons.usedBy('ONCE'), 'ORD-0001');
     assert.throws(() => orders.place({ customer: 'c-2', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'ONCE' }), CouponError);
   });
+
+  it('makes a single-use coupon available again when its order is cancelled', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'WELCOME', kind: 'fixed', value: 100, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+
+    const original = orders.place({ customer: 'paolo', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'WELCOME' });
+    orders.cancel(original.id, '2026-05-05');
+
+    assert.equal(coupons.usedBy('WELCOME'), undefined);
+    assert.doesNotThrow(() => orders.place({ customer: 'paolo', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'welcome' }));
+  });
 });
