index 0000000000000000000000000000000000000000..d227f3989a58fe2d2e85fb3e60ff756346c9b482
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,149 @@
+/** A rentable board or sail and its price in euro cents per calendar day. */
+export interface Equipment {
+  id: string;
+  kind: 'board' | 'sail';
+  dailyPrice: number;
+}
+
+/** The half-open UTC period for a rental: [start, end). */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The calculated cost for a rental period, expressed in euro cents. */
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed rental booking. */
+export interface RentalBooking extends RentalQuote {
+  id: string;
+}
+
+/** An in-memory service for renting windsurfing equipment by complete UTC days. */
+export interface RentalService {
+  /** Adds one rentable item. */
+  addEquipment(item: Equipment): void;
+  /** Calculates the cost of a valid rental without reserving the equipment. */
+  quote(request: RentalRequest): RentalQuote;
+  /** Reserves free equipment for a valid rental period. */
+  book(request: RentalRequest): RentalBooking;
+}
+
+const MIDNIGHT_UTC = /^(\d{4})-(\d{2})-(\d{2})T00:00:00(?:\.0{1,3})?Z$/;
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1_000;
+
+/**
+ * Creates an isolated, in-memory rental service.
+ *
+ * Booking identifiers are allocated in insertion order so that service behavior
+ * is deterministic and does not rely on a clock or random source.
+ */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: RentalBooking[] = [];
+  let nextBookingNumber = 1;
+
+  function addEquipment(item: Equipment): void {
+    validateEquipment(item);
+    if (equipment.has(item.id)) {
+      throw new Error(`Equipment already exists: ${item.id}`);
+    }
+    equipment.set(item.id, { ...item });
+  }
+
+  function quote(request: RentalRequest): RentalQuote {
+    const item = findEquipment(request.itemId);
+    const { startTime, endTime } = validatePeriod(request);
+    const total = ((endTime - startTime) / DAY_IN_MILLISECONDS) * item.dailyPrice;
+    if (!Number.isSafeInteger(total)) {
+      throw new Error('Rental total must be a safe integer number of euro cents');
+    }
+    return { ...request, total };
+  }
+
+  function book(request: RentalRequest): RentalBooking {
+    const quoteResult = quote(request);
+    const { startTime, endTime } = validatePeriod(request);
+    const isUnavailable = bookings.some((booking) => {
+      if (booking.itemId !== request.itemId) {
+        return false;
+      }
+      const existing = validatePeriod(booking);
+      return startTime < existing.endTime && endTime > existing.startTime;
+    });
+    if (isUnavailable) {
+      throw new Error(`Equipment is unavailable: ${request.itemId}`);
+    }
+
+    const booking: RentalBooking = {
+      id: `booking-${nextBookingNumber++}`,
+      ...quoteResult,
+    };
+    bookings.push(booking);
+    return { ...booking };
+  }
+
+  function findEquipment(itemId: string): Equipment {
+    if (typeof itemId !== 'string') {
+      throw new Error('Item ID must be a string');
+    }
+    const item = equipment.get(itemId);
+    if (item === undefined) {
+      throw new Error(`Unknown equipment: ${itemId}`);
+    }
+    return item;
+  }
+
+  return { addEquipment, quote, book };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item !== 'object' || item === null) {
+    throw new Error('Equipment must be an object');
+  }
+  if (typeof item.id !== 'string' || item.id.length === 0) {
+    throw new Error('Equipment ID must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error('Equipment kind must be board or sail');
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('Daily price must be a non-negative integer number of euro cents');
+  }
+}
+
+function validatePeriod(request: RentalRequest): { startTime: number; endTime: number } {
+  if (typeof request !== 'object' || request === null) {
+    throw new Error('Rental request must be an object');
+  }
+  const startTime = parseMidnightUtc(request.start, 'start');
+  const endTime = parseMidnightUtc(request.end, 'end');
+  if (endTime <= startTime) {
+    throw new Error('Rental end must be after its start');
+  }
+  return { startTime, endTime };
+}
+
+function parseMidnightUtc(value: unknown, label: string): number {
+  if (typeof value !== 'string') {
+    throw new Error(`Rental ${label} must be an ISO-8601 string`);
+  }
+  const match = MIDNIGHT_UTC.exec(value);
+  if (match === null) {
+    throw new Error(`Rental ${label} must be midnight UTC`);
+  }
+  const [, year, month, day] = match;
+  const time = Date.UTC(Number(year), Number(month) - 1, Number(day));
+  const date = new Date(time);
+  if (
+    date.getUTCFullYear() !== Number(year) ||
+    date.getUTCMonth() !== Number(month) - 1 ||
+    date.getUTCDate() !== Number(day)
+  ) {
+    throw new Error(`Rental ${label} must be a valid ISO-8601 date`);
+  }
+  return time;
+}
diff --git a/test/rental-service.test.mjs b/test/rental-service.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4b68e2ec38b9f3e172001464f344eb91877efd8b
--- /dev/null
+++ b/test/rental-service.test.mjs
@@ -0,0 +1,56 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { createRentalService } from '../dist/index.js';
+
+const start = '2026-06-10T00:00:00.000Z';
+const end = '2026-06-13T00:00:00.000Z';
+
+test('quotes and books whole-day rentals in euro cents', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+
+  assert.deepEqual(rentals.quote({ itemId: 'board-1', start, end }), {
+    itemId: 'board-1',
+    start,
+    end,
+    total: 7_500,
+  });
+  assert.deepEqual(rentals.book({ itemId: 'board-1', start, end }), {
+    id: 'booking-1',
+    itemId: 'board-1',
+    start,
+    end,
+    total: 7_500,
+  });
+});
+
+test('rejects unknown equipment and periods outside whole UTC days', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1_500 });
+
+  assert.throws(() => rentals.quote({ itemId: 'missing', start, end }));
+  assert.throws(() => rentals.quote({
+    itemId: 'sail-1',
+    start: '2026-06-10T12:00:00.000Z',
+    end,
+  }));
+  assert.throws(() => rentals.quote({ itemId: 'sail-1', start: end, end: start }));
+});
+
+test('prevents bookings that overlap and permits adjacent bookings', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+  rentals.book({ itemId: 'board-1', start, end });
+
+  assert.throws(() => rentals.book({
+    itemId: 'board-1',
+    start: '2026-06-12T00:00:00.000Z',
+    end: '2026-06-14T00:00:00.000Z',
+  }));
+  assert.doesNotThrow(() => rentals.book({
+    itemId: 'board-1',
+    start: end,
+    end: '2026-06-14T00:00:00.000Z',
+  }));
+});
