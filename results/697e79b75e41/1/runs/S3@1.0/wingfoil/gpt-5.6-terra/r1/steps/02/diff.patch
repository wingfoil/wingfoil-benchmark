diff --git a/test/rental-service.test.mjs b/test/rental-service.test.mjs
index 4b68e2ec38b9f3e172001464f344eb91877efd8b..d48a1939af51855faf576fe8eb15587902196fcf 100644
--- a/test/rental-service.test.mjs
