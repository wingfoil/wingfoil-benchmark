@@ -54,3 +54,32 @@ test('prevents bookings that overlap and permits adjacent bookings', () => {
     end: '2026-06-14T00:00:00.000Z',
   }));
 });
+
+test('lists sorted equipment that is free for the complete requested period', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 1_500 });
+  rentals.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2_500 });
+  rentals.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1_500 });
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+  rentals.book({ itemId: 'board-1', start, end });
+  rentals.book({
+    itemId: 'sail-1',
+    start: '2026-06-09T00:00:00.000Z',
+    end: '2026-06-11T00:00:00.000Z',
+  });
+
+  assert.deepEqual(rentals.availability({ start, end }), ['board-2', 'sail-2']);
+  assert.deepEqual(rentals.availability({ start, end, kind: 'board' }), ['board-2']);
+  assert.deepEqual(rentals.availability({ start, end, kind: 'sail' }), ['sail-2']);
+  assert.deepEqual(rentals.availability({
+    start: end,
+    end: '2026-06-14T00:00:00.000Z',
+  }), ['board-1', 'board-2', 'sail-1', 'sail-2']);
+});
+
+test('rejects availability queries with invalid periods or equipment kinds', () => {
+  const rentals = createRentalService();
+
+  assert.throws(() => rentals.availability({ start: end, end: start }));
+  assert.throws(() => rentals.availability({ start, end, kind: 'mast' }));
+});
