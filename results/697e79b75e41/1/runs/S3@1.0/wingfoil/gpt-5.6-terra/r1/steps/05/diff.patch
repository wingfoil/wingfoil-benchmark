+function calculateRefund(total: number, period: RentalPeriod, cancellationTime: number): number {
+  if (cancellationTime <= period.startTime) {
+    return total;
+  }
+  if (cancellationTime >= period.endTime) {
+    return 0;
+  }
+  const unusedDuration = period.endTime - cancellationTime;
+  const totalDuration = period.endTime - period.startTime;
+  return Math.round(total * (unusedDuration / totalDuration));
