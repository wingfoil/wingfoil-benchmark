+
+test('cancels a booking with a prorated refund and releases its equipment', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+  const booking = rentals.book({ itemId: 'board-1', start, end });
+
+  assert.deepEqual(rentals.cancel(booking.id, '2026-06-11T00:00:00.000Z'), {
+    bookingId: booking.id,
+    refund: 4_500,
+  });
+  assert.deepEqual(rentals.availability({ start, end }), ['board-1']);
+});
+
+test('refunds the whole price before a booking begins and rejects invalid cancellations', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({
+    id: 'board-1', kind: 'board', dailyPrice: 2_500, hourlyPrice: 400,
+  });
+  const booking = rentals.book({
+    itemId: 'board-1',
+    start: '2026-06-10T10:00:00.000Z',
+    end: '2026-06-10T13:00:00.000Z',
+  });
+
+  assert.deepEqual(rentals.cancel(booking.id, '2026-06-10T09:00:00.000Z'), {
+    bookingId: booking.id,
+    refund: 1_200,
+  });
+  assert.throws(() => rentals.cancel(booking.id, '2026-06-10T10:00:00.000Z'));
+  assert.throws(() => rentals.cancel('booking-999', '2026-06-10T10:00:00.000Z'));
+  assert.throws(() => rentals.cancel('booking-999', 'not-a-time'));
