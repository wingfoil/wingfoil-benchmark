+++ b/test/rental.test.js
@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createRentalService } from '../src/index.ts';
+
+test('quotes and books whole UTC days in integer euro cents', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1250 });
+
+  assert.deepEqual(service.quote({
+    itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-04T00:00:00Z',
+  }), { itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-04T00:00:00Z', total: 3750 });
+  assert.deepEqual(service.book({
+    itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-04T00:00:00Z',
+  }), { id: 'booking-1', itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-04T00:00:00Z', total: 3750 });
+});
+
+test('rejects missing equipment and invalid periods', () => {
+  const service = createRentalService();
+  assert.throws(() => service.quote({ itemId: 'missing', start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' }), /Unknown equipment/);
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 900 });
+  assert.throws(() => service.quote({ itemId: 'sail-1', start: '2026-06-01T12:00:00Z', end: '2026-06-02T00:00:00Z' }), /midnight UTC/);
+  assert.throws(() => service.quote({ itemId: 'sail-1', start: '2026-06-02T00:00:00Z', end: '2026-06-01T00:00:00Z' }), /after start/);
+});
+
+test('allows adjacent bookings and rejects overlapping bookings for the same item', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1000 });
+  service.book({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' });
+  assert.throws(() => service.book({ itemId: 'board-1', start: '2026-06-02T00:00:00Z', end: '2026-06-04T00:00:00Z' }), /already booked/);
+  assert.equal(service.book({ itemId: 'board-1', start: '2026-06-03T00:00:00Z', end: '2026-06-04T00:00:00Z' }).id, 'booking-2');
+});
