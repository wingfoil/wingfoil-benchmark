@@ -0,0 +1,120 @@
+/** A rentable equipment category. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** Equipment registered with the rental service; dailyPrice is in euro cents. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** An exclusive-end UTC rental period. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** A rental period priced in euro cents. */
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+/** A booked rental with its service-generated identifier. */
+export interface RentalBooking extends RentalQuote {
+  id: string;
+}
+
+/** Operations supported by an in-memory rental service. */
+export interface RentalService {
+  /** Register equipment once; duplicate IDs and invalid equipment are rejected. */
+  addEquipment(item: Equipment): void;
+  /** Price a valid rental period without reserving it. */
+  quote(request: RentalRequest): RentalQuote;
+  /** Reserve a valid, available period and return its booking details. */
+  book(request: RentalRequest): RentalBooking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00:00(?:\.0+)?Z$/;
+
+function parseMidnight(value: string, field: string): number {
+  if (!UTC_MIDNIGHT.test(value)) {
+    throw new Error(`${field} must be midnight UTC in ISO-8601 format`);
+  }
+
+  const timestamp = Date.parse(value);
+  if (!Number.isFinite(timestamp) || new Date(timestamp).toISOString() !== normalizeIso(value)) {
+    throw new Error(`${field} must be a valid UTC date`);
+  }
+  return timestamp;
+}
+
+function normalizeIso(value: string): string {
+  const [whole, fraction] = value.slice(0, -1).split('.');
+  return `${whole}.${(fraction ?? '').padEnd(3, '0').slice(0, 3)}Z`;
+}
+
+/** Create an isolated, in-memory service for rental equipment, quotes and bookings. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: RentalBooking[] = [];
+  let nextBookingId = 1;
+
+  function validateRequest(request: RentalRequest): { start: number; end: number; quote: RentalQuote } {
+    if (typeof request?.itemId !== 'string' || !equipment.has(request.itemId)) {
+      throw new Error(`Unknown equipment: ${request?.itemId}`);
+    }
+    if (typeof request.start !== 'string' || typeof request.end !== 'string') {
+      throw new Error('Rental period must use ISO-8601 UTC strings');
+    }
+
+    const start = parseMidnight(request.start, 'start');
+    const end = parseMidnight(request.end, 'end');
+    if (end <= start) throw new Error('end must be after start');
+
+    const item = equipment.get(request.itemId)!;
+    const days = (end - start) / DAY_MS;
+    const total = days * item.dailyPrice;
+    if (!Number.isSafeInteger(total)) throw new Error('Rental total exceeds the safe integer range');
+
+    return {
+      start,
+      end,
+      quote: { itemId: request.itemId, start: request.start, end: request.end, total },
+    };
+  }
+
+  return {
+    addEquipment(item) {
+      if (!item || typeof item.id !== 'string') {
+        throw new Error('Equipment id must be a string');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error("Equipment kind must be 'board' or 'sail'");
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+      }
+      if (equipment.has(item.id)) throw new Error(`Equipment already exists: ${item.id}`);
+      equipment.set(item.id, { ...item });
+    },
+
+    quote(request) {
+      return validateRequest(request).quote;
+    },
+
+    book(request) {
+      const { start, end, quote } = validateRequest(request);
+      const overlaps = bookings.some((booking) =>
+        booking.itemId === quote.itemId &&
+        start < Date.parse(booking.end) && end > Date.parse(booking.start),
+      );
+      if (overlaps) throw new Error(`Equipment is already booked for part of this period: ${quote.itemId}`);
+
+      const booking: RentalBooking = { id: `booking-${nextBookingId++}`, ...quote };
+      bookings.push(booking);
+      return { ...booking };
+    },
+  };
+}
