@@ -116,5 +125,29 @@ export function createRentalService(): RentalService {
       bookings.push(booking);
       return { ...booking };
     },
+
+    availability(query) {
+      if (typeof query?.start !== 'string' || typeof query.end !== 'string') {
+        throw new Error('Rental period must use ISO-8601 UTC strings');
+      }
+      if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+        throw new Error("Equipment kind must be 'board' or 'sail'");
+      }
+
+      const start = parseMidnight(query.start, 'start');
+      const end = parseMidnight(query.end, 'end');
+      if (end <= start) throw new Error('end must be after start');
+
+      return [...equipment.values()]
+        .filter((item) =>
+          (query.kind === undefined || item.kind === query.kind) &&
+          !bookings.some((booking) =>
+            booking.itemId === item.id &&
+            start < Date.parse(booking.end) && end > Date.parse(booking.start),
+          ),
+        )
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
