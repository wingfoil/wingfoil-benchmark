+
+test('cancels with a full refund at least 24 hours before start and releases equipment', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1000 });
+  const booking = service.book({ itemId: 'board-1', start: '2026-06-03T00:00:00Z', end: '2026-06-04T00:00:00Z' });
+
+  assert.deepEqual(service.cancel(booking.id, '2026-06-02T00:00:00Z'), { bookingId: booking.id, refund: 1000 });
+  assert.deepEqual(service.availability({ start: booking.start, end: booking.end }), ['board-1']);
+  assert.equal(service.book({ itemId: 'board-1', start: booking.start, end: booking.end }).id, 'booking-2');
+});
