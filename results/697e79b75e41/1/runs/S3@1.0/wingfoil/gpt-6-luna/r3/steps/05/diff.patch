+function parseUtcTimestamp(value: string, field: string): number {
+  if (!UTC_TIMESTAMP.test(value)) {
+    throw new Error(`${field} must be an ISO-8601 UTC timestamp`);
+  }
+  const timestamp = Date.parse(value);
+  if (!Number.isFinite(timestamp) || new Date(timestamp).toISOString() !== normalizeIso(value)) {
+    throw new Error(`${field} must be a valid UTC date`);
+  }
+  return timestamp;
+}
