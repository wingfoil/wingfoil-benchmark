+/** Windsurf equipment available for rental. Prices are integer euro cents per day. */
+export interface RentalEquipment {
+  /** Stable identifier used in rental requests. */
+  id: string;
+  /** Category of the equipment. */
+  kind: 'board' | 'sail';
+  /** Cost of renting this item for one whole day, in euro cents. */
+  dailyPrice: number;
+}
+
+/** UTC midnight-to-midnight period used for quotes and bookings. */
+export interface RentalRequest {
+  /** Identifier of the equipment to rent. */
+  itemId: string;
+  /** ISO-8601 UTC timestamp at midnight on the first rental day. */
+  start: string;
+  /** ISO-8601 UTC timestamp at midnight after the final rental day. */
+  end: string;
+}
+
+/** Price quote for a rental period, in euro cents. */
+export interface RentalQuote extends RentalRequest {
+  /** Total rental price in euro cents. */
+  total: number;
+}
+
+/** Confirmed rental booking, with a service-generated identifier. */
+export interface RentalBooking extends RentalQuote {
+  /** Unique identifier for this booking within the service. */
+  id: string;
+}
+
+/** In-memory rental service operations. */
+export interface RentalService {
+  /** Adds equipment to the catalogue. Duplicate identifiers are rejected. */
+  addEquipment(item: RentalEquipment): void;
+  /** Calculates the price for a valid whole-day UTC rental period. */
+  quote(request: RentalRequest): RentalQuote;
+  /** Books an available item for a valid period and returns its price and identifier. */
+  book(request: RentalRequest): RentalBooking;
+}
+
+interface StoredBooking extends RentalBooking {}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null;
+}
+
+function rentalDays(start: string, end: string): number {
+  const midnightUtc = /^\d{4}-\d{2}-\d{2}T00:00:00(?:\.0+)?(?:Z|\+00:00)$/;
+  if (!midnightUtc.test(start) || !midnightUtc.test(end)) {
+    throw new Error('Rental periods must start and end at midnight UTC.');
+  }
+
+  const startTime = Date.parse(start);
+  const endTime = Date.parse(end);
+  if (
+    !Number.isFinite(startTime) ||
+    !Number.isFinite(endTime) ||
+    new Date(startTime).toISOString().slice(0, 10) !== start.slice(0, 10) ||
+    new Date(endTime).toISOString().slice(0, 10) !== end.slice(0, 10)
+  ) {
+    throw new Error('Rental period must contain valid ISO-8601 UTC dates.');
+  }
+
+  const dayMilliseconds = 24 * 60 * 60 * 1000;
+  const duration = endTime - startTime;
+  if (duration <= 0 || duration % dayMilliseconds !== 0) {
+    throw new Error('Rental period must cover one or more whole days.');
+  }
+  return duration / dayMilliseconds;
+}
+
+/**
+ * Creates a rental service backed entirely by in-memory equipment and bookings.
+ * The service supports quoting and booking whole-day UTC rentals for boards and sails.
+ */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, RentalEquipment>();
+  const bookings: StoredBooking[] = [];
+  let nextBookingNumber = 1;
+
+  function validateRequest(request: RentalRequest): { item: RentalEquipment; days: number } {
+    if (!isRecord(request) || typeof request.itemId !== 'string' || typeof request.start !== 'string' || typeof request.end !== 'string') {
+      throw new Error('Rental request must include an itemId, start, and end.');
+    }
+
+    const item = equipment.get(request.itemId);
+    if (!item) {
+      throw new Error(`Unknown rental item: ${request.itemId}`);
+    }
+    return { item, days: rentalDays(request.start, request.end) };
+  }
+
+  function quote(request: RentalRequest): RentalQuote {
+    const { item, days } = validateRequest(request);
+    const total = item.dailyPrice * days;
+    if (!Number.isSafeInteger(total)) {
+      throw new Error('Rental total exceeds the supported integer amount.');
+    }
+    return { itemId: request.itemId, start: request.start, end: request.end, total };
+  }
+
+  return {
+    addEquipment(item: RentalEquipment): void {
+      if (!isRecord(item) || typeof item.id !== 'string' || item.id.length === 0) {
+        throw new Error('Equipment must have a non-empty string id.');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error('Equipment kind must be board or sail.');
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('Equipment dailyPrice must be a non-negative integer number of euro cents.');
+      }
+      if (equipment.has(item.id)) {
+        throw new Error(`Equipment id already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote,
+
+    book(request: RentalRequest): RentalBooking {
+      const rentalQuote = quote(request);
+      const startTime = Date.parse(request.start);
+      const endTime = Date.parse(request.end);
+      const overlaps = bookings.some((booking) =>
+        booking.itemId === request.itemId &&
+        startTime < Date.parse(booking.end) &&
+        Date.parse(booking.start) < endTime,
+      );
+      if (overlaps) {
+        throw new Error(`Rental item ${request.itemId} is not available for the requested period.`);
+      }
+
+      const booking: StoredBooking = {
+        id: `booking-${nextBookingNumber}`,
+        ...rentalQuote,
+      };
+      nextBookingNumber += 1;
+      bookings.push(booking);
+      return { ...booking };
+    },
+  };
+}
