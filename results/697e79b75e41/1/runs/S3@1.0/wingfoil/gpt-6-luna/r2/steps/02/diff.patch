     },
+
+    availability(query: AvailabilityQuery): string[] {
+      if (!query || typeof query !== 'object') {
+        throw new Error('An availability query is required');
+      }
+      if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+        throw new Error('Equipment kind must be board or sail');
+      }
+      const startTime = midnightUtc(query.start, 'start');
+      const endTime = midnightUtc(query.end, 'end');
+      if (endTime <= startTime) {
+        throw new Error('end must be after start');
+      }
+
+      return [...equipment.values()]
+        .filter((item) => query.kind === undefined || item.kind === query.kind)
+        .filter((item) => !bookings.some((booking) =>
+          booking.itemId === item.id && startTime < booking.endTime && booking.startTime < endTime))
+        .map((item) => item.id)
+        .sort();
+    },
   };
