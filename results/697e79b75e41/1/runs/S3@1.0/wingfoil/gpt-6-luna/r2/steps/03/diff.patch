diff --git a/test/rental-discount.test.js b/test/rental-discount.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..76846007294951020764e7d6d7d21975b2ce1665
--- /dev/null
+++ b/test/rental-discount.test.js
@@ -0,0 +1,27 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+test('rentals of at least three days receive a 10% discount in quotes and bookings', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board', kind: 'board', dailyPrice: 1001 });
+  const request = {
+    itemId: 'board',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-04T00:00:00Z',
+  };
+
+  assert.equal(rentals.quote(request).total, 2703);
+  assert.equal(rentals.book(request).total, 2703);
+});
+
+test('rentals shorter than three days retain their full price', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail', kind: 'sail', dailyPrice: 1001 });
+
+  assert.equal(rentals.quote({
+    itemId: 'sail',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+  }).total, 2002);
+});
