+++ b/src/index.ts
@@ -0,0 +1,103 @@
+export type EquipmentKind = "board" | "sail";
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+export interface RentalBooking extends RentalQuote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): RentalQuote;
+  book(request: RentalRequest): RentalBooking;
+}
+
+interface StoredEquipment extends Equipment {}
+
+function utcMidnight(value: string, field: string): number {
+  // Require an explicit UTC marker and a complete ISO date-time. Restricting
+  // midnight to this shape also avoids local-time interpretation by Date.
+  if (!/^\d{4}-\d{2}-\d{2}T00:00:00(?:\.0+)?Z$/.test(value)) {
+    throw new Error(`${field} must be midnight UTC in ISO-8601 format`);
+  }
+
+  const timestamp = Date.parse(value);
+  if (!Number.isFinite(timestamp) || new Date(timestamp).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${field} is not a valid UTC date`);
+  }
+  return timestamp;
+}
+
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, StoredEquipment>();
+  const bookings: RentalBooking[] = [];
+  let nextBookingId = 1;
+
+  function quote(request: RentalRequest): RentalQuote {
+    const item = equipment.get(request.itemId);
+    if (!item) throw new Error(`Unknown equipment item: ${request.itemId}`);
+
+    const start = utcMidnight(request.start, "start");
+    const end = utcMidnight(request.end, "end");
+    if (end <= start) throw new Error("end must be after start");
+
+    const days = (end - start) / 86_400_000;
+    const total = item.dailyPrice * days;
+    if (!Number.isSafeInteger(total)) throw new Error("Rental total exceeds the supported euro-cent range");
+    return {
+      itemId: request.itemId,
+      start: request.start,
+      end: request.end,
+      total,
+    };
+  }
+
+  return {
+    addEquipment(item) {
+      if (!item || typeof item.id !== "string" || item.id.length === 0) {
+        throw new Error("Equipment id must be a non-empty string");
+      }
+      if (item.kind !== "board" && item.kind !== "sail") {
+        throw new Error("Equipment kind must be 'board' or 'sail'");
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error("dailyPrice must be a non-negative integer number of euro cents");
+      }
+      if (equipment.has(item.id)) throw new Error(`Equipment item already exists: ${item.id}`);
+      equipment.set(item.id, { ...item });
+    },
+
+    quote,
+
+    book(request) {
+      const priced = quote(request);
+      const start = Date.parse(priced.start);
+      const end = Date.parse(priced.end);
+      if (bookings.some((booking) =>
+        booking.itemId === priced.itemId &&
+        start < Date.parse(booking.end) &&
+        Date.parse(booking.start) < end
+      )) {
+        throw new Error(`Equipment item is not available for the requested period: ${priced.itemId}`);
+      }
+
+      const booking: RentalBooking = { id: String(nextBookingId++), ...priced };
+      bookings.push(booking);
+      return { ...booking };
+    },
+  };
+}
