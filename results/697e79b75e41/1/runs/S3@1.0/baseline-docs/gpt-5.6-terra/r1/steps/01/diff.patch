index 0000000000000000000000000000000000000000..6f8db1570ff8635b9c692f14f3d86d7183d3d83a
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,153 @@
+/** A rentable item stored by the booking desk. Amounts are integer euro cents. */
+export interface Equipment {
+  id: string;
+  kind: 'board' | 'sail';
+  dailyPrice: number;
+}
+
+/** A half-open rental period expressed with UTC ISO-8601 timestamps. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The cost of renting an item for a validated period. */
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed rental booking. */
+export interface Booking extends RentalQuote {
+  id: string;
+}
+
+/** In-memory operations offered by the rental module. */
+export interface RentalService {
+  /** Adds a uniquely identified board or sail that can be rented. */
+  addEquipment(item: Equipment): void;
+  /** Calculates the rental cost without reserving the item. */
+  quote(request: RentalRequest): RentalQuote;
+  /** Reserves a free item and returns the confirmed booking. */
+  book(request: RentalRequest): Booking;
+}
+
+interface ValidatedPeriod extends RentalRequest {
+  startTime: number;
+  endTime: number;
+}
+
+const MILLISECONDS_PER_DAY = 24 * 60 * 60 * 1_000;
+const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00:00(?:\.0+)?Z$/;
+
+/**
+ * Creates an isolated, in-memory rental service.
+ *
+ * All rentals use half-open UTC-day periods: `end` is midnight immediately
+ * after the final day. Booking identifiers are deterministic within a service.
+ */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Booking[] = [];
+  let nextBookingNumber = 1;
+
+  return {
+    addEquipment(item: Equipment): void {
+      validateEquipment(item);
+      if (equipment.has(item.id)) {
+        throw new Error(`Equipment already exists: ${item.id}`);
+      }
+
+      equipment.set(item.id, { ...item });
+    },
+
+    quote(request: RentalRequest): RentalQuote {
+      const item = getEquipment(equipment, request);
+      const period = validatePeriod(request);
+      return createQuote(item, period);
+    },
+
+    book(request: RentalRequest): Booking {
+      const item = getEquipment(equipment, request);
+      const period = validatePeriod(request);
+
+      if (bookings.some((booking) => booking.itemId === item.id && periodsOverlap(period, booking))) {
+        throw new Error(`Equipment is unavailable for the requested period: ${item.id}`);
+      }
+
+      const booking: Booking = {
+        id: `booking-${nextBookingNumber}`,
+        ...createQuote(item, period),
+      };
+      nextBookingNumber += 1;
+      bookings.push(booking);
+      return { ...booking };
+    },
+  };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item !== 'object' || item === null) {
+    throw new Error('Equipment must be an object');
+  }
+  if (typeof item.id !== 'string' || item.id.length === 0) {
+    throw new Error('Equipment id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error('Equipment kind must be board or sail');
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('Equipment dailyPrice must be a non-negative integer number of cents');
+  }
+}
+
+function getEquipment(equipment: Map<string, Equipment>, request: RentalRequest): Equipment {
+  if (typeof request !== 'object' || request === null || typeof request.itemId !== 'string') {
+    throw new Error('Rental request must contain an itemId');
+  }
+
+  const item = equipment.get(request.itemId);
+  if (item === undefined) {
+    throw new Error(`Unknown equipment: ${request.itemId}`);
+  }
+  return item;
+}
+
+function validatePeriod(request: RentalRequest): ValidatedPeriod {
+  if (typeof request !== 'object' || request === null) {
+    throw new Error('Rental request must be an object');
+  }
+
+  const startTime = parseUtcMidnight(request.start, 'start');
+  const endTime = parseUtcMidnight(request.end, 'end');
+  if (endTime <= startTime) {
+    throw new Error('Rental end must be after its start');
+  }
+
+  return { ...request, startTime, endTime };
+}
+
+function parseUtcMidnight(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !UTC_MIDNIGHT.test(value)) {
+    throw new Error(`Rental ${name} must be an ISO-8601 UTC midnight`);
+  }
+
+  const time = Date.parse(value);
+  if (!Number.isFinite(time) || new Date(time).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`Rental ${name} must be a valid date`);
+  }
+  return time;
+}
+
+function createQuote(item: Equipment, period: ValidatedPeriod): RentalQuote {
+  const days = (period.endTime - period.startTime) / MILLISECONDS_PER_DAY;
+  const total = item.dailyPrice * days;
+  if (!Number.isSafeInteger(total)) {
+    throw new Error('Rental total exceeds the supported money range');
+  }
+  return { itemId: item.id, start: period.start, end: period.end, total };
+}
+
+function periodsOverlap(period: ValidatedPeriod, booking: Booking): boolean {
+  return period.start < booking.end && period.end > booking.start;
+}
diff --git a/test/rental-service.test.mjs b/test/rental-service.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..116bebaf27ebaffd9df595666d627d43d5368e29
--- /dev/null
+++ b/test/rental-service.test.mjs
@@ -0,0 +1,37 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { createRentalService } from '../dist/index.js';
+
+const day = (date) => `${date}T00:00:00.000Z`;
+
+test('quotes a whole-day rental in euro cents', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+
+  assert.deepEqual(
+    rentals.quote({ itemId: 'board-1', start: day('2026-05-10'), end: day('2026-05-13') }),
+    { itemId: 'board-1', start: day('2026-05-10'), end: day('2026-05-13'), total: 7_500 },
+  );
+});
+
+test('rejects unknown equipment and periods that are not complete UTC days', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1_500 });
+
+  assert.throws(() => rentals.quote({ itemId: 'missing', start: day('2026-05-10'), end: day('2026-05-11') }));
+  assert.throws(() => rentals.quote({ itemId: 'sail-1', start: '2026-05-10T12:00:00.000Z', end: day('2026-05-11') }));
+  assert.throws(() => rentals.quote({ itemId: 'sail-1', start: day('2026-05-11'), end: day('2026-05-10') }));
+});
+
+test('prevents overlapping bookings but permits adjacent bookings', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+
+  assert.deepEqual(
+    rentals.book({ itemId: 'board-1', start: day('2026-05-10'), end: day('2026-05-12') }),
+    { id: 'booking-1', itemId: 'board-1', start: day('2026-05-10'), end: day('2026-05-12'), total: 5_000 },
+  );
+  assert.throws(() => rentals.book({ itemId: 'board-1', start: day('2026-05-11'), end: day('2026-05-13') }));
+  assert.doesNotThrow(() => rentals.book({ itemId: 'board-1', start: day('2026-05-12'), end: day('2026-05-13') }));
+});
