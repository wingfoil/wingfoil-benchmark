diff --git a/test/rental-service.test.mjs b/test/rental-service.test.mjs
index 4e05cef443c6c5653ee82eb2775d8999bef0a359..d08e691236ae758f1e067dec90b14ea2a8147bd3 100644
--- a/test/rental-service.test.mjs
+++ b/test/rental-service.test.mjs
@@ -124,3 +124,27 @@ test('rejects availability queries with invalid kinds or periods', () => {
   assert.throws(() => rentals.availability({ start: day('2026-05-10'), end: day('2026-05-10') }));
   assert.throws(() => rentals.availability({ start: day('2026-05-10'), end: day('2026-05-11'), kind: 'mast' }));
 });
+
+test('cancels a booking exactly 24 hours before it starts and releases its equipment', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+  const booking = rentals.book({ itemId: 'board-1', start: day('2026-05-10'), end: day('2026-05-12') });
+
+  assert.deepEqual(rentals.cancel(booking.id, day('2026-05-09')), { bookingId: booking.id, refund: 5_000 });
+  assert.deepEqual(
+    rentals.availability({ start: day('2026-05-10'), end: day('2026-05-12'), kind: 'board' }),
+    ['board-1'],
+  );
+  assert.doesNotThrow(() => rentals.book({ itemId: 'board-1', start: day('2026-05-10'), end: day('2026-05-12') }));
+});
+
+test('only refunds a cancellation at least 24 hours before the booking and rejects repeat or invalid cancellations', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+  const lateBooking = rentals.book({ itemId: 'board-1', start: day('2026-05-10'), end: day('2026-05-12') });
+
+  assert.deepEqual(rentals.cancel(lateBooking.id, hour('2026-05-09', '01')), { bookingId: lateBooking.id, refund: 0 });
+  assert.throws(() => rentals.cancel(lateBooking.id, day('2026-05-08')));
+  assert.throws(() => rentals.cancel('missing', day('2026-05-08')));
+  assert.throws(() => rentals.cancel('booking-2', '2026-05-08T10:30:00.000Z'));
+});
