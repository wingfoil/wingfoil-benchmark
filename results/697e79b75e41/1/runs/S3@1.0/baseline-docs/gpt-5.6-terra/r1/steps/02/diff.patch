diff --git a/test/rental-service.test.mjs b/test/rental-service.test.mjs
index 116bebaf27ebaffd9df595666d627d43d5368e29..c528adf6bd21f0c843da979099a6d0dd91b41015 100644
--- a/test/rental-service.test.mjs
+++ b/test/rental-service.test.mjs
@@ -35,3 +35,32 @@ test('prevents overlapping bookings but permits adjacent bookings', () => {
   assert.throws(() => rentals.book({ itemId: 'board-1', start: day('2026-05-11'), end: day('2026-05-13') }));
   assert.doesNotThrow(() => rentals.book({ itemId: 'board-1', start: day('2026-05-12'), end: day('2026-05-13') }));
 });
+
+test('lists sorted equipment ids that are free for a requested period', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 1_500 });
+  rentals.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2_500 });
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_000 });
+  rentals.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1_000 });
+  rentals.book({ itemId: 'board-1', start: day('2026-05-10'), end: day('2026-05-12') });
+
+  assert.deepEqual(
+    rentals.availability({ start: day('2026-05-10'), end: day('2026-05-12') }),
+    ['board-2', 'sail-1', 'sail-2'],
+  );
+  assert.deepEqual(
+    rentals.availability({ start: day('2026-05-10'), end: day('2026-05-12'), kind: 'board' }),
+    ['board-2'],
+  );
+  assert.deepEqual(
+    rentals.availability({ start: day('2026-05-12'), end: day('2026-05-13'), kind: 'board' }),
+    ['board-1', 'board-2'],
+  );
+});
+
+test('rejects availability queries with invalid kinds or periods', () => {
+  const rentals = createRentalService();
+
+  assert.throws(() => rentals.availability({ start: day('2026-05-10'), end: day('2026-05-10') }));
+  assert.throws(() => rentals.availability({ start: day('2026-05-10'), end: day('2026-05-11'), kind: 'mast' }));
+});
