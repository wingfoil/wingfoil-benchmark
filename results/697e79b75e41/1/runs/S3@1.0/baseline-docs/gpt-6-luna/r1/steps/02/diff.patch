diff --git a/test/rental-service.test.mjs b/test/rental-service.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3bfa913456d74f2687b6b693e44fc86a391eefbd
--- /dev/null
+++ b/test/rental-service.test.mjs
@@ -0,0 +1,21 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/rental-service.ts';
+
+test('availability returns sorted, unbooked equipment, optionally filtered by kind', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail-b', kind: 'sail', dailyPrice: 100 });
+  rentals.addEquipment({ id: 'board-a', kind: 'board', dailyPrice: 200 });
+  rentals.addEquipment({ id: 'board-c', kind: 'board', dailyPrice: 200 });
+  rentals.book({ itemId: 'board-c', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' });
+
+  assert.deepEqual(rentals.availability({ start: '2026-06-02T00:00:00Z', end: '2026-06-04T00:00:00Z' }), ['board-a', 'sail-b']);
+  assert.deepEqual(rentals.availability({ start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z', kind: 'board' }), ['board-a']);
+  assert.deepEqual(rentals.availability({ start: '2026-06-03T00:00:00Z', end: '2026-06-04T00:00:00Z', kind: 'board' }), ['board-a', 'board-c']);
+});
+
+test('availability rejects invalid periods and kinds', () => {
+  const rentals = createRentalService();
+  assert.throws(() => rentals.availability({ start: '2026-06-02T00:00:00Z', end: '2026-06-01T00:00:00Z' }), /end must be after start/);
+  assert.throws(() => rentals.availability({ start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z', kind: 'kite' }), /kind must be board or sail/);
+});
