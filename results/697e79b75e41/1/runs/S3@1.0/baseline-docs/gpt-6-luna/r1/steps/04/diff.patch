diff --git a/test/rental-service.test.mjs b/test/rental-service.test.mjs
index f79b6379ec07f357a5c86dc97912edf7180cfb33..c7ddff3dabc5efd77ed49ce3a14947b185d0475d 100644
--- a/test/rental-service.test.mjs
+++ b/test/rental-service.test.mjs
@@ -35,3 +35,27 @@ test('rentals shorter than three days keep the full price', () => {
 
   assert.equal(rentals.quote({ itemId: 'board-a', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' }).total, 2_002);
 });
+
+test('hour-aligned rentals shorter than a day use hourly price per hour', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-hourly', kind: 'board', dailyPrice: 1_000, hourlyPrice: 175 });
+  const request = { itemId: 'board-hourly', start: '2026-06-01T09:00:00Z', end: '2026-06-01T13:00:00Z' };
+
+  assert.equal(rentals.quote(request).total, 700);
+  assert.equal(rentals.book(request).total, 700);
+});
+
+test('hourly rentals require an hourly price and valid whole-hour boundaries', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-daily', kind: 'board', dailyPrice: 1_000 });
+  rentals.addEquipment({ id: 'board-hourly', kind: 'board', dailyPrice: 1_000, hourlyPrice: 100 });
+
+  assert.throws(() => rentals.quote({ itemId: 'board-daily', start: '2026-06-01T09:00:00Z', end: '2026-06-01T10:00:00Z' }), /hourly price/);
+  assert.throws(() => rentals.quote({ itemId: 'board-hourly', start: '2026-06-01T09:30:00Z', end: '2026-06-01T10:30:00Z' }), /whole-hour UTC boundary/);
+});
+
+test('hourly price is validated as non-negative integer euro cents', () => {
+  const rentals = createRentalService();
+  assert.throws(() => rentals.addEquipment({ id: 'board-a', kind: 'board', dailyPrice: 1_000, hourlyPrice: -1 }), /hourlyPrice/);
+  assert.throws(() => rentals.addEquipment({ id: 'board-a', kind: 'board', dailyPrice: 1_000, hourlyPrice: 1.5 }), /hourlyPrice/);
+});
