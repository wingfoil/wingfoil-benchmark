+/** Windsurf equipment available for rental. Prices are integer euro cents per day. */
+export interface RentalEquipment {
+  id: string;
+  kind: 'board' | 'sail';
+  dailyPrice: number;
+}
+
+/** A rental period expressed as UTC midnight timestamps, with an exclusive end. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The price for a rental period, in integer euro cents. */
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed rental booking. */
+export interface RentalBooking extends RentalQuote {
+  id: string;
+}
+
+/** In-memory rental operations for equipment and bookings. */
+export interface RentalService {
+  /** Add equipment to the catalog. */
+  addEquipment(item: RentalEquipment): void;
+  /** Calculate the cost of a valid rental period. */
+  quote(request: RentalRequest): RentalQuote;
+  /** Book an available item for a valid rental period. */
+  book(request: RentalRequest): RentalBooking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00:00(?:\.\d+)?Z$/;
+
+function validatePeriod(request: RentalRequest): { start: number; end: number; days: number } {
+  if (typeof request.start !== 'string' || typeof request.end !== 'string' ||
+      !UTC_MIDNIGHT.test(request.start) || !UTC_MIDNIGHT.test(request.end)) {
+    throw new Error('Rental period must use UTC midnight ISO-8601 timestamps');
+  }
+  const start = Date.parse(request.start);
+  const end = Date.parse(request.end);
+  if (!Number.isFinite(start) || !Number.isFinite(end) ||
+      new Date(start).toISOString().slice(0, 10) !== request.start.slice(0, 10) ||
+      new Date(end).toISOString().slice(0, 10) !== request.end.slice(0, 10)) {
+    throw new Error('Rental period contains an invalid timestamp');
+  }
+  if (end <= start) throw new Error('Rental end must be after rental start');
+  return { start, end, days: (end - start) / DAY_MS };
+}
+
+/**
+ * Create an in-memory rental service. Equipment and bookings exist only for the
+ * lifetime of the returned service; booking IDs are sequential and deterministic.
+ */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, RentalEquipment>();
+  const bookings: RentalBooking[] = [];
+  let nextBookingId = 1;
+
+  function quote(request: RentalRequest): RentalQuote {
+    if (!request || typeof request.itemId !== 'string') throw new Error('Unknown rental item');
+    const item = equipment.get(request.itemId);
+    if (!item) throw new Error(`Unknown rental item: ${request.itemId}`);
+    const { days } = validatePeriod(request);
+    const total = item.dailyPrice * days;
+    if (!Number.isSafeInteger(total)) throw new Error('Rental total exceeds the supported amount');
+    return { itemId: request.itemId, start: request.start, end: request.end, total };
+  }
+
+  return {
+    addEquipment(item: RentalEquipment): void {
+      if (!item || typeof item.id !== 'string' || item.id.length === 0) throw new Error('Equipment ID must be a non-empty string');
+      if (item.kind !== 'board' && item.kind !== 'sail') throw new Error('Equipment kind must be board or sail');
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) throw new Error('Daily price must be a non-negative integer number of euro cents');
+      if (equipment.has(item.id)) throw new Error(`Equipment already exists: ${item.id}`);
+      equipment.set(item.id, { ...item });
+    },
+    quote,
+    book(request: RentalRequest): RentalBooking {
+      const priced = quote(request);
+      const { start, end } = validatePeriod(request);
+      if (bookings.some((booking) => booking.itemId === request.itemId &&
+          start < Date.parse(booking.end) && Date.parse(booking.start) < end)) {
+        throw new Error(`Rental item is unavailable for the requested period: ${request.itemId}`);
+      }
+      const booking: RentalBooking = { id: `booking-${nextBookingId++}`, ...priced };
+      bookings.push(booking);
+      return { ...booking };
+    },
+  };
+}
