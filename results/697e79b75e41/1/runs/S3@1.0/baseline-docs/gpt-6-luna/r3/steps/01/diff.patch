+/** Equipment that can be rented by the booking desk. Prices are integer euro cents per day. */
+export interface RentalEquipment {
+  id: string;
+  kind: 'board' | 'sail';
+  dailyPrice: number;
+}
+
+/** A half-open rental period expressed as UTC midnight ISO-8601 timestamps. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The price returned by a rental quote. */
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed booking with a service-assigned identifier. */
+export interface RentalBooking extends RentalQuote {
+  id: string;
+}
+
+/** In-memory operations for equipment and whole-day rental bookings. */
+export interface RentalService {
+  /** Add an item with a unique identifier and nonnegative daily price in integer euro cents. */
+  addEquipment(item: RentalEquipment): void;
+  /** Calculate the cost for a valid rental period; availability is not reserved. */
+  quote(request: RentalRequest): RentalQuote;
+  /** Book a valid period if the item is free throughout it. */
+  book(request: RentalRequest): RentalBooking;
+}
+
+/**
+ * Create an isolated in-memory rental catalogue and booking service.
+ * Periods are UTC whole-day half-open ranges; amounts are integer euro cents.
+ */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, RentalEquipment>();
+  const bookings: RentalBooking[] = [];
+  let nextBookingId = 1;
+
+  function validateRequest(request: RentalRequest): { item: RentalEquipment; start: number; end: number; days: number } {
+    if (!request || typeof request.itemId !== 'string' || request.itemId.length === 0) {
+      throw new Error('Invalid rental request');
+    }
+    const start = parseUtcMidnight(request.start);
+    const end = parseUtcMidnight(request.end);
+    if (start >= end) throw new Error('Rental period must have a start before its end');
+
+    const item = equipment.get(request.itemId);
+    if (!item) throw new Error(`Unknown equipment: ${request.itemId}`);
+    const days = (end - start) / 86_400_000;
+    const total = item.dailyPrice * days;
+    if (!Number.isSafeInteger(total)) throw new Error('Rental total exceeds the supported amount');
+    return { item, start, end, days };
+  }
+
+  function parseUtcMidnight(value: string): number {
+    if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}T00:00(?::00(?:\.0+)?)?Z$/.test(value)) {
+      throw new Error('Rental dates must be UTC midnight ISO-8601 timestamps');
+    }
+    const timestamp = Date.parse(value);
+    if (!Number.isFinite(timestamp) || new Date(timestamp).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+      throw new Error('Invalid rental date');
+    }
+    return timestamp;
+  }
+
+  function quote(request: RentalRequest): RentalQuote {
+    const { item, start, end, days } = validateRequest(request);
+    return { itemId: item.id, start: request.start, end: request.end, total: item.dailyPrice * days };
+  }
+
+  return {
+    addEquipment(item: RentalEquipment): void {
+      if (!item || typeof item.id !== 'string' || item.id.length === 0 ||
+          (item.kind !== 'board' && item.kind !== 'sail') ||
+          !Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('Invalid equipment');
+      }
+      if (equipment.has(item.id)) throw new Error(`Equipment already exists: ${item.id}`);
+      equipment.set(item.id, { ...item });
+    },
+    quote,
+    book(request: RentalRequest): RentalBooking {
+      const price = quote(request);
+      const start = Date.parse(request.start);
+      const end = Date.parse(request.end);
+      if (bookings.some((booking) => booking.itemId === price.itemId &&
+          start < Date.parse(booking.end) && Date.parse(booking.start) < end)) {
+        throw new Error(`Equipment is not available for the requested period: ${price.itemId}`);
+      }
+      const booking: RentalBooking = { id: `booking-${nextBookingId++}`, ...price };
+      bookings.push(booking);
+      return { ...booking };
+    },
+  };
+}
