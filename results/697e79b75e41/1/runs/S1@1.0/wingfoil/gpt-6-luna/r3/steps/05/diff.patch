+/**
+ * Create an RFC 6902 JSON Patch containing the changes needed to transform
+ * `from` into `to`. Objects are diffed by member and arrays by index, leaving
+ * unchanged values out of the patch. Neither input is modified.
+ *
+ * @param from The original JSON value.
+ * @param to The desired JSON value.
+ * @returns A JSON Patch that transforms `from` into `to`.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const patch: JsonPatchOperation[] = [];
+  buildPatch(from, to, "", patch);
+  return patch;
+}
+
+function buildPatch(from: unknown, to: unknown, path: string, patch: JsonPatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    const fromKeys = Object.keys(from).sort();
+    const toKeys = Object.keys(to).sort();
+    const toKeySet = new Set(toKeys);
+    const fromKeySet = new Set(fromKeys);
+
+    for (const key of fromKeys) {
+      if (!toKeySet.has(key)) patch.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+    }
+    for (const key of toKeys) {
+      const childPath = `${path}/${encodeToken(key)}`;
+      if (!fromKeySet.has(key)) {
+        patch.push({ op: "add", path: childPath, value: cloneJson(to[key]) });
+      } else {
+        buildPatch(from[key], to[key], childPath, patch);
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    buildArrayPatch(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: "replace", path, value: cloneJson(to) });
+}
+
+function buildArrayPatch(from: unknown[], to: unknown[], path: string, patch: JsonPatchOperation[]): void {
+  // Keeping positional correspondence for equal-sized arrays lets nested edits
+  // remain small (for example, changing one field in an array element).
+  if (from.length === to.length) {
+    for (let index = 0; index < from.length; index += 1) {
+      buildPatch(from[index], to[index], `${path}/${index}`, patch);
+    }
+    return;
+  }
+
+  // For arrays whose length changed, retain the longest unchanged subsequence
+  // and express the rest as insertions and removals against the evolving array.
+  const lengths = Array.from({ length: from.length + 1 }, () => new Array<number>(to.length + 1).fill(0));
+  for (let i = from.length - 1; i >= 0; i -= 1) {
+    for (let j = to.length - 1; j >= 0; j -= 1) {
+      lengths[i][j] = jsonEqual(from[i], to[j])
+        ? lengths[i + 1][j + 1] + 1
+        : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+
+  let fromIndex = 0;
+  let toIndex = 0;
+  let currentIndex = 0;
+  while (fromIndex < from.length && toIndex < to.length) {
+    if (jsonEqual(from[fromIndex], to[toIndex])) {
+      fromIndex += 1;
+      toIndex += 1;
+      currentIndex += 1;
+    } else if (lengths[fromIndex + 1][toIndex] >= lengths[fromIndex][toIndex + 1]) {
+      patch.push({ op: "remove", path: `${path}/${currentIndex}` });
+      fromIndex += 1;
+    } else {
+      patch.push({ op: "add", path: `${path}/${currentIndex}`, value: cloneJson(to[toIndex]) });
+      toIndex += 1;
+      currentIndex += 1;
+    }
+  }
+  while (fromIndex < from.length) {
+    patch.push({ op: "remove", path: `${path}/${currentIndex}` });
+    fromIndex += 1;
+  }
+  while (toIndex < to.length) {
+    patch.push({ op: "add", path: `${path}/${currentIndex}`, value: cloneJson(to[toIndex]) });
+    toIndex += 1;
+    currentIndex += 1;
+  }
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
