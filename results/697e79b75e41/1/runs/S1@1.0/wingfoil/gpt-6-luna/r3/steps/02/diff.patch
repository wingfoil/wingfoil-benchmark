+
+/** A single operation in an RFC 6902 JSON Patch document. */
+export type JsonPatchOperation =
+  | { op: "add"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "replace"; path: string; value: unknown }
+  | { op: "move"; from: string; path: string }
+  | { op: "copy"; from: string; path: string }
+  | { op: "test"; path: string; value: unknown };
+
+/**
+ * Apply an RFC 6902 JSON Patch to a JSON document without changing the input.
+ * Operations are applied in order. Array `add` accepts `-` to append; all
+ * other array locations require an existing canonical index. Throws if the
+ * patch is malformed or any operation cannot be applied.
+ *
+ * @param document The JSON value to patch.
+ * @param patch An array of RFC 6902 operations.
+ * @returns The resulting JSON value.
+ * @throws {TypeError} If the patch or an operation is malformed.
+ * @throws {Error} If an operation's path, source, or test fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new TypeError("JSON Patch must be an array");
+  let result = cloneJson(document);
+
+  for (const entry of patch) {
+    if (entry === null || typeof entry !== "object" || Array.isArray(entry)) {
+      throw new TypeError("Each JSON Patch operation must be an object");
+    }
+    const operation = entry as Record<string, unknown>;
+    const op = operation.op;
+    const path = operation.path;
+    if (typeof path !== "string") throw new TypeError("JSON Patch path must be a string");
+
+    switch (op) {
+      case "add":
+        requireValue(operation);
+        result = addAt(result, path, cloneJson(operation.value));
+        break;
+      case "remove":
+        result = removeAt(result, path).document;
+        break;
+      case "replace":
+        requireValue(operation);
+        assertExists(result, path);
+        result = addAt(result, path, cloneJson(operation.value), false);
+        break;
+      case "copy": {
+        const from = requirePath(operation.from, "from");
+        result = addAt(result, path, cloneJson(resolvePointer(result, from)));
+        break;
+      }
+      case "move": {
+        const from = requirePath(operation.from, "from");
+        const sourceTokens = pointerTokens(from);
+        const destinationTokens = pointerTokens(path);
+        if (destinationTokens.length > sourceTokens.length && sourceTokens.every((token, i) => token === destinationTokens[i])) {
+          throw new Error("Cannot move a value into one of its children");
+        }
+        if (from === path) {
+          resolvePointer(result, from);
+          break;
+        }
+        const removed = removeAt(result, from);
+        result = addAt(removed.document, path, removed.value);
+        break;
+      }
+      case "test":
+        requireValue(operation);
+        if (!jsonEqual(resolvePointer(result, path), operation.value)) {
+          throw new Error(`JSON Patch test failed at ${path}`);
+        }
+        break;
+      default:
+        throw new TypeError(`Unsupported JSON Patch operation: ${String(op)}`);
+    }
+  }
+  return result;
+}
+
+function requireValue(operation: Record<string, unknown>): void {
+  if (!Object.prototype.hasOwnProperty.call(operation, "value")) {
+    throw new TypeError("JSON Patch operation requires a value");
+  }
+}
+
+function requirePath(value: unknown, name: string): string {
+  if (typeof value !== "string") throw new TypeError(`JSON Patch ${name} must be a string`);
+  return value;
+}
+
+function pointerTokens(pointer: string): string[] {
+  if (pointer === "") return [];
+  if (!pointer.startsWith("/")) throw new TypeError("A JSON Pointer must be empty or start with '/'");
+  return pointer.slice(1).split("/").map(decodeToken);
+}
+
+function assertExists(document: unknown, pointer: string): void {
+  resolvePointer(document, pointer);
+}
+
+function addAt(document: unknown, pointer: string, value: unknown, allowInsert = true): unknown {
+  const tokens = pointerTokens(pointer);
+  if (tokens.length === 0) return value;
+  const key = tokens[tokens.length - 1];
+  const parentPointer = tokens.slice(0, -1).map(encodeToken).map(token => `/${token}`).join("");
+  const parent = parentPointer === "" ? document : resolvePointer(document, parentPointer);
+
+  if (Array.isArray(parent)) {
+    const index = key === "-" && allowInsert ? parent.length : parseArrayIndex(key, parent.length, allowInsert);
+    if (index > parent.length || (!allowInsert && index >= parent.length)) {
+      throw new Error(`JSON Patch array index out of bounds: ${key}`);
+    }
+    if (allowInsert) parent.splice(index, 0, value);
+    else parent[index] = value;
+  } else if (parent !== null && typeof parent === "object") {
+    if (!allowInsert && !Object.prototype.hasOwnProperty.call(parent, key)) {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+    Object.defineProperty(parent, key, { value, enumerable: true, writable: true, configurable: true });
+  } else {
+    throw new Error(`JSON Patch parent does not resolve: ${parentPointer}`);
+  }
+  return document;
+}
+
+function removeAt(document: unknown, pointer: string): { document: unknown; value: unknown } {
+  const tokens = pointerTokens(pointer);
+  if (tokens.length === 0) return { document: undefined, value: document };
+  const key = tokens[tokens.length - 1];
+  const parentPointer = tokens.slice(0, -1).map(encodeToken).map(token => `/${token}`).join("");
+  const parent = parentPointer === "" ? document : resolvePointer(document, parentPointer);
+  if (Array.isArray(parent)) {
+    const index = parseArrayIndex(key, parent.length, false);
+    if (index >= parent.length) throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    const [value] = parent.splice(index, 1);
+    return { document, value };
+  }
+  if (parent !== null && typeof parent === "object" && Object.prototype.hasOwnProperty.call(parent, key)) {
+    const value = (parent as Record<string, unknown>)[key];
+    delete (parent as Record<string, unknown>)[key];
+    return { document, value };
+  }
+  throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+}
+
+function parseArrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) throw new Error(`Invalid array index in JSON Pointer: ${token}`);
+  const index = Number(token);
+  if (!Number.isSafeInteger(index) || index > length || (!allowEnd && index === length)) {
+    throw new Error(`Invalid array index in JSON Pointer: ${token}`);
+  }
+  return index;
+}
+
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function cloneJson<T>(value: T): T {
+  if (Array.isArray(value)) return value.map(cloneJson) as T;
+  if (value !== null && typeof value === "object") {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) {
+      Object.defineProperty(copy, key, { value: cloneJson((value as Record<string, unknown>)[key]), enumerable: true, writable: true, configurable: true });
+    }
+    return copy as T;
+  }
+  return value;
+}
+
+function jsonEqual(left: unknown, right: unknown): boolean {
+  if (left === right) return true;
+  if (left === null || right === null || typeof left !== "object" || typeof right !== "object") return false;
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return Array.isArray(left) && Array.isArray(right) && left.length === right.length && left.every((item, index) => jsonEqual(item, right[index]));
+  }
+  const leftObject = left as Record<string, unknown>;
+  const rightObject = right as Record<string, unknown>;
+  const keys = Object.keys(leftObject);
+  return keys.length === Object.keys(rightObject).length && keys.every(key => Object.prototype.hasOwnProperty.call(rightObject, key) && jsonEqual(leftObject[key], rightObject[key]));
+}
