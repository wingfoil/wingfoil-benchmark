@@ -0,0 +1,73 @@
+/**
+ * Resolve a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * The empty string selects the whole document. Non-empty pointers must begin
+ * with `/`; reference tokens decode `~1` to `/` and `~0` to `~`. Array tokens
+ * must be canonical non-negative decimal indices. Throws when the pointer is
+ * malformed or a token does not identify a value in the document.
+ *
+ * @param document The JSON value to inspect.
+ * @param pointer An RFC 6901 JSON Pointer string.
+ * @returns The value selected by the pointer.
+ * @throws {TypeError} If `pointer` is not a valid JSON Pointer string.
+ * @throws {Error} If the pointer does not resolve within `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new TypeError("JSON Pointer must be a string");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new TypeError("A JSON Pointer must be empty or start with '/'");
+  }
+
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+  let value: unknown = document;
+
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`Invalid array index in JSON Pointer: ${token}`);
+      }
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= value.length) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+      value = value[index];
+    } else if (value !== null && typeof value === "object") {
+      if (!Object.prototype.hasOwnProperty.call(value, token)) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+      value = (value as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+  }
+
+  return value;
+}
+
+function decodeToken(token: string): string {
+  let decoded = "";
+  for (let index = 0; index < token.length; index += 1) {
+    const character = token[index];
+    if (character !== "~") {
+      decoded += character;
+      continue;
+    }
+
+    const escaped = token[index + 1];
+    if (escaped === "0") {
+      decoded += "~";
+    } else if (escaped === "1") {
+      decoded += "/";
+    } else {
+      throw new TypeError(`Invalid escape sequence in JSON Pointer token: ${token}`);
+    }
+    index += 1;
+  }
+  return decoded;
+}
