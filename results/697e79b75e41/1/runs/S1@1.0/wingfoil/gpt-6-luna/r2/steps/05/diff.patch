+type JsonPatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+/**
+ * Creates a minimal structural RFC 6902 JSON Patch that transforms `from` into `to`.
+ * Objects are diffed by member and arrays by their common prefix and suffix; values
+ * that differ as scalars or at the root are replaced. Inputs are validated and never changed.
+ *
+ * @param from The original JSON value.
+ * @param to The desired JSON value.
+ * @returns An RFC 6902 patch containing only changed members or values.
+ * @throws TypeError if either input is not a valid JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  assertJsonValue(from, "from");
+  assertJsonValue(to, "to");
+  const patch: JsonPatchOperation[] = [];
+  diffJson(from, to, "", patch);
+  return patch;
+}
+
+function diffJson(from: unknown, to: unknown, path: string, patch: JsonPatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from).sort()) {
+      if (!Object.hasOwn(to, key)) patch.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+    }
+    for (const key of Object.keys(to).sort()) {
+      const childPath = `${path}/${encodeToken(key)}`;
+      if (!Object.hasOwn(from, key)) patch.push({ op: "add", path: childPath, value: cloneJson(to[key]) });
+      else diffJson(from[key], to[key], childPath, patch);
+    }
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    let prefix = 0;
+    while (prefix < from.length && prefix < to.length && jsonEqual(from[prefix], to[prefix])) prefix++;
+    let suffix = 0;
+    while (suffix < from.length - prefix && suffix < to.length - prefix &&
+      jsonEqual(from[from.length - 1 - suffix], to[to.length - 1 - suffix])) suffix++;
+    const fromMiddle = from.length - prefix - suffix;
+    const toMiddle = to.length - prefix - suffix;
+    const overlap = Math.min(fromMiddle, toMiddle);
+    for (let i = 0; i < overlap; i++) diffJson(from[prefix + i], to[prefix + i], `${path}/${prefix + i}`, patch);
+    for (let i = fromMiddle - 1; i >= overlap; i--) {
+      patch.push({ op: "remove", path: `${path}/${prefix + i}` });
+    }
+    for (let i = overlap; i < toMiddle; i++) {
+      patch.push({ op: "add", path: `${path}/${prefix + i}`, value: cloneJson(to[prefix + i]) });
+    }
+    return;
+  }
+  patch.push({ op: "replace", path, value: cloneJson(to) });
+}
+
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
