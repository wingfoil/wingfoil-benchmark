+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * The empty pointer refers to the entire document. A nonempty pointer must
+ * begin with `/`; reference tokens use `~1` for `/` and `~0` for `~`.
+ * Throws a `TypeError` for malformed pointers and a `RangeError` when a valid
+ * pointer does not identify a value in the document.
+ *
+ * @param document The JSON value to traverse.
+ * @param pointer An RFC 6901 JSON Pointer string.
+ * @returns The value selected by the pointer.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new TypeError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return document;
+  if (!pointer.startsWith("/")) {
+    throw new TypeError("JSON Pointer must be empty or begin with '/'");
+  }
+
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+  let value = document;
+
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new RangeError(`Invalid array index: ${token}`);
+      }
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= value.length) {
+        throw new RangeError(`Array index does not exist: ${token}`);
+      }
+      value = value[index];
+    } else if (value !== null && typeof value === "object") {
+      if (!Object.hasOwn(value, token)) {
+        throw new RangeError(`Object member does not exist: ${token}`);
+      }
+      value = (value as Record<string, unknown>)[token];
+    } else {
+      throw new RangeError(`Pointer cannot be resolved through token: ${token}`);
+    }
+  }
+
+  return value;
+}
+
+function decodeToken(token: string): string {
+  if (/~(?:[^01]|$)/.test(token)) {
+    throw new TypeError(`Invalid escape sequence in JSON Pointer token: ${token}`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
