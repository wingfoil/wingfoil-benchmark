@@ -266,3 +266,39 @@ function jsonEqual(left: unknown, right: unknown): boolean {
 function samePath(left: string[], right: string[]): boolean {
   return left.length === right.length && left.every((token, index) => token === right[index]);
 }
+
+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document without changing either input.
+ * Object patches recursively update members, null patch members remove object properties,
+ * and any non-object patch replaces the target value.
+ *
+ * @param target The JSON value to update.
+ * @param patch The RFC 7386 merge patch value.
+ * @returns The merged JSON value.
+ * @throws TypeError if either input is not a valid JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJsonValue(target, "target");
+  assertJsonValue(patch, "patch");
+  return mergePatch(target, patch);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return cloneJson(patch);
+
+  const result: Record<string, unknown> = isObject(target) ? cloneJson(target) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      Object.defineProperty(result, key, {
+        value: mergePatch(Object.hasOwn(result, key) ? result[key] : undefined, value),
+        enumerable: true,
+        configurable: true,
+        writable: true,
+      });
+    }
+  }
+  return result;
+}
