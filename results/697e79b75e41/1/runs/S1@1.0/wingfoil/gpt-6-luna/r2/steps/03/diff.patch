--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -35,3 +35,35 @@ test("throws when an operation cannot be applied", () => {
   throws(() => applyPatch([], [{ op: "add", path: "/01", value: 0 }]));
   throws(() => applyPatch({}, [{ op: "move", from: "/a", path: "/a/b" }]));
 });
+
+test("follows RFC add, move, and copy semantics", () => {
+  deepStrictEqual(applyPatch({ a: 1, list: ["a", "b", "c"] }, [
+    { op: "add", path: "/a", value: 2 },
+    { op: "move", from: "/list/0", path: "/list/2" },
+    { op: "copy", from: "/a", path: "/copied", ignored: "extension member" },
+  ]), { a: 2, list: ["b", "c", "a"], copied: 2 });
+});
+
+test("requires own, correctly typed operation members and valid JSON values", () => {
+  const inherited = Object.assign(Object.create({ op: "add", path: "/x", value: 1 }), {});
+  throws(() => applyPatch({}, [inherited]), TypeError);
+  throws(() => applyPatch({}, [{ op: "add", path: "/x" }]), TypeError);
+  throws(() => applyPatch({}, [{ op: "add", path: "/x", value: undefined }]), TypeError);
+  throws(() => applyPatch({ n: Number.NaN }, []), TypeError);
+  throws(() => applyPatch({}, [{ op: "remove", path: "/x" }]), RangeError);
+  throws(() => applyPatch({}, [{ op: "replace", path: "/x", value: 1 }]), RangeError);
+  throws(() => applyPatch({}, [{ op: "add", path: "/a/b", value: 1 }]), RangeError);
+});
+
+test("test compares JSON values structurally and failed patches leave input untouched", () => {
+  const document = { n: 1, nested: { a: [true, null] } };
+  deepStrictEqual(applyPatch(document, [
+    { op: "test", path: "/nested", value: { a: [true, null] } },
+    { op: "test", path: "/n", value: 1.0 },
+  ]), document);
+  throws(() => applyPatch(document, [
+    { op: "replace", path: "/n", value: 2 },
+    { op: "test", path: "/n", value: 3 },
+  ]), RangeError);
+  deepStrictEqual(document, { n: 1, nested: { a: [true, null] } });
+});
