+/** Applies an RFC 6902 JSON Patch without modifying the input document. */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new TypeError("JSON Patch must be an array");
+  let result = cloneJson(document);
+  for (const item of patch) {
+    if (item === null || typeof item !== "object" || Array.isArray(item)) throw new TypeError("JSON Patch operation must be an object");
+    const operation = item as Record<string, unknown>;
+    const op = operation.op;
+    const path = operation.path;
+    if (typeof op !== "string" || typeof path !== "string") throw new TypeError("Operation requires string 'op' and 'path'");
+    const tokens = parsePointer(path);
+    switch (op) {
+      case "add":
+        requireMember(operation, "value");
+        result = addAt(result, tokens, cloneJson(operation.value));
+        break;
+      case "remove":
+        result = removeAt(result, tokens).document;
+        break;
+      case "replace":
+        requireMember(operation, "value");
+        resolvePointer(result, path);
+        result = addAt(result, tokens, cloneJson(operation.value), true);
+        break;
+      case "copy": {
+        const from = parseFrom(operation);
+        result = addAt(result, tokens, cloneJson(resolvePointer(result, from)));
+        break;
+      }
+      case "move": {
+        const from = parseFrom(operation);
+        const fromTokens = parsePointer(from);
+        if (tokens.length > fromTokens.length && fromTokens.every((token, i) => token === tokens[i])) throw new Error("Cannot move a value into its child");
+        const value = resolvePointer(result, from);
+        if (from !== path) {
+          result = removeAt(result, fromTokens).document;
+          result = addAt(result, tokens, value);
+        }
+        break;
+      }
+      case "test":
+        requireMember(operation, "value");
+        if (!jsonEqual(resolvePointer(result, path), operation.value)) throw new Error(`JSON Patch test failed at ${path}`);
+        break;
+      default:
+        throw new TypeError(`Unsupported JSON Patch operation: ${op}`);
+    }
+  }
