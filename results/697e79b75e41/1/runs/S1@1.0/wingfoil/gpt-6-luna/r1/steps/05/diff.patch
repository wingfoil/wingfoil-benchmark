+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ * Unchanged object members and array entries are omitted from the patch.
+ * Neither input is modified.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  const source = cloneJson(from);
+  const target = cloneJson(to);
+  const patch: unknown[] = [];
+  diffJson(source, target, [], patch);
+  return patch;
+}
+
+function diffJson(from: unknown, to: unknown, path: string[], patch: unknown[]): void {
+  if (jsonEqual(from, to)) return;
+  if (from !== null && to !== null && typeof from === "object" && typeof to === "object" && !Array.isArray(from) && !Array.isArray(to)) {
+    const oldObject = from as Record<string, unknown>;
+    const newObject = to as Record<string, unknown>;
+    for (const key of Object.keys(oldObject)) {
+      if (!Object.prototype.hasOwnProperty.call(newObject, key)) {
+        patch.push({ op: "remove", path: pointerFromTokens([...path, key]) });
+      }
+    }
+    for (const key of Object.keys(newObject)) {
+      const childPath = [...path, key];
+      if (!Object.prototype.hasOwnProperty.call(oldObject, key)) {
+        patch.push({ op: "add", path: pointerFromTokens(childPath), value: cloneJson(newObject[key]) });
+      } else {
+        diffJson(oldObject[key], newObject[key], childPath, patch);
+      }
+    }
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, patch);
+    return;
+  }
+  patch.push({ op: "replace", path: pointerFromTokens(path), value: cloneJson(to) });
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string[], patch: unknown[]): void {
+  // For same-length arrays, index correspondence preserves the smallest nested edits.
+  if (from.length === to.length) {
+    for (let i = 0; i < from.length; i++) diffJson(from[i], to[i], [...path, String(i)], patch);
+    return;
+  }
+
+  // Longest common subsequence keeps stable entries in place and expresses insertions
+  // and removals as single operations, rather than replacing the entire array.
+  const rows = from.length + 1, cols = to.length + 1;
+  const lengths = Array.from({ length: rows }, () => new Array<number>(cols).fill(0));
+  for (let i = from.length - 1; i >= 0; i--) {
+    for (let j = to.length - 1; j >= 0; j--) {
+      lengths[i][j] = jsonEqual(from[i], to[j])
+        ? lengths[i + 1][j + 1] + 1
+        : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  let i = 0, j = 0, index = 0;
+  while (i < from.length || j < to.length) {
+    if (i < from.length && j < to.length && jsonEqual(from[i], to[j])) {
+      i++; j++; index++;
+    } else if (i < from.length && (j === to.length || lengths[i + 1][j] >= lengths[i][j + 1])) {
+      patch.push({ op: "remove", path: pointerFromTokens([...path, String(index)]) });
+      i++;
+    } else {
+      patch.push({ op: "add", path: pointerFromTokens([...path, String(index)]), value: cloneJson(to[j]) });
+      j++; index++;
+    }
+  }
+}
+
 function parsePointer(pointer: string): string[] {
   if (pointer === "") return [];
   if (!pointer.startsWith("/")) throw new TypeError("JSON Pointer must be empty or begin with '/'");
