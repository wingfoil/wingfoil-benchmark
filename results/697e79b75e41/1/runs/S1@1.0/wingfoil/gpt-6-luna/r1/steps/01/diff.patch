+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * The empty pointer selects the entire document. A pointer beginning with `/`
+ * selects successive object members or array elements, with `~1` and `~0`
+ * decoded as `/` and `~` respectively. Throws if the pointer is malformed or
+ * any reference token does not identify a value in the document.
+ *
+ * @param document The JSON value to inspect.
+ * @param pointer An RFC 6901 JSON Pointer string.
+ * @returns The value selected by the pointer.
+ * @throws {TypeError} If `pointer` is not a valid JSON Pointer string.
+ * @throws {Error} If the pointer does not resolve within `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new TypeError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return document;
+  if (!pointer.startsWith("/")) {
+    throw new TypeError("JSON Pointer must be empty or begin with '/'");
+  }
+
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+  let current: unknown = document;
+
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`JSON Pointer array index is invalid: ${token}`);
+      }
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= current.length) {
+        throw new Error(`JSON Pointer does not resolve: ${token}`);
+      }
+      current = current[index];
+    } else if (current !== null && typeof current === "object") {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(`JSON Pointer does not resolve: ${token}`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer does not resolve: ${token}`);
+    }
+  }
+
+  return current;
+}
+
+function decodeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new TypeError(`Invalid escape in JSON Pointer token: ${token}`);
+  }
+  // RFC 6901 permits only ~0 and ~1 escapes. Decode in one pass so that
+  // sequences such as ~01 become ~1 rather than /.
+  return token.replace(/~[01]/g, (escape) => (escape === "~1" ? "/" : "~"));
+}
