+/**
+ * Applies an RFC 7386 JSON Merge Patch without modifying either input.
+ * Object members with a `null` patch value are removed; other object members
+ * are recursively merged. A non-object patch replaces the target entirely.
+ *
+ * @param target The JSON value to update.
+ * @param patch The JSON Merge Patch value.
+ * @returns The merged JSON value.
+ * @throws {TypeError} If either input is not representable as JSON.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  const targetCopy = cloneJson(target);
+  const patchCopy = cloneJson(patch);
+  return mergePatchValue(targetCopy, patchCopy);
+}
+
+function mergePatchValue(target: unknown, patch: unknown): unknown {
+  if (patch === null || typeof patch !== "object" || Array.isArray(patch)) {
+    return patch;
+  }
+
+  const result: Record<string, unknown> =
+    target !== null && typeof target === "object" && !Array.isArray(target)
+      ? target as Record<string, unknown>
+      : {};
+
+  for (const key of Object.keys(patch)) {
+    const value = (patch as Record<string, unknown>)[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      Object.defineProperty(result, key, {
+        value: mergePatchValue(result[key], value),
+        enumerable: true,
+        configurable: true,
+        writable: true,
+      });
+    }
+  }
+  return result;
+}
