diff --git a/test/apply-patch.test.js b/test/apply-patch.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..a2abd31ab722d9e8a179483a5797b013b53b6918
--- /dev/null
+++ b/test/apply-patch.test.js
@@ -0,0 +1,57 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("applies all RFC 6902 operations and ignores undefined operation members", () => {
+  const input = { a: [1, 2], b: { value: true } };
+  const result = applyPatch(input, [
+    { op: "add", path: "/a/1", value: 3, ignored: "member" },
+    { op: "copy", from: "/b", path: "/c" },
+    { op: "move", from: "/a/0", path: "/a/2" },
+    { op: "replace", path: "/c/value", value: false },
+    { op: "test", path: "/a", value: [3, 2, 1] },
+    { op: "remove", path: "/b" },
+  ]);
+  assert.deepEqual(result, { a: [3, 2, 1], c: { value: false } });
+  assert.deepEqual(input, { a: [1, 2], b: { value: true } });
+});
+
+test("move evaluates its destination after removing the source", () => {
+  assert.deepEqual(applyPatch(["a", "b", "c"], [{ op: "move", from: "/0", path: "/2" }]), ["b", "c", "a"]);
+});
+
+test("supports root replacement, array append, escaped keys, and numeric equality", () => {
+  const root = applyPatch({ "a/b~c": 1 }, [{ op: "replace", path: "", value: [] }, { op: "add", path: "/-", value: 1 }]);
+  assert.deepEqual(root, [1]);
+  assert.deepEqual(applyPatch({ n: 1 }, [{ op: "test", path: "/n", value: 1.0 }]), { n: 1 });
+  assert.deepEqual(applyPatch({ n: -0 }, [{ op: "test", path: "/n", value: 0 }]), { n: -0 });
+  assert.deepEqual(applyPatch({ "a/b~c": 1 }, [{ op: "test", path: "/a~1b~0c", value: 1 }]), { "a/b~c": 1 });
+});
+
+test("rejects invalid operations, invalid required members, and invalid array locations", () => {
+  for (const patch of [
+    [{ op: "add", path: "/x" }],
+    [{ op: "remove", path: "/missing" }],
+    [{ op: "replace", path: "/missing", value: 1 }],
+    [{ op: "add", path: "/a/3", value: 1 }],
+    [{ op: "add", path: "/a/-", value: 1 }, { op: "remove", path: "/a/-" }],
+    [{ op: "move", from: "/a", path: "/a/b" }],
+    [{ op: "wat", path: "/x" }],
+  ]) assert.throws(() => applyPatch({ a: [1, 2] }, patch));
+});
+
+test("failed patches do not change the input document", () => {
+  const input = { value: 1 };
+  assert.throws(() => applyPatch(input, [
+    { op: "replace", path: "/value", value: 2 },
+    { op: "test", path: "/value", value: 3 },
+  ]));
+  assert.deepEqual(input, { value: 1 });
+});
+
+test("rejects values outside the JSON data model", () => {
+  assert.throws(() => applyPatch({ value: undefined }, []));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/x", value: Infinity }]));
+  const cyclic = {}; cyclic.self = cyclic;
+  assert.throws(() => applyPatch(cyclic, []));
+});
