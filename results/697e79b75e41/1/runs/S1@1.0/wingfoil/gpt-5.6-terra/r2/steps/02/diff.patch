+    { op: "add", path: "/foo/-", value: "last" },
+    { op: "remove", path: "/foo/0" },
+    { op: "replace", path: "/object/nested", value: false },
+    { op: "copy", from: "/object", path: "/copied" },
+    { op: "move", from: "/foo/0", path: "/foo/2" },
+    { op: "test", path: "/copied/nested", value: false },
+  ]);
+
+  assert.deepEqual(result, {
+    foo: ["baz", "last", "qux"],
+    object: { nested: false },
+    copied: { nested: false },
+  });
+  assert.deepEqual(document, {
+    foo: ["bar", "baz"],
+    object: { nested: true },
+  });
+  assert.notEqual(result, document);
+});
+
