+  assert.throws(() => applyPatch(document, [{ op: "unknown", path: "/x" }]));
+  assert.throws(() => applyPatch(document, [{ op: "add", path: "/array/2", value: "two" }]));
+  assert.throws(() => applyPatch(document, [{ op: "replace", path: "/missing", value: 1 }]));
+  assert.throws(() => applyPatch(document, [{ op: "move", from: "/array", path: "/array/0/x" }]));
+  assert.throws(() => applyPatch(document, [{ op: "test", path: "/array/0", value: "two" }]));
+  assert.deepEqual(document, { array: ["one"] });
