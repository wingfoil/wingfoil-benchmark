+import { applyMergePatch, applyPatch, resolvePointer } from "../src/index.ts";
 
 const exampleDocument = {
   foo: ["bar", "baz"],
@@ -112,3 +112,50 @@ test("leaves the supplied document unchanged when a later operation fails", () =
 
   assert.deepEqual(document, { value: 1 });
 });
+
+test("applies RFC 7386 merge patches recursively and removes null members", () => {
+  const target = {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+  assert.deepEqual(target, {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  });
+  assert.deepEqual(patch, {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  });
+});
+
+test("replaces a target with a non-object merge patch and treats non-objects as empty objects", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, ["c"]), ["c"]);
+  assert.deepEqual(applyMergePatch(["a", "b"], { a: "c" }), { a: "c" });
+  assert.deepEqual(applyMergePatch(null, { a: null, b: { c: 1 } }), { b: { c: 1 } });
+  assert.deepEqual(applyMergePatch({ a: 1 }, null), null);
+});
+
+test("rejects non-JSON merge patch inputs", () => {
+  assert.throws(() => applyMergePatch(new Date(), {}));
+  assert.throws(() => applyMergePatch({}, new Date()));
+});
