+---
+
+Implement RFC 7386 JSON Merge Patch support.
+
+Export `applyMergePatch(target, patch)` from `src/index.ts`. It applies an object patch recursively,
+removes object members whose patch value is `null`, and replaces the target for every non-object
+patch. The operation must not mutate either input and must reject values that are not valid JSON.
+Document the public API and cover the RFC examples, replacement semantics, and immutability with
+automated tests.
diff --git a/src/index.ts b/src/index.ts
index a77dc57dac2e76cd7235d4c256b746655f6b894b..e5b42c19fafffe4be21713199bf3e1d7dd1aa93f 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -44,6 +44,34 @@ export function applyPatch(document: JsonValue, patch: readonly unknown[]): Json
   return result;
 }
 
+/**
+ * Applies an RFC 7386 JSON Merge Patch without changing either input document.
+ *
+ * Object-valued patches merge recursively and remove members assigned `null`; every other patch
+ * value replaces the target document or member.
+ *
+ * @throws {Error} If the target or patch is not a valid JSON value.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  return mergePatch(cloneJsonValue(target), cloneJsonValue(patch));
+}
+
+function mergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return patch;
+  }
+
+  const result: { [key: string]: JsonValue } = isJsonObject(target) ? target : {};
+  for (const [key, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[key];
+    } else {
+      setObjectMember(result, key, mergePatch(result[key] ?? null, value));
+    }
+  }
+  return result;
+}
+
 function applyOperation(document: JsonValue, operation: unknown): JsonValue {
   if (operation === null || typeof operation !== "object" || Array.isArray(operation)) {
     throw new Error("A JSON Patch operation must be an object.");
