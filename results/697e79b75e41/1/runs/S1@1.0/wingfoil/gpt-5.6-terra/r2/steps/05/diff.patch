 import assert from "node:assert/strict";
 import test from "node:test";
 
-import { applyMergePatch, applyPatch, resolvePointer } from "../src/index.ts";
+import { applyMergePatch, applyPatch, createPatch, resolvePointer } from "../src/index.ts";
+
+test("creates a minimal structural JSON Patch without mutating its inputs", () => {
+  const from = {
+    unchanged: { nested: ["one", "two"] },
+    settings: { "a/b": "before", retained: true },
+  };
+  const to = {
+    unchanged: { nested: ["one", "two"] },
+    settings: { "a/b": "after", retained: true },
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: "replace", path: "/settings/a~1b", value: "after" }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    unchanged: { nested: ["one", "two"] },
+    settings: { "a/b": "before", retained: true },
+  });
+  assert.deepEqual(to, {
+    unchanged: { nested: ["one", "two"] },
+    settings: { "a/b": "after", retained: true },
+  });
+});
+
+test("creates compact patches for array insertions, removals, and root replacements", () => {
+  const inserted = createPatch(["Ada", "Linus"], ["Ada", "Grace", "Linus"]);
+  assert.deepEqual(inserted, [{ op: "add", path: "/1", value: "Grace" }]);
+  assert.deepEqual(applyPatch(["Ada", "Linus"], inserted), ["Ada", "Grace", "Linus"]);
+
+  const removed = createPatch(["Ada", "Grace", "Linus"], ["Ada", "Linus"]);
+  assert.deepEqual(removed, [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(applyPatch(["Ada", "Grace", "Linus"], removed), ["Ada", "Linus"]);
+
+  const rootReplacement = createPatch({ value: true }, ["replacement"]);
+  assert.deepEqual(rootReplacement, [{ op: "replace", path: "", value: ["replacement"] }]);
+  assert.deepEqual(applyPatch({ value: true }, rootReplacement), ["replacement"]);
+});
+
+test("rejects non-JSON values when creating a patch", () => {
+  assert.throws(() => createPatch(new Date(), {}));
+  assert.throws(() => createPatch({}, new Date()));
+});
 
