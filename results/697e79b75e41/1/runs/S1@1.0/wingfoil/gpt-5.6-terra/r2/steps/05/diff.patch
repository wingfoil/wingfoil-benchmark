+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ *
+ * The patch changes only differing object members and array elements where possible. Neither input
+ * is modified, and values placed in the patch do not share mutable references with either input.
+ *
+ * @throws {Error} If either input is not a valid JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatchOperation[] {
+  const source = cloneJsonValue(from);
+  const target = cloneJsonValue(to);
+  const patch: JsonPatchOperation[] = [];
+  createPatchOperations(source, target, "", patch);
+  return patch;
+}
