+function createPatchOperations(from: JsonValue, to: JsonValue, path: string, patch: JsonPatchOperation[]): void {
+  if (jsonEquals(from, to)) {
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    for (const key of Object.keys(from)) {
+      const memberPath = appendPointer(path, key);
+      if (!hasOwn(to, key)) {
+        patch.push({ op: "remove", path: memberPath });
+      } else {
+        createPatchOperations(from[key]!, to[key]!, memberPath, patch);
+      }
+    }
+    for (const key of Object.keys(to)) {
+      if (!hasOwn(from, key)) {
+        patch.push({ op: "add", path: appendPointer(path, key), value: to[key]! });
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    if (from.length === to.length) {
+      for (let index = 0; index < from.length; index += 1) {
+        createPatchOperations(from[index]!, to[index]!, appendPointer(path, String(index)), patch);
+      }
+    } else {
+      createArrayPatchOperations(from, to, path, patch);
+    }
+    return;
+  }
+
+  patch.push({ op: "replace", path, value: to });
+}
+
+function createArrayPatchOperations(from: JsonValue[], to: JsonValue[], path: string, patch: JsonPatchOperation[]): void {
+  const longestCommonSubsequence = createLcsLengths(from, to);
+  let fromIndex = 0;
+  let toIndex = 0;
+  let patchIndex = 0;
+
+  while (fromIndex < from.length && toIndex < to.length) {
+    if (jsonEquals(from[fromIndex]!, to[toIndex]!)) {
+      fromIndex += 1;
+      toIndex += 1;
+      patchIndex += 1;
+    } else if (longestCommonSubsequence[fromIndex + 1]![toIndex]! >= longestCommonSubsequence[fromIndex]![toIndex + 1]!) {
+      patch.push({ op: "remove", path: appendPointer(path, String(patchIndex)) });
+      fromIndex += 1;
+    } else {
+      patch.push({ op: "add", path: appendPointer(path, String(patchIndex)), value: to[toIndex]! });
+      toIndex += 1;
+      patchIndex += 1;
+    }
+  }
+
+  while (fromIndex < from.length) {
+    patch.push({ op: "remove", path: appendPointer(path, String(patchIndex)) });
+    fromIndex += 1;
+  }
+  while (toIndex < to.length) {
+    patch.push({ op: "add", path: appendPointer(path, String(patchIndex)), value: to[toIndex]! });
+    toIndex += 1;
+    patchIndex += 1;
+  }
+}
+
+function createLcsLengths(from: JsonValue[], to: JsonValue[]): number[][] {
+  const lengths = Array.from({ length: from.length + 1 }, () => Array<number>(to.length + 1).fill(0));
+  for (let fromIndex = from.length - 1; fromIndex >= 0; fromIndex -= 1) {
+    for (let toIndex = to.length - 1; toIndex >= 0; toIndex -= 1) {
+      lengths[fromIndex]![toIndex] = jsonEquals(from[fromIndex]!, to[toIndex]!)
+        ? lengths[fromIndex + 1]![toIndex + 1]! + 1
+        : Math.max(lengths[fromIndex + 1]![toIndex]!, lengths[fromIndex]![toIndex + 1]!);
+    }
+  }
+  return lengths;
+}
+
+function appendPointer(path: string, token: string): string {
+  return `${path}/${token.replace(/~/g, "~0").replace(/\//g, "~1")}`;
+}
