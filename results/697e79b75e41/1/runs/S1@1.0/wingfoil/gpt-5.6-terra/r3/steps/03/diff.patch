index 1a3642e8dc2e242434c08cd56257726dc1859cac..177d3b36a1969f54b81c477565e9136eecdcd7b2 100644
--- a/test/index.test.mjs
+++ b/test/index.test.mjs
@@ -96,3 +96,35 @@ test('rejects invalid patches and failed operations without changing the input',
 
   assert.deepEqual(document, { values: [1], child: { value: true } });
 });
+
+test('requires operation members to be own JSON members and ignores defined extras', () => {
+  const inheritedOperation = Object.create({
+    op: 'add',
+    path: '/added',
+    value: true,
+  });
+
+  assert.throws(() => applyPatch({}, [inheritedOperation]));
+  assert.throws(() => applyPatch({}, [{
+    op: 'add',
+    path: '/added',
+    value: true,
+    invalidJsonExtra: undefined,
+  }]));
+  assert.deepEqual(
+    applyPatch({}, [{ op: 'add', path: '/added', value: true, ignored: null }]),
+    { added: true },
+  );
+});
+
+test('terminates a failed patch without changing the caller document', () => {
+  const document = { value: 1 };
+
+  assert.throws(() => applyPatch(document, [
+    { op: 'replace', path: '/value', value: 2 },
+    { op: 'test', path: '/value', value: 3 },
+    { op: 'add', path: '/unreached', value: true },
+  ]));
+
+  assert.deepEqual(document, { value: 1 });
+});
