+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document.
+ *
+ * Object patches merge recursively. A `null` object member removes that member, while arrays and
+ * all other JSON values replace the corresponding target value. Neither input document is mutated.
+ *
+ * @throws {TypeError} If `target` or `patch` contains a non-JSON value.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  assertJsonValue(target, 'target');
+  assertJsonValue(patch, 'patch');
+
+  if (!isJsonObject(patch)) {
+    return cloneJsonValue(patch);
+  }
+
+  const result = isJsonObject(target) ? cloneJsonValue(target) : {};
+  for (const [name, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[name];
+    } else {
+      const current = Object.hasOwn(result, name) ? result[name] : null;
+      Object.defineProperty(result, name, {
+        configurable: true,
+        enumerable: true,
+        value: applyMergePatch(current, value),
+        writable: true,
+      });
+    }
+  }
+  return result;
+}
+
 function validateOperation(operation: unknown, index: number): JsonPatchOperation {
   if (operation === null || typeof operation !== 'object' || Array.isArray(operation)) {
     throw new TypeError(`JSON Patch operation ${index} must be an object.`);
@@ -284,6 +317,10 @@ function cloneJsonValue(value: JsonValue): JsonValue {
   return value;
 }
 
+function isJsonObject(value: JsonValue): value is { [key: string]: JsonValue } {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
