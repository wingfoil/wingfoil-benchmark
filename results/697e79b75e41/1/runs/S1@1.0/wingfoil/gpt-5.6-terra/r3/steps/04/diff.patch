+
+test('applies RFC 7386 object patches recursively', () => {
+  const target = {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  };
+  const patch = {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: 'Hello!',
+    author: { givenName: 'John' },
+    tags: ['example'],
+    content: 'This will be unchanged',
+    phoneNumber: '+01-123-456-7890',
+  });
+  assert.deepEqual(target, {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  });
+});
+
+test('replaces targets for non-object merge patches and object-patches non-objects', () => {
+  assert.equal(applyMergePatch({ value: true }, null), null);
+  assert.deepEqual(applyMergePatch(['a', 'b'], { added: true }), { added: true });
+  assert.deepEqual(applyMergePatch({ nested: { removed: true } }, { nested: null }), {});
+});
+
+test('does not retain mutable references or inherited members in merge-patch results', () => {
+  const target = { preserved: { value: true } };
+  const patch = { added: { value: false }, ['__proto__']: { safe: true } };
+  const result = applyMergePatch(target, patch);
+
+  assert.deepEqual(result, {
+    preserved: { value: true },
+    added: { value: false },
+    ['__proto__']: { safe: true },
+  });
+  assert.notEqual(result.preserved, target.preserved);
+  assert.notEqual(result.added, patch.added);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
