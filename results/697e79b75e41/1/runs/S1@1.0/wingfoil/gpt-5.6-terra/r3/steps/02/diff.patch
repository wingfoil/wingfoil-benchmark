@@ -17,3 +17,18 @@ import { resolvePointer } from 'json-toolkit';
 const document = { services: [{ name: 'catalog' }] };
 resolvePointer(document, '/services/0/name'); // 'catalog'
 ```
+
+## JSON Patch
+
+`applyPatch(document, patch)` applies an [RFC 6902 JSON Patch](https://www.rfc-editor.org/rfc/rfc6902)
+array and returns a new JSON document. It supports `add`, `remove`, `replace`, `move`, `copy`, and
+`test`; validates patch input; and throws if an operation cannot be applied. Neither the input
+document nor values copied from it are mutated.
+
+```ts
+import { applyPatch } from 'json-toolkit';
+
+applyPatch({ services: ['catalog'] }, [
+  { op: 'add', path: '/services/-', value: 'search' },
+]); // { services: ['catalog', 'search'] }
+```
