+/**
+ * Applies an RFC 6902 JSON Patch to a JSON document.
+ *
+ * The input document is never mutated. The returned document and values copied into it are new
+ * values, so they can safely be changed independently of the input.
+ *
+ * @throws {TypeError} If the document, patch, operation, or JSON Pointer is invalid.
+ * @throws {Error} If an operation cannot be applied or a `test` operation fails.
+ */
+export function applyPatch(document: JsonValue, patch: readonly JsonPatchOperation[]): JsonValue {
+  assertJsonValue(document, 'document');
+
+  if (!Array.isArray(patch)) {
+    throw new TypeError('A JSON Patch must be an array of operations.');
+  }
+
+  let result = cloneJsonValue(document);
+  for (let index = 0; index < patch.length; index += 1) {
+    const operation = validateOperation(patch[index], index);
+    const path = parsePointer(operation.path);
+
+    switch (operation.op) {
+      case 'add':
+        result = addValue(result, path, cloneJsonValue(operation.value));
+        break;
+      case 'remove':
+        result = removeValue(result, path);
+        break;
+      case 'replace':
+        result = replaceValue(result, path, cloneJsonValue(operation.value));
+        break;
+      case 'move': {
+        const from = parsePointer(operation.from);
+        if (isProperPrefix(from, path)) {
+          throw new Error('A move operation cannot move a value into one of its children.');
+        }
+
+        const value = cloneJsonValue(getValue(result, from));
+        result = removeValue(result, from);
+        result = addValue(result, path, value);
+        break;
+      }
+      case 'copy':
+        result = addValue(result, path, cloneJsonValue(getValue(result, parsePointer(operation.from))));
+        break;
+      case 'test':
+        if (!jsonEqual(getValue(result, path), operation.value)) {
+          throw new Error(`JSON Patch test operation ${index} failed.`);
+        }
+        break;
+    }
+  }
+
+  return result;
+}
+
+function validateOperation(operation: unknown, index: number): JsonPatchOperation {
+  if (operation === null || typeof operation !== 'object' || Array.isArray(operation)) {
+    throw new TypeError(`JSON Patch operation ${index} must be an object.`);
+  }
+
+  const candidate = operation as Record<string, unknown>;
+  if (typeof candidate.op !== 'string' || typeof candidate.path !== 'string') {
+    throw new TypeError(`JSON Patch operation ${index} requires string "op" and "path" members.`);
+  }
+
+  switch (candidate.op) {
+    case 'add':
+    case 'replace':
+    case 'test':
+      assertJsonValue(candidate.value, `value in JSON Patch operation ${index}`);
+      return candidate as JsonPatchOperation;
+    case 'remove':
+      return candidate as JsonPatchOperation;
+    case 'move':
+    case 'copy':
+      if (typeof candidate.from !== 'string') {
+        throw new TypeError(`JSON Patch operation ${index} requires a string "from" member.`);
+      }
+      return candidate as JsonPatchOperation;
+    default:
+      throw new TypeError(`JSON Patch operation ${index} has unsupported op "${candidate.op}".`);
+  }
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === '') {
+    return [];
+  }
+  if (!pointer.startsWith('/')) {
+    throw new TypeError('A non-empty JSON Pointer must start with "/".');
+  }
+  return pointer.slice(1).split('/').map(decodeToken);
+}
+
+function getValue(document: JsonValue, tokens: readonly string[]): JsonValue {
+  let current = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!isArrayIndex(token) || Number(token) >= current.length) {
+        throw new Error(`The JSON Pointer does not resolve: array index "${token}" is absent.`);
+      }
+      current = current[Number(token)];
+    } else if (current !== null && typeof current === 'object' && Object.hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`The JSON Pointer does not resolve: member "${token}" is absent.`);
+    }
+  }
+  return current;
+}
+
+function parentAndToken(document: JsonValue, tokens: readonly string[]): [JsonValue, string] {
+  if (tokens.length === 0) {
+    throw new Error('The document root has no parent.');
+  }
+  return [getValue(document, tokens.slice(0, -1)), tokens[tokens.length - 1]];
+}
+
+function addValue(document: JsonValue, tokens: readonly string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const [parent, token] = parentAndToken(document, tokens);
+  if (Array.isArray(parent)) {
+    const index = token === '-' ? parent.length : arrayInsertionIndex(token, parent.length);
+    parent.splice(index, 0, value);
+  } else if (parent !== null && typeof parent === 'object') {
+    // Defining an own property preserves JSON's ability to represent a "__proto__" member.
+    Object.defineProperty(parent, token, {
+      configurable: true,
+      enumerable: true,
+      value,
+      writable: true,
+    });
+  } else {
+    throw new Error('The JSON Pointer parent is not a container.');
+  }
+  return document;
+}
+
+function removeValue(document: JsonValue, tokens: readonly string[]): JsonValue {
+  if (tokens.length === 0) {
+    return null;
+  }
+  const [parent, token] = parentAndToken(document, tokens);
+  if (Array.isArray(parent)) {
+    const index = existingArrayIndex(token, parent.length);
+    parent.splice(index, 1);
+  } else if (parent !== null && typeof parent === 'object' && Object.hasOwn(parent, token)) {
+    delete parent[token];
+  } else {
+    throw new Error(`The JSON Pointer does not resolve: member "${token}" is absent.`);
+  }
+  return document;
+}
+
+function replaceValue(document: JsonValue, tokens: readonly string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const [parent, token] = parentAndToken(document, tokens);
+  if (Array.isArray(parent)) {
+    parent[existingArrayIndex(token, parent.length)] = value;
+  } else if (parent !== null && typeof parent === 'object' && Object.hasOwn(parent, token)) {
+    parent[token] = value;
+  } else {
+    throw new Error(`The JSON Pointer does not resolve: member "${token}" is absent.`);
+  }
+  return document;
+}
+
+function arrayInsertionIndex(token: string, length: number): number {
+  if (!isArrayIndex(token) || Number(token) > length) {
+    throw new Error(`The JSON Patch array index "${token}" is invalid for an add operation.`);
+  }
+  return Number(token);
+}
+
+function existingArrayIndex(token: string, length: number): number {
+  if (!isArrayIndex(token) || Number(token) >= length) {
+    throw new Error(`The JSON Pointer does not resolve: array index "${token}" is absent.`);
+  }
+  return Number(token);
+}
+
+function isProperPrefix(prefix: readonly string[], value: readonly string[]): boolean {
+  return prefix.length < value.length && prefix.every((token, index) => token === value[index]);
+}
+
+function cloneJsonValue(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(cloneJsonValue);
+  }
+  if (value !== null && typeof value === 'object') {
+    return Object.fromEntries(Object.entries(value).map(([key, entry]) => [key, cloneJsonValue(entry)]));
+  }
+  return value;
+}
+
+function jsonEqual(left: JsonValue, right: JsonValue): boolean {
+  if (left === right) {
+    return true;
+  }
+  if (typeof left !== 'object' || left === null || typeof right !== 'object' || right === null) {
+    return false;
+  }
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return Array.isArray(left) && Array.isArray(right)
+      && left.length === right.length
+      && left.every((value, index) => jsonEqual(value, right[index]));
+  }
+  const leftKeys = Object.keys(left);
+  const rightKeys = Object.keys(right);
+  return leftKeys.length === rightKeys.length
+    && leftKeys.every((key) => Object.hasOwn(right, key) && jsonEqual(left[key], right[key]));
+}
+
+function assertJsonValue(value: unknown, name: string, seen = new WeakSet<object>()): asserts value is JsonValue {
+  if (value === null || typeof value === 'boolean' || typeof value === 'string') {
+    return;
+  }
+  if (typeof value === 'number') {
+    if (Number.isFinite(value)) {
+      return;
+    }
+    throw new TypeError(`${name} must contain only JSON values.`);
+  }
+  if (typeof value !== 'object' || seen.has(value)) {
+    throw new TypeError(`${name} must contain only JSON values.`);
+  }
+  if (!Array.isArray(value) && Object.getPrototypeOf(value) !== Object.prototype
+    && Object.getPrototypeOf(value) !== null) {
+    throw new TypeError(`${name} must contain only JSON values.`);
+  }
+  seen.add(value);
+  if (Array.isArray(value)) {
+    for (let index = 0; index < value.length; index += 1) {
+      if (!Object.hasOwn(value, index)) {
+        throw new TypeError(`${name} must contain only JSON values.`);
+      }
+      assertJsonValue(value[index], name, seen);
+    }
+  } else {
+    for (const [key, descriptor] of Object.entries(Object.getOwnPropertyDescriptors(value))) {
+      if (!descriptor.enumerable) {
+        continue;
+      }
+      if (!('value' in descriptor)) {
+        throw new TypeError(`${name} must contain only JSON values.`);
+      }
+      assertJsonValue(descriptor.value, `${name}.${key}`, seen);
+    }
+  }
+  seen.delete(value);
+}
+
 function decodeToken(token: string): string {
   if (/~(?:[^01]|$)/u.test(token)) {
     throw new TypeError(`The JSON Pointer contains an invalid escape sequence in "${token}".`);
