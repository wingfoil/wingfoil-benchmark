+test('applies all RFC 6902 operations without mutating the input document', () => {
+  const document = {
+    foo: ['bar', 'baz'],
+    object: { copied: false },
+  };
+
+  const result = applyPatch(document, [
+    { op: 'add', path: '/foo/1', value: 'qux' },
+    { op: 'replace', path: '/foo/0', value: 'boo' },
+    { op: 'move', from: '/foo/2', path: '/foo/0' },
+    { op: 'copy', from: '/object', path: '/copied' },
+    { op: 'remove', path: '/object/copied' },
+    { op: 'test', path: '/copied', value: { copied: false } },
+  ]);
+
+  assert.deepEqual(result, {
+    foo: ['baz', 'boo', 'qux'],
+    object: {},
+    copied: { copied: false },
+  });
+  assert.deepEqual(document, {
+    foo: ['bar', 'baz'],
+    object: { copied: false },
+  });
+  assert.notEqual(result.copied, document.object);
+});
