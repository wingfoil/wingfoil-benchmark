+/**
+ * Creates an RFC 6902 JSON Patch that changes `from` into `to`.
+ *
+ * The generated patch contains only the operations needed for the changed values. Object members
+ * are compared independently and array edits are expressed as adds, removes, or changes at their
+ * individual indexes. Neither input is mutated.
+ *
+ * @throws {TypeError} If either input contains a non-JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatchOperation[] {
+  assertJsonValue(from, 'from');
+  assertJsonValue(to, 'to');
+  return createPatchAtPath(from, to, '');
+}
