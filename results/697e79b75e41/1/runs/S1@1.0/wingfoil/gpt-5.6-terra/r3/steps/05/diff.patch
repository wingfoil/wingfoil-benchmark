+test('creates a compact JSON Patch for nested object changes', () => {
+  const from = {
+    unchanged: { nested: true },
+    services: { catalog: { enabled: true, replicas: 2 }, obsolete: true },
+  };
+  const to = {
+    unchanged: { nested: true },
+    services: { catalog: { enabled: true, replicas: 3 }, search: { enabled: true } },
+  };
+
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [
+    { op: 'remove', path: '/services/obsolete' },
+    { op: 'replace', path: '/services/catalog/replicas', value: 3 },
+    { op: 'add', path: '/services/search', value: { enabled: true } },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    unchanged: { nested: true },
+    services: { catalog: { enabled: true, replicas: 2 }, obsolete: true },
+  });
+});
+
+test('creates index-level array edits and escapes JSON Pointer tokens', () => {
+  const from = { 'a/b': ['catalog', 'billing', 'search'] };
+  const to = { 'a/b': ['catalog', 'accounts', 'billing', 'search'] };
+
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [{ op: 'add', path: '/a~1b/1', value: 'accounts' }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
