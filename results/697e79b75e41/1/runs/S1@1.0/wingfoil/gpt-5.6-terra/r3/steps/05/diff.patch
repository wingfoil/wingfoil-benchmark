+function createPatchAtPath(from: JsonValue, to: JsonValue, path: string): JsonPatchOperation[] {
+  if (jsonEqual(from, to)) {
+    return [];
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    const patch: JsonPatchOperation[] = [];
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) {
+        patch.push({ op: 'remove', path: appendPointer(path, key) });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      const memberPath = appendPointer(path, key);
+      if (Object.hasOwn(from, key)) {
+        patch.push(...createPatchAtPath(from[key], to[key], memberPath));
+      } else {
+        patch.push({ op: 'add', path: memberPath, value: cloneJsonValue(to[key]) });
+      }
+    }
+    return patch;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    return createArrayPatch(from, to, path);
+  }
+
+  return [{ op: 'replace', path, value: cloneJsonValue(to) }];
+}
+
+function createArrayPatch(from: readonly JsonValue[], to: readonly JsonValue[], path: string): JsonPatchOperation[] {
+  const costs = Array.from({ length: from.length + 1 }, () => Array<number>(to.length + 1).fill(0));
+  const patches: JsonPatchOperation[][][] = Array.from(
+    { length: from.length },
+    () => Array<JsonPatchOperation[]>(to.length),
+  );
+
+  for (let fromIndex = from.length; fromIndex >= 0; fromIndex -= 1) {
+    for (let toIndex = to.length; toIndex >= 0; toIndex -= 1) {
+      if (fromIndex === from.length) {
+        costs[fromIndex][toIndex] = to.length - toIndex;
+        continue;
+      }
+      if (toIndex === to.length) {
+        costs[fromIndex][toIndex] = from.length - fromIndex;
+        continue;
+      }
+
+      const itemPatch = createPatchAtPath(from[fromIndex], to[toIndex], appendPointer(path, String(fromIndex)));
+      patches[fromIndex][toIndex] = itemPatch;
+      costs[fromIndex][toIndex] = Math.min(
+        itemPatch.length + costs[fromIndex + 1][toIndex + 1],
+        1 + costs[fromIndex + 1][toIndex],
+        1 + costs[fromIndex][toIndex + 1],
+      );
+    }
+  }
+
+  const patch: JsonPatchOperation[] = [];
+  let fromIndex = 0;
+  let toIndex = 0;
+  let currentIndex = 0;
+  while (fromIndex < from.length || toIndex < to.length) {
+    if (fromIndex === from.length) {
+      patch.push({ op: 'add', path: appendPointer(path, String(currentIndex)), value: cloneJsonValue(to[toIndex]) });
+      toIndex += 1;
+      currentIndex += 1;
+      continue;
+    }
+    if (toIndex === to.length) {
+      patch.push({ op: 'remove', path: appendPointer(path, String(currentIndex)) });
+      fromIndex += 1;
+      continue;
+    }
+
+    const itemPatch = patches[fromIndex][toIndex];
+    if (costs[fromIndex][toIndex] === itemPatch.length + costs[fromIndex + 1][toIndex + 1]) {
+      patch.push(...rebaseArrayPatch(itemPatch, path, fromIndex, currentIndex));
+      fromIndex += 1;
+      toIndex += 1;
+      currentIndex += 1;
+    } else if (costs[fromIndex][toIndex] === 1 + costs[fromIndex + 1][toIndex]) {
+      patch.push({ op: 'remove', path: appendPointer(path, String(currentIndex)) });
+      fromIndex += 1;
+    } else {
+      patch.push({ op: 'add', path: appendPointer(path, String(currentIndex)), value: cloneJsonValue(to[toIndex]) });
+      toIndex += 1;
+      currentIndex += 1;
+    }
+  }
+  return patch;
+}
+
+function rebaseArrayPatch(
+  patch: readonly JsonPatchOperation[],
+  arrayPath: string,
+  fromIndex: number,
+  currentIndex: number,
+): JsonPatchOperation[] {
+  if (fromIndex === currentIndex) {
+    return patch;
+  }
+  const sourcePrefix = appendPointer(arrayPath, String(fromIndex));
+  const targetPrefix = appendPointer(arrayPath, String(currentIndex));
+  return patch.map((operation) => ({
+    ...operation,
+    path: operation.path === sourcePrefix
+      ? targetPrefix
+      : `${targetPrefix}${operation.path.slice(sourcePrefix.length)}`,
+  } as JsonPatchOperation));
+}
+
+function appendPointer(path: string, token: string): string {
+  return `${path}/${token.replace(/~/gu, '~0').replace(/\//gu, '~1')}`;
+}
