+import { applyMergePatch, applyPatch, createPatch } from "../src/index.ts";
+
+test("creates a localized patch for nested object changes", () => {
+  const from = { profile: { name: "Ada", enabled: true }, unchanged: [1, 2] };
+  const to = { profile: { name: "Grace", timezone: "UTC" }, unchanged: [1, 2] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/profile/enabled" },
+    { op: "replace", path: "/profile/name", value: "Grace" },
+    { op: "add", path: "/profile/timezone", value: "UTC" },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, { profile: { name: "Ada", enabled: true }, unchanged: [1, 2] });
+  assert.deepEqual(to, { profile: { name: "Grace", timezone: "UTC" }, unchanged: [1, 2] });
+});
+
+test("creates index-level array changes instead of replacing the array", () => {
+  const from = { values: ["one", "three"] };
+  const to = { values: ["one", "two", "three"] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: "add", path: "/values/1", value: "two" }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("creates valid localized patches for array removal and nested values", () => {
+  const from = { records: [{ id: 1, title: "draft" }, { id: 2, title: "keep" }] };
+  const to = { records: [{ id: 1, title: "final" }] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "replace", path: "/records/0/title", value: "final" },
+    { op: "remove", path: "/records/1" },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("creates root replacements, escapes pointer tokens, and validates JSON inputs", () => {
+  assert.deepEqual(createPatch({ ignored: true }, [1, 2]), [{ op: "replace", path: "", value: [1, 2] }]);
