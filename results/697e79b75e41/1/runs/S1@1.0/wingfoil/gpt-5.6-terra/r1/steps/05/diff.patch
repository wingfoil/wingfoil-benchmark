+/**
+ * Creates an RFC 6902 JSON Patch that transforms one JSON value into another.
+ *
+ * The inputs are validated and cloned before comparison, so neither input nor any value reachable
+ * from it is changed. Object members and array entries are diffed at their JSON Pointer locations
+ * whenever possible; a replacement is used only when the values cannot be meaningfully traversed.
+ *
+ * @param from The starting JSON document.
+ * @param to The desired JSON document.
+ * @returns A JSON Patch which turns `from` into `to`.
+ * @throws {Error} If either input is not a valid JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const source = cloneJson(from, "source document");
+  const target = cloneJson(to, "target document");
+  const patch: PatchOperation[] = [];
+
+  appendPatch(source, target, [], patch);
+  return patch;
+}
