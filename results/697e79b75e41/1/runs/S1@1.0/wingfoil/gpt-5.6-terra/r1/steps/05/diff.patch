+function appendPatch(source: JsonValue, target: JsonValue, path: string[], patch: PatchOperation[]): void {
+  if (jsonEquals(source, target)) {
+    return;
+  }
+
+  if (Array.isArray(source) && Array.isArray(target)) {
+    appendArrayPatch(source, target, path, patch);
+    return;
+  }
+
+  if (isObject(source) && isObject(target)) {
+    const sourceKeys = Object.keys(source).sort();
+    const targetKeys = Object.keys(target).sort();
+
+    for (const key of sourceKeys) {
+      if (!Object.hasOwn(target, key)) {
+        patch.push({ op: "remove", path: pointerFor([...path, key]) });
+      }
+    }
+    for (const key of sourceKeys) {
+      if (Object.hasOwn(target, key)) {
+        appendPatch(source[key] as JsonValue, target[key] as JsonValue, [...path, key], patch);
+      }
+    }
+    for (const key of targetKeys) {
+      if (!Object.hasOwn(source, key)) {
+        patch.push({ op: "add", path: pointerFor([...path, key]), value: target[key] });
+      }
+    }
+    return;
+  }
+
+  patch.push({ op: "replace", path: pointerFor(path), value: target });
+}
+
+function appendArrayPatch(source: JsonValue[], target: JsonValue[], path: string[], patch: PatchOperation[]): void {
+  const costs = arrayEditCosts(source, target);
+  let sourceIndex = 0;
+  let targetIndex = 0;
+  let patchIndex = 0;
+
+  while (sourceIndex < source.length || targetIndex < target.length) {
+    if (sourceIndex < source.length && targetIndex < target.length && jsonEquals(source[sourceIndex] as JsonValue, target[targetIndex] as JsonValue)) {
+      sourceIndex += 1;
+      targetIndex += 1;
+      patchIndex += 1;
+      continue;
+    }
+
+    const replacementCost = sourceIndex < source.length && targetIndex < target.length
+      ? 1 + (costs[sourceIndex + 1] as number[])[targetIndex + 1]
+      : Number.POSITIVE_INFINITY;
+    const removalCost = sourceIndex < source.length
+      ? 1 + (costs[sourceIndex + 1] as number[])[targetIndex]
+      : Number.POSITIVE_INFINITY;
+    const additionCost = targetIndex < target.length
+      ? 1 + (costs[sourceIndex] as number[])[targetIndex + 1]
+      : Number.POSITIVE_INFINITY;
+    const cost = (costs[sourceIndex] as number[])[targetIndex];
+
+    if (replacementCost === cost) {
+      appendPatch(
+        source[sourceIndex] as JsonValue,
+        target[targetIndex] as JsonValue,
+        [...path, String(patchIndex)],
+        patch,
+      );
+      sourceIndex += 1;
+      targetIndex += 1;
+      patchIndex += 1;
+    } else if (removalCost === cost) {
+      patch.push({ op: "remove", path: pointerFor([...path, String(patchIndex)]) });
+      sourceIndex += 1;
+    } else if (additionCost === cost) {
+      patch.push({ op: "add", path: pointerFor([...path, String(patchIndex)]), value: target[targetIndex] });
+      targetIndex += 1;
+      patchIndex += 1;
+    } else {
+      throw new Error("Unable to create a JSON Patch for the array values.");
+    }
+  }
+}
+
+function arrayEditCosts(source: JsonValue[], target: JsonValue[]): number[][] {
+  const costs = Array.from({ length: source.length + 1 }, () => Array<number>(target.length + 1).fill(0));
+
+  for (let sourceIndex = source.length; sourceIndex >= 0; sourceIndex -= 1) {
+    for (let targetIndex = target.length; targetIndex >= 0; targetIndex -= 1) {
+      if (sourceIndex === source.length && targetIndex === target.length) {
+        continue;
+      }
+      if (sourceIndex === source.length) {
+        (costs[sourceIndex] as number[])[targetIndex] = target.length - targetIndex;
+      } else if (targetIndex === target.length) {
+        (costs[sourceIndex] as number[])[targetIndex] = source.length - sourceIndex;
+      } else if (jsonEquals(source[sourceIndex] as JsonValue, target[targetIndex] as JsonValue)) {
+        (costs[sourceIndex] as number[])[targetIndex] = (costs[sourceIndex + 1] as number[])[targetIndex + 1];
+      } else {
+        (costs[sourceIndex] as number[])[targetIndex] = 1 + Math.min(
+          (costs[sourceIndex + 1] as number[])[targetIndex + 1],
+          (costs[sourceIndex + 1] as number[])[targetIndex],
+          (costs[sourceIndex] as number[])[targetIndex + 1],
+        );
+      }
+    }
+  }
+  return costs;
+}
+
+function pointerFor(path: string[]): string {
+  return path.map((token) => `/${token.replace(/~/g, "~0").replace(/\//g, "~1")}`).join("");
+}
