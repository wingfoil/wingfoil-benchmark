index 0000000000000000000000000000000000000000..0e252cba79f82954b4bb232072c9ac52f3313c08
--- /dev/null
+++ b/test/apply-patch.test.ts
@@ -0,0 +1,55 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyPatch } from "../src/index.ts";
+
+test("applies add, remove, and replace without mutating the input", () => {
+  const document = { title: "draft", tags: ["one", "three"] };
+
+  const result = applyPatch(document, [
+    { op: "add", path: "/tags/1", value: "two" },
+    { op: "add", path: "/published", value: false },
+    { op: "replace", path: "/title", value: "final" },
+    { op: "remove", path: "/tags/0" },
+  ]);
+
+  assert.deepEqual(result, { title: "final", tags: ["two", "three"], published: false });
+  assert.deepEqual(document, { title: "draft", tags: ["one", "three"] });
+});
+
+test("adds a document root and appends with an array dash token", () => {
+  assert.deepEqual(applyPatch({ ignored: true }, [{ op: "add", path: "", value: [1, 2] }]), [1, 2]);
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/-", value: 2 }]), [1, 2]);
+});
+
+test("moves and copies values using JSON Pointers", () => {
+  const result = applyPatch(
+    { from: { nested: ["value"] }, target: [] },
+    [
+      { op: "copy", from: "/from/nested/0", path: "/target/0" },
+      { op: "move", from: "/from/nested", path: "/moved" },
+    ],
+  );
+
+  assert.deepEqual(result, { from: {}, target: ["value"], moved: ["value"] });
+});
+
+test("test compares JSON values structurally", () => {
+  const document = { nested: { answer: 42 }, values: [true, null] };
+
+  assert.deepEqual(
+    applyPatch(document, [{ op: "test", path: "/nested", value: { answer: 42 } }]),
+    document,
+  );
+  assert.throws(() => applyPatch(document, [{ op: "test", path: "/values", value: [true] }]));
+});
+
+test("rejects malformed patches and invalid operation targets", () => {
+  assert.throws(() => applyPatch({}, {}));
+  assert.throws(() => applyPatch({}, [{ op: "unknown", path: "" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "missing-slash", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/missing" }]));
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/1", value: 2 }]));
+  assert.throws(() => applyPatch({ child: {} }, [{ op: "move", from: "/child", path: "/child/value" }]));
+  assert.throws(() => applyPatch({}, [{ op: "copy", path: "/copy" }]));
+});
