@@ -29,6 +29,251 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   return current;
 }
 
+type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
+
+type PatchOperation = Record<string, unknown>;
+
+/**
+ * Applies an RFC 6902 JSON Patch to a JSON document.
+ *
+ * The input document is cloned before any operation is applied, so neither it nor any of its nested
+ * values are changed. Invalid patches and operations that cannot be applied throw an error.
+ *
+ * @param document The JSON value to patch.
+ * @param patch An array of RFC 6902 operations.
+ * @returns The patched JSON value.
+ * @throws {Error} If the document or patch is invalid, or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  let result = cloneJson(document, "document");
+
+  if (!Array.isArray(patch)) {
+    throw new Error("A JSON Patch must be an array of operations.");
+  }
+
+  for (const operation of patch) {
+    result = applyOperation(result, operation);
+  }
+
+  return result;
+}
+
+function applyOperation(document: JsonValue, operation: unknown): JsonValue {
+  if (typeof operation !== "object" || operation === null || Array.isArray(operation)) {
+    throw new Error("A JSON Patch operation must be an object.");
+  }
+
+  const patch = operation as PatchOperation;
+  const op = requiredString(patch, "op");
+  const path = parsePointer(requiredString(patch, "path"));
+
+  switch (op) {
+    case "add":
+      return addValue(document, path, cloneJson(requiredValue(patch, "value"), "operation value"));
+    case "remove":
+      return removeValue(document, path).document;
+    case "replace":
+      ensureExists(document, path);
+      return replaceValue(document, path, cloneJson(requiredValue(patch, "value"), "operation value"));
+    case "move": {
+      const from = parsePointer(requiredString(patch, "from"));
+      if (isProperDescendant(path, from)) {
+        throw new Error("A JSON Patch move destination cannot be a child of its source.");
+      }
+      const removed = removeValue(document, from);
+      return addValue(removed.document, path, removed.value);
+    }
+    case "copy": {
+      const from = parsePointer(requiredString(patch, "from"));
+      return addValue(document, path, cloneJson(getValue(document, from), "copied value"));
+    }
+    case "test": {
+      const expected = cloneJson(requiredValue(patch, "value"), "operation value");
+      if (!jsonEquals(getValue(document, path), expected)) {
+        throw new Error("A JSON Patch test operation failed.");
+      }
+      return document;
+    }
+    default:
+      throw new Error(`Unsupported JSON Patch operation '${op}'.`);
+  }
+}
+
+function requiredString(operation: PatchOperation, property: string): string {
+  if (!Object.hasOwn(operation, property) || typeof operation[property] !== "string") {
+    throw new Error(`A JSON Patch operation requires a string '${property}' member.`);
+  }
+  return operation[property] as string;
+}
+
+function requiredValue(operation: PatchOperation, property: string): unknown {
+  if (!Object.hasOwn(operation, property)) {
+    throw new Error(`A JSON Patch operation requires a '${property}' member.`);
+  }
+  return operation[property];
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error("A non-empty JSON Pointer must begin with '/'.");
+  }
+  return pointer.slice(1).split("/").map(decodeReferenceToken);
+}
+
+function getValue(document: JsonValue, path: string[]): JsonValue {
+  let current = document;
+  for (const token of path) {
+    current = getToken(current, token);
+  }
+  return current;
+}
+
+function getToken(value: JsonValue, token: string): JsonValue {
+  if (Array.isArray(value)) {
+    const index = existingArrayIndex(value, token);
+    return value[index] as JsonValue;
+  }
+  if (isObject(value) && Object.hasOwn(value, token)) {
+    return value[token] as JsonValue;
+  }
+  throw new Error(`JSON Pointer does not resolve token '${token}'.`);
+}
+
+function addValue(document: JsonValue, path: string[], value: JsonValue): JsonValue {
+  if (path.length === 0) {
+    return value;
+  }
+  const { parent, token } = parentAt(document, path);
+  if (Array.isArray(parent)) {
+    const index = insertionArrayIndex(parent, token);
+    parent.splice(index, 0, value);
+  } else {
+    defineJsonProperty(parent, token, value);
+  }
+  return document;
+}
+
+function removeValue(document: JsonValue, path: string[]): { document: JsonValue; value: JsonValue } {
+  if (path.length === 0) {
+    throw new Error("A JSON Patch remove operation cannot remove the document root.");
+  }
+  const { parent, token } = parentAt(document, path);
+  if (Array.isArray(parent)) {
+    const index = existingArrayIndex(parent, token);
+    return { document, value: parent.splice(index, 1)[0] as JsonValue };
+  }
+  if (!Object.hasOwn(parent, token)) {
+    throw new Error(`JSON Pointer does not resolve token '${token}'.`);
+  }
+  const value = parent[token] as JsonValue;
+  delete parent[token];
+  return { document, value };
+}
+
+function replaceValue(document: JsonValue, path: string[], value: JsonValue): JsonValue {
+  if (path.length === 0) {
+    return value;
+  }
+  const { parent, token } = parentAt(document, path);
+  if (Array.isArray(parent)) {
+    parent[existingArrayIndex(parent, token)] = value;
+  } else {
+    defineJsonProperty(parent, token, value);
+  }
+  return document;
+}
+
+function ensureExists(document: JsonValue, path: string[]): void {
+  getValue(document, path);
+}
+
+function parentAt(document: JsonValue, path: string[]): { parent: JsonValue[] | { [key: string]: JsonValue }; token: string } {
+  const token = path[path.length - 1] as string;
+  const parent = getValue(document, path.slice(0, -1));
+  if (!Array.isArray(parent) && !isObject(parent)) {
+    throw new Error("A JSON Patch target parent must be an object or array.");
+  }
+  return { parent, token };
+}
+
+function existingArrayIndex(array: JsonValue[], token: string): number {
+  if (!/^(?:0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`'${token}' is not a valid JSON Pointer array index.`);
+  }
+  const index = Number(token);
+  if (!Number.isSafeInteger(index) || index >= array.length) {
+    throw new Error(`JSON Pointer does not resolve array index '${token}'.`);
+  }
+  return index;
+}
+
+function insertionArrayIndex(array: JsonValue[], token: string): number {
+  if (token === "-") {
+    return array.length;
+  }
+  if (!/^(?:0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`'${token}' is not a valid JSON Patch array index.`);
+  }
+  const index = Number(token);
+  if (!Number.isSafeInteger(index) || index > array.length) {
+    throw new Error(`JSON Patch cannot add at array index '${token}'.`);
+  }
+  return index;
+}
+
+function isProperDescendant(path: string[], ancestor: string[]): boolean {
+  return path.length > ancestor.length && ancestor.every((token, index) => path[index] === token);
+}
+
+function cloneJson(value: unknown, description: string): JsonValue {
+  if (value === null || typeof value === "string" || typeof value === "boolean") {
+    return value;
+  }
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) {
+      throw new Error(`${description} must be a valid JSON value.`);
+    }
+    return value;
+  }
+  if (Array.isArray(value)) {
+    return value.map((item) => cloneJson(item, description));
+  }
+  if (isObject(value)) {
+    const clone: { [key: string]: JsonValue } = {};
+    for (const key of Object.keys(value)) {
+      defineJsonProperty(clone, key, cloneJson(value[key], description));
+    }
+    return clone;
+  }
+  throw new Error(`${description} must be a valid JSON value.`);
+}
+
+function isObject(value: JsonValue | unknown): value is { [key: string]: JsonValue } {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function defineJsonProperty(object: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { configurable: true, enumerable: true, value, writable: true });
+}
+
+function jsonEquals(left: JsonValue, right: JsonValue): boolean {
+  if (left === right) {
+    return true;
+  }
+  if (Array.isArray(left) && Array.isArray(right)) {
+    return left.length === right.length && left.every((value, index) => jsonEquals(value, right[index] as JsonValue));
+  }
+  if (isObject(left) && isObject(right)) {
+    const leftKeys = Object.keys(left);
+    const rightKeys = Object.keys(right);
+    return leftKeys.length === rightKeys.length && leftKeys.every((key) => Object.hasOwn(right, key) && jsonEquals(left[key], right[key] as JsonValue));
+  }
+  return false;
+}
+
 function decodeReferenceToken(token: string): string {
   if (/~(?:[^01]|$)/.test(token)) {
     throw new Error(`Invalid JSON Pointer escape sequence in token '${token}'.`);
