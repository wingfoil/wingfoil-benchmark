index 0000000000000000000000000000000000000000..8c143f1d7fb465fd7a5d313767cd1d8bd7cfdf0c
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,59 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @param document The JSON value to search.
+ * @param pointer An RFC 6901 JSON Pointer.
+ * @returns The value designated by `pointer`.
+ * @throws {Error} If the pointer is malformed or cannot be resolved.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("A JSON Pointer must be a string.");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error("A non-empty JSON Pointer must begin with '/'.");
+  }
+
+  let current = document;
+
+  for (const rawToken of pointer.slice(1).split("/")) {
+    const token = decodeReferenceToken(rawToken);
+    current = resolveToken(current, token);
+  }
+
+  return current;
+}
+
+function decodeReferenceToken(token: string): string {
+  if (/~(?:[^01]|$)/.test(token)) {
+    throw new Error(`Invalid JSON Pointer escape sequence in token '${token}'.`);
+  }
+
+  return token.replace(/~[01]/g, (escape) => (escape === "~0" ? "~" : "/"));
+}
+
+function resolveToken(value: unknown, token: string): unknown {
+  if (Array.isArray(value)) {
+    if (!/^(?:0|[1-9][0-9]*)$/.test(token)) {
+      throw new Error(`'${token}' is not a valid JSON Pointer array index.`);
+    }
+
+    const index = Number(token);
+    if (!Number.isSafeInteger(index) || index >= value.length || !Object.hasOwn(value, index)) {
+      throw new Error(`JSON Pointer does not resolve array index '${token}'.`);
+    }
+
+    return value[index];
+  }
+
+  if (typeof value === "object" && value !== null && Object.hasOwn(value, token)) {
+    return (value as Record<string, unknown>)[token];
+  }
+
+  throw new Error(`JSON Pointer does not resolve token '${token}'.`);
+}
diff --git a/test/resolve-pointer.test.ts b/test/resolve-pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..76bb4995db1b8bc127812a976fd9456b3f28440e
--- /dev/null
+++ b/test/resolve-pointer.test.ts
@@ -0,0 +1,41 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { resolvePointer } from "../src/index.ts";
+
+const document = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("resolves the whole document with the empty pointer", () => {
+  assert.equal(resolvePointer(document, ""), document);
+});
+
+test("resolves object members and array entries", () => {
+  assert.equal(resolvePointer(document, "/foo/0"), "bar");
+  assert.equal(resolvePointer(document, "/foo/1"), "baz");
+});
+
+test("unescapes reference tokens according to RFC 6901", () => {
+  assert.equal(resolvePointer(document, "/a~1b"), 1);
+  assert.equal(resolvePointer(document, "/m~0n"), 8);
+  assert.equal(resolvePointer({ "~/": "value" }, "/~0~1"), "value");
+});
+
+test("rejects malformed pointers and pointers that do not resolve", () => {
+  assert.throws(() => resolvePointer(document, "foo"));
+  assert.throws(() => resolvePointer(document, "/m~2n"));
+  assert.throws(() => resolvePointer(document, "/foo/01"));
+  assert.throws(() => resolvePointer(document, "/foo/-"));
+  assert.throws(() => resolvePointer(document, "/missing"));
+  assert.throws(() => resolvePointer(null, "/anything"));
+});
