+/** Apply an RFC 7386 JSON Merge Patch without changing the supplied values. */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJsonValue(target, "JSON Merge Patch target");
+  assertJsonValue(patch, "JSON Merge Patch");
+  return mergePatchValue(target, patch);
+}
+
+function mergePatchValue(target: any, patch: any): any {
+  // Arrays, null, and primitive values in a patch replace the target as a whole.
+  if (patch === null || typeof patch !== "object" || Array.isArray(patch)) {
+    return cloneJson(patch);
+  }
+
+  // An object patch applied to a non-object starts from an empty object.
+  const result: Record<string, unknown> =
+    target !== null && typeof target === "object" && !Array.isArray(target)
+      ? cloneJson(target)
+      : {};
+
+  for (const key of Object.keys(patch)) {
+    if (patch[key] === null) {
+      delete result[key];
+    } else {
+      Object.defineProperty(result, key, {
+        value: mergePatchValue(result[key], patch[key]),
+        enumerable: true,
+        writable: true,
+        configurable: true,
+      });
+    }
+  }
+
+  return result;
+}
