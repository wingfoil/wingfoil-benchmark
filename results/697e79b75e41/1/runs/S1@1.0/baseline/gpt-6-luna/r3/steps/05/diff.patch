+function isSubsequence(shorter: unknown[], longer: unknown[]): boolean {
+  let index = 0;
+  for (const value of longer) {
+    if (index < shorter.length && jsonEqual(shorter[index], value)) index++;
+  }
+  return index === shorter.length;
+}
