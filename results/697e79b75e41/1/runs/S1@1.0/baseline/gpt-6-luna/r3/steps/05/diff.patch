+/** Create an RFC 6902 JSON Patch that transforms `from` into `to`. */
+export function createPatch(from: unknown, to: unknown): Array<Record<string, unknown>> {
+  assertJsonValue(from, "JSON Patch source");
+  assertJsonValue(to, "JSON Patch destination");
