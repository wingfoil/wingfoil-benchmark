+/** Applies an RFC 7386 JSON Merge Patch without changing either input. */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJson(target);
+  assertJson(patch);
+  return mergePatch(target, patch);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  // In RFC 7386, only objects are interpreted as sets of member updates.
+  // Arrays, primitives, and null replace the target value outright.
+  if (patch === null || typeof patch !== "object" || Array.isArray(patch)) {
+    return cloneJson(patch);
+  }
+
+  const result: Record<string, unknown> =
+    target !== null && typeof target === "object" && !Array.isArray(target)
+      ? cloneJson(target) as Record<string, unknown>
+      : {};
+
+  for (const key of Object.keys(patch)) {
+    const value = (patch as Record<string, unknown>)[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      // Define explicitly so keys such as "__proto__" remain ordinary JSON
+      // members instead of changing the result object's prototype.
+      Object.defineProperty(result, key, {
+        value: mergePatch(result[key], value),
+        enumerable: true,
+        writable: true,
+        configurable: true,
+      });
+    }
+  }
+  return result;
+}
