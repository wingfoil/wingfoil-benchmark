+/** Resolve a JSON Pointer (RFC 6901) against a JSON document. */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("JSON Pointer must be a string");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error("A non-empty JSON Pointer must start with '/'");
+  }
+
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+  let value: unknown = document;
+
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      // Array indices are 0 or a non-zero digit followed by digits. The '-'
+      // token is reserved for applications that add to arrays and does not
+      // identify an existing value.
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`Invalid array index: ${token}`);
+      }
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= value.length) {
+        throw new Error(`Array index is out of range: ${token}`);
+      }
+      value = value[index];
+    } else if (value !== null && typeof value === "object") {
+      if (!Object.hasOwn(value, token)) {
+        throw new Error(`JSON Pointer member not found: ${token}`);
+      }
+      value = (value as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer cannot resolve through: ${token}`);
+    }
+  }
+
+  return value;
+}
+
+function decodeToken(token: string): string {
+  // Reject every tilde escape other than ~0 and ~1 before decoding. Applying
+  // the replacements in this order also keeps ~01 mapped to ~1, as required.
+  if (/~(?:[^01]|$)/.test(token)) {
+    throw new Error(`Invalid JSON Pointer escape in token: ${token}`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
