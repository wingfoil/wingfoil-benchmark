@@ -0,0 +1,65 @@
+/**
+ * Resolve a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * An empty pointer identifies the document itself.  Every other pointer must
+ * start with `/`; its reference tokens are unescaped before they are used as
+ * object member names or array indices.
+ *
+ * @throws {Error} If `pointer` is malformed or does not identify a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("A JSON Pointer must be a string");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error("A JSON Pointer must be empty or start with '/'");
+  }
+
+  let value: unknown = document;
+
+  for (const encodedToken of pointer.slice(1).split("/")) {
+    const token = unescapeReferenceToken(encodedToken);
+
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(token) || Number(token) >= value.length) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+
+      value = value[Number(token)];
+      continue;
+    }
+
+    if (
+      value === null ||
+      typeof value !== "object" ||
+      !Object.prototype.hasOwnProperty.call(value, token)
+    ) {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+
+    value = (value as Record<string, unknown>)[token];
+  }
+
+  return value;
+}
+
+function unescapeReferenceToken(token: string): string {
+  // RFC 6901 permits only ~0 and ~1 escape sequences.  Decode in one pass so
+  // that, for example, `~01` correctly becomes `~1` rather than `/`.
+  return token.replace(/~(?:.|$)/g, (escape) => {
+    if (escape === "~0") return "~";
+    if (escape === "~1") return "/";
+    throw new Error(`Invalid JSON Pointer escape sequence: ${escape}`);
+  });
+}
+
+function isArrayIndex(token: string): boolean {
+  // The RFC array-index grammar disallows leading zeroes (except for "0") and
+  // the append marker "-" does not identify an existing array value.
+  return /^(?:0|[1-9][0-9]*)$/.test(token);
+}
