+/**
+ * Apply an RFC 7386 JSON Merge Patch without changing either supplied value.
+ *
+ * Object members whose patch value is `null` are removed.  Arrays and all
+ * other JSON values are replaced as a whole.  A `null` patch therefore
+ * replaces the complete target with `null`; it does not delete the document.
+ *
+ * @throws {Error} If `target` or `patch` is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJsonValue(target, "The target of a JSON Merge Patch");
+  assertJsonValue(patch, "A JSON Merge Patch");
+
+  return mergePatch(cloneJsonValue(target), patch);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  // Per RFC 7386, only an object patch is merged recursively.  In particular,
+  // an array replaces the target rather than being merged element-by-element.
+  if (!isObject(patch)) return cloneJsonValue(patch);
+
+  const result: Record<string, unknown> = isObject(target)
+    ? target
+    : {};
+
+  for (const name of Object.keys(patch)) {
+    const value = patch[name];
+    if (value === null) {
+      delete result[name];
+    } else {
+      setMember(result, name, mergePatch(result[name], value));
+    }
+  }
+
+  return result;
+}
+
 type Operation = {
   op: "add" | "remove" | "replace" | "move" | "copy" | "test";
   path: string;
