-import { applyMergePatch, applyPatch } from "../dist/index.js";
+import { applyMergePatch, applyPatch, createPatch } from "../dist/index.js";
+
+test("creates a granular JSON Patch without changing either input", () => {
+  const from = {
+    title: "draft",
+    items: [{ id: 1, enabled: false }, { id: 2 }],
+    obsolete: true,
+  };
+  const to = {
+    title: "draft",
+    items: [{ id: 1, enabled: true }, { id: 2 }, { id: 3 }],
+    added: { "a/b~c": "value" },
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/obsolete" },
+    { op: "replace", path: "/items/0/enabled", value: true },
+    { op: "add", path: "/items/2", value: { id: 3 } },
+    { op: "add", path: "/added", value: { "a/b~c": "value" } },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    title: "draft",
+    items: [{ id: 1, enabled: false }, { id: 2 }],
+    obsolete: true,
+  });
+  assert.deepEqual(to, {
+    title: "draft",
+    items: [{ id: 1, enabled: true }, { id: 2 }, { id: 3 }],
+    added: { "a/b~c": "value" },
+  });
+});
+
+test("creates compact array insertion and removal patches", () => {
+  assert.deepEqual(createPatch(["a", "b"], ["a", "new", "b"]), [
+    { op: "add", path: "/1", value: "new" },
+  ]);
+  assert.deepEqual(createPatch(["a", "remove", "b"], ["a", "b"]), [
+    { op: "remove", path: "/1" },
+  ]);
+  assert.deepEqual(createPatch({ "a/b~c": 1 }, { "a/b~c": 2 }), [
+    { op: "replace", path: "/a~1b~0c", value: 2 },
+  ]);
+});
 
