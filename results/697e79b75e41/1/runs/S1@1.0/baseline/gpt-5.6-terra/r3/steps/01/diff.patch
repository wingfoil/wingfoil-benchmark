+/**
+ * Resolve a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * The empty pointer identifies the document itself. Every other pointer must
+ * start with `/`; its slash-separated reference tokens use `~0` for `~` and
+ * `~1` for `/`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new TypeError("A JSON Pointer must be a string");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error("Invalid JSON Pointer: it must be empty or start with '/'");
+  }
+
+  let current: unknown = document;
+
+  for (const encodedToken of pointer.slice(1).split("/")) {
+    const token = decodeReferenceToken(encodedToken);
+
+    if (Array.isArray(current)) {
+      if (!isArrayIndex(token) || !Object.hasOwn(current, Number(token))) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+
+      current = current[Number(token)];
+      continue;
+    }
+
+    if (
+      current === null ||
+      typeof current !== "object" ||
+      !Object.hasOwn(current, token)
+    ) {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+
+    current = (current as Record<string, unknown>)[token];
+  }
+
+  return current;
+}
+
+function decodeReferenceToken(token: string): string {
+  // A bare `~`, or `~` followed by anything other than 0 or 1, is not a
+  // valid RFC 6901 escape sequence.
+  if (/~(?:[^01]|$)/.test(token)) {
+    throw new Error("Invalid JSON Pointer: invalid '~' escape sequence");
+  }
+
+  return token.replace(/~[01]/g, (escape) => (escape === "~0" ? "~" : "/"));
+}
+
+function isArrayIndex(token: string): boolean {
+  // RFC 6901 forbids leading zeroes except for the index zero itself.
+  return /^(?:0|[1-9][0-9]*)$/.test(token) && Number(token) < 2 ** 32 - 1;
+}
