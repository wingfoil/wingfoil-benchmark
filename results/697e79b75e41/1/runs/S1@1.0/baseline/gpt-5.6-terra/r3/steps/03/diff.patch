index 0000000000000000000000000000000000000000..4f54902041d6ec75f38e8d7e194ba556e7acb68f
--- /dev/null
+++ b/test/apply-patch.test.js
@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyPatch } from "../dist/index.js";
+
+test("applies the RFC 6902 operation examples in sequence", () => {
+  const document = { foo: ["all", "grass", "cows", "eat"], old: true };
+  const patch = [
+    { op: "add", path: "/extra", value: { nested: [1] } },
+    { op: "replace", path: "/old", value: false },
+    { op: "move", from: "/foo/1", path: "/foo/3" },
+    { op: "copy", from: "/extra/nested", path: "/copied" },
+    { op: "remove", path: "/extra" },
+    { op: "test", path: "/foo", value: ["all", "cows", "eat", "grass"] },
+  ];
+
+  assert.deepEqual(applyPatch(document, patch), {
+    foo: ["all", "cows", "eat", "grass"],
+    old: false,
+    copied: [1],
+  });
+  assert.deepEqual(document, { foo: ["all", "grass", "cows", "eat"], old: true });
+});
+
+test("rejects failed operations without changing the caller document", () => {
+  const document = { a: { b: 1 } };
+  assert.throws(() => applyPatch(document, [
+    { op: "replace", path: "/a/b", value: 2 },
+    { op: "test", path: "/a/b", value: 3 },
+  ]));
+  assert.deepEqual(document, { a: { b: 1 } });
+});
+
+test("rejects undefined root deletion instead of replacing it with null", () => {
+  assert.throws(
+    () => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]),
+    /cannot remove the document root/,
+  );
+});
+
+test("rejects invalid patch documents, including ignored non-JSON members", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "unknown", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: 1, ignored: Infinity }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: [, 1] }]));
+});
+
+test("enforces pointer and operation failure rules", () => {
+  assert.throws(() => applyPatch({ a: [] }, [{ op: "add", path: "/a/01", value: 1 }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "/missing" }]));
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.deepEqual(
+    applyPatch({ a: 1 }, [{ op: "add", path: "/b", value: 2, ignored: "by RFC" }]),
+    { a: 1, b: 2 },
+  );
+});
