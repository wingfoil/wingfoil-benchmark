 }
 
+/**
+ * JavaScript has values that look serializable but are not JSON values: sparse
+ * arrays, accessors, symbol properties, and cycles.  Rejecting them prevents
+ * patch semantics from depending on JavaScript object behaviour.
+ */
+function assertJsonContainer(value: object, ancestors: WeakSet<object>): void {
+  if (ancestors.has(value)) {
+    throw new TypeError("A JSON value cannot contain a cycle");
+  }
+  ancestors.add(value);
+
+  for (const key of Reflect.ownKeys(value)) {
+    if (Array.isArray(value) && key === "length") {
+      continue;
+    }
+    if (typeof key !== "string") {
+      throw new TypeError("A JSON value cannot contain symbol properties");
+    }
+    const descriptor = Object.getOwnPropertyDescriptor(value, key);
+    if (!descriptor || !descriptor.enumerable || !("value" in descriptor)) {
+      throw new TypeError("A JSON value must contain enumerable data properties");
+    }
+    if (Array.isArray(value) && !isArrayIndex(key)) {
+      throw new TypeError("A JSON array cannot contain non-index properties");
+    }
+  }
+
+  if (Array.isArray(value)) {
+    for (let index = 0; index < value.length; index += 1) {
+      if (!Object.hasOwn(value, index)) {
+        throw new TypeError("A JSON array cannot be sparse");
+      }
+    }
+  }
+}
