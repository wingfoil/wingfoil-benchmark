@@ -58,11 +58,20 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
     throw new TypeError("A JSON Patch must be an array of operations");
   }
 
+  // JSON Patch itself is a JSON document, not merely an array-like JavaScript
+  // value.  Clone it up front so ignored operation members are validated too.
+  // This also ensures callers cannot observe partial evaluation after an error.
+  const operations = cloneJsonValue(patch);
+  if (!Array.isArray(operations)) {
+    // Kept for type narrowing; cloneJsonValue preserves arrays.
+    throw new TypeError("A JSON Patch must be an array of operations");
+  }
+
