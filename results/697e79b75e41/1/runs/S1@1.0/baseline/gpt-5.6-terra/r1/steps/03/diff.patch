diff --git a/test/index.test.mjs b/test/index.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..748be151a04be9fe00dfd17081ad34fd7af02d84
--- /dev/null
+++ b/test/index.test.mjs
@@ -0,0 +1,52 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { applyPatch } from '../src/index.ts';
+
+test('applies operations sequentially and does not mutate the input document', () => {
+  const document = { entries: ['one'] };
+  const patch = [
+    { op: 'add', path: '/entries/-', value: 'two' },
+    { op: 'replace', path: '/entries/0', value: 'zero' },
+  ];
+
+  assert.deepEqual(applyPatch(document, patch), { entries: ['zero', 'two'] });
+  assert.deepEqual(document, { entries: ['one'] });
+});
+
+test('stops at an error without exposing partial changes', () => {
+  const document = { value: 1 };
+
+  assert.throws(() => applyPatch(document, [
+    { op: 'replace', path: '/value', value: 2 },
+    { op: 'test', path: '/value', value: 3 },
+  ]));
+  assert.deepEqual(document, { value: 1 });
+});
+
+test('requires existing locations except for the final add location', () => {
+  assert.deepEqual(
+    applyPatch({ parent: {} }, [{ op: 'add', path: '/parent/child', value: true }]),
+    { parent: { child: true } },
+  );
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: '/parent/child', value: true }]));
+  assert.throws(() => applyPatch({ parent: {} }, [{ op: 'replace', path: '/parent/child', value: true }]));
+});
+
+test('rejects attempts to remove the root because no JSON document remains', () => {
+  assert.throws(() => applyPatch({ value: true }, [{ op: 'remove', path: '' }]));
+});
+
+test('rejects JavaScript-only properties that cannot appear in JSON Patch', () => {
+  const operation = { path: '/value' };
+  Object.defineProperty(operation, 'op', { value: 'remove' });
+
+  assert.throws(() => applyPatch({ value: true }, [operation]));
+});
+
+test('ignores defined-but-unrecognised operation members', () => {
+  assert.deepEqual(
+    applyPatch({}, [{ op: 'add', path: '/value', value: true, note: 'ignored' }]),
+    { value: true },
+  );
+});
