+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @throws {Error} If `pointer` is malformed or does not identify a value in
+ * the document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (pointer === '') {
+    return document;
+  }
+
+  if (!pointer.startsWith('/')) {
+    throw new Error('Invalid JSON Pointer: a non-empty pointer must begin with "/"');
+  }
+
+  let current: unknown = document;
+
+  for (const referenceToken of pointer.slice(1).split('/')) {
+    const token = decodeReferenceToken(referenceToken);
+
+    if (Array.isArray(current)) {
+      if (!isArrayIndex(token) || !Object.hasOwn(current, Number(token))) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+
+      current = current[Number(token)];
+      continue;
+    }
+
+    if (
+      current === null ||
+      typeof current !== 'object' ||
+      !Object.hasOwn(current, token)
+    ) {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+
+    current = (current as Record<string, unknown>)[token];
+  }
+
+  return current;
+}
+
+function decodeReferenceToken(token: string): string {
+  let decoded = '';
+
+  for (let index = 0; index < token.length; index += 1) {
+    const character = token[index];
+
+    if (character !== '~') {
+      decoded += character;
+      continue;
+    }
+
+    const escapedCharacter = token[index + 1];
+    if (escapedCharacter === '0') {
+      decoded += '~';
+    } else if (escapedCharacter === '1') {
+      decoded += '/';
+    } else {
+      throw new Error(`Invalid JSON Pointer escape sequence in token: ${token}`);
+    }
+
+    index += 1;
+  }
+
+  return decoded;
+}
+
+function isArrayIndex(token: string): boolean {
+  // RFC 6901 section 4: "0" is valid, while leading zeroes are not.
+  return /^(?:0|[1-9][0-9]*)$/.test(token) && Number.isSafeInteger(Number(token));
+}
