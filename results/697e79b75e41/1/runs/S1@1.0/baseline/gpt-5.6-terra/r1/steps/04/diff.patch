+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document.
+ *
+ * Object-valued patches are merged recursively; a `null` member removes the
+ * corresponding member from the target. All other patch values replace the
+ * target value. Neither supplied value is mutated.
+ *
+ * @throws {Error} If the target or patch is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJsonValue(target, 'target');
+  assertJsonValue(patch, 'merge patch');
+
+  return mergePatch(target, patch);
+}
+
 type JsonObject = Record<string, unknown>;
 
+function mergePatch(target: unknown, patch: unknown): unknown {
+  // RFC 7386, section 2: an object patch merges into an object target. A
+  // non-object target is first treated as an empty object.
+  if (isJsonObject(patch)) {
+    const result: JsonObject = isJsonObject(target) ? cloneJson(target) as JsonObject : {};
+
+    for (const key of Object.keys(patch)) {
+      const patchValue = patch[key];
+      if (patchValue === null) {
+        delete result[key];
+      } else {
+        const targetValue = Object.hasOwn(result, key) ? result[key] : undefined;
+        setObjectMember(result, key, mergePatch(targetValue, patchValue));
+      }
+    }
+
+    return result;
+  }
+
+  // Arrays and scalar values are replacements, rather than structures to
+  // merge. Clone compound replacements so callers cannot mutate patch data
+  // through the returned document.
+  return cloneJson(patch);
+}
