+test('applies RFC 7386 merge patches without mutating either input', () => {
+  const target = {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  };
+  const patch = {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: 'Hello!',
+    author: { givenName: 'John' },
+    tags: ['example'],
+    content: 'This will be unchanged',
+    phoneNumber: '+01-123-456-7890',
+  });
+  assert.deepEqual(target, {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  });
+  assert.deepEqual(patch, {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  });
+});
+
+test('merge patch replaces non-object values and treats object patches as merging into empty objects', () => {
+  assert.deepEqual(applyMergePatch(['old'], { value: true, removed: null }), { value: true });
+  assert.deepEqual(applyMergePatch({ value: true }, ['replacement']), ['replacement']);
+  assert.equal(applyMergePatch({ value: true }, null), null);
+});
+
+test('merge patch safely handles special JavaScript property names', () => {
