diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..66e8240851effed12091f23f8f7797572ca3615e
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,78 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @param document - The JSON document to traverse.
+ * @param pointer - A JSON Pointer string. The empty string addresses the whole document.
+ * @returns The value addressed by {@link pointer}.
+ * @throws {TypeError} If `pointer` is not a valid JSON Pointer string.
+ * @throws {Error} If the pointer does not identify a value in `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  const referenceTokens = parsePointer(pointer);
+  let value = document;
+
+  for (const token of referenceTokens) {
+    value = resolveToken(value, token, pointer);
+  }
+
+  if (value === undefined) {
+    throw new Error(`JSON Pointer does not resolve to a value: ${pointer}`);
+  }
+
+  return value;
+}
+
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== 'string' || (pointer !== '' && !pointer.startsWith('/'))) {
+    throw new TypeError('JSON Pointer must be empty or begin with a slash');
+  }
+
+  return pointer === '' ? [] : pointer.slice(1).split('/').map(decodeReferenceToken);
+}
+
+function decodeReferenceToken(token: string): string {
+  let decoded = '';
+
+  for (let index = 0; index < token.length; index += 1) {
+    const character = token[index];
+
+    if (character !== '~') {
+      decoded += character;
+      continue;
+    }
+
+    const escape = token[index + 1];
+
+    if (escape === '0') {
+      decoded += '~';
+    } else if (escape === '1') {
+      decoded += '/';
+    } else {
+      throw new TypeError(`Invalid JSON Pointer escape sequence: ${token}`);
+    }
+
+    index += 1;
+  }
+
+  return decoded;
+}
+
+function resolveToken(value: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(value)) {
+    if (!isArrayIndex(token) || Number(token) >= value.length) {
+      throw new Error(`JSON Pointer does not resolve to a value: ${pointer}`);
+    }
+
+    return value[Number(token)];
+  }
+
+  if (value !== null && typeof value === 'object' && Object.hasOwn(value, token)) {
+    return (value as Record<string, unknown>)[token];
+  }
+
+  throw new Error(`JSON Pointer does not resolve to a value: ${pointer}`);
+}
+
+function isArrayIndex(token: string): boolean {
+  return /^(?:0|[1-9][0-9]*)$/.test(token);
+}
diff --git a/test/resolve-pointer.test.mjs b/test/resolve-pointer.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0adf61cd949440105b05d8c1f5ce60818c615874
--- /dev/null
+++ b/test/resolve-pointer.test.mjs
@@ -0,0 +1,40 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { resolvePointer } from '../dist/index.js';
+
+const document = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k\"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+test('resolves the RFC 6901 example pointers', () => {
+  assert.equal(resolvePointer(document, ''), document);
+  assert.equal(resolvePointer(document, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(document, '/'), 0);
+  assert.equal(resolvePointer(document, '/a~1b'), 1);
+  assert.equal(resolvePointer(document, '/c%d'), 2);
+  assert.equal(resolvePointer(document, '/e^f'), 3);
+  assert.equal(resolvePointer(document, '/g|h'), 4);
+  assert.equal(resolvePointer(document, '/i\\j'), 5);
+  assert.equal(resolvePointer(document, '/k\"l'), 6);
+  assert.equal(resolvePointer(document, '/ '), 7);
+  assert.equal(resolvePointer(document, '/m~0n'), 8);
+});
+
+test('rejects invalid pointers and unresolved references', () => {
+  assert.throws(() => resolvePointer(document, 'foo'));
+  assert.throws(() => resolvePointer(document, '/m~2n'));
+  assert.throws(() => resolvePointer(document, '/missing'));
+  assert.throws(() => resolvePointer(document, '/foo/2'));
+  assert.throws(() => resolvePointer(document, '/foo/01'));
+  assert.throws(() => resolvePointer(document, '/foo/-'));
+});
