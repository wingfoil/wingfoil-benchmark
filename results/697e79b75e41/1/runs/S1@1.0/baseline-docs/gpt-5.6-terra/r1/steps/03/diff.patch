diff --git a/test/apply-patch.test.mjs b/test/apply-patch.test.mjs
index f65fdb0d4f020d0303ea7b6df14453bf2a3c2b69..1e916bb48ba39b30ef250610e4a25c0b3884c148 100644
--- a/test/apply-patch.test.mjs
+++ b/test/apply-patch.test.mjs
@@ -74,3 +74,22 @@ test('rejects invalid patches and failing operations', () => {
   circular.self = circular;
   assert.throws(() => applyPatch(circular, []));
 });
+
+test('rejects patch documents and values that cannot be JSON', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'remove', path: '', ignored: undefined }]));
+  assert.throws(() => applyPatch({}, [{ op: 'remove', path: '', ignored: Infinity }]));
+  assert.throws(() => applyPatch([,], []));
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: '/value', value: [,] }]));
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: '/value', value: { missing: undefined } }]));
+});
+
+test('leaves the supplied document unchanged when a later operation fails', () => {
+  const document = { state: { value: 'before' } };
+
+  assert.throws(() => applyPatch(document, [
+    { op: 'replace', path: '/state/value', value: 'after' },
+    { op: 'test', path: '/state/value', value: 'not after' },
+  ]));
+
+  assert.deepEqual(document, { state: { value: 'before' } });
+});
