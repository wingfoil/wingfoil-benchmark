+/** A value permitted in a JSON document. */
+export type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
+
+/** A JSON Patch operation emitted by {@link createPatch}. */
+export type CreatedPatchOperation =
+  | { op: 'add' | 'replace'; path: string; value: JsonValue }
+  | { op: 'remove'; path: string };
+
+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ *
+ * The patch uses local additions, removals, and replacements where possible,
+ * rather than replacing an unchanged enclosing object or array. Both inputs
+ * and values included in the returned patch are detached from their sources.
+ *
+ * @param from - The JSON document to transform.
+ * @param to - The desired JSON document.
+ * @returns An ordered JSON Patch that transforms `from` into `to`.
+ * @throws {TypeError} If either argument is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): CreatedPatchOperation[] {
+  const source = cloneJson(from, 'from');
+  const target = cloneJson(to, 'to');
+  const patch: CreatedPatchOperation[] = [];
+  appendPatchOperations(source, target, [], patch);
+  return patch;
+}
+
+function appendPatchOperations(from: JsonValue, to: JsonValue, tokens: string[], patch: CreatedPatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    appendObjectPatchOperations(from, to, tokens, patch);
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    appendArrayPatchOperations(from, to, tokens, patch);
+  } else {
+    patch.push({ op: 'replace', path: tokensToPointer(tokens), value: cloneJson(to, 'patch value') });
+  }
+}
+
+function appendObjectPatchOperations(
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  tokens: string[],
+  patch: CreatedPatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) patch.push({ op: 'remove', path: tokensToPointer([...tokens, key]) });
+  }
+  for (const key of Object.keys(from)) {
+    if (Object.hasOwn(to, key)) appendPatchOperations(from[key], to[key], [...tokens, key], patch);
+  }
+  for (const key of Object.keys(to)) {
+    if (!Object.hasOwn(from, key)) {
+      patch.push({ op: 'add', path: tokensToPointer([...tokens, key]), value: cloneJson(to[key], 'patch value') });
+    }
+  }
+}
+
+function appendArrayPatchOperations(from: JsonValue[], to: JsonValue[], tokens: string[], patch: CreatedPatchOperation[]): void {
+  let prefixLength = 0;
+  while (prefixLength < from.length && prefixLength < to.length && jsonEqual(from[prefixLength], to[prefixLength])) {
+    prefixLength += 1;
+  }
+
+  let suffixLength = 0;
+  while (
+    suffixLength < from.length - prefixLength
+    && suffixLength < to.length - prefixLength
+    && jsonEqual(from[from.length - suffixLength - 1], to[to.length - suffixLength - 1])
+  ) {
+    suffixLength += 1;
+  }
+
+  const fromChangedLength = from.length - prefixLength - suffixLength;
+  const toChangedLength = to.length - prefixLength - suffixLength;
+  const sharedLength = Math.min(fromChangedLength, toChangedLength);
+
+  for (let index = 0; index < sharedLength; index += 1) {
+    appendPatchOperations(from[prefixLength + index], to[prefixLength + index], [...tokens, String(prefixLength + index)], patch);
+  }
+  for (let index = sharedLength; index < fromChangedLength; index += 1) {
+    patch.push({ op: 'remove', path: tokensToPointer([...tokens, String(prefixLength + sharedLength)]) });
+  }
+  for (let index = sharedLength; index < toChangedLength; index += 1) {
+    patch.push({
+      op: 'add',
+      path: tokensToPointer([...tokens, String(prefixLength + index)]),
+      value: cloneJson(to[prefixLength + index], 'patch value'),
+    });
+  }
+}
 
