 import test from 'node:test';
 
-import { applyMergePatch, applyPatch } from '../dist/index.js';
+import { applyMergePatch, applyPatch, createPatch } from '../dist/index.js';
+
+test('creates a compact JSON Patch for nested object and array changes', () => {
+  const from = {
+    unchanged: { deeply: ['retained'] },
+    settings: { theme: 'light', 'old/key': true },
+    items: [{ id: 1, done: false }, { id: 2 }],
+  };
+  const to = {
+    unchanged: { deeply: ['retained'] },
+    settings: { theme: 'dark', 'new/key': true },
+    items: [{ id: 1, done: true }, { id: 2 }, { id: 3 }],
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'remove', path: '/settings/old~1key' },
+    { op: 'replace', path: '/settings/theme', value: 'dark' },
+    { op: 'add', path: '/settings/new~1key', value: true },
+    { op: 'replace', path: '/items/0/done', value: true },
+    { op: 'add', path: '/items/2', value: { id: 3 } },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from.items[0], { id: 1, done: false });
+
+  patch[4].value.id = 99;
+  assert.deepEqual(to.items[2], { id: 3 });
+});
+
+test('creates an empty patch for equal values and rejects non-JSON inputs', () => {
+  assert.deepEqual(createPatch({ value: [1] }, { value: [1] }), []);
+  assert.throws(() => createPatch({ invalid: undefined }, {}));
+  assert.throws(() => createPatch({}, { invalid: Infinity }));
+});
+
+test('creates a local operation for a middle-array insertion', () => {
+  const from = { values: ['first', 'last'] };
+  const to = { values: ['first', 'middle', 'last'] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: 'add', path: '/values/1', value: 'middle' }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test('uses the empty JSON Pointer when replacing the document root', () => {
+  const patch = createPatch({ value: true }, ['replacement']);
+
+  assert.deepEqual(patch, [{ op: 'replace', path: '', value: ['replacement'] }]);
+  assert.deepEqual(applyPatch({ value: true }, patch), ['replacement']);
+});
 
