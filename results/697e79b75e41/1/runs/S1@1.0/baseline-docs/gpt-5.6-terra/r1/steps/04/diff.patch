@@ -24,6 +24,38 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
 
 type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
 
+/**
+ * Applies an RFC 7386 JSON Merge Patch without modifying either supplied value.
+ *
+ * Object members set to `null` in the patch are removed. A non-object patch
+ * replaces the target, while an object patch merges recursively into an object target.
+ *
+ * @param target - The JSON document to update.
+ * @param patch - The JSON Merge Patch document.
+ * @returns A new JSON document containing the merged result.
+ * @throws {TypeError} If either argument is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  const detachedTarget = cloneJson(target, 'target');
+  const detachedPatch = cloneJson(patch, 'JSON Merge Patch');
+  return mergePatch(detachedTarget, detachedPatch);
+}
+
+function mergePatch(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) return patch;
+
+  const result: { [key: string]: JsonValue } = isJsonObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const patchValue = patch[key];
+    if (patchValue === null) {
+      delete result[key];
+    } else {
+      defineJsonProperty(result, key, mergePatch(result[key], patchValue));
+    }
+  }
+  return result;
+}
+
