+import { applyMergePatch, applyPatch } from '../dist/index.js';
+
+test('applies the RFC 7386 merge patch examples', () => {
+  assert.deepEqual(
+    applyMergePatch(
+      { title: 'Goodbye!', author: { givenName: 'John', familyName: 'Doe' }, tags: ['example', 'sample'], content: 'This will be unchanged' },
+      { title: 'Hello!', phoneNumber: '+01-123-456-7890', author: { familyName: null }, tags: ['example'] },
+    ),
+    { title: 'Hello!', author: { givenName: 'John' }, tags: ['example'], content: 'This will be unchanged', phoneNumber: '+01-123-456-7890' },
+  );
+  assert.deepEqual(applyMergePatch({ a: 'b' }, null), null);
+  assert.deepEqual(applyMergePatch('not an object', { a: 'b' }), { a: 'b' });
+  assert.deepEqual(applyMergePatch({ a: { b: 'c' } }, { a: { b: null } }), { a: {} });
+});
+
+test('does not mutate or share mutable merge-patch inputs', () => {
+  const target = { retained: { values: [1] } };
+  const patch = { added: { values: [2] } };
+
+  const result = applyMergePatch(target, patch);
+  result.retained.values.push(3);
+  result.added.values.push(4);
+
+  assert.deepEqual(target, { retained: { values: [1] } });
+  assert.deepEqual(patch, { added: { values: [2] } });
+});
+
+test('rejects merge-patch arguments that are not JSON values', () => {
+  assert.throws(() => applyMergePatch({ value: undefined }, {}));
+  assert.throws(() => applyMergePatch({}, { value: Infinity }));
+  assert.throws(() => applyMergePatch({}, [,]));
+});
 
