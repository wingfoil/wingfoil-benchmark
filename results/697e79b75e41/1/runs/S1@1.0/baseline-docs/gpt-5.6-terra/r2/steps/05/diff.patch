+/** An RFC 6902 operation emitted by {@link createPatch}. */
+export type JsonPatchOperation =
+  | { op: "add"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "replace"; path: string; value: JsonValue };
+
+/** A sequence of RFC 6902 operations. */
+export type JsonPatch = JsonPatchOperation[];
+
+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ *
+ * Unchanged object members and array elements are omitted. Object members are
+ * compared recursively; equal-length arrays are compared by index, while
+ * insertions and removals in arrays preserve their common subsequence. The
+ * returned patch and both inputs are independent values.
+ *
+ * @param from - The source JSON document.
+ * @param to - The desired JSON document.
+ * @returns A JSON Patch that transforms `from` into `to`.
+ * @throws {Error} If either input is not a valid JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatch {
+  const source = cloneJson(from);
+  const target = cloneJson(to);
+  const patch: JsonPatch = [];
+
+  createPatchOperations(source, target, [], patch);
+  return patch;
+}
