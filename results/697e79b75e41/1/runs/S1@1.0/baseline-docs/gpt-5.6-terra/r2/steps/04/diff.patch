+
+test("applies an RFC 7386 object merge patch without changing either input", () => {
+  const target = {
+    title: "Goodbye!",
+    author: {
+      givenName: "John",
+      familyName: "Doe",
+    },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: {
+      familyName: null,
+    },
+    tags: ["example"],
+  };
+
+  const result = applyMergePatch(target, patch);
+
+  assert.deepEqual(result, {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+  assert.deepEqual(target, {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  });
+  assert.deepEqual(patch, {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  });
+});
+
+test("replaces non-object targets and patches, and ignores null removals of absent members", () => {
+  assert.deepEqual(applyMergePatch("not an object", { value: 1 }), { value: 1 });
+  assert.deepEqual(applyMergePatch({ value: 1 }, ["replacement"]), ["replacement"]);
+  assert.equal(applyMergePatch({ value: 1 }, null), null);
+  assert.deepEqual(applyMergePatch({ retained: true }, { missing: null }), { retained: true });
+});
+
+test("rejects merge-patch inputs that are not JSON values", () => {
+  assert.throws(() => applyMergePatch({ value: 1 }, Number.NaN));
+  assert.throws(() => applyMergePatch({ value: 1 }, { invalid: undefined }));
+});
