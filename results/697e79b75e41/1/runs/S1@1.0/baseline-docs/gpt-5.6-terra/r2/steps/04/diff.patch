+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document without modifying
+ * either input.
+ *
+ * Object-valued patches merge members recursively. A `null` member removes the
+ * corresponding target member; all other patch values replace the target
+ * value, including arrays.
+ *
+ * @param target - The JSON document to update.
+ * @param patch - The RFC 7386 merge-patch document to apply.
+ * @returns A new JSON document containing the merged value.
+ * @throws {Error} If either input is not a valid JSON value.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  return mergePatch(cloneJson(target), cloneJson(patch));
+}
+
 /**
  * Resolves an RFC 6901 JSON Pointer against a JSON document.
  *
@@ -119,6 +136,36 @@ function isArrayIndex(token: string): boolean {
     && Number.isSafeInteger(Number(token));
 }
 
+function mergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return patch;
+  }
+
+  const result: { [key: string]: JsonValue } = isJsonObject(target) ? target : {};
+
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+      continue;
+    }
+
+    const existingValue = Object.hasOwn(result, key) ? result[key] : null;
+    Object.defineProperty(result, key, {
+      configurable: true,
+      enumerable: true,
+      value: mergePatch(existingValue, value),
+      writable: true,
+    });
+  }
+
+  return result;
+}
+
+function isJsonObject(value: JsonValue): value is { [key: string]: JsonValue } {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
