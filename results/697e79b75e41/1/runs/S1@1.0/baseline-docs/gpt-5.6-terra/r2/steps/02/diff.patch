+  if (Array.isArray(parent)) {
+    if (!isArrayIndex(token) || !Object.hasOwn(parent, token)) {
+      throw new Error(`JSON Patch does not resolve array index '${token}'.`);
+    }
+    parent[Number(token)] = value;
+    return document;
+  }
+  if (!Object.hasOwn(parent, token)) {
+    throw new Error(`JSON Patch does not resolve object member '${token}'.`);
+  }
+  Object.defineProperty(parent, token, {
+    configurable: true,
+    enumerable: true,
+    value,
+    writable: true,
+  });
+  return document;
+}
+
+function getParent(
+  document: JsonValue,
+  path: string[],
+): { parent: JsonValue[] | { [key: string]: JsonValue }; token: string } {
+  const token = path[path.length - 1] as string;
+  const parent = getValue(document, path.slice(0, -1));
+  if (parent === null || typeof parent !== "object") {
+    throw new Error("JSON Patch cannot apply an operation below a primitive value.");
+  }
+  return { parent, token };
+}
+
+function sameTokens(left: string[], right: string[]): boolean {
+  return left.length === right.length && left.every((token, index) => token === right[index]);
+}
+
