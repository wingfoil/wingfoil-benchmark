+/**
+ * Applies an RFC 6902 JSON Patch to a JSON document without modifying either
+ * input.
+ *
+ * @param document - The JSON document to update.
+ * @param patch - An array of RFC 6902 operation objects.
+ * @returns A new JSON document containing the patched value.
+ * @throws {Error} If an input is not valid JSON Patch or an operation fails.
+ */
+export function applyPatch(document: JsonValue, patch: unknown): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("A JSON Patch must be an array of operations.");
+  }
+
+  let result = cloneJson(document);
+
+  for (const rawOperation of patch) {
+    const operation = validateOperation(rawOperation);
+    result = applyOperation(result, operation);
+  }
+
+  return result;
+}
