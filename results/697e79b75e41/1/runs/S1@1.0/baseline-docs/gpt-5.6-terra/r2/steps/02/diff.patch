index e0c56a6a022ad4eb33219b5ad71745a2741446fc..9a4ebe24171780d0d1bcd447e8cd3c0871c25914 100644
--- a/README.md
+++ b/README.md
@@ -24,3 +24,21 @@ resolvePointer(document, "/a~1b/~0key"); // true
 The function throws when the pointer is malformed (including an invalid `~`
 escape), an array token is not a valid array index, or a selected member/index
 does not exist. It returns `JsonValue`, the exported type for JSON values.
+
+## JSON Patch
+
+`applyPatch(document, patch)` applies an [RFC 6902 JSON Patch](https://www.rfc-editor.org/rfc/rfc6902)
+without changing either input. It supports `add`, `remove`, `replace`, `move`,
+`copy`, and `test`, including RFC 6901-escaped paths. A malformed patch or an
+operation whose target cannot be resolved throws an error.
+
+```ts
+import { applyPatch } from "json-toolkit";
+
+const updated = applyPatch({ users: ["Ari"] }, [
+  { op: "add", path: "/users/-", value: "Sam" },
+  { op: "replace", path: "/users/0", value: "Arianna" },
+]);
+
+// { users: ["Arianna", "Sam"] }
+```
