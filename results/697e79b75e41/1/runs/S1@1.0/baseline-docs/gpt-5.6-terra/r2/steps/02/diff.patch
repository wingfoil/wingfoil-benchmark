+
+test("applies every RFC 6902 operation without changing the input", () => {
+  const original = {
+    title: "Goodbye!",
+    authors: ["Nigel Rees"],
+    nested: { enabled: true },
+  };
+
+  const result = applyPatch(original, [
+    { op: "add", path: "/authors/-", value: "David Thomas" },
+    { op: "add", path: "/a~1b", value: "escaped member" },
+    { op: "replace", path: "/title", value: "Hello!" },
+    { op: "copy", from: "/nested", path: "/copied" },
+    { op: "move", from: "/authors/0", path: "/leadAuthor" },
+    { op: "test", path: "/nested/enabled", value: true },
+    { op: "remove", path: "/nested/enabled" },
+  ]);
+
+  assert.deepEqual(result, {
+    title: "Hello!",
+    authors: ["David Thomas"],
+    nested: {},
+    "a/b": "escaped member",
+    copied: { enabled: true },
+    leadAuthor: "Nigel Rees",
+  });
+  assert.deepEqual(original, {
+    title: "Goodbye!",
+    authors: ["Nigel Rees"],
+    nested: { enabled: true },
+  });
+  assert.notEqual(result, original);
+  assert.notEqual((result as { copied: object }).copied, original.nested);
+});
+
+test("supports replacing the document and inserting into arrays", () => {
+  assert.deepEqual(applyPatch(["a", "c"], [
+    { op: "add", path: "/1", value: "b" },
+  ]), ["a", "b", "c"]);
+  assert.deepEqual(applyPatch({ old: true }, [
+    { op: "add", path: "", value: { replacement: true } },
+  ]), { replacement: true });
+});
+
+test("rejects invalid patches and operations that cannot be applied", () => {
+  assert.throws(() => applyPatch({}, { op: "add" }));
+  assert.throws(() => applyPatch({}, [{ op: "unknown", path: "/x" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "x", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/missing" }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/2", value: 2 }]));
+  assert.throws(() => applyPatch({ value: 1 }, [
+    { op: "test", path: "/value", value: 2 },
+  ]));
+  assert.throws(() => applyPatch({ child: { value: 1 } }, [
+    { op: "move", from: "/child", path: "/child/value/moved" },
+  ]));
+});
