+    case "replace":
+      return replaceValue(document, path, cloneJson(operation.value));
+    case "copy": {
+      const value = getValue(document, parsePointer(operation.from as string));
+      return addValue(document, path, cloneJson(value));
+    }
+    case "move": {
+      const from = parsePointer(operation.from as string);
+      if (isProperPrefix(from, path)) {
+        throw new Error("A JSON Patch move destination cannot be a child of its source.");
+      }
+      if (sameTokens(from, path)) {
