+    throw new Error(`JSON Patch '${operation.op}' operations require a 'value' member.`);
+  }
+  if (["move", "copy"].includes(operation.op)
+    && (!Object.hasOwn(operation, "from") || typeof operation.from !== "string")) {
+    throw new Error(`JSON Patch '${operation.op}' operations require a string 'from' member.`);
+  }
