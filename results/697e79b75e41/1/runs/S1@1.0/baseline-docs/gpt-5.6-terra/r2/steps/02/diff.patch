+  if (value === null || typeof value !== "object" || Array.isArray(value)) {
+    throw new Error("Each JSON Patch operation must be an object.");
+  }
+
+  const operation = value as PatchOperation;
+  if (!Object.hasOwn(operation, "op") || typeof operation.op !== "string") {
+    throw new Error("A JSON Patch operation must contain a string 'op' member.");
+  }
+  if (!Object.hasOwn(operation, "path") || typeof operation.path !== "string") {
+    throw new Error("A JSON Patch operation must contain a string 'path' member.");
+  }
+
+  if (!["add", "remove", "replace", "move", "copy", "test"].includes(operation.op)) {
+    throw new Error(`Unsupported JSON Patch operation '${operation.op}'.`);
+  }
+
