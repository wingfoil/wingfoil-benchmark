new file mode 100644
index 0000000000000000000000000000000000000000..fd3f0c1525ca295dc00703d968844631cbcf9aab
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,94 @@
+/** A value that can occur in a JSON document. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @param document - The JSON document to search.
+ * @param pointer - An RFC 6901 JSON Pointer. The empty string identifies the
+ * whole document.
+ * @returns The JSON value identified by the pointer.
+ * @throws {Error} If `pointer` is malformed or does not identify a value.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  if (typeof pointer !== "string") {
+    throw new Error("A JSON Pointer must be a string.");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error("A non-empty JSON Pointer must start with '/'.");
+  }
+
+  let current: JsonValue = document;
+
+  for (const encodedToken of pointer.slice(1).split("/")) {
+    const token = decodeReferenceToken(encodedToken);
+    current = resolveToken(current, token);
+  }
+
+  return current;
+}
+
+function decodeReferenceToken(token: string): string {
+  let decoded = "";
+
+  for (let index = 0; index < token.length; index += 1) {
+    const character = token[index];
+
+    if (character !== "~") {
+      decoded += character;
+      continue;
+    }
+
+    const escape = token[index + 1];
+    if (escape === "0") {
+      decoded += "~";
+    } else if (escape === "1") {
+      decoded += "/";
+    } else {
+      throw new Error(`Invalid JSON Pointer escape in token '${token}'.`);
+    }
+
+    index += 1;
+  }
+
+  return decoded;
+}
+
+function resolveToken(value: JsonValue, token: string): JsonValue {
+  if (Array.isArray(value)) {
+    if (!isArrayIndex(token)) {
+      throw new Error(`'${token}' is not a valid JSON Pointer array index.`);
+    }
+
+    if (!Object.hasOwn(value, token)) {
+      throw new Error(`JSON Pointer does not resolve array index '${token}'.`);
+    }
+
+    return value[Number(token)] as JsonValue;
+  }
+
+  if (value !== null && typeof value === "object") {
+    if (!Object.hasOwn(value, token)) {
+      throw new Error(`JSON Pointer does not resolve object member '${token}'.`);
+    }
+
+    return value[token];
+  }
+
+  throw new Error("JSON Pointer cannot resolve a token from a primitive value.");
+}
+
+function isArrayIndex(token: string): boolean {
+  return token === "0" || /^[1-9][0-9]*$/.test(token);
+}
diff --git a/test/index.test.ts b/test/index.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..91baf71dc10fd56a965adc681acd66602890cbde
--- /dev/null
+++ b/test/index.test.ts
@@ -0,0 +1,41 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { resolvePointer } from "../src/index.ts";
+
+const document = {
+  "": "empty member name",
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  "k\"l": 6,
+  " ": 7,
+  "m~n": 8,
+  nested: { values: ["zero", false, null] },
+};
+
+test("resolves RFC 6901 reference tokens", () => {
+  assert.equal(resolvePointer(document, ""), document);
+  assert.equal(resolvePointer(document, "/"), "empty member name");
+  assert.equal(resolvePointer(document, "/a~1b"), 1);
+  assert.equal(resolvePointer(document, "/m~0n"), 8);
+  assert.equal(resolvePointer(document, "/nested/values/0"), "zero");
+  assert.equal(resolvePointer(document, "/nested/values/1"), false);
+  assert.equal(resolvePointer(document, "/nested/values/2"), null);
+});
+
+test("rejects malformed pointers and invalid escape sequences", () => {
+  assert.throws(() => resolvePointer(document, "nested/values"));
+  assert.throws(() => resolvePointer(document, "/m~2n"));
+  assert.throws(() => resolvePointer(document, "/m~"));
+});
+
+test("rejects pointers that do not identify a document value", () => {
+  assert.throws(() => resolvePointer(document, "/missing"));
+  assert.throws(() => resolvePointer(document, "/nested/values/3"));
+  assert.throws(() => resolvePointer(document, "/nested/values/01"));
+  assert.throws(() => resolvePointer(document, "/nested/values/-"));
+  assert.throws(() => resolvePointer(document, "/nested/values/0/child"));
+});
