diff --git a/test/index.test.ts b/test/index.test.ts
index 2aed4c4bf4e95999e289db456cf694029b372497..7ac4179e335c8c6920c09e928f7b4eaea301b10c 100644
--- a/test/index.test.ts
+++ b/test/index.test.ts
@@ -102,3 +102,32 @@ test("rejects malformed patches and operations that cannot be applied", () => {
     assert.throws(() => applyPatch({ a: { b: 1 }, items: [] }, patch));
   }
 });
+
+test("rejects values that are not JSON before applying a patch", () => {
+  const cyclic: { self?: unknown } = {};
+  cyclic.self = cyclic;
+
+  for (const [document, patch] of [
+    [undefined, []],
+    [{ value: Infinity }, []],
+    [{ value: new Date() }, []],
+    [{ value: 1 }, [{ op: "add", path: "/new", value: undefined }]],
+    [{ value: 1 }, [{ op: "test", path: "/value", value: Number.NaN }]],
+    [{ value: 1 }, [{ op: "add", path: "/new", value: cyclic }]],
+  ] as const) {
+    assert.throws(() => applyPatch(document, patch));
+  }
+});
+
+test("leaves the input document unchanged when a later operation fails", () => {
+  const original = { status: "draft", items: [1] };
+
+  assert.throws(() =>
+    applyPatch(original, [
+      { op: "replace", path: "/status", value: "published" },
+      { op: "test", path: "/items/0", value: 2 },
+    ]),
+  );
+
+  assert.deepEqual(original, { status: "draft", items: [1] });
+});
