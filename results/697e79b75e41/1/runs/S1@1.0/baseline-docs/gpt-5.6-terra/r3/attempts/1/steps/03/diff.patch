diff --git a/test/patch.test.mjs b/test/patch.test.mjs
index 347099460ddec742edf700093ddb85f33850ac8f..37ab016141979bce4e1a2735fbd662a6e4200192 100644
--- a/test/patch.test.mjs
+++ b/test/patch.test.mjs
@@ -62,3 +62,64 @@ test("rejects invalid patch operations and operations whose targets fail", () =>
   assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: 2 }]));
   assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
 });
+
+test("requires operation members to be own JSON object members", () => {
+  withObjectPrototypeMembers({ op: "add", path: "/value" }, () => {
+    assert.throws(() => applyPatch({}, [{ value: 1 }]));
+  });
+  withObjectPrototypeMembers({ value: 1 }, () => {
+    assert.throws(() => applyPatch({}, [{ op: "add", path: "/value" }]));
+  });
+  withObjectPrototypeMembers({ from: "/source" }, () => {
+    assert.throws(() => applyPatch({ source: 1 }, [{ op: "copy", path: "/copy" }]));
+  });
+});
+
+test("leaves the supplied document unchanged when evaluation stops at an error", () => {
+  const document = { status: "draft" };
+
+  assert.throws(() => applyPatch(document, [
+    { op: "replace", path: "/status", value: "published" },
+    { op: "test", path: "/status", value: "draft" },
+  ]));
+
+  assert.deepEqual(document, { status: "draft" });
+});
+
+test("rejects JavaScript values that cannot represent JSON patch documents", () => {
+  const sparseArray = [];
+  sparseArray.length = 1;
+  assert.throws(() => applyPatch(sparseArray, []));
+
+  assert.throws(() => applyPatch({}, [{
+    op: "add",
+    path: "/value",
+    value: 1,
+    ignored: undefined,
+  }]));
+});
+
+function withObjectPrototypeMembers(members, callback) {
+  const originals = new Map(Object.keys(members).map((key) => [
+    key,
+    Object.getOwnPropertyDescriptor(Object.prototype, key),
+  ]));
+  try {
+    for (const [key, value] of Object.entries(members)) {
+      Object.defineProperty(Object.prototype, key, {
+        configurable: true,
+        value,
+        writable: true,
+      });
+    }
+    callback();
+  } finally {
+    for (const [key, descriptor] of originals) {
+      if (descriptor === undefined) {
+        delete Object.prototype[key];
+      } else {
+        Object.defineProperty(Object.prototype, key, descriptor);
+      }
+    }
+  }
+}
