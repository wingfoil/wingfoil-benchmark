index 0000000000000000000000000000000000000000..f8ab2bd850af1b93a9115e15936f648a5f5ec6e9
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,77 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @param document The document to traverse.
+ * @param pointer An RFC 6901 JSON Pointer string.
+ * @returns The value designated by the pointer.
+ * @throws {TypeError} If `pointer` is not a valid JSON Pointer.
+ * @throws {Error} If the pointer does not designate a value in `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  const referenceTokens = parsePointer(pointer);
+  let value = document;
+
+  for (const token of referenceTokens) {
+    value = resolveToken(value, token, pointer);
+  }
+
+  return value;
+}
+
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string" || (pointer !== "" && !pointer.startsWith("/"))) {
+    throw new TypeError("A JSON Pointer must be empty or begin with '/'.");
+  }
+
+  if (pointer === "") {
+    return [];
+  }
+
+  return pointer.slice(1).split("/").map(decodeReferenceToken);
+}
+
+function decodeReferenceToken(token: string): string {
+  let decoded = "";
+
+  for (let index = 0; index < token.length; index += 1) {
+    const character = token[index];
+
+    if (character !== "~") {
+      decoded += character;
+      continue;
+    }
+
+    const escape = token[index + 1];
+    if (escape === "0") {
+      decoded += "~";
+    } else if (escape === "1") {
+      decoded += "/";
+    } else {
+      throw new TypeError("A JSON Pointer contains an invalid '~' escape sequence.");
+    }
+
+    index += 1;
+  }
+
+  return decoded;
+}
+
+function resolveToken(value: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(value)) {
+    if (!isArrayIndex(token) || Number(token) >= value.length) {
+      throw new Error(`JSON Pointer does not resolve to a value: ${pointer}`);
+    }
+
+    return value[Number(token)];
+  }
+
+  if (typeof value === "object" && value !== null && Object.hasOwn(value, token)) {
+    return (value as Record<string, unknown>)[token];
+  }
+
+  throw new Error(`JSON Pointer does not resolve to a value: ${pointer}`);
+}
+
+function isArrayIndex(token: string): boolean {
+  return token === "0" || /^[1-9][0-9]*$/.test(token);
+}
diff --git a/test/index.test.ts b/test/index.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4972034eee3bc6eb1be95308e1cbb85bc2260420
--- /dev/null
+++ b/test/index.test.ts
@@ -0,0 +1,44 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { resolvePointer } from "../src/index.ts";
+
+const document = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  "k\"l": 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("resolves the RFC 6901 examples", () => {
+  assert.deepEqual(resolvePointer(document, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(document, "/foo/0"), "bar");
+  assert.equal(resolvePointer(document, "/"), 0);
+  assert.equal(resolvePointer(document, "/a~1b"), 1);
+  assert.equal(resolvePointer(document, "/m~0n"), 8);
+});
+
+test("returns the entire document for the empty pointer", () => {
+  assert.equal(resolvePointer(document, ""), document);
+});
+
+test("distinguishes object members from array indexes", () => {
+  assert.equal(resolvePointer({ "01": "member" }, "/01"), "member");
+  assert.equal(resolvePointer(["zero", "one"], "/1"), "one");
+});
+
+test("rejects malformed or unresolved pointers", () => {
+  for (const pointer of ["foo", "/m~2n", "/m~", "/foo/-", "/foo/01", "/foo/2"]) {
+    assert.throws(() => resolvePointer(document, pointer));
+  }
+});
+
+test("resolves JSON null as a document value", () => {
+  assert.equal(resolvePointer({ value: null }, "/value"), null);
+});
