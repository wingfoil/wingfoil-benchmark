diff --git a/test/patch.test.mjs b/test/patch.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..347099460ddec742edf700093ddb85f33850ac8f
--- /dev/null
+++ b/test/patch.test.mjs
@@ -0,0 +1,64 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyPatch } from "../src/index.ts";
+
+test("applies the six RFC 6902 operations without mutating the document", () => {
+  const document = {
+    foo: ["bar", "baz"],
+    nested: { enabled: true },
+  };
+
+  const result = applyPatch(document, [
+    { op: "add", path: "/foo/1", value: "qux" },
+    { op: "remove", path: "/foo/0" },
+    { op: "replace", path: "/nested/enabled", value: false },
+    { op: "copy", from: "/nested", path: "/copy" },
+    { op: "move", from: "/foo/1", path: "/last" },
+    { op: "test", path: "/copy", value: { enabled: false } },
+  ]);
+
+  assert.deepEqual(result, {
+    foo: ["qux"],
+    nested: { enabled: false },
+    copy: { enabled: false },
+    last: "baz",
+  });
+  assert.deepEqual(document, {
+    foo: ["bar", "baz"],
+    nested: { enabled: true },
+  });
+  assert.notEqual(result, document);
+});
+
+test("supports root replacement, escaped tokens, and array append", () => {
+  assert.deepEqual(applyPatch({ "a/b": [] }, [
+    { op: "add", path: "/a~1b/-", value: 1 },
+    { op: "add", path: "", value: { replaced: true } },
+  ]), { replaced: true });
+});
+
+test("moves using the document after source removal and copies by value", () => {
+  const result = applyPatch({ items: ["a", "b", "c", "d"], source: { x: 1 } }, [
+    { op: "move", from: "/items/1", path: "/items/3" },
+    { op: "copy", from: "/source", path: "/copied" },
+  ]);
+
+  assert.deepEqual(result, {
+    items: ["a", "c", "d", "b"],
+    source: { x: 1 },
+    copied: { x: 1 },
+  });
+  assert.notEqual(result.source, result.copied);
+});
+
+test("rejects invalid patch operations and operations whose targets fail", () => {
+  assert.throws(() => applyPatch({}, {}));
+  assert.throws(() => applyPatch({}, [{ op: "unknown", path: "/x" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/x" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "x", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "copy", path: "/x" }]));
+  assert.throws(() => applyPatch([], [{ op: "remove", path: "/0" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: 2 }]));
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+});
