+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document.
+ *
+ * Object patches are applied recursively, with `null` member values removing
+ * their corresponding target members. All other patch values replace the
+ * target. Neither input is mutated.
+ *
+ * @param target The JSON document to update.
+ * @param patch The RFC 7386 merge patch document.
+ * @returns The merged JSON document.
+ * @throws {TypeError} If either input contains a non-JSON value or a cycle.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJsonValue(target, "The target");
+  assertJsonValue(patch, "A JSON Merge Patch");
+
+  return mergePatch(cloneJsonValue(target), patch);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return cloneJsonValue(patch);
+  }
+
+  const result: Record<string, unknown> = isObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const targetValue = Object.hasOwn(result, key) ? result[key] : undefined;
+      defineJsonMember(result, key, mergePatch(targetValue, value));
+    }
+  }
+
+  return result;
+}
+
 type Operation = {
   op: string;
   path: string;
