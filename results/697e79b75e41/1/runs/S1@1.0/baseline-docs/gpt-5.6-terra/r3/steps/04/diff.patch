@@ -131,3 +131,86 @@ test("leaves the input document unchanged when a later operation fails", () => {
 
   assert.deepEqual(original, { status: "draft", items: [1] });
 });
+
+test("applies the RFC 7386 merge patch example without mutating either input", () => {
+  const target = {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+  assert.deepEqual(target, {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  });
+  assert.deepEqual(patch, {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  });
+});
+
+test("replaces targets with non-object merge patches and initializes object targets", () => {
+  assert.deepEqual(applyMergePatch({ value: true }, ["replacement"]), ["replacement"]);
+  assert.deepEqual(applyMergePatch(["target"], { value: "patch" }), { value: "patch" });
+  assert.deepEqual(applyMergePatch(null, { value: null }), {});
+});
+
+test("applies the remaining RFC 7386 appendix A examples", () => {
+  const examples: Array<{ target: unknown; patch: unknown; result: unknown }> = [
+    { target: { a: "b" }, patch: { a: "c" }, result: { a: "c" } },
+    { target: { a: "b" }, patch: { b: "c" }, result: { a: "b", b: "c" } },
+    { target: { a: "b" }, patch: { a: null }, result: {} },
+    { target: { a: "b", b: "c" }, patch: { a: null }, result: { b: "c" } },
+    { target: { a: ["b"] }, patch: { a: "c" }, result: { a: "c" } },
+    { target: { a: "c" }, patch: { a: ["b"] }, result: { a: ["b"] } },
+    {
+      target: { a: { b: "c" } },
+      patch: { a: { b: "d", c: null } },
+      result: { a: { b: "d" } },
+    },
+    { target: { a: ["b"] }, patch: { a: { b: "c" } }, result: { a: { b: "c" } } },
+    { target: { a: { b: "c" } }, patch: { a: ["b"] }, result: { a: ["b"] } },
+    { target: ["a", "b"], patch: ["c", "d"], result: ["c", "d"] },
+    { target: { a: "b" }, patch: ["c"], result: ["c"] },
+    { target: { a: "foo" }, patch: null, result: null },
+    { target: { a: "foo" }, patch: "bar", result: "bar" },
+    { target: { e: null }, patch: { a: 1 }, result: { e: null, a: 1 } },
+    { target: [1, 2], patch: { a: "b", c: null }, result: { a: "b" } },
+  ];
+
+  for (const example of examples) {
+    assert.deepEqual(applyMergePatch(example.target, example.patch), example.result);
+  }
+});
+
+test("treats __proto__ as a JSON member without modifying object prototypes", () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true}}');
+  const result = applyMergePatch({}, patch) as Record<string, unknown>;
+
+  assert.deepEqual(result, patch);
+  assert.equal(Object.hasOwn(result, "__proto__"), true);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("rejects merge patches that are not JSON values", () => {
+  assert.throws(() => applyMergePatch({ value: 1 }, { value: Number.NaN }));
+  assert.throws(() => applyMergePatch(undefined, null));
+});
