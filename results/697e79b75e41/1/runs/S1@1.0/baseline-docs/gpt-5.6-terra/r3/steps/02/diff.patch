+
+test("applies add, remove, and replace operations without mutating the document", () => {
+  const original = { foo: ["bar", "baz"], object: { old: true } };
+
+  const result = applyPatch(original, [
+    { op: "add", path: "/foo/1", value: "qux" },
+    { op: "add", path: "/object/new", value: 1 },
+    { op: "remove", path: "/object/old" },
+    { op: "replace", path: "/foo/0", value: "boo" },
+  ]);
+
+  assert.deepEqual(result, { foo: ["boo", "qux", "baz"], object: { new: 1 } });
+  assert.deepEqual(original, { foo: ["bar", "baz"], object: { old: true } });
+});
+
+test("supports appending to arrays and replacing the document root", () => {
+  assert.deepEqual(applyPatch({ items: [1] }, [{ op: "add", path: "/items/-", value: 2 }]), {
+    items: [1, 2],
+  });
+  assert.deepEqual(applyPatch({ old: true }, [{ op: "replace", path: "", value: ["new"] }]), ["new"]);
+});
+
+test("moves and copies values using decoded JSON Pointers", () => {
