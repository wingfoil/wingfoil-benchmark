+/** An RFC 6902 operation produced by {@link createPatch}. */
+export type JsonPatchOperation =
+  | { op: "add"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "replace"; path: string; value: unknown };
+
+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ *
+ * The returned patch contains only the changed members or array elements where
+ * possible. Neither input is mutated, and values embedded in the patch are
+ * independent copies of `to`.
+ *
+ * @param from The source JSON document.
+ * @param to The target JSON document.
+ * @returns A JSON Patch that transforms `from` into `to`.
+ * @throws {TypeError} If either input contains a non-JSON value or a cycle.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  assertJsonValue(from, "The source document");
+  assertJsonValue(to, "The target document");
+
+  const patch: JsonPatchOperation[] = [];
+  createPatchOperations(from, to, "", patch);
+  return patch;
+}
+
