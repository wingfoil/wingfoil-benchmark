+test("creates a JSON Patch for granular nested object changes without mutating either input", () => {
+  const from = {
+    unchanged: { nested: true },
+    settings: { theme: "light", pageSize: 20, obsolete: true },
+  };
+  const to = {
+    unchanged: { nested: true },
+    settings: { theme: "dark", pageSize: 20, compact: false },
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/settings/obsolete" },
+    { op: "replace", path: "/settings/theme", value: "dark" },
+    { op: "add", path: "/settings/compact", value: false },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    unchanged: { nested: true },
+    settings: { theme: "light", pageSize: 20, obsolete: true },
+  });
+  assert.deepEqual(to, {
+    unchanged: { nested: true },
+    settings: { theme: "dark", pageSize: 20, compact: false },
+  });
+});
+
+test("creates granular array patches and escapes JSON Pointer member names", () => {
+  const from = { "a/b~c": ["first", "last"] };
+  const to = { "a/b~c": ["first", "middle", "updated"] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "replace", path: "/a~1b~0c/1", value: "middle" },
+    { op: "add", path: "/a~1b~0c/2", value: "updated" },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("creates an empty patch for equal values and replaces differing roots", () => {
+  assert.deepEqual(createPatch({ value: [1, null] }, { value: [1, null] }), []);
+  assert.deepEqual(createPatch({ value: 1 }, ["replacement"]), [
+    { op: "replace", path: "", value: ["replacement"] },
+  ]);
+});
+
+test("rejects non-JSON values when creating a patch", () => {
+  assert.throws(() => createPatch({ value: 1 }, { value: Number.NaN }));
+  assert.throws(() => createPatch(undefined, null));
+});
