+function createPatchOperations(
+  from: unknown,
+  to: unknown,
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  if (jsonEquals(from, to)) {
+    return;
+  }
+
+  if (isObject(from) && isObject(to)) {
+    createObjectPatchOperations(from, to, path, patch);
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatchOperations(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: "replace", path, value: cloneJsonValue(to) });
+}
+
+function createObjectPatchOperations(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      patch.push({ op: "remove", path: appendPointerToken(path, key) });
+    }
+  }
+
+  for (const key of Object.keys(to)) {
+    const memberPath = appendPointerToken(path, key);
+    if (!Object.hasOwn(from, key)) {
+      patch.push({ op: "add", path: memberPath, value: cloneJsonValue(to[key]) });
+    } else {
+      createPatchOperations(from[key], to[key], memberPath, patch);
+    }
+  }
+}
+
+function createArrayPatchOperations(
+  from: unknown[],
+  to: unknown[],
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEquals(from[start], to[start])) {
+    start += 1;
+  }
+
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && jsonEquals(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd -= 1;
+    toEnd -= 1;
+  }
+
+  const sharedLength = Math.min(fromEnd - start, toEnd - start);
+  for (let index = 0; index < sharedLength; index += 1) {
+    createPatchOperations(from[start + index], to[start + index], appendPointerToken(path, String(start + index)), patch);
+  }
+
+  for (let index = fromEnd - 1; index >= start + sharedLength; index -= 1) {
+    patch.push({ op: "remove", path: appendPointerToken(path, String(index)) });
+  }
+
+  for (let index = start + sharedLength; index < toEnd; index += 1) {
+    patch.push({ op: "add", path: appendPointerToken(path, String(index)), value: cloneJsonValue(to[index]) });
+  }
+}
+
+function appendPointerToken(path: string, token: string): string {
+  return `${path}/${token.replaceAll("~", "~0").replaceAll("/", "~1")}`;
+}
