+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document without mutating the inputs.
+ * Object patches recursively update members, null values remove members, and any
+ * non-object patch replaces the target value.
+ *
+ * @param target The JSON document to update.
+ * @param patch The JSON Merge Patch value to apply.
+ * @returns A new JSON document containing the patch result.
+ * @throws {Error} If either input is not a JSON value.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonValue(target)) throw new Error("JSON Merge Patch target must be a JSON value");
+  if (!isJsonValue(patch)) throw new Error("JSON Merge Patch patch must be a JSON value");
+
+  const merge = (current: JsonValue, update: JsonValue): JsonValue => {
+    if (update === null || typeof update !== "object" || Array.isArray(update)) {
+      return cloneJson(update);
+    }
+
+    const result: { [key: string]: JsonValue } =
+      current !== null && typeof current === "object" && !Array.isArray(current)
+        ? cloneJson(current) as { [key: string]: JsonValue }
+        : {};
+
+    for (const key of Object.keys(update)) {
+      const value = update[key];
+      if (value === null) {
+        delete result[key];
+      } else {
+        const existing = Object.prototype.hasOwnProperty.call(result, key) ? result[key] : null;
+        Object.defineProperty(result, key, {
+          value: merge(existing, value), enumerable: true, writable: true, configurable: true,
+        });
+      }
+    }
+    return result;
+  };
+
+  return merge(target, patch);
+}
