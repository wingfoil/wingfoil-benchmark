@@ -0,0 +1,68 @@
+/** A value that can appear in a JSON document. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * The empty pointer refers to the whole document. Pointer tokens decode `~1`
+ * as `/` and `~0` as `~`. Invalid pointers and pointers that do not resolve
+ * to a value throw an Error.
+ *
+ * @param document The JSON value to search.
+ * @param pointer The JSON Pointer string.
+ * @returns The value identified by the pointer.
+ * @throws {Error} If the pointer syntax is invalid or the value does not exist.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  if (typeof pointer !== "string") {
+    throw new Error("JSON Pointer must be a string");
+  }
+
+  if (pointer !== "" && !pointer.startsWith("/")) {
+    throw new Error("Invalid JSON Pointer: it must be empty or start with '/'");
+  }
+
+  const tokens = pointer === "" ? [] : pointer.slice(1).split("/");
+  let current: unknown = document;
+
+  for (const encodedToken of tokens) {
+    if (/~(?![01])/.test(encodedToken)) {
+      throw new Error(`Invalid JSON Pointer escape in token '${encodedToken}'`);
+    }
+
+    const token = encodedToken.replace(/~1/g, "/").replace(/~0/g, "~");
+
+    if (Array.isArray(current)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`Invalid array index '${token}' in JSON Pointer`);
+      }
+
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= current.length) {
+        throw new Error(`JSON Pointer array index '${token}' does not exist`);
+      }
+
+      current = current[index];
+    } else if (current !== null && typeof current === "object") {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(`JSON Pointer object member '${token}' does not exist`);
+      }
+
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer token '${token}' cannot be resolved`);
+    }
+
+    if (current === undefined) {
+      throw new Error(`JSON Pointer token '${token}' does not resolve to a value`);
+    }
+  }
+
+  return current as JsonValue;
+}
