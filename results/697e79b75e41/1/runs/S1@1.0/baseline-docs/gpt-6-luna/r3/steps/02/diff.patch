+
+function decodePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") throw new Error("JSON Patch path must be a string");
+  if (pointer !== "" && !pointer.startsWith("/")) {
+    throw new Error("Invalid JSON Pointer: it must be empty or start with '/'");
+  }
+  const parts = pointer === "" ? [] : pointer.slice(1).split("/");
+  return parts.map((part) => {
+    if (/~(?![01])/.test(part)) throw new Error(`Invalid JSON Pointer escape in token '${part}'`);
+    return part.replace(/~1/g, "/").replace(/~0/g, "~");
+  });
+}
+
+function cloneJson(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) return value.map(cloneJson);
+  if (value !== null && typeof value === "object") {
+    const result: { [key: string]: JsonValue } = {};
+    for (const key of Object.keys(value)) {
+      Object.defineProperty(result, key, { value: cloneJson(value[key]), enumerable: true, writable: true, configurable: true });
+    }
+    return result;
+  }
+  return value;
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) throw new Error(`Invalid array index '${token}'`);
+  const index = Number(token);
+  if (!Number.isSafeInteger(index) || index > length || (!allowEnd && index === length)) {
+    throw new Error(`Array index '${token}' is out of bounds`);
+  }
+  return index;
+}
+
+function getAt(root: JsonValue, tokens: string[]): JsonValue {
+  let current: JsonValue = root;
+  for (const token of tokens) {
+    if (Array.isArray(current)) current = current[arrayIndex(token, current.length, false)];
+    else if (current !== null && typeof current === "object" && Object.prototype.hasOwnProperty.call(current, token)) current = current[token];
+    else throw new Error(`JSON Patch path does not exist at '${token}'`);
+  }
+  return current;
+}
+
+function writeAt(root: JsonValue, tokens: string[], mode: "add" | "replace" | "remove", value?: JsonValue): JsonValue {
+  if (tokens.length === 0) {
+    if (mode === "remove") throw new Error("Removing the document root does not produce a JSON document");
+    return value as JsonValue;
+  }
+  const parent = getAt(root, tokens.slice(0, -1));
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (mode === "add" && key === "-") { parent.push(value as JsonValue); return root; }
+    const index = arrayIndex(key, parent.length, mode === "add");
+    if (mode === "add") parent.splice(index, 0, value as JsonValue);
+    else if (mode === "remove") parent.splice(index, 1);
+    else {
+      if (index >= parent.length) throw new Error(`Array index '${key}' does not exist`);
+      parent[index] = value as JsonValue;
+    }
+  } else if (parent !== null && typeof parent === "object") {
+    const exists = Object.prototype.hasOwnProperty.call(parent, key);
+    if (mode !== "add" && !exists) throw new Error(`JSON Patch path does not exist: '${key}'`);
+    if (mode === "remove") delete parent[key];
+    else Object.defineProperty(parent, key, { value: value as JsonValue, enumerable: true, writable: true, configurable: true });
+  } else throw new Error("JSON Patch parent path is not a container");
+  return root;
+}
+
+function jsonEqual(a: JsonValue, b: JsonValue): boolean {
+  if (a === b) return true;
+  if (a === null || b === null || typeof a !== "object" || typeof b !== "object") return false;
+  if (Array.isArray(a) !== Array.isArray(b)) return false;
+  if (Array.isArray(a) && Array.isArray(b)) return a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]));
+  const ak = Object.keys(a), bk = Object.keys(b);
+  return ak.length === bk.length && ak.every((key) => Object.prototype.hasOwnProperty.call(b, key) && jsonEqual((a as Record<string, JsonValue>)[key], (b as Record<string, JsonValue>)[key]));
+}
+
+/**
+ * Applies an RFC 6902 JSON Patch to a JSON document without mutating the input.
+ *
+ * @param document The JSON document to update.
+ * @param patch The ordered JSON Patch operations to apply.
+ * @returns A new JSON document containing the patch result.
+ * @throws {Error} If an operation is invalid or cannot be applied.
+ */
+export function applyPatch(document: JsonValue, patch: readonly unknown[]): JsonValue {
+  if (!Array.isArray(patch)) throw new Error("JSON Patch must be an array");
+  let result = cloneJson(document);
+  for (const raw of patch) {
+    if (raw === null || typeof raw !== "object" || Array.isArray(raw)) throw new Error("JSON Patch operation must be an object");
+    const operation = raw as Record<string, unknown>;
+    const op = operation.op;
+    const path = decodePointer(operation.path);
+    const requireValue = (): JsonValue => {
+      if (!Object.prototype.hasOwnProperty.call(operation, "value")) throw new Error(`JSON Patch '${String(op)}' operation requires value`);
+      return operation.value as JsonValue;
+    };
+    if (op === "add") result = writeAt(result, path, "add", requireValue());
+    else if (op === "remove") result = writeAt(result, path, "remove");
+    else if (op === "replace") { const value = requireValue(); getAt(result, path); result = writeAt(result, path, "replace", value); }
+    else if (op === "test") { if (!jsonEqual(getAt(result, path), requireValue())) throw new Error("JSON Patch test operation failed"); }
+    else if (op === "copy" || op === "move") {
+      const from = decodePointer(operation.from);
+      const copied = cloneJson(getAt(result, from));
+      if (op === "move") {
+        if (from.length < path.length && from.every((token, i) => token === path[i])) throw new Error("Cannot move a value into one of its children");
+        if (from.length === path.length && from.every((token, i) => token === path[i])) continue;
+        result = writeAt(result, from, "remove");
+      }
+      result = writeAt(result, path, "add", copied);
+    } else throw new Error(`Unsupported JSON Patch operation '${String(op)}'`);
+  }
+  return result;
+}
