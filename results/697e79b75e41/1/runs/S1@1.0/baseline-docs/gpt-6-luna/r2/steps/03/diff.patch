+
+test("validates move sources even when source and destination are identical", () => {
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/missing", path: "/missing" }]), Error);
+});
+
+test("a failing later operation leaves the caller's document unchanged", () => {
+  const document = { items: ["a", "b"] };
+  assert.throws(() => applyPatch(document, [
+    { op: "remove", path: "/items/0" },
+    { op: "remove", path: "/absent" },
