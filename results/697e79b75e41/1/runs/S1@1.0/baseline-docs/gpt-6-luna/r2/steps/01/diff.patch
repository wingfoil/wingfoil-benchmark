+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * The empty pointer refers to the document itself. Object tokens select own
+ * properties, and array tokens select canonical non-negative indices.
+ * Throws when the pointer is malformed or does not resolve within the document.
+ *
+ * @param document The JSON value to search.
+ * @param pointer An RFC 6901 JSON Pointer string.
+ * @returns The value identified by the pointer.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("JSON Pointer must be a string");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error("JSON Pointer must be empty or begin with '/'");
+  }
+
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+  let value = document;
+
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`Invalid array index in JSON Pointer: ${token}`);
+      }
+
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= value.length) {
+        throw new Error(`JSON Pointer array index does not exist: ${token}`);
+      }
+
+      value = value[index];
+      continue;
+    }
+
+    if (value !== null && typeof value === "object" && Object.hasOwn(value, token)) {
+      value = (value as Record<string, unknown>)[token];
+      continue;
+    }
+
+    throw new Error(`JSON Pointer token does not resolve: ${token}`);
+  }
+
+  return value;
+}
+
+function decodeToken(token: string): string {
+  if (/~(?:[^01]|$)/.test(token)) {
+    throw new Error(`Invalid escape sequence in JSON Pointer token: ${token}`);
+  }
+
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
diff --git a/test/pointer.test.js b/test/pointer.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..0429673253260758936711ebcf4249207ba5ef98
--- /dev/null
+++ b/test/pointer.test.js
@@ -0,0 +1,35 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+test("resolves the root and RFC 6901 object and array references", () => {
+  const document = {
+    "": 0,
+    "a/b": { "~key": ["zero", { value: true }] },
+    array: ["first", "second"],
+  };
+
+  assert.equal(resolvePointer(document, ""), document);
+  assert.equal(resolvePointer(document, "/"), 0);
+  assert.equal(resolvePointer(document, "/a~1b/~0key/1/value"), true);
+  assert.equal(resolvePointer(document, "/array/1"), "second");
+});
+
+test("preserves null values and property names inherited by ordinary objects", () => {
+  const document = JSON.parse('{"nullable":null,"constructor":"own"}');
+
+  assert.equal(resolvePointer(document, "/nullable"), null);
+  assert.equal(resolvePointer(document, "/constructor"), "own");
+});
+
+test("rejects malformed pointers and references that do not resolve", () => {
+  const document = { array: ["value"], object: {} };
+
+  for (const pointer of ["relative", "/bad~", "/bad~2escape"]) {
+    assert.throws(() => resolvePointer(document, pointer), Error);
+  }
+
+  for (const pointer of ["/missing", "/array/1", "/array/01", "/array/-", "/object/missing"]) {
+    assert.throws(() => resolvePointer(document, pointer), Error);
+  }
+});
