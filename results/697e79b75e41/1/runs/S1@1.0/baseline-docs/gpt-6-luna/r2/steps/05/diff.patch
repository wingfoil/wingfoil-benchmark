+import { applyPatch, createPatch } from "../src/index.ts";
+
+test("creates a focused patch for object changes and applies it", () => {
+  const from = { profile: { name: "Ada", active: true }, tags: ["math", "code"] };
+  const to = { profile: { name: "Grace", active: true }, tags: ["math", "code"], extra: 1 };
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [
+    { op: "replace", path: "/profile/name", value: "Grace" },
+    { op: "add", path: "/extra", value: 1 },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, { profile: { name: "Ada", active: true }, tags: ["math", "code"] });
+  assert.deepEqual(to, { profile: { name: "Grace", active: true }, tags: ["math", "code"], extra: 1 });
+});
+
+test("creates focused array edits, including middle insertion and removal", () => {
+  const from = { values: ["a", "b", "c"] };
+  const to = { values: ["a", "x", "b"] };
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [
+    { op: "add", path: "/values/1", value: "x" },
+    { op: "remove", path: "/values/3" },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("uses a root operation when the document itself changes type", () => {
