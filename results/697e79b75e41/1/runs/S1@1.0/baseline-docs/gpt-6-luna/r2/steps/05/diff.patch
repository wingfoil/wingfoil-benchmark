 ```
 
+`createPatch(from, to)` produces an RFC 6902 patch containing operations for the changed values,
+including nested object members and array insertions or removals. It does not mutate either input.
+
+```ts
+import { createPatch } from "json-toolkit";
+
+createPatch({ user: { name: "Ada" } }, { user: { name: "Grace" } });
+// [{ op: "replace", path: "/user/name", value: "Grace" }]
+```
+
 ## JSON Merge Patch
 
 `applyMergePatch(target, patch)` applies an RFC 7386 JSON Merge Patch and returns a new value.
diff --git a/src/index.ts b/src/index.ts
index cc36781ee4c641d66c848a6261bc7eaa29b54cd6..e0a64c7ddf5da79435a7419edf92ccca0f25ea86 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -64,6 +64,79 @@ type JsonPatchOperation =
   | { op: "remove"; path: string }
   | { op: "move" | "copy"; from: string; path: string };
 
+/**
+ * Creates a focused RFC 6902 JSON Patch that transforms one JSON value into another.
+ * Inputs are only read; values included in the patch are copied so later mutation
+ * of either input does not change the returned patch.
+ *
+ * @param from The original JSON value.
+ * @param to The desired JSON value.
+ * @returns An ordered array of JSON Patch operations.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const operations: JsonPatchOperation[] = [];
+  diffJson(from, to, "", operations);
+  return operations;
+}
+
+function diffJson(from: unknown, to: unknown, path: string, operations: JsonPatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+
+  if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) operations.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const childPath = `${path}/${encodeToken(key)}`;
+      if (Object.hasOwn(from, key)) diffJson(from[key], to[key], childPath, operations);
+      else operations.push({ op: "add", path: childPath, value: cloneJson(to[key]) });
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    if (from.length === to.length && from.filter((value, index) => !jsonEqual(value, to[index])).length <= 1) {
+      for (let index = 0; index < from.length; index++) diffJson(from[index], to[index], `${path}/${index}`, operations);
+      return;
+    }
+    diffArray(from, to, path, operations);
+    return;
+  }
+
+  operations.push({ op: "replace", path, value: cloneJson(to) });
+}
+
+function diffArray(from: unknown[], to: unknown[], path: string, operations: JsonPatchOperation[]): void {
+  const rows = from.length + 1;
+  const columns = to.length + 1;
+  const lengths = Array.from({ length: rows }, () => Array<number>(columns).fill(0));
+  for (let i = from.length - 1; i >= 0; i--) {
+    for (let j = to.length - 1; j >= 0; j--) {
+      lengths[i][j] = jsonEqual(from[i], to[j])
+        ? 1 + lengths[i + 1][j + 1]
+        : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+
+  let i = 0;
+  let j = 0;
+  let index = 0;
+  while (i < from.length || j < to.length) {
+    if (i < from.length && j < to.length && jsonEqual(from[i], to[j])) {
+      i++;
+      j++;
+      index++;
+    } else if (i < from.length && (j === to.length || lengths[i + 1][j] >= lengths[i][j + 1])) {
+      operations.push({ op: "remove", path: `${path}/${index}` });
+      i++;
+    } else {
+      operations.push({ op: "add", path: `${path}/${index}`, value: cloneJson(to[j]) });
+      j++;
+      index++;
+    }
+  }
+}
