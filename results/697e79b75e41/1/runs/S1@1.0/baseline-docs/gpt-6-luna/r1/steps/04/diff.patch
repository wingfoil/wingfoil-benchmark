+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document without changing the input.
+ * Object members are recursively merged, `null` members are removed, and any
+ * non-object patch replaces the target value. The returned document is independent.
+ *
+ * @param target The JSON document to update.
+ * @param patch The JSON Merge Patch value.
+ * @returns The merged document.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return cloneJson(patch);
+
+  const result: Record<string, unknown> = isObject(target) ? cloneJson(target) as Record<string, unknown> : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      Object.defineProperty(result, key, {
+        value: applyMergePatch(result[key], value),
+        enumerable: true,
+        writable: true,
+        configurable: true,
+      });
+    }
+  }
+  return result;
+}
