+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to` without
+ * changing either input. Object members and same-length array elements are
+ * compared recursively so unchanged values are not sent again.
+ *
+ * @param from The original JSON document.
+ * @param to The desired JSON document.
+ * @returns A JSON Patch operation array.
+ */
+export function createPatch(from: unknown, to: unknown): Array<Record<string, unknown>> {
+  const operations: Array<Record<string, unknown>> = [];
+  diffJson(from, to, [], operations);
+  return operations;
+}
+
+function diffJson(from: unknown, to: unknown, path: string[], operations: Array<Record<string, unknown>>): void {
+  if (jsonEqual(from, to)) return;
+
+  if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) {
+        operations.push({ op: "remove", path: pointer(path.concat(key)) });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      if (!Object.hasOwn(from, key)) {
+        operations.push({ op: "add", path: pointer(path.concat(key)), value: cloneJson(to[key]) });
+      } else {
+        diffJson(from[key], to[key], path.concat(key), operations);
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    const shared = Math.min(from.length, to.length);
+    for (let i = 0; i < shared; i++) diffJson(from[i], to[i], path.concat(String(i)), operations);
+    for (let i = from.length - 1; i >= to.length; i--) {
+      operations.push({ op: "remove", path: pointer(path.concat(String(i))) });
+    }
+    for (let i = shared; i < to.length; i++) {
+      operations.push({ op: "add", path: pointer(path.concat("-")), value: cloneJson(to[i]) });
+    }
+    return;
+  }
+
+  if (path.length === 0) {
+    operations.push({ op: "replace", path: "", value: cloneJson(to) });
+  } else {
+    operations.push({ op: "replace", path: pointer(path), value: cloneJson(to) });
+  }
+}
+
+function pointer(tokens: string[]): string {
+  return tokens.map((token) => `/${encodeToken(token)}`).join("");
+}
