@@ -0,0 +1,54 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * The empty pointer refers to the document itself. Non-empty pointers must
+ * begin with `/`; tokens decode `~1` to `/` and `~0` to `~`. Throws when the
+ * pointer is malformed or a token does not identify a value in the document.
+ *
+ * @param document The JSON document to search.
+ * @param pointer An RFC 6901 JSON Pointer string.
+ * @returns The value selected by the pointer.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("JSON Pointer must be a string");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error("A non-empty JSON Pointer must begin with '/'");
+  }
+
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+  let value: unknown = document;
+
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`Invalid array index in JSON Pointer: ${token}`);
+      }
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= value.length) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+      value = value[index];
+    } else if (value !== null && typeof value === "object") {
+      if (!Object.hasOwn(value, token)) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+      value = (value as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+  }
+
+  return value;
+}
+
+function decodeToken(token: string): string {
+  if (/~(?:[^01]|$)/.test(token)) {
+    throw new Error(`Invalid escape sequence in JSON Pointer token: ${token}`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
