+  let result = cloneJson(document);
+  for (const operation of patch) {
+    if (!isObject(operation) || typeof operation.op !== "string" || typeof operation.path !== "string") {
+      throw new Error("Invalid JSON Patch operation");
+    }
+    const tokens = parsePointer(operation.path);
+    switch (operation.op) {
+      case "add":
+        requireField(operation, "value");
+        result = addAt(result, tokens, cloneJson(operation.value));
+        break;
+      case "remove":
+        result = removeAt(result, tokens).document;
+        break;
+      case "replace":
+        requireField(operation, "value");
+        result = replaceAt(result, tokens, cloneJson(operation.value));
+        break;
+      case "move": {
