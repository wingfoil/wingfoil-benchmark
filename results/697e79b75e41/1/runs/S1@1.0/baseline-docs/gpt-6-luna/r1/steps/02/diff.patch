+ * Operations run in order; the function throws if an operation is malformed or
+ * cannot be applied. The returned document is an independent value.
+ *
+ * @param document The JSON document to patch.
+ * @param patch An array of RFC 6902 operations.
+ * @returns The patched document.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error("JSON Patch must be an array");
+  }
