 export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 
+/** A rejected line from a task import.
+ * @property line - the one-based line number in the supplied text
+ * @property reason - why the line could not be added
+ */
+export interface ImportRejection {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of importing task lines into a list.
+ * @property imported - the number of tasks added
+ * @property rejected - lines that could not be added
+ */
+export interface ImportTasksResult {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
+/**
+ * Imports semicolon-separated task lines into a list, skipping blank lines and continuing after errors.
+ * Each nonblank line has the form `title;priority;tags`, with tags separated by spaces and an empty
+ * priority meaning normal.
+ * @param list - the task list to add tasks to
+ * @param text - task data with one task per line
+ * @returns counts of added tasks and reasons for rejected lines
+ */
+export function importTasks(list: TaskList, text: string): ImportTasksResult {
+  let imported = 0;
+  const rejected: ImportRejection[] = [];
+
+  text.split(/\r?\n/).forEach((rawLine, index) => {
+    if (rawLine.trim().length === 0) return;
+    const fields = rawLine.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'line must contain title, priority and tags separated by semicolons' });
+      return;
+    }
+
+    const [title, rawPriority, rawTags] = fields;
+    const priority = rawPriority === '' ? undefined : rawPriority;
+    const result = list.add({
+      title,
+      ...(priority === undefined ? {} : { priority: priority as 'low' | 'normal' | 'high' }),
+      tags: rawTags.trim() === '' ? [] : rawTags.trim().split(/\s+/),
+    });
+    if (result.ok) imported++;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  });
+
+  return { imported, rejected };
+}
+
