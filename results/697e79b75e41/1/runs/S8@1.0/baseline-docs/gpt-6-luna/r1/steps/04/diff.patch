@@ -8,6 +8,18 @@ export type { Summary } from './domain/summary.ts';
 export { PRIORITIES } from './domain/task.ts';
 export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 
+/** A row that could not be imported, with its one-based source line and reason. */
+export interface RejectedTaskImport {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of importing task rows into a list. */
+export interface TaskImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedTaskImport[];
+}
+
 /**
  * A new, empty task list for the app, kept in memory.
  * @param now - optionally supplies ISO-8601 date-time strings for task creation and changes
@@ -15,3 +27,40 @@ export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 export function createTodoList(now: () => string = () => new Date().toISOString()): TaskList {
   return createTaskList(now);
 }
+
+/**
+ * Import semicolon-separated task rows, skipping blank lines and collecting rows that fail validation.
+ * @param list - the task list to add tasks to
+ * @param text - rows in `title;priority;tags` format, with tags separated by spaces
+ */
+export function importTasks(list: TaskList, text: string): TaskImportResult {
+  let imported = 0;
+  const rejected: RejectedTaskImport[] = [];
+
+  text.split(/\r?\n/).forEach((row, index) => {
+    if (row.trim().length === 0) return;
+    const fields = row.split(';');
+    if (fields.length !== 3) {
+      rejected.push({
+        line: index + 1,
+        reason: 'line must contain title, priority and tags separated by semicolons',
+      });
+      return;
+    }
+
+    const [title, rawPriority, rawTags] = fields;
+    const priority = rawPriority.trim();
+    const result = list.add({
+      title,
+      ...(priority === '' ? {} : { priority: priority as Priority }),
+      tags: rawTags.trim() === '' ? [] : rawTags.trim().split(/\s+/),
+    });
+    if (result.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line: index + 1, reason: result.error.message });
+    }
+  });
+
+  return { imported, rejected };
+}
