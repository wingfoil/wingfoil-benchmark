     },
   };
 }
+
+function validateTitle(title: string): ReturnType<typeof err> | undefined {
+  const trimmed = title.trim();
+  if (trimmed.length === 0) return err('invalid-input', 'title must not be empty or only spaces');
+  if (trimmed.length > 120) return err('invalid-input', 'title must be 120 characters or fewer');
+  return undefined;
+}
+
+function validateTag(tag: string): ReturnType<typeof err> | undefined {
+  if (tag.length === 0) return err('invalid-input', 'tag must not be empty');
+  if (/\s/.test(tag)) return err('invalid-input', 'tag must not contain spaces');
+  return undefined;
+}
