@@ -21,3 +21,8 @@ The list rejects invalid task input with an `invalid-input` result and a message
 Titles must contain non-space characters and be at most 120 characters long. Priorities must be `low`,
 `normal` or `high`. Tags must be non-empty and contain no whitespace. These rules apply to task creation,
 renaming and adding tags; rejected input leaves the list unchanged.
+
+`importTasks(list, text)` adds tasks from a spreadsheet-friendly text format with one row per line:
+`title;priority;tags`. Leave priority empty for `normal`, and separate tags with spaces. Blank lines are
+skipped. The result reports the number imported and each rejected row's one-based line number and reason;
+rows are added independently, so a rejected row does not prevent later rows from being imported.
diff --git a/src/index.ts b/src/index.ts
index 03aaff9a123a0f30bba65259f9214771473133a1..6f09a51428b62ff20e6ad4f3168b62f7e041746f 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -1,5 +1,7 @@
 import { createTaskList } from './domain/list.ts';
 import type { TaskList } from './domain/list.ts';
+import { PRIORITIES } from './domain/task.ts';
+import type { Priority } from './domain/task.ts';
 
 export type { TaskFilter, TaskList } from './domain/list.ts';
 export type { Result, TodoError, TodoErrorCode } from './domain/result.ts';
@@ -16,3 +18,54 @@ export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 export function createTodoList(now: () => string = () => new Date().toISOString()): TaskList {
   return createTaskList(now);
 }
+
+/** A line that could not be imported, with its one-based line number and reason. */
+export interface ImportRejection {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of importing task lines into a list. */
+export interface ImportTasksResult {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
+/**
+ * Adds tasks from semicolon-separated lines in `title;priority;tags` format.
+ * Blank lines are skipped; an empty priority means `normal`, and tags are separated by whitespace.
+ *
+ * @param list - the task list to add tasks to
+ * @param text - task rows, one per line
+ */
+export function importTasks(list: TaskList, text: string): ImportTasksResult {
+  let imported = 0;
+  const rejected: ImportRejection[] = [];
+
+  for (const [index, rawLine] of text.split(/\r?\n/).entries()) {
+    if (rawLine.trim() === '') continue;
+
+    const fields = rawLine.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'line must have title, priority and tags separated by semicolons' });
+      continue;
+    }
+
+    const [title, rawPriority, rawTags] = fields;
+    const priorityText = rawPriority.trim();
+    if (priorityText !== '' && !PRIORITIES.includes(priorityText as Priority)) {
+      rejected.push({ line: index + 1, reason: 'priority must be low, normal or high' });
+      continue;
+    }
+
+    const result = list.add({
+      title,
+      ...(priorityText === '' ? {} : { priority: priorityText as Priority }),
+      tags: rawTags.trim() === '' ? [] : rawTags.trim().split(/\s+/),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  }
+
+  return { imported, rejected };
+}
