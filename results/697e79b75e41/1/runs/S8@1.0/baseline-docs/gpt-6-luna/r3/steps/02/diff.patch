 describe('task list', () => {
+  it('records creation and last-change times for tasks', () => {
+    const times = ['2026-01-01T00:00:00.000Z', '2026-01-02T00:00:00.000Z', '2026-01-03T00:00:00.000Z'];
+    const list = createTodoList(() => times.shift()!);
+    const task = valueOf(list.add({ title: 'Track me' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+    const updated = valueOf(list.complete(task.id));
+    assert.equal(updated.createdAt, task.createdAt);
+    assert.equal(updated.updatedAt, '2026-01-02T00:00:00.000Z');
+    const renamed = valueOf(list.rename(task.id, 'Renamed'));
+    assert.equal(renamed.updatedAt, '2026-01-03T00:00:00.000Z');
+  });
+
   it('adds an open task with a normal priority by default', () => {
     const list = createTodoList();
     const task = valueOf(list.add({ title: '  Buy milk ' }));
-    assert.deepEqual(task, { id: '1', title: 'Buy milk', priority: 'normal', tags: [], status: 'open' });
+    assert.equal(task.id, '1');
+    assert.equal(task.title, 'Buy milk');
+    assert.equal(task.priority, 'normal');
+    assert.deepEqual(task.tags, []);
+    assert.equal(task.status, 'open');
+    assert.equal(task.createdAt, task.updatedAt);
     assert.equal(list.openCount(), 1);
   });
 
