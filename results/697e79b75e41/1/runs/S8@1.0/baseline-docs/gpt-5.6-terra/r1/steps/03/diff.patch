 import { err, ok } from './result.ts';
 import type { Result } from './result.ts';
-import { addTag, compareTasks, completeTask, createTask, removeTag, renameTask, reopenTask } from './task.ts';
+import { addTag, compareTasks, completeTask, createTask, PRIORITIES, removeTag, renameTask, reopenTask } from './task.ts';
 import type { NewTask, Priority, Status, Task } from './task.ts';
 
+const MAX_TITLE_LENGTH = 120;
+
+function validateTitle(title: string): Result<void> {
+  const trimmedTitle = title.trim();
+  if (trimmedTitle.length === 0) return err('invalid-input', 'title must not be empty or only spaces');
+  if (trimmedTitle.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `title must be ${MAX_TITLE_LENGTH} characters or fewer`);
+  }
+  return ok(undefined);
+}
+
+function validatePriority(priority: Priority | undefined): Result<void> {
+  if (priority !== undefined && !PRIORITIES.includes(priority)) {
+    return err('invalid-input', 'priority must be low, normal, or high');
+  }
+  return ok(undefined);
+}
+
+function validateTag(tag: string): Result<void> {
+  if (tag.length === 0) return err('invalid-input', 'tag must not be empty');
+  if (/\s/u.test(tag)) return err('invalid-input', 'tag must not contain spaces');
+  return ok(undefined);
+}
+
+function validateNewTask(input: NewTask): Result<void> {
+  const title = validateTitle(input.title);
+  if (!title.ok) return title;
+  const priority = validatePriority(input.priority);
+  if (!priority.ok) return priority;
+  for (const tag of input.tags ?? []) {
+    const validTag = validateTag(tag);
+    if (!validTag.ok) return validTag;
+  }
+  return ok(undefined);
+}
+
 /** Which tasks to show: by status, priority or tag; every task when nothing is given. */
 export interface TaskFilter {
   readonly status?: Status;
