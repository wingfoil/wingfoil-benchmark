 }
 
+/** A source row that could not be imported. */
+export interface RejectedTaskImport {
+  /** The one-based line number in the supplied text. */
+  readonly line: number;
+  /** Why this row could not be added. */
+  readonly reason: string;
+}
+
+/** The outcome of importing tasks from spreadsheet text. */
+export interface TaskImportResult {
+  /** How many tasks were added. */
+  readonly imported: number;
+  /** Every non-blank row that could not be added. */
+  readonly rejected: readonly RejectedTaskImport[];
+}
+
 /**
  * A new, empty task list for the app, kept in memory.
  *
@@ -22,3 +39,47 @@ export interface TodoListOptions {
 export function createTodoList(options: TodoListOptions = {}): TaskList {
   return createTaskList(options.now ?? (() => new Date().toISOString()));
 }
+
+/**
+ * Adds tasks described as `title;priority;tags` rows to a list.
+ *
+ * @param list - the list that receives valid tasks
+ * @param text - spreadsheet text, with tags separated by whitespace and an empty priority meaning `normal`
+ */
+export function importTasks(list: TaskList, text: string): TaskImportResult {
+  const rejected: RejectedTaskImport[] = [];
+  let imported = 0;
+
+  for (const [index, row] of text.split(/\r\n?|\n/u).entries()) {
+    if (row.trim().length === 0) continue;
+
+    const parsed = parseImportRow(row);
+    if (parsed === undefined) {
+      rejected.push({ line: index + 1, reason: 'expected title;priority;tags' });
+      continue;
+    }
+
+    const added = list.add(parsed);
+    if (added.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line: index + 1, reason: added.error.message });
+    }
+  }
+
+  return { imported, rejected };
+}
+
+function parseImportRow(row: string): NewTask | undefined {
+  const fields = row.split(';');
+  if (fields.length !== 3) return undefined;
+
+  const [title, priorityText, tagsText] = fields;
+  const priority = priorityText.trim();
+  const tags = tagsText.trim();
+  return {
+    title,
+    priority: priority === '' ? undefined : (priority as Priority),
+    tags: tags === '' ? [] : tags.split(/\s+/u),
+  };
+}
