diff --git a/src/index.ts b/src/index.ts
index f87d90f5bd0b29efa1af37bc773a937aec17b405..63c052f0c48e8c44720998db35b1df861ff1f930 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -8,9 +8,57 @@ export type { Summary } from './domain/summary.ts';
 export { PRIORITIES } from './domain/task.ts';
 export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 
+/** A rejected line from a bulk task import. */
+export interface ImportRejection {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of importing a block of task lines. */
+export interface ImportTasksResult {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
 /**
  * A new, empty task list for the app, kept in memory.
  */
 export function createTodoList(): TaskList {
   return createTaskList(() => new Date().toISOString());
 }
+
+/**
+ * Add valid tasks from `title;priority;tags` lines to a task list.
+ * Blank lines are skipped; an empty priority uses the list's normal priority. Rejected line numbers
+ * refer to their positions in the original text, starting at 1.
+ *
+ * @param list - the task list to add tasks to
+ * @param text - task rows with tags separated by spaces
+ */
+export function importTasks(list: TaskList, text: string): ImportTasksResult {
+  let imported = 0;
+  const rejected: ImportRejection[] = [];
+
+  text.split(/\r?\n/).forEach((rawLine, index) => {
+    if (rawLine.trim() === '') return;
+
+    const fields = rawLine.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'line must contain title, priority and tags separated by semicolons' });
+      return;
+    }
+
+    const [title, rawPriority, rawTags] = fields;
+    const priority = rawPriority.trim();
+    const tagsText = rawTags.trim();
+    const result = list.add({
+      title: title.trim(),
+      ...(priority === '' ? {} : { priority: priority as 'low' | 'normal' | 'high' }),
+      tags: tagsText === '' ? [] : tagsText.split(/\s+/),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  });
+
+  return { imported, rejected };
+}
