@@ -0,0 +1,54 @@
+import type { TaskList } from './domain/list.ts';
+import type { Priority } from './domain/task.ts';
+
+/** A line that could not be imported, with its one-based position and reason. */
+export interface ImportRejection {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** Counts successful task imports and describes every rejected non-blank line. */
+export interface ImportTasksResult {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
+/**
+ * Import tasks from semicolon-separated lines in `title;priority;tags` format.
+ * Priority may be empty (the list's default is used); tags are separated by whitespace.
+ * Empty lines are ignored. Invalid lines are reported while subsequent lines are still processed.
+ *
+ * @param list - task list that receives valid tasks
+ * @param text - one task per line in the import format
+ * @returns the number of tasks added and the rejected lines with reasons
+ */
+export function importTasks(list: TaskList, text: string): ImportTasksResult {
+  let imported = 0;
+  const rejected: ImportRejection[] = [];
+
+  text.split(/\r?\n/).forEach((rawLine, index) => {
+    if (rawLine.trim().length === 0) return;
+    const fields = rawLine.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'line must contain title, priority and tags separated by semicolons' });
+      return;
+    }
+
+    const [title, priorityText, tagsText] = fields;
+    const priority = priorityText.trim();
+    if (priority !== '' && priority !== 'low' && priority !== 'normal' && priority !== 'high') {
+      rejected.push({ line: index + 1, reason: 'priority must be low, normal or high' });
+      return;
+    }
+
+    const result = list.add({
+      title: title.trim(),
+      ...(priority === '' ? {} : { priority: priority as Priority }),
+      tags: tagsText.trim() === '' ? [] : tagsText.trim().split(/\s+/),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  });
+
+  return { imported, rejected };
+}
