 }
+
+/**
+ * Adds tasks from semicolon-delimited lines, reporting failures without stopping the import.
+ * Each nonblank line must be `title;priority;tags`; an empty priority means `normal`, and tags are
+ * separated by whitespace. List validation and duplicate-title rules apply to every line.
+ *
+ * @param list - the task list receiving imported tasks
+ * @param text - source text containing one task per line
+ */
+export function importTasks(list: TaskList, text: string): ImportTasksResult {
+  let imported = 0;
+  const rejected: ImportRejection[] = [];
+
+  text.split(/\r?\n/).forEach((rawLine, index) => {
+    if (rawLine.trim().length === 0) return;
+
+    const line = index + 1;
+    const fields = rawLine.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line, reason: 'line must contain title, priority and tags separated by semicolons' });
+      return;
+    }
+
+    const [title, rawPriority, rawTags] = fields;
+    const priority = rawPriority.trim();
+    const result = list.add({
+      title,
+      ...(priority.length === 0 ? {} : { priority: priority as Priority }),
+      tags: rawTags.trim().length === 0 ? [] : rawTags.trim().split(/\s+/),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line, reason: result.error.message });
+  });
+
+  return { imported, rejected };
+}
