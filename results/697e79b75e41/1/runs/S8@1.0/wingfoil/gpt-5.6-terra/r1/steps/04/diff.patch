+/** A source line that could not be added during a bulk import. */
+export interface RejectedTaskImport {
+  /** The one-based line number in the supplied import text. */
+  readonly line: number;
+  /** Why the line could not be imported. */
+  readonly reason: string;
+}
+
+/** The outcome of a bulk task import. */
+export interface TaskImportResult {
+  /** The number of tasks successfully added to the list. */
+  readonly imported: number;
+  /** Each non-blank line that could not be added. */
+  readonly rejected: readonly RejectedTaskImport[];
+}
+
 /**
  * A new, empty task list for the app, kept in memory.
  *
@@ -16,3 +34,45 @@ export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 export function createTodoList(now: () => string = () => new Date().toISOString()): TaskList {
   return createTaskList(now);
 }
+
+/**
+ * Adds tasks from semicolon-delimited text, retaining per-line failures while importing valid rows.
+ *
+ * @param list - the task list to receive valid tasks
+ * @param text - one `title;priority;tags` task row per line
+ */
+export function importTasks(list: TaskList, text: string): TaskImportResult {
+  const rejected: RejectedTaskImport[] = [];
+  let imported = 0;
+
+  for (const [index, line] of text.split(/\r?\n/).entries()) {
+    if (line.trim().length === 0) continue;
+
+    const fields = line.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'expected title;priority;tags' });
+      continue;
+    }
+
+    const [title, priorityText, tagsText] = fields;
+    const priority = priorityText.trim();
+    if (priority.length > 0 && !isPriority(priority)) {
+      rejected.push({ line: index + 1, reason: 'priority must be low, normal, or high' });
+      continue;
+    }
+
+    const result = list.add({
+      title,
+      priority: priority || undefined,
+      tags: tagsText.trim().length === 0 ? [] : tagsText.trim().split(/\s+/),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  }
+
+  return { imported, rejected };
+}
+
+function isPriority(value: string): value is Priority {
+  return PRIORITIES.includes(value as Priority);
+}
