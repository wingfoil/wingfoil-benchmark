+
+function validateTitle(title: string): Result<never> | undefined {
+  if (title.trim().length === 0) return err('invalid-input', 'title must not be empty or only spaces');
+  if (title.length > 120) return err('invalid-input', 'title must be 120 characters or fewer');
+  return undefined;
+}
+
+function validatePriority(priority: unknown): Result<never> | undefined {
+  if (priority !== undefined && !PRIORITIES.includes(priority as Priority)) {
+    return err('invalid-input', 'priority must be low, normal or high');
+  }
+  return undefined;
+}
+
+function validateTag(tag: string): Result<never> | undefined {
+  if (tag.length === 0) return err('invalid-input', 'tag must not be empty');
+  if (/\s/.test(tag)) return err('invalid-input', 'tag must not contain spaces');
+  return undefined;
+}
