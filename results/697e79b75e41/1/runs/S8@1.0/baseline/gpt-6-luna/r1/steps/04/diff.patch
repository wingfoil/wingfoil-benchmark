 export function createTodoList(): TaskList {
   return createTaskList();
 }
+
+/** A line that could not be imported, with its one-based source line number. */
+export interface RejectedTaskLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of importing tasks from a semicolon-separated text block. */
+export interface ImportTasksResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedTaskLine[];
+}
+
+/**
+ * Add tasks from lines in `title;priority;tags` format. Empty priorities default to `normal`.
+ * Blank lines are ignored, and each rejection includes the original one-based line number.
+ *
+ * @param list - the task list to add tasks to
+ * @param text - newline-separated task records
+ */
+export function importTasks(list: TaskList, text: string): ImportTasksResult {
+  let imported = 0;
+  const rejected: RejectedTaskLine[] = [];
+
+  for (const [index, sourceLine] of text.split(/\r?\n/).entries()) {
+    if (sourceLine.trim().length === 0) continue;
+
+    const fields = sourceLine.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'line must contain title, priority and tags separated by semicolons' });
+      continue;
+    }
+
+    const [title, priorityText, tagsText] = fields;
+    const priority = priorityText.trim() || 'normal';
+    if (!PRIORITIES.includes(priority as Priority)) {
+      rejected.push({ line: index + 1, reason: 'priority must be low, normal or high' });
+      continue;
+    }
+
+    const result = list.add({
+      title,
+      priority: priority as Priority,
+      tags: tagsText.trim() === '' ? [] : tagsText.trim().split(/\s+/),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  }
+
+  return { imported, rejected };
+}
