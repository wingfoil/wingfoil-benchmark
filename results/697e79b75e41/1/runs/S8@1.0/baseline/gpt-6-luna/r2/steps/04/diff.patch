@@ -8,9 +8,55 @@ export type { Summary } from './domain/summary.ts';
 export { PRIORITIES } from './domain/task.ts';
 export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 
+/** A line that could not be imported into a task list. */
+export interface RejectedTaskLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of importing newline-separated tasks into a list. */
+export interface ImportTasksResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedTaskLine[];
+}
+
 /**
  * A new, empty task list for the app, kept in memory.
  */
 export function createTodoList(): TaskList {
   return createTaskList();
 }
+
+/**
+ * Add tasks from lines in `title;priority;tags` format. Empty priorities mean `normal`;
+ * tags are separated by whitespace. Blank lines are ignored.
+ *
+ * @param list - the list to add tasks to
+ * @param text - newline-separated task rows
+ */
+export function importTasks(list: TaskList, text: string): ImportTasksResult {
+  let imported = 0;
+  const rejected: RejectedTaskLine[] = [];
+
+  for (const [index, rawLine] of text.split(/\r?\n/).entries()) {
+    if (rawLine.trim().length === 0) continue;
+
+    const fields = rawLine.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'line must contain title, priority and tags separated by semicolons' });
+      continue;
+    }
+
+    const [title, rawPriority, rawTags] = fields;
+    const priority = rawPriority.trim();
+    const result = list.add({
+      title,
+      ...(priority.length === 0 ? {} : { priority: priority as Priority }),
+      tags: rawTags.trim().length === 0 ? [] : rawTags.trim().split(/\s+/),
+    });
+    if (result.ok) imported++;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  }
+
+  return { imported, rejected };
+}
