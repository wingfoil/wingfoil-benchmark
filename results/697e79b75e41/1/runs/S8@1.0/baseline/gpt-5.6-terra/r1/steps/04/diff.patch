 export type { TaskFilter, TaskList } from './domain/list.ts';
 export type { Result, TodoError, TodoErrorCode } from './domain/result.ts';
@@ -8,9 +9,56 @@ export type { Summary } from './domain/summary.ts';
 export { PRIORITIES } from './domain/task.ts';
 export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 
+/** A line that could not be imported, together with the reason it was rejected. */
+export interface RejectedTaskImport {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of importing tasks from spreadsheet-style text. */
+export interface TaskImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedTaskImport[];
+}
+
 /**
  * A new, empty task list for the app, kept in memory.
  */
 export function createTodoList(): TaskList {
   return createTaskList();
 }
+
+/**
+ * Add tasks described one per line as `title;priority;tags`.
+ *
+ * An empty priority uses the normal priority. Tags are separated by whitespace;
+ * blank lines are ignored.
+ */
+export function importTasks(list: TaskList, text: string): TaskImportResult {
+  let imported = 0;
+  const rejected: RejectedTaskImport[] = [];
+
+  for (const [index, line] of text.split(/\r?\n/).entries()) {
+    if (line.trim().length === 0) continue;
+
+    const fields = line.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'expected title;priority;tags' });
+      continue;
+    }
+
+    const [title, priorityField, tagsField] = fields;
+    const priority = priorityField.trim();
+    const tags = tagsField.trim().length === 0 ? [] : tagsField.trim().split(/\s+/);
+    const result = list.add({
+      title,
+      priority: priority === '' ? undefined : (priority as Priority),
+      tags,
+    });
+
+    if (result.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  }
+
+  return { imported, rejected };
+}
