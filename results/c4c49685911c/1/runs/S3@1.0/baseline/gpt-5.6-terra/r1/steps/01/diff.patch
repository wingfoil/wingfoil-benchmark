@@ -0,0 +1,164 @@
+export type EquipmentKind = "board" | "sail";
+
+export interface EquipmentItem {
+  id: string;
+  kind: EquipmentKind;
+  /** Price for one day, in whole euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+export interface Booking extends RentalQuote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: EquipmentItem): void;
+  quote(request: RentalRequest): RentalQuote;
+  book(request: RentalRequest): Booking;
+}
+
+interface Period {
+  start: string;
+  end: string;
+  startTime: number;
+  endTime: number;
+}
+
+const MILLISECONDS_PER_DAY = 24 * 60 * 60 * 1000;
+
+/**
+ * Creates an in-memory service for the school's board and sail rentals.
+ */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, EquipmentItem>();
+  const bookings: Booking[] = [];
+  let nextBookingNumber = 1;
+
+  function addEquipment(item: EquipmentItem): void {
+    validateEquipment(item);
+
+    if (equipment.has(item.id)) {
+      throw new Error(`Equipment with id "${item.id}" already exists`);
+    }
+
+    // Keep an internal copy so later mutations by the caller do not change prices.
+    equipment.set(item.id, { ...item });
+  }
+
+  function quote(request: RentalRequest): RentalQuote {
+    const item = findEquipment(request);
+    const period = validatePeriod(request);
+    const total = ((period.endTime - period.startTime) / MILLISECONDS_PER_DAY) * item.dailyPrice;
+
+    return {
+      itemId: request.itemId,
+      start: request.start,
+      end: request.end,
+      total,
+    };
+  }
+
+  function book(request: RentalRequest): Booking {
+    const rentalQuote = quote(request);
+    const requestedPeriod = validatePeriod(request);
+
+    const isUnavailable = bookings.some((booking) => {
+      if (booking.itemId !== request.itemId) {
+        return false;
+      }
+
+      const bookedPeriod = validatePeriod(booking);
+      return bookedPeriod.startTime < requestedPeriod.endTime
+        && requestedPeriod.startTime < bookedPeriod.endTime;
+    });
+
+    if (isUnavailable) {
+      throw new Error(`Equipment with id "${request.itemId}" is not available for this period`);
+    }
+
+    const booking: Booking = {
+      id: `booking-${nextBookingNumber++}`,
+      ...rentalQuote,
+    };
+    bookings.push(booking);
+    return { ...booking };
+  }
+
+  return { addEquipment, quote, book };
+
+  function findEquipment(request: RentalRequest): EquipmentItem {
+    if (!request || typeof request.itemId !== "string") {
+      throw new Error("A rental request must include an item id");
+    }
+
+    const item = equipment.get(request.itemId);
+    if (!item) {
+      throw new Error(`Unknown equipment id "${request.itemId}"`);
+    }
+    return item;
+  }
+}
+
+function validateEquipment(item: EquipmentItem): void {
+  if (!item || typeof item.id !== "string") {
+    throw new Error("Equipment must have a string id");
+  }
+  if (item.kind !== "board" && item.kind !== "sail") {
+    throw new Error("Equipment kind must be either \"board\" or \"sail\"");
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error("Equipment dailyPrice must be a non-negative integer number of euro cents");
+  }
+}
+
+function validatePeriod(request: RentalRequest): Period {
+  if (!request || typeof request.start !== "string" || typeof request.end !== "string") {
+    throw new Error("A rental request must include start and end times");
+  }
+
+  const startTime = parseUtcMidnight(request.start, "start");
+  const endTime = parseUtcMidnight(request.end, "end");
+
+  if (endTime <= startTime) {
+    throw new Error("The rental end must be after its start");
+  }
+
+  return { start: request.start, end: request.end, startTime, endTime };
+}
+
+function parseUtcMidnight(value: string, field: "start" | "end"): number {
+  // An optional fractional component is permitted only when it represents zero,
+  // so every accepted time is exactly midnight UTC.
+  const match = /^(\d{4})-(\d{2})-(\d{2})T00:00:00(?:\.0+)?Z$/.exec(value);
+  if (!match) {
+    throw new Error(`Rental ${field} must be an ISO-8601 midnight time in UTC`);
+  }
+
+  const time = Date.parse(value);
+  if (!Number.isFinite(time)) {
+    throw new Error(`Rental ${field} must be a valid ISO-8601 time`);
+  }
+
+  const date = new Date(time);
+  if (date.getUTCFullYear() !== Number(match[1])
+    || date.getUTCMonth() + 1 !== Number(match[2])
+    || date.getUTCDate() !== Number(match[3])
+    || date.getUTCHours() !== 0
+    || date.getUTCMinutes() !== 0
+    || date.getUTCSeconds() !== 0
+    || date.getUTCMilliseconds() !== 0) {
+    throw new Error(`Rental ${field} must be a valid ISO-8601 midnight time in UTC`);
+  }
+
+  return time;
+}
