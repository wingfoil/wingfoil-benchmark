+function validateAvailabilityQuery(query: AvailabilityQuery): { startTime: number; endTime: number } {
+  if (typeof query !== 'object' || query === null) {
+    throw new Error('Availability query must include a rental period');
+  }
+  if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+    throw new Error('Availability query kind must be board or sail');
+  }
+
+  const startTime = parseMidnightUtc(query.start);
+  const endTime = parseMidnightUtc(query.end);
+  if (endTime <= startTime) {
+    throw new Error('Rental end must be after its start');
+  }
+  return { startTime, endTime };
+}
