+
+test('lists sorted equipment that is free for the entire requested period', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail-z', kind: 'sail', dailyPrice: 1_000 });
+  rentals.addEquipment({ id: 'board-b', kind: 'board', dailyPrice: 2_000 });
+  rentals.addEquipment({ id: 'board-a', kind: 'board', dailyPrice: 2_000 });
+  rentals.book({
+    itemId: 'board-b', start: '2026-06-02T00:00:00Z', end: '2026-06-04T00:00:00Z',
+  });
+
+  assert.deepEqual(rentals.availability({
+    start: '2026-06-01T00:00:00Z', end: '2026-06-05T00:00:00Z', kind: 'board',
+  }), ['board-a']);
+  assert.deepEqual(rentals.availability({
+    start: '2026-06-01T00:00:00Z', end: '2026-06-05T00:00:00Z',
+  }), ['board-a', 'sail-z']);
+});
+
+test('treats adjacent bookings as available and rejects invalid availability queries', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_000 });
+  rentals.book({
+    itemId: 'board-1', start: '2026-06-02T00:00:00Z', end: '2026-06-04T00:00:00Z',
+  });
+
+  assert.deepEqual(rentals.availability({
+    start: '2026-06-04T00:00:00Z', end: '2026-06-05T00:00:00Z',
+  }), ['board-1']);
+  assert.throws(() => rentals.availability({
+    start: '2026-06-05T00:00:00Z', end: '2026-06-05T00:00:00Z',
+  }));
+  assert.throws(() => rentals.availability({
+    start: '2026-06-05T00:00:00Z', end: '2026-06-06T00:00:00Z', kind: 'mast',
+  }));
+});
