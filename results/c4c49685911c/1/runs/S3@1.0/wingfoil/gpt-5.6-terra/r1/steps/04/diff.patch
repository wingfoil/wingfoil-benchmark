+test('quotes and books an on-the-hour rental shorter than a day at the hourly price', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500, hourlyPrice: 750 });
+
+  const request = {
+    itemId: 'board-1',
+    start: '2026-06-01T10:00:00Z',
+    end: '2026-06-01T14:00:00Z',
+  };
+
+  assert.deepEqual(rentals.quote(request), { ...request, total: 3_000 });
+  assert.deepEqual(rentals.book(request), { id: 'booking-1', ...request, total: 3_000 });
+});
+
+test('rejects hourly rentals when the item has no hourly price', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+
+  assert.throws(() => rentals.quote({
