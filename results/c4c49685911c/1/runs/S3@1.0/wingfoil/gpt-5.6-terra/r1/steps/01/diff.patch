--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,139 @@
+/** A rentable board or sail and its daily price in euro cents. */
+export interface Equipment {
+  id: string;
+  kind: 'board' | 'sail';
+  dailyPrice: number;
+}
+
+/** The requested half-open UTC rental period. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** A price calculated for a rental request. */
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed rental booking. */
+export interface RentalBooking extends RentalQuote {
+  id: string;
+}
+
+/** An in-memory service for quoting and booking rental equipment. */
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): RentalQuote;
+  book(request: RentalRequest): RentalBooking;
+}
+
+const MILLISECONDS_PER_DAY = 24 * 60 * 60 * 1_000;
+const MIDNIGHT_UTC = /^(\d{4})-(\d{2})-(\d{2})T00:00:00(?:\.0+)?Z$/;
+
+/**
+ * Creates an isolated in-memory rental service.
+ *
+ * Rental periods use UTC midnight boundaries and are half-open: `end` is the
+ * first moment after the rental, so adjacent bookings do not overlap.
+ */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: RentalBooking[] = [];
+  let nextBookingNumber = 1;
+
+  function addEquipment(item: Equipment): void {
+    validateEquipment(item);
+    if (equipment.has(item.id)) {
+      throw new Error(`Equipment already exists: ${item.id}`);
+    }
+    equipment.set(item.id, { ...item });
+  }
+
+  function quote(request: RentalRequest): RentalQuote {
+    const item = equipment.get(request.itemId);
+    if (item === undefined) {
+      throw new Error(`Unknown equipment: ${request.itemId}`);
+    }
+
+    const { startTime, endTime } = validatePeriod(request);
+    const days = (endTime - startTime) / MILLISECONDS_PER_DAY;
+    const total = days * item.dailyPrice;
+    if (!Number.isSafeInteger(total)) {
+      throw new Error('Rental total exceeds the supported integer-cent range');
+    }
+
+    return { ...request, total };
+  }
+
+  function book(request: RentalRequest): RentalBooking {
+    const rentalQuote = quote(request);
+    const { startTime, endTime } = validatePeriod(request);
+    const isUnavailable = bookings.some((booking) => {
+      const bookingStart = parseMidnightUtc(booking.start);
+      const bookingEnd = parseMidnightUtc(booking.end);
+      return startTime < bookingEnd && bookingStart < endTime && booking.itemId === request.itemId;
+    });
+
+    if (isUnavailable) {
+      throw new Error(`Equipment is unavailable for the requested period: ${request.itemId}`);
+    }
+
+    const booking: RentalBooking = {
+      id: `booking-${nextBookingNumber}`,
+      ...rentalQuote,
+    };
+    nextBookingNumber += 1;
+    bookings.push(booking);
+    return booking;
+  }
+
+  return { addEquipment, quote, book };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item !== 'object' || item === null || typeof item.id !== 'string' || item.id.length === 0) {
+    throw new Error('Equipment must have a non-empty string id');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error('Equipment kind must be board or sail');
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('Equipment dailyPrice must be a non-negative integer number of euro cents');
+  }
+}
+
+function validatePeriod(request: RentalRequest): { startTime: number; endTime: number } {
+  if (typeof request !== 'object' || request === null || typeof request.itemId !== 'string') {
+    throw new Error('Rental request must include an itemId');
+  }
+
+  const startTime = parseMidnightUtc(request.start);
+  const endTime = parseMidnightUtc(request.end);
+  if (endTime <= startTime) {
+    throw new Error('Rental end must be after its start');
+  }
+  return { startTime, endTime };
+}
+
+function parseMidnightUtc(value: unknown): number {
+  if (typeof value !== 'string') {
+    throw new Error('Rental times must be UTC ISO-8601 strings');
+  }
+
+  const match = MIDNIGHT_UTC.exec(value);
+  if (match === null) {
+    throw new Error('Rental times must be midnight UTC ISO-8601 strings');
+  }
+
+  const date = new Date(value);
+  const timestamp = date.getTime();
+  if (!Number.isFinite(timestamp)
+    || date.getUTCFullYear() !== Number(match[1])
+    || date.getUTCMonth() + 1 !== Number(match[2])
+    || date.getUTCDate() !== Number(match[3])) {
+    throw new Error('Rental times must be valid UTC ISO-8601 dates');
+  }
+  return timestamp;
+}
diff --git a/test/rental.test.mjs b/test/rental.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..1f5b72756640185b9d95f4f4461d3da91bd1b0c1
--- /dev/null
+++ b/test/rental.test.mjs
@@ -0,0 +1,41 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { createRentalService } from '../src/index.ts';
+
+test('quotes and books a whole-day rental in integer euro cents', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+
+  const request = {
+    itemId: 'board-1',
+    start: '2026-06-01T00:00:00Z',
+    end: '2026-06-04T00:00:00Z',
+  };
+
+  assert.deepEqual(rentals.quote(request), { ...request, total: 7_500 });
+  assert.deepEqual(rentals.book(request), { id: 'booking-1', ...request, total: 7_500 });
+});
+
+test('rejects invalid periods, unknown equipment, and overlapping bookings', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1_000 });
+
+  assert.throws(() => rentals.quote({
+    itemId: 'missing', start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z',
+  }));
+  assert.throws(() => rentals.quote({
+    itemId: 'sail-1', start: '2026-06-01T12:00:00Z', end: '2026-06-02T00:00:00Z',
+  }));
+  assert.throws(() => rentals.quote({
+    itemId: 'sail-1', start: '2026-06-02T00:00:00Z', end: '2026-06-02T00:00:00Z',
+  }));
+
+  rentals.book({ itemId: 'sail-1', start: '2026-06-02T00:00:00Z', end: '2026-06-04T00:00:00Z' });
+  assert.throws(() => rentals.book({
+    itemId: 'sail-1', start: '2026-06-03T00:00:00Z', end: '2026-06-05T00:00:00Z',
+  }));
+  assert.doesNotThrow(() => rentals.book({
+    itemId: 'sail-1', start: '2026-06-04T00:00:00Z', end: '2026-06-05T00:00:00Z',
+  }));
+});
