+function calculateRentalTotal(days: number, dailyPrice: number): number {
+  const fullPrice = days * dailyPrice;
+  if (!Number.isSafeInteger(fullPrice)) {
+    throw new Error('Rental total exceeds the supported integer-cent range');
+  }
+
+  if (days < LONG_RENTAL_MINIMUM_DAYS) {
+    return fullPrice;
+  }
+
+  return Math.round(fullPrice * (1 - LONG_RENTAL_DISCOUNT_RATE));
+}
