index 0000000000000000000000000000000000000000..cb745cec32d98c3512b96260db9657e48334c00e
--- /dev/null
+++ b/test/rental-service.test.mjs
@@ -0,0 +1,48 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+const { createRentalService } = await import('../dist/index.js');
+
+const board = { id: 'board-1', kind: 'board', dailyPrice: 2_500 };
+const firstDay = '2026-05-01T00:00:00.000Z';
+const thirdDay = '2026-05-03T00:00:00.000Z';
+
+test('quotes and books a whole-day UTC rental', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment(board);
+
+  assert.deepEqual(rentals.quote({ itemId: board.id, start: firstDay, end: thirdDay }), {
+    itemId: board.id,
+    start: firstDay,
+    end: thirdDay,
+    total: 5_000,
+  });
+  assert.deepEqual(rentals.book({ itemId: board.id, start: firstDay, end: thirdDay }), {
+    id: 'booking-1',
+    itemId: board.id,
+    start: firstDay,
+    end: thirdDay,
+    total: 5_000,
+  });
+});
+
+test('rejects invalid periods, unknown items, and overlapping bookings', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment(board);
+
+  assert.throws(() => rentals.quote({ itemId: 'missing', start: firstDay, end: thirdDay }));
+  assert.throws(() => rentals.quote({ itemId: board.id, start: '2026-05-01T01:00:00.000Z', end: thirdDay }));
+  assert.throws(() => rentals.quote({ itemId: board.id, start: thirdDay, end: firstDay }));
+
+  rentals.book({ itemId: board.id, start: firstDay, end: thirdDay });
+  assert.throws(() => rentals.book({
+    itemId: board.id,
+    start: '2026-05-02T00:00:00.000Z',
+    end: '2026-05-04T00:00:00.000Z',
+  }));
+  assert.doesNotThrow(() => rentals.book({
+    itemId: board.id,
+    start: thirdDay,
+    end: '2026-05-04T00:00:00.000Z',
+  }));
+});
