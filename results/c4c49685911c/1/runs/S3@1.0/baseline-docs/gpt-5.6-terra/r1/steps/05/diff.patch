+function parseUtcTimestamp(value: unknown): number {
+  if (typeof value !== 'string') {
+    throw new Error('Cancellation time must be a UTC ISO-8601 timestamp');
+  }
+
+  const match = UTC_TIMESTAMP.exec(value);
+  const timestamp = Date.parse(value);
+  if (match === null || !Number.isFinite(timestamp) || new Date(timestamp).toISOString().slice(0, 19) !== match[1]) {
+    throw new Error('Cancellation time must be a valid UTC ISO-8601 timestamp');
+  }
+  return timestamp;
+}
