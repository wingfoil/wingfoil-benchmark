+
+test('cancels a booking, refunds it when cancelled at least 24 hours before it starts, and releases its equipment', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+  const booking = rentals.book({ itemId: 'board-1', start: thirdDay, end: fourthDay });
+
+  assert.deepEqual(rentals.cancel(booking.id, secondDay), { bookingId: booking.id, refund: 2_500 });
+  assert.deepEqual(rentals.availability({ start: thirdDay, end: fourthDay }), ['board-1']);
+  assert.doesNotThrow(() => rentals.book({ itemId: 'board-1', start: thirdDay, end: fourthDay }));
+});
+
+test('does not refund late cancellations and rejects unknown or repeat cancellations', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+  const booking = rentals.book({ itemId: 'board-1', start: thirdDay, end: fourthDay });
+
+  assert.deepEqual(rentals.cancel(booking.id, '2026-06-02T00:00:00.001Z'), { bookingId: booking.id, refund: 0 });
+  assert.throws(() => rentals.cancel(booking.id, firstDay));
+  assert.throws(() => rentals.cancel('booking-999', firstDay));
+});
