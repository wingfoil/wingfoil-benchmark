new file mode 100644
index 0000000000000000000000000000000000000000..4e50a4a97214a29f20a3bbcfc564f1ccee070165
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,175 @@
+/** A rentable board or sail held by the school. */
+export interface Equipment {
+  id: string;
+  kind: 'board' | 'sail';
+  dailyPrice: number;
+}
+
+/** A requested half-open rental period, expressed as UTC ISO-8601 timestamps. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The calculated price for a rental request, in euro cents. */
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed rental booking. */
+export interface RentalBooking extends RentalQuote {
+  id: string;
+}
+
+/** An in-memory booking desk for the school's rental equipment. */
+export interface RentalService {
+  /** Adds a board or sail that can be rented. */
+  addEquipment(item: Equipment): void;
+  /** Calculates the price of a valid rental period without reserving the item. */
+  quote(request: RentalRequest): RentalQuote;
+  /** Reserves a free item for a valid rental period. */
+  book(request: RentalRequest): RentalBooking;
+}
+
+interface ValidatedPeriod {
+  startTime: number;
+  endTime: number;
+}
+
+const MIDNIGHT_UTC = /^(\d{4}-\d{2}-\d{2})T00:00:00(?:\.000)?Z$/;
+const MILLISECONDS_PER_DAY = 24 * 60 * 60 * 1000;
+
+/**
+ * Creates an isolated, in-memory rental service.
+ *
+ * Booking identifiers are assigned sequentially, beginning with `booking-1` for
+ * each newly created service. Cancellation is intentionally not exposed yet.
+ */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Array<RentalBooking & ValidatedPeriod> = [];
+  let nextBookingNumber = 1;
+
+  function addEquipment(item: Equipment): void {
+    validateEquipment(item);
+    if (equipment.has(item.id)) {
+      throw new Error(`Equipment already exists: ${item.id}`);
+    }
+
+    equipment.set(item.id, { ...item });
+  }
+
+  function quote(request: RentalRequest): RentalQuote {
+    const item = getEquipment(equipment, request);
+    const period = validateRequest(request);
+    const total = calculateTotal(item.dailyPrice, period);
+
+    return { itemId: request.itemId, start: request.start, end: request.end, total };
+  }
+
+  function book(request: RentalRequest): RentalBooking {
+    const item = getEquipment(equipment, request);
+    const period = validateRequest(request);
+    const total = calculateTotal(item.dailyPrice, period);
+
+    if (bookings.some((booking) => booking.itemId === request.itemId && periodsOverlap(period, booking))) {
+      throw new Error(`Equipment is not available: ${request.itemId}`);
+    }
+
+    const booking: RentalBooking & ValidatedPeriod = {
+      id: `booking-${nextBookingNumber++}`,
+      itemId: request.itemId,
+      start: request.start,
+      end: request.end,
+      total,
+      ...period,
+    };
+    bookings.push(booking);
+
+    return toPublicBooking(booking);
+  }
+
+  return { addEquipment, quote, book };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item !== 'object' || item === null) {
+    throw new Error('Equipment must be an object');
+  }
+  if (typeof item.id !== 'string' || item.id.length === 0) {
+    throw new Error('Equipment id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error('Equipment kind must be board or sail');
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('Equipment daily price must be a non-negative integer number of cents');
+  }
+}
+
+function getEquipment(equipment: Map<string, Equipment>, request: RentalRequest): Equipment {
+  if (typeof request !== 'object' || request === null || typeof request.itemId !== 'string') {
+    throw new Error('Rental request must identify an item');
+  }
+
+  const item = equipment.get(request.itemId);
+  if (item === undefined) {
+    throw new Error(`Unknown equipment: ${request.itemId}`);
+  }
+  return item;
+}
+
+function validateRequest(request: RentalRequest): ValidatedPeriod {
+  if (typeof request !== 'object' || request === null) {
+    throw new Error('Rental request must be an object');
+  }
+  const startTime = parseMidnightUtc(request.start, 'start');
+  const endTime = parseMidnightUtc(request.end, 'end');
+
+  if (endTime <= startTime) {
+    throw new Error('Rental end must be after its start');
+  }
+
+  return { startTime, endTime };
+}
+
+function parseMidnightUtc(value: unknown, field: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`Rental ${field} must be a midnight UTC ISO-8601 timestamp`);
+  }
+
+  const timestamp = Date.parse(value);
+  if (!Number.isFinite(timestamp)) {
+    throw new Error(`Rental ${field} must be a valid date`);
+  }
+
+  const datePart = value.slice(0, 10);
+  if (new Date(timestamp).toISOString().slice(0, 10) !== datePart) {
+    throw new Error(`Rental ${field} must be a valid date`);
+  }
+  return timestamp;
+}
+
+function calculateTotal(dailyPrice: number, period: ValidatedPeriod): number {
+  const days = (period.endTime - period.startTime) / MILLISECONDS_PER_DAY;
+  const total = days * dailyPrice;
+  if (!Number.isSafeInteger(total)) {
+    throw new Error('Rental total exceeds the supported money range');
+  }
+  return total;
+}
+
+function periodsOverlap(period: ValidatedPeriod, booking: RentalBooking & ValidatedPeriod): boolean {
+  return booking.startTime < period.endTime && period.startTime < booking.endTime;
+}
+
+function toPublicBooking(booking: RentalBooking): RentalBooking {
+  return {
+    id: booking.id,
+    itemId: booking.itemId,
+    start: booking.start,
+    end: booking.end,
+    total: booking.total,
+  };
+}
diff --git a/test/rental-service.test.mjs b/test/rental-service.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..04fbea3c5bf895fd250c408f439819f7cd5a0c4d
--- /dev/null
+++ b/test/rental-service.test.mjs
@@ -0,0 +1,30 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { createRentalService } from '../dist/index.js';
+
+const firstDay = '2026-06-01T00:00:00.000Z';
+const secondDay = '2026-06-02T00:00:00.000Z';
+const thirdDay = '2026-06-03T00:00:00.000Z';
+
+test('quotes and books an item for whole UTC days', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+
+  const request = { itemId: 'board-1', start: firstDay, end: thirdDay };
+  assert.deepEqual(rentals.quote(request), { ...request, total: 5_000 });
+  assert.deepEqual(rentals.book(request), { id: 'booking-1', ...request, total: 5_000 });
+});
+
+test('rejects unknown equipment, invalid periods, and overlapping bookings', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1_800 });
+
+  assert.throws(() => rentals.quote({ itemId: 'missing', start: firstDay, end: secondDay }));
+  assert.throws(() => rentals.quote({ itemId: 'sail-1', start: '2026-06-01T12:00:00.000Z', end: secondDay }));
+  assert.throws(() => rentals.quote({ itemId: 'sail-1', start: secondDay, end: firstDay }));
+
+  rentals.book({ itemId: 'sail-1', start: firstDay, end: thirdDay });
+  assert.throws(() => rentals.book({ itemId: 'sail-1', start: secondDay, end: thirdDay }));
+  assert.doesNotThrow(() => rentals.book({ itemId: 'sail-1', start: thirdDay, end: '2026-06-04T00:00:00.000Z' }));
+});
