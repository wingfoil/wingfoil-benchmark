     throw new Error(`Rental ${field} must be a midnight UTC ISO-8601 timestamp`);
diff --git a/test/rental-service.test.mjs b/test/rental-service.test.mjs
index 04fbea3c5bf895fd250c408f439819f7cd5a0c4d..94329d14c94ea360318547438827ea578ca9109f 100644
--- a/test/rental-service.test.mjs
