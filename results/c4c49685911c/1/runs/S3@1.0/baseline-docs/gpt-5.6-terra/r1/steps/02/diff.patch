+function validateAvailabilityQuery(query: AvailabilityQuery): ValidatedPeriod {
+  if (typeof query !== 'object' || query === null) {
+    throw new Error('Availability query must be an object');
+  }
+  if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+    throw new Error('Availability kind must be board or sail');
+  }
+
+  const startTime = parseMidnightUtc(query.start, 'start');
+  const endTime = parseMidnightUtc(query.end, 'end');
+  if (endTime <= startTime) {
+    throw new Error('Rental end must be after its start');
+  }
+
+  return { startTime, endTime };
+}
+
 function parseMidnightUtc(value: unknown, field: string): number {
