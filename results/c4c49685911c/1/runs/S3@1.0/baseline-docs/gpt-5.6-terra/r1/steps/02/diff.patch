@@ -28,3 +28,28 @@ test('rejects unknown equipment, invalid periods, and overlapping bookings', ()
   assert.throws(() => rentals.book({ itemId: 'sail-1', start: secondDay, end: thirdDay }));
   assert.doesNotThrow(() => rentals.book({ itemId: 'sail-1', start: thirdDay, end: '2026-06-04T00:00:00.000Z' }));
 });
+
+test('lists sorted equipment that is free for the whole requested period', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 1_800 });
+  rentals.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2_500 });
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_300 });
+  rentals.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1_700 });
+
+  rentals.book({ itemId: 'board-1', start: firstDay, end: thirdDay });
+  rentals.book({ itemId: 'sail-2', start: secondDay, end: thirdDay });
+
+  assert.deepEqual(rentals.availability({ start: firstDay, end: secondDay }), ['board-2', 'sail-1', 'sail-2']);
+  assert.deepEqual(rentals.availability({ start: firstDay, end: secondDay, kind: 'board' }), ['board-2']);
+  assert.deepEqual(rentals.availability({ start: thirdDay, end: '2026-06-04T00:00:00.000Z', kind: 'sail' }), [
+    'sail-1',
+    'sail-2',
+  ]);
+});
+
+test('rejects invalid availability queries', () => {
+  const rentals = createRentalService();
+
+  assert.throws(() => rentals.availability({ start: firstDay, end: firstDay }));
+  assert.throws(() => rentals.availability({ start: firstDay, end: secondDay, kind: 'mast' }));
+});
