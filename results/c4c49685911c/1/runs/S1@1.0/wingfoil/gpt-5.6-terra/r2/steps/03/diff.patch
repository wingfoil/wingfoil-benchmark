@@ -0,0 +1,12 @@
+---
+id: task-003-conform-applypatch-to-rfc-6902
+type: task
+title: "Conform applyPatch to RFC 6902"
+status: pending
+format: 1
+---
+
+Reviewed `applyPatch` against RFC 6902 and its error handling rules. The implementation now validates
+the patch itself as a JSON document before applying operations, retains the caller's document when a
+later operation fails, and supports a same-location move of the document root. Added deterministic
+regression tests and documented the failure guarantee.
diff --git a/src/index.ts b/src/index.ts
index b88692ef117db12eff92235f67c0e065602657fe..6c388ec31a1427cb7561da14f0789a61af70f326 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -47,13 +47,17 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
  * @throws {Error} If an operation cannot be applied or a test operation fails.
  */
 export function applyPatch(document: unknown, patch: unknown): unknown {
-  if (!Array.isArray(patch)) {
+  // RFC 6902 defines a patch as a JSON document, not merely an iterable of
+  // operation-like JavaScript values. Clone it before applying anything so
+  // non-JSON arrays and operation objects are rejected at this boundary.
+  const patchDocument = cloneJsonValue(patch);
+  if (!Array.isArray(patchDocument)) {
     throw new TypeError('A JSON Patch must be an array of operations.');
   }
 
   let result = cloneJsonValue(document);
 
-  for (const operation of patch) {
+  for (const operation of patchDocument) {
     result = applyOperation(result, operation);
   }
 
@@ -120,6 +124,13 @@ function moveValue(document: unknown, path: string[], from: string): unknown {
   }
 
   const value = getValue(document, fromTokens);
+  // A source and target may be the same location: only a *proper* prefix is
+  // forbidden by RFC 6902. This is particularly important for the root,
+  // where modeling the move as a literal remove followed by add is impossible.
+  if (fromTokens.length === path.length &&
+      fromTokens.every((token, index) => token === path[index])) {
+    return document;
+  }
   return addValue(removeValue(document, fromTokens), path, value);
 }
 
diff --git a/test/json-patch.test.mjs b/test/json-patch.test.mjs
index 972aac6900bcc4f9fe4d4b4574c7510e70e819e8..1a87912bcca0a5021b64622fc74bf3ab46886cac 100644
--- a/test/json-patch.test.mjs
+++ b/test/json-patch.test.mjs
@@ -58,3 +58,27 @@ test('rejects malformed patches and failed operations', () => {
   assert.throws(() => applyPatch(document, [{ op: 'move', from: '/child', path: '/child/value/new' }]));
   assert.throws(() => applyPatch(document, [{ op: 'copy', from: '/missing', path: '/copy' }]));
 });
+
+test('requires the patch document to be a JSON array of JSON operation objects', () => {
+  const patch = [{ op: 'add', path: '/answer', value: 42 }];
+  Object.defineProperty(patch, 'metadata', { enumerable: true, value: 'not JSON' });
+  assert.throws(() => applyPatch({}, patch), TypeError);
+
+  assert.throws(() => applyPatch({}, [Object.assign(new Date(), {
+    op: 'add', path: '/answer', value: 42,
+  })]), TypeError);
+});
+
+test('permits moving the document root to itself', () => {
+  const document = { value: ['preserved'] };
+  assert.deepEqual(applyPatch(document, [{ op: 'move', from: '', path: '' }]), document);
+});
+
+test('leaves the input document unchanged when a later operation fails', () => {
+  const document = { value: 1 };
+  assert.throws(() => applyPatch(document, [
+    { op: 'replace', path: '/value', value: 2 },
+    { op: 'test', path: '/value', value: 3 },
+  ]));
+  assert.deepEqual(document, { value: 1 });
+});
