+import { applyMergePatch, applyPatch, createPatch } from '../dist/index.js';
+
+test('creates a compact patch for nested object changes', () => {
+  const from = {
+    account: { name: 'Ada', preferences: { theme: 'light', locale: 'en' } },
+    retained: ['unchanged'],
+  };
+  const to = {
+    account: { name: 'Ada', preferences: { theme: 'dark', locale: 'en' } },
+    retained: ['unchanged'],
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: 'replace', path: '/account/preferences/theme', value: 'dark' }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    account: { name: 'Ada', preferences: { theme: 'light', locale: 'en' } },
+    retained: ['unchanged'],
+  });
+});
+
+test('creates index-safe changes for array insertions and removals', () => {
+  const from = { values: ['a', 'b', 'c'] };
+  const to = { values: ['a', 'c', 'd'] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'remove', path: '/values/1' },
+    { op: 'add', path: '/values/2', value: 'd' },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test('creates a root replacement without retaining input references', () => {
+  const to = { nested: ['new'] };
+  const patch = createPatch(null, to);
+
+  assert.deepEqual(patch, [{ op: 'replace', path: '', value: to }]);
+  assert.notStrictEqual(patch[0].value, to);
+  assert.deepEqual(applyPatch(null, patch), to);
+  assert.throws(() => createPatch({ value: Infinity }, {}), TypeError);
+});
 
