+/** A JSON Patch operation produced by {@link createPatch}. */
+export type JsonPatchOperation =
+  | { op: 'add' | 'replace'; path: string; value: unknown }
+  | { op: 'remove'; path: string };
+
+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ *
+ * The generated patch uses `add`, `remove`, and `replace` operations, recursing
+ * into objects and arrays to preserve unchanged portions of the document. Both
+ * inputs must be JSON values and are neither mutated nor retained by the patch.
+ *
+ * @param from The JSON document before the change.
+ * @param to The desired JSON document.
+ * @returns An ordered JSON Patch that transforms `from` into `to`.
+ * @throws {TypeError} If either input is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const source = cloneJsonValue(from);
+  const target = cloneJsonValue(to);
+  const patch: JsonPatchOperation[] = [];
+  createPatchOperations(source, target, '', patch);
+  return patch;
+}
