+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document.
+ *
+ * Object members whose patch value is `null` are removed. Other object
+ * members are merged recursively; arrays and scalar values replace the target.
+ * Neither input is mutated.
+ *
+ * @param target The JSON document to transform.
+ * @param patch The JSON Merge Patch document.
+ * @returns A new JSON document containing the merged result.
+ * @throws {TypeError} If `target` or `patch` is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return mergePatch(cloneJsonValue(target), cloneJsonValue(patch));
+}
+
 type JsonContainer = unknown[] | Record<string, unknown>;
 
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isMergePatchObject(patch)) {
+    return patch;
+  }
+
+  const result = isMergePatchObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      defineJsonProperty(result, key, mergePatch(result[key], value));
+    }
+  }
+  return result;
+}
+
+function isMergePatchObject(value: unknown): value is Record<string, unknown> {
+  return isJsonObject(value) && !Array.isArray(value);
+}
+
 function applyOperation(document: unknown, operation: unknown): unknown {
   if (!isJsonObject(operation) || Array.isArray(operation)) {
     throw new TypeError('A JSON Patch operation must be an object.');
