+
+test('does not mutate inputs or retain references while applying merge patches', () => {
+  const target = { nested: { unchanged: true, removed: 'value' } };
+  const patch = { nested: { removed: null, added: ['value'] } };
+  const result = applyMergePatch(target, patch);
+
+  assert.deepEqual(result, { nested: { unchanged: true, added: ['value'] } });
+  assert.deepEqual(target, { nested: { unchanged: true, removed: 'value' } });
+  assert.notStrictEqual(result, target);
+  assert.notStrictEqual(result.nested, target.nested);
+  assert.notStrictEqual(result.nested.added, patch.nested.added);
+
+  assert.throws(() => applyMergePatch({}, new Date()), TypeError);
+  assert.throws(() => applyMergePatch({ value: Infinity }, {}), TypeError);
+});
 
