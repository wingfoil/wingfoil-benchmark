+/**
+ * Applies an RFC 6902 JSON Patch to a JSON document.
+ *
+ * @param document The JSON document to transform.
+ * @param patch The ordered array of JSON Patch operations.
+ * @returns A new JSON document containing the result of the patch.
+ * @throws {TypeError} If the document, patch, operation, or JSON Pointer is invalid.
+ * @throws {Error} If an operation cannot be applied or a test operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new TypeError('A JSON Patch must be an array of operations.');
+  }
+
+  let result = cloneJsonValue(document);
+
+  for (const operation of patch) {
+    result = applyOperation(result, operation);
+  }
+
+  return result;
+}
+
+type JsonContainer = unknown[] | Record<string, unknown>;
+
+function applyOperation(document: unknown, operation: unknown): unknown {
+  if (!isJsonObject(operation) || Array.isArray(operation)) {
+    throw new TypeError('A JSON Patch operation must be an object.');
+  }
+
+  const op = operation.op;
+  const path = operation.path;
+  if (!Object.hasOwn(operation, 'op') || !Object.hasOwn(operation, 'path') ||
+      typeof op !== 'string' || typeof path !== 'string') {
+    throw new TypeError('A JSON Patch operation must have string "op" and "path" members.');
+  }
+
+  const tokens = parsePointer(path);
+  switch (op) {
+    case 'add':
+      return addValue(document, tokens, requiredValue(operation));
+    case 'remove':
+      return removeValue(document, tokens);
+    case 'replace':
+      return replaceValue(document, tokens, requiredValue(operation));
+    case 'move':
+      return moveValue(document, tokens, requiredFrom(operation));
+    case 'copy':
+      return addValue(document, tokens, getValue(document, parsePointer(requiredFrom(operation))));
+    case 'test':
+      if (!jsonEquals(getValue(document, tokens), requiredValue(operation))) {
+        throw new Error(`JSON Patch test operation failed at path: ${path}`);
+      }
+      return document;
+    default:
+      throw new TypeError(`Unsupported JSON Patch operation: ${op}`);
+  }
+}
+
+function requiredValue(operation: Record<string, unknown>): unknown {
+  if (!Object.hasOwn(operation, 'value')) {
+    throw new TypeError('This JSON Patch operation requires a "value" member.');
+  }
+
+  return cloneJsonValue(operation.value);
+}
+
+function requiredFrom(operation: Record<string, unknown>): string {
+  if (!Object.hasOwn(operation, 'from') || typeof operation.from !== 'string') {
+    throw new TypeError('This JSON Patch operation requires a string "from" member.');
+  }
+
+  parsePointer(operation.from);
+  return operation.from;
+}
+
+function moveValue(document: unknown, path: string[], from: string): unknown {
+  const fromTokens = parsePointer(from);
+  if (isProperPrefix(fromTokens, path)) {
+    throw new Error('A JSON Patch move destination cannot be a child of its source.');
+  }
+
+  const value = getValue(document, fromTokens);
+  return addValue(removeValue(document, fromTokens), path, value);
+}
+
+function isProperPrefix(prefix: string[], value: string[]): boolean {
+  return prefix.length < value.length && prefix.every((token, index) => token === value[index]);
+}
+
+function addValue(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return cloneJsonValue(value);
+  }
+
+  const { parent, token } = getParent(document, tokens);
+  if (Array.isArray(parent)) {
+    const index = arrayIndex(token, parent.length, true);
+    parent.splice(index, 0, cloneJsonValue(value));
+  } else {
+    defineJsonProperty(parent, token, cloneJsonValue(value));
+  }
+  return document;
+}
+
+function removeValue(document: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) {
+    throw new Error('A JSON Patch cannot remove the document root.');
+  }
+
+  const { parent, token } = getParent(document, tokens);
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(token, parent.length, false), 1);
+  } else {
+    if (!Object.hasOwn(parent, token)) {
+      throw new Error(`JSON Patch path does not exist: ${formatPointer(tokens)}`);
+    }
+    delete parent[token];
+  }
+  return document;
+}
+
+function replaceValue(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return cloneJsonValue(value);
+  }
+
+  const { parent, token } = getParent(document, tokens);
+  if (Array.isArray(parent)) {
+    parent[arrayIndex(token, parent.length, false)] = cloneJsonValue(value);
+  } else {
+    if (!Object.hasOwn(parent, token)) {
+      throw new Error(`JSON Patch path does not exist: ${formatPointer(tokens)}`);
+    }
+    defineJsonProperty(parent, token, cloneJsonValue(value));
+  }
+  return document;
+}
+
+function getValue(document: unknown, tokens: string[]): unknown {
+  let value = document;
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      value = value[arrayIndex(token, value.length, false)];
+    } else if (isJsonObject(value)) {
+      if (!Object.hasOwn(value, token)) {
+        throw new Error(`JSON Patch path does not exist: ${formatPointer(tokens)}`);
+      }
+      value = value[token];
+    } else {
+      throw new Error(`JSON Patch path does not exist: ${formatPointer(tokens)}`);
+    }
+  }
+  return value;
+}
+
+function getParent(document: unknown, tokens: string[]): { parent: JsonContainer; token: string } {
+  const parent = getValue(document, tokens.slice(0, -1));
+  if (!Array.isArray(parent) && !isJsonObject(parent)) {
+    throw new Error(`JSON Patch parent does not exist: ${formatPointer(tokens)}`);
+  }
+  return { parent, token: tokens[tokens.length - 1] };
+}
+
+function arrayIndex(token: string, length: number, allowAppend: boolean): number {
+  if (allowAppend && token === '-') {
+    return length;
+  }
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`Invalid JSON Patch array index: ${token}`);
+  }
+
+  const index = Number(token);
+  const maximum = allowAppend ? length : length - 1;
+  if (!Number.isSafeInteger(index) || index > maximum) {
+    throw new Error(`JSON Patch array index is out of bounds: ${token}`);
+  }
+  return index;
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === '') {
+    return [];
+  }
+  if (!pointer.startsWith('/')) {
+    throw new TypeError('A JSON Patch path must be a valid JSON Pointer.');
+  }
+  return pointer.slice(1).split('/').map(decodeReferenceToken);
+}
+
+function formatPointer(tokens: string[]): string {
+  return `/${tokens.map((token) => token.replace(/~/g, '~0').replace(/\//g, '~1')).join('/')}`;
+}
+
+function defineJsonProperty(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, {
+    configurable: true,
+    enumerable: true,
+    value,
+    writable: true,
+  });
+}
+
+function cloneJsonValue(value: unknown, ancestors = new Set<object>()): unknown {
+  if (value === null || typeof value === 'string' || typeof value === 'boolean') {
+    return value;
+  }
+  if (typeof value === 'number') {
+    if (!Number.isFinite(value)) {
+      throw new TypeError('A JSON value cannot be a non-finite number.');
+    }
+    return value;
+  }
+  if (typeof value !== 'object' || value === null || ancestors.has(value)) {
+    throw new TypeError('Expected a JSON value.');
+  }
+
+  ancestors.add(value);
+  let cloned: unknown;
+  if (Array.isArray(value)) {
+    const keys = Object.keys(value);
+    if (keys.length !== value.length || keys.some((key) =>
+      !/^(0|[1-9][0-9]*)$/.test(key) || Number(key) >= value.length)) {
+      throw new TypeError('Expected a JSON array without holes or extra properties.');
+    }
+    cloned = value.map((item) => cloneJsonValue(item, ancestors));
+  } else {
+    if (Object.getPrototypeOf(value) !== Object.prototype && Object.getPrototypeOf(value) !== null ||
+        Object.getOwnPropertySymbols(value).length > 0) {
+      throw new TypeError('Expected a plain JSON object.');
+    }
+    const object: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) {
+      defineJsonProperty(object, key, cloneJsonValue((value as Record<string, unknown>)[key], ancestors));
+    }
+    cloned = object;
+  }
+  ancestors.delete(value);
+  return cloned;
+}
+
+function jsonEquals(left: unknown, right: unknown): boolean {
+  if (left === right) {
+    return true;
+  }
+  if (typeof left !== typeof right || left === null || right === null) {
+    return false;
+  }
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return Array.isArray(left) && Array.isArray(right) && left.length === right.length &&
+      left.every((value, index) => jsonEquals(value, right[index]));
+  }
+  if (isJsonObject(left) && isJsonObject(right)) {
+    const leftKeys = Object.keys(left);
+    const rightKeys = Object.keys(right);
+    return leftKeys.length === rightKeys.length &&
+      leftKeys.every((key) => Object.hasOwn(right, key) && jsonEquals(left[key], right[key]));
+  }
+  return false;
+}
+
 function decodeReferenceToken(token: string): string {
   if (/~(?:[^01]|$)/.test(token)) {
     throw new TypeError(`Invalid JSON Pointer escape sequence in token: ${token}`);
