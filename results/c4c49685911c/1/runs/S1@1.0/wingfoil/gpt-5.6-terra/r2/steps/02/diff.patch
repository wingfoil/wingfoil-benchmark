index 0000000000000000000000000000000000000000..972aac6900bcc4f9fe4d4b4574c7510e70e819e8
--- /dev/null
+++ b/test/json-patch.test.mjs
@@ -0,0 +1,60 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { applyPatch } from '../dist/index.js';
+
+test('applies the RFC 6902 operation examples', () => {
+  assert.deepEqual(applyPatch({ foo: ['bar', 'baz'] }, [
+    { op: 'add', path: '/foo/1', value: 'qux' },
+    { op: 'remove', path: '/foo/0' },
+    { op: 'replace', path: '/foo/0', value: 'boo' },
+    { op: 'copy', from: '/foo/0', path: '/copied' },
+    { op: 'move', from: '/copied', path: '/moved' },
+    { op: 'test', path: '/moved', value: 'boo' },
+  ]), { foo: ['boo', 'baz'], moved: 'boo' });
+});
+
+test('adds at root and to objects and arrays, including escaped member names', () => {
+  assert.deepEqual(applyPatch(['a', 'c'], [
+    { op: 'add', path: '/1', value: 'b' },
+    { op: 'add', path: '/-', value: 'd' },
+  ]), ['a', 'b', 'c', 'd']);
+  assert.deepEqual(applyPatch({ 'a/b': 1 }, [
+    { op: 'add', path: '/a~1b', value: 2 },
+  ]), { 'a/b': 2 });
+  assert.equal(applyPatch({ old: true }, [{ op: 'add', path: '', value: false }]), false);
+});
+
+test('does not mutate the document or retain references to patch values', () => {
+  const document = { items: [{ id: 1 }] };
+  const value = { nested: ['value'] };
+  const result = applyPatch(document, [{ op: 'add', path: '/extra', value }]);
+
+  assert.deepEqual(document, { items: [{ id: 1 }] });
+  assert.notStrictEqual(result, document);
+  assert.notStrictEqual(result.items, document.items);
+  assert.notStrictEqual(result.extra, value);
+  value.nested.push('changed');
+  assert.deepEqual(result.extra, { nested: ['value'] });
+});
+
+test('uses structural equality for test operations', () => {
+  assert.deepEqual(applyPatch({ value: { a: [1, 2], b: null } }, [
+    { op: 'test', path: '/value', value: { b: null, a: [1, 2] } },
+  ]), { value: { a: [1, 2], b: null } });
+});
+
+test('rejects malformed patches and failed operations', () => {
+  const document = { foo: ['bar'], child: { value: 1 } };
+
+  assert.throws(() => applyPatch(document, {}), TypeError);
+  assert.throws(() => applyPatch(document, [{}]), TypeError);
+  assert.throws(() => applyPatch(document, [{ op: 'unknown', path: '' }]), TypeError);
+  assert.throws(() => applyPatch(document, [{ op: 'add', path: 'foo', value: 1 }]), TypeError);
+  assert.throws(() => applyPatch(document, [{ op: 'add', path: '/foo/01', value: 1 }]));
+  assert.throws(() => applyPatch(document, [{ op: 'remove', path: '/missing' }]));
+  assert.throws(() => applyPatch(document, [{ op: 'replace', path: '/missing', value: 1 }]));
+  assert.throws(() => applyPatch(document, [{ op: 'test', path: '/foo/0', value: 'baz' }]));
+  assert.throws(() => applyPatch(document, [{ op: 'move', from: '/child', path: '/child/value/new' }]));
+  assert.throws(() => applyPatch(document, [{ op: 'copy', from: '/missing', path: '/copy' }]));
+});
