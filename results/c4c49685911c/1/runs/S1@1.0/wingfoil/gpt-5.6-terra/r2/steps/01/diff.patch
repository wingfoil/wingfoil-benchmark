diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..718c37430d8ce539273b12fe9fe7923e7d663c73
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,63 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @param document The JSON document to traverse.
+ * @param pointer The JSON Pointer string to resolve.
+ * @returns The value referenced by the pointer.
+ * @throws {TypeError} If `pointer` is not a valid JSON Pointer.
+ * @throws {Error} If the pointer does not resolve to a document value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== 'string' || (pointer !== '' && !pointer.startsWith('/'))) {
+    throw new TypeError('A JSON Pointer must be empty or start with "/".');
+  }
+
+  if (pointer === '') {
+    return document;
+  }
+
+  let value = document;
+
+  for (const token of pointer.slice(1).split('/')) {
+    const referenceToken = decodeReferenceToken(token);
+
+    if (Array.isArray(value)) {
+      value = resolveArrayElement(value, referenceToken, pointer);
+    } else if (isJsonObject(value)) {
+      if (!Object.hasOwn(value, referenceToken)) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+
+      value = value[referenceToken];
+    } else {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  if (/~(?:[^01]|$)/.test(token)) {
+    throw new TypeError(`Invalid JSON Pointer escape sequence in token: ${token}`);
+  }
+
+  return token.replace(/~1/g, '/').replace(/~0/g, '~');
+}
+
+function resolveArrayElement(array: unknown[], token: string, pointer: string): unknown {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+  }
+
+  const index = Number(token);
+  if (!Number.isSafeInteger(index) || index >= array.length) {
+    throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+  }
+
+  return array[index];
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null;
+}
diff --git a/test/json-pointer.test.mjs b/test/json-pointer.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0fdd8c9b2b4a2917dc4bc9279d016faae5fab965
--- /dev/null
+++ b/test/json-pointer.test.mjs
@@ -0,0 +1,42 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { resolvePointer } from '../dist/index.js';
+
+const document = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k\"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+test('resolves RFC 6901 example pointers', () => {
+  assert.deepEqual(resolvePointer(document, ''), document);
+  assert.deepEqual(resolvePointer(document, '/foo'), ['bar', 'baz']);
+  assert.equal(resolvePointer(document, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(document, '/'), 0);
+  assert.equal(resolvePointer(document, '/a~1b'), 1);
+  assert.equal(resolvePointer(document, '/m~0n'), 8);
+});
+
+test('resolves values that are falsy or undefined-like JSON values', () => {
+  assert.equal(resolvePointer({ a: false }, '/a'), false);
+  assert.equal(resolvePointer({ a: null }, '/a'), null);
+  assert.equal(resolvePointer({ a: 0 }, '/a'), 0);
+});
+
+test('rejects invalid or unresolved pointers', () => {
+  assert.throws(() => resolvePointer(document, 'foo'));
+  assert.throws(() => resolvePointer(document, '/m~2n'));
+  assert.throws(() => resolvePointer(document, '/foo/01'));
+  assert.throws(() => resolvePointer(document, '/foo/-'));
+  assert.throws(() => resolvePointer(document, '/foo/2'));
+  assert.throws(() => resolvePointer(document, '/missing'));
+  assert.throws(() => resolvePointer(null, '/anything'));
+});
