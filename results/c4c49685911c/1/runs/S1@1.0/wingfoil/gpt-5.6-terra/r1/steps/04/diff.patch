+id: task-004-implement-json-merge-patch
+type: task
+title: "Implement JSON Merge Patch"
+status: pending
+format: 1
+---
+
+Implemented and exported `applyMergePatch(target, patch)` in `src/index.ts` according to RFC 7386.
+
+The function validates both inputs as JSON values, applies object patches recursively, treats `null`
+object members as deletions, replaces targets with non-object patches, and does not mutate either
+input. Added RFC-derived, replacement/deletion, immutability, and invalid-input test coverage.
+
+Verification: `npm test` passes.
diff --git a/src/index.ts b/src/index.ts
index b2910682c5c5100d4265a2b668f89e778df659cd..d13b4edb1cdab67a060fff7136a412ac492106a9 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -103,11 +103,43 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   return result;
 }
 
+/**
+ * Applies an RFC 7386 JSON Merge Patch without mutating either input.
+ *
+ * @param target The JSON document to update.
+ * @param patch The JSON Merge Patch document to apply.
+ * @returns A new document containing the merged result.
+ * @throws {TypeError} If either input is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return mergePatch(cloneJson(target), cloneJson(patch));
+}
+
 type PatchOperation =
   | { op: 'add' | 'replace' | 'test'; path: string[]; value: unknown }
   | { op: 'remove'; path: string[] }
   | { op: 'move' | 'copy'; path: string[]; from: string[] };
 
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonObject(patch)) {
+    return patch;
+  }
+
+  const result: Record<string, unknown> = isJsonObject(target) ? target : {};
+  for (const [key, patchValue] of Object.entries(patch)) {
+    if (patchValue === null) {
+      delete result[key];
+    } else {
+      defineJsonMember(result, key, mergePatch(result[key], patchValue));
+    }
+  }
+  return result;
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
 function validateOperation(candidate: unknown): PatchOperation {
   if (candidate === null || typeof candidate !== 'object' || Array.isArray(candidate)) {
     throw new TypeError('Each JSON Patch operation must be an object.');
