+
+test('applies RFC 7386 object merge patches without mutating either input', () => {
+  const target = {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  };
+  const patch = {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: 'Hello!',
+    author: { givenName: 'John' },
+    tags: ['example'],
+    content: 'This will be unchanged',
+    phoneNumber: '+01-123-456-7890',
+  });
+  assert.deepEqual(target, {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  });
+  assert.deepEqual(patch, {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  });
+});
+
+test('replaces a target for non-object patches and handles null deletions', () => {
+  assert.deepEqual(applyMergePatch({ value: true }, ['replacement']), ['replacement']);
+  assert.deepEqual(applyMergePatch(['target'], { added: 1 }), { added: 1 });
+  assert.deepEqual(applyMergePatch({ retained: 1 }, { absent: null, retained: null }), {});
+});
+
+test('rejects non-JSON merge patch inputs', () => {
+  assert.throws(() => applyMergePatch({ value: 1 }, { value: Number.NaN }));
+  assert.throws(() => applyMergePatch({ value: 1 }, { value: undefined }));
+});
