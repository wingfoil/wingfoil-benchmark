--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,59 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @param document The JSON document to query.
+ * @param pointer An RFC 6901 JSON Pointer.
+ * @returns The value identified by the pointer.
+ * @throws {Error} If the pointer is malformed or does not identify a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("JSON Pointer must be a string");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error("JSON Pointer must be empty or start with '/'");
+  }
+
+  let value = document;
+  for (const referenceToken of pointer.slice(1).split("/")) {
+    const token = decodeReferenceToken(referenceToken);
+
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(token) || Number(token) >= value.length) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+      value = value[Number(token)];
+      continue;
+    }
+
+    if (value === null || typeof value !== "object" || !Object.hasOwn(value, token)) {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+    value = (value as Record<string, unknown>)[token];
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  return token.replace(/~./g, (escape) => {
+    if (escape === "~0") {
+      return "~";
+    }
+    if (escape === "~1") {
+      return "/";
+    }
+    throw new Error(`Invalid JSON Pointer escape sequence: ${escape}`);
+  }).replace(/~$/, () => {
+    throw new Error("Invalid JSON Pointer escape sequence: ~");
+  });
+}
+
+function isArrayIndex(token: string): boolean {
+  return /^(?:0|[1-9][0-9]*)$/.test(token) && Number.isSafeInteger(Number(token));
+}
diff --git a/test/index.test.mjs b/test/index.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6fc50e8de7a470ff24fbd05b4dd99daaf0799896
--- /dev/null
+++ b/test/index.test.mjs
@@ -0,0 +1,32 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { resolvePointer } from "../src/index.ts";
+
+const document = {
+  "": "root member",
+  "a/b": "slash",
+  "m~n": "tilde",
+  nested: { value: false },
+  list: ["first", { answer: 42 }, null],
+};
+
+test("resolves the root document and RFC 6901 escaped member names", () => {
+  assert.equal(resolvePointer(document, ""), document);
+  assert.equal(resolvePointer(document, "/"), "root member");
+  assert.equal(resolvePointer(document, "/a~1b"), "slash");
+  assert.equal(resolvePointer(document, "/m~0n"), "tilde");
+});
+
+test("resolves nested object members and array elements", () => {
+  assert.equal(resolvePointer(document, "/nested/value"), false);
+  assert.equal(resolvePointer(document, "/list/0"), "first");
+  assert.equal(resolvePointer(document, "/list/1/answer"), 42);
+  assert.equal(resolvePointer(document, "/list/2"), null);
+});
+
+test("rejects malformed and non-resolving pointers", () => {
+  for (const pointer of ["nested/value", "/m~2n", "/m~", "/list/01", "/list/-", "/list/3", "/nested/missing", "/list/0/value"]) {
+    assert.throws(() => resolvePointer(document, pointer));
+  }
+});
