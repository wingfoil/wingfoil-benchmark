+test('creates a compact RFC 6902 patch without mutating either document', () => {
+  const from = {
+    title: 'before',
+    unchanged: { nested: true },
+    items: [{ id: 1, label: 'one' }, { id: 2, label: 'two' }],
+  };
+  const to = {
+    title: 'after',
+    unchanged: { nested: true },
+    items: [{ id: 1, label: 'one' }, { id: 2, label: 'updated' }],
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'replace', path: '/items/1/label', value: 'updated' },
+    { op: 'replace', path: '/title', value: 'after' },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    title: 'before',
+    unchanged: { nested: true },
+    items: [{ id: 1, label: 'one' }, { id: 2, label: 'two' }],
+  });
+  assert.deepEqual(to, {
+    title: 'after',
+    unchanged: { nested: true },
+    items: [{ id: 1, label: 'one' }, { id: 2, label: 'updated' }],
+  });
+});
+
+test('creates empty, escaped, and array insertion/removal patches', () => {
+  const insertionPatch = createPatch({ value: [1, 3] }, { value: [1, 2, 3] });
+  assert.deepEqual(insertionPatch, [
+    { op: 'add', path: '/value/1', value: 2 },
+  ]);
+  assert.deepEqual(applyPatch({ value: [1, 3] }, insertionPatch), { value: [1, 2, 3] });
+  assert.deepEqual(createPatch({ 'a/b': { '~key': true } }, {}), [
+    { op: 'remove', path: '/a~1b' },
+  ]);
+  assert.deepEqual(createPatch({ value: 1 }, { value: 1 }), []);
+  assert.deepEqual(createPatch({ value: 1 }, ['replacement']), [
+    { op: 'replace', path: '', value: ['replacement'] },
+  ]);
+  assert.throws(() => createPatch({ valid: true }, { invalid: undefined }));
+});
