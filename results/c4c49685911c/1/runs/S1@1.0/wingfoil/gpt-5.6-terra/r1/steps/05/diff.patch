+/** A single operation in an RFC 6902 JSON Patch document. */
+export type JsonPatchOperation =
+  | { op: 'add' | 'replace' | 'test'; path: string; value: unknown }
+  | { op: 'remove'; path: string }
+  | { op: 'move' | 'copy'; path: string; from: string };
+
+/**
+ * Creates an RFC 6902 JSON Patch that transforms one JSON document into another.
+ *
+ * The returned patch uses structural changes where possible and does not mutate
+ * either input.
+ *
+ * @param from The original JSON document.
+ * @param to The desired JSON document.
+ * @returns A JSON Patch that transforms `from` into `to`.
+ * @throws {TypeError} If either input is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  cloneJson(from);
+  cloneJson(to);
+
+  const patch: JsonPatchOperation[] = [];
+  createPatchOperations(from, to, [], patch);
+  return patch;
+}
+
 type PatchOperation =
   | { op: 'add' | 'replace' | 'test'; path: string[]; value: unknown }
   | { op: 'remove'; path: string[] }
   | { op: 'move' | 'copy'; path: string[]; from: string[] };
 
+function createPatchOperations(
+  from: unknown,
+  to: unknown,
+  path: string[],
+  patch: JsonPatchOperation[],
+): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    const fromKeys = Object.keys(from).sort();
+    const toKeys = Object.keys(to).sort();
+
+    for (const key of fromKeys) {
+      if (!Object.hasOwn(to, key)) {
+        patch.push({ op: 'remove', path: formatPointer([...path, key]) });
+      }
+    }
+    for (const key of toKeys) {
+      if (Object.hasOwn(from, key)) {
+        createPatchOperations(from[key], to[key], [...path, key], patch);
+      } else {
+        patch.push({ op: 'add', path: formatPointer([...path, key]), value: cloneJson(to[key]) });
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatchOperations(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: 'replace', path: formatPointer(path), value: cloneJson(to) });
+}
+
+function createArrayPatchOperations(
+  from: unknown[],
+  to: unknown[],
+  path: string[],
+  patch: JsonPatchOperation[],
+): void {
+  const costs = arrayEditCosts(from, to);
+  let fromIndex = 0;
+  let toIndex = 0;
+  let resultIndex = 0;
+
+  while (fromIndex < from.length || toIndex < to.length) {
+    if (fromIndex === from.length) {
+      patch.push({ op: 'add', path: formatPointer([...path, String(resultIndex)]), value: cloneJson(to[toIndex]) });
+      toIndex += 1;
+      resultIndex += 1;
+      continue;
+    }
+    if (toIndex === to.length) {
+      patch.push({ op: 'remove', path: formatPointer([...path, String(resultIndex)]) });
+      fromIndex += 1;
+      continue;
+    }
+    if (jsonEqual(from[fromIndex], to[toIndex])) {
+      fromIndex += 1;
+      toIndex += 1;
+      resultIndex += 1;
+      continue;
+    }
+
+    const replaceCost = 1 + costs[fromIndex + 1][toIndex + 1];
+    const removeCost = 1 + costs[fromIndex + 1][toIndex];
+    const addCost = 1 + costs[fromIndex][toIndex + 1];
+    if (replaceCost <= removeCost && replaceCost <= addCost) {
+      createPatchOperations(from[fromIndex], to[toIndex], [...path, String(resultIndex)], patch);
+      fromIndex += 1;
+      toIndex += 1;
+      resultIndex += 1;
+    } else if (removeCost <= addCost) {
+      patch.push({ op: 'remove', path: formatPointer([...path, String(resultIndex)]) });
+      fromIndex += 1;
+    } else {
+      patch.push({ op: 'add', path: formatPointer([...path, String(resultIndex)]), value: cloneJson(to[toIndex]) });
+      toIndex += 1;
+      resultIndex += 1;
+    }
+  }
+}
+
+function arrayEditCosts(from: unknown[], to: unknown[]): number[][] {
+  const costs = Array.from({ length: from.length + 1 }, () => Array<number>(to.length + 1).fill(0));
+  for (let fromIndex = from.length; fromIndex >= 0; fromIndex -= 1) {
+    for (let toIndex = to.length; toIndex >= 0; toIndex -= 1) {
+      if (fromIndex === from.length) {
+        costs[fromIndex][toIndex] = to.length - toIndex;
+      } else if (toIndex === to.length) {
+        costs[fromIndex][toIndex] = from.length - fromIndex;
+      } else if (jsonEqual(from[fromIndex], to[toIndex])) {
+        costs[fromIndex][toIndex] = costs[fromIndex + 1][toIndex + 1];
+      } else {
+        costs[fromIndex][toIndex] = 1 + Math.min(
+          costs[fromIndex + 1][toIndex + 1],
+          costs[fromIndex + 1][toIndex],
+          costs[fromIndex][toIndex + 1],
+        );
+      }
+    }
+  }
+  return costs;
+}
+
+function formatPointer(tokens: string[]): string {
+  return tokens.map((token) => `/${token.replaceAll('~', '~0').replaceAll('/', '~1')}`).join('');
+}
