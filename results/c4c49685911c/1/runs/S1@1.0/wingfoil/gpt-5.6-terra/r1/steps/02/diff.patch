index 102e1b4463d8635ea0e1a21d18b67debc0131b95..b2910682c5c5100d4265a2b668f89e778df659cd 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -49,6 +49,256 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   return value;
 }
 
+/**
+ * Applies an RFC 6902 JSON Patch without mutating the source document.
+ *
+ * @param document The JSON document to update.
+ * @param patch The array of JSON Patch operations.
+ * @returns A new document containing the applied operations.
+ * @throws {TypeError} If the document, patch, or an operation is malformed.
+ * @throws {Error} If an operation cannot be applied or a `test` fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  let result = cloneJson(document);
+
+  if (!Array.isArray(patch)) {
+    throw new TypeError('A JSON Patch must be an array of operations.');
+  }
+
+  for (const candidate of patch) {
+    const operation = validateOperation(candidate);
+
+    switch (operation.op) {
+      case 'add':
+        result = addValue(result, operation.path, operation.value);
+        break;
+      case 'remove':
+        result = removeValue(result, operation.path).document;
+        break;
+      case 'replace':
+        getValue(result, operation.path);
+        result = addValue(result, operation.path, operation.value);
+        break;
+      case 'move': {
+        if (isProperPrefix(operation.from, operation.path)) {
+          throw new Error('A JSON Patch move cannot move a value into one of its children.');
+        }
+
+        const source = getValue(result, operation.from);
+        result = removeValue(result, operation.from).document;
+        result = addValue(result, operation.path, source);
+        break;
+      }
+      case 'copy':
+        result = addValue(result, operation.path, getValue(result, operation.from));
+        break;
+      case 'test':
+        if (!jsonEqual(getValue(result, operation.path), operation.value)) {
+          throw new Error('A JSON Patch test operation failed.');
+        }
+        break;
+    }
+  }
+
+  return result;
+}
+
+type PatchOperation =
+  | { op: 'add' | 'replace' | 'test'; path: string[]; value: unknown }
+  | { op: 'remove'; path: string[] }
+  | { op: 'move' | 'copy'; path: string[]; from: string[] };
+
+function validateOperation(candidate: unknown): PatchOperation {
+  if (candidate === null || typeof candidate !== 'object' || Array.isArray(candidate)) {
+    throw new TypeError('Each JSON Patch operation must be an object.');
+  }
+
+  const operation = candidate as Record<string, unknown>;
+  if (typeof operation.op !== 'string' || !Object.hasOwn(operation, 'op')) {
+    throw new TypeError('A JSON Patch operation must have an "op" string member.');
+  }
+  if (typeof operation.path !== 'string' || !Object.hasOwn(operation, 'path')) {
+    throw new TypeError('A JSON Patch operation must have a "path" string member.');
+  }
+
+  const path = parsePointer(operation.path);
+  switch (operation.op) {
+    case 'add':
+    case 'replace':
+    case 'test':
+      if (!Object.hasOwn(operation, 'value')) {
+        throw new TypeError(`A JSON Patch ${operation.op} operation must have a "value" member.`);
+      }
+      cloneJson(operation.value);
+      return { op: operation.op, path, value: operation.value };
+    case 'remove':
+      return { op: 'remove', path };
+    case 'move':
+    case 'copy':
+      if (typeof operation.from !== 'string' || !Object.hasOwn(operation, 'from')) {
+        throw new TypeError(`A JSON Patch ${operation.op} operation must have a "from" string member.`);
+      }
+      return { op: operation.op, path, from: parsePointer(operation.from) };
+    default:
+      throw new TypeError(`Unsupported JSON Patch operation "${operation.op}".`);
+  }
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === '') {
+    return [];
+  }
+  if (!pointer.startsWith('/')) {
+    throw new TypeError('A non-empty JSON Pointer must begin with a slash.');
+  }
+  return pointer.slice(1).split('/').map(decodeReferenceToken);
+}
+
+function getValue(document: unknown, tokens: string[]): unknown {
+  let value = document;
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      const index = arrayIndex(token, value.length, false);
+      value = value[index];
+      continue;
+    }
+    if (value === null || typeof value !== 'object' || !Object.hasOwn(value, token)) {
+      throw new Error(`JSON Patch path does not exist at "${token}".`);
+    }
+    value = (value as Record<string, unknown>)[token];
+  }
+  return value;
+}
+
+function addValue(document: unknown, tokens: string[], value: unknown): unknown {
+  const addedValue = cloneJson(value);
+  if (tokens.length === 0) {
+    return addedValue;
+  }
+
+  const parent = getValue(document, tokens.slice(0, -1));
+  const token = tokens.at(-1)!;
+  if (Array.isArray(parent)) {
+    const index = arrayIndex(token, parent.length, true);
+    parent.splice(index, 0, addedValue);
+  } else if (parent !== null && typeof parent === 'object') {
+    defineJsonMember(parent as Record<string, unknown>, token, addedValue);
+  } else {
+    throw new Error('JSON Patch path parent is not an object or array.');
+  }
+  return document;
+}
+
+function removeValue(document: unknown, tokens: string[]): { document: unknown; value: unknown } {
+  if (tokens.length === 0) {
+    return { document: undefined, value: document };
+  }
+
+  const parent = getValue(document, tokens.slice(0, -1));
+  const token = tokens.at(-1)!;
+  if (Array.isArray(parent)) {
+    const index = arrayIndex(token, parent.length, false);
+    return { document, value: parent.splice(index, 1)[0] };
+  }
+  if (parent === null || typeof parent !== 'object' || !Object.hasOwn(parent, token)) {
+    throw new Error(`JSON Patch path does not exist at "${token}".`);
+  }
+  const value = (parent as Record<string, unknown>)[token];
+  delete (parent as Record<string, unknown>)[token];
+  return { document, value };
+}
+
+function arrayIndex(token: string, length: number, allowAppend: boolean): number {
+  if (allowAppend && token === '-') {
+    return length;
+  }
+  if (!/^(?:0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`JSON Patch array index "${token}" is invalid.`);
+  }
+  const index = Number(token);
+  if (!Number.isSafeInteger(index) || index >= length + (allowAppend ? 1 : 0)) {
+    throw new Error(`JSON Patch array index "${token}" is absent.`);
+  }
+  return index;
+}
+
+function isProperPrefix(prefix: string[], path: string[]): boolean {
+  return prefix.length < path.length && prefix.every((token, index) => path[index] === token);
+}
+
+function jsonEqual(left: unknown, right: unknown): boolean {
+  if (left === right) {
+    return true;
+  }
+  if (typeof left !== typeof right || left === null || right === null) {
+    return false;
+  }
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return Array.isArray(left) && Array.isArray(right)
+      && left.length === right.length
+      && left.every((value, index) => jsonEqual(value, right[index]));
+  }
+  if (typeof left !== 'object') {
+    return false;
+  }
+  const leftObject = left as Record<string, unknown>;
+  const rightObject = right as Record<string, unknown>;
+  const leftKeys = Object.keys(leftObject);
+  const rightKeys = Object.keys(rightObject);
+  return leftKeys.length === rightKeys.length
+    && leftKeys.every((key) => Object.hasOwn(rightObject, key) && jsonEqual(leftObject[key], rightObject[key]));
+}
+
+function cloneJson(value: unknown, ancestors = new Set<object>()): unknown {
+  if (value === null || typeof value === 'string' || typeof value === 'boolean') {
+    return value;
+  }
+  if (typeof value === 'number') {
+    if (!Number.isFinite(value)) {
+      throw new TypeError('A JSON value cannot be an infinite or NaN number.');
+    }
+    return value;
+  }
+  if (typeof value !== 'object') {
+    throw new TypeError('The document and patch values must be JSON values.');
+  }
+  if (ancestors.has(value)) {
+    throw new TypeError('The document and patch values must not contain cycles.');
+  }
+
+  ancestors.add(value);
+  try {
+    if (Array.isArray(value)) {
+      const clone: unknown[] = [];
+      for (let index = 0; index < value.length; index += 1) {
+        if (!Object.hasOwn(value, index)) {
+          throw new TypeError('A JSON array must not contain holes.');
+        }
+        clone.push(cloneJson(value[index], ancestors));
+      }
+      if (Object.keys(value).length !== value.length) {
+        throw new TypeError('A JSON array must not have non-index properties.');
+      }
+      return clone;
+    }
+    const prototype = Object.getPrototypeOf(value);
+    if (prototype !== Object.prototype && prototype !== null) {
+      throw new TypeError('A JSON object must be a plain object.');
+    }
+    const clone: Record<string, unknown> = {};
+    for (const [key, nestedValue] of Object.entries(value)) {
+      defineJsonMember(clone, key, cloneJson(nestedValue, ancestors));
+    }
+    return clone;
+  } finally {
+    ancestors.delete(value);
+  }
+}
+
+function defineJsonMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { configurable: true, enumerable: true, value, writable: true });
+}
+
 function decodeReferenceToken(referenceToken: string): string {
   let token = '';
 
