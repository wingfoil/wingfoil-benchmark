+
+test('applies all RFC 6902 operations without mutating the source document', () => {
+  const source = {
+    foo: ['bar', 'baz'],
+    nested: { value: 1 },
+  };
+  const patch = [
+    { op: 'add', path: '/foo/1', value: 'qux' },
+    { op: 'replace', path: '/nested/value', value: 2 },
+    { op: 'copy', from: '/nested', path: '/copied' },
+    { op: 'move', from: '/foo/0', path: '/moved' },
+    { op: 'remove', path: '/foo/1' },
+    { op: 'test', path: '/copied/value', value: 2 },
+  ];
+
+  assert.deepEqual(applyPatch(source, patch), {
+    foo: ['qux'],
+    nested: { value: 2 },
+    copied: { value: 2 },
+    moved: 'bar',
+  });
+  assert.deepEqual(source, {
+    foo: ['bar', 'baz'],
+    nested: { value: 1 },
+  });
+});
+
+test('supports append, escaped paths, and replacing the whole document', () => {
+  assert.deepEqual(
+    applyPatch({ 'a/b': { '~key': [] } }, [
+      { op: 'add', path: '/a~1b/~0key/-', value: true },
+    ]),
+    { 'a/b': { '~key': [true] } },
+  );
+  assert.deepEqual(applyPatch({ before: true }, [{ op: 'replace', path: '', value: ['after'] }]), ['after']);
+});
+
+test('rejects malformed patches and operations that cannot be applied', () => {
+  assert.throws(() => applyPatch({}, {}));
+  assert.throws(() => applyPatch({}, [{ op: 'unknown', path: '' }]));
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: 'missing-slash', value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: 'remove', path: '/missing' }]));
+  assert.throws(() => applyPatch({ list: [] }, [{ op: 'add', path: '/list/1', value: 1 }]));
+  assert.throws(() => applyPatch({ value: 1 }, [{ op: 'test', path: '/value', value: 2 }]));
+  assert.throws(() => applyPatch({ a: {} }, [{ op: 'move', from: '/a', path: '/a/child' }]));
+});
