diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..102e1b4463d8635ea0e1a21d18b67debc0131b95
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,76 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @param document The JSON document to traverse.
+ * @param pointer A JSON Pointer string.
+ * @returns The value identified by the pointer.
+ * @throws {TypeError} If `pointer` is not a valid JSON Pointer.
+ * @throws {Error} If the pointer does not identify a value in `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== 'string') {
+    throw new TypeError('A JSON Pointer must be a string.');
+  }
+
+  if (pointer === '') {
+    return document;
+  }
+
+  if (!pointer.startsWith('/')) {
+    throw new TypeError('A non-empty JSON Pointer must begin with a slash.');
+  }
+
+  let value = document;
+
+  for (const referenceToken of pointer.slice(1).split('/')) {
+    const token = decodeReferenceToken(referenceToken);
+
+    if (Array.isArray(value)) {
+      if (!/^(?:0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`JSON Pointer does not resolve: invalid array index "${token}".`);
+      }
+
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= value.length) {
+        throw new Error(`JSON Pointer does not resolve: array index "${token}" is absent.`);
+      }
+
+      value = value[index];
+      continue;
+    }
+
+    if (value === null || typeof value !== 'object' || !Object.hasOwn(value, token)) {
+      throw new Error(`JSON Pointer does not resolve: member "${token}" is absent.`);
+    }
+
+    value = (value as Record<string, unknown>)[token];
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(referenceToken: string): string {
+  let token = '';
+
+  for (let position = 0; position < referenceToken.length; position += 1) {
+    const character = referenceToken[position];
+
+    if (character !== '~') {
+      token += character;
+      continue;
+    }
+
+    const escape = referenceToken[position + 1];
+    if (escape === '0') {
+      token += '~';
+    } else if (escape === '1') {
+      token += '/';
+    } else {
+      throw new TypeError('A JSON Pointer reference token contains an invalid escape sequence.');
+    }
+
+    position += 1;
+  }
+
+  return token;
+}
diff --git a/test/index.test.mjs b/test/index.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..63be16b6d48052b676cff8d7f108c52662a0e876
--- /dev/null
+++ b/test/index.test.mjs
@@ -0,0 +1,29 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { resolvePointer } from '../dist/index.js';
+
+const document = {
+  '': 'empty key',
+  a: {
+    'b/c': { '~key': 'escaped value' },
+  },
+  array: ['first', null, { value: false }],
+};
+
+test('resolves RFC 6901 reference tokens', () => {
+  assert.equal(resolvePointer(document, ''), document);
+  assert.equal(resolvePointer(document, '/'), 'empty key');
+  assert.equal(resolvePointer(document, '/a/b~1c/~0key'), 'escaped value');
+  assert.equal(resolvePointer(document, '/array/1'), null);
+  assert.equal(resolvePointer(document, '/array/2/value'), false);
+});
+
+test('rejects invalid pointers and missing values', () => {
+  assert.throws(() => resolvePointer(document, 'a/b'));
+  assert.throws(() => resolvePointer(document, '/a/b~2c'));
+  assert.throws(() => resolvePointer(document, '/array/01'));
+  assert.throws(() => resolvePointer(document, '/array/3'));
+  assert.throws(() => resolvePointer(document, '/missing'));
+  assert.throws(() => resolvePointer(document, '/array/0/value'));
+});
