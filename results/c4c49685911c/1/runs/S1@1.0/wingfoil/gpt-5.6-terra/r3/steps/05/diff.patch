+test("creates a granular patch that transforms JSON without mutating either input", () => {
+  const from = {
+    unchanged: true,
+    "a/b": { "m~n": "before", remove: true },
+    items: ["first", "last"],
+  };
+  const to = {
+    unchanged: true,
+    "a/b": { "m~n": "after", added: true },
+    items: ["first", "middle", "last"],
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/a~1b/remove" },
+    { op: "replace", path: "/a~1b/m~0n", value: "after" },
+    { op: "add", path: "/a~1b/added", value: true },
+    { op: "add", path: "/items/1", value: "middle" },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    unchanged: true,
+    "a/b": { "m~n": "before", remove: true },
+    items: ["first", "last"],
+  });
+  assert.deepEqual(to, {
+    unchanged: true,
+    "a/b": { "m~n": "after", added: true },
+    items: ["first", "middle", "last"],
+  });
+});
 
