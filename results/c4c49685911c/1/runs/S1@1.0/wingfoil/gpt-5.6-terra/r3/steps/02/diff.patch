index 0000000000000000000000000000000000000000..7a092f5a2a755c503865b1372eb6edb528c9f33d
--- /dev/null
+++ b/test/applyPatch.test.ts
@@ -0,0 +1,99 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyPatch } from "../src/index.ts";
+
+test("applies add, remove, replace, move, copy, and test operations in order", () => {
+  const document = {
+    foo: ["bar", "baz"],
+    nested: { source: { enabled: true } },
+  };
+
+  const result = applyPatch(document, [
+    { op: "add", path: "/foo/1", value: "qux" },
+    { op: "remove", path: "/foo/0" },
+    { op: "replace", path: "/nested/source/enabled", value: false },
+    { op: "copy", from: "/nested/source", path: "/copied" },
+    { op: "move", from: "/foo/1", path: "/foo/-" },
+    { op: "test", path: "/copied/enabled", value: false },
+  ]);
+
+  assert.deepEqual(result, {
+    foo: ["qux", "baz"],
+    nested: { source: { enabled: false } },
+    copied: { enabled: false },
+  });
+  assert.deepEqual(document, {
+    foo: ["bar", "baz"],
+    nested: { source: { enabled: true } },
+  });
+});
+
+test("supports replacing and adding the document root", () => {
+  assert.equal(applyPatch("before", [{ op: "replace", path: "", value: "after" }]), "after");
+  assert.deepEqual(applyPatch({ before: true }, [{ op: "add", path: "", value: [1, 2] }]), [1, 2]);
+});
+
+test("adds object properties and appends arrays using RFC 6901 escaped paths", () => {
+  assert.deepEqual(
+    applyPatch({ "a/b": [] }, [{ op: "add", path: "/a~1b/-", value: { "m~n": 1 } }]),
+    { "a/b": [{ "m~n": 1 }] },
+  );
+});
+
+test("moves within an array after removing the source", () => {
+  assert.deepEqual(
+    applyPatch({ values: ["a", "b", "c"] }, [{ op: "move", from: "/values/0", path: "/values/2" }]),
+    { values: ["b", "c", "a"] },
+  );
+});
+
+test("copies values by value rather than sharing mutable descendants", () => {
+  const result = applyPatch(
+    { source: { items: [1] } },
+    [
+      { op: "copy", from: "/source", path: "/copy" },
+      { op: "add", path: "/copy/items/-", value: 2 },
+    ],
+  );
+
+  assert.deepEqual(result, { source: { items: [1] }, copy: { items: [1, 2] } });
+});
+
+test("rejects invalid patch operations, invalid paths, missing locations, and failed tests", () => {
+  const document = { values: [1], nested: { value: true } };
+
+  for (const patch of [
+    {},
+    [{ op: "unknown", path: "/values" }],
+    [{ op: "add", path: "/values/3", value: 2 }],
+    [{ op: "remove", path: "/missing" }],
+    [{ op: "replace", path: "/nested/missing", value: false }],
+    [{ op: "move", from: "/nested", path: "/nested/child" }],
+    [{ op: "test", path: "/nested/value", value: false }],
+    [{ op: "add", path: "invalid", value: true }],
+  ]) {
+    assert.throws(() => applyPatch(document, patch));
+  }
+
+  assert.deepEqual(document, { values: [1], nested: { value: true } });
+});
+
+test("requires operation members with their RFC 6902 types", () => {
+  for (const patch of [
+    [{ path: "/value", value: 1 }],
+    [{ op: "add", path: "/value" }],
+    [{ op: "remove", path: 1 }],
+    [{ op: "copy", path: "/value" }],
+    [{ op: "test", path: "/value" }],
+  ]) {
+    assert.throws(() => applyPatch({}, patch));
+  }
+});
+
+test("tests objects by JSON structure rather than member insertion order", () => {
+  assert.deepEqual(
+    applyPatch({ value: { first: 1, second: 2 } }, [{ op: "test", path: "/value", value: { second: 2, first: 1 } }]),
+    { value: { first: 1, second: 2 } },
+  );
+});
