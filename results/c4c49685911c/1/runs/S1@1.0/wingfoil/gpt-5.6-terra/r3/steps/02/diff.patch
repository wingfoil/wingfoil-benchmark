+/**
+ * Applies an RFC 6902 JSON Patch without mutating the source document.
+ *
+ * @throws {Error} If the document or patch is not valid JSON, an operation is invalid, or an
+ * operation cannot be applied.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  assertJsonValue(document, "document");
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: it must be an array of operations");
+  }
+
+  let result = cloneJsonValue(document);
+
+  for (const operation of patch) {
+    result = applyOperation(result, operation);
+  }
+
+  return result;
+}
+
+function applyOperation(document: unknown, rawOperation: unknown): unknown {
+  if (!isObject(rawOperation) || Array.isArray(rawOperation)) {
+    throw new Error("Invalid JSON Patch operation: it must be an object");
+  }
+
+  const operation = rawOperation;
+  const op = requiredStringMember(operation, "op");
+  const path = requiredStringMember(operation, "path");
+  const tokens = parsePointer(path);
+
+  switch (op) {
+    case "add":
+      return addValue(document, tokens, cloneRequiredValue(operation));
+    case "remove":
+      return removeValue(document, tokens);
+    case "replace":
+      return replaceValue(document, tokens, cloneRequiredValue(operation));
+    case "move": {
+      const from = parsePointer(requiredStringMember(operation, "from"));
+      if (isProperPrefix(from, tokens)) {
+        throw new Error("Invalid move operation: the destination cannot be inside the source");
+      }
+
+      const value = cloneJsonValue(getValue(document, from));
+      return addValue(removeValue(document, from), tokens, value);
+    }
+    case "copy": {
+      const from = parsePointer(requiredStringMember(operation, "from"));
+      return addValue(document, tokens, cloneJsonValue(getValue(document, from)));
+    }
+    case "test": {
+      const expected = cloneRequiredValue(operation);
+      if (!jsonEqual(getValue(document, tokens), expected)) {
+        throw new Error(`JSON Patch test operation failed at path '${path}'`);
+      }
+
+      return document;
+    }
+    default:
+      throw new Error(`Invalid JSON Patch operation: unsupported op '${op}'`);
+  }
+}
+
+function addValue(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return value;
+  }
+
+  const { parent, token } = getParent(document, tokens);
+  if (Array.isArray(parent)) {
+    if (token === "-") {
+      parent.push(value);
+      return document;
+    }
+
+    const index = parseArrayIndex(token, parent.length, true);
+    parent.splice(index, 0, value);
+    return document;
+  }
+
+  if (isObject(parent)) {
+    setObjectMember(parent, token, value);
+    return document;
+  }
+
+  throw new Error("JSON Patch path does not identify an object or array");
+}
+
+function removeValue(document: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) {
+    throw new Error("JSON Patch cannot remove the document root");
+  }
+
+  const { parent, token } = getParent(document, tokens);
+  if (Array.isArray(parent)) {
+    const index = parseArrayIndex(token, parent.length, false);
+    parent.splice(index, 1);
+    return document;
+  }
+
+  if (isObject(parent)) {
+    if (!Object.hasOwn(parent, token)) {
+      throw new Error(`JSON Patch path does not exist: '${pointerFromTokens(tokens)}'`);
+    }
+
+    delete parent[token];
+    return document;
+  }
+
+  throw new Error("JSON Patch path does not identify an object or array");
+}
+
+function replaceValue(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return value;
+  }
+
+  const { parent, token } = getParent(document, tokens);
+  if (Array.isArray(parent)) {
+    parent[parseArrayIndex(token, parent.length, false)] = value;
+    return document;
+  }
+
+  if (isObject(parent)) {
+    if (!Object.hasOwn(parent, token)) {
+      throw new Error(`JSON Patch path does not exist: '${pointerFromTokens(tokens)}'`);
+    }
+
+    setObjectMember(parent, token, value);
+    return document;
+  }
+
+  throw new Error("JSON Patch path does not identify an object or array");
+}
+
+function getParent(document: unknown, tokens: string[]): { parent: unknown; token: string } {
+  return { parent: getValue(document, tokens.slice(0, -1)), token: tokens.at(-1)! };
+}
+
+function getValue(document: unknown, tokens: string[]): unknown {
+  let value = document;
+
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      value = value[parseArrayIndex(token, value.length, false)];
+    } else if (isObject(value) && Object.hasOwn(value, token)) {
+      value = value[token];
+    } else {
+      throw new Error(`JSON Patch path does not exist: '${pointerFromTokens(tokens)}'`);
+    }
+  }
+
+  return value;
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error("Invalid JSON Pointer: it must be empty or start with '/'");
+  }
+
+  return pointer.slice(1).split("/").map(decodeReferenceToken);
+}
+
+function parseArrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (!/^(?:0|[1-9][0-9]*)$/u.test(token)) {
+    throw new Error(`Invalid JSON Patch array index: '${token}'`);
+  }
+
+  const index = Number(token);
+  const maximum = allowEnd ? length : length - 1;
+  if (!Number.isSafeInteger(index) || index > maximum) {
+    throw new Error(`JSON Patch array index is out of bounds: '${token}'`);
+  }
+
+  return index;
+}
+
+function requiredStringMember(operation: Record<string, unknown>, name: string): string {
+  const descriptor = Object.getOwnPropertyDescriptor(operation, name);
+  if (descriptor === undefined || !("value" in descriptor) || typeof descriptor.value !== "string") {
+    throw new Error(`Invalid JSON Patch operation: '${name}' must be a string`);
+  }
+
+  return descriptor.value;
+}
+
+function cloneRequiredValue(operation: Record<string, unknown>): unknown {
+  const descriptor = Object.getOwnPropertyDescriptor(operation, "value");
+  if (descriptor === undefined || !("value" in descriptor)) {
+    throw new Error("Invalid JSON Patch operation: 'value' is required");
+  }
+
+  assertJsonValue(descriptor.value, "operation value");
+  return cloneJsonValue(descriptor.value);
+}
+
+function isProperPrefix(prefix: string[], value: string[]): boolean {
+  return prefix.length < value.length && prefix.every((token, index) => token === value[index]);
+}
+
+function pointerFromTokens(tokens: string[]): string {
+  return `/${tokens.map((token) => token.replace(/~/gu, "~0").replace(/\//gu, "~1")).join("/")}`;
+}
+
+function setObjectMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { configurable: true, enumerable: true, value, writable: true });
+}
+
+function cloneJsonValue(value: unknown): unknown {
+  if (Array.isArray(value)) {
+    return value.map(cloneJsonValue);
+  }
+  if (isObject(value)) {
+    const clone: Record<string, unknown> = {};
+    for (const [key, member] of Object.entries(value)) {
+      setObjectMember(clone, key, cloneJsonValue(member));
+    }
+    return clone;
+  }
+
+  return value;
+}
+
+function assertJsonValue(value: unknown, name: string, seen = new WeakSet<object>()): void {
+  if (value === null || typeof value === "string" || typeof value === "boolean") {
+    return;
+  }
+  if (typeof value === "number") {
+    if (Number.isFinite(value)) {
+      return;
+    }
+    throw new Error(`Invalid JSON ${name}: numbers must be finite`);
+  }
+  if (!isObject(value)) {
+    throw new Error(`Invalid JSON ${name}`);
+  }
+  const prototype = Object.getPrototypeOf(value);
+  if (!Array.isArray(value) && prototype !== Object.prototype && prototype !== null) {
+    throw new Error(`Invalid JSON ${name}: objects must be plain objects`);
+  }
+  if (Object.getOwnPropertySymbols(value).length > 0) {
+    throw new Error(`Invalid JSON ${name}: symbol properties are not supported`);
+  }
+  if (seen.has(value)) {
+    throw new Error(`Invalid JSON ${name}: cyclic values are not supported`);
+  }
+  seen.add(value);
+
+  if (Array.isArray(value)) {
+    for (const key of Object.getOwnPropertyNames(value)) {
+      if (key !== "length" && !/^(?:0|[1-9][0-9]*)$/u.test(key)) {
+        throw new Error(`Invalid JSON ${name}: arrays cannot have named properties`);
+      }
+    }
+    for (let index = 0; index < value.length; index += 1) {
+      const descriptor = Object.getOwnPropertyDescriptor(value, String(index));
+      if (descriptor === undefined || !("value" in descriptor)) {
+        throw new Error(`Invalid JSON ${name}: sparse arrays are not supported`);
+      }
+      assertJsonValue(descriptor.value, name, seen);
+    }
+  } else {
+    for (const key of Object.getOwnPropertyNames(value)) {
+      const descriptor = Object.getOwnPropertyDescriptor(value, key)!;
+      if (!descriptor.enumerable || !("value" in descriptor)) {
+        throw new Error(`Invalid JSON ${name}: object members must be enumerable data properties`);
+      }
+      assertJsonValue(descriptor.value, name, seen);
+    }
+  }
+
+  seen.delete(value);
+}
+
+function jsonEqual(left: unknown, right: unknown): boolean {
+  if (left === right) {
+    return true;
+  }
+  if (typeof left !== "object" || left === null || typeof right !== "object" || right === null) {
+    return false;
+  }
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return Array.isArray(left) && Array.isArray(right) && left.length === right.length && left.every((value, index) => jsonEqual(value, right[index]));
+  }
+
+  const leftEntries = Object.entries(left);
+  const rightEntries = Object.entries(right);
+  return leftEntries.length === rightEntries.length && leftEntries.every(([key, value]) => Object.hasOwn(right, key) && jsonEqual(value, right[key]));
+}
+
 function decodeReferenceToken(token: string): string {
   if (/~(?:[^01]|$)/u.test(token)) {
     throw new Error(`Invalid JSON Pointer escape sequence in token: ${token}`);
