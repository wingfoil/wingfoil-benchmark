+
+## Work completed
+
+Implemented and exported `applyMergePatch(target, patch)` according to RFC 7386. Object patches merge
+recursively, `null` members remove object members, and non-object patches replace the target. Inputs
+are validated as JSON values and results are independent of both input values.
+
+Added RFC-based merge, deletion, replacement, non-object-target, and invalid-input tests. Updated the
+README with the public API and verified the suite with `npm test`.
diff --git a/src/index.ts b/src/index.ts
index efbb9811f62b0ea4c08338a666ed644623b0d596..13308942a434ca0d98cbec9838db038552c5f0e5 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -55,6 +55,37 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   return result;
 }
 
+/**
+ * Applies an RFC 7386 JSON Merge Patch without mutating either supplied JSON value.
+ *
+ * @throws {Error} If the target or patch is not a valid JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJsonValue(target, "target");
+  assertJsonValue(patch, "patch");
+
+  return mergePatch(target, patch);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonObject(patch)) {
+    return cloneJsonValue(patch);
+  }
+
+  const result: Record<string, unknown> = isJsonObject(target)
+    ? cloneJsonValue(target) as Record<string, unknown>
+    : {};
+  for (const [name, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[name];
+    } else {
+      setObjectMember(result, name, mergePatch(result[name], value));
+    }
+  }
+
+  return result;
+}
+
 function applyOperation(document: unknown, rawOperation: unknown): unknown {
   if (!isObject(rawOperation) || Array.isArray(rawOperation)) {
     throw new Error("Invalid JSON Patch operation: it must be an object");
@@ -352,3 +383,7 @@ function resolveArrayElement(array: unknown[], token: string): unknown {
 function isObject(value: unknown): value is Record<string, unknown> {
   return typeof value === "object" && value !== null;
 }
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return isObject(value) && !Array.isArray(value);
+}
diff --git a/test/applyMergePatch.test.ts b/test/applyMergePatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4bceda71bdc2524d903221dae8dfe7f91aea5fec
--- /dev/null
+++ b/test/applyMergePatch.test.ts
@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyMergePatch } from "../src/index.ts";
+
+test("merges object members and removes members assigned null", () => {
+  const target = {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+  assert.deepEqual(target, {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  });
+  assert.deepEqual(patch, {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  });
+});
+
+test("treats a non-object target as an empty object when applying an object patch", () => {
+  assert.deepEqual(applyMergePatch([1, 2], { nested: { enabled: true } }), {
+    nested: { enabled: true },
+  });
+  assert.deepEqual(applyMergePatch("before", { removed: null, added: "after" }), { added: "after" });
+});
+
+test("replaces the target when the patch is not an object, including null", () => {
+  assert.deepEqual(applyMergePatch({ values: [1] }, ["replacement"]), ["replacement"]);
+  assert.equal(applyMergePatch({ value: true }, null), null);
+});
+
+test("rejects targets and patches that are not JSON values", () => {
+  assert.throws(() => applyMergePatch({ value: true }, { ignored: undefined }));
+  assert.throws(() => applyMergePatch(undefined, { value: true }));
+});
