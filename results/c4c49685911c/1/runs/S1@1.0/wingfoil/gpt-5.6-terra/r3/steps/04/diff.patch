@@ -29,3 +29,16 @@ import { applyPatch } from "json-toolkit";
 applyPatch({ items: ["first"] }, [{ op: "add", path: "/items/-", value: "next" }]);
 // { items: ["first", "next"] }
 ```
+
+## JSON Merge Patch
+
+`applyMergePatch(target, patch)` applies an RFC 7386 JSON Merge Patch. Object members in the patch
+are merged recursively, while a member with a `null` value removes that member. A non-object patch
+replaces the target. It returns a new JSON value and never mutates either supplied value.
+
+```ts
+import { applyMergePatch } from "json-toolkit";
+
+applyMergePatch({ title: "Draft", author: { name: "Avery" } }, { title: "Published", author: { name: null } });
+// { title: "Published", author: {} }
+```
