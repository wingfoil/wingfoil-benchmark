@@ -0,0 +1,59 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @throws {Error} If the pointer syntax is invalid or it does not identify a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (!pointer.startsWith("/")) {
+    if (pointer === "") {
+      return document;
+    }
+
+    throw new Error("Invalid JSON Pointer: it must be empty or start with '/'");
+  }
+
+  let value = document;
+
+  for (const token of pointer.slice(1).split("/")) {
+    const referenceToken = decodeReferenceToken(token);
+
+    if (Array.isArray(value)) {
+      value = resolveArrayElement(value, referenceToken);
+    } else if (isObject(value)) {
+      if (!Object.hasOwn(value, referenceToken)) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+
+      value = value[referenceToken];
+    } else {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  if (/~(?:[^01]|$)/u.test(token)) {
+    throw new Error(`Invalid JSON Pointer escape sequence in token: ${token}`);
+  }
+
+  return token.replace(/~1/gu, "/").replace(/~0/gu, "~");
+}
+
+function resolveArrayElement(array: unknown[], token: string): unknown {
+  if (!/^(?:0|[1-9][0-9]*)$/u.test(token)) {
+    throw new Error(`JSON Pointer does not resolve: invalid array index '${token}'`);
+  }
+
+  const index = Number(token);
+  if (!Number.isSafeInteger(index) || index >= array.length || !Object.hasOwn(array, index)) {
+    throw new Error(`JSON Pointer does not resolve: array index '${token}' is absent`);
+  }
+
+  return array[index];
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null;
+}
diff --git a/test/resolvePointer.test.ts b/test/resolvePointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..48182271728a107dee185b2ca172fe79b37b3c95
--- /dev/null
+++ b/test/resolvePointer.test.ts
@@ -0,0 +1,31 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { resolvePointer } from "../src/index.ts";
+
+const document = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "m~n": 8,
+  "~1": 9,
+  nested: { enabled: false, value: null },
+};
+
+test("resolves RFC 6901 reference tokens", () => {
+  assert.equal(resolvePointer(document, ""), document);
+  assert.deepEqual(resolvePointer(document, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(document, "/foo/0"), "bar");
+  assert.equal(resolvePointer(document, "/"), 0);
+  assert.equal(resolvePointer(document, "/a~1b"), 1);
+  assert.equal(resolvePointer(document, "/m~0n"), 8);
+  assert.equal(resolvePointer(document, "/~01"), 9);
+  assert.equal(resolvePointer(document, "/nested/enabled"), false);
+  assert.equal(resolvePointer(document, "/nested/value"), null);
+});
+
+test("rejects malformed pointers and unresolved values", () => {
+  for (const pointer of ["foo", "/m~n", "/m~2n", "/foo/01", "/foo/-", "/foo/2", "/missing", "/nested/value/property"]) {
+    assert.throws(() => resolvePointer(document, pointer));
+  }
+});
