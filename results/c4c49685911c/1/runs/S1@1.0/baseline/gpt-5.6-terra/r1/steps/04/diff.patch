+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document.
+ *
+ * Object members with a `null` patch value are removed. Other object members
+ * are recursively merged, while every non-object patch value replaces the
+ * corresponding target value. The supplied target and patch are never
+ * modified.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  // Clone both inputs before merging. Besides preserving caller-owned values,
+  // this rejects values that cannot occur in a JSON document.
+  return mergePatch(cloneJson(target), cloneJson(patch));
+}
+
 type JsonObject = Record<string, unknown>;
 
 function isObject(value: unknown): value is JsonObject {
   return value !== null && typeof value === "object";
 }
 
+function isJsonObject(value: unknown): value is JsonObject {
+  return isObject(value) && !Array.isArray(value);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  // RFC 7386 defines recursion only for JSON objects. Arrays, like all other
+  // non-object JSON values, are replaced as a whole.
+  if (!isJsonObject(patch)) {
+    return patch;
+  }
+
+  const result: JsonObject = isJsonObject(target) ? target : {};
+
+  for (const name of Object.keys(patch)) {
+    const value = patch[name];
+    if (value === null) {
+      delete result[name];
+    } else {
+      setObjectMember(result, name, mergePatch(result[name], value));
+    }
+  }
+
+  return result;
+}
+
 function requiredString(operation: JsonObject, member: string): string {
   if (!Object.prototype.hasOwnProperty.call(operation, member) || typeof operation[member] !== "string") {
     throw new Error(`A JSON Patch operation requires a string '${member}' member`);
diff --git a/test/applyMergePatch.test.ts b/test/applyMergePatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d60398789d4c24f99487a01fb8dbe8d474ce6706
--- /dev/null
+++ b/test/applyMergePatch.test.ts
@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyMergePatch } from "../src/index.ts";
+
+test("applies the RFC 7386 example merge patch", () => {
+  const target = {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+  assert.deepEqual(target, {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  });
+  assert.deepEqual(patch, {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  });
+});
+
+test("replaces a target when the patch is not an object", () => {
+  assert.deepEqual(applyMergePatch({ value: true }, ["replacement"]), ["replacement"]);
+  assert.equal(applyMergePatch({ value: true }, null), null);
+});
+
+test("treats a non-object target as an empty object for an object patch", () => {
+  assert.deepEqual(applyMergePatch(["old"], { value: 1, removed: null }), { value: 1 });
+});
+
+test("handles __proto__ as a JSON member", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"safe":true}}')) as Record<string, unknown>;
+
+  assert.deepEqual(result, JSON.parse('{"__proto__":{"safe":true}}'));
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(result.__proto__, { safe: true });
+});
