+/**
+ * Creates a JSON Patch (RFC 6902) that transforms `from` into `to`.
+ *
+ * Both inputs must be JSON values. Neither is modified, and values included in
+ * the returned patch are independent copies of values from `to`.
+ */
+export function createPatch(from: unknown, to: unknown): Array<Record<string, unknown>> {
+  // Besides checking that callers supplied JSON documents, cloning means the
+  // patch never retains a reference to either caller-owned input.
+  const source = cloneJson(from);
+  const target = cloneJson(to);
+  const patch: Array<Record<string, unknown>> = [];
+
+  createPatchAt(source, target, [], patch);
+  return patch;
+}
