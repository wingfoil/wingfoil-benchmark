+
+function createArrayPatch(
+  from: readonly unknown[],
+  to: readonly unknown[],
+  path: readonly string[],
+  patch: Array<Record<string, unknown>>,
+): void {
+  // Keep the longest unchanged subsequence. This makes an insertion or
+  // deletion in a large array a single operation rather than replacements for
+  // every following element.
+  const matches = longestCommonSubsequence(from, to);
+  let fromIndex = 0;
+  let toIndex = 0;
+  let resultIndex = 0;
+
+  for (const [matchedFrom, matchedTo] of [...matches, [from.length, to.length] as const]) {
+    const removed = matchedFrom - fromIndex;
+    const added = matchedTo - toIndex;
+    const paired = Math.min(removed, added);
+
+    // A replacement may itself be an object or array with a small change.
+    // Pairing equivalent unmatched runs allows that smaller nested patch while
+    // the LCS above still handles shifted values as insertions/removals.
+    for (let offset = 0; offset < paired; offset += 1) {
+      createPatchAt(from[fromIndex + offset], to[toIndex + offset], [...path, String(resultIndex + offset)], patch);
+    }
+
+    for (let offset = paired; offset < removed; offset += 1) {
+      patch.push({ op: "remove", path: formatPointer([...path, String(resultIndex + paired)]) });
+    }
+
+    for (let offset = paired; offset < added; offset += 1) {
+      patch.push({ op: "add", path: formatPointer([...path, String(resultIndex + offset)]), value: to[toIndex + offset] });
+    }
