diff --git a/test/createPatch.test.ts b/test/createPatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cc302ccc874f71b7e4e2201e960c595a05b98b53
--- /dev/null
+++ b/test/createPatch.test.ts
@@ -0,0 +1,36 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyPatch, createPatch } from "../src/index.ts";
+
+test("creates a patch for a nested change without replacing the document", () => {
+  const from = { account: { name: "Ada", preferences: { theme: "light" } }, enabled: true };
+  const to = { account: { name: "Ada", preferences: { theme: "dark" } }, enabled: true };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: "replace", path: "/account/preferences/theme", value: "dark" }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, { account: { name: "Ada", preferences: { theme: "light" } }, enabled: true });
+  assert.deepEqual(to, { account: { name: "Ada", preferences: { theme: "dark" } }, enabled: true });
+});
+
+test("uses small array operations and escapes JSON Pointer tokens", () => {
+  const from = { "a/b~c": ["first", "third"] };
+  const to = { "a/b~c": ["first", "second", "third"] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: "add", path: "/a~1b~0c/1", value: "second" }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("returns an empty patch for equal documents and does not retain target values", () => {
+  assert.deepEqual(createPatch({ value: [1] }, { value: [1] }), []);
+
+  const target = { value: { nested: true } };
+  const patch = createPatch({}, target);
+  (patch[0].value as { nested: boolean }).nested = false;
+
+  assert.deepEqual(target, { value: { nested: true } });
+});
