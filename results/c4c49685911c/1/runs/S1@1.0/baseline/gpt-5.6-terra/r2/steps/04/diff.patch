+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document.
+ *
+ * Neither the target nor the patch is mutated.  Object members whose patch
+ * value is null are removed; all other non-object values (including arrays)
+ * replace the corresponding target value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  // Validate and detach both documents up front.  Besides keeping the public
+  // operation immutable, this ensures values introduced by the patch cannot
+  // retain references to caller-owned objects.
+  return mergePatch(cloneJsonValue(target), cloneJsonValue(patch));
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonObject(patch)) {
+    return patch;
+  }
+
+  // Per RFC 7386, an object patch applied to anything other than an object
+  // starts from an empty object.  Arrays are JSON values, not JSON objects.
+  const result: Record<string, unknown> = isJsonObject(target)
+    ? target
+    : {};
+
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const targetValue = Object.hasOwn(result, key) ? result[key] : undefined;
+      defineJsonProperty(result, key, mergePatch(targetValue, value));
+    }
+  }
+
+  return result;
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
