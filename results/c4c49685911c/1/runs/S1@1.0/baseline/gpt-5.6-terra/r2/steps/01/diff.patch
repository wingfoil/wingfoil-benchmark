+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * The empty pointer denotes the document itself. Every other pointer consists
+ * of slash-prefixed reference tokens; `~1` and `~0` in a token stand for `/`
+ * and `~`, respectively.
+ *
+ * @throws {Error} If the pointer is malformed or does not identify a value in
+ * the document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("A JSON Pointer must be a string");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error("A non-empty JSON Pointer must start with '/'");
+  }
+
+  let value = document;
+
+  for (const encodedToken of pointer.slice(1).split("/")) {
+    const token = decodeReferenceToken(encodedToken);
+
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(token)) {
+        throw new Error(`JSON Pointer token '${token}' is not a valid array index`);
+      }
+
+      const index = Number(token);
+      if (index >= value.length || !Object.hasOwn(value, index)) {
+        throw new Error(`JSON Pointer does not resolve: array index '${token}' is out of bounds`);
+      }
+
+      value = value[index];
+      continue;
+    }
+
+    if (value === null || typeof value !== "object" || !Object.hasOwn(value, token)) {
+      throw new Error(`JSON Pointer does not resolve at token '${token}'`);
+    }
+
+    value = (value as Record<string, unknown>)[token];
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  let decoded = "";
+
+  for (let index = 0; index < token.length; index += 1) {
+    const character = token[index];
+    if (character !== "~") {
+      decoded += character;
+      continue;
+    }
+
+    const escape = token[index + 1];
+    if (escape === "0") {
+      decoded += "~";
+    } else if (escape === "1") {
+      decoded += "/";
+    } else {
+      throw new Error(`Invalid JSON Pointer escape sequence in token '${token}'`);
+    }
+    index += 1;
+  }
+
+  return decoded;
+}
+
+function isArrayIndex(token: string): boolean {
+  // RFC 6901 section 4: "0" or a non-zero digit followed by digits.
+  return /^(?:0|[1-9][0-9]*)$/.test(token);
+}
