+function createPatchAt(
+  from: unknown,
+  to: unknown,
+  path: string[],
+  patch: Array<Record<string, unknown>>,
+): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    const fromKeys = Object.keys(from);
+    const toKeys = Object.keys(to);
