+  for (const [anchorFrom, anchorTo] of [...anchors, [fromMiddle.length, toMiddle.length] as [number, number]]) {
+    currentIndex = createArrayGapPatch(
+      fromMiddle.slice(fromIndex, anchorFrom),
+      toMiddle.slice(toIndex, anchorTo),
+      path,
+      currentIndex,
+      patch,
+    );
