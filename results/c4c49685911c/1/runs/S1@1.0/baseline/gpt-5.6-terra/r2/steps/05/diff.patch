+  // Keep a longest sequence of unchanged values as anchors.  The portions
+  // between anchors can then be edited at their current array index, avoiding
+  // replacement of an entire array for a local insertion, deletion, or edit.
+  const anchors = longestCommonSubsequence(fromMiddle, toMiddle);
+  let fromIndex = 0;
+  let toIndex = 0;
