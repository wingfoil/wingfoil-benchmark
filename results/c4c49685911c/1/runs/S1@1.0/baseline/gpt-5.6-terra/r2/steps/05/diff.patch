+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ *
+ * The inputs must be JSON values.  Neither input is mutated, and values put
+ * into the returned patch are detached from `to`.
+ */
+export function createPatch(from: unknown, to: unknown): Array<Record<string, unknown>> {
+  // Cloning validates the values as JSON and means that no operation value in
+  // the resulting patch can retain a reference to either caller-owned input.
+  const source = cloneJsonValue(from);
+  const target = cloneJsonValue(to);
+  const patch: Array<Record<string, unknown>> = [];
+  createPatchAt(source, target, [], patch);
+  return patch;
+}
