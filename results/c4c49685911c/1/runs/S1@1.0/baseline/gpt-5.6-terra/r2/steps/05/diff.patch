+function createArrayPatch(
+  from: unknown[],
+  to: unknown[],
+  path: string[],
+  patch: Array<Record<string, unknown>>,
+): void {
+  // Trim unchanged ends before alignment.  Apart from making common edits
+  // inexpensive, this makes a one-element edit in a large array local.
+  let prefixLength = 0;
+  while (
+    prefixLength < from.length
+    && prefixLength < to.length
+    && jsonEqual(from[prefixLength], to[prefixLength])
+  ) {
+    prefixLength += 1;
+  }
+
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (
+    fromEnd > prefixLength
+    && toEnd > prefixLength
+    && jsonEqual(from[fromEnd - 1], to[toEnd - 1])
+  ) {
+    fromEnd -= 1;
+    toEnd -= 1;
+  }
+
+  const fromMiddle = from.slice(prefixLength, fromEnd);
+  const toMiddle = to.slice(prefixLength, toEnd);
+  let currentIndex = prefixLength;
+
+  // LCS produces useful anchors for reorders and multiple independent edits,
+  // but needs a matrix proportional to both dimensions.  For a genuinely
+  // large changed region, corresponding positions still get granular diffs
+  // without risking disproportionate memory use.
+  if (fromMiddle.length * toMiddle.length > 1_000_000) {
+    createArrayGapPatch(fromMiddle, toMiddle, path, currentIndex, patch);
+    return;
+  }
