+function createArrayGapPatch(
+  from: unknown[],
+  to: unknown[],
+  path: string[],
+  index: number,
+  patch: Array<Record<string, unknown>>,
+): number {
+  const sharedLength = Math.min(from.length, to.length);
+  for (let offset = 0; offset < sharedLength; offset += 1) {
+    createPatchAt(from[offset], to[offset], [...path, String(index + offset)], patch);
+  }
