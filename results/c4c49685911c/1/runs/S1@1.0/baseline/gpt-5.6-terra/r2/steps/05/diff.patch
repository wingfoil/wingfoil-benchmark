+  // Remove at one fixed index because each removal shifts the next value into
+  // that position.
+  for (let offset = sharedLength; offset < from.length; offset += 1) {
+    patch.push({ op: "remove", path: formatPointer([...path, String(index + sharedLength)]) });
+  }
+  for (let offset = sharedLength; offset < to.length; offset += 1) {
+    patch.push({
+      op: "add",
+      path: formatPointer([...path, String(index + offset)]),
+      value: to[offset],
+    });
+  }
