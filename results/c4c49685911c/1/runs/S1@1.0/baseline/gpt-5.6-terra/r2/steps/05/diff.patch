+    // unambiguous, and so every recursive operation has a valid parent.
+    for (const key of fromKeys) {
+      if (!Object.hasOwn(to, key)) {
+        patch.push({ op: "remove", path: formatPointer([...path, key]) });
+      }
+    }
+    for (const key of toKeys) {
+      if (Object.hasOwn(from, key)) {
+        createPatchAt(from[key], to[key], [...path, key], patch);
+      } else {
+        patch.push({ op: "add", path: formatPointer([...path, key]), value: to[key] });
+      }
