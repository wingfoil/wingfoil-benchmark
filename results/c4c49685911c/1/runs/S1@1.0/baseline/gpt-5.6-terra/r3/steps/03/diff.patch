diff --git a/test/apply-patch.test.ts b/test/apply-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6a7e2626155b88f1c41b1039b662747ef038cc8b
--- /dev/null
+++ b/test/apply-patch.test.ts
@@ -0,0 +1,60 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyPatch } from "../src/index.ts";
+
+test("applies operations sequentially without mutating the supplied document", () => {
+  const document = { items: ["a", "c"], unchanged: true };
+  const result = applyPatch(document, [
+    { op: "add", path: "/items/1", value: "b" },
+    { op: "move", from: "/items/2", path: "/items/0" },
+    { op: "replace", path: "/unchanged", value: false },
+  ]);
+
+  assert.deepEqual(result, { items: ["c", "a", "b"], unchanged: false });
+  assert.deepEqual(document, { items: ["a", "c"], unchanged: true });
+});
+
+test("permits add at the root and only permits '-' as an add array index", () => {
+  assert.deepEqual(
+    applyPatch({ old: true }, [{ op: "add", path: "", value: { replacement: true } }]),
+    { replacement: true },
+  );
+  assert.deepEqual(
+    applyPatch([1, 2], [{ op: "add", path: "/-", value: 3 }]),
+    [1, 2, 3],
+  );
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/-" }]));
+});
+
+test("requires a JSON Patch document, not merely a JavaScript array", () => {
+  const patch = [{ op: "add", path: "/ok", value: true, metadata: undefined }];
+  assert.throws(() => applyPatch({}, patch), /JSON Patch is not a JSON value/);
+});
+
+test("move requires its source to exist even when source and destination match", () => {
+  assert.throws(
+    () => applyPatch({}, [{ op: "move", from: "/missing", path: "/missing" }]),
+    /does not exist/,
+  );
+  assert.deepEqual(
+    applyPatch({ value: 1 }, [{ op: "move", from: "/value", path: "/value" }]),
+    { value: 1 },
+  );
+});
+
+test("rejects removal of the document root", () => {
+  assert.throws(
+    () => applyPatch({ value: 1 }, [{ op: "remove", path: "" }]),
+    /cannot remove the document root/,
+  );
+});
+
+test("a failed patch leaves the supplied document unchanged", () => {
+  const document = { value: 1 };
+  assert.throws(() => applyPatch(document, [
+    { op: "replace", path: "/value", value: 2 },
+    { op: "test", path: "/value", value: 3 },
+  ]));
+  assert.deepEqual(document, { value: 1 });
+});
