+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @throws {Error} When the pointer is malformed or names no value in the
+ * document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("A JSON Pointer must be a string");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error("A non-empty JSON Pointer must begin with '/'");
+  }
+
+  let value = document;
+
+  for (const referenceToken of pointer.slice(1).split("/")) {
+    const token = decodeReferenceToken(referenceToken);
+
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(token)) {
+        throw new Error(`JSON Pointer does not resolve: invalid array index ${token}`);
+      }
+
+      const index = Number(token);
+      if (index >= value.length || !Object.hasOwn(value, index)) {
+        throw new Error(`JSON Pointer does not resolve: array index ${token} is absent`);
+      }
+
+      value = value[index];
+    } else if (value !== null && typeof value === "object") {
+      if (!Object.hasOwn(value, token)) {
+        throw new Error(`JSON Pointer does not resolve: member ${token} is absent`);
+      }
+
+      value = (value as Record<string, unknown>)[token];
+    } else {
+      throw new Error("JSON Pointer does not resolve: cannot traverse a scalar value");
+    }
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  let decoded = "";
+
+  for (let index = 0; index < token.length; index += 1) {
+    const character = token[index];
+
+    if (character !== "~") {
+      decoded += character;
+      continue;
+    }
+
+    const escape = token[index + 1];
+    if (escape === "0") {
+      decoded += "~";
+    } else if (escape === "1") {
+      decoded += "/";
+    } else {
+      throw new Error(`Invalid JSON Pointer escape in token ${token}`);
+    }
+
+    index += 1;
+  }
+
+  return decoded;
+}
+
+function isArrayIndex(token: string): boolean {
+  return token === "0" || /^[1-9][0-9]*$/.test(token);
+}
