+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ *
+ * Both arguments must be JSON values. The returned patch owns any values it
+ * contains, so mutating the patch after it is created cannot affect either
+ * input.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  assertJsonValue(from, "from");
+  assertJsonValue(to, "to");
+
+  const patch: JsonPatchOperation[] = [];
+  createPatchOperations(from, to, "", patch);
+  return patch;
+}
+
+type JsonPatchOperation =
+  | { op: "add"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "replace"; path: string; value: unknown };
+
+function createPatchOperations(
+  from: unknown,
+  to: unknown,
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) {
+        patch.push({ op: "remove", path: appendPointer(path, key) });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      const childPath = appendPointer(path, key);
+      if (!Object.hasOwn(from, key)) {
+        patch.push({ op: "add", path: childPath, value: cloneJson(to[key]) });
+      } else {
+        createPatchOperations(from[key], to[key], childPath, patch);
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatchOperations(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: "replace", path, value: cloneJson(to) });
+}
+
+function createArrayPatchOperations(
+  from: unknown[],
+  to: unknown[],
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  // Equal values are anchors. Between anchors we pair corresponding values so
+  // that a changed object can still be diffed recursively, while insertions
+  // and removals remain single array operations rather than replacements of
+  // the rest of the array.
+  let fromStart = 0;
+  let toStart = 0;
+  while (fromStart < from.length && toStart < to.length
+    && jsonEqual(from[fromStart], to[toStart])) {
+    fromStart += 1;
+    toStart += 1;
+  }
+
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > fromStart && toEnd > toStart
+    && jsonEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd -= 1;
+    toEnd -= 1;
+  }
+
+  const anchors = longestCommonSubsequence(
+    from.slice(fromStart, fromEnd),
+    to.slice(toStart, toEnd),
+  ).map(([fromIndex, toIndex]) => [fromIndex + fromStart, toIndex + toStart] as const);
+  let resultIndex = fromStart;
+
+  for (const [fromIndex, toIndex] of [...anchors, [fromEnd, toEnd] as const]) {
+    const paired = Math.min(fromIndex - fromStart, toIndex - toStart);
+    for (let offset = 0; offset < paired; offset += 1) {
+      createPatchOperations(
+        from[fromStart + offset],
+        to[toStart + offset],
+        appendPointer(path, String(resultIndex)),
+        patch,
+      );
+      resultIndex += 1;
+    }
+
+    for (let index = paired; fromStart + index < fromIndex; index += 1) {
+      patch.push({ op: "remove", path: appendPointer(path, String(resultIndex)) });
+    }
+    for (let index = paired; toStart + index < toIndex; index += 1) {
+      patch.push({
+        op: "add",
+        path: appendPointer(path, String(resultIndex)),
+        value: cloneJson(to[toStart + index]),
+      });
+      resultIndex += 1;
+    }
+
+    if (fromIndex < from.length) {
+      resultIndex += 1;
+    }
+    fromStart = fromIndex + 1;
+    toStart = toIndex + 1;
+  }
+}
+
+function longestCommonSubsequence(from: unknown[], to: unknown[]): Array<readonly [number, number]> {
+  const lengths = Array.from(
+    { length: from.length + 1 },
+    () => Array<number>(to.length + 1).fill(0),
+  );
+
+  for (let fromIndex = from.length - 1; fromIndex >= 0; fromIndex -= 1) {
+    for (let toIndex = to.length - 1; toIndex >= 0; toIndex -= 1) {
+      lengths[fromIndex][toIndex] = jsonEqual(from[fromIndex], to[toIndex])
+        ? lengths[fromIndex + 1][toIndex + 1] + 1
+        : Math.max(lengths[fromIndex + 1][toIndex], lengths[fromIndex][toIndex + 1]);
+    }
+  }
+
+  const result: Array<readonly [number, number]> = [];
+  let fromIndex = 0;
+  let toIndex = 0;
+  while (fromIndex < from.length && toIndex < to.length) {
+    if (jsonEqual(from[fromIndex], to[toIndex])) {
+      result.push([fromIndex, toIndex]);
+      fromIndex += 1;
+      toIndex += 1;
+    } else if (lengths[fromIndex + 1][toIndex] >= lengths[fromIndex][toIndex + 1]) {
+      fromIndex += 1;
+    } else {
+      toIndex += 1;
+    }
+  }
+  return result;
+}
+
+function appendPointer(path: string, token: string): string {
+  return `${path}/${token.replace(/~/g, "~0").replace(/\//g, "~1")}`;
+}
