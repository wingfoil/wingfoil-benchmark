 import assert from "node:assert/strict";
 import test from "node:test";
 
-import { applyMergePatch, applyPatch } from "../src/index.ts";
+import { applyMergePatch, applyPatch, createPatch } from "../src/index.ts";
+
+test("creates a granular JSON Patch without mutating its inputs", () => {
+  const from = { account: { name: "Ada", enabled: true }, unchanged: [1, 2] };
+  const to = { account: { name: "Ada", enabled: false }, unchanged: [1, 2] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: "replace", path: "/account/enabled", value: false }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, { account: { name: "Ada", enabled: true }, unchanged: [1, 2] });
+  assert.deepEqual(to, { account: { name: "Ada", enabled: false }, unchanged: [1, 2] });
+});
+
+test("creates compact array insertions and removals", () => {
+  const inserted = createPatch(["a", "c"], ["a", "b", "c"]);
+  const removed = createPatch(["a", "b", "c"], ["a", "c"]);
+
+  assert.deepEqual(inserted, [{ op: "add", path: "/1", value: "b" }]);
+  assert.deepEqual(removed, [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(applyPatch(["a", "c"], inserted), ["a", "b", "c"]);
+  assert.deepEqual(applyPatch(["a", "b", "c"], removed), ["a", "c"]);
+});
+
+test("escapes object-member paths and returns independent patch values", () => {
+  const to = { "a/b~c": { values: [1] } };
+  const patch = createPatch({}, to);
+
+  assert.deepEqual(patch, [{ op: "add", path: "/a~1b~0c", value: { values: [1] } }]);
+  ((patch[0] as { value: { values: number[] } }).value.values)[0] = 9;
+  assert.deepEqual(to, { "a/b~c": { values: [1] } });
+});
+
+test("createPatch accepts only JSON values", () => {
+  assert.throws(() => createPatch({ value: undefined }, {}), /from is not a JSON value/);
+  assert.throws(() => createPatch({}, { value: Number.NaN }), /to is not a JSON value/);
+});
 
