 import assert from "node:assert/strict";
 import test from "node:test";
 
-import { applyPatch } from "../src/index.ts";
+import { applyMergePatch, applyPatch } from "../src/index.ts";
+
+test("applies the RFC 7386 merge patch examples", () => {
+  const cases: Array<[unknown, unknown, unknown]> = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("merge patch does not mutate or retain mutable input values", () => {
+  const target = { retained: { value: 1 }, removed: true };
+  const patch = { retained: { added: [2] }, replacement: { nested: true }, removed: null };
+
+  const result = applyMergePatch(target, patch) as Record<string, unknown>;
+
+  assert.deepEqual(result, { retained: { value: 1, added: [2] }, replacement: { nested: true } });
+  assert.deepEqual(target, { retained: { value: 1 }, removed: true });
+  assert.deepEqual(patch, { retained: { added: [2] }, replacement: { nested: true }, removed: null });
+
+  ((result.replacement as Record<string, unknown>).nested) = false;
+  assert.deepEqual(patch.replacement, { nested: true });
+});
+
+test("merge patch accepts only JSON documents", () => {
+  assert.throws(() => applyMergePatch({ value: 1 }, { value: undefined }), /JSON Merge Patch is not a JSON value/);
+  assert.throws(() => applyMergePatch({ value: undefined }, {}), /target is not a JSON value/);
+});
+
+test("merge patch handles JavaScript-special member names as JSON members", () => {
+  const patch = JSON.parse('{"__proto__":{"enabled":true}}');
+
+  assert.deepEqual(
+    applyMergePatch({}, patch),
+    JSON.parse('{"__proto__":{"enabled":true}}'),
+  );
+  assert.equal(({} as Record<string, unknown>).enabled, undefined);
+});
 
