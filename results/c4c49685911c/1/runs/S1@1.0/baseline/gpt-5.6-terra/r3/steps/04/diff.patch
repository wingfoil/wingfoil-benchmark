+/**
+ * Applies an RFC 7386 JSON Merge Patch without modifying either supplied JSON
+ * document.
+ *
+ * A non-object patch replaces the target outright. Within an object patch,
+ * null-valued members remove their corresponding target members.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJsonValue(target, "target");
+  assertJsonValue(patch, "JSON Merge Patch");
+
+  return mergePatch(cloneJson(target), patch);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return cloneJson(patch);
+  }
+
+  const result: Record<string, unknown> = isObject(target)
+    ? target
+    : {};
+
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const targetValue = Object.hasOwn(result, key) ? result[key] : undefined;
+      setObjectMember(result, key, mergePatch(targetValue, value));
+    }
+  }
+
+  return result;
+}
+
 function applyOperation(document: unknown, operation: unknown, operationIndex: number): unknown {
