@@ -80,6 +80,136 @@ type PatchOperation = {
   value?: unknown;
 };
 
+/**
+ * Creates an RFC 6902 JSON Patch that transforms one JSON document into another.
+ *
+ * The generated patch changes only the differing portions of objects and arrays;
+ * it does not mutate either input.
+ *
+ * @param from The JSON document to transform from.
+ * @param to The JSON document to transform to.
+ * @returns An ordered array of JSON Patch operations.
+ * @throws {TypeError} If either input is not a valid JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const source = cloneJson(from);
+  const target = cloneJson(to);
+  const patch: PatchOperation[] = [];
+  createPatchOperations(source, target, '', patch);
+  return patch;
+}
+
+function createPatchOperations(from: JsonValue, to: JsonValue, path: string, patch: PatchOperation[]): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    createObjectPatch(from, to, path, patch);
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatch(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: 'replace', path, value: to });
+}
+
+function createObjectPatch(
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  path: string,
+  patch: PatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      patch.push({ op: 'remove', path: appendPointer(path, key) });
+    }
+  }
+  for (const key of Object.keys(from)) {
+    if (Object.hasOwn(to, key)) {
+      createPatchOperations(from[key] as JsonValue, to[key] as JsonValue, appendPointer(path, key), patch);
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (!Object.hasOwn(from, key)) {
+      patch.push({ op: 'add', path: appendPointer(path, key), value: to[key] as JsonValue });
+    }
+  }
+}
+
+function createArrayPatch(from: JsonValue[], to: JsonValue[], path: string, patch: PatchOperation[]): void {
+  const matches = findArrayMatches(from, to);
+  let fromStart = 0;
+  let toStart = 0;
+  let index = 0;
+
+  for (const [fromMatch, toMatch] of matches) {
+    index = createArraySegmentPatch(from, fromStart, fromMatch, to, toStart, toMatch, path, index, patch);
+    index += 1;
+    fromStart = fromMatch + 1;
+    toStart = toMatch + 1;
+  }
+  createArraySegmentPatch(from, fromStart, from.length, to, toStart, to.length, path, index, patch);
+}
+
+function findArrayMatches(from: JsonValue[], to: JsonValue[]): Array<[number, number]> {
+  const lengths = Array.from({ length: from.length + 1 }, () => new Array<number>(to.length + 1).fill(0));
+  for (let fromIndex = from.length - 1; fromIndex >= 0; fromIndex -= 1) {
+    for (let toIndex = to.length - 1; toIndex >= 0; toIndex -= 1) {
+      lengths[fromIndex][toIndex] = jsonEqual(from[fromIndex], to[toIndex])
+        ? lengths[fromIndex + 1][toIndex + 1] + 1
+        : Math.max(lengths[fromIndex + 1][toIndex], lengths[fromIndex][toIndex + 1]);
+    }
+  }
+
+  const matches: Array<[number, number]> = [];
+  let fromIndex = 0;
+  let toIndex = 0;
+  while (fromIndex < from.length && toIndex < to.length) {
+    if (jsonEqual(from[fromIndex], to[toIndex])) {
+      matches.push([fromIndex, toIndex]);
+      fromIndex += 1;
+      toIndex += 1;
+    } else if (lengths[fromIndex + 1][toIndex] >= lengths[fromIndex][toIndex + 1]) {
+      fromIndex += 1;
+    } else {
+      toIndex += 1;
+    }
+  }
+  return matches;
+}
+
+function createArraySegmentPatch(
+  from: JsonValue[],
+  fromStart: number,
+  fromEnd: number,
+  to: JsonValue[],
+  toStart: number,
+  toEnd: number,
+  path: string,
+  index: number,
+  patch: PatchOperation[],
+): number {
+  const sharedLength = Math.min(fromEnd - fromStart, toEnd - toStart);
+  for (let offset = 0; offset < sharedLength; offset += 1) {
+    createPatchOperations(from[fromStart + offset] as JsonValue, to[toStart + offset] as JsonValue, appendPointer(path, String(index + offset)), patch);
+  }
+  for (let offset = sharedLength; fromStart + offset < fromEnd; offset += 1) {
+    patch.push({ op: 'remove', path: appendPointer(path, String(index + sharedLength)) });
+  }
+  for (let offset = sharedLength; toStart + offset < toEnd; offset += 1) {
+    patch.push({ op: 'add', path: appendPointer(path, String(index + offset)), value: to[toStart + offset] as JsonValue });
+  }
+  return index + (toEnd - toStart);
+}
+
+function appendPointer(path: string, token: string): string {
+  return `${path}/${encodeReferenceToken(token)}`;
+}
