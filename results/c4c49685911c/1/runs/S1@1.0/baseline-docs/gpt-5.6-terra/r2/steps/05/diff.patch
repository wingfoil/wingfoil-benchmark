 import assert from 'node:assert/strict';
 import test from 'node:test';
 
-import { applyMergePatch, applyPatch } from '../dist/index.js';
+import { applyMergePatch, applyPatch, createPatch } from '../dist/index.js';
+
+test('creates a small RFC 6902 patch for nested, escaped, and array changes without mutating either input', () => {
+  const from = {
+    unchanged: { nested: true },
+    settings: { 'a/b': 1, removed: true },
+    items: ['first', 'second', 'third'],
+  };
+  const to = {
+    unchanged: { nested: true },
+    settings: { 'a/b': 2, added: false },
+    items: ['first', 'inserted', 'second', 'third'],
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'remove', path: '/settings/removed' },
+    { op: 'replace', path: '/settings/a~1b', value: 2 },
+    { op: 'add', path: '/settings/added', value: false },
+    { op: 'add', path: '/items/1', value: 'inserted' },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    unchanged: { nested: true },
+    settings: { 'a/b': 1, removed: true },
+    items: ['first', 'second', 'third'],
+  });
+  assert.deepEqual(to, {
+    unchanged: { nested: true },
+    settings: { 'a/b': 2, added: false },
+    items: ['first', 'inserted', 'second', 'third'],
+  });
+});
+
+test('creates an empty patch for equal values and replaces incompatible roots', () => {
+  assert.deepEqual(createPatch({ value: [1, 2] }, { value: [1, 2] }), []);
+  assert.deepEqual(createPatch({ value: true }, ['replacement']), [
+    { op: 'replace', path: '', value: ['replacement'] },
+  ]);
+  assert.throws(() => createPatch({ invalid: undefined }, {}));
+});
+
+test('keeps nested edits inside changed array entries while removing obsolete entries', () => {
+  const from = { rows: [{ value: 1, retained: true }, 'obsolete'] };
+  const to = { rows: [{ value: 2, retained: true }] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'replace', path: '/rows/0/value', value: 2 },
+    { op: 'remove', path: '/rows/1' },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
 
