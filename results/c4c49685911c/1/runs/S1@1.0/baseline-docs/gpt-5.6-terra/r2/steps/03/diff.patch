diff --git a/src/index.ts b/src/index.ts
index 25a229cd53e5f7c7b6ce57961edd4524f70a0d04..5b3bb9d2f12deb7ea53666af4b610e23a0b6bb52 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -62,7 +62,10 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
 
   let result = cloneJson(document);
   for (const operation of patch) {
-    result = applyOperation(result, validateOperation(operation));
+    // An operation is a JSON object in its entirety, not merely a container for
+    // the members used by its operation.  Clone it before evaluation so invalid
+    // ignored members cannot pass through and evaluation uses a stable snapshot.
+    result = applyOperation(result, validateOperation(cloneJson(operation)));
   }
   return result;
 }
diff --git a/test/json-patch.test.mjs b/test/json-patch.test.mjs
index 51222de0ca044b461badda6663ccc3573cacc844..36b88f22512564d8a6f7fe38216525313a57b172 100644
--- a/test/json-patch.test.mjs
+++ b/test/json-patch.test.mjs
@@ -55,3 +55,30 @@ test('uses escaped pointer tokens and deep-copies copied values', () => {
   assert.deepEqual(result, { 'a/b': { nested: true }, copied: { nested: true } });
   assert.notEqual(result['a/b'], result.copied);
 });
+
+test('rejects operation objects that are not JSON, including ignored members', () => {
+  class Operation {
+    op = 'remove';
+    path = '/value';
+  }
+
+  assert.throws(() => applyPatch({ value: true }, [new Operation()]));
+  assert.throws(() => applyPatch(
+    { value: true },
+    [{ op: 'remove', path: '/value', ignored: undefined }],
+  ));
+  assert.throws(() => applyPatch(
+    { value: true },
+    [{ op: 'remove', path: '/value', ignored: Number.NaN }],
+  ));
+});
+
+test('stops on errors without changing the supplied document', () => {
+  const document = { value: 1 };
+
+  assert.throws(() => applyPatch(document, [
+    { op: 'replace', path: '/value', value: 2 },
+    { op: 'test', path: '/value', value: 3 },
+  ]));
+  assert.deepEqual(document, { value: 1 });
+});
