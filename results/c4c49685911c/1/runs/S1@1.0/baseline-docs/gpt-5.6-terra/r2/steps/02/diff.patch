--- /dev/null
+++ b/test/json-patch.test.mjs
@@ -0,0 +1,57 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { applyPatch } from '../dist/index.js';
+
+test('applies each RFC 6902 operation without mutating the source document', () => {
+  const document = {
+    baz: 'qux',
+    foo: ['bar', 'baz'],
+    nested: { value: 1 },
+  };
+  const patch = [
+    { op: 'add', path: '/foo/1', value: 'inserted' },
+    { op: 'remove', path: '/baz' },
+    { op: 'replace', path: '/nested/value', value: 2 },
+    { op: 'copy', from: '/foo/0', path: '/copied' },
+    { op: 'move', from: '/foo/2', path: '/foo/-' },
+    { op: 'test', path: '/copied', value: 'bar' },
+  ];
+
+  assert.deepEqual(applyPatch(document, patch), {
+    foo: ['bar', 'inserted', 'baz'],
+    nested: { value: 2 },
+    copied: 'bar',
+  });
+  assert.deepEqual(document, {
+    baz: 'qux',
+    foo: ['bar', 'baz'],
+    nested: { value: 1 },
+  });
+});
+
+test('supports replacing the whole document and adding to an empty array', () => {
+  assert.equal(applyPatch({ value: true }, [{ op: 'replace', path: '', value: null }]), null);
+  assert.equal(applyPatch({ value: true }, [{ op: 'remove', path: '' }]), null);
+  assert.deepEqual(applyPatch([], [{ op: 'add', path: '/-', value: 'value' }]), ['value']);
+});
+
+test('rejects invalid patches and failed operations', () => {
+  assert.throws(() => applyPatch({}, {}));
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: 'missing-slash', value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: 'remove', path: '/missing' }]));
+  assert.throws(() => applyPatch(['a'], [{ op: 'add', path: '/2', value: 'b' }]));
+  assert.throws(() => applyPatch({ a: {} }, [{ op: 'move', from: '/a', path: '/a/b' }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'test', path: '/a', value: 2 }]));
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: '/date', value: new Date() }]));
+});
+
+test('uses escaped pointer tokens and deep-copies copied values', () => {
+  const result = applyPatch(
+    { 'a/b': { nested: true } },
+    [{ op: 'copy', from: '/a~1b', path: '/copied' }],
+  );
+
+  assert.deepEqual(result, { 'a/b': { nested: true }, copied: { nested: true } });
+  assert.notEqual(result['a/b'], result.copied);
+});
