 import assert from 'node:assert/strict';
 import test from 'node:test';
 
-import { applyPatch } from '../dist/index.js';
+import { applyMergePatch, applyPatch } from '../dist/index.js';
+
+test('applies the RFC 7386 merge patch examples without mutating either input', () => {
+  const target = {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  };
+  const patch = {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: 'Hello!',
+    author: { givenName: 'John' },
+    tags: ['example'],
+    content: 'This will be unchanged',
+    phoneNumber: '+01-123-456-7890',
+  });
+  assert.deepEqual(target, {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  });
+  assert.deepEqual(patch, {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  });
+});
+
+test('replaces non-object targets and patches, and handles null deletion semantics', () => {
+  assert.deepEqual(applyMergePatch('not an object', { value: 1 }), { value: 1 });
+  assert.deepEqual(applyMergePatch({ value: true }, ['replacement']), ['replacement']);
+  assert.equal(applyMergePatch({ value: true }, null), null);
+  assert.deepEqual(applyMergePatch({ value: null, kept: true }, { value: null, missing: null }), { kept: true });
+});
+
+test('rejects inputs that are not JSON values', () => {
+  assert.throws(() => applyMergePatch({}, { invalid: undefined }));
+  assert.throws(() => applyMergePatch({ invalid: Number.NaN }, {}));
+});
 
