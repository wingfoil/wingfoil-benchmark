@@ -39,6 +39,40 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
 
 type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
 
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document without changing either input.
+ *
+ * @param target The JSON document to update.
+ * @param patch The JSON Merge Patch document to apply.
+ * @returns A new JSON document containing the merged result.
+ * @throws {TypeError} If either input is not a valid JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return mergePatch(cloneJson(target), cloneJson(patch));
+}
+
+function mergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return patch;
+  }
+
+  const result = isJsonObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const patchValue = patch[key] as JsonValue;
+    if (patchValue === null) {
+      delete result[key];
+    } else {
+      const targetValue = Object.hasOwn(result, key) ? result[key] as JsonValue : null;
+      setObjectMember(result, key, mergePatch(targetValue, patchValue));
+    }
+  }
+  return result;
+}
+
+function isJsonObject(value: JsonValue): value is { [key: string]: JsonValue } {
+  return value !== null && !Array.isArray(value) && typeof value === 'object';
+}
