diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5941fb0eaaa1c6c8c47b7d35a2f70cc4c378a872
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,71 @@
+/** A value permitted in a JSON document. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [member: string]: JsonValue };
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @param document - The JSON document to traverse.
+ * @param pointer - An RFC 6901 JSON Pointer string.
+ * @returns The value identified by the pointer.
+ * @throws {Error} If the pointer is invalid or does not identify a document value.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  if (typeof pointer !== 'string') {
+    throw new Error('A JSON Pointer must be a string.');
+  }
+
+  if (pointer === '') {
+    return document;
+  }
+
+  if (!pointer.startsWith('/')) {
+    throw new Error('A non-empty JSON Pointer must start with "/".');
+  }
+
+  let value = document;
+  for (const referenceToken of pointer.slice(1).split('/')) {
+    const token = decodeReferenceToken(referenceToken);
+    value = resolveToken(value, token);
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  if (/~(?:[^01]|$)/.test(token)) {
+    throw new Error(`Invalid JSON Pointer escape sequence in token "${token}".`);
+  }
+
+  return token.replace(/~[01]/g, (escape) => (escape === '~0' ? '~' : '/'));
+}
+
+function resolveToken(value: JsonValue, token: string): JsonValue {
+  if (Array.isArray(value)) {
+    if (!/^(?:0|[1-9][0-9]*)$/.test(token)) {
+      throw new Error(`"${token}" is not a valid JSON Pointer array index.`);
+    }
+
+    const index = Number(token);
+    if (!Number.isSafeInteger(index) || index >= value.length) {
+      throw new Error(`JSON Pointer array index "${token}" does not exist.`);
+    }
+
+    return value[index]!;
+  }
+
+  if (value !== null && typeof value === 'object') {
+    if (Object.prototype.hasOwnProperty.call(value, token)) {
+      return value[token]!;
+    }
+
+    throw new Error(`JSON Pointer object member "${token}" does not exist.`);
+  }
+
+  throw new Error(`Cannot resolve JSON Pointer token "${token}" from a primitive value.`);
+}
diff --git a/test/resolve-pointer.test.mjs b/test/resolve-pointer.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0ad60ea9f9694761379a354bba8c4b7ca78df011
--- /dev/null
+++ b/test/resolve-pointer.test.mjs
@@ -0,0 +1,56 @@
+import assert from 'node:assert/strict';
+import { before, test } from 'node:test';
+import { execFileSync } from 'node:child_process';
+
+before(() => {
+  execFileSync('npx', ['tsc'], { stdio: 'inherit' });
+});
+
+const document = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k\"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+test('resolves the JSON Pointer examples from RFC 6901', async () => {
+  const { resolvePointer } = await import('../dist/index.js');
+
+  assert.equal(resolvePointer(document, ''), document);
+  assert.deepEqual(resolvePointer(document, '/foo'), ['bar', 'baz']);
+  assert.equal(resolvePointer(document, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(document, '/'), 0);
+  assert.equal(resolvePointer(document, '/a~1b'), 1);
+  assert.equal(resolvePointer(document, '/c%d'), 2);
+  assert.equal(resolvePointer(document, '/e^f'), 3);
+  assert.equal(resolvePointer(document, '/g|h'), 4);
+  assert.equal(resolvePointer(document, '/i\\j'), 5);
+  assert.equal(resolvePointer(document, '/k\"l'), 6);
+  assert.equal(resolvePointer(document, '/ '), 7);
+  assert.equal(resolvePointer(document, '/m~0n'), 8);
+});
+
+test('rejects invalid pointers and references that do not exist', async () => {
+  const { resolvePointer } = await import('../dist/index.js');
+
+  assert.throws(() => resolvePointer(document, 'foo'));
+  assert.throws(() => resolvePointer(document, '/m~2n'));
+  assert.throws(() => resolvePointer(document, '/foo/01'));
+  assert.throws(() => resolvePointer(document, '/foo/-'));
+  assert.throws(() => resolvePointer(document, '/foo/2'));
+  assert.throws(() => resolvePointer(document, '/missing'));
+});
+
+test('resolves falsy JSON values', async () => {
+  const { resolvePointer } = await import('../dist/index.js');
+
+  assert.equal(resolvePointer({ false: false }, '/false'), false);
+  assert.equal(resolvePointer({ null: null }, '/null'), null);
+  assert.equal(resolvePointer({ zero: 0 }, '/zero'), 0);
+});
