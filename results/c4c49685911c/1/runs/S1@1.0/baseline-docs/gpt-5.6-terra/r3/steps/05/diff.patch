@@ -103,6 +123,157 @@ function mergePatch(target: JsonValue, patch: JsonValue): JsonValue {
   return result;
 }
 
+function createPatchOperations(
+  from: JsonValue,
+  to: JsonValue,
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatchOperations(from, to, path, patch);
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    for (const member of Object.keys(from)) {
+      if (Object.prototype.hasOwnProperty.call(to, member)) {
+        createPatchOperations(from[member]!, to[member]!, appendPointerToken(path, member), patch);
+      } else {
+        patch.push({ op: 'remove', path: appendPointerToken(path, member) });
+      }
+    }
+    for (const member of Object.keys(to)) {
+      if (!Object.prototype.hasOwnProperty.call(from, member)) {
+        patch.push({ op: 'add', path: appendPointerToken(path, member), value: cloneJsonValue(to[member]!) });
+      }
+    }
+    return;
+  }
+
+  patch.push({ op: 'replace', path, value: cloneJsonValue(to) });
+}
+
+function createArrayPatchOperations(
+  from: JsonValue[],
+  to: JsonValue[],
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  if (from.length * to.length > 1_000_000) {
+    createLinearArrayPatchOperations(from, to, path, patch);
+    return;
+  }
+
+  const rowLength = to.length + 1;
+  const costs = new Uint32Array((from.length + 1) * rowLength);
+
+  for (let fromIndex = 0; fromIndex < from.length; fromIndex += 1) {
+    costs[fromIndex * rowLength + to.length] = from.length - fromIndex;
+  }
+  for (let toIndex = 0; toIndex < to.length; toIndex += 1) {
+    costs[from.length * rowLength + toIndex] = to.length - toIndex;
+  }
+
+  for (let fromIndex = from.length - 1; fromIndex >= 0; fromIndex -= 1) {
+    for (let toIndex = to.length - 1; toIndex >= 0; toIndex -= 1) {
+      const index = fromIndex * rowLength + toIndex;
+      if (jsonEqual(from[fromIndex]!, to[toIndex]!)) {
+        costs[index] = costs[(fromIndex + 1) * rowLength + toIndex + 1]!;
+      } else {
+        costs[index] = 1 + Math.min(
+          costs[(fromIndex + 1) * rowLength + toIndex + 1]!,
+          costs[(fromIndex + 1) * rowLength + toIndex]!,
+          costs[fromIndex * rowLength + toIndex + 1]!,
+        );
+      }
+    }
+  }
+
+  let fromIndex = 0;
+  let toIndex = 0;
+  let patchIndex = 0;
+  while (fromIndex < from.length || toIndex < to.length) {
+    if (fromIndex < from.length && toIndex < to.length && jsonEqual(from[fromIndex]!, to[toIndex]!)) {
+      fromIndex += 1;
+      toIndex += 1;
+      patchIndex += 1;
+      continue;
+    }
+
+    const cost = costs[fromIndex * rowLength + toIndex]!;
+    const removeCost = fromIndex < from.length ? costs[(fromIndex + 1) * rowLength + toIndex]! + 1 : Infinity;
+    const addCost = toIndex < to.length ? costs[fromIndex * rowLength + toIndex + 1]! + 1 : Infinity;
+    const replaceCost = fromIndex < from.length && toIndex < to.length
+      ? costs[(fromIndex + 1) * rowLength + toIndex + 1]! + 1
+      : Infinity;
+
+    if (removeCost === cost) {
+      patch.push({ op: 'remove', path: appendPointerToken(path, String(patchIndex)) });
+      fromIndex += 1;
+    } else if (addCost === cost) {
+      patch.push({ op: 'add', path: appendPointerToken(path, String(patchIndex)), value: cloneJsonValue(to[toIndex]!) });
+      toIndex += 1;
+      patchIndex += 1;
+    } else if (replaceCost === cost) {
+      createPatchOperations(from[fromIndex]!, to[toIndex]!, appendPointerToken(path, String(patchIndex)), patch);
+      fromIndex += 1;
+      toIndex += 1;
+      patchIndex += 1;
+    } else {
+      throw new Error('Could not create an array JSON Patch operation.');
+    }
+  }
+}
+
+function createLinearArrayPatchOperations(
+  from: JsonValue[],
+  to: JsonValue[],
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  let prefixLength = 0;
+  while (prefixLength < from.length && prefixLength < to.length
+    && jsonEqual(from[prefixLength]!, to[prefixLength]!)) {
+    prefixLength += 1;
+  }
+
+  let suffixLength = 0;
+  while (suffixLength < from.length - prefixLength && suffixLength < to.length - prefixLength
+    && jsonEqual(from[from.length - suffixLength - 1]!, to[to.length - suffixLength - 1]!)) {
+    suffixLength += 1;
+  }
+
+  const fromMiddleLength = from.length - prefixLength - suffixLength;
+  const toMiddleLength = to.length - prefixLength - suffixLength;
+  const sharedLength = Math.min(fromMiddleLength, toMiddleLength);
+  for (let index = 0; index < sharedLength; index += 1) {
+    createPatchOperations(
+      from[prefixLength + index]!,
+      to[prefixLength + index]!,
+      appendPointerToken(path, String(prefixLength + index)),
+      patch,
+    );
+  }
+  for (let index = sharedLength; index < fromMiddleLength; index += 1) {
+    patch.push({ op: 'remove', path: appendPointerToken(path, String(prefixLength + sharedLength)) });
+  }
+  for (let index = sharedLength; index < toMiddleLength; index += 1) {
+    patch.push({
+      op: 'add',
+      path: appendPointerToken(path, String(prefixLength + index)),
+      value: cloneJsonValue(to[prefixLength + index]!),
+    });
+  }
+}
+
+function appendPointerToken(path: string, token: string): string {
+  return `${path}/${token.replace(/~/g, '~0').replace(/\//g, '~1')}`;
+}
