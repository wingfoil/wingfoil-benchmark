index 0000000000000000000000000000000000000000..cbeddff85092f1126cca94dd72505804cc7594f7
--- /dev/null
+++ b/test/create-patch.test.mjs
@@ -0,0 +1,85 @@
+import assert from 'node:assert/strict';
+import { before, test } from 'node:test';
+import { execFileSync } from 'node:child_process';
+
+before(() => {
+  execFileSync('npx', ['tsc'], { stdio: 'inherit' });
+});
+
+test('creates a granular patch that transforms one document into another without changing either input', async () => {
+  const { applyPatch, createPatch } = await import('../dist/index.js');
+  const from = {
+    title: 'Draft',
+    author: { name: 'Ada', email: 'ada@example.test' },
+    tags: ['typescript', 'json'],
+    obsolete: true,
+  };
+  const to = {
+    title: 'Published',
+    author: { name: 'Ada Lovelace', email: 'ada@example.test' },
+    tags: ['typescript', 'rfc-6902', 'json'],
+    published: true,
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'replace', path: '/title', value: 'Published' },
+    { op: 'replace', path: '/author/name', value: 'Ada Lovelace' },
+    { op: 'add', path: '/tags/1', value: 'rfc-6902' },
+    { op: 'remove', path: '/obsolete' },
+    { op: 'add', path: '/published', value: true },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    title: 'Draft',
+    author: { name: 'Ada', email: 'ada@example.test' },
+    tags: ['typescript', 'json'],
+    obsolete: true,
+  });
+  assert.deepEqual(to, {
+    title: 'Published',
+    author: { name: 'Ada Lovelace', email: 'ada@example.test' },
+    tags: ['typescript', 'rfc-6902', 'json'],
+    published: true,
+  });
+});
+
+test('uses RFC 6901 escaping and replaces a changed root', async () => {
+  const { applyPatch, createPatch } = await import('../dist/index.js');
+
+  assert.deepEqual(
+    createPatch({ 'a/b': { '~key': 1 } }, { 'a/b': { '~key': 2 } }),
+    [{ op: 'replace', path: '/a~1b/~0key', value: 2 }],
+  );
+  assert.deepEqual(applyPatch(['old'], createPatch(['old'], { value: true })), { value: true });
+  assert.deepEqual(createPatch({ unchanged: true }, { unchanged: true }), []);
+});
+
+test('creates array removal operations at the changing index', async () => {
+  const { applyPatch, createPatch } = await import('../dist/index.js');
+  const patch = createPatch(['first', 'obsolete', 'last'], ['first', 'last']);
+
+  assert.deepEqual(patch, [{ op: 'remove', path: '/1' }]);
+  assert.deepEqual(applyPatch(['first', 'obsolete', 'last'], patch), ['first', 'last']);
+});
+
+test('preserves unchanged array values when they shift', async () => {
+  const { applyPatch, createPatch } = await import('../dist/index.js');
+  const from = ['first', 'unchanged', 'last'];
+  const to = ['unchanged', 'last', 'new'];
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'remove', path: '/0' },
+    { op: 'add', path: '/2', value: 'new' },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test('rejects non-JSON inputs', async () => {
+  const { createPatch } = await import('../dist/index.js');
+
+  assert.throws(() => createPatch({ value: Number.NaN }, {}));
+  assert.throws(() => createPatch({}, new Date()));
+});
