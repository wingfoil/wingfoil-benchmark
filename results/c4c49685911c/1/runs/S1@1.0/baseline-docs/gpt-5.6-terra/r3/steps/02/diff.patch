index 0000000000000000000000000000000000000000..ec4629dc4fce7a55a4353e0ca69d1df5803bb21f
--- /dev/null
+++ b/test/apply-patch.test.mjs
@@ -0,0 +1,51 @@
+import assert from 'node:assert/strict';
+import { before, test } from 'node:test';
+import { execFileSync } from 'node:child_process';
+
+before(() => {
+  execFileSync('npx', ['tsc'], { stdio: 'inherit' });
+});
+
+test('applies the operations in the RFC 6902 examples without changing the input', async () => {
+  const { applyPatch } = await import('../dist/index.js');
+  const source = { baz: 'qux', foo: ['bar', 'baz'], a: { b: { c: 'd' } } };
+
+  const result = applyPatch(source, [
+    { op: 'add', path: '/foo/1', value: 'qux' },
+    { op: 'remove', path: '/baz' },
+    { op: 'replace', path: '/a/b/c', value: 'e' },
+    { op: 'move', from: '/foo/0', path: '/foo/2' },
+    { op: 'copy', from: '/a/b/c', path: '/a/b/d' },
+    { op: 'test', path: '/a/b/d', value: 'e' },
+  ]);
+
+  assert.deepEqual(result, {
+    foo: ['qux', 'baz', 'bar'],
+    a: { b: { c: 'e', d: 'e' } },
+  });
+  assert.deepEqual(source, { baz: 'qux', foo: ['bar', 'baz'], a: { b: { c: 'd' } } });
+  assert.notEqual(result, source);
+});
+
+test('supports root replacement, array append, and escaped member names', async () => {
+  const { applyPatch } = await import('../dist/index.js');
+
+  assert.deepEqual(applyPatch({ value: 1 }, [{ op: 'replace', path: '', value: ['root'] }]), ['root']);
+  assert.equal(applyPatch({ value: 1 }, [{ op: 'remove', path: '' }]), null);
+  assert.deepEqual(
+    applyPatch({ 'a/b': [] }, [{ op: 'add', path: '/a~1b/-', value: false }]),
+    { 'a/b': [false] },
+  );
+});
+
+test('rejects malformed patches and operations whose targets do not exist', async () => {
+  const { applyPatch } = await import('../dist/index.js');
+
+  assert.throws(() => applyPatch({}, {}));
+  assert.throws(() => applyPatch({}, [{ op: 'unknown', path: '' }]));
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: 'missing', value: 1 }]));
+  assert.throws(() => applyPatch({ list: [] }, [{ op: 'remove', path: '/list/0' }]));
+  assert.throws(() => applyPatch({ list: [] }, [{ op: 'replace', path: '/list/-', value: 1 }]));
+  assert.throws(() => applyPatch({ a: {} }, [{ op: 'move', from: '/a', path: '/a/b' }]));
+  assert.throws(() => applyPatch({ value: 1 }, [{ op: 'test', path: '/value', value: 2 }]));
+});
