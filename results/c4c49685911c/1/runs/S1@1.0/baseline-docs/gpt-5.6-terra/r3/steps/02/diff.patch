+/**
+ * Applies an RFC 6902 JSON Patch without mutating the source document.
+ *
+ * @param document - The JSON document to patch.
+ * @param patch - An array of JSON Patch operation objects.
+ * @returns A new JSON document containing the result of the patch.
+ * @throws {Error} If the document or patch is invalid, or an operation cannot be applied.
+ */
+export function applyPatch(document: JsonValue, patch: unknown): JsonValue {
+  assertJsonValue(document, 'The document');
+  if (!Array.isArray(patch)) {
+    throw new Error('A JSON Patch must be an array of operations.');
+  }
+  assertJsonValue(patch, 'A JSON Patch');
+
+  let result = cloneJsonValue(document);
+  for (const operation of patch) {
+    result = applyOperation(result, operation);
+  }
+
+  return result;
+}
+
+function applyOperation(document: JsonValue, operation: unknown): JsonValue {
+  if (operation === null || typeof operation !== 'object' || Array.isArray(operation)) {
+    throw new Error('A JSON Patch operation must be an object.');
+  }
+
+  const record = operation as Record<string, unknown>;
+  const op = requiredStringMember(record, 'op');
+  const path = requiredStringMember(record, 'path');
+  const pathTokens = parsePointer(path);
+
+  switch (op) {
+    case 'add':
+      return addValue(document, pathTokens, requiredJsonValueMember(record, 'value'));
+    case 'remove':
+      return removeValue(document, pathTokens);
+    case 'replace':
+      return replaceValue(document, pathTokens, requiredJsonValueMember(record, 'value'));
+    case 'move': {
+      const fromTokens = parsePointer(requiredStringMember(record, 'from'));
+      if (isProperDescendant(pathTokens, fromTokens)) {
+        throw new Error('A move operation cannot move a value into one of its children.');
+      }
+      if (sameTokens(pathTokens, fromTokens)) {
+        getValue(document, fromTokens);
+        return document;
+      }
+      const value = getValue(document, fromTokens);
+      return addValue(removeValue(document, fromTokens), pathTokens, value);
+    }
+    case 'copy': {
+      const value = getValue(document, parsePointer(requiredStringMember(record, 'from')));
+      return addValue(document, pathTokens, value);
+    }
+    case 'test': {
+      const expected = requiredJsonValueMember(record, 'value');
+      if (!jsonEqual(getValue(document, pathTokens), expected)) {
+        throw new Error(`JSON Patch test operation failed at "${path}".`);
+      }
+      return document;
+    }
+    default:
+      throw new Error(`Unsupported JSON Patch operation "${op}".`);
+  }
+}
+
+function requiredStringMember(record: Record<string, unknown>, member: string): string {
+  if (!Object.prototype.hasOwnProperty.call(record, member) || typeof record[member] !== 'string') {
+    throw new Error(`A JSON Patch operation requires a string "${member}" member.`);
+  }
+  return record[member];
+}
+
+function requiredJsonValueMember(record: Record<string, unknown>, member: string): JsonValue {
+  if (!Object.prototype.hasOwnProperty.call(record, member)) {
+    throw new Error(`A JSON Patch operation requires a "${member}" member.`);
+  }
+  assertJsonValue(record[member], `The JSON Patch "${member}" member`);
+  return record[member];
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === '') {
+    return [];
+  }
+  if (!pointer.startsWith('/')) {
+    throw new Error('A non-empty JSON Pointer must start with "/".');
+  }
+  return pointer.slice(1).split('/').map(decodeReferenceToken);
+}
+
+function getValue(document: JsonValue, tokens: readonly string[]): JsonValue {
+  let value = document;
+  for (const token of tokens) {
+    value = resolveToken(value, token);
+  }
+  return value;
+}
+
+function addValue(document: JsonValue, tokens: readonly string[], value: JsonValue): JsonValue {
+  const copy = cloneJsonValue(value);
+  if (tokens.length === 0) {
+    return copy;
+  }
+
+  const { parent, token } = resolveParent(document, tokens);
+  if (Array.isArray(parent)) {
+    if (token === '-') {
+      parent.push(copy);
+    } else {
+      parent.splice(arrayIndex(token, parent.length, true), 0, copy);
+    }
+  } else if (isJsonObject(parent)) {
+    setObjectMember(parent, token, copy);
+  } else {
+    throw new Error('Cannot add a JSON Patch value to a primitive.');
+  }
+  return document;
+}
+
+function removeValue(document: JsonValue, tokens: readonly string[]): JsonValue {
+  if (tokens.length === 0) {
+    return null;
+  }
+
+  const { parent, token } = resolveParent(document, tokens);
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(token, parent.length, false), 1);
+  } else if (isJsonObject(parent)) {
+    if (!Object.prototype.hasOwnProperty.call(parent, token)) {
+      throw new Error(`JSON Pointer object member "${token}" does not exist.`);
+    }
+    delete parent[token];
+  } else {
+    throw new Error('Cannot remove a JSON Patch value from a primitive.');
+  }
+  return document;
+}
+
+function replaceValue(document: JsonValue, tokens: readonly string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) {
+    return cloneJsonValue(value);
+  }
+
+  const { parent, token } = resolveParent(document, tokens);
+  if (Array.isArray(parent)) {
+    parent[arrayIndex(token, parent.length, false)] = cloneJsonValue(value);
+  } else if (isJsonObject(parent)) {
+    if (!Object.prototype.hasOwnProperty.call(parent, token)) {
+      throw new Error(`JSON Pointer object member "${token}" does not exist.`);
+    }
+    setObjectMember(parent, token, cloneJsonValue(value));
+  } else {
+    throw new Error('Cannot replace a JSON Patch value in a primitive.');
+  }
+  return document;
+}
+
+function resolveParent(document: JsonValue, tokens: readonly string[]): { parent: JsonValue; token: string } {
+  return { parent: getValue(document, tokens.slice(0, -1)), token: tokens[tokens.length - 1]! };
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (!/^(?:0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`"${token}" is not a valid JSON Pointer array index.`);
+  }
+  const index = Number(token);
+  if (!Number.isSafeInteger(index) || index > length || (!allowEnd && index === length)) {
+    throw new Error(`JSON Pointer array index "${token}" does not exist.`);
+  }
+  return index;
+}
+
+function isProperDescendant(candidate: readonly string[], ancestor: readonly string[]): boolean {
+  return candidate.length > ancestor.length && ancestor.every((token, index) => candidate[index] === token);
+}
+
+function sameTokens(left: readonly string[], right: readonly string[]): boolean {
+  return left.length === right.length && left.every((token, index) => right[index] === token);
+}
+
+function isJsonObject(value: JsonValue): value is { [member: string]: JsonValue } {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function setObjectMember(object: { [member: string]: JsonValue }, member: string, value: JsonValue): void {
+  Object.defineProperty(object, member, { configurable: true, enumerable: true, value, writable: true });
+}
+
+function jsonEqual(left: JsonValue, right: JsonValue): boolean {
+  if (left === right) {
+    return true;
+  }
+  if (typeof left !== typeof right || left === null || right === null) {
+    return false;
+  }
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return Array.isArray(left) && Array.isArray(right)
+      && left.length === right.length
+      && left.every((value, index) => jsonEqual(value, right[index]!));
+  }
+  if (isJsonObject(left) && isJsonObject(right)) {
+    const leftKeys = Object.keys(left);
+    return leftKeys.length === Object.keys(right).length
+      && leftKeys.every((key) => Object.prototype.hasOwnProperty.call(right, key) && jsonEqual(left[key]!, right[key]!));
+  }
+  return false;
+}
+
+function assertJsonValue(value: unknown, label: string, ancestors = new Set<object>()): asserts value is JsonValue {
+  if (value === null || typeof value === 'string' || typeof value === 'boolean') {
+    return;
+  }
+  if (typeof value === 'number') {
+    if (Number.isFinite(value)) {
+      return;
+    }
+  } else if (typeof value === 'object' && !Array.isArray(value)) {
+    if (Object.getPrototypeOf(value) !== Object.prototype && Object.getPrototypeOf(value) !== null) {
+      throw new Error(`${label} must be a JSON value.`);
+    }
+    if (ancestors.has(value)) {
+      throw new Error(`${label} must not contain a circular reference.`);
+    }
+    ancestors.add(value);
+    for (const key of Object.keys(value)) {
+      assertJsonValue((value as Record<string, unknown>)[key], label, ancestors);
+    }
+    ancestors.delete(value);
+    return;
+  } else if (Array.isArray(value)) {
+    if (ancestors.has(value)) {
+      throw new Error(`${label} must not contain a circular reference.`);
+    }
+    ancestors.add(value);
+    for (const item of value) {
+      assertJsonValue(item, label, ancestors);
+    }
+    ancestors.delete(value);
+    return;
+  }
+  throw new Error(`${label} must be a JSON value.`);
+}
+
+function cloneJsonValue(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(cloneJsonValue);
+  }
+  if (isJsonObject(value)) {
+    const copy: { [member: string]: JsonValue } = {};
+    for (const key of Object.keys(value)) {
+      setObjectMember(copy, key, cloneJsonValue(value[key]!));
+    }
+    return copy;
+  }
+  return value;
+}
+
 function decodeReferenceToken(token: string): string {
   if (/~(?:[^01]|$)/.test(token)) {
     throw new Error(`Invalid JSON Pointer escape sequence in token "${token}".`);
