+/**
+ * Applies an RFC 7386 JSON Merge Patch without mutating either input document.
+ *
+ * Object members with a null patch value are removed. A non-object patch replaces
+ * the target value, while arrays are replaced as whole values.
+ *
+ * @param target - The JSON document to update.
+ * @param patch - The JSON Merge Patch document to apply.
+ * @returns A new JSON document containing the merged result.
+ * @throws {Error} If either argument is not a JSON value.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  assertJsonValue(target, 'The target');
+  assertJsonValue(patch, 'The JSON Merge Patch');
+  return mergePatch(target, patch);
+}
+
+function mergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return cloneJsonValue(patch);
+  }
+
+  const result: { [member: string]: JsonValue } = isJsonObject(target) ? cloneJsonObject(target) : {};
+  for (const member of Object.keys(patch)) {
+    const value = patch[member]!;
+    if (value === null) {
+      delete result[member];
+    } else {
+      setObjectMember(result, member, mergePatch(result[member] ?? null, value));
+    }
+  }
+  return result;
+}
+
 function applyOperation(document: JsonValue, operation: unknown): JsonValue {
   if (operation === null || typeof operation !== 'object' || Array.isArray(operation)) {
     throw new Error('A JSON Patch operation must be an object.');
@@ -340,15 +374,19 @@ function cloneJsonValue(value: JsonValue): JsonValue {
     return value.map(cloneJsonValue);
   }
   if (isJsonObject(value)) {
-    const copy: { [member: string]: JsonValue } = {};
-    for (const key of Object.keys(value)) {
-      setObjectMember(copy, key, cloneJsonValue(value[key]!));
-    }
-    return copy;
+    return cloneJsonObject(value);
   }
   return value;
 }
 
+function cloneJsonObject(value: { [member: string]: JsonValue }): { [member: string]: JsonValue } {
+  const copy: { [member: string]: JsonValue } = {};
+  for (const key of Object.keys(value)) {
+    setObjectMember(copy, key, cloneJsonValue(value[key]!));
+  }
+  return copy;
+}
