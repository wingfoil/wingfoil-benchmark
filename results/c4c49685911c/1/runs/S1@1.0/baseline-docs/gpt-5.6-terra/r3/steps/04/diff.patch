@@ -34,3 +34,18 @@ applyPatch({ users: ['Ada'] }, [
   { op: 'add', path: '/users/-', value: 'Grace' },
 ]); // { users: ['Ada', 'Grace'] }
 ```
+
+## JSON Merge Patch
+
+`applyMergePatch(target, patch)` applies an [RFC 7386 JSON Merge Patch](https://www.rfc-editor.org/rfc/rfc7386)
+without mutating either input. Object members set to `null` in the patch are removed; arrays and other
+non-object values replace their target wholesale.
+
+```ts
+import { applyMergePatch } from 'json-toolkit';
+
+applyMergePatch(
+  { title: 'Draft', author: { name: 'Ada', email: 'ada@example.test' } },
+  { title: 'Published', author: { email: null } },
+); // { title: 'Published', author: { name: 'Ada' } }
+```
