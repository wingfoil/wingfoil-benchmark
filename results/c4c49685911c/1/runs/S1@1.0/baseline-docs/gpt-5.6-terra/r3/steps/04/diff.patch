diff --git a/test/apply-merge-patch.test.mjs b/test/apply-merge-patch.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..19e2d5a3618f304f99f8e6194344ec69de313025
--- /dev/null
+++ b/test/apply-merge-patch.test.mjs
@@ -0,0 +1,39 @@
+import assert from 'node:assert/strict';
+import { before, test } from 'node:test';
+import { execFileSync } from 'node:child_process';
+
+before(() => {
+  execFileSync('npx', ['tsc'], { stdio: 'inherit' });
+});
+
+test('applies the RFC 7386 merge patch examples without changing the target or patch', async () => {
+  const { applyMergePatch } = await import('../dist/index.js');
+  const target = { title: 'Goodbye!', author: { givenName: 'John', familyName: 'Doe' }, tags: ['example', 'sample'], content: 'This will be unchanged' };
+  const patch = { title: 'Hello!', phoneNumber: '+01-123-456-7890', author: { familyName: null }, tags: ['example'] };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: 'Hello!',
+    author: { givenName: 'John' },
+    tags: ['example'],
+    content: 'This will be unchanged',
+    phoneNumber: '+01-123-456-7890',
+  });
+  assert.deepEqual(target, { title: 'Goodbye!', author: { givenName: 'John', familyName: 'Doe' }, tags: ['example', 'sample'], content: 'This will be unchanged' });
+  assert.deepEqual(patch, { title: 'Hello!', phoneNumber: '+01-123-456-7890', author: { familyName: null }, tags: ['example'] });
+});
+
+test('treats a non-object target as an empty object and replaces with non-object patches', async () => {
+  const { applyMergePatch } = await import('../dist/index.js');
+
+  assert.deepEqual(applyMergePatch(['a', 'b'], { value: null, added: true }), { added: true });
+  assert.deepEqual(applyMergePatch({ value: true }, ['replaced']), ['replaced']);
+  assert.equal(applyMergePatch({ value: true }, null), null);
+});
+
+test('accepts only JSON documents', async () => {
+  const { applyMergePatch } = await import('../dist/index.js');
+
+  assert.throws(() => applyMergePatch({ value: 1 }, { value: Number.NaN }));
+  assert.throws(() => applyMergePatch({ value: 1 }, new Date()));
+  assert.throws(() => applyMergePatch(new Date(), {}));
+});
