diff --git a/test/applyPatch.test.mjs b/test/applyPatch.test.mjs
index 476d2d72c5d4ed24b551b8be8eaf94e429fc5be4..b0054857b01edcfe67126e3732bf661280402b8c 100644
--- a/test/applyPatch.test.mjs
+++ b/test/applyPatch.test.mjs
@@ -60,3 +60,35 @@ test("rejects malformed patches and failed operations", () => {
     assert.throws(() => applyPatch(document, patch));
   }
 });
+
+test("rejects JavaScript values that cannot represent a JSON Patch document", () => {
+  class AddOperation {
+    op = "add";
+    path = "/added";
+    value = true;
+  }
+
+  const patchWithNamedMember = [{ op: "add", path: "/added", value: true }];
+  patchWithNamedMember.metadata = "not JSON";
+
+  assert.throws(() => applyPatch({}, [new AddOperation()]));
+  assert.throws(() => applyPatch({}, patchWithNamedMember));
+  assert.throws(() => applyPatch({}, [{
+    get op() {
+      return "add";
+    },
+    path: "/added",
+    value: true,
+  }]));
+});
+
+test("leaves the supplied document unchanged when a later operation fails", () => {
+  const original = { status: "pending" };
+
+  assert.throws(() => applyPatch(original, [
+    { op: "replace", path: "/status", value: "updated" },
+    { op: "test", path: "/status", value: "pending" },
+  ]));
+
+  assert.deepEqual(original, { status: "pending" });
+});
