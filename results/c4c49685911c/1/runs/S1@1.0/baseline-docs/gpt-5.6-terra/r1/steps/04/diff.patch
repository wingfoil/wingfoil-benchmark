diff --git a/test/applyMergePatch.test.mjs b/test/applyMergePatch.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a4c5283d075413f7611914152df4d49758257abc
--- /dev/null
+++ b/test/applyMergePatch.test.mjs
@@ -0,0 +1,51 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyMergePatch } from "../src/index.ts";
+
+test("applies the RFC 7386 merge-patch example without mutating either input", () => {
+  const target = {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+  assert.deepEqual(target, {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  });
+  assert.deepEqual(patch, {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  });
+});
+
+test("replaces any target with a non-object patch and treats non-object targets as empty objects", () => {
+  assert.deepEqual(applyMergePatch({ value: true }, ["replacement"]), ["replacement"]);
+  assert.deepEqual(applyMergePatch("old value", { added: true }), { added: true });
+  assert.equal(applyMergePatch({ value: true }, null), null);
+});
+
+test("validates JSON-compatible target and patch documents", () => {
+  assert.throws(() => applyMergePatch({ value: 1 }, Number.NaN));
+  assert.throws(() => applyMergePatch({ value: 1 }, { get value() { return true; } }));
+  assert.throws(() => applyMergePatch({ value: undefined }, {}));
+});
