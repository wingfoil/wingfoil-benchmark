+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document without modifying either input.
+ *
+ * @param target The JSON document to patch.
+ * @param patch The JSON Merge Patch document.
+ * @returns A new JSON value containing the merged document.
+ * @throws {TypeError} If the target or patch is not a JSON-compatible value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return mergePatch(cloneJsonValue(target), cloneJsonValue(patch));
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonRecord(patch)) {
+    return patch;
+  }
+
+  const result: Record<string, unknown> = isJsonRecord(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      defineJsonMember(result, key, mergePatch(result[key], value));
+    }
+  }
+  return result;
+}
