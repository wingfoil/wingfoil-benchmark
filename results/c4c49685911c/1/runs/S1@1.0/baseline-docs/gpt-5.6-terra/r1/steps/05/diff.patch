new file mode 100644
index 0000000000000000000000000000000000000000..fe0432b4806c1339a8b7a9045b79fae16989ebd3
--- /dev/null
+++ b/test/createPatch.test.mjs
@@ -0,0 +1,54 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyPatch, createPatch } from "../src/index.ts";
+
+test("creates a patch for a small nested change without replacing the document", () => {
+  const from = {
+    profile: { name: "Ada", settings: { theme: "light", alerts: true } },
+    projects: ["json-toolkit"],
+  };
+  const to = {
+    profile: { name: "Ada", settings: { theme: "dark", alerts: true } },
+    projects: ["json-toolkit"],
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: "replace", path: "/profile/settings/theme", value: "dark" }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from.profile.settings, { theme: "light", alerts: true });
+  assert.deepEqual(to.profile.settings, { theme: "dark", alerts: true });
+});
+
+test("creates add, remove, and array operations with escaped pointer tokens", () => {
+  const from = { "a/b": { "m~n": 1 }, items: ["Ada", "Linus"] };
+  const to = { "a/b": { "m~n": 2, enabled: true }, items: ["Grace", "Ada"] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "replace", path: "/a~1b/m~0n", value: 2 },
+    { op: "add", path: "/a~1b/enabled", value: true },
+    { op: "add", path: "/items/0", value: "Grace" },
+    { op: "remove", path: "/items/2" },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("creates an empty patch for equal values and replaces a changed root", () => {
+  assert.deepEqual(createPatch({ value: [1] }, { value: [1] }), []);
+  assert.deepEqual(createPatch({ value: true }, ["replacement"]), [
+    { op: "replace", path: "", value: ["replacement"] },
+  ]);
+});
+
+test("validates JSON values and does not retain mutable target values", () => {
+  assert.throws(() => createPatch({ value: 1 }, { value: Number.NaN }));
+
+  const to = { added: { enabled: true } };
+  const patch = createPatch({}, to);
+  to.added.enabled = false;
+
+  assert.deepEqual(applyPatch({}, patch), { added: { enabled: true } });
+});
