+function createPatchAt(
+  from: unknown,
+  to: unknown,
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (isJsonRecord(from) && isJsonRecord(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.prototype.hasOwnProperty.call(to, key)) {
+        patch.push({ op: "remove", path: appendPointer(path, key) });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      const childPath = appendPointer(path, key);
+      if (Object.prototype.hasOwnProperty.call(from, key)) {
+        createPatchAt(from[key], to[key], childPath, patch);
+      } else {
+        patch.push({ op: "add", path: childPath, value: to[key] });
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatch(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: "replace", path, value: to });
+}
+
+function createArrayPatch(
+  from: unknown[],
+  to: unknown[],
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  let fromIndex = 0;
+  let toIndex = 0;
+
+  while (fromIndex < from.length && toIndex < to.length) {
+    if (jsonEqual(from[fromIndex], to[toIndex])) {
+      fromIndex += 1;
+      toIndex += 1;
+      continue;
+    }
+
+    if (findJsonValue(to, toIndex + 1, from[fromIndex]) !== -1) {
+      patch.push({ op: "add", path: appendPointer(path, String(toIndex)), value: to[toIndex] });
+      toIndex += 1;
+      continue;
+    }
+
+    if (findJsonValue(from, fromIndex + 1, to[toIndex]) !== -1) {
+      patch.push({ op: "remove", path: appendPointer(path, String(toIndex)) });
+      fromIndex += 1;
+      continue;
+    }
+
+    createPatchAt(from[fromIndex], to[toIndex], appendPointer(path, String(toIndex)), patch);
+    fromIndex += 1;
+    toIndex += 1;
+  }
+
+  while (fromIndex < from.length) {
+    patch.push({ op: "remove", path: appendPointer(path, String(toIndex)) });
+    fromIndex += 1;
+  }
+  while (toIndex < to.length) {
+    patch.push({ op: "add", path: appendPointer(path, "-"), value: to[toIndex] });
+    toIndex += 1;
+  }
+}
+
+function findJsonValue(values: unknown[], start: number, value: unknown): number {
+  for (let index = start; index < values.length; index += 1) {
+    if (jsonEqual(values[index], value)) {
+      return index;
+    }
+  }
+  return -1;
+}
+
+function appendPointer(pointer: string, token: string): string {
+  return `${pointer}/${token.replace(/~/g, "~0").replace(/\//g, "~1")}`;
+}
