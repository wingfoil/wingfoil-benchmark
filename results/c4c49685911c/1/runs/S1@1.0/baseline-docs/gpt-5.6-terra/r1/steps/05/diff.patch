+/**
+ * An RFC 6902 operation that adds, removes, or replaces a JSON value.
+ */
+export type JsonPatchOperation =
+  | { op: "add"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "replace"; path: string; value: unknown };
+
+/**
+ * Creates an RFC 6902 JSON Patch that transforms one JSON document into another.
+ *
+ * The returned patch changes only the differing values where possible. Both input
+ * documents are validated as JSON-compatible values and are never modified.
+ *
+ * @param from The original JSON document.
+ * @param to The desired JSON document.
+ * @returns An ordered JSON Patch that transforms `from` into `to`.
+ * @throws {TypeError} If either document is not a JSON-compatible value.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const source = cloneJsonValue(from);
+  const target = cloneJsonValue(to);
+  const patch: JsonPatchOperation[] = [];
+
+  createPatchAt(source, target, "", patch);
+  return patch;
+}
