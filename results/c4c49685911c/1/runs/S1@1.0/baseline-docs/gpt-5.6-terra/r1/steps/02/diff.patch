index 0000000000000000000000000000000000000000..476d2d72c5d4ed24b551b8be8eaf94e429fc5be4
--- /dev/null
+++ b/test/applyPatch.test.mjs
@@ -0,0 +1,62 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyPatch } from "../src/index.ts";
+
+test("applies each JSON Patch operation without mutating its input", () => {
+  const original = {
+    foo: ["bar", "baz"],
+    nested: { value: 1 },
+  };
+
+  const result = applyPatch(original, [
+    { op: "add", path: "/foo/1", value: "qux" },
+    { op: "add", path: "/extra", value: { enabled: true } },
+    { op: "replace", path: "/nested/value", value: 2 },
+    { op: "copy", from: "/extra", path: "/copied" },
+    { op: "move", from: "/foo/0", path: "/foo/-" },
+    { op: "remove", path: "/foo/1" },
+    { op: "test", path: "/nested", value: { value: 2 } },
+  ]);
+
+  assert.deepEqual(result, {
+    foo: ["qux", "bar"],
+    nested: { value: 2 },
+    extra: { enabled: true },
+    copied: { enabled: true },
+  });
+  assert.deepEqual(original, {
+    foo: ["bar", "baz"],
+    nested: { value: 1 },
+  });
+  assert.notEqual(result, original);
+  assert.notEqual(result.extra, result.copied);
+});
+
+test("supports escaped pointer tokens and replacing the document root", () => {
+  assert.deepEqual(
+    applyPatch({ "a/b": { "m~n": 1 } }, [
+      { op: "replace", path: "/a~1b/m~0n", value: 2 },
+      { op: "add", path: "", value: ["new document"] },
+    ]),
+    ["new document"],
+  );
+});
+
+test("rejects malformed patches and failed operations", () => {
+  const document = { items: ["a"], object: { value: 1 } };
+
+  for (const patch of [
+    {},
+    [{ op: "unknown", path: "/items" }],
+    [{ op: "add", path: "items", value: 1 }],
+    [{ op: "add", path: "/items/2", value: "b" }],
+    [{ op: "remove", path: "/missing" }],
+    [{ op: "replace", path: "/missing", value: 1 }],
+    [{ op: "move", from: "/object", path: "/object/child" }],
+    [{ op: "copy", path: "/copy" }],
+    [{ op: "test", path: "/object", value: { value: 2 } }],
+  ]) {
+    assert.throws(() => applyPatch(document, patch));
+  }
+});
