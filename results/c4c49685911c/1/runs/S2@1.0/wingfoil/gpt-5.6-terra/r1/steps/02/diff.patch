index 0000000000000000000000000000000000000000..4aaade28e1777f0c1089db46805d85f7107f197b
--- /dev/null
+++ b/test/invoices.test.ts
@@ -0,0 +1,44 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createShop } from '../src/index.ts';
+
+describe('invoices with exempt delivery', () => {
+  // Red-first: paid delivery belongs in the exempt row and must stay in the total.
+  it('includes shipping at 0% and keeps the invoice total equal to the order total', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'MUG', name: 'Mug', priceCents: 1000, vatClass: 'standard', weightGrams: 300 });
+    s.inventory.restock('MUG', 1);
+    const order = s.orders.place({ customer: 'Anna', date: '2026-11-01', lines: [{ sku: 'MUG', quantity: 1 }] });
+    const invoice = s.invoices.issue(s.orders.ship(order.id, '2026-11-02'));
+    assert.deepEqual(invoice.vat, [
+      { rate: 22, netCents: 1000, vatCents: 220 },
+      { rate: 0, netCents: 490, vatCents: 0 },
+    ]);
+    assert.equal(invoice.totalCents, 1710);
+    assert.equal(invoice.totalCents, order.totals.totalCents);
+  });
+
+  // Red-first: exempt goods and paid delivery share the same summary row.
+  it('combines delivery with exempt goods without charging VAT', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'EXEMPT', name: 'Exempt goods', priceCents: 1000, vatClass: 'exempt', weightGrams: 10 });
+    s.inventory.restock('EXEMPT', 1);
+    const order = s.orders.place({ customer: 'c-1', date: '2026-11-01', lines: [{ sku: 'EXEMPT', quantity: 1 }] });
+    const invoice = s.invoices.issue(s.orders.ship(order.id, '2026-11-02'));
+    assert.deepEqual(invoice.vat, [{ rate: 0, netCents: 1490, vatCents: 0 }]);
+    assert.equal(invoice.totalCents, 1490);
+    assert.equal(invoice.totalCents, order.totals.totalCents);
+  });
+
+  // Characterization: free delivery must not add an empty exempt summary row.
+  it('omits the delivery row when shipping is free', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'MUG', name: 'Mug', priceCents: 1000, vatClass: 'standard', weightGrams: 300 });
+    s.inventory.restock('MUG', 5);
+    const order = s.orders.place({ customer: 'c-1', date: '2026-11-01', lines: [{ sku: 'MUG', quantity: 5 }] });
+    const invoice = s.invoices.issue(s.orders.ship(order.id, '2026-11-02'));
+    assert.deepEqual(invoice.vat, [{ rate: 22, netCents: 5000, vatCents: 1100 }]);
+    assert.equal(invoice.totalCents, order.totals.totalCents);
+  });
+});
