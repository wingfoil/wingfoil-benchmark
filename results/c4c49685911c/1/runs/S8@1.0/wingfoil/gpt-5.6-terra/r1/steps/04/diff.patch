 export { PRIORITIES } from './domain/task.ts';
 export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 
+/** A source line that could not be imported, with its one-based line number and failure reason. */
+export interface RejectedTaskImport {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The result of importing task records: successfully added tasks and records that were rejected. */
+export interface TaskImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedTaskImport[];
+}
+
 /**
  * A new, empty task list for the app, kept in memory.
  */
 export function createTodoList(): TaskList {
   return createTaskList();
 }
+
+/**
+ * Imports semicolon-separated task records into `list`.
+ *
+ * Each non-blank line in `text` must contain `title;priority;tags`, where the priority is empty or
+ * one of `low`, `normal`, and `high`, and tags are separated by whitespace. Valid lines are added
+ * independently; rejected lines are returned with their one-based source line and reason.
+ *
+ * @param list - the task list to add imported tasks to
+ * @param text - newline-separated task records to import
+ */
+export function importTasks(list: TaskList, text: string): TaskImportResult {
+  const rejected: RejectedTaskImport[] = [];
+  let imported = 0;
+
+  for (const [index, line] of text.split(/\r?\n/).entries()) {
+    if (line.trim() === '') continue;
+
+    const fields = line.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'expected title;priority;tags' });
+      continue;
+    }
+
+    const [title, priorityText, tagsText] = fields;
+    if (title.trim() === '') {
+      rejected.push({ line: index + 1, reason: 'title is required' });
+      continue;
+    }
+
+    const priority = priorityText.trim();
+    if (priority !== '' && priority !== 'low' && priority !== 'normal' && priority !== 'high') {
+      rejected.push({ line: index + 1, reason: 'priority must be low, normal, or high' });
+      continue;
+    }
+
+    const result = list.add({
+      title,
+      ...(priority === '' ? {} : { priority }),
+      tags: tagsText.trim() === '' ? [] : tagsText.trim().split(/\s+/),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  }
+
+  return { imported, rejected };
+}
