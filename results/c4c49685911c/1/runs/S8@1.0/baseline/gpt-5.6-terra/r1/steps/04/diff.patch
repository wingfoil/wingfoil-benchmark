 export type { TaskFilter, TaskList } from './domain/list.ts';
 export type { Result, TodoError, TodoErrorCode } from './domain/result.ts';
@@ -14,3 +15,53 @@ export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 export function createTodoList(): TaskList {
   return createTaskList();
 }
+
+/** A line that could not be imported, together with why it was rejected. */
+export interface ImportRejection {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of importing tasks from text. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
+/**
+ * Adds tasks described by lines of `title;priority;tags` text.
+ *
+ * An empty priority uses the normal priority. Tags are separated by whitespace,
+ * and blank lines are ignored.
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: ImportRejection[] = [];
+
+  for (const [index, line] of text.split(/\r?\n/).entries()) {
+    if (line.trim().length === 0) continue;
+
+    const fields = line.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'expected title;priority;tags' });
+      continue;
+    }
+
+    const [title, priorityText, tagsText] = fields;
+    const priority = priorityText.trim();
+    const tags = tagsText.trim() === '' ? [] : tagsText.trim().split(/\s+/);
+    const result = list.add({
+      title,
+      priority: priority === '' ? undefined : (priority as Priority),
+      tags,
+    });
+
+    if (result.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line: index + 1, reason: result.error.message });
+    }
+  }
+
+  return { imported, rejected };
+}
