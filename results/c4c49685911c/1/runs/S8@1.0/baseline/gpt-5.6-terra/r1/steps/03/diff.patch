+
+function validateNewTask(input: NewTask): Result<never> | undefined {
+  return validateTitle(input.title) ?? validatePriority(input.priority) ?? validateTags(input.tags);
+}
+
+function validateTitle(title: string): Result<never> | undefined {
+  const trimmed = title.trim();
+  if (trimmed.length === 0) return err('invalid-input', 'title must not be empty or only spaces');
+  if (trimmed.length > 120) return err('invalid-input', 'title must be 120 characters or fewer');
+  return undefined;
+}
+
+function validatePriority(priority: Priority | undefined): Result<never> | undefined {
+  if (priority !== undefined && !PRIORITIES.includes(priority)) {
+    return err('invalid-input', 'priority must be low, normal, or high');
+  }
+  return undefined;
+}
+
+function validateTags(tags: readonly string[] | undefined): Result<never> | undefined {
+  return tags?.map(validateTag).find((error) => error !== undefined);
+}
+
+function validateTag(tag: string): Result<never> | undefined {
+  if (tag.length === 0) return err('invalid-input', 'tag must not be empty');
+  if (tag.includes(' ')) return err('invalid-input', 'tag must not contain spaces');
+  return undefined;
+}
