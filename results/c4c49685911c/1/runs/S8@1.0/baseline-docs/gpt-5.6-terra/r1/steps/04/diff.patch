diff --git a/src/import.ts b/src/import.ts
new file mode 100644
index 0000000000000000000000000000000000000000..68706a6f8d130723fd0d9723ea90f5c630d0e408
--- /dev/null
+++ b/src/import.ts
@@ -0,0 +1,65 @@
+import { PRIORITIES } from './domain/task.ts';
+import type { NewTask } from './domain/task.ts';
+import type { TaskList } from './domain/list.ts';
+
+/** A spreadsheet row that could not be imported. */
+export interface RejectedTaskImport {
+  /** The one-based line number in the imported text. */
+  readonly line: number;
+  /** Why the row could not be added to the task list. */
+  readonly reason: string;
+}
+
+/** The outcome of importing tasks from spreadsheet text. */
+export interface TaskImportResult {
+  /** The number of tasks added to the task list. */
+  readonly imported: number;
+  /** Every nonblank row that could not be added. */
+  readonly rejected: readonly RejectedTaskImport[];
+}
+
+/**
+ * Imports `title;priority;tags` rows into a task list, skipping blank rows and retaining rejected rows.
+ *
+ * @param list - the task list to add valid rows to
+ * @param text - newline-separated spreadsheet rows; tags are space-separated
+ */
+export function importTasks(list: TaskList, text: string): TaskImportResult {
+  const rejected: RejectedTaskImport[] = [];
+  let imported = 0;
+
+  for (const [index, row] of text.split(/\r\n?|\n/).entries()) {
+    if (row.trim().length === 0) continue;
+
+    const fields = row.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'line must contain title;priority;tags' });
+      continue;
+    }
+
+    const input = parseRow(fields);
+    if (typeof input === 'string') {
+      rejected.push({ line: index + 1, reason: input });
+      continue;
+    }
+
+    const added = list.add(input);
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  }
+
+  return { imported, rejected };
+}
+
+function parseRow([title, priority, tags]: string[]): NewTask | string {
+  const normalizedPriority = priority.trim();
+  if (normalizedPriority !== '' && !(PRIORITIES as readonly string[]).includes(normalizedPriority)) {
+    return 'priority must be low, normal, or high';
+  }
+
+  return {
+    title,
+    ...(normalizedPriority === '' ? {} : { priority: normalizedPriority as NewTask['priority'] }),
+    tags: tags.trim() === '' ? [] : tags.trim().split(/\s+/),
+  };
+}
