 describe('task list', () => {
+  it('records creation and change times for every successful task mutation', () => {
+    const times = [
+      '2026-10-26T10:00:00.000Z',
+      '2026-10-26T10:01:00.000Z',
+      '2026-10-26T10:02:00.000Z',
+      '2026-10-26T10:03:00.000Z',
+      '2026-10-26T10:04:00.000Z',
+      '2026-10-26T10:05:00.000Z',
+    ];
+    const list = createTodoList(() => times.shift() as string);
+
+    const added = valueOf(list.add({ title: 'Water plants' }));
+    assert.equal(added.createdAt, '2026-10-26T10:00:00.000Z');
+    assert.equal(added.updatedAt, added.createdAt);
+
+    assert.equal(valueOf(list.complete(added.id)).updatedAt, '2026-10-26T10:01:00.000Z');
+    assert.equal(valueOf(list.reopen(added.id)).updatedAt, '2026-10-26T10:02:00.000Z');
+    assert.equal(valueOf(list.rename(added.id, 'Water herbs')).updatedAt, '2026-10-26T10:03:00.000Z');
+    assert.equal(valueOf(list.tag(added.id, 'garden')).updatedAt, '2026-10-26T10:04:00.000Z');
+    const untagged = valueOf(list.untag(added.id, 'garden'));
+    assert.equal(untagged.updatedAt, '2026-10-26T10:05:00.000Z');
+    assert.equal(untagged.createdAt, added.createdAt);
+  });
+
   it('adds an open task with a normal priority by default', () => {
     const list = createTodoList();
     const task = valueOf(list.add({ title: '  Buy milk ' }));
-    assert.deepEqual(task, { id: 'task-1', title: 'Buy milk', priority: 'normal', tags: [], status: 'open' });
+    assert.equal(task.id, 'task-1');
+    assert.equal(task.title, 'Buy milk');
+    assert.equal(task.priority, 'normal');
+    assert.deepEqual(task.tags, []);
+    assert.equal(task.status, 'open');
+    assert.match(task.createdAt, /^\d{4}-\d{2}-\d{2}T/);
+    assert.equal(task.updatedAt, task.createdAt);
     assert.equal(list.openCount(), 1);
   });
 
