+
+function validateTitle(input: string): Result<string> {
+  const title = input.trim();
+  if (title.length === 0) return err('invalid-input', 'title cannot be empty');
+  if (title.length > 120) return err('invalid-input', 'title cannot be longer than 120 characters');
+  return ok(title);
+}
+
+function validatePriority(priority: Priority | undefined): Result<Priority> {
+  if (priority === undefined || PRIORITIES.includes(priority)) return ok(priority ?? 'normal');
+  return err('invalid-input', 'priority must be low, normal, or high');
+}
+
+function validateTags(tags: readonly string[]): Result<readonly string[]> {
+  for (const tag of tags) {
+    const validTag = validateTag(tag);
+    if (!validTag.ok) return validTag;
+  }
+  return ok(tags);
+}
+
+function validateTag(tag: string): Result<string> {
+  if (tag.length === 0) return err('invalid-input', 'tag cannot be empty');
+  if (tag.includes(' ')) return err('invalid-input', 'tag cannot contain a space');
+  return ok(tag);
+}
