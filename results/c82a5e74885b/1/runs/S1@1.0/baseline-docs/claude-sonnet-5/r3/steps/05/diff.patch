+
+/** Diffs the common indices of two arrays in place, then the length difference at the tail. */
+function diffArrays(from: readonly unknown[], to: readonly unknown[], path: string, ops: JsonPatchOperation[]): void {
+  const commonLength = Math.min(from.length, to.length);
+  for (let index = 0; index < commonLength; index++) {
+    diffValues(from[index], to[index], `${path}/${index}`, ops);
+  }
+  for (let index = from.length - 1; index >= commonLength; index--) {
+    ops.push({ op: "remove", path: `${path}/${index}` });
+  }
+  for (let index = commonLength; index < to.length; index++) {
+    ops.push({ op: "add", path: `${path}/-`, value: structuredClone(to[index]) });
+  }
+}
+
+/** Diffs two plain objects member by member: removals, then additions and recursive changes. */
+function diffObjects(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  path: string,
+  ops: JsonPatchOperation[],
+): void {
+  for (const member of Object.keys(from)) {
+    if (!Object.prototype.hasOwnProperty.call(to, member)) {
+      ops.push({ op: "remove", path: `${path}/${escapeToken(member)}` });
+    }
+  }
+  for (const member of Object.keys(to)) {
+    const memberPath = `${path}/${escapeToken(member)}`;
+    if (Object.prototype.hasOwnProperty.call(from, member)) {
+      diffValues(from[member], to[member], memberPath, ops);
+    } else {
+      ops.push({ op: "add", path: memberPath, value: structuredClone(to[member]) });
+    }
+  }
+}
+
+/** Appends the operations that turn the value at `path` in `from` into the one in `to`. */
+function diffValues(from: unknown, to: unknown, path: string, ops: JsonPatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isPlainObject(from) && isPlainObject(to)) {
+    diffObjects(from, to, path, ops);
+  } else {
+    ops.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Computes a JSON Patch that turns `from` into `to`, as specified in RFC 6902.
+ *
+ * @param from - The document the patch starts from.
+ * @param to - The document the patch produces.
+ * @returns An ordered sequence of operations that, applied to `from` with {@link applyPatch},
+ *   yields a document deep-equal to `to`. Parts of the documents that are already equal are not
+ *   mentioned; neither `from` nor `to` is modified.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const ops: JsonPatchOperation[] = [];
+  diffValues(from, to, "", ops);
+  return ops;
+}
