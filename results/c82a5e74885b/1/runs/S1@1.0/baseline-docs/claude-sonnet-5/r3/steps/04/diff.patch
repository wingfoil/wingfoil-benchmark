+++ b/src/json-merge-patch.test.ts
@@ -0,0 +1,80 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "./json-merge-patch.ts";
+
+// The examples from RFC 7386 Appendix A.
+
+const rfcVectors: [unknown, unknown, unknown][] = [
+  [{ a: "b" }, { a: "c" }, { a: "c" }],
+  [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  [{ a: "b" }, { a: null }, {}],
+  [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+  [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+  [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  [["a", "b"], ["c", "d"], ["c", "d"]],
+  [{ a: "b" }, ["c"], ["c"]],
+  [{ a: "foo" }, null, null],
+  [{ a: "foo" }, "bar", "bar"],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: "b", c: null }, { a: "b" }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+
+for (const [target, patch, expected] of rfcVectors) {
+  test(`merges ${JSON.stringify(target)} with ${JSON.stringify(patch)}`, () => {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  });
+}
+
+test("merges nested objects recursively without touching sibling members", () => {
+  const target = { title: "Goodbye!", author: { name: "John" }, tags: ["a", "b"] };
+  const patch = { author: { name: "Jane" } };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Goodbye!",
+    author: { name: "Jane" },
+    tags: ["a", "b"],
+  });
+});
+
+test("adds a new nested member when the target lacks it", () => {
+  assert.deepEqual(applyMergePatch({}, { a: { b: 1 } }), { a: { b: 1 } });
+});
+
+test("removing a member that does not exist is a no-op", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { c: null }), { a: "b" });
+});
+
+test("does not mutate the target or the patch", () => {
+  const target = { a: { b: "c" } };
+  const patch = { a: { b: "d", c: null }, e: null };
+  const targetSnapshot = structuredClone(target);
+  const patchSnapshot = structuredClone(patch);
+  applyMergePatch(target, patch);
+  assert.deepEqual(target, targetSnapshot);
+  assert.deepEqual(patch, patchSnapshot);
+});
+
+// "__proto__" is just another member name in a JSON document: merging it must not reach through
+// to the object's prototype. A JS object literal with a `__proto__` key sets the object's
+// prototype instead of creating that property, so these patches are built with `JSON.parse`,
+// which (unlike object literal syntax) always creates a plain own property, as it would when a
+// patch arrives over the wire.
+
+test('merging a "__proto__" member creates an own property instead of changing the prototype', () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true}}');
+  const result = applyMergePatch({}, patch) as Record<string, unknown>;
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(JSON.stringify(result), JSON.stringify({ ["__proto__"]: { polluted: true } }));
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test('a "__proto__" member already on the target is read as a plain value, not the prototype', () => {
+  const target = JSON.parse('{"__proto__":{"a":1}}');
+  const patch = JSON.parse('{"__proto__":{"b":2}}');
+  const result = applyMergePatch(target, patch) as Record<string, unknown>;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(JSON.stringify(result), JSON.stringify({ ["__proto__"]: { a: 1, b: 2 } }));
+});
