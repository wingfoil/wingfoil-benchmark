+++ b/src/json-merge-patch.ts
@@ -0,0 +1,59 @@
+/**
+ * JSON Merge Patch, as specified in RFC 7386 (https://www.rfc-editor.org/rfc/rfc7386).
+ *
+ * A JSON Merge Patch describes changes to a JSON document using a document that mirrors the
+ * shape of the target: object members are merged recursively, a `null` member value removes the
+ * corresponding target member, and any other value (including an array) replaces it wholesale.
+ */
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Reads an object member by name, as a plain own property.
+ *
+ * A member named "__proto__" read through a normal access (`object[member]`) is intercepted by
+ * `Object.prototype`'s accessor of that name when `object` has no own property of that name,
+ * returning the object's prototype instead of `undefined`. Checking `hasOwnProperty` first avoids
+ * that.
+ */
+function getMember(object: Record<string, unknown>, member: string): unknown {
+  return Object.prototype.hasOwnProperty.call(object, member) ? object[member] : undefined;
+}
+
+/**
+ * Sets an object member by name, as a plain own property.
+ *
+ * A member named "__proto__" set through a normal assignment (`object[member] = value`) is
+ * intercepted by `Object.prototype`'s accessor of that name and changes `object`'s prototype
+ * instead of creating a member. `Object.defineProperty` bypasses that accessor and always creates
+ * a regular own property.
+ */
+function setMember(object: Record<string, unknown>, member: string, value: unknown): void {
+  Object.defineProperty(object, member, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/**
+ * Applies a JSON Merge Patch to a target JSON document, as specified in RFC 7386 section 2.
+ *
+ * @param target - The JSON document to patch.
+ * @param patch - The merge patch to apply.
+ * @returns The merged document; neither `target` nor `patch` is modified. If `patch` is not a
+ *   JSON object, it replaces `target` entirely.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isPlainObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result: Record<string, unknown> = isPlainObject(target) ? { ...target } : {};
+  for (const member of Object.keys(patch)) {
+    const value = patch[member];
+    if (value === null) {
+      delete result[member];
+    } else {
+      setMember(result, member, applyMergePatch(getMember(result, member), value));
+    }
+  }
+  return result;
+}
