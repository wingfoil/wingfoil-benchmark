index 0000000000000000000000000000000000000000..9859fdb75a70a46057bb5310009d575f8e6b9a64
--- /dev/null
+++ b/src/json-patch.ts
@@ -0,0 +1,231 @@
+/**
+ * JSON Patch, as specified in RFC 6902 (https://www.rfc-editor.org/rfc/rfc6902).
+ *
+ * A JSON Patch is an ordered sequence of operations that transform one JSON document into
+ * another.
+ */
+
+import { ARRAY_INDEX_PATTERN, parsePointer, resolvePointer, step } from "./json-pointer.ts";
+
+/** Adds or replaces a member of an object, or inserts an element into an array, at `path`. */
+export type AddOperation = { op: "add"; path: string; value: unknown };
+
+/** Removes the member or array element at `path`, which must exist. */
+export type RemoveOperation = { op: "remove"; path: string };
+
+/** Replaces the value of the existing member or array element at `path`. */
+export type ReplaceOperation = { op: "replace"; path: string; value: unknown };
+
+/** Moves the value at `from` to `path`. */
+export type MoveOperation = { op: "move"; path: string; from: string };
+
+/** Copies the value at `from` to `path`. */
+export type CopyOperation = { op: "copy"; path: string; from: string };
+
+/** Fails the patch unless the value at `path` deep-equals `value`. */
+export type TestOperation = { op: "test"; path: string; value: unknown };
+
+/** A single JSON Patch operation, as specified in RFC 6902 section 4. */
+export type JsonPatchOperation =
+  | AddOperation
+  | RemoveOperation
+  | ReplaceOperation
+  | MoveOperation
+  | CopyOperation
+  | TestOperation;
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function requireString(value: unknown, member: string, index: number): string {
+  if (typeof value !== "string") {
+    throw new Error(`Invalid JSON Patch: operation ${index} is missing its "${member}" string member`);
+  }
+  return value;
+}
+
+function requireValue(raw: Record<string, unknown>, index: number): unknown {
+  if (!("value" in raw)) {
+    throw new Error(`Invalid JSON Patch: operation ${index} is missing its "value" member`);
+  }
+  return raw.value;
+}
+
+/**
+ * Validates and normalizes one raw patch entry into a {@link JsonPatchOperation}.
+ *
+ * @throws {Error} If the entry is not a well-formed operation.
+ */
+function parseOperation(raw: unknown, index: number): JsonPatchOperation {
+  if (!isPlainObject(raw)) {
+    throw new Error(`Invalid JSON Patch: operation ${index} must be an object`);
+  }
+  const path = requireString(raw.path, "path", index);
+  switch (raw.op) {
+    case "add":
+      return { op: "add", path, value: requireValue(raw, index) };
+    case "remove":
+      return { op: "remove", path };
+    case "replace":
+      return { op: "replace", path, value: requireValue(raw, index) };
+    case "move":
+      return { op: "move", path, from: requireString(raw.from, "from", index) };
+    case "copy":
+      return { op: "copy", path, from: requireString(raw.from, "from", index) };
+    case "test":
+      return { op: "test", path, value: requireValue(raw, index) };
+    default:
+      throw new Error(`Invalid JSON Patch: operation ${index} has unknown "op" value ${JSON.stringify(raw.op)}`);
+  }
+}
+
+type Navigation = { root: true } | { root: false; parent: unknown; lastToken: string };
+
+/** Walks all but the last reference token of `path`, per RFC 6901 section 4. */
+function navigate(document: unknown, path: string): Navigation {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    return { root: true };
+  }
+  const lastToken = tokens[tokens.length - 1];
+  const parent = tokens.slice(0, -1).reduce((current, token) => step(current, token, path), document);
+  return { root: false, parent, lastToken };
+}
+
+/** Resolves the array index `token` refers to when adding into `array`, per RFC 6902 section 4.1. */
+function insertIndex(array: unknown[], token: string, path: string): number {
+  if (token === "-") {
+    return array.length;
+  }
+  if (!ARRAY_INDEX_PATTERN.test(token) || Number(token) > array.length) {
+    throw new Error(`"${path}" does not resolve: "${token}" is not a valid array index to add at`);
+  }
+  return Number(token);
+}
+
+function add(document: unknown, path: string, value: unknown): unknown {
+  const nav = navigate(document, path);
+  if (nav.root) {
+    return value;
+  }
+  const { parent, lastToken } = nav;
+  if (Array.isArray(parent)) {
+    parent.splice(insertIndex(parent, lastToken, path), 0, value);
+  } else if (isPlainObject(parent)) {
+    parent[lastToken] = value;
+  } else {
+    throw new Error(`"${path}" does not resolve: cannot add into a non-object, non-array value`);
+  }
+  return document;
+}
+
+function remove(document: unknown, path: string): unknown {
+  const nav = navigate(document, path);
+  if (nav.root) {
+    throw new Error(`Invalid "remove" operation: path "" has no parent to remove from`);
+  }
+  const { parent, lastToken } = nav;
+  step(parent, lastToken, path); // validates that the target member or element exists
+  if (Array.isArray(parent)) {
+    parent.splice(Number(lastToken), 1);
+  } else {
+    delete (parent as Record<string, unknown>)[lastToken];
+  }
+  return document;
+}
+
+function replace(document: unknown, path: string, value: unknown): unknown {
+  const nav = navigate(document, path);
+  if (nav.root) {
+    return value;
+  }
+  const { parent, lastToken } = nav;
+  step(parent, lastToken, path); // validates that the target member or element exists
+  if (Array.isArray(parent)) {
+    parent[Number(lastToken)] = value;
+  } else {
+    (parent as Record<string, unknown>)[lastToken] = value;
+  }
+  return document;
+}
+
+/** True if `path` refers to a location strictly inside `ancestorPath`. */
+function isProperDescendant(ancestorPath: string, path: string): boolean {
+  const ancestorTokens = parsePointer(ancestorPath);
+  const tokens = parsePointer(path);
+  return tokens.length > ancestorTokens.length && ancestorTokens.every((token, i) => token === tokens[i]);
+}
+
+function move(document: unknown, path: string, from: string): unknown {
+  if (isProperDescendant(from, path)) {
+    throw new Error(`Invalid "move" operation: cannot move "${from}" into its own child "${path}"`);
+  }
+  const value = resolvePointer(document, from);
+  const cloned = structuredClone(value);
+  return add(remove(document, from), path, cloned);
+}
+
+function copy(document: unknown, path: string, from: string): unknown {
+  const cloned = structuredClone(resolvePointer(document, from));
+  return add(document, path, cloned);
+}
+
+/** Deep-equals two JSON values, per the comparison rules in RFC 6902 section 4.6. */
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (Array.isArray(a) && Array.isArray(b)) {
+    return a.length === b.length && a.every((item, i) => deepEqual(item, b[i]));
+  }
+  if (isPlainObject(a) && isPlainObject(b)) {
+    const aKeys = Object.keys(a);
+    return (
+      aKeys.length === Object.keys(b).length &&
+      aKeys.every((key) => Object.prototype.hasOwnProperty.call(b, key) && deepEqual(a[key], b[key]))
+    );
+  }
+  return false;
+}
+
+function test(document: unknown, path: string, value: unknown): unknown {
+  if (!deepEqual(resolvePointer(document, path), value)) {
+    throw new Error(`"test" operation failed: the value at "${path}" does not equal the expected value`);
+  }
+  return document;
+}
+
+function applyOperation(document: unknown, operation: JsonPatchOperation): unknown {
+  switch (operation.op) {
+    case "add":
+      return add(document, operation.path, operation.value);
+    case "remove":
+      return remove(document, operation.path);
+    case "replace":
+      return replace(document, operation.path, operation.value);
+    case "move":
+      return move(document, operation.path, operation.from);
+    case "copy":
+      return copy(document, operation.path, operation.from);
+    case "test":
+      return test(document, operation.path, operation.value);
+  }
+}
+
+/**
+ * Applies a JSON Patch to a JSON document, as specified in RFC 6902.
+ *
+ * @param document - The JSON document to patch.
+ * @param patch - The ordered sequence of operations to apply.
+ * @returns A new document with every operation applied, in order; `document` is left unmodified.
+ * @throws {Error} If `patch` is not a well-formed JSON Patch, or if one of its operations fails
+ *   (e.g. a "test" mismatch, or a path that does not resolve).
+ */
+export function applyPatch(document: unknown, patch: readonly JsonPatchOperation[]): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: expected an array of operations");
+  }
+  const operations = patch.map((raw, index) => parseOperation(raw, index));
+  return operations.reduce((current, operation) => applyOperation(current, operation), structuredClone(document));
+}
