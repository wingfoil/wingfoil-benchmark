diff --git a/src/json-patch.test.ts b/src/json-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..14716f3d039b18b2795358afc1bfde23d6072254
--- /dev/null
+++ b/src/json-patch.test.ts
@@ -0,0 +1,206 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, type JsonPatchOperation } from "./json-patch.ts";
+
+// The examples from RFC 6902 Appendix A.
+
+test("A.1 adding an object member", () => {
+  const result = applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]);
+  assert.deepEqual(result, { foo: "bar", baz: "qux" });
+});
+
+test("A.2 adding an array element", () => {
+  const result = applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]);
+  assert.deepEqual(result, { foo: ["bar", "qux", "baz"] });
+});
+
+test("A.3 removing an object member", () => {
+  const result = applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]);
+  assert.deepEqual(result, { foo: "bar" });
+});
+
+test("A.4 removing an array element", () => {
+  const result = applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]);
+  assert.deepEqual(result, { foo: ["bar", "baz"] });
+});
+
+test("A.5 replacing a value", () => {
+  const result = applyPatch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]);
+  assert.deepEqual(result, { baz: "boo", foo: "bar" });
+});
+
+test("A.6 moving a value", () => {
+  const document = { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } };
+  const result = applyPatch(document, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]);
+  assert.deepEqual(result, { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+});
+
+test("A.7 moving an array element", () => {
+  const result = applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]);
+  assert.deepEqual(result, { foo: ["all", "cows", "eat", "grass"] });
+});
+
+test("A.8 testing a value: success", () => {
+  const document = { baz: "qux", foo: ["a", 2, "c"] };
+  const result = applyPatch(document, [
+    { op: "test", path: "/baz", value: "qux" },
+    { op: "test", path: "/foo/1", value: 2 },
+  ]);
+  assert.deepEqual(result, document);
+});
+
+test("A.9 testing a value: error", () => {
+  assert.throws(
+    () => applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]),
+    /"test" operation failed/,
+  );
+});
+
+test("A.10 adding a nested member object", () => {
+  const result = applyPatch({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]);
+  assert.deepEqual(result, { foo: "bar", child: { grandchild: {} } });
+});
+
+test("A.11 ignoring unrecognized elements", () => {
+  const result = applyPatch({ foo: "bar" }, [
+    { op: "add", path: "/baz", value: "qux", xyz: 123 } as unknown as JsonPatchOperation,
+  ]);
+  assert.deepEqual(result, { foo: "bar", baz: "qux" });
+});
+
+test("A.12 adding to a nonexistent target", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]), Error);
+});
+
+test('A.14 "~" escape ordering', () => {
+  const document = { "/": 9, "~1": 10 };
+  const result = applyPatch(document, [{ op: "test", path: "/~01", value: 10 }]);
+  assert.deepEqual(result, document);
+});
+
+test("A.15 comparing strings and numbers", () => {
+  assert.throws(
+    () => applyPatch({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]),
+    /"test" operation failed/,
+  );
+});
+
+test("A.16 adding an array value", () => {
+  const result = applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]);
+  assert.deepEqual(result, { foo: ["bar", ["abc", "def"]] });
+});
+
+// Additional behaviour not covered by the RFC's own examples.
+
+test("add replaces the whole document at the root path", () => {
+  const result = applyPatch({ foo: "bar" }, [{ op: "add", path: "", value: { replaced: true } }]);
+  assert.deepEqual(result, { replaced: true });
+});
+
+test("replace replaces the whole document at the root path", () => {
+  const result = applyPatch({ foo: "bar" }, [{ op: "replace", path: "", value: { replaced: true } }]);
+  assert.deepEqual(result, { replaced: true });
+});
+
+test("replace throws when the target does not exist", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "replace", path: "/baz", value: 1 }]), /no member named/);
+});
+
+test("remove throws when the target does not exist", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "remove", path: "/baz" }]), /no member named/);
+});
+
+test("remove throws when applied to the root", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "remove", path: "" }]), /no parent to remove from/);
+});
+
+test("copy duplicates a value independently of the source", () => {
+  const document = { source: { nested: [1, 2, 3] } };
+  const result = applyPatch(document, [{ op: "copy", from: "/source", path: "/copy" }]) as {
+    source: { nested: number[] };
+    copy: { nested: number[] };
+  };
+  assert.deepEqual(result.copy, result.source);
+  result.copy.nested.push(4);
+  assert.deepEqual(result.source.nested, [1, 2, 3]);
+});
+
+test("move throws when moving a location into one of its own children", () => {
+  assert.throws(
+    () => applyPatch({ foo: { bar: 1 } }, [{ op: "move", path: "/foo/bar", from: "/foo" }]),
+    /cannot move/,
+  );
+});
+
+test("move throws when the source does not exist", () => {
+  assert.throws(() => applyPatch({ foo: 1 }, [{ op: "move", from: "/bar", path: "/baz" }]), /no member named/);
+});
+
+test("does not mutate the input document", () => {
+  const document = { foo: { bar: [1, 2, 3] } };
+  const snapshot = structuredClone(document);
+  applyPatch(document, [
+    { op: "add", path: "/foo/baz", value: "qux" },
+    { op: "remove", path: "/foo/bar/0" },
+  ]);
+  assert.deepEqual(document, snapshot);
+});
+
+test("leaves the input document untouched when an operation fails", () => {
+  const document = { foo: "bar" };
+  const snapshot = structuredClone(document);
+  assert.throws(() => applyPatch(document, [{ op: "replace", path: "/foo", value: "changed" }, { op: "test", path: "/foo", value: "wrong" }]));
+  assert.deepEqual(document, snapshot);
+});
+
+test("applies several operations in order", () => {
+  const result = applyPatch({ items: [1, 2, 3] }, [
+    { op: "add", path: "/items/-", value: 4 },
+    { op: "remove", path: "/items/0" },
+    { op: "replace", path: "/items/0", value: 20 },
+  ]);
+  assert.deepEqual(result, { items: [20, 3, 4] });
+});
+
+// Validation of the patch document itself.
+
+test("throws when the patch is not an array", () => {
+  assert.throws(() => applyPatch({}, "not an array" as unknown as JsonPatchOperation[]), /expected an array/);
+});
+
+test("throws when an operation is not an object", () => {
+  assert.throws(() => applyPatch({}, ["nope" as unknown as JsonPatchOperation]), /must be an object/);
+});
+
+test("throws when an operation is missing its path", () => {
+  assert.throws(
+    () => applyPatch({}, [{ op: "add", value: 1 } as unknown as JsonPatchOperation]),
+    /missing its "path"/,
+  );
+});
+
+test("throws when add is missing its value", () => {
+  assert.throws(
+    () => applyPatch({}, [{ op: "add", path: "/foo" } as unknown as JsonPatchOperation]),
+    /missing its "value"/,
+  );
+});
+
+test("throws when move is missing its from member", () => {
+  assert.throws(
+    () => applyPatch({}, [{ op: "move", path: "/foo" } as unknown as JsonPatchOperation]),
+    /missing its "from"/,
+  );
+});
+
+test("throws when op has an unknown value", () => {
+  assert.throws(
+    () => applyPatch({}, [{ op: "frobnicate", path: "/foo" } as unknown as JsonPatchOperation]),
+    /unknown "op" value/,
+  );
+});
+
+test("a value of null is a valid add value, not a missing one", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/foo", value: null }]);
+  assert.deepEqual(result, { foo: null });
+});
