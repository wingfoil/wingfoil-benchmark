index 0000000000000000000000000000000000000000..e5720b8c24739befa203d44b6a6f2a19ee56b679
--- /dev/null
+++ b/src/json-pointer.test.ts
@@ -0,0 +1,84 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "./json-pointer.ts";
+
+// The example document and pointers from RFC 6901 section 5.
+const rfcExample = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+const rfcVectors: [string, unknown][] = [
+  ["", rfcExample],
+  ["/foo", ["bar", "baz"]],
+  ["/foo/0", "bar"],
+  ["/", 0],
+  ["/a~1b", 1],
+  ["/c%d", 2],
+  ["/e^f", 3],
+  ["/g|h", 4],
+  ["/i\\j", 5],
+  ['/k"l', 6],
+  ["/ ", 7],
+  ["/m~0n", 8],
+];
+
+for (const [pointer, expected] of rfcVectors) {
+  test(`resolves the RFC 6901 example pointer ${JSON.stringify(pointer)}`, () => {
+    assert.deepEqual(resolvePointer(rfcExample, pointer), expected);
+  });
+}
+
+test("resolves a nested member inside an array", () => {
+  const document = { items: [{ name: "a" }, { name: "b" }] };
+  assert.equal(resolvePointer(document, "/items/1/name"), "b");
+});
+
+test("unescapes ~1 before ~0 so a trailing literal digit survives", () => {
+  // "~01" decodes to "~" (from ~0) followed by the literal character "1".
+  assert.equal(resolvePointer({ "~1": "literal", "/": "slash" }, "/~01"), "literal");
+});
+
+test("throws when the pointer is not a string", () => {
+  assert.throws(() => resolvePointer({}, null as unknown as string), TypeError);
+});
+
+test("throws when a non-empty pointer does not start with /", () => {
+  assert.throws(() => resolvePointer({ foo: 1 }, "foo"), /must be empty or start with/);
+});
+
+test("throws when a token contains an unescaped ~", () => {
+  assert.throws(() => resolvePointer({ "~x": 1 }, "/~x"), /not followed by "0" or "1"/);
+});
+
+test("throws when a member does not exist", () => {
+  assert.throws(() => resolvePointer({ foo: 1 }, "/bar"), /no member named "bar"/);
+});
+
+test("throws when an array index is out of bounds", () => {
+  assert.throws(() => resolvePointer([1, 2], "/2"), /out of bounds/);
+});
+
+test("throws when an array index has a leading zero", () => {
+  assert.throws(() => resolvePointer([1, 2], "/01"), /not a non-negative integer/);
+});
+
+test('throws when an array index is "-"', () => {
+  assert.throws(() => resolvePointer([1, 2], "/-"), /nonexistent array element/);
+});
+
+test("throws when indexing into a primitive value", () => {
+  assert.throws(() => resolvePointer({ foo: 1 }, "/foo/bar"), /cannot index into/);
+});
+
+test("throws when indexing into null", () => {
+  assert.throws(() => resolvePointer({ foo: null }, "/foo/bar"), /cannot index into/);
+});
