new file mode 100644
index 0000000000000000000000000000000000000000..7d219b5c9c97b5f3257c3aa417c154f79689fc9d
--- /dev/null
+++ b/src/json-pointer.ts
@@ -0,0 +1,85 @@
+/**
+ * JSON Pointer, as specified in RFC 6901 (https://www.rfc-editor.org/rfc/rfc6901).
+ *
+ * A JSON Pointer is a string syntax for identifying a specific value within a JSON document.
+ */
+
+const ARRAY_INDEX_PATTERN = /^(?:0|[1-9][0-9]*)$/;
+
+/**
+ * Splits a JSON Pointer string into its reference tokens, unescaping each one.
+ *
+ * @throws {Error} If the pointer does not follow RFC 6901 syntax: it must be empty, or start
+ *   with "/", and every "~" in it must be followed by "0" or "1".
+ */
+function parsePointer(pointer: string): string[] {
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`);
+  }
+  return pointer
+    .split("/")
+    .slice(1)
+    .map((token) => unescapeToken(token, pointer));
+}
+
+function unescapeToken(token: string, pointer: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" contains a "~" not followed by "0" or "1"`);
+  }
+  return token.replace(/~[01]/g, (match) => (match === "~0" ? "~" : "/"));
+}
+
+/**
+ * Looks up a single reference token in the current value, per RFC 6901 section 4.
+ *
+ * @throws {Error} If `current` is not a value the token can index into, or if the token does
+ *   not refer to an existing member or element.
+ */
+function step(current: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(current)) {
+    if (token === "-") {
+      throw new Error(`"${pointer}" does not resolve: "-" refers to a nonexistent array element`);
+    }
+    if (!ARRAY_INDEX_PATTERN.test(token)) {
+      throw new Error(
+        `Invalid JSON Pointer: "${pointer}" uses "${token}" as an array index, which is not a non-negative integer with no leading zeros`,
+      );
+    }
+    const index = Number(token);
+    if (index >= current.length) {
+      throw new Error(`"${pointer}" does not resolve: index ${index} is out of bounds`);
+    }
+    return current[index];
+  }
+
+  if (typeof current === "object" && current !== null) {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new Error(`"${pointer}" does not resolve: no member named "${token}"`);
+    }
+    return (current as Record<string, unknown>)[token];
+  }
+
+  throw new Error(`"${pointer}" does not resolve: cannot index into a non-object, non-array value`);
+}
+
+/**
+ * Resolves a JSON Pointer against a JSON document, as specified in RFC 6901.
+ *
+ * @param document - The JSON document to resolve the pointer against.
+ * @param pointer - A JSON Pointer string, e.g. `"/foo/0/bar"`. The empty string `""` refers to
+ *   the whole document.
+ * @returns The value the pointer refers to.
+ * @throws {Error} If `pointer` is not a valid JSON Pointer string, or if it does not resolve to
+ *   a value within `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new TypeError("Invalid JSON Pointer: expected a string");
+  }
+
+  const tokens = parsePointer(pointer);
+  return tokens.reduce((current, token) => step(current, token, pointer), document);
+}
