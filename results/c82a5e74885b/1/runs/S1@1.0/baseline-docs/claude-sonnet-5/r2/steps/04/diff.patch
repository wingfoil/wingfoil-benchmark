+/**
+ * A JSON value that is an object (as opposed to an array, which RFC 7386
+ * treats as an opaque scalar to be replaced wholesale, never merged).
+ */
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+/**
+ * Reads an own member by name, without falling through to inherited
+ * accessors such as `Object.prototype`'s `__proto__` getter for a container
+ * that has no own member of that name yet.
+ */
+function ownMember(container: Record<string, unknown>, key: string): unknown {
+  return Object.prototype.hasOwnProperty.call(container, key) ? container[key] : undefined;
+}
+
+/**
+ * Merges `patch`'s members into `base` in place, per RFC 7386: a `null`
+ * member value removes the corresponding member of `base`, an object member
+ * value is merged recursively, and any other value replaces it wholesale.
+ */
+function mergeInto(base: Record<string, unknown>, patch: Record<string, unknown>): void {
+  for (const key of Object.keys(patch)) {
+    const patchValue = ownMember(patch, key);
+    if (patchValue === null) {
+      delete base[key];
+      continue;
+    }
+    if (isJsonObject(patchValue)) {
+      const existing = ownMember(base, key);
+      const nested = isJsonObject(existing) ? existing : {};
+      mergeInto(nested, patchValue);
+      setMember(base, key, nested);
+    } else {
+      setMember(base, key, structuredClone(patchValue));
+    }
+  }
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the
+ * resulting document as a new value. It never mutates `target`, `patch`, or
+ * any value reachable from either.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result: Record<string, unknown> = isJsonObject(target) ? structuredClone(target) : {};
+  mergeInto(result, patch);
+  return result;
+}
