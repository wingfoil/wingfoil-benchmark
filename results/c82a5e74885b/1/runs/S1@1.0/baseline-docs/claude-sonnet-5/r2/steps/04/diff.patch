diff --git a/test/apply-merge-patch.test.ts b/test/apply-merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d3725fd9ae3ef21d2887f2c8b44fcf4fe9a95307
--- /dev/null
+++ b/test/apply-merge-patch.test.ts
@@ -0,0 +1,121 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyMergePatch } from '../src/index.ts';
+
+// The example test cases from RFC 7386 appendix A.
+
+test('A.1: replaces a member value', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { a: 'c' }), { a: 'c' });
+});
+
+test('A.2: adds a member', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { b: 'c' }), { a: 'b', b: 'c' });
+});
+
+test('A.3: a null value removes a member', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { a: null }), {});
+});
+
+test('A.4: a null value removes only the targeted member', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b', b: 'c' }, { a: null }), { b: 'c' });
+});
+
+test('A.5: a scalar patch value replaces an array wholesale', () => {
+  assert.deepEqual(applyMergePatch({ a: ['b'] }, { a: 'c' }), { a: 'c' });
+});
+
+test('A.6: an array patch value replaces a scalar wholesale', () => {
+  assert.deepEqual(applyMergePatch({ a: 'c' }, { a: ['b'] }), { a: ['b'] });
+});
+
+test('A.7: merges nested objects recursively', () => {
+  assert.deepEqual(applyMergePatch({ a: { b: 'c' } }, { a: { b: 'd', c: null } }), { a: { b: 'd' } });
+});
+
+test('A.8: an array patch value replaces an array of objects wholesale', () => {
+  assert.deepEqual(applyMergePatch({ a: [{ b: 'c' }] }, { a: [1] }), { a: [1] });
+});
+
+test('A.9: an array patch replaces an array target wholesale', () => {
+  assert.deepEqual(applyMergePatch(['a', 'b'], ['c', 'd']), ['c', 'd']);
+});
+
+test('A.10: an array patch replaces an object target wholesale', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, ['c']), ['c']);
+});
+
+test('A.11: a null patch replaces the whole document with null', () => {
+  assert.equal(applyMergePatch({ a: 'foo' }, null), null);
+});
+
+test('A.12: a scalar patch replaces the whole document', () => {
+  assert.equal(applyMergePatch({ a: 'foo' }, 'bar'), 'bar');
+});
+
+test('A.13: a null member value in the target is left alone when untouched', () => {
+  assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+});
+
+test('A.14: merging into a non-object target discards it and starts from an empty object', () => {
+  assert.deepEqual(applyMergePatch([1, 2], { a: 'b', c: null }), { a: 'b' });
+});
+
+test('A.15: removing a member of a newly created nested object leaves it empty', () => {
+  assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+});
+
+// Additional coverage beyond the RFC appendix.
+
+test('does not mutate the target document', () => {
+  const target = { a: { b: 'c' }, list: [1, 2, 3] };
+  const snapshot = structuredClone(target);
+  applyMergePatch(target, { a: { b: 'd' }, list: null });
+  assert.deepEqual(target, snapshot);
+});
+
+test('does not mutate the patch document', () => {
+  const patch = { a: { b: 'c' } };
+  const snapshot = structuredClone(patch);
+  applyMergePatch({}, patch);
+  assert.deepEqual(patch, snapshot);
+});
+
+test('does not let the returned document alias the target', () => {
+  const target = { a: { b: 'c' } };
+  const result = applyMergePatch(target, {}) as { a: { b: string } };
+  assert.deepEqual(result, target);
+  assert.notEqual(result.a, target.a);
+});
+
+test('does not let the returned document alias the patch', () => {
+  const patch = { a: { b: 'c' } };
+  const result = applyMergePatch({}, patch) as { a: { b: string } };
+  patch.a.b = 'mutated';
+  assert.equal(result.a.b, 'c');
+});
+
+test('leaves an untouched nested member of the target unaliased', () => {
+  const target = { a: { b: 'c' }, keep: { d: 'e' } };
+  const result = applyMergePatch(target, { a: { b: 'f' } }) as { keep: { d: string } };
+  assert.deepEqual(result.keep, { d: 'e' });
+  assert.notEqual(result.keep, target.keep);
+});
+
+test('sets a member literally named "__proto__" without altering the object prototype', () => {
+  // Built via JSON.parse, like a patch received over the wire, since the
+  // "__proto__: value" object-literal syntax sets a prototype instead of
+  // creating an own property of that name.
+  const patch = JSON.parse('{"__proto__":{"polluted":true}}');
+  const result = applyMergePatch({}, patch) as Record<string, unknown>;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ['__proto__']);
+  assert.deepEqual(result.__proto__, { polluted: true });
+  assert.equal(Object.prototype.hasOwnProperty.call({}, 'polluted'), false);
+});
+
+test('merges into an existing member literally named "__proto__" without altering the object prototype', () => {
+  const target = applyMergePatch({}, JSON.parse('{"__proto__":{"a":1}}')) as Record<string, unknown>;
+  const result = applyMergePatch(target, JSON.parse('{"__proto__":{"b":2}}')) as Record<string, unknown>;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(result.__proto__, { a: 1, b: 2 });
+});
