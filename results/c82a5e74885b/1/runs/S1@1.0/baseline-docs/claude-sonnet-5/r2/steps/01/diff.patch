diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9ba8abf93046072ea3d1fcdb57c7f91cf7d94f9b
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,56 @@
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/**
+ * Decodes a single reference token per RFC 6901 section 3: "~1" is unescaped
+ * to "/" before "~0" is unescaped to "~", since reversing that order would
+ * corrupt sequences like "~01".
+ */
+function unescapeToken(token: string): string {
+  return token.replace(/~1/g, '/').replace(/~0/g, '~');
+}
+
+function step(current: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token)) {
+      throw new Error(`Invalid JSON Pointer "${pointer}": "${token}" is not a valid array index`);
+    }
+    const index = Number(token);
+    if (index >= current.length) {
+      throw new Error(`Invalid JSON Pointer "${pointer}": index ${index} is out of bounds`);
+    }
+    return current[index];
+  }
+
+  if (current !== null && typeof current === 'object') {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new Error(`Invalid JSON Pointer "${pointer}": no member named "${token}"`);
+    }
+    return (current as Record<string, unknown>)[token];
+  }
+
+  throw new Error(`Invalid JSON Pointer "${pointer}": cannot step into a ${typeof current}`);
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document, returning the
+ * value it refers to.
+ *
+ * Throws when `pointer` is not a syntactically valid JSON Pointer, or when it
+ * does not resolve to a value within `document` (e.g. a missing member, an
+ * out-of-bounds array index, or the "-" array index, which never resolves to
+ * an element).
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== 'string') {
+    throw new TypeError('JSON Pointer must be a string');
+  }
+  if (pointer === '') {
+    return document;
+  }
+  if (!pointer.startsWith('/')) {
+    throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+
+  const tokens = pointer.split('/').slice(1).map(unescapeToken);
+  return tokens.reduce((current, token) => step(current, token, pointer), document);
+}
diff --git a/test/index.test.ts b/test/index.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..01ae8f4910538c1c65c9398afdb328e057e31c6c
--- /dev/null
+++ b/test/index.test.ts
@@ -0,0 +1,83 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { resolvePointer } from '../src/index.ts';
+
+// The example document and pointer/value pairs from RFC 6901 section 5.
+const rfcDocument = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+test('resolves the whole document for the empty pointer', () => {
+  assert.deepEqual(resolvePointer(rfcDocument, ''), rfcDocument);
+});
+
+test('resolves each RFC 6901 example pointer to its documented value', () => {
+  assert.deepEqual(resolvePointer(rfcDocument, '/foo'), ['bar', 'baz']);
+  assert.equal(resolvePointer(rfcDocument, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(rfcDocument, '/foo/1'), 'baz');
+  assert.equal(resolvePointer(rfcDocument, '/'), 0);
+  assert.equal(resolvePointer(rfcDocument, '/a~1b'), 1);
+  assert.equal(resolvePointer(rfcDocument, '/c%d'), 2);
+  assert.equal(resolvePointer(rfcDocument, '/e^f'), 3);
+  assert.equal(resolvePointer(rfcDocument, '/g|h'), 4);
+  assert.equal(resolvePointer(rfcDocument, '/i\\j'), 5);
+  assert.equal(resolvePointer(rfcDocument, '/k"l'), 6);
+  assert.equal(resolvePointer(rfcDocument, '/ '), 7);
+  assert.equal(resolvePointer(rfcDocument, '/m~0n'), 8);
+});
+
+test('resolves nested objects and arrays', () => {
+  const document = { a: { b: [{ c: 'deep' }] } };
+  assert.equal(resolvePointer(document, '/a/b/0/c'), 'deep');
+});
+
+test('decodes ~1 before ~0 so "~01" means a literal "~1" token', () => {
+  const document = { '~1': 'literal-tilde-one' };
+  assert.equal(resolvePointer(document, '/~01'), 'literal-tilde-one');
+});
+
+test('rejects a non-string pointer', () => {
+  // @ts-expect-error exercising runtime validation of external input
+  assert.throws(() => resolvePointer({}, 42));
+});
+
+test('rejects a pointer that does not start with "/" and is not empty', () => {
+  assert.throws(() => resolvePointer({ foo: 1 }, 'foo'));
+});
+
+test('rejects a reference token that is not a property of an object', () => {
+  assert.throws(() => resolvePointer({ foo: 1 }, '/bar'));
+});
+
+test('rejects an array index that is out of bounds', () => {
+  assert.throws(() => resolvePointer({ foo: ['bar'] }, '/foo/1'));
+});
+
+test('rejects the "-" array index since it does not resolve to an element', () => {
+  assert.throws(() => resolvePointer({ foo: ['bar'] }, '/foo/-'));
+});
+
+test('rejects an array index with a leading zero', () => {
+  assert.throws(() => resolvePointer({ foo: ['bar', 'baz'] }, '/foo/01'));
+});
+
+test('rejects a non-numeric array index', () => {
+  assert.throws(() => resolvePointer({ foo: ['bar'] }, '/foo/x'));
+});
+
+test('rejects stepping into a scalar value', () => {
+  assert.throws(() => resolvePointer({ foo: 'bar' }, '/foo/0'));
+});
+
+test('rejects stepping into null', () => {
+  assert.throws(() => resolvePointer({ foo: null }, '/foo/bar'));
+});
