+/**
+ * Sets an object member by name, including names such as "__proto__" that
+ * plain assignment would misinterpret as rewiring the object's prototype
+ * instead of creating a member with that literal name.
+ */
+function setMember(container: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(container, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
 function arrayIndexForAdd(container: unknown[], key: string, pointer: string): number {
   if (key === '-') {
     return container.length;
@@ -111,7 +120,7 @@ function applyAdd(holder: DocumentHolder, pointer: string, value: unknown): void
     container.splice(arrayIndexForAdd(container, key, pointer), 0, value);
     return;
   }
-  container[key] = value;
+  setMember(container, key, value);
 }
 
 function applyRemove(holder: DocumentHolder, pointer: string): unknown {
@@ -140,7 +149,7 @@ function applyReplace(holder: DocumentHolder, pointer: string, value: unknown):
   if (Array.isArray(container)) {
     container[Number(key)] = value;
   } else {
-    container[key] = value;
