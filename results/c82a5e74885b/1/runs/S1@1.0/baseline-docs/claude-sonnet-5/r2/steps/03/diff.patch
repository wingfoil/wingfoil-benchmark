 import { test } from 'node:test';
 import assert from 'node:assert/strict';
-import { applyPatch } from '../src/index.ts';
+import { applyPatch, resolvePointer } from '../src/index.ts';
 
 // The examples from RFC 6902 appendix A.
 
@@ -84,6 +84,12 @@ test('A.15: test fails when comparing a string to a number', () => {
   assert.throws(() => applyPatch(document, [{ op: 'test', path: '/~01', value: '10' }]));
 });
 
+test('A.14: ~ escape ordering lets "/~01" address the member "~1"', () => {
+  const document = { '/': 9, '~1': 10 };
+  const result = applyPatch(document, [{ op: 'test', path: '/~01', value: 10 }]);
+  assert.deepEqual(result, document);
+});
+
 test('A.16: adds an array value as a single element', () => {
   const document = { foo: ['bar'] };
   const result = applyPatch(document, [{ op: 'add', path: '/foo/-', value: ['abc', 'def'] }]);
@@ -238,3 +244,23 @@ test('rejects "move" missing "from"', () => {
 test('rejects "copy" missing "from"', () => {
   assert.throws(() => applyPatch({}, [{ op: 'copy', path: '/foo' }] as unknown as []));
 });
+
+test('adds a member literally named "__proto__" without altering the object prototype', () => {
+  const document = {};
+  const result = applyPatch(document, [{ op: 'add', path: '/__proto__', value: { polluted: true } }]) as Record<
+    string,
+    unknown
+  >;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ['__proto__']);
+  assert.deepEqual(resolvePointer(result, '/__proto__'), { polluted: true });
+  assert.equal(Object.prototype.hasOwnProperty.call({}, 'polluted'), false);
+});
+
+test('replaces a member literally named "__proto__" without altering the object prototype', () => {
+  const document = applyPatch({}, [{ op: 'add', path: '/__proto__', value: 1 }]);
+  const result = applyPatch(document, [{ op: 'replace', path: '/__proto__', value: 2 }]);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(result, resolvePointer(result, ''));
+  assert.equal(resolvePointer(result, '/__proto__'), 2);
+});
