+const OPERATIONS_WITH_VALUE = new Set(['add', 'replace', 'test']);
+const OPERATIONS_WITH_FROM = new Set(['move', 'copy']);
+const VALID_OPERATIONS = new Set(['add', 'remove', 'replace', 'move', 'copy', 'test']);
+
+interface Operation {
+  op: string;
+  path: string;
+  value: unknown;
+  from: string;
+}
+
+/**
+ * Validates the shape of a single JSON Patch operation, as external input.
+ */
+function parseOperation(raw: unknown, index: number): Operation {
+  if (raw === null || typeof raw !== 'object' || Array.isArray(raw)) {
+    throw new Error(`Invalid JSON Patch: operation at index ${index} must be an object`);
+  }
+  const record = raw as Record<string, unknown>;
+  const { op } = record;
+  if (typeof op !== 'string' || !VALID_OPERATIONS.has(op)) {
+    throw new Error(`Invalid JSON Patch: operation at index ${index} has an invalid "op"`);
+  }
+  const { path } = record;
+  if (typeof path !== 'string') {
+    throw new Error(`Invalid JSON Patch: "${op}" operation at index ${index} is missing a string "path"`);
+  }
+  if (OPERATIONS_WITH_VALUE.has(op) && !Object.prototype.hasOwnProperty.call(record, 'value')) {
+    throw new Error(`Invalid JSON Patch: "${op}" operation at index ${index} is missing "value"`);
+  }
+  const { from } = record;
+  if (OPERATIONS_WITH_FROM.has(op) && typeof from !== 'string') {
+    throw new Error(`Invalid JSON Patch: "${op}" operation at index ${index} is missing a string "from"`);
+  }
+  return { op, path, value: record.value, from: from as string };
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the
+ * resulting document as a new value, without mutating `document` or any
+ * value reachable from `patch`.
+ *
+ * Throws when `patch` is not a syntactically valid JSON Patch, or when one
+ * of its operations fails (e.g. a "test" mismatch, or a path that does not
+ * resolve within the document).
+ */
+export function applyPatch(document: unknown, patch: readonly unknown[]): unknown {
+  if (!Array.isArray(patch)) {
+    throw new TypeError('JSON Patch must be an array of operations');
+  }
+
+  const holder: DocumentHolder = { doc: structuredClone(document) };
+
+  patch.forEach((raw, index) => {
+    const operation = parseOperation(raw, index);
+    switch (operation.op) {
+      case 'add':
+        applyAdd(holder, operation.path, structuredClone(operation.value));
+        break;
+      case 'remove':
+        applyRemove(holder, operation.path);
+        break;
+      case 'replace':
+        applyReplace(holder, operation.path, structuredClone(operation.value));
+        break;
+      case 'move':
+        applyMove(holder, operation.from, operation.path);
+        break;
+      case 'copy':
+        applyCopy(holder, operation.from, operation.path);
+        break;
+      case 'test':
+        if (!deepEqual(resolvePointer(holder.doc, operation.path), operation.value)) {
+          throw new Error(`JSON Patch "test" operation at index ${index} failed: value at "${operation.path}" does not match`);
+        }
+        break;
+    }
+  });
+
+  return holder.doc;
 }
diff --git a/test/apply-patch.test.ts b/test/apply-patch.test.ts
