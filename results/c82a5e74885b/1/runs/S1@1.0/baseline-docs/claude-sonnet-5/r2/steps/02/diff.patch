index 0000000000000000000000000000000000000000..ec85cf43dacd0fb7c72d79e6198da61f8a918eea
--- /dev/null
+++ b/test/apply-patch.test.ts
@@ -0,0 +1,240 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch } from '../src/index.ts';
+
+// The examples from RFC 6902 appendix A.
+
+test('A.1: adds an object member', () => {
+  const document = { foo: 'bar' };
+  const result = applyPatch(document, [{ op: 'add', path: '/baz', value: 'qux' }]);
+  assert.deepEqual(result, { foo: 'bar', baz: 'qux' });
+});
+
+test('A.2: adds an array element', () => {
+  const document = { foo: ['bar', 'baz'] };
+  const result = applyPatch(document, [{ op: 'add', path: '/foo/1', value: 'qux' }]);
+  assert.deepEqual(result, { foo: ['bar', 'qux', 'baz'] });
+});
+
+test('A.3: removes an object member', () => {
+  const document = { baz: 'qux', foo: 'bar' };
+  const result = applyPatch(document, [{ op: 'remove', path: '/baz' }]);
+  assert.deepEqual(result, { foo: 'bar' });
+});
+
+test('A.4: removes an array element', () => {
+  const document = { foo: ['bar', 'qux', 'baz'] };
+  const result = applyPatch(document, [{ op: 'remove', path: '/foo/1' }]);
+  assert.deepEqual(result, { foo: ['bar', 'baz'] });
+});
+
+test('A.5: replaces a value', () => {
+  const document = { baz: 'qux', foo: 'bar' };
+  const result = applyPatch(document, [{ op: 'replace', path: '/baz', value: 'boo' }]);
+  assert.deepEqual(result, { baz: 'boo', foo: 'bar' });
+});
+
+test('A.6: moves a value', () => {
+  const document = { foo: { bar: 'baz', waldo: 'fred' }, qux: { corge: 'grault' } };
+  const result = applyPatch(document, [{ op: 'move', from: '/foo/waldo', path: '/qux/thud' }]);
+  assert.deepEqual(result, { foo: { bar: 'baz' }, qux: { corge: 'grault', thud: 'fred' } });
+});
+
+test('A.7: moves an array element', () => {
+  const document = { foo: ['all', 'grass', 'cows', 'eat'] };
+  const result = applyPatch(document, [{ op: 'move', from: '/foo/1', path: '/foo/3' }]);
+  assert.deepEqual(result, { foo: ['all', 'cows', 'eat', 'grass'] });
+});
+
+test('A.8: a successful test leaves the document unchanged', () => {
+  const document = { baz: 'qux', foo: ['a', 2, 'c'] };
+  const result = applyPatch(document, [
+    { op: 'test', path: '/baz', value: 'qux' },
+    { op: 'test', path: '/foo/1', value: 2 },
+  ]);
+  assert.deepEqual(result, document);
+});
+
+test('A.9: a failing test throws', () => {
+  const document = { baz: 'qux' };
+  assert.throws(() => applyPatch(document, [{ op: 'test', path: '/baz', value: 'bar' }]));
+});
+
+test('A.10: adds a nested member object', () => {
+  const document = { foo: 'bar' };
+  const result = applyPatch(document, [{ op: 'add', path: '/child', value: { grandchild: {} } }]);
+  assert.deepEqual(result, { foo: 'bar', child: { grandchild: {} } });
+});
+
+test('A.11: ignores unrecognized operation members', () => {
+  const document = { foo: 'bar' };
+  const result = applyPatch(document, [
+    { op: 'add', path: '/baz', value: 'qux', xyz: 123 } as unknown as object,
+  ]);
+  assert.deepEqual(result, { foo: 'bar', baz: 'qux' });
+});
+
+test('A.12: adding to a nonexistent target throws', () => {
+  const document = { foo: 'bar' };
+  assert.throws(() => applyPatch(document, [{ op: 'add', path: '/baz/bat', value: 'qux' }]));
+});
+
+test('A.15: test fails when comparing a string to a number', () => {
+  const document = { '/': 9, '~1': 10 };
+  assert.throws(() => applyPatch(document, [{ op: 'test', path: '/~01', value: '10' }]));
+});
+
+test('A.16: adds an array value as a single element', () => {
+  const document = { foo: ['bar'] };
+  const result = applyPatch(document, [{ op: 'add', path: '/foo/-', value: ['abc', 'def'] }]);
+  assert.deepEqual(result, { foo: ['bar', ['abc', 'def']] });
+});
+
+// Additional coverage beyond the RFC appendix.
+
+test('add replaces an object member that already exists', () => {
+  const document = { foo: 'bar' };
+  const result = applyPatch(document, [{ op: 'add', path: '/foo', value: 'baz' }]);
+  assert.deepEqual(result, { foo: 'baz' });
+});
+
+test('add at the root replaces the whole document', () => {
+  const document = { foo: 'bar' };
+  const result = applyPatch(document, [{ op: 'add', path: '', value: { baz: 'qux' } }]);
+  assert.deepEqual(result, { baz: 'qux' });
+});
+
+test('add rejects an array index past the end', () => {
+  const document = { foo: ['bar'] };
+  assert.throws(() => applyPatch(document, [{ op: 'add', path: '/foo/5', value: 'x' }]));
+});
+
+test('replace at the root replaces the whole document', () => {
+  const document = { foo: 'bar' };
+  const result = applyPatch(document, [{ op: 'replace', path: '', value: { baz: 'qux' } }]);
+  assert.deepEqual(result, { baz: 'qux' });
+});
+
+test('replace rejects a path that does not exist', () => {
+  const document = { foo: 'bar' };
+  assert.throws(() => applyPatch(document, [{ op: 'replace', path: '/baz', value: 'x' }]));
+});
+
+test('remove rejects a path that does not exist', () => {
+  const document = { foo: 'bar' };
+  assert.throws(() => applyPatch(document, [{ op: 'remove', path: '/baz' }]));
+});
+
+test('remove rejects the root document', () => {
+  const document = { foo: 'bar' };
+  assert.throws(() => applyPatch(document, [{ op: 'remove', path: '' }]));
+});
+
+test('copy duplicates a value without aliasing the source', () => {
+  const document = { foo: { bar: 'baz' } };
+  const result = applyPatch(document, [{ op: 'copy', path: '/qux', from: '/foo' }]) as {
+    foo: { bar: string };
+    qux: { bar: string };
+  };
+  assert.deepEqual(result, { foo: { bar: 'baz' }, qux: { bar: 'baz' } });
+  assert.notEqual(result.foo, result.qux);
+});
+
+test('copy rejects a source that does not exist', () => {
+  const document = { foo: 'bar' };
+  assert.throws(() => applyPatch(document, [{ op: 'copy', path: '/baz', from: '/missing' }]));
+});
+
+test('move rejects a source that does not exist', () => {
+  const document = { foo: 'bar' };
+  assert.throws(() => applyPatch(document, [{ op: 'move', path: '/baz', from: '/missing' }]));
+});
+
+test('move rejects moving a value into one of its own children', () => {
+  const document = { foo: { bar: 'baz' } };
+  assert.throws(() => applyPatch(document, [{ op: 'move', from: '/foo', path: '/foo/bar' }]));
+});
+
+test('move allows a from and path that are identical', () => {
+  const document = { foo: 'bar' };
+  const result = applyPatch(document, [{ op: 'move', from: '/foo', path: '/foo' }]);
+  assert.deepEqual(result, { foo: 'bar' });
+});
+
+test('test treats object member order as insignificant', () => {
+  const document = { foo: { a: 1, b: 2 } };
+  const result = applyPatch(document, [{ op: 'test', path: '/foo', value: { b: 2, a: 1 } }]);
+  assert.deepEqual(result, document);
+});
+
+test('test treats array element order as significant', () => {
+  const document = { foo: [1, 2] };
+  assert.throws(() => applyPatch(document, [{ op: 'test', path: '/foo', value: [2, 1] }]));
+});
+
+test('applies a sequence of operations in order', () => {
+  const document = { foo: 'bar' };
+  const result = applyPatch(document, [
+    { op: 'add', path: '/baz', value: 1 },
+    { op: 'replace', path: '/baz', value: 2 },
+    { op: 'test', path: '/baz', value: 2 },
+    { op: 'remove', path: '/foo' },
+  ]);
+  assert.deepEqual(result, { baz: 2 });
+});
+
+test('does not mutate the input document', () => {
+  const document = { foo: { bar: 'baz' }, list: [1, 2, 3] };
+  const snapshot = structuredClone(document);
+  applyPatch(document, [
+    { op: 'add', path: '/foo/qux', value: true },
+    { op: 'remove', path: '/list/0' },
+  ]);
+  assert.deepEqual(document, snapshot);
+});
+
+test('does not let the returned document alias the input', () => {
+  const document = { foo: { bar: 'baz' } };
+  const result = applyPatch(document, [{ op: 'replace', path: '/foo/bar', value: 'changed' }]) as {
+    foo: { bar: string };
+  };
+  assert.equal(result.foo.bar, 'changed');
+  assert.equal(document.foo.bar, 'baz');
+});
+
+test('does not let a stored value alias the patch', () => {
+  const document = {};
+  const value = { nested: 'original' };
+  const patch = [{ op: 'add', path: '/foo', value }];
+  const result = applyPatch(document, patch) as { foo: { nested: string } };
+  value.nested = 'mutated';
+  assert.equal(result.foo.nested, 'original');
+});
+
+test('rejects a patch that is not an array', () => {
+  assert.throws(() => applyPatch({}, { op: 'add', path: '/foo', value: 1 } as unknown as []));
+});
+
+test('rejects an operation that is not an object', () => {
+  assert.throws(() => applyPatch({}, ['add'] as unknown as []));
+});
+
+test('rejects an unknown operation name', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'patch', path: '/foo', value: 1 }] as unknown as []));
+});
+
+test('rejects an operation missing "path"', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'add', value: 1 }] as unknown as []));
+});
+
+test('rejects "add" missing "value"', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: '/foo' }] as unknown as []));
+});
+
+test('rejects "move" missing "from"', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'move', path: '/foo' }] as unknown as []));
+});
+
+test('rejects "copy" missing "from"', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'copy', path: '/foo' }] as unknown as []));
+});
