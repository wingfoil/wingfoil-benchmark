+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document.
+ *
+ * @param document - The JSON document to patch.
+ * @param patch - An ordered list of operations to apply.
+ * @returns A new document with every operation of `patch` applied, in order; `document` is left untouched.
+ * @throws If `patch` is not a well-formed JSON Patch, or if any of its operations fails to apply.
+ */
+export function applyPatch(document: JsonValue, patch: JsonPatchOperation[]): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: must be an array of operations");
+  }
