+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function appendPointer(path: string, token: string): string {
+  return `${path}/${encodeToken(token)}`;
+}
+
+function diffArrays(path: string, from: JsonValue[], to: JsonValue[], patch: JsonPatchOperation[]): void {
+  const common = Math.min(from.length, to.length);
+  for (let index = 0; index < common; index++) {
+    diffValues(appendPointer(path, String(index)), from[index], to[index], patch);
+  }
+  for (let index = from.length - 1; index >= to.length; index--) {
+    patch.push({ op: "remove", path: appendPointer(path, String(index)) });
+  }
+  for (let index = from.length; index < to.length; index++) {
+    patch.push({ op: "add", path: appendPointer(path, String(index)), value: cloneJson(to[index]) });
+  }
+}
+
+function diffObjects(
+  path: string,
+  from: Record<string, JsonValue>,
+  to: Record<string, JsonValue>,
+  patch: JsonPatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.prototype.hasOwnProperty.call(to, key)) {
+      patch.push({ op: "remove", path: appendPointer(path, key) });
+    }
+  }
+
+  for (const key of Object.keys(to)) {
+    if (Object.prototype.hasOwnProperty.call(from, key)) {
+      diffValues(appendPointer(path, key), from[key], to[key], patch);
+    } else {
+      patch.push({ op: "add", path: appendPointer(path, key), value: cloneJson(to[key]) });
+    }
+  }
+}
+
+function diffValues(path: string, from: JsonValue, to: JsonValue, patch: JsonPatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(path, from, to, patch);
+    return;
+  }
+
+  if (isObject(from) && isObject(to)) {
+    diffObjects(path, from, to, patch);
+    return;
+  }
+
+  patch.push({ op: "replace", path, value: cloneJson(to) });
+}
+
+/**
+ * Computes the JSON Patch (RFC 6902) that turns `from` into `to`.
+ *
+ * @param from - The source JSON document.
+ * @param to - The target JSON document.
+ * @returns An ordered list of operations which, applied to `from` with {@link applyPatch}, yields `to`.
+ *   Only the parts of the document that differ are described; neither `from` nor `to` is mutated, and
+ *   values carried by the resulting operations are independent copies.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatchOperation[] {
+  const patch: JsonPatchOperation[] = [];
+  diffValues("", from, to, patch);
+  return patch;
+}
