diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fd65396582bf5712ef8335468e63cbe873561a8f
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,68 @@
+/**
+ * A value as it can appear in a parsed JSON document.
+ */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+function decodeToken(rawToken: string): string {
+  if (/~(?![01])/.test(rawToken)) {
+    throw new Error(`Invalid JSON Pointer: "~" must be followed by "0" or "1" in "${rawToken}"`);
+  }
+  return rawToken.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function step(current: unknown, token: string): unknown {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token)) {
+      throw new Error(`Invalid array index "${token}" in JSON Pointer`);
+    }
+    const index = Number(token);
+    if (index >= current.length) {
+      throw new Error(`Array index "${token}" is out of bounds in JSON Pointer`);
+    }
+    return current[index];
+  }
+
+  if (current !== null && typeof current === "object") {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new Error(`No member named "${token}" in JSON Pointer`);
+    }
+    return (current as { [key: string]: unknown })[token];
+  }
+
+  throw new Error(`Cannot resolve JSON Pointer token "${token}" on a non-container value`);
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @param document - The JSON document to resolve the pointer against.
+ * @param pointer - A JSON Pointer string, e.g. "/foo/0/bar".
+ * @returns The value the pointer refers to.
+ * @throws If `pointer` is not a syntactically valid JSON Pointer, or if it
+ *   does not resolve to a value within `document`.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: must be a string");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+
+  if (pointer[0] !== "/") {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`);
+  }
+
+  const tokens = pointer.split("/").slice(1).map(decodeToken);
+
+  return tokens.reduce<unknown>((current, token) => step(current, token), document) as JsonValue;
+}
diff --git a/test/index.test.ts b/test/index.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1d800df1cc6b0b11d94844ef7053c6fff795b074
--- /dev/null
+++ b/test/index.test.ts
@@ -0,0 +1,93 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { resolvePointer } from "../src/index.ts";
+
+const rfcExample = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  "k\"l": 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("the empty pointer resolves to the whole document", () => {
+  assert.equal(resolvePointer(rfcExample, ""), rfcExample);
+});
+
+test("resolves a top-level array member", () => {
+  assert.deepEqual(resolvePointer(rfcExample, "/foo"), ["bar", "baz"]);
+});
+
+test("resolves an array element by index", () => {
+  assert.equal(resolvePointer(rfcExample, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfcExample, "/foo/1"), "baz");
+});
+
+test("resolves the member with an empty-string name", () => {
+  assert.equal(resolvePointer(rfcExample, "/"), 0);
+});
+
+test("resolves members whose names need no escaping", () => {
+  assert.equal(resolvePointer(rfcExample, "/c%d"), 2);
+  assert.equal(resolvePointer(rfcExample, "/e^f"), 3);
+  assert.equal(resolvePointer(rfcExample, "/g|h"), 4);
+  assert.equal(resolvePointer(rfcExample, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfcExample, '/k"l'), 6);
+  assert.equal(resolvePointer(rfcExample, "/ "), 7);
+});
+
+test("decodes ~1 to / and ~0 to ~ in member names", () => {
+  assert.equal(resolvePointer(rfcExample, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfcExample, "/m~0n"), 8);
+});
+
+test("resolves nested members through objects and arrays", () => {
+  const document = { a: { b: [{ c: "deep" }] } };
+  assert.equal(resolvePointer(document, "/a/b/0/c"), "deep");
+});
+
