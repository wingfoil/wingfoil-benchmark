   assert.equal(Object.getPrototypeOf(result), Object.prototype);
   assert.deepEqual(result.__proto__, { already: "there" });
 });
+
+// applyMergePatch — RFC 7386
+
+const mergePatchExamples: Array<{ target: JsonValue; patch: JsonValue; result: JsonValue }> = [
+  { target: { a: "b" }, patch: { a: "c" }, result: { a: "c" } },
+  { target: { a: "b" }, patch: { b: "c" }, result: { a: "b", b: "c" } },
+  { target: { a: "b" }, patch: { a: null }, result: {} },
+  { target: { a: "b", b: "c" }, patch: { a: null }, result: { b: "c" } },
+  { target: { a: ["b"] }, patch: { a: "c" }, result: { a: "c" } },
+  { target: { a: "c" }, patch: { a: ["b"] }, result: { a: ["b"] } },
+  { target: { a: { b: "c" } }, patch: { a: { b: "d", c: null } }, result: { a: { b: "d" } } },
+  { target: { a: [{ b: "c" }] }, patch: { a: [1] }, result: { a: [1] } },
+  { target: ["a", "b"], patch: ["c", "d"], result: ["c", "d"] },
+  { target: { a: "b" }, patch: ["c"], result: ["c"] },
+  { target: { a: "foo" }, patch: null, result: null },
+  { target: { a: "foo" }, patch: "bar", result: "bar" },
+  { target: { e: null }, patch: { a: 1 }, result: { e: null, a: 1 } },
+  { target: [1, 2], patch: { a: "b", c: null }, result: { a: "b" } },
+  { target: {}, patch: { a: { bb: { ccc: null } } }, result: { a: { bb: {} } } },
+];
+
+for (const { target, patch, result } of mergePatchExamples) {
+  test(`merge-patches ${JSON.stringify(target)} with ${JSON.stringify(patch)} into ${JSON.stringify(result)}`, () => {
+    assert.deepEqual(applyMergePatch(target, patch), result);
+  });
+}
+
+test("merges nested objects recursively, adding new members alongside existing ones", () => {
+  const target = { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" } };
+  const patch = { author: { familyName: null, nickname: "Jonny" }, tags: ["example"] };
+  const result = applyMergePatch(target, patch);
+  assert.deepEqual(result, { title: "Goodbye!", author: { givenName: "John", nickname: "Jonny" }, tags: ["example"] });
+});
+
+test("does not mutate the input target", () => {
+  const target = { a: { b: "c" }, list: [1, 2] };
+  const snapshot = JSON.parse(JSON.stringify(target));
+  applyMergePatch(target, { a: { b: null, d: "e" }, list: [3] });
+  assert.deepEqual(target, snapshot);
+});
+
+test("does not mutate the input patch", () => {
+  const patch = { a: { b: "c" } };
+  const snapshot = JSON.parse(JSON.stringify(patch));
+  const result = applyMergePatch({ a: { b: "x" } }, patch) as Record<string, JsonValue>;
+  (result.a as Record<string, JsonValue>).b = "mutated";
+  assert.deepEqual(patch, snapshot);
+});
+
+test("adds a member named __proto__ as a literal member, without altering the object's prototype", () => {
+  const target = { foo: "bar" };
+  const patch = JSON.parse('{"__proto__": {"polluted": true}}');
+  const result = applyMergePatch(target, patch) as Record<string, JsonValue>;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(Object.prototype.hasOwnProperty.call(result, "__proto__"), true);
+  assert.deepEqual(result.__proto__, { polluted: true });
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
