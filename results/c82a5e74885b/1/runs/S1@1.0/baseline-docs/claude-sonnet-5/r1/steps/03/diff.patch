diff --git a/test/index.test.ts b/test/index.test.ts
index 44310215d004db9aa86a1b1538674cf14664d10c..3738c27430372986bde9a358a6c5f628d0907f3e 100644
--- a/test/index.test.ts
+++ b/test/index.test.ts
@@ -1,6 +1,6 @@
 import assert from "node:assert/strict";
 import { test } from "node:test";
-import { applyPatch, resolvePointer } from "../src/index.ts";
+import { applyPatch, resolvePointer, type JsonValue } from "../src/index.ts";
 
 const rfcExample = {
   foo: ["bar", "baz"],
@@ -299,3 +299,35 @@ test("rejects a move operation missing its from member", () => {
   // @ts-expect-error exercising runtime validation of a boundary input
   assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "move", path: "/baz" }]));
 });
+
+test("adds a member named __proto__ as a literal member, without altering the object's prototype", () => {
+  const document = { foo: "bar" };
+  const result = applyPatch(document, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as Record<
+    string,
+    JsonValue
+  >;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(Object.prototype.hasOwnProperty.call(result, "__proto__"), true);
+  assert.deepEqual(result.__proto__, { polluted: true });
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("replaces an existing literal __proto__ member, without altering the object's prototype", () => {
+  const document = JSON.parse('{"__proto__": 1, "foo": "bar"}');
+  const result = applyPatch(document, [{ op: "replace", path: "/__proto__", value: { polluted: true } }]) as Record<
+    string,
+    JsonValue
+  >;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(result.__proto__, { polluted: true });
+});
+
+test("clones a literal __proto__ member without altering the clone's prototype", () => {
+  const document = JSON.parse('{"__proto__": {"already": "there"}, "foo": "bar"}');
+  const result = applyPatch(document, [{ op: "replace", path: "/foo", value: "changed" }]) as Record<
+    string,
+    JsonValue
+  >;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(result.__proto__, { already: "there" });
+});
