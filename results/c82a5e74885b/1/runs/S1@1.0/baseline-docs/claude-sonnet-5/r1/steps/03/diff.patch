+/**
+ * Sets an object member by name, treating `key` as a plain string rather than
+ * a JS property accessor. A bare `container[key] = value` would, for
+ * `key === "__proto__"`, invoke `Object.prototype`'s `__proto__` setter and
+ * change `container`'s prototype instead of creating a member named
+ * "__proto__" — a prototype-pollution hazard for a library that applies
+ * patches to untrusted JSON.
+ */
+function setMember(container: Record<string, JsonValue>, key: string, value: JsonValue): void {
+  Object.defineProperty(container, key, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
+
 function cloneJson(value: JsonValue): JsonValue {
   if (Array.isArray(value)) {
     return value.map(cloneJson);
