diff --git a/src/index.test.ts b/src/index.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c4d0ec790ae84ece386ef1f0e1272559737b5b3f
--- /dev/null
+++ b/src/index.test.ts
@@ -0,0 +1,83 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "./index.ts";
+
+// Example document from RFC 6901, Appendix A.
+const document = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 Appendix A examples", () => {
+  assert.deepEqual(resolvePointer(document, ""), document);
+  assert.deepEqual(resolvePointer(document, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(document, "/foo/0"), "bar");
+  assert.equal(resolvePointer(document, "/"), 0);
+  assert.equal(resolvePointer(document, "/a~1b"), 1);
+  assert.equal(resolvePointer(document, "/c%d"), 2);
+  assert.equal(resolvePointer(document, "/e^f"), 3);
+  assert.equal(resolvePointer(document, "/g|h"), 4);
+  assert.equal(resolvePointer(document, "/i\\j"), 5);
+  assert.equal(resolvePointer(document, '/k"l'), 6);
+  assert.equal(resolvePointer(document, "/ "), 7);
+  assert.equal(resolvePointer(document, "/m~0n"), 8);
+});
+
+test("resolves nested structures", () => {
+  const doc = { a: { b: [{ c: 42 }] } };
+  assert.equal(resolvePointer(doc, "/a/b/0/c"), 42);
+});
+
+test("throws when pointer does not start with /", () => {
+  assert.throws(() => resolvePointer(document, "foo"));
+});
+
+test("throws on malformed escape sequences", () => {
+  assert.throws(() => resolvePointer(document, "/foo~"));
+  assert.throws(() => resolvePointer(document, "/foo~2"));
+});
+
+test("throws when a path segment is missing", () => {
+  assert.throws(() => resolvePointer(document, "/missing"));
+  assert.throws(() => resolvePointer(document, "/foo/missing"));
+});
+
+test("throws on array index out of bounds", () => {
+  assert.throws(() => resolvePointer(document, "/foo/2"));
+});
+
+test("throws on non-canonical array index (leading zero)", () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, "/a/01"));
+});
+
+test("throws on '-' array index (no corresponding element)", () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, "/a/-"));
+});
+
+test("throws when traversing into a primitive", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+});
+
+test("throws when pointer is not a string", () => {
+  // @ts-expect-error intentionally passing a non-string pointer
+  assert.throws(() => resolvePointer(document, 42));
+});
+
+test("does not fall prey to prototype pollution lookups", () => {
+  const doc = JSON.parse('{"a": 1}');
+  assert.throws(() => resolvePointer(doc, "/__proto__"));
+  assert.throws(() => resolvePointer(doc, "/constructor"));
+});
+
+test("resolves the whole document for the empty pointer, including primitives", () => {
+  assert.equal(resolvePointer(42, ""), 42);
+  assert.equal(resolvePointer(null, ""), null);
+});
diff --git a/src/index.ts b/src/index.ts
