index 0000000000000000000000000000000000000000..760090974dda684ab4a0fac91f5d39a3301cc49a
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,61 @@
+export type JsonValue =
+  | string
+  | number
+  | boolean
+  | null
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+function unescapeToken(token: string): string {
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function isArrayIndexToken(token: string): boolean {
+  return token === "0" || /^[1-9][0-9]*$/.test(token);
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * Throws if `pointer` is not a syntactically valid JSON Pointer, or if it
+ * does not resolve to a value within `document`.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  if (typeof pointer !== "string") {
+    throw new Error("JSON Pointer must be a string");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (pointer[0] !== "/") {
+    throw new Error(`Invalid JSON Pointer: "${pointer}"`);
+  }
+  if (/~(?![01])/.test(pointer)) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}"`);
+  }
+
+  const tokens = pointer.split("/").slice(1).map(unescapeToken);
+
+  let current: JsonValue = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!isArrayIndexToken(token)) {
+        throw new Error(`Pointer "${pointer}" does not resolve to a value`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new Error(`Pointer "${pointer}" does not resolve to a value`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(`Pointer "${pointer}" does not resolve to a value`);
+      }
+      current = (current as { [key: string]: JsonValue })[token];
+    } else {
+      throw new Error(`Pointer "${pointer}" does not resolve to a value`);
+    }
+  }
+
+  return current;
+}
