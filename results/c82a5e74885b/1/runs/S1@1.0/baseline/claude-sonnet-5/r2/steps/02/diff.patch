diff --git a/test/apply-patch.test.ts b/test/apply-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..808cff2611e1e9b19744833b4fa6e2cd66b7fa9e
--- /dev/null
+++ b/test/apply-patch.test.ts
@@ -0,0 +1,173 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("does not mutate the input document or patch", () => {
+  const document = { a: 1, b: [1, 2, 3] };
+  const patch = [{ op: "add", path: "/c", value: 42 } as const];
+  const documentCopy = structuredClone(document);
+  const patchCopy = structuredClone(patch);
+
+  const result = applyPatch(document, patch);
+
+  assert.deepEqual(document, documentCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.deepEqual(result, { a: 1, b: [1, 2, 3], c: 42 });
+});
+
+test("add: sets a new object member", () => {
+  const result = applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]);
+  assert.deepEqual(result, { foo: "bar", baz: "qux" });
+});
+
+test("add: replaces an existing object member", () => {
+  const result = applyPatch({ foo: "bar" }, [{ op: "add", path: "/foo", value: "qux" }]);
+  assert.deepEqual(result, { foo: "qux" });
+});
+
+test("add: inserts into an array at an index", () => {
+  const result = applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]);
+  assert.deepEqual(result, { foo: ["bar", "qux", "baz"] });
+});
+
+test("add: appends to an array with '-'", () => {
+  const result = applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/-", value: "qux" }]);
+  assert.deepEqual(result, { foo: ["bar", "baz", "qux"] });
+});
+
+test("add: appends to an array at index equal to its length", () => {
+  const result = applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/1", value: "baz" }]);
+  assert.deepEqual(result, { foo: ["bar", "baz"] });
+});
+
+test("add: replaces the whole document at the root pointer", () => {
+  const result = applyPatch({ foo: "bar" }, [{ op: "add", path: "", value: { baz: "qux" } }]);
+  assert.deepEqual(result, { baz: "qux" });
+});
+
+test("add: creates nested objects along an existing path", () => {
+  const result = applyPatch({ foo: {} }, [{ op: "add", path: "/foo/bar", value: ["baz"] }]);
+  assert.deepEqual(result, { foo: { bar: ["baz"] } });
+});
+
+test("add: fails when the array index is out of bounds", () => {
+  assert.throws(() => applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/5", value: "x" }]));
+});
+
+test("add: fails when an intermediate path segment does not exist", () => {
+  assert.throws(() => applyPatch({ foo: {} }, [{ op: "add", path: "/bar/baz", value: 1 }]));
+});
+
+test("remove: deletes an object member", () => {
+  const result = applyPatch({ foo: "bar", baz: "qux" }, [{ op: "remove", path: "/baz" }]);
+  assert.deepEqual(result, { foo: "bar" });
+});
+
+test("remove: deletes an array element, shifting later elements", () => {
+  const result = applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]);
+  assert.deepEqual(result, { foo: ["bar", "baz"] });
+});
+
+test("remove: fails when the member does not exist", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "remove", path: "/baz" }]));
+});
+
+test("remove: fails on the whole document", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "remove", path: "" }]));
+});
+
+test("replace: changes an existing object member's value", () => {
+  const result = applyPatch({ foo: "bar", baz: "qux" }, [{ op: "replace", path: "/baz", value: "boo" }]);
+  assert.deepEqual(result, { foo: "bar", baz: "boo" });
+});
+
+test("replace: changes an existing array element's value", () => {
+  const result = applyPatch({ foo: ["bar", "baz"] }, [{ op: "replace", path: "/foo/0", value: "qux" }]);
+  assert.deepEqual(result, { foo: ["qux", "baz"] });
+});
+
+test("replace: fails when the target does not already exist", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "replace", path: "/baz", value: 1 }]));
+});
+
+test("move: relocates an object member", () => {
+  const result = applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [
+    { op: "move", path: "/qux/thud", from: "/foo/waldo" },
+  ]);
+  assert.deepEqual(result, { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+});
+
+test("move: relocates an array element", () => {
+  const result = applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [
+    { op: "move", path: "/foo/3", from: "/foo/1" },
+  ]);
+  assert.deepEqual(result, { foo: ["all", "cows", "eat", "grass"] });
+});
+
+test("move: fails when moving a location into one of its own children", () => {
+  assert.throws(() =>
+    applyPatch({ foo: { bar: "baz" } }, [{ op: "move", path: "/foo/bar/baz", from: "/foo" }]),
+  );
+});
+
+test("move: fails when the source does not exist", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "move", path: "/baz", from: "/qux" }]));
+});
+
+test("copy: duplicates a value without aliasing the original", () => {
+  const result = applyPatch({ foo: { bar: [1, 2, 3] } }, [
+    { op: "copy", path: "/baz", from: "/foo/bar" },
+  ]);
+  assert.deepEqual(result, { foo: { bar: [1, 2, 3] }, baz: [1, 2, 3] });
+
+  const mutated = applyPatch(result, [{ op: "add", path: "/baz/0", value: "changed" }]);
+  assert.deepEqual((mutated as any).foo.bar, [1, 2, 3]);
+});
+
+test("copy: duplicates an array element", () => {
+  const result = applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [
+    { op: "copy", path: "/foo/3", from: "/foo/1" },
+  ]);
+  assert.deepEqual(result, { foo: ["all", "grass", "cows", "grass", "eat"] });
+});
+
+test("test: succeeds when the value matches", () => {
+  const result = applyPatch({ foo: "bar" }, [{ op: "test", path: "/foo", value: "bar" }]);
+  assert.deepEqual(result, { foo: "bar" });
+});
+
+test("test: fails when the value does not match", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "test", path: "/foo", value: "qux" }]));
+});
+
+test("test: compares objects and arrays structurally, ignoring key order", () => {
+  const result = applyPatch({ foo: { a: 1, b: 2 } }, [
+    { op: "test", path: "/foo", value: { b: 2, a: 1 } },
+  ]);
+  assert.deepEqual(result, { foo: { a: 1, b: 2 } });
+});
+
+test("applies several operations in sequence", () => {
+  const document = { a: 1, b: { c: 2 } };
+  const result = applyPatch(document, [
+    { op: "replace", path: "/a", value: 10 },
+    { op: "add", path: "/b/d", value: 3 },
+    { op: "test", path: "/b/d", value: 3 },
+    { op: "remove", path: "/b/c" },
+  ]);
+  assert.deepEqual(result, { a: 10, b: { d: 3 } });
+});
+
+test("fails when the patch is not an array", () => {
+  assert.throws(() => applyPatch({}, { op: "add", path: "/a", value: 1 }));
+});
+
+test("fails when an operation is missing required members", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "move", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ path: "/a", value: 1 }]));
+});
+
+test("fails on an unknown operation name", () => {
+  assert.throws(() => applyPatch({}, [{ op: "frobnicate", path: "/a", value: 1 }]));
+});
