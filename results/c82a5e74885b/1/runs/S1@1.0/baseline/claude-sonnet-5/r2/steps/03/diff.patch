diff --git a/test/apply-patch.test.ts b/test/apply-patch.test.ts
index 808cff2611e1e9b19744833b4fa6e2cd66b7fa9e..2e40548c32ea0745ee5743749f7d8daa976ad67e 100644
--- a/test/apply-patch.test.ts
+++ b/test/apply-patch.test.ts
@@ -171,3 +171,17 @@ test("fails when an operation is missing required members", () => {
 test("fails on an unknown operation name", () => {
   assert.throws(() => applyPatch({}, [{ op: "frobnicate", path: "/a", value: 1 }]));
 });
+
+test("add: treats '__proto__' as an ordinary member name, not a prototype assignment", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: "yes" } }]) as any;
+  assert.deepEqual(result, { ["__proto__"]: { polluted: "yes" } });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(Object.prototype.hasOwnProperty.call(result, "__proto__"), true);
+  assert.deepEqual(({} as any).polluted, undefined);
+});
+
+test("replace: updates a prior '__proto__' member without touching the real prototype", () => {
+  const withMember = applyPatch({}, [{ op: "add", path: "/__proto__", value: 1 }]);
+  const result = applyPatch(withMember, [{ op: "replace", path: "/__proto__", value: 2 }]);
+  assert.deepEqual(result, { ["__proto__"]: 2 } as any);
+});
