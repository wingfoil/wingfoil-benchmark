@@ -81,3 +81,203 @@ test("works on arrays and primitives as the root document", () => {
   assert.equal(resolvePointer("hello", ""), "hello");
   assert.throws(() => resolvePointer("hello", "/0"));
 });
+
+// applyPatch: examples from RFC 6902, Appendix A.
+
+test("A.1 adding an object member", () => {
+  const result = applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]);
+  assert.deepEqual(result, { baz: "qux", foo: "bar" });
+});
+
+test("A.2 adding an array element", () => {
+  const result = applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]);
+  assert.deepEqual(result, { foo: ["bar", "qux", "baz"] });
+});
+
+test("A.3 removing an object member", () => {
+  const result = applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]);
+  assert.deepEqual(result, { foo: "bar" });
+});
+
+test("A.4 removing an array element", () => {
+  const result = applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]);
+  assert.deepEqual(result, { foo: ["bar", "baz"] });
+});
+
+test("A.5 replacing a value", () => {
+  const result = applyPatch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]);
+  assert.deepEqual(result, { baz: "boo", foo: "bar" });
+});
+
+test("A.6 moving a value", () => {
+  const document = { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } };
+  const result = applyPatch(document, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]);
+  assert.deepEqual(result, { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+});
+
+test("A.7 moving an array element", () => {
+  const result = applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [
+    { op: "move", from: "/foo/1", path: "/foo/3" },
+  ]);
+  assert.deepEqual(result, { foo: ["all", "cows", "eat", "grass"] });
+});
+
+test("A.8 testing a value: success", () => {
+  const document = { baz: "qux", foo: ["a", 2, "c"] };
+  const result = applyPatch(document, [
+    { op: "test", path: "/baz", value: "qux" },
+    { op: "test", path: "/foo/1", value: 2 },
+  ]);
+  assert.deepEqual(result, document);
+});
+
+test("A.9 testing a value: error", () => {
+  assert.throws(() => applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]));
+});
+
+test("A.10 adding a nested member object", () => {
+  const result = applyPatch({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]);
+  assert.deepEqual(result, { foo: "bar", child: { grandchild: {} } });
+});
+
+test("A.11 ignoring unrecognized elements", () => {
+  const result = applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }]);
+  assert.deepEqual(result, { baz: "qux", foo: "bar" });
+});
+
+test("A.12 adding to a nonexistent target", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]));
+});
+
+test("A.14 ~ escape ordering", () => {
+  const document = { "/": 9, "~1": 10 };
+  const result = applyPatch(document, [{ op: "test", path: "/~01", value: 10 }]);
+  assert.deepEqual(result, document);
+});
+
+test("A.15 comparing strings and numbers", () => {
+  assert.throws(() => applyPatch({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]));
+});
+
+test("A.16 adding an array value", () => {
+  const result = applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]);
+  assert.deepEqual(result, { foo: ["bar", ["abc", "def"]] });
+});
+
+// applyPatch: the copy operation (not in RFC 6902 Appendix A).
+
+test("copy duplicates a value at a new location", () => {
+  const result = applyPatch({ foo: { bar: 1 } }, [{ op: "copy", from: "/foo", path: "/baz" }]);
+  assert.deepEqual(result, { foo: { bar: 1 }, baz: { bar: 1 } });
+});
+
+test("copy does not alias the source and destination", () => {
+  const result = applyPatch({ foo: { bar: 1 } }, [
+    { op: "copy", from: "/foo", path: "/baz" },
+    { op: "replace", path: "/baz/bar", value: 2 },
+  ]) as { foo: { bar: number }; baz: { bar: number } };
+  assert.deepEqual(result.foo, { bar: 1 });
+  assert.deepEqual(result.baz, { bar: 2 });
+});
+
+test("copy appends into an array with '-'", () => {
+  const result = applyPatch({ foo: [1, 2] }, [{ op: "copy", from: "/foo/0", path: "/foo/-" }]);
+  assert.deepEqual(result, { foo: [1, 2, 1] });
+});
+
+// applyPatch: general behaviour.
+
+test("does not mutate the input document", () => {
+  const document = { foo: { bar: [1, 2, 3] } };
+  const snapshot = structuredClone(document);
+  applyPatch(document, [
+    { op: "add", path: "/baz", value: 1 },
+    { op: "replace", path: "/foo/bar/0", value: 99 },
+    { op: "remove", path: "/foo/bar/1" },
+  ]);
+  assert.deepEqual(document, snapshot);
+});
+
+test("does not mutate the input patch", () => {
+  const value = { nested: true };
+  const patch = [{ op: "add", path: "/foo", value }];
+  const result = applyPatch({}, patch) as { foo: { nested: boolean } };
+  result.foo.nested = false;
+  assert.equal(value.nested, true);
+});
+
+test("applies operations in sequence against the result of prior operations", () => {
+  const result = applyPatch({}, [
+    { op: "add", path: "/a", value: 1 },
+    { op: "add", path: "/b", value: 2 },
+    { op: "remove", path: "/a" },
+  ]);
+  assert.deepEqual(result, { b: 2 });
+});
+
+test("replacing the whole document", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "replace", path: "", value: { baz: "qux" } }]), {
+    baz: "qux",
+  });
+});
+
+test("adding the whole document", () => {
+  assert.equal(applyPatch({ foo: "bar" }, [{ op: "add", path: "", value: 42 }]), 42);
+});
+
+test("move rejects moving a location into one of its own children", () => {
+  assert.throws(() =>
+    applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]),
+  );
+});
+
+test("move allows moving a value to its own location", () => {
+  const result = applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a" }]);
+  assert.deepEqual(result, { a: { b: 1 } });
+});
+
+test("rejects a patch that is not an array", () => {
+  assert.throws(() => applyPatch({}, { op: "add", path: "/foo", value: 1 }));
+});
+
+test("rejects an operation with an unknown op name", () => {
+  assert.throws(() => applyPatch({}, [{ op: "frobnicate", path: "/foo", value: 1 }]));
+});
+
+test("rejects an operation missing its value member", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/foo" }]));
+});
+
+test("rejects move/copy operations missing their from member", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", path: "/b" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", path: "/b" }]));
+});
+
+test("rejects removing the root document", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]));
+});
+
+test("rejects an out-of-bounds array add", () => {
+  assert.throws(() => applyPatch({ foo: [1, 2] }, [{ op: "add", path: "/foo/3", value: 0 }]));
+});
+
+test("rejects replacing a nonexistent array index", () => {
+  assert.throws(() => applyPatch({ foo: [1, 2] }, [{ op: "replace", path: "/foo/2", value: 0 }]));
+});
+
+test("rejects removing a nonexistent object member", () => {
+  assert.throws(() => applyPatch({ foo: 1 }, [{ op: "remove", path: "/bar" }]));
+});
+
+test("add treats '__proto__' as a plain object key", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as Record<
+    string,
+    unknown
+  >;
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  assert.deepEqual(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(
+    Object.getOwnPropertyDescriptor(result, "__proto__"),
+    { value: { polluted: true }, writable: true, enumerable: true, configurable: true },
+  );
+});
