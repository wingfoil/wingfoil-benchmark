@@ -48,3 +50,274 @@ function step(current: unknown, token: string): unknown {
 
   throw new Error(`Cannot resolve JSON Pointer token "${token}" against a non-object, non-array value`);
 }
+
+function splitPointer(pointer: string): string[] {
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}"`);
+  }
+  return pointer.split("/").slice(1).map(decodeToken);
+}
+
+function walk(document: unknown, tokens: string[]): unknown {
+  let current = document;
+  for (const token of tokens) {
+    current = step(current, token);
+  }
+  return current;
+}
+
+/**
+ * JSON Patch (RFC 6902) operations, as parsed from a patch document.
+ */
+type Operation =
+  | { op: "add"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "replace"; path: string; value: unknown }
+  | { op: "move"; path: string; from: string }
+  | { op: "copy"; path: string; from: string }
+  | { op: "test"; path: string; value: unknown };
+
+const OPERATION_NAMES = ["add", "remove", "replace", "move", "copy", "test"] as const;
+
+function isOperationName(value: string): value is Operation["op"] {
+  return (OPERATION_NAMES as readonly string[]).includes(value);
+}
+
+function parseOperation(raw: unknown): Operation {
+  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+    throw new Error(`Invalid JSON Patch operation: ${JSON.stringify(raw)}`);
+  }
+  const candidate = raw as Record<string, unknown>;
+
+  const op = candidate.op;
+  if (typeof op !== "string" || !isOperationName(op)) {
+    throw new Error(`Invalid JSON Patch operation "op" member: ${JSON.stringify(op)}`);
+  }
+
+  const path = candidate.path;
+  if (typeof path !== "string") {
+    throw new Error(`JSON Patch "${op}" operation is missing a string "path" member`);
+  }
+
+  if (op === "move" || op === "copy") {
+    const from = candidate.from;
+    if (typeof from !== "string") {
+      throw new Error(`JSON Patch "${op}" operation is missing a string "from" member`);
+    }
+    return { op, path, from };
+  }
+
+  if (op === "add" || op === "replace" || op === "test") {
+    if (!("value" in candidate)) {
+      throw new Error(`JSON Patch "${op}" operation is missing a "value" member`);
+    }
+    return { op, path, value: candidate.value };
+  }
+
+  return { op, path };
+}
+
+function isProperPrefix(prefix: string[], tokens: string[]): boolean {
+  return prefix.length < tokens.length && prefix.every((token, i) => token === tokens[i]);
+}
+
+function setMember(container: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(container, key, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
+
+function isContainer(value: unknown): value is Record<string, unknown> | unknown[] {
+  return value !== null && typeof value === "object";
+}
+
+function addAt(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return value;
+  }
+
+  const container = walk(document, tokens.slice(0, -1));
+  const key = tokens[tokens.length - 1];
+
+  if (Array.isArray(container)) {
+    if (key === "-") {
+      container.push(value);
+      return document;
+    }
+    if (!ARRAY_INDEX_RE.test(key)) {
+      throw new Error(`Invalid array index in JSON Patch path: "${key}"`);
+    }
+    const index = Number(key);
+    if (index > container.length) {
+      throw new Error(`JSON Patch array index out of bounds: "${key}"`);
+    }
+    container.splice(index, 0, value);
+    return document;
+  }
+
+  if (isContainer(container)) {
+    setMember(container as Record<string, unknown>, key, value);
+    return document;
+  }
+
+  throw new Error(`Cannot add a member to a non-object, non-array value at "${tokens.slice(0, -1).join("/")}"`);
+}
+
+function removeAt(document: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) {
+    throw new Error("Cannot remove the root document");
+  }
+
+  const container = walk(document, tokens.slice(0, -1));
+  const key = tokens[tokens.length - 1];
+
+  if (Array.isArray(container)) {
+    if (!ARRAY_INDEX_RE.test(key)) {
+      throw new Error(`Invalid array index in JSON Patch path: "${key}"`);
+    }
+    const index = Number(key);
+    if (index >= container.length) {
+      throw new Error(`JSON Patch array index out of bounds: "${key}"`);
+    }
+    container.splice(index, 1);
+    return document;
+  }
+
+  if (isContainer(container) && !Array.isArray(container)) {
+    const obj = container as Record<string, unknown>;
+    if (!Object.prototype.hasOwnProperty.call(obj, key)) {
+      throw new Error(`JSON Patch "remove" references nonexistent object member: "${key}"`);
+    }
+    delete obj[key];
+    return document;
+  }
+
+  throw new Error(`Cannot remove a member from a non-object, non-array value at "${tokens.slice(0, -1).join("/")}"`);
+}
+
+function replaceAt(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return value;
+  }
+
+  const container = walk(document, tokens.slice(0, -1));
+  const key = tokens[tokens.length - 1];
+
+  if (Array.isArray(container)) {
+    if (!ARRAY_INDEX_RE.test(key)) {
+      throw new Error(`Invalid array index in JSON Patch path: "${key}"`);
+    }
+    const index = Number(key);
+    if (index >= container.length) {
+      throw new Error(`JSON Patch array index out of bounds: "${key}"`);
+    }
+    container[index] = value;
+    return document;
+  }
+
+  if (isContainer(container) && !Array.isArray(container)) {
+    const obj = container as Record<string, unknown>;
+    if (!Object.prototype.hasOwnProperty.call(obj, key)) {
+      throw new Error(`JSON Patch "replace" references nonexistent object member: "${key}"`);
+    }
+    setMember(obj, key, value);
+    return document;
+  }
+
+  throw new Error(`Cannot replace a member of a non-object, non-array value at "${tokens.slice(0, -1).join("/")}"`);
+}
+
+function moveTo(document: unknown, pathTokens: string[], fromTokens: string[]): unknown {
+  if (fromTokens.length === 0) {
+    throw new Error("Cannot move the root document");
+  }
+  if (isProperPrefix(fromTokens, pathTokens)) {
+    throw new Error('JSON Patch "move" operation "from" cannot be a proper prefix of "path"');
+  }
+
+  const value = walk(document, fromTokens);
+  const afterRemove = removeAt(document, fromTokens);
+  return addAt(afterRemove, pathTokens, value);
+}
+
+function copyTo(document: unknown, pathTokens: string[], fromTokens: string[]): unknown {
+  const value = structuredClone(walk(document, fromTokens));
+  return addAt(document, pathTokens, value);
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => deepEqual(v, b[i]))
+    );
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const aKeys = Object.keys(a);
+    const bKeys = Object.keys(b);
+    return (
+      aKeys.length === bKeys.length &&
+      aKeys.every(
+        (key) =>
+          Object.prototype.hasOwnProperty.call(b, key) &&
+          deepEqual((a as Record<string, unknown>)[key], (b as Record<string, unknown>)[key]),
+      )
+    );
+  }
+  return false;
+}
+
+function testAt(document: unknown, tokens: string[], expected: unknown): unknown {
+  const actual = walk(document, tokens);
+  if (!deepEqual(actual, expected)) {
+    throw new Error(`JSON Patch "test" operation failed at "/${tokens.join("/")}"`);
+  }
+  return document;
+}
+
+function applyOperation(document: unknown, rawOperation: unknown): unknown {
+  const operation = parseOperation(rawOperation);
+  const tokens = splitPointer(operation.path);
+
+  switch (operation.op) {
+    case "add":
+      return addAt(document, tokens, structuredClone(operation.value));
+    case "remove":
+      return removeAt(document, tokens);
+    case "replace":
+      return replaceAt(document, tokens, structuredClone(operation.value));
+    case "move":
+      return moveTo(document, tokens, splitPointer(operation.from));
+    case "copy":
+      return copyTo(document, tokens, splitPointer(operation.from));
+    case "test":
+      return testAt(document, tokens, operation.value);
+  }
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document, returning the result as
+ * a new value. The input document and patch are never mutated.
+ *
+ * @throws if `patch` is not a well-formed array of JSON Patch operations, or
+ *   if any operation fails to apply.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error("JSON Patch must be an array of operations");
+  }
+
+  let result = structuredClone(document);
+  for (const rawOperation of patch) {
+    result = applyOperation(result, rawOperation);
+  }
+  return result;
+}
