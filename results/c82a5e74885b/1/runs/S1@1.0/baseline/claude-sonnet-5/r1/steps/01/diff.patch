index 0000000000000000000000000000000000000000..a98ac2dd54298f426520fdce4ea05af6c92a5a4d
--- /dev/null
+++ b/src/index.test.ts
@@ -0,0 +1,83 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "./index.ts";
+
+// Example document from RFC 6901, section 5.
+const document = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  "k\"l": 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("empty string resolves to the whole document", () => {
+  assert.equal(resolvePointer(document, ""), document);
+});
+
+test("RFC 6901 section 5 examples", () => {
+  assert.deepEqual(resolvePointer(document, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(document, "/foo/0"), "bar");
+  assert.equal(resolvePointer(document, "/"), 0);
+  assert.equal(resolvePointer(document, "/a~1b"), 1);
+  assert.equal(resolvePointer(document, "/c%d"), 2);
+  assert.equal(resolvePointer(document, "/e^f"), 3);
+  assert.equal(resolvePointer(document, "/g|h"), 4);
+  assert.equal(resolvePointer(document, "/i\\j"), 5);
+  assert.equal(resolvePointer(document, "/k\"l"), 6);
+  assert.equal(resolvePointer(document, "/ "), 7);
+  assert.equal(resolvePointer(document, "/m~0n"), 8);
+});
+
+test("resolves nested structures", () => {
+  const doc = { a: { b: [{ c: 42 }] } };
+  assert.equal(resolvePointer(doc, "/a/b/0/c"), 42);
+});
+
+test("decodes ~1 before ~0 to avoid double-unescaping", () => {
+  assert.equal(resolvePointer({ "~1": "literal" }, "/~01"), "literal");
+});
+
+test("array index must not have leading zeros", () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, "/a/01"));
+});
+
+test("array index '-' does not resolve to a value", () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, "/a/-"));
+});
+
+test("non-numeric array token throws", () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, "/a/foo"));
+});
+
+test("out-of-bounds array index throws", () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, "/a/2"));
+});
+
+test("missing object member throws", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+});
+
+test("descending into a primitive throws", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+});
+
+test("pointer must start with a slash", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "a"));
+});
+
+test("invalid escape sequence throws", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/~"));
+  assert.throws(() => resolvePointer({ a: 1 }, "/~2"));
+});
+
+test("works on arrays and primitives as the root document", () => {
+  assert.equal(resolvePointer([1, 2, 3], "/1"), 2);
+  assert.equal(resolvePointer("hello", ""), "hello");
+  assert.throws(() => resolvePointer("hello", "/0"));
+});
