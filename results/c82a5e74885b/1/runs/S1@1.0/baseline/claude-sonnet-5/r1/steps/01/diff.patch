+++ b/src/index.ts
@@ -0,0 +1,50 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @throws if `pointer` is not a syntactically valid JSON Pointer, or if it
+ *   does not resolve to a value within `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}"`);
+  }
+
+  let current = document;
+  for (const rawToken of pointer.split("/").slice(1)) {
+    current = step(current, decodeToken(rawToken));
+  }
+  return current;
+}
+
+function decodeToken(rawToken: string): string {
+  if (/~(?![01])/.test(rawToken)) {
+    throw new Error(`Invalid JSON Pointer escape sequence in token: "${rawToken}"`);
+  }
+  return rawToken.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function step(current: unknown, token: string): unknown {
+  if (Array.isArray(current)) {
+    if (!/^(?:0|[1-9][0-9]*)$/.test(token)) {
+      throw new Error(`Invalid array index in JSON Pointer: "${token}"`);
+    }
+    const index = Number(token);
+    if (index >= current.length) {
+      throw new Error(`JSON Pointer array index out of bounds: "${token}"`);
+    }
+    return current[index];
+  }
+
+  if (current !== null && typeof current === "object") {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new Error(`JSON Pointer references nonexistent object member: "${token}"`);
+    }
+    return (current as Record<string, unknown>)[token];
+  }
+
+  throw new Error(`Cannot resolve JSON Pointer token "${token}" against a non-object, non-array value`);
+}
