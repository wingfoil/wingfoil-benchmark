diff --git a/src/json-pointer.ts b/src/json-pointer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2aa1647bf947a6a1ffdb5c2137626c800281e5a7
--- /dev/null
+++ b/src/json-pointer.ts
@@ -0,0 +1,123 @@
+/**
+ * JSON Pointer, as specified in RFC 6901 (https://www.rfc-editor.org/rfc/rfc6901).
+ *
+ * A JSON Pointer is a string that identifies one value inside a JSON document. It is a sequence of
+ * reference tokens, each prefixed by `/`; the empty string identifies the whole document.
+ */
+
+/** An object in a JSON document: string keys, JSON values. */
+export interface JsonObject {
+  [key: string]: JsonValue;
+}
+
+/** Any value a JSON document can hold, i.e. anything `JSON.parse` can return. */
+export type JsonValue = null | boolean | number | string | JsonValue[] | JsonObject;
+
+/** Why a JSON Pointer operation failed. */
+export type JsonPointerErrorCode =
+  /** The pointer is not a valid JSON Pointer: it is malformed, or not a string at all. */
+  | 'invalid-pointer'
+  /** The pointer is well-formed, but the document holds no value at it. */
+  | 'unresolved';
+
+/** Thrown when a JSON Pointer is malformed, or does not resolve against a document. */
+export class JsonPointerError extends Error {
+  /** Lets callers tell a malformed pointer apart from one the document does not answer. */
+  readonly code: JsonPointerErrorCode;
+
+  /**
+   * The pointer that failed, or `undefined` when the input was not a string. It is not simply the
+   * empty string in that case, because `''` is itself a valid pointer: the whole document.
+   */
+  readonly pointer: string | undefined;
+
+  constructor(code: JsonPointerErrorCode, pointer: string | undefined, reason: string) {
+    const subject = pointer === undefined ? 'JSON Pointer' : `JSON Pointer ${JSON.stringify(pointer)}`;
+    super(`${subject}: ${reason}`);
+    this.name = 'JsonPointerError';
+    this.code = code;
+    this.pointer = pointer;
+  }
+}
+
+/** A `~` that is not the start of one of the two escape sequences `~0` and `~1`. */
+const DANGLING_ESCAPE = /~(?![01])/;
+
+/** An array index as RFC 6901 section 4 defines it: `0`, or a digit string with no leading zero. */
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/**
+ * Splits a JSON Pointer into its unescaped reference tokens.
+ *
+ * Shared with the operations built on top of pointers, so that they all accept exactly the pointers
+ * RFC 6901 defines.
+ *
+ * @throws {JsonPointerError} with code `invalid-pointer` if `pointer` is not a valid JSON Pointer.
+ */
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== 'string') {
+    throw new JsonPointerError('invalid-pointer', undefined, `expected a string, got ${typeof pointer}`);
+  }
+  if (pointer !== '' && !pointer.startsWith('/')) {
+    throw new JsonPointerError('invalid-pointer', pointer, 'a non-empty pointer must start with "/"');
+  }
+  if (DANGLING_ESCAPE.test(pointer)) {
+    throw new JsonPointerError('invalid-pointer', pointer, '"~" must be followed by "0" or "1"');
+  }
+
+  // The leading "/" opens the first token rather than separating two, so the split drops one empty
+  // field at the front. The empty pointer has no token at all.
+  return pointer === '' ? [] : pointer.slice(1).split('/').map(unescapeToken);
+}
+
+/**
+ * Turns a reference token into the member name it denotes.
+ *
+ * `~1` becomes `/` before `~0` becomes `~`, as RFC 6901 section 4 requires: the reverse order would
+ * read the escaped form `~01` as `/` instead of the literal `~1`.
+ */
+function unescapeToken(token: string): string {
+  return token.replaceAll('~1', '/').replaceAll('~0', '~');
+}
+
+/**
+ * Returns the value that `pointer` refers to in `document`.
+ *
+ * @param document The JSON document to read, as returned by `JSON.parse`.
+ * @param pointer A JSON Pointer; the empty string refers to `document` itself.
+ * @throws {JsonPointerError} with code `invalid-pointer` if `pointer` is not a valid JSON Pointer,
+ *   or code `unresolved` if `document` holds no value at `pointer`.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  let value = document;
+
+  for (const token of parsePointer(pointer)) {
+    value = member(value, token, pointer);
+  }
+
+  return value;
+}
+
+/** Reads the member `token` of `node`, the single step a pointer's tokens are evaluated by. */
+function member(node: JsonValue, token: string, pointer: string): JsonValue {
+  const fail = (reason: string): never => {
+    throw new JsonPointerError('unresolved', pointer, `${JSON.stringify(token)} ${reason}`);
+  };
+
+  if (Array.isArray(node)) {
+    // "-" denotes the position just past the last element, which never holds a value. Any other
+    // non-index token — including "length" — names nothing in an array.
+    if (!ARRAY_INDEX.test(token)) {
+      return fail('is not an array index');
+    }
+    const index = Number(token);
+    return index < node.length ? node[index] : fail(`is out of range, the array has ${node.length} element(s)`);
+  }
+
+  if (node === null || typeof node !== 'object') {
+    return fail(`cannot be read from ${node === null ? 'null' : `a ${typeof node}`}`);
+  }
+
+  // Own properties only: a document must not expose `toString` or `__proto__` from the prototype.
+  return Object.prototype.hasOwnProperty.call(node, token) ? node[token] : fail('is not a member of the object');
+}
diff --git a/test/json-pointer.test.ts b/test/json-pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..638df69aec942597da52d81503f8312f5952d44a
--- /dev/null
+++ b/test/json-pointer.test.ts
@@ -0,0 +1,188 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { JsonPointerError, resolvePointer } from '../src/index.ts';
+import type { JsonValue } from '../src/index.ts';
+
+/**
+ * The example document of RFC 6901, section 5. Its keys exercise every character that the
+ * specification singles out, including the empty key and the two escape sequences.
+ */
+const rfcExample: JsonValue = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+test('resolves every pointer of the RFC 6901 example document', () => {
+  assert.deepEqual(resolvePointer(rfcExample, ''), rfcExample);
+  assert.deepEqual(resolvePointer(rfcExample, '/foo'), ['bar', 'baz']);
+  assert.equal(resolvePointer(rfcExample, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(rfcExample, '/foo/1'), 'baz');
+  assert.equal(resolvePointer(rfcExample, '/'), 0);
+  assert.equal(resolvePointer(rfcExample, '/a~1b'), 1);
+  assert.equal(resolvePointer(rfcExample, '/c%d'), 2);
+  assert.equal(resolvePointer(rfcExample, '/e^f'), 3);
+  assert.equal(resolvePointer(rfcExample, '/g|h'), 4);
+  assert.equal(resolvePointer(rfcExample, '/i\\j'), 5);
+  assert.equal(resolvePointer(rfcExample, '/k"l'), 6);
+  assert.equal(resolvePointer(rfcExample, '/ '), 7);
+  assert.equal(resolvePointer(rfcExample, '/m~0n'), 8);
+});
+
+test('unescapes ~1 before ~0, so ~01 denotes the key "~1"', () => {
+  assert.equal(resolvePointer({ '~1': 'tilde-one' }, '/~01'), 'tilde-one');
+  assert.equal(resolvePointer({ '~/': 'both' }, '/~0~1'), 'both');
+  assert.equal(resolvePointer({ '~0': 'tilde-zero' }, '/~00'), 'tilde-zero');
+});
+
+test('walks nested objects and arrays to any depth', () => {
+  const document: JsonValue = { a: { b: [{ c: ['deep'] }] } };
+
+  assert.equal(resolvePointer(document, '/a/b/0/c/0'), 'deep');
+  assert.deepEqual(resolvePointer(document, '/a/b/0'), { c: ['deep'] });
+});
+
+test('resolves the empty key, including repeatedly', () => {
+  assert.equal(resolvePointer({ '': { '': 'twice' } }, '//'), 'twice');
+});
+
+test('returns null, false and 0 rather than treating them as absent', () => {
+  const document: JsonValue = { nil: null, no: false, zero: 0, empty: '' };
+
+  assert.equal(resolvePointer(document, '/nil'), null);
+  assert.equal(resolvePointer(document, '/no'), false);
+  assert.equal(resolvePointer(document, '/zero'), 0);
+  assert.equal(resolvePointer(document, '/empty'), '');
+});
+
+test('resolves a whole-document pointer against any value, including a primitive', () => {
+  assert.equal(resolvePointer('just a string', ''), 'just a string');
+  assert.equal(resolvePointer(null, ''), null);
+  assert.deepEqual(resolvePointer([], ''), []);
+});
+
+test('rejects pointers that are not valid JSON Pointers', () => {
+  for (const pointer of ['foo', 'foo/bar', '0', '~', ' /foo', '/~', '/~2', '/~x', '/a~', '/~~0']) {
+    assert.throws(
+      () => resolvePointer(rfcExample, pointer),
+      (error: unknown) =>
+        error instanceof JsonPointerError && error.code === 'invalid-pointer',
+      `expected ${JSON.stringify(pointer)} to be rejected as a malformed pointer`,
+    );
+  }
+});
+
+test('treats a trailing slash as a final empty token, not as a malformed pointer', () => {
+  assert.equal(resolvePointer({ foo: { '': 'ok' } }, '/foo/'), 'ok');
+});
+
+test('rejects a pointer that is not a string', () => {
+  for (const pointer of [undefined, null, 42, ['/foo'], { pointer: '/foo' }]) {
+    assert.throws(
+      () => resolvePointer(rfcExample, pointer as unknown as string),
+      (error: unknown) =>
+        error instanceof JsonPointerError && error.code === 'invalid-pointer',
+      `expected ${String(pointer)} to be rejected as a non-string pointer`,
+    );
+  }
+});
+
+test('rejects a pointer that names an absent object member', () => {
+  assert.throws(
+    () => resolvePointer(rfcExample, '/bar'),
+    (error: unknown) => error instanceof JsonPointerError && error.code === 'unresolved',
+  );
+  assert.throws(() => resolvePointer({ a: {} }, '/a/b'), JsonPointerError);
+});
+
+test('does not resolve inherited properties', () => {
+  for (const pointer of ['/__proto__', '/constructor', '/toString', '/hasOwnProperty']) {
+    assert.throws(
+      () => resolvePointer({}, pointer),
+      (error: unknown) => error instanceof JsonPointerError && error.code === 'unresolved',
+      `expected ${pointer} not to reach the prototype chain`,
+    );
+  }
+});
+
+test('resolves an own member that shadows an inherited one', () => {
+  assert.equal(resolvePointer(JSON.parse('{"toString": "mine"}'), '/toString'), 'mine');
+});
+
+test('rejects array tokens that are not RFC 6901 array indices', () => {
+  for (const pointer of ['/foo/01', '/foo/+1', '/foo/-1', '/foo/1.0', '/foo/ 1', '/foo/1e0', '/foo/length', '/foo/']) {
+    assert.throws(
+      () => resolvePointer(rfcExample, pointer),
+      (error: unknown) => error instanceof JsonPointerError && error.code === 'unresolved',
+      `expected ${pointer} not to index the array`,
+    );
+  }
+});
+
+test('accepts "0" as an array index but not as a leading-zero prefix', () => {
+  assert.equal(resolvePointer({ foo: ['first'] }, '/foo/0'), 'first');
+  assert.throws(() => resolvePointer({ foo: ['first'] }, '/foo/00'), JsonPointerError);
+});
+
+test('rejects an array index that is out of range', () => {
+  assert.throws(
+    () => resolvePointer(rfcExample, '/foo/2'),
+    (error: unknown) => error instanceof JsonPointerError && error.code === 'unresolved',
+  );
+  assert.throws(() => resolvePointer({ foo: [] }, '/foo/0'), JsonPointerError);
+});
+
+test('applies the array index rules only to arrays, not to objects', () => {
+  // An object member may be named anything, including the tokens an array would refuse.
+  const document: JsonValue = { '0': 'zero', '01': 'leading zero', '-': 'dash', length: 'not a count' };
+
+  assert.equal(resolvePointer(document, '/0'), 'zero');
+  assert.equal(resolvePointer(document, '/01'), 'leading zero');
+  assert.equal(resolvePointer(document, '/-'), 'dash');
+  assert.equal(resolvePointer(document, '/length'), 'not a count');
+});
+
+test('rejects "-", the token for the member after the last array element', () => {
+  assert.throws(
+    () => resolvePointer(rfcExample, '/foo/-'),
+    (error: unknown) => error instanceof JsonPointerError && error.code === 'unresolved',
+  );
+});
+
+test('rejects descending into a primitive or null', () => {
+  for (const document of ['text', 42, true, null] as JsonValue[]) {
+    assert.throws(
+      () => resolvePointer(document, '/a'),
+      (error: unknown) => error instanceof JsonPointerError && error.code === 'unresolved',
+      `expected ${String(document)} to have no members`,
+    );
+  }
+  assert.throws(() => resolvePointer({ a: 'text' }, '/a/0'), JsonPointerError);
+});
+
+test('carries the offending pointer on the error', () => {
+  assert.throws(
+    () => resolvePointer({ a: {} }, '/a/b/c'),
+    (error: unknown) =>
+      error instanceof JsonPointerError &&
+      error.pointer === '/a/b/c' &&
+      error.message.includes('/a/b/c'),
+  );
+});
+
+test('leaves the document untouched', () => {
+  const document: JsonValue = { foo: ['bar'] };
+  const snapshot = JSON.stringify(document);
+
+  resolvePointer(document, '/foo/0');
+
+  assert.equal(JSON.stringify(document), snapshot);
+});
