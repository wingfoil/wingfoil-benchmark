index 0000000000000000000000000000000000000000..da09dec6d98876878b05719e33fb85b251e2dd45
--- /dev/null
+++ b/test/json-patch.test.ts
@@ -0,0 +1,472 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { applyPatch, JsonPatchError } from '../src/index.ts';
+import type { JsonPatch, JsonPatchErrorCode, JsonValue } from '../src/index.ts';
+
+/** Asserts that applying `patch` to `document` fails with `code`, at operation `index`. */
+function assertFails(
+  document: JsonValue,
+  patch: unknown,
+  code: JsonPatchErrorCode,
+  index: number | undefined,
+  message?: string,
+): void {
+  assert.throws(
