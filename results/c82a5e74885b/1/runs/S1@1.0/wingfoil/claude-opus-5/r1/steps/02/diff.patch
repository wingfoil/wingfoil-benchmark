+test('applies the examples of RFC 6902, appendix A', () => {
+  // A.1 — adding an object member.
+  assert.deepEqual(applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/baz', value: 'qux' }]), {
+    baz: 'qux',
+    foo: 'bar',
+  });
+
+  // A.2 — adding an array element.
+  assert.deepEqual(
+    applyPatch({ foo: ['bar', 'baz'] }, [{ op: 'add', path: '/foo/1', value: 'qux' }]),
+    { foo: ['bar', 'qux', 'baz'] },
+  );
+
+  // A.3 — removing an object member.
+  assert.deepEqual(applyPatch({ baz: 'qux', foo: 'bar' }, [{ op: 'remove', path: '/baz' }]), {
+    foo: 'bar',
+  });
+
+  // A.4 — removing an array element.
+  assert.deepEqual(applyPatch({ foo: ['bar', 'qux', 'baz'] }, [{ op: 'remove', path: '/foo/1' }]), {
+    foo: ['bar', 'baz'],
+  });
+
+  // A.5 — replacing a value.
+  assert.deepEqual(
+    applyPatch({ baz: 'qux', foo: 'bar' }, [{ op: 'replace', path: '/baz', value: 'boo' }]),
+    { baz: 'boo', foo: 'bar' },
+  );
+
+  // A.6 — moving a value.
+  assert.deepEqual(
+    applyPatch({ foo: { bar: 'baz', waldo: 'fred' }, qux: { corge: 'grault' } }, [
+      { op: 'move', from: '/foo/waldo', path: '/qux/thud' },
+    ]),
+    { foo: { bar: 'baz' }, qux: { corge: 'grault', thud: 'fred' } },
+  );
+
+  // A.7 — moving an array element.
+  assert.deepEqual(
+    applyPatch({ foo: ['all', 'grass', 'cows', 'eat'] }, [
+      { op: 'move', from: '/foo/1', path: '/foo/3' },
+    ]),
+    { foo: ['all', 'cows', 'eat', 'grass'] },
+  );
+
+  // A.8 — testing a value: success.
+  const a8: JsonValue = { baz: 'qux', foo: ['a', 2, 'c'] };
+  assert.deepEqual(
+    applyPatch(a8, [
+      { op: 'test', path: '/baz', value: 'qux' },
+      { op: 'test', path: '/foo/1', value: 2 },
+    ]),
+    a8,
+  );
+
+  // A.9 — testing a value: error.
+  assertFails({ baz: 'qux' }, [{ op: 'test', path: '/baz', value: 'bar' }], 'test-failed', 0);
+
+  // A.10 — adding a nested member object.
+  assert.deepEqual(
+    applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/child', value: { grandchild: {} } }]),
+    { foo: 'bar', child: { grandchild: {} } },
+  );
+
+  // A.11 — ignoring unrecognized elements.
+  assert.deepEqual(
+    applyPatch({ foo: 'bar' }, [
+      { op: 'add', path: '/baz', value: 'qux', xyz: 123 },
+    ] as unknown as JsonPatch),
+    { foo: 'bar', baz: 'qux' },
+  );
+
+  // A.12 — adding to a nonexistent target.
+  assertFails({ foo: 'bar' }, [{ op: 'add', path: '/baz/bat', value: 'qux' }], 'unresolved', 0);
+
+  // A.14 — the "~" escape ordering.
+  assert.deepEqual(
+    applyPatch({ '/': 9, '~1': 10 }, [{ op: 'test', path: '/~01', value: 10 }]),
+    { '/': 9, '~1': 10 },
+  );
+
+  // A.15 — comparing strings and numbers.
+  assertFails({ '/': 9, '~1': 10 }, [{ op: 'test', path: '/~01', value: '10' }], 'test-failed', 0);
+
+  // A.16 — adding an array value.
+  assert.deepEqual(
+    applyPatch({ foo: ['bar'] }, [{ op: 'add', path: '/foo/-', value: ['abc', 'def'] }]),
+    { foo: ['bar', ['abc', 'def']] },
+  );
+});
