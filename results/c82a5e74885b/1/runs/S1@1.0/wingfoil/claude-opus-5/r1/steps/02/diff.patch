+++ b/src/json-patch.ts
@@ -0,0 +1,464 @@
+/**
+ * JSON Patch, as specified in RFC 6902 (https://www.rfc-editor.org/rfc/rfc6902).
+ *
+ * A patch is a sequence of operations — `add`, `remove`, `replace`, `move`, `copy` and `test` — each
+ * naming what it acts on with a JSON Pointer (RFC 6901). They are applied in order, and the patch
+ * either applies whole or not at all: an operation that fails leaves the document as it was.
+ */
+
+import { arrayIndex, JsonPointerError, parsePointer, resolveTokens } from './json-pointer.ts';
+import { cloneJson, equalJson, setMember } from './json-value.ts';
+import type { JsonObject, JsonValue } from './json-value.ts';
+
+/** Adds `value` at `path`: a member of an object, or an element inserted into an array. */
+export interface AddOperation {
+  readonly op: 'add';
+  readonly path: string;
+  readonly value: JsonValue;
+}
+
+/** Removes the value at `path`, which must exist. */
+export interface RemoveOperation {
+  readonly op: 'remove';
+  readonly path: string;
+}
+
+/** Replaces the value at `path`, which must exist, with `value`. */
+export interface ReplaceOperation {
+  readonly op: 'replace';
+  readonly path: string;
+  readonly value: JsonValue;
+}
+
+/** Moves the value at `from`, which must exist, to `path`. */
+export interface MoveOperation {
+  readonly op: 'move';
+  readonly from: string;
+  readonly path: string;
+}
+
+/** Copies the value at `from`, which must exist, to `path`, leaving `from` in place. */
+export interface CopyOperation {
+  readonly op: 'copy';
+  readonly from: string;
+  readonly path: string;
+}
+
+/** Tests that the value at `path`, which must exist, equals `value`; changes nothing. */
+export interface TestOperation {
+  readonly op: 'test';
+  readonly path: string;
+  readonly value: JsonValue;
+}
+
+/** One operation of a JSON Patch. */
+export type JsonPatchOperation =
+  | AddOperation
+  | RemoveOperation
+  | ReplaceOperation
+  | MoveOperation
+  | CopyOperation
+  | TestOperation;
+
+/** A JSON Patch: the operations to apply to a document, in order. */
+export type JsonPatch = readonly JsonPatchOperation[];
+
+/** Why applying a JSON Patch failed. */
+export type JsonPatchErrorCode =
+  /** The patch is not a valid JSON Patch: it is not an array of well-formed operations. */
+  | 'invalid-patch'
+  /** The patch is well-formed, but the document holds no value where an operation needs one. */
+  | 'unresolved'
+  /** A `test` operation found a value other than the one it was given. */
+  | 'test-failed';
+
+/** Thrown when a JSON Patch is malformed, or when one of its operations fails. */
+export class JsonPatchError extends Error {
+  /**
+   * Lets callers tell a defective patch from a document that does not answer it, and both from a
+   * `test` that simply said no. `'unresolved'` carries the same meaning as on `JsonPointerError`.
+   */
+  readonly code: JsonPatchErrorCode;
+
+  /**
+   * The position in the patch of the operation that failed, or `undefined` when the patch as a
+   * whole was rejected and no operation was ever reached.
+   */
+  readonly index: number | undefined;
+
+  constructor(
+    code: JsonPatchErrorCode,
+    index: number | undefined,
+    reason: string,
+    options?: ErrorOptions,
+  ) {
+    const subject = index === undefined ? 'JSON Patch' : `JSON Patch operation ${index}`;
+    super(`${subject}: ${reason}`, options);
+    this.name = 'JsonPatchError';
+    this.code = code;
+    this.index = index;
+  }
+}
+
+/**
+ * Applies `patch` to `document` and returns the result as a new value.
+ *
+ * Neither argument is modified. The operations are applied in order to a copy of `document`; if any
+ * of them fails, the whole patch fails and nothing is kept, as RFC 6902 section 5 requires.
+ *
+ * @param document The JSON document to patch, as returned by `JSON.parse`.
+ * @param patch The operations to apply; an empty patch returns a copy of `document`.
+ * @throws {JsonPatchError} with code `invalid-patch` if `patch` is not a valid JSON Patch, code
+ *   `unresolved` if an operation names a location the document does not hold, or code `test-failed`
+ *   if a `test` operation finds a different value.
+ */
+export function applyPatch(document: JsonValue, patch: JsonPatch): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new JsonPatchError(
+      'invalid-patch',
+      undefined,
+      `expected an array of operations, got ${describe(patch)}`,
+    );
+  }
+
+  // The operations then work in place on this copy: the inputs are never written to, the result
+  // shares nothing with them, and a failure part-way through discards the half-patched copy.
+  let result = cloneJson(document);
+  for (const [index, operation] of patch.entries()) {
+    result = applyOperation(result, operation, index);
+  }
+
+  return result;
+}
+
+/** The name of one of the six operations, i.e. a valid `op` member. */
+type OperationName = JsonPatchOperation['op'];
+
+/** The six operations RFC 6902 section 4 defines, in the order it defines them. */
+const OPERATIONS: readonly OperationName[] = ['add', 'remove', 'replace', 'move', 'copy', 'test'];
+
+/** The members of an operation, as they arrive: a patch is often parsed from an API payload. */
+type OperationMembers = Readonly<Record<string, unknown>>;
+
+/** Builds the error of the operation at hand, which knows its own name and position. */
+type Fail = (code: JsonPatchErrorCode, reason: string, cause?: unknown) => JsonPatchError;
+
+/** A target of an operation: the pointer as the patch wrote it, and its reference tokens. */
+interface Location {
+  readonly pointer: string;
+  readonly tokens: readonly string[];
+}
+
+/**
+ * Applies one operation and returns the resulting document, which is `document` itself unless the
+ * operation replaced it as a whole.
+ */
+function applyOperation(document: JsonValue, operation: unknown, index: number): JsonValue {
+  if (operation === null || typeof operation !== 'object' || Array.isArray(operation)) {
+    throw new JsonPatchError(
+      'invalid-patch',
+      index,
+      `expected an operation object, got ${describe(operation)}`,
+    );
+  }
+
+  const members: OperationMembers = operation as OperationMembers;
+  const op = members['op'];
+  if (!isOperationName(op)) {
+    throw new JsonPatchError(
+      'invalid-patch',
+      index,
+      `"op" must be one of ${OPERATIONS.map((name) => `"${name}"`).join(', ')}, got ${describe(op)}`,
+    );
+  }
+
+  const fail: Fail = (code, reason, cause) =>
+    new JsonPatchError(code, index, `"${op}" ${reason}`, cause === undefined ? undefined : { cause });
+  const path = readLocation(members, 'path', fail);
+
+  // Each operation reads only the members RFC 6902 section 4 defines for it; every other member of
+  // the operation object is ignored, as section 4 requires.
+  switch (op) {
+    case 'add':
+      return add(document, path, cloneJson(readValue(members, fail)), fail);
+    case 'remove':
+      return remove(document, path, fail);
+    case 'replace':
+      return replace(document, path, cloneJson(readValue(members, fail)), fail);
+    case 'move':
+      return move(document, readLocation(members, 'from', fail), path, fail);
+    case 'copy':
+      return copy(document, readLocation(members, 'from', fail), path, fail);
+    case 'test':
+      return test(document, path, readValue(members, fail), fail);
+  }
+}
+
+/**
+ * Adds `value` at `path` (RFC 6902 section 4.1).
+ *
+ * The parent of the target must exist; the target itself need not. An object member is created, or
+ * replaced if it is already there; an array element is inserted, shifting the elements after it.
+ */
+function add(document: JsonValue, path: Location, value: JsonValue, fail: Fail): JsonValue {
+  if (path.tokens.length === 0) {
+    return value;
+  }
+
+  const parent = parentOf(document, path, fail);
+  const token = lastToken(path);
+
+  if (Array.isArray(parent)) {
+    // "-" is the position just past the last element: there, adding means appending.
+    const index = token === '-' ? parent.length : arrayIndex(token);
+    if (index === undefined || index > parent.length) {
+      throw fail(
+        'unresolved',
+        `${quote(path.pointer)}: ${quote(token)} is not a position in an array of ${parent.length} element(s)`,
+      );
+    }
+    parent.splice(index, 0, value);
+  } else {
+    setMember(parent, token, value);
+  }
+
+  return document;
+}
+
+/** Removes the value at `path`, which must exist (RFC 6902 section 4.2). */
+function remove(document: JsonValue, path: Location, fail: Fail): JsonValue {
+  if (path.tokens.length === 0) {
+    throw fail('invalid-patch', 'cannot remove the whole document; replace it instead');
+  }
+
+  const parent = parentOf(document, path, fail);
+
+  if (Array.isArray(parent)) {
+    parent.splice(existingIndex(parent, path, fail), 1);
+  } else {
+    requireMember(parent, path, fail);
+    delete parent[lastToken(path)];
+  }
+
+  return document;
+}
+
+/** Replaces the value at `path`, which must exist, with `value` (RFC 6902 section 4.3). */
+function replace(document: JsonValue, path: Location, value: JsonValue, fail: Fail): JsonValue {
+  if (path.tokens.length === 0) {
+    return value;
+  }
+
+  const parent = parentOf(document, path, fail);
+
+  if (Array.isArray(parent)) {
+    parent[existingIndex(parent, path, fail)] = value;
+  } else {
+    requireMember(parent, path, fail);
+    setMember(parent, lastToken(path), value);
+  }
+
+  return document;
+}
+
+/**
+ * Moves the value at `from` to `path` (RFC 6902 section 4.4).
+ *
+ * A removal followed by an addition, in that order: an array index in `path` therefore counts
+ * positions in the array the removal leaves behind.
+ */
+function move(document: JsonValue, from: Location, path: Location, fail: Fail): JsonValue {
+  if (from.tokens.length === 0) {
+    throw fail('invalid-patch', 'cannot move the whole document; "from" must name a value in it');
+  }
+  if (isProperPrefix(from.tokens, path.tokens)) {
+    throw fail(
+      'invalid-patch',
+      `cannot move ${quote(from.pointer)} into ${quote(path.pointer)}, which it contains`,
+    );
+  }
+
+  // Read before removing: afterwards the value is no longer in the document, but still intact.
+  const value = valueAt(document, from, fail);
+  return add(remove(document, from, fail), path, value, fail);
+}
+
+/** Copies the value at `from` to `path`, leaving `from` in place (RFC 6902 section 4.5). */
+function copy(document: JsonValue, from: Location, path: Location, fail: Fail): JsonValue {
+  // A copy, not a second reference: writing through one of the two locations must not reach the
+  // other, neither in a later operation nor in the document this returns.
+  const value = cloneJson(valueAt(document, from, fail));
+  return add(document, path, value, fail);
+}
+
+/** Tests that the value at `path` equals `value`, and changes nothing (RFC 6902 section 4.6). */
+function test(document: JsonValue, path: Location, value: JsonValue, fail: Fail): JsonValue {
+  const found = valueAt(document, path, fail);
+
+  if (!equalJson(found, value)) {
+    throw fail(
+      'test-failed',
+      `${quote(path.pointer)}: expected ${preview(value)}, found ${preview(found)}`,
+    );
+  }
+
+  return document;
+}
+
+/** Resolves `location`, for the operations that read a value the document must already hold. */
+function valueAt(document: JsonValue, location: Location, fail: Fail): JsonValue {
+  try {
+    return resolveTokens(document, location.tokens, location.pointer);
+  } catch (error) {
+    throw fail('unresolved', `${quote(location.pointer)}: ${reasonOf(error)}`, error);
+  }
+}
+
+/**
+ * Resolves the array or object that holds `location`'s target, for the operations that write to it.
+ *
+ * The target itself is left to the caller: `add` may create it, while the others require it.
+ */
+function parentOf(document: JsonValue, location: Location, fail: Fail): JsonValue[] | JsonObject {
+  const parent = valueAt(document, parentLocation(location), fail);
+
+  if (parent === null || typeof parent !== 'object') {
+    throw fail(
+      'unresolved',
+      `${quote(location.pointer)}: its parent is ${describe(parent)}, which holds no members`,
+    );
+  }
+
+  return parent;
+}
+
+/**
+ * The location of the parent of `location`'s target: all of its tokens but the last.
+ *
+ * It keeps the whole pointer, so that a failure along the way is reported against the target the
+ * operation named rather than against a prefix the patch never wrote.
+ */
+function parentLocation(location: Location): Location {
+  return { pointer: location.pointer, tokens: location.tokens.slice(0, -1) };
+}
+
+/** The token naming the target within its parent; only called when the location has one. */
+function lastToken(location: Location): string {
+  return location.tokens[location.tokens.length - 1];
+}
+
+/** Reads `location`'s last token as the index of an element the array holds. */
+function existingIndex(array: readonly JsonValue[], location: Location, fail: Fail): number {
+  const token = lastToken(location);
+  const index = arrayIndex(token);
+
+  if (index === undefined || index >= array.length) {
+    throw fail(
+      'unresolved',
+      `${quote(location.pointer)}: ${quote(token)} is not an index of an array of ${array.length} element(s)`,
+    );
+  }
+
+  return index;
+}
+
+/** Requires that the object hold `location`'s last token as an own member. */
+function requireMember(object: JsonObject, location: Location, fail: Fail): void {
+  const token = lastToken(location);
+
+  if (!Object.hasOwn(object, token)) {
+    throw fail(
+      'unresolved',
+      `${quote(location.pointer)}: ${quote(token)} is not a member of the object`,
+    );
+  }
+}
+
+/** Reports whether `prefix` names an ancestor of `tokens`, rather than the same location or none. */
+function isProperPrefix(prefix: readonly string[], tokens: readonly string[]): boolean {
+  return prefix.length < tokens.length && prefix.every((token, index) => token === tokens[index]);
+}
+
+/** Narrows the `op` member of an operation to one of the six names RFC 6902 defines. */
+function isOperationName(op: unknown): op is OperationName {
+  return typeof op === 'string' && (OPERATIONS as readonly string[]).includes(op);
+}
+
+/** Reads the pointer in the member `name`, and splits it into its reference tokens. */
+function readLocation(members: OperationMembers, name: 'path' | 'from', fail: Fail): Location {
+  const pointer = members[name];
+
+  if (typeof pointer !== 'string') {
+    throw fail('invalid-patch', `"${name}" must be a JSON Pointer, got ${describe(pointer)}`);
+  }
+
+  try {
+    return { pointer, tokens: parsePointer(pointer) };
+  } catch (error) {
+    throw fail(
+      'invalid-patch',
+      `"${name}" ${quote(pointer)} is not a valid JSON Pointer: ${reasonOf(error)}`,
+      error,
+    );
+  }
+}
+
+/**
+ * Reads the `value` member, which `add`, `replace` and `test` all require.
+ *
+ * `undefined` is rejected along with an absent member: JSON has no such value, so a patch that
+ * carries one was built by mistake, and silently reading it as "absent" would hide that.
+ */
+function readValue(members: OperationMembers, fail: Fail): JsonValue {
+  const value = members['value'];
+
+  if (value === undefined) {
+    throw fail('invalid-patch', 'requires a "value", and it must be a JSON value');
+  }
+
+  return value as JsonValue;
+}
+
+/** The reason a JSON Pointer failed, to be quoted in the message of the operation that used it. */
+function reasonOf(error: unknown): string {
+  return error instanceof JsonPointerError ? error.reason : String(error);
+}
+
+/** Renders a string for an error message, so that an empty or padded one is still visible. */
+function quote(text: string): string {
+  return JSON.stringify(text);
+}
+
+/** Names the kind of an unexpected value, for an error message. */
+function describe(value: unknown): string {
+  if (value === undefined) {
+    return 'nothing';
+  }
+  if (value === null) {
+    return 'null';
+  }
+  if (Array.isArray(value)) {
+    return 'an array';
+  }
+
+  switch (typeof value) {
+    case 'string':
+      return quote(value);
+    case 'number':
+    case 'boolean':
+      return String(value);
+    case 'object':
+      return 'an object';
+    default:
+      return `a ${typeof value}`;
+  }
+}
+
+/** How much of a JSON value an error message shows before cutting it short. */
+const PREVIEW_LENGTH = 80;
+
+/** Renders a JSON value for an error message, keeping the message a readable length. */
+function preview(value: JsonValue): string {
+  const text = JSON.stringify(value);
+  return text.length <= PREVIEW_LENGTH ? text : `${text.slice(0, PREVIEW_LENGTH)}…`;
+}
