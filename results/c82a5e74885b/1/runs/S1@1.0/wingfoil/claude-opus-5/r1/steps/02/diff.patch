diff --git a/src/json-value.ts b/src/json-value.ts
new file mode 100644
index 0000000000000000000000000000000000000000..977b111d843d9fb28b7fd294fb8a31fb2737d25c
--- /dev/null
+++ b/src/json-value.ts
@@ -0,0 +1,73 @@
+/**
+ * The JSON data model: the values a document can hold, and the three operations on them that the
+ * standards built on top of it share — defining a member, copying a value, and comparing two.
+ *
+ * This module knows nothing of pointers or patches; it is the layer they both stand on.
+ */
+
+/** An object in a JSON document: string keys, JSON values. */
+export interface JsonObject {
+  [key: string]: JsonValue;
+}
+
+/** Any value a JSON document can hold, i.e. anything `JSON.parse` can return. */
+export type JsonValue = null | boolean | number | string | JsonValue[] | JsonObject;
+
+/**
+ * Adds or replaces the member `key` of `object`.
+ *
+ * Defines the property instead of assigning it: a plain assignment to `__proto__` would run the
+ * inherited setter and change the object's prototype rather than store a member, and a JSON
+ * document may legitimately hold a member of that name.
+ */
+export function setMember(object: JsonObject, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/**
+ * Returns a deep copy of `value`, sharing no object or array with it.
+ *
+ * Copies own members only, for the same reason resolution reads only own members: a document is
+ * data, and must not carry anything from a prototype into its copy.
+ */
+export function cloneJson(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(cloneJson);
+  }
+  if (value === null || typeof value !== 'object') {
+    return value;
+  }
+
+  const copy: JsonObject = {};
+  for (const key of Object.keys(value)) {
+    setMember(copy, key, cloneJson(value[key]));
+  }
+  return copy;
+}
+
+/**
+ * Reports whether two JSON values are equal, as RFC 6902 section 4.6 defines equality: strings,
+ * numbers and the literals are compared by value; arrays must have the same elements in the same
+ * order; objects must have the same members, in any order.
+ */
+export function equalJson(one: JsonValue, other: JsonValue): boolean {
+  if (Array.isArray(one) || Array.isArray(other)) {
+    return (
+      Array.isArray(one) &&
+      Array.isArray(other) &&
+      one.length === other.length &&
+      one.every((element, index) => equalJson(element, other[index]))
+    );
+  }
+
+  if (one === null || other === null || typeof one !== 'object' || typeof other !== 'object') {
+    return one === other;
+  }
+
+  // Two objects are equal when neither holds a member the other lacks, and their members match.
+  const keys = Object.keys(one);
+  return (
+    keys.length === Object.keys(other).length &&
+    keys.every((key) => Object.hasOwn(other, key) && equalJson(one[key], other[key]))
+  );
+}
