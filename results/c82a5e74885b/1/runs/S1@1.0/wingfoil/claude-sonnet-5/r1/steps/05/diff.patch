+/**
+ * Computes the JSON Patch (RFC 6902) that turns `from` into `to` when
+ * applied. Neither input is mutated.
+ *
+ * The patch only describes the parts of the document that actually changed:
+ * unchanged members and array elements are left out, and a nested change
+ * produces an operation scoped to that nested location rather than
+ * replacing an enclosing object or array wholesale.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const operations: JsonPatchOperation[] = [];
+  diffValues(from, to, "", operations);
+  return operations;
+}
+
+function diffValues(from: unknown, to: unknown, pointer: string, operations: JsonPatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (isJsonObject(from) && isJsonObject(to)) {
+    diffObjects(from, to, pointer, operations);
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, pointer, operations);
+    return;
+  }
+  operations.push({ op: "replace", path: pointer, value: to });
+}
+
+function diffObjects(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  pointer: string,
+  operations: JsonPatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.prototype.hasOwnProperty.call(to, key)) {
+      operations.push({ op: "remove", path: `${pointer}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const path = `${pointer}/${escapeToken(key)}`;
+    if (!Object.prototype.hasOwnProperty.call(from, key)) {
+      operations.push({ op: "add", path, value: to[key] });
+    } else {
+      diffValues(from[key], to[key], path, operations);
+    }
+  }
+}
+
+// Diffs two arrays by their longest common subsequence (by deep equality),
+// so that an insertion or removal in the middle produces one `add`/`remove`
+// rather than a `replace` of every element shifted around it.
+function diffArrays(from: unknown[], to: unknown[], pointer: string, operations: JsonPatchOperation[]): void {
+  const n = from.length;
+  const m = to.length;
+  const lcsLength: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcsLength[i][j] = deepEqual(from[i], to[j])
+        ? lcsLength[i + 1][j + 1] + 1
+        : Math.max(lcsLength[i + 1][j], lcsLength[i][j + 1]);
+    }
+  }
+
+  let i = 0;
+  let j = 0;
+  let index = 0;
+  while (i < n || j < m) {
+    if (i < n && j < m && deepEqual(from[i], to[j])) {
+      i++;
+      j++;
+      index++;
+    } else if (j < m && (i === n || lcsLength[i][j + 1] >= lcsLength[i + 1][j])) {
+      operations.push({ op: "add", path: `${pointer}/${index}`, value: to[j] });
+      j++;
+      index++;
+    } else {
+      operations.push({ op: "remove", path: `${pointer}/${index}` });
+      i++;
+    }
+  }
+}
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
