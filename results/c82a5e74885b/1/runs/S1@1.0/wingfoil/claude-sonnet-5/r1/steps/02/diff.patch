--- a/src/index.ts
+++ b/src/index.ts
@@ -83,3 +83,264 @@ function parseArrayIndex(token: string): number | null {
 function isJsonObject(value: unknown): value is Record<string, unknown> {
   return typeof value === "object" && value !== null && !Array.isArray(value);
 }
+
+/**
+ * A single operation of a JSON Patch (RFC 6902).
+ */
+export type JsonPatchOperation =
+  | { op: "add"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "replace"; path: string; value: unknown }
+  | { op: "move"; path: string; from: string }
+  | { op: "copy"; path: string; from: string }
+  | { op: "test"; path: string; value: unknown };
+
+/**
+ * Raised when a JSON Patch is not syntactically valid, or when one of its
+ * operations fails to apply to the document.
+ */
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the
+ * resulting document as a new value. The input `document` is never mutated.
+ *
+ * @throws {JsonPatchError} if `patch` is not a valid JSON Patch, or if one of
+ * its operations fails to apply.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  const operations = parsePatch(patch);
+  return operations.reduce(applyOperation, document);
+}
+
+const PATCH_OPS = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+
+function parsePatch(patch: unknown): JsonPatchOperation[] {
+  if (!Array.isArray(patch)) {
+    throw new JsonPatchError("Invalid JSON Patch: must be an array of operations");
+  }
+  return patch.map(parseOperation);
+}
+
+function parseOperation(raw: unknown, index: number): JsonPatchOperation {
+  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+    throw new JsonPatchError(`Invalid JSON Patch operation at index ${index}: must be an object`);
+  }
+
+  const { op, path } = raw as Record<string, unknown>;
+  if (typeof op !== "string" || !PATCH_OPS.has(op)) {
+    throw new JsonPatchError(
+      `Invalid JSON Patch operation at index ${index}: unknown "op" ${JSON.stringify(op)}`,
+    );
+  }
+  if (typeof path !== "string") {
+    throw new JsonPatchError(`Invalid JSON Patch operation at index ${index}: "path" must be a string`);
+  }
+
+  if (op === "move" || op === "copy") {
+    const from = (raw as Record<string, unknown>).from;
+    if (typeof from !== "string") {
+      throw new JsonPatchError(
+        `Invalid JSON Patch operation at index ${index}: "${op}" requires a string "from"`,
+      );
+    }
+    return { op, path, from };
+  }
+
+  if (op === "add" || op === "replace" || op === "test") {
+    if (!Object.prototype.hasOwnProperty.call(raw, "value")) {
+      throw new JsonPatchError(`Invalid JSON Patch operation at index ${index}: "${op}" requires a "value"`);
+    }
+    return { op, path, value: (raw as Record<string, unknown>).value };
+  }
+
+  return { op: "remove", path };
+}
+
+function applyOperation(document: unknown, operation: JsonPatchOperation): unknown {
+  switch (operation.op) {
+    case "add":
+      return addAt(document, operation.path, operation.value);
+    case "remove":
+      return removeAt(document, operation.path);
+    case "replace":
+      return replaceAt(document, operation.path, operation.value);
+    case "test": {
+      const actual = getAt(document, operation.path);
+      if (!deepEqual(actual, operation.value)) {
+        throw new JsonPatchError(`JSON Patch "test" failed: "${operation.path}" does not match the given value`);
+      }
+      return document;
+    }
+    case "move": {
+      assertNotProperPrefix(operation.from, operation.path);
+      const value = getAt(document, operation.from);
+      const withoutSource = removeAt(document, operation.from);
+      return addAt(withoutSource, operation.path, value);
+    }
+    case "copy": {
+      const value = getAt(document, operation.from);
+      return addAt(document, operation.path, value);
+    }
+  }
+}
+
+function getAt(document: unknown, pointer: string): unknown {
+  try {
+    return resolvePointer(document, pointer);
+  } catch (error) {
+    throw toPatchError(error, pointer);
+  }
+}
+
+function toPatchError(error: unknown, pointer: string): JsonPatchError {
+  const message = error instanceof Error ? error.message : String(error);
+  return new JsonPatchError(`JSON Patch operation failed at "${pointer}": ${message}`);
+}
+
+function parsePatchTokens(pointer: string): string[] {
+  try {
+    return parsePointer(pointer);
+  } catch (error) {
+    throw toPatchError(error, pointer);
+  }
+}
+
+function assertNotProperPrefix(from: string, path: string): void {
+  const fromTokens = parsePatchTokens(from);
+  const pathTokens = parsePatchTokens(path);
+  const isProperPrefix =
+    fromTokens.length < pathTokens.length && fromTokens.every((token, i) => token === pathTokens[i]);
+  if (isProperPrefix) {
+    throw new JsonPatchError(
+      `JSON Patch "move" cannot move "${from}" into one of its own children ("${path}")`,
+    );
+  }
+}
+
+type PatchWriteMode = "add" | "replace" | "remove";
+
+function addAt(document: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePatchTokens(pointer);
+  return tokens.length === 0 ? value : writeAt(document, tokens, 0, "add", value, pointer);
+}
+
+function replaceAt(document: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePatchTokens(pointer);
+  return tokens.length === 0 ? value : writeAt(document, tokens, 0, "replace", value, pointer);
+}
+
+function removeAt(document: unknown, pointer: string): unknown {
+  const tokens = parsePatchTokens(pointer);
+  if (tokens.length === 0) {
+    throw new JsonPatchError(`JSON Patch "remove" cannot target the whole document ("${pointer}")`);
+  }
+  return writeAt(document, tokens, 0, "remove", undefined, pointer);
+}
+
+function writeAt(
+  current: unknown,
+  tokens: string[],
+  index: number,
+  mode: PatchWriteMode,
+  value: unknown,
+  pointer: string,
+): unknown {
+  const token = tokens[index];
+  const isLast = index === tokens.length - 1;
+
+  if (Array.isArray(current)) {
+    const idx = resolveArrayIndex(current, token, isLast && mode === "add", pointer);
+    if (!isLast) {
+      return replaceArrayElement(current, idx, writeAt(current[idx], tokens, index + 1, mode, value, pointer));
+    }
+    if (mode === "add") {
+      return [...current.slice(0, idx), value, ...current.slice(idx)];
+    }
+    if (mode === "replace") {
+      return replaceArrayElement(current, idx, value);
+    }
+    return [...current.slice(0, idx), ...current.slice(idx + 1)];
+  }
+
+  if (isJsonObject(current)) {
+    if (!isLast) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new JsonPatchError(`JSON Patch operation failed at "${pointer}": no member named "${token}"`);
+      }
+      return { ...current, [token]: writeAt(current[token], tokens, index + 1, mode, value, pointer) };
+    }
+    if (mode === "remove") {
+      return omitMember(current, requireMember(current, token, pointer));
+    }
+    if (mode === "replace") {
+      requireMember(current, token, pointer);
+    }
+    return { ...current, [token]: value };
+  }
+
+  throw new JsonPatchError(
+    `JSON Patch operation failed at "${pointer}": cannot descend into ${current === null ? "null" : typeof current}`,
+  );
+}
+
+function requireMember(object: Record<string, unknown>, token: string, pointer: string): string {
+  if (!Object.prototype.hasOwnProperty.call(object, token)) {
+    throw new JsonPatchError(`JSON Patch operation failed at "${pointer}": no member named "${token}"`);
+  }
+  return token;
+}
+
+function omitMember(object: Record<string, unknown>, token: string): Record<string, unknown> {
+  const rest: Record<string, unknown> = {};
+  for (const key of Object.keys(object)) {
+    if (key !== token) {
+      rest[key] = object[key];
+    }
+  }
+  return rest;
+}
+
+function resolveArrayIndex(array: unknown[], token: string, allowAppend: boolean, pointer: string): number {
+  if (allowAppend && token === "-") {
+    return array.length;
+  }
+  const idx = parseArrayIndex(token);
+  if (idx === null) {
+    throw new JsonPatchError(`JSON Patch operation failed at "${pointer}": "${token}" is not a valid array index`);
+  }
+  const max = allowAppend ? array.length : array.length - 1;
+  if (idx > max) {
+    throw new JsonPatchError(`JSON Patch operation failed at "${pointer}": index ${idx} is out of bounds`);
+  }
+  return idx;
+}
+
+function replaceArrayElement(array: unknown[], idx: number, value: unknown): unknown[] {
+  const copy = array.slice();
+  copy[idx] = value;
+  return copy;
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (Array.isArray(a) && Array.isArray(b)) {
+    return a.length === b.length && a.every((item, i) => deepEqual(item, b[i]));
+  }
+  if (isJsonObject(a) && isJsonObject(b)) {
+    const aKeys = Object.keys(a);
+    const bKeys = Object.keys(b);
+    return (
+      aKeys.length === bKeys.length &&
+      aKeys.every((key) => Object.prototype.hasOwnProperty.call(b, key) && deepEqual(a[key], b[key]))
+    );
+  }
+  return false;
+}
