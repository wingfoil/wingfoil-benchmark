@@ -315,3 +315,72 @@ test("rejects the whole patch when a later operation is malformed, even if earli
   assert.throws(() => applyPatch(document, [{ op: "add", path: "/b", value: 2 }, { op: "frobnicate", path: "/c" }]));
   assert.deepEqual(document, { a: 1 });
 });
+
+// The example test cases from RFC 7386 Appendix A.
+
+test("RFC 7386 A. replaces a member value", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: "c" }), { a: "c" });
+});
+
+test("RFC 7386 A. adds a member value", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { b: "c" }), { a: "b", b: "c" });
+});
+
+test("RFC 7386 A. a null member value removes the member", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: null }), {});
+  assert.deepEqual(applyMergePatch({ a: "b", b: "c" }, { a: null }), { b: "c" });
+});
+
+test("RFC 7386 A. a non-object patch value replaces a member outright, even over a differently-shaped value", () => {
+  assert.deepEqual(applyMergePatch({ a: ["b"] }, { a: "c" }), { a: "c" });
+  assert.deepEqual(applyMergePatch({ a: "c" }, { a: ["b"] }), { a: ["b"] });
+});
+
+test("RFC 7386 A. merges nested objects member by member", () => {
+  assert.deepEqual(applyMergePatch({ a: { b: "c" } }, { a: { b: "d", c: null } }), {
+    a: { b: "d" },
+  });
+});
+
+test("RFC 7386 A. an array value is replaced wholesale, never merged element by element", () => {
+  assert.deepEqual(applyMergePatch({ a: [{ b: "c" }] }, { a: [1] }), { a: [1] });
+});
+
+test("RFC 7386 A. a top-level array patch replaces the whole document", () => {
+  assert.deepEqual(applyMergePatch(["a", "b"], ["c", "d"]), ["c", "d"]);
+  assert.deepEqual(applyMergePatch({ a: "b" }, ["c"]), ["c"]);
+});
+
+test("RFC 7386 A. a scalar or null patch replaces the whole document", () => {
+  assert.equal(applyMergePatch({ a: "b" }, null), null);
+  assert.equal(applyMergePatch({ a: "b" }, "c"), "c");
+});
+
+test("RFC 7386 A. removing a nested member can empty its parent object without removing the parent", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: { bb: { ccc: null } } }), {
+    a: { bb: {} },
+  });
+});
+
+// Edge cases beyond the RFC's own table.
+
+test("a null value for a member absent from the target is a no-op, not an addition", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { c: null }), { a: "b" });
+});
+
+test("an object patch against a non-object target starts from an empty object", () => {
+  assert.deepEqual(applyMergePatch("b", { a: "c" }), { a: "c" });
+  assert.deepEqual(applyMergePatch(null, { a: "c" }), { a: "c" });
+  assert.deepEqual(applyMergePatch([1, 2], { a: "c" }), { a: "c" });
+});
+
+test("an empty object patch leaves the target unchanged", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, {}), { a: "b" });
+});
+
+test("does not mutate the target document, including nested objects", () => {
+  const target = { a: { b: "c" }, d: "e" };
+  const snapshot = JSON.parse(JSON.stringify(target));
+  applyMergePatch(target, { a: { b: "f", g: null }, d: null, h: "i" });
+  assert.deepEqual(target, snapshot);
+});
