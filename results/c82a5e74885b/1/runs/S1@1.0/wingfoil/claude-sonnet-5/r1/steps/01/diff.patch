@@ -0,0 +1,85 @@
+/**
+ * Raised when a string is not a syntactically valid JSON Pointer, or when a
+ * syntactically valid pointer does not resolve to a value within a given
+ * document.
+ */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document and returns the
+ * value it refers to.
+ *
+ * @throws {JsonPointerError} if `pointer` is not a valid JSON Pointer, or if
+ * it does not resolve to a value within `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("JSON Pointer must be a string");
+  }
+
+  return parsePointer(pointer).reduce(resolveToken, document);
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new JsonPointerError(
+      `Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`,
+    );
+  }
+  return pointer.split("/").slice(1).map(unescapeToken);
+}
+
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new JsonPointerError(
+      `Invalid JSON Pointer: "~" must be followed by "0" or "1" in "${token}"`,
+    );
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function resolveToken(current: unknown, token: string): unknown {
+  if (Array.isArray(current)) {
+    const index = parseArrayIndex(token);
+    if (index === null) {
+      throw new JsonPointerError(
+        `JSON Pointer does not resolve to a value: "${token}" is not a valid array index`,
+      );
+    }
+    if (index >= current.length) {
+      throw new JsonPointerError(
+        `JSON Pointer does not resolve to a value: index ${index} is out of bounds`,
+      );
+    }
+    return current[index];
+  }
+
+  if (isJsonObject(current)) {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new JsonPointerError(
+        `JSON Pointer does not resolve to a value: no member named "${token}"`,
+      );
+    }
+    return current[token];
+  }
+
+  throw new JsonPointerError(
+    `JSON Pointer does not resolve to a value: cannot descend into ${typeof current}`,
+  );
+}
+
+function parseArrayIndex(token: string): number | null {
+  return /^(0|[1-9][0-9]*)$/.test(token) ? Number(token) : null;
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
