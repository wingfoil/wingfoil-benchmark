@@ -0,0 +1,75 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import { resolvePointer } from "./index.ts";
+
+// The example document from RFC 6901 Section 5.
+const rfcExample = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("resolves the whole document for the empty pointer", () => {
+  assert.equal(resolvePointer(rfcExample, ""), rfcExample);
+});
+
+test("resolves the RFC 6901 example pointers", () => {
+  assert.deepEqual(resolvePointer(rfcExample, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfcExample, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfcExample, "/"), 0);
+  assert.equal(resolvePointer(rfcExample, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfcExample, "/c%d"), 2);
+  assert.equal(resolvePointer(rfcExample, "/e^f"), 3);
+  assert.equal(resolvePointer(rfcExample, "/g|h"), 4);
+  assert.equal(resolvePointer(rfcExample, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfcExample, '/k"l'), 6);
+  assert.equal(resolvePointer(rfcExample, "/ "), 7);
+  assert.equal(resolvePointer(rfcExample, "/m~0n"), 8);
+});
+
+test("resolves nested members and array indices together", () => {
+  const document = { a: { b: [{ c: "deep" }] } };
+  assert.equal(resolvePointer(document, "/a/b/0/c"), "deep");
+});
+
+test("rejects a pointer that does not start with '/'", () => {
+  assert.throws(() => resolvePointer({}, "foo"));
+});
+
+test("rejects a malformed escape sequence", () => {
+  assert.throws(() => resolvePointer({ "a~b": 1 }, "/a~b"));
+  assert.throws(() => resolvePointer({}, "/trailing~"));
+});
+
+test("rejects a pointer argument that is not a string", () => {
+  // @ts-expect-error exercising runtime validation of a non-string pointer
+  assert.throws(() => resolvePointer({}, 42));
+});
+
+test("rejects an object member that does not exist", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+});
+
+test("rejects an array index that is out of bounds", () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, "/a/2"));
+});
+
+test("rejects a leading-zero array index", () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, "/a/01"));
+});
+
+test("rejects the '-' array token, which never refers to an existing element", () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, "/a/-"));
+});
+
+test("rejects descending into a scalar", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+});
