--- a/src/index.ts
+++ b/src/index.ts
@@ -325,6 +325,108 @@ export function applyPatch(document: JsonValue, patch: JsonPatchOperation[]): Js
   return operations.reduce<JsonValue>((current, operation) => applyOperation(current, operation), deepClone(document));
 }
 
+/**
+ * Escapes a single JSON Pointer reference token, the inverse of the
+ * unescaping `parsePointer` performs (RFC 6901 section 4): "~" becomes
+ * "~0" first, then "/" becomes "~1", so that a literal "~1" already
+ * present in the token round-trips instead of being read back as an
+ * escape sequence.
+ */
+function escapeToken(token: string): string {
+  return token.replace(/~/g, '~0').replace(/\//g, '~1');
+}
+
+/** Appends a reference token to a JSON Pointer, escaping it first. */
+function childPath(path: string, token: string): string {
+  return `${path}/${escapeToken(token)}`;
+}
+
+/**
+ * Diffs the members of two objects at `path`, per the strategy described
+ * on `createPatch`: a member only `from` has is removed, a member only
+ * `to` has is added (with a cloned value, so the patch never shares
+ * structure with `to`), and a member both sides have is diffed
+ * recursively at its own path.
+ */
+function diffObjects(
+  path: string,
+  from: { [member: string]: JsonValue },
+  to: { [member: string]: JsonValue },
+  patch: JsonPatchOperation[],
+): void {
+  for (const member of Object.keys(from)) {
+    if (!Object.prototype.hasOwnProperty.call(to, member)) {
+      patch.push({ op: 'remove', path: childPath(path, member) });
+    }
+  }
+  for (const member of Object.keys(to)) {
+    if (Object.prototype.hasOwnProperty.call(from, member)) {
+      diffValues(childPath(path, member), from[member], to[member], patch);
+    } else {
+      patch.push({ op: 'add', path: childPath(path, member), value: deepClone(to[member]) });
+    }
+  }
+}
+
+/**
+ * Diffs the elements of two arrays at `path`, per the strategy described
+ * on `createPatch`: elements are lined up by index; the common prefix is
+ * diffed recursively, then `to`'s extra elements (if it is longer) are
+ * appended, or `from`'s extra elements (if it is longer) are removed,
+ * highest index first so an earlier removal never shifts a later one.
+ */
+function diffArrays(path: string, from: JsonValue[], to: JsonValue[], patch: JsonPatchOperation[]): void {
+  const common = Math.min(from.length, to.length);
+  for (let index = 0; index < common; index++) {
+    diffValues(childPath(path, String(index)), from[index], to[index], patch);
+  }
+  for (let index = common; index < to.length; index++) {
+    patch.push({ op: 'add', path: `${path}/-`, value: deepClone(to[index]) });
+  }
+  for (let index = from.length - 1; index >= common; index--) {
+    patch.push({ op: 'remove', path: childPath(path, String(index)) });
+  }
+}
+
+/**
+ * Diffs `from` against `to` at `path`, appending the operations needed
+ * to turn the former into the latter to `patch`. See `createPatch`.
+ */
+function diffValues(path: string, from: JsonValue, to: JsonValue, patch: JsonPatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (isObject(from) && isObject(to)) {
+    diffObjects(path, from, to, patch);
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(path, from, to, patch);
+  } else {
+    patch.push({ op: 'replace', path, value: deepClone(to) });
+  }
+}
+
+/**
+ * Computes a JSON Patch (RFC 6902) that turns `from` into `to` when
+ * applied via `applyPatch`. Does not mutate `from` or `to`.
+ *
+ * The result is a structural diff, not a byte- or text-level one: it
+ * walks `from` and `to` together, member by member for objects and
+ * index by index for arrays, and only emits an operation where the two
+ * sides actually differ at that path. A value is replaced wholesale only
+ * where there is no finer-grained description left: a change of JSON
+ * type at that path (e.g. an object becoming an array), or a scalar that
+ * differs from its counterpart. Because array elements are compared by
+ * index rather than by identity or content, an insertion or deletion in
+ * the middle of an array is reported as a run of per-index "replace"
+ * operations followed by a trailing "add"/"remove", rather than the
+ * single, shorter operation a move-aware diff could produce.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatchOperation[] {
+  const patch: JsonPatchOperation[] = [];
+  diffValues('', from, to, patch);
+  return patch;
+}
+
