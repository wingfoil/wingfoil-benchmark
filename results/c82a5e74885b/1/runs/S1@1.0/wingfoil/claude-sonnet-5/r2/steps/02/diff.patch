diff --git a/src/index.ts b/src/index.ts
index 86043d4d1d7061484279f8f648791fc36d16af7b..44cec0d990bd8a97e35e98b777bb459f19de8485 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -79,3 +79,237 @@ export function resolvePointer(document: JsonValue, pointer: string): JsonValue
   const tokens = parsePointer(pointer);
   return tokens.reduce((current, token) => step(current, token, pointer), document);
 }
+
+/**
+ * A single operation of a JSON Patch (RFC 6902).
+ */
+export type JsonPatchOperation =
+  | { op: 'add'; path: string; value: JsonValue }
+  | { op: 'remove'; path: string }
+  | { op: 'replace'; path: string; value: JsonValue }
+  | { op: 'move'; path: string; from: string }
+  | { op: 'copy'; path: string; from: string }
+  | { op: 'test'; path: string; value: JsonValue };
+
+function isObject(value: JsonValue): value is { [member: string]: JsonValue } {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Deeply copies a JSON value, so that no part of the result is shared
+ * with `value`.
+ */
+function deepClone(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(deepClone);
+  }
+  if (isObject(value)) {
+    return Object.fromEntries(Object.entries(value).map(([member, memberValue]) => [member, deepClone(memberValue)]));
+  }
+  return value;
+}
+
+/**
+ * Compares two JSON values per RFC 6902 section 4.6: arrays must have the
+ * same elements in the same order, objects must have the same members
+ * (order does not matter) with equal values, and other values must be
+ * strictly equal.
+ */
+function deepEqual(a: JsonValue, b: JsonValue): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((item, index) => deepEqual(item, b[index]));
+  }
+  if (isObject(a) || isObject(b)) {
+    if (!isObject(a) || !isObject(b)) {
+      return false;
+    }
+    const aMembers = Object.keys(a);
+    const bMembers = Object.keys(b);
+    return (
+      aMembers.length === bMembers.length &&
+      aMembers.every((member) => Object.prototype.hasOwnProperty.call(b, member) && deepEqual(a[member], b[member]))
+    );
+  }
+  return a === b;
+}
+
+/**
+ * Resolves the container (object or array) that holds the value a
+ * pointer's last token refers to, per RFC 6901 section 4. The container
+ * itself must already exist; its last-token member or element need not.
+ */
+function navigateToParent(document: JsonValue, tokens: string[], pointer: string): { parent: JsonValue; key: string } {
+  const key = tokens[tokens.length - 1];
+  const parent = tokens.slice(0, -1).reduce<JsonValue>((current, token) => step(current, token, pointer), document);
+  return { parent, key };
+}
+
+/**
+ * Inserts `value` into `array` at the position `key` refers to, per
+ * RFC 6902 section 4.1: `key` must be "-" (append) or a valid, in-bounds
+ * array index, up to and including `array.length` (insert at the end).
+ */
+function insertIntoArray(array: JsonValue[], key: string, value: JsonValue, pointer: string): void {
+  if (key === '-') {
+    array.push(value);
+    return;
+  }
+  if (!ARRAY_INDEX.test(key)) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" uses "${key}" as an array index.`);
+  }
+  const index = Number(key);
+  if (index > array.length) {
+    throw new Error(`"${pointer}" does not resolve: array index ${index} is out of bounds.`);
+  }
+  array.splice(index, 0, value);
+}
+
+/** Applies an "add" operation (RFC 6902 section 4.1). */
+function applyAdd(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const { parent, key } = navigateToParent(document, tokens, path);
+  if (Array.isArray(parent)) {
+    insertIntoArray(parent, key, value, path);
+    return document;
+  }
+  if (isObject(parent)) {
+    parent[key] = value;
+    return document;
+  }
+  throw new Error(`"${path}" does not resolve: "${key}" has no member to look up.`);
+}
+
+/** Applies a "remove" operation (RFC 6902 section 4.2). */
+function applyRemove(document: JsonValue, path: string): JsonValue {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    throw new Error('Invalid JSON Patch: a "remove" operation cannot target the whole document.');
+  }
+  resolvePointer(document, path);
+  const { parent, key } = navigateToParent(document, tokens, path);
+  if (Array.isArray(parent)) {
+    parent.splice(Number(key), 1);
+  } else if (isObject(parent)) {
+    delete parent[key];
+  }
+  return document;
+}
+
+/** Applies a "replace" operation (RFC 6902 section 4.3). */
+function applyReplace(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    return value;
+  }
+  resolvePointer(document, path);
+  const { parent, key } = navigateToParent(document, tokens, path);
+  if (Array.isArray(parent)) {
+    parent[Number(key)] = value;
+  } else if (isObject(parent)) {
+    parent[key] = value;
+  }
+  return document;
+}
+
+/**
+ * Applies a "move" operation (RFC 6902 section 4.4): a "remove" at
+ * `from` followed by an "add" at `path` of the removed value. Moving a
+ * location into one of its own descendants fails naturally, because the
+ * "add" can no longer find its (already removed) parent.
+ */
+function applyMove(document: JsonValue, path: string, from: string): JsonValue {
+  const value = resolvePointer(document, from);
+  const afterRemove = applyRemove(document, from);
+  return applyAdd(afterRemove, path, value);
+}
+
+/**
+ * Applies a "copy" operation (RFC 6902 section 4.5): an "add" at `path`
+ * of the value found at `from`. The value is cloned, so the copy does
+ * not share structure with its source.
+ */
+function applyCopy(document: JsonValue, path: string, from: string): JsonValue {
+  const value = resolvePointer(document, from);
+  return applyAdd(document, path, deepClone(value));
+}
+
+/** Applies a "test" operation (RFC 6902 section 4.6). */
+function applyTest(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  const actual = resolvePointer(document, path);
+  if (!deepEqual(actual, value)) {
+    throw new Error(`"test" operation failed: the value at "${path}" does not match.`);
+  }
+  return document;
+}
+
+/**
+ * Checks that `value` is a well-formed JSON Patch operation (RFC 6902
+ * section 4) and narrows it to `JsonPatchOperation`. Members other than
+ * the ones each operation requires are ignored, per section 4, Note.
+ */
+function validateOperation(value: unknown, index: number): JsonPatchOperation {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    throw new Error(`Invalid JSON Patch: operation ${index} must be an object.`);
+  }
+  const operation = value as Record<string, unknown>;
+  if (typeof operation.path !== 'string') {
+    throw new Error(`Invalid JSON Patch: operation ${index} must have a string "path" member.`);
+  }
+  switch (operation.op) {
+    case 'add':
+    case 'replace':
+    case 'test':
+      if (!('value' in operation)) {
+        throw new Error(`Invalid JSON Patch: operation ${index} ("${operation.op}") must have a "value" member.`);
+      }
+      return { op: operation.op, path: operation.path, value: operation.value as JsonValue };
+    case 'remove':
+      return { op: 'remove', path: operation.path };
+    case 'move':
+    case 'copy':
+      if (typeof operation.from !== 'string') {
+        throw new Error(`Invalid JSON Patch: operation ${index} ("${operation.op}") must have a string "from" member.`);
+      }
+      return { op: operation.op, path: operation.path, from: operation.from };
+    default:
+      throw new Error(`Invalid JSON Patch: operation ${index} has an unknown "op" value "${String(operation.op)}".`);
+  }
+}
+
+/** Dispatches a single, already-validated operation to its handler. */
+function applyOperation(document: JsonValue, operation: JsonPatchOperation): JsonValue {
+  switch (operation.op) {
+    case 'add':
+      return applyAdd(document, operation.path, operation.value);
+    case 'remove':
+      return applyRemove(document, operation.path);
+    case 'replace':
+      return applyReplace(document, operation.path, operation.value);
+    case 'move':
+      return applyMove(document, operation.path, operation.from);
+    case 'copy':
+      return applyCopy(document, operation.path, operation.from);
+    case 'test':
+      return applyTest(document, operation.path, operation.value);
+  }
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) — an array of add, remove, replace,
+ * move, copy and test operations — to a JSON document, and returns the
+ * resulting document as a new value. Does not mutate `document`.
+ *
+ * Throws when `patch` is not a well-formed JSON Patch, or when one of
+ * its operations fails (its target or source does not exist, or a
+ * "test" operation does not match).
+ */
+export function applyPatch(document: JsonValue, patch: JsonPatchOperation[]): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error('Invalid JSON Patch: a patch must be an array of operations.');
+  }
+  const operations = patch.map((operation, index) => validateOperation(operation, index));
+  return operations.reduce<JsonValue>((current, operation) => applyOperation(current, operation), deepClone(document));
+}
