--- a/README.md
+++ b/README.md
@@ -19,3 +19,19 @@ const document = { foo: ['bar', 'baz'] };
 resolvePointer(document, '/foo/0'); // 'bar'
 resolvePointer(document, '');       // the whole document
 ```
+
+### JSON Patch (RFC 6902)
+
+`applyPatch(document, patch)` applies a [JSON Patch](https://www.rfc-editor.org/rfc/rfc6902) — an
+array of `add`, `remove`, `replace`, `move`, `copy` and `test` operations — to a JSON document and
+returns the resulting document as a new value, without mutating `document`. It throws when `patch` is
+not a well-formed JSON Patch, or when one of its operations fails (its target or source does not
+exist, or a `test` operation does not match).
+
+```ts
+import { applyPatch } from 'json-toolkit';
+
+const document = { foo: 'bar' };
+applyPatch(document, [{ op: 'add', path: '/baz', value: 'qux' }]); // { foo: 'bar', baz: 'qux' }
+document; // unchanged: { foo: 'bar' }
+```
