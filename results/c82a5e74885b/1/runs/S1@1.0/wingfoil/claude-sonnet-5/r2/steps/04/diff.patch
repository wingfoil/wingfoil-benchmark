diff --git a/src/index.ts b/src/index.ts
index bd584571755c62e69f34f4c910015e67ad23646b..c1da3625e077a24ca937e117100945f4ecd3dd97 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -324,3 +324,39 @@ export function applyPatch(document: JsonValue, patch: JsonPatchOperation[]): Js
   const operations = patch.map((operation, index) => validateOperation(operation, index));
   return operations.reduce<JsonValue>((current, operation) => applyOperation(current, operation), deepClone(document));
 }
+
+/**
+ * Merges a JSON Merge Patch object into `target`, per RFC 7386 section 2:
+ * a `null` member removes the corresponding member of `target`, any other
+ * member is merged recursively, and members `target` does not have are
+ * added. `target` is already owned by the caller (a clone, or freshly
+ * created here) and may be mutated in place.
+ */
+function mergeInto(target: JsonValue, patch: { [member: string]: JsonValue }): JsonValue {
+  const result = isObject(target) ? target : {};
+  for (const [member, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[member];
+    } else {
+      result[member] = isObject(value) ? mergeInto(result[member], value) : deepClone(value);
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a target JSON document, and
+ * returns the merged document as a new value. Does not mutate `target`
+ * or `patch`.
+ *
+ * Per RFC 7386 section 2, a `patch` that is not itself a JSON object
+ * replaces `target` wholesale (this also covers `patch: null`, which
+ * removes the whole document by replacing it with `null`); otherwise,
+ * `patch`'s members are merged into `target` recursively.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isObject(patch)) {
+    return deepClone(patch);
+  }
+  return mergeInto(deepClone(target), patch);
+}
