+  const result = applyMergePatch({ a: [{ b: 'c' }] }, { a: [1] });
+  assert.deepEqual(result, { a: [1] });
+});
+
+test('an array patch replaces an array target wholesale (RFC 7386 A)', () => {
+  assert.deepEqual(applyMergePatch(['a', 'b'], ['c', 'd']), ['c', 'd']);
+});
+
+test('an array patch replaces an object target wholesale (RFC 7386 A)', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, ['c']), ['c']);
+});
+
+test('a null patch replaces the whole document with null (RFC 7386 A)', () => {
+  assert.equal(applyMergePatch({ a: 'foo' }, null), null);
+});
+
+test('a scalar patch replaces the whole document (RFC 7386 A)', () => {
+  assert.equal(applyMergePatch({ a: 'foo' }, 'bar'), 'bar');
+});
