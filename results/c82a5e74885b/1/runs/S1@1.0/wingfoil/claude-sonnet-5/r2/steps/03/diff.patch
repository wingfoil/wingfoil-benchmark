+  const result = applyPatch({ foo: 'bar' }, [{ op: 'replace', path: '', value }]) as { x: number };
+  result.x = 2;
+  assert.equal(value.x, 1);
+});
+
 test('replaces the whole document when the path is empty', () => {
   const result = applyPatch({ foo: 'bar' }, [{ op: 'replace', path: '', value: { baz: 'qux' } }]);
   assert.deepEqual(result, { baz: 'qux' });
