@@ -0,0 +1,81 @@
+/**
+ * A JSON value, as defined by RFC 8259: a string, number, boolean, null,
+ * an array of JSON values, or an object mapping strings to JSON values.
+ */
+export type JsonValue =
+  | string
+  | number
+  | boolean
+  | null
+  | JsonValue[]
+  | { [member: string]: JsonValue };
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const MALFORMED_ESCAPE = /~(?![01])/;
+
+/**
+ * Splits a JSON Pointer into its reference tokens, unescaping each one.
+ * Throws when the pointer does not follow the ABNF grammar of RFC 6901
+ * section 3: it must be empty or start with "/", and every "~" it
+ * contains must be immediately followed by "0" or "1".
+ */
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== 'string') {
+    throw new Error('A JSON Pointer must be a string.');
+  }
+  if (pointer === '') {
+    return [];
+  }
+  if (pointer[0] !== '/') {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/".`);
+  }
+  return pointer
+    .split('/')
+    .slice(1)
+    .map((token) => {
+      if (MALFORMED_ESCAPE.test(token)) {
+        throw new Error(`Invalid JSON Pointer: "${pointer}" contains a malformed "~" escape.`);
+      }
+      return token.replace(/~1/g, '/').replace(/~0/g, '~');
+    });
+}
+
+/**
+ * Resolves a single reference token against the current value, per
+ * RFC 6901 section 4. Throws when the token cannot be resolved: the
+ * current value is not an object or array, the object has no such
+ * member, or the array has no such index.
+ */
+function step(current: JsonValue, token: string, pointer: string): JsonValue {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token)) {
+      throw new Error(
+        `Invalid JSON Pointer: "${pointer}" uses "${token}" as an array index.`,
+      );
+    }
+    const index = Number(token);
+    if (index >= current.length) {
+      throw new Error(`"${pointer}" does not resolve: array index ${index} is out of bounds.`);
+    }
+    return current[index];
+  }
+  if (typeof current === 'object' && current !== null) {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new Error(`"${pointer}" does not resolve: no member named "${token}".`);
+    }
+    return current[token];
+  }
+  throw new Error(`"${pointer}" does not resolve: "${token}" has no member to look up.`);
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document, returning
+ * the value it refers to.
+ *
+ * Throws when `pointer` is not a syntactically valid JSON Pointer, or
+ * when it does not resolve to a value within `document`.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  const tokens = parsePointer(pointer);
+  return tokens.reduce((current, token) => step(current, token, pointer), document);
+}
