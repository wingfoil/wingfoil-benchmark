diff --git a/src/index.test.ts b/src/index.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..923ccebaafc2373b9e08ce23dd2bb460830af50c
--- /dev/null
+++ b/src/index.test.ts
@@ -0,0 +1,79 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { resolvePointer } from './index.ts';
+
+// Document from RFC 6901, section 5.
+const document = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+test('resolves the whole document for the empty pointer', () => {
+  assert.deepEqual(resolvePointer(document, ''), document);
+});
+
+test('resolves a top-level member', () => {
+  assert.deepEqual(resolvePointer(document, '/foo'), ['bar', 'baz']);
+});
+
+test('resolves an array element by index', () => {
+  assert.equal(resolvePointer(document, '/foo/0'), 'bar');
+});
+
+test('resolves the member with the empty-string name', () => {
+  assert.equal(resolvePointer(document, '/'), 0);
+});
+
+test('unescapes ~1 to / and ~0 to ~', () => {
+  assert.equal(resolvePointer(document, '/a~1b'), 1);
+  assert.equal(resolvePointer(document, '/m~0n'), 8);
+});
+
+test('resolves members whose names need no escaping', () => {
+  assert.equal(resolvePointer(document, '/c%d'), 2);
+  assert.equal(resolvePointer(document, '/e^f'), 3);
+  assert.equal(resolvePointer(document, '/g|h'), 4);
+  assert.equal(resolvePointer(document, '/i\\j'), 5);
+  assert.equal(resolvePointer(document, '/k"l'), 6);
+  assert.equal(resolvePointer(document, '/ '), 7);
+});
+
+test('rejects a pointer that is neither empty nor starting with /', () => {
+  assert.throws(() => resolvePointer(document, 'foo'));
+});
+
+test('rejects a pointer that is not a string', () => {
+  assert.throws(() => resolvePointer(document, 42 as unknown as string));
+});
+
+test('rejects a pointer with a malformed escape sequence', () => {
+  assert.throws(() => resolvePointer(document, '/foo~2'));
+});
+
+test('rejects a pointer to a member that does not exist', () => {
+  assert.throws(() => resolvePointer(document, '/missing'));
+});
+
+test('rejects a pointer with a non-numeric array index', () => {
+  assert.throws(() => resolvePointer(document, '/foo/bar'));
+});
+
+test('rejects a pointer with an array index that has a leading zero', () => {
+  assert.throws(() => resolvePointer(document, '/foo/01'));
+});
+
+test('rejects a pointer with an out-of-bounds array index', () => {
+  assert.throws(() => resolvePointer(document, '/foo/2'));
+});
+
+test('rejects a pointer that descends into a scalar value', () => {
+  assert.throws(() => resolvePointer(document, '/foo/0/bar'));
+});
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e2bffa7b398551d902c6b6263e285d9bbbe10154
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,62 @@
+/** Any value that can appear in a parsed JSON document. */
+export type JsonValue =
+  | string
+  | number
+  | boolean
+  | null
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+/** Splits a JSON Pointer into its unescaped reference tokens, per RFC 6901 section 3-4. */
+function parsePointer(pointer: string): string[] {
+  if (pointer === '') {
+    return [];
+  }
+  if (!pointer.startsWith('/')) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`);
+  }
+  return pointer.split('/').slice(1).map(unescapeToken);
+}
+
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: malformed escape sequence in token "${token}"`);
+  }
+  // Order matters: a literal "~" is encoded as "~0" and "/" as "~1", so "~1"
+  // must be unescaped first or "~01" would wrongly decode to "/".
+  return token.replace(/~1/g, '/').replace(/~0/g, '~');
+}
+
+function resolveToken(current: JsonValue, token: string): JsonValue {
+  if (Array.isArray(current)) {
+    if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+      throw new Error(`Invalid JSON Pointer: "${token}" is not a valid array index`);
+    }
+    const index = Number(token);
+    if (index >= current.length) {
+      throw new Error(`JSON Pointer does not resolve: index ${index} is out of bounds`);
+    }
+    return current[index];
+  }
+  if (current !== null && typeof current === 'object') {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new Error(`JSON Pointer does not resolve: no member named "${token}"`);
+    }
+    return (current as { [key: string]: JsonValue })[token];
+  }
+  throw new Error(`JSON Pointer does not resolve: cannot descend into a ${typeof current} value`);
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document and returns the value it refers to.
+ *
+ * @throws {Error} if `pointer` is not a syntactically valid JSON Pointer, or if it does not
+ * resolve to a value within `document`.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  if (typeof pointer !== 'string') {
+    throw new Error('Invalid JSON Pointer: must be a string');
+  }
+  const tokens = parsePointer(pointer);
+  return tokens.reduce(resolveToken, document);
+}
