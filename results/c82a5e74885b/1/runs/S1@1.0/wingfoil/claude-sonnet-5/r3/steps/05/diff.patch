@@ -27,6 +27,13 @@ function unescapeToken(token: string): string {
   return token.replace(/~1/g, '/').replace(/~0/g, '~');
 }
 
+/** Encodes a literal member name as a JSON Pointer reference token, per RFC 6901 section 4. */
+function escapeToken(token: string): string {
+  // Order matters, mirroring unescapeToken: "~" must become "~0" before "/" becomes "~1", or a
+  // literal "/" would wrongly turn into "~01" instead of "~1".
+  return token.replace(/~/g, '~0').replace(/\//g, '~1');
+}
+
 const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
 
 /** Parses a reference token as an array index, optionally allowing one-past-the-end for insertion. */
@@ -304,3 +311,69 @@ export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue
   }
   return result;
 }
+
+/** Appends the operations that turn the object `from` into the object `to` at `path`. */
+function diffObjects(
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    const childPath = `${path}/${escapeToken(key)}`;
+    if (Object.prototype.hasOwnProperty.call(to, key)) {
+      diffValues(from[key], to[key], childPath, patch);
+    } else {
+      patch.push({ op: 'remove', path: childPath });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (!Object.prototype.hasOwnProperty.call(from, key)) {
+      patch.push({ op: 'add', path: `${path}/${escapeToken(key)}`, value: clone(to[key]) });
+    }
+  }
+}
+
+/**
+ * Appends the operations that turn the array `from` into the array `to` at `path`. Elements at a
+ * shared index are diffed in place; a length difference is described as trailing "add"s (appended
+ * via "-") or trailing "remove"s (from the highest index down, so earlier removals cannot shift the
+ * index of one still to come).
+ */
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, patch: JsonPatchOperation[]): void {
+  const commonLength = Math.min(from.length, to.length);
+  for (let index = 0; index < commonLength; index++) {
+    diffValues(from[index], to[index], `${path}/${index}`, patch);
+  }
+  for (let index = from.length - 1; index >= to.length; index--) {
+    patch.push({ op: 'remove', path: `${path}/${index}` });
+  }
+  for (let index = from.length; index < to.length; index++) {
+    patch.push({ op: 'add', path: `${path}/-`, value: clone(to[index]) });
+  }
+}
+
+/** Appends the operations that turn the value `from` into the value `to` at `path`. */
+function diffValues(from: JsonValue, to: JsonValue, path: string, patch: JsonPatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (isJsonObject(from) && isJsonObject(to)) {
+    diffObjects(from, to, path, patch);
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, patch);
+  } else {
+    patch.push({ op: 'replace', path, value: clone(to) });
+  }
+}
+
+/**
+ * Computes a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ * Describes only what changed: unchanged members and array elements produce no operation,
+ * neither `from` nor `to` is mutated, and no value in the result is aliased with `to`.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatch {
+  const patch: JsonPatchOperation[] = [];
+  diffValues(from, to, '', patch);
+  return patch;
+}
