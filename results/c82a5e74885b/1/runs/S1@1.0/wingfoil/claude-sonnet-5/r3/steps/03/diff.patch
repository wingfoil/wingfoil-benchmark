+test('add: adds a member literally named "__proto__" without altering the object\'s prototype', () => {
+  const result = applyPatch({ a: 1 }, [
+    { op: 'add', path: '/__proto__', value: { polluted: true } },
+  ]) as Record<string, unknown>;
+  assert.deepEqual(Object.keys(result), ['a', '__proto__']);
