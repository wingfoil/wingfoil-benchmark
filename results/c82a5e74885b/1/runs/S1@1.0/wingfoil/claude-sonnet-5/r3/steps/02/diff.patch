+/** Validates that an unknown value has the shape of a JSON Patch operation, per RFC 6902 section 4. */
+function validateOperation(operation: unknown): JsonPatchOperation {
+  if (typeof operation !== 'object' || operation === null || Array.isArray(operation)) {
+    throw new Error('Invalid JSON Patch operation: must be an object');
+  }
+  const { op, path } = operation as { op?: unknown; path?: unknown };
+  if (typeof path !== 'string') {
+    throw new Error('Invalid JSON Patch operation: "path" must be a string');
+  }
+  switch (op) {
+    case 'add':
+    case 'replace':
+    case 'test': {
+      if (!('value' in operation)) {
+        throw new Error(`Invalid JSON Patch operation: "${op}" requires a "value" member`);
+      }
+      return { op, path, value: (operation as { value: JsonValue }).value };
+    }
+    case 'remove':
+      return { op, path };
+    case 'move':
+    case 'copy': {
+      const { from } = operation as { from?: unknown };
+      if (typeof from !== 'string') {
+        throw new Error(`Invalid JSON Patch operation: "${op}" requires a "from" member`);
+      }
+      return { op, path, from };
+    }
+    default:
+      throw new Error(`Invalid JSON Patch operation: unknown "op" value ${JSON.stringify(op)}`);
+  }
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the resulting document as a new
+ * value; `document` is left unmodified.
+ *
+ * @throws {Error} if `patch` is not a well-formed JSON Patch, or if one of its operations fails.
+ */
+export function applyPatch(document: JsonValue, patch: JsonPatch): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error('Invalid JSON Patch: must be an array of operations');
+  }
+  return patch.reduce<JsonValue>(
+    (current, operation) => applyOperation(current, validateOperation(operation)),
+    clone(document),
+  );
+}
