+
+// applyMergePatch — RFC 7386.
+// Cases labelled "RFC 7386 appendix A" reproduce that section's worked examples verbatim.
+
+test('does not mutate the input target and returns a new value', () => {
+  const original = { a: 1, nested: { b: 2 } };
+  const result = applyMergePatch(original, { nested: { b: 99 } }) as {
+    a: number;
+    nested: { b: number };
+  };
+  assert.deepEqual(original, { a: 1, nested: { b: 2 } });
+  assert.equal(result.nested.b, 99);
+  assert.notEqual(result, original);
+  assert.notEqual(result.nested, original.nested);
+});
+
+test('RFC 7386 appendix A: replaces an existing member', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { a: 'c' }), { a: 'c' });
+});
+
+test('RFC 7386 appendix A: adds a new member', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { b: 'c' }), { a: 'b', b: 'c' });
+});
+
+test('RFC 7386 appendix A: a null value removes the only member', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { a: null }), {});
+});
+
+test('RFC 7386 appendix A: a null value removes one member among several', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b', b: 'c' }, { a: null }), { b: 'c' });
+});
+
+test('RFC 7386 appendix A: a scalar patch value replaces an array member wholesale', () => {
+  assert.deepEqual(applyMergePatch({ a: ['b'] }, { a: 'c' }), { a: 'c' });
+});
+
+test('RFC 7386 appendix A: an array patch value replaces a scalar member wholesale', () => {
+  assert.deepEqual(applyMergePatch({ a: 'c' }, { a: ['b'] }), { a: ['b'] });
+});
+
+test('RFC 7386 appendix A: merges nested objects recursively', () => {
+  assert.deepEqual(applyMergePatch({ a: { b: 'c' } }, { a: { b: 'd', c: null } }), {
+    a: { b: 'd' },
+  });
+});
+
+test('RFC 7386 appendix A: an array member is replaced, not merged element-wise', () => {
+  assert.deepEqual(applyMergePatch({ a: [{ b: 'c' }] }, { a: [1] }), { a: [1] });
+});
+
+test('RFC 7386 appendix A: a top-level array patch replaces the whole target', () => {
+  assert.deepEqual(applyMergePatch(['a', 'b'], ['c', 'd']), ['c', 'd']);
+});
+
+test('RFC 7386 appendix A: a top-level array patch replaces an object target', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, ['c']), ['c']);
+});
+
+test('RFC 7386 appendix A: a top-level null patch replaces the whole target', () => {
+  assert.equal(applyMergePatch({ a: 'foo' }, null), null);
+});
+
+test('RFC 7386 appendix A: a top-level scalar patch replaces the whole target', () => {
+  assert.equal(applyMergePatch({ a: 'foo' }, 'bar'), 'bar');
+});
+
+test('RFC 7386 appendix A: a member whose value is null is preserved when untouched by the patch', () => {
+  assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+});
+
+test('RFC 7386 appendix A: an array target is discarded in favor of the merged patch object', () => {
+  assert.deepEqual(applyMergePatch([1, 2], { a: 'b', c: null }), { a: 'b' });
+});
+
+test('RFC 7386 appendix A: removing a member leaves a nested empty object rather than deleting it', () => {
+  assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+});
+
+test('removing a member that does not exist in the target is a no-op', () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, { b: null }), { a: 1 });
+});
+
+test('merges a member literally named "__proto__" without altering the object\'s prototype', () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true}}') as JsonValue;
+  const result = applyMergePatch({ a: 1 }, patch) as Record<string, unknown>;
+  assert.deepEqual(Object.keys(result), ['a', '__proto__']);
+  assert.deepEqual(result['__proto__'], { polluted: true });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal((Object.prototype as Record<string, unknown>).polluted, undefined);
+});
diff --git a/src/index.ts b/src/index.ts
index 99d32d2ee9b6c7712436976f3908a06641eb4438..758c608bc552c625f80388b068f41e45ccbda51a 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -279,3 +279,28 @@ export function applyPatch(document: JsonValue, patch: JsonPatch): JsonValue {
     clone(document),
   );
 }
+
+/** Returns `true` if `value` is a JSON object: neither an array nor `null`. */
+function isJsonObject(value: JsonValue): value is { [key: string]: JsonValue } {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a target JSON document and returns the merged document
+ * as a new value; `target` is left unmodified.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return clone(patch);
+  }
+  const result: { [key: string]: JsonValue } = isJsonObject(target) ? clone(target) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(result[key], value));
+    }
+  }
+  return result;
+}
