+/** The longest a title may be. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * The title, trimmed; or why it cannot be used: empty, or longer than {@link MAX_TITLE_LENGTH} characters.
+ *
+ * @param title - the title to validate
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'title must not be empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `title must not be longer than ${MAX_TITLE_LENGTH} characters`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority, if it is one of {@link PRIORITIES}; or why it cannot be used.
+ *
+ * @param priority - the priority to validate
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  if (!(PRIORITIES as readonly string[]).includes(priority)) {
+    return err('invalid-input', `priority must be one of ${PRIORITIES.join(', ')}, not "${priority}"`);
+  }
+  return ok(priority as Priority);
+}
+
+/**
+ * The tag, if it is not empty and has no space; or why it cannot be used.
+ *
+ * @param tag - the tag to validate
+ */
+export function validateTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'tag must not be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `tag must not contain a space: "${tag}"`);
+  return ok(tag);
+}
