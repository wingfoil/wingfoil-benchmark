@@ -0,0 +1,56 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('bulk import', () => {
+  it('imports every valid line, defaulting priority and splitting tags on spaces', () => {
+    const list = createTodoList();
+    const result = importTasks(
+      list,
+      'Renew the insurance;high;admin money\nWater the plants;;\nBuy milk;normal;',
+    );
+    assert.deepEqual(result, { imported: 3, rejected: [] });
+
+    const tasks = list.list();
+    assert.deepEqual(
+      tasks.map((task) => [task.title, task.priority, task.tags]),
+      [
+        ['Renew the insurance', 'high', ['admin', 'money']],
+        ['Buy milk', 'normal', []],
+        ['Water the plants', 'normal', []],
+      ],
+    );
+  });
+
+  it('skips blank lines without affecting line numbers', () => {
+    const list = createTodoList();
+    const result = importTasks(list, '\nBuy milk;;\n\nBuy milk;;\n');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(result.rejected, [{ line: 4, reason: 'there is already a task "Buy milk"' }]);
+  });
+
+  it('rejects a line that is not title;priority;tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;normal');
+    assert.equal(result.imported, 0);
+    assert.deepEqual(result.rejected, [{ line: 1, reason: 'expected "title;priority;tags"' }]);
+  });
+
+  it('rejects an invalid title or priority, and a duplicate title, importing everything else', () => {
+    const list = createTodoList();
+    const result = importTasks(
+      list,
+      [';normal;', 'Buy milk;urgent;', 'Buy milk;;', 'Buy milk;;'].join('\n'),
+    );
+    assert.equal(result.imported, 1);
+    assert.deepEqual(
+      result.rejected.map((rejection) => rejection.line),
+      [1, 2, 4],
+    );
+    assert.deepEqual(
+      list.list().map((task) => task.title),
+      ['Buy milk'],
+    );
+  });
+});
