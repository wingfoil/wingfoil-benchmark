+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line from a bulk import that could not be added, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of a bulk import: how many tasks were added, and which lines were not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds every task described in `text` to `list`. Each non-blank line holds one task, as
+ * `title;priority;tags`: the priority may be left empty for a normal one, and the tags are
+ * separated by spaces. Blank lines are skipped. A line is rejected for the same reasons
+ * {@link TaskList.add} would refuse it (an invalid title, priority or tag, or a duplicate title),
+ * or for not having the `title;priority;tags` shape.
+ *
+ * @param list - the task list to add to
+ * @param text - the lines to import, one task per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+
+  const lines = text.split(/\r?\n/);
+  for (let index = 0; index < lines.length; index++) {
+    const line = lines[index];
+    if (line.trim() === '') continue;
+
+    const parts = line.split(';');
+    if (parts.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'expected "title;priority;tags"' });
+      continue;
+    }
+
+    const [title, priorityPart, tagsPart] = parts;
+    const priority = priorityPart.trim() === '' ? undefined : (priorityPart.trim() as Priority);
+    const tags = tagsPart.trim() === '' ? [] : tagsPart.trim().split(/\s+/);
+
+    const result = list.add({ title, priority, tags });
+    if (result.ok) imported++;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  }
+
+  return { imported, rejected };
+}
