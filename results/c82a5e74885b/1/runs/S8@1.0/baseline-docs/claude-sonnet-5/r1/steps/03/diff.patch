+describe('input validation', () => {
+  it('refuses a title that is empty or only spaces, on add', () => {
+    const list = createTodoList();
+    const empty = list.add({ title: '' });
+    assert.equal(empty.ok, false);
+    if (!empty.ok) assert.equal(empty.error.code, 'invalid-input');
+    const spaces = list.add({ title: '   ' });
+    assert.equal(spaces.ok, false);
+    if (!spaces.ok) assert.equal(spaces.error.code, 'invalid-input');
+    assert.equal(list.list().length, 0);
+  });
+
+  it('refuses a title longer than 120 characters, on add', () => {
+    const list = createTodoList();
+    const result = list.add({ title: 'a'.repeat(121) });
+    assert.equal(result.ok, false);
+    if (!result.ok) assert.equal(result.error.code, 'invalid-input');
+    assert.equal(list.list().length, 0);
+  });
+
+  it('accepts a title of exactly 120 characters, on add', () => {
+    const list = createTodoList();
+    const result = list.add({ title: 'a'.repeat(120) });
+    assert.equal(result.ok, true);
+  });
+
+  it('refuses a priority other than low, normal or high, on add', () => {
