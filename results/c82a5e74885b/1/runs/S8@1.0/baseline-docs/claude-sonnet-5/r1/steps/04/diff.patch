 }
+
+/** A line of a bulk import that could not be added, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of a bulk import: how many tasks were added, and every line that was not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Bulk-imports tasks into `list` from `text`, one task per line, as `title;priority;tags`: the priority
+ * may be left empty for a normal one, and the tags are separated by spaces. Blank lines are skipped.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the tasks to import, one per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  const lines = text.split('\n');
+  for (const [index, rawLine] of lines.entries()) {
+    const line = rawLine.trim();
+    if (line === '') continue;
+    const [title = '', priorityField = '', ...rest] = line.split(';');
+    const priority = priorityField.trim();
+    const tags = rest.join(';').trim().split(/\s+/).filter((tag) => tag !== '');
+    const added = list.add({
+      title,
+      priority: priority === '' ? undefined : (priority as Priority),
+      tags,
+    });
+    if (added.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line: index + 1, reason: added.error.message });
+    }
+  }
+  return { imported, rejected };
+}
