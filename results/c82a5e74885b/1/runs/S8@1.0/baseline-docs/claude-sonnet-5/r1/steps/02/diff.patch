+describe('task timestamps', () => {
+  it('stamps a new task with its creation time, as both createdAt and updatedAt', () => {
+    const list = createTodoList(fakeClock(['2024-01-01T00:00:00.000Z']));
+    const task = valueOf(list.add({ title: 'Buy milk' }));
+    assert.equal(task.createdAt, '2024-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, '2024-01-01T00:00:00.000Z');
+  });
+
+  it('updates updatedAt, and keeps createdAt, on every change', () => {
+    const list = createTodoList(
+      fakeClock([
+        '2024-01-01T00:00:00.000Z', // add
+        '2024-01-02T00:00:00.000Z', // complete
+        '2024-01-03T00:00:00.000Z', // reopen
+        '2024-01-04T00:00:00.000Z', // rename
+        '2024-01-05T00:00:00.000Z', // tag
+        '2024-01-06T00:00:00.000Z', // untag
+      ]),
+    );
+    const created = valueOf(list.add({ title: 'Water the plants' }));
+    assert.equal(created.createdAt, '2024-01-01T00:00:00.000Z');
+
+    const completed = valueOf(list.complete(created.id));
+    assert.equal(completed.updatedAt, '2024-01-02T00:00:00.000Z');
+    assert.equal(completed.createdAt, created.createdAt);
+
+    const reopened = valueOf(list.reopen(created.id));
+    assert.equal(reopened.updatedAt, '2024-01-03T00:00:00.000Z');
+    assert.equal(reopened.createdAt, created.createdAt);
+
+    const renamed = valueOf(list.rename(created.id, 'Water the garden'));
+    assert.equal(renamed.updatedAt, '2024-01-04T00:00:00.000Z');
+    assert.equal(renamed.createdAt, created.createdAt);
+
+    const tagged = valueOf(list.tag(created.id, 'garden'));
+    assert.equal(tagged.updatedAt, '2024-01-05T00:00:00.000Z');
+    assert.equal(tagged.createdAt, created.createdAt);
+
+    const untagged = valueOf(list.untag(created.id, 'garden'));
+    assert.equal(untagged.updatedAt, '2024-01-06T00:00:00.000Z');
+    assert.equal(untagged.createdAt, created.createdAt);
+  });
+
+  it('does not update updatedAt when a change is refused', () => {
+    const list = createTodoList(fakeClock(['2024-01-01T00:00:00.000Z', '2024-01-02T00:00:00.000Z']));
+    const created = valueOf(list.add({ title: 'Water the plants' }));
+    const completed = valueOf(list.complete(created.id));
+    assert.equal(completed.updatedAt, '2024-01-02T00:00:00.000Z');
+
+    const again = list.complete(created.id);
+    assert.equal(again.ok, false);
+    assert.equal(valueOf(list.get(created.id)).updatedAt, '2024-01-02T00:00:00.000Z');
+  });
+
+  it('stamps tasks with a real, current moment when no clock is given', () => {
+    const before = new Date().toISOString();
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'Buy milk' }));
+    const after = new Date().toISOString();
+    assert.ok(task.createdAt >= before && task.createdAt <= after);
+  });
