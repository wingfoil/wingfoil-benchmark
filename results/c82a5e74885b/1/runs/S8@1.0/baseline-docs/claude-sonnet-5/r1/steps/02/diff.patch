+    find: (titleOrId) => tasks.find(titleOrId),
+    complete: (titleOrId) => tasks.complete(titleOrId, clock()),
+    reopen: (titleOrId) => tasks.reopen(titleOrId, clock()),
+    rename: (titleOrId, newTitle) => tasks.rename(titleOrId, newTitle, clock()),
+    tag: (titleOrId, tag) => tasks.tag(titleOrId, tag, clock()),
+    untag: (titleOrId, tag) => tasks.untag(titleOrId, tag, clock()),
+    remove: (titleOrId) => tasks.remove(titleOrId),
+    list: (filter) => tasks.list(filter),
+    openCount: () => tasks.openCount(),
+  };
 }
