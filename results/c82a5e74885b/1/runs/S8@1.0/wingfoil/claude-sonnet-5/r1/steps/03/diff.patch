index ae5fdc6ac255fde645860fd39fc1cf9d5407631f..e54117b7105c5f3e808f9e514ad92e6df6e0e6a3 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -7,6 +7,9 @@ export type Priority = 'low' | 'normal' | 'high';
 /** Every priority, from the least urgent to the most. */
 export const PRIORITIES: readonly Priority[] = ['low', 'normal', 'high'];
 
+/** The longest a task's title may be, in characters, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
 /** Whether a task still has to be done. */
 export type Status = 'open' | 'done';
 
@@ -107,6 +110,46 @@ export function removeTag(task: Task, tag: string, now: string): Task {
   return { ...task, tags: task.tags.filter((existing) => existing !== tag), updatedAt: now };
 }
 
+/**
+ * The title, trimmed, if it is valid: not empty, or only spaces, and not longer than
+ * `MAX_TITLE_LENGTH` characters once trimmed.
+ *
+ * @param title - the title to validate
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed.length === 0) return err('invalid-input', 'title must not be empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `title must not be longer than ${MAX_TITLE_LENGTH} characters`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * `priority`, if it is one of `PRIORITIES`; `undefined` passed through unchanged, since a priority
+ * is optional.
+ *
+ * @param priority - the priority to validate, if any
+ */
+export function validatePriority(priority: Priority | undefined): Result<Priority | undefined> {
+  if (priority === undefined) return ok(undefined);
+  if (!PRIORITIES.includes(priority)) {
+    return err('invalid-input', `priority must be one of ${PRIORITIES.join(', ')}, not "${priority}"`);
+  }
+  return ok(priority);
+}
+
+/**
+ * The tag, if it is valid: not empty, and without a space.
+ *
+ * @param tag - the tag to validate
+ */
+export function validateTag(tag: string): Result<string> {
+  if (tag.length === 0) return err('invalid-input', 'tag must not be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `tag must not contain a space, got "${tag}"`);
+  return ok(tag);
+}
+
