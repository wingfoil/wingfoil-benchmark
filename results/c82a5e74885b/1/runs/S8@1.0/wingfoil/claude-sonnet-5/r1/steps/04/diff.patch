+
+/** A line of a bulk import that could not be added, and why. */
+export interface RejectedLine {
+  /** The line's position in the imported text, counting from 1. */
+  readonly line: number;
+  /** Why the line could not be added, for the person importing it. */
+  readonly reason: string;
+}
+
+/** The outcome of a bulk import: how many tasks were added, and every line that was not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds every valid task found in `text` to `list`, one per non-blank line, each written as
+ * `title;priority;tags`: `priority` left empty means a normal priority, and `tags` are
+ * separated by spaces. Blank lines are skipped. Each line is validated the same way as
+ * `list.add`, so a line that fails validation, or duplicates a title already in `list`
+ * (including one imported from an earlier line), is rejected rather than added.
+ *
+ * @param list - the task list to add the imported tasks to
+ * @param text - the text to import, one task per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  const now = new Date().toISOString();
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+
+  const lines = text.split(/\r?\n/);
+  for (const [index, rawLine] of lines.entries()) {
+    if (rawLine.trim().length === 0) continue;
+
+    const fields = rawLine.split(';');
+    if (fields.length > 3) {
+      rejected.push({
+        line: index + 1,
+        reason: `a line must have the form "title;priority;tags", got ${fields.length} fields`,
+      });
+      continue;
+    }
+
+    const [title, priorityText = '', tagsText = ''] = fields;
+    const priority = priorityText.trim();
+    const tags = tagsText.trim();
+    const input: NewTask = {
+      title,
+      priority: priority.length === 0 ? undefined : (priority as Priority),
+      tags: tags.length === 0 ? [] : tags.split(/\s+/),
+    };
+
+    const result = list.add(input, now);
+    if (result.ok) imported++;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  }
+
+  return { imported, rejected };
+}
diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d747c0e124226739076f49c9c37e8281f67bd98d
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,92 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('imports a valid line with a priority and tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin money');
+    assert.deepEqual(result, { imported: 1, rejected: [] });
+    const task = list.list()[0];
+    assert.equal(task.title, 'Renew the insurance');
+    assert.equal(task.priority, 'high');
+    assert.deepEqual(task.tags, ['admin', 'money']);
+  });
+
+  it('defaults to a normal priority and no tags when both are left empty', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;');
+    assert.deepEqual(result, { imported: 1, rejected: [] });
+    const task = list.list()[0];
+    assert.equal(task.priority, 'normal');
+    assert.deepEqual(task.tags, []);
+  });
+
+  it('accepts a line that omits the trailing priority and tags fields entirely', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk');
+    assert.deepEqual(result, { imported: 1, rejected: [] });
+    assert.equal(list.list()[0].priority, 'normal');
+  });
+
+  it('skips blank lines without counting or rejecting them', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;\n\n   \nBuy eggs;;');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+  });
+
+  it('imports several valid lines, counting from 1', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'a;;\nb;high;\nc;;x y');
+    assert.equal(result.imported, 3);
+    assert.deepEqual(result.rejected, []);
+    assert.deepEqual(
+      list.list().map((task) => task.title),
+      ['b', 'a', 'c'],
+    );
+  });
+
+  it('rejects a line with an empty title, and reports the line number', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;\n;;\nBuy eggs;;');
+    assert.equal(result.imported, 2);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0].line, 2);
+  });
+
+  it('rejects a line with an invalid priority', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;urgent;');
+    assert.deepEqual(result.imported, 0);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0].line, 1);
+    assert.match(result.rejected[0].reason, /priority/);
+  });
+
+  it('rejects a second line that duplicates an already-imported title', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;\nBuy milk;;');
+    assert.equal(result.imported, 1);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0].line, 2);
+    assert.match(result.rejected[0].reason, /already/);
+  });
+
+  it('rejects a line with too many fields', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;high;home;extra');
+    assert.equal(result.imported, 0);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0].line, 1);
+  });
+
+  it('leaves the list untouched by lines that fail to import', () => {
+    const list = createTodoList();
+    importTasks(list, ';;\nBuy milk;;');
+    assert.deepEqual(
+      list.list().map((task) => task.title),
+      ['Buy milk'],
+    );
+  });
+});
