@@ -0,0 +1,136 @@
+const DAY_IN_MS = 24 * 60 * 60 * 1000;
+
+/** The kind of equipment the school rents out. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A piece of equipment available for rental, with its id, kind and daily price in euro cents. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** A request to quote or book an item for a period, given as whole UTC days. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The cost of renting an item for a period. */
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  total: number;
+}
+
+/** A confirmed booking of an item for a period. */
+export interface Booking {
+  id: string;
+  itemId: string;
+  start: string;
+  end: string;
+  total: number;
+}
+
+/** The rental desk service: register equipment, quote and book rentals. */
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+function isUtcMidnight(date: Date): boolean {
+  return (
+    date.getUTCHours() === 0 &&
+    date.getUTCMinutes() === 0 &&
+    date.getUTCSeconds() === 0 &&
+    date.getUTCMilliseconds() === 0
+  );
+}
+
+function wholeDaysBetween(start: string, end: string): number {
+  const startDate = new Date(start);
+  const endDate = new Date(end);
+  if (Number.isNaN(startDate.getTime()) || Number.isNaN(endDate.getTime())) {
+    throw new Error('start and end must be valid ISO-8601 UTC times');
+  }
+  if (!isUtcMidnight(startDate) || !isUtcMidnight(endDate)) {
+    throw new Error('a booking period must start and end at midnight UTC');
+  }
+  if (endDate.getTime() <= startDate.getTime()) {
+    throw new Error('end must be after start');
+  }
+  return (endDate.getTime() - startDate.getTime()) / DAY_IN_MS;
+}
+
+function overlaps(aStart: Date, aEnd: Date, bStart: Date, bEnd: Date): boolean {
+  return aStart.getTime() < bEnd.getTime() && bStart.getTime() < aEnd.getTime();
+}
+
+/** Creates an in-memory rental service for the booking desk. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookingsByItem = new Map<string, Booking[]>();
+  let nextBookingId = 1;
+
+  function getEquipmentOrThrow(itemId: string): Equipment {
+    const item = equipment.get(itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${itemId}`);
+    }
+    return item;
+  }
+
+  function addEquipment(item: Equipment): void {
+    if (typeof item.id !== 'string' || item.id === '') {
+      throw new Error('id must be a non-empty string');
+    }
+    if (equipment.has(item.id)) {
+      throw new Error(`item already exists: ${item.id}`);
+    }
+    if (item.kind !== 'board' && item.kind !== 'sail') {
+      throw new Error(`kind must be 'board' or 'sail'`);
+    }
+    if (!Number.isInteger(item.dailyPrice) || item.dailyPrice < 0) {
+      throw new Error('dailyPrice must be a non-negative integer number of cents');
+    }
+    equipment.set(item.id, { ...item });
+  }
+
+  function quote(request: RentalRequest): Quote {
+    const item = getEquipmentOrThrow(request.itemId);
+    const days = wholeDaysBetween(request.start, request.end);
+    return {
+      itemId: request.itemId,
+      start: request.start,
+      end: request.end,
+      total: days * item.dailyPrice,
+    };
+  }
+
+  function book(request: RentalRequest): Booking {
+    const quoted = quote(request);
+    const existing = bookingsByItem.get(request.itemId) ?? [];
+    const start = new Date(request.start);
+    const end = new Date(request.end);
+    for (const existingBooking of existing) {
+      if (overlaps(start, end, new Date(existingBooking.start), new Date(existingBooking.end))) {
+        throw new Error(`item ${request.itemId} is already booked for part of that period`);
+      }
+    }
+    const booking: Booking = {
+      id: String(nextBookingId++),
+      itemId: request.itemId,
+      start: request.start,
+      end: request.end,
+      total: quoted.total,
+    };
+    existing.push(booking);
+    bookingsByItem.set(request.itemId, existing);
+    return booking;
+  }
+
+  return { addEquipment, quote, book };
+}
