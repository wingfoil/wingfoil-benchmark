+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+test('quotes a board for several whole days', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+
+  const result = service.quote({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+  });
+
+  assert.deepEqual(result, {
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+    total: 6000,
+  });
+});
+
+test('quote throws for an unknown item', () => {
+  const service = createRentalService();
+
+  assert.throws(() =>
+    service.quote({
+      itemId: 'missing',
+      start: '2024-06-01T00:00:00.000Z',
+      end: '2024-06-02T00:00:00.000Z',
+    })
+  );
+});
+
+test('quote throws when the period is not whole days', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+
+  assert.throws(() =>
+    service.quote({
+      itemId: 'sail-1',
+      start: '2024-06-01T10:00:00.000Z',
+      end: '2024-06-02T00:00:00.000Z',
+    })
+  );
+});
+
+test('quote throws when the end is not after the start', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+
+  assert.throws(() =>
+    service.quote({
+      itemId: 'sail-1',
+      start: '2024-06-02T00:00:00.000Z',
+      end: '2024-06-01T00:00:00.000Z',
+    })
+  );
+});
+
+test('books an item and returns a booking with an id', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+  });
+
+  assert.equal(booking.itemId, 'board-1');
+  assert.equal(booking.start, '2024-06-01T00:00:00.000Z');
+  assert.equal(booking.end, '2024-06-04T00:00:00.000Z');
+  assert.equal(booking.total, 6000);
+  assert.equal(typeof booking.id, 'string');
+  assert.notEqual(booking.id, '');
+});
+
+test('book throws for an unknown item', () => {
+  const service = createRentalService();
+
+  assert.throws(() =>
+    service.book({
+      itemId: 'missing',
+      start: '2024-06-01T00:00:00.000Z',
+      end: '2024-06-02T00:00:00.000Z',
+    })
+  );
+});
+
+test('book throws when the item is already booked for an overlapping period', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+  });
+
+  assert.throws(() =>
+    service.book({
+      itemId: 'board-1',
+      start: '2024-06-03T00:00:00.000Z',
+      end: '2024-06-05T00:00:00.000Z',
+    })
+  );
+});
+
+test('books the same item for two back-to-back periods without overlap', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+  });
+
+  const second = service.book({
+    itemId: 'board-1',
+    start: '2024-06-04T00:00:00.000Z',
+    end: '2024-06-06T00:00:00.000Z',
+  });
+
+  assert.equal(second.total, 4000);
+});
+
+test('books the same period on two different items without conflict', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+
+  const boardBooking = service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-02T00:00:00.000Z',
+  });
+  const sailBooking = service.book({
+    itemId: 'sail-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-02T00:00:00.000Z',
+  });
+
+  assert.notEqual(boardBooking.id, sailBooking.id);
+});
+
+test('addEquipment rejects a duplicate item id', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+
+  assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'sail', dailyPrice: 1500 }));
+});
+
+test('addEquipment rejects an invalid kind', () => {
+  const service = createRentalService();
+
+  assert.throws(() =>
+    // @ts-expect-error exercising runtime validation of an invalid kind
+    service.addEquipment({ id: 'board-1', kind: 'kite', dailyPrice: 2000 })
+  );
+});
+
+test('addEquipment rejects a non-integer daily price', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 19.99 }));
+});
