   total: number;
 }
 
-/** The rental desk service: register equipment, quote and book rentals. */
+/** A request for the equipment free over a whole-day period, optionally restricted to one kind. */
+export interface AvailabilityQuery {
+  start: string;
+  end: string;
+  kind?: EquipmentKind;
+}
+
+/** The rental desk service: register equipment, quote and book rentals, and check availability. */
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  availability(query: AvailabilityQuery): string[];
 }
 
 function isUtcMidnight(date: Date): boolean {
@@ -132,5 +140,25 @@ export function createRentalService(): RentalService {
     return booking;
   }
 
-  return { addEquipment, quote, book };
+  function availability(query: AvailabilityQuery): string[] {
+    wholeDaysBetween(query.start, query.end);
+    const start = new Date(query.start);
+    const end = new Date(query.end);
+    const ids: string[] = [];
+    for (const item of equipment.values()) {
+      if (query.kind !== undefined && item.kind !== query.kind) {
+        continue;
+      }
+      const bookings = bookingsByItem.get(item.id) ?? [];
+      const isBooked = bookings.some((booking) =>
+        overlaps(start, end, new Date(booking.start), new Date(booking.end))
+      );
+      if (!isBooked) {
+        ids.push(item.id);
+      }
+    }
+    return ids.sort();
+  }
+
+  return { addEquipment, quote, book, availability };
 }
