@@ -0,0 +1,26 @@
+---
+id: task-002-add-availability-query-to-rental-service
+type: task
+title: "Add availability query to rental service"
+status: approved
+---
+
+## Request
+
+Add `availability(query)` to `createRentalService()`'s `RentalService`, where `query` is
+`{ start, end, kind }` with `kind` optional. It returns the sorted ids of the equipment of that kind, or
+of any kind when none is given, that is free for the whole period.
+
+## What was done
+
+- Added failing tests first (red) in `src/index.test.ts`: a kind-filtered query excluding a booked item, a
+  query with no `kind` covering every kind, a back-to-back booking not blocking the following period
+  (consistent with the existing half-open interval semantics), and an invalid (non-whole-day) period
+  throwing.
+- Implemented `availability(query)` in `src/index.ts` (green): validates the period with the existing
+  `wholeDaysBetween` (reused from `quote`/`book`, so the same whole-UTC-day rule applies), filters
+  equipment by `kind` when given, excludes any item with a booking overlapping the query period using the
+  existing `overlaps` half-open check, and returns the remaining ids sorted.
+- Added `AvailabilityQuery` to the exported types and extended `RentalService` with `availability`; updated
+  the service's doc comment to mention availability.
+- All 16 tests pass (`node --test`); no new dependency was added.
diff --git a/src/index.test.ts b/src/index.test.ts
index 69389a2d566eaa3778ff006b4ed16aecc5173361..5bd2760cbbb3edbcb87e736959403330dbb27a63 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -164,3 +164,66 @@ test('addEquipment rejects a non-integer daily price', () => {
 
   assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 19.99 }));
 });
+
+test('availability returns the free items of a kind, sorted', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2000 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  service.book({
+    itemId: 'board-2',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-03T00:00:00.000Z',
+  });
+
+  const ids = service.availability({
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-03T00:00:00.000Z',
+    kind: 'board',
+  });
+
+  assert.deepEqual(ids, ['board-1']);
+});
+
+test('availability returns free items of any kind when none is given', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+
+  const ids = service.availability({
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-03T00:00:00.000Z',
+  });
+
+  assert.deepEqual(ids, ['board-1', 'sail-1']);
+});
+
+test('availability treats a back-to-back booking as not blocking the next period', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+  });
+
+  const ids = service.availability({
+    start: '2024-06-04T00:00:00.000Z',
+    end: '2024-06-06T00:00:00.000Z',
+    kind: 'board',
+  });
+
+  assert.deepEqual(ids, ['board-1']);
+});
+
+test('availability throws when the period is not whole days', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+
+  assert.throws(() =>
+    service.availability({
+      start: '2024-06-01T10:00:00.000Z',
+      end: '2024-06-02T00:00:00.000Z',
+    })
+  );
+});
