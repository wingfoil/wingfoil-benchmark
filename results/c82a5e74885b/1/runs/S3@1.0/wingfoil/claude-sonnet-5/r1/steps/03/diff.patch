+/** The full price for a period, less 10% for a rental of 3 days or more, rounded to the nearest cent. */
+function priceFor(days: number, dailyPrice: number): number {
+  const fullPrice = days * dailyPrice;
+  if (days < LONG_RENTAL_DAYS) {
+    return fullPrice;
+  }
+  return Math.round(fullPrice * (1 - LONG_RENTAL_DISCOUNT));
+}
