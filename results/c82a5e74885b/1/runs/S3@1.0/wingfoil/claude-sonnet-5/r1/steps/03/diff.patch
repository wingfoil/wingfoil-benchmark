+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+
+  const result = service.quote({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-03T00:00:00.000Z',
+  });
+
+  assert.equal(result.total, 4000);
+});
+
+test('quote applies a 10% discount for a rental of exactly 3 days', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+
+  const result = service.quote({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+  });
+
+  assert.equal(result.total, 5400);
+});
+
+test('quote applies a 10% discount for a rental of more than 3 days, rounded to the nearest cent', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1501 });
+
+  const result = service.quote({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+  });
+
+  assert.equal(result.total, 4053);
+});
+
+test('book applies the long-rental discount to the stored booking total', () => {
