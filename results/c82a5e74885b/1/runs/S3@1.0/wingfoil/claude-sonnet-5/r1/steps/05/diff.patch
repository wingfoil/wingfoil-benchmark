+/**
+ * The refund for cancelling a booking at a given time: the full total if cancelled before the rental
+ * starts, nothing if cancelled at or after it ends, otherwise the total prorated by the unused part of
+ * the period, rounded to the nearest cent.
+ */
+function refundFor(booking: Booking, at: Date): number {
+  const start = new Date(booking.start).getTime();
+  const end = new Date(booking.end).getTime();
+  const atMs = at.getTime();
+  if (atMs <= start) {
+    return booking.total;
+  }
+  if (atMs >= end) {
+    return 0;
+  }
+  return Math.round((booking.total * (end - atMs)) / (end - start));
+}
