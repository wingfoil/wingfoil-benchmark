+test('cancel refunds the full total when cancelled before the booking starts', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+  });
+
+  const cancellation = service.cancel(booking.id, '2024-05-31T00:00:00.000Z');
+
+  assert.deepEqual(cancellation, { bookingId: booking.id, refund: 5400 });
+});
+
+test('cancel refunds nothing when cancelled at or after the booking ends', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+  });
+
+  const cancellation = service.cancel(booking.id, '2024-06-04T00:00:00.000Z');
+
+  assert.equal(cancellation.refund, 0);
+});
+
+test('cancel prorates the refund for a cancellation during the booking', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1000 });
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-05T00:00:00.000Z',
+  });
+
+  const cancellation = service.cancel(booking.id, '2024-06-03T00:00:00.000Z');
+
+  assert.equal(cancellation.refund, 1800);
+});
+
+test('a cancelled booking no longer holds its equipment', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+  });
+
+  service.cancel(booking.id, '2024-05-31T00:00:00.000Z');
+
+  const ids = service.availability({
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+    kind: 'board',
+  });
+  assert.deepEqual(ids, ['board-1']);
+  assert.doesNotThrow(() =>
+    service.book({
+      itemId: 'board-1',
+      start: '2024-06-01T00:00:00.000Z',
+      end: '2024-06-04T00:00:00.000Z',
+    })
+  );
+});
+
+test('cancel throws for an unknown booking id', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.cancel('missing', '2024-06-01T00:00:00.000Z'));
+});
+
+test('cancel throws when the booking was already cancelled', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+  });
+  service.cancel(booking.id, '2024-05-31T00:00:00.000Z');
+
+  assert.throws(() => service.cancel(booking.id, '2024-06-01T00:00:00.000Z'));
+});
+
+test('cancel throws when at is not a valid date', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+  });
+
+  assert.throws(() => service.cancel(booking.id, 'not-a-date'));
+});
+
