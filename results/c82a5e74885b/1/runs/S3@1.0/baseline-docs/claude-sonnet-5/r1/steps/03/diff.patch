diff --git a/src/pricing.ts b/src/pricing.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3b41a11cb1b13e1bffa17adc27885d878cb8b048
--- /dev/null
+++ b/src/pricing.ts
@@ -0,0 +1,15 @@
+const LONG_RENTAL_THRESHOLD_DAYS = 3;
+const LONG_RENTAL_DISCOUNT = 0.1;
+
+/**
+ * Prices a rental of the given number of whole days at the given daily price. Rentals of
+ * {@link LONG_RENTAL_THRESHOLD_DAYS} days or more are discounted by {@link LONG_RENTAL_DISCOUNT},
+ * rounded to the nearest cent.
+ */
+export function priceForDays(dailyPrice: number, days: number): number {
+  const fullPrice = dailyPrice * days;
+  if (days < LONG_RENTAL_THRESHOLD_DAYS) {
+    return fullPrice;
+  }
+  return Math.round(fullPrice * (1 - LONG_RENTAL_DISCOUNT));
+}
