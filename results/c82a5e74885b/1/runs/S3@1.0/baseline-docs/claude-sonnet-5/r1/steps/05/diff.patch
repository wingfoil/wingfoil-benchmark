+test('cancels a booking and refunds the full amount paid', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-03T00:00:00.000Z',
+  });
+
+  const result = service.cancel(booking.id, '2024-05-20T00:00:00.000Z');
+
+  assert.deepEqual(result, { bookingId: booking.id, refund: 4000 });
+});
+
+test('a cancelled booking no longer holds its equipment', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-03T00:00:00.000Z',
+  });
+
+  service.cancel(booking.id, '2024-05-20T00:00:00.000Z');
+
+  assert.doesNotThrow(() =>
+    service.book({
+      itemId: 'board-1',
+      start: '2024-06-01T00:00:00.000Z',
+      end: '2024-06-03T00:00:00.000Z',
+    }),
+  );
+});
+
+test('cancel throws for an unknown booking', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.cancel('missing', '2024-05-20T00:00:00.000Z'));
+});
+
+test('cancel throws when the booking is already cancelled', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-03T00:00:00.000Z',
+  });
+  service.cancel(booking.id, '2024-05-20T00:00:00.000Z');
+
+  assert.throws(() => service.cancel(booking.id, '2024-05-21T00:00:00.000Z'));
+});
+
+test('cancel throws for an unparseable cancellation time', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-03T00:00:00.000Z',
+  });
+
+  assert.throws(() => service.cancel(booking.id, 'not-a-date'));
+});
+
