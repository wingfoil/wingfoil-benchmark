@@ -0,0 +1,16 @@
+import type { Equipment } from './types.ts';
+
+/** Validates an equipment item at the system boundary. Throws when it is invalid. */
+export function validateEquipment(item: Equipment): void {
+  if (typeof item.id !== 'string' || item.id.trim() === '') {
+    throw new Error('Equipment id must be a non-empty string');
+  }
+
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error(`Equipment kind must be 'board' or 'sail', got: ${String(item.kind)}`);
+  }
+
+  if (!Number.isInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('Equipment dailyPrice must be a non-negative integer number of cents');
+  }
+}
