index 0000000000000000000000000000000000000000..551c2cb4bc07b08a7685e61dcf7f56aa726ddffd
--- /dev/null
+++ b/src/period.ts
@@ -0,0 +1,43 @@
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+/** A validated rental period: both ends at UTC midnight, spanning whole days. */
+export interface Period {
+  startMs: number;
+  endMs: number;
+  days: number;
+}
+
+/**
+ * Parses and validates a rental period. Throws when either bound is not a valid UTC-midnight
+ * ISO-8601 timestamp, or when the end is not strictly after the start.
+ */
+export function parsePeriod(start: string, end: string): Period {
+  const startMs = parseUtcMidnight(start, 'start');
+  const endMs = parseUtcMidnight(end, 'end');
+
+  if (endMs <= startMs) {
+    throw new Error(`Invalid period: end (${end}) must be after start (${start})`);
+  }
+
+  return { startMs, endMs, days: (endMs - startMs) / MS_PER_DAY };
+}
+
+function parseUtcMidnight(value: string, field: string): number {
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms)) {
+    throw new Error(`Invalid ${field}: ${value} is not a valid ISO-8601 date`);
+  }
+
+  const date = new Date(ms);
+  const isMidnight =
+    date.getUTCHours() === 0 &&
+    date.getUTCMinutes() === 0 &&
+    date.getUTCSeconds() === 0 &&
+    date.getUTCMilliseconds() === 0;
+
+  if (!isMidnight) {
+    throw new Error(`Invalid ${field}: ${value} must be at UTC midnight`);
+  }
+
+  return ms;
+}
