index 0000000000000000000000000000000000000000..a3aca672d1203ac7145cdd8caea3a74455b455f8
--- /dev/null
+++ b/src/rental-service.ts
@@ -0,0 +1,64 @@
+import type { Booking, Equipment, Quote, RentalRequest, RentalService } from './types.ts';
+import { parsePeriod } from './period.ts';
+import { validateEquipment } from './validation.ts';
+
+/** Creates a rental service that keeps equipment, quotes and bookings in memory. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Booking[] = [];
+  let nextBookingId = 1;
+
+  function findEquipment(itemId: string): Equipment {
+    const item = equipment.get(itemId);
+    if (!item) {
+      throw new Error(`Unknown item: ${itemId}`);
+    }
+    return item;
+  }
+
+  function priceFor(item: Equipment, start: string, end: string): { total: number; startMs: number; endMs: number } {
+    const { startMs, endMs, days } = parsePeriod(start, end);
+    return { total: days * item.dailyPrice, startMs, endMs };
+  }
+
+  function overlapsExistingBooking(itemId: string, startMs: number, endMs: number): boolean {
+    return bookings.some(
+      (booking) =>
+        booking.itemId === itemId &&
+        Date.parse(booking.start) < endMs &&
+        startMs < Date.parse(booking.end),
+    );
+  }
+
+  function addEquipment(item: Equipment): void {
+    validateEquipment(item);
+    equipment.set(item.id, item);
+  }
+
+  function quote(request: RentalRequest): Quote {
+    const item = findEquipment(request.itemId);
+    const { total } = priceFor(item, request.start, request.end);
+    return { itemId: item.id, start: request.start, end: request.end, total };
+  }
+
+  function book(request: RentalRequest): Booking {
+    const item = findEquipment(request.itemId);
+    const { total, startMs, endMs } = priceFor(item, request.start, request.end);
+
+    if (overlapsExistingBooking(item.id, startMs, endMs)) {
+      throw new Error(`Item ${item.id} is already booked for part of that period`);
+    }
+
+    const booking: Booking = {
+      id: String(nextBookingId++),
+      itemId: item.id,
+      start: request.start,
+      end: request.end,
+      total,
+    };
+    bookings.push(booking);
+    return booking;
+  }
+
+  return { addEquipment, quote, book };
+}
