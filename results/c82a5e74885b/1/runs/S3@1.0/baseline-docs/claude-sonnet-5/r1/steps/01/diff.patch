@@ -0,0 +1,51 @@
+/** A board or a sail that the school can rent out. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item: its identity, kind, and daily price in euro cents. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one day of rental, in integer euro cents. */
+  dailyPrice: number;
+}
+
+/** A request to price or book an item for a period of whole UTC days. */
+export interface RentalRequest {
+  itemId: string;
+  /** ISO-8601 UTC timestamp at midnight: the first day of the period. */
+  start: string;
+  /** ISO-8601 UTC timestamp at midnight: the start of the day after the last day of the period. */
+  end: string;
+}
+
+/** The price of renting an item for a period, before any booking is made. */
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  /** Total price for the period, in integer euro cents. */
+  total: number;
+}
+
+/** A confirmed rental of an item for a period. */
+export interface Booking {
+  id: string;
+  itemId: string;
+  start: string;
+  end: string;
+  /** Total price for the period, in integer euro cents. */
+  total: number;
+}
+
+/** The booking desk's rental module: equipment, quotes and bookings, kept in memory. */
+export interface RentalService {
+  /** Registers an item as available for rental. Throws if the item is invalid. */
+  addEquipment(item: Equipment): void;
+  /** Prices a rental request. Throws for an unknown item or a period the rules do not allow. */
+  quote(request: RentalRequest): Quote;
+  /**
+   * Books a rental request. Throws for an unknown item, a period the rules do not allow, or
+   * when the item is not free for the whole period.
+   */
+  book(request: RentalRequest): Booking;
+}
