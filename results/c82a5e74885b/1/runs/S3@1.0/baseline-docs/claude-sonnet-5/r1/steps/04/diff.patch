+
+test('addEquipment accepts an item with an hourly price', () => {
+  const service = createRentalService();
+
+  assert.doesNotThrow(() =>
+    service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 400 }),
+  );
+});
+
+test('addEquipment throws for a non-integer hourly price', () => {
+  const service = createRentalService();
+
+  assert.throws(() =>
+    service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 2500, hourlyPrice: 4.5 }),
+  );
+});
+
+test('addEquipment throws for a negative hourly price', () => {
+  const service = createRentalService();
+
+  assert.throws(() =>
+    service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 2500, hourlyPrice: -1 }),
+  );
+});
+
