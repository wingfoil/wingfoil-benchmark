+
+  assert.equal(booking.total, 1200);
+  assert.equal(typeof booking.id, 'string');
+});
+
+test('book throws for an hourly rental on an item without an hourly price', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+
+  assert.throws(() =>
+    service.book({
+      itemId: 'board-1',
+      start: '2024-06-01T13:00:00.000Z',
+      end: '2024-06-01T16:00:00.000Z',
+    }),
+  );
+});
+
+test('an hourly booking blocks overlapping hourly and daily bookings of the same item', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 400 });
+  service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T13:00:00.000Z',
+    end: '2024-06-01T16:00:00.000Z',
+  });
+
+  assert.throws(() =>
+    service.book({
+      itemId: 'board-1',
+      start: '2024-06-01T15:00:00.000Z',
+      end: '2024-06-01T18:00:00.000Z',
+    }),
+  );
+  assert.throws(() =>
+    service.book({
+      itemId: 'board-1',
+      start: '2024-06-01T00:00:00.000Z',
+      end: '2024-06-02T00:00:00.000Z',
+    }),
+  );
+});
+
+test('availability excludes an item with an hourly booking overlapping the queried hours', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 400 });
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500, hourlyPrice: 400 });
+  service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T13:00:00.000Z',
+    end: '2024-06-01T16:00:00.000Z',
+  });
+
+  const result = service.availability({
+    start: '2024-06-01T14:00:00.000Z',
+    end: '2024-06-01T15:00:00.000Z',
+    kind: 'board',
+  });
+
+  assert.deepEqual(result, ['board-2']);
+});
