+    start: '2024-06-01T13:00:00.000Z',
+    end: '2024-06-01T16:00:00.000Z',
+  });
+
+  assert.deepEqual(result, {
+    itemId: 'board-1',
+    start: '2024-06-01T13:00:00.000Z',
+    end: '2024-06-01T16:00:00.000Z',
+    total: 1200,
+  });
+});
+
+test('quotes a 1-hour rental at the item\'s hourly price', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 400 });
+
+  const result = service.quote({
+    itemId: 'board-1',
+    start: '2024-06-01T13:00:00.000Z',
+    end: '2024-06-01T14:00:00.000Z',
+  });
+
+  assert.equal(result.total, 400);
+});
+
+test('quote throws for an hourly rental on an item without an hourly price', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+
+  assert.throws(() =>
+    service.quote({
+      itemId: 'board-1',
+      start: '2024-06-01T13:00:00.000Z',
+      end: '2024-06-01T16:00:00.000Z',
+    }),
+  );
+});
+
+test('quote throws for a sub-day period that does not start and end on the hour', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 400 });
+
+  assert.throws(() =>
+    service.quote({
+      itemId: 'board-1',
+      start: '2024-06-01T13:30:00.000Z',
+      end: '2024-06-01T16:00:00.000Z',
+    }),
+  );
+});
+
+test('quote throws for a 24-hour period that is not midnight-to-midnight', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 400 });
+
+  assert.throws(() =>
+    service.quote({
+      itemId: 'board-1',
