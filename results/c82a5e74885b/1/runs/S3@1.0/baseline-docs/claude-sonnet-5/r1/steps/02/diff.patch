-import type { Booking, Equipment, Quote, RentalRequest, RentalService } from './types.ts';
+import type { AvailabilityQuery, Booking, Equipment, Quote, RentalRequest, RentalService } from './types.ts';
 import { parsePeriod } from './period.ts';
-import { validateEquipment } from './validation.ts';
+import { validateAvailabilityQuery, validateEquipment } from './validation.ts';
 
 /** Creates a rental service that keeps equipment, quotes and bookings in memory. */
 export function createRentalService(): RentalService {
@@ -60,5 +60,21 @@ export function createRentalService(): RentalService {
     return booking;
   }
 
-  return { addEquipment, quote, book };
+  function availability(query: AvailabilityQuery): string[] {
+    validateAvailabilityQuery(query);
+    const { startMs, endMs } = parsePeriod(query.start, query.end);
+
+    const ids: string[] = [];
+    for (const item of equipment.values()) {
+      if (query.kind !== undefined && item.kind !== query.kind) {
+        continue;
+      }
+      if (!overlapsExistingBooking(item.id, startMs, endMs)) {
+        ids.push(item.id);
+      }
+    }
+    return ids.sort();
+  }
+
+  return { addEquipment, quote, book, availability };
 }
