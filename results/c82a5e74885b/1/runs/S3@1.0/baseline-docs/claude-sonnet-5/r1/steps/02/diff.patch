+/** Validates an availability query at the system boundary. Throws when the kind is invalid. */
+export function validateAvailabilityQuery(query: AvailabilityQuery): void {
+  if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+    throw new Error(`Equipment kind must be 'board' or 'sail', got: ${String(query.kind)}`);
+  }
