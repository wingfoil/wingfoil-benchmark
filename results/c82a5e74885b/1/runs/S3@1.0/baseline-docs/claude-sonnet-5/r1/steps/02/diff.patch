diff --git a/src/rental-service.test.ts b/src/rental-service.test.ts
index 4eefb6ec427a9f0c20609abec61d1624fbe41f8f..4d5f19fddb2ac18b781a3aab97cdfdaee6a762e3 100644
--- a/src/rental-service.test.ts
+++ b/src/rental-service.test.ts
@@ -207,3 +207,102 @@ test('addEquipment throws for an empty id', () => {
 
   assert.throws(() => service.addEquipment({ id: '', kind: 'board', dailyPrice: 100 }));
 });
+
+test('availability returns the sorted ids of every item free for the period when no kind is given', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1000 });
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2000 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+
+  const result = service.availability({
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-03T00:00:00.000Z',
+  });
+
+  assert.deepEqual(result, ['board-1', 'board-2', 'sail-1']);
+});
+
+test('availability only returns items of the requested kind', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1000 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+
+  const result = service.availability({
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-03T00:00:00.000Z',
+    kind: 'board',
+  });
+
+  assert.deepEqual(result, ['board-1']);
+});
+
+test('availability excludes an item booked for part of the period', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2000 });
+  service.book({
+    itemId: 'board-1',
+    start: '2024-06-02T00:00:00.000Z',
+    end: '2024-06-04T00:00:00.000Z',
+  });
+
+  const result = service.availability({
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-03T00:00:00.000Z',
+    kind: 'board',
+  });
+
+  assert.deepEqual(result, ['board-2']);
+});
+
+test('availability includes an item whose booking is back-to-back with the requested period', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+  service.book({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-03T00:00:00.000Z',
+  });
+
+  const result = service.availability({
+    start: '2024-06-03T00:00:00.000Z',
+    end: '2024-06-05T00:00:00.000Z',
+  });
+
+  assert.deepEqual(result, ['board-1']);
+});
+
+test('availability returns an empty array when nothing matches the requested kind', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1000 });
+
+  const result = service.availability({
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-03T00:00:00.000Z',
+    kind: 'board',
+  });
+
+  assert.deepEqual(result, []);
+});
+
+test('availability throws for an invalid period', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2000 });
+
+  assert.throws(() =>
+    service.availability({
+      start: '2024-06-02T00:00:00.000Z',
+      end: '2024-06-01T00:00:00.000Z',
+    }),
+  );
+});
+
+test('availability throws for an invalid kind', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.availability({
+    start: '2024-06-01T00:00:00.000Z',
+    end: '2024-06-02T00:00:00.000Z',
+    kind: 'kite',
+  } as never));
+});
