+test('cancel before the rental starts refunds the full total', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', start: '2024-06-01T00:00:00.000Z', end: '2024-06-04T00:00:00.000Z' });
+  const cancellation = rental.cancel(booking.id, '2024-05-30T00:00:00.000Z');
+  assert.deepEqual(cancellation, { bookingId: booking.id, refund: booking.total });
+});
+
+test('cancel after the rental ends refunds nothing', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', start: '2024-06-01T00:00:00.000Z', end: '2024-06-04T00:00:00.000Z' });
+  const cancellation = rental.cancel(booking.id, '2024-06-05T00:00:00.000Z');
+  assert.equal(cancellation.refund, 0);
+});
+
+test('cancel part way through the rental refunds the unused portion', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', start: '2024-06-01T00:00:00.000Z', end: '2024-06-05T00:00:00.000Z' });
+  const cancellation = rental.cancel(booking.id, '2024-06-02T00:00:00.000Z');
+  assert.equal(cancellation.refund, booking.total * 0.75);
+});
+
+test('cancel frees the equipment so it can be booked again for the same period', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', start: '2024-06-01T00:00:00.000Z', end: '2024-06-05T00:00:00.000Z' });
+  rental.cancel(booking.id, '2024-06-02T00:00:00.000Z');
+  const ids = rental.availability({ start: '2024-06-01T00:00:00.000Z', end: '2024-06-05T00:00:00.000Z' });
+  assert.ok(ids.includes('board-1'));
+  const rebooking = rental.book({ itemId: 'board-1', start: '2024-06-01T00:00:00.000Z', end: '2024-06-05T00:00:00.000Z' });
+  assert.ok(rebooking.id);
+});
+
+test('cancel throws for an unknown booking id', () => {
+  const rental = service();
+  assert.throws(() => rental.cancel('nope', '2024-06-01T00:00:00.000Z'));
+});
+
+test('cancel throws when the booking was already cancelled', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', start: '2024-06-01T00:00:00.000Z', end: '2024-06-04T00:00:00.000Z' });
+  rental.cancel(booking.id, '2024-06-01T00:00:00.000Z');
+  assert.throws(() => rental.cancel(booking.id, '2024-06-02T00:00:00.000Z'));
+});
+
