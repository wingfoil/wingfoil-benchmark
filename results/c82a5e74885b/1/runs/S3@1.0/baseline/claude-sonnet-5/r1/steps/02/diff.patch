diff --git a/test/rental-service.test.ts b/test/rental-service.test.ts
index 053a8786794d4fcde1cce4a3ebfc1f7752f8e910..2b9f81b5f48b2f081360c998ae399226f8b25df0 100644
--- a/test/rental-service.test.ts
+++ b/test/rental-service.test.ts
@@ -71,3 +71,35 @@ test('book does not block the same period on a different item', () => {
   const booking = rental.book({ itemId: 'sail-1', start: '2024-06-01T00:00:00.000Z', end: '2024-06-05T00:00:00.000Z' });
   assert.equal(booking.itemId, 'sail-1');
 });
+
+test('availability returns every item of every kind when free and no kind is given', () => {
+  const rental = service();
+  const ids = rental.availability({ start: '2024-06-01T00:00:00.000Z', end: '2024-06-03T00:00:00.000Z' });
+  assert.deepEqual(ids, ['board-1', 'sail-1']);
+});
+
+test('availability filters by kind', () => {
+  const rental = service();
+  const ids = rental.availability({ start: '2024-06-01T00:00:00.000Z', end: '2024-06-03T00:00:00.000Z', kind: 'sail' });
+  assert.deepEqual(ids, ['sail-1']);
+});
+
+test('availability excludes items booked for an overlapping period', () => {
+  const rental = service();
+  rental.book({ itemId: 'board-1', start: '2024-06-01T00:00:00.000Z', end: '2024-06-05T00:00:00.000Z' });
+  const ids = rental.availability({ start: '2024-06-03T00:00:00.000Z', end: '2024-06-07T00:00:00.000Z' });
+  assert.deepEqual(ids, ['sail-1']);
+});
+
+test('availability includes items whose booking ends right when the query starts', () => {
+  const rental = service();
+  rental.book({ itemId: 'board-1', start: '2024-06-01T00:00:00.000Z', end: '2024-06-05T00:00:00.000Z' });
+  const ids = rental.availability({ start: '2024-06-05T00:00:00.000Z', end: '2024-06-07T00:00:00.000Z' });
+  assert.deepEqual(ids, ['board-1', 'sail-1']);
+});
+
+test('availability throws when the period is invalid', () => {
+  const rental = service();
+  assert.throws(() => rental.availability({ start: '2024-06-02T00:00:00.000Z', end: '2024-06-01T00:00:00.000Z' }));
+  assert.throws(() => rental.availability({ start: '2024-06-01T10:00:00.000Z', end: '2024-06-02T00:00:00.000Z' }));
+});
