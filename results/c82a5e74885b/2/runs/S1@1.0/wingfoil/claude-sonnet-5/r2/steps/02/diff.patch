+}
+
+function isProperPrefix(prefix: readonly string[], of: readonly string[]): boolean {
+  return prefix.length < of.length && prefix.every((token, index) => token === of[index]);
+}
+
+function validateOperation(raw: unknown): JsonPatchOperation {
+  if (!isContainer(raw) || Array.isArray(raw)) {
+    throw new Error(`Invalid JSON Patch operation: ${JSON.stringify(raw)}`);
+  }
+  const operation = raw as Record<string, unknown>;
+  if (typeof operation.path !== "string") {
+    throw new Error(`JSON Patch operation is missing a "path" string: ${JSON.stringify(raw)}`);
+  }
+
+  switch (operation.op) {
+    case "add":
+    case "replace":
+    case "test":
+      if (!Object.prototype.hasOwnProperty.call(operation, "value")) {
+        throw new Error(
+          `JSON Patch "${operation.op}" operation is missing "value": ${JSON.stringify(raw)}`,
+        );
+      }
+      return { op: operation.op, path: operation.path, value: operation.value };
+    case "move":
+    case "copy":
+      if (typeof operation.from !== "string") {
+        throw new Error(
+          `JSON Patch "${operation.op}" operation is missing a "from" string: ${JSON.stringify(raw)}`,
+        );
+      }
+      return { op: operation.op, path: operation.path, from: operation.from };
+    case "remove":
+      return { op: "remove", path: operation.path };
+    default:
+      throw new Error(`Unknown JSON Patch operation: ${JSON.stringify(operation.op)}`);
+  }
+}
+
+function applyOperation(root: RootHolder, operation: JsonPatchOperation): void {
+  switch (operation.op) {
+    case "add": {
+      const { container, key } = locate(root, operation.path);
+      insertMember(container, key, structuredClone(operation.value), operation.path);
+      break;
+    }
+    case "remove": {
+      if (parsePointer(operation.path).length === 0) {
+        throw new Error('JSON Patch "remove" cannot remove the whole document');
+      }
+      const { container, key } = locate(root, operation.path);
+      deleteMember(container, key, operation.path);
+      break;
+    }
+    case "replace": {
+      const { container, key } = locate(root, operation.path);
+      readMember(container, key, operation.path);
+      setMember(container, key, structuredClone(operation.value), operation.path);
+      break;
+    }
+    case "move": {
+      const fromTokens = parsePointer(operation.from);
+      if (fromTokens.length === 0) {
+        throw new Error('JSON Patch "move" cannot move the whole document');
+      }
+      if (isProperPrefix(fromTokens, parsePointer(operation.path))) {
+        throw new Error(
+          `JSON Patch "move" cannot move ${JSON.stringify(operation.from)} into itself`,
+        );
+      }
+      const source = locate(root, operation.from);
+      const value = readMember(source.container, source.key, operation.from);
+      deleteMember(source.container, source.key, operation.from);
+      const destination = locate(root, operation.path);
+      insertMember(destination.container, destination.key, value, operation.path);
+      break;
+    }
+    case "copy": {
+      const source = locate(root, operation.from);
+      const value = readMember(source.container, source.key, operation.from);
+      const destination = locate(root, operation.path);
+      insertMember(destination.container, destination.key, structuredClone(value), operation.path);
+      break;
+    }
+    case "test": {
+      const { container, key } = locate(root, operation.path);
+      const actual = readMember(container, key, operation.path);
+      if (!deepEqual(actual, operation.value)) {
+        throw new Error(`JSON Patch "test" operation failed at ${JSON.stringify(operation.path)}`);
+      }
+      break;
+    }
+  }
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the
+ * resulting document as a new value, without mutating `document` or `patch`.
+ *
+ * @throws if `patch` is not a syntactically valid JSON Patch, or if one of
+ * its operations fails against `document`.
+ */
+export function applyPatch(document: unknown, patch: JsonPatchOperation[]): unknown {
+  if (!Array.isArray(patch)) {
+    throw new TypeError("JSON Patch must be an array of operations");
+  }
+
+  const root: RootHolder = { value: structuredClone(document) };
+  for (const raw of patch) {
+    applyOperation(root, validateOperation(raw));
+  }
+  return root.value;
+}
