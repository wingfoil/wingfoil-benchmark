diff --git a/src/index.test.ts b/src/index.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ef6ba1b6769d5f75e110c2f4f88cb9adeb5bfa05
--- /dev/null
+++ b/src/index.test.ts
@@ -0,0 +1,92 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "./index.ts";
+
+const document = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  "k\"l": 6,
+  " ": 7,
+  "m~n": 8,
+  nested: { deeper: { value: "found" } },
+  flag: false,
+  nil: null,
+};
+
+test("empty pointer resolves to the whole document", () => {
+  assert.equal(resolvePointer(document, ""), document);
+});
+
+test("resolves a top-level object member", () => {
+  assert.deepEqual(resolvePointer(document, "/foo"), ["bar", "baz"]);
+});
+
+test("resolves a nested object member", () => {
+  assert.equal(resolvePointer(document, "/nested/deeper/value"), "found");
+});
+
+test("resolves an array element by index", () => {
+  assert.equal(resolvePointer(document, "/foo/0"), "bar");
+  assert.equal(resolvePointer(document, "/foo/1"), "baz");
+});
+
+test("resolves falsy values (false, null, 0) as valid results", () => {
+  assert.equal(resolvePointer(document, "/flag"), false);
+  assert.equal(resolvePointer(document, "/nil"), null);
+  assert.equal(resolvePointer(document, "/"), 0);
+});
+
+test("unescapes ~1 to / and ~0 to ~ in reference tokens", () => {
+  assert.equal(resolvePointer(document, "/a~1b"), 1);
+  assert.equal(resolvePointer(document, "/m~0n"), 8);
+});
+
+test("resolves members whose names need no escaping", () => {
+  assert.equal(resolvePointer(document, "/c%d"), 2);
+  assert.equal(resolvePointer(document, "/e^f"), 3);
+  assert.equal(resolvePointer(document, "/g|h"), 4);
+  assert.equal(resolvePointer(document, "/i\\j"), 5);
+  assert.equal(resolvePointer(document, "/k\"l"), 6);
+  assert.equal(resolvePointer(document, "/ "), 7);
+});
+
+test("throws when a pointer does not start with /", () => {
+  assert.throws(() => resolvePointer(document, "foo"));
+});
+
+test("throws when the pointer is not a string", () => {
+  // @ts-expect-error exercising runtime validation of a non-string input
+  assert.throws(() => resolvePointer(document, 42));
+});
+
+test("throws when an object member does not exist", () => {
+  assert.throws(() => resolvePointer(document, "/missing"));
+});
+
+test("throws when an array index is out of bounds", () => {
+  assert.throws(() => resolvePointer(document, "/foo/2"));
+});
+
+test("throws when an array index has a leading zero or is not a number", () => {
+  assert.throws(() => resolvePointer(document, "/foo/01"));
+  assert.throws(() => resolvePointer(document, "/foo/a"));
+});
+
+test("throws when using - to index an array (no such element)", () => {
+  assert.throws(() => resolvePointer(document, "/foo/-"));
+});
+
+test("throws when traversing through a scalar value", () => {
+  assert.throws(() => resolvePointer(document, "/flag/x"));
+  assert.throws(() => resolvePointer(document, "/nil/x"));
+});
+
+test("throws on an invalid escape sequence", () => {
+  assert.throws(() => resolvePointer(document, "/a~2b"));
+  assert.throws(() => resolvePointer(document, "/trailing~"));
+});
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..583a004f90f935354cda80163dd995a1d63f4719
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,55 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document and returns the
+ * value it refers to.
+ *
+ * @throws if `pointer` is not a syntactically valid JSON Pointer, or if it
+ * does not resolve to a value within `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new TypeError("JSON Pointer must be a string");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (pointer[0] !== "/") {
+    throw new Error(`Invalid JSON Pointer: ${JSON.stringify(pointer)}`);
+  }
+
+  let current: unknown = document;
+
+  for (const rawToken of pointer.split("/").slice(1)) {
+    if (/~(?![01])/.test(rawToken)) {
+      throw new Error(`Invalid JSON Pointer: ${JSON.stringify(pointer)}`);
+    }
+    const token = rawToken.replace(/~1/g, "/").replace(/~0/g, "~");
+
+    if (Array.isArray(current)) {
+      if (!/^(?:0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(
+          `JSON Pointer ${JSON.stringify(pointer)} does not resolve to a value`,
+        );
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new Error(
+          `JSON Pointer ${JSON.stringify(pointer)} does not resolve to a value`,
+        );
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(
+          `JSON Pointer ${JSON.stringify(pointer)} does not resolve to a value`,
+        );
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(
+        `JSON Pointer ${JSON.stringify(pointer)} does not resolve to a value`,
+      );
+    }
+  }
+
+  return current;
+}
