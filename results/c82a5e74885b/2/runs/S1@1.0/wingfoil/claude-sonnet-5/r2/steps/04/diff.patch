 });
+
+// --- applyMergePatch ---
+// Numbered cases are the literal examples from RFC 7386 Appendix A.
+
+test("1. replaces an existing member", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: "c" }), { a: "c" });
+});
+
+test("2. adds a new member", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { b: "c" }), { a: "b", b: "c" });
+});
+
+test("3. a null value removes the member it targets", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: null }), {});
+});
+
+test("4. null removes only the targeted member, others survive", () => {
+  assert.deepEqual(applyMergePatch({ a: "b", b: "c" }, { a: null }), { b: "c" });
+});
+
+test("5. a scalar patch value replaces an array wholesale", () => {
+  assert.deepEqual(applyMergePatch({ a: ["b"] }, { a: "c" }), { a: "c" });
+});
+
+test("6. an array patch value replaces a scalar wholesale", () => {
+  assert.deepEqual(applyMergePatch({ a: "c" }, { a: ["b"] }), { a: ["b"] });
+});
+
+test("7. merges nested objects recursively, applying null deletions within them", () => {
+  assert.deepEqual(applyMergePatch({ a: { b: "c" } }, { a: { b: "d", c: null } }), {
+    a: { b: "d" },
+  });
+});
+
+test("8. an array member is replaced wholesale, not merged element-by-element", () => {
+  assert.deepEqual(applyMergePatch({ a: [{ b: "c" }] }, { a: [1] }), { a: [1] });
+});
+
+test("9. two arrays at the root: the patch array replaces the target array", () => {
+  assert.deepEqual(applyMergePatch(["a", "b"], ["c", "d"]), ["c", "d"]);
+});
+
+test("10. a non-object patch at the root replaces the whole target", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, ["c"]), ["c"]);
+});
+
+test("11. a null patch at the root replaces the whole target with null", () => {
+  assert.equal(applyMergePatch({ a: "foo" }, null), null);
+});
+
+test("12. a scalar patch at the root replaces the whole target", () => {
+  assert.equal(applyMergePatch({ a: "foo" }, "bar"), "bar");
+});
+
+test("13. an existing null-valued member is left alone; the patch only adds", () => {
+  assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+});
+
+test("14. a non-object target is discarded in favour of an empty object before merging", () => {
+  assert.deepEqual(applyMergePatch([1, 2], { a: "b", c: null }), { a: "b" });
+});
+
+test("15. a deletion nested two levels deep leaves the now-empty ancestor object in place", () => {
+  assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+});
+
+test("null for a member that does not exist is a no-op, not an error", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { c: null }), { a: "b" });
+});
+
+test("does not mutate the input target", () => {
+  const nested = { value: 1 };
+  const target = { foo: nested, list: [1, 2] };
+  const snapshot = JSON.parse(JSON.stringify(target));
+
+  applyMergePatch(target, { foo: { value: 99 }, list: [0] });
+
+  assert.deepEqual(target, snapshot);
+  assert.equal(target.foo, nested);
+});
+
+test("does not let the returned document alias a value from the patch", () => {
+  const nestedPatchValue = { count: 1 };
+  const result = applyMergePatch({}, { added: nestedPatchValue }) as { added: { count: number } };
+
+  result.added.count = 42;
+
+  assert.equal(nestedPatchValue.count, 1);
+});
