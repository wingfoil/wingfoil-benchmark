index 294ec9f25b6ff7b097ebea14210a991b84bb7097..187ee3bef4d672c54310b8792afae789deafbad1 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -319,3 +319,67 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(path: string, from: unknown[], to: unknown[], ops: JsonPatchOperation[]): void {
+  const common = Math.min(from.length, to.length);
+  for (let index = 0; index < common; index++) {
+    diffValues(`${path}/${index}`, from[index], to[index], ops);
+  }
+  for (let index = from.length - 1; index >= to.length; index--) {
+    ops.push({ op: "remove", path: `${path}/${index}` });
+  }
+  for (let index = from.length; index < to.length; index++) {
+    ops.push({ op: "add", path: `${path}/${index}`, value: structuredClone(to[index]) });
+  }
+}
+
+function diffObjects(
+  path: string,
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  ops: JsonPatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.prototype.hasOwnProperty.call(to, key)) {
+      ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const childPath = `${path}/${escapeToken(key)}`;
+    if (!Object.prototype.hasOwnProperty.call(from, key)) {
+      ops.push({ op: "add", path: childPath, value: structuredClone(to[key]) });
+    } else {
+      diffValues(childPath, from[key], to[key], ops);
+    }
+  }
+}
+
+function diffValues(path: string, from: unknown, to: unknown, ops: JsonPatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(path, from, to, ops);
+    return;
+  }
+  if (isMergeableObject(from) && isMergeableObject(to)) {
+    diffObjects(path, from, to, ops);
+    return;
+  }
+  ops.push({ op: "replace", path, value: structuredClone(to) });
+}
+
+/**
+ * Computes a JSON Patch (RFC 6902) that, when applied to `from` with
+ * `applyPatch`, produces `to`. Neither `from` nor `to` is mutated, and the
+ * patch describes only the members and array elements that actually changed.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const ops: JsonPatchOperation[] = [];
+  diffValues("", from, to, ops);
+  return ops;
+}
