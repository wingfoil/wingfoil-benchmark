+test("createPatch: a scalar replacing an array is a wholesale replace, not an element diff", () => {
+  assert.deepEqual(createPatch([1, 2], "x"), [{ op: "replace", path: "", value: "x" }]);
+});
+
+test("createPatch: the resulting patch applies cleanly to turn from into to", () => {
+  const from = { title: "Draft", tags: ["a", "b"], list: [1, 2, 3], author: { name: "Alex" } };
+  const to = { title: "Published", tags: ["a", "b", "c"], list: [1, 9], author: { email: "a@b.c" } };
