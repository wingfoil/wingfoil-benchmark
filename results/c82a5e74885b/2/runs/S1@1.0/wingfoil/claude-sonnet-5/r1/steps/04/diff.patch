+/**
+ * Applies a JSON Merge Patch, as specified in RFC 7386, to a target JSON document and returns the
+ * merged document as a new value; `target` is never mutated.
+ *
+ * A `patch` that is a JSON object is merged into `target` member by member: a member set to `null` is
+ * removed from the result, and any other member overwrites or (if both sides are objects) recursively
+ * merges into the corresponding member of `target`. A `patch` that is not a JSON object - including an
+ * array, or `null` - replaces the whole of `target`.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonObject(patch)) {
+    return structuredClone(patch);
+  }
+
+  const result: Record<string, unknown> = isJsonObject(target)
+    ? (structuredClone(target) as Record<string, unknown>)
+    : {};
+
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(getMember(result, key), value));
+    }
+  }
+
+  return result;
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+// Reads an own member only: a plain read of an absent key named "__proto__" would otherwise return
+// Object.prototype itself, since that name is also an inherited accessor on every plain object.
+function getMember(object: Record<string, unknown>, key: string): unknown {
+  return Object.prototype.hasOwnProperty.call(object, key) ? object[key] : undefined;
+}
+
+// Plain assignment would invoke Object.prototype's "__proto__" accessor instead of creating an own
+// member, silently repointing the object's prototype instead of setting a member named "__proto__".
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
