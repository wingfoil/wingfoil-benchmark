diff --git a/src/index.test.ts b/src/index.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..44afff00e2bfe3e7687e1c22e920fd9580ac60e2
--- /dev/null
+++ b/src/index.test.ts
@@ -0,0 +1,75 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { resolvePointer, JsonPointerError } from './index.ts';
+
+// The document and expected resolutions below are the worked example from RFC 6901 §5.
+const rfcExample = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+test('RFC 6901 §5 worked example', () => {
+  assert.equal(resolvePointer(rfcExample, ''), rfcExample);
+  assert.deepEqual(resolvePointer(rfcExample, '/foo'), ['bar', 'baz']);
+  assert.equal(resolvePointer(rfcExample, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(rfcExample, '/'), 0);
+  assert.equal(resolvePointer(rfcExample, '/a~1b'), 1);
+  assert.equal(resolvePointer(rfcExample, '/c%d'), 2);
+  assert.equal(resolvePointer(rfcExample, '/e^f'), 3);
+  assert.equal(resolvePointer(rfcExample, '/g|h'), 4);
+  assert.equal(resolvePointer(rfcExample, '/i\\j'), 5);
+  assert.equal(resolvePointer(rfcExample, '/k"l'), 6);
+  assert.equal(resolvePointer(rfcExample, '/ '), 7);
+  assert.equal(resolvePointer(rfcExample, '/m~0n'), 8);
+});
+
+test('resolves nested objects and arrays', () => {
+  const document = { a: { b: [{ c: 'deep' }] } };
+  assert.equal(resolvePointer(document, '/a/b/0/c'), 'deep');
+});
+
+test('rejects a pointer that does not start with "/"', () => {
+  assert.throws(() => resolvePointer({}, 'foo'), JsonPointerError);
+});
+
+test('rejects a non-string pointer', () => {
+  // @ts-expect-error exercising runtime validation of a non-string input
+  assert.throws(() => resolvePointer({}, 42), JsonPointerError);
+});
+
+test('rejects a "~" escape not followed by "0" or "1"', () => {
+  assert.throws(() => resolvePointer({ '~x': 1 }, '/~x'), JsonPointerError);
+});
+
+test('rejects a reference token for a member that does not exist', () => {
+  assert.throws(() => resolvePointer({ a: 1 }, '/b'), JsonPointerError);
+});
+
+test('rejects an array index that is out of bounds', () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, '/a/2'), JsonPointerError);
+});
+
+test('rejects an array index with a leading zero', () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, '/a/01'), JsonPointerError);
+});
+
+test('rejects the "-" array index, which never resolves to a value', () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, '/a/-'), JsonPointerError);
+});
+
+test('rejects stepping into a primitive value', () => {
+  assert.throws(() => resolvePointer({ a: 1 }, '/a/b'), JsonPointerError);
+});
+
+test('rejects stepping into null', () => {
+  assert.throws(() => resolvePointer({ a: null }, '/a/b'), JsonPointerError);
+});
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3788a6dcca6b6cc373da24975262b812d6ea90b0
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,65 @@
+/**
+ * Thrown by {@link resolvePointer} when a string is not a valid JSON Pointer, or when a valid pointer
+ * does not resolve to a value within the given document.
+ */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'JsonPointerError';
+  }
+}
+
+const ESCAPE_PATTERN = /^(?:[^~]|~[01])*$/;
+const ARRAY_INDEX_PATTERN = /^(?:0|[1-9][0-9]*)$/;
+
+/**
+ * Resolves a JSON Pointer, as specified in RFC 6901, against a JSON document and returns the value it
+ * refers to.
+ *
+ * @throws {JsonPointerError} if `pointer` is not a valid JSON Pointer, or if it does not resolve to a
+ * value within `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== 'string') {
+    throw new JsonPointerError('A JSON Pointer must be a string.');
+  }
+  if (pointer === '') {
+    return document;
+  }
+  if (pointer[0] !== '/') {
+    throw new JsonPointerError(`Invalid JSON Pointer: "${pointer}".`);
+  }
+
+  let current: unknown = document;
+  for (const rawToken of pointer.split('/').slice(1)) {
+    current = step(current, decodeToken(rawToken, pointer), pointer);
+  }
+  return current;
+}
+
+// RFC 6901 §4: decode "~1" before "~0", since the encoding step escapes "~" first and then "/" - doing
+// the reverse here would turn an original "~1" token into "/" instead of restoring it.
+function decodeToken(rawToken: string, pointer: string): string {
+  if (!ESCAPE_PATTERN.test(rawToken)) {
+    throw new JsonPointerError(`Invalid JSON Pointer: "${pointer}".`);
+  }
+  return rawToken.replace(/~1/g, '/').replace(/~0/g, '~');
+}
+
+function step(current: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX_PATTERN.test(token) || Number(token) >= current.length) {
+      throw new JsonPointerError(`JSON Pointer "${pointer}" does not resolve to a value.`);
+    }
+    return current[Number(token)];
+  }
+
+  if (typeof current === 'object' && current !== null) {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new JsonPointerError(`JSON Pointer "${pointer}" does not resolve to a value.`);
+    }
+    return (current as Record<string, unknown>)[token];
+  }
+
+  throw new JsonPointerError(`JSON Pointer "${pointer}" does not resolve to a value.`);
+}
