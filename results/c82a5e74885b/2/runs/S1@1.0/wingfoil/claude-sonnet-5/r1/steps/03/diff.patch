+test('"add" clones its value, so the same literal used twice is not aliased', () => {
+  const shared = { x: 1 };
+  const result = applyPatch({}, [
+    { op: 'add', path: '/a', value: shared },
+    { op: 'add', path: '/b', value: shared },
+  ]) as { a: { x: number }; b: { x: number } };
+  assert.notEqual(result.a, result.b);
+  (result.a as { x: number }).x = 999;
+  assert.equal(result.b.x, 1);
+});
+
+test('"add" clones its value, so mutating the caller\'s value afterwards has no effect', () => {
+  const value: { x: number } = { x: 1 };
+  const result = applyPatch({}, [{ op: 'add', path: '/a', value }]) as { a: { x: number } };
+  value.x = 999;
+  assert.equal(result.a.x, 1);
+});
+
+test('"replace" clones its value, so mutating the caller\'s value afterwards has no effect', () => {
+  const value: { x: number } = { x: 1 };
+  const result = applyPatch({ a: 0 }, [{ op: 'replace', path: '/a', value }]) as { a: { x: number } };
+  value.x = 999;
+  assert.equal(result.a.x, 1);
+});
+
 test('does not mutate the input document', () => {
   const document = { foo: ['bar', 'baz'] };
   const snapshot = structuredClone(document);
@@ -247,3 +272,25 @@ test('rejects moving a value into one of its own children', () => {
     JsonPointerError,
   );
 });
+
+// Object members named like prototype internals must behave as plain data members.
+
+test('"add" can add a member literally named "__proto__"', () => {
+  const result = applyPatch({}, [{ op: 'add', path: '/__proto__', value: { polluted: true } }]) as Record<
+    string,
+    unknown
+  >;
+  assert.equal(Object.prototype.hasOwnProperty.call(result, '__proto__'), true);
+  assert.deepEqual(result.__proto__, { polluted: true });
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test('"replace" on a member literally named "__proto__" replaces its own value', () => {
+  const document = JSON.parse('{"__proto__": 1}') as Record<string, unknown>;
+  const result = applyPatch(document, [{ op: 'replace', path: '/__proto__', value: 2 }]) as Record<
+    string,
+    unknown
+  >;
+  assert.equal(Object.prototype.hasOwnProperty.call(result, '__proto__'), true);
+  assert.equal(result.__proto__, 2);
+});
