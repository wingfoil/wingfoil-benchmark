+  if (Array.isArray(parent)) {
+    if (lastToken === '-') {
+      parent.push(value);
+      return;
+    }
+    if (!ARRAY_INDEX_PATTERN.test(lastToken) || Number(lastToken) > parent.length) {
+      throw new JsonPointerError(`JSON Pointer "${pointer}" does not resolve to a valid array index.`);
+    }
+    parent.splice(Number(lastToken), 0, value);
+    return;
+  }
+
+  if (typeof parent === 'object' && parent !== null) {
+    (parent as Record<string, unknown>)[lastToken] = value;
+    return;
+  }
+
+  throw new JsonPointerError(`JSON Pointer "${pointer}" does not resolve to a value.`);
