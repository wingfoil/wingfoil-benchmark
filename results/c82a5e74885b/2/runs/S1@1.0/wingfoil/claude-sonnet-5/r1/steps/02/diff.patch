+/**
+ * Thrown by {@link applyPatch} when a patch document is malformed, or when a "test" operation fails.
+ * Failures to resolve a "path" or "from" JSON Pointer throw {@link JsonPointerError} instead.
+ */
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'JsonPatchError';
+  }
+}
+
+/** A single operation of a JSON Patch, as specified in RFC 6902. */
+export interface JsonPatchOperation {
+  readonly op: 'add' | 'remove' | 'replace' | 'move' | 'copy' | 'test';
+  readonly path: string;
+  readonly from?: string;
+  readonly value?: unknown;
+}
+
+const PATCH_OPS = new Set(['add', 'remove', 'replace', 'move', 'copy', 'test']);
+
+/**
+ * Applies a JSON Patch, as specified in RFC 6902, to a JSON document and returns the resulting
+ * document as a new value. `document` is never mutated.
+ *
+ * @throws {JsonPatchError} if `patch` is not a well-formed JSON Patch, or if a "test" operation fails.
+ * @throws {JsonPointerError} if an operation's "path" or "from" is not a valid JSON Pointer, or does
+ * not resolve to a value where the operation requires one to already exist.
+ */
+export function applyPatch(document: unknown, patch: readonly JsonPatchOperation[]): unknown {
+  if (!Array.isArray(patch)) {
+    throw new JsonPatchError('A JSON Patch must be an array of operations.');
+  }
+
+  const box: { doc: unknown } = { doc: structuredClone(document) };
+  for (const rawOperation of patch) {
+    applyOperation(box, validateOperation(rawOperation));
+  }
+  return box.doc;
+}
+
+function validateOperation(rawOperation: unknown): JsonPatchOperation {
+  if (typeof rawOperation !== 'object' || rawOperation === null || Array.isArray(rawOperation)) {
+    throw new JsonPatchError(`Invalid JSON Patch operation: ${JSON.stringify(rawOperation)}.`);
+  }
+
+  const { op, path, from, value } = rawOperation as Record<string, unknown>;
+  if (typeof op !== 'string' || !PATCH_OPS.has(op)) {
+    throw new JsonPatchError(`Invalid JSON Patch operation "op": ${JSON.stringify(op)}.`);
+  }
+  if (typeof path !== 'string') {
+    throw new JsonPatchError(`Operation "${op}" requires a string "path".`);
+  }
+  if ((op === 'move' || op === 'copy') && typeof from !== 'string') {
+    throw new JsonPatchError(`Operation "${op}" requires a string "from".`);
+  }
+  if (
+    (op === 'add' || op === 'replace' || op === 'test') &&
+    !Object.prototype.hasOwnProperty.call(rawOperation, 'value')
+  ) {
+    throw new JsonPatchError(`Operation "${op}" requires a "value".`);
+  }
+
+  return { op, path, from: from as string | undefined, value } as JsonPatchOperation;
+}
+
+function applyOperation(box: { doc: unknown }, operation: JsonPatchOperation): void {
+  switch (operation.op) {
+    case 'add':
+      addAt(box, operation.path, operation.value);
+      return;
+    case 'remove':
+      removeAt(box, operation.path);
+      return;
+    case 'replace':
+      replaceAt(box, operation.path, operation.value);
+      return;
+    case 'move': {
+      const value = resolvePointer(box.doc, operation.from as string);
+      removeAt(box, operation.from as string);
+      addAt(box, operation.path, value);
+      return;
+    }
+    case 'copy': {
+      const value = resolvePointer(box.doc, operation.from as string);
+      addAt(box, operation.path, structuredClone(value));
+      return;
+    }
+    case 'test': {
+      const actual = resolvePointer(box.doc, operation.path);
+      if (!deepEqual(actual, operation.value)) {
+        throw new JsonPatchError(`Test failed: "${operation.path}" does not hold the expected value.`);
+      }
+      return;
+    }
