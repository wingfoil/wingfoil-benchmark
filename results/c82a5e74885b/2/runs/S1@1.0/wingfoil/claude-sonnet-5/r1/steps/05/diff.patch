+/**
+ * Produces a JSON Patch, as specified in RFC 6902, that turns `from` into `to` when applied via
+ * {@link applyPatch}. The patch describes only what changed: unchanged members and array elements are
+ * left out rather than replacing the whole document. Neither `from` nor `to` is mutated, nor
+ * referenced by the returned patch.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const operations: JsonPatchOperation[] = [];
+  diffValues('', from, to, operations);
+  return operations;
+}
+
+function diffValues(path: string, from: unknown, to: unknown, operations: JsonPatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (isJsonObject(from) && isJsonObject(to)) {
+    diffObjects(path, from, to, operations);
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(path, from, to, operations);
+    return;
+  }
+  operations.push({ op: 'replace', path, value: structuredClone(to) });
+}
+
+function diffObjects(
+  path: string,
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  operations: JsonPatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    const memberPath = `${path}/${encodeToken(key)}`;
+    if (!Object.prototype.hasOwnProperty.call(to, key)) {
+      operations.push({ op: 'remove', path: memberPath });
+    } else {
+      diffValues(memberPath, from[key], to[key], operations);
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (!Object.prototype.hasOwnProperty.call(from, key)) {
+      operations.push({ op: 'add', path: `${path}/${encodeToken(key)}`, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+// Isolates the differing middle of the two arrays behind their common prefix and suffix, then either
+// diffs that middle element-by-element (when it doesn't change length) or replaces it wholesale -
+// cheap to compute and exact for the common cases (an appended/removed/changed run), though not a
+// globally minimal edit script (e.g. it won't detect an element that moved).
+function diffArrays(path: string, from: unknown[], to: unknown[], operations: JsonPatchOperation[]): void {
+  const maxPrefix = Math.min(from.length, to.length);
+  let prefixLength = 0;
+  while (prefixLength < maxPrefix && deepEqual(from[prefixLength], to[prefixLength])) {
+    prefixLength += 1;
+  }
+
+  const maxSuffix = maxPrefix - prefixLength;
+  let suffixLength = 0;
+  while (
+    suffixLength < maxSuffix &&
+    deepEqual(from[from.length - 1 - suffixLength], to[to.length - 1 - suffixLength])
+  ) {
+    suffixLength += 1;
+  }
+
+  const fromMiddle = from.slice(prefixLength, from.length - suffixLength);
+  const toMiddle = to.slice(prefixLength, to.length - suffixLength);
+
+  if (fromMiddle.length === toMiddle.length) {
+    fromMiddle.forEach((item, index) => {
+      diffValues(`${path}/${prefixLength + index}`, item, toMiddle[index], operations);
+    });
+    return;
+  }
+
+  // Remove from the end backwards so each removal's index is still valid after the previous one.
+  for (let index = fromMiddle.length - 1; index >= 0; index -= 1) {
+    operations.push({ op: 'remove', path: `${path}/${prefixLength + index}` });
+  }
+  toMiddle.forEach((item, index) => {
+    operations.push({ op: 'add', path: `${path}/${prefixLength + index}`, value: structuredClone(item) });
+  });
+}
+
+// Encodes a reference token per RFC 6901 §3, the reverse of decodeToken's escape order: "~" must be
+// escaped to "~0" before "/" is escaped to "~1", otherwise the "~" introduced by escaping "/" would
+// itself get escaped.
+function encodeToken(token: string): string {
+  return token.replace(/~/g, '~0').replace(/\//g, '~1');
+}
+
 function deepEqual(a: unknown, b: unknown): boolean {
   if (a === b) {
     return true;
