index 0000000000000000000000000000000000000000..3786f489fefaa11916f774f9bc32df151ac91f25
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,57 @@
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @param document - The JSON document to resolve the pointer against.
+ * @param pointer - A JSON Pointer string, e.g. `"/foo/0"`. The empty string refers to the whole document.
+ * @returns The value the pointer refers to.
+ * @throws {Error} If `pointer` is not syntactically a valid JSON Pointer, or does not resolve to a value in `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  return parsePointer(pointer).reduce<unknown>(
+    (value, token) => resolveToken(value, token, pointer),
+    document,
+  );
+}
+
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== 'string') {
+    throw new TypeError('A JSON Pointer must be a string.');
+  }
+  if (pointer === '') {
+    return [];
+  }
+  if (!pointer.startsWith('/')) {
+    throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/".`);
+  }
+  return pointer.split('/').slice(1).map(unescapeToken);
+}
+
+function unescapeToken(token: string): string {
+  return token.replace(/~1/g, '/').replace(/~0/g, '~');
+}
+
+function resolveToken(value: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(value)) {
+    if (!ARRAY_INDEX.test(token)) {
+      throw new Error(`Invalid JSON Pointer "${pointer}": "${token}" is not a valid array index.`);
+    }
+    const index = Number(token);
+    if (index >= value.length) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve to a value: index ${index} is out of bounds.`);
+    }
+    return value[index];
+  }
+  if (isJsonObject(value)) {
+    if (!Object.prototype.hasOwnProperty.call(value, token)) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve to a value: no member "${token}".`);
+    }
+    return value[token];
+  }
+  throw new Error(`JSON Pointer "${pointer}" does not resolve to a value: cannot index into ${typeof value}.`);
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
diff --git a/test/index.test.ts b/test/index.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e6cbc79c393746b734218ad92b6d729d8745e3b8
--- /dev/null
+++ b/test/index.test.ts
@@ -0,0 +1,66 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { resolvePointer } from '../src/index.ts';
+
+// Document from RFC 6901 §5.
+const document = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+test('empty pointer resolves to the whole document', () => {
+  assert.deepEqual(resolvePointer(document, ''), document);
+});
+
+test('resolves a top-level member', () => {
+  assert.deepEqual(resolvePointer(document, '/foo'), ['bar', 'baz']);
+});
+
+test('resolves an array element by index', () => {
+  assert.equal(resolvePointer(document, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(document, '/foo/1'), 'baz');
+});
+
+test('resolves members needing escape decoding', () => {
+  assert.equal(resolvePointer(document, '/'), 0);
+  assert.equal(resolvePointer(document, '/a~1b'), 1);
+  assert.equal(resolvePointer(document, '/c%d'), 2);
+  assert.equal(resolvePointer(document, '/e^f'), 3);
+  assert.equal(resolvePointer(document, '/g|h'), 4);
+  assert.equal(resolvePointer(document, '/i\\j'), 5);
+  assert.equal(resolvePointer(document, '/k"l'), 6);
+  assert.equal(resolvePointer(document, '/ '), 7);
+  assert.equal(resolvePointer(document, '/m~0n'), 8);
+});
+
+test('rejects a pointer that does not start with "/"', () => {
+  assert.throws(() => resolvePointer(document, 'foo'));
+});
+
+test('rejects an out-of-bounds array index', () => {
+  assert.throws(() => resolvePointer(document, '/foo/2'));
+});
+
+test('rejects "-" as an array index, since it names no value', () => {
+  assert.throws(() => resolvePointer(document, '/foo/-'));
+});
+
+test('rejects a non-canonical array index', () => {
+  assert.throws(() => resolvePointer(document, '/foo/01'));
+});
+
+test('rejects indexing into a scalar', () => {
+  assert.throws(() => resolvePointer(document, '/foo/0/bar'));
+});
+
+test('rejects a member that does not exist', () => {
+  assert.throws(() => resolvePointer(document, '/missing'));
+});
