--- a/src/index.ts
+++ b/src/index.ts
@@ -260,12 +260,21 @@ function addAt(container: unknown, key: string, value: unknown, pointer: string)
     return;
   }
   if (isJsonObject(container)) {
-    container[key] = value;
+    setMember(container, key, value);
     return;
   }
   throw new Error(`JSON Patch "add" failed at "${pointer}": cannot add into ${typeof container}.`);
 }
 
+/**
+ * Sets an object member by its literal name, including names such as `__proto__` that would
+ * otherwise be intercepted by `Object.prototype`'s inherited accessor instead of creating a real,
+ * own, enumerable member.
+ */
+function setMember(container: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(container, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
 function removeAt(container: unknown, key: string, pointer: string): unknown {
   if (Array.isArray(container)) {
     const index = parseArrayIndex(key, pointer);
@@ -298,7 +307,7 @@ function replaceAt(container: unknown, key: string, value: unknown, pointer: str
     if (!Object.prototype.hasOwnProperty.call(container, key)) {
       throw new Error(`JSON Patch "replace" failed at "${pointer}": no member "${key}".`);
     }
-    container[key] = value;
+    setMember(container, key, value);
     return;
   }
   throw new Error(`JSON Patch "replace" failed at "${pointer}": cannot replace into ${typeof container}.`);
diff --git a/test/apply-patch.test.ts b/test/apply-patch.test.ts
index c5d324055ed85ca035e0f739c687c890ebd1d6a5..e71212f369820a256c223bece80a814ab071db9d 100644
--- a/test/apply-patch.test.ts
+++ b/test/apply-patch.test.ts
@@ -133,3 +133,18 @@ test('rejects a "move" operation missing "from"', () => {
 test('rejects an operation whose "path" is not syntactically valid', () => {
   assert.throws(() => applyPatch({}, [{ op: 'add', path: 'foo', value: 1 }]));
 });
+
+test('add creates a literal "__proto__" member instead of altering the object prototype', () => {
+  const result = applyPatch({}, [{ op: 'add', path: '/__proto__', value: { polluted: true } }]) as object;
+  assert.equal(Object.prototype.hasOwnProperty.call(result, '__proto__'), true);
+  assert.deepEqual(JSON.parse(JSON.stringify(result)), { ['__proto__']: { polluted: true } });
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test('replace overwrites a literal "__proto__" member without altering the object prototype', () => {
+  const document: Record<string, unknown> = {};
+  Object.defineProperty(document, '__proto__', { value: 1, enumerable: true, configurable: true, writable: true });
+  const result = applyPatch(document, [{ op: 'replace', path: '/__proto__', value: 2 }]) as object;
+  assert.equal(Object.prototype.hasOwnProperty.call(result, '__proto__'), true);
+  assert.deepEqual(JSON.parse(JSON.stringify(result)), { ['__proto__']: 2 });
+});
