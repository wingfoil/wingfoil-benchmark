new file mode 100644
index 0000000000000000000000000000000000000000..2d90225cd6ca54b32922282f4e2f5b16504f8873
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,84 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyMergePatch } from '../src/index.ts';
+
+// Examples from RFC 7386 Appendix A.
+test('replaces an existing member', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { a: 'c' }), { a: 'c' });
+});
+
+test('adds a new member', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { b: 'c' }), { a: 'b', b: 'c' });
+});
+
+test('a null member value removes the only member', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { a: null }), {});
+});
+
+test('a null member value removes one member, leaving the others', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b', b: 'c' }, { a: null }), { b: 'c' });
+});
+
+test('a scalar patch value replaces an array member wholesale', () => {
+  assert.deepEqual(applyMergePatch({ a: ['b'] }, { a: 'c' }), { a: 'c' });
+});
+
+test('an array patch value replaces a scalar member wholesale', () => {
+  assert.deepEqual(applyMergePatch({ a: 'c' }, { a: ['b'] }), { a: ['b'] });
+});
+
+test('object members are merged recursively', () => {
+  assert.deepEqual(applyMergePatch({ a: { b: 'c' } }, { a: { b: 'd', c: null } }), { a: { b: 'd' } });
+});
+
+test('an array patch value replaces an array member wholesale, not element-by-element', () => {
+  assert.deepEqual(applyMergePatch({ a: [{ b: 'c' }] }, { a: [1] }), { a: [1] });
+});
+
+test('an array patch replaces an array target wholesale', () => {
+  assert.deepEqual(applyMergePatch(['a', 'b'], ['c', 'd']), ['c', 'd']);
+});
+
+test('an array patch replaces an object target wholesale', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, ['c']), ['c']);
+});
+
+test('a null patch replaces the whole document', () => {
+  assert.equal(applyMergePatch({ a: 'foo' }, null), null);
+});
+
+test('a scalar patch replaces the whole document', () => {
+  assert.equal(applyMergePatch({ a: 'foo' }, 'bar'), 'bar');
+});
+
+test('a null member value on a target missing that member is a no-op add of nothing', () => {
+  assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+});
+
+test('a patch on a non-object target starts from an empty object, dropping unrelated target content', () => {
+  assert.deepEqual(applyMergePatch([1, 2], { a: 'b', c: null }), { a: 'b' });
+});
+
+test('merging nested objects drops members set to null at every level', () => {
+  assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+});
+
+test('does not mutate the input document', () => {
+  const target = { a: { b: 'c' }, d: ['e'] };
+  applyMergePatch(target, { a: { b: 'z' }, d: null });
+  assert.deepEqual(target, { a: { b: 'c' }, d: ['e'] });
+});
+
+test('merging creates a literal "__proto__" member instead of altering the object prototype', () => {
+  const patch: Record<string, unknown> = {};
+  Object.defineProperty(patch, '__proto__', {
+    value: { polluted: true },
+    enumerable: true,
+    configurable: true,
+    writable: true,
+  });
+  const result = applyMergePatch({}, patch) as object;
+  assert.equal(Object.prototype.hasOwnProperty.call(result, '__proto__'), true);
+  assert.deepEqual(JSON.parse(JSON.stringify(result)), { ['__proto__']: { polluted: true } });
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
