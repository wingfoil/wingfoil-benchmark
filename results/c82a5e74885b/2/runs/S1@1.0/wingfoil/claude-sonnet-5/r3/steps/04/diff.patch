index 352e887f2e3946ad5cebf2c575cfb5132ac5ae97..49973655f38ac562d2c234bc63f8abfd3fdccb65 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -313,6 +313,35 @@ function replaceAt(container: unknown, key: string, value: unknown, pointer: str
   throw new Error(`JSON Patch "replace" failed at "${pointer}": cannot replace into ${typeof container}.`);
 }
 
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document.
+ *
+ * @param target - The JSON document to patch.
+ * @param patch - The merge patch: an object whose members are merged into `target` recursively (a
+ *   `null` member value removes the corresponding member from the result), or any other JSON value,
+ *   which replaces `target` entirely.
+ * @returns The merged document. `target` is never mutated.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonObject(patch)) {
+    return patch;
+  }
+  const result: Record<string, unknown> = isJsonObject(target) ? { ...target } : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(getMember(result, key), value));
+    }
+  }
+  return result;
+}
+
+function getMember(container: Record<string, unknown>, key: string): unknown {
+  return Object.prototype.hasOwnProperty.call(container, key) ? container[key] : undefined;
+}
+
 function deepEqual(a: unknown, b: unknown): boolean {
   if (a === b) {
     return true;
