--- a/src/index.ts
+++ b/src/index.ts
@@ -342,6 +342,124 @@ function getMember(container: Record<string, unknown>, key: string): unknown {
   return Object.prototype.hasOwnProperty.call(container, key) ? container[key] : undefined;
 }
 
+/**
+ * Computes a JSON Patch (RFC 6902) that turns `from` into `to` when applied.
+ *
+ * @param from - The document the patch starts from.
+ * @param to - The document the patch produces when applied to `from`.
+ * @returns An ordered list of operations describing only what changed between `from` and `to`.
+ *   Neither `from` nor `to` is mutated.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatch {
+  const patch: Operation[] = [];
+  diffValues(from, to, '', patch);
+  return patch;
+}
+
+function diffValues(from: unknown, to: unknown, path: string, patch: Operation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (isJsonObject(from) && isJsonObject(to)) {
+    diffObjects(from, to, path, patch);
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, patch);
+    return;
+  }
+  patch.push({ op: 'replace', path, value: to });
+}
+
+function diffObjects(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  path: string,
+  patch: Operation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.prototype.hasOwnProperty.call(to, key)) {
+      patch.push({ op: 'remove', path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const childPath = `${path}/${escapeToken(key)}`;
+    if (!Object.prototype.hasOwnProperty.call(from, key)) {
+      patch.push({ op: 'add', path: childPath, value: to[key] });
+    } else {
+      diffValues(from[key], to[key], childPath, patch);
+    }
+  }
+}
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, '~0').replace(/\//g, '~1');
+}
+
+/**
+ * Diffs two arrays by their longest common subsequence (by deep equality), so that elements shared
+ * between `from` and `to` are left untouched. Within a run of elements that differ, elements are
+ * paired up positionally and diffed recursively (so a changed array element yields a patch local to
+ * what changed inside it, not a wholesale replacement); only a surplus of removed or added elements
+ * within that run falls back to plain `remove`/`add` operations.
+ */
+function diffArrays(from: readonly unknown[], to: readonly unknown[], path: string, patch: Operation[]): void {
+  const lcs = buildLcsTable(from, to);
+  const removedValues: unknown[] = [];
+  const insertedValues: unknown[] = [];
+  let index = 0;
+  let i = 0;
+  let j = 0;
+
+  const flushRun = (): void => {
+    const pairs = Math.min(removedValues.length, insertedValues.length);
+    for (let k = 0; k < pairs; k++) {
+      diffValues(removedValues[k], insertedValues[k], `${path}/${index}`, patch);
+      index++;
+    }
+    for (let k = pairs; k < removedValues.length; k++) {
+      patch.push({ op: 'remove', path: `${path}/${index}` });
+    }
+    for (let k = pairs; k < insertedValues.length; k++) {
+      patch.push({ op: 'add', path: `${path}/${index}`, value: insertedValues[k] });
+      index++;
+    }
+    removedValues.length = 0;
+    insertedValues.length = 0;
+  };
+
+  while (i < from.length || j < to.length) {
+    if (i < from.length && j < to.length && deepEqual(from[i], to[j])) {
+      flushRun();
+      index++;
+      i++;
+      j++;
+      continue;
+    }
+    const preferRemove = i < from.length && (j === to.length || lcs[i + 1][j] >= lcs[i][j + 1]);
+    if (preferRemove) {
+      removedValues.push(from[i]);
+      i++;
+    } else {
+      insertedValues.push(to[j]);
+      j++;
+    }
+  }
+  flushRun();
+}
+
+function buildLcsTable(from: readonly unknown[], to: readonly unknown[]): number[][] {
+  const n = from.length;
+  const m = to.length;
+  const table: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      table[i][j] = deepEqual(from[i], to[j]) ? table[i + 1][j + 1] + 1 : Math.max(table[i + 1][j], table[i][j + 1]);
+    }
+  }
+  return table;
+}
+
 function deepEqual(a: unknown, b: unknown): boolean {
   if (a === b) {
     return true;
