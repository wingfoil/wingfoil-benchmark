index 0000000000000000000000000000000000000000..200242d5d97cdcd3511bc8451689dd725171ec18
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,92 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch, createPatch } from '../src/index.ts';
+
+test('returns an empty patch for identical documents', () => {
+  assert.deepEqual(createPatch({ foo: 'bar' }, { foo: 'bar' }), []);
+});
+
+test('adds a new object member', () => {
+  const patch = createPatch({ foo: 'bar' }, { foo: 'bar', baz: 'qux' });
+  assert.deepEqual(patch, [{ op: 'add', path: '/baz', value: 'qux' }]);
+});
+
+test('removes a member that is no longer present', () => {
+  const patch = createPatch({ foo: 'bar', baz: 'qux' }, { foo: 'bar' });
+  assert.deepEqual(patch, [{ op: 'remove', path: '/baz' }]);
+});
+
+test('replaces a scalar member that changed', () => {
+  const patch = createPatch({ foo: 'bar' }, { foo: 'baz' });
+  assert.deepEqual(patch, [{ op: 'replace', path: '/foo', value: 'baz' }]);
+});
+
+test('recurses into nested objects, touching only the member that changed', () => {
+  const patch = createPatch({ foo: { a: 1, b: 2 } }, { foo: { a: 1, b: 3 } });
+  assert.deepEqual(patch, [{ op: 'replace', path: '/foo/b', value: 3 }]);
+});
+
+test('appends an array element', () => {
+  const patch = createPatch({ foo: ['a'] }, { foo: ['a', 'b'] });
+  assert.deepEqual(patch, [{ op: 'add', path: '/foo/1', value: 'b' }]);
+});
+
+test('removes an array element', () => {
+  const patch = createPatch({ foo: ['a', 'b'] }, { foo: ['a'] });
+  assert.deepEqual(patch, [{ op: 'remove', path: '/foo/1' }]);
+});
+
+test('replaces a single changed array element, leaving the others untouched', () => {
+  const patch = createPatch({ foo: [1, 2, 3] }, { foo: [1, 5, 3] });
+  assert.deepEqual(patch, [{ op: 'replace', path: '/foo/1', value: 5 }]);
+});
+
+test('describes an insertion in the middle of an array without touching the unchanged tail', () => {
+  const patch = createPatch({ foo: ['a', 'c'] }, { foo: ['a', 'b', 'c'] });
+  assert.deepEqual(patch, [{ op: 'add', path: '/foo/1', value: 'b' }]);
+});
+
+test('recurses into an array of objects, describing only the member that changed', () => {
+  const patch = createPatch({ items: [{ id: 1, name: 'a' }] }, { items: [{ id: 1, name: 'b' }] });
+  assert.deepEqual(patch, [{ op: 'replace', path: '/items/0/name', value: 'b' }]);
+});
+
+test('escapes member names containing "/" and "~" in emitted paths', () => {
+  const patch = createPatch({ 'a/b': 1, 'c~d': 1 }, { 'a/b': 2, 'c~d': 2 });
+  assert.deepEqual(patch.length, 2);
+  assert.ok(patch.some((op) => op.path === '/a~1b' && 'value' in op && op.value === 2));
+  assert.ok(patch.some((op) => op.path === '/c~0d' && 'value' in op && op.value === 2));
+});
+
+test('replaces the whole document at the root when the two values are unrelated in shape', () => {
+  const patch = createPatch({ foo: 'bar' }, ['a']);
+  assert.deepEqual(patch, [{ op: 'replace', path: '', value: ['a'] }]);
+});
+
+test('does not mutate either input document', () => {
+  const from = { foo: ['a', 'b'], bar: { x: 1 } };
+  const to = { foo: ['a', 'c'], bar: { x: 2 }, baz: 3 };
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  createPatch(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+});
+
+test('the resulting patch, applied to "from", produces "to"', () => {
+  const cases: [unknown, unknown][] = [
+    [{ foo: 'bar' }, { foo: 'bar' }],
+    [{ foo: 'bar' }, { foo: 'bar', baz: 'qux' }],
+    [{ foo: 'bar', baz: 'qux' }, { foo: 'bar' }],
+    [{ foo: [1, 2, 3] }, { foo: [1, 5, 3] }],
+    [{ foo: ['a', 'c'] }, { foo: ['a', 'b', 'c'] }],
+    [{ items: [{ id: 1, name: 'a' }, { id: 2, name: 'x' }] }, { items: [{ id: 2, name: 'x' }] }],
+    [{ foo: { a: 1, b: 2 } }, { foo: { a: 1, b: 3 }, c: 4 }],
+    [{ foo: 'bar' }, ['a']],
+    [[1, 2], { foo: 'bar' }],
+  ];
+  for (const [from, to] of cases) {
+    const patch = createPatch(from, to);
+    assert.deepEqual(applyPatch(from, patch), to);
+  }
+});
