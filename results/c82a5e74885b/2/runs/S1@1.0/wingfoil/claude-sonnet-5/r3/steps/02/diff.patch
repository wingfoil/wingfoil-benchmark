@@ -52,6 +49,274 @@ function resolveToken(value: unknown, token: string, pointer: string): unknown {
   throw new Error(`JSON Pointer "${pointer}" does not resolve to a value: cannot index into ${typeof value}.`);
 }
 
+function parseArrayIndex(token: string, pointer: string): number {
+  if (!ARRAY_INDEX.test(token)) {
+    throw new Error(`Invalid JSON Pointer "${pointer}": "${token}" is not a valid array index.`);
+  }
+  return Number(token);
+}
+
 function isJsonObject(value: unknown): value is Record<string, unknown> {
   return typeof value === 'object' && value !== null && !Array.isArray(value);
 }
+
+/** A JSON Patch `add` operation (RFC 6902 §4.1). */
+export interface AddOperation {
+  readonly op: 'add';
+  readonly path: string;
+  readonly value: unknown;
+}
+
+/** A JSON Patch `remove` operation (RFC 6902 §4.2). */
+export interface RemoveOperation {
+  readonly op: 'remove';
+  readonly path: string;
+}
+
+/** A JSON Patch `replace` operation (RFC 6902 §4.3). */
+export interface ReplaceOperation {
+  readonly op: 'replace';
+  readonly path: string;
+  readonly value: unknown;
+}
+
+/** A JSON Patch `move` operation (RFC 6902 §4.4). */
+export interface MoveOperation {
+  readonly op: 'move';
+  readonly from: string;
+  readonly path: string;
+}
+
+/** A JSON Patch `copy` operation (RFC 6902 §4.5). */
+export interface CopyOperation {
+  readonly op: 'copy';
+  readonly from: string;
+  readonly path: string;
+}
+
+/** A JSON Patch `test` operation (RFC 6902 §4.6). */
+export interface TestOperation {
+  readonly op: 'test';
+  readonly path: string;
+  readonly value: unknown;
+}
+
+/** One operation of a JSON Patch (RFC 6902). */
+export type Operation =
+  | AddOperation
+  | RemoveOperation
+  | ReplaceOperation
+  | MoveOperation
+  | CopyOperation
+  | TestOperation;
+
+/** A JSON Patch (RFC 6902): an ordered list of operations. */
+export type JsonPatch = readonly Operation[];
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document.
+ *
+ * @param document - The JSON document to patch.
+ * @param patch - An ordered list of operations (`add`, `remove`, `replace`, `move`, `copy`, `test`).
+ * @returns A new document with every operation applied in order. `document` is never mutated.
+ * @throws {Error} If `patch` is not a valid array of operations, or if any operation fails to apply.
+ */
+export function applyPatch(document: unknown, patch: JsonPatch): unknown {
+  if (!Array.isArray(patch)) {
+    throw new TypeError('A JSON Patch must be an array of operations.');
+  }
+  const operations = patch.map(parseOperation);
+  const holder: Record<string, unknown> = { doc: structuredClone(document) };
+  for (const operation of operations) {
+    applyOperation(holder, operation);
+  }
+  return holder.doc;
+}
+
+function parseOperation(raw: unknown): Operation {
+  if (typeof raw !== 'object' || raw === null || Array.isArray(raw)) {
+    throw new TypeError('Invalid JSON Patch: each operation must be an object.');
+  }
+  const op = (raw as { op?: unknown }).op;
+  switch (op) {
+    case 'add':
+      return { op, path: requireString(raw, 'path'), value: requireValue(raw) };
+    case 'remove':
+      return { op, path: requireString(raw, 'path') };
+    case 'replace':
+      return { op, path: requireString(raw, 'path'), value: requireValue(raw) };
+    case 'move':
+      return { op, from: requireString(raw, 'from'), path: requireString(raw, 'path') };
+    case 'copy':
+      return { op, from: requireString(raw, 'from'), path: requireString(raw, 'path') };
+    case 'test':
+      return { op, path: requireString(raw, 'path'), value: requireValue(raw) };
+    default:
+      throw new Error(`Invalid JSON Patch: unknown "op" ${JSON.stringify(op)}.`);
+  }
+}
+
+function requireString(operation: object, field: 'path' | 'from'): string {
+  const value = (operation as Record<string, unknown>)[field];
+  if (typeof value !== 'string') {
+    throw new TypeError(`Invalid JSON Patch operation: "${field}" must be a string.`);
+  }
+  return value;
+}
+
+function requireValue(operation: object): unknown {
+  if (!Object.prototype.hasOwnProperty.call(operation, 'value')) {
+    throw new TypeError('Invalid JSON Patch operation: missing "value".');
+  }
+  return (operation as Record<string, unknown>).value;
+}
+
+function applyOperation(holder: Record<string, unknown>, operation: Operation): void {
+  switch (operation.op) {
+    case 'add':
+      addValue(holder, operation.path, operation.value);
+      return;
+    case 'remove':
+      removeValue(holder, operation.path);
+      return;
+    case 'replace':
+      replaceValue(holder, operation.path, operation.value);
+      return;
+    case 'move':
+      moveValue(holder, operation.from, operation.path);
+      return;
+    case 'copy':
+      copyValue(holder, operation.from, operation.path);
+      return;
+    case 'test':
+      testValue(holder, operation.path, operation.value);
+      return;
+  }
+}
+
+function addValue(holder: Record<string, unknown>, pointer: string, value: unknown): void {
+  const { container, key } = navigateToParent(holder, pointer);
+  addAt(container, key, value, pointer);
+}
+
+function removeValue(holder: Record<string, unknown>, pointer: string): unknown {
+  const { container, key } = navigateToParent(holder, pointer);
+  return removeAt(container, key, pointer);
+}
+
+function replaceValue(holder: Record<string, unknown>, pointer: string, value: unknown): void {
+  const { container, key } = navigateToParent(holder, pointer);
+  replaceAt(container, key, value, pointer);
+}
+
+function moveValue(holder: Record<string, unknown>, from: string, path: string): void {
+  if (isProperPrefix(from, path)) {
+    throw new Error(`JSON Patch "move" failed: "${from}" is a proper prefix of "${path}".`);
+  }
+  const value = removeValue(holder, from);
+  addValue(holder, path, value);
+}
+
+function copyValue(holder: Record<string, unknown>, from: string, path: string): void {
+  const value = resolvePointer(holder.doc, from);
+  addValue(holder, path, structuredClone(value));
+}
+
+function testValue(holder: Record<string, unknown>, pointer: string, expected: unknown): void {
+  const actual = resolvePointer(holder.doc, pointer);
+  if (!deepEqual(actual, expected)) {
+    throw new Error(`JSON Patch "test" failed at "${pointer}": value does not match.`);
+  }
+}
+
+function navigateToParent(
+  holder: Record<string, unknown>,
+  pointer: string,
+): { container: unknown; key: string } {
+  const tokens = ['doc', ...parsePointer(pointer)];
+  const parentTokens = tokens.slice(0, -1);
+  const key = tokens[tokens.length - 1];
+  const container = parentTokens.reduce<unknown>((value, token) => resolveToken(value, token, pointer), holder);
+  return { container, key };
+}
+
+function isProperPrefix(from: string, path: string): boolean {
+  const fromTokens = parsePointer(from);
+  const pathTokens = parsePointer(path);
+  return pathTokens.length > fromTokens.length && fromTokens.every((token, index) => token === pathTokens[index]);
+}
+
+function addAt(container: unknown, key: string, value: unknown, pointer: string): void {
+  if (Array.isArray(container)) {
+    if (key === '-') {
+      container.push(value);
+      return;
+    }
+    const index = parseArrayIndex(key, pointer);
+    if (index > container.length) {
+      throw new Error(`JSON Patch "add" failed at "${pointer}": index ${index} is out of bounds.`);
+    }
+    container.splice(index, 0, value);
+    return;
+  }
+  if (isJsonObject(container)) {
+    container[key] = value;
+    return;
+  }
+  throw new Error(`JSON Patch "add" failed at "${pointer}": cannot add into ${typeof container}.`);
+}
+
+function removeAt(container: unknown, key: string, pointer: string): unknown {
+  if (Array.isArray(container)) {
+    const index = parseArrayIndex(key, pointer);
+    if (index >= container.length) {
+      throw new Error(`JSON Patch "remove" failed at "${pointer}": index ${index} is out of bounds.`);
+    }
+    return container.splice(index, 1)[0];
+  }
+  if (isJsonObject(container)) {
+    if (!Object.prototype.hasOwnProperty.call(container, key)) {
+      throw new Error(`JSON Patch "remove" failed at "${pointer}": no member "${key}".`);
+    }
+    const value = container[key];
+    delete container[key];
+    return value;
+  }
+  throw new Error(`JSON Patch "remove" failed at "${pointer}": cannot remove from ${typeof container}.`);
+}
+
+function replaceAt(container: unknown, key: string, value: unknown, pointer: string): void {
+  if (Array.isArray(container)) {
+    const index = parseArrayIndex(key, pointer);
+    if (index >= container.length) {
+      throw new Error(`JSON Patch "replace" failed at "${pointer}": index ${index} is out of bounds.`);
+    }
+    container[index] = value;
+    return;
+  }
+  if (isJsonObject(container)) {
+    if (!Object.prototype.hasOwnProperty.call(container, key)) {
+      throw new Error(`JSON Patch "replace" failed at "${pointer}": no member "${key}".`);
+    }
+    container[key] = value;
+    return;
+  }
+  throw new Error(`JSON Patch "replace" failed at "${pointer}": cannot replace into ${typeof container}.`);
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (Array.isArray(a) && Array.isArray(b)) {
+    return a.length === b.length && a.every((item, index) => deepEqual(item, b[index]));
+  }
+  if (isJsonObject(a) && isJsonObject(b)) {
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.prototype.hasOwnProperty.call(b, key) && deepEqual(a[key], b[key]))
+    );
+  }
+  return false;
+}
