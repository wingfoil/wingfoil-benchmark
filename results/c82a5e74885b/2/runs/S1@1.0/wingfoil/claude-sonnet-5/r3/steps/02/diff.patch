index 0000000000000000000000000000000000000000..c5d324055ed85ca035e0f739c687c890ebd1d6a5
--- /dev/null
+++ b/test/apply-patch.test.ts
@@ -0,0 +1,135 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch } from '../src/index.ts';
+
+test('add inserts a new object member', () => {
+  const result = applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/baz', value: 'qux' }]);
+  assert.deepEqual(result, { foo: 'bar', baz: 'qux' });
+});
+
+test('add inserts an array element at an index, shifting later elements', () => {
+  const result = applyPatch({ foo: ['a', 'c'] }, [{ op: 'add', path: '/foo/1', value: 'b' }]);
+  assert.deepEqual(result, { foo: ['a', 'b', 'c'] });
+});
+
+test('add appends to an array with "-"', () => {
+  const result = applyPatch({ foo: ['a'] }, [{ op: 'add', path: '/foo/-', value: 'b' }]);
+  assert.deepEqual(result, { foo: ['a', 'b'] });
+});
+
+test('add replaces the whole document at the root pointer', () => {
+  const result = applyPatch({ foo: 'bar' }, [{ op: 'add', path: '', value: { baz: 'qux' } }]);
+  assert.deepEqual(result, { baz: 'qux' });
+});
+
+test('add rejects an out-of-bounds array index', () => {
+  assert.throws(() => applyPatch({ foo: ['a'] }, [{ op: 'add', path: '/foo/5', value: 'b' }]));
+});
+
+test('remove deletes an object member', () => {
+  const result = applyPatch({ foo: 'bar', baz: 'qux' }, [{ op: 'remove', path: '/baz' }]);
+  assert.deepEqual(result, { foo: 'bar' });
+});
+
+test('remove deletes an array element, shifting later elements', () => {
+  const result = applyPatch({ foo: ['a', 'b', 'c'] }, [{ op: 'remove', path: '/foo/1' }]);
+  assert.deepEqual(result, { foo: ['a', 'c'] });
+});
+
+test('remove rejects a member that does not exist', () => {
+  assert.throws(() => applyPatch({ foo: 'bar' }, [{ op: 'remove', path: '/missing' }]));
+});
+
+test('replace overwrites an existing member', () => {
+  const result = applyPatch({ foo: 'bar' }, [{ op: 'replace', path: '/foo', value: 'baz' }]);
+  assert.deepEqual(result, { foo: 'baz' });
+});
+
+test('replace rejects a member that does not exist', () => {
+  assert.throws(() => applyPatch({ foo: 'bar' }, [{ op: 'replace', path: '/missing', value: 1 }]));
+});
+
+test('move relocates a value, removing it from its original location', () => {
+  const result = applyPatch({ foo: { bar: 'baz' }, qux: {} }, [
+    { op: 'move', from: '/foo/bar', path: '/qux/bar' },
+  ]);
+  assert.deepEqual(result, { foo: {}, qux: { bar: 'baz' } });
+});
+
+test('move rejects moving a location into one of its own children', () => {
+  assert.throws(() =>
+    applyPatch({ foo: { bar: 'baz' } }, [{ op: 'move', from: '/foo', path: '/foo/bar' }]),
+  );
+});
+
+test('copy duplicates a value, leaving the original in place', () => {
+  const result = applyPatch({ foo: { bar: 'baz' }, qux: {} }, [
+    { op: 'copy', from: '/foo/bar', path: '/qux/bar' },
+  ]);
+  assert.deepEqual(result, { foo: { bar: 'baz' }, qux: { bar: 'baz' } });
+});
+
+test('copy does not let the new location alias the source', () => {
+  const document = { foo: { bar: 'baz' }, qux: {} };
+  const result = applyPatch(document, [
+    { op: 'copy', from: '/foo', path: '/qux' },
+    { op: 'replace', path: '/qux/bar', value: 'changed' },
+  ]) as { foo: { bar: string }; qux: { bar: string } };
+  assert.equal(result.foo.bar, 'baz');
+  assert.equal(result.qux.bar, 'changed');
+});
+
+test('copy rejects a source that does not exist', () => {
+  assert.throws(() => applyPatch({ foo: {} }, [{ op: 'copy', from: '/missing', path: '/foo/bar' }]));
+});
+
+test('test succeeds when the value matches and leaves the document unchanged', () => {
+  const result = applyPatch({ foo: 'bar' }, [{ op: 'test', path: '/foo', value: 'bar' }]);
+  assert.deepEqual(result, { foo: 'bar' });
+});
+
+test('test is insensitive to object key order', () => {
+  const result = applyPatch({ foo: { a: 1, b: 2 } }, [
+    { op: 'test', path: '/foo', value: { b: 2, a: 1 } },
+  ]);
+  assert.deepEqual(result, { foo: { a: 1, b: 2 } });
+});
+
+test('test fails when the value does not match', () => {
+  assert.throws(() => applyPatch({ foo: 'bar' }, [{ op: 'test', path: '/foo', value: 'baz' }]));
+});
+
+test('applies several operations in order', () => {
+  const result = applyPatch({ foo: ['a', 'b'] }, [
+    { op: 'add', path: '/foo/-', value: 'c' },
+    { op: 'remove', path: '/foo/0' },
+    { op: 'replace', path: '/foo/0', value: 'B' },
+  ]);
+  assert.deepEqual(result, { foo: ['B', 'c'] });
+});
+
+test('does not mutate the input document', () => {
+  const document = { foo: ['a', 'b'] };
+  applyPatch(document, [{ op: 'add', path: '/foo/-', value: 'c' }]);
+  assert.deepEqual(document, { foo: ['a', 'b'] });
+});
+
+test('rejects a patch that is not an array', () => {
+  assert.throws(() => applyPatch({}, { op: 'add', path: '/foo', value: 1 } as unknown as []));
+});
+
+test('rejects an operation with an unknown "op"', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'frobnicate', path: '/foo' } as unknown as never]));
+});
+
+test('rejects an "add" operation missing "value"', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: '/foo' } as unknown as never]));
+});
+
