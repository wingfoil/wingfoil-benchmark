index 0ba99be09dc27a7eee614167cdb832d7d902edd0..2e28c30e0a1863be136d1386998f566b9ec6aea4 100644
--- a/test/json-patch.test.ts
+++ b/test/json-patch.test.ts
@@ -638,3 +638,80 @@ test('keeps the pointer failure that explains an invalid "path" as the error cau
   assert.equal(error.cause.reason, 'invalid-pointer');
   assert.doesNotMatch(error.message, /\.\./, 'the quoted message must not double the full stop');
 });
+
+// --- conformance corners ----------------------------------------------------------------------
+// The points of RFC 6902 that the operation-by-operation tests above leave implicit, and that an
+// implementation can get wrong without any of them noticing.
+
+test('every token on an object is a member name, "-" and digits included', () => {
+  // Only an array gives "-" and the digit strings their RFC 6901 § 4 meaning. On an object they are
+  // ordinary member names, so a patch must not treat them as indices there.
+  assertPatches({}, [{ op: 'add', path: '/-', value: 1 }], { '-': 1 });
+  assertPatches({}, [{ op: 'add', path: '/0', value: 1 }], { '0': 1 });
+  assertPatches({ '-': 1, '0': 2 }, [{ op: 'remove', path: '/-' }], { '0': 2 });
+  assertPatches({ '01': 1 }, [{ op: 'replace', path: '/01', value: 2 }], { '01': 2 });
+  assertPatches({ '': 1 }, [{ op: 'test', path: '/', value: 1 }], { '': 1 });
+});
+
+test('on an array only the array-index form of RFC 6901 § 4 names an element', () => {
+  // A token that is not "0" or digits without a leading zero names no element, whatever JavaScript
+  // would coerce it to; "-" is left out because RFC 6902 § 4.1 gives it a meaning for "add".
+  for (const token of ['00', '01', '1e0', '+1', '-0', ' 1', '1 ', '1.0', '0x1', 'length']) {
+    assertFails([1, 2, 3], [{ op: 'add', path: `/${token}`, value: 9 }], 'operation-failed');
+    assertFails([1, 2, 3], [{ op: 'remove', path: `/${token}` }], 'operation-failed');
+    assertFails([1, 2, 3], [{ op: 'replace', path: `/${token}`, value: 9 }], 'operation-failed');
+    assertFails([1, 2, 3], [{ op: 'copy', from: `/${token}`, path: '/0' }], 'operation-failed');
+    assertFails([1, 2, 3], [{ op: 'test', path: `/${token}`, value: 1 }], 'test-failed');
+  }
+});
+
+test('escaped reference tokens are decoded in "path" and in "from" alike', () => {
+  assertPatches({}, [{ op: 'add', path: '/a~1b', value: 1 }], { 'a/b': 1 });
+  assertPatches({}, [{ op: 'add', path: '/a~0b', value: 1 }], { 'a~b': 1 });
+  assertPatches({ 'a/b': 1 }, [{ op: 'move', from: '/a~1b', path: '/c' }], { c: 1 });
+  assertPatches({ 'a~b': 1 }, [{ op: 'copy', from: '/a~0b', path: '/c' }], { 'a~b': 1, c: 1 });
+  assertPatches({ 'a/b': 1, c: 2 }, [{ op: 'remove', path: '/a~1b' }], { c: 2 });
+  // "~01" is the two characters "~1", not "/": unescaping replaces "~1" before "~0".
+  assertPatches({ '~1': 1, '/': 2 }, [{ op: 'remove', path: '/~01' }], { '/': 2 });
+});
+
+test('move and copy can target the whole document', () => {
+  assertPatches({ a: { b: 1 } }, [{ op: 'move', from: '/a', path: '' }], { b: 1 });
+  assertPatches({ a: 1 }, [{ op: 'copy', from: '/a', path: '' }], 1);
+  assertPatches({ a: 1 }, [{ op: 'copy', from: '', path: '' }], { a: 1 });
+});
+
+test('a member the operation does not define is ignored, malformed or not', () => {
+  // RFC 6902 § 4 has an undefined member ignored "as if [it] did not appear in the object", so its
+  // contents are never validated either: a "from" on an "add" is not parsed as a JSON Pointer.
+  assertPatches({ a: 1 }, [{ op: 'add', path: '/b', value: 2, from: 'not-a-pointer' }], {
+    a: 1,
+    b: 2,
+  });
+  assertPatches({ a: 1, b: 2 }, [{ op: 'remove', path: '/b', from: '/a~b' }], { a: 1 });
+  assertPatches({ a: 1 }, [{ op: 'test', path: '/a', value: 1, from: 7 }], { a: 1 });
+  const moveWithValue = [{ op: 'move', from: '/a', path: '/b', value: undefined }];
+  assertPatches({ a: 1 }, moveWithValue as unknown as JsonValue, { b: 1 });
+});
+
+test('a patch cannot reach an object prototype through its pointers', () => {
+  // "/__proto__" resolves only on a document that declares that member, so the classic pollution
+  // route -- walking into Object.prototype and writing there -- is a failed operation instead.
+  for (const operation of [
+    { op: 'add', path: '/__proto__/polluted', value: true },
+    { op: 'replace', path: '/__proto__/polluted', value: true },
+    { op: 'copy', from: '/a', path: '/__proto__/polluted' },
+    { op: 'move', from: '/a', path: '/__proto__/polluted' },
+    { op: 'add', path: '/constructor/prototype/polluted', value: true },
+  ] as JsonValue[]) {
+    assertFails({ a: 1 }, [operation], 'operation-failed');
+  }
+  assert.equal(({} as { polluted?: boolean }).polluted, undefined);
+});
+
+test('a move whose add fails leaves the document whole, not half-moved', () => {
+  // The remove half of § 4.4 has already run when the add half fails. Because the operations run on
+  // a copy, § 5 still holds: the document keeps the value the move was taking out of it.
+  assertFails({ a: 1, b: [] }, [{ op: 'move', from: '/a', path: '/b/3' }], 'operation-failed');
+  assertFails({ a: 1, b: 1 }, [{ op: 'move', from: '/a', path: '/b/c' }], 'operation-failed');
+});
