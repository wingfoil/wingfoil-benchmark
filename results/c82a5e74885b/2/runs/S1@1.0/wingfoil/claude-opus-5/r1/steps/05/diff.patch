+++ b/src/json-diff.ts
@@ -0,0 +1,263 @@
+/**
+ * The difference between two JSON documents, as a JSON Patch
+ * ([RFC 6902](https://www.rfc-editor.org/rfc/rfc6902)).
+ *
+ * This is the other direction of `src/json-patch.ts`: there a document and a patch give a document,
+ * here two documents give a patch that turns the first into the second. It is what a service sends
+ * when it holds both versions of a document and only the change should go over the wire.
+ *
+ * The patch names what differs and nothing else. Two documents that differ in one member mention
+ * that member alone, at any depth; an array that gained or lost an element says so, rather than
+ * being sent again element by element, which is what the alignment of {@link editCosts} is for.
+ *
+ * Three of the six operations of RFC 6902 are never produced -- `test`, which states a precondition
+ * rather than a change, and `move` and `copy`, which say nothing a `remove` and an `add` do not
+ * already say. The patch is therefore made of `add`, `remove` and `replace`, and is a patch any
+ * RFC 6902 implementation applies.
+ *
+ * @module
+ */
+
+import { formatPointer } from './json-pointer.ts';
+import type { JsonPatch, JsonPatchOperation } from './json-patch.ts';
+import {
+  cloneJson,
+  isJsonObject,
+  jsonEquals,
+  memberOf,
+  type JsonObject,
+  type JsonValue,
+} from './json-value.ts';
+
+/**
+ * Returns a JSON Patch that turns `from` into `to`.
+ *
+ * The patch describes the difference and nothing more: values the two documents share are not in
+ * it, so a change in one member of a large document is one operation, not the document again.
+ * Comparing documents cannot fail, so nothing is thrown -- two JSON values always differ in a way a
+ * patch can state.
+ *
+ * Neither document is changed, and the patch shares no object or array with either: the values it
+ * carries are copies taken from `to`, so the three can be changed afterwards without affecting each
+ * other.
+ *
+ * @param from the document the patch will be applied to.
+ * @param to the document the patch must produce.
+ * @returns a JSON Patch, made of `add`, `remove` and `replace` operations, for which
+ * `applyPatch(from, createPatch(from, to))` equals `to`. Two documents that do not differ give an
+ * empty patch.
+ *
+ * @example
+ * createPatch({ name: 'disk', sizes: [1, 2] }, { name: 'disk', sizes: [1, 2, 3] });
+ * // [{ op: 'add', path: '/sizes/2', value: 3 }]
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatch {
+  const operations: JsonPatchOperation[] = [];
+  diff(asJson(from), asJson(to), [], operations);
+  return operations;
+}
+
+/**
+ * Writes into `into` the operations that turn the value at `path` from `from` into `to`.
+ *
+ * Two values of the same kind -- two objects, two arrays -- are compared part by part, so that only
+ * the parts that differ are mentioned. Anything else is a single `replace`: there is nothing smaller
+ * to say about a number that became a string, or about an object that took the place of an array.
+ */
+function diff(
+  from: JsonValue,
+  to: JsonValue,
+  path: readonly string[],
+  into: JsonPatchOperation[],
+): void {
+  if (jsonEquals(from, to)) {
+    return;
+  }
+  if (isJsonObject(from) && isJsonObject(to)) {
+    diffObjects(from, to, path, into);
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, into);
+  } else {
+    into.push({ op: 'replace', path: formatPointer(path), value: cloneJson(to) });
+  }
+}
+
+/**
+ * Compares two objects member by member: what `to` lost is removed, what it gained is added, and
+ * what both declare is compared in its turn.
+ *
+ * The operations come in document order -- `from`'s members in its order, which is where the
+ * removals and the changes are, then the members only `to` has, in its order -- so that the same two
+ * documents always give the same patch. An object member is named by a pointer and never moves, so
+ * nothing here depends on the operations before it.
+ */
+function diffObjects(
+  from: JsonObject,
+  to: JsonObject,
+  path: readonly string[],
+  into: JsonPatchOperation[],
+): void {
+  for (const member of Object.keys(from)) {
+    const before = from[member];
+    if (before === undefined) {
+      // A member holding `undefined` is no member of a JSON document: there is nothing to remove or
+      // to compare, and `to` declaring that name is an addition below.
+      continue;
+    }
+    const after = memberOf(to, member);
+    if (after === undefined) {
+      into.push({ op: 'remove', path: formatPointer([...path, member]) });
+    } else {
+      diff(before, after, [...path, member], into);
+    }
+  }
+  for (const member of Object.keys(to)) {
+    const after = to[member];
+    if (after !== undefined && memberOf(from, member) === undefined) {
+      into.push({ op: 'add', path: formatPointer([...path, member]), value: cloneJson(after) });
+    }
+  }
+}
+
+/**
+ * Compares two arrays as the sequences they are: the elements they share are left alone, and the
+ * others are added, removed, or compared in place.
+ *
+ * The elements both arrays open and end with are trimmed first. They are the same elements whatever
+ * happened between them, and trimming them is what keeps a change in a long array cheap: the
+ * alignment below costs a comparison of every remaining element of one array against every one of
+ * the other, and after trimming, those are only the elements around the change.
+ */
+function diffArrays(
+  from: JsonValue[],
+  to: JsonValue[],
+  path: readonly string[],
+  into: JsonPatchOperation[],
+): void {
+  const prefix = commonPrefixLength(from, to);
+  const suffix = commonSuffixLength(from, to, prefix);
+  const source = middle(from, prefix, suffix);
+  const target = middle(to, prefix, suffix);
+  emitEdits(source, target, editCosts(source, target), prefix, path, into);
+}
+
+/** How many elements the two arrays open with that are equal (RFC 6902 § 4.6). */
+function commonPrefixLength(from: JsonValue[], to: JsonValue[]): number {
+  const limit = Math.min(from.length, to.length);
+  let length = 0;
+  while (length < limit && jsonEquals(asJson(from[length]), asJson(to[length]))) {
+    length++;
+  }
+  return length;
+}
+
+/**
+ * How many elements the two arrays end with that are equal, counting no further back than the
+ * `prefix` elements the common prefix has already accounted for.
+ */
+function commonSuffixLength(from: JsonValue[], to: JsonValue[], prefix: number): number {
+  const limit = Math.min(from.length, to.length) - prefix;
+  let length = 0;
+  while (
+    length < limit &&
+    jsonEquals(asJson(from[from.length - 1 - length]), asJson(to[to.length - 1 - length]))
+  ) {
+    length++;
+  }
+  return length;
+}
+
+/** The elements of `array` left between a common prefix and a common suffix of those lengths. */
+function middle(array: JsonValue[], prefix: number, suffix: number): JsonValue[] {
+  return array.slice(prefix, array.length - suffix).map(asJson);
+}
+
+/**
+ * The cost of the cheapest edit script turning `source` into `target`, for every suffix of each.
+ *
+ * `costs[i][j]` is the fewest edits -- an element added, an element removed, or two elements read as
+ * one that changed -- that turn `source[i..]` into `target[j..]`; {@link emitEdits} reads the table
+ * back to recover the script itself. Equal elements cost nothing, which is what makes an element
+ * inserted in the middle of an array one operation rather than a rewrite of everything after it.
+ */
+function editCosts(source: JsonValue[], target: JsonValue[]): number[][] {
+  const costs = Array.from({ length: source.length + 1 }, () =>
+    new Array<number>(target.length + 1).fill(0),
+  );
+  // Filled from the end, each cell being the cheapest of the edits that could come first.
+  for (let i = source.length; i >= 0; i--) {
+    for (let j = target.length; j >= 0; j--) {
+      if (i === source.length) {
+        costs[i][j] = target.length - j; // nothing left to turn: the rest of `target` is added
+      } else if (j === target.length) {
+        costs[i][j] = source.length - i; // nothing left to reach: the rest of `source` is removed
+      } else if (jsonEquals(source[i], target[j])) {
+        costs[i][j] = costs[i + 1][j + 1];
+      } else {
+        costs[i][j] = 1 + Math.min(costs[i + 1][j + 1], costs[i + 1][j], costs[i][j + 1]);
+      }
+    }
+  }
+  return costs;
+}
+
+/**
+ * Walks the cheapest edit script back out of `costs`, writing one operation per edit.
+ *
+ * Each operation is written against the array as the operations before it leave it, which is how a
+ * patch is applied: `index` is where the walk stands in that array, and an element kept or added
+ * moves it on, while a removal does not -- the elements after the removed one have shifted down, so
+ * the next one to look at now sits at the index just removed.
+ *
+ * Where two scripts cost the same, an element added or removed is preferred to a pair of elements
+ * read as one element that changed: a pair that ties with an addition or a removal is a pair the
+ * alignment has no reason to believe in, and describing a change in place is worth it only when it
+ * is the cheaper story.
+ */
+function emitEdits(
+  source: JsonValue[],
+  target: JsonValue[],
+  costs: number[][],
+  start: number,
+  path: readonly string[],
+  into: JsonPatchOperation[],
+): void {
+  let index = start;
+  let i = 0;
+  let j = 0;
+  while (i < source.length || j < target.length) {
+    const cost = costs[i][j];
+    const where = () => formatPointer([...path, String(index)]);
+    if (i < source.length && j < target.length && jsonEquals(source[i], target[j])) {
+      i++;
+      j++;
+      index++;
+    } else if (i < source.length && cost === 1 + costs[i + 1][j]) {
+      into.push({ op: 'remove', path: where() });
+      i++;
+    } else if (j < target.length && cost === 1 + costs[i][j + 1]) {
+      into.push({ op: 'add', path: where(), value: cloneJson(target[j]) });
+      j++;
+      index++;
+    } else {
+      // The two elements are read as one element that changed, so the difference between them is
+      // described in its turn: a change inside an element is not an element sent whole.
+      diff(source[i], target[j], [...path, String(index)], into);
+      i++;
+      j++;
+      index++;
+    }
+  }
+}
+
+/**
+ * Reads a value the patch may have to carry, as the JSON value it must be.
+ *
+ * `undefined` is no JSON value and no operation can carry one. Where a document can simply be
+ * without a value -- an object member -- `undefined` is read as absent, as `applyMergePatch` reads
+ * it; where it cannot -- the document itself, or an element of an array -- it is read as the `null`
+ * that `JSON.stringify` writes for it there.
+ */
+function asJson(value: JsonValue | undefined): JsonValue {
+  return value === undefined ? null : value;
+}
