+
+/**
+ * The value `object` holds as its `name` member, or `undefined` when it declares no such member.
+ *
+ * Own members only, as RFC 6901 § 4 evaluation does: what the prototype chain offers under a name --
+ * `toString`, or `__proto__` on a document that does not declare it -- is not a member of the JSON
+ * document. A member holding `undefined` reads as absent too, `undefined` being no JSON value.
+ */
+export function memberOf(object: JsonObject, name: string): JsonValue | undefined {
+  return Object.hasOwn(object, name) ? object[name] : undefined;
+}
+
+/**
+ * Whether two JSON values are equal in the sense of RFC 6902 § 4.6.
+ *
+ * Primitives are compared by value, arrays member by member and in order, objects by their set of
+ * members, whatever order they are written in; nothing is compared across types, so the string
+ * `"10"` does not equal the number `10`.
+ */
+export function jsonEquals(left: JsonValue, right: JsonValue): boolean {
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return (
+      Array.isArray(left) &&
+      Array.isArray(right) &&
+      left.length === right.length &&
+      left.every((element, index) => jsonEquals(element, right[index]))
+    );
+  }
+  if (isJsonObject(left) || isJsonObject(right)) {
+    if (!isJsonObject(left) || !isJsonObject(right)) {
+      return false;
+    }
+    const members = Object.keys(left);
+    return (
+      members.length === Object.keys(right).length &&
+      members.every(
+        (member) => Object.hasOwn(right, member) && jsonEquals(left[member], right[member]),
+      )
+    );
+  }
+  return left === right;
+}
diff --git a/test/json-diff.test.ts b/test/json-diff.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f96f4efb3e257b99b757e3ffe40e4080c635ca77
--- /dev/null
+++ b/test/json-diff.test.ts
@@ -0,0 +1,360 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import {
+  applyPatch,
+  createPatch,
+  type JsonObject,
+  type JsonPatch,
+  type JsonValue,
+} from '../src/index.ts';
+
+/**
+ * Asserts that `createPatch(from, to)` is exactly `expected`, that applying it turns `from` into
+ * `to`, and that neither input is changed.
+ *
+ * Every case pins the operations themselves, not only the round trip: a patch that rewrites the
+ * whole document would pass the round trip, and describing nothing more than what changed is the
+ * point of the feature.
+ *
+ * @param applied what applying the patch yields, when that is not `to` itself -- which happens only
+ * for inputs holding values JSON has not, such as `undefined`.
+ */
+function assertPatches(
+  from: JsonValue,
+  to: JsonValue,
+  expected: JsonPatch,
+  applied: JsonValue = to,
+): JsonPatch {
+  const fromBefore = structuredClone(from);
+  const toBefore = structuredClone(to);
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, expected);
+  assert.deepEqual(applyPatch(from, patch), applied, 'the patch must turn `from` into `to`');
+  assert.deepEqual(from, fromBefore, 'createPatch must not change `from`');
+  assert.deepEqual(to, toBefore, 'createPatch must not change `to`');
+  return patch;
+}
+
+// --- documents that do not differ ------------------------------------------------------------
+
+test('two equal documents give an empty patch', () => {
+  assertPatches({ a: 'b' }, { a: 'b' }, []);
+  assertPatches([1, [2, { c: null }]], [1, [2, { c: null }]], []);
+  assertPatches(null, null, []);
+  assertPatches(0, 0, []);
+  assertPatches('', '', []);
+});
+
+test('members written in another order are the same document', () => {
+  // Equality is RFC 6902 § 4.6 equality: an object is its set of members, in no order.
+  assertPatches({ a: 1, b: { c: 2, d: 3 } }, { b: { d: 3, c: 2 }, a: 1 }, []);
+});
+
+// --- the document as a whole ----------------------------------------------------------------
+
+test('a document of another type is replaced whole, at the empty pointer', () => {
+  assertPatches(1, 2, [{ op: 'replace', path: '', value: 2 }]);
+  assertPatches({ a: 'b' }, ['a'], [{ op: 'replace', path: '', value: ['a'] }]);
+  assertPatches(null, false, [{ op: 'replace', path: '', value: false }]);
+  assertPatches([1], { a: 1 }, [{ op: 'replace', path: '', value: { a: 1 } }]);
+});
+
+test('values of different types are never equal', () => {
+  // The string "10" is not the number 10, and null is not false (RFC 6902 § 4.6).
+  assertPatches('10', 10, [{ op: 'replace', path: '', value: 10 }]);
+  assertPatches({ a: null }, { a: false }, [{ op: 'replace', path: '/a', value: false }]);
+  assertPatches({ a: '1' }, { a: 1 }, [{ op: 'replace', path: '/a', value: 1 }]);
+});
+
+// --- objects ----------------------------------------------------------------------------------
+
+test('a member the target gained is added', () => {
+  assertPatches({ a: 1 }, { a: 1, b: 2 }, [{ op: 'add', path: '/b', value: 2 }]);
+});
+
+test('a member the target lost is removed', () => {
+  assertPatches({ a: 1, b: 2 }, { a: 1 }, [{ op: 'remove', path: '/b' }]);
+});
+
+test('a member that changed is replaced', () => {
+  assertPatches({ a: 1, b: 2 }, { a: 1, b: 3 }, [{ op: 'replace', path: '/b', value: 3 }]);
+});
+
+test('an added member carries its whole value, a removed one carries none', () => {
+  assertPatches({}, { a: { b: [1, 2] } }, [{ op: 'add', path: '/a', value: { b: [1, 2] } }]);
+  assertPatches({ a: { b: [1, 2] } }, {}, [{ op: 'remove', path: '/a' }]);
+});
+
+test('only the members that changed are mentioned, at any depth', () => {
+  assertPatches(
+    { kept: { deep: [1, 2, 3] }, changed: { a: { b: 'old' }, same: true } },
+    { kept: { deep: [1, 2, 3] }, changed: { a: { b: 'new' }, same: true } },
+    [{ op: 'replace', path: '/changed/a/b', value: 'new' }],
+  );
+});
+
+test('operations come in document order: the removals and changes, then the additions', () => {
+  // `from`'s members in its order -- which is where the removals and the changes are -- then the
+  // members only `to` has, in its order. The same two documents always give the same patch.
+  assertPatches({ a: 1, b: 2, c: 3 }, { a: 1, c: 30, d: 4 }, [
+    { op: 'remove', path: '/b' },
+    { op: 'replace', path: '/c', value: 30 },
+    { op: 'add', path: '/d', value: 4 },
+  ]);
+});
+
+test('a member set to null is a replacement, not a removal', () => {
+  // Unlike a merge patch, a JSON Patch can say "this member now holds null".
+  assertPatches({ a: 1 }, { a: null }, [{ op: 'replace', path: '/a', value: null }]);
+  assertPatches({ a: null }, {}, [{ op: 'remove', path: '/a' }]);
+  assertPatches({}, { a: null }, [{ op: 'add', path: '/a', value: null }]);
+});
+
+test('member names are escaped into their pointers', () => {
+  assertPatches({ 'a/b': 1, 'm~n': 2 }, { 'a/b': 2, 'm~n': 2 }, [
+    { op: 'replace', path: '/a~1b', value: 2 },
+  ]);
+  assertPatches({ '': 1 }, { '': 2 }, [{ op: 'replace', path: '/', value: 2 }]);
+  assertPatches({ a: { '0': 1 } }, { a: { '0': 2 } }, [{ op: 'replace', path: '/a/0', value: 2 }]);
+});
+
+test('an object replaces a value of another type, member by member below that', () => {
+  assertPatches({ a: 'text' }, { a: { b: 1 } }, [{ op: 'replace', path: '/a', value: { b: 1 } }]);
+  assertPatches({ a: { b: 1 } }, { a: 'text' }, [{ op: 'replace', path: '/a', value: 'text' }]);
+});
+
+// --- arrays -----------------------------------------------------------------------------------
+
+test('an element appended to an array is added at its index', () => {
+  assertPatches([1, 2], [1, 2, 3], [{ op: 'add', path: '/2', value: 3 }]);
+  assertPatches({ a: [] }, { a: ['x'] }, [{ op: 'add', path: '/a/0', value: 'x' }]);
+});
+
+test('elements dropped from the end of an array are removed', () => {
+  assertPatches([1, 2, 3], [1, 2], [{ op: 'remove', path: '/2' }]);
+  // Each removal shifts what follows, so the operations are written against the array as patched
+  // so far: removing the last two elements twice names the same index.
+  assertPatches([1, 2, 3], [1], [
+    { op: 'remove', path: '/1' },
+    { op: 'remove', path: '/1' },
+  ]);
+});
+
+test('an element that changed is replaced where it sits', () => {
+  assertPatches([1, 2, 3], [1, 9, 3], [{ op: 'replace', path: '/1', value: 9 }]);
+});
+
+test('an element inserted at the front is one addition, not a rewrite', () => {
+  assertPatches([1, 2, 3], [0, 1, 2, 3], [{ op: 'add', path: '/0', value: 0 }]);
+});
+
+test('an element inserted in the middle is one addition', () => {
+  assertPatches([1, 2, 3], [1, 9, 2, 3], [{ op: 'add', path: '/1', value: 9 }]);
+});
+
+test('an element taken out of the front or the middle is one removal', () => {
+  assertPatches([1, 2, 3], [2, 3], [{ op: 'remove', path: '/0' }]);
+  assertPatches([1, 2, 3], [1, 3], [{ op: 'remove', path: '/1' }]);
+});
+
+test('an element and its neighbours are told apart by what they hold, not by their index', () => {
+  // The elements after the insertion are the same values, so nothing about them is sent.
+  assertPatches(
+    [{ id: 1 }, { id: 2 }, { id: 3 }],
+    [{ id: 1 }, { id: 9 }, { id: 2 }, { id: 3 }],
+    [{ op: 'add', path: '/1', value: { id: 9 } }],
+  );
+});
+
+test('an element that merely changed inside is described member by member', () => {
+  assertPatches(
+    [{ id: 1, size: 10 }, { id: 2, size: 20 }],
+    [{ id: 1, size: 10 }, { id: 2, size: 21 }],
+    [{ op: 'replace', path: '/1/size', value: 21 }],
+  );
+});
+
+test('an array emptied and an array filled', () => {
+  assertPatches([1, 2], [], [
+    { op: 'remove', path: '/0' },
+    { op: 'remove', path: '/0' },
+  ]);
+  assertPatches([], [1, 2], [
+    { op: 'add', path: '/0', value: 1 },
+    { op: 'add', path: '/1', value: 2 },
+  ]);
+});
+
+test('reordered elements are described by the fewest element edits', () => {
+  // Reversing [1,2,3] keeps the middle element: two replacements, not three.
+  assertPatches([1, 2, 3], [3, 2, 1], [
+    { op: 'replace', path: '/0', value: 3 },
+    { op: 'replace', path: '/2', value: 1 },
+  ]);
+});
+
+test('an insertion and a removal in the same array are each one operation', () => {
+  assertPatches(['a', 'b', 'c', 'd'], ['a', 'x', 'b', 'd'], [
+    { op: 'add', path: '/1', value: 'x' },
+    { op: 'remove', path: '/3' },
+  ]);
+});
+
+test('an array nested in an array is diffed as deeply as any other value', () => {
+  assertPatches([[1, 2], [3]], [[1, 2], [3, 4]], [{ op: 'add', path: '/1/1', value: 4 }]);
+});
+
+test('an array of another kind of value is replaced, not merged', () => {
+  assertPatches([1], [[1]], [{ op: 'replace', path: '/0', value: [1] }]);
+  assertPatches({ a: [1] }, { a: 'x' }, [{ op: 'replace', path: '/a', value: 'x' }]);
+});
+
+// --- nothing more than what changed -----------------------------------------------------------
+
+test('one changed element of a long array is one operation, whatever its length', () => {
+  const from: JsonValue = Array.from({ length: 1000 }, (_, index) => ({
+    id: index,
+    label: `item ${index}`,
+  }));
+  const to: JsonValue = (from as JsonObject[]).map((item) =>
+    item['id'] === 500 ? { ...item, label: 'changed' } : item,
+  );
+
+  const patch = assertPatches(from, to, [{ op: 'replace', path: '/500/label', value: 'changed' }]);
+  // The whole point: what goes over the wire is the size of the change, not of the document.
+  assert.ok(JSON.stringify(patch).length < 80, JSON.stringify(patch));
+});
+
+test('one changed leaf of a deep document is one operation', () => {
+  const from: JsonValue = { a: { b: { c: { d: { e: [1, { f: 'old' }] } } } }, other: [1, 2, 3] };
+  const to: JsonValue = { a: { b: { c: { d: { e: [1, { f: 'new' }] } } } }, other: [1, 2, 3] };
+
+  assertPatches(from, to, [{ op: 'replace', path: '/a/b/c/d/e/1/f', value: 'new' }]);
+});
+
+test('an empty patch is produced for a large unchanged document', () => {
+  const document = { items: Array.from({ length: 200 }, (_, index) => ({ index })) };
+  assertPatches(document, structuredClone(document), []);
+});
+
+// --- the patch is a value of its own ----------------------------------------------------------
+
+test('the patch shares nothing with the documents it was made from', () => {
+  const to: JsonObject = { added: { deep: [1, 2] } };
+  const patch = createPatch({}, to);
+  const added = (patch[0] as { readonly value: JsonValue }).value as JsonObject;
+
+  assert.notEqual(added, to['added']);
+  added['deep'] = ['changed'];
+  assert.deepEqual(to, { added: { deep: [1, 2] } });
+});
+
+test('changing a document afterwards does not change the patch', () => {
+  const to: JsonObject = { a: [1] };
+  const patch = createPatch({}, to);
+  (to['a'] as JsonValue[]).push(2);
+
+  assert.deepEqual(patch, [{ op: 'add', path: '/a', value: [1] }]);
+});
+
+test('the patch applies to the document it was made from, through applyPatch', () => {
+  // The patch is a JSON Patch: `applyPatch` validates it, so an invalid one would be refused here.
+  const from = { items: ['disk'], count: 1 };
+  const to = { items: ['disk', 'tape'], count: 2, primary: 'disk' };
+  assert.deepEqual(applyPatch(from, createPatch(from, to)), to);
+});
+
+test('no test operation is produced: a patch describes the change, not a precondition', () => {
+  const patch = createPatch({ a: 1, b: [1, 2] }, { a: 2, b: [1] });
+  assert.deepEqual(
+    patch.map((operation) => operation.op),
+    ['replace', 'remove'],
+  );
+});
+
+// --- members are member names, not property lookups -------------------------------------------
+
+test('a member named __proto__ is diffed as the plain member it is', () => {
+  const from = JSON.parse('{"a": 1}') as JsonValue;
+  const to = JSON.parse('{"a": 1, "__proto__": {"polluted": true}}') as JsonValue;
+
+  const patch = assertPatches(from, to, [
+    { op: 'add', path: '/__proto__', value: { polluted: true } },
+  ]);
+  const result = applyPatch(from, patch) as JsonObject;
+  assert.deepEqual(Object.keys(result).sort(), ['__proto__', 'a']);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as { polluted?: unknown }).polluted, undefined);
+});
+
+test('a member named __proto__ is diffed into, not replaced whole', () => {
+  const from = JSON.parse('{"__proto__": {"a": 1, "b": 2}}') as JsonValue;
+  const to = JSON.parse('{"__proto__": {"a": 1, "b": 3}}') as JsonValue;
+
+  assertPatches(from, to, [{ op: 'replace', path: '/__proto__/b', value: 3 }]);
+});
+
+test('an inherited property is not a member either document has', () => {
+  // Only own members are read, as RFC 6901 § 4 evaluation does: what the prototype chain offers
+  // under a name is not part of the document, so there is nothing to describe about it. (The
+  // documents are compared directly here: a clone of one would not carry its prototype.)
+  const inheriting = Object.create({ inherited: 1 }) as JsonObject;
+  inheriting['own'] = 2;
+
+  assert.deepEqual(createPatch({ own: 2 }, inheriting), []);
+  assert.deepEqual(createPatch(inheriting, { own: 2 }), []);
+  assert.deepEqual(createPatch(inheriting, { own: 3 }), [{ op: 'replace', path: '/own', value: 3 }]);
+});
+
+// --- values that are not JSON -----------------------------------------------------------------
+
+test('a member holding undefined is read as absent, in either document', () => {
+  // `undefined` is not a JSON value, so it is read as "no such member", as `applyMergePatch` reads
+  // it too.
+  const withUndefined = { a: 1, b: undefined } as unknown as JsonValue;
+  assertPatches({ a: 1, b: 2 }, withUndefined, [{ op: 'remove', path: '/b' }], { a: 1 });
+  // Nothing to say, so nothing is applied, and `from` keeps the member JSON does not see.
+  assertPatches(withUndefined, { a: 1 }, [], withUndefined);
+  assertPatches({ a: 1 }, withUndefined, [], { a: 1 });
+  assertPatches(withUndefined, { a: 1, b: 2 }, [{ op: 'add', path: '/b', value: 2 }], {
+    a: 1,
+    b: 2,
+  });
+});
+
+test('an undefined where a JSON Patch must carry a value is read as null', () => {
+  // An array element and the document itself cannot be absent, and no operation can carry
+  // `undefined`, so it is written as the `null` that `JSON.stringify` writes for it in an array.
+  assertPatches([1], [undefined] as unknown as JsonValue, [
+    { op: 'replace', path: '/0', value: null },
+  ], [null]);
+  assertPatches({ a: 1 }, undefined as unknown as JsonValue, [
+    { op: 'replace', path: '', value: null },
+  ], null);
+  assertPatches(undefined as unknown as JsonValue, { a: 1 }, [
+    { op: 'replace', path: '', value: { a: 1 } },
+  ]);
+});
+
+// --- the library's documented example ---------------------------------------------------------
+
+test('the README example sends only what changed', () => {
+  const stored = {
+    name: 'disk',
+    labels: { tier: 'cold', region: 'eu' },
+    sizes: [1, 2, 3],
+  };
+  const wanted = {
+    name: 'disk',
+    labels: { tier: 'hot' },
+    sizes: [1, 2, 3, 4],
+  };
+
+  assertPatches(stored, wanted, [
+    { op: 'replace', path: '/labels/tier', value: 'hot' },
+    { op: 'remove', path: '/labels/region' },
+    { op: 'add', path: '/sizes/3', value: 4 },
+  ]);
+});
