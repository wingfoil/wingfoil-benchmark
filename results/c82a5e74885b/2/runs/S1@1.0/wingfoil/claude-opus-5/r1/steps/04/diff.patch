+export function cloneJson(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(cloneJson);
+  }
+  if (isJsonObject(value)) {
+    const copy: JsonObject = {};
+    for (const [member, held] of Object.entries(value)) {
+      setMember(copy, member, cloneJson(held));
+    }
+    return copy;
+  }
+  return value;
+}
+
+/**
+ * Writes `value` as the `name` member of `object`.
+ *
+ * Defining the property rather than assigning it is what makes a member named `__proto__` an
+ * ordinary member: assigning that name would set the prototype instead, and the member would not
+ * exist at all.
+ */
+export function setMember(object: JsonObject, name: string, value: JsonValue): void {
+  Object.defineProperty(object, name, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
diff --git a/test/json-merge-patch.test.ts b/test/json-merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8f826def77affc6d5e4b387dbd8fa9d2a38bf2b2
--- /dev/null
+++ b/test/json-merge-patch.test.ts
@@ -0,0 +1,278 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { applyMergePatch, type JsonObject, type JsonValue } from '../src/index.ts';
+
+/**
+ * Asserts that merging `patch` into `target` yields `expected`, without touching either input.
+ *
+ * Every case goes through here, because RFC 7386 has no failure modes to assert instead: the two
+ * things a caller can observe of a merge are the result and that its inputs are left alone.
+ */
+function assertMerges(target: JsonValue, patch: JsonValue, expected: JsonValue): JsonValue {
+  const targetBefore = structuredClone(target);
+  const patchBefore = structuredClone(patch);
+  const result = applyMergePatch(target, patch);
+  assert.deepEqual(result, expected);
+  assert.deepEqual(target, targetBefore, 'applyMergePatch must not change the target');
+  assert.deepEqual(patch, patchBefore, 'applyMergePatch must not change the patch');
+  return result;
+}
+
+// --- RFC 7386 appendix A: the specification's own test cases, verbatim -----------------------
+
+test('A: replaces the value of a member the target has', () => {
+  assertMerges({ a: 'b' }, { a: 'c' }, { a: 'c' });
+});
+
+test('A: adds a member the target does not have', () => {
+  assertMerges({ a: 'b' }, { b: 'c' }, { a: 'b', b: 'c' });
+});
+
+test('A: null removes a member, leaving an empty object', () => {
+  assertMerges({ a: 'b' }, { a: null }, {});
+});
+
+test('A: null removes one member and leaves the others', () => {
+  assertMerges({ a: 'b', b: 'c' }, { a: null }, { b: 'c' });
+});
+
+test('A: a value replaces an array wholesale', () => {
+  assertMerges({ a: ['b'] }, { a: 'c' }, { a: 'c' });
+});
+
+test('A: an array replaces a value wholesale', () => {
+  assertMerges({ a: 'c' }, { a: ['b'] }, { a: ['b'] });
+});
+
+test('A: merges into a nested object, replacing and removing', () => {
+  assertMerges({ a: { b: 'c' } }, { a: { b: 'd', c: null } }, { a: { b: 'd' } });
+});
+
+test('A: an array in the patch replaces an array of objects', () => {
+  assertMerges({ a: [{ b: 'c' }] }, { a: [1] }, { a: [1] });
+});
+
+test('A: an array patch replaces an array target', () => {
+  assertMerges(['a', 'b'], ['c', 'd'], ['c', 'd']);
+});
+
+test('A: an array patch replaces an object target', () => {
+  assertMerges({ a: 'b' }, ['c'], ['c']);
+});
+
+test('A: a null patch replaces the whole document', () => {
+  assertMerges({ a: 'foo' }, null, null);
+});
+
+test('A: a string patch replaces the whole document', () => {
+  assertMerges({ a: 'foo' }, 'bar', 'bar');
+});
+
+test('A: a null the patch does not mention is kept', () => {
+  assertMerges({ e: null }, { a: 1 }, { e: null, a: 1 });
+});
+
+test('A: an object patch discards a non-object target, nulls removing nothing', () => {
+  assertMerges([1, 2], { a: 'b', c: null }, { a: 'b' });
+});
+
+test('A: null removes a member that is not there, creating the objects above it', () => {
+  assertMerges({}, { a: { bb: { ccc: null } } }, { a: { bb: {} } });
+});
+
+// --- RFC 7386 § 1 and § 3: the examples in the specification's prose -------------------------
+
+test('§ 1 changes one member and removes a nested one', () => {
+  assertMerges(
+    { a: 'b', c: { d: 'e', f: 'g' } },
+    { a: 'z', c: { f: null } },
+    { a: 'z', c: { d: 'e' } },
+  );
+});
+
+test('§ 3 replaces, adds, removes a nested member and replaces an array', () => {
+  const result = assertMerges(
+    {
+      title: 'Goodbye!',
+      author: { givenName: 'John', familyName: 'Doe' },
+      tags: ['example', 'sample'],
+      content: 'This will be unchanged',
+    },
+    {
+      title: 'Hello!',
+      phoneNumber: '+01-123-456-7890',
+      author: { familyName: null },
+      tags: ['example'],
+    },
+    {
+      title: 'Hello!',
+      author: { givenName: 'John' },
+      tags: ['example'],
+      content: 'This will be unchanged',
+      phoneNumber: '+01-123-456-7890',
+    },
+  );
+  // The RFC prints the result with the added member last: members the target already had keep their
+  // place, and a new one goes at the end.
+  assert.equal(
+    JSON.stringify(result),
+    '{"title":"Hello!","author":{"givenName":"John"},"tags":["example"],' +
+      '"content":"This will be unchanged","phoneNumber":"+01-123-456-7890"}',
+  );
+});
+
+// --- the patch as a whole --------------------------------------------------------------------
+
+test('an empty object patch changes nothing', () => {
+  assertMerges({ a: 'b', c: [1, { d: null }] }, {}, { a: 'b', c: [1, { d: null }] });
+});
+
+test('a patch of a number, a boolean or an object replaces any target', () => {
+  assertMerges({ a: 'b' }, 42, 42);
+  assertMerges(['a'], false, false);
+  assertMerges(null, { a: 'b' }, { a: 'b' });
+  assertMerges(7, { a: 'b' }, { a: 'b' });
+  assertMerges('text', {}, {});
+});
+
+test('a target of any type is discarded by an object patch', () => {
+  // "if Target is not an Object: Target = {}": everything the target held is gone, including what
+  // the patch does not mention.
+  assertMerges(null, { a: 1 }, { a: 1 });
+  assertMerges(true, { a: 1 }, { a: 1 });
+  assertMerges(['keep?'], { a: 1 }, { a: 1 });
+});
+
+test('merging is recursive to any depth', () => {
+  assertMerges(
+    { a: { b: { c: { d: 'deep', e: 'gone' } } } },
+    { a: { b: { c: { d: 'deeper', e: null, f: 'new' } } } },
+    { a: { b: { c: { d: 'deeper', f: 'new' } } } },
+  );
+});
+
+test('an object patch replaces a nested non-object target', () => {
+  assertMerges({ a: 'b' }, { a: { c: 'd' } }, { a: { c: 'd' } });
+});
+
+test('null removes a member whatever it holds', () => {
+  assertMerges(
+    { object: { a: 1 }, array: [1], none: null, number: 0, text: '' },
+    { object: null, array: null, none: null, number: null, text: null },
+    {},
+  );
+});
+
+test('a merge patch cannot set a member to null, only remove it', () => {
+  // The limitation RFC 7386 § 1 states: a patch using explicit nulls cannot be expressed.
+  assertMerges({ a: 1 }, { a: null }, {});
+});
+
+test('members are merged in the order the patch lists them', () => {
+  const result = applyMergePatch({ b: 1 }, { c: 2, a: 3 });
+  assert.equal(JSON.stringify(result), '{"b":1,"c":2,"a":3}');
+});
+
+// --- the result is a new value ---------------------------------------------------------------
+
+test('the result shares nothing with the target', () => {
+  const target: JsonObject = { kept: { deep: [1, 2] }, replaced: 'old' };
+  const result = applyMergePatch(target, { replaced: 'new' }) as JsonObject;
+
+  assert.notEqual(result, target);
+  assert.notEqual(result['kept'], target['kept']);
+  (result['kept'] as JsonObject)['deep'] = ['changed'];
+  assert.deepEqual(target, { kept: { deep: [1, 2] }, replaced: 'old' });
+});
+
+test('the result shares nothing with the patch', () => {
+  const patch: JsonObject = { added: { deep: [1, 2] } };
+  const result = applyMergePatch({}, patch) as JsonObject;
+
+  assert.notEqual(result['added'], patch['added']);
+  (result['added'] as JsonObject)['deep'] = ['changed'];
+  assert.deepEqual(patch, { added: { deep: [1, 2] } });
+});
+
+test('a non-object patch is returned as a copy, not as itself', () => {
+  const patch: JsonValue = [1, { a: 'b' }];
+  const result = applyMergePatch({ a: 'b' }, patch);
+
+  assert.deepEqual(result, patch);
+  assert.notEqual(result, patch);
+  (result as JsonValue[]).push('appended');
+  assert.deepEqual(patch, [1, { a: 'b' }]);
+});
+
+test('an unchanged target is returned as a copy, not as itself', () => {
+  const target: JsonObject = { a: 'b' };
+  const result = applyMergePatch(target, {});
+
+  assert.deepEqual(result, target);
+  assert.notEqual(result, target);
+});
+
+// --- members are member names, not property lookups ------------------------------------------
+
+test('a patch member named __proto__ is written as a plain member', () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}}') as JsonValue;
+  const result = applyMergePatch({ a: 'b' }, patch) as JsonObject;
+
+  assert.deepEqual(Object.keys(result).sort(), ['__proto__', 'a']);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.getOwnPropertyDescriptor(result, '__proto__')?.value, {
+    polluted: true,
+  });
+  assert.equal(({} as { polluted?: unknown }).polluted, undefined);
+});
+
+test('a target member named __proto__ is merged into and removed like any other', () => {
+  const target = JSON.parse('{"__proto__": {"a": 1, "b": 2}}') as JsonValue;
+  const merged = applyMergePatch(target, JSON.parse('{"__proto__": {"b": null, "c": 3}}'));
+  assert.deepEqual(Object.getOwnPropertyDescriptor(merged, '__proto__')?.value, { a: 1, c: 3 });
+  assert.equal(Object.getPrototypeOf(merged), Object.prototype);
+
+  const removed = applyMergePatch(target, JSON.parse('{"__proto__": null}'));
+  assert.deepEqual(Object.keys(removed as JsonObject), []);
+});
+
+test('an inherited property is not a member the patch can remove or merge into', () => {
+  // `toString` is not a member of `{}`, so a null for it removes nothing and an object for it adds
+  // the member rather than merging with `Object.prototype.toString`.
+  assertMerges({}, { toString: null }, {});
+  const result = applyMergePatch({}, { toString: { a: 1 } }) as JsonObject;
+  assert.deepEqual(Object.keys(result), ['toString']);
+  assert.deepEqual(result['toString'], { a: 1 });
+});
+
+// --- values that are not JSON ----------------------------------------------------------------
+
+test('a member holding undefined is treated as absent from the patch', () => {
+  // `undefined` is not a JSON value, so a JavaScript caller writing it means "no such member",
+  // which is how `applyPatch` reads an operation's missing `value` too.
+  const patch = { a: undefined, b: 'set' } as unknown as JsonValue;
+  assert.deepEqual(applyMergePatch({ a: 'kept' }, patch), { a: 'kept', b: 'set' });
+});
+
+test('an undefined patch is no patch, and leaves the target as it is', () => {
+  const target: JsonObject = { a: 'b' };
+  const result = applyMergePatch(target, undefined as unknown as JsonValue);
+  assert.deepEqual(result, { a: 'b' });
+  assert.notEqual(result, target);
+});
+
+// --- the library's documented example --------------------------------------------------------
+
+test('the README example merges a partial update from a client', () => {
+  const stored = {
+    name: 'disk',
+    labels: { tier: 'cold', region: 'eu' },
+    sizes: [1, 2],
+  };
+  assertMerges(
+    stored,
+    { labels: { tier: 'hot', region: null }, sizes: [3] },
+    { name: 'disk', labels: { tier: 'hot' }, sizes: [3] },
+  );
+});
