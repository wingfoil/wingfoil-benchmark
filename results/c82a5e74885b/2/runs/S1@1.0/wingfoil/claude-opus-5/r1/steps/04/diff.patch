@@ -0,0 +1,101 @@
+/**
+ * JSON Merge Patch, as specified in [RFC 7386](https://www.rfc-editor.org/rfc/rfc7386).
+ *
+ * A merge patch is not a list of operations like a JSON Patch (RFC 6902) but a document that looks
+ * like the one it changes: its members are merged into the target, member by member and recursively,
+ * and a member holding `null` removes the member of that name. Anything that is not an object
+ * replaces the target outright. That is the whole format -- the price of its simplicity is that it
+ * cannot set a member to `null`, address an array element, or state a precondition.
+ *
+ * The algorithm implemented here is the `MergePatch` pseudo-code of § 2. RFC 7396 obsoletes RFC 7386
+ * to correct the indentation of that pseudo-code, which in RFC 7386 puts `return Target` inside the
+ * loop over the patch's members; the two RFCs agree on everything else, including the test cases of
+ * their appendix A, so this module follows both as RFC 7396 prints them.
+ *
+ * @module
+ */
+
+import {
+  cloneJson,
+  isJsonObject,
+  setMember,
+  type JsonObject,
+  type JsonValue,
+} from './json-value.ts';
+
+/**
+ * Applies a JSON Merge Patch to a JSON document and returns the merged document.
+ *
+ * The result is a new value: `target` is left untouched, and no part of it, nor of `patch`, is
+ * shared with the result, so the three can be changed afterwards without affecting each other.
+ *
+ * Merging cannot fail. Every pair of JSON values has a result, so -- unlike {@link applyPatch} --
+ * this function throws nothing and has no error class: a patch that mentions members the target
+ * does not have adds them, and one that removes members that are not there removes nothing. A
+ * caller who needs an update to be refused when the document is not as expected wants a JSON Patch
+ * with a `test` operation instead.
+ *
+ * @param target the JSON document to merge into.
+ * @param patch the merge patch: a JSON document shaped like `target`, as RFC 7386 § 1 describes it.
+ * Any JSON value is accepted, so a patch parsed from a `application/merge-patch+json` payload can be
+ * passed in as it is.
+ * @returns the merged document, as a new value.
+ *
+ * @example
+ * applyMergePatch(
+ *   { title: 'Goodbye!', author: { givenName: 'John', familyName: 'Doe' } },
+ *   { title: 'Hello!', author: { familyName: null } },
+ * ); // { title: 'Hello!', author: { givenName: 'John' } }
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (patch === undefined) {
+    // Not a JSON value, so there is no patch to apply: the target stands, copied like any result.
+    return cloneJson(target);
+  }
+  return merge(target, patch);
+}
+
+/**
+ * The `MergePatch(Target, Patch)` of RFC 7386 § 2, on a target that may be absent.
+ *
+ * The recursion reaches a member the target does not declare -- which is how a patch adds one --
+ * and "not an object" covers that case as it covers a string or a number, so the absent target
+ * needs no case of its own, only a type that admits it.
+ */
+function merge(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    // "If the patch is anything other than an object, the result will always be to replace the
+    // entire target with the entire patch" (§ 1). The copy is what keeps the patch out of the
+    // result, so that changing one afterwards cannot change the other.
+    return cloneJson(patch);
+  }
+
+  // "if Target is not an Object: Target = {}" (§ 2): a target that has no members cannot be merged
+  // into, and the patch's members are all that is left of it.
+  const merged: JsonObject =
+    target !== undefined && isJsonObject(target) ? (cloneJson(target) as JsonObject) : {};
+
+  for (const [member, value] of Object.entries(patch)) {
+    if (value === null) {
+      // A null member removes the member of that name; one the target does not declare is already
+      // absent, which the RFC's own `{} + {"a":{"bb":{"ccc":null}}}` case relies on.
+      delete merged[member];
+    } else if (value !== undefined) {
+      // A member holding `undefined` is not a member of a JSON document, so it is passed over
+      // rather than merged: the patch simply does not mention that name.
+      setMember(merged, member, merge(memberOf(merged, member), value));
+    }
+  }
+  return merged;
+}
+
+/**
+ * The value `object` holds as its `name` member, or `undefined` when it declares no such member.
+ *
+ * Own members only, as RFC 6901 § 4 evaluation does and as the rest of the library has it: what the
+ * prototype chain offers under a name -- `toString`, or `__proto__` on a document that does not
+ * declare it -- is not a member of the JSON document, so it is nothing to merge into.
+ */
+function memberOf(object: JsonObject, name: string): JsonValue | undefined {
+  return Object.hasOwn(object, name) ? object[name] : undefined;
+}
