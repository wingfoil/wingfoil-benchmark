@@ -8,3 +18,45 @@ export type JsonValue = null | boolean | number | string | JsonValue[] | JsonObj
 
 /** A JSON object: an unordered set of name/value members. */
 export type JsonObject = { [member: string]: JsonValue };
+
+/** Whether `value` is a JSON object, as opposed to an array, `null` or a primitive. */
+export function isJsonObject(value: JsonValue): value is JsonObject {
