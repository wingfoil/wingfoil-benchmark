new file mode 100644
index 0000000000000000000000000000000000000000..f277f7659d047c23467dab6ab2e6ac76c4db925f
--- /dev/null
+++ b/test/json-pointer.test.ts
@@ -0,0 +1,209 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { JsonPointerError, resolvePointer, type JsonValue } from '../src/index.ts';
+
+/**
+ * The example document of RFC 6901 § 5, verbatim. Every pointer the RFC lists for it is
+ * exercised below, so the happy path is pinned to the specification's own examples.
+ */
+const rfcExample: JsonValue = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+/** Asserts that resolving `pointer` fails with a `JsonPointerError` carrying `reason`. */
+function assertFails(
+  document: JsonValue,
+  pointer: string,
+  reason: 'invalid-pointer' | 'unresolved',
+): JsonPointerError {
+  let caught: unknown;
+  try {
+    resolvePointer(document, pointer);
+  } catch (error) {
+    caught = error;
+  }
+  assert.ok(
+    caught instanceof JsonPointerError,
+    `expected resolvePointer(${JSON.stringify(pointer)}) to throw a JsonPointerError, got ${String(caught)}`,
+  );
+  assert.equal(caught.reason, reason);
+  assert.ok(caught instanceof Error);
+  assert.equal(caught.name, 'JsonPointerError');
+  assert.ok(caught.message.length > 0);
+  return caught;
+}
+
+test('resolves every pointer of the RFC 6901 example document', () => {
+  assert.deepEqual(resolvePointer(rfcExample, ''), rfcExample);
+  assert.deepEqual(resolvePointer(rfcExample, '/foo'), ['bar', 'baz']);
+  assert.equal(resolvePointer(rfcExample, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(rfcExample, '/foo/1'), 'baz');
+  assert.equal(resolvePointer(rfcExample, '/'), 0);
+  assert.equal(resolvePointer(rfcExample, '/a~1b'), 1);
+  assert.equal(resolvePointer(rfcExample, '/c%d'), 2);
+  assert.equal(resolvePointer(rfcExample, '/e^f'), 3);
+  assert.equal(resolvePointer(rfcExample, '/g|h'), 4);
+  assert.equal(resolvePointer(rfcExample, '/i\\j'), 5);
+  assert.equal(resolvePointer(rfcExample, '/k"l'), 6);
+  assert.equal(resolvePointer(rfcExample, '/ '), 7);
+  assert.equal(resolvePointer(rfcExample, '/m~0n'), 8);
+});
+
+test('the empty pointer refers to the whole document, whatever its type', () => {
+  assert.equal(resolvePointer(42, ''), 42);
+  assert.equal(resolvePointer('hello', ''), 'hello');
+  assert.equal(resolvePointer(null, ''), null);
+  assert.equal(resolvePointer(false, ''), false);
+  assert.deepEqual(resolvePointer([], ''), []);
+});
+
+test('returns the value in place, without copying it', () => {
+  const nested = { b: [1, 2] };
+  const document = { a: nested };
+  assert.equal(resolvePointer(document, '/a'), nested);
+  assert.equal(resolvePointer(document, '/a/b'), nested.b);
+});
+
+test('walks nested objects and arrays to any depth', () => {
+  const document: JsonValue = { a: [{ b: { c: [[], [{ d: 'deep' }]] } }] };
+  assert.equal(resolvePointer(document, '/a/0/b/c/1/0/d'), 'deep');
+  assert.deepEqual(resolvePointer(document, '/a/0/b/c/0'), []);
+});
+
+test('distinguishes a member holding null from a missing member', () => {
+  const document: JsonValue = { a: null };
+  assert.equal(resolvePointer(document, '/a'), null);
+  assertFails(document, '/b', 'unresolved');
+});
+
+test('resolves the empty member name, including repeated', () => {
+  assert.equal(resolvePointer({ '': 1 }, '/'), 1);
+  assert.equal(resolvePointer({ '': { '': 2 } }, '//'), 2);
+  assert.equal(resolvePointer({ '': { a: 3 } }, '//a'), 3);
+});
+
+test('unescapes ~1 before ~0, as RFC 6901 § 4 requires', () => {
+  assert.equal(resolvePointer({ '~1': 'tilde-one' }, '/~01'), 'tilde-one');
+  assert.equal(resolvePointer({ '/0': 'slash-zero' }, '/~10'), 'slash-zero');
+  assert.equal(resolvePointer({ '~/': 'both' }, '/~0~1'), 'both');
+  assert.equal(resolvePointer({ '~~': 'tildes' }, '/~0~0'), 'tildes');
+});
+
+test('treats member names as opaque Unicode strings', () => {
+  assert.equal(resolvePointer({ 'clé': 'valeur' }, '/clé'), 'valeur');
+  assert.equal(resolvePointer({ '🔑': 'emoji' }, '/🔑'), 'emoji');
+  assert.equal(resolvePointer({ 'a\u0000b': 'nul' }, '/a\u0000b'), 'nul');
+});
+
+test('rejects a non-empty pointer that does not start with a solidus', () => {
+  assertFails(rfcExample, 'foo', 'invalid-pointer');
+  assertFails(rfcExample, 'foo/0', 'invalid-pointer');
+  assertFails(rfcExample, '#/foo', 'invalid-pointer');
+  assertFails(rfcExample, ' /foo', 'invalid-pointer');
+});
+
+test('rejects a tilde that is not followed by 0 or 1', () => {
+  assertFails(rfcExample, '/~', 'invalid-pointer');
+  assertFails(rfcExample, '/~2', 'invalid-pointer');
+  assertFails(rfcExample, '/a~b', 'invalid-pointer');
+  assertFails(rfcExample, '/a~', 'invalid-pointer');
+  assertFails(rfcExample, '/~~0', 'invalid-pointer');
+  assertFails(rfcExample, '/ok/~x', 'invalid-pointer');
+});
+
+test('rejects a pointer that is not a string', () => {
+  for (const pointer of [undefined, null, 0, 1, true, {}, [], ['/foo'], Symbol('/foo')]) {
+    assertFails(rfcExample, pointer as unknown as string, 'invalid-pointer');
+  }
+});
+
+test('reports an array index that is out of range as unresolved', () => {
+  assertFails(rfcExample, '/foo/2', 'unresolved');
+  assertFails(rfcExample, '/foo/10', 'unresolved');
+  assertFails([], '/0', 'unresolved');
+});
+
+test('reports the "-" token as unresolved: it names the element after the last', () => {
+  assertFails(rfcExample, '/foo/-', 'unresolved');
+  assertFails([], '/-', 'unresolved');
+  assertFails(rfcExample, '/foo/-/x', 'unresolved');
+});
+
+test('accepts only the array-index form of RFC 6901 § 4 on arrays', () => {
+  const document: JsonValue = ['zero', 'one'];
+  assert.equal(resolvePointer(document, '/0'), 'zero');
+  assert.equal(resolvePointer(document, '/1'), 'one');
+  // Leading zeros, signs, spaces and other numeric spellings are not array indexes.
+  for (const pointer of ['/00', '/01', '/+0', '/-0', '/-1', '/1.0', '/1e0', '/ 1', '/1 ', '/0x1']) {
+    assertFails(document, pointer, 'unresolved');
+  }
+});
+
+test('does not expose array properties as members', () => {
+  const document: JsonValue = { foo: ['bar'] };
+  assertFails(document, '/foo/length', 'unresolved');
+  assertFails(document, '/foo/', 'unresolved');
+  assertFails(document, '/foo/0/length', 'unresolved');
+});
+
+test('reports a primitive on the way as unresolved', () => {
+  assertFails(rfcExample, '/foo/0/0', 'unresolved');
+  assertFails(rfcExample, '/foo/0/a', 'unresolved');
+  assertFails({ a: 1 }, '/a/b', 'unresolved');
+  assertFails({ a: null }, '/a/b', 'unresolved');
+  assertFails({ a: true }, '/a/b', 'unresolved');
+  assertFails(1, '/a', 'unresolved');
+  assertFails(null, '/a', 'unresolved');
+  assertFails('text', '/0', 'unresolved');
+});
+
+test('resolves only own members, never inherited ones', () => {
+  const document: JsonValue = { a: 1 };
+  for (const pointer of [
+    '/__proto__',
+    '/constructor',
+    '/constructor/name',
+    '/toString',
+    '/hasOwnProperty',
+    '/valueOf',
+  ]) {
+    assertFails(document, pointer, 'unresolved');
+  }
+});
+
+test('resolves an own member named like a prototype property', () => {
+  // `JSON.parse` creates these as plain own properties, so they are ordinary members.
+  const document = JSON.parse('{"__proto__": {"a": 1}, "constructor": 2, "toString": 3}');
+  assert.deepEqual(resolvePointer(document, '/__proto__'), { a: 1 });
+  assert.equal(resolvePointer(document, '/__proto__/a'), 1);
+  assert.equal(resolvePointer(document, '/constructor'), 2);
+  assert.equal(resolvePointer(document, '/toString'), 3);
+});
+
+test('names the pointer and the failure in the error message', () => {
+  assert.match(
+    assertFails({ a: {} }, '/a/b', 'unresolved').message,
+    /"\/a\/b".*"\/a".*"b"/,
+  );
+  // The pointer is echoed in its escaped form, so it can be pasted back as a pointer.
+  assert.match(assertFails({}, '/a~1b', 'unresolved').message, /"\/a~1b"/);
+  assert.match(assertFails({}, '/~01', 'unresolved').message, /"\/~01"/);
+  assert.match(assertFails({}, 'a', 'invalid-pointer').message, /"a".*start with "\/"/);
+  assert.match(assertFails({}, '/a~b', 'invalid-pointer').message, /"\/a~b".*"~"/);
+});
+
+test('stops at the first failing token, left to right', () => {
+  // The escape error is in the second token; the first token is already unresolvable. The
+  // pointer is validated as a whole before any traversal, so syntax wins.
+  assertFails({}, '/missing/~x', 'invalid-pointer');
+});
