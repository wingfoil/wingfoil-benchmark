diff --git a/src/json-pointer.ts b/src/json-pointer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f2b12a0e5c589e0cc5967bf081c51868f473e2ef
--- /dev/null
+++ b/src/json-pointer.ts
@@ -0,0 +1,192 @@
+/**
+ * JSON Pointer, as specified in [RFC 6901](https://www.rfc-editor.org/rfc/rfc6901).
+ *
+ * A JSON Pointer is a string that identifies one value inside a JSON document: either the empty
+ * string, which refers to the whole document, or a sequence of `/`-prefixed reference tokens, each
+ * naming an object member or an array element to step into. Because `/` separates tokens and `~`
+ * starts an escape sequence, those two characters are escaped inside a token as `~1` and `~0`.
+ *
+ * This module implements the string form of the syntax (RFC 6901 § 3) and its evaluation
+ * (RFC 6901 § 4). The URI fragment identifier form of § 6 (`#/foo/0`, with percent-encoding) is a
+ * different representation and is not accepted here: callers holding a fragment decode it to the
+ * string form first.
+ *
+ * @module
+ */
+
+import type { JsonValue } from './json-value.ts';
+
+/** Why a JSON Pointer operation failed. */
+export type JsonPointerErrorReason =
+  /** The pointer is not a syntactically valid JSON Pointer (RFC 6901 § 3). */
+  | 'invalid-pointer'
+  /** The pointer is well formed, but the document has no value at it (RFC 6901 § 4). */
+  | 'unresolved';
+
+/**
+ * Thrown when a JSON Pointer cannot be used against a document.
+ *
+ * The two failure modes are told apart by {@link JsonPointerErrorReason}: a malformed pointer is a
+ * fault of the pointer alone, while an unresolved one depends on the document, so callers that
+ * probe a document (`does this value exist?`) can catch `unresolved` and let `invalid-pointer`
+ * through as the bug it is.
+ */
+export class JsonPointerError extends Error {
+  override readonly name = 'JsonPointerError';
+
+  /** Which of the two failure modes occurred. */
+  readonly reason: JsonPointerErrorReason;
+
+  constructor(reason: JsonPointerErrorReason, message: string) {
+    super(message);
+    this.reason = reason;
+  }
+}
+
+/**
+ * The array index form of RFC 6901 § 4: `0`, or a digit string without a leading zero.
+ *
+ * Any other token on an array -- `-`, `01`, `1.0`, `-1`, `length` -- names no element.
+ */
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/** A `~` that starts no escape sequence, i.e. one not followed by `0` or `1`. */
+const DANGLING_ESCAPE = /~(?![01])/;
+
+/**
+ * Splits a JSON Pointer into its reference tokens, unescaped.
+ *
+ * The empty pointer yields no token; `/` yields one empty token. Unescaping replaces `~1` before
+ * `~0`, so that `~01` decodes to the two characters `~1` rather than to `/`.
+ *
+ * @throws {JsonPointerError} with reason `invalid-pointer` if `pointer` is not a string, does not
+ * start with `/` while non-empty, or contains a `~` that starts no escape sequence.
+ */
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== 'string') {
+    throw new JsonPointerError(
+      'invalid-pointer',
+      `Invalid JSON Pointer: expected a string, received ${describeType(pointer)}.`,
+    );
+  }
+  if (pointer === '') {
+    return [];
+  }
+  if (!pointer.startsWith('/')) {
+    throw new JsonPointerError(
+      'invalid-pointer',
+      `Invalid JSON Pointer ${quote(pointer)}: a non-empty pointer must start with "/".`,
+    );
+  }
+  if (DANGLING_ESCAPE.test(pointer)) {
+    throw new JsonPointerError(
+      'invalid-pointer',
+      `Invalid JSON Pointer ${quote(pointer)}: "~" must be followed by "0" or "1".`,
+    );
+  }
+  return pointer
+    .slice(1)
+    .split('/')
+    .map((token) => token.replaceAll('~1', '/').replaceAll('~0', '~'));
+}
+
+/**
+ * Returns the value `pointer` refers to inside `document`.
+ *
+ * The value is returned as it sits in the document, not copied, so mutating the result mutates the
+ * document. The empty pointer returns `document` itself.
+ *
+ * @param document the JSON document to evaluate the pointer against.
+ * @param pointer a JSON Pointer in string form, such as `/items/0/name`.
+ * @throws {JsonPointerError} with reason `invalid-pointer` if `pointer` is not a valid JSON
+ * Pointer, or `unresolved` if `document` has no value at `pointer`.
+ *
+ * @example
+ * resolvePointer({ items: [{ name: 'disk' }] }, '/items/0/name'); // 'disk'
+ * resolvePointer({ 'a/b': 1 }, '/a~1b'); // 1
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  const tokens = parsePointer(pointer);
+  let value = document;
+  for (const [index, token] of tokens.entries()) {
+    value = step(value, token, tokens, index);
+  }
+  return value;
+}
+
+/**
+ * Takes one step from `value` through `token`, the token at `index` of `tokens`.
+ *
+ * `tokens` and `index` only locate the step within the pointer, for the error message.
+ */
+function step(value: JsonValue, token: string, tokens: string[], index: number): JsonValue {
+  const at = () => describeLocation(tokens, index);
+
+  if (Array.isArray(value)) {
+    if (token === '-') {
+      throw unresolved(
+        tokens,
+        `${at()} is an array and "-" refers to the element after its last one, which does not exist`,
+      );
+    }
+    if (!ARRAY_INDEX.test(token)) {
+      throw unresolved(tokens, `${at()} is an array and ${quote(token)} is not an array index`);
+    }
+    const elementIndex = Number(token);
+    if (elementIndex >= value.length) {
+      throw unresolved(
+        tokens,
+        `${at()} is an array of length ${value.length}, so index ${elementIndex} is out of range`,
+      );
+    }
+    return value[elementIndex];
+  }
+
+  if (typeof value === 'object' && value !== null) {
+    // Only own members count: a JSON object has exactly the members it declares, so inherited
+    // properties such as `toString` or `__proto__` must not resolve.
+    if (!Object.hasOwn(value, token)) {
+      throw unresolved(tokens, `${at()} has no member ${quote(token)}`);
+    }
+    return value[token];
+  }
+
+  throw unresolved(tokens, `${at()} is ${describeType(value)}, which has no members`);
+}
+
+/** Builds the `unresolved` error for `tokens`, explaining the failure with `because`. */
+function unresolved(tokens: string[], because: string): JsonPointerError {
+  return new JsonPointerError(
+    'unresolved',
+    `JSON Pointer ${quote(formatPointer(tokens))} does not resolve: ${because}.`,
+  );
+}
+
+/** Names the value the pointer had reached before the token at `index`, for an error message. */
+function describeLocation(tokens: string[], index: number): string {
+  return index === 0
+    ? 'the document'
+    : `the value at ${quote(formatPointer(tokens.slice(0, index)))}`;
+}
+
+/** Joins reference tokens back into a JSON Pointer, escaping `~` and `/`. */
+function formatPointer(tokens: string[]): string {
+  return tokens.map((token) => `/${token.replaceAll('~', '~0').replaceAll('/', '~1')}`).join('');
+}
+
+/** Quotes a string for an error message, escaping it the way JSON would. */
+function quote(text: string): string {
+  return JSON.stringify(text);
+}
+
+/** Names the type of a value for an error message, as an English noun phrase. */
+function describeType(value: unknown): string {
+  if (value === null || value === undefined) {
+    return String(value);
+  }
+  if (Array.isArray(value)) {
+    return 'an array';
+  }
+  const type = typeof value;
+  return /^[aeiou]/.test(type) ? `an ${type}` : `a ${type}`;
+}
diff --git a/src/json-value.ts b/src/json-value.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bc5fcc4c6316a6eb65eccc1667f72b667883e27e
--- /dev/null
+++ b/src/json-value.ts
@@ -0,0 +1,10 @@
+/**
+ * A value that can appear in a JSON document, i.e. anything `JSON.parse` can return.
+ *
+ * It is the currency of this library: every building block takes and returns `JsonValue`, so
+ * documents can be passed from one to the next without casting.
+ */
+export type JsonValue = null | boolean | number | string | JsonValue[] | JsonObject;
+
+/** A JSON object: an unordered set of name/value members. */
+export type JsonObject = { [member: string]: JsonValue };
