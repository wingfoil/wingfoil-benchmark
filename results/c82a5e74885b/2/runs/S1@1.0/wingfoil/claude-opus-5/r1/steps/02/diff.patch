+test('test fails when the target does not exist', () => {
+  assertFails({ a: 1 }, [{ op: 'test', path: '/b', value: 1 }], 'test-failed');
+  assertFails({ a: 1 }, [{ op: 'test', path: '/b', value: null }], 'test-failed');
+  assertFails({}, [{ op: 'test', path: '/a/b', value: 1 }], 'test-failed');
