+// --- immutability ---------------------------------------------------------------------------
+
+test('the result shares nothing with the document it was built from', () => {
+  const document: JsonValue = { kept: { deep: [1, 2] }, dropped: 1 };
+  const result = applyPatch(document, [{ op: 'remove', path: '/dropped' }]) as {
+    kept: { deep: number[] };
+  };
+  assert.notEqual(result, document);
+  assert.notEqual(result.kept, document.kept);
+  assert.notEqual(result.kept.deep, (document.kept as { deep: number[] }).deep);
+  result.kept.deep.push(3);
+  assert.deepEqual(document, { kept: { deep: [1, 2] }, dropped: 1 });
+});
+
+test('the result shares nothing with the patch it was given', () => {
+  const value = { deep: [1] };
+  const patch: JsonPatch = [
+    { op: 'add', path: '/a', value },
+    { op: 'add', path: '/b', value },
+  ];
+  const result = applyPatch({}, patch) as { a: typeof value; b: typeof value };
+  assert.notEqual(result.a, value);
+  assert.notEqual(result.a, result.b, 'each insertion gets its own copy');
+  result.a.deep.push(2);
+  assert.deepEqual(value, { deep: [1] }, 'the patch must not be changed either');
+  assert.deepEqual(result.b, { deep: [1] });
+});
