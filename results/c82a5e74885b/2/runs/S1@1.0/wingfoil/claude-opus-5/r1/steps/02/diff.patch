+test('move is not fooled by a sibling whose name starts like the source', () => {
+  // "/ab" is not inside "/a": the prefix rule compares reference tokens, not characters.
+  assertPatches({ a: 1, ab: { c: 2 } }, [{ op: 'move', from: '/a', path: '/ab/c' }], {
+    ab: { c: 1 },
+  });
+});
+
+// --- copy -----------------------------------------------------------------------------------
+
+test('copy duplicates a value, leaving the source in place', () => {
+  assertPatches({ a: { x: 1 } }, [{ op: 'copy', from: '/a', path: '/b' }], {
+    a: { x: 1 },
+    b: { x: 1 },
