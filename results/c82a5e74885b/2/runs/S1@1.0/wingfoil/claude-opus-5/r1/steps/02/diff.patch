+ * @throws {JsonPatchError} with reason `test-failed`.
+ */
+function test(
+  document: JsonValue,
+  prepared: PreparedOperation,
+  path: readonly string[],
+  value: JsonValue,
+): void {
+  let found: JsonValue;
+  try {
+    found = resolveTokens(document, path);
+  } catch (error) {
+    if (error instanceof JsonPointerError) {
+      throw new JsonPatchError(
+        'test-failed',
+        `${describeOperation(prepared)} failed: the document has no value there.`,
