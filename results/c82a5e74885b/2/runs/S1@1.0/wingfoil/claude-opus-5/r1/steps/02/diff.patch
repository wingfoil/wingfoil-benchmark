+    assertFails({ a: 1 }, [{ op: 'test', path: '/a', value }], 'test-failed');
+  }
+  assertFails({ a: { x: 1 } }, [{ op: 'test', path: '/a', value: { x: 1, y: 2 } }], 'test-failed');
+  assertFails({ a: { x: 1, y: 2 } }, [{ op: 'test', path: '/a', value: { x: 1 } }], 'test-failed');
+  assertFails({ a: [1, 2] }, [{ op: 'test', path: '/a', value: [1] }], 'test-failed');
+  assertFails({ a: null }, [{ op: 'test', path: '/a', value: false }], 'test-failed');
+  assertFails({ a: 0 }, [{ op: 'test', path: '/a', value: false }], 'test-failed');
+  assertFails({ a: '' }, [{ op: 'test', path: '/a', value: null }], 'test-failed');
