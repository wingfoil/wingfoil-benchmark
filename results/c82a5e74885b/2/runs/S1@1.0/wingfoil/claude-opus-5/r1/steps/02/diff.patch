+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import {
+  JsonPatchError,
+  JsonPointerError,
+  applyPatch,
+  resolvePointer,
+  type JsonObject,
+  type JsonPatch,
+  type JsonValue,
+} from '../src/index.ts';
+
+/** Asserts that applying `patch` to `document` fails with a `JsonPatchError` carrying `reason`. */
+function assertFails(
+  document: JsonValue,
+  patch: JsonValue,
+  reason: 'invalid-patch' | 'operation-failed' | 'test-failed',
+): JsonPatchError {
+  const before = structuredClone(document);
+  let caught: unknown;
+  try {
+    applyPatch(document, patch);
+  } catch (error) {
+    caught = error;
+  }
+  assert.ok(
+    caught instanceof JsonPatchError,
+    `expected applyPatch(${JSON.stringify(patch)}) to throw a JsonPatchError, got ${String(caught)}`,
+  );
+  assert.equal(caught.reason, reason);
+  assert.ok(caught instanceof Error);
+  assert.equal(caught.name, 'JsonPatchError');
+  assert.ok(caught.message.length > 0);
+  // RFC 6902 § 5: a patch that fails leaves the document as it was.
+  assert.deepEqual(document, before, 'a failed patch must not change the document');
+  return caught;
+}
+
+/** Asserts that applying `patch` to `document` yields `expected`, without touching `document`. */
+function assertPatches(document: JsonValue, patch: JsonValue, expected: JsonValue): JsonValue {
+  const before = structuredClone(document);
+  const result = applyPatch(document, patch);
+  assert.deepEqual(result, expected);
+  assert.deepEqual(document, before, 'applyPatch must not change the document it is given');
+  return result;
+}
+
+// --- RFC 6902 appendix A: the specification's own examples, verbatim -------------------------
+
+test('A.1 adds an object member', () => {
+  assertPatches({ foo: 'bar' }, [{ op: 'add', path: '/baz', value: 'qux' }], {
+    baz: 'qux',
+    foo: 'bar',
+  });
+});
+
+test('A.2 adds an array element', () => {
+  assertPatches({ foo: ['bar', 'baz'] }, [{ op: 'add', path: '/foo/1', value: 'qux' }], {
+    foo: ['bar', 'qux', 'baz'],
+  });
+});
+
+test('A.3 removes an object member', () => {
+  assertPatches({ baz: 'qux', foo: 'bar' }, [{ op: 'remove', path: '/baz' }], { foo: 'bar' });
+});
+
+test('A.4 removes an array element', () => {
+  assertPatches({ foo: ['bar', 'qux', 'baz'] }, [{ op: 'remove', path: '/foo/1' }], {
+    foo: ['bar', 'baz'],
+  });
+});
+
+test('A.5 replaces a value', () => {
+  assertPatches(
+    { baz: 'qux', foo: 'bar' },
+    [{ op: 'replace', path: '/baz', value: 'boo' }],
+    { baz: 'boo', foo: 'bar' },
+  );
+});
+
+test('A.6 moves a value', () => {
+  assertPatches(
+    { foo: { bar: 'baz', waldo: 'fred' }, qux: { corge: 'grault' } },
+    [{ op: 'move', from: '/foo/waldo', path: '/qux/thud' }],
+    { foo: { bar: 'baz' }, qux: { corge: 'grault', thud: 'fred' } },
+  );
+});
+
+test('A.7 moves an array element', () => {
+  assertPatches(
+    { foo: ['all', 'grass', 'cows', 'eat'] },
+    [{ op: 'move', from: '/foo/1', path: '/foo/3' }],
+    { foo: ['all', 'cows', 'eat', 'grass'] },
+  );
+});
+
+test('A.8 tests a value successfully', () => {
+  const document: JsonValue = { baz: 'qux', foo: ['a', 2, 'c'] };
+  assertPatches(
+    document,
+    [
+      { op: 'test', path: '/baz', value: 'qux' },
+      { op: 'test', path: '/foo/1', value: 2 },
+    ],
+    document,
+  );
+});
+
+test('A.9 fails a comparison', () => {
+  assertFails({ baz: 'qux' }, [{ op: 'test', path: '/baz', value: 'bar' }], 'test-failed');
+});
+
+test('A.10 adds a nested member object', () => {
+  assertPatches(
+    { foo: 'bar' },
+    [{ op: 'add', path: '/child', value: { grandchild: {} } }],
+    { foo: 'bar', child: { grandchild: {} } },
+  );
+});
+
+test('A.11 ignores unrecognized operation members', () => {
+  assertPatches({ foo: 'bar' }, [{ op: 'add', path: '/baz', value: 'qux', xyz: 123 }], {
+    foo: 'bar',
+    baz: 'qux',
+  });
+});
+
+test('A.12 rejects adding to a nonexistent target', () => {
+  assertFails({ foo: 'bar' }, [{ op: 'add', path: '/baz/bat', value: 'qux' }], 'operation-failed');
+});
+
+test('A.14 unescapes ~1 before ~0, as RFC 6901 § 4 requires', () => {
+  const document: JsonValue = { '/': 9, '~1': 10 };
+  assertPatches(document, [{ op: 'test', path: '/~01', value: 10 }], document);
+  assertPatches(document, [{ op: 'test', path: '/~1', value: 9 }], document);
+});
+
+test('A.15 does not compare a string equal to a number', () => {
+  assertFails({ '/': 9, '~1': 10 }, [{ op: 'test', path: '/~01', value: '10' }], 'test-failed');
+});
+
+test('A.16 appends an array value with "-"', () => {
+  assertPatches({ foo: ['bar'] }, [{ op: 'add', path: '/foo/-', value: ['abc', 'def'] }], {
+    foo: ['bar', ['abc', 'def']],
+  });
+});
+
+// --- add ------------------------------------------------------------------------------------
+
+test('add replaces an existing object member', () => {
+  assertPatches({ a: 1, b: 2 }, [{ op: 'add', path: '/a', value: 9 }], { a: 9, b: 2 });
+});
+
+test('add on the empty path replaces the whole document', () => {
+  assertPatches({ a: 1 }, [{ op: 'add', path: '', value: [1, 2] }], [1, 2]);
+  assertPatches([1], [{ op: 'add', path: '', value: null }], null);
+  assertPatches(null, [{ op: 'add', path: '', value: { a: 1 } }], { a: 1 });
+});
+
+test('add inserts into an array at any position up to its length', () => {
+  assertPatches([1, 2, 3], [{ op: 'add', path: '/0', value: 0 }], [0, 1, 2, 3]);
+  assertPatches([1, 2, 3], [{ op: 'add', path: '/2', value: 0 }], [1, 2, 0, 3]);
+  assertPatches([1, 2, 3], [{ op: 'add', path: '/3', value: 0 }], [1, 2, 3, 0]);
+  assertPatches([], [{ op: 'add', path: '/0', value: 0 }], [0]);
+  assertPatches([], [{ op: 'add', path: '/-', value: 0 }], [0]);
+});
+
+test('add rejects an array index beyond the end', () => {
+  assertFails([1, 2], [{ op: 'add', path: '/3', value: 0 }], 'operation-failed');
+  assertFails([], [{ op: 'add', path: '/1', value: 0 }], 'operation-failed');
+});
+
+test('add rejects a token that is no array index on an array', () => {
+  for (const path of ['/01', '/a', '/', '/-1', '/1.0', '/length']) {
+    assertFails([1, 2], [{ op: 'add', path, value: 0 }], 'operation-failed');
+  }
+});
+
+test('add rejects a missing parent, however deep', () => {
+  assertFails({}, [{ op: 'add', path: '/a/b', value: 1 }], 'operation-failed');
+  assertFails({ a: {} }, [{ op: 'add', path: '/a/b/c', value: 1 }], 'operation-failed');
+  assertFails({ a: [] }, [{ op: 'add', path: '/a/0/b', value: 1 }], 'operation-failed');
+});
+
+test('add rejects a parent that is a primitive', () => {
+  assertFails({ a: 1 }, [{ op: 'add', path: '/a/b', value: 1 }], 'operation-failed');
+  assertFails({ a: null }, [{ op: 'add', path: '/a/b', value: 1 }], 'operation-failed');
+  assertFails(7, [{ op: 'add', path: '/a', value: 1 }], 'operation-failed');
+});
+
+test('add writes an own member, even one named like a prototype property', () => {
+  const result = applyPatch({}, [{ op: 'add', path: '/__proto__', value: { polluted: true } }]);
+  // An object literal cannot express the expectation -- `__proto__:` in one sets the prototype --
+  // so the result is compared as the JSON text it serializes to.
+  assert.ok(Object.hasOwn(result as object, '__proto__'));
+  assert.equal(JSON.stringify(result), '{"__proto__":{"polluted":true}}');
+  assert.equal(({} as { polluted?: boolean }).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  // The member is an ordinary one from then on: it resolves, and it can be read back and removed.
+  assert.equal(resolvePointer(result, '/__proto__/polluted'), true);
+  assert.equal(JSON.stringify(applyPatch(result, [{ op: 'remove', path: '/__proto__' }])), '{}');
+});
+
+test('add accepts every kind of JSON value', () => {
+  const values: JsonValue[] = [null, true, 0, -1.5, '', 'text', [], {}, { a: [1, { b: null }] }];
+  for (const value of values) {
+    assertPatches({}, [{ op: 'add', path: '/x', value }], { x: value });
+  }
+});
+
+// --- remove ---------------------------------------------------------------------------------
+
+test('remove deletes an object member, leaving the others', () => {
+  assertPatches({ a: 1, b: 2 }, [{ op: 'remove', path: '/a' }], { b: 2 });
+  assertPatches({ a: { b: { c: 1 }, d: 2 } }, [{ op: 'remove', path: '/a/b/c' }], {
+    a: { b: {}, d: 2 },
+  });
+});
+
+test('remove deletes a member holding null', () => {
+  assertPatches({ a: null }, [{ op: 'remove', path: '/a' }], {});
+});
+
+test('remove closes the gap in an array', () => {
+  assertPatches([1, 2, 3], [{ op: 'remove', path: '/0' }], [2, 3]);
+  assertPatches([1, 2, 3], [{ op: 'remove', path: '/2' }], [1, 2]);
+  assertPatches([1], [{ op: 'remove', path: '/0' }], []);
+});
+
+test('remove requires the target to exist', () => {
+  assertFails({ a: 1 }, [{ op: 'remove', path: '/b' }], 'operation-failed');
+  assertFails({}, [{ op: 'remove', path: '/a/b' }], 'operation-failed');
+  assertFails([1], [{ op: 'remove', path: '/1' }], 'operation-failed');
+  assertFails([1], [{ op: 'remove', path: '/-' }], 'operation-failed');
+  assertFails([1], [{ op: 'remove', path: '/01' }], 'operation-failed');
+  assertFails({ a: 1 }, [{ op: 'remove', path: '/a/b' }], 'operation-failed');
+});
+
+test('remove cannot remove the whole document, whatever the document', () => {
+  assertFails({ a: 1 }, [{ op: 'remove', path: '' }], 'invalid-patch');
+  assertFails(null, [{ op: 'remove', path: '' }], 'invalid-patch');
+});
+
+// --- replace --------------------------------------------------------------------------------
+
+test('replace overwrites an existing value, whatever its type', () => {
+  assertPatches({ a: 1 }, [{ op: 'replace', path: '/a', value: { b: [] } }], { a: { b: [] } });
+  assertPatches([1, 2], [{ op: 'replace', path: '/1', value: 'two' }], [1, 'two']);
+  assertPatches({ a: null }, [{ op: 'replace', path: '/a', value: false }], { a: false });
+});
+
+test('replace on the empty path replaces the whole document', () => {
+  assertPatches({ a: 1 }, [{ op: 'replace', path: '', value: 'done' }], 'done');
+});
+
+test('replace requires the target to exist', () => {
+  assertFails({ a: 1 }, [{ op: 'replace', path: '/b', value: 2 }], 'operation-failed');
+  assertFails({}, [{ op: 'replace', path: '/a/b', value: 2 }], 'operation-failed');
+  assertFails([1], [{ op: 'replace', path: '/1', value: 2 }], 'operation-failed');
+  assertFails([1], [{ op: 'replace', path: '/-', value: 2 }], 'operation-failed');
+});
+
+test('replace does not append to an array', () => {
+  assertFails([1, 2], [{ op: 'replace', path: '/2', value: 3 }], 'operation-failed');
+});
+
+// --- move -----------------------------------------------------------------------------------
+
+test('move relocates a value between containers of any kind', () => {
+  assertPatches({ a: { x: 1 }, b: [] }, [{ op: 'move', from: '/a/x', path: '/b/0' }], {
+    a: {},
+    b: [1],
+  });
+  assertPatches({ a: [1, 2], b: {} }, [{ op: 'move', from: '/a/1', path: '/b/here' }], {
+    a: [1],
+    b: { here: 2 },
+  });
+});
+
+test('move inside one array removes before it adds', () => {
+  assertPatches([1, 2, 3], [{ op: 'move', from: '/0', path: '/2' }], [2, 3, 1]);
+  assertPatches([1, 2, 3], [{ op: 'move', from: '/2', path: '/0' }], [3, 1, 2]);
+  assertPatches([1, 2, 3], [{ op: 'move', from: '/1', path: '/-' }], [1, 3, 2]);
+});
+
+test('move counts the destination index in the array it has already left', () => {
+  // RFC 6902 § 4.4 makes a move a remove followed by an add, so the last index an element can move
+  // to is the end of the array it was taken out of: index 3 of a four-element array is past it.
+  assertPatches([1, 2, 3, 4], [{ op: 'move', from: '/0', path: '/3' }], [2, 3, 4, 1]);
+  assertFails([1, 2, 3], [{ op: 'move', from: '/0', path: '/3' }], 'operation-failed');
+});
+
+test('move to the same location leaves the document unchanged', () => {
+  assertPatches({ a: 1, b: 2 }, [{ op: 'move', from: '/a', path: '/a' }], { a: 1, b: 2 });
+  assertPatches([1, 2], [{ op: 'move', from: '/1', path: '/1' }], [1, 2]);
+});
+
+test('move moves the value itself, not a copy of it', () => {
+  const inner = { deep: true };
+  const result = applyPatch({ a: inner }, [{ op: 'move', from: '/a', path: '/b' }]) as {
+    b: { deep: boolean };
+  };
+  assert.deepEqual(result, { b: { deep: true } });
+  assert.notEqual(result.b, inner, 'the result must not share the input document');
+});
+
+test('move requires the source to exist', () => {
+  assertFails({ a: 1 }, [{ op: 'move', from: '/b', path: '/c' }], 'operation-failed');
+  assertFails([1], [{ op: 'move', from: '/-', path: '/0' }], 'operation-failed');
+});
+
+test('move requires the destination parent to exist', () => {
+  assertFails({ a: 1 }, [{ op: 'move', from: '/a', path: '/b/c' }], 'operation-failed');
+  assertFails({ a: 1, b: [] }, [{ op: 'move', from: '/a', path: '/b/1' }], 'operation-failed');
+});
