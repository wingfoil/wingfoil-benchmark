diff --git a/src/message.ts b/src/message.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8ca6d24d2dabeb7774ea23b0f51c51ac589ea8ce
--- /dev/null
+++ b/src/message.ts
@@ -0,0 +1,47 @@
+/**
+ * Rendering of values inside the library's error messages.
+ *
+ * Every building block reports failures in the same vocabulary, so these helpers live next to the
+ * types rather than in one of the features: a pointer that does not resolve and a patch operation
+ * that fails name a value the same way.
+ *
+ * @module
+ */
+
+import type { JsonValue } from './json-value.ts';
+
+/** How much of a value {@link preview} shows before cutting it short. */
+const PREVIEW_LENGTH = 60;
+
+/** Quotes a string for an error message, escaping it the way JSON would. */
+export function quote(text: string): string {
+  return JSON.stringify(text);
+}
+
+/** Names the type of a value for an error message, as an English noun phrase. */
+export function describeType(value: unknown): string {
+  if (value === null || value === undefined) {
+    return String(value);
+  }
+  if (Array.isArray(value)) {
+    return 'an array';
+  }
+  const type = typeof value;
+  return /^[aeiou]/.test(type) ? `an ${type}` : `a ${type}`;
+}
+
+/** Counts things in an error message, pluralizing the noun: `1 element`, `2 elements`. */
+export function count(amount: number, noun: string): string {
+  return `${amount} ${noun}${amount === 1 ? '' : 's'}`;
+}
+
+/**
+ * Renders a value for an error message, as the JSON text of it, cut short when it is long.
+ *
+ * A message is read by a human, so a whole document in it would hide the sentence around it; the
+ * first {@link PREVIEW_LENGTH} characters are enough to recognize which value is meant.
+ */
+export function preview(value: JsonValue): string {
+  const text = JSON.stringify(value) ?? String(value);
+  return text.length <= PREVIEW_LENGTH ? text : `${text.slice(0, PREVIEW_LENGTH)}...`;
+}
