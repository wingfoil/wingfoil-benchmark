+test('test ignores the order of object members but not of array elements', () => {
+  assertPatches({ a: { x: 1, y: 2 } }, [{ op: 'test', path: '/a', value: { y: 2, x: 1 } }], {
+    a: { x: 1, y: 2 },
+  });
+  assertFails({ a: [1, 2] }, [{ op: 'test', path: '/a', value: [2, 1] }], 'test-failed');
+});
