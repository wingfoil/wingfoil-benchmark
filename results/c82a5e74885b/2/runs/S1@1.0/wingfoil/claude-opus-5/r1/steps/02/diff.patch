+test('move cannot move the whole document', () => {
+  assertFails({ a: 1 }, [{ op: 'move', from: '', path: '/a' }], 'invalid-patch');
+  assertFails({ a: 1 }, [{ op: 'move', from: '', path: '' }], 'invalid-patch');
+});
