+test('move rejects a destination inside the value it moves, whatever the document', () => {
+  // RFC 6902 § 4.4: the "from" location must not be a proper prefix of the "path" location. No
+  // document can satisfy such an operation, so it is the patch that is wrong, not the pair.
+  assertFails({ a: { b: {} } }, [{ op: 'move', from: '/a', path: '/a/b/c' }], 'invalid-patch');
+  assertFails({ a: { b: {} } }, [{ op: 'move', from: '/a', path: '/a/c' }], 'invalid-patch');
+  assertFails({ a: [[]] }, [{ op: 'move', from: '/a', path: '/a/0/0' }], 'invalid-patch');
+  assertFails({}, [{ op: 'move', from: '/a', path: '/a/b' }], 'invalid-patch');
