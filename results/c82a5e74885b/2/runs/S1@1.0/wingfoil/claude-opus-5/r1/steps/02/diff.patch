+test('a failing operation cancels the whole patch, leaving the document untouched', () => {
+  const document: JsonValue = { a: 1, b: { c: [2, 3] } };
+  assertFails(
+    document,
+    [
+      { op: 'remove', path: '/a' },
+      { op: 'add', path: '/b/c/-', value: 4 },
+      { op: 'test', path: '/b/c/0', value: 'two' },
+    ],
+    'test-failed',
+  );
+});
