+// --- test -----------------------------------------------------------------------------------
+
+test('test compares values the way RFC 6902 § 4.6 defines', () => {
+  const document: JsonValue = {
+    s: 'text',
+    n: 1.5,
+    t: true,
+    z: null,
+    a: [1, [2, { b: 'c' }]],
+    o: { x: 1, y: [true, null] },
