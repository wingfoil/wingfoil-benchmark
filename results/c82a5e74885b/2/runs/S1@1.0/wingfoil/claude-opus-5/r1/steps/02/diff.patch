+/**
+ * Returns the value at the location `path` names, which must exist.
+ *
+ * The `JsonPointerError` saying which token did not resolve is kept as the failure's `cause`.
+ */
+function read(
+  document: JsonValue,
+  prepared: PreparedOperation,
+  path: readonly string[],
+): JsonValue {
+  try {
+    return resolveTokens(document, path);
+  } catch (error) {
+    if (error instanceof JsonPointerError) {
+      throw failed(prepared, `the document has no value at ${quote(formatPointer(path))}`, {
+        cause: error,
+      });
+    }
+    throw error;
+  }
+}
+
+/** A place inside a document: a container, and the reference token naming a spot in it. */
+interface Place {
+  /** The object or array the operation writes in. */
+  readonly container: JsonObject | JsonValue[];
+  /** The last token of the operation's pointer, naming the spot inside `container`. */
+  readonly token: string;
+  /** The tokens leading to `container`, which name it in the error messages. */
+  readonly parent: readonly string[];
+}
+
+/**
+ * Locates the place the last token of `path` names, inside the container the others lead to.
+ *
+ * `path` must have at least one token: the document as a whole sits in no container, which is why
+ * the operations that can name it handle that case before coming here.
+ *
+ * @throws {JsonPatchError} with reason `operation-failed` if the document holds no value where the
+ * tokens before the last one lead, or holds one that has no members there.
+ */
+function placeOf(
+  document: JsonValue,
+  prepared: PreparedOperation,
+  path: readonly string[],
+): Place {
+  const parent = path.slice(0, -1);
+  const container = read(document, prepared, parent);
+  if (!Array.isArray(container) && !isJsonObject(container)) {
+    throw failed(
+      prepared,
+      `${describeLocation(parent)} is ${describeType(container)}, which has no members`,
+    );
+  }
+  return { container, token: path[path.length - 1], parent };
