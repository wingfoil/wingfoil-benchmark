+
+/** Returns the index the place names in `container`, which must hold an element there. */
+function requireIndex(place: Place, container: JsonValue[], prepared: PreparedOperation): number {
+  const at = () => describeLocation(place.parent);
+  const index = arrayIndex(place.token);
+  if (index === undefined) {
+    throw failed(prepared, `${at()} is an array and ${quote(place.token)} is not an array index`);
+  }
+  if (index >= container.length) {
+    throw failed(
+      prepared,
+      `${at()} is an array of ${count(container.length, 'element')}, so it has no index ${index}`,
+    );
+  }
+  return index;
+}
+
+/** Returns the member the place names in `container`, which must declare it. */
+function requireMember(
+  place: Place,
+  container: JsonObject,
+  prepared: PreparedOperation,
+): JsonValue {
+  // Own members only, as RFC 6901 § 4 evaluation does: an inherited `toString` is not a member.
+  if (!Object.hasOwn(container, place.token)) {
+    throw failed(prepared, `${describeLocation(place.parent)} has no member ${quote(place.token)}`);
+  }
+  return container[place.token];
+}
+
+/** Builds the `operation-failed` error for an operation, explaining the failure with `because`. */
+function failed(
+  prepared: PreparedOperation,
+  because: string,
+  options?: ErrorOptions,
+): JsonPatchError {
+  return new JsonPatchError(
+    'operation-failed',
+    `${describeOperation(prepared)} failed: ${because}.`,
+    options,
+  );
+}
+
+/**
+ * Names an operation by its position, its `op` and its pointers, for an error message.
+ *
+ * Only the pointers the operation defines are named: a `from` member on an `add`, which RFC 6902
+ * § 4 has it ignore, is left out of the message as it is left out of the operation.
+ */
+function describeOperation(prepared: PreparedOperation): string {
+  const where =
+    'from' in prepared
+      ? `from ${quote(prepared.operation.from)} to ${quote(prepared.operation.path)}`
+      : `at ${quote(prepared.operation.path)}`;
+  return `JSON Patch operation ${prepared.index} (${quote(prepared.operation.op)} ${where})`;
+}
+
+// --- JSON values ----------------------------------------------------------------------------
+
+/**
+ * Deep-copies a JSON value, so that the copy shares no object or array with the original.
+ *
+ * Members are defined rather than assigned, so that a document declaring `__proto__` -- as
+ * `JSON.parse` lets it -- keeps it as the plain member it is instead of changing the copy's
+ * prototype.
+ */
+function cloneJson(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(cloneJson);
+  }
+  if (isJsonObject(value)) {
+    const copy: JsonObject = {};
+    for (const [member, held] of Object.entries(value)) {
+      setMember(copy, member, cloneJson(held));
+    }
+    return copy;
+  }
+  return value;
+}
+
+/**
+ * Whether two JSON values are equal in the sense of RFC 6902 § 4.6.
+ *
+ * Primitives are compared by value, arrays member by member and in order, objects by their set of
+ * members, whatever order they are written in; nothing is compared across types, so the string
+ * `"10"` does not equal the number `10`.
+ */
+function jsonEquals(left: JsonValue, right: JsonValue): boolean {
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return (
+      Array.isArray(left) &&
+      Array.isArray(right) &&
+      left.length === right.length &&
+      left.every((element, index) => jsonEquals(element, right[index]))
+    );
+  }
+  if (isJsonObject(left) || isJsonObject(right)) {
+    if (!isJsonObject(left) || !isJsonObject(right)) {
+      return false;
+    }
+    const members = Object.keys(left);
+    return (
+      members.length === Object.keys(right).length &&
+      members.every(
+        (member) => Object.hasOwn(right, member) && jsonEquals(left[member], right[member]),
+      )
+    );
+  }
+  return left === right;
+}
+
+/** Whether `value` is a JSON object, as opposed to an array, `null` or a primitive. */
+function isJsonObject(value: JsonValue): value is JsonObject {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Writes `value` as the `name` member of `object`.
+ *
+ * Defining the property rather than assigning it is what makes a member named `__proto__` an
+ * ordinary member: assigning that name would set the prototype instead, and the member would not
+ * exist at all.
+ */
+function setMember(object: JsonObject, name: string, value: JsonValue): void {
+  Object.defineProperty(object, name, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
