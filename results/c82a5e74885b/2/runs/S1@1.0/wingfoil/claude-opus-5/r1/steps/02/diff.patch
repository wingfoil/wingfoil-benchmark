@@ -0,0 +1,615 @@
+/**
+ * JSON Patch, as specified in [RFC 6902](https://www.rfc-editor.org/rfc/rfc6902).
+ *
+ * A JSON Patch is an array of operations -- `add`, `remove`, `replace`, `move`, `copy` and `test` --
+ * each naming the value it acts on with a JSON Pointer (RFC 6901). Applied in order, they describe
+ * a change to a JSON document: the format services use to send an update of a document instead of
+ * the whole document.
+ *
+ * A patch is all or nothing (RFC 6902 § 5): if any operation fails, the document is left exactly as
+ * it was. {@link applyPatch} keeps that promise by building the result beside the document it is
+ * given and returning it only once every operation has succeeded.
+ *
+ * @module
+ */
+
+import {
+  JsonPointerError,
+  arrayIndex,
+  describeLocation,
+  formatPointer,
+  parsePointer,
+  resolveTokens,
+} from './json-pointer.ts';
+import type { JsonObject, JsonValue } from './json-value.ts';
+import { count, describeType, preview, quote } from './message.ts';
+
+/** Why applying a JSON Patch failed. */
+export type JsonPatchErrorReason =
+  /** The patch is not a valid JSON Patch, whatever document it were applied to (RFC 6902 § 4). */
+  | 'invalid-patch'
+  /** The patch is valid, but one of its operations does not fit the document it was applied to. */
+  | 'operation-failed'
+  /** A `test` operation did not hold: the document has another value, or none, at its `path`. */
+  | 'test-failed';
+
+/**
+ * Thrown when a JSON Patch cannot be applied to a document.
+ *
+ * The three failure modes of {@link JsonPatchErrorReason} are the three answers a caller acts on
+ * differently: `invalid-patch` blames the patch alone, so the sender must fix it;
+ * `operation-failed` blames the pair, so the patch was written against another document; and
+ * `test-failed` is the answer a `test` operation exists to give, the precondition a caller put in
+ * the patch on purpose. The message names the operation by its position in the patch, which is the
+ * only thing that tells two otherwise identical operations apart.
+ */
+export class JsonPatchError extends Error {
+  override readonly name = 'JsonPatchError';
+
+  /** Which of the three failure modes occurred. */
+  readonly reason: JsonPatchErrorReason;
+
+  constructor(reason: JsonPatchErrorReason, message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.reason = reason;
+  }
+}
+
+/** One operation of a JSON Patch (RFC 6902 § 4). */
+export type JsonPatchOperation =
+  /** Adds `value` at `path`: a member, an element inserted in an array, or the whole document. */
+  | { readonly op: 'add'; readonly path: string; readonly value: JsonValue }
+  /** Removes the value at `path`, closing the gap when it is an array element. */
+  | { readonly op: 'remove'; readonly path: string }
+  /** Replaces the value at `path`, which must exist, with `value`. */
+  | { readonly op: 'replace'; readonly path: string; readonly value: JsonValue }
+  /** Removes the value at `from` and adds it at `path`. */
+  | { readonly op: 'move'; readonly from: string; readonly path: string }
+  /** Adds a copy of the value at `from` at `path`, leaving `from` as it is. */
+  | { readonly op: 'copy'; readonly from: string; readonly path: string }
+  /** Succeeds only if the value at `path` equals `value` (RFC 6902 § 4.6). */
+  | { readonly op: 'test'; readonly path: string; readonly value: JsonValue };
+
+/** A JSON Patch: the operations to apply to a document, in order (RFC 6902 § 3). */
+export type JsonPatch = readonly JsonPatchOperation[];
+
+/** The two operations that take their value from another location: `move` and `copy`. */
+type TransferOperation = Extract<JsonPatchOperation, { from: string }>;
+
+/**
+ * The six operations of RFC 6902 § 4, with the members each one requires besides its `path`.
+ *
+ * Declaring them here is what makes an unknown `op` a patch error rather than a silent no-op, and
+ * keeps the names the error messages list in step with the names that are accepted.
+ */
+const OPERATIONS = {
+  add: { value: true, from: false },
+  remove: { value: false, from: false },
+  replace: { value: true, from: false },
+  move: { value: false, from: true },
+  copy: { value: false, from: true },
+  test: { value: true, from: false },
+} as const;
+
+/**
+ * An operation whose shape has been checked and whose pointers are parsed into their tokens.
+ *
+ * `move` and `copy` form their own variant, carrying the tokens of their `from` as well: that is
+ * what lets the code that applies them read a `from` that is known to be there.
+ */
+type PreparedOperation =
+  | {
+      /** Its position in the patch, counted from 0, as the error messages name it. */
+      readonly index: number;
+      /** The operation itself, now known to carry the members its `op` requires. */
+      readonly operation: Exclude<JsonPatchOperation, TransferOperation>;
+      /** The reference tokens of its `path`. */
+      readonly path: readonly string[];
+    }
+  | {
+      readonly index: number;
+      readonly operation: TransferOperation;
+      readonly path: readonly string[];
+      /** The reference tokens of its `from`: where the value it adds comes from. */
+      readonly from: readonly string[];
+    };
+
+/**
+ * Applies a JSON Patch to a JSON document and returns the patched document.
+ *
+ * The result is a new value: `document` is left untouched, and no part of it, nor of `patch`, is
+ * shared with the result, so the three can be changed afterwards without affecting each other.
+ * Nothing is applied unless everything applies -- a patch that fails anywhere changes nothing at
+ * all (RFC 6902 § 5) -- and the patch is checked as a whole before the first operation runs.
+ *
+ * @param document the JSON document to patch.
+ * @param patch a JSON Patch: an array of operations, as {@link JsonPatch} describes them. Any JSON
+ * value is accepted and validated at run time, so a patch parsed from JSON text -- which is how one
+ * usually arrives -- can be passed in as it is, without a cast.
+ * @returns the patched document, as a new value.
+ * @throws {JsonPatchError} with reason `invalid-patch` if `patch` is not a valid JSON Patch,
+ * `test-failed` if a `test` operation does not hold, or `operation-failed` if another operation
+ * cannot be applied to `document`.
+ *
+ * @example
+ * applyPatch({ items: ['disk'] }, [
+ *   { op: 'add', path: '/items/-', value: 'tape' },
+ *   { op: 'test', path: '/items/0', value: 'disk' },
+ * ]); // { items: ['disk', 'tape'] }
+ */
+export function applyPatch(document: JsonValue, patch: JsonPatch | JsonValue): JsonValue {
+  const operations = preparePatch(patch);
+  // The copy is what the operations change; `document` itself is never touched, which is both the
+  // promise of a new value and what makes a failing patch leave the document as it was.
+  let result = cloneJson(document);
+  for (const prepared of operations) {
+    result = applyOperation(result, prepared);
+  }
+  return result;
+}
+
+// --- validating the patch -------------------------------------------------------------------
+
+/**
+ * Checks `patch` and prepares each of its operations, in order.
+ *
+ * Everything that can be decided from the patch alone is decided here, before any operation
+ * touches the document: the shape of each operation, the syntax of its pointers, and the two
+ * operations RFC 6902 describes that no document could satisfy -- removing or moving the whole
+ * document, and moving a value into one of its own children.
+ *
+ * @throws {JsonPatchError} with reason `invalid-patch`.
+ */
+function preparePatch(patch: JsonPatch | JsonValue): PreparedOperation[] {
+  if (!Array.isArray(patch)) {
+    throw new JsonPatchError(
+      'invalid-patch',
+      `Invalid JSON Patch: expected an array of operations, received ${describeType(patch)}.`,
+    );
+  }
+  // `Array.from` rather than `map`, which would skip the holes of a sparse array -- impossible in
+  // parsed JSON, but a caller can hand-build one -- and leave them unchecked in the result.
+  return Array.from(patch, prepareOperation);
+}
+
+/** Checks one operation of a patch, at `index`, and parses its pointers. @see preparePatch */
+function prepareOperation(operation: JsonValue, index: number): PreparedOperation {
+  if (!isJsonObject(operation)) {
+    throw invalid(index, `expected a JSON object, received ${describeType(operation)}`);
+  }
+
+  const op = operation['op'];
+  if (typeof op !== 'string') {
+    throw invalid(index, `its "op" must be a string, found ${describeType(op)}`);
+  }
+  if (!isOperationName(op)) {
+    throw invalid(
+      index,
+      `${quote(op)} is not one of the operations of RFC 6902 (${operationNames()})`,
+    );
+  }
+  const required = OPERATIONS[op];
+
+  const path = parseMemberPointer(operation, 'path', op, index);
+  // `undefined` is not a JSON value, so a `value` member holding it counts as absent.
+  if (required.value && operation['value'] === undefined) {
+    throw invalid(index, `${quote(op)} requires a "value" member`);
+  }
+  if (op === 'remove' && path.length === 0) {
+    throw invalid(index, 'the whole document cannot be removed');
+  }
+
+  // The checks above are what make the assertions below true: the operation carries an `op` of one
+  // of the six names and the members that one requires, which is all the types promise.
+  if (!required.from) {
+    const checked = operation as Exclude<JsonPatchOperation, TransferOperation>;
+    return { index, operation: checked, path };
+  }
+
+  const from = parseMemberPointer(operation, 'from', op, index);
+  if (op === 'move') {
+    if (from.length === 0) {
+      throw invalid(index, 'the whole document cannot be moved');
+    }
+    if (isProperPrefix(from, path)) {
+      throw invalid(index, 'a value cannot be moved into one of its own children');
+    }
+  }
+  return { index, operation: operation as TransferOperation, path, from };
+}
+
+/**
+ * Parses the `path` or `from` member of an operation into its reference tokens.
+ *
+ * @throws {JsonPatchError} with reason `invalid-patch` if the member is missing, is not a string,
+ * or is not a valid JSON Pointer; the `JsonPointerError` that said why is kept as the `cause`.
+ */
+function parseMemberPointer(
+  operation: JsonObject,
+  member: 'path' | 'from',
+  op: string,
+  index: number,
+): string[] {
+  const pointer = operation[member];
+  if (typeof pointer !== 'string') {
+    const found = describeType(pointer);
+    throw invalid(
+      index,
+      `${quote(op)} requires a ${quote(member)} member holding a JSON Pointer, found ${found}`,
+    );
+  }
+  try {
+    return parsePointer(pointer);
+  } catch (error) {
+    if (error instanceof JsonPointerError) {
+      // The pointer error's own message says what is wrong with it; its final stop is dropped, as
+      // the sentence it is quoted in ends with one of its own.
+      const why = error.message.replace(/\.$/, '');
+      throw invalid(index, `its ${quote(member)} is not a valid JSON Pointer -- ${why}`, {
+        cause: error,
+      });
+    }
+    throw error;
+  }
+}
+
+/** Builds the `invalid-patch` error for the operation at `index`, explaining it with `because`. */
+function invalid(index: number, because: string, options?: ErrorOptions): JsonPatchError {
+  return new JsonPatchError(
+    'invalid-patch',
+    `Invalid JSON Patch operation ${index}: ${because}.`,
+    options,
+  );
+}
+
+/** Whether `op` names one of the six operations of RFC 6902 § 4. */
+function isOperationName(op: string): op is JsonPatchOperation['op'] {
+  return Object.hasOwn(OPERATIONS, op);
+}
+
+/** Lists the accepted `op` values, for an error message. */
+function operationNames(): string {
+  return Object.keys(OPERATIONS).map(quote).join(', ');
+}
+
+/** Whether `prefix` locates an ancestor of `tokens`, i.e. is a shorter pointer that leads to it. */
+function isProperPrefix(prefix: readonly string[], tokens: readonly string[]): boolean {
+  return prefix.length < tokens.length && prefix.every((token, index) => token === tokens[index]);
+}
+
+// --- applying one operation -----------------------------------------------------------------
+
+/**
+ * Applies one prepared operation to `document`, which it may change in place.
+ *
+ * @returns the patched document: `document` itself, or the new value when the operation replaces
+ * the document as a whole (the only thing an operation cannot do in place).
+ */
+function applyOperation(document: JsonValue, prepared: PreparedOperation): JsonValue {
+  if ('from' in prepared) {
+    // Both operations add at `path` a value taken from `from`, and differ only in what they leave
+    // behind: a `move` takes the value out of the document (RFC 6902 § 4.4), a `copy` duplicates it
+    // (§ 4.5). Removing first is what makes moving an array element to a later index land before
+    // where it was counted, the elements having shifted down already.
+    const value =
+      prepared.operation.op === 'move'
+        ? remove(document, prepared, prepared.from)
+        : cloneJson(read(document, prepared, prepared.from));
+    return add(document, prepared, prepared.path, value);
+  }
+
+  const { operation, path } = prepared;
+  switch (operation.op) {
+    case 'add':
+      return add(document, prepared, path, cloneJson(operation.value));
+    case 'remove':
+      remove(document, prepared, path);
+      return document;
+    case 'replace':
+      return replace(document, prepared, path, cloneJson(operation.value));
+    case 'test':
+      test(document, prepared, path, operation.value);
+      return document;
+  }
