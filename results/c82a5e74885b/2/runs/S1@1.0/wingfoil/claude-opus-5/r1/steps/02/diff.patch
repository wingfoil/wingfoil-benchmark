+    ['/z', null],
+    ['/a', [1, [2, { b: 'c' }]]],
+    ['/a/1/1', { b: 'c' }],
+    ['/o', { x: 1, y: [true, null] }],
+  ] as [string, JsonValue][]) {
+    assertPatches(document, [{ op: 'test', path, value }], document);
+  }
+});
