+// --- the patch as a whole -------------------------------------------------------------------
+
+test('an empty patch returns the document unchanged', () => {
+  const document: JsonValue = { a: [1, { b: 'c' }] };
+  const result = assertPatches(document, [], document);
+  assert.notEqual(result, document, 'the result is a new value, even for an empty patch');
+});
+
+test('operations apply in order, each seeing the result of the ones before it', () => {
+  assertPatches(
+    { a: 1 },
+    [
+      { op: 'add', path: '/b', value: [] },
+      { op: 'add', path: '/b/-', value: 'first' },
+      { op: 'add', path: '/b/-', value: 'second' },
+      { op: 'test', path: '/b/1', value: 'second' },
+      { op: 'move', from: '/a', path: '/b/0' },
+      { op: 'copy', from: '/b/0', path: '/c' },
+      { op: 'remove', path: '/b/1' },
+      { op: 'replace', path: '/c', value: 'done' },
