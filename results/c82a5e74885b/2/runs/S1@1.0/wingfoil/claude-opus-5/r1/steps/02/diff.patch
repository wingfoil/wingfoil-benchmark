+test('a frozen document can be patched: nothing is written into it', () => {
+  // Frozen in place, so the document keeps its `JsonValue` type: freezing is a run-time property.
+  const document: JsonValue = { a: [1, 2], b: 1 };
+  Object.freeze((document as JsonObject)['a']);
+  Object.freeze(document);
+  assertPatches(document, [{ op: 'add', path: '/a/-', value: 3 }], { a: [1, 2, 3], b: 1 });
+  assertPatches(document, [{ op: 'remove', path: '/b' }], { a: [1, 2] });
+  assertPatches(document, [{ op: 'replace', path: '/a/0', value: 0 }], { a: [0, 2], b: 1 });
+});
+
+test('a document that is a bare value is returned as it is', () => {
+  for (const document of [null, true, 0, 'text'] as JsonValue[]) {
+    assert.equal(applyPatch(document, []), document);
+  }
+});
