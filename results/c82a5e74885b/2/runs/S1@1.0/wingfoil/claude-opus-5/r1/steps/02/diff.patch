+// --- invalid patches ------------------------------------------------------------------------
+
+test('rejects a patch that is not an array', () => {
+  for (const patch of [
+    undefined,
+    null,
+    0,
+    'add',
+    true,
+    {},
+    { op: 'add', path: '/a', value: 1 },
+  ] as JsonValue[]) {
+    assertFails({ a: 1 }, patch, 'invalid-patch');
+  }
+});
+
+test('rejects an operation that is not a JSON object', () => {
+  for (const operation of [null, 1, 'add', true, [], [{ op: 'add' }]] as JsonValue[]) {
+    assertFails({ a: 1 }, [operation], 'invalid-patch');
+  }
+});
+
+test('rejects a patch with a hole in it', () => {
+  const sparse = [{ op: 'add', path: '/b', value: 2 }];
+  sparse[2] = { op: 'add', path: '/c', value: 3 };
+  assertFails({ a: 1 }, sparse as unknown as JsonValue, 'invalid-patch');
+});
+
+test('rejects a missing, misspelled or non-string "op"', () => {
+  assertFails({ a: 1 }, [{ path: '/a' }], 'invalid-patch');
+  assertFails({ a: 1 }, [{ op: 'Add', path: '/a', value: 1 }], 'invalid-patch');
+  assertFails({ a: 1 }, [{ op: 'append', path: '/a', value: 1 }], 'invalid-patch');
+  assertFails({ a: 1 }, [{ op: '', path: '/a', value: 1 }], 'invalid-patch');
+  assertFails({ a: 1 }, [{ op: 1, path: '/a', value: 1 }], 'invalid-patch');
+  assertFails({ a: 1 }, [{ op: null, path: '/a', value: 1 }], 'invalid-patch');
+});
+
+test('rejects a missing or non-string "path"', () => {
+  for (const op of ['add', 'remove', 'replace', 'move', 'copy', 'test']) {
+    assertFails({ a: 1 }, [{ op, value: 1, from: '/a' }], 'invalid-patch');
+    assertFails({ a: 1 }, [{ op, path: 0, value: 1, from: '/a' }], 'invalid-patch');
+    assertFails({ a: 1 }, [{ op, path: null, value: 1, from: '/a' }], 'invalid-patch');
+  }
+});
+
+test('rejects a "value" that is missing where the operation needs one', () => {
+  for (const op of ['add', 'replace', 'test']) {
+    assertFails({ a: 1 }, [{ op, path: '/a' }], 'invalid-patch');
+    const withUndefined = [{ op, path: '/a', value: undefined }] as unknown as JsonValue;
+    assertFails({ a: 1 }, withUndefined, 'invalid-patch');
+  }
+});
+
+test('rejects a "from" that is missing or not a string where the operation needs one', () => {
+  for (const op of ['move', 'copy']) {
+    assertFails({ a: 1 }, [{ op, path: '/b' }], 'invalid-patch');
+    assertFails({ a: 1 }, [{ op, path: '/b', from: 0 }], 'invalid-patch');
+    assertFails({ a: 1 }, [{ op, path: '/b', from: null }], 'invalid-patch');
+  }
+});
+
+test('ignores a "value" or "from" the operation does not define', () => {
+  assertPatches({ a: 1, b: 2 }, [{ op: 'remove', path: '/a', value: 'ignored' }], { b: 2 });
+  assertPatches({ a: 1 }, [{ op: 'add', path: '/b', value: 2, from: '/nowhere' }], { a: 1, b: 2 });
+});
+
+test('rejects a "path" or "from" that is not a valid JSON Pointer', () => {
+  for (const path of ['a', 'a/b', '#/a', '/a~b', '/~', '/a~']) {
+    assertFails({ a: 1 }, [{ op: 'add', path, value: 1 }], 'invalid-patch');
+    assertFails({ a: 1 }, [{ op: 'remove', path }], 'invalid-patch');
+    assertFails({ a: 1 }, [{ op: 'move', from: path, path: '/b' }], 'invalid-patch');
+    assertFails({ a: 1 }, [{ op: 'copy', from: '/a', path }], 'invalid-patch');
+  }
+});
+
+test('validates the whole patch before applying any of it', () => {
+  // The first operation would succeed; the second is malformed, so nothing is applied.
+  assertFails(
+    { a: 1 },
+    [
+      { op: 'remove', path: '/a' },
+      { op: 'nonsense', path: '/a' },
+    ],
+    'invalid-patch',
+  );
+});
+
+test('names the operation and the reason in the error message', () => {
+  assert.match(
+    assertFails({ a: {} }, [{ op: 'remove', path: '/a/b' }], 'operation-failed').message,
+    /operation 0.*"remove".*"\/a\/b"/,
+  );
+  assert.match(
+    assertFails({ a: 1 }, [{ op: 'test', path: '/a', value: 2 }], 'test-failed').message,
+    /operation 0.*"test".*"\/a"/,
+  );
+  assert.match(
+    assertFails({ a: 1 }, [{ op: 'frobnicate', path: '/a' }], 'invalid-patch').message,
+    /operation 0.*"frobnicate"/,
+  );
+  assert.match(assertFails({ a: 1 }, {}, 'invalid-patch').message, /array/);
+});
+
+test('the message of a failing operation leaves out the members it ignores', () => {
+  const message = assertFails(
+    { a: 1 },
+    [{ op: 'add', path: '/b/c', value: 2, from: '/a' }],
+    'operation-failed',
+  ).message;
+  assert.match(message, /"add" at "\/b\/c"/);
+  assert.doesNotMatch(message, /from/, 'an "add" has no "from", so its message must not show one');
+});
+
+test('keeps the pointer failure that explains an invalid "path" as the error cause', () => {
+  const error = assertFails({ a: 1 }, [{ op: 'remove', path: '/a~b' }], 'invalid-patch');
+  assert.ok(error.cause instanceof JsonPointerError);
+  assert.equal(error.cause.reason, 'invalid-pointer');
+  assert.doesNotMatch(error.message, /\.\./, 'the quoted message must not double the full stop');
+});
