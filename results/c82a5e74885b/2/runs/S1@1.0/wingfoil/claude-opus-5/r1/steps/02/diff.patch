+
+/**
+ * Adds `value` at the location `path` names (RFC 6902 § 4.1), in place.
+ *
+ * On an array the value is inserted, shifting the elements after it, and the index may be one past
+ * the last element -- which is what `-` always means here, unlike when reading.
+ */
+function add(
+  document: JsonValue,
+  prepared: PreparedOperation,
+  path: readonly string[],
+  value: JsonValue,
+): JsonValue {
+  if (path.length === 0) {
+    return value;
+  }
+  const place = placeOf(document, prepared, path);
+  const { container, token } = place;
+  const at = () => describeLocation(place.parent);
+  if (Array.isArray(container)) {
+    const index = token === '-' ? container.length : arrayIndex(token);
+    if (index === undefined) {
+      throw failed(prepared, `${at()} is an array and ${quote(token)} is not an array index`);
+    }
+    if (index > container.length) {
+      const size = count(container.length, 'element');
+      throw failed(prepared, `${at()} is an array of ${size}, so index ${index} is past its end`);
+    }
+    container.splice(index, 0, value);
+  } else {
+    setMember(container, token, value);
+  }
+  return document;
+}
+
+/**
+ * Removes the value at the location `path` names (RFC 6902 § 4.2), in place, and returns it.
+ *
+ * The location must exist; on an array the elements after it move down to close the gap.
+ */
+function remove(
+  document: JsonValue,
+  prepared: PreparedOperation,
+  path: readonly string[],
+): JsonValue {
+  const place = placeOf(document, prepared, path);
+  const { container, token } = place;
+  if (Array.isArray(container)) {
+    const [element] = container.splice(requireIndex(place, container, prepared), 1);
+    return element;
+  }
+  const value = requireMember(place, container, prepared);
+  delete container[token];
+  return value;
+}
+
+/** Replaces the value at the location `path` names (RFC 6902 § 4.3), which must exist, in place. */
+function replace(
+  document: JsonValue,
+  prepared: PreparedOperation,
+  path: readonly string[],
+  value: JsonValue,
+): JsonValue {
+  if (path.length === 0) {
+    return value;
+  }
+  const place = placeOf(document, prepared, path);
+  const { container, token } = place;
+  if (Array.isArray(container)) {
+    container[requireIndex(place, container, prepared)] = value;
+  } else {
+    // A replace needs the member to be there; the value it holds is the one being overwritten.
+    requireMember(place, container, prepared);
+    setMember(container, token, value);
+  }
+  return document;
