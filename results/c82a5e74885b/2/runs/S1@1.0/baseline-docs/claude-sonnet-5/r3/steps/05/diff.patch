+
+/** Escapes a single reference token for use in a JSON Pointer, as the inverse of {@link unescapeToken}. */
+function escapeToken(token: string): string {
+  return token.replace(/~/g, '~0').replace(/\//g, '~1');
+}
+
+/** Appends the operations that turn `from` into `to` at `path` to `ops`, recursing into containers. */
+function diffValues(path: string, from: JsonValue, to: JsonValue, ops: JsonPatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (isJsonObject(from) && isJsonObject(to)) {
+    diffObjects(path, from, to, ops);
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(path, from, to, ops);
+    return;
+  }
+  ops.push({ op: 'replace', path, value: to });
+}
+
+function diffObjects(
+  path: string,
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  ops: JsonPatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.prototype.hasOwnProperty.call(to, key)) {
+      ops.push({ op: 'remove', path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const childPath = `${path}/${escapeToken(key)}`;
+    if (Object.prototype.hasOwnProperty.call(from, key)) {
+      diffValues(childPath, from[key], to[key], ops);
+    } else {
+      ops.push({ op: 'add', path: childPath, value: to[key] });
+    }
+  }
+}
+
+/** Diffs the common prefix of `from` and `to` element by element, then trims or appends the tail. */
+function diffArrays(path: string, from: JsonValue[], to: JsonValue[], ops: JsonPatchOperation[]): void {
+  const common = Math.min(from.length, to.length);
+  for (let i = 0; i < common; i++) {
+    diffValues(`${path}/${i}`, from[i], to[i], ops);
+  }
+  for (let i = from.length; i > common; i--) {
+    ops.push({ op: 'remove', path: `${path}/${common}` });
+  }
+  for (let i = common; i < to.length; i++) {
+    ops.push({ op: 'add', path: `${path}/-`, value: to[i] });
+  }
+}
+
+/**
+ * Computes a JSON Patch (RFC 6902) describing the difference between two JSON documents: applying
+ * the returned patch to `from` with {@link applyPatch} produces a document equal to `to`. Neither
+ * `from` nor `to` is mutated. The patch only addresses the parts of the document that changed.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatchOperation[] {
+  const ops: JsonPatchOperation[] = [];
+  diffValues('', from, to, ops);
+  return ops;
+}
