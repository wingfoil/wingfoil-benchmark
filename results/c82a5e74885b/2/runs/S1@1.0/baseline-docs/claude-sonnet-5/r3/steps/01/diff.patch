+/** A JSON value, as defined by RFC 8259. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+/** Thrown when a JSON Pointer is malformed, or does not resolve within the given document. */
+export class JsonPointerError extends Error {}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function unescapeToken(token: string): string {
+  return token.replace(/~1/g, '/').replace(/~0/g, '~');
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document, returning the value it refers to.
+ *
+ * Throws a {@link JsonPointerError} when `pointer` is not a syntactically valid JSON Pointer, or
+ * when it does not resolve to a value within `document`.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  if (pointer === '') {
+    return document;
+  }
+  if (!pointer.startsWith('/')) {
+    throw new JsonPointerError(`Invalid JSON Pointer: "${pointer}"`);
+  }
+
+  const tokens = pointer.slice(1).split('/').map(unescapeToken);
+
+  let current: JsonValue = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token)) {
+        throw new JsonPointerError(`"${token}" is not a valid array index in pointer "${pointer}"`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new JsonPointerError(`Index ${index} is out of bounds in pointer "${pointer}"`);
+      }
+      current = current[index];
+    } else if (typeof current === 'object' && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new JsonPointerError(`No member "${token}" in pointer "${pointer}"`);
+      }
+      current = current[token];
+    } else {
+      throw new JsonPointerError(`Cannot resolve "${token}" in pointer "${pointer}": not an object or array`);
+    }
+  }
+
+  return current;
+}
