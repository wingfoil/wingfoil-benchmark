@@ -272,3 +272,80 @@ test('rejects a "move" operation missing "from"', () => {
     JsonPatchError,
   );
 });
+
+// Examples from RFC 7386 Appendix A.
+test('A: replaces an existing member', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { a: 'c' }), { a: 'c' });
+});
+
+test('A: adds a new member', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { b: 'c' }), { a: 'b', b: 'c' });
+});
+
+test('A: a null value removes an existing member', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, { a: null }), {});
+});
+
+test('A: a null value removes an existing member, leaving the others untouched', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b', b: 'c' }, { a: null }), { b: 'c' });
+});
+
+test('A: a scalar patch value replaces an array member wholesale', () => {
+  assert.deepEqual(applyMergePatch({ a: ['b'] }, { a: 'c' }), { a: 'c' });
+});
+
+test('A: an array patch value replaces a scalar member wholesale', () => {
+  assert.deepEqual(applyMergePatch({ a: 'c' }, { a: ['b'] }), { a: ['b'] });
+});
+
+test('A: nested objects are merged member by member', () => {
+  assert.deepEqual(applyMergePatch({ a: { b: 'c' } }, { a: { b: 'd', c: null } }), { a: { b: 'd' } });
+});
+
+test('A: an array member is replaced wholesale, never merged element by element', () => {
+  assert.deepEqual(applyMergePatch({ a: [{ b: 'c' }] }, { a: [1] }), { a: [1] });
+});
+
+test('A: a patch that is itself an array replaces the whole target', () => {
+  assert.deepEqual(applyMergePatch(['a', 'b'], ['c', 'd']), ['c', 'd']);
+});
+
+test('A: an array patch replaces an object target wholesale', () => {
+  assert.deepEqual(applyMergePatch({ a: 'b' }, ['c']), ['c']);
+});
+
+test('A: a null patch replaces the whole target with null', () => {
+  assert.equal(applyMergePatch({ a: 'foo' }, null), null);
+});
+
+test('A: a scalar patch replaces the whole target', () => {
+  assert.equal(applyMergePatch({ a: 'foo' }, 'bar'), 'bar');
+});
+
+test('A: a null member value is added as-is when there is no existing member to remove', () => {
+  assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+});
+
+test('A: an array target is discarded in favour of the object patch', () => {
+  assert.deepEqual(applyMergePatch([1, 2], { a: 'b', c: null }), { a: 'b' });
+});
+
+test('A: nested objects are created as needed, and null members within them are dropped', () => {
+  assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+});
+
+// Additional coverage beyond the RFC's own examples.
+
+test('does not mutate the target document', () => {
+  const target = { a: { b: 'c' }, d: ['e'] };
+  const snapshot = JSON.parse(JSON.stringify(target));
+  applyMergePatch(target, { a: { b: null, f: 'g' }, d: ['h'] });
+  assert.deepEqual(target, snapshot);
+});
+
+test('does not mutate the patch document', () => {
+  const patch = { a: { b: 'c' } };
+  const snapshot = JSON.parse(JSON.stringify(patch));
+  applyMergePatch({}, patch);
+  assert.deepEqual(patch, snapshot);
+});
