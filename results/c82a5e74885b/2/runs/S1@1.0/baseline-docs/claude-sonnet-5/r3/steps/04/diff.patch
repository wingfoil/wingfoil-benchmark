   }
   return result;
 }
+
+/** Narrows `value` to a JSON object, as opposed to an array, scalar, or `null`. */
+function isJsonObject(value: JsonValue): value is { [key: string]: JsonValue } {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a target JSON document, returning the merged document
+ * as a new value; neither `target` nor `patch` is mutated.
+ *
+ * Object members of `patch` are merged into `target` recursively; a `null` member removes the
+ * corresponding member from `target`. Any other patch value (including an array) replaces the
+ * corresponding target value wholesale.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return patch;
+  }
+  const result: { [key: string]: JsonValue } = isJsonObject(target) ? { ...target } : {};
+  for (const [key, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[key];
+    } else {
+      result[key] = applyMergePatch(result[key], value);
+    }
+  }
+  return result;
+}
