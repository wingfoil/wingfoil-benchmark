diff --git a/src/json-merge-patch.test.ts b/src/json-merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d35d7ca0e2bbd09ad5da7e8c2c4290012bb4bbdc
--- /dev/null
+++ b/src/json-merge-patch.test.ts
@@ -0,0 +1,101 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import { applyMergePatch } from './json-merge-patch.ts';
+import type { JsonValue } from './json-pointer.ts';
+
+function deepFreeze<T extends JsonValue>(value: T): T {
+  if (Array.isArray(value)) {
+    value.forEach(deepFreeze);
+  } else if (value !== null && typeof value === 'object') {
+    Object.values(value).forEach(deepFreeze);
+  }
+  return Object.freeze(value);
+}
+
+// Test cases from RFC 7386 appendix A.
+const RFC_EXAMPLES: { target: JsonValue; patch: JsonValue; result: JsonValue }[] = [
+  { target: { a: 'b' }, patch: { a: 'c' }, result: { a: 'c' } },
+  { target: { a: 'b' }, patch: { b: 'c' }, result: { a: 'b', b: 'c' } },
+  { target: { a: 'b' }, patch: { a: null }, result: {} },
+  { target: { a: 'b', b: 'c' }, patch: { a: null }, result: { b: 'c' } },
+  { target: { a: ['b'] }, patch: { a: 'c' }, result: { a: 'c' } },
+  { target: { a: 'c' }, patch: { a: ['b'] }, result: { a: ['b'] } },
+  { target: { a: { b: 'c' } }, patch: { a: { b: 'd', c: null } }, result: { a: { b: 'd' } } },
+  { target: { a: [{ b: 'c' }] }, patch: { a: [1] }, result: { a: [1] } },
+  { target: ['a', 'b'], patch: ['c', 'd'], result: ['c', 'd'] },
+  { target: { a: 'b' }, patch: ['c'], result: ['c'] },
+  { target: { a: 'foo' }, patch: null, result: null },
+  { target: { a: 'foo' }, patch: 'bar', result: 'bar' },
+  { target: { e: null }, patch: { a: 1 }, result: { e: null, a: 1 } },
+  { target: [1, 2], patch: { a: 'b', c: null }, result: { a: 'b' } },
+  { target: {}, patch: { a: { bb: { ccc: null } } }, result: { a: { bb: {} } } },
+];
+
+for (const [i, { target, patch, result }] of RFC_EXAMPLES.entries()) {
+  test(`RFC 7386 appendix A example ${i + 1}: ${JSON.stringify(target)} + ${JSON.stringify(patch)}`, () => {
+    assert.deepEqual(applyMergePatch(deepFreeze(target), deepFreeze(patch)), result);
+  });
+}
+
+test('merges nested objects recursively instead of overwriting them', () => {
+  const target = deepFreeze({ a: { b: 1, c: 2 }, d: 1 });
+  const result = applyMergePatch(target, { a: { c: 3, e: 4 } });
+  assert.deepEqual(result, { a: { b: 1, c: 3, e: 4 }, d: 1 });
+});
+
+test('adds a new nested member when the target does not have the parent object', () => {
+  const target = deepFreeze({ a: 1 });
+  const result = applyMergePatch(target, { b: { c: 1 } });
+  assert.deepEqual(result, { a: 1, b: { c: 1 } });
+});
+
+test('a null in the patch removes a deeply nested member', () => {
+  const target = deepFreeze({ a: { b: { c: 1, d: 2 } } });
+  const result = applyMergePatch(target, { a: { b: { c: null } } });
+  assert.deepEqual(result, { a: { b: { d: 2 } } });
+});
+
+test('a null for a member absent from the target is a no-op', () => {
+  const target = deepFreeze({ a: 1 });
+  const result = applyMergePatch(target, { b: null });
+  assert.deepEqual(result, { a: 1 });
+});
+
+test('does not mutate the input target or patch', () => {
+  const target = deepFreeze({ foo: { bar: 1 }, baz: 2 });
+  const patch = deepFreeze({ foo: { bar: 2 }, baz: null });
+  const targetSnapshot = JSON.parse(JSON.stringify(target));
+  const patchSnapshot = JSON.parse(JSON.stringify(patch));
+  applyMergePatch(target, patch);
+  assert.deepEqual(target, targetSnapshot);
+  assert.deepEqual(patch, patchSnapshot);
+});
+
+test('the result does not share references with the input target', () => {
+  const target = deepFreeze({ foo: { bar: 1 }, baz: { qux: 1 } });
+  const result = applyMergePatch(target, { foo: { bar: 2 } }) as {
+    foo: { bar: number };
+    baz: { qux: number };
+  };
+  assert.notEqual(result.baz, target.baz);
+  assert.deepEqual(result.baz, { qux: 1 });
+});
+
+test('treats "__proto__" as a plain member name, not an accessor', () => {
+  const target = deepFreeze({});
+  const patch = deepFreeze(JSON.parse('{"__proto__":{"polluted":true}}')) as JsonValue;
+  const result = applyMergePatch(target, patch) as {
+    [key: string]: JsonValue;
+  };
+  assert.equal(Object.prototype.hasOwnProperty.call(result, '__proto__'), true);
+  assert.deepEqual(JSON.parse(JSON.stringify(result)), { ['__proto__']: { polluted: true } });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as { polluted?: boolean }).polluted, undefined);
+});
+
+test('does not drop or act on an input document member literally named "__proto__"', () => {
+  const target = deepFreeze(JSON.parse('{"__proto__":{"x":1},"foo":"bar"}')) as JsonValue;
+  const result = applyMergePatch(target, { foo: 'baz' });
+  assert.deepEqual(JSON.parse(JSON.stringify(result)), { ['__proto__']: { x: 1 }, foo: 'baz' });
+});
