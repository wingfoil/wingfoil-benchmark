--- a/README.md
+++ b/README.md
@@ -32,3 +32,18 @@ import { applyPatch } from 'json-toolkit';
 applyPatch({ foo: ['bar', 'baz'] }, [{ op: 'add', path: '/foo/1', value: 'qux' }]);
 // => { foo: ['bar', 'qux', 'baz'] }
 ```
+
+### JSON Merge Patch (RFC 7386)
+
+`applyMergePatch(target, patch)` applies a [JSON Merge Patch](https://www.rfc-editor.org/rfc/rfc7386)
+to a JSON document and returns the merged document as a new value, leaving `target` and `patch`
+untouched. Object members of `patch` are merged into `target` recursively; a `null` member removes the
+corresponding member from the result. Any other `patch` value (including an array) replaces `target`
+wholesale.
+
+```ts
+import { applyMergePatch } from 'json-toolkit';
+
+applyMergePatch({ foo: 'bar', baz: { qux: 1 } }, { baz: { qux: null, quux: 2 } });
+// => { foo: 'bar', baz: { quux: 2 } }
+```
