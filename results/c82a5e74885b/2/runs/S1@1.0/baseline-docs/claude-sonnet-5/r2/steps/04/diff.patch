new file mode 100644
index 0000000000000000000000000000000000000000..cd1e68ca1530790ed79acf712e9a88482b134b66
--- /dev/null
+++ b/src/json-merge-patch.ts
@@ -0,0 +1,54 @@
+import type { JsonValue } from './json-pointer.ts';
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the resulting
+ * document as a new value. The input document and patch are left untouched.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  return mergePatch(target, patch);
+}
+
+function mergePatch(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return cloneValue(patch);
+  }
+  const result: { [key: string]: JsonValue } = isJsonObject(target)
+    ? (cloneValue(target) as { [key: string]: JsonValue })
+    : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key] as JsonValue;
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, mergePatch(result[key], value));
+    }
+  }
+  return result;
+}
+
+function isJsonObject(value: JsonValue | undefined): value is { [key: string]: JsonValue } {
+  return value !== null && value !== undefined && typeof value === 'object' && !Array.isArray(value);
+}
+
+function cloneValue(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(cloneValue);
+  }
+  if (value !== null && typeof value === 'object') {
+    const clone: { [key: string]: JsonValue } = {};
+    for (const key of Object.keys(value)) {
+      setMember(clone, key, cloneValue(value[key] as JsonValue));
+    }
+    return clone;
+  }
+  return value;
+}
+
+/**
+ * Sets an own, enumerable member on a plain object, bypassing any inherited accessor
+ * (e.g. "__proto__") so that a member name is always treated as plain string data,
+ * never as an instruction to the object's internals.
+ */
+function setMember(container: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(container, key, { value, writable: true, enumerable: true, configurable: true });
+}
