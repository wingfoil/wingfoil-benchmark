index 0000000000000000000000000000000000000000..af8207c75fa9f36de26d9e1bcae07d1a85f27759
--- /dev/null
+++ b/src/json-patch.test.ts
@@ -0,0 +1,253 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import { applyPatch, JsonPatchError } from './json-patch.ts';
+import type { JsonValue } from './json-pointer.ts';
+
+function deepFreeze<T extends JsonValue>(value: T): T {
+  if (Array.isArray(value)) {
+    value.forEach(deepFreeze);
+  } else if (value !== null && typeof value === 'object') {
+    Object.values(value).forEach(deepFreeze);
+  }
+  return Object.freeze(value);
+}
+
+test('add: inserts a new object member', () => {
+  const document = deepFreeze({ foo: 'bar' });
+  const result = applyPatch(document, [{ op: 'add', path: '/baz', value: 'qux' }]);
+  assert.deepEqual(result, { foo: 'bar', baz: 'qux' });
+});
+
+test('add: replaces an existing object member', () => {
+  const document = deepFreeze({ foo: 'bar' });
+  const result = applyPatch(document, [{ op: 'add', path: '/foo', value: 'qux' }]);
+  assert.deepEqual(result, { foo: 'qux' });
+});
+
+test('add: inserts an array element at an index, shifting later elements right', () => {
+  const document = deepFreeze({ foo: [1, 2, 3] });
+  const result = applyPatch(document, [{ op: 'add', path: '/foo/1', value: 99 }]);
+  assert.deepEqual(result, { foo: [1, 99, 2, 3] });
+});
+
+test('add: appends an array element with "-"', () => {
+  const document = deepFreeze({ foo: [1, 2] });
+  const result = applyPatch(document, [{ op: 'add', path: '/foo/-', value: 3 }]);
+  assert.deepEqual(result, { foo: [1, 2, 3] });
+});
+
+test('add: replaces the whole document at the root', () => {
+  const document = deepFreeze({ foo: 'bar' });
+  const result = applyPatch(document, [{ op: 'add', path: '', value: { baz: 'qux' } }]);
+  assert.deepEqual(result, { baz: 'qux' });
+});
+
+test('add: rejects an array index past the end of the array', () => {
+  const document = deepFreeze({ foo: [1, 2] });
+  assert.throws(
+    () => applyPatch(document, [{ op: 'add', path: '/foo/3', value: 1 }]),
+    JsonPatchError,
+  );
+});
+
+test('add: rejects a path whose parent does not exist', () => {
+  const document = deepFreeze({ foo: 'bar' });
+  assert.throws(
+    () => applyPatch(document, [{ op: 'add', path: '/missing/child', value: 1 }]),
+    JsonPatchError,
+  );
+});
+
+test('remove: deletes an object member', () => {
+  const document = deepFreeze({ foo: 'bar', baz: 'qux' });
+  const result = applyPatch(document, [{ op: 'remove', path: '/baz' }]);
+  assert.deepEqual(result, { foo: 'bar' });
+});
+
+test('remove: deletes an array element, shifting later elements left', () => {
+  const document = deepFreeze({ foo: [1, 2, 3] });
+  const result = applyPatch(document, [{ op: 'remove', path: '/foo/1' }]);
+  assert.deepEqual(result, { foo: [1, 3] });
+});
+
+test('remove: rejects removing the whole document at the root', () => {
+  const document = deepFreeze({ foo: 'bar' });
+  assert.throws(() => applyPatch(document, [{ op: 'remove', path: '' }]), JsonPatchError);
+});
+
+test('remove: rejects a missing object member', () => {
+  const document = deepFreeze({ foo: 'bar' });
+  assert.throws(() => applyPatch(document, [{ op: 'remove', path: '/missing' }]), JsonPatchError);
+});
+
+test('replace: overwrites an existing object member', () => {
+  const document = deepFreeze({ foo: 'bar' });
+  const result = applyPatch(document, [{ op: 'replace', path: '/foo', value: 'qux' }]);
+  assert.deepEqual(result, { foo: 'qux' });
+});
+
+test('replace: overwrites an existing array element', () => {
+  const document = deepFreeze({ foo: [1, 2, 3] });
+  const result = applyPatch(document, [{ op: 'replace', path: '/foo/1', value: 99 }]);
+  assert.deepEqual(result, { foo: [1, 99, 3] });
+});
+
+test('replace: overwrites the whole document at the root', () => {
+  const document = deepFreeze({ foo: 'bar' });
+  const result = applyPatch(document, [{ op: 'replace', path: '', value: { baz: 1 } }]);
+  assert.deepEqual(result, { baz: 1 });
+});
+
+test('replace: rejects a missing object member', () => {
+  const document = deepFreeze({ foo: 'bar' });
+  assert.throws(
+    () => applyPatch(document, [{ op: 'replace', path: '/missing', value: 1 }]),
+    JsonPatchError,
+  );
+});
+
+test('replace: rejects the "-" array index, which never refers to an existing element', () => {
+  const document = deepFreeze({ foo: [1, 2] });
+  assert.throws(
+    () => applyPatch(document, [{ op: 'replace', path: '/foo/-', value: 1 }]),
+    JsonPatchError,
+  );
+});
+
+test('move: relocates an object member', () => {
+  const document = deepFreeze({ foo: { bar: 1 }, baz: {} });
+  const result = applyPatch(document, [{ op: 'move', from: '/foo/bar', path: '/baz/bar' }]);
+  assert.deepEqual(result, { foo: {}, baz: { bar: 1 } });
+});
+
+test('move: relocates an array element', () => {
+  const document = deepFreeze({ foo: [1, 2, 3] });
+  const result = applyPatch(document, [{ op: 'move', from: '/foo/0', path: '/foo/2' }]);
+  assert.deepEqual(result, { foo: [2, 3, 1] });
+});
+
+test('move: is a no-op when "from" and "path" are the same location', () => {
+  const document = deepFreeze({ foo: 'bar' });
+  const result = applyPatch(document, [{ op: 'move', from: '/foo', path: '/foo' }]);
+  assert.deepEqual(result, { foo: 'bar' });
+});
+
+test('move: rejects moving a location into one of its own children', () => {
+  const document = deepFreeze({ foo: { bar: 1 } });
+  assert.throws(
+    () => applyPatch(document, [{ op: 'move', from: '/foo', path: '/foo/baz' }]),
+    JsonPatchError,
+  );
+});
+
+test('move: rejects a missing "from" location', () => {
+  const document = deepFreeze({ foo: 'bar' });
+  assert.throws(
+    () => applyPatch(document, [{ op: 'move', from: '/missing', path: '/foo' }]),
+    JsonPatchError,
+  );
+});
+
+test('copy: duplicates a value to a new location independently of the source', () => {
+  const document = deepFreeze({ foo: { bar: 1 }, baz: {} });
+  const result = applyPatch(document, [{ op: 'copy', from: '/foo', path: '/baz/copy' }]) as {
+    foo: { bar: number };
+    baz: { copy: { bar: number } };
+  };
+  assert.deepEqual(result, { foo: { bar: 1 }, baz: { copy: { bar: 1 } } });
+  assert.notEqual(result.baz.copy, result.foo);
+});
+
+test('copy: rejects a missing "from" location', () => {
+  const document = deepFreeze({ foo: 'bar' });
+  assert.throws(
+    () => applyPatch(document, [{ op: 'copy', from: '/missing', path: '/foo' }]),
+    JsonPatchError,
+  );
+});
+
+test('test: succeeds and leaves the document unchanged when values match', () => {
+  const document = deepFreeze({ foo: { bar: 1 } });
+  const result = applyPatch(document, [{ op: 'test', path: '/foo', value: { bar: 1 } }]);
+  assert.deepEqual(result, { foo: { bar: 1 } });
+});
+
+test('test: throws when the value at the path does not match', () => {
+  const document = deepFreeze({ foo: 'bar' });
+  assert.throws(
+    () => applyPatch(document, [{ op: 'test', path: '/foo', value: 'qux' }]),
+    JsonPatchError,
+  );
+});
+
+test('test: throws when the path does not resolve to a value', () => {
+  const document = deepFreeze({ foo: 'bar' });
+  assert.throws(
+    () => applyPatch(document, [{ op: 'test', path: '/missing', value: 'bar' }]),
+    JsonPatchError,
+  );
+});
+
+test('applies a sequence of operations in order', () => {
+  const document = deepFreeze({ foo: 1 });
+  const result = applyPatch(document, [
+    { op: 'add', path: '/bar', value: 2 },
+    { op: 'test', path: '/bar', value: 2 },
+    { op: 'replace', path: '/foo', value: 10 },
+    { op: 'remove', path: '/bar' },
+  ]);
+  assert.deepEqual(result, { foo: 10 });
+});
+
+test('does not mutate the input document', () => {
+  const document = deepFreeze({ foo: [1, 2], bar: { baz: 1 } });
+  const snapshot = JSON.parse(JSON.stringify(document));
+  applyPatch(document, [
+    { op: 'add', path: '/foo/-', value: 3 },
+    { op: 'replace', path: '/bar/baz', value: 99 },
+  ]);
+  assert.deepEqual(document, snapshot);
+});
+
+test('rejects a patch that is not an array', () => {
+  const document = { foo: 'bar' };
+  // @ts-expect-error -- exercising runtime validation of the boundary.
+  assert.throws(() => applyPatch(document, { op: 'add', path: '/foo', value: 1 }), JsonPatchError);
+});
+
+test('rejects an operation object with an unknown "op"', () => {
+  const document = { foo: 'bar' };
+  assert.throws(
+    // @ts-expect-error -- exercising runtime validation of the boundary.
+    () => applyPatch(document, [{ op: 'patch', path: '/foo', value: 1 }]),
+    JsonPatchError,
+  );
+});
+
+test('rejects an operation missing its "path" member', () => {
+  const document = { foo: 'bar' };
+  assert.throws(
+    // @ts-expect-error -- exercising runtime validation of the boundary.
+    () => applyPatch(document, [{ op: 'remove' }]),
+    JsonPatchError,
+  );
+});
+
+test('rejects an "add" operation missing its "value" member', () => {
+  const document = { foo: 'bar' };
+  assert.throws(
+    // @ts-expect-error -- exercising runtime validation of the boundary.
+    () => applyPatch(document, [{ op: 'add', path: '/foo' }]),
+    JsonPatchError,
+  );
+});
+
+test('rejects a "move" operation missing its "from" member', () => {
+  const document = { foo: 'bar' };
+  assert.throws(
+    // @ts-expect-error -- exercising runtime validation of the boundary.
+    () => applyPatch(document, [{ op: 'move', path: '/foo' }]),
+    JsonPatchError,
+  );
+});
