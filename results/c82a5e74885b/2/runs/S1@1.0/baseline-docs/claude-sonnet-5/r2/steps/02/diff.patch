index 0000000000000000000000000000000000000000..c34c02df436d7d13b5989b4e5faab86eb24d53bb
--- /dev/null
+++ b/src/json-patch.ts
@@ -0,0 +1,254 @@
+import { JsonPointerError, parsePointer, resolveTokens, type JsonValue } from './json-pointer.ts';
+
+/** Thrown when a patch is not syntactically valid, or when one of its operations fails. */
+export class JsonPatchError extends Error {}
+
+/** An operation that inserts or overwrites the value at `path`. */
+export type JsonPatchAddOperation = { op: 'add'; path: string; value: JsonValue };
+/** An operation that deletes the value at `path`. */
+export type JsonPatchRemoveOperation = { op: 'remove'; path: string };
+/** An operation that overwrites the existing value at `path`. */
+export type JsonPatchReplaceOperation = { op: 'replace'; path: string; value: JsonValue };
+/** An operation that relocates the value at `from` to `path`. */
+export type JsonPatchMoveOperation = { op: 'move'; from: string; path: string };
+/** An operation that duplicates the value at `from` to `path`. */
+export type JsonPatchCopyOperation = { op: 'copy'; from: string; path: string };
+/** An operation that fails the patch unless the value at `path` equals `value`. */
+export type JsonPatchTestOperation = { op: 'test'; path: string; value: JsonValue };
+
+/** A single operation of a JSON Patch (RFC 6902). */
+export type JsonPatchOperation =
+  | JsonPatchAddOperation
+  | JsonPatchRemoveOperation
+  | JsonPatchReplaceOperation
+  | JsonPatchMoveOperation
+  | JsonPatchCopyOperation
+  | JsonPatchTestOperation;
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the resulting document
+ * as a new value. The input document and patch are left untouched.
+ *
+ * @throws {JsonPatchError} if `patch` is not a valid JSON Patch, or if one of its
+ * operations fails against `document`.
+ */
+export function applyPatch(document: JsonValue, patch: JsonPatchOperation[]): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new JsonPatchError('A JSON Patch must be an array of operations.');
+  }
+  let root = cloneValue(document);
+  for (const operation of patch) {
+    root = applyOperation(root, validateOperation(operation));
+  }
+  return root;
+}
+
+function applyOperation(root: JsonValue, operation: JsonPatchOperation): JsonValue {
+  switch (operation.op) {
+    case 'add':
+      return addAt(root, toTokens(operation.path), cloneValue(operation.value));
+    case 'remove':
+      removeAt(root, toTokens(operation.path));
+      return root;
+    case 'replace':
+      return replaceAt(root, toTokens(operation.path), cloneValue(operation.value));
+    case 'move':
+      return moveAt(root, toTokens(operation.from), toTokens(operation.path));
+    case 'copy':
+      return addAt(root, toTokens(operation.path), cloneValue(getAt(root, toTokens(operation.from))));
+    case 'test':
+      testAt(root, toTokens(operation.path), operation.value);
+      return root;
+  }
+}
+
+function validateOperation(operation: unknown): JsonPatchOperation {
+  if (operation === null || typeof operation !== 'object' || Array.isArray(operation)) {
+    throw new JsonPatchError('Each operation of a JSON Patch must be an object.');
+  }
+  const candidate = operation as { [key: string]: unknown };
+  const { op } = candidate;
+  if (typeof op !== 'string') {
+    throw new JsonPatchError('Each operation must have a string "op" member.');
+  }
+  if (typeof candidate.path !== 'string') {
+    throw new JsonPatchError('Each operation must have a string "path" member.');
+  }
+  switch (op) {
+    case 'add':
+    case 'replace':
+    case 'test':
+      if (!Object.prototype.hasOwnProperty.call(candidate, 'value')) {
+        throw new JsonPatchError(`A "${op}" operation must have a "value" member.`);
+      }
+      return { op, path: candidate.path, value: candidate.value as JsonValue };
+    case 'remove':
+      return { op, path: candidate.path };
+    case 'move':
+    case 'copy':
+      if (typeof candidate.from !== 'string') {
+        throw new JsonPatchError(`A "${op}" operation must have a string "from" member.`);
+      }
+      return { op, path: candidate.path, from: candidate.from };
+    default:
+      throw new JsonPatchError(`"${String(op)}" is not a valid JSON Patch operation.`);
+  }
+}
+
+function toTokens(pointer: string): string[] {
+  try {
+    return parsePointer(pointer);
+  } catch (error) {
+    throw new JsonPatchError((error as JsonPointerError).message);
+  }
+}
+
+function getAt(root: JsonValue, tokens: readonly string[]): JsonValue {
+  try {
+    return resolveTokens(root, tokens);
+  } catch (error) {
+    throw new JsonPatchError((error as JsonPointerError).message);
+  }
+}
+
+function resolveParent(root: JsonValue, tokens: readonly string[]): JsonValue {
+  return getAt(root, tokens.slice(0, -1));
+}
+
+function addAt(root: JsonValue, tokens: readonly string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = resolveParent(root, tokens);
+  const lastToken = tokens[tokens.length - 1] as string;
+  if (Array.isArray(parent)) {
+    const index = lastToken === '-' ? parent.length : toInsertIndex(lastToken, parent.length);
+    parent.splice(index, 0, value);
+  } else if (parent !== null && typeof parent === 'object') {
+    (parent as { [key: string]: JsonValue })[lastToken] = value;
+  } else {
+    throw new JsonPatchError(`Cannot add a member to a non-container value at "${lastToken}".`);
+  }
+  return root;
+}
+
+function removeAt(root: JsonValue, tokens: readonly string[]): JsonValue {
+  if (tokens.length === 0) {
+    throw new JsonPatchError('The root document cannot be removed.');
+  }
+  const parent = resolveParent(root, tokens);
+  const lastToken = tokens[tokens.length - 1] as string;
+  if (Array.isArray(parent)) {
+    const index = toExistingIndex(lastToken, parent.length);
+    return parent.splice(index, 1)[0] as JsonValue;
+  }
+  if (parent !== null && typeof parent === 'object') {
+    const container = parent as { [key: string]: JsonValue };
+    if (!Object.prototype.hasOwnProperty.call(container, lastToken)) {
+      throw new JsonPatchError(`Member "${lastToken}" does not exist.`);
+    }
+    const removed = container[lastToken] as JsonValue;
+    delete container[lastToken];
+    return removed;
+  }
+  throw new JsonPatchError(`Cannot remove a member from a non-container value at "${lastToken}".`);
+}
+
+function replaceAt(root: JsonValue, tokens: readonly string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = resolveParent(root, tokens);
+  const lastToken = tokens[tokens.length - 1] as string;
+  if (Array.isArray(parent)) {
+    const index = toExistingIndex(lastToken, parent.length);
+    parent[index] = value;
+  } else if (parent !== null && typeof parent === 'object') {
+    const container = parent as { [key: string]: JsonValue };
+    if (!Object.prototype.hasOwnProperty.call(container, lastToken)) {
+      throw new JsonPatchError(`Member "${lastToken}" does not exist.`);
+    }
+    container[lastToken] = value;
+  } else {
+    throw new JsonPatchError(`Cannot replace a member of a non-container value at "${lastToken}".`);
+  }
+  return root;
+}
+
+function moveAt(root: JsonValue, fromTokens: readonly string[], pathTokens: readonly string[]): JsonValue {
+  if (isProperPrefix(fromTokens, pathTokens)) {
+    throw new JsonPatchError('A location cannot be moved into one of its own children.');
+  }
+  if (sameTokens(fromTokens, pathTokens)) {
+    getAt(root, fromTokens);
+    return root;
+  }
+  const value = removeAt(root, fromTokens);
+  return addAt(root, pathTokens, value);
+}
+
+function testAt(root: JsonValue, tokens: readonly string[], expected: JsonValue): void {
+  const actual = getAt(root, tokens);
+  if (!deepEqual(actual, expected)) {
+    throw new JsonPatchError('The "test" operation failed: values are not equal.');
+  }
+}
+
+function toInsertIndex(token: string, length: number): number {
+  if (!ARRAY_INDEX.test(token) || Number(token) > length) {
+    throw new JsonPatchError(`"${token}" is not a valid array index for insertion.`);
+  }
+  return Number(token);
+}
+
+function toExistingIndex(token: string, length: number): number {
+  if (!ARRAY_INDEX.test(token) || Number(token) >= length) {
+    throw new JsonPatchError(`"${token}" is not a valid array index.`);
+  }
+  return Number(token);
+}
+
+function isProperPrefix(prefix: readonly string[], tokens: readonly string[]): boolean {
+  return prefix.length < tokens.length && prefix.every((token, i) => token === tokens[i]);
+}
+
+function sameTokens(a: readonly string[], b: readonly string[]): boolean {
+  return a.length === b.length && a.every((token, i) => token === b[i]);
+}
+
+function cloneValue(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(cloneValue);
+  }
+  if (value !== null && typeof value === 'object') {
+    const clone: { [key: string]: JsonValue } = {};
+    for (const key of Object.keys(value)) {
+      clone[key] = cloneValue(value[key] as JsonValue);
+    }
+    return clone;
+  }
+  return value;
+}
+
+function deepEqual(a: JsonValue, b: JsonValue): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (Array.isArray(a) && Array.isArray(b)) {
+    return a.length === b.length && a.every((item, i) => deepEqual(item, b[i] as JsonValue));
+  }
+  if (a !== null && b !== null && typeof a === 'object' && typeof b === 'object') {
+    const aKeys = Object.keys(a);
+    const bKeys = Object.keys(b);
+    return (
+      aKeys.length === bKeys.length &&
+      aKeys.every((key) =>
+        Object.prototype.hasOwnProperty.call(b, key) &&
+        deepEqual((a as { [key: string]: JsonValue })[key] as JsonValue, (b as { [key: string]: JsonValue })[key] as JsonValue),
+      )
+    );
+  }
+  return false;
+}
