index 0000000000000000000000000000000000000000..131ef4946b717ed94aea319edf7eff404e6b953c
--- /dev/null
+++ b/src/json-pointer.ts
@@ -0,0 +1,68 @@
+/** Any value that can appear in a parsed JSON document. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+/** Thrown when a pointer is syntactically invalid or does not resolve to a value. */
+export class JsonPointerError extends Error {}
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+const MALFORMED_ESCAPE = /~(?![01])/;
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @throws {JsonPointerError} if `pointer` is not a valid JSON Pointer, or does not
+ * resolve to a value within `document`.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  let current = document;
+  for (const token of parsePointer(pointer)) {
+    current = step(current, token);
+  }
+  return current;
+}
+
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== 'string') {
+    throw new JsonPointerError('A JSON Pointer must be a string.');
+  }
+  if (pointer === '') {
+    return [];
+  }
+  if (!pointer.startsWith('/')) {
+    throw new JsonPointerError(`"${pointer}" must be empty or start with "/".`);
+  }
+  return pointer.split('/').slice(1).map(decodeToken);
+}
+
+function decodeToken(rawToken: string): string {
+  if (MALFORMED_ESCAPE.test(rawToken)) {
+    throw new JsonPointerError(`"${rawToken}" contains a "~" not followed by "0" or "1".`);
+  }
+  return rawToken.replace(/~1/g, '/').replace(/~0/g, '~');
+}
+
+function step(current: JsonValue, token: string): JsonValue {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token)) {
+      throw new JsonPointerError(`"${token}" is not a valid array index.`);
+    }
+    const index = Number(token);
+    if (index >= current.length) {
+      throw new JsonPointerError(`Array index ${index} is out of bounds.`);
+    }
+    return current[index];
+  }
+  if (current !== null && typeof current === 'object') {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new JsonPointerError(`Member "${token}" does not exist.`);
+    }
+    return (current as { [key: string]: JsonValue })[token];
+  }
+  throw new JsonPointerError(`Cannot resolve token "${token}" against a non-container value.`);
+}
