+test('add: treats "__proto__" as a plain member name, not an accessor', () => {
+  const document = deepFreeze({});
+  const result = applyPatch(document, [
+    { op: 'add', path: '/__proto__', value: { polluted: true } },
+  ]) as { [key: string]: JsonValue };
+  assert.equal(Object.prototype.hasOwnProperty.call(result, '__proto__'), true);
+  assert.deepEqual(JSON.parse(JSON.stringify(result)), { ['__proto__']: { polluted: true } });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as { polluted?: boolean }).polluted, undefined);
+});
+
