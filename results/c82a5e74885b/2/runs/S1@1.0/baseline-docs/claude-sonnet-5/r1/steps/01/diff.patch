diff --git a/src/index.test.ts b/src/index.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4628564a95cee3b118361d132f67593d01978389
--- /dev/null
+++ b/src/index.test.ts
@@ -0,0 +1,77 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer, JsonPointerError } from "./index.js";
+
+// Document from RFC 6901, section 5.
+const document = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("resolves the whole document for the empty pointer", () => {
+  assert.equal(resolvePointer(document, ""), document);
+});
+
+test("resolves an object member", () => {
+  assert.deepEqual(resolvePointer(document, "/foo"), ["bar", "baz"]);
+});
+
+test("resolves an array element by index", () => {
+  assert.equal(resolvePointer(document, "/foo/0"), "bar");
+  assert.equal(resolvePointer(document, "/foo/1"), "baz");
+});
+
+test("resolves the member with an empty name", () => {
+  assert.equal(resolvePointer(document, "/"), 0);
+});
+
+test("unescapes ~1 to / and ~0 to ~, in that order", () => {
+  assert.equal(resolvePointer(document, "/a~1b"), 1);
+  assert.equal(resolvePointer(document, "/m~0n"), 8);
+});
+
+test("resolves member names that collide with reserved characters", () => {
+  assert.equal(resolvePointer(document, "/c%d"), 2);
+  assert.equal(resolvePointer(document, "/e^f"), 3);
+  assert.equal(resolvePointer(document, "/g|h"), 4);
+  assert.equal(resolvePointer(document, "/i\\j"), 5);
+  assert.equal(resolvePointer(document, '/k"l'), 6);
+  assert.equal(resolvePointer(document, "/ "), 7);
+});
+
+test("rejects a pointer that does not start with / and is not empty", () => {
+  assert.throws(() => resolvePointer(document, "foo"), JsonPointerError);
+});
+
+test("rejects a pointer referring to a missing object member", () => {
+  assert.throws(() => resolvePointer(document, "/bar"), JsonPointerError);
+});
+
+test("rejects a pointer with an out-of-bounds array index", () => {
+  assert.throws(() => resolvePointer(document, "/foo/2"), JsonPointerError);
+});
+
+test("rejects a pointer with a leading-zero array index", () => {
+  assert.throws(() => resolvePointer(document, "/foo/00"), JsonPointerError);
+});
+
+test("rejects the '-' array index, which does not reference an element", () => {
+  assert.throws(() => resolvePointer(document, "/foo/-"), JsonPointerError);
+});
+
+test("rejects a pointer that traverses into a primitive value", () => {
+  assert.throws(() => resolvePointer(document, "/foo/0/bar"), JsonPointerError);
+});
+
+test("rejects a token with an invalid escape sequence", () => {
+  assert.throws(() => resolvePointer(document, "/~2"), JsonPointerError);
+  assert.throws(() => resolvePointer(document, "/~"), JsonPointerError);
+});
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6e421d4b15c47f106fbc7b03679e513fab06c652
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,66 @@
+/** A JSON value, as defined by the JSON data model. */
+export type JsonValue =
+  | string
+  | number
+  | boolean
+  | null
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+/** Thrown when a JSON Pointer is malformed, or does not resolve to a value. */
+export class JsonPointerError extends Error {}
+
+const ARRAY_INDEX_PATTERN = /^(?:0|[1-9][0-9]*)$/;
+const INVALID_ESCAPE_PATTERN = /~(?![01])/;
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @throws {JsonPointerError} If `pointer` is not a valid JSON Pointer, or
+ *   does not resolve to a value within `document`.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("A JSON Pointer must be a string.");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new JsonPointerError(
+      `Invalid JSON Pointer "${pointer}": it must be empty or start with "/".`,
+    );
+  }
+
+  return pointer
+    .split("/")
+    .slice(1)
+    .reduce(resolveToken, document);
+}
+
+function resolveToken(current: JsonValue, rawToken: string): JsonValue {
+  if (INVALID_ESCAPE_PATTERN.test(rawToken)) {
+    throw new JsonPointerError(`Invalid JSON Pointer token "${rawToken}": "~" must be followed by "0" or "1".`);
+  }
+  const token = rawToken.replace(/~1/g, "/").replace(/~0/g, "~");
+
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX_PATTERN.test(token)) {
+      throw new JsonPointerError(`Invalid array index "${token}" in JSON Pointer.`);
+    }
+    const index = Number(token);
+    if (index >= current.length) {
+      throw new JsonPointerError(`Array index "${token}" is out of bounds in JSON Pointer.`);
+    }
+    return current[index];
+  }
+
+  if (current !== null && typeof current === "object") {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new JsonPointerError(`Member "${token}" does not exist in JSON Pointer target.`);
+    }
+    return (current as { [key: string]: JsonValue })[token];
+  }
+
+  throw new JsonPointerError(`Cannot resolve token "${token}" of JSON Pointer: value is not an object or array.`);
+}
