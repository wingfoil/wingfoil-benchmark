+test("treats '__proto__' as an ordinary member name for 'add', 'test' and 'remove'", () => {
+  const added = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]);
+  assert.equal(Object.prototype.hasOwnProperty.call(added, "__proto__"), true);
+  assert.deepEqual(added, JSON.parse('{"__proto__":{"polluted":true}}'));
+  assert.equal(({} as { polluted?: boolean }).polluted, undefined);
+
+  const tested = applyPatch(added, [{ op: "test", path: "/__proto__", value: { polluted: true } }]);
+  assert.deepEqual(tested, added);
+
+  const removed = applyPatch(added, [{ op: "remove", path: "/__proto__" }]);
+  assert.deepEqual(removed, {});
+});
+
+test("preserves and clones a document member literally named '__proto__'", () => {
+  const document = JSON.parse('{"__proto__":"value","foo":1}') as JsonValue;
+  const result = applyPatch(document, []);
+  assert.equal(Object.prototype.hasOwnProperty.call(result, "__proto__"), true);
+  assert.deepEqual(result, document);
+});
+
 test("rejects a patch that is not an array", () => {
   assert.throws(() => applyPatch({ foo: "bar" }, { op: "add", path: "/baz", value: 1 } as unknown as JsonPatchOperation[]), JsonPatchError);
 });
