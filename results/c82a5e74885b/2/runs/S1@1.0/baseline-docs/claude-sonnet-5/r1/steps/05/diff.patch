+
+// createPatch (diffing two documents into a JSON Patch, RFC 6902).
+
+test("returns an empty patch for two equal documents", () => {
+  assert.deepEqual(createPatch({ foo: "bar" }, { foo: "bar" }), []);
+});
+
+test("does not mutate its input documents", () => {
+  const from: JsonValue = { foo: "bar" };
+  const to: JsonValue = { foo: "baz", qux: 1 };
+  createPatch(from, to);
+  assert.deepEqual(from, { foo: "bar" });
+  assert.deepEqual(to, { foo: "baz", qux: 1 });
+});
+
+test("describes an added object member as a single 'add' operation", () => {
+  const patch = createPatch({ foo: "bar" }, { foo: "bar", baz: "qux" });
+  assert.deepEqual(patch, [{ op: "add", path: "/baz", value: "qux" }]);
+});
+
+test("describes a removed object member as a single 'remove' operation", () => {
+  const patch = createPatch({ foo: "bar", baz: "qux" }, { foo: "bar" });
+  assert.deepEqual(patch, [{ op: "remove", path: "/baz" }]);
+});
+
+test("describes a changed object member as a single 'replace' operation", () => {
+  const patch = createPatch({ foo: "bar" }, { foo: "baz" });
+  assert.deepEqual(patch, [{ op: "replace", path: "/foo", value: "baz" }]);
+});
+
+test("describes a change deep in the document without replacing the whole subtree", () => {
+  const from = { a: { b: 1, c: 2 }, unrelated: [1, 2, 3] };
+  const to = { a: { b: 5, c: 2 }, unrelated: [1, 2, 3] };
+  assert.deepEqual(createPatch(from, to), [{ op: "replace", path: "/a/b", value: 5 }]);
+});
+
+test("escapes '~' and '/' in member names used as JSON Pointer tokens", () => {
+  const patch = createPatch({}, { "a/b~c": 1 });
+  assert.deepEqual(patch, [{ op: "add", path: "/a~1b~0c", value: 1 }]);
+});
+
+test("describes an array insertion in the middle as a single 'add' operation", () => {
+  const patch = createPatch({ items: [1, 4] }, { items: [1, 2, 3, 4] });
+  assert.deepEqual(patch, [
+    { op: "add", path: "/items/1", value: 2 },
+    { op: "add", path: "/items/2", value: 3 },
+  ]);
+});
+
+test("describes an array removal in the middle as a single 'remove' operation", () => {
+  const patch = createPatch({ items: [1, 2, 3, 4] }, { items: [1, 4] });
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/items/1" },
+    { op: "remove", path: "/items/1" },
+  ]);
+});
+
+test("describes a single changed array element as a single 'replace' operation", () => {
+  const patch = createPatch({ items: [1, 2, 3] }, { items: [1, 5, 3] });
+  assert.deepEqual(patch, [{ op: "replace", path: "/items/1", value: 5 }]);
+});
+
+test("replaces the whole document when its type changes", () => {
+  assert.deepEqual(createPatch({ foo: "bar" }, [1, 2, 3]), [{ op: "replace", path: "", value: [1, 2, 3] }]);
+  assert.deepEqual(createPatch(1, "one"), [{ op: "replace", path: "", value: "one" }]);
+});
+
+test("the resulting patch applies cleanly and reproduces the target document", () => {
+  const from: JsonValue = {
+    name: "widget",
+    tags: ["a", "b", "c"],
+    meta: { version: 1, active: true },
+    extra: "to be removed",
+  };
+  const to: JsonValue = {
+    name: "widget",
+    tags: ["a", "x", "b", "c", "y"],
+    meta: { version: 2, active: true },
+    added: "new",
+  };
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("a value added by the patch is independent of the 'to' document it came from", () => {
+  const to: JsonValue = { foo: { bar: 1 } };
+  const patch = createPatch({}, to);
+  (to.foo as { bar: number }).bar = 2;
+  assert.deepEqual(applyPatch({}, patch), { foo: { bar: 1 } });
