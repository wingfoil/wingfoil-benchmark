+/**
+ * Computes a JSON Patch (RFC 6902) that turns `from` into `to` when applied with
+ * {@link applyPatch}.
+ *
+ * The patch describes only what changed: unchanged object members and array elements are
+ * left out, and a change nested deep in the document is described at that depth instead of
+ * replacing an ancestor subtree wholesale.
+ *
+ * Neither `from` nor `to` is mutated.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatchOperation[] {
+  return diffValues(from, to, "");
+}
+
+function diffValues(from: JsonValue, to: JsonValue, path: string): JsonPatchOperation[] {
+  if (deepEqual(from, to)) {
+    return [];
+  }
+  if (isJsonObject(from) && isJsonObject(to)) {
+    return diffObjects(from, to, path);
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    return diffArrays(from, to, path);
+  }
+  return [{ op: "replace", path, value: cloneValue(to) }];
+}
+
+function diffObjects(from: ObjectContainer, to: ObjectContainer, path: string): JsonPatchOperation[] {
+  const ops: JsonPatchOperation[] = [];
+  for (const key of Object.keys(from)) {
+    if (!Object.prototype.hasOwnProperty.call(to, key)) {
+      ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const childPath = `${path}/${escapeToken(key)}`;
+    if (!Object.prototype.hasOwnProperty.call(from, key)) {
+      ops.push({ op: "add", path: childPath, value: cloneValue(to[key]) });
+    } else {
+      ops.push(...diffValues(from[key], to[key], childPath));
+    }
+  }
+  return ops;
+}
+
+/**
+ * Diffs two arrays by matching their common leading and trailing elements, then describing
+ * the differing middle section: changed elements in the overlap are diffed recursively, and
+ * any remaining elements are added to or removed from `from`'s side of that section.
+ */
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string): JsonPatchOperation[] {
+  let prefix = 0;
+  while (prefix < from.length && prefix < to.length && deepEqual(from[prefix], to[prefix])) {
+    prefix++;
+  }
+
+  let suffix = 0;
+  while (
+    suffix < from.length - prefix &&
+    suffix < to.length - prefix &&
+    deepEqual(from[from.length - 1 - suffix], to[to.length - 1 - suffix])
+  ) {
+    suffix++;
+  }
+
+  const fromMid = from.slice(prefix, from.length - suffix);
+  const toMid = to.slice(prefix, to.length - suffix);
+  const overlap = Math.min(fromMid.length, toMid.length);
+
+  const ops: JsonPatchOperation[] = [];
+  for (let i = 0; i < overlap; i++) {
+    ops.push(...diffValues(fromMid[i], toMid[i], `${path}/${prefix + i}`));
+  }
+  for (let i = overlap; i < toMid.length; i++) {
+    ops.push({ op: "add", path: `${path}/${prefix + i}`, value: cloneValue(toMid[i]) });
+  }
+  for (let i = overlap; i < fromMid.length; i++) {
+    ops.push({ op: "remove", path: `${path}/${prefix + overlap}` });
+  }
+  return ops;
+}
+
+/** Escapes "~" and "/" in a JSON Pointer token, the inverse of {@link unescapeToken}. */
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
 /**
