+    const operation = parseOperation(rawOperation as unknown, index);
+    try {
+      return applyOperation(current, operation);
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      throw new JsonPatchError(`Operation ${index} ("${operation.op}") failed: ${message}`);
+    }
