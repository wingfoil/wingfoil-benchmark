+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a target JSON document and returns the merged
+ * document.
+ *
+ * Neither `target` nor `patch` is mutated; a new document is returned instead.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return cloneValue(patch);
+  }
+
+  const result: ObjectContainer = isJsonObject(target) ? (cloneValue(target) as ObjectContainer) : {};
+  for (const key of Object.keys(patch)) {
+    const patchValue = patch[key];
+    if (patchValue === null) {
+      delete result[key];
+    } else {
+      const currentValue = Object.prototype.hasOwnProperty.call(result, key) ? result[key] : null;
+      setMember(result, key, applyMergePatch(currentValue, patchValue));
+    }
+  }
+  return result;
+}
+
+function isJsonObject(value: JsonValue): value is ObjectContainer {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
