+
+// JSON Merge Patch (RFC 7386). Examples are taken from RFC 7386, Appendix A, unless noted otherwise.
+
+test("does not mutate its input target or patch", () => {
+  const target: JsonValue = { a: { b: "c" } };
+  const patch: JsonValue = { a: { b: "d", c: null } };
+  const result = applyMergePatch(target, patch);
+  assert.deepEqual(target, { a: { b: "c" } });
+  assert.deepEqual(patch, { a: { b: "d", c: null } });
+  assert.deepEqual(result, { a: { b: "d" } });
+});
+
+test("replaces an existing member", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: "c" }), { a: "c" });
+});
+
+test("adds a new member", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { b: "c" }), { a: "b", b: "c" });
+});
+
+test("a null value removes an existing member", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: null }), {});
+});
+
+test("a null value for a member leaves the other members untouched", () => {
+  assert.deepEqual(applyMergePatch({ a: "b", b: "c" }, { a: null }), { b: "c" });
+});
+
+test("a scalar patch value replaces an array", () => {
+  assert.deepEqual(applyMergePatch({ a: ["b"] }, { a: "c" }), { a: "c" });
+});
+
+test("an array patch value replaces a scalar", () => {
+  assert.deepEqual(applyMergePatch({ a: "c" }, { a: ["b"] }), { a: ["b"] });
+});
+
+test("merges nested objects member by member, deleting null members", () => {
+  assert.deepEqual(applyMergePatch({ a: { b: "c" } }, { a: { b: "d", c: null } }), { a: { b: "d" } });
+});
+
+test("an array value in the patch replaces the whole array, without merging elements", () => {
+  assert.deepEqual(applyMergePatch({ a: [{ b: "c" }] }, { a: [1] }), { a: [1] });
+});
+
+test("an array patch applied to an array target replaces it wholesale", () => {
+  assert.deepEqual(applyMergePatch(["a", "b"], ["c", "d"]), ["c", "d"]);
+});
+
+test("an array patch applied to an object target replaces it wholesale", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, ["c"]), ["c"]);
+});
+
+test("a null patch replaces the whole target", () => {
+  assert.equal(applyMergePatch({ a: "foo" }, null), null);
+});
+
+test("a scalar patch replaces the whole target", () => {
+  assert.equal(applyMergePatch({ a: "foo" }, "bar"), "bar");
+});
+
+test("a null member in the target survives when the patch adds an unrelated member", () => {
+  assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+});
+
+test("merges nested objects recursively, pruning members left empty by a null leaf", () => {
+  assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+});
+
+test("treats a non-object target as empty when the patch is an object", () => {
+  assert.deepEqual(applyMergePatch("not an object", { a: "b" }), { a: "b" });
+});
+
+test("treats '__proto__' as an ordinary member name", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"polluted":true}}') as JsonValue);
+  assert.equal(Object.prototype.hasOwnProperty.call(result, "__proto__"), true);
+  assert.deepEqual(result, JSON.parse('{"__proto__":{"polluted":true}}'));
+  assert.equal(({} as { polluted?: boolean }).polluted, undefined);
+});
