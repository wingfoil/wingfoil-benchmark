diff --git a/test/index.test.ts b/test/index.test.ts
index 3a8995d37c76173ffb4919a46f464f306d7a7df9..a08d3150377c79fd4df455e6b0e8bb78b75ff333 100644
--- a/test/index.test.ts
+++ b/test/index.test.ts
@@ -286,3 +286,33 @@ test('add rejects an out-of-bounds array index', () => {
   const patch: JsonPatchOperation[] = [{ op: 'add', path: '/foo/5', value: 3 }];
   assert.throws(() => applyPatch(document, patch));
 });
+
+test('add can create a member literally named "__proto__" without polluting Object.prototype', () => {
+  const document: JsonValue = {};
+  const patch: JsonPatchOperation[] = [{ op: 'add', path: '/__proto__', value: { polluted: true } }];
+  const result = applyPatch(document, patch) as Record<string, JsonValue>;
+  assert.equal(Object.prototype.hasOwnProperty.call(result, '__proto__'), true);
+  assert.deepEqual(result['__proto__'], { polluted: true });
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test('a "__proto__" member untouched by the patch survives application', () => {
+  const document = JSON.parse('{"__proto__": {"kept": true}, "safe": 1}') as JsonValue;
+  const patch: JsonPatchOperation[] = [{ op: 'replace', path: '/safe', value: 2 }];
+  const result = applyPatch(document, patch) as Record<string, JsonValue>;
+  assert.equal(Object.prototype.hasOwnProperty.call(result, '__proto__'), true);
+  assert.deepEqual(result['__proto__'], { kept: true });
+});
+
+test('replace and remove work on a member literally named "__proto__"', () => {
+  const document = JSON.parse('{"__proto__": 1}') as JsonValue;
+  const replaced = applyPatch(document, [{ op: 'replace', path: '/__proto__', value: 2 }]) as Record<
+    string,
+    JsonValue
+  >;
+  assert.equal(Object.prototype.hasOwnProperty.call(replaced, '__proto__'), true);
+  assert.equal(replaced['__proto__'], 2);
+
+  const removed = applyPatch(document, [{ op: 'remove', path: '/__proto__' }]) as Record<string, JsonValue>;
+  assert.equal(Object.prototype.hasOwnProperty.call(removed, '__proto__'), false);
+});
