+import { applyMergePatch, applyPatch, resolvePointer, type JsonPatchOperation, type JsonValue } from '../src/index.ts';
 
 // The example document and pointers from RFC 6901, Section 5.
 const rfcDocument: JsonValue = {
@@ -316,3 +316,52 @@ test('replace and remove work on a member literally named "__proto__"', () => {
   const removed = applyPatch(document, [{ op: 'remove', path: '/__proto__' }]) as Record<string, JsonValue>;
   assert.equal(Object.prototype.hasOwnProperty.call(removed, '__proto__'), false);
 });
+
+// The test cases from RFC 7386, Appendix A.
+test('RFC 7386 appendix A examples', () => {
+  const cases: Array<{ target: JsonValue; patch: JsonValue; result: JsonValue }> = [
+    { target: { a: 'b' }, patch: { a: 'c' }, result: { a: 'c' } },
+    { target: { a: 'b' }, patch: { b: 'c' }, result: { a: 'b', b: 'c' } },
+    { target: { a: 'b' }, patch: { a: null }, result: {} },
+    { target: { a: 'b', b: 'c' }, patch: { a: null }, result: { b: 'c' } },
+    { target: { a: ['b'] }, patch: { a: 'c' }, result: { a: 'c' } },
+    { target: { a: 'c' }, patch: { a: ['b'] }, result: { a: ['b'] } },
+    {
+      target: { a: { b: 'c' } },
+      patch: { a: { b: 'd', c: null } },
+      result: { a: { b: 'd' } },
+    },
+    { target: { a: [{ b: 'c' }] }, patch: { a: [1] }, result: { a: [1] } },
+    { target: ['a', 'b'], patch: ['c', 'd'], result: ['c', 'd'] },
+    { target: { a: 'b' }, patch: ['c'], result: ['c'] },
+    { target: { a: 'foo' }, patch: null, result: null },
+    { target: { a: 'foo' }, patch: 'bar', result: 'bar' },
+    { target: { e: null }, patch: { a: 1 }, result: { e: null, a: 1 } },
+    { target: [1, 2], patch: { a: 'b', c: null }, result: { a: 'b' } },
+    { target: {}, patch: { a: { bb: { ccc: null } } }, result: { a: { bb: {} } } },
+  ];
+
+  for (const { target, patch, result } of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), result);
+  }
+});
+
+test('does not mutate the target or the patch', () => {
+  const target: JsonValue = { a: { b: 'c' }, d: 'e' };
+  const patch: JsonValue = { a: { b: 'f', g: null }, h: 'i' };
+  const targetCopy = JSON.parse(JSON.stringify(target));
+  const patchCopy = JSON.parse(JSON.stringify(patch));
+
+  applyMergePatch(target, patch);
+
+  assert.deepEqual(target, targetCopy);
+  assert.deepEqual(patch, patchCopy);
+});
+
+test('merging into a member literally named "__proto__" does not pollute Object.prototype', () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}}') as JsonValue;
+  const result = applyMergePatch({}, patch) as Record<string, JsonValue>;
+  assert.equal(Object.prototype.hasOwnProperty.call(result, '__proto__'), true);
+  assert.deepEqual(result['__proto__'], { polluted: true });
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
