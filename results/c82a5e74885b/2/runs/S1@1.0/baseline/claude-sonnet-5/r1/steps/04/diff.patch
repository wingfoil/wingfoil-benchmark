+++ b/src/index.ts
@@ -48,6 +48,35 @@ export function applyPatch(document: JsonValue, patch: JsonPatchOperation[]): Js
   return result;
 }
 
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to `target` and returns the result
+ * as a new value, without mutating `target` or `patch`.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return deepClone(patch);
+  }
+
+  const base = isJsonObject(target) ? target : {};
+  const result: { [key: string]: JsonValue } = {};
+  for (const key of Object.keys(base)) {
+    setMember(result, key, deepClone(base[key]));
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(result[key] ?? null, value));
+    }
+  }
+  return result;
+}
+
+function isJsonObject(value: JsonValue): value is { [key: string]: JsonValue } {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
 function parsePointer(pointer: string): string[] {
   if (pointer[0] !== '/') {
     throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
