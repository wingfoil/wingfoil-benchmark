+/**
+ * Computes a JSON Patch (RFC 6902) that turns `from` into `to` when applied,
+ * without mutating either input.
+ *
+ * The patch only describes the parts of the document that actually changed:
+ * unchanged members and array elements are left untouched.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatchOperation[] {
+  const patch: JsonPatchOperation[] = [];
+  diffValues(from, to, '', patch);
+  return patch;
+}
+
 function isJsonObject(value: JsonValue): value is { [key: string]: JsonValue } {
   return typeof value === 'object' && value !== null && !Array.isArray(value);
 }
 
+function diffValues(from: JsonValue, to: JsonValue, path: string, patch: JsonPatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (isJsonObject(from) && isJsonObject(to)) {
+    diffObjects(from, to, path, patch);
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, patch);
+    return;
+  }
+  patch.push({ op: 'replace', path, value: deepClone(to) });
+}
+
+function diffObjects(
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.prototype.hasOwnProperty.call(to, key)) {
+      patch.push({ op: 'remove', path: `${path}/${encodeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (!Object.prototype.hasOwnProperty.call(from, key)) {
+      patch.push({ op: 'add', path: `${path}/${encodeToken(key)}`, value: deepClone(to[key]) });
+    } else {
+      diffValues(from[key], to[key], `${path}/${encodeToken(key)}`, patch);
+    }
+  }
+}
+
+// Diffs matching prefixes and suffixes first, then recurses into the common
+// middle stretch and only adds/removes the surplus on whichever side is
+// longer. This keeps a single inserted/removed element from turning into a
+// replacement of everything after it.
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, patch: JsonPatchOperation[]): void {
+  const minLength = Math.min(from.length, to.length);
+
+  let start = 0;
+  while (start < minLength && deepEqual(from[start], to[start])) {
+    start++;
+  }
+
+  let endFrom = from.length - 1;
+  let endTo = to.length - 1;
+  while (endFrom >= start && endTo >= start && deepEqual(from[endFrom], to[endTo])) {
+    endFrom--;
+    endTo--;
+  }
+
+  const fromMidLength = endFrom - start + 1;
+  const toMidLength = endTo - start + 1;
+  const pairedLength = Math.max(0, Math.min(fromMidLength, toMidLength));
+
+  for (let k = 0; k < pairedLength; k++) {
+    diffValues(from[start + k], to[start + k], `${path}/${start + k}`, patch);
+  }
+  for (let idx = endFrom; idx >= start + pairedLength; idx--) {
+    patch.push({ op: 'remove', path: `${path}/${idx}` });
+  }
+  for (let idx = start + pairedLength; idx <= endTo; idx++) {
+    patch.push({ op: 'add', path: `${path}/${idx}`, value: deepClone(to[idx]) });
+  }
+}
+
+function encodeToken(token: string): string {
+  return token.replace(/~/g, '~0').replace(/\//g, '~1');
+}
+
 function parsePointer(pointer: string): string[] {
   if (pointer[0] !== '/') {
     throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
