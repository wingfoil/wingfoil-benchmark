+
+// createPatch
+test('createPatch returns an empty patch for identical documents', () => {
+  const document: JsonValue = { a: 1, b: [1, 2, 3] };
+  assert.deepEqual(createPatch(document, document), []);
+});
+
+test('createPatch describes only a changed member, not the whole object', () => {
+  const from: JsonValue = { a: 1, b: { c: 2, d: 3 } };
+  const to: JsonValue = { a: 1, b: { c: 2, d: 4 } };
+  assert.deepEqual(createPatch(from, to), [{ op: 'replace', path: '/b/d', value: 4 }]);
+});
+
+test('createPatch adds and removes object members', () => {
+  const from: JsonValue = { a: 1, b: 2 };
+  const to: JsonValue = { a: 1, c: 3 };
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(patch.sort((x, y) => x.path.localeCompare(y.path)), [
+    { op: 'remove', path: '/b' },
+    { op: 'add', path: '/c', value: 3 },
+  ]);
+});
+
+test('createPatch escapes "~" and "/" in member names', () => {
+  const from: JsonValue = {};
+  const to: JsonValue = { 'a/b~c': 1 };
+  assert.deepEqual(createPatch(from, to), [{ op: 'add', path: '/a~1b~0c', value: 1 }]);
+});
+
+test('createPatch appends to an array without touching existing elements', () => {
+  const from: JsonValue = { items: [1, 2] };
+  const to: JsonValue = { items: [1, 2, 3] };
+  assert.deepEqual(createPatch(from, to), [{ op: 'add', path: '/items/2', value: 3 }]);
+});
+
+test('createPatch removes a trailing array element', () => {
+  const from: JsonValue = { items: [1, 2, 3] };
+  const to: JsonValue = { items: [1, 2] };
+  assert.deepEqual(createPatch(from, to), [{ op: 'remove', path: '/items/2' }]);
+});
+
+test('createPatch describes an inserted array element without replacing the tail', () => {
+  const from: JsonValue = ['a', 'b'];
+  const to: JsonValue = ['a', 'x', 'b'];
+  assert.deepEqual(createPatch(from, to), [{ op: 'add', path: '/1', value: 'x' }]);
+});
+
+test('createPatch recurses into a changed array element', () => {
+  const from: JsonValue = [{ id: 1, name: 'foo' }];
+  const to: JsonValue = [{ id: 1, name: 'bar' }];
+  assert.deepEqual(createPatch(from, to), [{ op: 'replace', path: '/0/name', value: 'bar' }]);
+});
+
+test('createPatch replaces the root when the shape changes entirely', () => {
+  const from: JsonValue = { a: 1 };
+  const to: JsonValue = [1, 2, 3];
+  assert.deepEqual(createPatch(from, to), [{ op: 'replace', path: '', value: [1, 2, 3] }]);
+});
+
+test('createPatch produces a patch that applies cleanly for arbitrary changes', () => {
+  const from: JsonValue = { users: [{ id: 1, tags: ['a', 'b'] }, { id: 2, tags: [] }], count: 2 };
+  const to: JsonValue = { users: [{ id: 1, tags: ['a', 'c', 'b'] }, { id: 3, tags: ['z'] }], count: 2 };
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test('createPatch does not mutate its inputs', () => {
+  const from: JsonValue = { a: { b: 1 }, arr: [1, 2, 3] };
+  const to: JsonValue = { a: { b: 2 }, arr: [1, 2, 3, 4] };
+  const fromCopy = JSON.parse(JSON.stringify(from));
+  const toCopy = JSON.parse(JSON.stringify(to));
+
+  const patch = createPatch(from, to);
+  patch.forEach((op) => {
+    if ('value' in op && typeof op.value === 'object' && op.value !== null) {
+      (op.value as Record<string, JsonValue>).mutated = true;
+    }
+  });
