+  const fromTokens = from === '' ? [] : parsePointer(from);
+  const pathTokens = path === '' ? [] : parsePointer(path);
+  if (pathTokens.length > fromTokens.length && fromTokens.every((token, i) => token === pathTokens[i])) {
+    throw new Error(`Invalid JSON Patch: cannot move "${from}" into its own child "${path}"`);
+  }
