+  const patch: JsonPatchOperation[] = [{ op: 'move', from: '/foo/waldo', path: '/qux/thud' }];
+  assert.deepEqual(applyPatch(document, patch), {
+    foo: { bar: 'baz' },
+    qux: { corge: 'grault', thud: 'fred' },
