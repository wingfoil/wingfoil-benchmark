+  if (Array.isArray(parent)) {
+    const index = parseArrayIndex(key, parent.length, path, false);
+    parent[index] = deepClone(value);
+  } else if (typeof parent === 'object' && parent !== null) {
+    if (!Object.prototype.hasOwnProperty.call(parent, key)) {
+      throw new Error(`Invalid JSON Patch: cannot replace "${path}", no member "${key}"`);
+    }
+    (parent as Record<string, JsonValue>)[key] = deepClone(value);
+  } else {
