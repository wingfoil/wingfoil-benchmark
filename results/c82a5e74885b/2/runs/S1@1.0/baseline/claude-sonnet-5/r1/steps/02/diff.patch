+
+// The example documents and patches from RFC 6902, Appendix A.
+test('A.1 adding an object member', () => {
+  const document: JsonValue = { foo: 'bar' };
+  const patch: JsonPatchOperation[] = [{ op: 'add', path: '/baz', value: 'qux' }];
+  assert.deepEqual(applyPatch(document, patch), { foo: 'bar', baz: 'qux' });
+});
+
+test('A.2 adding an array element', () => {
+  const document: JsonValue = { foo: ['bar', 'baz'] };
+  const patch: JsonPatchOperation[] = [{ op: 'add', path: '/foo/1', value: 'qux' }];
+  assert.deepEqual(applyPatch(document, patch), { foo: ['bar', 'qux', 'baz'] });
+});
+
+test('A.3 removing an object member', () => {
+  const document: JsonValue = { baz: 'qux', foo: 'bar' };
+  const patch: JsonPatchOperation[] = [{ op: 'remove', path: '/baz' }];
+  assert.deepEqual(applyPatch(document, patch), { foo: 'bar' });
+});
+
+test('A.4 removing an array element', () => {
+  const document: JsonValue = { foo: ['bar', 'qux', 'baz'] };
+  const patch: JsonPatchOperation[] = [{ op: 'remove', path: '/foo/1' }];
+  assert.deepEqual(applyPatch(document, patch), { foo: ['bar', 'baz'] });
+});
+
+test('A.5 replacing a value', () => {
+  const document: JsonValue = { baz: 'qux', foo: 'bar' };
+  const patch: JsonPatchOperation[] = [{ op: 'replace', path: '/baz', value: 'boo' }];
+  assert.deepEqual(applyPatch(document, patch), { baz: 'boo', foo: 'bar' });
+});
+
