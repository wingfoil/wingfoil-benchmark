diff --git a/src/index.test.ts b/src/index.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9717b1897e1855a0888731cd3d52a4efa77ff5b1
--- /dev/null
+++ b/src/index.test.ts
@@ -0,0 +1,108 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "./index.ts";
+
+const document = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  "k\"l": 6,
+  " ": 7,
+  "m~n": 8,
+  nested: { deeper: { value: 42 } },
+  empty: {},
+};
+
+test("empty pointer resolves to the whole document", () => {
+  assert.equal(resolvePointer(document, ""), document);
+});
+
+test("resolves a top-level property", () => {
+  assert.deepEqual(resolvePointer(document, "/foo"), ["bar", "baz"]);
+});
+
+test("resolves an array element by index", () => {
+  assert.equal(resolvePointer(document, "/foo/0"), "bar");
+  assert.equal(resolvePointer(document, "/foo/1"), "baz");
+});
+
+test("resolves nested object properties", () => {
+  assert.equal(resolvePointer(document, "/nested/deeper/value"), 42);
+});
+
+test("resolves the empty-string property", () => {
+  assert.equal(resolvePointer(document, "/"), 0);
+});
+
+test("examples from RFC 6901 section 5", () => {
+  const rfcExample = {
+    foo: ["bar", "baz"],
+    "": 0,
+    "a/b": 1,
+    "c%d": 2,
+    "e^f": 3,
+    "g|h": 4,
+    "i\\j": 5,
+    'k"l': 6,
+    " ": 7,
+    "m~n": 8,
+  };
+  assert.deepEqual(resolvePointer(rfcExample, ""), rfcExample);
+  assert.deepEqual(resolvePointer(rfcExample, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfcExample, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfcExample, "/"), 0);
+  assert.equal(resolvePointer(rfcExample, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfcExample, "/c%d"), 2);
+  assert.equal(resolvePointer(rfcExample, "/e^f"), 3);
+  assert.equal(resolvePointer(rfcExample, "/g|h"), 4);
+  assert.equal(resolvePointer(rfcExample, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfcExample, '/k"l'), 6);
+  assert.equal(resolvePointer(rfcExample, "/ "), 7);
+  assert.equal(resolvePointer(rfcExample, "/m~0n"), 8);
+});
+
+test("decodes ~1 before ~0 so ~01 means a literal ~1", () => {
+  const doc = { "~1": "literal-tilde-one" };
+  assert.equal(resolvePointer(doc, "/~01"), "literal-tilde-one");
+});
+
+test("throws for a pointer that does not start with /", () => {
+  assert.throws(() => resolvePointer(document, "foo"));
+});
+
+test("throws for a dangling ~ escape", () => {
+  assert.throws(() => resolvePointer(document, "/foo~"));
+  assert.throws(() => resolvePointer(document, "/foo~2"));
+});
+
+test("throws for a nonexistent object property", () => {
+  assert.throws(() => resolvePointer(document, "/missing"));
+});
+
+test("throws for an array index out of bounds", () => {
+  assert.throws(() => resolvePointer(document, "/foo/2"));
+});
+
+test("throws for a non-numeric array index", () => {
+  assert.throws(() => resolvePointer(document, "/foo/bar"));
+});
+
+test("throws for a leading-zero array index", () => {
+  assert.throws(() => resolvePointer(document, "/foo/01"));
+});
+
+test("throws for the '-' array index (nonexistent element)", () => {
+  assert.throws(() => resolvePointer(document, "/foo/-"));
+});
+
+test("throws when descending into a non-object, non-array value", () => {
+  assert.throws(() => resolvePointer(document, "/foo/0/bar"));
+});
+
+test("resolves into an empty object pointer target without throwing", () => {
+  assert.deepEqual(resolvePointer(document, "/empty"), {});
+});
