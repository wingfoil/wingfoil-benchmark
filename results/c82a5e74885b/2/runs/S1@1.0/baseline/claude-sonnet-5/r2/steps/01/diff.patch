new file mode 100644
index 0000000000000000000000000000000000000000..90a371c04e086461d7d2edc0d7e5a03b61c5e0fc
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,51 @@
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  if (pointer === "") {
+    return document;
+  }
+  if (pointer[0] !== "/") {
+    throw new Error(`Invalid JSON Pointer: "${pointer}"`);
+  }
+
+  let current = document;
+  for (const token of pointer.split("/").slice(1).map(decodeToken)) {
+    current = step(current, token);
+  }
+  return current;
+}
+
+function decodeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer escape sequence in "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function step(value: JsonValue, token: string): JsonValue {
+  if (Array.isArray(value)) {
+    if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+      throw new Error(`Invalid array index "${token}" in JSON Pointer`);
+    }
+    const index = Number(token);
+    if (index >= value.length) {
+      throw new Error(`Array index "${token}" is out of bounds`);
+    }
+    return value[index];
+  }
+
+  if (value !== null && typeof value === "object") {
+    if (!Object.prototype.hasOwnProperty.call(value, token)) {
+      throw new Error(`No property "${token}" in JSON Pointer target`);
+    }
+    return value[token];
+  }
+
+  throw new Error(`Cannot resolve JSON Pointer token "${token}" into a non-object, non-array value`);
+}
