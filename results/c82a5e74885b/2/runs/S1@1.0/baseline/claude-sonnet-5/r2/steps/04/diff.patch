+export type JsonMergePatch = JsonValue;
+
+export function applyMergePatch(target: JsonValue, patch: JsonMergePatch): JsonValue {
+  return mergePatch(target, patch);
+}
+
+function mergePatch(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isObject(patch)) {
+    return structuredClone(patch);
+  }
+
+  const result: { [key: string]: JsonValue } = isObject(target) ? structuredClone(target) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      if (hasOwn(result, key)) {
+        delete result[key];
+      }
+    } else {
+      setMember(result, key, mergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
+
 export function applyPatch(document: JsonValue, patch: JsonPatch): JsonValue {
   if (!Array.isArray(patch)) {
     throw new Error("A JSON Patch must be an array of operations");
