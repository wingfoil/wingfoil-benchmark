 const document = {
   foo: ["bar", "baz"],
@@ -390,3 +390,86 @@ test("RFC 6902 A.16: adding an array value", () => {
   const result = applyPatch(doc, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]);
   assert.deepEqual(result, { foo: ["bar", ["abc", "def"]] });
 });
+
+// applyMergePatch
+
+test("RFC 7386 A.1: replaces an existing member", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: "c" }), { a: "c" });
+});
+
+test("RFC 7386 A.2: adds a new member", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { b: "c" }), { a: "b", b: "c" });
+});
+
+test("RFC 7386 A.3: a null value removes the member", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: null }), {});
+});
+
+test("RFC 7386 A.4: a null value removes an existing member, leaving the rest", () => {
+  assert.deepEqual(applyMergePatch({ a: "b", b: "c" }, { a: null }), { b: "c" });
+});
+
+test("RFC 7386 A.5: an array in the patch replaces the array in the target wholesale", () => {
+  assert.deepEqual(applyMergePatch({ a: ["b"] }, { a: "c" }), { a: "c" });
+});
+
+test("RFC 7386 A.6: a string in the target is replaced by an array in the patch", () => {
+  assert.deepEqual(applyMergePatch({ a: "c" }, { a: ["b"] }), { a: ["b"] });
+});
+
+test("RFC 7386 A.7: merges nested objects recursively", () => {
+  assert.deepEqual(applyMergePatch({ a: { b: "c" } }, { a: { b: "d", c: null } }), {
+    a: { b: "d" },
+  });
+});
+
+test("RFC 7386 A.8: an array of objects in the patch replaces the array wholesale", () => {
+  assert.deepEqual(applyMergePatch({ a: [{ b: "c" }] }, { a: [1] }), { a: [1] });
+});
+
+test("RFC 7386 A.9: a patch array replaces a target array", () => {
+  assert.deepEqual(applyMergePatch(["a", "b"], ["c", "d"]), ["c", "d"]);
+});
+
+test("RFC 7386 A.10: a patch array replaces a target object", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, ["c"]), ["c"]);
+});
+
+test("RFC 7386 A.11: a null patch replaces the whole target with null", () => {
+  assert.equal(applyMergePatch({ a: "foo" }, null), null);
+});
+
+test("RFC 7386 A.12: a string patch replaces the whole target", () => {
+  assert.equal(applyMergePatch({ a: "foo" }, "bar"), "bar");
+});
+
+test("RFC 7386 A.13: a null-valued member in the target is left alone when the patch adds a sibling", () => {
+  assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+});
+
+test("RFC 7386 A.14: a non-object target is discarded in favor of an empty object before merging", () => {
+  assert.deepEqual(applyMergePatch([1, 2], { a: "b", c: null }), { a: "b" });
+});
+
+test("RFC 7386 A.15: null removals apply recursively, even into newly-created objects", () => {
+  assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+});
+
+test("does not mutate the target or the patch", () => {
+  const target = { a: { b: "c" }, d: "e" };
+  const patch = { a: { b: "d", c: null }, d: null };
+  const result = applyMergePatch(target, patch);
+  assert.deepEqual(result, { a: { b: "d" } });
+  assert.deepEqual(target, { a: { b: "c" }, d: "e" });
+  assert.deepEqual(patch, { a: { b: "d", c: null }, d: null });
+});
+
+test("'__proto__' is merged as a plain data member, not the object's prototype", () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}}');
+  const result = applyMergePatch({ foo: "bar" }, patch) as Record<string, unknown>;
+  assert.deepEqual(Object.keys(result), ["foo", "__proto__"]);
+  assert.equal(Object.prototype.hasOwnProperty.call(result, "__proto__"), true);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(JSON.stringify(result), '{"foo":"bar","__proto__":{"polluted":true}}');
+  assert.equal((Object.prototype as Record<string, unknown>).polluted, undefined);
+});
