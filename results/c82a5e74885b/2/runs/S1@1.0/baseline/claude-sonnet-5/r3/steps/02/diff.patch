+
+function parseArrayInsertIndex(token: string, length: number): number {
+  if (token === "-") {
+    return length;
+  }
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`Invalid JSON Pointer array index: "${token}"`);
+  }
