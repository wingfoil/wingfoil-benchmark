+
+test('rejects a sub-day period that does not start and end on the hour', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 400 });
+
+  assert.throws(() =>
+    service.quote({ itemId: 'board-1', start: '2024-06-01T13:30:00Z', end: '2024-06-01T16:00:00Z' }),
+  );
+});
+
+test('rejects a 24-hour period that does not start and end at midnight UTC', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 400 });
+
+  assert.throws(() =>
+    service.quote({ itemId: 'board-1', start: '2024-06-01T13:00:00Z', end: '2024-06-02T13:00:00Z' }),
+  );
+});
+
+test('rejects equipment with a negative or non-integer hourly price', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100, hourlyPrice: -1 }));
+  assert.throws(() => service.addEquipment({ id: 'y', kind: 'sail', dailyPrice: 100, hourlyPrice: 10.5 }));
+});
+
+test('an hourly booking blocks an overlapping hourly availability slot', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 400 });
+  service.book({ itemId: 'board-1', start: '2024-06-01T13:00:00Z', end: '2024-06-01T15:00:00Z' });
