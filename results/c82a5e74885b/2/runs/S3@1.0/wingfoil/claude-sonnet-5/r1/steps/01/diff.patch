@@ -0,0 +1,95 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { createRentalService } from './index.ts';
+
+function board() {
+  return { id: 'board-1', kind: 'board' as const, dailyPrice: 2500 };
+}
+
+test('quotes a multi-day rental in integer cents', () => {
+  const service = createRentalService();
+  service.addEquipment(board());
+
+  const result = service.quote({ itemId: 'board-1', start: '2024-06-01T00:00:00Z', end: '2024-06-04T00:00:00Z' });
+
+  assert.deepEqual(result, {
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00Z',
+    end: '2024-06-04T00:00:00Z',
+    total: 7500,
+  });
+});
+
+test('books an item and returns a booking id alongside the quote', () => {
+  const service = createRentalService();
+  service.addEquipment(board());
+
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-01T00:00:00Z', end: '2024-06-02T00:00:00Z' });
+
+  assert.equal(typeof booking.id, 'string');
+  assert.ok(booking.id.length > 0);
+  assert.deepEqual(
+    { itemId: booking.itemId, start: booking.start, end: booking.end, total: booking.total },
+    { itemId: 'board-1', start: '2024-06-01T00:00:00Z', end: '2024-06-02T00:00:00Z', total: 2500 },
+  );
+});
+
+test('rejects a quote for an unknown item', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.quote({ itemId: 'missing', start: '2024-06-01T00:00:00Z', end: '2024-06-02T00:00:00Z' }));
+});
+
+test('rejects a booking for an unknown item', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.book({ itemId: 'missing', start: '2024-06-01T00:00:00Z', end: '2024-06-02T00:00:00Z' }));
+});
+
+test('rejects a period that does not start and end at midnight UTC', () => {
+  const service = createRentalService();
+  service.addEquipment(board());
+
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2024-06-01T12:00:00Z', end: '2024-06-02T12:00:00Z' }));
+});
+
+test('rejects a period whose end is not after its start', () => {
+  const service = createRentalService();
+  service.addEquipment(board());
+
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2024-06-01T00:00:00Z', end: '2024-06-01T00:00:00Z' }));
+});
+
+test('rejects overlapping bookings for the same item', () => {
+  const service = createRentalService();
+  service.addEquipment(board());
+  service.book({ itemId: 'board-1', start: '2024-06-01T00:00:00Z', end: '2024-06-05T00:00:00Z' });
+
+  assert.throws(() =>
+    service.book({ itemId: 'board-1', start: '2024-06-03T00:00:00Z', end: '2024-06-06T00:00:00Z' }),
+  );
+});
+
+test('allows back-to-back bookings that do not overlap', () => {
+  const service = createRentalService();
+  service.addEquipment(board());
+  service.book({ itemId: 'board-1', start: '2024-06-01T00:00:00Z', end: '2024-06-03T00:00:00Z' });
+
+  const second = service.book({ itemId: 'board-1', start: '2024-06-03T00:00:00Z', end: '2024-06-05T00:00:00Z' });
+
+  assert.equal(second.itemId, 'board-1');
+});
+
+test('rejects equipment with an unknown kind', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'kite' as never, dailyPrice: 100 }));
+});
+
+test('rejects equipment with a negative or non-integer daily price', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: -1 }));
+  assert.throws(() => service.addEquipment({ id: 'y', kind: 'sail', dailyPrice: 10.5 }));
+});
