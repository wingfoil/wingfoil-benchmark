+++ b/src/index.ts
@@ -0,0 +1,122 @@
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/** A board or a sail that the school can rent out. */
+export interface Equipment {
+  id: string;
+  kind: 'board' | 'sail';
+  /** Cost of one day of rental, in integer euro cents. */
+  dailyPrice: number;
+}
+
+/** A request to quote or book one item for a period. */
+export interface RentalRequest {
+  itemId: string;
+  /** Start of the period, an ISO-8601 UTC timestamp at midnight. */
+  start: string;
+  /** End of the period, an ISO-8601 UTC timestamp at midnight, exclusive. */
+  end: string;
+}
+
+/** The cost of renting an item for a period. */
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  /** Total cost, in integer euro cents. */
+  total: number;
+}
+
+/** A confirmed rental of an item for a period. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** An in-memory rental desk: equipment catalogue, quoting and booking. */
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+interface Period {
+  startMs: number;
+  endMs: number;
+}
+
+function parsePeriod(start: string, end: string): Period {
+  const startMs = Date.parse(start);
+  const endMs = Date.parse(end);
+  if (Number.isNaN(startMs) || Number.isNaN(endMs)) {
+    throw new Error('start and end must be ISO-8601 timestamps');
+  }
+  if (startMs % DAY_MS !== 0 || endMs % DAY_MS !== 0) {
+    throw new Error('a booking period must start and end at midnight UTC');
+  }
+  if (endMs <= startMs) {
+    throw new Error('a booking period must cover at least one whole day');
+  }
+  return { startMs, endMs };
+}
+
+function overlaps(a: Period, b: Period): boolean {
+  return a.startMs < b.endMs && b.startMs < a.endMs;
+}
+
+/** Creates a rental service that keeps its catalogue and bookings in memory. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookedPeriods = new Map<string, Period[]>();
+  const bookings: Booking[] = [];
+
+  function requireEquipment(itemId: string): Equipment {
+    const item = equipment.get(itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${itemId}`);
+    }
+    return item;
+  }
+
+  function resolveQuote(request: RentalRequest): { item: Equipment; period: Period; total: number } {
+    const item = requireEquipment(request.itemId);
+    const period = parsePeriod(request.start, request.end);
+    const days = (period.endMs - period.startMs) / DAY_MS;
+    return { item, period, total: days * item.dailyPrice };
+  }
+
+  return {
+    addEquipment(item) {
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error(`unknown equipment kind: ${item.kind}`);
+      }
+      if (!Number.isInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of cents');
+      }
+      equipment.set(item.id, item);
+    },
+
+    quote(request) {
+      const { total } = resolveQuote(request);
+      return { itemId: request.itemId, start: request.start, end: request.end, total };
+    },
+
+    book(request) {
+      const { period, total } = resolveQuote(request);
+      const periods = bookedPeriods.get(request.itemId) ?? [];
+      if (periods.some((booked) => overlaps(booked, period))) {
+        throw new Error(`item ${request.itemId} is not free for that period`);
+      }
+      periods.push(period);
+      bookedPeriods.set(request.itemId, periods);
+
+      const booking: Booking = {
+        id: `booking-${bookings.length + 1}`,
+        itemId: request.itemId,
+        start: request.start,
+        end: request.end,
+        total,
+      };
+      bookings.push(booking);
+      return booking;
+    },
+  };
+}
