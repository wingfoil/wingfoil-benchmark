@@ -0,0 +1,32 @@
+---
+id: task-005-let-customers-cancel-a-booking
+type: task
+title: "Let customers cancel a booking"
+status: pending
+---
+
+## Request
+
+Add `cancel(bookingId, at)` to the rental service: it cancels the booking at the time `at` and returns
+`{ bookingId, refund }`, the amount given back to the customer. A cancelled booking no longer holds its
+equipment, and a booking can only be cancelled once.
+
+## What was done
+
+- Added `cancel(bookingId: string, at: string): Cancellation` to `RentalService`, with a new exported
+  `Cancellation` interface (`{ bookingId, refund }`).
+- `createRentalService` now keeps bookings in a `Map<string, Booking>` (instead of an array) plus a
+  parallel `bookingPeriods` map and a `cancelledBookingIds` set, so `cancel` can look up a booking's item
+  and period in O(1) and reject a second cancellation.
+- `cancel` validates the booking exists and isn't already cancelled, parses `at` as an ISO-8601 timestamp
+  (same rejection as `parsePeriod`), then removes the booking's period from `bookedPeriods` so the item is
+  immediately free again for `availability` and `book`.
+- Refund policy (see dl-006): the full total when `at` is before the rental's start, nothing once the
+  rental has started.
+- Tests added first (red, then green): full refund before start, no refund after start, equipment freed
+  after cancellation (re-bookable, visible in `availability`), double cancellation rejected, unknown
+  booking rejected.
+
+## Verification
+
+`node --test`: 31/31 passing (26 pre-existing + 5 new).
diff --git a/src/index.test.ts b/src/index.test.ts
index d35100dff415762c8a3b91040a7522bd7b7e0941..7823556aefdb0cc399a936b53af92aea5e66665a 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -242,3 +242,51 @@ test('an hourly booking blocks an overlapping hourly availability slot', () => {
 
   assert.deepEqual(available, []);
 });
+
+test('cancelling before a rental starts refunds its full total', () => {
+  const service = createRentalService();
+  service.addEquipment(board());
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-01T00:00:00Z', end: '2024-06-02T00:00:00Z' });
+
+  const result = service.cancel(booking.id, '2024-05-30T00:00:00Z');
+
+  assert.deepEqual(result, { bookingId: booking.id, refund: 2500 });
+});
+
+test('cancelling after a rental has started refunds nothing', () => {
+  const service = createRentalService();
+  service.addEquipment(board());
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-01T00:00:00Z', end: '2024-06-02T00:00:00Z' });
+
+  const result = service.cancel(booking.id, '2024-06-01T12:00:00Z');
+
+  assert.deepEqual(result, { bookingId: booking.id, refund: 0 });
+});
+
+test('a cancelled booking no longer holds its equipment', () => {
+  const service = createRentalService();
+  service.addEquipment(board());
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-01T00:00:00Z', end: '2024-06-02T00:00:00Z' });
+
+  service.cancel(booking.id, '2024-05-30T00:00:00Z');
+
+  const available = service.availability({ start: '2024-06-01T00:00:00Z', end: '2024-06-02T00:00:00Z' });
+  assert.deepEqual(available, ['board-1']);
+  const rebooked = service.book({ itemId: 'board-1', start: '2024-06-01T00:00:00Z', end: '2024-06-02T00:00:00Z' });
+  assert.equal(rebooked.itemId, 'board-1');
+});
+
+test('rejects cancelling a booking twice', () => {
+  const service = createRentalService();
+  service.addEquipment(board());
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-01T00:00:00Z', end: '2024-06-02T00:00:00Z' });
+  service.cancel(booking.id, '2024-05-30T00:00:00Z');
+
+  assert.throws(() => service.cancel(booking.id, '2024-05-30T00:00:00Z'));
+});
+
+test('rejects cancelling an unknown booking', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.cancel('missing', '2024-05-30T00:00:00Z'));
+});
