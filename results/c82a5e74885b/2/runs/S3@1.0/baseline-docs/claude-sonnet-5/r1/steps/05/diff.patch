diff --git a/test/rentalService.test.ts b/test/rentalService.test.ts
index 4a0cb1764c60381be6c9a1caf2e0600039ae5e73..a69c86029257d8db3aabca6157dfb22acd66b8eb 100644
--- a/test/rentalService.test.ts
+++ b/test/rentalService.test.ts
@@ -239,3 +239,63 @@ test('availability throws when the period is empty or inverted', () => {
 
   assert.throws(() => service.availability({ start: '2024-06-02', end: '2024-06-01' }));
 });
+
+test('cancel refunds the full total when cancelled before the rental starts', () => {
+  const service = serviceWithBoard(1000);
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-10', end: '2024-06-13' });
+
+  const cancellation = service.cancel(booking.id, '2024-06-05T00:00:00Z');
+
+  assert.deepEqual(cancellation, { bookingId: booking.id, refund: 2700 });
+});
+
+test('cancel refunds nothing once the rental has started', () => {
+  const service = serviceWithBoard(1000);
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-10', end: '2024-06-13' });
+
+  const cancellation = service.cancel(booking.id, '2024-06-11T00:00:00Z');
+
+  assert.deepEqual(cancellation, { bookingId: booking.id, refund: 0 });
+});
+
+test('cancel refunds nothing when cancelled exactly as the rental starts', () => {
+  const service = serviceWithBoard(1000);
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-10', end: '2024-06-13' });
+
+  const cancellation = service.cancel(booking.id, '2024-06-10T00:00:00Z');
+
+  assert.equal(cancellation.refund, 0);
+});
+
+test('a cancelled booking no longer holds its equipment', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-10', end: '2024-06-13' });
+
+  service.cancel(booking.id, '2024-06-05');
+
+  assert.deepEqual(service.availability({ start: '2024-06-10', end: '2024-06-13' }), ['board-1']);
+});
+
+test('the equipment of a cancelled booking can be rebooked for the same period', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-10', end: '2024-06-13' });
+  service.cancel(booking.id, '2024-06-05');
+
+  const rebooked = service.book({ itemId: 'board-1', start: '2024-06-10', end: '2024-06-13' });
+
+  assert.equal(rebooked.itemId, 'board-1');
+});
+
+test('cancel throws for an unknown booking', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() => service.cancel('missing', '2024-06-05'));
+});
+
+test('cancel throws when the booking was already cancelled', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-10', end: '2024-06-13' });
+  service.cancel(booking.id, '2024-06-05');
+
+  assert.throws(() => service.cancel(booking.id, '2024-06-06'));
+});
