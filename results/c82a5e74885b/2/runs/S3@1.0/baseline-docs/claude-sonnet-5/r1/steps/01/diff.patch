@@ -0,0 +1,125 @@
+/** One day in milliseconds, the only unit a rental period is measured in. */
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+const DATE_TIME_AT_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00:00(\.000)?Z$/;
+
+export type EquipmentKind = 'board' | 'sail';
+
+/** A piece of equipment available for rent. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Cost of one day of rental, in integer euro cents. */
+  dailyPrice: number;
+}
+
+/** A request to quote or book an item for a period. */
+export interface RentalRequest {
+  itemId: string;
+  /** Start of the period, as a UTC midnight ISO-8601 string. */
+  start: string;
+  /** End of the period (the day after its last day), as a UTC midnight ISO-8601 string. */
+  end: string;
+}
+
+/** The cost of renting an item for a period, without booking it. */
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  /** Total cost, in integer euro cents. */
+  total: number;
+}
+
+/** A confirmed rental of an item for a period. */
+export interface Booking {
+  id: string;
+  itemId: string;
+  start: string;
+  end: string;
+  /** Total cost, in integer euro cents. */
+  total: number;
+}
+
+/** The booking desk's rental module: equipment, quotes and bookings, kept in memory. */
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+/** A booking as kept internally, with its period also parsed to milliseconds for overlap checks. */
+interface BookingRecord extends Booking {
+  startMs: number;
+  endMs: number;
+}
+
+/** Creates a rental service with its own in-memory equipment and booking records. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: BookingRecord[] = [];
+  let nextBookingId = 1;
+
+  function getEquipment(itemId: string): Equipment {
+    const item = equipment.get(itemId);
+    if (!item) {
+      throw new Error(`Unknown item: "${itemId}"`);
+    }
+    return item;
+  }
+
+  function parseMidnightUtc(value: string): number {
+    if (!DATE_ONLY.test(value) && !DATE_TIME_AT_MIDNIGHT.test(value)) {
+      throw new Error(`Invalid period: "${value}" must be a UTC midnight ISO-8601 date`);
+    }
+    return Date.parse(value);
+  }
+
+  function parsePeriod(request: RentalRequest): { startMs: number; endMs: number; days: number } {
+    const startMs = parseMidnightUtc(request.start);
+    const endMs = parseMidnightUtc(request.end);
+    if (endMs <= startMs) {
+      throw new Error(`Invalid period: "${request.start}" to "${request.end}" is empty or inverted`);
+    }
+    return { startMs, endMs, days: (endMs - startMs) / MS_PER_DAY };
+  }
+
+  function overlaps(startMs: number, endMs: number, existing: BookingRecord): boolean {
+    return startMs < existing.endMs && endMs > existing.startMs;
+  }
+
+  return {
+    addEquipment(item) {
+      equipment.set(item.id, item);
+    },
+
+    quote(request) {
+      const item = getEquipment(request.itemId);
+      const { days } = parsePeriod(request);
+      return { itemId: request.itemId, start: request.start, end: request.end, total: days * item.dailyPrice };
+    },
+
+    book(request) {
+      const item = getEquipment(request.itemId);
+      const { startMs, endMs, days } = parsePeriod(request);
+
+      const clash = bookings.some((b) => b.itemId === item.id && overlaps(startMs, endMs, b));
+      if (clash) {
+        throw new Error(`"${item.id}" is already booked for part of that period`);
+      }
+
+      const booking: BookingRecord = {
+        id: `booking-${nextBookingId++}`,
+        itemId: request.itemId,
+        start: request.start,
+        end: request.end,
+        total: days * item.dailyPrice,
+        startMs,
+        endMs,
+      };
+      bookings.push(booking);
+      return { id: booking.id, itemId: booking.itemId, start: booking.start, end: booking.end, total: booking.total };
+    },
+  };
+}
diff --git a/test/rentalService.test.ts b/test/rentalService.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4a9f2bc2084fba2194225de4af0f6d85d35e8221
--- /dev/null
+++ b/test/rentalService.test.ts
@@ -0,0 +1,109 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.js';
+
+function serviceWithBoard(dailyPrice = 1500) {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice });
+  return service;
+}
+
+test('quote computes the total for a whole number of days', () => {
+  const service = serviceWithBoard(1500);
+
+  const quote = service.quote({ itemId: 'board-1', start: '2024-06-01', end: '2024-06-04' });
+
+  assert.deepEqual(quote, {
+    itemId: 'board-1',
+    start: '2024-06-01',
+    end: '2024-06-04',
+    total: 4500,
+  });
+});
+
+test('quote accepts full ISO-8601 midnight timestamps', () => {
+  const service = serviceWithBoard(1000);
+
+  const quote = service.quote({
+    itemId: 'board-1',
+    start: '2024-06-01T00:00:00Z',
+    end: '2024-06-02T00:00:00Z',
+  });
+
+  assert.equal(quote.total, 1000);
+});
+
+test('quote throws for an unknown item', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.quote({ itemId: 'missing', start: '2024-06-01', end: '2024-06-02' }));
+});
+
+test('quote throws when the period does not start and end at midnight UTC', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() =>
+    service.quote({ itemId: 'board-1', start: '2024-06-01T10:00:00Z', end: '2024-06-02' }),
+  );
+});
+
+test('quote throws when the period is empty or inverted', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2024-06-02', end: '2024-06-01' }));
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2024-06-01', end: '2024-06-01' }));
+});
+
+test('book returns a booking with an id and the quoted total', () => {
+  const service = serviceWithBoard(1500);
+
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-01', end: '2024-06-04' });
+
+  assert.equal(booking.itemId, 'board-1');
+  assert.equal(booking.start, '2024-06-01');
+  assert.equal(booking.end, '2024-06-04');
+  assert.equal(booking.total, 4500);
+  assert.equal(typeof booking.id, 'string');
+  assert.ok(booking.id.length > 0);
+});
+
+test('book throws for an unknown item', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.book({ itemId: 'missing', start: '2024-06-01', end: '2024-06-02' }));
+});
+
+test('book throws when the item is already booked for an overlapping period', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2024-06-01', end: '2024-06-05' });
+
+  assert.throws(() =>
+    service.book({ itemId: 'board-1', start: '2024-06-03', end: '2024-06-06' }),
+  );
+});
+
+test('book allows a second booking that starts the day the first one ends', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2024-06-01', end: '2024-06-05' });
+
+  const second = service.book({ itemId: 'board-1', start: '2024-06-05', end: '2024-06-08' });
+
+  assert.equal(second.itemId, 'board-1');
+});
+
+test('book detects overlap across different ISO-8601 spellings of the same instant', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2024-06-01T00:00:00Z', end: '2024-06-05T00:00:00Z' });
+
+  assert.throws(() => service.book({ itemId: 'board-1', start: '2024-06-03', end: '2024-06-06' }));
+});
+
+test('book allows the same period on two different items', () => {
+  const service = serviceWithBoard();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 800 });
+  service.book({ itemId: 'board-1', start: '2024-06-01', end: '2024-06-05' });
+
+  const sailBooking = service.book({ itemId: 'sail-1', start: '2024-06-01', end: '2024-06-05' });
+
+  assert.equal(sailBooking.itemId, 'sail-1');
+});
