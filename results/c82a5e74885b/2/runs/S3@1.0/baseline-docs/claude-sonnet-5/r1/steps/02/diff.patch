diff --git a/test/rentalService.test.ts b/test/rentalService.test.ts
index 4a9f2bc2084fba2194225de4af0f6d85d35e8221..24ac481e62a1a854b07021d87559712835ea85f6 100644
--- a/test/rentalService.test.ts
+++ b/test/rentalService.test.ts
@@ -107,3 +107,55 @@ test('book allows the same period on two different items', () => {
 
   assert.equal(sailBooking.itemId, 'sail-1');
 });
+
+test('availability returns the ids of every item free for the period, sorted', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 1500 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 800 });
+
+  const ids = service.availability({ start: '2024-06-01', end: '2024-06-04' });
+
+  assert.deepEqual(ids, ['board-1', 'board-2', 'sail-1']);
+});
+
+test('availability filters by kind when one is given', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 800 });
+
+  const ids = service.availability({ start: '2024-06-01', end: '2024-06-04', kind: 'sail' });
+
+  assert.deepEqual(ids, ['sail-1']);
+});
+
+test('availability excludes an item booked for part of the period', () => {
+  const service = serviceWithBoard();
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 1500 });
+  service.book({ itemId: 'board-1', start: '2024-06-02', end: '2024-06-03' });
+
+  const ids = service.availability({ start: '2024-06-01', end: '2024-06-04' });
+
+  assert.deepEqual(ids, ['board-2']);
+});
+
+test('availability includes an item whose booking ends the day the period starts', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2024-05-30', end: '2024-06-01' });
+
+  const ids = service.availability({ start: '2024-06-01', end: '2024-06-04' });
+
+  assert.deepEqual(ids, ['board-1']);
+});
+
+test('availability throws when the period does not start and end at midnight UTC', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() => service.availability({ start: '2024-06-01T10:00:00Z', end: '2024-06-02' }));
+});
+
+test('availability throws when the period is empty or inverted', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() => service.availability({ start: '2024-06-02', end: '2024-06-01' }));
+});
