diff --git a/test/index.test.ts b/test/index.test.ts
index c04abd3848b79db79ba95bce7765f8b013b4bfd9..850ac88b3001b7d07c2fd4867eca480552251eb1 100644
--- a/test/index.test.ts
+++ b/test/index.test.ts
@@ -115,3 +115,52 @@ test('tracks bookings independently per item', () => {
 
   assert.doesNotThrow(() => service.book({ itemId: 's1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' }));
 });
+
+test('availability lists all equipment free for the period, sorted', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b2'));
+  service.addEquipment(board('b1'));
+  service.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 800 });
+
+  const ids = service.availability({ start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z' });
+
+  assert.deepEqual(ids, ['b1', 'b2', 's1']);
+});
+
+test('availability filters by kind when given', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1'));
+  service.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 800 });
+
+  const ids = service.availability({ start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z', kind: 'sail' });
+
+  assert.deepEqual(ids, ['s1']);
+});
+
+test('availability excludes items booked for an overlapping period', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1'));
+  service.addEquipment(board('b2'));
+  service.book({ itemId: 'b1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+
+  const ids = service.availability({ start: '2026-07-03T00:00:00.000Z', end: '2026-07-06T00:00:00.000Z' });
+
+  assert.deepEqual(ids, ['b2']);
+});
+
+test('availability includes items whose booking ends exactly when the query starts', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1'));
+  service.book({ itemId: 'b1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+
+  const ids = service.availability({ start: '2026-07-05T00:00:00.000Z', end: '2026-07-06T00:00:00.000Z' });
+
+  assert.deepEqual(ids, ['b1']);
+});
+
+test('availability rejects an invalid period', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1'));
+
+  assert.throws(() => service.availability({ start: '2026-07-02T00:00:00.000Z', end: '2026-07-01T00:00:00.000Z' }));
+});
