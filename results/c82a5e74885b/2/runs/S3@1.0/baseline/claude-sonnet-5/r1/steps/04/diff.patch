diff --git a/test/index.test.ts b/test/index.test.ts
index 6ad530e4951937fec9d1bf2599751b1407a0ca8a..316a4867726164b0e959c4509417a80c0392b851 100644
--- a/test/index.test.ts
+++ b/test/index.test.ts
@@ -2,8 +2,8 @@ import { test } from 'node:test';
 import assert from 'node:assert/strict';
 import { createRentalService } from '../src/index.ts';
 
-function board(id: string, dailyPrice = 1500) {
-  return { id, kind: 'board' as const, dailyPrice };
+function board(id: string, dailyPrice = 1500, hourlyPrice?: number) {
+  return { id, kind: 'board' as const, dailyPrice, hourlyPrice };
 }
 
 test('quotes a single day at the daily price', () => {
@@ -182,3 +182,66 @@ test('availability rejects an invalid period', () => {
 
   assert.throws(() => service.availability({ start: '2026-07-02T00:00:00.000Z', end: '2026-07-01T00:00:00.000Z' }));
 });
+
+test('quotes an hourly rental at the hourly price per hour', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1', 1500, 200));
+
+  const quote = service.quote({ itemId: 'b1', start: '2026-07-01T10:00:00.000Z', end: '2026-07-01T13:00:00.000Z' });
+
+  assert.equal(quote.total, 600);
+});
+
+test('books an hourly rental at the hourly price per hour', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1', 1500, 200));
+
+  const booking = service.book({ itemId: 'b1', start: '2026-07-01T10:00:00.000Z', end: '2026-07-01T11:00:00.000Z' });
+
+  assert.equal(booking.total, 200);
+});
+
+test('a 24-hour rental is priced as a day, not 24 hours', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1', 1500, 200));
+
+  const quote = service.quote({ itemId: 'b1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z' });
+
+  assert.equal(quote.total, 1500);
+});
+
+test('rejects an hourly period that does not start and end on the hour', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1', 1500, 200));
+
+  assert.throws(() => service.quote({ itemId: 'b1', start: '2026-07-01T10:30:00.000Z', end: '2026-07-01T13:00:00.000Z' }));
+  assert.throws(() => service.quote({ itemId: 'b1', start: '2026-07-01T10:00:00.000Z', end: '2026-07-01T13:30:00.000Z' }));
+});
+
+test('rejects an item without an hourly price when renting by the hour', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1', 1500));
+
+  assert.throws(() => service.quote({ itemId: 'b1', start: '2026-07-01T10:00:00.000Z', end: '2026-07-01T13:00:00.000Z' }));
+  assert.throws(() => service.book({ itemId: 'b1', start: '2026-07-01T10:00:00.000Z', end: '2026-07-01T13:00:00.000Z' }));
+});
+
+test('availability accepts an hourly period', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1', 1500, 200));
+  service.addEquipment(board('b2', 1500, 200));
+  service.book({ itemId: 'b1', start: '2026-07-01T10:00:00.000Z', end: '2026-07-01T11:00:00.000Z' });
+
+  const ids = service.availability({ start: '2026-07-01T10:00:00.000Z', end: '2026-07-01T11:00:00.000Z' });
+
+  assert.deepEqual(ids, ['b2']);
+});
+
+test('does not allow double-booking an overlapping hourly period', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1', 1500, 200));
+  service.book({ itemId: 'b1', start: '2026-07-01T10:00:00.000Z', end: '2026-07-01T12:00:00.000Z' });
+
+  assert.throws(() => service.book({ itemId: 'b1', start: '2026-07-01T11:00:00.000Z', end: '2026-07-01T13:00:00.000Z' }));
+  assert.doesNotThrow(() => service.book({ itemId: 'b1', start: '2026-07-01T12:00:00.000Z', end: '2026-07-01T13:00:00.000Z' }));
+});
