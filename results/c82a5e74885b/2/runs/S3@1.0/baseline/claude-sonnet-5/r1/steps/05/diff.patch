diff --git a/test/index.test.ts b/test/index.test.ts
index 316a4867726164b0e959c4509417a80c0392b851..961c01db5cdb3f30748388c4374ba01cc721994b 100644
--- a/test/index.test.ts
+++ b/test/index.test.ts
@@ -245,3 +245,73 @@ test('does not allow double-booking an overlapping hourly period', () => {
   assert.throws(() => service.book({ itemId: 'b1', start: '2026-07-01T11:00:00.000Z', end: '2026-07-01T13:00:00.000Z' }));
   assert.doesNotThrow(() => service.book({ itemId: 'b1', start: '2026-07-01T12:00:00.000Z', end: '2026-07-01T13:00:00.000Z' }));
 });
+
+test('cancelling before the rental starts refunds the full total', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1', 1000));
+  const booking = service.book({ itemId: 'b1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+
+  const cancellation = service.cancel(booking.id, '2026-06-30T00:00:00.000Z');
+
+  assert.deepEqual(cancellation, { bookingId: booking.id, refund: 2000 });
+});
+
+test('cancelling exactly at the start refunds the full total', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1', 1000));
+  const booking = service.book({ itemId: 'b1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+
+  const cancellation = service.cancel(booking.id, '2026-07-01T00:00:00.000Z');
+
+  assert.equal(cancellation.refund, 2000);
+});
+
+test('cancelling after the rental ends refunds nothing', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1', 1000));
+  const booking = service.book({ itemId: 'b1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+
+  const cancellation = service.cancel(booking.id, '2026-07-03T00:00:00.000Z');
+
+  assert.equal(cancellation.refund, 0);
+});
+
+test('cancelling partway through the rental refunds the unused portion', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1', 1000));
+  const booking = service.book({ itemId: 'b1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+
+  const cancellation = service.cancel(booking.id, '2026-07-02T00:00:00.000Z');
+
+  assert.equal(cancellation.refund, 1000);
+});
+
+test('a cancelled booking no longer holds its equipment', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1'));
+  const booking = service.book({ itemId: 'b1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+
+  service.cancel(booking.id, '2026-06-30T00:00:00.000Z');
+
+  assert.doesNotThrow(() => service.book({ itemId: 'b1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' }));
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' }),
+    [],
+  );
+});
+
+test('a booking can only be cancelled once', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1'));
+  const booking = service.book({ itemId: 'b1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z' });
+
+  service.cancel(booking.id, '2026-06-30T00:00:00.000Z');
+
+  assert.throws(() => service.cancel(booking.id, '2026-06-30T00:00:00.000Z'));
+});
+
+test('cancel throws for an unknown booking', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.cancel('nope', '2026-06-30T00:00:00.000Z'));
+});
