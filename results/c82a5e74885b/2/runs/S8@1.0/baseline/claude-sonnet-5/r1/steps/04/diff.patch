@@ -0,0 +1,67 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('imports every valid line, defaulting priority to normal and splitting tags by space', () => {
+    const list = createTodoList();
+    const result = importTasks(
+      list,
+      'Renew the insurance;high;admin money\nBuy milk;;\nWalk the dog',
+    );
+    assert.equal(result.imported, 2);
+    assert.deepEqual(result.rejected, [{ line: 3, reason: 'expected title;priority;tags' }]);
+    const tasks = list.list();
+    assert.deepEqual(
+      tasks.map((task) => [task.title, task.priority, task.tags]),
+      [
+        ['Renew the insurance', 'high', ['admin', 'money']],
+        ['Buy milk', 'normal', []],
+      ],
+    );
+  });
+
+  it('skips blank lines without affecting line numbers', () => {
+    const list = createTodoList();
+    const result = importTasks(list, '\n   \nBuy milk;;\n\nWalk the dog;;pets');
+    assert.equal(result.imported, 2);
+    assert.deepEqual(result.rejected, []);
+    assert.deepEqual(
+      list.list().map((task) => task.title),
+      ['Buy milk', 'Walk the dog'],
+    );
+  });
+
+  it('rejects a line with the wrong number of fields', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;high');
+    assert.equal(result.imported, 0);
+    assert.deepEqual(result.rejected, [{ line: 1, reason: 'expected title;priority;tags' }]);
+  });
+
+  it('rejects a line with an invalid title or priority, reporting why', () => {
+    const list = createTodoList();
+    const result = importTasks(list, ';;\nBuy milk;urgent;');
+    assert.equal(result.imported, 0);
+    assert.equal(result.rejected.length, 2);
+    assert.equal(result.rejected[0]?.line, 1);
+    assert.equal(result.rejected[0]?.reason, 'title cannot be empty');
+    assert.equal(result.rejected[1]?.line, 2);
+    assert.equal(result.rejected[1]?.reason, 'priority must be one of low, normal, high, not "urgent"');
+  });
+
+  it('rejects a line whose title duplicates one already in the list', () => {
+    const list = createTodoList();
+    list.add({ title: 'Buy milk' });
+    const result = importTasks(list, 'Buy milk;;');
+    assert.equal(result.imported, 0);
+    assert.equal(result.rejected[0]?.reason, 'there is already a task "Buy milk"');
+  });
+
+  it('imports nothing from empty text', () => {
+    const list = createTodoList();
+    const result = importTasks(list, '');
+    assert.deepEqual(result, { imported: 0, rejected: [] });
+  });
+});
