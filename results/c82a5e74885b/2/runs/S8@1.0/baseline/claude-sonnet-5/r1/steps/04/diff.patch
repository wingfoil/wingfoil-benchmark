+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of an import that could not be added, and why. */
+export interface ImportRejection {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of a bulk import: how many tasks were added, and every line that was not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
+/**
+ * Adds every valid line of `text` to `list`, one task per line, as `title;priority;tags`: the
+ * priority may be left empty for a normal one, and the tags are separated by spaces. Blank lines are
+ * skipped.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import, one task per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  const rejected: ImportRejection[] = [];
+  let imported = 0;
+  text.split('\n').forEach((rawLine, index) => {
+    const line = rawLine.trim();
+    if (line === '') return;
+    const parts = line.split(';');
+    if (parts.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'expected title;priority;tags' });
+      return;
+    }
+    const [title, rawPriority, rawTags] = parts;
+    const priority = rawPriority.trim() === '' ? undefined : (rawPriority.trim() as Priority);
+    const tags = rawTags.trim() === '' ? [] : rawTags.trim().split(/\s+/);
+    const added = list.add({ title, priority, tags });
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
