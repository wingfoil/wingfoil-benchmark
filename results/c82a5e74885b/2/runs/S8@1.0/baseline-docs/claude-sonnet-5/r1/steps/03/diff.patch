diff --git a/src/domain/validation.ts b/src/domain/validation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ee9b774f72cd990e5583c2d7f13f185072287398
--- /dev/null
+++ b/src/domain/validation.ts
@@ -0,0 +1,57 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { Priority } from './task.ts';
+
+const MAX_TITLE_LENGTH = 120;
+
+/**
+ * `title`, trimmed, or an error when it is empty, only spaces, or longer than 120 characters.
+ *
+ * @param title - the title as given by the caller
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed.length === 0) return err('invalid-input', 'title cannot be empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `title cannot be longer than ${MAX_TITLE_LENGTH} characters`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * `priority`, or an error when it is given but is not `low`, `normal` or `high`.
+ *
+ * @param priority - the priority as given by the caller, or undefined to keep the default
+ */
+export function validatePriority(priority: string | undefined): Result<Priority | undefined> {
+  if (priority === undefined) return ok(undefined);
+  if (!PRIORITIES.includes(priority as Priority)) {
+    return err('invalid-input', `priority must be one of ${PRIORITIES.join(', ')}`);
+  }
+  return ok(priority as Priority);
+}
+
+/**
+ * `tag`, or an error when it is empty or contains a space.
+ *
+ * @param tag - the tag as given by the caller
+ */
+export function validateTag(tag: string): Result<string> {
+  if (tag.length === 0) return err('invalid-input', 'tag cannot be empty');
+  if (tag.includes(' ')) return err('invalid-input', 'tag cannot contain a space');
+  return ok(tag);
+}
+
+/**
+ * `tags`, or the first error found among them.
+ *
+ * @param tags - the tags as given by the caller
+ */
+export function validateTags(tags: readonly string[]): Result<readonly string[]> {
+  for (const tag of tags) {
+    const validated = validateTag(tag);
+    if (!validated.ok) return validated;
+  }
+  return ok(tags);
+}
diff --git a/test/list.test.ts b/test/list.test.ts
index 5ec6bc47e7707e0ea1f6d930e599fb9ff3f28b1f..3508f6df1361942cdf4db6e61f215cf1a420e811 100644
--- a/test/list.test.ts
+++ b/test/list.test.ts
@@ -175,4 +175,73 @@ describe('task list', () => {
     assert.equal(failed.ok, false);
     assert.equal(valueOf(list.get(task.id)).updatedAt, task.updatedAt);
   });
+
+  describe('input validation', () => {
+    it('refuses to add a task with an empty or blank title', () => {
+      const list = createTodoList();
+      for (const title of ['', '   ']) {
+        const result = list.add({ title });
+        assert.equal(result.ok, false);
+        if (!result.ok) {
+          assert.equal(result.error.code, 'invalid-input');
+          assert.match(result.error.message, /title/i);
+        }
+      }
+      assert.equal(list.list().length, 0);
+    });
+
+    it('refuses to add a task with a title longer than 120 characters', () => {
+      const list = createTodoList();
+      const result = list.add({ title: 'a'.repeat(121) });
+      assert.equal(result.ok, false);
+      if (!result.ok) assert.equal(result.error.code, 'invalid-input');
+      assert.equal(list.list().length, 0);
+    });
+
+    it('accepts a title of exactly 120 characters', () => {
+      const list = createTodoList();
+      const title = 'a'.repeat(120);
+      assert.equal(valueOf(list.add({ title })).title, title);
+    });
+
+    it('refuses to add a task with an invalid priority', () => {
+      const list = createTodoList();
+      const result = list.add({ title: 'Buy milk', priority: 'urgent' as never });
+      assert.equal(result.ok, false);
+      if (!result.ok) assert.equal(result.error.code, 'invalid-input');
+      assert.equal(list.list().length, 0);
+    });
+
+    it('refuses to add a task with an empty tag or a tag containing a space', () => {
+      const list = createTodoList();
+      for (const tag of ['', 'two words']) {
+        const result = list.add({ title: 'Buy milk', tags: [tag] });
+        assert.equal(result.ok, false);
+        if (!result.ok) assert.equal(result.error.code, 'invalid-input');
+      }
+      assert.equal(list.list().length, 0);
+    });
+
+    it('refuses to rename a task to an empty, blank or too-long title, leaving it unchanged', () => {
+      const list = createTodoList();
+      const task = valueOf(list.add({ title: 'Buy milk' }));
+      for (const title of ['', '   ', 'a'.repeat(121)]) {
+        const result = list.rename(task.id, title);
+        assert.equal(result.ok, false);
+        if (!result.ok) assert.equal(result.error.code, 'invalid-input');
+      }
+      assert.equal(valueOf(list.get(task.id)).title, 'Buy milk');
+    });
+
+    it('refuses to add an empty tag or a tag containing a space to a task, leaving it unchanged', () => {
+      const list = createTodoList();
+      const task = valueOf(list.add({ title: 'Buy milk' }));
+      for (const tag of ['', 'two words']) {
+        const result = list.tag(task.id, tag);
+        assert.equal(result.ok, false);
+        if (!result.ok) assert.equal(result.error.code, 'invalid-input');
+      }
+      assert.deepEqual(valueOf(list.get(task.id)).tags, []);
+    });
+  });
 });
