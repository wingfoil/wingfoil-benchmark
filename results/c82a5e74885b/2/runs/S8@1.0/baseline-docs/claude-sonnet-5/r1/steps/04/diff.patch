+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of `importTasks` that could not be added to the list, and why. */
+export interface ImportRejection {
+  /** The line's position in the text, counting from 1. */
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of `importTasks`: how many tasks were added, and every line that was not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
+const FIELD_COUNT = 3;
+
+/**
+ * Adds to `list` every task described in `text`, one per line as `title;priority;tags`: priority may be
+ * left empty for `normal`, and tags are separated by spaces. Blank lines are skipped.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the tasks to import, one per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: ImportRejection[] = [];
+
+  text.split('\n').forEach((raw, index) => {
+    if (raw.trim().length === 0) return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length !== FIELD_COUNT) {
+      rejected.push({ line, reason: 'expected a line as "title;priority;tags"' });
+      return;
+    }
+    const [title, priority, tagsField] = fields;
+    const trimmedPriority = priority.trim();
+    const tags = tagsField.trim().length === 0 ? [] : tagsField.trim().split(/\s+/);
+    const result = list.add({
+      title,
+      priority: trimmedPriority.length === 0 ? undefined : (trimmedPriority as Priority),
+      tags,
+    });
+    if (result.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line, reason: result.error.message });
+    }
+  });
+
+  return { imported, rejected };
+}
