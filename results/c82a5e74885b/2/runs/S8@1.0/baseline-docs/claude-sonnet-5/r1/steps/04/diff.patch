@@ -0,0 +1,75 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('imports every valid line, parsing title, priority and tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;;');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+    assert.deepEqual(
+      list.list().map((task) => [task.title, task.priority, task.tags]),
+      [
+        ['Renew the insurance', 'high', ['admin', 'money']],
+        ['Buy milk', 'normal', []],
+      ],
+    );
+  });
+
+  it('skips blank lines without counting them', () => {
+    const list = createTodoList();
+    const result = importTasks(list, '\nBuy milk;;\n   \n');
+    assert.deepEqual(result, { imported: 1, rejected: [] });
+  });
+
+  it('collapses repeated spaces between tags', () => {
+    const list = createTodoList();
+    importTasks(list, 'Buy milk;;foo   bar');
+    assert.deepEqual(list.list()[0]?.tags, ['foo', 'bar']);
+  });
+
+  it('rejects a line that is not title;priority;tags, keeping the 1-based line number', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;\njust a title\nWalk the dog;;');
+    assert.equal(result.imported, 2);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0]?.line, 2);
+    assert.match(result.rejected[0]?.reason ?? '', /title;priority;tags/);
+  });
+
+  it('rejects a line with an invalid priority, reporting why', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;urgent;');
+    assert.equal(result.imported, 0);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0]?.line, 1);
+    assert.match(result.rejected[0].reason, /priority/i);
+  });
+
+  it('rejects a line with a blank title, reporting why', () => {
+    const list = createTodoList();
+    const result = importTasks(list, ';high;');
+    assert.equal(result.imported, 0);
+    assert.match(result.rejected[0]?.reason ?? '', /title/i);
+  });
+
+  it('rejects a line whose title duplicates one already on the list', () => {
+    const list = createTodoList();
+    list.add({ title: 'Buy milk' });
+    const result = importTasks(list, 'Buy milk;;');
+    assert.equal(result.imported, 0);
+    assert.match(result.rejected[0]?.reason ?? '', /already a task/i);
+  });
+
+  it('keeps the lines already imported when a later line is rejected', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;\nBuy milk;;\nWalk the dog;;');
+    assert.equal(result.imported, 2);
+    assert.deepEqual(
+      list.list().map((task) => task.title),
+      ['Buy milk', 'Walk the dog'],
+    );
+    assert.deepEqual(result.rejected, [{ line: 2, reason: 'there is already a task "Buy milk"' }]);
+  });
+});
