+import type { TaskList } from './domain/list.ts';
+import type { NewTask, Priority } from './domain/task.ts';
+
+/** A line from a bulk import that could not be added, and why. */
+export interface ImportRejection {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of a bulk import: how many tasks were added, and every line that was not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
+/**
+ * Adds every valid task described in `text` to `list`.
+ *
+ * `text` holds one task per line, as `title;priority;tags`: the priority may be left empty for a
+ * normal one, and the tags are separated by spaces, for example `Renew the insurance;high;admin
+ * money`. Blank lines are skipped. A line that is not shaped `title;priority;tags`, or whose title,
+ * priority or tags the list rejects, is not added; its 1-based line number and the reason are
+ * reported instead.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines describing the tasks to import
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: ImportRejection[] = [];
+
+  text.split(/\r\n|\n/).forEach((line, index) => {
+    if (line.trim() === '') return;
+
+    const task = parseLine(line);
+    if (task === undefined) {
+      rejected.push({ line: index + 1, reason: 'line must have the form "title;priority;tags"' });
+      return;
+    }
+
+    const result = list.add(task);
+    if (result.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line: index + 1, reason: result.error.message });
+    }
+  });
+
+  return { imported, rejected };
+}
+
+function parseLine(line: string): NewTask | undefined {
+  const firstSemicolon = line.indexOf(';');
+  const secondSemicolon = firstSemicolon === -1 ? -1 : line.indexOf(';', firstSemicolon + 1);
+  if (secondSemicolon === -1) return undefined;
+
+  const title = line.slice(0, firstSemicolon).trim();
+  const priority = line.slice(firstSemicolon + 1, secondSemicolon).trim();
+  const tags = line
+    .slice(secondSemicolon + 1)
+    .trim()
+    .split(/\s+/)
+    .filter((tag) => tag !== '');
+
+  return { title, ...(priority === '' ? {} : { priority: priority as Priority }), tags };
+}
