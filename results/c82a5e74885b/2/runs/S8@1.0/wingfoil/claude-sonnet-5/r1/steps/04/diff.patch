@@ -0,0 +1,78 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('imports a title-only line with a normal priority and no tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;');
+    assert.deepEqual(result, { imported: 1, rejected: [] });
+    const task = list.list()[0]!;
+    assert.equal(task.title, 'Buy milk');
+    assert.equal(task.priority, 'normal');
+    assert.deepEqual(task.tags, []);
+  });
+
+  it('imports a line with a priority and several space-separated tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin money');
+    assert.deepEqual(result, { imported: 1, rejected: [] });
+    const task = list.list()[0]!;
+    assert.equal(task.title, 'Renew the insurance');
+    assert.equal(task.priority, 'high');
+    assert.deepEqual(task.tags, ['admin', 'money']);
+  });
+
+  it('imports several lines and skips blank lines without counting them as rejected', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'One;;\n\nTwo;low;\n   \nThree;;home');
+    assert.deepEqual(result, { imported: 3, rejected: [] });
+    assert.deepEqual(
+      list.list().map((task) => task.title),
+      ['One', 'Three', 'Two'],
+    );
+  });
+
+  it('rejects a line with an invalid priority, reports its 1-based line number, and adds nothing for it', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;urgent;');
+    assert.equal(result.imported, 0);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0]!.line, 1);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a line with an empty title and keeps importing the rest of the lines', () => {
+    const list = createTodoList();
+    const result = importTasks(list, ';high;\nBuy milk;;');
+    assert.equal(result.imported, 1);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0]!.line, 1);
+    assert.equal(list.list()[0]!.title, 'Buy milk');
+  });
+
+  it('rejects a line that does not have the title;priority;tags shape', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk');
+    assert.equal(result.imported, 0);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0]!.line, 1);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a line that duplicates the title of an already-added task', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;\nBuy milk;high;');
+    assert.equal(result.imported, 1);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0]!.line, 2);
+    assert.equal(list.list().length, 1);
+  });
+
+  it('reports the correct line number for a rejection after blank lines', () => {
+    const list = createTodoList();
+    const result = importTasks(list, '\n\nBuy milk;urgent;');
+    assert.equal(result.rejected[0]!.line, 3);
+  });
+});
