+
+describe('task ids', () => {
+  it('gives each task its own id, kept through a rename', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    const b = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(a.id, b.id);
+    assert.equal(valueOf(list.rename('a', 'c')).id, a.id);
+    assert.equal(valueOf(list.get(a.id)).title, 'c');
+  });
+
+  it('does not reuse the id of a removed task', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    list.remove(a.id);
+    assert.equal(list.get(a.id).ok, false);
+    assert.notEqual(valueOf(list.add({ title: 'a' })).id, a.id);
+  });
+
+  it('accepts an id wherever a title is accepted', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'Buy milk' }));
+    assert.equal(valueOf(list.find(id)).title, 'Buy milk');
+    assert.equal(valueOf(list.complete(id)).status, 'done');
+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.deepEqual(valueOf(list.tag(id, 'shop')).tags, ['shop']);
+    assert.deepEqual(valueOf(list.untag(id, 'shop')).tags, []);
+    assert.equal(valueOf(list.rename(id, 'Buy oat milk')).title, 'Buy oat milk');
+    assert.equal(valueOf(list.remove(id)).title, 'Buy oat milk');
+    assert.equal(list.list().length, 0);
+  });
+
+  it('reports an unknown id as not found, and refuses a rename onto another title', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    list.add({ title: 'b' });
+    const missing = list.get('nope');
+    assert.equal(!missing.ok && missing.error.code, 'not-found');
+    const clash = list.rename(a.id, 'b');
+    assert.equal(!clash.ok && clash.error.code, 'duplicate');
+    assert.equal(list.rename(a.id, 'a').ok, true);
+  });
+});
