diff --git a/src/domain/validation.ts b/src/domain/validation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..50bbdb38bd447f516bede92fdfdd720b89f36219
--- /dev/null
+++ b/src/domain/validation.ts
@@ -0,0 +1,61 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { NewTask } from './task.ts';
+
+/** The longest title a task may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a task title: after trimming it must be neither empty nor longer than `MAX_TITLE_LENGTH`.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title is empty: give the task a title');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; at most ${MAX_TITLE_LENGTH} are allowed`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be one of `low`, `normal` and `high`.
+ *
+ * @param priority - the priority as given
+ */
+export function validatePriority(priority: string): Result<string> {
+  if (PRIORITIES.some((known) => known === priority)) return ok(priority);
+  return err('invalid-input', `the priority "${String(priority)}" is not one of ${PRIORITIES.join(', ')}`);
+}
+
+/**
+ * Checks a tag: it must not be empty and must not contain a space.
+ *
+ * @param tag - the tag as typed
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'the tag is empty: give a tag');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space; tags are a single word`);
+  return ok(tag);
+}
+
+/**
+ * Checks everything about a new task: its title, its priority when given, and each of its tags.
+ *
+ * @param input - the task as typed
+ */
+export function validateNewTask(input: NewTask): Result<NewTask> {
+  const title = validateTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined) {
+    const priority = validatePriority(input.priority);
+    if (!priority.ok) return priority;
+  }
+  for (const tag of input.tags ?? []) {
+    const checked = validateTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok(input);
+}
diff --git a/test/list.test.ts b/test/list.test.ts
index 196ea107d0e76032d6616dec68b69abc2668261d..b472ce67c3535ffa51fd6f8edd7083ca83a79c40 100644
--- a/test/list.test.ts
+++ b/test/list.test.ts
@@ -165,3 +165,45 @@ describe('task times', () => {
     assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
   });
 });
+
+describe('input validation', () => {
+  const invalid = (result: { ok: boolean; error?: { code: string; message: string } }) => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+    assert.notEqual(result.error?.message, '');
+  };
+
+  it('rejects an empty, blank or too long title when adding', () => {
+    const list = createTodoList();
+    invalid(list.add({ title: '' }));
+    invalid(list.add({ title: '   ' }));
+    invalid(list.add({ title: 'x'.repeat(121) }));
+    assert.equal(list.list().length, 0);
+    assert.equal(valueOf(list.add({ title: 'x'.repeat(120) })).id, 'task-1');
+  });
+
+  it('rejects an unknown priority or a bad tag when adding', () => {
+    const list = createTodoList();
+    invalid(list.add({ title: 'a', priority: 'urgent' as never }));
+    invalid(list.add({ title: 'a', tags: ['ok', ''] }));
+    invalid(list.add({ title: 'a', tags: ['two words'] }));
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a bad new title when renaming, leaving the task unchanged', () => {
+    const list = createTodoList();
+    list.add({ title: 'a' });
+    invalid(list.rename('a', '  '));
+    invalid(list.rename('a', 'y'.repeat(121)));
+    assert.equal(valueOf(list.find('a')).title, 'a');
+  });
+
+  it('rejects an empty tag or one with a space, leaving the task unchanged', () => {
+    const list = createTodoList();
+    list.add({ title: 'a' });
+    invalid(list.tag('a', ''));
+    invalid(list.tag('a', ' '));
+    invalid(list.tag('a', 'to do'));
+    assert.deepEqual(valueOf(list.find('a')).tags, []);
+  });
+});
