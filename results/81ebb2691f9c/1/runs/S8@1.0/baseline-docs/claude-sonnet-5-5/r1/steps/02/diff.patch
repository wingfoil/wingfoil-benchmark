+describe('task times', () => {
+  const clockAt = (...times: string[]) => {
+    let next = 0;
+    return () => times[Math.min(next++, times.length - 1)];
+  };
+
+  it('stamps a new task with the same createdAt and updatedAt', () => {
+    const list = createTodoList(clockAt('2026-03-01T08:00:00.000Z'));
+    const task = valueOf(list.add({ title: 'a' }));
+    assert.equal(task.createdAt, '2026-03-01T08:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    const times = ['10', '11', '12', '13', '14', '15'].map((m) => `2026-03-01T08:${m}:00.000Z`);
+    const list = createTodoList(clockAt(...times));
+    list.add({ title: 'a' });
+    const changes = [
+      valueOf(list.complete('a')),
+      valueOf(list.reopen('a')),
+      valueOf(list.rename('a', 'b')),
+      valueOf(list.tag('b', 'x')),
+      valueOf(list.untag('b', 'x')),
+    ];
+    assert.deepEqual(
+      changes.map((task) => task.updatedAt),
+      times.slice(1),
+    );
+    assert.ok(changes.every((task) => task.createdAt === times[0]));
+  });
+
+  it('leaves updatedAt alone when a change fails', () => {
+    const list = createTodoList(clockAt('2026-03-01T08:00:00.000Z', '2026-03-01T09:00:00.000Z'));
+    list.add({ title: 'a' });
+    assert.equal(list.reopen('a').ok, false);
+    assert.equal(valueOf(list.find('a')).updatedAt, '2026-03-01T08:00:00.000Z');
+  });
+
+  it('uses the system clock by default', () => {
+    const task = valueOf(createTodoList().add({ title: 'a' }));
+    assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
+  });
+});
