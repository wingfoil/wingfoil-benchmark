+describe('importTasks', () => {
+  it('adds every valid line, with priority and tags', () => {
+    const list = createTodoList();
+    const outcome = importTasks(list, 'Renew the insurance;high;admin money\n\nBuy milk;;\nCall mum');
+    assert.deepEqual(outcome, { imported: 3, rejected: [] });
+    const insurance = valueOf(list.find('Renew the insurance'));
+    assert.equal(insurance.priority, 'high');
+    assert.deepEqual(insurance.tags, ['admin', 'money']);
+    assert.equal(valueOf(list.find('Buy milk')).priority, 'normal');
+  });
+
+  it('rejects bad lines with their number and imports the rest', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const outcome = importTasks(list, 'Ok;low;a\r\n;high;x\n\nBad;urgent;x\nExisting;;\nA;low;b;extra\nOk;;');
+    assert.equal(outcome.imported, 1);
+    assert.deepEqual(
