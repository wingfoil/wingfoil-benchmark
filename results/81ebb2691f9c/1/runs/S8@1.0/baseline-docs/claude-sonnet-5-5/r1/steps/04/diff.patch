+
+## Bulk import
+
+`importTasks(list, text)` adds tasks from text with one task per line, as `title;priority;tags`, for
+example `Renew the insurance;high;admin money`. The priority may be left empty for a normal one, and tags
+are separated by spaces. Blank lines are skipped. It returns `{ imported, rejected }`: `imported` is how
+many tasks were added, and `rejected` lists each line that could not be added as `{ line, reason }`, with
+`line` counting from 1 (blank lines included). A line is rejected for the reasons `add` gives (invalid
+title, priority or tag, or a title already in the list, including one imported earlier in the same text),
+or when it has more than three fields. Rejected lines do not stop the others.
diff --git a/src/domain/import.ts b/src/domain/import.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a014572d01f67eea0bf712904b353c868423d051
--- /dev/null
+++ b/src/domain/import.ts
@@ -0,0 +1,52 @@
+import type { TaskList } from './list.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** A line of the imported text that could not be added, and why. */
+export interface RejectedLine {
+  /** The line's number in the text, counting from 1. */
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks were added, and the lines that were not. */
+export interface ImportSummary {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+const FIELD_COUNT = 3;
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may be
+ * empty for a normal one, the tags are separated by spaces, and blank lines are skipped. A line that cannot
+ * be added is reported and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportSummary {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((content, index) => {
+    if (content.trim() === '') return;
+    const reason = importLine(list, content);
+    if (reason === undefined) imported += 1;
+    else rejected.push({ line: index + 1, reason });
+  });
+  return { imported, rejected };
+}
+
+function importLine(list: TaskList, content: string): string | undefined {
+  const fields = content.split(';');
+  if (fields.length > FIELD_COUNT) {
+    return `the line has ${fields.length} fields; expected at most ${FIELD_COUNT}: title;priority;tags`;
+  }
+  const [title = '', priority = '', tags = ''] = fields.map((field) => field.trim());
+  const input: NewTask = {
+    title,
+    ...(priority === '' ? {} : { priority: priority as Priority }),
+    tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+  };
+  const added = list.add(input);
+  return added.ok ? undefined : added.error.message;
+}
