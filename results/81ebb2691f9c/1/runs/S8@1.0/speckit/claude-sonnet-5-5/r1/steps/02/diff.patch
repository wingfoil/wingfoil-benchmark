+
+describe('task timestamps', () => {
+  it('stamps creation, and every change sets updatedAt', () => {
+    let tick = 0;
+    const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)).toISOString());
+    const added = valueOf(list.add({ title: 'a' }));
+    assert.equal(added.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(added.updatedAt, added.createdAt);
+    const steps = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.rename('a', 'b'),
+      () => list.tag('b', 'x'),
+      () => list.untag('b', 'x'),
+    ];
+    for (const [i, step] of steps.entries()) {
+      const task = valueOf(step());
+      assert.equal(task.createdAt, added.createdAt);
+      assert.equal(task.updatedAt, new Date(Date.UTC(2026, 0, 1, 0, 0, i + 1)).toISOString());
+    }
+  });
+
+  it('uses the real clock by default', () => {
+    const task = valueOf(createTodoList().add({ title: 'a' }));
+    assert.ok(!Number.isNaN(Date.parse(task.createdAt)));
+  });
+});
