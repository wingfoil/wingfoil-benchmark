@@ -0,0 +1,44 @@
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of an import that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks it added, and the lines it could not add. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text`, one per line as `title;priority;tags`, to the list. The priority may be
+ * empty, the tags are separated by whitespace; blank lines are skipped. A line that cannot be added is
+ * reported and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\n|\r/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line: index + 1, reason: `expected "title;priority;tags" but found ${fields.length} fields` });
+      return;
+    }
+    const [title = '', priority = '', tags = ''] = fields.map((field) => field.trim());
+    const result = list.add({
+      title,
+      ...(priority === '' ? {} : { priority: priority as Priority }),
+      tags: tags === '' ? [] : tags.split(/\s+/),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  });
+  return { imported, rejected };
+}
