@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds valid lines, skips blank ones and reports the others by line number', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const report = importTasks(
+      list,
+      'Renew the insurance;high;admin money\r\n\nBuy milk\nWater plants;;home\n;low;x\nA;urgent;\nB;low;bad tag;extra\nExisting;;\nBuy milk;;',
+    );
+    assert.equal(report.imported, 3);
+    assert.deepEqual(report.rejected.map((r) => r.line), [5, 6, 7, 8, 9]);
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    assert.equal(list.openCount(), 4);
+  });
+});
