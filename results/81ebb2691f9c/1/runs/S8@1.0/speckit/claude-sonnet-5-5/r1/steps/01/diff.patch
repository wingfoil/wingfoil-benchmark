+
+describe('task ids', () => {
+  it('gives each task a distinct id that survives a rename', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    const b = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(a.id, b.id);
+    list.rename(a.id, 'c');
+    assert.equal(valueOf(list.get(a.id)).title, 'c');
+    assert.equal(valueOf(list.find('c')).id, a.id);
+  });
+
+  it('reports an unknown id, and never reuses a removed id', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    valueOf(list.remove(a.id));
+    const r = list.get(a.id);
+    assert.equal(r.ok, false);
+    if (!r.ok) assert.equal(r.error.code, 'not-found');
+    assert.notEqual(valueOf(list.add({ title: 'a' })).id, a.id);
+  });
+
+  it('accepts an id in every operation', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'a' }));
+    assert.equal(valueOf(list.tag(id, 'x')).tags[0], 'x');
+    assert.equal(valueOf(list.untag(id, 'x')).tags.length, 0);
+    assert.equal(valueOf(list.complete(id)).status, 'done');
+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.equal(valueOf(list.rename(id, 'a')).title, 'a');
+    assert.equal(valueOf(list.find(id)).title, 'a');
+    valueOf(list.remove(id));
+    assert.equal(list.openCount(), 0);
+  });
