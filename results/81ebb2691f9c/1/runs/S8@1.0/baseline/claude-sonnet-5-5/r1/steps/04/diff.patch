+
+describe('importTasks', () => {
+  it('imports valid lines and reports the others with their line numbers', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const report = importTasks(
+      list,
+      'Renew the insurance;high;admin money\n\nBuy milk;;\r\nWalk;urgent;x\nExisting;low;\n;high;\nBuy milk\nPlain',
+    );
+    assert.equal(report.imported, 3);
+    assert.deepEqual(report.rejected.map((r) => r.line), [4, 5, 6, 7]);
+    const task = valueOf(list.find('Renew the insurance'));
+    assert.equal(task.priority, 'high');
+    assert.deepEqual(task.tags, ['admin', 'money']);
+    assert.equal(valueOf(list.find('Buy milk')).priority, 'normal');
+  });
+});
