+++ b/src/domain/import.ts
@@ -0,0 +1,54 @@
+import { PRIORITIES } from './task.ts';
+import type { Priority } from './task.ts';
+import type { TaskList } from './list.ts';
+
+/** A line of the imported text that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks it added, and the lines it could not add. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line, as `title;priority;tags`. The priority may be
+ * empty for a normal one, the tags are separated by spaces, and both may be left out. Blank lines are
+ * skipped; a line that cannot be added is reported and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+
+  text.split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const reject = (reason: string): void => void rejected.push({ line, reason });
+
+    const fields = raw.split(';');
+    if (fields.length > 3) return reject(`expected "title;priority;tags" but found ${fields.length} fields`);
+    const [title = '', priorityText = '', tagText = ''] = fields;
+
+    let priority: Priority | undefined;
+    const wanted = priorityText.trim().toLowerCase();
+    if (wanted !== '') {
+      if (!PRIORITIES.includes(wanted as Priority)) {
+        return reject(`the priority "${priorityText.trim()}" is not one of ${PRIORITIES.join(', ')}`);
+      }
+      priority = wanted as Priority;
+    }
+
+    const tags = tagText.split(/\s+/).filter((tag) => tag !== '');
+    const added = list.add({ title, ...(priority === undefined ? {} : { priority }), tags });
+    if (added.ok) imported += 1;
+    else reject(added.error.message);
+  });
+
+  return { imported, rejected };
+}
