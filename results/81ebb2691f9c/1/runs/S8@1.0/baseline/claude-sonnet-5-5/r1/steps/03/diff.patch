diff --git a/src/domain/task.ts b/src/domain/task.ts
index 32639830c14212d36865fffcc19b3e246bee9183..e5766681f43aea5a9a950bf1a8a4d97ae49da62d 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -31,6 +31,66 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/** The longest title a task may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a title: after trimming it must be neither empty nor longer than `MAX_TITLE_LENGTH`.
+ *
+ * @param title - the title to check
+ */
+export function validateTitle(title: unknown): Result<string> {
+  if (typeof title !== 'string') return err('invalid-input', 'the title must be text');
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'the title is empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; the limit is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be one of `PRIORITIES`.
+ *
+ * @param priority - the priority to check
+ */
+export function validatePriority(priority: unknown): Result<Priority> {
+  if (PRIORITIES.includes(priority as Priority)) return ok(priority as Priority);
+  return err('invalid-input', `the priority "${String(priority)}" is not one of ${PRIORITIES.join(', ')}`);
+}
+
+/**
+ * Checks a tag: it must be text that is not empty and holds no space.
+ *
+ * @param tag - the tag to check
+ */
+export function validateTag(tag: unknown): Result<string> {
+  if (typeof tag !== 'string') return err('invalid-input', 'the tag must be text');
+  if (tag === '') return err('invalid-input', 'the tag is empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space`);
+  return ok(tag);
+}
+
+/**
+ * Checks everything a new task is made of.
+ *
+ * @param input - the task's title, priority and tags
+ */
+export function validateNewTask(input: NewTask): Result<NewTask> {
+  const title = validateTitle(input?.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined) {
+    const priority = validatePriority(input.priority);
+    if (!priority.ok) return priority;
+  }
+  if (input.tags !== undefined && !Array.isArray(input.tags)) return err('invalid-input', 'the tags must be a list');
+  for (const tag of input.tags ?? []) {
+    const checked = validateTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok(input);
+}
+
