index 85a52811dad6a9cda81f646c4bcadddab5a709be..690520ce244abe1f8d90cabb7125c403cc468024 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -125,6 +125,47 @@ export function compareTasks(a: Task, b: Task): number {
   return a.title < b.title ? -1 : a.title > b.title ? 1 : 0;
 }
 
+/** The longest title a task may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a title: once trimmed it must be neither empty nor longer than 120 characters.
+ *
+ * @param title - the title as typed
+ * @returns the trimmed title, or an `invalid-input` error
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title is empty: give the task a title');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long: the limit is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be `low`, `normal` or `high`.
+ *
+ * @param priority - the priority as given
+ * @returns the priority, or an `invalid-input` error
+ */
+export function validatePriority(priority: unknown): Result<Priority> {
+  if (PRIORITIES.includes(priority as Priority)) return ok(priority as Priority);
+  return err('invalid-input', `the priority "${String(priority)}" is not valid: use ${PRIORITIES.join(', ')}`);
+}
+
+/**
+ * Checks a tag: it must not be empty and must not contain a space.
+ *
+ * @param tag - the tag as given
+ * @returns the tag, or an `invalid-input` error
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'the tag is empty: give a tag a name');
+  if (tag.includes(' ')) return err('invalid-input', `the tag "${tag}" contains a space: tags are one word`);
+  return ok(tag);
+}
+
 function unique(tags: readonly string[]): string[] {
   return tags.filter((tag, index) => tags.indexOf(tag) === index);
 }
