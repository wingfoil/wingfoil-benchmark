+describe('input validation', () => {
+  const invalid = (result: { ok: boolean; error?: { code: string } }): void => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+  };
+
+  it('rejects empty, blank and too long titles on add and rename', () => {
+    const list = createTodoList();
+    invalid(list.add({ title: '' }));
+    invalid(list.add({ title: '   ' }));
+    invalid(list.add({ title: 'x'.repeat(121) }));
+    assert.equal(list.list().length, 0);
+    valueOf(list.add({ title: 'x'.repeat(120) }));
+    valueOf(list.add({ title: 'Keep' }));
+    invalid(list.rename('Keep', '  '));
+    invalid(list.rename('Keep', 'y'.repeat(121)));
+    assert.equal(valueOf(list.find('Keep')).title, 'Keep');
+  });
+
+  it('rejects an unknown priority and bad tags without changing anything', () => {
+    const list = createTodoList();
+    invalid(list.add({ title: 'A', priority: 'urgent' as never }));
+    invalid(list.add({ title: 'A', tags: ['ok', 'to do'] }));
+    invalid(list.add({ title: 'A', tags: [''] }));
+    const added = valueOf(list.add({ title: 'B' }));
+    assert.equal(added.id, 'task-1');
+    const before = valueOf(list.find('B'));
+    invalid(list.tag('B', ''));
+    invalid(list.tag('B', 'to do'));
+    assert.deepEqual(valueOf(list.find('B')), before);
+    assert.equal(list.list().length, 1);
+  });
+});
