@@ -0,0 +1,46 @@
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of the import text that could not be added, with its 1-based number and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks were added, and the lines that were not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds tasks to a list from text with one task per line, as `title;priority;tags`. The priority may be
+ * empty (a normal task) and the tags are separated by spaces. Blank lines are skipped; a line that
+ * cannot be added is reported and does not stop the others.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import
+ * @returns how many tasks were added, and each rejected line with its number (from 1) and reason
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r?\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `the line has ${fields.length} fields: use title;priority;tags` });
+      return;
+    }
+    const [title = '', priority = '', tags = ''] = fields.map((field) => field.trim());
+    const added = list.add({
+      title,
+      ...(priority === '' ? {} : { priority: priority as Priority }),
+      tags: tags === '' ? [] : tags.split(/\s+/),
+    });
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
