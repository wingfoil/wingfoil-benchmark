@@ -0,0 +1,43 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('reads title, priority and tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;;shopping\nCall mum');
+    assert.deepEqual(result, { imported: 3, rejected: [] });
+    const [insurance, milk, mum] = ['Renew the insurance', 'Buy milk', 'Call mum'].map((t) => {
+      const found = list.find(t);
+      return found.ok ? found.value : assert.fail(t);
+    });
+    assert.equal(insurance?.priority, 'high');
+    assert.deepEqual(insurance?.tags, ['admin', 'money']);
+    assert.equal(milk?.priority, 'normal');
+    assert.deepEqual(milk?.tags, ['shopping']);
+    assert.deepEqual(mum?.tags, []);
+  });
+
+  it('skips blank lines, accepts CRLF and counts lines from 1 including blanks', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'A\r\n\r\n  \r\nB;urgent');
+    assert.equal(result.imported, 1);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0]?.line, 4);
+  });
+
+  it('rejects bad lines and keeps importing the rest', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const result = importTasks(list, 'Good\n;high\nExisting\nGood\nToo;high;a;b\nTag;low;x');
+    assert.equal(result.imported, 2);
+    assert.deepEqual(result.rejected.map((r) => r.line), [2, 3, 4, 5]);
+    assert.ok(result.rejected.every((r) => r.reason.length > 0));
+    assert.equal(list.list().length, 3);
+  });
+
+  it('returns nothing for empty text', () => {
+    assert.deepEqual(importTasks(createTodoList(), ''), { imported: 0, rejected: [] });
+  });
+});
