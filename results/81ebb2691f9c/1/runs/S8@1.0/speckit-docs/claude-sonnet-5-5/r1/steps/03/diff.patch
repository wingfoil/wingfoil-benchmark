+/** The longest title a task may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a title: it must not be empty or only spaces, nor longer than 120 characters once trimmed.
+ *
+ * @param title - the title to check
+ * @returns the trimmed title, or an `invalid-input` error
+ */
+export function validateTitle(title: string): Result<string> {
+  if (typeof title !== 'string') return err('invalid-input', 'the title must be text');
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'the title is empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; at most ${MAX_TITLE_LENGTH} are allowed`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be `low`, `normal` or `high`.
+ *
+ * @param priority - the priority to check
+ * @returns the priority, or an `invalid-input` error
+ */
+export function validatePriority(priority: unknown): Result<Priority> {
+  if (PRIORITIES.includes(priority as Priority)) return ok(priority as Priority);
+  return err('invalid-input', `the priority ${JSON.stringify(priority)} is not one of: ${PRIORITIES.join(', ')}`);
+}
+
+/**
+ * Checks a tag: it must not be empty nor contain a space.
+ *
+ * @param tag - the tag to check
+ * @returns the tag, or an `invalid-input` error
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string') return err('invalid-input', 'the tag must be text');
+  if (tag === '') return err('invalid-input', 'the tag is empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space`);
+  return ok(tag);
+}
+
 /**
  * A new open task. Its priority is `normal` unless given; its tags keep the order given, each once.
+ * Fails with `invalid-input` when the title, the priority or a tag is not valid.
  *
  * @param input - the task's title, priority and tags
  * @param id - the task's identifier, unique in its list
  * @param at - the time of creation, an ISO-8601 date-time
  */
-export function createTask(input: NewTask, id: string, at: string): Task {
