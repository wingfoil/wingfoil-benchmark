@@ -0,0 +1,63 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { TaskList } from './list.ts';
+import type { NewTask, Priority } from './task.ts';
+import { validatePriority } from './task.ts';
+
+/** A line of an import that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Reads one `title;priority;tags` line. The priority and the tags may be left out; the tags are
+ * separated by spaces.
+ *
+ * @param line - a non-blank line of an import
+ * @returns the task the line describes, or an `invalid-input` error
+ */
+export function parseTaskLine(line: string): Result<NewTask> {
+  const fields = line.split(';');
+  if (fields.length > 3) {
+    return err('invalid-input', `expected at most 3 fields (title;priority;tags), found ${fields.length}`);
+  }
+  const [title = '', rawPriority = '', rawTags = ''] = fields;
+  const priorityText = rawPriority.trim().toLowerCase();
+  let priority: Priority = 'normal';
+  if (priorityText !== '') {
+    const checked = validatePriority(priorityText);
+    if (!checked.ok) return checked;
+    priority = checked.value;
+  }
+  const tags = rawTags.split(/\s+/).filter((tag) => tag !== '');
+  return ok({ title, priority, tags });
+}
+
+/**
+ * Adds the tasks described in `text`, one per line as `title;priority;tags`, to `list`. Blank lines
+ * are skipped; a line that is not valid, or whose title is already taken, is reported and the rest
+ * are still added.
+ *
+ * @param list - the task list to add to
+ * @param text - the lines to import
+ * @returns how many tasks were added, and the rejected lines with their numbers counting from 1
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((content, index) => {
+    if (content.trim() === '') return;
+    const parsed = parseTaskLine(content);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
