index 0000000000000000000000000000000000000000..b5dd2de6757df7b90411dc88d5697ac63c8e5cb5
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds valid lines, skips blank ones and reports the others by line number', () => {
+    const list = createTodoList();
+    const report = importTasks(
+      list,
+      'Renew the insurance;high;admin money\n\nBuy milk\nWalk;urgent;\nBuy milk;low\n;;\r\nPaint;low;a;b',
+    );
+    assert.equal(report.imported, 2);
+    assert.deepEqual(
+      report.rejected.map((r) => r.line),
+      [4, 5, 6, 7],
+    );
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+  });
+});
