+describe('task timestamps', () => {
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    let tick = 0;
+    const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)).toISOString());
+    const added = valueOf(list.add({ title: 'a' }));
+    assert.equal(added.createdAt, added.updatedAt);
+    const steps = [
+      valueOf(list.complete('a')),
+      valueOf(list.reopen('a')),
+      valueOf(list.tag('a', 'x')),
+      valueOf(list.untag('a', 'x')),
+      valueOf(list.rename('a', 'b')),
+    ];
+    let previous = added.updatedAt;
+    for (const task of steps) {
+      assert.equal(task.createdAt, added.createdAt);
+      assert.ok(task.updatedAt > previous);
+      previous = task.updatedAt;
+    }
+  });
