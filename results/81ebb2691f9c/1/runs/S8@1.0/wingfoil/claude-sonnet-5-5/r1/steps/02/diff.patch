+describe('task timestamps', () => {
+  function clockList() {
+    let tick = 0;
+    return createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)).toISOString());
+  }
+
+  it('sets createdAt and updatedAt to the same time when a task is added', () => {
+    const task = valueOf(clockList().add({ title: 'a' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    const list = clockList();
+    const { id, createdAt } = valueOf(list.add({ title: 'a' }));
+    const stamps = [
+      valueOf(list.complete(id)),
+      valueOf(list.reopen(id)),
+      valueOf(list.rename(id, 'b')),
+      valueOf(list.tag(id, 'x')),
+      valueOf(list.untag(id, 'x')),
+    ].map((task) => task.updatedAt);
+    assert.deepEqual(stamps, [1, 2, 3, 4, 5].map((s) => `2026-01-01T00:00:0${s}.000Z`));
+    assert.equal(valueOf(list.get(id)).createdAt, createdAt);
+    assert.equal(valueOf(list.get(id)).updatedAt, stamps[4]);
+  });
+
+  it('leaves updatedAt alone when a change fails', () => {
+    const list = clockList();
+    const { id, updatedAt } = valueOf(list.add({ title: 'a' }));
+    assert.equal(list.reopen(id).ok, false);
+    assert.equal(valueOf(list.get(id)).updatedAt, updatedAt);
+  });
+
+  it('uses the system clock by default', () => {
+    const task = valueOf(createTodoList().add({ title: 'a' }));
+    assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
+  });
+});
+
