+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.deepEqual(valueOf(list.tag(id, 'x')).tags, ['x']);
+    assert.deepEqual(valueOf(list.untag(id, 'x')).tags, []);
+    assert.equal(valueOf(list.find(id)).title, 'a');
+    list.add({ title: 'b' });
+    const clash = list.rename(id, 'b');
+    assert.equal(clash.ok, false);
+    valueOf(list.remove(id));
+    assert.equal(list.get(id).ok, false);
+    assert.equal(list.openCount(), 1);
+  });
+
