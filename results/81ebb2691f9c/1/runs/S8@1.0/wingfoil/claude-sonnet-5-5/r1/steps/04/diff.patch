+++ b/src/domain/import.ts
@@ -0,0 +1,52 @@
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+import { validatePriority } from './task.ts';
+
+/** A line of an import that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may be
+ * empty (or left out) for a normal one; tags are separated by spaces. Blank lines are skipped. A line that
+ * cannot be added is reported and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: 'a line has at most three fields: title;priority;tags' });
+      return;
+    }
+    const [title = '', priorityText = '', tagsText = ''] = fields;
+    let priority: Priority | undefined;
+    if (priorityText.trim() !== '') {
+      const checked = validatePriority(priorityText.trim());
+      if (!checked.ok) {
+        rejected.push({ line, reason: checked.error.message });
+        return;
+      }
+      priority = checked.value;
+    }
+    const tags = tagsText.split(/\s+/).filter((tag) => tag !== '');
+    const added = list.add({ title, ...(priority === undefined ? {} : { priority }), tags });
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
