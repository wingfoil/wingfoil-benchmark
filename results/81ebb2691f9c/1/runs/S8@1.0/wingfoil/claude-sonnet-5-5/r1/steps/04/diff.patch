@@ -0,0 +1,43 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds every valid line with its priority and tags', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;;\nWalk;low');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok);
+    assert.equal(milk.value.priority, 'normal');
+    assert.deepEqual(milk.value.tags, []);
+  });
+
+  it('skips blank lines but keeps counting them, and accepts CRLF', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'a;;\r\n\r\n   \r\nb;;x\r\n');
+    assert.equal(report.imported, 2);
+    assert.deepEqual(report.rejected, []);
+  });
+
+  it('rejects bad lines with their line number and reason, and still adds the others', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'ok;;\n;high;\nbad;urgent;\nfine;;a\nok;;\nx;high;t;extra');
+    assert.equal(report.imported, 2);
+    assert.deepEqual(
+      report.rejected.map((r) => r.line),
+      [2, 3, 5, 6],
+    );
+    for (const r of report.rejected) assert.ok(r.reason.length > 0);
+    assert.equal(list.list().length, 2);
+  });
+
+  it('returns nothing imported for empty text', () => {
+    assert.deepEqual(importTasks(createTodoList(), ''), { imported: 0, rejected: [] });
+  });
+});
