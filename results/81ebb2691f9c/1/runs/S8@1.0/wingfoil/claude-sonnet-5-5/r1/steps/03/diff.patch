+
+describe('input validation', () => {
+  const failure = (result: { ok: boolean; error?: { code: string } }) => {
+    assert.equal(result.ok, false);
+    return result.error;
+  };
+
+  it('rejects empty, blank and over-long titles when adding', () => {
+    const list = createTodoList();
+    for (const title of ['', '   ', 'x'.repeat(121)]) {
+      assert.equal(failure(list.add({ title }))?.code, 'invalid-input');
+    }
+    assert.equal(list.list().length, 0);
+  });
+
+  it('accepts a title of exactly 120 characters, ignoring surrounding spaces', () => {
+    assert.equal(createTodoList().add({ title: ` ${'x'.repeat(120)} ` }).ok, true);
+  });
+
+  it('rejects an unknown priority when adding', () => {
+    const list = createTodoList();
+    const bad = { title: 'a', priority: 'urgent' } as never;
+    assert.equal(failure(list.add(bad))?.code, 'invalid-input');
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects an empty tag or a tag with a space when adding', () => {
+    const list = createTodoList();
+    for (const tag of ['', 'two words']) {
+      assert.equal(failure(list.add({ title: 'a', tags: ['ok', tag] }))?.code, 'invalid-input');
+    }
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects an invalid new title when renaming, changing nothing', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'a' }));
+    for (const title of ['', '  ', 'x'.repeat(121)]) {
+      assert.equal(failure(list.rename('a', title))?.code, 'invalid-input');
+    }
+    assert.deepEqual(valueOf(list.get(before.id)), before);
+  });
+
+  it('rejects an invalid tag when tagging, changing nothing', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'a' }));
+    for (const tag of ['', ' ', 'a b']) {
+      assert.equal(failure(list.tag('a', tag))?.code, 'invalid-input');
+    }
+    assert.deepEqual(valueOf(list.get(before.id)), before);
+  });
+});
