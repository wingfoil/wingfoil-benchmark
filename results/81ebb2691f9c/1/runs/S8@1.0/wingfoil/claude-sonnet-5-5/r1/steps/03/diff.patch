 /** Every priority, from the least urgent to the most. */
 export const PRIORITIES: readonly Priority[] = ['low', 'normal', 'high'];
 
+/** The longest title a task may have, once surrounding spaces are removed. */
+export const MAX_TITLE_LENGTH = 120;
+
 /** Whether a task still has to be done. */
 export type Status = 'open' | 'done';
 
@@ -30,6 +33,63 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/**
+ * Checks a title: after trimming it must be neither empty nor longer than `MAX_TITLE_LENGTH`.
+ *
+ * @param title - the title to check
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title must not be empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title must have at most ${MAX_TITLE_LENGTH} characters`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be one of `PRIORITIES`.
+ *
+ * @param priority - the priority to check
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  const known = PRIORITIES.find((candidate) => candidate === priority);
+  if (known === undefined) {
+    return err('invalid-input', `the priority must be one of ${PRIORITIES.join(', ')}, not "${priority}"`);
+  }
+  return ok(known);
+}
+
+/**
+ * Checks a tag: it must be a non-empty string without whitespace.
+ *
+ * @param tag - the tag to check
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'a tag must not be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" must not contain a space`);
+  return ok(tag);
+}
+
+/**
+ * Checks everything a new task is given: its title, its priority when given, and each of its tags.
+ *
+ * @param input - the task to check
+ */
+export function validateNewTask(input: NewTask): Result<NewTask> {
+  const title = validateTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined) {
+    const priority = validatePriority(input.priority);
+    if (!priority.ok) return priority;
+  }
+  for (const tag of input.tags ?? []) {
+    const checked = validateTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok(input);
+}
+
