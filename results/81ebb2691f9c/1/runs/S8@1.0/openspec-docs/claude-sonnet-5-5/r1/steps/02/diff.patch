+    assert.equal(added.createdAt, added.updatedAt);
+    const changes = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.rename('a', 'b'),
+      () => list.tag('b', 'x'),
+      () => list.untag('b', 'x'),
+    ];
+    let previous = added.updatedAt;
+    for (const change of changes) {
+      const task = valueOf(change());
+      assert.equal(task.createdAt, added.createdAt);
+      assert.ok(task.updatedAt > previous);
+      previous = task.updatedAt;
+    }
+  });
