@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('imports valid lines, skips blanks and reports rejects by line number', () => {
+    const list = createTodoList();
+    const report = importTasks(
+      list,
+      'Renew the insurance;high;admin money\n\nBuy milk\nWalk;urgent;x\nBuy milk;;\n;low;\na;b;c;d',
+    );
+    assert.equal(report.imported, 2);
+    assert.deepEqual(report.rejected.map((r) => r.line), [4, 5, 6, 7]);
+    const task = list.find('Renew the insurance');
+    assert.ok(task.ok && task.value.priority === 'high' && task.value.tags.join() === 'admin,money');
+  });
+});
