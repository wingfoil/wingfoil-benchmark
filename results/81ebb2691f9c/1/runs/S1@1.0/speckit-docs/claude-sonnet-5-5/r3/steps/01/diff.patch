index 0000000000000000000000000000000000000000..e164d745feaba7cfd9b6477020127772cb052208
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,58 @@
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Splits a pointer into its unescaped reference tokens (RFC 6901 section 3 and 4). */
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new TypeError("A JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new SyntaxError(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new SyntaxError(`Invalid JSON Pointer "${pointer}": "~" must be followed by "0" or "1"`);
+      }
+      // "~1" first, so that "~01" decodes to "~1" and not "/".
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer `pointer` refers to (RFC 6901).
+ * Throws if the pointer is not valid or does not resolve to a value of the document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current: unknown = document;
+  for (const token of parsePointer(pointer)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token)) {
+        throw new Error(`Pointer "${pointer}" does not resolve: "${token}" is not a valid array index`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new Error(`Pointer "${pointer}" does not resolve: index ${token} is out of bounds`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(`Pointer "${pointer}" does not resolve: no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`Pointer "${pointer}" does not resolve: "${token}" is applied to a non-container value`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fc964f72ded61ef79e8f9c90a0fe4c06649546c5
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,59 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// The document of RFC 6901 section 5.
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("escape order and falsy values", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer(null, ""), null);
+  assert.equal(resolvePointer([false], "/0"), false);
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["foo", "/a~", "/a~2", "/~", "#/foo"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), p);
+  }
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer(doc, "/nope"));
+  assert.throws(() => resolvePointer(doc, "/foo/2"));
+  assert.throws(() => resolvePointer(doc, "/foo/-"));
+  assert.throws(() => resolvePointer(doc, "/foo/00"));
+  assert.throws(() => resolvePointer(doc, "/foo/+1"));
+  assert.throws(() => resolvePointer(doc, "/foo/1.0"));
+  assert.throws(() => resolvePointer(doc, "/foo/length"));
+  assert.throws(() => resolvePointer(doc, "/foo/0/x"));
+  assert.throws(() => resolvePointer(doc, "/__proto__"));
+  assert.throws(() => resolvePointer(doc, "/constructor"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+});
