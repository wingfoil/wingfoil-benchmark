diff --git a/test/diff.test.ts b/test/diff.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..654d8851097da28f1e7c54ade6f35779553b5d12
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,48 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const before = structuredClone(from);
+  const after = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, before);
+  assert.deepEqual(to, after);
+  return patch;
+};
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a small change yields a small patch", () => {
+  const big = { a: { b: { c: 1, d: [1, 2, 3] } }, e: "x" };
+  assert.deepEqual(roundTrip(big, { ...big, a: { b: { c: 2, d: [1, 2, 3] } } }), [
+    { op: "replace", path: "/a/b/c", value: 2 },
+  ]);
+  assert.deepEqual(roundTrip({ l: [1, 2, 3, 4] }, { l: [0, 1, 2, 3, 4] }), [{ op: "add", path: "/l/0", value: 0 }]);
+  assert.deepEqual(roundTrip({ l: [1, 2, 3, 4] }, { l: [1, 3, 4] }), [{ op: "remove", path: "/l/1" }]);
+});
+
+test("members, escaping and root replacement", () => {
+  roundTrip({ "a/b": 1, "m~n": 2, gone: 1 }, { "a/b": 3, "m~n": 2, new: null });
+  roundTrip({ a: 1 }, [1]);
+  roundTrip(1, { a: 1 });
+  roundTrip({ a: [] }, { a: {} });
+  roundTrip(JSON.parse('{"__proto__":1}'), JSON.parse('{"__proto__":2,"x":1}'));
+});
+
+test("randomised round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) % n);
+  const gen = (depth: number): unknown => {
+    const k = rnd(depth > 2 ? 3 : 5);
+    if (k === 0) return rnd(3);
+    if (k === 1) return ["x", "y", null][rnd(3)];
+    if (k === 2) return rnd(2) === 0;
+    if (k === 3) return Array.from({ length: rnd(6) }, () => gen(depth + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => [["a", "b", "c/d", "~"][rnd(4)], gen(depth + 1)]));
+  };
+  for (let i = 0; i < 3000; i++) roundTrip(gen(0), gen(0));
+});
