+import { deepEqual } from "./patch.ts";
+
+type Json = unknown;
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: Json };
+
+/** Above this many cells the quadratic array alignment is skipped in favour of a positional diff. */
+const MAX_ALIGN_CELLS = 1_000_000;
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Pairs of indexes (in `a`, in `b`) of a longest common subsequence of equal elements. */
+function alignment(a: Json[], b: Json[]): Array<[number, number]> {
+  const n = a.length;
+  const m = b.length;
+  if (n === 0 || m === 0) return [];
+  if (n * m > MAX_ALIGN_CELLS) {
+    const pairs: Array<[number, number]> = [];
+    for (let i = 0; i < Math.min(n, m); i++) if (deepEqual(a[i], b[i])) pairs.push([i, i]);
+    return pairs;
+  }
+  const width = m + 1;
+  const table = new Uint32Array((n + 1) * width);
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      table[i * width + j] = deepEqual(a[i], b[j])
+        ? table[(i + 1) * width + j + 1] + 1
+        : Math.max(table[(i + 1) * width + j], table[i * width + j + 1]);
+    }
+  }
+  const pairs: Array<[number, number]> = [];
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (deepEqual(a[i], b[j])) {
+      pairs.push([i++, j++]);
+    } else if (table[(i + 1) * width + j] >= table[i * width + j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
+
+function diffArrays(from: Json[], to: Json[], path: string, ops: Operation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && deepEqual(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && deepEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const a = from.slice(start, endFrom);
+  const b = to.slice(start, endTo);
+  const pairs = alignment(a, b);
+  pairs.push([a.length, b.length]);
+
+  // `index` is the position in the array as already patched; everything before it matches `to`.
+  let index = start;
+  let i = 0;
+  let j = 0;
+  for (const [pi, pj] of pairs) {
+    const removed = pi - i;
+    const added = pj - j;
+    const common = Math.min(removed, added);
+    for (let k = 0; k < common; k++) diffValues(a[i + k], b[j + k], `${path}/${index + k}`, ops);
+    for (let k = common; k < removed; k++) ops.push({ op: "remove", path: `${path}/${index + common}` });
+    for (let k = common; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${index + k}`, value: structuredClone(b[j + k]) });
+    }
+    index += added + (pi < a.length ? 1 : 0);
+    i = pi + 1;
+    j = pj + 1;
+  }
+}
+
+function diffValues(from: Json, to: Json, path: string, ops: Operation[]): void {
+  if (deepEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(from, key)) diffValues(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: structuredClone(to[key]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Returns an RFC 6902 JSON Patch that turns `from` into `to` when applied with `applyPatch`.
+ * The patch only describes what differs; equal documents give an empty patch. Neither input is mutated.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const ops: Operation[] = [];
+  diffValues(from, to, "", ops);
+  return ops;
+}
