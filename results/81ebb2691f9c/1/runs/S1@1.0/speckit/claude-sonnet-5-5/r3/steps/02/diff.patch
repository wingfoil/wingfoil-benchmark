@@ -0,0 +1,165 @@
+import { parsePointer } from "./pointer.ts";
+
+type Json = unknown;
+type Container = Json[] | Record<string, Json>;
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const OPS = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function deepEqual(a: Json, b: Json): boolean {
+  if (a === b) return true;
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => deepEqual(v, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((k) => Object.hasOwn(b, k) && deepEqual(a[k], b[k]));
+  }
+  return false;
+}
+
+function setMember(target: Record<string, Json>, key: string, value: Json): void {
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Walks to the container holding the last token of `tokens`; every intermediate step must exist. */
+function parentOf(root: Json, tokens: string[], pointer: string): Container {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`Path "${pointer}" does not exist`);
+      }
+      current = current[Number(token)];
+    } else if (isObject(current) && Object.hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path "${pointer}" does not exist`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new Error(`Path "${pointer}": parent is not an object or array`);
+  }
+  return current;
+}
+
+function getAt(root: Json, pointer: string): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return root;
+  const parent = parentOf(root, tokens, pointer);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(last) || Number(last) >= parent.length) {
+      throw new Error(`Path "${pointer}" does not exist`);
+    }
+    return parent[Number(last)];
+  }
+  if (!Object.hasOwn(parent, last)) throw new Error(`Path "${pointer}" does not exist`);
+  return parent[last];
+}
+
+function addAt(root: Json, pointer: string, value: Json): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens, pointer);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (last === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(last) && Number(last) <= parent.length) {
+      parent.splice(Number(last), 0, value);
+    } else {
+      throw new Error(`Path "${pointer}": invalid array index`);
+    }
+  } else {
+    setMember(parent, last, value);
+  }
+  return root;
+}
+
+/** Replaces the existing value at `pointer`; the caller has already checked that it exists. */
+function replaceAt(root: Json, pointer: string, value: Json): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens, pointer);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(last)] = value;
+  else setMember(parent, last, value);
+  return root;
+}
+
+function removeAt(root: Json, pointer: string): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) throw new Error("Cannot remove the whole document");
+  const parent = parentOf(root, tokens, pointer);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(last) || Number(last) >= parent.length) {
+      throw new Error(`Path "${pointer}" does not exist`);
+    }
+    parent.splice(Number(last), 1);
+  } else {
+    if (!Object.hasOwn(parent, last)) throw new Error(`Path "${pointer}" does not exist`);
+    delete parent[last];
+  }
+  return root;
+}
+
+function pointerString(op: Record<string, unknown>, member: "path" | "from", index: number): string {
+  const value = op[member];
+  if (typeof value !== "string") {
+    throw new Error(`Operation ${index}: "${member}" must be a string JSON Pointer`);
+  }
+  parsePointer(value);
+  return value;
+}
+
+/**
+ * Applies an RFC 6902 JSON Patch to `document` and returns the result as a new value.
+ * Neither `document` nor `patch` is mutated; throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new Error("JSON Patch must be an array of operations");
+  let result: Json = structuredClone(document);
+  patch.forEach((op: unknown, index: number) => {
+    if (!isObject(op)) throw new Error(`Operation ${index} must be an object`);
+    const name = op.op;
+    if (typeof name !== "string" || !OPS.has(name)) throw new Error(`Operation ${index}: unknown "op"`);
+    const path = pointerString(op, "path", index);
+    const from = name === "move" || name === "copy" ? pointerString(op, "from", index) : "";
+    if ((name === "add" || name === "replace" || name === "test") && !Object.hasOwn(op, "value")) {
+      throw new Error(`Operation ${index}: "value" is required for "${name}"`);
+    }
+    switch (name) {
+      case "add":
+        result = addAt(result, path, structuredClone(op.value));
+        break;
+      case "remove":
+        result = removeAt(result, path);
+        break;
+      case "replace":
+        getAt(result, path);
+        result = replaceAt(result, path, structuredClone(op.value));
+        break;
+      case "move": {
+        const value = getAt(result, from);
+        if (from === path) break;
+        if (path.startsWith(from + "/")) throw new Error(`Operation ${index}: cannot move a value into itself`);
+        result = addAt(removeAt(result, from), path, value);
+        break;
+      }
+      case "copy":
+        result = addAt(result, path, structuredClone(getAt(result, from)));
+        break;
+      case "test":
+        if (!deepEqual(getAt(result, path), op.value)) throw new Error(`Operation ${index}: test failed at "${path}"`);
+        break;
+    }
+  });
+  return result;
+}
