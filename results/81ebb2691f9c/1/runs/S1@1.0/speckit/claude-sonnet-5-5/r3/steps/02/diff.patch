@@ -0,0 +1,153 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) =>
+  assert.deepEqual(applyPatch(doc, patch as any), expected);
+const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch as any), Error);
+
+test("RFC 6902 Appendix A examples", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  ok({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  });
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", op2: 1 }, { op: "bogus", path: "/x" }]);
+  ok({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 });
+  bad({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 9 }]);
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] });
+});
+
+test("copy deep-copies", () => {
+  const out: any = applyPatch({ a: { b: [1] } }, [{ op: "copy", from: "/a", path: "/c" }]);
+  assert.deepEqual(out, { a: { b: [1] }, c: { b: [1] } });
+  out.c.b.push(2);
+  assert.deepEqual(out.a.b, [1]);
+});
+
+test("whole-document operations", () => {
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: null }], null);
+  ok(null, [{ op: "test", path: "", value: null }], null);
+  bad({ a: 1 }, [{ op: "remove", path: "" }]);
+  ok(5, [], 5);
+});
+
+test("does not mutate or alias inputs", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const value = { x: [1] };
+  const patch = [{ op: "add", path: "/d", value }, { op: "remove", path: "/a/0" }, { op: "replace", path: "/b/c", value: 2 }];
+  const snap = structuredClone({ doc, patch });
+  const out: any = applyPatch(doc, patch);
+  assert.deepEqual({ doc, patch }, snap);
+  assert.notEqual(out.d, value);
+  out.d.x.push(2);
+  assert.deepEqual(value, { x: [1] });
+  assert.equal(applyPatch(doc, []) === doc, false);
+});
+
+test("failure is all-or-nothing", () => {
+  const doc = { a: 1 };
+  bad(doc, [{ op: "add", path: "/b", value: 2 }, { op: "remove", path: "/zzz" }]);
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("invalid patches", () => {
+  bad({}, {});
+  bad({}, null);
+  bad({}, [null]);
+  bad({}, [[]]);
+  bad({}, ["add"]);
+  bad({}, [{ path: "/a", value: 1 }]);
+  bad({}, [{ op: "nope", path: "/a" }]);
+  bad({}, [{ op: 1, path: "/a" }]);
+  bad({}, [{ op: "add", value: 1 }]);
+  bad({}, [{ op: "add", path: 1, value: 1 }]);
+  bad({}, [{ op: "add", path: "a", value: 1 }]);
+  bad({}, [{ op: "add", path: "/a~2", value: 1 }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "/a" }]);
+  bad({ a: 1 }, [{ op: "test", path: "/a" }]);
+  bad({ a: 1 }, [{ op: "move", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "copy", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "move", from: "a", path: "/b" }]);
+});
+
+test("array index rules", () => {
+  ok([1, 2], [{ op: "add", path: "/2", value: 3 }], [1, 2, 3]);
+  ok([1, 2], [{ op: "add", path: "/0", value: 0 }], [0, 1, 2]);
+  bad([1, 2], [{ op: "add", path: "/3", value: 3 }]);
+  bad([1, 2], [{ op: "add", path: "/01", value: 3 }]);
+  bad([1, 2], [{ op: "add", path: "/-1", value: 3 }]);
+  bad([1, 2], [{ op: "add", path: "/length", value: 3 }]);
+  bad([1, 2], [{ op: "remove", path: "/2" }]);
+  bad([1, 2], [{ op: "remove", path: "/-" }]);
+  bad([1, 2], [{ op: "replace", path: "/2", value: 1 }]);
+  bad([1, 2], [{ op: "replace", path: "/-", value: 1 }]);
+  bad([1, 2], [{ op: "test", path: "/-", value: 1 }]);
+  bad([1, 2], [{ op: "copy", from: "/-", path: "/0" }]);
+  ok([1, 2], [{ op: "copy", from: "/0", path: "/-" }], [1, 2, 1]);
+});
+
+test("missing targets and bad parents", () => {
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad({}, [{ op: "test", path: "/a", value: 1 }]);
+  bad({}, [{ op: "move", from: "/a", path: "/b" }]);
+  bad({}, [{ op: "copy", from: "/a", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]);
+  bad({ a: null }, [{ op: "add", path: "/a/b", value: 1 }]);
+  bad({}, [{ op: "add", path: "/a/b/c", value: 1 }]);
+});
+
+test("move rules", () => {
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  bad({ a: 1 }, [{ op: "move", from: "", path: "/a" }]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  bad({ a: 1 }, [{ op: "move", from: "/x", path: "/x" }]);
+  ok({ a: 1, b: 2 }, [{ op: "move", from: "/a", path: "/b" }], { b: 1 });
+  ok({ a: [1, 2, 3] }, [{ op: "move", from: "/a/2", path: "/a/0" }], { a: [3, 1, 2] });
+});
+
+test("test operation equality", () => {
+  const t = (a: unknown, b: unknown) => applyPatch({ x: a }, [{ op: "test", path: "/x", value: b }]);
+  t({ a: 1, b: [1, 2] }, { b: [1, 2], a: 1 });
+  t(null, null);
+  t(1, 1.0);
+  t("", "");
+  assert.throws(() => t([1, 2], [2, 1]));
+  assert.throws(() => t(null, 0));
+  assert.throws(() => t(1, "1"));
+  assert.throws(() => t({}, []));
+  assert.throws(() => t({ a: 1 }, { a: 1, b: 2 }));
+  assert.throws(() => t({ a: 1, b: 2 }, { a: 1 }));
+  assert.throws(() => t({ a: undefined }, { b: 1 }));
+  assert.throws(() => t(false, 0));
+});
+
+test("prototype safety", () => {
+  const out: any = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(({} as any).polluted, undefined);
+  assert.ok(Object.hasOwn(out, "__proto__"));
+  bad({}, [{ op: "remove", path: "/__proto__" }]);
+  bad({}, [{ op: "remove", path: "/toString" }]);
+  bad({}, [{ op: "add", path: "/constructor/x", value: 1 }]);
+  bad({}, [{ op: "test", path: "/constructor", value: 1 }]);
+});
