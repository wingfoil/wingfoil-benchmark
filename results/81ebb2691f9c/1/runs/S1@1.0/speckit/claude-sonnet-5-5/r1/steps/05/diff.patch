+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createPatch, applyPatch } from "../src/index.ts";
+
+const cases: [unknown, unknown][] = [
+  [{ a: 1 }, { a: 1 }],
+  [{ a: 1, b: [1, 2, 3] }, { a: 2, b: [1, 3, 4, 5] }],
+  [[1, 2, 3, 4], [1, 4]],
+  [[], [1, 2]],
+  [{ "a/b": { "~": 1 } }, { "a/b": { "~": 2 }, c: null }],
+  [1, "x"],
+  [{ a: [] }, { a: {} }],
+  [null, { a: 1 }],
+  [[{ x: 1 }, { y: 2 }], [{ x: 1 }, { y: 3 }]],
+];
+
+test("round trips and does not mutate", () => {
+  for (const [from, to] of cases) {
+    const f = structuredClone(from), t = structuredClone(to);
+    const patch = createPatch(from, to);
+    assert.deepEqual(from, f);
+    assert.deepEqual(to, t);
+    assert.deepEqual(applyPatch(from, patch), to);
+  }
+});
+
+test("minimal patches", () => {
+  assert.deepEqual(createPatch({ a: 1, b: { c: [1, 2] } }, { a: 1, b: { c: [1, 3] } }), [
+    { op: "replace", path: "/b/c/1", value: 3 },
+  ]);
+  assert.deepEqual(createPatch({ a: 1 }, { a: 1 }), []);
+  assert.deepEqual(createPatch([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+});
