@@ -0,0 +1,70 @@
+type Operation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function equal(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => equal(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((k) => Object.hasOwn(b, k) && equal(a[k], b[k]));
+  }
+  return a === b;
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, out: Operation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && equal(from[start], to[start])) start++;
+  let end = 0;
+  while (
+    end < from.length - start &&
+    end < to.length - start &&
+    equal(from[from.length - 1 - end], to[to.length - 1 - end])
+  ) {
+    end++;
+  }
+  const removed = from.length - start - end;
+  const added = to.length - start - end;
+  const common = Math.min(removed, added);
+  for (let i = 0; i < common; i++) diff(from[start + i], to[start + i], `${path}/${start + i}`, out);
+  // Operations apply in order, so removals repeat at one index and additions ascend.
+  for (let i = common; i < removed; i++) out.push({ op: "remove", path: `${path}/${start + common}` });
+  for (let i = common; i < added; i++) out.push({ op: "add", path: `${path}/${start + i}`, value: structuredClone(to[start + i]) });
+}
+
+function diff(from: unknown, to: unknown, path: string, out: Operation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (!Object.hasOwn(from, key)) out.push({ op: "add", path: child, value: structuredClone(to[key]) });
+      else diff(from[key], to[key], child, out);
+    }
+  } else if (!equal(from, to)) {
+    out.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only
+ * what changed. Neither input is modified and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const out: Operation[] = [];
+  diff(from, to, "", out);
+  return out;
+}
