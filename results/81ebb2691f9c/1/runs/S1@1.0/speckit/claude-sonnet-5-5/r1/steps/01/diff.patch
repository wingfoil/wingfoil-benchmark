@@ -0,0 +1,42 @@
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Parses an RFC 6901 JSON Pointer string into its unescaped reference tokens. */
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new TypeError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: must be empty or start with "/": ${pointer}`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new Error(`Invalid JSON Pointer: "~" must be followed by 0 or 1: ${pointer}`);
+      }
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/** Returns the value of `document` referred to by the JSON Pointer `pointer` (RFC 6901). */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const token of parsePointer(pointer)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`JSON Pointer does not resolve: no array element "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new Error(`JSON Pointer does not resolve: no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer does not resolve: cannot descend into a primitive at "${token}"`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..362c0f82fb624cfd622c97b65a5f68951a5604e2
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,71 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("escape decoding is single-pass", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("falsy values are returned", () => {
+  const d = { a: null, b: false, c: 0, d: "" };
+  for (const k of ["a", "b", "c", "d"]) {
+    assert.equal(resolvePointer(d, `/${k}`), (d as any)[k]);
+  }
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["a/b", "a", "/a~", "/a~2", "/~", "#/a", "#"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), Error, p);
+  }
+  assert.throws(() => resolvePointer({}, undefined as any));
+  assert.throws(() => resolvePointer({}, 1 as any));
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: "str" }, "/a/0"));
+  assert.throws(() => resolvePointer({ a: "str" }, "/a/length"));
+  assert.throws(() => resolvePointer([1, 2], "/2"));
+  for (const t of ["-", "01", "+1", "1.0", "a", "", "length", "1e0", "-1"]) {
+    assert.throws(() => resolvePointer([1, 2], `/${t}`), Error, t);
+  }
+  for (const t of ["constructor", "__proto__", "toString", "hasOwnProperty"]) {
+    assert.throws(() => resolvePointer({}, `/${t}`), Error, t);
+  }
+});
+
+test("own __proto__ member resolves", () => {
+  const d = JSON.parse('{"__proto__": 5}');
+  assert.equal(resolvePointer(d, "/__proto__"), 5);
+});
