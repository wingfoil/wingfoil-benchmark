index 0000000000000000000000000000000000000000..069d5ac79f7ba524ad7e0d80d5d038feb34f0148
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,40 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const before = structuredClone([from, to]);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual([from, to], before);
+  return patch;
+};
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small change gives a small patch", () => {
+  const from = { a: { b: 1, c: [1, 2, 3] }, d: "x" };
+  assert.deepEqual(roundTrip(from, { a: { b: 1, c: [1, 9, 3] }, d: "x" }), [{ op: "replace", path: "/a/c/1", value: 9 }]);
+  assert.deepEqual(roundTrip(from, { a: { b: 1, c: [1, 2, 3] } }), [{ op: "remove", path: "/d" }]);
+  assert.deepEqual(roundTrip({ l: [1, 2, 3, 4] }, { l: [1, 2, 3, 4, 5] }), [{ op: "add", path: "/l/4", value: 5 }]);
+  assert.equal(roundTrip({ l: [1, 2, 3, 4] }, { l: [1, 3, 4] }).length, 1);
+  assert.equal(roundTrip({ l: [1, 2, 3, 4] }, { l: [1, 0, 2, 3, 4] }).length, 1);
+});
+
+test("type changes, root, escaping, special keys", () => {
+  roundTrip(1, 2);
+  roundTrip({ a: 1 }, [1]);
+  roundTrip([1, 2, 3, 4], [4]);
+  roundTrip([1], [1, 2, 3]);
+  roundTrip(null, { a: null });
+  roundTrip({ "a/b": 1, "m~n": 2, "": 3 }, { "a/b": 2, "m~n": 3, "": 4 });
+  const proto = JSON.parse('{"__proto__": {"x": 1}}');
+  roundTrip({}, proto);
+  roundTrip(proto, {});
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0] as { value: { b: number } }).value.b = 5;
+  assert.equal(to.a.b, 1);
+});
