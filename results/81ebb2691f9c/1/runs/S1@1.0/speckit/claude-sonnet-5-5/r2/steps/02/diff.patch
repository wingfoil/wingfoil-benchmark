index 0000000000000000000000000000000000000000..719c282eed865d6dbe4322e955e4a7cefed84579
--- /dev/null
+++ b/src/patch.ts
@@ -0,0 +1,174 @@
+import { parse } from "./pointer.ts";
+
+const INDEX = /^(0|[1-9][0-9]*)$/;
+
+type Container = Record<string, unknown> | unknown[];
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function clone<T>(value: T): T {
+  return structuredClone(value);
+}
+
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty keeps "__proto__" an ordinary member instead of changing the prototype.
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function equal(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => equal(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.hasOwn(b, key) && equal(a[key], b[key]))
+    );
+  }
+  return a === b;
+}
+
+/** Walks to the container holding the target of `tokens` (which must be non-empty). */
+function parentOf(root: unknown, tokens: string[], path: string): Container {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`Path "${path}" does not exist: no array element "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (isObject(current) && Object.hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path "${path}" does not exist at "${token}"`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new Error(`Path "${path}" does not exist: parent is not an object or array`);
+  }
+  return current;
+}
+
+function get(root: unknown, path: string): unknown {
+  let current = root;
+  for (const token of parse(path)) {
+    if (Array.isArray(current)) {
+      if (!INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`Path "${path}" does not exist: no array element "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (isObject(current) && Object.hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path "${path}" does not exist at "${token}"`);
+    }
+  }
+  return current;
+}
+
+function add(root: unknown, path: string, value: unknown): unknown {
+  const tokens = parse(path);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens, path);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (key === "-") {
+      parent.push(value);
+    } else if (INDEX.test(key) && Number(key) <= parent.length) {
+      parent.splice(Number(key), 0, value);
+    } else {
+      throw new Error(`Cannot add at "${path}": invalid array index "${key}"`);
+    }
+  } else {
+    setMember(parent, key, value);
+  }
+  return root;
+}
+
+function remove(root: unknown, path: string): unknown {
+  const tokens = parse(path);
+  if (tokens.length === 0) throw new Error("Cannot remove the document root");
+  get(root, path);
+  const parent = parentOf(root, tokens, path);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(key), 1);
+  else delete parent[key];
+  return root;
+}
+
+function replace(root: unknown, path: string, value: unknown): unknown {
+  const tokens = parse(path);
+  if (tokens.length === 0) return value;
+  get(root, path);
+  const parent = parentOf(root, tokens, path);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(key)] = value;
+  else setMember(parent, key, value);
+  return root;
+}
+
+function member(operation: Record<string, unknown>, name: string, index: number): unknown {
+  if (!Object.hasOwn(operation, name)) {
+    throw new Error(`Patch operation ${index} is missing "${name}"`);
+  }
+  return operation[name];
+}
+
+function pointerMember(operation: Record<string, unknown>, name: string, index: number): string {
+  const value = member(operation, name, index);
+  if (typeof value !== "string") {
+    throw new Error(`Patch operation ${index}: "${name}" must be a string`);
+  }
+  return value;
+}
+
+/**
+ * Applies the RFC 6902 JSON Patch `patch` to `document` and returns the result as a new value.
+ * Neither argument is mutated; throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new TypeError("JSON Patch must be an array of operations");
+  let result = clone(document);
+  patch.forEach((operation, index) => {
+    if (!isObject(operation)) throw new Error(`Patch operation ${index} must be an object`);
+    const path = pointerMember(operation, "path", index);
+    switch (operation.op) {
+      case "add":
+        result = add(result, path, clone(member(operation, "value", index)));
+        break;
+      case "replace":
+        result = replace(result, path, clone(member(operation, "value", index)));
+        break;
+      case "remove":
+        result = remove(result, path);
+        break;
+      case "test":
+        if (!equal(get(result, path), member(operation, "value", index))) {
+          throw new Error(`Patch operation ${index}: test failed at "${path}"`);
+        }
+        break;
+      case "copy": {
+        const from = pointerMember(operation, "from", index);
+        result = add(result, path, clone(get(result, from)));
+        break;
+      }
+      case "move": {
+        const from = pointerMember(operation, "from", index);
+        const value = get(result, from);
+        if (from === path) break;
+        if (path.startsWith(from + "/")) {
+          throw new Error(`Patch operation ${index}: cannot move "${from}" into its own child`);
+        }
+        result = add(remove(result, from), path, value);
+        break;
+      }
+      default:
+        throw new Error(`Patch operation ${index}: unknown op ${JSON.stringify(operation.op)}`);
+    }
+  });
+  return result;
+}
