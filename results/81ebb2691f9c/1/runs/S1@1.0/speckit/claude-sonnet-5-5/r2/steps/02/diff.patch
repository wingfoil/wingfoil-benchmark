diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e7f22cf4a108bb9f04fb2a600f7e76a78782899e
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,88 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const p = (doc: unknown, patch: unknown) => applyPatch(doc, patch);
+
+test("RFC 6902 appendix A examples", () => {
+  assert.deepEqual(p({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(p({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(p({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+  assert.deepEqual(p({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+  assert.deepEqual(p({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), { baz: "boo", foo: "bar" });
+  assert.deepEqual(
+    p({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(p({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(p({ baz: "qux", foo: ["bar", "baz"] }, [{ op: "copy", from: "/foo/1", path: "/foo/-" }]), { baz: "qux", foo: ["bar", "baz", "baz"] });
+  assert.deepEqual(p({ baz: "qux" }, [{ op: "test", path: "/baz", value: "qux" }]), { baz: "qux" });
+  assert.deepEqual(p({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]), { foo: ["bar", ["abc", "def"]] });
+});
+
+test("failures throw", () => {
+  const bad: unknown[] = [
+    [{ op: "test", path: "/a", value: 2 }],
+    [{ op: "test", path: "/a", value: "1" }],
+    [{ op: "remove", path: "/missing" }],
+    [{ op: "replace", path: "/missing", value: 1 }],
+    [{ op: "add", path: "/x/y", value: 1 }],
+    [{ op: "add", path: "/l/5", value: 1 }],
+    [{ op: "add", path: "/l/01", value: 1 }],
+    [{ op: "move", from: "/missing", path: "/z" }],
+    [{ op: "move", from: "/o", path: "/o/c" }],
+    [{ op: "copy", from: "/missing", path: "/z" }],
+    [{ op: "add", path: "/z" }],
+    [{ op: "add", value: 1 }],
+    [{ op: "bogus", path: "/a" }],
+    [{ op: "remove", path: "" }],
+    [{ op: "remove", path: "a" }],
+    [{ op: "move", path: "/z" }],
+    [null],
+    {},
+  ];
+  for (const patch of bad) assert.throws(() => p({ a: 1, l: [1], o: { c: 1 } }, patch));
+});
+
+test("test op uses deep, order-insensitive equality; null value is allowed", () => {
+  p({ a: { x: 1, y: [1, 2] } }, [{ op: "test", path: "/a", value: { y: [1, 2], x: 1 } }]);
+  assert.throws(() => p({ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]));
+  assert.deepEqual(p({}, [{ op: "add", path: "/n", value: null }]), { n: null });
+});
+
+test("root operations and empty patch", () => {
+  assert.deepEqual(p({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(p({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+  assert.deepEqual(p({ a: 1 }, []), { a: 1 });
+});
+
+test("does not mutate inputs, and the result shares nothing with them", () => {
+  const doc = { a: [1, { b: 2 }], c: { d: 1 } };
+  const patch = [
+    { op: "add", path: "/e", value: { f: 1 } },
+    { op: "copy", from: "/c", path: "/g" },
+    { op: "remove", path: "/a/0" },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const out = p(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  out.e.f = 99;
+  out.g.d = 99;
+  assert.deepEqual(patch, patchCopy);
+  assert.equal(doc.c.d, 1);
+});
+
+test("atomic: a failing patch throws and leaves input intact", () => {
+  const doc = { a: 1 };
+  assert.throws(() => p(doc, [{ op: "add", path: "/b", value: 1 }, { op: "remove", path: "/x" }]));
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("__proto__ is an ordinary member", () => {
+  const out = p({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as any;
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(({} as any).polluted, undefined);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+});
