@@ -14,3 +14,14 @@ followed by `0` or `1`), and a `RangeError` when it does not resolve: missing me
 of range or not canonical (`01`, `-1`), the `-` token (a nonexistent element), or descending into a
 primitive. Only own members are resolved, so `/toString` or `/__proto__` never reach inherited values.
 Run the tests with `npm test`.
+
+### JSON Patch (RFC 6902)
+
+`applyPatch(document, patch)` applies a JSON Patch, an array of `add`, `remove`, `replace`, `move`,
+`copy` and `test` operations, and returns the resulting document as a new value: neither the document
+nor the patch is mutated or shared with the result. Operations apply in order and the patch is atomic:
+any failure throws and nothing is returned. It throws a `TypeError` when the patch is malformed (not an
+array, unknown `op`, missing `path`, `from` or `value`), a `SyntaxError` for an invalid JSON Pointer, and
+a `RangeError` when an operation fails (missing target, array index out of range, failed `test`, moving a
+value into its own child, or removing the whole document). Pointers follow the rules of `resolvePointer`;
+`-` appends to an array in `add`, and a `test` compares values deeply, ignoring member order.
diff --git a/src/index.ts b/src/index.ts
index be01093ec20bc818c03f180455c4f3d3fe45aec7..565cafca84e7d7ac1676fabf66c0faabd2836126 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -50,3 +50,167 @@ function step(current: unknown, token: string): unknown {
 export function resolvePointer(document: unknown, pointer: string): unknown {
   return parseTokens(pointer).reduce(step, document);
 }
+
+type Container = Record<string, unknown> | unknown[];
+
+interface Location {
+  parent: Container;
+  key: string;
+}
+
+const OPERATIONS = ["add", "remove", "replace", "move", "copy", "test"] as const;
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((item, i) => isEqual(item, b[i]))
+    );
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((k) => Object.hasOwn(b, k) && isEqual(a[k], b[k]));
+  }
+  return a === b;
+}
+
+function locate(root: unknown, pointer: string): Location | undefined {
+  const tokens = parseTokens(pointer);
+  if (tokens.length === 0) {
+    return undefined;
+  }
+  const parent = tokens.slice(0, -1).reduce(step, root);
+  if (typeof parent !== "object" || parent === null) {
+    throw new RangeError(`JSON Patch target does not exist: ${pointer}`);
+  }
+  return { parent: parent as Container, key: tokens[tokens.length - 1] };
+}
+
+function arrayIndex(key: string, last: number): number {
+  if (!ARRAY_INDEX.test(key) || Number(key) > last) {
+    throw new RangeError(`JSON Patch target does not exist: array index "${key}"`);
+  }
+  return Number(key);
+}
+
+function setMember(parent: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty keeps "__proto__" an ordinary member instead of changing the prototype.
+  Object.defineProperty(parent, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function addAt(root: unknown, pointer: string, value: unknown): unknown {
+  const location = locate(root, pointer);
+  if (location === undefined) {
+    return value;
+  }
+  const { parent, key } = location;
+  if (Array.isArray(parent)) {
+    parent.splice(key === "-" ? parent.length : arrayIndex(key, parent.length), 0, value);
+  } else {
+    setMember(parent, key, value);
+  }
+  return root;
+}
+
+function removeAt(root: unknown, pointer: string): unknown {
+  const location = locate(root, pointer);
+  if (location === undefined) {
+    throw new RangeError("JSON Patch cannot remove the whole document");
+  }
+  const { parent, key } = location;
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(key, parent.length - 1), 1);
+  } else if (Object.hasOwn(parent, key)) {
+    delete parent[key];
+  } else {
+    throw new RangeError(`JSON Patch target does not exist: member "${key}"`);
+  }
+  return root;
+}
+
+function replaceAt(root: unknown, pointer: string, value: unknown): unknown {
+  const location = locate(root, pointer);
+  if (location === undefined) {
+    return value;
+  }
+  const { parent, key } = location;
+  if (Array.isArray(parent)) {
+    parent[arrayIndex(key, parent.length - 1)] = value;
+  } else if (Object.hasOwn(parent, key)) {
+    setMember(parent, key, value);
+  } else {
+    throw new RangeError(`JSON Patch target does not exist: member "${key}"`);
+  }
+  return root;
+}
+
+function requireString(operation: Record<string, unknown>, name: string): string {
+  const value = operation[name];
+  if (typeof value !== "string") {
+    throw new TypeError(`Invalid JSON Patch: "${name}" must be a string in a "${String(operation.op)}" operation`);
+  }
+  return value;
+}
+
+function requireValue(operation: Record<string, unknown>): unknown {
+  if (!Object.hasOwn(operation, "value")) {
+    throw new TypeError(`Invalid JSON Patch: "value" is required in a "${String(operation.op)}" operation`);
+  }
+  return structuredClone(operation.value);
+}
+
+function applyOperation(root: unknown, operation: unknown): unknown {
+  if (!isObject(operation)) {
+    throw new TypeError("Invalid JSON Patch: each operation must be an object");
+  }
+  const op = operation.op;
+  if (!OPERATIONS.includes(op as (typeof OPERATIONS)[number])) {
+    throw new TypeError(`Invalid JSON Patch: unknown operation "${String(op)}"`);
+  }
+  const path = requireString(operation, "path");
+  switch (op) {
+    case "add":
+      return addAt(root, path, requireValue(operation));
+    case "remove":
+      return removeAt(root, path);
+    case "replace":
+      return replaceAt(root, path, requireValue(operation));
+    case "test":
+      if (!isEqual(resolvePointer(root, path), requireValue(operation))) {
+        throw new RangeError(`JSON Patch test failed at "${path}"`);
+      }
+      return root;
+    default: {
+      const from = requireString(operation, "from");
+      const value = structuredClone(resolvePointer(root, from));
+      if (op === "copy") {
+        return addAt(root, path, value);
+      }
+      if (path.startsWith(`${from}/`)) {
+        throw new RangeError(`JSON Patch cannot move "${from}" into one of its own children`);
+      }
+      return addAt(removeAt(root, from), path, value);
+    }
+  }
+}
+
+/**
+ * Applies the JSON Patch `patch` (RFC 6902), an array of `add`, `remove`, `replace`, `move`,
+ * `copy` and `test` operations, to `document` and returns the resulting document.
+ *
+ * The input is never mutated: operations run on a copy, and values taken from the patch are
+ * copied too, so the result shares nothing with either argument. Operations apply in order and
+ * the patch is atomic, as any failure throws and no partial result is returned. Throws a
+ * `TypeError` when the patch is malformed (not an array, unknown `op`, missing `path`, `from`
+ * or `value`), a `SyntaxError` for an invalid JSON Pointer, and a `RangeError` when an operation
+ * fails: target missing, index out of range, a failed `test`, or removing the whole document.
+ */
+export function applyPatch(document: unknown, patch: unknown[]): unknown {
+  if (!Array.isArray(patch)) {
+    throw new TypeError("Invalid JSON Patch: a patch must be an array of operations");
+  }
+  return patch.reduce(applyOperation, structuredClone(document));
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..039d19069a767f090e6f47b54572c61da3eee3e6
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,121 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { applyPatch } from "../src/index.ts";
+
+// Each case is [description, document, patch, expected] taken from RFC 6902 Appendix A.
+const examples: [string, unknown, unknown[], unknown][] = [
+  ["A.1 adding an object member", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" }],
+  [
+    "A.2 adding an array element",
+    { foo: ["bar", "baz"] },
+    [{ op: "add", path: "/foo/1", value: "qux" }],
+    { foo: ["bar", "qux", "baz"] },
+  ],
+  ["A.3 removing an object member", { baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }],
+  ["A.4 removing an array element", { foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }],
+  [
+    "A.5 replacing a value",
+    { baz: "qux", foo: "bar" },
+    [{ op: "replace", path: "/baz", value: "boo" }],
+    { baz: "boo", foo: "bar" },
+  ],
+  [
+    "A.6 moving a value",
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  ],
+  [
+    "A.7 moving an array element",
+    { foo: ["all", "grass", "cows", "eat"] },
+    [{ op: "move", from: "/foo/1", path: "/foo/3" }],
+    { foo: ["all", "cows", "eat", "grass"] },
+  ],
+  [
+    "A.8 testing a value: success",
+    { baz: "qux", foo: ["a", 2, "c"] },
+    [
+      { op: "test", path: "/baz", value: "qux" },
+      { op: "test", path: "/foo/1", value: 2 },
+    ],
+    { baz: "qux", foo: ["a", 2, "c"] },
+  ],
+  [
+    "A.10 adding a nested member object",
+    { foo: "bar" },
+    [{ op: "add", path: "/child", value: { grandchild: {} } }],
+    { foo: "bar", child: { grandchild: {} } },
+  ],
+  ["A.11 ignoring unrecognized elements", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" }],
+  ["A.14 escape ordering", { "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }],
+  [
+    "A.16 adding an array value",
+    { foo: ["bar"] },
+    [{ op: "add", path: "/foo/-", value: ["abc", "def"] }],
+    { foo: ["bar", ["abc", "def"]] },
+  ],
+  ["copy", { a: { b: 1 } }, [{ op: "copy", from: "/a", path: "/c" }], { a: { b: 1 }, c: { b: 1 } }],
+  ["add replaces an existing member", { a: 1 }, [{ op: "add", path: "/a", value: 2 }], { a: 2 }],
+  ["add at the end index", { a: [1] }, [{ op: "add", path: "/a/1", value: 2 }], { a: [1, 2] }],
+  ["root replace", { a: 1 }, [{ op: "replace", path: "", value: [1] }], [1]],
+  ["root add", { a: 1 }, [{ op: "add", path: "", value: null }], null],
+  ["empty patch", { a: 1 }, [], { a: 1 }],
+  ["move to the same location", { a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 }],
+  ["test ignores member order", { a: { x: 1, y: 2 } }, [{ op: "test", path: "/a", value: { y: 2, x: 1 } }], { a: { x: 1, y: 2 } }],
+];
+
+for (const [name, document, patch, expected] of examples) {
+  test(`applyPatch: ${name}`, () => {
+    assert.deepEqual(applyPatch(document, patch), expected);
+  });
+}
+
+const failures: [string, unknown, unknown, ErrorConstructor][] = [
+  ["A.9 failing test", { baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }], RangeError],
+  ["A.12 adding to a nonexistent target", { foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }], RangeError],
+  ["unknown operation", {}, [{ op: "bogus", path: "" }], TypeError],
+  ["test compares types", { a: 10 }, [{ op: "test", path: "/a", value: "10" }], RangeError],
+  ["test of a missing member", {}, [{ op: "test", path: "/a", value: null }], RangeError],
+  ["patch is not an array", {}, { op: "add", path: "/a", value: 1 }, TypeError],
+  ["operation is not an object", {}, [null], TypeError],
+  ["missing path", {}, [{ op: "remove" }], TypeError],
+  ["missing value", {}, [{ op: "add", path: "/a" }], TypeError],
+  ["missing from", { a: 1 }, [{ op: "move", path: "/b" }], TypeError],
+  ["invalid pointer", {}, [{ op: "add", path: "a", value: 1 }], SyntaxError],
+  ["remove missing member", {}, [{ op: "remove", path: "/a" }], RangeError],
+  ["remove inherited member", {}, [{ op: "remove", path: "/toString" }], RangeError],
+  ["remove the whole document", {}, [{ op: "remove", path: "" }], RangeError],
+  ["replace missing member", {}, [{ op: "replace", path: "/a", value: 1 }], RangeError],
+  ["replace past the array end", [1], [{ op: "replace", path: "/1", value: 1 }], RangeError],
+  ["add beyond the array end", [1], [{ op: "add", path: "/2", value: 1 }], RangeError],
+  ["add with a non-canonical index", [1], [{ op: "add", path: "/01", value: 1 }], RangeError],
+  ["add into a primitive", { a: 1 }, [{ op: "add", path: "/a/b", value: 1 }], RangeError],
+  ["move from a missing location", {}, [{ op: "move", from: "/a", path: "/b" }], RangeError],
+  ["move into own child", { a: {} }, [{ op: "move", from: "/a", path: "/a/b" }], RangeError],
+  ["copy from a missing location", {}, [{ op: "copy", from: "/a", path: "/b" }], RangeError],
+];
+
+for (const [name, document, patch, error] of failures) {
+  test(`applyPatch throws: ${name}`, () => {
+    assert.throws(() => applyPatch(document, patch as unknown[]), error);
+  });
+}
+
+test("applyPatch does not mutate the document or share values with the patch", () => {
+  const document = { a: { b: [1, 2] } };
+  const value = { n: 1 };
+  const result = applyPatch(document, [
+    { op: "add", path: "/a/b/-", value: 3 },
+    { op: "add", path: "/v", value },
+    { op: "copy", from: "/a", path: "/c" },
+  ]) as { v: { n: number }; c: unknown; a: unknown };
+  assert.deepEqual(document, { a: { b: [1, 2] } });
+  assert.notEqual(result.v, value);
+  assert.notEqual(result.c, result.a);
+});
+
+test("applyPatch keeps __proto__ an ordinary member", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as object;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+});
