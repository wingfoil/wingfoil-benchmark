new file mode 100644
index 0000000000000000000000000000000000000000..fd3f2fa90ab6b0844e82b6c3617a516054aa6121
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrips: [string, unknown, unknown][] = [
+  ["equal documents", { a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }],
+  ["member order only", { a: 1, b: 2 }, { b: 2, a: 1 }],
+  ["added member", { a: 1 }, { a: 1, b: 2 }],
+  ["removed member", { a: 1, b: 2 }, { a: 1 }],
+  ["changed nested member", { a: { b: { c: 1 } } }, { a: { b: { c: 2 } } }],
+  ["null value", { a: 1 }, { a: null }],
+  ["array grows", { a: [1, 2] }, { a: [1, 2, 3, 4] }],
+  ["array shrinks", [1, 2, 3, 4], [1, 2]],
+  ["array element changes", [{ a: 1 }, { a: 2 }], [{ a: 1 }, { a: 3 }]],
+  ["type change", { a: [1] }, { a: { 0: 1 } }],
+  ["root replaced", { a: 1 }, [1]],
+  ["primitive root", 1, 2],
+  ["keys needing escapes", { "a/b": 1, "m~n": 2 }, { "a/b": 3, "m~n": 4 }],
+  ["__proto__ member", { a: 1 }, JSON.parse('{"a":1,"__proto__":{"x":1}}')],
+];
+
+for (const [name, from, to] of roundTrips) {
+  test(`applying the patch turns from into to: ${name}`, () => {
+    assert.deepEqual(applyPatch(from, createPatch(from, to)), to);
+  });
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(createPatch({ a: [1, 2] }, { a: [1, 2] }), []);
+});
+
+test("a small change gives a single small operation", () => {
+  const from = { a: { b: 1, c: [1, 2, 3] }, d: "x" };
+  const to = { a: { b: 1, c: [1, 9, 3] }, d: "x" };
+  assert.deepEqual(createPatch(from, to), [{ op: "replace", path: "/a/c/1", value: 9 }]);
+});
+
+test("escapes pointer tokens", () => {
+  assert.deepEqual(createPatch({ "a/b~": 1 }, { "a/b~": 2 }), [{ op: "replace", path: "/a~1b~0", value: 2 }]);
+});
+
+test("removes array tail from the highest index", () => {
+  assert.deepEqual(createPatch([1, 2, 3], [1]), [
+    { op: "remove", path: "/2" },
+    { op: "remove", path: "/1" },
+  ]);
+});
+
+test("does not mutate the inputs nor share structure with them", () => {
+  const from = { a: 1 };
+  const to = { b: { c: [1] } };
+  const patch = createPatch(from, to) as { value?: { c: unknown[] } }[];
+  assert.deepEqual(from, { a: 1 });
+  assert.deepEqual(to, { b: { c: [1] } });
+  assert.notEqual(patch.find((op) => op.value)?.value, to.b);
+});
