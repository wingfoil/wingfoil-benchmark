index 8be1e1ecc71c972cbdc7c9666a2e6eb835c27a91..c4624299ed722730c9bd84906a605ad42c75ba46 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -248,3 +248,76 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+interface PatchOperation {
+  op: "add" | "remove" | "replace";
+  path: string;
+  value?: unknown;
+}
+
+function escapeToken(token: string): string {
+  return token.replaceAll("~", "~0").replaceAll("/", "~1");
+}
+
+function diffObjects(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  path: string,
+  out: PatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const child = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) {
+      diffValues(from[key], to[key], child, out);
+    } else {
+      out.push({ op: "add", path: child, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, out: PatchOperation[]): void {
+  const common = Math.min(from.length, to.length);
+  for (let i = 0; i < common; i++) {
+    diffValues(from[i], to[i], `${path}/${i}`, out);
+  }
+  // Removing from the end keeps the indices of the remaining removals valid.
+  for (let i = from.length - 1; i >= common; i--) {
+    out.push({ op: "remove", path: `${path}/${i}` });
+  }
+  for (let i = common; i < to.length; i++) {
+    out.push({ op: "add", path: `${path}/-`, value: structuredClone(to[i]) });
+  }
+}
+
+function diffValues(from: unknown, to: unknown, path: string, out: PatchOperation[]): void {
+  if (isEqual(from, to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from, to, path, out);
+  } else {
+    out.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when passed to `applyPatch`.
+ *
+ * Only what changed is described: objects are compared member by member and arrays element by
+ * element, so a small change deep in a document yields a single small operation, and equal
+ * documents yield an empty patch. Arrays that differ in length are patched by removing the
+ * surplus tail or appending the new elements. Values in the patch are copies, and neither
+ * input is mutated. Only own members are compared.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  const out: PatchOperation[] = [];
+  diffValues(from, to, "", out);
+  return out;
+}
