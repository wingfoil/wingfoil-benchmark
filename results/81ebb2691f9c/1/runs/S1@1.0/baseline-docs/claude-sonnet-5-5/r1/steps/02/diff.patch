new file mode 100644
index 0000000000000000000000000000000000000000..a781969599fa95e610fab6ccc6b0c8d6ac266223
--- /dev/null
+++ b/src/pointer.ts
@@ -0,0 +1,56 @@
+/** Any value representable in a JSON document. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const INVALID_ESCAPE = /~(?![01])/;
+
+function unescapeToken(token: string): string {
+  if (INVALID_ESCAPE.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in "${token}"`);
+  }
+  return token.replace(/~([01])/g, (_, code: string) => (code === "0" ? "~" : "/"));
+}
+
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: pointer must be a string");
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`);
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+export function step(current: unknown, token: string): JsonValue {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+      throw new Error(`JSON Pointer does not resolve: no array element "${token}"`);
+    }
+    return current[Number(token)] as JsonValue;
+  }
+  if (typeof current === "object" && current !== null && Object.hasOwn(current, token)) {
+    return (current as { [key: string]: JsonValue })[token];
+  }
+  throw new Error(`JSON Pointer does not resolve: no member "${token}"`);
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer (RFC 6901) `pointer` refers to.
+ *
+ * Throws if `pointer` is not a valid JSON Pointer, or if it does not resolve to a value of the
+ * document (missing member, out-of-range or non-canonical array index, the "-" end-of-array
+ * marker, or traversal through a scalar). Only own members are followed, so names such as
+ * "constructor" never reach the prototype chain.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  return parsePointer(pointer).reduce<JsonValue>(step, document);
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f469b40b4c4f7de5e25bca9f438f7e4e1b6de3b2
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,137 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+import type { JsonValue, PatchOperation } from "../src/index.ts";
+
+const apply = (doc: JsonValue, patch: unknown) => applyPatch(doc, patch as PatchOperation[]);
+
+test("RFC 6902 add examples", () => {
+  assert.deepEqual(apply({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), {
+    foo: "bar",
+    baz: "qux",
+  });
+  assert.deepEqual(
+    apply({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]),
+    { foo: ["bar", "qux", "baz"] },
+  );
+  assert.deepEqual(apply({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(apply({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(apply({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+});
+
+test("add errors", () => {
+  assert.throws(() => apply({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: 1 }]));
+  assert.throws(() => apply({ foo: [1] }, [{ op: "add", path: "/foo/3", value: 1 }]));
+  assert.throws(() => apply({ foo: [1] }, [{ op: "add", path: "/foo/01", value: 1 }]));
+  assert.throws(() => apply({ foo: 1 }, [{ op: "add", path: "/foo/x", value: 1 }]));
+  assert.throws(() => apply({}, [{ op: "add", path: "/a" }]));
+});
+
+test("remove", () => {
+  assert.deepEqual(apply({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(apply([1, 2, 3], [{ op: "remove", path: "/1" }]), [1, 3]);
+  assert.throws(() => apply({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => apply([1], [{ op: "remove", path: "/-" }]));
+  assert.throws(() => apply({ a: 1 }, [{ op: "remove", path: "" }]));
+});
+
+test("replace", () => {
+  assert.deepEqual(apply({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(apply([1, 2], [{ op: "replace", path: "/1", value: 5 }]), [1, 5]);
+  assert.equal(apply({ a: 1 }, [{ op: "replace", path: "", value: 7 }]), 7);
+  assert.throws(() => apply({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => apply([1], [{ op: "replace", path: "/1", value: 1 }]));
+});
+
+test("RFC 6902 move examples", () => {
+  assert.deepEqual(
+    apply({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [
+      { op: "move", from: "/foo/waldo", path: "/qux/thud" },
+    ]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(
+    apply({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]),
+    { foo: ["all", "cows", "eat", "grass"] },
+  );
+});
+
+test("move errors", () => {
+  assert.throws(() => apply({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => apply({}, [{ op: "move", from: "/a", path: "/b" }]));
+  assert.throws(() => apply({ a: 1 }, [{ op: "move", path: "/b" }]));
+  assert.deepEqual(apply({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+});
+
+test("copy", () => {
+  const result = apply({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }]) as {
+    a: object;
+    b: object;
+  };
+  assert.deepEqual(result, { a: { x: 1 }, b: { x: 1 } });
+  assert.notEqual(result.a, result.b);
+  assert.throws(() => apply({}, [{ op: "copy", from: "/a", path: "/b" }]));
+});
+
+test("test operation", () => {
+  assert.deepEqual(apply({ a: 1 }, [{ op: "test", path: "/a", value: 1 }]), { a: 1 });
+  assert.deepEqual(
+    apply({ a: { x: 1, y: [1, 2] } }, [{ op: "test", path: "/a", value: { y: [1, 2], x: 1 } }]),
+    { a: { x: 1, y: [1, 2] } },
+  );
+  assert.deepEqual(apply({ a: null }, [{ op: "test", path: "/a", value: null }]), { a: null });
+  assert.throws(() => apply({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]));
+  assert.throws(() => apply({ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]));
+  assert.throws(() => apply({ a: { x: 1 } }, [{ op: "test", path: "/a", value: { x: 1, y: 2 } }]));
+  assert.throws(() => apply({}, [{ op: "test", path: "/a", value: 1 }]));
+});
+
+test("operations apply in order", () => {
+  assert.deepEqual(
+    apply({}, [
+      { op: "add", path: "/a", value: 1 },
+      { op: "copy", from: "/a", path: "/b" },
+      { op: "test", path: "/b", value: 1 },
+    ]),
+    { a: 1, b: 1 },
+  );
+});
+
+test("invalid patches", () => {
+  assert.throws(() => apply({}, { op: "add" }));
+  assert.throws(() => apply({}, [null]));
+  assert.throws(() => apply({}, [{ op: "bogus", path: "" }]));
+  assert.throws(() => apply({}, [{ op: "remove" }]));
+  assert.throws(() => apply({}, [{ op: "remove", path: "a" }]));
+});
+
+test("inputs are not mutated and results do not alias them", () => {
+  const doc = { a: [1, { b: 2 }] };
+  const value = { n: [1] };
+  const patch = [
+    { op: "replace", path: "/a/1/b", value: 3 },
+    { op: "add", path: "/c", value },
+  ];
+  const snapshot = structuredClone({ doc, patch });
+  const result = apply(doc, patch) as { c: { n: number[] } };
+  assert.deepEqual({ doc, patch }, snapshot);
+  result.c.n.push(2);
+  assert.deepEqual(value, { n: [1] });
+});
+
+test("a failing patch leaves the document untouched", () => {
+  const doc = { a: 1 };
+  assert.throws(() =>
+    apply(doc, [
+      { op: "add", path: "/b", value: 2 },
+      { op: "test", path: "/a", value: 9 },
+    ]),
+  );
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("__proto__ is an ordinary member", () => {
+  const result = apply({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as object;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+});
