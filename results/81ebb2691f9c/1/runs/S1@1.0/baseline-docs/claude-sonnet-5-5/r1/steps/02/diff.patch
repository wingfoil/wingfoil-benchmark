diff --git a/src/patch.ts b/src/patch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d2f08e922b289e360df76409c01e89830be9ef6f
--- /dev/null
+++ b/src/patch.ts
@@ -0,0 +1,188 @@
+import { parsePointer, step } from "./pointer.ts";
+import type { JsonValue } from "./pointer.ts";
+
+type JsonObject = { [key: string]: JsonValue };
+
+/** One operation of a JSON Patch document (RFC 6902, section 4). */
+export interface PatchOperation {
+  op: "add" | "remove" | "replace" | "move" | "copy" | "test";
+  path: string;
+  value?: JsonValue;
+  from?: string;
+}
+
+const OPERATIONS = ["add", "remove", "replace", "move", "copy", "test"];
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function isObject(value: unknown): value is JsonObject {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function clone(value: JsonValue): JsonValue {
+  return structuredClone(value);
+}
+
+function jsonEqual(a: JsonValue, b: JsonValue): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (Array.isArray(a) && Array.isArray(b)) {
+    return a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]));
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.hasOwn(b, key) && jsonEqual(a[key], b[key]))
+    );
+  }
+  return false;
+}
+
+// Defines the member rather than assigning it, so that "__proto__" stays an ordinary member.
+function setMember(target: JsonObject, key: string, value: JsonValue): void {
+  Object.defineProperty(target, key, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
+
+function parseIndex(token: string, length: number): number {
+  if (!ARRAY_INDEX.test(token) || Number(token) > length) {
+    throw new Error(`JSON Patch: invalid array index "${token}"`);
+  }
+  return Number(token);
+}
+
+function parentOf(document: JsonValue, tokens: string[]): JsonValue[] | JsonObject {
+  const parent = tokens.slice(0, -1).reduce<JsonValue>(step, document);
+  if (typeof parent !== "object" || parent === null) {
+    throw new Error("JSON Patch: the parent of the target is not an array or an object");
+  }
+  return parent;
+}
+
+function addAt(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = parentOf(document, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    const index = key === "-" ? parent.length : parseIndex(key, parent.length);
+    parent.splice(index, 0, value);
+  } else {
+    setMember(parent, key, value);
+  }
+  return document;
+}
+
+function removeAt(document: JsonValue, path: string): JsonValue {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    throw new Error("JSON Patch: the whole document cannot be removed");
+  }
+  const parent = parentOf(document, tokens);
+  const key = tokens[tokens.length - 1];
+  step(parent, key);
+  if (Array.isArray(parent)) {
+    parent.splice(Number(key), 1);
+  } else {
+    delete parent[key];
+  }
+  return document;
+}
+
+function replaceAt(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = parentOf(document, tokens);
+  const key = tokens[tokens.length - 1];
+  step(parent, key);
+  if (Array.isArray(parent)) {
+    parent[Number(key)] = value;
+  } else {
+    setMember(parent, key, value);
+  }
+  return document;
+}
+
+function valueAt(document: JsonValue, pointer: string): JsonValue {
+  return parsePointer(pointer).reduce<JsonValue>(step, document);
+}
+
+function isProperPrefix(from: string[], path: string[]): boolean {
+  return from.length < path.length && from.every((token, i) => token === path[i]);
+}
+
+function moveValue(document: JsonValue, from: string, path: string): JsonValue {
+  if (isProperPrefix(parsePointer(from), parsePointer(path))) {
+    throw new Error("JSON Patch: a value cannot be moved into one of its own children");
+  }
+  const value = clone(valueAt(document, from));
+  return addAt(removeAt(document, from), path, value);
+}
+
+function requireString(operation: JsonObject, member: string): string {
+  const text = operation[member];
+  if (typeof text !== "string") {
+    throw new Error(`JSON Patch: operation member "${member}" must be a string`);
+  }
+  return text;
+}
+
+function requireValue(operation: JsonObject): JsonValue {
+  if (!Object.hasOwn(operation, "value")) {
+    throw new Error(`JSON Patch: operation "${String(operation.op)}" requires a "value"`);
+  }
+  return clone(operation.value);
+}
+
+function applyOperation(document: JsonValue, operation: unknown): JsonValue {
+  if (!isObject(operation)) {
+    throw new Error("JSON Patch: each operation must be an object");
+  }
+  const op = operation.op;
+  if (typeof op !== "string" || !OPERATIONS.includes(op)) {
+    throw new Error(`JSON Patch: unknown operation "${String(op)}"`);
+  }
+  const path = requireString(operation, "path");
+  switch (op) {
+    case "add":
+      return addAt(document, path, requireValue(operation));
+    case "remove":
+      return removeAt(document, path);
+    case "replace":
+      return replaceAt(document, path, requireValue(operation));
+    case "move":
+      return moveValue(document, requireString(operation, "from"), path);
+    case "copy":
+      return addAt(document, path, clone(valueAt(document, requireString(operation, "from"))));
+    default:
+      if (!jsonEqual(valueAt(document, path), requireValue(operation))) {
+        throw new Error(`JSON Patch: test failed at "${path}"`);
+      }
+      return document;
+  }
+}
+
+/**
+ * Applies the JSON Patch (RFC 6902) `patch` to `document` and returns the resulting document.
+ *
+ * The input document and the patch are never mutated: the result shares no structure with them.
+ * Operations are applied in order; the whole patch is atomic because any failure throws and no
+ * partial result is returned. Throws if `patch` is not an array of valid operations, or if an
+ * operation fails (unresolvable path, invalid array index, failed `test`, a `move` into its own
+ * child, removal of the whole document).
+ */
+export function applyPatch(document: JsonValue, patch: PatchOperation[]): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("JSON Patch: a patch must be an array of operations");
+  }
+  return patch.reduce<JsonValue>(applyOperation, clone(document));
+}
