@@ -0,0 +1,56 @@
+/** Any value representable in a JSON document. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const INVALID_ESCAPE = /~(?![01])/;
+
+function unescapeToken(token: string): string {
+  if (INVALID_ESCAPE.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in "${token}"`);
+  }
+  return token.replace(/~([01])/g, (_, code: string) => (code === "0" ? "~" : "/"));
+}
+
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: pointer must be a string");
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`);
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+function step(current: unknown, token: string): JsonValue {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+      throw new Error(`JSON Pointer does not resolve: no array element "${token}"`);
+    }
+    return current[Number(token)] as JsonValue;
+  }
+  if (typeof current === "object" && current !== null && Object.hasOwn(current, token)) {
+    return (current as { [key: string]: JsonValue })[token];
+  }
+  throw new Error(`JSON Pointer does not resolve: no member "${token}"`);
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer (RFC 6901) `pointer` refers to.
+ *
+ * Throws if `pointer` is not a valid JSON Pointer, or if it does not resolve to a value of the
+ * document (missing member, out-of-range or non-canonical array index, the "-" end-of-array
+ * marker, or traversal through a scalar). Only own members are followed, so names such as
+ * "constructor" never reach the prototype chain.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  return parsePointer(pointer).reduce<JsonValue>(step, document);
+}
