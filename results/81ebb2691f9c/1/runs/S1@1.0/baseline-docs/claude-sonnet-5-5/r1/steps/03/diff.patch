diff --git a/src/patch.ts b/src/patch.ts
index d2f08e922b289e360df76409c01e89830be9ef6f..7fc1b436056c9a0b1eb55e76391930f9ecb9a468 100644
--- a/src/patch.ts
+++ b/src/patch.ts
@@ -121,7 +121,13 @@ function isProperPrefix(from: string[], path: string[]): boolean {
 }
 
 function moveValue(document: JsonValue, from: string, path: string): JsonValue {
-  if (isProperPrefix(parsePointer(from), parsePointer(path))) {
+  const source = parsePointer(from);
+  const target = parsePointer(path);
+  if (source.length === target.length && source.every((token, i) => token === target[i])) {
+    valueAt(document, from);
+    return document;
+  }
+  if (isProperPrefix(source, target)) {
     throw new Error("JSON Patch: a value cannot be moved into one of its own children");
   }
   const value = clone(valueAt(document, from));
@@ -137,7 +143,7 @@ function requireString(operation: JsonObject, member: string): string {
 }
 
 function requireValue(operation: JsonObject): JsonValue {
-  if (!Object.hasOwn(operation, "value")) {
+  if (operation.value === undefined) {
     throw new Error(`JSON Patch: operation "${String(operation.op)}" requires a "value"`);
   }
   return clone(operation.value);
@@ -184,5 +190,9 @@ export function applyPatch(document: JsonValue, patch: PatchOperation[]): JsonVa
   if (!Array.isArray(patch)) {
     throw new Error("JSON Patch: a patch must be an array of operations");
   }
-  return patch.reduce<JsonValue>(applyOperation, clone(document));
+  let result = clone(document);
+  for (let i = 0; i < patch.length; i++) {
+    result = applyOperation(result, patch[i]);
+  }
+  return result;
 }
diff --git a/test/patch.test.ts b/test/patch.test.ts
index f469b40b4c4f7de5e25bca9f438f7e4e1b6de3b2..50b8e9ea8508f5c4b4fbcc1ad7308c1055b1894f 100644
--- a/test/patch.test.ts
+++ b/test/patch.test.ts
@@ -135,3 +135,14 @@ test("__proto__ is an ordinary member", () => {
   assert.equal(Object.getPrototypeOf(result), Object.prototype);
   assert.deepEqual(Object.keys(result), ["__proto__"]);
 });
+
+test("a move onto its own location is a no-op, including for the whole document", () => {
+  assert.deepEqual(apply({ a: 1 }, [{ op: "move", from: "", path: "" }]), { a: 1 });
+  assert.throws(() => apply({ a: 1 }, [{ op: "move", from: "/b", path: "/b" }]));
+});
+
+test("a missing or undefined value, or a hole in the patch, is invalid", () => {
+  assert.throws(() => apply({}, [{ op: "add", path: "/a", value: undefined }]));
+  assert.throws(() => apply({}, [{ op: "test", path: "", value: undefined }]));
+  assert.throws(() => apply({}, new Array(1)));
+});
