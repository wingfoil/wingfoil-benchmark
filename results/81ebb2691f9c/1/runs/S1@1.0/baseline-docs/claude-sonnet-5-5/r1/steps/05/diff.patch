index 0000000000000000000000000000000000000000..839816fb600742bbcc9b52420bedc60d1bde59da
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,66 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+import type { JsonValue } from "../src/index.ts";
+
+function roundTrip(from: JsonValue, to: JsonValue) {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a small change in a large document yields a single operation", () => {
+  const from = { a: { b: { c: 1, d: [1, 2, 3] } }, e: "x" };
+  const to = { a: { b: { c: 1, d: [1, 9, 3] } }, e: "x" };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/d/1", value: 9 }]);
+});
+
+test("adds and removes members", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, c: null }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: null },
+  ]);
+});
+
+test("escapes pointer tokens and handles __proto__", () => {
+  const from = JSON.parse('{"a/b":1,"m~n":1,"__proto__":{"x":1}}');
+  const to = JSON.parse('{"a/b":2,"m~n":1,"__proto__":{"x":2}}');
+  const patch = roundTrip(from, to);
+  assert.deepEqual(patch.map((o) => o.path), ["/a~1b", "/__proto__/x"]);
+});
+
+test("array insertion and removal do not rewrite the following elements", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 5, 2, 3, 4]), [{ op: "add", path: "/1", value: 5 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+});
+
+test("arrays of different lengths with changes round-trip", () => {
+  roundTrip([1, 2, 3, 4, 5], [1, 9, 5]);
+  roundTrip([1, 9, 5], [1, 2, 3, 4, 5]);
+  roundTrip([[1], [2]], [[1, 1], [3], [4]]);
+  roundTrip([], [1]);
+  roundTrip([1, 1, 1], [1, 1]);
+});
+
+test("type changes and root changes are replacements", () => {
+  assert.deepEqual(roundTrip({ a: [1] }, { a: { b: 1 } }), [
+    { op: "replace", path: "/a", value: { b: 1 } },
+  ]);
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  roundTrip(null, "x");
+});
+
+test("does not mutate inputs or share structure", () => {
+  const from = { a: 1 };
+  const to = { b: { c: [1] } };
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, { a: 1 });
+  assert.deepEqual(to, { b: { c: [1] } });
+  (patch[1].value as { c: number[] }).c.push(2);
+  assert.deepEqual(to, { b: { c: [1] } });
+});
