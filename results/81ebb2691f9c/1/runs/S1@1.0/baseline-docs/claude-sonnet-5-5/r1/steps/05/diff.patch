index 0000000000000000000000000000000000000000..d661b4622f58118ddf7febb716dc9005a9c84166
--- /dev/null
+++ b/src/diff.ts
@@ -0,0 +1,82 @@
+import type { JsonValue } from "./pointer.ts";
+import { isObject } from "./object.ts";
+import { jsonEqual } from "./patch.ts";
+import type { PatchOperation } from "./patch.ts";
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffObjects(
+  from: Record<string, JsonValue>,
+  to: Record<string, JsonValue>,
+  path: string,
+  out: PatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    const child = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(to, key)) {
+      diffValues(from[key], to[key], child, out);
+    } else {
+      out.push({ op: "remove", path: child });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (!Object.hasOwn(from, key)) {
+      out.push({ op: "add", path: `${path}/${escapeToken(key)}`, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+// Trims the common head and tail so that an insertion or removal in the middle of an array does
+// not turn every following element into a replacement.
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, out: PatchOperation[]): void {
+  const shortest = Math.min(from.length, to.length);
+  let head = 0;
+  while (head < shortest && jsonEqual(from[head], to[head])) {
+    head++;
+  }
+  let tail = 0;
+  while (
+    tail < shortest - head &&
+    jsonEqual(from[from.length - 1 - tail], to[to.length - 1 - tail])
+  ) {
+    tail++;
+  }
+  const removed = from.length - tail - head;
+  const added = to.length - tail - head;
+  const paired = Math.min(removed, added);
+  for (let i = 0; i < paired; i++) {
+    diffValues(from[head + i], to[head + i], `${path}/${head + i}`, out);
+  }
+  for (let i = removed - 1; i >= paired; i--) {
+    out.push({ op: "remove", path: `${path}/${head + i}` });
+  }
+  for (let i = paired; i < added; i++) {
+    out.push({ op: "add", path: `${path}/${head + i}`, value: structuredClone(to[head + i]) });
+  }
+}
+
+function diffValues(from: JsonValue, to: JsonValue, path: string, out: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from, to, path, out);
+  } else if (!jsonEqual(from, to)) {
+    out.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when passed to `applyPatch`.
+ *
+ * The patch is minimal in size rather than in operation count: it descends into objects and
+ * arrays and only emits `add`, `remove` and `replace` for the parts that differ, so identical
+ * documents give an empty patch. Neither input is mutated and the patch shares no structure with
+ * them. Members are visited in document order, so the result is deterministic.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diffValues(from, to, "", out);
+  return out;
+}
