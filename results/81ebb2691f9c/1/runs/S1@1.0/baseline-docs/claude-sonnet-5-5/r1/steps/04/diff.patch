+++ b/src/merge.ts
@@ -0,0 +1,33 @@
+import type { JsonValue } from "./pointer.ts";
+import { isObject, setMember } from "./object.ts";
+
+function merge(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result = isObject(target) ? target : {};
+  for (const [name, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[name];
+    } else {
+      setMember(result, name, merge(Object.hasOwn(result, name) ? result[name] : undefined, value));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies the JSON Merge Patch (RFC 7386) `patch` to `target` and returns the merged document.
+ *
+ * Object members of `patch` are merged recursively into `target`; a `null` member removes the
+ * member from the result, and any non-object `patch` (including an array) replaces `target`
+ * wholesale. Neither input is mutated and the result shares no structure with them. Because `null`
+ * means "remove", a merge patch cannot set a member to `null`; use JSON Patch for that.
+ * Throws if `patch` or `target` is not a JSON value.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (patch === undefined || target === undefined) {
+    throw new Error("JSON Merge Patch: target and patch must be JSON values");
+  }
+  return merge(structuredClone(target), patch);
+}
diff --git a/src/object.ts b/src/object.ts
new file mode 100644
index 0000000000000000000000000000000000000000..347d15a78d92eba96ad0ac12b69fb49a26694f4b
--- /dev/null
+++ b/src/object.ts
@@ -0,0 +1,17 @@
+import type { JsonValue } from "./pointer.ts";
+
+export type JsonObject = { [key: string]: JsonValue };
+
+export function isObject(value: unknown): value is JsonObject {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+// Defines the member rather than assigning it, so that "__proto__" stays an ordinary member.
+export function setMember(target: JsonObject, key: string, value: JsonValue): void {
+  Object.defineProperty(target, key, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
