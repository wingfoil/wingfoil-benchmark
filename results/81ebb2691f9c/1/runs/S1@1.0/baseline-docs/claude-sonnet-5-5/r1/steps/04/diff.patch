@@ -32,3 +32,18 @@ import { applyPatch } from "./src/index.ts";
 
 applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]); // { foo: "bar", baz: "qux" }
 ```
+
+## JSON Merge Patch (RFC 7386)
+
+`applyMergePatch(target, patch)` applies a JSON Merge Patch and returns the merged document as a new
+value; neither input is mutated, and the result shares no structure with them. Object members of the
+patch are merged recursively, a `null` member removes the member from the result, and any other patch
+value (including an array or a scalar) replaces the target wholesale. Because `null` means "remove", a
+merge patch cannot set a member to `null`; use JSON Patch for that. It throws if the target or patch is
+`undefined`.
+
+```ts
+import { applyMergePatch } from "./src/index.ts";
+
+applyMergePatch({ a: "b", c: { d: "e" } }, { a: "z", c: { d: null } }); // { a: "z", c: {} }
+```
