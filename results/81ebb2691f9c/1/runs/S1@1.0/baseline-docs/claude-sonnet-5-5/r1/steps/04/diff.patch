diff --git a/test/merge.test.ts b/test/merge.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ec516bd9067398dccafc18de5f437115f3e08a53
--- /dev/null
+++ b/test/merge.test.ts
@@ -0,0 +1,52 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+import type { JsonValue } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [JsonValue, JsonValue, JsonValue][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("does not mutate inputs or share structure", () => {
+  const target = { a: { b: 1 }, c: [1] };
+  const patch = { a: { d: { e: 2 } }, f: [3] };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 }, c: [1] });
+  assert.deepEqual(patch, { a: { d: { e: 2 } }, f: [3] });
+  assert.notEqual(result.c, target.c);
+  assert.notEqual(result.a.d, patch.a.d);
+  assert.notEqual(result.f, patch.f);
+});
+
+test("__proto__ and inherited names are ordinary members", () => {
+  const patch = JSON.parse('{"__proto__":{"x":1},"constructor":{"y":2}}');
+  const result = applyMergePatch({}, patch) as any;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as any).x, undefined);
+  assert.deepEqual(Object.keys(result), ["__proto__", "constructor"]);
+  assert.deepEqual(applyMergePatch({}, JSON.parse('{"toString":{"a":null}}')), { toString: {} });
+});
+
+test("rejects undefined target or patch", () => {
+  assert.throws(() => applyMergePatch(undefined as any, {}));
+  assert.throws(() => applyMergePatch({}, undefined as any));
+});
