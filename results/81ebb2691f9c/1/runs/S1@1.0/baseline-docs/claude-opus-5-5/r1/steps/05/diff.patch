@@ -0,0 +1,160 @@
+/**
+ * Creation of a JSON Patch (RFC 6902) from two versions of a document: the patch holds only the
+ * changes, so clients can send it instead of the whole new version.
+ *
+ * Objects are compared member by member and arrays element by element, aligned on their longest
+ * common subsequence, so that inserting or removing an element does not rewrite the elements after
+ * it. A value whose type changes is replaced.
+ */
+import { JsonPatchError, type JsonPatchOperation } from "./json-patch.ts";
+import { escapeToken, isObject, jsonEqual, toJson } from "./json-value.ts";
+
+/**
+ * Above this many removed and inserted elements, two arrays are compared by position rather than
+ * aligned, since aligning them takes time and memory that grow with the square of that number.
+ */
+const MAX_ALIGNED_EDITS = 1000;
+
+/**
+ * Returns a JSON Patch that turns `from` into `to` when applied with `applyPatch`. Neither argument
+ * is mutated, and the patch shares no object or array with them.
+ *
+ * The patch describes only what changed: members that are added, removed or changed, and array
+ * elements that are inserted, removed or changed, at the deepest location where the versions differ.
+ * Equal documents give an empty patch.
+ *
+ * Both arguments must be JSON values: `null`, booleans, finite numbers, strings, arrays and plain
+ * objects.
+ *
+ * @throws {JsonPatchError} when `from` or `to` is not a JSON value; its `index` is `undefined` and
+ *   the underlying error is available as `cause`.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const patch: JsonPatchOperation[] = [];
+  diff(copyJson(from, "from"), copyJson(to, "to"), "", patch);
+  return patch;
+}
+
+function copyJson(value: unknown, name: string): unknown {
+  try {
+    return toJson(value, "");
+  } catch (cause) {
+    throw new JsonPatchError(`cannot create a patch, ${name}: ${(cause as Error).message}`, undefined, undefined, { cause });
+  }
+}
+
+/** Appends to `patch` the operations that turn `from` into `to`, private copies found at `path`. */
+function diff(from: unknown, to: unknown, path: string, patch: JsonPatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, patch);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from, to, path, patch);
+  } else if (!jsonEqual(from, to)) {
+    patch.push({ op: "replace", path, value: to });
+  }
+}
+
+function diffObjects(from: Record<string, unknown>, to: Record<string, unknown>, path: string, patch: JsonPatchOperation[]): void {
+  for (const key of Object.keys(from)) {
+    const memberPath = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(to, key)) {
+      diff(from[key], to[key], memberPath, patch);
+    } else {
+      patch.push({ op: "remove", path: memberPath });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (!Object.hasOwn(from, key)) {
+      patch.push({ op: "add", path: `${path}/${escapeToken(key)}`, value: to[key] });
+    }
+  }
+}
+
+/**
+ * Between two consecutive elements kept from `from` to `to`, the elements that differ are changed in
+ * place pairwise, then the surplus is removed or inserted. Indexes are those of the array as the
+ * preceding operations left it.
+ */
+function diffArrays(from: unknown[], to: unknown[], path: string, patch: JsonPatchOperation[]): void {
+  let index = 0;
+  let fromIndex = 0;
+  let toIndex = 0;
+  for (const [fromKept, toKept] of [...commonElements(from, to), [from.length, to.length]]) {
+    for (; fromIndex < fromKept && toIndex < toKept; fromIndex += 1, toIndex += 1, index += 1) {
+      diff(from[fromIndex], to[toIndex], `${path}/${index}`, patch);
+    }
+    for (; fromIndex < fromKept; fromIndex += 1) {
+      patch.push({ op: "remove", path: `${path}/${index}` });
+    }
+    for (; toIndex < toKept; toIndex += 1, index += 1) {
+      patch.push({ op: "add", path: `${path}/${index}`, value: to[toIndex] });
+    }
+    fromIndex += 1;
+    toIndex += 1;
+    index += 1;
+  }
+}
+
+/**
+ * Returns, in order, the index pairs of a longest common subsequence of `from` and `to`, or none when
+ * more than MAX_ALIGNED_EDITS elements must be removed or inserted.
+ *
+ * This is the greedy algorithm of E. W. Myers, "An O(ND) Difference Algorithm and Its Variations"
+ * (1986): its cost grows with the number of differences rather than with the product of the lengths,
+ * so a small change to a long array stays cheap.
+ */
+function commonElements(from: unknown[], to: unknown[]): Array<[number, number]> {
+  // furthest[d][k + d] is the furthest index in `from` reached on diagonal k (index in `from` minus
+  // index in `to`) with d removals and insertions.
+  const furthest: Int32Array[] = [];
+  for (let d = 0; d <= Math.min(from.length + to.length, MAX_ALIGNED_EDITS); d += 1) {
+    const current = new Int32Array(2 * d + 1);
+    for (let k = -d; k <= d; k += 2) {
+      let x = d === 0 ? 0 : reach(furthest[d - 1], d, k);
+      let y = x - k;
+      while (x < from.length && y < to.length && jsonEqual(from[x], to[y])) {
+        x += 1;
+        y += 1;
+      }
+      current[k + d] = x;
+      if (x >= from.length && y >= to.length) {
+        furthest.push(current);
+        return backtrack(furthest, from.length, to.length);
+      }
+    }
+    furthest.push(current);
+  }
+  return [];
+}
+
+/** The furthest index in `from` on diagonal k after one more edit than `previous` holds. */
+function reach(previous: Int32Array, d: number, k: number): number {
+  return insertsBefore(previous, d, k) ? previous[k + 1 + d - 1] : previous[k - 1 + d - 1] + 1;
+}
+
+/** Whether the furthest path to diagonal k at step d ends with an insertion (from diagonal k + 1). */
+function insertsBefore(previous: Int32Array, d: number, k: number): boolean {
+  return k === -d || (k !== d && previous[k - 1 + d - 1] < previous[k + 1 + d - 1]);
+}
+
+/** Walks the furthest paths back from the end of both arrays and collects the kept elements. */
+function backtrack(furthest: Int32Array[], fromLength: number, toLength: number): Array<[number, number]> {
+  const pairs: Array<[number, number]> = [];
+  let x = fromLength;
+  let y = toLength;
+  for (let d = furthest.length - 1; d >= 0; d -= 1) {
+    const k = x - y;
+    // The point reached at step d - 1, then the point after the edit of step d (the origin for d = 0).
+    const previousK = d === 0 ? 0 : insertsBefore(furthest[d - 1], d, k) ? k + 1 : k - 1;
+    const previousX = d === 0 ? 0 : furthest[d - 1][previousK + d - 1];
+    const startX = previousK === k + 1 || d === 0 ? previousX : previousX + 1;
+    while (x > startX) {
+      x -= 1;
+      y -= 1;
+      pairs.push([x, y]);
+    }
+    x = previousX;
+    y = previousX - previousK;
+  }
+  return pairs.reverse();
+}
