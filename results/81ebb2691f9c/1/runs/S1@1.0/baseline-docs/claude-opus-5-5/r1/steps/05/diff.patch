index 0000000000000000000000000000000000000000..2aa80849b09248b7ecb51675e9fb4a6fab611a94
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,126 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch, JsonPatchError } from "../src/index.ts";
+
+function deepFreeze<T>(value: T): T {
+  if (typeof value === "object" && value !== null) {
+    for (const member of Object.values(value)) {
+      deepFreeze(member);
+    }
+    Object.freeze(value);
+  }
+  return value;
+}
+
+/** Creates the patch from frozen inputs, checks that it turns `from` into `to`, and returns it. */
+function roundTrip(from: unknown, to: unknown): unknown[] {
+  const patch = createPatch(deepFreeze(from), deepFreeze(to));
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: null }], c: "d" }, { c: "d", a: [1, { b: null }] }), []);
+});
+
+test("a changed member is replaced, and only it", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: { c: "x", d: [1, 2, 3] } }, { a: 1, b: { c: "y", d: [1, 2, 3] } }), [
+    { op: "replace", path: "/b/c", value: "y" },
+  ]);
+});
+
+test("added and removed members", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("a member set to null is replaced, not removed", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+});
+
+test("member names are escaped in paths", () => {
+  assert.deepEqual(roundTrip({ "a/b": { "c~d": 1 } }, { "a/b": { "c~d": 2 } }), [
+    { op: "replace", path: "/a~1b/c~0d", value: 2 },
+  ]);
+});
+
+test("a __proto__ member is an ordinary member", () => {
+  const from = JSON.parse('{"__proto__": {"a": 1}}');
+  const to = JSON.parse('{"__proto__": {"a": 2}, "b": 3}');
+  assert.deepEqual(roundTrip(from, to), [
+    { op: "replace", path: "/__proto__/a", value: 2 },
+    { op: "add", path: "/b", value: 3 },
+  ]);
+});
+
+test("an element inserted into an array is added alone", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [0, 1, 2, 3, 4]), [{ op: "add", path: "/0", value: 0 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+});
+
+test("an element removed from an array is removed alone", () => {
+  assert.deepEqual(roundTrip(["a", "b", "c", "d"], ["b", "c", "d"]), [{ op: "remove", path: "/0" }]);
+  assert.deepEqual(roundTrip(["a", "b", "c", "d"], ["a", "b", "d"]), [{ op: "remove", path: "/2" }]);
+});
+
+test("a changed array element is patched in place", () => {
+  const from = [{ id: 1, name: "a" }, { id: 2, name: "b" }, { id: 3, name: "c" }];
+  const to = [{ id: 1, name: "a" }, { id: 2, name: "B" }, { id: 3, name: "c" }];
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/1/name", value: "B" }]);
+});
+
+test("several array edits use the indexes of the array as it is being patched", () => {
+  roundTrip([1, 2, 3, 4, 5, 6], [0, 2, 3, 7, 8, 5, 6, 9]);
+  roundTrip(["a", "b", "c"], ["c", "b", "a"]);
+  roundTrip([1, 2, 3], []);
+  roundTrip([], [1, 2, 3]);
+  roundTrip([[1, 2], { a: 1 }, "x"], [{ a: 2 }, [1, 3], "y", "x"]);
+});
+
+test("a value of a different type is replaced", () => {
+  assert.deepEqual(roundTrip({ a: [1] }, { a: { 0: 1 } }), [{ op: "replace", path: "/a", value: { 0: 1 } }]);
+  assert.deepEqual(roundTrip({ a: 1 }, { a: "1" }), [{ op: "replace", path: "/a", value: "1" }]);
+});
+
+test("different root values replace the whole document", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip("a", null), [{ op: "replace", path: "", value: null }]);
+});
+
+test("a small change in a large document gives a small patch", () => {
+  const from = { items: Array.from({ length: 2000 }, (_, id) => ({ id, tags: ["t"] })) };
+  const to = structuredClone(from);
+  to.items[1500].tags.push("u");
+  to.items.splice(10, 1);
+  assert.deepEqual(roundTrip(from, to), [
+    { op: "remove", path: "/items/10" },
+    { op: "add", path: "/items/1499/tags/1", value: "u" },
+  ]);
+});
+
+test("large arrays that differ everywhere still give a correct patch", () => {
+  const from = Array.from({ length: 5000 }, (_, index) => index);
+  const to = Array.from({ length: 4000 }, (_, index) => index + 10_000);
+  roundTrip(from, to);
+});
+
+test("the patch shares no object or array with the inputs", () => {
+  const to = { a: { b: [1] } };
+  const patch = createPatch({}, to);
+  (patch[0] as { value: { b: number[] } }).value.b.push(2);
+  assert.deepEqual(to, { a: { b: [1] } });
+});
+
+test("inputs that are not JSON values are rejected", () => {
+  for (const [from, to] of [[{ a: undefined }, {}], [{}, { a: Number.NaN }], [new Date(0), {}], [{}, [() => 1]]]) {
+    assert.throws(() => createPatch(from, to), (error: unknown) => {
+      assert.ok(error instanceof JsonPatchError, String(error));
+      assert.equal(error.index, undefined);
+      assert.ok(error.cause instanceof Error);
+      return true;
+    });
+  }
+});
