+++ b/src/json-merge-patch.ts
@@ -0,0 +1,58 @@
+/**
+ * JSON Merge Patch (RFC 7386): a partial JSON document that describes changes to a target by
+ * mirroring its structure.
+ *
+ * Both inputs are validated and copied before merging, so the merge works on private values and
+ * never mutates or shares the caller's.
+ */
+import { isObject, setMember, toJson } from "./json-value.ts";
+
+/** Thrown when the target or the patch is not a JSON value. */
+export class JsonMergePatchError extends Error {
+  constructor(message: string, options?: ErrorOptions) {
+    super(`Invalid JSON Merge Patch: ${message}`, options);
+    this.name = "JsonMergePatchError";
+  }
+}
+
+/**
+ * Applies the merge patch `patch` to `target` and returns the merged document as a new value; neither
+ * argument is mutated and the result shares no object or array with them.
+ *
+ * An object patch changes the members it names: a `null` member removes the target member, an object
+ * member is merged recursively, and any other member replaces the target member. A patch that is not
+ * an object, including an array or `null`, replaces the whole target.
+ *
+ * Both arguments must be JSON values: `null`, booleans, finite numbers, strings, arrays and plain
+ * objects.
+ *
+ * @throws {JsonMergePatchError} when the target or the patch is not a JSON value. The underlying
+ *   error is available as `cause`.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return mergePatch(copyJson(target, "target"), copyJson(patch, "patch"));
+}
+
+function copyJson(value: unknown, name: string): unknown {
+  try {
+    return toJson(value, "");
+  } catch (cause) {
+    throw new JsonMergePatchError(`${name}: ${(cause as Error).message}`, { cause });
+  }
+}
+
+/** The MergePatch function of RFC 7386 section 2, on private copies that it may change. */
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return patch;
+  }
+  const result = isObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    if (patch[key] === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, mergePatch(Object.hasOwn(result, key) ? result[key] : undefined, patch[key]));
+    }
+  }
+  return result;
+}
