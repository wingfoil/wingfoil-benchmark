diff --git a/src/json-value.ts b/src/json-value.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b1b509eb6757d6fc83d353a452b0e3ac2d43ff7a
--- /dev/null
+++ b/src/json-value.ts
@@ -0,0 +1,44 @@
+/**
+ * Internal helpers for JSON values, shared by the patch formats: copying and validating values, and
+ * writing object members safely.
+ */
+
+/** Returns a deep copy of the JSON value `value`, which is found at `pointer` (used in errors). */
+export function toJson(value: unknown, pointer: string): unknown {
+  if (Array.isArray(value)) {
+    return Array.from(value, (item, index) => toJson(item, `${pointer}/${index}`));
+  }
+  if (isPlainObject(value)) {
+    const copy = {};
+    for (const key of Object.keys(value)) {
+      setMember(copy, key, toJson(value[key], `${pointer}/${escapeToken(key)}`));
+    }
+    return copy;
+  }
+  if (value === null || typeof value === "string" || typeof value === "boolean" || (typeof value === "number" && Number.isFinite(value))) {
+    return value;
+  }
+  throw new Error(`the value at ${JSON.stringify(pointer)} is not a JSON value`);
+}
+
+// Defining the member, rather than assigning it, makes "__proto__" an own member instead of
+// changing the object's prototype.
+export function setMember(object: object, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+export function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+export function isPlainObject(value: unknown): value is Record<string, unknown> {
+  if (!isObject(value)) {
+    return false;
+  }
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
+
+function escapeToken(token: string): string {
+  return token.replaceAll("~", "~0").replaceAll("/", "~1");
+}
diff --git a/test/json-merge-patch.test.ts b/test/json-merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d5b8a2cbf363aa6224cb8bd9dd98428cae19f4fc
--- /dev/null
+++ b/test/json-merge-patch.test.ts
@@ -0,0 +1,108 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch, JsonMergePatchError } from "../src/index.ts";
+
+function assertMergePatchError(target: unknown, patch: unknown): void {
+  assert.throws(() => applyMergePatch(target, patch), (error: unknown) => {
+    assert.ok(error instanceof JsonMergePatchError, String(error));
+    assert.ok(error.cause instanceof Error);
+    return true;
+  });
+}
+
+// The examples of RFC 7386, appendix A.
+const rfcExamples: Array<[unknown, unknown, unknown]> = [
+  [{ a: "b" }, { a: "c" }, { a: "c" }],
+  [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  [{ a: "b" }, { a: null }, {}],
+  [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+  [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+  [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  [["a", "b"], ["c", "d"], ["c", "d"]],
+  [{ a: "b" }, ["c"], ["c"]],
+  [{ a: "foo" }, null, null],
+  [{ a: "foo" }, "bar", "bar"],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: "b", c: null }, { a: "b" }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+
+for (const [index, [target, patch, expected]] of rfcExamples.entries()) {
+  test(`RFC 7386 appendix A, example ${index + 1}`, () => {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  });
+}
+
+test("RFC 7386 section 3 example", () => {
+  const target = {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = { title: "Hello!", phoneNumber: "+01-123-456-7890", author: { familyName: null }, tags: ["example"] };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+});
+
+test("an empty object patch returns an equal target", () => {
+  assert.deepEqual(applyMergePatch({ a: [1, { b: null }] }, {}), { a: [1, { b: null }] });
+});
+
+test("removing a missing member is not an error", () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, { b: null }), { a: 1 });
+});
+
+test("keeps null inside arrays, which replace the target value as a whole", () => {
+  assert.deepEqual(applyMergePatch({ a: [1] }, { a: [null, { b: null }] }), { a: [null, { b: null }] });
+});
+
+test("does not mutate the target or the patch, and shares no value with them", () => {
+  const target = { keep: { x: 1 }, change: { y: 2 } };
+  const patch = { change: { z: [3] }, added: { w: 4 } };
+  const result = applyMergePatch(target, patch) as Record<string, Record<string, unknown>>;
+  assert.deepEqual(target, { keep: { x: 1 }, change: { y: 2 } });
+  assert.deepEqual(patch, { change: { z: [3] }, added: { w: 4 } });
+  assert.notEqual(result.keep, target.keep);
+  assert.notEqual(result.change.z, patch.change.z);
+  assert.notEqual(result.added, patch.added);
+});
+
+test("a patch that is not an object returns a copy of it", () => {
+  const patch = [{ a: 1 }];
+  const result = applyMergePatch({}, patch);
+  assert.deepEqual(result, patch);
+  assert.notEqual(result, patch);
+});
+
+test("creates an own __proto__ member without touching any prototype", () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}}');
+  const result = applyMergePatch({}, patch) as Record<string, unknown>;
+  assert.ok(Object.hasOwn(result, "__proto__"));
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("rejects a target or a patch that is not JSON", () => {
+  assertMergePatchError({ a: undefined }, {});
+  assertMergePatchError({ a: 1 }, { b: Number.NaN });
+  assertMergePatchError({}, { a: { b: new Date(0) } });
+  assertMergePatchError(undefined, "x");
+});
+
+test("errors name the input and the location of the invalid value", () => {
+  assert.throws(() => applyMergePatch({}, { a: [1, undefined] }), {
+    name: "JsonMergePatchError",
+    message: 'Invalid JSON Merge Patch: patch: the value at "/a/1" is not a JSON value',
+  });
+  assert.throws(() => applyMergePatch({ a: () => 1 }, {}), {
+    message: 'Invalid JSON Merge Patch: target: the value at "/a" is not a JSON value',
+  });
+});
