index 0000000000000000000000000000000000000000..08f1af80875fb19499c19303322787f9d2a0fa0b
--- /dev/null
+++ b/src/json-pointer.ts
@@ -0,0 +1,97 @@
+/**
+ * JSON Pointer (RFC 6901): a string syntax identifying one value inside a JSON document.
+ *
+ * Only the plain string representation is handled. The URI fragment representation (`#/foo`)
+ * must be percent-decoded and stripped of its `#` by the caller before use.
+ */
+
+/** Thrown when a pointer is not a valid JSON Pointer or does not resolve to a value. */
+export class JsonPointerError extends Error {
+  /** The pointer that failed to parse or resolve. */
+  readonly pointer: string;
+
+  constructor(pointer: string, message: string) {
+    super(`Invalid JSON Pointer ${JSON.stringify(pointer)}: ${message}`);
+    this.name = "JsonPointerError";
+    this.pointer = pointer;
+  }
+}
+
+// RFC 6901 section 4: an array index is "0" or a digit sequence without a leading zero.
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+// RFC 6901 section 3: "~" may only be followed by "0" or "1".
+const INVALID_ESCAPE = /~(?![01])/;
+
+/**
+ * Splits a JSON Pointer into its unescaped reference tokens.
+ *
+ * `""` yields no token (the whole document); `"/"` yields one empty token.
+ * `~1` is decoded before `~0`, as RFC 6901 section 4 requires, so `~01` becomes `~1`.
+ *
+ * @throws {JsonPointerError} when the pointer is not a string, does not start with `/`,
+ *   or contains a `~` not followed by `0` or `1`.
+ */
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError(String(pointer), "a pointer must be a string");
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new JsonPointerError(pointer, 'a non-empty pointer must start with "/"');
+  }
+  if (INVALID_ESCAPE.test(pointer)) {
+    throw new JsonPointerError(pointer, '"~" must be followed by "0" or "1"');
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+function unescapeToken(token: string): string {
+  return token.replaceAll("~1", "/").replaceAll("~0", "~");
+}
+
+/**
+ * Returns the value of `document` that `pointer` refers to (the value itself, not a copy).
+ *
+ * Object members are matched by their own keys only, so inherited properties such as
+ * `constructor` never resolve. The `-` array token refers to a nonexistent element and
+ * therefore never resolves either.
+ *
+ * @throws {JsonPointerError} when the pointer is invalid or does not resolve to a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let value = document;
+  for (const token of parsePointer(pointer)) {
+    value = child(value, token, pointer);
+  }
+  return value;
+}
+
+function child(value: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(value)) {
+    return arrayElement(value, token, pointer);
+  }
+  if (typeof value === "object" && value !== null) {
+    return objectMember(value, token, pointer);
+  }
+  throw new JsonPointerError(pointer, `cannot read ${JSON.stringify(token)} of a non-container value`);
+}
+
+function arrayElement(array: readonly unknown[], token: string, pointer: string): unknown {
+  if (!ARRAY_INDEX.test(token)) {
+    throw new JsonPointerError(pointer, `${JSON.stringify(token)} is not an array index`);
+  }
+  const index = Number(token);
+  if (index >= array.length) {
+    throw new JsonPointerError(pointer, `index ${token} is out of range`);
+  }
+  return array[index];
+}
+
+function objectMember(object: object, token: string, pointer: string): unknown {
+  if (!Object.hasOwn(object, token)) {
+    throw new JsonPointerError(pointer, `member ${JSON.stringify(token)} does not exist`);
+  }
+  return (object as Record<string, unknown>)[token];
+}
diff --git a/test/json-pointer.test.ts b/test/json-pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..957889af43a40849eeafaf1571bf166513b9ed79
--- /dev/null
+++ b/test/json-pointer.test.ts
@@ -0,0 +1,106 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { JsonPointerError, parsePointer, resolvePointer } from "../src/index.ts";
+
+// The example document of RFC 6901, section 5.
+const rfcDocument = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("resolves every example of RFC 6901 section 5", () => {
+  const examples: Array<[string, unknown]> = [
+    ["", rfcDocument],
+    ["/foo", ["bar", "baz"]],
+    ["/foo/0", "bar"],
+    ["/", 0],
+    ["/a~1b", 1],
+    ["/c%d", 2],
+    ["/e^f", 3],
+    ["/g|h", 4],
+    ["/i\\j", 5],
+    ['/k"l', 6],
+    ["/ ", 7],
+    ["/m~0n", 8],
+  ];
+  for (const [pointer, expected] of examples) {
+    assert.deepEqual(resolvePointer(rfcDocument, pointer), expected, pointer);
+  }
+});
+
+test("returns the referenced value itself, not a copy", () => {
+  assert.equal(resolvePointer(rfcDocument, "/foo"), rfcDocument.foo);
+});
+
+test("resolves nested values and falsy values", () => {
+  const document = { a: { b: [null, { c: false }] } };
+  assert.equal(resolvePointer(document, "/a/b/0"), null);
+  assert.equal(resolvePointer(document, "/a/b/1/c"), false);
+});
+
+test("resolves the empty pointer on a scalar document", () => {
+  assert.equal(resolvePointer(42, ""), 42);
+});
+
+test("decodes ~1 before ~0, so ~01 is a literal ~1", () => {
+  assert.equal(resolvePointer({ "~1": "tilde-one", "/": "slash" }, "/~01"), "tilde-one");
+});
+
+test("rejects a pointer that does not start with /", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "foo"), JsonPointerError);
+  assert.throws(() => resolvePointer(rfcDocument, "#/foo"), JsonPointerError);
+});
+
+test("rejects invalid ~ escapes", () => {
+  for (const pointer of ["/m~n", "/m~2n", "/m~"]) {
+    assert.throws(() => resolvePointer(rfcDocument, pointer), JsonPointerError, pointer);
+  }
+});
+
+test("rejects a missing object member", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/missing"), JsonPointerError);
+});
+
+test("does not resolve inherited properties of objects", () => {
+  for (const pointer of ["/constructor", "/__proto__", "/toString", "/hasOwnProperty"]) {
+    assert.throws(() => resolvePointer({}, pointer), JsonPointerError, pointer);
+  }
+});
+
+test("rejects array indexes that are out of range or malformed", () => {
+  for (const pointer of ["/foo/2", "/foo/-", "/foo/01", "/foo/-1", "/foo/1.0", "/foo/", "/foo/ 1", "/foo/length", "/foo/1e0"]) {
+    assert.throws(() => resolvePointer(rfcDocument, pointer), JsonPointerError, pointer);
+  }
+});
+
+test("rejects descending into a scalar", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/foo/0/0"), JsonPointerError);
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"), JsonPointerError);
+  assert.throws(() => resolvePointer("text", "/0"), JsonPointerError);
+});
+
+test("rejects a pointer that is not a string", () => {
+  assert.throws(() => resolvePointer(rfcDocument, 7 as unknown as string), JsonPointerError);
+});
+
+test("parsePointer splits and unescapes the reference tokens", () => {
+  assert.deepEqual(parsePointer(""), []);
+  assert.deepEqual(parsePointer("/"), [""]);
+  assert.deepEqual(parsePointer("/a~1b/m~0n//0"), ["a/b", "m~n", "", "0"]);
+});
+
+test("errors carry the pointer that failed", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/foo/9"), (error: unknown) => {
+    assert.ok(error instanceof JsonPointerError);
+    assert.equal(error.pointer, "/foo/9");
+    return true;
+  });
+});
