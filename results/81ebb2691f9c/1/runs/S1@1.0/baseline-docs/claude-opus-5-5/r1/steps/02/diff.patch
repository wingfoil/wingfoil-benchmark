diff --git a/test/json-patch.test.ts b/test/json-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2b8a03329e81323e89d44e4cf29b37fdd91a6df4
--- /dev/null
+++ b/test/json-patch.test.ts
@@ -0,0 +1,243 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, JsonPatchError, type JsonPatchOperation } from "../src/index.ts";
+
+// Builds an untyped patch, for tests that feed malformed input as external callers could.
+function untyped(patch: unknown): JsonPatchOperation[] {
+  return patch as JsonPatchOperation[];
+}
+
+function assertPatchError(document: unknown, patch: unknown, index?: number): void {
+  assert.throws(() => applyPatch(document, untyped(patch)), (error: unknown) => {
+    assert.ok(error instanceof JsonPatchError, String(error));
+    assert.equal(error.index, index);
+    return true;
+  });
+}
+
+// The examples of RFC 6902, appendix A, that succeed.
+const rfcExamples: Array<[string, unknown, JsonPatchOperation[], unknown]> = [
+  ["A.1 adding an object member", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { baz: "qux", foo: "bar" }],
+  ["A.2 adding an array element", { foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] }],
+  ["A.3 removing an object member", { baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }],
+  ["A.4 removing an array element", { foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }],
+  ["A.5 replacing a value", { baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" }],
+  [
+    "A.6 moving a value",
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  ],
+  ["A.7 moving an array element", { foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], { foo: ["all", "cows", "eat", "grass"] }],
+  [
+    "A.8 testing a value: success",
+    { baz: "qux", foo: ["a", 2, "c"] },
+    [
+      { op: "test", path: "/baz", value: "qux" },
+      { op: "test", path: "/foo/1", value: 2 },
+    ],
+    { baz: "qux", foo: ["a", 2, "c"] },
+  ],
+  ["A.10 adding a nested member object", { foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } }],
+  [
+    "A.11 ignoring unrecognized elements",
+    { foo: "bar" },
+    untyped([{ op: "add", path: "/baz", value: "qux", xyz: 123 }]),
+    { foo: "bar", baz: "qux" },
+  ],
+  ["A.14 ~ escape ordering", { "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }],
+  ["A.16 adding an array value", { foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] }],
+];
+
+for (const [name, document, patch, expected] of rfcExamples) {
+  test(`RFC 6902 ${name}`, () => {
+    assert.deepEqual(applyPatch(document, patch), expected);
+  });
+}
+
+test("RFC 6902 A.9 testing a value: error", () => {
+  assertPatchError({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }], 0);
+});
+
+test("RFC 6902 A.12 adding to a nonexistent target", () => {
+  assertPatchError({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }], 0);
+});
+
+test("RFC 6902 A.15 comparing strings and numbers", () => {
+  assertPatchError({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }], 0);
+});
+
+test("applies the operations in order, each to the result of the previous one", () => {
+  const patch: JsonPatchOperation[] = [
+    { op: "add", path: "/list", value: [] },
+    { op: "add", path: "/list/-", value: 1 },
+    { op: "add", path: "/list/0", value: 0 },
+    { op: "copy", from: "/list", path: "/copy" },
+    { op: "replace", path: "/copy/1", value: "one" },
+    { op: "test", path: "/list", value: [0, 1] },
+  ];
+  assert.deepEqual(applyPatch({}, patch), { list: [0, 1], copy: [0, "one"] });
+});
+
+test("an empty patch returns an equal document", () => {
+  assert.deepEqual(applyPatch({ a: [1] }, []), { a: [1] });
+});
+
+test("does not mutate the document or the patch, and shares no value with them", () => {
+  const document = { a: { b: 1 }, list: [1, 2] };
+  const value = { nested: [1] };
+  const patch: JsonPatchOperation[] = [
+    { op: "add", path: "/a/c", value },
+    { op: "add", path: "/a/c/nested/-", value: 2 },
+    { op: "remove", path: "/list/0" },
+  ];
+  const result = applyPatch(document, patch) as { a: { b: number }; list: number[] };
+  assert.deepEqual(document, { a: { b: 1 }, list: [1, 2] });
+  assert.deepEqual(value, { nested: [1] });
+  assert.deepEqual(result, { a: { b: 1, c: { nested: [1, 2] } }, list: [2] });
+  result.a.b = 99;
+  assert.equal(document.a.b, 1);
+});
+
+test("does not mutate the document when an operation fails midway", () => {
+  const document = { a: 1 };
+  assertPatchError(document, [{ op: "add", path: "/b", value: 2 }, { op: "remove", path: "/missing" }], 1);
+  assert.deepEqual(document, { a: 1 });
+});
+
+test("add replaces an existing member and the whole document", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+});
+
+test("add appends at the index equal to the array length", () => {
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/1", value: 2 }]), [1, 2]);
+});
+
+test("add rejects out-of-range or malformed array indexes", () => {
+  for (const path of ["/2", "/-1", "/01", "/x", "/1.0"]) {
+    assertPatchError([1], [{ op: "add", path, value: 0 }], 0);
+  }
+});
+
+test("add rejects a parent that is a scalar", () => {
+  assertPatchError({ a: 1 }, [{ op: "add", path: "/a/b", value: 0 }], 0);
+});
+
+test("add creates an own __proto__ member without touching any prototype", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as object;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.ok(Object.hasOwn(result, "__proto__"));
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("remove rejects a missing target, including the - index and the whole document", () => {
+  assertPatchError({ a: [1] }, [{ op: "remove", path: "/b" }], 0);
+  assertPatchError({ a: [1] }, [{ op: "remove", path: "/a/1" }], 0);
+  assertPatchError({ a: [1] }, [{ op: "remove", path: "/a/-" }], 0);
+  assertPatchError({ a: [1] }, [{ op: "remove", path: "" }], 0);
+});
+
+test("replace changes the whole document and rejects a missing target", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: "x" }]), "x");
+  assertPatchError({ a: 1 }, [{ op: "replace", path: "/b", value: 2 }], 0);
+  assertPatchError([1], [{ op: "replace", path: "/1", value: 2 }], 0);
+});
+
+test("move to the same location leaves the document unchanged", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+});
+
+test("move rejects a destination inside the moved value and a missing source", () => {
+  assertPatchError({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b/c" }], 0);
+  assertPatchError({ a: { b: 1 } }, [{ op: "move", from: "", path: "/a" }], 0);
+  assertPatchError({ a: 1 }, [{ op: "move", from: "/b", path: "/c" }], 0);
+});
+
+test("move accepts a destination that only shares a string prefix with the source", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/ab" }]), { ab: 1 });
+});
+
+test("copy rejects a missing source", () => {
+  assertPatchError({ a: 1 }, [{ op: "copy", from: "/b", path: "/c" }], 0);
+});
+
+test("test compares JSON values structurally", () => {
+  const document = { o: { a: 1, b: [true, null] }, n: 1, s: "1" };
+  const passing: JsonPatchOperation[] = [
+    { op: "test", path: "/o", value: { b: [true, null], a: 1 } },
+    { op: "test", path: "/n", value: 1.0 },
+    { op: "test", path: "", value: document },
+  ];
+  assert.deepEqual(applyPatch(document, passing), document);
+  const failing: unknown[] = [
+    { o: { a: 1 } },
+    { o: { a: 1, b: [true, null], c: 2 } },
+    { o: { a: 1, b: [null, true] } },
+    { o: { a: 1, b: [true] } },
+    { n: "1" },
+    { n: true },
+    { s: 1 },
+    { o: [] },
+  ];
+  for (const values of failing) {
+    const [[key, value]] = Object.entries(values as object);
+    assertPatchError(document, [{ op: "test", path: `/${key}`, value }], 0);
+  }
+  assertPatchError({ a: null }, [{ op: "test", path: "/a", value: {} }], 0);
+  assertPatchError({ a: {} }, [{ op: "test", path: "/a", value: null }], 0);
+  assertPatchError({ a: [] }, [{ op: "test", path: "/a", value: {} }], 0);
+});
+
+test("test rejects a missing target", () => {
+  assertPatchError({}, [{ op: "test", path: "/a", value: null }], 0);
+});
+
+test("rejects a patch that is not an array of operation objects", () => {
+  assertPatchError({}, { op: "add", path: "/a", value: 1 });
+  assertPatchError({}, [null], 0);
+  assertPatchError({}, [[]], 0);
+});
+
+test("rejects operations with a missing or unknown op", () => {
+  assertPatchError({}, [{ path: "/a", value: 1 }], 0);
+  assertPatchError({}, [{ op: "merge", path: "/a", value: 1 }], 0);
+  assertPatchError({}, [{ op: "ADD", path: "/a", value: 1 }], 0);
+});
+
+test("rejects operations with a missing or invalid path or from", () => {
+  assertPatchError({}, [{ op: "add", value: 1 }], 0);
+  assertPatchError({}, [{ op: "add", path: "a", value: 1 }], 0);
+  assertPatchError({}, [{ op: "add", path: "/a~2", value: 1 }], 0);
+  assertPatchError({}, [{ op: "remove", path: 1 }], 0);
+  assertPatchError({ a: 1 }, [{ op: "move", path: "/b" }], 0);
+  assertPatchError({ a: 1 }, [{ op: "copy", from: "a", path: "/b" }], 0);
+});
+
+test("rejects add, replace and test without a value, but accepts a null value", () => {
+  for (const op of ["add", "replace", "test"]) {
+    assertPatchError({ a: 1 }, [{ op, path: "/a" }], 0);
+  }
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "/a", value: null }]), { a: null });
+});
+
+test("rejects values that are not JSON", () => {
+  for (const value of [undefined, Number.NaN, Infinity, () => 1, 1n, new Date(0), [undefined], { a: Symbol("x") }]) {
+    assertPatchError({}, [{ op: "add", path: "/a", value }], 0);
+  }
+});
+
+test("validates the whole patch before applying any operation", () => {
+  assertPatchError({}, [{ op: "test", path: "/missing", value: 1 }, { op: "nope" }], 1);
+});
+
+test("errors carry the failing operation and the cause", () => {
+  const operation = { op: "remove", path: "/a/9" } as const;
+  assert.throws(() => applyPatch({ a: [] }, [{ op: "test", path: "", value: { a: [] } }, operation]), (error: unknown) => {
+    assert.ok(error instanceof JsonPatchError);
+    assert.equal(error.index, 1);
+    assert.equal(error.operation, operation);
+    assert.ok(error.cause instanceof Error);
+    return true;
+  });
+});
