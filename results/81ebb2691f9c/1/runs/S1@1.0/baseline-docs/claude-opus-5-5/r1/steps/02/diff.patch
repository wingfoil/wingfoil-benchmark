@@ -0,0 +1,241 @@
+/**
+ * JSON Patch (RFC 6902): a sequence of operations that changes a JSON document.
+ *
+ * The patch is validated as a whole before any operation runs, then the operations are applied in
+ * order to a private copy of the document, so a failing patch leaves the caller's values untouched.
+ */
+import { isArrayIndex, parsePointer, resolvePointer } from "./json-pointer.ts";
+
+/** One operation of a JSON Patch. Members other than those of its `op` are ignored. */
+export type JsonPatchOperation =
+  | { readonly op: "add" | "replace" | "test"; readonly path: string; readonly value: unknown }
+  | { readonly op: "remove"; readonly path: string }
+  | { readonly op: "move" | "copy"; readonly from: string; readonly path: string };
+
+/** Thrown when a patch is invalid or one of its operations fails. */
+export class JsonPatchError extends Error {
+  /** Position of the failing operation in the patch, or `undefined` when the patch itself is invalid. */
+  readonly index: number | undefined;
+  /** The failing operation, as given in the patch, or `undefined` when the patch itself is invalid. */
+  readonly operation: unknown;
+
+  constructor(message: string, index?: number, operation?: unknown, options?: ErrorOptions) {
+    super(index === undefined ? `Invalid JSON Patch: ${message}` : `JSON Patch operation ${index} failed: ${message}`, options);
+    this.name = "JsonPatchError";
+    this.index = index;
+    this.operation = operation;
+  }
+}
+
+const OPERATIONS = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+
+/**
+ * Applies `patch` to `document` and returns the result as a new value; neither argument is mutated
+ * and the result shares no object or array with them.
+ *
+ * Both the document and the operation values must be JSON values: `null`, booleans, finite numbers,
+ * strings, arrays and plain objects.
+ *
+ * @throws {JsonPatchError} when the document or the patch is invalid, or when an operation fails
+ *   (its target does not exist, or a `test` does not match). The underlying error, such as a
+ *   `JsonPointerError`, is available as `cause`.
+ */
+export function applyPatch(document: unknown, patch: readonly JsonPatchOperation[]): unknown {
+  const operations = validatePatch(patch);
+  let result = attempt(() => toJson(document, ""));
+  operations.forEach((operation, index) => {
+    result = attempt(() => applyOperation(result, operation), index, patch[index]);
+  });
+  return result;
+}
+
+function attempt<T>(action: () => T, index?: number, operation?: unknown): T {
+  try {
+    return action();
+  } catch (cause) {
+    const message = cause instanceof Error ? cause.message : String(cause);
+    throw new JsonPatchError(message, index, operation, { cause });
+  }
+}
+
+function validatePatch(patch: unknown): JsonPatchOperation[] {
+  if (!Array.isArray(patch)) {
+    throw new JsonPatchError("a patch must be an array of operations");
+  }
+  return patch.map((operation: unknown, index) => attempt(() => validateOperation(operation), index, operation));
+}
+
+/** Checks one operation and returns a copy of it holding only its known members, with a private value. */
+function validateOperation(operation: unknown): JsonPatchOperation {
+  if (!isPlainObject(operation)) {
+    throw new Error("an operation must be an object");
+  }
+  const { op } = operation;
+  if (typeof op !== "string" || !OPERATIONS.has(op)) {
+    throw new Error(`unknown op ${JSON.stringify(op)}`);
+  }
+  const path = pointerMember(operation, "path");
+  switch (op) {
+    case "remove":
+      return { op, path };
+    case "move":
+    case "copy":
+      return { op, from: pointerMember(operation, "from"), path };
+    default:
+      if (!Object.hasOwn(operation, "value")) {
+        throw new Error(`a ${op} operation needs a value`);
+      }
+      return { op: op as "add" | "replace" | "test", path, value: toJson(operation.value, "") };
+  }
+}
+
+function pointerMember(operation: Record<string, unknown>, name: string): string {
+  const pointer = operation[name];
+  if (typeof pointer !== "string") {
+    throw new Error(`"${name}" must be a JSON Pointer string`);
+  }
+  parsePointer(pointer);
+  return pointer;
+}
+
+function applyOperation(document: unknown, operation: JsonPatchOperation): unknown {
+  switch (operation.op) {
+    case "add":
+      return add(document, operation.path, operation.value);
+    case "remove":
+      return remove(document, operation.path);
+    case "replace":
+      return replace(document, operation.path, operation.value);
+    case "move":
+      return move(document, operation.from, operation.path);
+    case "copy":
+      return add(document, operation.path, toJson(resolvePointer(document, operation.from), operation.from));
+    case "test":
+      return test(document, operation.path, operation.value);
+  }
+}
+
+function add(document: unknown, path: string, value: unknown): unknown {
+  if (path === "") {
+    return value;
+  }
+  const { container, key } = parent(document, path);
+  if (Array.isArray(container)) {
+    container.splice(insertionIndex(container, key), 0, value);
+  } else if (isObject(container)) {
+    setMember(container, key, value);
+  } else {
+    throw new Error(`cannot add ${JSON.stringify(key)} to a non-container value`);
+  }
+  return document;
+}
+
+function insertionIndex(array: readonly unknown[], token: string): number {
+  if (token === "-") {
+    return array.length;
+  }
+  if (!isArrayIndex(token) || Number(token) > array.length) {
+    throw new Error(`${JSON.stringify(token)} is not an index where an element can be inserted`);
+  }
+  return Number(token);
+}
+
+function remove(document: unknown, path: string): unknown {
+  if (path === "") {
+    throw new Error("cannot remove the whole document");
+  }
+  resolvePointer(document, path);
+  const { container, key } = parent(document, path);
+  if (Array.isArray(container)) {
+    container.splice(Number(key), 1);
+  } else {
+    delete (container as Record<string, unknown>)[key];
+  }
+  return document;
+}
+
+function replace(document: unknown, path: string, value: unknown): unknown {
+  if (path === "") {
+    return value;
+  }
+  resolvePointer(document, path);
+  const { container, key } = parent(document, path);
+  setMember(container as Record<string, unknown>, key, value);
+  return document;
+}
+
+function move(document: unknown, from: string, path: string): unknown {
+  if (path.startsWith(`${from}/`)) {
+    throw new Error(`cannot move ${JSON.stringify(from)} into its own descendant ${JSON.stringify(path)}`);
+  }
+  const value = resolvePointer(document, from);
+  if (from === path) {
+    return document;
+  }
+  return add(remove(document, from), path, value);
+}
+
+function test(document: unknown, path: string, expected: unknown): unknown {
+  if (!jsonEqual(resolvePointer(document, path), expected)) {
+    throw new Error(`the value at ${JSON.stringify(path)} is not equal to the expected value`);
+  }
+  return document;
+}
+
+/** Resolves the container of the non-empty `path` and returns it with the last, unescaped token. */
+function parent(document: unknown, path: string): { container: unknown; key: string } {
+  const key = parsePointer(path).at(-1) as string;
+  return { container: resolvePointer(document, path.slice(0, path.lastIndexOf("/"))), key };
+}
+
+// Defining the member, rather than assigning it, makes "__proto__" an own member instead of
+// changing the object's prototype.
+function setMember(object: object, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** RFC 6902 section 4.6: arrays are equal element-wise, objects member-wise in any order. */
+function jsonEqual(left: unknown, right: unknown): boolean {
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return Array.isArray(left) && Array.isArray(right) && left.length === right.length && left.every((item, index) => jsonEqual(item, right[index]));
+  }
+  if (isObject(left) && isObject(right)) {
+    const keys = Object.keys(left);
+    return keys.length === Object.keys(right).length && keys.every((key) => Object.hasOwn(right, key) && jsonEqual(left[key], right[key]));
+  }
+  return left === right;
+}
+
+/** Returns a deep copy of the JSON value `value`, which is found at `pointer` (used in errors). */
+function toJson(value: unknown, pointer: string): unknown {
+  if (Array.isArray(value)) {
+    return Array.from(value, (item, index) => toJson(item, `${pointer}/${index}`));
+  }
+  if (isPlainObject(value)) {
+    const copy = {};
+    for (const key of Object.keys(value)) {
+      setMember(copy, key, toJson(value[key], `${pointer}/${escapeToken(key)}`));
+    }
+    return copy;
+  }
+  if (value === null || typeof value === "string" || typeof value === "boolean" || (typeof value === "number" && Number.isFinite(value))) {
+    return value;
+  }
+  throw new Error(`the value at ${JSON.stringify(pointer)} is not a JSON value`);
+}
+
+function escapeToken(token: string): string {
+  return token.replaceAll("~", "~0").replaceAll("/", "~1");
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  if (!isObject(value)) {
+    return false;
+  }
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
