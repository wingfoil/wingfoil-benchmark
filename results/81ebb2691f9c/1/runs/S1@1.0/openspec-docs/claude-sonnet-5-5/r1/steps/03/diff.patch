diff --git a/test/patch.test.ts b/test/patch.test.ts
index 7e095135d1f4211ba28901ad39978511afa9008b..e7c330d1cb4f7018ff95c612ea0cdb97a3ec42e6 100644
--- a/test/patch.test.ts
+++ b/test/patch.test.ts
@@ -22,3 +22,13 @@ test("errors", () => {
   assert.throws(() => applyPatch({}, [{ op: "bogus", path: "" }]));
   assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]));
 });
+test("RFC 6902 edge cases", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.deepEqual(applyPatch([1, 2], [{ op: "move", from: "/0", path: "/1" }]), [2, 1]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: null }]), null);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "copy", from: "/a", path: "/b", value: 3 }]), { a: 1, b: 1 });
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/1", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/01", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/-" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 2 }]));
+});
