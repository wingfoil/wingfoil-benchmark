new file mode 100644
index 0000000000000000000000000000000000000000..0d850c5c1540ceae4f1ca4aa6f2cf7d3c8ce9e43
--- /dev/null
+++ b/src/merge-patch.ts
@@ -0,0 +1,31 @@
+const has = (o: object, k: string) => Object.prototype.hasOwnProperty.call(o, k);
+
+type Obj = Record<string, unknown>;
+
+const isObject = (v: unknown): v is Obj => typeof v === "object" && v !== null && !Array.isArray(v);
+
+function setMember(obj: Obj, key: string, value: unknown): void {
+  // defineProperty so that a "__proto__" member stays an ordinary member.
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(clone);
+  if (isObject(value)) {
+    const out: Obj = {};
+    for (const [k, v] of Object.entries(value)) setMember(out, k, clone(v));
+    return out;
+  }
+  return value;
+}
+
+/** Applies a JSON Merge Patch (RFC 7386, section 2). Neither argument is modified. */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch);
+  const out: Obj = isObject(target) ? (clone(target) as Obj) : {};
+  for (const [k, v] of Object.entries(patch)) {
+    if (v === null) delete out[k];
+    else setMember(out, k, applyMergePatch(has(out, k) ? out[k] : undefined, v));
+  }
+  return out;
+}
