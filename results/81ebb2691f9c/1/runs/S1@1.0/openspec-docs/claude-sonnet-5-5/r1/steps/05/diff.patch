index 0000000000000000000000000000000000000000..b80f372d0a20a2a1325efb3cefac07b803790ed2
--- /dev/null
+++ b/src/diff.ts
@@ -0,0 +1,75 @@
+type Op = { op: "add" | "remove" | "replace"; path: string; value?: unknown };
+
+const has = (o: object, k: string) => Object.prototype.hasOwnProperty.call(o, k);
+const isObject = (v: unknown): v is Record<string, unknown> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+const escapeToken = (token: string) => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+function clone<T>(value: T): T {
+  if (Array.isArray(value)) return value.map(clone) as T;
+  if (isObject(value)) {
+    const out: Record<string, unknown> = {};
+    for (const [k, v] of Object.entries(value)) {
+      // defineProperty so that a "__proto__" member stays an ordinary member.
+      Object.defineProperty(out, k, { value: clone(v), writable: true, enumerable: true, configurable: true });
+    }
+    return out as T;
+  }
+  return value;
+}
+
+function equal(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => equal(v, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const ka = Object.keys(a);
+    return ka.length === Object.keys(b).length && ka.every((k) => has(b, k) && equal(a[k], b[k]));
+  }
+  return a === b;
+}
+
+function diff(from: unknown, to: unknown, path: string, ops: Op[]): void {
+  if (equal(from, to)) return;
+  if (isObject(from) && isObject(to)) {
+    for (const k of Object.keys(from)) {
+      if (!has(to, k)) ops.push({ op: "remove", path: `${path}/${escapeToken(k)}` });
+    }
+    for (const k of Object.keys(to)) {
+      const p = `${path}/${escapeToken(k)}`;
+      if (has(from, k)) diff(from[k], to[k], p, ops);
+      else ops.push({ op: "add", path: p, value: clone(to[k]) });
+    }
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    // Skip the common head and tail, so an insertion or removal does not rewrite what follows it.
+    let start = 0;
+    while (start < from.length && start < to.length && equal(from[start], to[start])) start++;
+    let endFrom = from.length;
+    let endTo = to.length;
+    while (endFrom > start && endTo > start && equal(from[endFrom - 1], to[endTo - 1])) {
+      endFrom--;
+      endTo--;
+    }
+    const common = Math.min(endFrom, endTo) - start;
+    for (let i = 0; i < common; i++) diff(from[start + i], to[start + i], `${path}/${start + i}`, ops);
+    // Remove from the highest index down so earlier removals do not shift later ones.
+    for (let i = endFrom - 1; i >= start + common; i--) ops.push({ op: "remove", path: `${path}/${i}` });
+    for (let i = start + common; i < endTo; i++) {
+      ops.push({ op: "add", path: `${path}/${i}`, value: clone(to[i]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied,
+ * describing only what changed. Neither input is mutated.
+ */
+export function createPatch(from: unknown, to: unknown): Op[] {
+  const ops: Op[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
