@@ -0,0 +1,29 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createPatch } from "../src/diff.ts";
+import { applyPatch } from "../src/patch.ts";
+
+const roundTrip = (a: unknown, b: unknown) => {
+  const ca = JSON.stringify(a), cb = JSON.stringify(b);
+  const p = createPatch(a, b);
+  assert.deepEqual(applyPatch(a, p), b);
+  assert.equal(JSON.stringify(a), ca);
+  assert.equal(JSON.stringify(b), cb);
+  return p;
+};
+
+test("minimal patches", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: { c: [1, 2, 3] } }, { a: 1, b: { c: [1, 2, 3] } }), []);
+  assert.deepEqual(roundTrip({ a: 1, b: { c: 2 } }, { a: 1, b: { c: 3 } }), [{ op: "replace", path: "/b/c", value: 3 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 9, 2, 3, 4]), [{ op: "add", path: "/1", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 4]), [{ op: "remove", path: "/2" }, { op: "remove", path: "/1" }]);
+});
+test("edge cases", () => {
+  roundTrip(1, 2);
+  roundTrip({ a: 1 }, [1]);
+  roundTrip(null, { a: null });
+  roundTrip({ "a/b": 1, "m~n": 2, "": 3 }, { "a/b": 2, "m~n": 2 });
+  roundTrip({ a: [1, [2, 3], { x: 1 }] }, { a: [[2, 4], { x: 2 }, 5, 6] });
+  roundTrip({}, JSON.parse('{"__proto__": {"x": 1}}'));
+  roundTrip(JSON.parse('{"__proto__": 1}'), JSON.parse('{"__proto__": 2}'));
+});
