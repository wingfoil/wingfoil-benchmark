+++ b/src/index.ts
@@ -202,3 +202,24 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   }
   return doc;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the result as a new value.
+ * The inputs are not mutated. A non-object patch replaces the target; a null member of an object patch
+ * removes the member from the target (including inside nested patch values).
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJson(patch);
+  return mergePatch(target, patch);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch);
+  const result: Record<string, unknown> = isObject(target) ? (clone(target) as Record<string, unknown>) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) delete result[key];
+    else setMember(result, key, mergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+  }
+  return result;
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c056fd6347a63fcd67c581b9730fc5368885ac61
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,23 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 example", () => {
+  const target = { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["example", "sample"], content: "x" };
+  const patch = { title: "Hello!", phoneNumber: "+01-123-456-7890", author: { familyName: null }, tags: ["example"] };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!", author: { givenName: "John" }, tags: ["example"], content: "x", phoneNumber: "+01-123-456-7890",
+  });
+});
+
+test("non-object patch replaces; non-object target is treated as {}", () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, [1]), [1]);
+  assert.deepEqual(applyMergePatch([1], { a: 1 }), { a: 1 });
+  assert.equal(applyMergePatch({ a: 1 }, null), null);
+});
+
+test("strips nulls in new nested objects and does not mutate", () => {
+  const target = { a: { b: 1 } };
+  assert.deepEqual(applyMergePatch(target, { c: { d: null, e: 1 } }), { a: { b: 1 }, c: { e: 1 } });
+  assert.deepEqual(target, { a: { b: 1 } });
+});
