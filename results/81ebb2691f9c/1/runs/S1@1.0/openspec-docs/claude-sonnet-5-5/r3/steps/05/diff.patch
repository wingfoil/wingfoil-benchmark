index 0000000000000000000000000000000000000000..a748ae30c5a31b65d2eb93877c79e34b695ac41b
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,28 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createPatch } from "../src/diff.ts";
+import { applyPatch } from "../src/patch.ts";
+
+const roundTrip = (a: unknown, b: unknown) => {
+  const before = JSON.stringify(a);
+  const p = createPatch(a, b);
+  assert.equal(JSON.stringify(a), before);
+  assert.deepEqual(applyPatch(a, p), b);
+  return p;
+};
+
+test("minimal patches", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: { c: [1, 2, 3] } }, { a: 1, b: { c: [1, 2, 3] } }), []);
+  assert.deepEqual(roundTrip({ a: 1, b: { c: 2 } }, { a: 1, b: { c: 3 } }), [{ op: "replace", path: "/b/c", value: 3 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip({ "a/b~": 1 }, {}), [{ op: "remove", path: "/a~1b~0" }]);
+});
+
+test("round trips", () => {
+  roundTrip(1, "x");
+  roundTrip([1, 2, 3, 4, 5], [1, 7]);
+  roundTrip([1], [5, 6, 7]);
+  roundTrip({ a: [{ x: 1 }, { y: 2 }] }, { a: [{ x: 2 }] });
+  roundTrip({ a: null }, { a: [] });
+  roundTrip(JSON.parse('{"__proto__":{"a":1}}'), JSON.parse('{"__proto__":{"a":2}}'));
+});
