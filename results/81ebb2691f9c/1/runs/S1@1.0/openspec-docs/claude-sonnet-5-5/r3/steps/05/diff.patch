@@ -0,0 +1,54 @@
+import { clone, equal, isObject } from "./patch.ts";
+import type { Json } from "./pointer.ts";
+
+export type Operation =
+  | { op: "add" | "replace"; path: string; value: Json }
+  | { op: "remove"; path: string };
+
+const has = (o: object, k: string): boolean => Object.prototype.hasOwnProperty.call(o, k);
+const escapeToken = (t: string): string => t.replace(/~/g, "~0").replace(/\//g, "~1");
+
+function diffArrays(a: Json[], b: Json[], path: string, ops: Operation[]): void {
+  let start = 0;
+  while (start < a.length && start < b.length && equal(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && equal(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const common = Math.min(endA, endB) - start;
+  for (let i = 0; i < common; i++) diff(a[start + i], b[start + i], `${path}/${start + i}`, ops);
+  // Remove surplus elements from the end so earlier indices stay valid.
+  for (let i = endA - 1; i >= start + common; i--) ops.push({ op: "remove", path: `${path}/${i}` });
+  for (let i = start + common; i < endB; i++) {
+    ops.push({ op: "add", path: `${path}/${i}`, value: clone(b[i]) });
+  }
+}
+
+function diff(a: Json, b: Json, path: string, ops: Operation[]): void {
+  if (equal(a, b)) return;
+  if (Array.isArray(a) && Array.isArray(b)) return diffArrays(a, b, path, ops);
+  if (isObject(a) && isObject(b)) {
+    for (const k of Object.keys(a)) {
+      if (!has(b, k)) ops.push({ op: "remove", path: `${path}/${escapeToken(k)}` });
+    }
+    for (const k of Object.keys(b)) {
+      const p = `${path}/${escapeToken(k)}`;
+      if (!has(a, k)) ops.push({ op: "add", path: p, value: clone(b[k]) });
+      else diff(a[k], b[k], p, ops);
+    }
+    return;
+  }
+  ops.push({ op: "replace", path, value: clone(b) });
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only the
+ * parts that differ. Neither input is modified, and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const ops: Operation[] = [];
+  diff(from as Json, to as Json, "", ops);
+  return ops;
+}
