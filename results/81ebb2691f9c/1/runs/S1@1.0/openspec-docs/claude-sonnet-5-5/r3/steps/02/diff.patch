index fe12a490292aceabeead30201ae52c8a609abd54..1b308b8a892269525a5d15d65a41adc8ff63f2d1 100644
--- a/src/pointer.ts
+++ b/src/pointer.ts
@@ -9,6 +9,18 @@ function unescapeToken(token: string): string {
   return token.replace(/~1/g, "/").replace(/~0/g, "~");
 }
 
+/** Splits a JSON Pointer (RFC 6901) into its unescaped reference tokens. */
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
 /**
  * Returns the value that a JSON Pointer (RFC 6901) refers to in a document.
  * Throws if the pointer is syntactically invalid or does not resolve to a value.
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..086ffc0c83005e36c04b94ff5ef2d845953b589e
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,49 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/patch.ts";
+
+const ap = (d: unknown, p: unknown) => applyPatch(d, p);
+
+test("RFC 6902 examples", () => {
+  assert.deepEqual(ap({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(ap({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(ap({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(ap({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+  assert.deepEqual(ap({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+  assert.deepEqual(ap({ baz: "qux" }, [{ op: "replace", path: "/baz", value: "boo" }]), { baz: "boo" });
+  assert.deepEqual(
+    ap({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(ap({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(ap({ foo: { bar: [1] } }, [{ op: "copy", from: "/foo/bar", path: "/baz" }]), { foo: { bar: [1] }, baz: [1] });
+  assert.deepEqual(ap({ baz: "qux" }, [{ op: "test", path: "/baz", value: "qux" }]), { baz: "qux" });
+});
+
+test("failures", () => {
+  assert.throws(() => ap({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]));
+  assert.throws(() => ap({}, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.throws(() => ap({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => ap({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => ap([1], [{ op: "add", path: "/2", value: 1 }]));
+  assert.throws(() => ap([1], [{ op: "add", path: "/01", value: 1 }]));
+  assert.throws(() => ap([1], [{ op: "replace", path: "/-", value: 1 }]));
+  assert.throws(() => ap({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => ap({}, [{ op: "add", path: "/a" }]));
+  assert.throws(() => ap({}, [{ op: "bogus", path: "/a" }]));
+  assert.throws(() => ap({}, { op: "add" }));
+  assert.throws(() => ap({}, [{ op: "copy", path: "/a" }]));
+});
+
+test("root, equality, no mutation", () => {
+  assert.deepEqual(ap({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(ap({ a: 1, b: [1, { c: 2 }] }, [{ op: "test", path: "", value: { b: [1, { c: 2 }], a: 1 } }]), { a: 1, b: [1, { c: 2 }] });
+  assert.throws(() => ap({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]));
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const patch = [{ op: "add", path: "/x", value: { y: 1 } }, { op: "remove", path: "/a/0" }, { op: "copy", from: "/x", path: "/z" }];
+  const out = ap(doc, patch) as any;
+  assert.deepEqual(doc, { a: [1, 2], b: { c: 1 } });
+  out.x.y = 9;
+  assert.equal((patch[0] as any).value.y, 1);
+  assert.equal(out.z.y, 1);
+});
