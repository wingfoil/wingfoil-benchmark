+++ b/src/patch.ts
@@ -0,0 +1,181 @@
+import { parsePointer } from "./pointer.ts";
+import type { Json } from "./pointer.ts";
+
+type Container = Json[] | { [key: string]: Json };
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const has = (o: object, k: string): boolean => Object.prototype.hasOwnProperty.call(o, k);
+
+function isObject(v: unknown): v is { [key: string]: Json } {
+  return typeof v === "object" && v !== null && !Array.isArray(v);
+}
+
+function setMember(obj: { [key: string]: Json }, key: string, value: Json): void {
+  // defineProperty keeps keys such as "__proto__" as plain own members.
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone(value: Json): Json {
+  if (Array.isArray(value)) return value.map(clone);
+  if (isObject(value)) {
+    const out: { [key: string]: Json } = {};
+    for (const k of Object.keys(value)) setMember(out, k, clone(value[k]));
+    return out;
+  }
+  return value;
+}
+
+function equal(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((x, i) => equal(x, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const ka = Object.keys(a);
+    return ka.length === Object.keys(b).length && ka.every((k) => has(b, k) && equal(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** Walks to the container holding the last token of the pointer. */
+function parentOf(doc: Json, tokens: string[], path: string): Container {
+  let current: Json = doc;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`Path "${path}" does not resolve at "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (isObject(current) && has(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path "${path}" does not resolve at "${token}"`);
+    }
+  }
+  if (typeof current !== "object" || current === null) {
+    throw new Error(`Path "${path}" does not resolve: parent is a scalar`);
+  }
+  return current;
+}
+
+function get(doc: Json, path: string): Json {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return doc;
+  const parent = parentOf(doc, tokens, path);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(last) || Number(last) >= parent.length) {
+      throw new Error(`Path "${path}" does not exist`);
+    }
+    return parent[Number(last)];
+  }
+  if (!has(parent, last)) throw new Error(`Path "${path}" does not exist`);
+  return parent[last];
+}
+
+function add(doc: Json, path: string, value: Json): Json {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(doc, tokens, path);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (last === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(last) && Number(last) <= parent.length) {
+      parent.splice(Number(last), 0, value);
+    } else {
+      throw new Error(`Cannot add at "${path}": invalid array index`);
+    }
+  } else {
+    setMember(parent, last, value);
+  }
+  return doc;
+}
+
+function remove(doc: Json, path: string): Json {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) throw new Error("Cannot remove the document root");
+  get(doc, path); // must exist
+  const parent = parentOf(doc, tokens, path);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete parent[last];
+  return doc;
+}
+
+function replace(doc: Json, path: string, value: Json): Json {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return value;
+  get(doc, path); // must exist
+  const parent = parentOf(doc, tokens, path);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(last)] = value;
+  else setMember(parent, last, value);
+  return doc;
+}
+
+function member(op: Record<string, unknown>, name: string, index: number): unknown {
+  if (!has(op, name) || op[name] === undefined) {
+    throw new Error(`Invalid patch: operation ${index} is missing "${name}"`);
+  }
+  return op[name];
+}
+
+function pointerMember(op: Record<string, unknown>, name: string, index: number): string {
+  const v = member(op, name, index);
+  if (typeof v !== "string") {
+    throw new Error(`Invalid patch: "${name}" of operation ${index} must be a string`);
+  }
+  parsePointer(v);
+  return v;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a document and returns the result as a new value.
+ * The input document and patch are never modified. Throws if the patch is invalid or
+ * any operation fails; in that case no result is produced.
+ */
+export function applyPatch(document: unknown, patch: unknown): Json {
+  if (!Array.isArray(patch)) throw new Error("Invalid patch: must be an array of operations");
+
+  let doc = clone(document as Json);
+  patch.forEach((raw: unknown, i: number) => {
+    if (!isObject(raw)) throw new Error(`Invalid patch: operation ${i} is not an object`);
+    const op = raw as Record<string, unknown>;
+    const path = pointerMember(op, "path", i);
+    switch (op.op) {
+      case "add":
+        doc = add(doc, path, clone(member(op, "value", i) as Json));
+        break;
+      case "replace":
+        doc = replace(doc, path, clone(member(op, "value", i) as Json));
+        break;
+      case "remove":
+        doc = remove(doc, path);
+        break;
+      case "test":
+        if (!equal(get(doc, path), member(op, "value", i))) {
+          throw new Error(`Test failed at "${path}"`);
+        }
+        break;
+      case "copy": {
+        const from = pointerMember(op, "from", i);
+        doc = add(doc, path, clone(get(doc, from)));
+        break;
+      }
+      case "move": {
+        const from = pointerMember(op, "from", i);
+        const value = get(doc, from);
+        if (from === path) break;
+        if (path.startsWith(from + "/")) {
+          throw new Error(`Cannot move "${from}" into one of its own children`);
+        }
+        doc = add(remove(doc, from), path, value);
+        break;
+      }
+      default:
+        throw new Error(`Invalid patch: operation ${i} has unknown "op"`);
+    }
+  });
+  return doc;
+}
