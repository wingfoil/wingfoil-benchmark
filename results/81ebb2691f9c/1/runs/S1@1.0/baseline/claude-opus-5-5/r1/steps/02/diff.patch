index 0000000000000000000000000000000000000000..369aa1dcab641b4cbd5fed3db223871129725db0
--- /dev/null
+++ b/src/patch.ts
@@ -0,0 +1,235 @@
+/**
+ * JSON Patch (RFC 6902): https://www.rfc-editor.org/rfc/rfc6902
+ *
+ * Paths are JSON Pointers (RFC 6901) in their string representation, parsed with parsePointer.
+ * The patch is applied to a deep copy of the document, so neither the document nor the patch is
+ * ever mutated, and the result shares no objects or arrays with them.
+ */
+
+import { JsonPointerError, formatPointer, parseArrayIndex, parsePointer } from "./pointer.ts";
+
+/** A single JSON Patch operation (RFC 6902 section 4). */
+export type JsonPatchOperation =
+  | { op: "add"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "replace"; path: string; value: unknown }
+  | { op: "move"; from: string; path: string }
+  | { op: "copy"; from: string; path: string }
+  | { op: "test"; path: string; value: unknown };
+
+/**
+ * Error thrown for an invalid patch or a failing operation. `index` is the position of the
+ * offending operation in the patch (undefined when the patch itself is not an array), and
+ * `operation` is that operation as given. A JsonPointerError behind the failure is kept as `cause`.
+ */
+export class JsonPatchError extends Error {
+  readonly index: number | undefined;
+  readonly operation: unknown;
+
+  constructor(message: string, index?: number, operation?: unknown, options?: { cause?: unknown }) {
+    super(index === undefined ? message : `Operation ${index}: ${message}`, options);
+    this.name = "JsonPatchError";
+    this.index = index;
+    this.operation = operation;
+  }
+}
+
+type Container = Record<string, unknown> | unknown[];
+
+interface ParsedOperation {
+  op: JsonPatchOperation["op"];
+  path: string[];
+  from?: string[];
+  value?: unknown;
+}
+
+const OPERATIONS = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+
+function hasOwn(object: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(object, key);
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Sets an own data property, so that a "__proto__" member never changes the prototype. */
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Deep copy of a JSON value. Own "__proto__" members are copied as members. */
+function cloneJson<T>(value: T): T {
+  if (Array.isArray(value)) return value.map(cloneJson) as T;
+  if (isObject(value)) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(copy, key, cloneJson(value[key]));
+    return copy as T;
+  }
+  return value;
+}
+
+/**
+ * JSON equality as defined for "test" (RFC 6902 section 4.6): same type, numbers equal by value,
+ * arrays equal element by element, objects with the same set of members regardless of order.
+ */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((key) => hasOwn(b, key) && jsonEqual(a[key], b[key]));
+  }
+  return a === b;
+}
+
+/** Checks the structure of every operation before any is applied (sections 3 and 4). */
+function parseOperations(patch: unknown): ParsedOperation[] {
+  if (!Array.isArray(patch)) throw new JsonPatchError("JSON Patch must be an array of operations");
+  return patch.map((operation, index) => {
+    const fail = (message: string, cause?: unknown): never => {
+      throw new JsonPatchError(message, index, operation, cause === undefined ? undefined : { cause });
+    };
+    const pointer = (member: "path" | "from"): string[] => {
+      if (!hasOwn(operation, member)) fail(`missing "${member}"`);
+      const value = operation[member];
+      if (typeof value !== "string") return fail(`"${member}" must be a string`);
+      try {
+        return parsePointer(value);
+      } catch (error) {
+        if (error instanceof JsonPointerError) return fail(`invalid "${member}": ${error.message}`, error);
+        throw error;
+      }
+    };
+
+    if (!isObject(operation)) return fail("operation must be an object");
+    if (!hasOwn(operation, "op")) return fail('missing "op"');
+    const op = operation.op;
+    if (typeof op !== "string" || !OPERATIONS.has(op)) return fail(`unknown "op" ${JSON.stringify(op)}`);
+    const parsed: ParsedOperation = { op: op as ParsedOperation["op"], path: pointer("path") };
+    if (op === "move" || op === "copy") parsed.from = pointer("from");
+    if (op === "add" || op === "replace" || op === "test") {
+      // A "value" of null is valid; only an absent member is an error.
+      if (!hasOwn(operation, "value")) fail('missing "value"');
+      parsed.value = operation.value;
+    }
+    return parsed;
+  });
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the patched document as a new value.
+ * Operations are applied in order; if the patch is malformed or any operation fails (a missing
+ * target, an out-of-range index, a failed "test", ...) a JsonPatchError is thrown and no result is
+ * returned. Neither `document` nor `patch` is modified.
+ */
+export function applyPatch(document: unknown, patch: readonly unknown[]): unknown {
+  const operations = parseOperations(patch);
+  // A single root holder lets the whole document ("" path) be replaced like any other location.
+  const root: { document: unknown } = { document: cloneJson(document) };
+
+  operations.forEach((operation, index) => {
+    const fail = (message: string): never => {
+      throw new JsonPatchError(message, index, patch[index]);
+    };
+    const describe = (tokens: string[]) => JSON.stringify(formatPointer(tokens));
+
+    /** Resolves the parent container of `tokens` (which must not be empty). */
+    const parentOf = (tokens: string[]): Container => {
+      let current: unknown = root.document;
+      for (let i = 0; i < tokens.length - 1; i++) {
+        current = child(current, tokens[i], tokens.slice(0, i + 1));
+      }
+      if (!Array.isArray(current) && !isObject(current)) {
+        return fail(`parent of ${describe(tokens)} is not an object or array`);
+      }
+      return current;
+    };
+    /** Returns the existing child `token` of `container`; `at` is the pointer to that child. */
+    const child = (container: unknown, token: string, at: string[]): unknown => {
+      if (Array.isArray(container)) {
+        const i = parseArrayIndex(token);
+        if (i === undefined || i >= container.length) fail(`${describe(at)} does not exist`);
+        return container[i!];
+      }
+      if (isObject(container) && hasOwn(container, token)) return container[token];
+      return fail(`${describe(at)} does not exist`);
+    };
+
+    const get = (tokens: string[]): unknown => {
+      if (tokens.length === 0) return root.document;
+      return child(parentOf(tokens), tokens[tokens.length - 1], tokens);
+    };
+    const add = (tokens: string[], value: unknown): void => {
+      if (tokens.length === 0) {
+        root.document = value;
+        return;
+      }
+      const parent = parentOf(tokens);
+      const token = tokens[tokens.length - 1];
+      if (Array.isArray(parent)) {
+        const i = token === "-" ? parent.length : parseArrayIndex(token);
+        if (i === undefined) fail(`invalid array index in ${describe(tokens)}`);
+        if (i! > parent.length) fail(`array index out of range in ${describe(tokens)}`);
+        parent.splice(i!, 0, value);
+      } else {
+        setMember(parent, token, value);
+      }
+    };
+    const remove = (tokens: string[]): unknown => {
+      if (tokens.length === 0) return fail("cannot remove the whole document");
+      const value = get(tokens);
+      const parent = parentOf(tokens);
+      const token = tokens[tokens.length - 1];
+      if (Array.isArray(parent)) parent.splice(Number(token), 1);
+      else delete parent[token];
+      return value;
+    };
+
+    /** Replaces an existing value in place, keeping the position of an object member. */
+    const replace = (tokens: string[], value: unknown): void => {
+      get(tokens);
+      if (tokens.length === 0) {
+        root.document = value;
+        return;
+      }
+      const parent = parentOf(tokens);
+      const token = tokens[tokens.length - 1];
+      if (Array.isArray(parent)) parent[Number(token)] = value;
+      else setMember(parent, token, value);
+    };
+
+    const { path, from } = operation;
+    switch (operation.op) {
+      case "add":
+        add(path, cloneJson(operation.value));
+        break;
+      case "remove":
+        remove(path);
+        break;
+      case "replace":
+        replace(path, cloneJson(operation.value));
+        break;
+      case "move": {
+        // Section 4.4: "from" must not be a proper prefix of "path" (no move into its own child).
+        if (from!.length < path.length && from!.every((token, i) => token === path[i])) {
+          fail(`cannot move ${describe(from!)} into its own child ${describe(path)}`);
+        }
+        // Moving a value onto itself leaves the document unchanged, once "from" is known to exist.
+        if (from!.length === path.length && from!.every((token, i) => token === path[i])) get(from!);
+        else add(path, remove(from!));
+        break;
+      }
+      case "copy":
+        add(path, cloneJson(get(from!)));
+        break;
+      case "test":
+        if (!jsonEqual(get(path), operation.value)) fail(`test failed: value at ${describe(path)} is not equal`);
+        break;
+    }
+  });
+
+  return root.document;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6f8f0ed06a54e1b79994ea17bf90eb5f349055b9
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,156 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { JsonPatchError, JsonPointerError, applyPatch } from "../src/index.ts";
+
+const fails = (document: unknown, patch: unknown, index?: number) =>
+  assert.throws(
+    () => applyPatch(document, patch as unknown[]),
+    (error: unknown) => error instanceof JsonPatchError && error.index === index,
+  );
+
+// RFC 6902 Appendix A examples.
+test("A.1-A.4 add and remove", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { baz: "qux", foo: "bar" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+});
+
+test("A.5-A.7 replace and move", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), { baz: "boo", foo: "bar" });
+  assert.deepEqual(
+    applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+});
+
+test("A.8-A.9 test", () => {
+  const doc = { baz: "qux", foo: ["a", 2, "c"] };
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }]), doc);
+  fails({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }], 0);
+});
+
+test("A.10-A.16 misc", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]), { foo: "bar", child: { grandchild: {} } });
+  // A.11: unrecognized members are ignored.
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }]), { foo: "bar", baz: "qux" });
+  fails({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }], 0); // A.12
+  fails({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }], 0); // A.15
+  assert.deepEqual(applyPatch({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }]), { "/": 9, "~1": 10 }); // A.14
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]), { foo: ["bar", ["abc", "def"]] }); // A.16
+});
+
+test("does not mutate its inputs and shares no structure with them", () => {
+  const doc = { a: { b: [1, 2] }, c: 1 };
+  const value = { x: [1] };
+  const patch = [
+    { op: "add", path: "/a/b/-", value },
+    { op: "copy", from: "/a", path: "/d" },
+    { op: "remove", path: "/c" },
+  ];
+  const snapshot = structuredClone({ doc, patch });
+  const result = applyPatch(doc, patch) as any;
+  assert.deepEqual({ doc, patch }, snapshot);
+  assert.deepEqual(result, { a: { b: [1, 2, { x: [1] }] }, d: { b: [1, 2, { x: [1] }] } });
+  assert.notEqual(result.a.b[2], value);
+  assert.notEqual(result.a, result.d);
+  assert.deepEqual(applyPatch(doc, []), doc);
+  assert.notEqual(applyPatch(doc, []), doc);
+});
+
+test("root operations", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: null }]), null);
+  assert.deepEqual(applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "" }]), { b: 1 });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "copy", from: "", path: "/b" }]), { a: 1, b: { a: 1 } });
+  assert.deepEqual(applyPatch([1], [{ op: "test", path: "", value: [1] }]), [1]);
+  fails({ a: 1 }, [{ op: "remove", path: "" }], 0);
+});
+
+test("add, remove and replace targets", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch([1, 2], [{ op: "add", path: "/2", value: 3 }]), [1, 2, 3]);
+  assert.deepEqual(applyPatch([1, 2], [{ op: "replace", path: "/0", value: 9 }]), [9, 2]);
+  assert.deepEqual(Object.keys(applyPatch({ a: 1, b: 2 }, [{ op: "replace", path: "/a", value: 3 }]) as object), ["a", "b"]);
+  fails([1, 2], [{ op: "add", path: "/3", value: 3 }], 0);
+  fails([1, 2], [{ op: "add", path: "/01", value: 3 }], 0);
+  fails([1, 2], [{ op: "remove", path: "/2" }], 0);
+  fails([1, 2], [{ op: "remove", path: "/-" }], 0);
+  fails([1, 2], [{ op: "replace", path: "/-", value: 3 }], 0);
+  fails({ a: 1 }, [{ op: "replace", path: "/b", value: 3 }], 0);
+  fails({ a: 1 }, [{ op: "remove", path: "/b" }], 0);
+  fails({ a: 1 }, [{ op: "add", path: "/a/b", value: 3 }], 0);
+  fails({}, [{ op: "remove", path: "/constructor" }], 0);
+});
+
+test("own __proto__ members are handled as plain members", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as any;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.equal(({} as any).polluted, undefined);
+  const doc = JSON.parse('{"__proto__": {"x": 1}}');
+  assert.deepEqual(Object.keys(applyPatch(doc, [{ op: "test", path: "/__proto__/x", value: 1 }]) as object), ["__proto__"]);
+});
+
+test("move and copy", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  fails({ a: 1 }, [{ op: "move", from: "/b", path: "/b" }], 0);
+  fails({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b/c" }], 0);
+  assert.deepEqual(applyPatch({ a: 1, ab: 2 }, [{ op: "move", from: "/a", path: "/ab" }]), { ab: 1 });
+  assert.deepEqual(applyPatch([1, 2, 3], [{ op: "move", from: "/0", path: "/-" }]), [2, 3, 1]);
+  assert.deepEqual(applyPatch([1, 2], [{ op: "copy", from: "/0", path: "/0" }]), [1, 1, 2]);
+  fails({ a: 1 }, [{ op: "copy", from: "/b", path: "/c" }], 0);
+});
+
+test("test uses JSON equality", () => {
+  const doc = { o: { a: 1, b: [1, { c: null }] }, n: 1, s: "1", z: null };
+  applyPatch(doc, [{ op: "test", path: "/o", value: { b: [1, { c: null }], a: 1.0 } }]);
+  fails(doc, [{ op: "test", path: "/o", value: { a: 1 } }], 0);
+  fails(doc, [{ op: "test", path: "/o", value: { a: 1, b: [1, { c: null }], d: 1 } }], 0);
+  fails(doc, [{ op: "test", path: "/o/b", value: [{ c: null }, 1] }], 0);
+  fails(doc, [{ op: "test", path: "/n", value: "1" }], 0);
+  fails(doc, [{ op: "test", path: "/s", value: 1 }], 0);
+  fails(doc, [{ op: "test", path: "/z", value: false }], 0);
+  fails(doc, [{ op: "test", path: "/o", value: [] }], 0);
+  fails(doc, [{ op: "test", path: "/missing", value: null }], 0);
+  applyPatch(doc, [{ op: "test", path: "/z", value: null }]);
+});
+
+test("invalid patches", () => {
+  fails({}, {}, undefined);
+  fails({}, null, undefined);
+  fails({}, [null], 0);
+  fails({}, [[]], 0);
+  fails({}, [{ path: "/a", value: 1 }], 0);
+  fails({}, [{ op: "jump", path: "/a" }], 0);
+  fails({}, [{ op: "add", value: 1 }], 0);
+  fails({}, [{ op: "add", path: 1, value: 1 }], 0);
+  fails({}, [{ op: "add", path: "/a" }], 0);
+  fails({}, [{ op: "replace", path: "" }], 0);
+  fails({}, [{ op: "test", path: "" }], 0);
+  fails({ a: 1 }, [{ op: "move", path: "/b" }], 0);
+  fails({ a: 1 }, [{ op: "copy", from: 1, path: "/b" }], 0);
+  fails({}, [{ op: "add", path: "a", value: 1 }], 0);
+  fails({}, [{ op: "add", path: "#/a", value: 1 }], 0);
+  fails({}, [{ op: "add", path: "/~2", value: 1 }], 0);
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a", value: null }]), { a: null });
+  // The whole patch is checked before anything is applied, and the error carries the cause.
+  fails({}, [{ op: "add", path: "/a", value: 1 }, { op: "nope" }], 1);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "a", value: 1 }]), (e: any) => e.cause instanceof JsonPointerError);
+});
+
+test("operations apply in order and a failure aborts the patch", () => {
+  const patch = [
+    { op: "add", path: "/a", value: [] },
+    { op: "add", path: "/a/-", value: 1 },
+    { op: "test", path: "/a/0", value: 1 },
+    { op: "remove", path: "/b" },
+  ];
+  const doc = { b: 1 };
+  assert.deepEqual(applyPatch(doc, patch), { a: [1] });
+  fails(doc, [...patch, { op: "remove", path: "/b" }], 4);
+  assert.deepEqual(doc, { b: 1 });
+});
