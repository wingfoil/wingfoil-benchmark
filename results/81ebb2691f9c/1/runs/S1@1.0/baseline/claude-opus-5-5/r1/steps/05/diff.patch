index 0000000000000000000000000000000000000000..bbfcbc1a725603c086f8f9485bb04e6d7bbcb1ca
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,130 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { JsonPatchError, applyPatch, createPatch } from "../src/index.ts";
+
+/** Checks that the patch turns `from` into `to`, and returns it. */
+const roundTrip = (from: unknown, to: unknown) => {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+};
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(createPatch({ a: [1, { b: null }] }, { a: [1, { b: null }] }), []);
+  assert.deepEqual(createPatch({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+  assert.deepEqual(createPatch(0, -0), []);
+});
+
+test("object members", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1, b: 3 }), [{ op: "replace", path: "/b", value: 3 }]);
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1 }), [{ op: "remove", path: "/b" }]);
+  assert.deepEqual(roundTrip({ a: 1 }, { a: 1, "c/d~": null }), [{ op: "add", path: "/c~1d~0", value: null }]);
+  assert.deepEqual(roundTrip({ a: { b: { c: 1, d: 2 } } }, { a: { b: { c: 1, d: 3 } } }), [{ op: "replace", path: "/a/b/d", value: 3 }]);
+});
+
+test("changes of type and at the root", () => {
+  assert.deepEqual(roundTrip({ a: [1] }, { a: { 0: 1 } }), [{ op: "replace", path: "/a", value: { 0: 1 } }]);
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip("x", null), [{ op: "replace", path: "", value: null }]);
+  assert.deepEqual(roundTrip({ a: "1" }, { a: 1 }), [{ op: "replace", path: "/a", value: 1 }]);
+});
+
+test("array insertions and removals do not rewrite the rest of the array", () => {
+  const long = Array.from({ length: 1000 }, (_, i) => ({ id: i, name: `item ${i}` }));
+  const inserted = [...long.slice(0, 500), { id: -1, name: "new" }, ...long.slice(500)];
+  assert.deepEqual(roundTrip(long, inserted), [{ op: "add", path: "/500", value: { id: -1, name: "new" } }]);
+  assert.deepEqual(roundTrip(inserted, long), [{ op: "remove", path: "/500" }]);
+  const words = ["one", "two", "three"].map((word) => `${word}: a value long enough to make a full replace the longer patch`);
+  assert.deepEqual(roundTrip(words, ["zero", ...words, "four"]), [
+    { op: "add", path: "/0", value: "zero" },
+    { op: "add", path: "/4", value: "four" },
+  ]);
+  assert.deepEqual(roundTrip([...words, "x", "y"], [words[0], "y"]), [
+    { op: "remove", path: "/1" },
+    { op: "remove", path: "/1" },
+    { op: "remove", path: "/1" },
+  ]);
+});
+
+test("a changed array element is diffed in place", () => {
+  const long = Array.from({ length: 1000 }, (_, i) => ({ id: i, name: `item ${i}`, tags: ["a", "b"] }));
+  const changed = structuredClone(long);
+  changed[700].tags.push("c");
+  assert.deepEqual(roundTrip(long, changed), [{ op: "add", path: "/700/tags/2", value: "c" }]);
+});
+
+test("a replace is used when it is shorter than the detailed changes", () => {
+  assert.deepEqual(roundTrip({ a: { x: 1, y: 2, z: 3 } }, { a: { u: 1, v: 2, w: 3 } }), [
+    { op: "replace", path: "/a", value: { u: 1, v: 2, w: 3 } },
+  ]);
+  assert.deepEqual(roundTrip([1, 2, 3], [4, 5, 6]), [{ op: "replace", path: "", value: [4, 5, 6] }]);
+});
+
+test("many array changes still give a correct patch", () => {
+  const from = Array.from({ length: 5000 }, (_, i) => i);
+  const to = Array.from({ length: 5000 }, (_, i) => (i % 2 === 0 ? i : -i));
+  roundTrip(from, to);
+  const reversed = [...from].reverse();
+  roundTrip(from, reversed);
+});
+
+test("own __proto__ members are plain members", () => {
+  const from = JSON.parse('{"__proto__": {"a": 1}, "b": 1}');
+  const to = JSON.parse('{"__proto__": {"a": 2}, "c": 1}');
+  const patch = roundTrip(from, to);
+  assert.equal(Object.getPrototypeOf(applyPatch(from, patch)), Object.prototype);
+  roundTrip({}, JSON.parse('{"__proto__": 1}'));
+});
+
+test("does not mutate its inputs and shares no structure with them", () => {
+  const from = { a: [1, { b: 2 }], c: { d: 1 } };
+  const to = { a: [1, { b: 2 }, { e: [3] }], c: [{ f: 4 }] };
+  const [fromCopy, toCopy] = [structuredClone(from), structuredClone(to)];
+  const patch = createPatch(from, to) as { value?: unknown }[];
+  assert.deepEqual([from, to], [fromCopy, toCopy]);
+  for (const operation of patch) {
+    if (typeof operation.value === "object" && operation.value !== null) (operation.value as Record<string, unknown>).x = 1;
+  }
+  assert.deepEqual([from, to], [fromCopy, toCopy]);
+});
+
+test("inputs must be JSON", () => {
+  for (const bad of [undefined, NaN, new Date(), [1, , 2], { a: () => 1 }]) {
+    assert.throws(() => createPatch(bad, {}), JsonPatchError);
+    assert.throws(() => createPatch({}, bad), JsonPatchError);
+  }
+});
+
+test("random documents round-trip", () => {
+  let seed = 42;
+  const random = () => ((seed = (seed * 1103515245 + 12345) % 2 ** 31) / 2 ** 31);
+  const pick = <T>(items: T[]) => items[Math.floor(random() * items.length)];
+  const value = (depth: number): unknown => {
+    const kind = depth > 3 ? random() * 4 : random() * 6;
+    if (kind < 1) return null;
+    if (kind < 2) return pick([true, false, 0, 1, 2.5, -3]);
+    if (kind < 4) return pick(["a", "b", "", "~/"]);
+    if (kind < 5) return Array.from({ length: Math.floor(random() * 6) }, () => value(depth + 1));
+    return Object.fromEntries(Array.from({ length: Math.floor(random() * 5) }, () => [pick(["a", "b", "c", "/", "~"]), value(depth + 1)]));
+  };
+  const mutate = (input: unknown): unknown => {
+    if (random() < 0.2) return value(2);
+    if (Array.isArray(input)) {
+      const out = input.map((item) => (random() < 0.3 ? mutate(item) : item));
+      if (random() < 0.3) out.splice(Math.floor(random() * (out.length + 1)), 0, value(3));
+      if (random() < 0.3 && out.length > 0) out.splice(Math.floor(random() * out.length), 1);
+      return out;
+    }
+    if (input !== null && typeof input === "object") {
+      const out: Record<string, unknown> = {};
+      for (const [key, item] of Object.entries(input)) if (random() > 0.15) out[key] = random() < 0.3 ? mutate(item) : item;
+      if (random() < 0.3) out[pick(["a", "d", "e/f"])] = value(3);
+      return out;
+    }
+    return input;
+  };
+  for (let n = 0; n < 2000; n++) {
+    const from = value(0);
+    roundTrip(from, random() < 0.5 ? mutate(from) : value(0));
+  }
+});
