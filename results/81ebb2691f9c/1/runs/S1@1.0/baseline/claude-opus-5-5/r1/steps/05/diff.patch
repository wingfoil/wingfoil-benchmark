+++ b/src/diff.ts
@@ -0,0 +1,166 @@
+/**
+ * Creating a JSON Patch (RFC 6902) from two versions of a document.
+ *
+ * The patch only touches what changed: unchanged members and array elements are left alone, changed
+ * containers are diffed recursively, and array elements are matched with Myers' diff algorithm so
+ * that an insertion or removal does not rewrite the rest of the array. Whenever a single "replace"
+ * would be shorter than the detailed operations for a value, the "replace" is used instead.
+ */
+
+import { cloneJson, hasOwn, invalidJson, isObject } from "./json.ts";
+import { JsonPatchError, type JsonPatchOperation } from "./patch.ts";
+import { formatPointer } from "./pointer.ts";
+
+/** Beyond this many differences between two arrays, elements are paired by position instead. */
+const MAX_ARRAY_EDITS = 1000;
+
+/**
+ * A string that is equal for two values exactly when they are JSON-equal (RFC 6902 section 4.6):
+ * object members are sorted, so member order does not matter.
+ */
+function canonical(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
+  if (isObject(value)) {
+    const members = Object.keys(value).sort().map((key) => `${JSON.stringify(key)}:${canonical(value[key])}`);
+    return `{${members.join(",")}}`;
+  }
+  return JSON.stringify(value);
+}
+
+type Edit = "equal" | "delete" | "insert";
+
+/**
+ * Shortest edit script turning `a` into `b` (Myers, "An O(ND) Difference Algorithm and Its
+ * Variations", 1986), or undefined if it needs more than `maxEdits` deletions and insertions.
+ */
+function shortestEdit(a: string[], b: string[], maxEdits: number): Edit[] | undefined {
+  const n = a.length;
+  const m = b.length;
+  const offset = n + m + 1;
+  // v[offset + k] is the furthest x reached on diagonal k = x - y.
+  const v = new Int32Array(2 * offset + 1);
+  // trace[d] holds diagonals -d..d of v as they were before step d.
+  const trace: Int32Array[] = [];
+  for (let d = 0; d <= Math.min(n + m, maxEdits); d++) {
+    trace.push(v.slice(offset - d, offset + d + 1));
+    for (let k = -d; k <= d; k += 2) {
+      let x = k === -d || (k !== d && v[offset + k - 1] < v[offset + k + 1]) ? v[offset + k + 1] : v[offset + k - 1] + 1;
+      let y = x - k;
+      while (x < n && y < m && a[x] === b[y]) {
+        x++;
+        y++;
+      }
+      v[offset + k] = x;
+      if (x >= n && y >= m) return backtrack(trace, n, m);
+    }
+  }
+  return undefined;
+}
+
+function backtrack(trace: Int32Array[], n: number, m: number): Edit[] {
+  const edits: Edit[] = [];
+  let x = n;
+  let y = m;
+  for (let d = trace.length - 1; d > 0; d--) {
+    const v = trace[d];
+    const at = (k: number) => v[k + d];
+    const k = x - y;
+    const prevK = k === -d || (k !== d && at(k - 1) < at(k + 1)) ? k + 1 : k - 1;
+    const prevX = at(prevK);
+    const prevY = prevX - prevK;
+    for (; x > prevX && y > prevY; x--, y--) edits.push("equal");
+    edits.push(prevK === k + 1 ? "insert" : "delete");
+    x = prevX;
+    y = prevY;
+  }
+  for (; x > 0; x--) edits.push("equal");
+  return edits.reverse();
+}
+
+/** Size of operations once serialized, used to pick the shorter of two equivalent patches. */
+const size = (operations: JsonPatchOperation[]) => JSON.stringify(operations).length;
+
+/** Appends to `out` the operations turning `from` into `to` at `path`. */
+function diff(from: unknown, to: unknown, path: string[], out: JsonPatchOperation[]): void {
+  let detailed: JsonPatchOperation[];
+  if (Array.isArray(from) && Array.isArray(to)) detailed = diffArrays(from, to, path);
+  else if (isObject(from) && isObject(to)) detailed = diffObjects(from, to, path);
+  else {
+    if (from !== to) out.push({ op: "replace", path: formatPointer(path), value: cloneJson(to) });
+    return;
+  }
+  const replacement: JsonPatchOperation[] = [{ op: "replace", path: formatPointer(path), value: cloneJson(to) }];
+  out.push(...(detailed.length > 0 && size(replacement) < size(detailed) ? replacement : detailed));
+}
+
+function diffObjects(from: Record<string, unknown>, to: Record<string, unknown>, path: string[]): JsonPatchOperation[] {
+  const out: JsonPatchOperation[] = [];
+  for (const key of Object.keys(from)) {
+    if (!hasOwn(to, key)) out.push({ op: "remove", path: formatPointer([...path, key]) });
+  }
+  for (const key of Object.keys(to)) {
+    if (hasOwn(from, key)) diff(from[key], to[key], [...path, key], out);
+    else out.push({ op: "add", path: formatPointer([...path, key]), value: cloneJson(to[key]) });
+  }
+  return out;
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string[]): JsonPatchOperation[] {
+  const a = from.map(canonical);
+  const b = to.map(canonical);
+  // Without a short edit script, everything between the common prefix and suffix is one change.
+  let edits = shortestEdit(a, b, MAX_ARRAY_EDITS);
+  if (edits === undefined) {
+    let prefix = 0;
+    while (prefix < a.length && prefix < b.length && a[prefix] === b[prefix]) prefix++;
+    let suffix = 0;
+    while (suffix < a.length - prefix && suffix < b.length - prefix && a[a.length - 1 - suffix] === b[b.length - 1 - suffix]) suffix++;
+    edits = [
+      ...Array<Edit>(prefix).fill("equal"),
+      ...Array<Edit>(a.length - prefix - suffix).fill("delete"),
+      ...Array<Edit>(b.length - prefix - suffix).fill("insert"),
+      ...Array<Edit>(suffix).fill("equal"),
+    ];
+  }
+
+  // Walks the edits left to right; `index` is the position in the array as patched so far.
+  const out: JsonPatchOperation[] = [];
+  let i = 0; // in from
+  let j = 0; // in to
+  let index = 0;
+  for (let e = 0; e < edits.length; ) {
+    if (edits[e] === "equal") {
+      i++, j++, index++, e++;
+      continue;
+    }
+    // A run of changes between two equal elements: deleted and inserted elements are paired up
+    // and diffed in place, then the extra ones are removed or added.
+    let deleted = 0;
+    let inserted = 0;
+    for (; e < edits.length && edits[e] !== "equal"; e++) edits[e] === "delete" ? deleted++ : inserted++;
+    const paired = Math.min(deleted, inserted);
+    for (let p = 0; p < paired; p++) diff(from[i++], to[j++], [...path, String(index++)], out);
+    for (let p = paired; p < deleted; p++, i++) out.push({ op: "remove", path: formatPointer([...path, String(index)]) });
+    for (let p = paired; p < inserted; p++) {
+      out.push({ op: "add", path: formatPointer([...path, String(index++)]), value: cloneJson(to[j++]) });
+    }
+  }
+  return out;
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with applyPatch: the
+ * result is JSON-equal to `to` (member order is not significant in JSON, and new members are
+ * appended). Only the parts that differ appear in the patch; it is empty when the two are
+ * JSON-equal. Throws JsonPatchError if either input is not a JSON value. Neither input is modified,
+ * and the patch shares no objects or arrays with them.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  for (const [name, value] of [["from", from], ["to", to]] as const) {
+    const problem = invalidJson(value);
+    if (problem !== undefined) throw new JsonPatchError(`${name} is not JSON: ${problem}`);
+  }
+  const out: JsonPatchOperation[] = [];
+  diff(from, to, [], out);
+  return out;
+}
