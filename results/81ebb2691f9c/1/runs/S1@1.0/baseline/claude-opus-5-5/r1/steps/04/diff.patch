+/** Helpers for JSON values (RFC 8259) shared by the features that copy or validate documents. */
+
+import { formatPointer } from "./pointer.ts";
+
+export function hasOwn(object: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(object, key);
+}
+
+export function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Sets an own data property, so that a "__proto__" member never changes the prototype. */
+export function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Deep copy of a JSON value. Own "__proto__" members are copied as members. */
+export function cloneJson<T>(value: T): T {
+  if (Array.isArray(value)) return value.map(cloneJson) as T;
+  if (isObject(value)) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(copy, key, cloneJson(value[key]));
+    return copy as T;
+  }
+  return value;
+}
+
+/**
+ * Returns a description of why `value` is not a JSON value (RFC 8259), or undefined if it is one:
+ * null, a boolean, a string, a finite number, a dense plain array or a plain object (prototype
+ * Object.prototype or null) whose members are JSON values, without cycles.
+ */
+export function invalidJson(value: unknown, at: string[] = [], ancestors = new Set<object>()): string | undefined {
+  const where = () => (at.length === 0 ? "" : ` at ${JSON.stringify(formatPointer(at))}`);
+  switch (typeof value) {
+    case "string":
+    case "boolean":
+      return undefined;
+    case "number":
+      return Number.isFinite(value) ? undefined : `${value} is not a JSON number${where()}`;
+    case "object":
+      if (value === null) return undefined;
+      break;
+    default:
+      return `${typeof value} is not a JSON value${where()}`;
+  }
+  const proto = Object.getPrototypeOf(value);
+  if (Array.isArray(value) ? proto !== Array.prototype : proto !== Object.prototype && proto !== null) {
+    return `${proto?.constructor?.name ?? "object"} is not a JSON value${where()}`;
+  }
+  if (ancestors.has(value)) return `circular reference${where()}`;
+  ancestors.add(value);
+  try {
+    if (Array.isArray(value)) {
+      for (let i = 0; i < value.length; i++) {
+        if (!(i in value)) return `missing array element at ${JSON.stringify(formatPointer([...at, String(i)]))}`;
+        const problem = invalidJson(value[i], [...at, String(i)], ancestors);
+        if (problem !== undefined) return problem;
+      }
+    } else {
+      for (const key of Object.keys(value)) {
+        const problem = invalidJson((value as Record<string, unknown>)[key], [...at, key], ancestors);
+        if (problem !== undefined) return problem;
+      }
+    }
+    return undefined;
+  } finally {
+    ancestors.delete(value);
+  }
+}
