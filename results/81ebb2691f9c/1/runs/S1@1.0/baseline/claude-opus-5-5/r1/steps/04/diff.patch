@@ -0,0 +1,83 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { JsonMergePatchError, applyMergePatch } from "../src/index.ts";
+
+test("section 3 example", () => {
+  const target = { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["example", "sample"], content: "This will be unchanged" };
+  const patch = { title: "Hello!", phoneNumber: "+01-123-456-7890", author: { familyName: null }, tags: ["example"] };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+});
+
+test("Appendix A test cases", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) assert.deepEqual(applyMergePatch(target, patch), expected);
+});
+
+test("keeps member order: existing members in place, new ones appended", () => {
+  const result = applyMergePatch({ a: 1, b: 2, c: 3 }, { d: 4, a: 0, b: null }) as object;
+  assert.deepEqual(Object.keys(result), ["a", "c", "d"]);
+});
+
+test("nulls inside arrays and in an empty patch are kept", () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, { a: [null, { b: null }] }), { a: [null, { b: null }] });
+  assert.deepEqual(applyMergePatch({ a: null }, {}), { a: null });
+  assert.deepEqual(applyMergePatch(null, { a: 1 }), { a: 1 });
+});
+
+test("does not mutate its inputs and shares no structure with them", () => {
+  const target = { a: { b: [1] }, keep: { x: 1 } };
+  const patch = { a: { c: { d: [2] } }, n: { m: [3] } };
+  const snapshot = structuredClone({ target, patch });
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual({ target, patch }, snapshot);
+  assert.deepEqual(result, { a: { b: [1], c: { d: [2] } }, keep: { x: 1 }, n: { m: [3] } });
+  assert.notEqual(result.keep, target.keep);
+  assert.notEqual(result.a.b, target.a.b);
+  assert.notEqual(result.n, patch.n);
+  assert.notEqual(result.a.c.d, patch.a.c.d);
+  const array = [1];
+  assert.notEqual(applyMergePatch({}, array), array);
+});
+
+test("only own members are merged, and __proto__ is an ordinary member", () => {
+  assert.deepEqual(applyMergePatch({}, { constructor: { a: 1 } }), { constructor: { a: 1 } });
+  assert.deepEqual(applyMergePatch({}, { toString: null }), {});
+  const result = applyMergePatch(JSON.parse('{"__proto__": {"a": 1}}'), JSON.parse('{"__proto__": {"b": 2}}')) as any;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.deepEqual({ ...Object.getOwnPropertyDescriptor(result, "__proto__")!.value }, { a: 1, b: 2 });
+  const added = applyMergePatch({}, JSON.parse('{"__proto__": {"polluted": true}}')) as any;
+  assert.equal(added.polluted, undefined);
+  assert.equal(({} as any).polluted, undefined);
+});
+
+test("rejects a target or patch that is not JSON", () => {
+  const cycle: any = {};
+  cycle.self = cycle;
+  for (const bad of [undefined, NaN, Infinity, 1n, () => 1, new Date(), new Map(), [1, , 2], { a: undefined }, cycle]) {
+    assert.throws(() => applyMergePatch({}, bad), JsonMergePatchError);
+    assert.throws(() => applyMergePatch(bad, {}), JsonMergePatchError);
+  }
+});
