+/**
+ * JSON Merge Patch (RFC 7386): https://www.rfc-editor.org/rfc/rfc7386
+ *
+ * The patch is merged into a deep copy of the target, so neither input is ever mutated, and the
+ * result shares no objects or arrays with them.
+ */
+
+import { cloneJson, hasOwn, invalidJson, isObject, setMember } from "./json.ts";
+
+/** Error thrown when the target or the patch is not a JSON value. */
+export class JsonMergePatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonMergePatchError";
+  }
+}
+
+/**
+ * The MergePatch function of RFC 7386 section 2. `target` is already a private copy and is
+ * modified in place; values taken from `patch` are copied.
+ */
+function merge(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return cloneJson(patch);
+  const result: Record<string, unknown> = isObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) delete result[key];
+    // Own members only: a "constructor" or "__proto__" member is never read from the prototype.
+    // setMember keeps the position of an existing member and appends a new one.
+    else setMember(result, key, merge(hasOwn(result, key) ? result[key] : undefined, value));
+  }
+  return result;
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to `target` and returns the merged document as a new value.
+ * An object patch is merged member by member, a `null` member removing the target's member; any
+ * other patch (array, primitive, `null`) replaces the target as a whole. Throws JsonMergePatchError
+ * if `target` or `patch` is not a JSON value. Neither input is modified.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  for (const [name, value] of [["target", target], ["patch", patch]] as const) {
+    const problem = invalidJson(value);
+    if (problem !== undefined) throw new JsonMergePatchError(`${name} is not JSON: ${problem}`);
+  }
+  return merge(cloneJson(target), patch);
+}
