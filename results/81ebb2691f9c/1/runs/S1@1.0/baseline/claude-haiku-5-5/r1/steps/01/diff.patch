--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,56 @@
+/**
+ * Thrown by `resolvePointer` when the pointer is malformed or does not
+ * resolve to a value of the document.
+ */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'JsonPointerError';
+  }
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document and returns the
+ * value it refers to. The empty pointer refers to the whole document.
+ *
+ * @throws {JsonPointerError} if `pointer` is not a valid JSON Pointer, or if it
+ * does not resolve to a value of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== 'string') {
+    throw new JsonPointerError('JSON Pointer must be a string');
+  }
+  if (pointer === '') {
+    return document;
+  }
+  if (!pointer.startsWith('/')) {
+    throw new JsonPointerError(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+
+  let current = document;
+  for (const rawToken of pointer.slice(1).split('/')) {
+    const token = unescapeToken(rawToken, pointer);
+
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new JsonPointerError(`JSON Pointer "${pointer}" does not resolve: no array index "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === 'object' && current !== null && Object.hasOwn(current, token)) {
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`JSON Pointer "${pointer}" does not resolve: no member "${token}"`);
+    }
+  }
+  return current;
+}
+
+/** Checks escapes in a reference token and applies them: "~1" → "/", then "~0" → "~". */
+function unescapeToken(token: string, pointer: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new JsonPointerError(`Invalid JSON Pointer "${pointer}": "~" must be followed by "0" or "1"`);
+  }
+  return token.replace(/~1/g, '/').replace(/~0/g, '~');
+}
diff --git a/test/resolve-pointer.test.ts b/test/resolve-pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dc57f6f75b64c2c4af28b30592fb23b8114704f1
--- /dev/null
+++ b/test/resolve-pointer.test.ts
@@ -0,0 +1,71 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { JsonPointerError, resolvePointer } from '../src/index.ts';
+
+// Examples from RFC 6901, section 5.
+const doc = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+test('empty pointer refers to the whole document', () => {
+  assert.equal(resolvePointer(doc, ''), doc);
+});
+
+test('resolves RFC 6901 examples', () => {
+  assert.deepEqual(resolvePointer(doc, '/foo'), ['bar', 'baz']);
+  assert.equal(resolvePointer(doc, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(doc, '/'), 0);
+  assert.equal(resolvePointer(doc, '/a~1b'), 1);
+  assert.equal(resolvePointer(doc, '/c%d'), 2);
+  assert.equal(resolvePointer(doc, '/e^f'), 3);
+  assert.equal(resolvePointer(doc, '/g|h'), 4);
+  assert.equal(resolvePointer(doc, '/i\\j'), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, '/ '), 7);
+  assert.equal(resolvePointer(doc, '/m~0n'), 8);
+});
+
+test('returns falsy and null values as they are', () => {
+  assert.equal(resolvePointer({ a: null, b: 0, c: false, d: '' }, '/a'), null);
+  assert.equal(resolvePointer({ a: null, b: 0, c: false, d: '' }, '/b'), 0);
+  assert.equal(resolvePointer({ a: null, b: 0, c: false, d: '' }, '/c'), false);
+  assert.equal(resolvePointer({ a: null, b: 0, c: false, d: '' }, '/d'), '');
+});
+
+test('array indices must be canonical and in range', () => {
+  const list = ['x', 'y', 'z'];
+  assert.equal(resolvePointer(list, '/2'), 'z');
+  assert.throws(() => resolvePointer(list, '/3'), JsonPointerError);
+  assert.throws(() => resolvePointer(list, '/01'), JsonPointerError);
+  assert.throws(() => resolvePointer(list, '/-'), JsonPointerError);
+  assert.throws(() => resolvePointer(list, '/a'), JsonPointerError);
+});
+
+test('does not resolve inherited properties', () => {
+  assert.throws(() => resolvePointer({}, '/constructor'), JsonPointerError);
+  assert.throws(() => resolvePointer({}, '/__proto__'), JsonPointerError);
+  assert.throws(() => resolvePointer({ a: 1 }, '/a/toString'), JsonPointerError);
+});
+
+test('cannot descend into primitives or missing members', () => {
+  assert.throws(() => resolvePointer({ a: 1 }, '/a/b'), JsonPointerError);
+  assert.throws(() => resolvePointer({ a: null }, '/a/b'), JsonPointerError);
+  assert.throws(() => resolvePointer({ a: 1 }, '/b'), JsonPointerError);
+});
+
+test('rejects pointers that are not valid JSON Pointers', () => {
+  assert.throws(() => resolvePointer(doc, 'foo'), JsonPointerError);
+  assert.throws(() => resolvePointer(doc, '/m~n'), JsonPointerError);
+  assert.throws(() => resolvePointer(doc, '/m~'), JsonPointerError);
+  assert.throws(() => resolvePointer(doc, '/~2'), JsonPointerError);
+  assert.throws(() => resolvePointer(doc, 42 as unknown as string), JsonPointerError);
+});
