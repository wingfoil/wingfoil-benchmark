--- a/src/index.ts
+++ b/src/index.ts
@@ -260,3 +260,85 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return out;
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(a: unknown[], b: unknown[], path: string, out: PatchOperation[]): void {
+  let start = 0;
+  while (start < a.length && start < b.length && jsonEqual(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && jsonEqual(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const x = a.slice(start, endA);
+  const y = b.slice(start, endB);
+
+  // Longest common subsequence of the differing middle sections.
+  const lcs: number[][] = Array.from({ length: x.length + 1 }, () =>
+    new Array<number>(y.length + 1).fill(0),
+  );
+  for (let i = x.length - 1; i >= 0; i--) {
+    for (let j = y.length - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(x[i], y[j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  let pos = start; // index in the array as it is after the operations emitted so far
+  let i = 0;
+  let j = 0;
+  while (i < x.length || j < y.length) {
+    if (i < x.length && j < y.length && jsonEqual(x[i], y[j])) {
+      i++;
+      j++;
+      pos++;
+      continue;
+    }
+    // Collect a run of deletions and insertions up to the next common element.
+    const dels: unknown[] = [];
+    const ins: unknown[] = [];
+    while (i < x.length || j < y.length) {
+      if (i < x.length && j < y.length && jsonEqual(x[i], y[j])) break;
+      if (j >= y.length || (i < x.length && lcs[i + 1][j] >= lcs[i][j + 1])) dels.push(x[i++]);
+      else ins.push(y[j++]);
+    }
+    const paired = Math.min(dels.length, ins.length);
+    for (let k = 0; k < paired; k++) diffValues(dels[k], ins[k], `${path}/${pos++}`, out);
+    for (let k = paired; k < dels.length; k++) out.push({ op: "remove", path: `${path}/${pos}` });
+    for (let k = paired; k < ins.length; k++) {
+      out.push({ op: "add", path: `${path}/${pos++}`, value: clone(ins[k]) });
+    }
+  }
+}
+
+function diffValues(from: Json, to: Json, path: string, out: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isPlainObject(from) && isPlainObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!hasOwn(to, key)) out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (!hasOwn(from, key)) out.push({ op: "add", path: child, value: clone(to[key]) });
+      else diffValues(from[key], to[key], child, out);
+    }
+  } else if (!jsonEqual(from, to)) {
+    out.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Computes a JSON Patch (RFC 6902) that turns `from` into `to`, containing only the changes.
+ * Neither input is mutated.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diffValues(from, to, "", out);
+  return out;
+}
diff --git a/test/createpatch.test.ts b/test/createpatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..84066a56d46cc05f761ed396e1a99c30c8a0580f
--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,44 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createPatch, applyPatch } from "../src/index.ts";
+
+const roundTrip = (a: unknown, b: unknown) => {
+  const p = createPatch(a, b);
+  assert.deepEqual(applyPatch(a, p), b);
+  return p;
+};
+
+test("small change yields small patch", () => {
+  const p = roundTrip({ a: { b: 1, c: [1, 2, 3] }, d: "x" }, { a: { b: 2, c: [1, 2, 3] }, d: "x" });
+  assert.deepEqual(p, [{ op: "replace", path: "/a/b", value: 2 }]);
+});
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("array insert and remove", () => {
+  assert.equal(roundTrip([1, 2, 3, 4], [0, 1, 2, 3, 4]).length, 1);
+  assert.equal(roundTrip([1, 2, 3, 4], [1, 3, 4]).length, 1);
+  roundTrip([1, 2, 3, 4, 5, 6], [2, 9, 4, 7, 8, 6, 1]);
+  roundTrip([{ a: 1 }, { b: 2 }], [{ a: 1, c: 3 }]);
+});
+
+test("root, type changes and special keys", () => {
+  roundTrip(1, { a: 1 });
+  roundTrip({ a: null }, { a: [] });
+  roundTrip({ "a/b": 1, "~": 2 }, { "a/b": 3, "~x": 2 });
+  const to = JSON.parse('{"__proto__": {"x": 1}}');
+  roundTrip({}, to);
+});
+
+test("does not mutate inputs", () => {
+  const a = { x: [1, 2], y: { z: 1 } };
+  const b = { x: [2], y: { z: 2 } };
+  const ac = structuredClone(a);
+  const bc = structuredClone(b);
+  const p = createPatch(a, b);
+  applyPatch(a, p);
+  assert.deepEqual(a, ac);
+  assert.deepEqual(b, bc);
+});
