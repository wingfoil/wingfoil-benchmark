--- a/src/index.ts
+++ b/src/index.ts
@@ -48,3 +48,192 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+type Json = unknown;
+
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; path: string; from: string };
+
+function isContainer(v: unknown): v is Record<string, unknown> | unknown[] {
+  return typeof v === "object" && v !== null;
+}
+
+function hasOwn(o: object, k: string): boolean {
+  return Object.prototype.hasOwnProperty.call(o, k);
+}
+
+/** Sets an own data property, safely even for keys such as "__proto__". */
+function setMember(obj: object, key: string, value: unknown): void {
+  Object.defineProperty(obj, key, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
+
+/** Deep copy of a JSON value. */
+function clone(value: Json): Json {
+  if (Array.isArray(value)) return value.map(clone);
+  if (isContainer(value)) {
+    const out: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) {
+      setMember(out, key, clone((value as Record<string, unknown>)[key]));
+    }
+    return out;
+  }
+  return value;
+}
+
+/** JSON equality as defined for the "test" operation (RFC 6902 section 4.6). */
+function jsonEqual(a: Json, b: Json): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false;
+    return a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (isContainer(a) && isContainer(b)) {
+    const ka = Object.keys(a);
+    const kb = Object.keys(b);
+    if (ka.length !== kb.length) return false;
+    return ka.every(
+      (k) =>
+        hasOwn(b, k) &&
+        jsonEqual((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]),
+    );
+  }
+  return a === b;
+}
+
+/** Parses a pointer into decoded tokens; throws if it is invalid. */
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") throw new Error("Invalid JSON Pointer: not a string");
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+function parseIndex(token: string, max: number): number {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`Invalid array index "${token}"`);
+  }
+  const index = Number(token);
+  if (index > max) throw new Error(`Array index ${token} out of range`);
+  return index;
+}
+
+/** Finds the container holding the target of `tokens` (which must be non-empty). */
+function parentOf(doc: Json, tokens: string[]): Json {
+  let current = doc;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      current = current[parseIndex(token, current.length - 1)];
+    } else if (isContainer(current) && hasOwn(current, token)) {
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`Path does not exist at "${token}"`);
+    }
+  }
+  if (!isContainer(current)) throw new Error("Parent of target is not a container");
+  return current;
+}
+
+function getAt(doc: Json, tokens: string[]): Json {
+  if (tokens.length === 0) return doc;
+  const parent = parentOf(doc, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) return parent[parseIndex(key, parent.length - 1)];
+  if (!hasOwn(parent, key)) throw new Error(`No member "${key}"`);
+  return (parent as Record<string, unknown>)[key];
+}
+
+function addAt(doc: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(doc, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    const index = key === "-" ? parent.length : parseIndex(key, parent.length);
+    parent.splice(index, 0, value);
+  } else {
+    setMember(parent, key, value);
+  }
+  return doc;
+}
+
+function removeAt(doc: Json, tokens: string[]): Json {
+  if (tokens.length === 0) throw new Error("Cannot remove the document root");
+  const parent = parentOf(doc, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(parseIndex(key, parent.length - 1), 1);
+  } else {
+    if (!hasOwn(parent, key)) throw new Error(`No member "${key}"`);
+    delete (parent as Record<string, unknown>)[key];
+  }
+  return doc;
+}
+
+function replaceAt(doc: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  getAt(doc, tokens); // target must exist
+  const parent = parentOf(doc, tokens) as Record<string, unknown> | unknown[];
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[parseIndex(key, parent.length - 1)] = value;
+  else setMember(parent, key, value);
+  return doc;
+}
+
+function applyOperation(doc: Json, operation: unknown): Json {
+  if (!isContainer(operation) || Array.isArray(operation)) {
+    throw new Error("Invalid patch operation: not an object");
+  }
+  const op = operation as Record<string, unknown>;
+  const path = parsePointer(op.path);
+  const needValue = () => {
+    if (!hasOwn(op, "value") || op.value === undefined) {
+      throw new Error(`Invalid "${String(op.op)}" operation: missing "value"`);
+    }
+    return op.value;
+  };
+
+  switch (op.op) {
+    case "add":
+      return addAt(doc, path, clone(needValue()));
+    case "remove":
+      return removeAt(doc, path);
+    case "replace":
+      return replaceAt(doc, path, clone(needValue()));
+    case "test":
+      if (!jsonEqual(getAt(doc, path), needValue())) {
+        throw new Error(`Test failed at "${op.path}"`);
+      }
+      return doc;
+    case "move":
+    case "copy": {
+      const from = parsePointer(op.from);
+      const value = getAt(doc, from);
+      if (op.op === "copy") return addAt(doc, path, clone(value));
+      const isPrefix =
+        from.length < path.length && from.every((t, i) => t === path[i]);
+      if (isPrefix) throw new Error("Cannot move a value into one of its children");
+      if (from.length === path.length && from.every((t, i) => t === path[i])) return doc;
+      return addAt(removeAt(doc, from), path, value);
+    }
+    default:
+      throw new Error(`Invalid patch operation: unknown op "${String(op.op)}"`);
+  }
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a document and returns the result.
+ * The input is never mutated; throws if the patch is invalid or any operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new Error("Invalid JSON Patch: not an array");
+  let doc = clone(document);
+  for (const operation of patch) doc = applyOperation(doc, operation);
+  return doc;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..66aa2512ade0950eb60abafb31d8a3ac9573f250
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,47 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("RFC 6902 examples", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(applyPatch({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]), { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(applyPatch({ a: [1] }, [{ op: "copy", from: "/a", path: "/b" }]), { a: [1], b: [1] });
+  assert.deepEqual(applyPatch({ a: { x: 1, y: 2 } }, [{ op: "test", path: "/a", value: { y: 2, x: 1 } }]), { a: { x: 1, y: 2 } });
+});
+
+test("errors", () => {
+  const bad = (doc: unknown, p: unknown) => assert.throws(() => applyPatch(doc, p));
+  bad({}, {});
+  bad({}, [{ op: "nope", path: "" }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad({}, [{ op: "add", path: "/a/b", value: 1 }]);
+  bad([1], [{ op: "add", path: "/2", value: 1 }]);
+  bad([1], [{ op: "add", path: "/01", value: 1 }]);
+  bad([1], [{ op: "remove", path: "/-" }]);
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+  bad({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  bad({}, [{ op: "copy", path: "/a" }]);
+});
+
+test("does not mutate input; atomic", () => {
+  const doc = { a: [1, { b: 2 }] };
+  const snap = JSON.stringify(doc);
+  const out = applyPatch(doc, [{ op: "copy", from: "/a", path: "/c" }, { op: "add", path: "/c/1/b", value: 9 }]) as any;
+  assert.equal(JSON.stringify(doc), snap);
+  assert.equal(out.a[1].b, 2);
+  assert.equal(out.c[1].b, 9);
+  assert.throws(() => applyPatch(doc, [{ op: "remove", path: "/a" }, { op: "remove", path: "/a" }]));
+  assert.equal(JSON.stringify(doc), snap);
+});
+
+test("null value and root ops", () => {
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a", value: null }]), { a: null });
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+});
