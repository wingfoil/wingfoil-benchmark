--- a/src/index.ts
+++ b/src/index.ts
@@ -206,3 +206,21 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the merged document.
+ * The inputs are not mutated.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return structuredClone(patch);
+  const result: Record<string, unknown> = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) setMember(result, key, structuredClone(target[key]));
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) delete result[key];
+    else setMember(result, key, applyMergePatch(Object.hasOwn(result, key) ? result[key] : undefined, value));
+  }
+  return result;
+}
diff --git a/test/merge.test.ts b/test/merge.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..da8ed550543a21f63c743e1e5f191e7e2b8bf40a
--- /dev/null
+++ b/test/merge.test.ts
@@ -0,0 +1,17 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 example", () => {
+  const target = { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["a", "b"], content: "x" };
+  const patch = { title: "Hello!", phoneNumber: "+01", author: { familyName: null }, tags: ["c"] };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!", author: { givenName: "John" }, tags: ["c"], content: "x", phoneNumber: "+01",
+  });
+});
+
+test("non-object patches and nulls in new objects", () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, [1]), [1]);
+  assert.deepEqual(applyMergePatch([1], { a: { b: null } }), { a: {} });
+  assert.equal(applyMergePatch({ a: 1 }, null), null);
+});
