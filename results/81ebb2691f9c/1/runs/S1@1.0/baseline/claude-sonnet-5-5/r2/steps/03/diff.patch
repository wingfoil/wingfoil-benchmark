diff --git a/test/patch.test.ts b/test/patch.test.ts
index f7846a359f1d41e960719f178250a7cf79d971f5..5666ba961c51a12bdb52d689b01303dfcff8fd66 100644
--- a/test/patch.test.ts
+++ b/test/patch.test.ts
@@ -24,3 +24,13 @@ test("failures and immutability", () => {
   assert.throws(() => applyPatch(doc, {}));
   assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a", value: [1, 2] }]));
 });
+
+test("RFC 6902 edge cases", () => {
+  assert.deepEqual(applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a/b", path: "/a" }]), { a: 1 });
+  assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "/b", path: "/b" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.deepEqual(applyPatch({ a: [1] }, [{ op: "add", path: "/a/1", value: 2 }]), { a: [1, 2] });
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "replace", path: "/a/-", value: 2 }]));
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "test", path: "/a", value: [] }]));
+});
