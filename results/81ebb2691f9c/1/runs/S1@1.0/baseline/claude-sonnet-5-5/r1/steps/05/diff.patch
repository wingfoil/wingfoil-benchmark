+++ b/test/create-patch.test.ts
@@ -0,0 +1,30 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createPatch, applyPatch } from "../src/index.ts";
+
+const cases: [unknown, unknown][] = [
+  [{ a: 1 }, { a: 1 }],
+  [{ a: 1, b: { c: [1, 2, 3] } }, { a: 1, b: { c: [1, 2, 4] } }],
+  [[1, 2, 3, 4], [1, 4]],
+  [[1, 2], [0, 1, 2, 3]],
+  [{ "a/b": 1, "~": 2 }, { "a/b": 2, x: 3 }],
+  [1, { a: 1 }],
+  [[1, [2]], { a: null }],
+  [{ a: [] }, { a: {} }],
+];
+
+test("createPatch round-trips without mutating", () => {
+  for (const [from, to] of cases) {
+    const f = JSON.stringify(from), t = JSON.stringify(to);
+    const patch = createPatch(from, to);
+    assert.deepEqual(applyPatch(from, patch), to);
+    assert.equal(JSON.stringify(from), f);
+    assert.equal(JSON.stringify(to), t);
+  }
+});
+
+test("createPatch is minimal", () => {
+  assert.deepEqual(createPatch({ a: 1, b: { c: 2 } }, { a: 1, b: { c: 3 } }), [{ op: "replace", path: "/b/c", value: 3 }]);
+  assert.deepEqual(createPatch([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(createPatch({ a: 1 }, { a: 1 }), []);
+});
