   return result;
 }
+
+/**
+ * JSON Patch generation.
+ */
+
+type PatchOperation = { op: "add" | "remove" | "replace"; path: string; value?: unknown };
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffInto(from: Json, to: Json, path: string, out: PatchOperation[]): void {
+  if (deepEqual(from, to)) return;
+
+  if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (!has(from, key)) out.push({ op: "add", path: child, value: clone(to[key]) });
+      else diffInto(from[key], to[key], child, out);
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    let start = 0;
+    while (start < from.length && start < to.length && deepEqual(from[start], to[start])) start++;
+    let fromEnd = from.length;
+    let toEnd = to.length;
+    while (fromEnd > start && toEnd > start && deepEqual(from[fromEnd - 1], to[toEnd - 1])) {
+      fromEnd--;
+      toEnd--;
+    }
+    const common = Math.min(fromEnd, toEnd) - start;
+    for (let i = 0; i < common; i++) diffInto(from[start + i], to[start + i], `${path}/${start + i}`, out);
+    // Removals go from the highest index down so earlier indices stay valid.
+    for (let i = fromEnd - 1; i >= start + common; i--) out.push({ op: "remove", path: `${path}/${i}` });
+    for (let i = start + common; i < toEnd; i++) out.push({ op: "add", path: `${path}/${i}`, value: clone(to[i]) });
+    return;
+  }
+
+  out.push({ op: "replace", path, value: clone(to) });
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only the
+ * differences. The inputs are not mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diffInto(from, to, "", out);
+  return out;
+}
