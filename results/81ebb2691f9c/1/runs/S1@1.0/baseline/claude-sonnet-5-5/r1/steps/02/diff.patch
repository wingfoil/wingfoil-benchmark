+++ b/src/index.ts
@@ -51,3 +51,160 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+/**
+ * JSON Patch (RFC 6902).
+ */
+
+type Json = unknown;
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function has(object: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(object, key);
+}
+
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty so that a "__proto__" member is an ordinary own property.
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone(value: Json): Json {
+  if (Array.isArray(value)) return value.map(clone);
+  if (isObject(value)) {
+    const result: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(result, key, clone(value[key]));
+    return result;
+  }
+  return value;
+}
+
+function deepEqual(a: Json, b: Json): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => deepEqual(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((k) => has(b, k) && deepEqual(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/** Index into `array` for `token`; `allowEnd` accepts "-" and index === length (for add). */
+function arrayIndex(array: unknown[], token: string, allowEnd: boolean): number {
+  if (allowEnd && token === "-") return array.length;
+  if (!ARRAY_INDEX.test(token)) throw new Error(`Invalid array index "${token}"`);
+  const index = Number(token);
+  if (index > array.length || (!allowEnd && index === array.length)) {
+    throw new Error(`Array index ${token} is out of bounds`);
+  }
+  return index;
+}
+
+/** Walks to the parent of the pointer's target; the root document is never passed here. */
+function parentOf(document: Json, tokens: string[]): Json {
+  let current = document;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      current = current[arrayIndex(current, token, false)];
+    } else if (isObject(current) && has(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path does not resolve at "${token}"`);
+    }
+  }
+  return current;
+}
+
+function addAt(document: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(document, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(parent, last, true), 0, value);
+  } else if (isObject(parent)) {
+    setMember(parent, last, value);
+  } else {
+    throw new Error("Cannot add into a primitive value");
+  }
+  return document;
+}
+
+function removeAt(document: Json, tokens: string[]): { document: Json; removed: Json } {
+  if (tokens.length === 0) return { document: undefined, removed: document };
+  const parent = parentOf(document, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    return { document, removed: parent.splice(arrayIndex(parent, last, false), 1)[0] };
+  }
+  if (isObject(parent) && has(parent, last)) {
+    const removed = parent[last];
+    delete parent[last];
+    return { document, removed };
+  }
+  throw new Error(`Cannot remove: no member "${last}"`);
+}
+
+/**
+ * Applies the JSON Patch `patch` (RFC 6902) to `document` and returns the result as a new value.
+ * The inputs are not mutated. Throws if the patch is invalid or any operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new TypeError("JSON Patch must be an array");
+  let result = clone(document);
+
+  for (const operation of patch) {
+    if (!isObject(operation)) throw new TypeError("JSON Patch operation must be an object");
+    const { op } = operation;
+    if (typeof operation.path !== "string") throw new TypeError("Operation requires a string \"path\"");
+    const path = parsePointer(operation.path);
+
+    const needValue = () => {
+      if (!has(operation, "value")) throw new TypeError(`Operation "${op}" requires a "value"`);
+      return operation.value;
+    };
+    const needFrom = () => {
+      if (typeof operation.from !== "string") throw new TypeError(`Operation "${op}" requires a string "from"`);
+      return parsePointer(operation.from);
+    };
+
+    switch (op) {
+      case "add":
+        result = addAt(result, path, clone(needValue()));
+        break;
+      case "remove":
+        result = removeAt(result, path).document;
+        break;
+      case "replace": {
+        const value = clone(needValue());
+        result = addAt(removeAt(result, path).document, path, value);
+        break;
+      }
+      case "move": {
+        const from = needFrom();
+        if (from.length < path.length && from.every((t, i) => t === path[i])) {
+          throw new Error("Cannot move a value into one of its own children");
+        }
+        const removed = removeAt(result, from);
+        result = addAt(removed.document, path, removed.removed);
+        break;
+      }
+      case "copy": {
+        const from = needFrom();
+        result = addAt(result, path, clone(resolvePointer(result, operation.from as string)));
+        break;
+      }
+      case "test":
+        if (!deepEqual(resolvePointer(result, operation.path), needValue())) {
+          throw new Error(`Test failed at "${operation.path}"`);
+        }
+        break;
+      default:
+        throw new TypeError(`Unknown operation: ${String(op)}`);
+    }
+  }
+  return result;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..588d6d9090c2b00ff5cb775cdd5c61adced58e6a
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,57 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("RFC 6902 appendix A examples", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(applyPatch({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+  assert.deepEqual(applyPatch({ baz: "qux" }, [{ op: "replace", path: "/baz", value: "boo" }]), { baz: "boo" });
+  assert.deepEqual(
+    applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  assert.deepEqual(applyPatch({ foo: [1] }, [{ op: "copy", from: "/foo/0", path: "/foo/-" }]), { foo: [1, 1] });
+  assert.deepEqual(applyPatch({ a: { b: 1 } }, [{ op: "test", path: "/a", value: { b: 1 } }]), { a: { b: 1 } });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+});
+
+test("does not mutate input or alias patch values", () => {
+  const doc = { a: [1, { b: 2 }] };
+  const value = { x: 1 };
+  const out = applyPatch(doc, [{ op: "add", path: "/v", value }, { op: "remove", path: "/a/0" }]) as any;
+  assert.deepEqual(doc, { a: [1, { b: 2 }] });
+  out.v.x = 9;
+  assert.equal(value.x, 1);
+});
+
+test("failures throw", () => {
+  const bad: unknown[][] = [
+    [{ op: "test", path: "/a", value: 2 }],
+    [{ op: "remove", path: "/zz" }],
+    [{ op: "replace", path: "/zz", value: 1 }],
+    [{ op: "add", path: "/x/y", value: 1 }],
+    [{ op: "add", path: "/l/5", value: 1 }],
+    [{ op: "add", path: "/l/01", value: 1 }],
+    [{ op: "add", path: "/a" }],
+    [{ op: "move", from: "/l", path: "/l/0" }],
+    [{ op: "copy", from: "/nope", path: "/q" }],
+    [{ op: "bogus", path: "/a" }],
+    [{ op: "add", value: 1 }],
+    [null],
+  ];
+  for (const patch of bad) assert.throws(() => applyPatch({ a: 1, l: [1] }, patch));
+  assert.throws(() => applyPatch({}, {}));
+});
+
+test("test compares deeply, ignoring key order, and distinguishes types", () => {
+  const doc = { a: { x: 1, y: [1, 2] }, n: 1 };
+  applyPatch(doc, [{ op: "test", path: "/a", value: { y: [1, 2], x: 1 } }]);
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/n", value: "1" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/y", value: [2, 1] }]));
+});
