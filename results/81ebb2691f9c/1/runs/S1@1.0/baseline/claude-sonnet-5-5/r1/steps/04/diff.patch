   return result;
 }
+
+/**
+ * JSON Merge Patch (RFC 7386).
+ */
+
+/**
+ * Applies the JSON Merge Patch `patch` (RFC 7386) to `target` and returns the result as a new value.
+ * The inputs are not mutated. A non-object patch replaces the target; `null` members delete.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch);
+  const result = isObject(target) ? (clone(target) as Record<string, unknown>) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(has(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
diff --git a/test/merge-patch.test.ts b/test/merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fadb5d5dce1d47276ffcebef9fb863c3bfa4278a
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,35 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("does not mutate inputs and handles __proto__", () => {
+  const target = { a: { b: 1 } };
+  const patch = JSON.parse('{"a":{"c":2},"__proto__":{"x":1}}');
+  const out = applyMergePatch(target, patch) as Record<string, unknown>;
+  assert.deepEqual(target, { a: { b: 1 } });
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+  assert.deepEqual(Object.keys(out), ["a", "__proto__"]);
+});
