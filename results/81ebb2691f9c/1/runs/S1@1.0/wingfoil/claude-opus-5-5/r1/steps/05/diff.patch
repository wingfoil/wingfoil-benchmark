+/**
+ * Creating a JSON Patch (RFC 6902): the operations that turn one JSON document into another.
+ *
+ * The patch follows the structure the two documents share: it descends into objects and arrays
+ * present in both, so a value that differs in one small place gives a patch about that place only.
+ */
+
+// The largest number of element pairs compared to align the differing middles of two arrays. Above
+// it, the middles are compared position by position: the patch is still correct, though maybe longer.
+const MAX_ALIGNMENT_PAIRS = 1_000_000;
+
+/**
+ * Returns a JSON Patch that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * `from` and `to` must be JSON values: null, booleans, finite numbers, strings, and arrays and plain
+ * objects of these, without cycles. Neither is modified, and the patch shares no object or array with
+ * them. The patch only uses `add`, `remove` and `replace`, and describes the differences only: equal
+ * documents give an empty patch, objects are compared member by member regardless of member order,
+ * and arrays are aligned on their longest common subsequence of elements, so that inserting or
+ * removing one element gives one operation. A value whose type changes is replaced as a whole.
+ * Applying the patch gives a document equal to `to`, whose members may be in another order.
+ *
+ * @throws {JsonPatchError} when `from` or `to` is not a JSON value; its `index` is `undefined`.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  if (!isJsonValue(from)) {
+    throw new JsonPatchError("the source document is not a JSON value");
+  }
+  if (!isJsonValue(to)) {
+    throw new JsonPatchError("the target document is not a JSON value");
+  }
+  const patch: JsonPatchOperation[] = [];
+  diffValues(from, to, "", patch);
+  return patch;
+}
+
+// Appends to `patch` the operations that turn `from`, found at `path`, into `to`.
+function diffValues(from: unknown, to: unknown, path: string, patch: JsonPatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, patch);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from, to, path, patch);
+  } else if (!jsonEqual(from, to)) {
+    patch.push({ op: "replace", path, value: cloneJson(to) });
+  }
+}
+
+// Members are visited in the order of `from`, then of `to`, so the patch is deterministic.
+function diffObjects(from: Record<string, unknown>, to: Record<string, unknown>, path: string, patch: JsonPatchOperation[]): void {
+  for (const [key, value] of Object.entries(from)) {
+    const memberPath = `${path}/${encodeToken(key)}`;
+    if (Object.hasOwn(to, key)) {
+      diffValues(value, to[key], memberPath, patch);
+    } else {
+      patch.push({ op: "remove", path: memberPath });
+    }
+  }
+  for (const [key, value] of Object.entries(to)) {
+    if (!Object.hasOwn(from, key)) {
+      patch.push({ op: "add", path: `${path}/${encodeToken(key)}`, value: cloneJson(value) });
+    }
+  }
+}
+
+// Escapes a member name as a reference token: `~` as `~0`, then `/` as `~1` (RFC 6901, section 3).
+function encodeToken(key: string): string {
+  return key.replaceAll("~", "~0").replaceAll("/", "~1");
+}
+
+// Diffs two arrays: their common head and tail are kept as they are, and their differing middles
+// are aligned on a longest common subsequence where they are small enough.
+function diffArrays(from: unknown[], to: unknown[], path: string, patch: JsonPatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+    start++;
+  }
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && jsonEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+  const removed = from.slice(start, fromEnd);
+  const added = to.slice(start, toEnd);
+  if (removed.length * added.length > MAX_ALIGNMENT_PAIRS) {
+    diffArrayRun(removed, added, path, start, patch);
+    return;
+  }
+  // Each run of differing elements between two common ones is diffed on its own; `index` is the
+  // position, in the array as the patch has changed it so far, of the next element to compare.
+  let index = start;
+  let fromIndex = 0;
+  let toIndex = 0;
+  for (const [fromCommon, toCommon] of commonSubsequence(removed, added)) {
+    index = diffArrayRun(removed.slice(fromIndex, fromCommon), added.slice(toIndex, toCommon), path, index, patch) + 1;
+    fromIndex = fromCommon + 1;
+    toIndex = toCommon + 1;
+  }
+  diffArrayRun(removed.slice(fromIndex), added.slice(toIndex), path, index, patch);
+}
+
+// Turns the elements `from`, found at `index`, into the elements `to`: pairs of elements are diffed
+// in place, then the extra elements are removed or added. Returns the index after the last element.
+function diffArrayRun(from: unknown[], to: unknown[], path: string, index: number, patch: JsonPatchOperation[]): number {
+  const paired = Math.min(from.length, to.length);
+  for (let i = 0; i < paired; i++) {
+    diffValues(from[i], to[i], `${path}/${index + i}`, patch);
+  }
+  for (let i = paired; i < from.length; i++) {
+    patch.push({ op: "remove", path: `${path}/${index + paired}` });
+  }
+  for (let i = paired; i < to.length; i++) {
+    patch.push({ op: "add", path: `${path}/${index + i}`, value: cloneJson(to[i]) });
+  }
+  return index + to.length;
+}
+
+// Returns the positions, in `a` and in `b`, of the elements of a longest common subsequence of them.
+function commonSubsequence(a: unknown[], b: unknown[]): Array<[number, number]> {
+  const width = b.length + 1;
+  // `lengths[i * width + j]` is the length of a longest common subsequence of `a[i..]` and `b[j..]`.
+  const lengths = new Uint32Array((a.length + 1) * width);
+  const equal = (i: number, j: number) => jsonEqual(a[i], b[j]);
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lengths[i * width + j] = equal(i, j)
+        ? lengths[(i + 1) * width + j + 1] + 1
+        : Math.max(lengths[(i + 1) * width + j], lengths[i * width + j + 1]);
+    }
+  }
+  const pairs: Array<[number, number]> = [];
+  let i = 0;
+  let j = 0;
+  while (i < a.length && j < b.length) {
+    if (lengths[i * width + j] === lengths[(i + 1) * width + j + 1] + 1 && equal(i, j)) {
+      pairs.push([i, j]);
+      i++;
+      j++;
+    } else if (lengths[(i + 1) * width + j] >= lengths[i * width + j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
