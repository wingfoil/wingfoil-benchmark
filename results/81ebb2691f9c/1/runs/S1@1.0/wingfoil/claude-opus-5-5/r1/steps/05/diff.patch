+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch, JsonPatchError } from "../src/index.ts";
+
+// Checks that the patch from `from` to `to` turns `from` into `to`, and returns it.
+function roundTrip(from: unknown, to: unknown): unknown[] {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: null }] }, { a: [1, { b: null }] }), []);
+  assert.deepEqual(roundTrip(3, 3), []);
+});
+
+test("objects compare regardless of member order", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+});
+
+test("a changed primitive member is replaced, and nothing else", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: { c: "x", d: [1, 2] } }, { a: 1, b: { c: "y", d: [1, 2] } }), [
+    { op: "replace", path: "/b/c", value: "y" },
+  ]);
+});
+
+test("added and removed members", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, c: { d: 3 } }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: { d: 3 } },
+  ]);
+});
+
+test("a member set to null is replaced, not removed", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+});
+
+test("a change of type replaces the value", () => {
+  assert.deepEqual(roundTrip({ a: [1] }, { a: { 0: 1 } }), [{ op: "replace", path: "/a", value: { 0: 1 } }]);
+  assert.deepEqual(roundTrip({ a: 1 }, ["a"]), [{ op: "replace", path: "", value: ["a"] }]);
+  assert.deepEqual(roundTrip("1", 1), [{ op: "replace", path: "", value: 1 }]);
+});
+
+test("member names are escaped as JSON Pointer tokens", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "m~n": 2, "": 3 }, { "a/b": 2, "m~n": 3, "": 4 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/m~0n", value: 3 },
+    { op: "replace", path: "/", value: 4 },
+  ]);
+});
+
+test("an element inserted into an array is added alone", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, "x", 3, 4]), [{ op: "add", path: "/2", value: "x" }]);
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(roundTrip([], [0]), [{ op: "add", path: "/0", value: 0 }]);
+});
+
+test("an element removed from an array is removed alone", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip(["a", "b", "c"], []), [
+    { op: "remove", path: "/0" },
+    { op: "remove", path: "/0" },
+    { op: "remove", path: "/0" },
+  ]);
+});
+
+test("a changed array element is diffed in place", () => {
+  assert.deepEqual(roundTrip([{ id: 1, n: "a" }, { id: 2, n: "b" }], [{ id: 1, n: "a" }, { id: 2, n: "c" }]), [
+    { op: "replace", path: "/1/n", value: "c" },
+  ]);
+});
+
+test("mixed array edits apply in order", () => {
+  const cases: Array<[unknown[], unknown[]]> = [
+    [["a", "b", "c", "d", "e"], ["x", "b", "d", "y", "e", "z"]],
+    [[1, 2, 3], [3, 2, 1]],
+    [[1, 1, 2, 2], [2, 2, 1, 1]],
+    [[[1, 2], [3]], [[1], [3, 4], []]],
+    [[null, true, false], [false, null]],
+  ];
+  for (const [from, to] of cases) {
+    roundTrip(from, to);
+  }
+});
+
+test("a small change in a large document gives a small patch", () => {
+  const items = Array.from({ length: 2000 }, (_, id) => ({ id, name: `item ${id}`, tags: ["a", "b"] }));
+  const from = { version: 1, items };
+  const to = { version: 1, items: items.map((item) => (item.id === 1234 ? { ...item, tags: ["a", "c"] } : item)) };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/items/1234/tags/1", value: "c" }]);
+});
+
+test("large arrays with many changes still give a correct patch", () => {
+  const from = Array.from({ length: 3000 }, (_, i) => i);
+  const to = Array.from({ length: 3000 }, (_, i) => (i % 3 === 0 ? i + 0.5 : i));
+  roundTrip(from, to);
+  roundTrip(from, [...from].reverse());
+});
+
+test("neither input is modified, and the patch shares nothing with them", () => {
+  const from = { a: [1, { b: 2 }], c: { d: 1 } };
+  const to = { a: [1, { b: 3 }, { e: [5] }], f: { g: [] } };
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to) as Array<{ value?: unknown }>;
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  for (const operation of patch) {
+    if (typeof operation.value === "object" && operation.value !== null) {
+      (operation.value as Record<string, unknown>).mutated = true;
+    }
+  }
+  assert.deepEqual(to, toCopy);
+});
+
+test("a __proto__ member is an ordinary member", () => {
+  const from = JSON.parse('{"__proto__": {"a": 1}, "b": 1}');
+  const to = JSON.parse('{"__proto__": {"a": 2}}');
+  assert.deepEqual(roundTrip(from, to), [
+    { op: "replace", path: "/__proto__/a", value: 2 },
+    { op: "remove", path: "/b" },
+  ]);
+  assert.equal(({} as Record<string, unknown>).a, undefined);
+  const added = createPatch(null, to) as Array<{ value: object }>;
+  assert.ok(Object.hasOwn(added[0].value, "__proto__"));
+  assert.equal(Object.getPrototypeOf(added[0].value), Object.prototype);
+});
+
+test("null-prototype objects and shared sub-values are JSON values", () => {
+  const shared = { x: 1 };
+  const from = Object.assign(Object.create(null), { a: shared, b: shared });
+  roundTrip(from, { a: shared, b: { x: 2 } });
+});
+
+test("inputs that are not JSON values are rejected", () => {
+  const cyclic: Record<string, unknown> = {};
+  cyclic.self = cyclic;
+  for (const bad of [undefined, NaN, Infinity, new Date(0), new Map(), () => 1, [1, , 3], { a: undefined }, cyclic]) {
+    assert.throws(() => createPatch(bad, {}), (error: unknown) => error instanceof JsonPatchError && error.index === undefined);
+    assert.throws(() => createPatch({}, bad), JsonPatchError);
+  }
+});
