+---
+id: task-002-implement-json-patch-rfc-6902-applypatch
+type: task
+title: "Implement JSON Patch (RFC 6902) applyPatch"
+status: pending
+format: 1
+---
+
+## Request
+
+Implement JSON Patch (RFC 6902) with its six operations: export `applyPatch(document, patch)` from
+`src/index.ts`, returning the resulting document as a new value without mutating the input, and
+throwing when the patch is invalid or an operation fails.
+
+## What was done
+
+- `test/json-patch.test.ts`: written first (red: the import failed), then green — every example of
+  RFC 6902 appendix A (successes and failures), sequencing, no mutation of document or patch, no
+  shared objects in the result, atomicity, each operation's happy and error paths (root paths,
+  `-`/append/out-of-range/leading-zero indexes, primitives, inherited members, move into a child,
+  move to the same place, independent copies), `test` equality (member order, falsy values),
+  `__proto__` safety, patch/operation validation, and error shape (`index`, `cause`).
+- `src/index.ts`: `applyPatch`, `JsonPatchError` and the `JsonPatchOperation` type, reusing
+  `parsePointer`/`resolvePointer`, with doc comments.
+- `README.md`: usage and error behaviour of `applyPatch`.
+- `npm test`: 45 tests pass (31 new); `tsc --noEmit -p .` passes.
+- Design choices recorded in dl-002-json-patch-api-atomic-copy-on-apply-upfront-validation-jsonpatcherror-with-index.
diff --git a/src/index.ts b/src/index.ts
index f5d62cde8bb6ed79deb1f6842b12136069cf911f..de9932050c3b9c5311f043010512cecbba1f648b 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -87,3 +87,218 @@ function resolveToken(value: unknown, token: string, pointer: string): unknown {
   }
   throw new JsonPointerError(`cannot reference ${JSON.stringify(token)} in a primitive value`, pointer);
 }
+
+/**
+ * JSON Patch (RFC 6902): a sequence of operations that changes a JSON document.
+ *
+ * A patch is applied atomically: the operations change a copy of the document, so a patch that
+ * fails leaves no partial result and the caller's document is never modified.
+ */
+
+/** One operation of a JSON Patch, as it reads once validated (RFC 6902, section 4). */
+export type JsonPatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; from: string; path: string };
+
+/** Error thrown when a patch is invalid, or when one of its operations fails. */
+export class JsonPatchError extends Error {
+  /** The position in the patch of the operation at fault; `undefined` when the patch is not an array. */
+  readonly index: number | undefined;
+
+  constructor(message: string, index?: number, options?: ErrorOptions) {
+    super(index === undefined ? message : `operation ${index}: ${message}`, options);
+    this.name = "JsonPatchError";
+    this.index = index;
+  }
+}
+
+// An operation that cannot be carried out; `applyPatch` turns it into a `JsonPatchError`.
+class OperationFailure extends Error {}
+
+const OPERATIONS = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+
+/**
+ * Applies `patch`, a JSON Patch, to `document` and returns the resulting document.
+ *
+ * The result is a new value that shares no object or array with `document` or `patch`, neither of
+ * which is modified. The whole patch is validated before any operation is applied; the operations
+ * then apply in order, each to the result of the previous one. Members of an operation other than
+ * `op`, `path`, `from` and `value` are ignored. Object members are always set as own data members,
+ * so a `__proto__` member never changes a prototype.
+ *
+ * @throws {JsonPatchError} when `patch` is not an array of valid operations, or when an operation
+ * fails: its target or `from` location does not exist, a `move` would put a value inside itself,
+ * a `test` finds a different value, or a `remove` targets the whole document. Its `index` tells
+ * which operation; a pointer that does not resolve is kept as its `cause`.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new JsonPatchError("a JSON Patch must be an array of operations");
+  }
+  const operations = patch.map(validateOperation);
+  let result = cloneJson(document);
+  operations.forEach((operation, index) => {
+    try {
+      result = applyOperation(result, operation);
+    } catch (error) {
+      if (error instanceof OperationFailure) {
+        throw new JsonPatchError(error.message, index);
+      }
+      if (error instanceof JsonPointerError) {
+        throw new JsonPatchError(error.message, index, { cause: error });
+      }
+      throw error;
+    }
+  });
+  return result;
+}
+
+function validateOperation(operation: unknown, index: number): JsonPatchOperation {
+  if (!isObject(operation)) {
+    throw new JsonPatchError("an operation must be an object", index);
+  }
+  const { op } = operation;
+  if (typeof op !== "string" || !OPERATIONS.has(op)) {
+    throw new JsonPatchError(`unknown op ${JSON.stringify(op)}`, index);
+  }
+  const path = pointerMember(operation, "path", index);
+  switch (op) {
+    case "remove":
+      return { op, path };
+    case "move":
+    case "copy":
+      return { op, from: pointerMember(operation, "from", index), path };
+    default:
+      // A member holding `undefined` is no JSON value: it counts as missing.
+      if (!Object.hasOwn(operation, "value") || operation.value === undefined) {
+        throw new JsonPatchError(`a "${op}" operation needs a "value" member`, index);
+      }
+      return { op: op as "add" | "replace" | "test", path, value: operation.value };
+  }
+}
+
+function pointerMember(operation: Record<string, unknown>, name: "path" | "from", index: number): string {
+  const pointer = operation[name];
+  if (!Object.hasOwn(operation, name) || typeof pointer !== "string") {
+    throw new JsonPatchError(`the "${name}" member must be a string`, index);
+  }
+  try {
+    parsePointer(pointer);
+  } catch (error) {
+    throw new JsonPatchError(`the "${name}" member is invalid: ${(error as Error).message}`, index, { cause: error });
+  }
+  return pointer;
+}
+
+function applyOperation(document: unknown, operation: JsonPatchOperation): unknown {
+  switch (operation.op) {
+    case "add":
+      return addValue(document, operation.path, cloneJson(operation.value));
+    case "remove":
+      removeValue(document, operation.path);
+      return document;
+    case "replace":
+      if (operation.path === "") {
+        return cloneJson(operation.value);
+      }
+      removeValue(document, operation.path);
+      return addValue(document, operation.path, cloneJson(operation.value));
+    case "move":
+      if (operation.from === operation.path) {
+        return document;
+      }
+      // Reference tokens are separated by `/` and never contain one, so this is a token prefix.
+      if (operation.path.startsWith(`${operation.from}/`)) {
+        throw new OperationFailure(`cannot move ${JSON.stringify(operation.from)} into one of its children`);
+      }
+      return addValue(document, operation.path, removeValue(document, operation.from));
+    case "copy":
+      return addValue(document, operation.path, cloneJson(resolvePointer(document, operation.from)));
+    case "test":
+      if (!jsonEqual(resolvePointer(document, operation.path), operation.value)) {
+        throw new OperationFailure(`the value at ${JSON.stringify(operation.path)} differs from the expected value`);
+      }
+      return document;
+  }
+}
+
+// Splits a non-empty pointer into the pointer to its parent and its last, decoded, token.
+function splitPointer(pointer: string): [string, string] {
+  return [pointer.slice(0, pointer.lastIndexOf("/")), parsePointer(pointer).at(-1) as string];
+}
+
+// Adds `value` at `path` in `document`, in place, and returns the resulting document.
+function addValue(document: unknown, path: string, value: unknown): unknown {
+  if (path === "") {
+    return value;
+  }
+  const [parentPointer, token] = splitPointer(path);
+  const parent = resolvePointer(document, parentPointer);
+  if (Array.isArray(parent)) {
+    const index = token === "-" ? parent.length : Number(token);
+    if (token !== "-" && (!ARRAY_INDEX.test(token) || index > parent.length)) {
+      throw new OperationFailure(`cannot add at ${JSON.stringify(path)}: not an index from 0 to ${parent.length}, nor "-"`);
+    }
+    parent.splice(index, 0, value);
+  } else if (isObject(parent)) {
+    setMember(parent, token, value);
+  } else {
+    throw new OperationFailure(`cannot add at ${JSON.stringify(path)}: its parent is a primitive value`);
+  }
+  return document;
+}
+
+// Removes the existing value at `path` in `document`, in place, and returns it.
+function removeValue(document: unknown, path: string): unknown {
+  if (path === "") {
+    throw new OperationFailure("cannot remove the whole document");
+  }
+  const value = resolvePointer(document, path);
+  const [parentPointer, token] = splitPointer(path);
+  const parent = resolvePointer(document, parentPointer) as unknown[] | Record<string, unknown>;
+  if (Array.isArray(parent)) {
+    parent.splice(Number(token), 1);
+  } else {
+    delete parent[token];
+  }
+  return value;
+}
+
+// Sets an own data member, even for a key such as `__proto__` that assignment would treat specially.
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+// Deep-copies a JSON value; `Object.fromEntries` keeps `__proto__` as an own member.
+function cloneJson(value: unknown): unknown {
+  if (Array.isArray(value)) {
+    return value.map(cloneJson);
+  }
+  if (isObject(value)) {
+    return Object.fromEntries(Object.entries(value).map(([key, member]) => [key, cloneJson(member)]));
+  }
+  return value;
+}
+
+// JSON equality as `test` defines it (RFC 6902, section 4.6): objects regardless of member order.
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((element, index) => jsonEqual(element, b[index]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) {
+      return false;
+    }
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.hasOwn(b, key) && jsonEqual(a[key], b[key]))
+    );
+  }
+  return a === b;
+}
