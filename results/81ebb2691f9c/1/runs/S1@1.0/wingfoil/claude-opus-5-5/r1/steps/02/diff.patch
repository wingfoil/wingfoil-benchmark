index 0000000000000000000000000000000000000000..7b647154fc08e6203bc1bbf1f2cf10ffa7b714a7
--- /dev/null
+++ b/test/json-patch.test.ts
@@ -0,0 +1,264 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, JsonPatchError, JsonPointerError } from "../src/index.ts";
+
+// The examples of RFC 6902, appendix A, that succeed: [title, document, patch, expected result].
+const rfcSuccesses: Array<[string, unknown, unknown[], unknown]> = [
+  ["A.1 adding an object member", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { baz: "qux", foo: "bar" }],
+  ["A.2 adding an array element", { foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] }],
+  ["A.3 removing an object member", { baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }],
+  ["A.4 removing an array element", { foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }],
+  ["A.5 replacing a value", { baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" }],
+  [
+    "A.6 moving a value",
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  ],
+  ["A.7 moving an array element", { foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], { foo: ["all", "cows", "eat", "grass"] }],
+  [
+    "A.8 testing a value: success",
+    { baz: "qux", foo: ["a", 2, "c"] },
+    [
+      { op: "test", path: "/baz", value: "qux" },
+      { op: "test", path: "/foo/1", value: 2 },
+    ],
+    { baz: "qux", foo: ["a", 2, "c"] },
+  ],
+  ["A.10 adding a nested member object", { foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } }],
+  ["A.11 ignoring unrecognized elements", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" }],
+  ["A.14 ~ escape ordering", { "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }],
+  ["A.16 adding an array value", { foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] }],
+];
+
+// The examples of RFC 6902, appendix A, that fail: [title, document, patch].
+const rfcFailures: Array<[string, unknown, unknown[]]> = [
+  ["A.9 testing a value: error", { baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]],
+  ["A.12 adding to a nonexistent target", { foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]],
+  ["A.15 comparing strings and numbers", { "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]],
+];
+
+test("applies the successful examples of RFC 6902 appendix A", () => {
+  for (const [title, document, patch, expected] of rfcSuccesses) {
+    assert.deepEqual(applyPatch(document, patch), expected, title);
+  }
+});
+
+test("rejects the failing examples of RFC 6902 appendix A", () => {
+  for (const [title, document, patch] of rfcFailures) {
+    assert.throws(() => applyPatch(document, patch), JsonPatchError, title);
+  }
+});
+
+test("A.13 a patch whose operation has an invalid op member is rejected", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "invalid", path: "/baz" }]), JsonPatchError);
+});
+
+test("an empty patch returns an equal document", () => {
+  assert.deepEqual(applyPatch({ a: [1] }, []), { a: [1] });
+});
+
+test("operations apply in sequence, each on the result of the previous one", () => {
+  const result = applyPatch({}, [
+    { op: "add", path: "/list", value: [] },
+    { op: "add", path: "/list/-", value: 1 },
+    { op: "add", path: "/list/0", value: 0 },
+    { op: "copy", from: "/list", path: "/copy" },
+    { op: "replace", path: "/list/1", value: "one" },
+    { op: "test", path: "/copy", value: [0, 1] },
+  ]);
+  assert.deepEqual(result, { list: [0, "one"], copy: [0, 1] });
+});
+
+test("does not mutate the document nor the patch", () => {
+  const document = { a: { b: [1, 2] }, c: "x" };
+  const patch = [
+    { op: "add", path: "/a/b/-", value: { deep: [3] } },
+    { op: "remove", path: "/c" },
+    { op: "move", from: "/a/b/0", path: "/first" },
+  ];
+  const documentBefore = structuredClone(document);
+  const patchBefore = structuredClone(patch);
+  const result = applyPatch(document, patch);
+  assert.deepEqual(document, documentBefore);
+  assert.deepEqual(patch, patchBefore);
+  assert.deepEqual(result, { a: { b: [2, { deep: [3] }] }, first: 1 });
+});
+
+test("the result shares no object or array with the document or the patch", () => {
+  const value = { nested: [1] };
+  const document = { kept: { x: 1 } };
+  const result = applyPatch(document, [{ op: "add", path: "/added", value }]) as Record<string, any>;
+  assert.notEqual(result, document);
+  assert.notEqual(result.kept, document.kept);
+  assert.notEqual(result.added, value);
+  assert.notEqual(result.added.nested, value.nested);
+});
+
+test("a failing operation leaves the input untouched", () => {
+  const document = { a: 1 };
+  assert.throws(() =>
+    applyPatch(document, [
+      { op: "add", path: "/b", value: 2 },
+      { op: "remove", path: "/missing" },
+    ]),
+  );
+  assert.deepEqual(document, { a: 1 });
+});
+
+test("add: the root path replaces the whole document", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+});
+
+test("add: replaces an existing object member", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+});
+
+test("add: an index equal to the array length appends", () => {
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/1", value: 2 }]), [1, 2]);
+});
+
+test("add: accepts null and other falsy values", () => {
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a", value: null }, { op: "add", path: "/b", value: 0 }]), {
+    a: null,
+    b: 0,
+  });
+});
+
+test("add: rejects an out-of-range, malformed or leading-zero array index", () => {
+  for (const path of ["/2", "/01", "/-1", "/x", "/1.0"]) {
+    assert.throws(() => applyPatch([1], [{ op: "add", path, value: 0 }]), JsonPatchError, path);
+  }
+});
+
+test("add: rejects a target inside a primitive value", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 0 }]), JsonPatchError);
+});
+
+test("add: a __proto__ member is an own data member, not a prototype change", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as object;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.ok(Object.hasOwn(result, "__proto__"));
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("remove: rejects a missing member, an out-of-range index, '-' and the root", () => {
+  const cases: Array<[unknown, string]> = [
+    [{ a: 1 }, "/b"],
+    [[1], "/1"],
+    [[1], "/-"],
+    [{ a: 1 }, "/toString"],
+    [{ a: 1 }, ""],
+  ];
+  for (const [document, path] of cases) {
+    assert.throws(() => applyPatch(document, [{ op: "remove", path }]), JsonPatchError, path);
+  }
+});
+
+test("replace: the root path replaces the whole document", () => {
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: "x" }]), "x");
+});
+
+test("replace: rejects a missing target", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "replace", path: "/b", value: 2 }]), JsonPatchError);
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/1", value: 2 }]), JsonPatchError);
+});
+
+test("move: to the same location leaves the document unchanged", () => {
+  assert.deepEqual(applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a" }]), { a: { b: 1 } });
+});
+
+test("move: rejects moving a value into one of its children", () => {
+  assert.throws(() => applyPatch({ a: { b: {} } }, [{ op: "move", from: "/a", path: "/a/b/c" }]), JsonPatchError);
+});
+
+test("move: a path that merely starts with the same characters is not a child", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/ab" }]), { ab: 1 });
+});
+
+test("move: rejects a missing source", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "/b", path: "/c" }]), JsonPatchError);
+});
+
+test("copy: copies are independent of their source", () => {
+  const result = applyPatch({ a: { b: 1 } }, [
+    { op: "copy", from: "/a", path: "/c" },
+    { op: "replace", path: "/c/b", value: 2 },
+  ]);
+  assert.deepEqual(result, { a: { b: 1 }, c: { b: 2 } });
+});
+
+test("copy: rejects a missing source", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", from: "/b", path: "/c" }]), JsonPatchError);
+});
+
+test("test: compares objects regardless of member order, arrays in order", () => {
+  const document = { o: { a: 1, b: [1, { c: null }] } };
+  assert.doesNotThrow(() => applyPatch(document, [{ op: "test", path: "/o", value: { b: [1, { c: null }], a: 1 } }]));
+  for (const value of [{ a: 1 }, { a: 1, b: [{ c: null }, 1] }, { a: 1, b: [1, { c: null }], d: 0 }, [1]]) {
+    assert.throws(() => applyPatch(document, [{ op: "test", path: "/o", value }]), JsonPatchError);
+  }
+});
+
+test("test: distinguishes null, false, 0, empty string, empty array and empty object", () => {
+  const values = [null, false, 0, "", [], {}];
+  for (const actual of values) {
+    for (const expected of values) {
+      const patch = [{ op: "test", path: "/v", value: expected }];
+      if (actual === expected) {
+        assert.doesNotThrow(() => applyPatch({ v: actual }, patch));
+      } else {
+        assert.throws(() => applyPatch({ v: actual }, patch), JsonPatchError);
+      }
+    }
+  }
+});
+
+test("test: rejects a missing target", () => {
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/a", value: null }]), JsonPatchError);
+});
+
+test("rejects a patch that is not an array of operation objects", () => {
+  for (const patch of [{}, null, "[]", [null], [1], [[]]]) {
+    assert.throws(() => applyPatch({}, patch as never), JsonPatchError, JSON.stringify(patch));
+  }
+});
+
+test("rejects operations with missing or malformed members", () => {
+  const operations: unknown[] = [
+    { path: "/a", value: 1 },
+    { op: "ADD", path: "/a", value: 1 },
+    { op: "add", value: 1 },
+    { op: "add", path: 1, value: 1 },
+    { op: "add", path: "a", value: 1 },
+    { op: "add", path: "/~2", value: 1 },
+    { op: "add", path: "/a" },
+    { op: "replace", path: "/a" },
+    { op: "test", path: "/a" },
+    { op: "move", path: "/a" },
+    { op: "copy", path: "/a", from: 1 },
+    { op: "move", path: "/a", from: "a" },
+  ];
+  for (const operation of operations) {
+    assert.throws(() => applyPatch({ a: 1 }, [operation]), JsonPatchError, JSON.stringify(operation));
+  }
+});
+
+test("validates the whole patch before applying any operation", () => {
+  assert.throws(
+    () => applyPatch({}, [{ op: "test", path: "/missing", value: 1 }, { op: "nope" }]),
+    (error: unknown) => error instanceof JsonPatchError && error.index === 1,
+  );
+});
+
+test("the error tells which operation failed and keeps the pointer error as cause", () => {
+  assert.throws(
+    () => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: 1 }, { op: "remove", path: "/b" }]),
+    (error: unknown) =>
+      error instanceof JsonPatchError &&
+      error.name === "JsonPatchError" &&
+      error.index === 1 &&
+      error.message.includes("operation 1") &&
+      error.cause instanceof JsonPointerError,
+  );
+});
