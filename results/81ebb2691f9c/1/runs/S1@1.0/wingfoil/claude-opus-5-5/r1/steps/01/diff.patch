@@ -0,0 +1,89 @@
+/**
+ * JSON Pointer (RFC 6901): identifies a specific value within a JSON document.
+ *
+ * Pointers are handled in their JSON string representation (RFC 6901, section 5), such as
+ * `/foo/0`. The URI fragment identifier representation (`#/foo/0`, section 6) is not accepted:
+ * a caller holding a fragment percent-decodes it and strips the `#` first.
+ */
+
+/** Error thrown when a pointer is not a valid JSON Pointer or does not resolve to a value. */
+export class JsonPointerError extends Error {
+  /** The pointer that caused the error. */
+  readonly pointer: string;
+
+  constructor(message: string, pointer: string) {
+    super(`${message} (pointer: ${JSON.stringify(pointer)})`);
+    this.name = "JsonPointerError";
+    this.pointer = pointer;
+  }
+}
+
+// An escape is `~` followed by `0` or `1`; any other `~` makes the pointer invalid (RFC 6901, section 3).
+const INVALID_ESCAPE = /~(?![01])/;
+// An array index is `0` or digits without a leading zero (RFC 6901, section 4).
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/**
+ * Splits a JSON Pointer into its decoded reference tokens.
+ *
+ * The empty pointer yields no token: it refers to the whole document.
+ *
+ * @throws {JsonPointerError} when `pointer` is not a valid JSON Pointer.
+ */
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("a JSON Pointer must be a string", String(pointer));
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new JsonPointerError("a non-empty JSON Pointer must start with '/'", pointer);
+  }
+  if (INVALID_ESCAPE.test(pointer)) {
+    throw new JsonPointerError("'~' must be followed by '0' or '1'", pointer);
+  }
+  // `~1` is decoded before `~0`, so that `~01` becomes `~1` and not `/` (RFC 6901, section 4).
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => token.replaceAll("~1", "/").replaceAll("~0", "~"));
+}
+
+/**
+ * Returns the value of `document` that `pointer` refers to.
+ *
+ * The value is returned as is, not copied. Only the document's own members and in-range array
+ * elements are reachable: the `-` token, which designates the element after the last one, refers to
+ * no existing value and is rejected.
+ *
+ * @throws {JsonPointerError} when `pointer` is not a valid JSON Pointer, or does not resolve to a
+ * value of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let value = document;
+  for (const token of parsePointer(pointer)) {
+    value = resolveToken(value, token, pointer);
+  }
+  return value;
+}
+
+function resolveToken(value: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(value)) {
+    if (!ARRAY_INDEX.test(token)) {
+      throw new JsonPointerError(`${JSON.stringify(token)} is not an array index`, pointer);
+    }
+    const index = Number(token);
+    if (index >= value.length) {
+      throw new JsonPointerError(`array index ${token} is out of range`, pointer);
+    }
+    return value[index];
+  }
+  if (typeof value === "object" && value !== null) {
+    if (!Object.hasOwn(value, token)) {
+      throw new JsonPointerError(`object has no member ${JSON.stringify(token)}`, pointer);
+    }
+    return (value as Record<string, unknown>)[token];
+  }
+  throw new JsonPointerError(`cannot reference ${JSON.stringify(token)} in a primitive value`, pointer);
+}
diff --git a/test/json-pointer.test.ts b/test/json-pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3d0ebfae1451f87ed028a2d3167f34b1bcb3bae8
--- /dev/null
+++ b/test/json-pointer.test.ts
@@ -0,0 +1,124 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { JsonPointerError, parsePointer, resolvePointer } from "../src/index.ts";
+
+// The example document of RFC 6901, section 5.
+const rfcDocument = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("resolves every example of RFC 6901 section 5", () => {
+  const cases: Array<[string, unknown]> = [
+    ["", rfcDocument],
+    ["/foo", ["bar", "baz"]],
+    ["/foo/0", "bar"],
+    ["/", 0],
+    ["/a~1b", 1],
+    ["/c%d", 2],
+    ["/e^f", 3],
+    ["/g|h", 4],
+    ["/i\\j", 5],
+    ['/k"l', 6],
+    ["/ ", 7],
+    ["/m~0n", 8],
+  ];
+  for (const [pointer, expected] of cases) {
+    assert.deepEqual(resolvePointer(rfcDocument, pointer), expected, `pointer ${JSON.stringify(pointer)}`);
+  }
+});
+
+test("returns the referenced value itself, not a copy", () => {
+  const inner = { x: 1 };
+  assert.equal(resolvePointer({ a: [inner] }, "/a/0"), inner);
+});
+
+test("resolves values that are null, false, zero or empty", () => {
+  const document = { n: null, f: false, z: 0, s: "", a: [], o: {} };
+  assert.equal(resolvePointer(document, "/n"), null);
+  assert.equal(resolvePointer(document, "/f"), false);
+  assert.equal(resolvePointer(document, "/z"), 0);
+  assert.equal(resolvePointer(document, "/s"), "");
+  assert.deepEqual(resolvePointer(document, "/a"), []);
+  assert.deepEqual(resolvePointer(document, "/o"), {});
+});
+
+test("resolves the whole document when it is a primitive", () => {
+  assert.equal(resolvePointer(42, ""), 42);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("decodes ~1 before ~0, so ~01 is the literal ~1", () => {
+  assert.equal(resolvePointer({ "~1": "tilde-one", "/": "slash" }, "/~01"), "tilde-one");
+  assert.equal(resolvePointer({ "~1": "tilde-one", "/": "slash" }, "/~1"), "slash");
+});
+
+test("treats array indexes and numeric-looking member names correctly", () => {
+  assert.equal(resolvePointer({ "0": "member" }, "/0"), "member");
+  assert.equal(resolvePointer({ "01": "member" }, "/01"), "member");
+  assert.equal(resolvePointer([["a", "b"], ["c"]], "/0/1"), "b");
+  assert.equal(resolvePointer(Array.from({ length: 11 }, (_, i) => i), "/10"), 10);
+});
+
+test("rejects pointers that are not valid JSON Pointers", () => {
+  for (const pointer of ["foo", "#/foo", " /foo", "/~", "/foo~", "/~2", "/a~b", "/~~1"]) {
+    assert.throws(() => resolvePointer(rfcDocument, pointer), JsonPointerError, `pointer ${JSON.stringify(pointer)}`);
+  }
+});
+
+test("rejects a pointer that is not a string", () => {
+  assert.throws(() => resolvePointer({}, 1 as unknown as string), JsonPointerError);
+  assert.throws(() => resolvePointer({}, undefined as unknown as string), JsonPointerError);
+});
+
+test("rejects a pointer to a missing object member", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"), JsonPointerError);
+  assert.throws(() => resolvePointer({ a: { b: 1 } }, "/a/c"), JsonPointerError);
+});
+
+test("does not resolve inherited properties", () => {
+  for (const pointer of ["/__proto__", "/constructor", "/toString", "/hasOwnProperty"]) {
+    assert.throws(() => resolvePointer({}, pointer), JsonPointerError, `pointer ${pointer}`);
+  }
+  assert.throws(() => resolvePointer([], "/length"), JsonPointerError);
+});
+
+test("rejects array indexes that are out of range or malformed", () => {
+  const array = ["a", "b"];
+  for (const pointer of ["/2", "/-", "/-1", "/01", "/00", "/+1", "/1.0", "/1e0", "/ 1", "/", "/0x1"]) {
+    assert.throws(() => resolvePointer(array, pointer), JsonPointerError, `pointer ${pointer}`);
+  }
+});
+
+test("rejects a pointer that goes through a primitive value", () => {
+  assert.throws(() => resolvePointer({ a: "text" }, "/a/0"), JsonPointerError);
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"), JsonPointerError);
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"), JsonPointerError);
+  assert.throws(() => resolvePointer(true, "/a"), JsonPointerError);
+});
+
+test("reports the pointer in the error", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"), (error: unknown) => {
+    assert.ok(error instanceof JsonPointerError);
+    assert.ok(error instanceof Error);
+    assert.equal(error.pointer, "/b");
+    assert.match(error.message, /\/b/);
+    return true;
+  });
+});
+
+test("parsePointer splits and decodes reference tokens", () => {
+  assert.deepEqual(parsePointer(""), []);
+  assert.deepEqual(parsePointer("/"), [""]);
+  assert.deepEqual(parsePointer("/a~1b/m~0n/0"), ["a/b", "m~n", "0"]);
+  assert.deepEqual(parsePointer("//"), ["", ""]);
+  assert.throws(() => parsePointer("a"), JsonPointerError);
+});
