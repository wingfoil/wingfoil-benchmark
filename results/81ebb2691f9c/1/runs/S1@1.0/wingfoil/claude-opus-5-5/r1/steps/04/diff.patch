--- a/src/index.ts
+++ b/src/index.ts
@@ -349,3 +349,59 @@ function jsonEqual(a: unknown, b: unknown): boolean {
   }
   return a === b;
 }
+
+/**
+ * JSON Merge Patch (RFC 7386, whose algorithm RFC 7396 keeps unchanged): a partial document that
+ * describes the changes to make to a target JSON document.
+ *
+ * A patch object merges into the target member by member: a `null` member removes the target's
+ * member, any other member is merged in turn into the target's member of the same name. Any patch
+ * that is not an object, an array included, replaces the target as a whole.
+ */
+
+/** Error thrown when the target or the patch of a merge patch is not a JSON value. */
+export class JsonMergePatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonMergePatchError";
+  }
+}
+
+/**
+ * Applies `patch`, a JSON Merge Patch, to `target` and returns the merged document (RFC 7386,
+ * section 2).
+ *
+ * `target` and `patch` must be JSON values: null, booleans, finite numbers, strings, and arrays and
+ * plain objects of these, without cycles. The result is a new value that shares no object or array
+ * with `target` or `patch`, neither of which is modified. Only own members of the target are merged
+ * into, and members are always set as own data members, so a `__proto__` member never changes a
+ * prototype. Applying a merge patch cannot otherwise fail: every JSON value is a valid merge patch.
+ *
+ * @throws {JsonMergePatchError} when `target` or `patch` is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonValue(patch)) {
+    throw new JsonMergePatchError("the patch is not a JSON value");
+  }
+  if (!isJsonValue(target)) {
+    throw new JsonMergePatchError("the target is not a JSON value");
+  }
+  return mergePatch(cloneJson(target), patch);
+}
+
+// The `MergePatch` function of RFC 7386, section 2, on a `target` that may be changed in place.
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return cloneJson(patch);
+  }
+  // A target that is not an object is ignored and replaced by an empty object.
+  const result = isObject(target) ? target : {};
+  for (const [name, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[name];
+    } else {
+      setMember(result, name, mergePatch(Object.hasOwn(result, name) ? result[name] : undefined, value));
+    }
+  }
+  return result;
+}
diff --git a/test/json-merge-patch.test.ts b/test/json-merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8333e64e30b08582f82326fca52197bb842addca
--- /dev/null
+++ b/test/json-merge-patch.test.ts
@@ -0,0 +1,124 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch, JsonMergePatchError } from "../src/index.ts";
+
+// The examples of RFC 7386, appendix A: [original, patch, expected result].
+const rfcExamples: Array<[unknown, unknown, unknown]> = [
+  [{ a: "b" }, { a: "c" }, { a: "c" }],
+  [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  [{ a: "b" }, { a: null }, {}],
+  [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+  [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+  [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  [["a", "b"], ["c", "d"], ["c", "d"]],
+  [{ a: "b" }, ["c"], ["c"]],
+  [{ a: "foo" }, null, null],
+  [{ a: "foo" }, "bar", "bar"],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: "b", c: null }, { a: "b" }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+
+test("applies the examples of RFC 7386 appendix A", () => {
+  for (const [original, patch, expected] of rfcExamples) {
+    assert.deepEqual(applyMergePatch(original, patch), expected, `${JSON.stringify(original)} + ${JSON.stringify(patch)}`);
+  }
+});
+
+test("applies the example of RFC 7386 section 3", () => {
+  const target = {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = { title: "Hello!", phoneNumber: "+01-123-456-7890", author: { familyName: null }, tags: ["example"] };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+});
+
+test("an empty object patch returns an equal document", () => {
+  assert.deepEqual(applyMergePatch({ a: [1, { b: null }] }, {}), { a: [1, { b: null }] });
+});
+
+test("removing a member that does not exist changes nothing", () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, { b: null }), { a: 1 });
+});
+
+test("an object patch replaces a target that is not an object", () => {
+  for (const target of [null, true, 0, "x", [1]]) {
+    assert.deepEqual(applyMergePatch(target, { a: 1, b: null }), { a: 1 });
+  }
+  assert.deepEqual(applyMergePatch({ a: "x" }, { a: { b: 1 } }), { a: { b: 1 } });
+});
+
+test("null inside an array of the patch is kept: arrays replace, they are not merged", () => {
+  assert.deepEqual(applyMergePatch({ a: [1, 2] }, { a: [null, { b: null }] }), { a: [null, { b: null }] });
+});
+
+test("falsy values other than null are set, not removed", () => {
+  assert.deepEqual(applyMergePatch({ a: 1, b: 1, c: 1, d: 1 }, { a: false, b: 0, c: "", d: {} }), { a: false, b: 0, c: "", d: {} });
+});
+
+test("does not mutate the target nor the patch", () => {
+  const target = { a: { b: 1, c: [1] } };
+  const patch = { a: { b: null, d: { e: 1 } } };
+  const targetCopy = structuredClone(target);
+  const patchCopy = structuredClone(patch);
+  applyMergePatch(target, patch);
+  assert.deepEqual(target, targetCopy);
+  assert.deepEqual(patch, patchCopy);
+});
+
+test("the result shares no object or array with the target or the patch", () => {
+  const target = { kept: { x: 1 }, list: [1] };
+  const patch = { added: { y: [2] }, list: [3] };
+  const result = applyMergePatch(target, patch) as Record<string, any>;
+  assert.notEqual(result, target);
+  assert.notEqual(result.kept, target.kept);
+  assert.notEqual(result.added, patch.added);
+  assert.notEqual(result.added.y, patch.added.y);
+  assert.notEqual(result.list, patch.list);
+  assert.notEqual(applyMergePatch({}, patch.list), patch.list);
+});
+
+test("a __proto__ member is an own data member, not a prototype change", () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}}');
+  const result = applyMergePatch({}, patch) as Record<string, unknown>;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.ok(Object.hasOwn(result, "__proto__"));
+  assert.deepEqual(Object.getOwnPropertyDescriptor(result, "__proto__")?.value, { polluted: true });
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  const removed = applyMergePatch(JSON.parse('{"__proto__": 1, "a": 2}'), JSON.parse('{"__proto__": null}'));
+  assert.deepEqual(Object.keys(removed as object), ["a"]);
+});
+
+test("inherited members of the target are not merged into", () => {
+  // `toString` exists on `Object.prototype`, not on the target: the patch value is set as is.
+  assert.deepEqual(applyMergePatch({}, { toString: { a: null } }), { toString: {} });
+});
+
+test("rejects a target or a patch that is not a JSON value", () => {
+  const cyclic: Record<string, unknown> = {};
+  cyclic.self = cyclic;
+  const invalid = [undefined, NaN, Infinity, 1n, Symbol("s"), () => 1, new Date(0), new Map(), [1, , 3], { a: undefined }, cyclic];
+  for (const value of invalid) {
+    assert.throws(() => applyMergePatch(value, {}), (error: unknown) => error instanceof JsonMergePatchError && /target/.test(error.message));
+    assert.throws(() => applyMergePatch({}, value), (error: unknown) => error instanceof JsonMergePatchError && /patch/.test(error.message));
+    assert.throws(() => applyMergePatch({}, { a: value }), JsonMergePatchError);
+  }
+});
+
+test("accepts objects without a prototype and sub-values shared without a cycle", () => {
+  const shared = { x: 1 };
+  const result = applyMergePatch(Object.assign(Object.create(null), { a: 1 }), { b: shared, c: shared }) as Record<string, any>;
+  assert.deepEqual({ ...result }, { a: 1, b: { x: 1 }, c: { x: 1 } });
+  assert.notEqual(result.b, result.c);
+});
