+++ b/src/index.ts
@@ -0,0 +1,55 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * The empty pointer refers to the whole document. Otherwise the pointer is a sequence of reference
+ * tokens, each prefixed by "/", that select a member of an object or an element of an array in turn.
+ *
+ * @param document the JSON document to resolve the pointer against
+ * @param pointer the JSON Pointer, such as "/foo/0"
+ * @returns the value the pointer refers to
+ * @throws {Error} when the pointer is not a valid JSON Pointer, or does not resolve to a value of the document
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  return parsePointer(pointer).reduce<unknown>(
+    (current, token) => selectMember(current, token, pointer),
+    document,
+  );
+}
+
+const ARRAY_INDEX = /^(0|[1-9]\d*)$/;
+
+/** Splits a pointer into its unescaped reference tokens, validating its syntax. */
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== 'string') {
+    throw new Error('invalid JSON Pointer: the pointer must be a string');
+  }
+  if (pointer === '') {
+    return [];
+  }
+  if (!pointer.startsWith('/')) {
+    throw new Error(`invalid JSON Pointer "${pointer}": a non-empty pointer must start with "/"`);
+  }
+  return pointer.slice(1).split('/').map((token) => unescapeToken(token, pointer));
+}
+
+/** Replaces "~1" with "/" and "~0" with "~"; any other "~" is a syntax error. */
+function unescapeToken(token: string, pointer: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`invalid JSON Pointer "${pointer}": "~" must be followed by "0" or "1"`);
+  }
+  return token.replace(/~1/g, '/').replace(/~0/g, '~');
+}
+
+/** Selects the member or element named by a reference token, which must exist in the container. */
+function selectMember(container: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(container)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= container.length) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: no array element "${token}"`);
+    }
+    return container[Number(token)];
+  }
+  if (typeof container === 'object' && container !== null && Object.hasOwn(container, token)) {
+    return (container as Record<string, unknown>)[token];
+  }
+  throw new Error(`JSON Pointer "${pointer}" does not resolve: no member "${token}"`);
+}
diff --git a/test/resolve-pointer.test.ts b/test/resolve-pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9bb6e0e8d23b8750d8e0c7c26a553c71f9b3ec5a
--- /dev/null
+++ b/test/resolve-pointer.test.ts
@@ -0,0 +1,136 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { resolvePointer } from '../src/index.ts';
+
+// The example document of RFC 6901, section 5.
+const rfcDocument = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+describe('resolvePointer', () => {
+  describe('valid pointers (RFC 6901, section 5)', () => {
+    it('resolves the empty pointer to the whole document', () => {
+      assert.equal(resolvePointer(rfcDocument, ''), rfcDocument);
+    });
+
+    it('resolves an object member holding an array', () => {
+      assert.deepEqual(resolvePointer(rfcDocument, '/foo'), ['bar', 'baz']);
+    });
+
+    it('resolves an array element by index', () => {
+      assert.equal(resolvePointer(rfcDocument, '/foo/0'), 'bar');
+      assert.equal(resolvePointer(rfcDocument, '/foo/1'), 'baz');
+    });
+
+    it('resolves the member whose name is the empty string', () => {
+      assert.equal(resolvePointer(rfcDocument, '/'), 0);
+    });
+
+    it('unescapes ~1 to / in member names', () => {
+      assert.equal(resolvePointer(rfcDocument, '/a~1b'), 1);
+    });
+
+    it('unescapes ~0 to ~ in member names', () => {
+      assert.equal(resolvePointer(rfcDocument, '/m~0n'), 8);
+    });
+
+    it('treats other characters in member names literally', () => {
+      assert.equal(resolvePointer(rfcDocument, '/c%d'), 2);
+      assert.equal(resolvePointer(rfcDocument, '/e^f'), 3);
+      assert.equal(resolvePointer(rfcDocument, '/g|h'), 4);
+      assert.equal(resolvePointer(rfcDocument, '/i\\j'), 5);
+      assert.equal(resolvePointer(rfcDocument, '/k"l'), 6);
+      assert.equal(resolvePointer(rfcDocument, '/ '), 7);
+    });
+  });
+
+  describe('values', () => {
+    it('returns null when the pointer refers to a null value', () => {
+      assert.equal(resolvePointer({ a: null }, '/a'), null);
+    });
+
+    it('returns the whole document for the empty pointer when the document is null', () => {
+      assert.equal(resolvePointer(null, ''), null);
+    });
+
+    it('resolves a document that is an array', () => {
+      assert.equal(resolvePointer(['x', 'y'], '/1'), 'y');
+    });
+
+    it('resolves nested objects and arrays', () => {
+      const doc = { a: [{ b: { c: [10, 20, 30] } }] };
+      assert.equal(resolvePointer(doc, '/a/0/b/c/2'), 30);
+    });
+
+    it('accepts the index 0 but not indexes with leading zeros', () => {
+      assert.equal(resolvePointer(['first'], '/0'), 'first');
+      assert.throws(() => resolvePointer(['first', 'second'], '/01'));
+    });
+  });
+
+  describe('invalid pointers', () => {
+    it('throws when the pointer is not a string', () => {
+      assert.throws(() => resolvePointer(rfcDocument, 1 as unknown as string));
+    });
+
+    it('throws when a non-empty pointer does not start with /', () => {
+      assert.throws(() => resolvePointer(rfcDocument, 'foo'));
+      assert.throws(() => resolvePointer(rfcDocument, 'foo/0'));
+    });
+
+    it('throws on a ~ that is not followed by 0 or 1', () => {
+      assert.throws(() => resolvePointer(rfcDocument, '/m~n'));
+      assert.throws(() => resolvePointer(rfcDocument, '/m~2'));
+    });
+
+    it('throws on a ~ at the end of the pointer', () => {
+      assert.throws(() => resolvePointer(rfcDocument, '/m~'));
+    });
+
+    it('throws on a non-numeric array index', () => {
+      assert.throws(() => resolvePointer(rfcDocument, '/foo/a'));
+    });
+
+    it('throws on a signed array index', () => {
+      assert.throws(() => resolvePointer(rfcDocument, '/foo/-0'));
+      assert.throws(() => resolvePointer(rfcDocument, '/foo/+1'));
+    });
+  });
+
+  describe('pointers that do not resolve', () => {
+    it('throws when an object member is missing', () => {
+      assert.throws(() => resolvePointer(rfcDocument, '/missing'));
+    });
+
+    it('throws when an array index is out of range', () => {
+      assert.throws(() => resolvePointer(rfcDocument, '/foo/2'));
+    });
+
+    it('throws for the "-" index, which names the position after the last element', () => {
+      assert.throws(() => resolvePointer(rfcDocument, '/foo/-'));
+    });
+
+    it('throws when the pointer traverses into a primitive value', () => {
+      assert.throws(() => resolvePointer(rfcDocument, '/foo/0/x'));
+      assert.throws(() => resolvePointer({ a: null }, '/a/b'));
+    });
+
+    it('throws for inherited properties that are not members of the document', () => {
+      assert.throws(() => resolvePointer({}, '/constructor'));
+      assert.throws(() => resolvePointer({}, '/toString'));
+    });
+
+    it('throws when the document is null and the pointer is not empty', () => {
+      assert.throws(() => resolvePointer(null, '/a'));
+    });
+  });
+});
