@@ -0,0 +1,180 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch, createPatch } from '../src/index.ts';
+
+/** Checks that the patch made from `from` turns it into `to` when applied. */
+function assertRoundTrip(from: unknown, to: unknown): void {
+  assert.deepEqual(applyPatch(from, createPatch(from, to)), to);
+}
+
+describe('createPatch', () => {
+  describe('equal values', () => {
+    it('gives an empty patch for equal scalars', () => {
+      assert.deepEqual(createPatch(1, 1), []);
+    });
+
+    it('gives an empty patch for equal nested documents', () => {
+      assert.deepEqual(createPatch({ a: [1, { b: null }], c: 'd' }, { c: 'd', a: [1, { b: null }] }), []);
+    });
+
+    it('treats 0 and -0 as equal', () => {
+      assert.deepEqual(createPatch({ a: -0 }, { a: 0 }), []);
+    });
+  });
+
+  describe('objects', () => {
+    it('replaces a changed member', () => {
+      assert.deepEqual(createPatch({ a: 1, b: 2 }, { a: 1, b: 3 }), [{ op: 'replace', path: '/b', value: 3 }]);
+    });
+
+    it('adds a member that is only in the new document', () => {
+      assert.deepEqual(createPatch({ a: 1 }, { a: 1, b: 'x' }), [{ op: 'add', path: '/b', value: 'x' }]);
+    });
+
+    it('removes a member that is only in the old document', () => {
+      assert.deepEqual(createPatch({ a: 1, b: 2 }, { a: 1 }), [{ op: 'remove', path: '/b' }]);
+    });
+
+    it('describes a change deep inside a document with one operation', () => {
+      assert.deepEqual(createPatch({ a: { b: { c: 1, d: 2 } } }, { a: { b: { c: 1, d: 3 } } }), [
+        { op: 'replace', path: '/a/b/d', value: 3 },
+      ]);
+    });
+
+    it('replaces a member whose type changes, with the new value as a whole', () => {
+      assert.deepEqual(createPatch({ a: { b: 1 } }, { a: [1] }), [{ op: 'replace', path: '/a', value: [1] }]);
+    });
+
+    it('escapes "/" and "~" in member names', () => {
+      assert.deepEqual(createPatch({ 'a/b': 1, 'c~d': 1 }, { 'a/b': 2, 'c~d': 1 }), [
+        { op: 'replace', path: '/a~1b', value: 2 },
+      ]);
+    });
+
+    it('describes a member named "__proto__" as data', () => {
+      const from = JSON.parse('{"__proto__": 1}');
+      const to = JSON.parse('{"__proto__": 2}');
+      assert.deepEqual(createPatch(from, to), [{ op: 'replace', path: '/__proto__', value: 2 }]);
+      assertRoundTrip(from, to);
+    });
+  });
+
+  describe('arrays', () => {
+    it('adds an element appended to the end', () => {
+      assert.deepEqual(createPatch([1, 2], [1, 2, 3]), [{ op: 'add', path: '/2', value: 3 }]);
+    });
+
+    it('adds an element inserted in the middle, without rewriting the others', () => {
+      assert.deepEqual(createPatch([1, 2, 3], [1, 9, 2, 3]), [{ op: 'add', path: '/1', value: 9 }]);
+    });
+
+    it('removes an element from the middle, without rewriting the others', () => {
+      assert.deepEqual(createPatch([1, 2, 3], [1, 3]), [{ op: 'remove', path: '/1' }]);
+    });
+
+    it('removes the first element of an array of objects', () => {
+      assert.deepEqual(
+        createPatch([{ id: 1 }, { id: 2 }, { id: 3 }], [{ id: 2 }, { id: 3 }]),
+        [{ op: 'remove', path: '/0' }],
+      );
+    });
+
+    it('changes one field of one object element with one operation', () => {
+      assert.deepEqual(
+        createPatch([{ id: 1, name: 'a' }, { id: 2, name: 'b' }], [{ id: 1, name: 'a' }, { id: 2, name: 'c' }]),
+        [{ op: 'replace', path: '/1/name', value: 'c' }],
+      );
+    });
+
+    it('replaces an element that changes into a value of another type', () => {
+      assert.deepEqual(createPatch(['a', 'b'], ['a', 2]), [{ op: 'replace', path: '/1', value: 2 }]);
+    });
+
+    it('applies the operations in order, so that each index is valid when it is used', () => {
+      assertRoundTrip([1, 2, 3, 4, 5], [0, 1, 3, 4, 6, 7]);
+      assertRoundTrip(['a', 'b', 'c'], ['c', 'a', 'b']);
+      assertRoundTrip([[1], [2]], [[2], [3], [1]]);
+    });
+
+    it('empties an array and fills an empty one', () => {
+      assertRoundTrip([1, 2], []);
+      assertRoundTrip([], [1, 2]);
+    });
+  });
+
+  describe('a change of root type', () => {
+    it('replaces the whole document at the empty pointer when the root type changes', () => {
+      assert.deepEqual(createPatch({ a: 1 }, [1]), [{ op: 'replace', path: '', value: [1] }]);
+    });
+
+    it('replaces a scalar root', () => {
+      assert.deepEqual(createPatch(1, 2), [{ op: 'replace', path: '', value: 2 }]);
+      assert.deepEqual(createPatch(null, { a: null }), [{ op: 'replace', path: '', value: { a: null } }]);
+    });
+  });
+
+  describe('round trip: applyPatch gives back the new document', () => {
+    const cases: [string, unknown, unknown][] = [
+      ['nested objects with a mix of changes', { a: { b: 1, c: [1, 2] }, d: null }, { a: { b: 2, c: [2] }, e: 'x' }],
+      ['an object that becomes null', { a: { b: 1 } }, { a: null }],
+      ['null that becomes an object', { a: null }, { a: { b: [] } }],
+      ['arrays of arrays', [[1, 2], [3]], [[1], [3, 4], []]],
+      ['duplicate elements', [1, 1, 1, 2], [1, 2, 1, 1]],
+      ['an element of an object replaced by an array', { a: { x: 1 } }, { a: [{ x: 1 }] }],
+    ];
+    for (const [name, from, to] of cases) {
+      it(name, () => assertRoundTrip(from, to));
+    }
+  });
+
+  describe('small patches for small changes in large documents', () => {
+    it('describes one changed field among a thousand records with one operation', () => {
+      const from = { records: Array.from({ length: 1000 }, (_, i) => ({ id: i, value: `v${i}` })) };
+      const to = structuredClone(from);
+      to.records[500].value = 'changed';
+      const patch = createPatch(from, to);
+      assert.deepEqual(patch, [{ op: 'replace', path: '/records/500/value', value: 'changed' }]);
+    });
+
+    it('describes one inserted record among a thousand with one operation', () => {
+      const from = { records: Array.from({ length: 1000 }, (_, i) => ({ id: i })) };
+      const to = { records: [...from.records.slice(0, 300), { id: -1 }, ...from.records.slice(300)] };
+      assert.deepEqual(createPatch(from, to), [{ op: 'add', path: '/records/300', value: { id: -1 } }]);
+    });
+
+    it('still gives a correct patch when an array changes in very many places', () => {
+      const from = Array.from({ length: 2000 }, (_, i) => i);
+      const to = Array.from({ length: 2000 }, (_, i) => i * 2);
+      assertRoundTrip(from, to);
+    });
+  });
+
+  describe('inputs', () => {
+    it('does not mutate either document', () => {
+      const from = { a: [1, { b: 2 }], c: { d: 'x' } };
+      const to = { a: [1, { b: 3 }, 4], e: null };
+      const fromBefore = structuredClone(from);
+      const toBefore = structuredClone(to);
+      createPatch(from, to);
+      assert.deepEqual(from, fromBefore);
+      assert.deepEqual(to, toBefore);
+    });
+
+    it('returns values that share no object with the documents', () => {
+      const from = { a: 1 };
+      const to = { a: { b: [1] }, c: { d: 2 } };
+      const patch = createPatch(from, to);
+      for (const operation of patch) {
+        if ('value' in operation) {
+          (operation.value as { b?: number[]; d?: number }).d = 9;
+        }
+      }
+      assert.deepEqual(to, { a: { b: [1] }, c: { d: 2 } });
+    });
+
+    it('does not throw for JSON values', () => {
+      assert.doesNotThrow(() => createPatch(null, [null, true, 'x', { y: [] }]));
+      assert.doesNotThrow(() => createPatch({ a: 1e300 }, { a: -0.5 }));
+    });
+  });
+});
