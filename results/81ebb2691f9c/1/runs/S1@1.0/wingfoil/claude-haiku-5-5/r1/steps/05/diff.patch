index 138673e80d77da191356448ee8ce50dd0f71ed67..fd90474fba603eb42244d060c10eea9bfd784567 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -77,6 +77,141 @@ function mergeInto(target: unknown, patch: unknown): unknown {
   return result;
 }
 
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only what changed.
+ *
+ * Objects are compared member by member, and arrays are aligned by their unchanged elements, so a small
+ * change gives a small patch. A change of the root's type gives one `replace` of the whole document.
+ *
+ * @param from the JSON document before the change
+ * @param to the JSON document after the change
+ * @returns the operations, in the order they must be applied, as new values: neither input is modified
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const operations: JsonPatchOperation[] = [];
+  diffValue('', from, to, operations);
+  return operations;
+}
+
+/** The most element pairs that array alignment compares; above it, elements are paired by position only. */
+const MAX_ALIGNMENT_PAIRS = 1_000_000;
+
+/** Appends the operations that turn `from` into `to`, at the location `pointer`. */
+function diffValue(pointer: string, from: unknown, to: unknown, operations: JsonPatchOperation[]): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(pointer, from, to, operations);
+  } else if (isRecord(from) && isRecord(to)) {
+    diffObject(pointer, from, to, operations);
+  } else {
+    operations.push({ op: 'replace', path: pointer, value: structuredClone(to) });
+  }
+}
+
+/** Removes the members only in `from`, adds the members only in `to`, and compares the others. */
+function diffObject(
+  pointer: string,
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  operations: JsonPatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      operations.push({ op: 'remove', path: childPointer(pointer, key) });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const path = childPointer(pointer, key);
+    if (Object.hasOwn(from, key)) {
+      diffValue(path, from[key], to[key], operations);
+    } else {
+      operations.push({ op: 'add', path, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+/**
+ * Aligns the arrays on their unchanged elements. The elements between two aligned elements are paired by
+ * position and compared; the extra ones are removed or added at their current index. Each operation is
+ * emitted at the index the array has when the operation is applied.
+ */
+function diffArray(pointer: string, from: unknown[], to: unknown[], operations: JsonPatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+    start++;
+  }
+  let tail = 0;
+  while (
+    tail < from.length - start &&
+    tail < to.length - start &&
+    jsonEqual(from[from.length - 1 - tail], to[to.length - 1 - tail])
+  ) {
+    tail++;
+  }
+  const a = from.slice(start, from.length - tail);
+  const b = to.slice(start, to.length - tail);
+
+  let index = start;
+  let i = 0;
+  let j = 0;
+  // The last entry is a sentinel after the end of both arrays, which closes the final gap.
+  for (const [ai, bj] of [...alignElements(a, b), [a.length, b.length]]) {
+    const paired = Math.min(ai - i, bj - j);
+    for (let k = 0; k < paired; k++) {
+      diffValue(childPointer(pointer, String(index++)), a[i + k], b[j + k], operations);
+    }
+    for (let k = i + paired; k < ai; k++) {
+      operations.push({ op: 'remove', path: childPointer(pointer, String(index)) });
+    }
+    for (let k = j + paired; k < bj; k++) {
+      operations.push({ op: 'add', path: childPointer(pointer, String(index++)), value: structuredClone(b[k]) });
+    }
+    i = ai + 1;
+    j = bj + 1;
+    index++;
+  }
+}
+
+/**
+ * Finds a longest common subsequence of equal elements, as pairs of indices in increasing order. Returns no
+ * pairs when the arrays are too large to compare in full, so that the caller pairs them by position.
+ */
+function alignElements(a: unknown[], b: unknown[]): [number, number][] {
+  if (a.length * b.length > MAX_ALIGNMENT_PAIRS) {
+    return [];
+  }
+  // lengths[i * width + j] is the length of a longest common subsequence of a[i..] and b[j..].
+  const width = b.length + 1;
+  const lengths = new Uint32Array((a.length + 1) * width);
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lengths[i * width + j] = jsonEqual(a[i], b[j])
+        ? lengths[(i + 1) * width + j + 1] + 1
+        : Math.max(lengths[(i + 1) * width + j], lengths[i * width + j + 1]);
+    }
+  }
+  const pairs: [number, number][] = [];
+  let i = 0;
+  let j = 0;
+  while (i < a.length && j < b.length) {
+    if (jsonEqual(a[i], b[j])) {
+      pairs.push([i++, j++]);
+    } else if (lengths[(i + 1) * width + j] >= lengths[i * width + j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
+
+/** Appends a reference token to a JSON Pointer, escaping "~" and "/" as RFC 6901 requires. */
+function childPointer(pointer: string, token: string): string {
+  return `${pointer}/${token.replace(/~/g, '~0').replace(/\//g, '~1')}`;
+}
+
 const OPERATION_NAMES = ['add', 'remove', 'replace', 'move', 'copy', 'test'] as const;
 
 type OperationName = (typeof OPERATION_NAMES)[number];
