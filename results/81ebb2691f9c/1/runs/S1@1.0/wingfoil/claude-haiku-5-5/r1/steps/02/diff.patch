+    });
+  });
+
+  describe('sequence', () => {
+    it('applies the operations in order, each to the result of the previous one', () => {
+      assert.deepEqual(
+        applyPatch({ foo: [] as number[] }, [
+          { op: 'add', path: '/foo/-', value: 1 },
+          { op: 'add', path: '/foo/-', value: 2 },
+          { op: 'move', from: '/foo/0', path: '/bar' },
+          { op: 'test', path: '/foo/0', value: 2 },
+        ]),
+        { foo: [2], bar: 1 },
+      );
+    });
+
+    it('returns the document unchanged for an empty patch', () => {
+      assert.deepEqual(applyPatch({ foo: 'bar' }, []), { foo: 'bar' });
