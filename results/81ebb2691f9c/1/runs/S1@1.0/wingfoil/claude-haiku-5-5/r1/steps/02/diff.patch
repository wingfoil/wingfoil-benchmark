index 17e5a61728670703fe94d1a74d05e7dab7c0bf6e..5ae1d7cb874b844bddb3070ea17f62dd3eddb349 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -10,10 +10,213 @@
  * @throws {Error} when the pointer is not a valid JSON Pointer, or does not resolve to a value of the document
  */
 export function resolvePointer(document: unknown, pointer: string): unknown {
-  return parsePointer(pointer).reduce<unknown>(
-    (current, token) => selectMember(current, token, pointer),
-    document,
-  );
+  return selectPath(document, parsePointer(pointer), pointer);
+}
+
+/**
+ * One operation of a JSON Patch (RFC 6902). The `value` of `add`, `replace` and `test` is any JSON value.
+ */
+export type JsonPatchOperation =
+  | { op: 'add' | 'replace' | 'test'; path: string; value: unknown }
+  | { op: 'remove'; path: string }
+  | { op: 'move' | 'copy'; from: string; path: string };
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document.
+ *
+ * The operations are applied in order, each to the result of the previous one. The patch is applied to a
+ * copy of the document, which is returned: neither the document nor the patch is modified.
+ *
+ * @param document the JSON document to patch
+ * @param patch the operations to apply, in order
+ * @returns the patched document, as a new value
+ * @throws {Error} when the patch is invalid, or when one of its operations fails; the input is left unchanged
+ */
+export function applyPatch(document: unknown, patch: readonly JsonPatchOperation[]): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error('invalid JSON Patch: the patch must be an array of operations');
+  }
+  const operations = patch.map((operation, index) => parseOperation(operation, index));
+  return operations.reduce<unknown>((current, operation, index) => {
+    try {
+      return applyOperation(current, operation);
+    } catch (error) {
+      throw new Error(`JSON Patch patch[${index}] failed: ${(error as Error).message}`, { cause: error });
+    }
+  }, structuredClone(document));
+}
+
+const OPERATION_NAMES = ['add', 'remove', 'replace', 'move', 'copy', 'test'] as const;
+
+type OperationName = (typeof OPERATION_NAMES)[number];
+
+/** Checks that a patch element is a well-formed operation, and returns it typed. */
+function parseOperation(input: unknown, index: number): JsonPatchOperation {
+  if (!isRecord(input)) {
+    throw invalidOperation(index, 'must be an object');
+  }
+  const { op, path, from } = input;
+  if (!isOperationName(op)) {
+    throw invalidOperation(index, 'has an unknown "op"');
+  }
+  if (typeof path !== 'string') {
+    throw invalidOperation(index, `"${op}" needs a string "path"`);
+  }
+  switch (op) {
+    case 'add':
+    case 'replace':
+    case 'test':
+      if (input.value === undefined) {
+        throw invalidOperation(index, `"${op}" needs a "value"`);
+      }
+      return { op, path, value: input.value };
+    case 'remove':
+      return { op, path };
+    case 'move':
+    case 'copy':
+      if (typeof from !== 'string') {
+        throw invalidOperation(index, `"${op}" needs a string "from"`);
+      }
+      return { op, from, path };
+  }
+}
+
+function invalidOperation(index: number, reason: string): Error {
+  return new Error(`invalid JSON Patch: patch[${index}] ${reason}`);
+}
+
+function isOperationName(name: unknown): name is OperationName {
+  return (OPERATION_NAMES as readonly unknown[]).includes(name);
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/** Applies one operation, and returns the resulting document. */
+function applyOperation(document: unknown, operation: JsonPatchOperation): unknown {
+  switch (operation.op) {
+    case 'add':
+      return add(document, operation.path, structuredClone(operation.value));
+    case 'remove':
+      return remove(document, operation.path);
+    case 'replace':
+      return replace(document, operation.path, structuredClone(operation.value));
+    case 'move':
+      return move(document, operation.from, operation.path);
+    case 'copy':
+      return add(document, operation.path, structuredClone(resolvePointer(document, operation.from)));
+    case 'test':
+      return testValue(document, operation.path, operation.value);
+  }
+}
+
+/** Adds a member, or inserts an array element before the given index, or appends with "-". */
+function add(document: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  const token = tokens.pop();
+  if (token === undefined) {
+    return value;
+  }
+  const parent = selectPath(document, tokens, pointer);
+  if (Array.isArray(parent)) {
+    if (token === '-') {
+      parent.push(value);
+    } else {
+      if (!ARRAY_INDEX.test(token) || Number(token) > parent.length) {
+        throw new Error(`JSON Pointer "${pointer}" does not resolve: no array position "${token}"`);
+      }
+      parent.splice(Number(token), 0, value);
+    }
+  } else if (isRecord(parent)) {
+    defineMember(parent, token, value);
+  } else {
+    throw new Error(`JSON Pointer "${pointer}" does not resolve: cannot add to a primitive value`);
+  }
+  return document;
+}
+
+/** Removes the member or array element at the location, which must exist. */
+function remove(document: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  const token = tokens.pop();
+  if (token === undefined) {
+    throw new Error('cannot remove the whole document');
+  }
+  const parent = selectPath(document, tokens, pointer);
+  selectMember(parent, token, pointer);
+  if (Array.isArray(parent)) {
+    parent.splice(Number(token), 1);
+  } else {
+    delete (parent as Record<string, unknown>)[token];
+  }
+  return document;
+}
+
+/** Replaces the value at the location, which must exist. */
+function replace(document: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  const token = tokens.pop();
+  if (token === undefined) {
+    return value;
+  }
+  const parent = selectPath(document, tokens, pointer);
+  selectMember(parent, token, pointer);
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else {
+    defineMember(parent as Record<string, unknown>, token, value);
+  }
+  return document;
+}
+
+/** Moves the value at "from" to "path": a removal followed by an addition. */
+function move(document: unknown, from: string, pointer: string): unknown {
+  const value = resolvePointer(document, from);
+  if (isProperPrefix(parsePointer(from), parsePointer(pointer))) {
+    throw new Error(`cannot move "${from}" into one of its own children, "${pointer}"`);
+  }
+  return add(remove(document, from), pointer, value);
+}
+
+/** Checks that the value at the location equals the expected value. */
+function testValue(document: unknown, pointer: string, expected: unknown): unknown {
+  if (!jsonEqual(resolvePointer(document, pointer), expected)) {
+    throw new Error(`the value at "${pointer}" does not equal the tested value`);
+  }
+  return document;
+}
+
+/** Creates or replaces an own property, so that a member named "__proto__" is stored as data. */
+function defineMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function isProperPrefix(prefix: string[], tokens: string[]): boolean {
+  return prefix.length < tokens.length && prefix.every((token, index) => token === tokens[index]);
+}
+
+/** Compares two JSON values by structure: arrays in order, objects by their members in any order. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, index) => jsonEqual(item, b[index]));
+  }
+  if (isRecord(a)) {
+    if (!isRecord(b)) {
+      return false;
+    }
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.hasOwn(b, key) && jsonEqual(a[key], b[key]))
+    );
+  }
+  return a === b;
+}
+
+/** Follows the reference tokens from the document, each one selecting a member that must exist. */
+function selectPath(document: unknown, tokens: string[], pointer: string): unknown {
+  return tokens.reduce((current, token) => selectMember(current, token, pointer), document);
 }
 
 const ARRAY_INDEX = /^(0|[1-9]\d*)$/;
