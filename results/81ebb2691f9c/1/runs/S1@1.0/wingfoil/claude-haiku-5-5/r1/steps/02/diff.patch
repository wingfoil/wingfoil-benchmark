+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch } from '../src/index.ts';
+
+describe('applyPatch', () => {
+  describe('operations (RFC 6902, appendix A examples)', () => {
+    it('add sets a new object member', () => {
+      assert.deepEqual(
+        applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/baz', value: 'qux' }]),
+        { foo: 'bar', baz: 'qux' },
+      );
+    });
+
+    it('add inserts an array element before the given index', () => {
+      assert.deepEqual(
+        applyPatch({ foo: ['bar', 'baz'] }, [{ op: 'add', path: '/foo/1', value: 'qux' }]),
+        { foo: ['bar', 'qux', 'baz'] },
+      );
+    });
+
+    it('add appends to an array with the "-" index', () => {
+      assert.deepEqual(
+        applyPatch({ foo: ['bar'] }, [{ op: 'add', path: '/foo/-', value: ['abc', 'def'] }]),
+        { foo: ['bar', ['abc', 'def']] },
+      );
+    });
+
+    it('add accepts the array length as the index, which appends', () => {
+      assert.deepEqual(applyPatch(['a', 'b'], [{ op: 'add', path: '/2', value: 'c' }]), ['a', 'b', 'c']);
+    });
+
+    it('add replaces an existing object member', () => {
+      assert.deepEqual(applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/foo', value: 1 }]), { foo: 1 });
+    });
+
+    it('add with the empty path replaces the whole document', () => {
+      assert.deepEqual(applyPatch({ foo: 'bar' }, [{ op: 'add', path: '', value: [1] }]), [1]);
+    });
+
+    it('remove deletes an object member', () => {
+      assert.deepEqual(applyPatch({ baz: 'qux', foo: 'bar' }, [{ op: 'remove', path: '/baz' }]), {
+        foo: 'bar',
+      });
+    });
+
+    it('remove deletes an array element', () => {
+      assert.deepEqual(
+        applyPatch({ foo: ['bar', 'qux', 'baz'] }, [{ op: 'remove', path: '/foo/1' }]),
+        { foo: ['bar', 'baz'] },
+      );
+    });
+
+    it('replace sets an existing member', () => {
+      assert.deepEqual(
+        applyPatch({ baz: 'qux', foo: 'bar' }, [{ op: 'replace', path: '/baz', value: 'boo' }]),
+        { baz: 'boo', foo: 'bar' },
+      );
+    });
+
+    it('replace with the empty path replaces the whole document', () => {
+      assert.equal(applyPatch({ foo: 'bar' }, [{ op: 'replace', path: '', value: 7 }]), 7);
+    });
+
+    it('move relocates a member to another object', () => {
+      assert.deepEqual(
+        applyPatch({ foo: { bar: 'baz', waldo: 'fred' }, qux: { corge: 'grault' } }, [
+          { op: 'move', from: '/foo/waldo', path: '/qux/thud' },
+        ]),
+        { foo: { bar: 'baz' }, qux: { corge: 'grault', thud: 'fred' } },
+      );
+    });
+
+    it('move relocates an array element', () => {
+      assert.deepEqual(
+        applyPatch({ foo: ['all', 'grass', 'cows', 'eat'] }, [{ op: 'move', from: '/foo/1', path: '/foo/3' }]),
+        { foo: ['all', 'cows', 'eat', 'grass'] },
+      );
+    });
+
+    it('copy adds a copy of a value at another location', () => {
+      assert.deepEqual(
+        applyPatch({ foo: { bar: 'baz' } }, [{ op: 'copy', from: '/foo', path: '/qux' }]),
+        { foo: { bar: 'baz' }, qux: { bar: 'baz' } },
+      );
+    });
+
+    it('copy produces a value that does not share structure with its source', () => {
+      const result = applyPatch({ foo: { bar: 'baz' } }, [{ op: 'copy', from: '/foo', path: '/qux' }]) as {
+        foo: { bar: string };
+        qux: { bar: string };
+      };
+      result.qux.bar = 'changed';
+      assert.equal(result.foo.bar, 'baz');
+    });
+
+    it('test passes when the value is equal', () => {
+      const doc = { baz: 'qux', foo: ['a', 2, 'c'] };
+      assert.deepEqual(
+        applyPatch(doc, [
+          { op: 'test', path: '/baz', value: 'qux' },
+          { op: 'test', path: '/foo/1', value: 2 },
+        ]),
+        doc,
+      );
+    });
+
+    it('test fails when the value differs', () => {
+      assert.throws(() => applyPatch({ baz: 'qux' }, [{ op: 'test', path: '/baz', value: 'bar' }]));
+    });
+
+    it('test compares objects by their members, regardless of key order', () => {
+      assert.deepEqual(
+        applyPatch({ a: { x: 1, y: [1, { z: null }] } }, [
+          { op: 'test', path: '/a', value: { y: [1, { z: null }], x: 1 } },
+        ]),
+        { a: { x: 1, y: [1, { z: null }] } },
+      );
+    });
+
+    it('test compares arrays in order and rejects arrays of different length', () => {
+      assert.throws(() => applyPatch({ a: [1, 2] }, [{ op: 'test', path: '/a', value: [2, 1] }]));
+      assert.throws(() => applyPatch({ a: [1, 2] }, [{ op: 'test', path: '/a', value: [1] }]));
+    });
+
+    it('test does not treat null as an object or an array', () => {
+      assert.throws(() => applyPatch({ a: null }, [{ op: 'test', path: '/a', value: {} }]));
+      assert.throws(() => applyPatch({ a: null }, [{ op: 'test', path: '/a', value: [] }]));
+    });
+
+    it('test with a member name containing escapes resolves the escaped name', () => {
+      assert.deepEqual(applyPatch({ '/': 9, '~1': 10 }, [{ op: 'test', path: '/~01', value: 10 }]), {
+        '/': 9,
+        '~1': 10,
+      });
+    });
+  });
+
+  describe('equality and moves to the same place', () => {
+    it('test treats 0 and -0 as equal', () => {
+      assert.deepEqual(applyPatch({ a: -0 }, [{ op: 'test', path: '/a', value: 0 }]), { a: -0 });
+    });
+
+    it('move to the same location leaves the document unchanged', () => {
