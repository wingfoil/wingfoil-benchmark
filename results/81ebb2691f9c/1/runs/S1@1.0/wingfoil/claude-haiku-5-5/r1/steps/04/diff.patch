new file mode 100644
index 0000000000000000000000000000000000000000..faba8753c4db6a56d6440aecf85d791f0995faa4
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,113 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyMergePatch } from '../src/index.ts';
+
+// The examples of RFC 7386, Appendix A: each row is a target, a patch and the expected result.
+const appendixA: [string, unknown, unknown, unknown][] = [
+  ['replaces a member', { a: 'b' }, { a: 'c' }, { a: 'c' }],
+  ['adds a member', { a: 'b' }, { b: 'c' }, { a: 'b', b: 'c' }],
+  ['removes a member set to null', { a: 'b' }, { a: null }, {}],
+  ['removes only the named member', { a: 'b', b: 'c' }, { a: null }, { b: 'c' }],
+  ['replaces an array with a string', { a: ['b'] }, { a: 'c' }, { a: 'c' }],
+  ['replaces a string with an array', { a: 'c' }, { a: ['b'] }, { a: ['b'] }],
+  ['merges nested objects', { a: { b: 'c' } }, { a: { b: 'd', c: null } }, { a: { b: 'd' } }],
+  ['replaces an array of objects', { a: [{ b: 'c' }] }, { a: [1] }, { a: [1] }],
+  ['replaces an array with an array', ['a', 'b'], ['c', 'd'], ['c', 'd']],
+  ['replaces an object with an array', { a: 'b' }, ['c'], ['c']],
+  ['replaces an object with null', { a: 'foo' }, null, null],
+  ['replaces an object with a string', { a: 'foo' }, 'bar', 'bar'],
+  ['keeps a null member that is not in the patch', { e: null }, { a: 1 }, { e: null, a: 1 }],
+  ['replaces an array with an object, dropping null members', [1, 2], { a: 'b', c: null }, { a: 'b' }],
+  ['creates nested objects, dropping null members', {}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+
+describe('applyMergePatch', () => {
+  describe('RFC 7386, Appendix A examples', () => {
+    for (const [name, target, patch, expected] of appendixA) {
+      it(name, () => {
+        assert.deepEqual(applyMergePatch(target, patch), expected);
+      });
+    }
+  });
+
+  describe('members', () => {
+    it('removes a member set to null, and does not create it when it is absent', () => {
+      assert.deepEqual(applyMergePatch({ a: 1 }, { b: null }), { a: 1 });
+    });
+
+    it('keeps null values inside arrays, because only object members are removed', () => {
+      assert.deepEqual(applyMergePatch({ a: [1] }, { a: [null, 2] }), { a: [null, 2] });
+    });
+
+    it('does not keep a null member of a new object', () => {
+      assert.deepEqual(applyMergePatch({ a: 1 }, { b: { c: null } }), { a: 1, b: {} });
+    });
+
+    it('merges nested objects without touching their other members', () => {
+      assert.deepEqual(
+        applyMergePatch({ a: { b: { c: 1, d: 2 }, e: 3 } }, { a: { b: { c: null } } }),
+        { a: { b: { d: 2 }, e: 3 } },
+      );
+    });
+
+    it('treats a member whose name is inherited, such as "constructor", as absent from the target', () => {
+      assert.deepEqual(applyMergePatch({}, { constructor: { a: 1 } }), { constructor: { a: 1 } });
+    });
+
+    it('stores a member named "__proto__" as data, without changing the prototype', () => {
+      const patch = JSON.parse('{"__proto__": {"polluted": true}}');
+      const result = applyMergePatch({}, patch) as Record<string, unknown>;
+      assert.equal(Object.getPrototypeOf(result), Object.prototype);
+      assert.equal(Object.hasOwn(result, 'polluted'), false);
+      assert.deepEqual(JSON.parse(JSON.stringify(result)), JSON.parse('{"__proto__": {"polluted": true}}'));
+      assert.equal(Object.hasOwn(result, '__proto__'), true);
+    });
+  });
+
+  describe('non-object patches and targets', () => {
+    it('returns a copy of a patch that is an array, replacing the whole target', () => {
+      const patch = [{ a: null }];
+      const result = applyMergePatch({ a: 1 }, patch) as unknown[];
+      assert.deepEqual(result, [{ a: null }]);
+      assert.notEqual(result, patch);
+    });
+
+    it('returns a number, a boolean and a string patch as they are', () => {
+      assert.equal(applyMergePatch({ a: 1 }, 0), 0);
+      assert.equal(applyMergePatch({ a: 1 }, false), false);
+      assert.equal(applyMergePatch({ a: 1 }, ''), '');
+    });
+
+    it('starts from an empty object when the target is a primitive', () => {
+      assert.deepEqual(applyMergePatch(42, { a: 1 }), { a: 1 });
+      assert.deepEqual(applyMergePatch(null, { a: 1 }), { a: 1 });
+    });
+  });
+
+  describe('no mutation', () => {
+    it('does not modify the target or the patch', () => {
+      const target = { a: { b: 1, c: [1] }, d: 'x' };
+      const patch = { a: { b: null, e: { f: 2 } }, g: 3 };
+      const targetBefore = structuredClone(target);
+      const patchBefore = structuredClone(patch);
+      applyMergePatch(target, patch);
+      assert.deepEqual(target, targetBefore);
+      assert.deepEqual(patch, patchBefore);
+    });
+
+    it('returns a document that shares no object with the target or the patch', () => {
+      const target = { a: { b: 1 }, c: { d: 2 } };
+      const patch = { a: { e: { f: 3 } } };
+      const result = applyMergePatch(target, patch) as { a: { e: { f: unknown } }; c: { d: number } };
+      result.c.d = 99;
+      result.a.e.f = 99;
+      assert.deepEqual(target, { a: { b: 1 }, c: { d: 2 } });
+      assert.deepEqual(patch, { a: { e: { f: 3 } } });
+    });
+
+    it('returns a new value even when the patch changes nothing', () => {
+      const target = { a: 1 };
+      assert.notEqual(applyMergePatch(target, {}), target);
+    });
+  });
+});
