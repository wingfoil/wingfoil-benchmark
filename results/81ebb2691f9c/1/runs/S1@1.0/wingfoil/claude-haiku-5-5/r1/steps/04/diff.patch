@@ -46,6 +46,37 @@ export function applyPatch(document: unknown, patch: readonly JsonPatchOperation
   }, structuredClone(document));
 }
 
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document.
+ *
+ * A patch that is not an object replaces the whole document. A patch object is merged into the target: a
+ * member whose value is `null` removes the member of the same name, and any other member is merged into the
+ * target's member of that name. Arrays are replaced, not merged.
+ *
+ * @param target the JSON document to patch
+ * @param patch the merge patch, as a JSON value
+ * @returns the merged document, as a new value: neither the target nor the patch is modified
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return mergeInto(structuredClone(target), patch);
+}
+
+/** Merges a patch into a target that the caller owns, which is modified and returned. */
+function mergeInto(target: unknown, patch: unknown): unknown {
+  if (!isRecord(patch)) {
+    return structuredClone(patch);
+  }
+  const result: Record<string, unknown> = isRecord(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    if (patch[key] === null) {
+      delete result[key];
+    } else {
+      defineMember(result, key, mergeInto(Object.hasOwn(result, key) ? result[key] : undefined, patch[key]));
+    }
+  }
+  return result;
+}
+
 const OPERATION_NAMES = ['add', 'remove', 'replace', 'move', 'copy', 'test'] as const;
 
 type OperationName = (typeof OPERATION_NAMES)[number];
