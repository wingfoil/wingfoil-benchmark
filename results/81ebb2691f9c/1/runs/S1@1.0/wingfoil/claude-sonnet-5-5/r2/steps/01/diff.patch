@@ -0,0 +1,76 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// The example document of RFC 6901, section 5, and its expected evaluations (section 5 / 6).
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("unescapes ~01 as ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("resolves to falsy values, including null", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer([false], "/0"), false);
+});
+
+test("whole-document pointer works on any JSON value", () => {
+  assert.equal(resolvePointer(null, ""), null);
+  assert.equal(resolvePointer("s", ""), "s");
+});
+
+test("rejects syntactically invalid pointers", () => {
+  for (const p of ["foo", "a/b", "/a~", "/a~2", "/a~b", "#/a", "# "]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), /invalid/i, p);
+  }
+  assert.throws(() => resolvePointer({}, undefined as unknown as string), /invalid/i);
+});
+
+test("rejects pointers that do not resolve", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"), /not resolve/i);
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"), /not resolve/i);
+  assert.throws(() => resolvePointer({ a: "str" }, "/a/0"), /not resolve/i);
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"), /not resolve/i);
+});
+
+test("array indices: strict decimal, in range", () => {
+  const doc = ["a", "b"];
+  assert.equal(resolvePointer(doc, "/1"), "b");
+  for (const p of ["/2", "/-", "/01", "/+1", "/-1", "/1.0", "/ 1", "/1e0", "/length", "/"]) {
+    assert.throws(() => resolvePointer(doc, p), /not resolve/i, p);
+  }
+});
+
+test("only own properties of objects resolve", () => {
+  for (const p of ["/__proto__", "/constructor", "/toString", "/hasOwnProperty"]) {
+    assert.throws(() => resolvePointer({}, p), /not resolve/i, p);
+  }
+  const parsed = JSON.parse('{"__proto__": 5}');
+  assert.equal(resolvePointer(parsed, "/__proto__"), 5);
+});
