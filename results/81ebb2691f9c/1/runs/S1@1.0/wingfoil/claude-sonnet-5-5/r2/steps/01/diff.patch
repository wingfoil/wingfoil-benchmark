@@ -0,0 +1,50 @@
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Splits a pointer into its unescaped reference tokens (RFC 6901, sections 3 and 4). */
+function parseTokens(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new Error(`Invalid JSON Pointer "${pointer}": "~" must be followed by "0" or "1"`);
+      }
+      // "~1" first, then "~0", so that "~01" yields "~1" (RFC 6901, section 4).
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer `pointer` (RFC 6901) refers to.
+ *
+ * @throws Error if `pointer` is not a valid JSON Pointer, or if it does not resolve to a value of
+ * `document` (missing member, array index out of range or "-", or traversal into a scalar).
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const token of parseTokens(pointer)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`JSON Pointer "${pointer}" does not resolve: no array element "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new Error(`JSON Pointer "${pointer}" does not resolve: no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: "${token}" is not in an object or array`);
+    }
+  }
+  return current;
+}
