@@ -0,0 +1,64 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+const target = { a: "b", c: { d: "e", f: "g" } };
+
+// RFC 7386, Appendix A test cases.
+const cases: [unknown, unknown, unknown][] = [
+  [{ a: "b" }, { a: "c" }, { a: "c" }],
+  [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  [{ a: "b" }, { a: null }, {}],
+  [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+  [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+  [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  [["a", "b"], ["c", "d"], ["c", "d"]],
+  [{ a: "b" }, ["c"], ["c"]],
+  [{ a: "foo" }, null, null],
+  [{ a: "foo" }, "bar", "bar"],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: "b", c: null }, { a: "b" }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+for (const [t, p, expected] of cases) {
+  test(`RFC 7386 A: ${JSON.stringify(t)} + ${JSON.stringify(p)}`, () => {
+    assert.deepEqual(applyMergePatch(t, p), expected);
+  });
+}
+
+test("section 3 example", () => {
+  const patch = { title: "Hello!", phoneNumber: "+01-123-456-7890", author: { familyName: null }, tags: ["example"] };
+  const doc = { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["example", "sample"], content: "x" };
+  assert.deepEqual(applyMergePatch(doc, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "x",
+    phoneNumber: "+01-123-456-7890",
+  });
+});
+
+test("does not mutate or share structure with its arguments", () => {
+  const t = structuredClone(target);
+  const p = { c: { x: { y: 1 } } };
+  const pCopy = structuredClone(p);
+  const result = applyMergePatch(t, p) as { c: { x: unknown } };
+  assert.deepEqual(t, target);
+  assert.deepEqual(p, pCopy);
+  assert.notEqual(result.c.x, p.c.x);
+});
+
+test("treats __proto__ as an ordinary member", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"polluted":true}}')) as object;
+  assert.equal(Object.hasOwn(result, "__proto__"), true);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  assert.equal((result as Record<string, unknown>).polluted, undefined);
+});
+
+test("rejects values that are not JSON", () => {
+  assert.throws(() => applyMergePatch({}, { a: undefined }), /Merge Patch/);
+  assert.throws(() => applyMergePatch({}, { a: NaN }), /Merge Patch/);
+  assert.throws(() => applyMergePatch({ a: new Date() }, {}), /Merge Patch/);
+});
