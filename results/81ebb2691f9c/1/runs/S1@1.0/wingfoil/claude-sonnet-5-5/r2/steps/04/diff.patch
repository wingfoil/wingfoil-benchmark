+++ b/src/merge-patch.ts
@@ -0,0 +1,37 @@
+import { isJsonValue, isObject, setMember } from "./json.ts";
+
+function merge(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result: Record<string, unknown> = {};
+  if (isObject(target)) {
+    for (const [key, value] of Object.entries(target)) {
+      setMember(result, key, structuredClone(value));
+    }
+  }
+  for (const [key, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, merge(result[key], value));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies the JSON Merge Patch `patch` (RFC 7386) to `target` and returns the result as a new value.
+ * Neither argument is mutated, and the result shares no structure with either.
+ *
+ * @throws Error if `target` or `patch` is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonValue(patch)) {
+    throw new Error("Invalid JSON Merge Patch: not a JSON value");
+  }
+  if (!isJsonValue(target)) {
+    throw new Error("JSON Merge Patch: target is not a JSON value");
+  }
+  return merge(target, patch);
+}
