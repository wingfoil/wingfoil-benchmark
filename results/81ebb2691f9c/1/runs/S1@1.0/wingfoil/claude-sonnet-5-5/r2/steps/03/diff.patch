+
+# Make applyPatch conform to RFC 6902
+
+Reviewed patch checking and application against RFC 6902 (all six operations, root and `-` handling,
+move-into-child, atomicity, input immutability, error cases). The behaviour was conformant except that
+operation `value`s were only checked for presence: `undefined`, `NaN`, `Infinity`, bigint, `Date`,
+`Map`, functions and cyclic structures were accepted (and silently cloned or dropped). They are now
+rejected as an invalid patch. Test added in `test/patch.test.ts`; `npm test` passes (35 tests).
diff --git a/src/patch.ts b/src/patch.ts
index 04bf02fd6962470854da2eb0631b44fec4e0f730..594d0faf35c9ef610af5abaed0343cf6619d37c3 100644
--- a/src/patch.ts
+++ b/src/patch.ts
@@ -16,6 +16,25 @@ function isObject(value: unknown): value is Record<string, unknown> {
   return typeof value === "object" && value !== null && !Array.isArray(value);
 }
 
+/** True if `value` is a JSON value (RFC 8259): no undefined, NaN, Infinity, class instance or cycle. */
+function isJsonValue(value: unknown, ancestors: object[] = []): boolean {
+  if (value === null || typeof value === "string" || typeof value === "boolean") {
+    return true;
+  }
+  if (typeof value === "number") {
+    return Number.isFinite(value);
+  }
+  if (typeof value !== "object" || ancestors.includes(value)) {
+    return false;
+  }
+  const path = [...ancestors, value];
+  if (Array.isArray(value)) {
+    return value.every((item) => isJsonValue(item, path));
+  }
+  const prototype = Object.getPrototypeOf(value);
+  return (prototype === Object.prototype || prototype === null) && Object.values(value).every((item) => isJsonValue(item, path));
+}
+
 /** Checks the shape of one operation (RFC 6902, sections 3 and 4) and returns it typed. */
 function validateOperation(operation: unknown, index: number): Operation {
   const where = `Invalid JSON Patch: operation ${index}`;
@@ -33,6 +52,9 @@ function validateOperation(operation: unknown, index: number): Operation {
   if ((op === "add" || op === "replace" || op === "test") && !Object.hasOwn(operation, "value")) {
     throw new Error(`${where} ("${op}") requires a "value"`);
   }
+  if (Object.hasOwn(operation, "value") && !isJsonValue(operation.value)) {
+    throw new Error(`${where} has a "value" that is not a JSON value`);
+  }
   if (op === "move" || op === "copy") {
     if (typeof operation.from !== "string") {
       throw new Error(`${where} ("${op}") requires a string "from"`);
