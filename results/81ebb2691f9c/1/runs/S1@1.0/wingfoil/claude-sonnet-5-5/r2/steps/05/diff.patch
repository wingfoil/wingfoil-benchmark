index 0000000000000000000000000000000000000000..d323c062033e63464761f47ddeeef69927d0b0db
--- /dev/null
+++ b/src/diff.ts
@@ -0,0 +1,83 @@
+import { isJsonValue, isObject, jsonEqual } from "./json.ts";
+
+interface Operation {
+  op: "add" | "remove" | "replace";
+  path: string;
+  value?: unknown;
+}
+
+/** Escapes a member name as a JSON Pointer reference token (RFC 6901, section 3). */
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffObjects(from: Record<string, unknown>, to: Record<string, unknown>, path: string, out: Operation[]): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const child = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) {
+      diff(from[key], to[key], child, out);
+    } else {
+      out.push({ op: "add", path: child, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+/**
+ * Trims the common head and tail of the arrays, diffs the elements that overlap in the middle in
+ * place, then removes or appends what is left over.
+ */
+function diffArrays(from: unknown[], to: unknown[], path: string, out: Operation[]): void {
+  let head = 0;
+  while (head < from.length && head < to.length && jsonEqual(from[head], to[head])) {
+    head++;
+  }
+  let tail = 0;
+  while (tail < from.length - head && tail < to.length - head && jsonEqual(from[from.length - 1 - tail], to[to.length - 1 - tail])) {
+    tail++;
+  }
+  const fromEnd = from.length - tail;
+  const toEnd = to.length - tail;
+  const overlap = Math.min(fromEnd, toEnd) - head;
+  for (let i = head; i < head + overlap; i++) {
+    diff(from[i], to[i], `${path}/${i}`, out);
+  }
+  // Removing at the same index each time avoids the later indexes shifting under us.
+  for (let i = head + overlap; i < fromEnd; i++) {
+    out.push({ op: "remove", path: `${path}/${head + overlap}` });
+  }
+  for (let i = head + overlap; i < toEnd; i++) {
+    out.push({ op: "add", path: `${path}/${i}`, value: structuredClone(to[i]) });
+  }
+}
+
+function diff(from: unknown, to: unknown, path: string, out: Operation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from, to, path, out);
+  } else if (!jsonEqual(from, to)) {
+    out.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ * It lists only the differences: unchanged members and array elements are not mentioned, and
+ * equal documents give an empty patch. Neither argument is mutated, and the patch shares no
+ * structure with them. The result is deterministic for given inputs.
+ *
+ * @throws Error if `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new Error("Cannot create a JSON Patch: input is not a JSON value");
+  }
+  const out: Operation[] = [];
+  diff(from, to, "", out);
+  return out;
+}
