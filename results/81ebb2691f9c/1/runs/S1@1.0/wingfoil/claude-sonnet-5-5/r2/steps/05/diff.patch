index 0000000000000000000000000000000000000000..0ab306f01876861719207ab8d7e11ddcbc2dcea6
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,90 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown): unknown[] {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("member order is not a difference", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+});
+
+test("one small change deep in a document is a single operation", () => {
+  const from = { user: { name: "a", tags: ["x", "y"], address: { city: "Paris", zip: "75001" } }, big: [1, 2, 3] };
+  const to = structuredClone(from);
+  to.user.address.city = "Lyon";
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/user/address/city", value: "Lyon" }]);
+});
+
+test("added and removed members", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("type changes replace the value", () => {
+  assert.deepEqual(roundTrip({ a: [1] }, { a: { 0: 1 } }), [{ op: "replace", path: "/a", value: { 0: 1 } }]);
+  roundTrip({ a: null }, { a: 0 });
+});
+
+test("root replacement", () => {
+  assert.deepEqual(roundTrip(1, "x"), [{ op: "replace", path: "", value: "x" }]);
+  roundTrip([1], { a: 1 });
+});
+
+test("keys with / and ~ are escaped", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "~": 1 }, { "a/b": 2, "~": 1 }), [{ op: "replace", path: "/a~1b", value: 2 }]);
+  roundTrip({ "~1": 1 }, { "~1": 2 });
+});
+
+test("__proto__ is an ordinary member", () => {
+  const from = JSON.parse('{"__proto__": 1}');
+  const to = JSON.parse('{"__proto__": 2}');
+  roundTrip(from, to);
+  roundTrip({}, to);
+});
+
+test("array append, insert, remove and edit stay small", () => {
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 2]), [{ op: "remove", path: "/2" }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 9, 3]), [{ op: "replace", path: "/1", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 3], [1, 2, 3]), [{ op: "add", path: "/1", value: 2 }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+});
+
+test("array of objects diffs inside the elements", () => {
+  assert.deepEqual(roundTrip([{ a: 1 }, { a: 2 }], [{ a: 1 }, { a: 3 }]), [{ op: "replace", path: "/1/a", value: 3 }]);
+});
+
+test("arrays with several changes round-trip", () => {
+  roundTrip([1, 2, 3, 4, 5], [1, 9, 8, 7, 5]);
+  roundTrip([1, 2, 3, 4, 5], [1, 9, 5]);
+  roundTrip([1, 5], [1, 2, 3, 4, 5]);
+  roundTrip([], [1, 2]);
+  roundTrip([1, 2], []);
+});
+
+test("inputs are not mutated and the patch shares no structure with them", () => {
+  const from = { a: { b: 1 } };
+  const to = { a: { b: 1 }, c: { d: [1] } };
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to) as { value: { d: number[] } }[];
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  patch[0].value.d.push(2);
+  assert.deepEqual(to, toCopy);
+});
+
+test("non-JSON input is rejected", () => {
+  assert.throws(() => createPatch({ a: undefined }, {}), /not a JSON value/);
+  assert.throws(() => createPatch({}, { a: NaN }), /not a JSON value/);
+});
