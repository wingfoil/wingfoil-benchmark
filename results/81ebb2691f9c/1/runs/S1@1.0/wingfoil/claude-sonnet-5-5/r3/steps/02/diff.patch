+---
+id: task-002-implement-json-patch-applypatch-rfc-6902
+type: task
+title: "Implement JSON Patch applyPatch (RFC 6902)"
+status: pending
+format: 1
+---
+
+Implemented `applyPatch(document, patch)` in `src/index.ts` (RFC 6902: add, remove, replace, move, copy, test),
+built on `resolvePointer`. Tests in `test/patch.test.ts` cover each operation's happy and error paths,
+non-mutation, atomicity and malformed patches. See dl-002.
diff --git a/src/index.ts b/src/index.ts
index b6a054a30c4e20d454a919328c8df898a2bfa80b..f9da580afa6b2de66908de7dec6bd96df4dc1737 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -54,3 +54,172 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+/** The six operation names of RFC 6902. */
+export type PatchOperationName = "add" | "remove" | "replace" | "move" | "copy" | "test";
+
+/** One operation of a JSON Patch (RFC 6902). */
+export interface PatchOperation {
+  op: PatchOperationName;
+  path: string;
+  value?: JsonValue;
+  from?: string;
+}
+
+/** A JSON Patch document: an ordered array of operations. */
+export type JsonPatch = PatchOperation[];
+
+type Container = JsonValue[] | { [key: string]: JsonValue };
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function deepClone<T>(value: T): T {
+  return structuredClone(value);
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) &&
+      Array.isArray(b) &&
+      a.length === b.length &&
+      a.every((item, i) => deepEqual(item, b[i]))
+    );
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.hasOwn(b, key) && deepEqual(a[key], b[key]))
+    );
+  }
+  return a === b;
+}
+
+/** Defines an own member, so that a key such as `__proto__` never reaches the prototype. */
+function setMember(target: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function requirePointer(op: Record<string, unknown>, member: "path" | "from"): string {
+  const pointer = op[member];
+  if (typeof pointer !== "string") {
+    throw new Error(`Invalid JSON Patch: operation "${String(op.op)}" needs a string "${member}"`);
+  }
+  return pointer;
+}
+
+/** Splits a non-empty pointer into the container it points into and its last token. */
+function locateParent(document: unknown, pointer: string): { parent: Container; token: string } {
+  const cut = pointer.lastIndexOf("/");
+  if (cut < 0) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`);
+  }
+  const token = unescapeToken(pointer.slice(cut + 1));
+  const parent = resolvePointer(document, pointer.slice(0, cut));
+  if (typeof parent !== "object" || parent === null) {
+    throw new Error(`JSON Patch target "${pointer}" has no container parent`);
+  }
+  return { parent: parent as Container, token };
+}
+
+function arrayIndex(array: unknown[], token: string, pointer: string, allowEnd: boolean): number {
+  if (allowEnd && token === "-") {
+    return array.length;
+  }
+  const index = Number(token);
+  if (!ARRAY_INDEX.test(token) || index > array.length || (!allowEnd && index === array.length)) {
+    throw new Error(`JSON Patch target "${pointer}": bad array index "${token}"`);
+  }
+  return index;
+}
+
+function addValue(document: JsonValue, pointer: string, value: JsonValue): JsonValue {
+  if (pointer === "") {
+    return value;
+  }
+  const { parent, token } = locateParent(document, pointer);
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(parent, token, pointer, true), 0, value);
+  } else {
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+function removeValue(document: JsonValue, pointer: string): JsonValue {
+  if (pointer === "") {
+    throw new Error("JSON Patch cannot remove the whole document");
+  }
+  const { parent, token } = locateParent(document, pointer);
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(parent, token, pointer, false), 1);
+  } else if (Object.hasOwn(parent, token)) {
+    delete parent[token];
+  } else {
+    throw new Error(`JSON Patch target "${pointer}" does not exist`);
+  }
+  return document;
+}
+
+function applyOperation(document: JsonValue, raw: unknown): JsonValue {
+  if (!isObject(raw)) {
+    throw new Error("Invalid JSON Patch: an operation must be an object");
+  }
+  const path = requirePointer(raw, "path");
+  const needValue = (): JsonValue => {
+    if (!Object.hasOwn(raw, "value") || raw.value === undefined) {
+      throw new Error(`Invalid JSON Patch: operation "${String(raw.op)}" needs a "value"`);
+    }
+    return deepClone(raw.value as JsonValue);
+  };
+
+  switch (raw.op) {
+    case "add":
+      return addValue(document, path, needValue());
+    case "remove":
+      return removeValue(document, path);
+    case "replace": {
+      const value = needValue();
+      resolvePointer(document, path);
+      return path === "" ? value : addValue(removeValue(document, path), path, value);
+    }
+    case "move": {
+      const from = requirePointer(raw, "from");
+      if (path.startsWith(`${from}/`)) {
+        throw new Error(`JSON Patch cannot move "${from}" into its own child "${path}"`);
+      }
+      const value = deepClone(resolvePointer(document, from) as JsonValue);
+      return from === path ? document : addValue(removeValue(document, from), path, value);
+    }
+    case "copy": {
+      const from = requirePointer(raw, "from");
+      return addValue(document, path, deepClone(resolvePointer(document, from) as JsonValue));
+    }
+    case "test":
+      if (!deepEqual(resolvePointer(document, path), needValue())) {
+        throw new Error(`JSON Patch test failed at "${path}"`);
+      }
+      return document;
+    default:
+      throw new Error(`Invalid JSON Patch: unknown operation "${String(raw.op)}"`);
+  }
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result.
+ *
+ * The input document and patch are never mutated; the result shares no
+ * structure with them. Operations run in order, and the whole patch is
+ * atomic: it throws an `Error` when the patch is malformed or any operation
+ * fails (missing target, bad array index, failed `test`, removal of the root),
+ * and then no result is produced.
+ */
+export function applyPatch(document: JsonValue, patch: JsonPatch): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: a patch must be an array of operations");
+  }
+  return patch.reduce<JsonValue>(applyOperation, deepClone(document));
+}
