new file mode 100644
index 0000000000000000000000000000000000000000..6faf08a71fd164ffe621b4a0074b70d36a27fe25
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,129 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, type JsonPatch, type JsonValue } from "../src/index.ts";
+
+const apply = (doc: JsonValue, patch: unknown) => applyPatch(doc, patch as JsonPatch);
+
+test("add: member, replace existing member, array insert and append", () => {
+  assert.deepEqual(apply({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(apply({ foo: "bar" }, [{ op: "add", path: "/foo", value: 1 }]), { foo: 1 });
+  assert.deepEqual(apply({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(apply([1], [{ op: "add", path: "/-", value: 2 }]), [1, 2]);
+  assert.deepEqual(apply([1], [{ op: "add", path: "/1", value: 2 }]), [1, 2]);
+  assert.deepEqual(apply({ a: 1 }, [{ op: "add", path: "", value: [] }]), []);
+  assert.deepEqual(apply({}, [{ op: "add", path: "/a", value: null }]), { a: null });
+});
+
+test("add: errors", () => {
+  assert.throws(() => apply({}, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.throws(() => apply([1], [{ op: "add", path: "/3", value: 1 }]));
+  assert.throws(() => apply([1], [{ op: "add", path: "/01", value: 1 }]));
+  assert.throws(() => apply([1], [{ op: "add", path: "/x", value: 1 }]));
+  assert.throws(() => apply({}, [{ op: "add", path: "/a" }]));
+  assert.throws(() => apply({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]));
+});
+
+test("remove", () => {
+  assert.deepEqual(apply({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(apply([1, 2, 3], [{ op: "remove", path: "/1" }]), [1, 3]);
+  assert.throws(() => apply({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => apply({}, [{ op: "remove", path: "/__proto__" }]));
+  assert.throws(() => apply([1], [{ op: "remove", path: "/1" }]));
+  assert.throws(() => apply([1], [{ op: "remove", path: "/-" }]));
+  assert.throws(() => apply({}, [{ op: "remove", path: "" }]));
+});
+
+test("replace", () => {
+  assert.deepEqual(apply({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(apply([1, 2], [{ op: "replace", path: "/1", value: 9 }]), [1, 9]);
+  assert.deepEqual(apply({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+  assert.throws(() => apply({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => apply([1], [{ op: "replace", path: "/1", value: 1 }]));
+  assert.throws(() => apply([1], [{ op: "replace", path: "/0" }]));
+});
+
+test("move", () => {
+  assert.deepEqual(apply({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]), {
+    foo: { bar: "baz" },
+    qux: { corge: "grault", thud: "fred" },
+  });
+  assert.deepEqual(apply({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  assert.deepEqual(apply({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.throws(() => apply({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => apply({}, [{ op: "move", from: "/a", path: "/b" }]));
+  assert.throws(() => apply({ a: 1 }, [{ op: "move", path: "/b" }]));
+});
+
+test("copy yields an independent value", () => {
+  const result = apply({ a: { x: 1 } }, [
+    { op: "copy", from: "/a", path: "/b" },
+    { op: "add", path: "/b/y", value: 2 },
+  ]);
+  assert.deepEqual(result, { a: { x: 1 }, b: { x: 1, y: 2 } });
+  assert.throws(() => apply({}, [{ op: "copy", from: "/a", path: "/b" }]));
+});
+
+test("test", () => {
+  const doc = { a: [1, { b: null }], c: 1 };
+  assert.deepEqual(apply(doc, [{ op: "test", path: "/a", value: [1, { b: null }] }]), doc);
+  assert.deepEqual(apply(doc, [{ op: "test", path: "/a/1/b", value: null }]), doc);
+  assert.deepEqual(apply(doc, [{ op: "test", path: "", value: { c: 1, a: [1, { b: null }] } }]), doc);
+  assert.throws(() => apply(doc, [{ op: "test", path: "/c", value: "1" }]));
+  assert.throws(() => apply(doc, [{ op: "test", path: "/a", value: [1] }]));
+  assert.throws(() => apply(doc, [{ op: "test", path: "/missing", value: null }]));
+  assert.throws(() => apply(doc, [{ op: "test", path: "/c", value: 1, extra: 0 }, { op: "test", path: "/c" }]));
+  assert.throws(() => apply({ a: 1 }, [{ op: "test", path: "", value: { a: 1, b: 2 } }]));
+});
+
+test("operations run in order; the patch is all-or-nothing", () => {
+  assert.deepEqual(
+    apply({}, [
+      { op: "add", path: "/a", value: [] },
+      { op: "add", path: "/a/-", value: 1 },
+    ]),
+    { a: [1] },
+  );
+  assert.throws(() => apply({ a: 1 }, [{ op: "remove", path: "/a" }, { op: "remove", path: "/a" }]));
+});
+
+test("does not mutate its inputs or share structure", () => {
+  const doc = { a: [1, 2], o: { k: 1 } };
+  const value = { n: [1] };
+  const patch: JsonPatch = [
+    { op: "add", path: "/v", value },
+    { op: "remove", path: "/a/0" },
+    { op: "replace", path: "/o/k", value: 2 },
+  ];
+  const snapshot = structuredClone({ doc, patch });
+  const result = applyPatch(doc, patch) as { v: unknown };
+  assert.deepEqual({ doc, patch }, snapshot);
+  assert.notEqual(result.v, value);
+  assert.deepEqual(apply(doc, []), doc);
+  assert.notEqual(apply(doc, []), doc);
+});
+
+test("invalid patches", () => {
+  assert.throws(() => apply({}, {}));
+  assert.throws(() => apply({}, null));
+  assert.throws(() => apply({}, [null]));
+  assert.throws(() => apply({}, [[]]));
+  assert.throws(() => apply({}, [{ path: "/a", value: 1 }]));
+  assert.throws(() => apply({}, [{ op: "merge", path: "/a", value: 1 }]));
+  assert.throws(() => apply({}, [{ op: "add", value: 1 }]));
+  assert.throws(() => apply({}, [{ op: "add", path: 1, value: 1 }]));
+  assert.throws(() => apply({}, [{ op: "add", path: "a", value: 1 }]));
+  assert.throws(() => apply({}, [{ op: "add", path: "/a~2", value: 1 }]));
+});
+
+test("keys such as __proto__ are plain own members", () => {
+  const result = apply({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as Record<string, unknown>;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+});
+
+test("escaped tokens", () => {
+  assert.deepEqual(apply({}, [{ op: "add", path: "/a~1b~0c", value: 1 }]), { "a/b~c": 1 });
+});
