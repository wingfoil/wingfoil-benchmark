+---
+id: task-005-add-createpatch-rfc-6902-diff
+type: task
+title: "Add createPatch (RFC 6902 diff)"
+status: pending
+format: 1
+---
+
+Added `createPatch(from, to)` to `src/index.ts`, returning an RFC 6902 patch that turns `from` into `to`.
+
+- Recursive diff: objects member by member, arrays with common prefix/suffix trimmed (see dl-003); differing types or primitives get a `replace` at their own path; identical inputs give `[]`.
+- JSON Pointer tokens are escaped (`~0`, `~1`); inputs are not mutated and values in the patch are deep clones.
+- Tests in `test/create-patch.test.ts` (minimality, escapes, `__proto__`, immutability, seeded randomised round trip through `applyPatch`); all 31 tests pass.
+
diff --git a/src/index.ts b/src/index.ts
index e7f23551dfeb91cc74566d59cc224d8b3f813471..10c5ce0edc95c5ff9a3040d3f29685af68f9da99 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -260,3 +260,76 @@ export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue
   }
   return result;
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, out: JsonPatch): void {
+  let start = 0;
+  while (start < from.length && start < to.length && deepEqual(from[start], to[start])) {
+    start++;
+  }
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && deepEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+  const common = Math.min(fromEnd, toEnd) - start;
+  for (let i = 0; i < common; i++) {
+    diffValues(from[start + i], to[start + i], `${path}/${start + i}`, out);
+  }
+  for (let i = start + common; i < fromEnd; i++) {
+    out.push({ op: "remove", path: `${path}/${start + common}` });
+  }
+  for (let i = start + common; i < toEnd; i++) {
+    out.push({ op: "add", path: `${path}/${i}`, value: deepClone(to[i]) });
+  }
+}
+
+function diffObjects(
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  path: string,
+  out: JsonPatch,
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const child = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) {
+      diffValues(from[key], to[key], child, out);
+    } else {
+      out.push({ op: "add", path: child, value: deepClone(to[key]) });
+    }
+  }
+}
+
+function diffValues(from: JsonValue, to: JsonValue, path: string, out: JsonPatch): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from as { [key: string]: JsonValue }, to as { [key: string]: JsonValue }, path, out);
+  } else if (!deepEqual(from, to)) {
+    out.push({ op: "replace", path, value: deepClone(to) });
+  }
+}
+
+/**
+ * Computes a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * Only what differs is described: objects are compared member by member and arrays element by
+ * element, after skipping their common leading and trailing elements, so that one insertion or
+ * removal in an array does not rewrite the elements after it. Values of different types, or
+ * differing primitives, are replaced at their own path. Identical documents give an empty patch.
+ * The output is deterministic, neither input is mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatch {
+  const patch: JsonPatch = [];
+  diffValues(from, to, "", patch);
+  return patch;
+}
