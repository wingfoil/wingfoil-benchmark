new file mode 100644
index 0000000000000000000000000000000000000000..11dc1be9514312dba0761adf412ade2093e3f651
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,80 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch, type JsonValue } from "../src/index.ts";
+
+function roundTrip(from: JsonValue, to: JsonValue) {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a small change in a large document yields one small operation", () => {
+  assert.deepEqual(roundTrip({ a: { b: 1, c: [1, 2] }, d: "x" }, { a: { b: 2, c: [1, 2] }, d: "x" }), [
+    { op: "replace", path: "/a/b", value: 2 },
+  ]);
+});
+
+test("member addition and removal", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("array insertion, removal and append touch only the changed elements", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([1], [1, 2, 3]).length, 2);
+  assert.deepEqual(roundTrip([1, 2, 3], [1]).length, 2);
+  roundTrip([1, 2, 3, 4, 5], [1, 9, 8, 5]);
+  roundTrip([[1], [2]], [[1, 5], [3]]);
+});
+
+test("root and type changes replace the value", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip(1, null), [{ op: "replace", path: "", value: null }]);
+  assert.deepEqual(roundTrip({ a: [1] }, { a: { b: 1 } }), [{ op: "replace", path: "/a", value: { b: 1 } }]);
+  assert.deepEqual(roundTrip({ a: null }, { a: false }), [{ op: "replace", path: "/a", value: false }]);
+});
+
+test("keys needing escapes and __proto__", () => {
+  roundTrip({ "a/b": 1, "m~n": 2 }, { "a/b": 3, "m~n": 4, "": 5 });
+  assert.equal(createPatch({ "a/b": 1 }, { "a/b": 2 })[0].path, "/a~1b");
+  const to = JSON.parse('{"__proto__": {"x": 1}}');
+  const patch = createPatch({}, to);
+  assert.deepEqual(applyPatch({}, patch), to);
+});
+
+test("inputs are not mutated and the patch shares no structure with them", () => {
+  const from: JsonValue = { a: [1, 2], b: { c: 1 } };
+  const to: JsonValue = { a: [1, 2, { z: 1 }], b: 5, n: { m: [1] } };
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  for (const op of patch) {
+    if (typeof op.value === "object" && op.value !== null) {
+      assert.notEqual(op.value, (to as Record<string, unknown>)[op.path.slice(1)]);
+    }
+  }
+});
+
+test("randomised round trip", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff), seed % n);
+  const gen = (depth: number): JsonValue => {
+    const k = rnd(depth > 2 ? 4 : 6);
+    if (k === 0) return rnd(3);
+    if (k === 1) return "s" + rnd(2);
+    if (k === 2) return null;
+    if (k === 3) return rnd(2) === 0;
+    if (k === 4) return Array.from({ length: rnd(5) }, () => gen(depth + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(depth + 1)]));
+  };
+  for (let i = 0; i < 500; i++) roundTrip(gen(0), gen(0));
+});
