+++ b/src/index.ts
@@ -192,6 +192,9 @@ function applyOperation(document: unknown, operation: Operation): unknown {
       return addAt(document, operation.path, structuredClone(get(document, operation.from)));
     case "move": {
       const value = get(document, operation.from);
+      if (operation.from.length === operation.path.length && operation.from.every((token, i) => token === operation.path[i])) {
+        return document;
+      }
       if (isProperPrefix(operation.from, operation.path)) {
         throw new Error(`JSON Patch: cannot move "${describe(operation.from)}" into one of its own children`);
       }
@@ -222,6 +225,6 @@ export function applyPatch(document: unknown, patch: unknown[]): unknown {
   if (!Array.isArray(patch)) {
     throw new Error("Invalid JSON Patch: must be an array of operations");
   }
-  const operations = patch.map(parseOperation);
+  const operations = Array.from(patch, parseOperation);
   return operations.reduce(applyOperation, structuredClone(document));
 }
