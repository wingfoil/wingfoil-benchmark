diff --git a/src/index.ts b/src/index.ts
index c9c776ecc458c27e93253f7432b2493d7d1eeb26..ecfd2022c4b814f87b199f5e6e44ee78d91db66e 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -267,3 +267,72 @@ function mergePatch(target: unknown, patch: unknown): unknown {
 export function applyMergePatch(target: unknown, patch: unknown): unknown {
   return mergePatch(target, patch);
 }
+
+type PatchOperation = { op: "add" | "replace"; path: string; value: unknown } | { op: "remove"; path: string };
+
+function diffArrays(from: unknown[], to: unknown[], tokens: string[], out: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+    start++;
+  }
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && jsonEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+  const common = Math.min(fromEnd, toEnd) - start;
+  for (let i = 0; i < common; i++) {
+    diffValues(from[start + i], to[start + i], [...tokens, String(start + i)], out);
+  }
+  for (let i = fromEnd - 1; i >= start + common; i--) {
+    out.push({ op: "remove", path: describe([...tokens, String(i)]) });
+  }
+  for (let i = start + common; i < toEnd; i++) {
+    out.push({ op: "add", path: describe([...tokens, String(i)]), value: structuredClone(to[i]) });
+  }
+}
+
+function diffObjects(from: Record<string, unknown>, to: Record<string, unknown>, tokens: string[], out: PatchOperation[]): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      out.push({ op: "remove", path: describe([...tokens, key]) });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (Object.hasOwn(from, key)) {
+      diffValues(from[key], to[key], [...tokens, key], out);
+    } else {
+      out.push({ op: "add", path: describe([...tokens, key]), value: structuredClone(to[key]) });
+    }
+  }
+}
+
+function diffValues(from: unknown, to: unknown, tokens: string[], out: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, tokens, out);
+  } else if (isPlainObject(from) && isPlainObject(to)) {
+    diffObjects(from, to, tokens, out);
+  } else if (!jsonEqual(from, to)) {
+    out.push({ op: "replace", path: describe(tokens), value: structuredClone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when passed to `applyPatch`.
+ *
+ * The patch is minimal in granularity: it descends into objects and arrays and only touches what
+ * differs, so equal documents give an empty patch. Object members are compared by key (order is
+ * irrelevant); arrays are compared positionally after trimming their common head and tail. Operations
+ * are emitted in a deterministic order: removals before additions inside an object, and array
+ * removals from the highest index down. Neither argument is mutated, and the patch shares no
+ * structure with them.
+ *
+ * @param from - A parsed JSON value.
+ * @param to - A parsed JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diffValues(from, to, [], out);
+  return out;
+}
