index 0000000000000000000000000000000000000000..4139802a611e1d8f9eabda47586248fd95308400
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,58 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown): unknown[] {
+  const before = structuredClone(from);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, before);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a small change yields a single operation", () => {
+  const from = { a: { b: [1, 2, 3], c: "x" }, d: true };
+  const to = { a: { b: [1, 2, 3], c: "y" }, d: true };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/c", value: "y" }]);
+});
+
+test("object members added and removed", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, c: 3 }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("array changes are local", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 4]), [{ op: "remove", path: "/2" }]);
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4, 5], [1, 9, 5]), [
+    { op: "replace", path: "/1", value: 9 },
+    { op: "remove", path: "/3" },
+    { op: "remove", path: "/2" },
+  ]);
+});
+
+test("type changes, root replacement and null", () => {
+  roundTrip({ a: [1] }, { a: { 0: 1 } });
+  roundTrip({ a: null }, { a: 1 });
+  assert.deepEqual(roundTrip(1, [2]), [{ op: "replace", path: "", value: [2] }]);
+  roundTrip(null, {});
+});
+
+test("keys needing escapes and __proto__", () => {
+  const to = JSON.parse('{"a/b":1,"~":2,"__proto__":{"x":1}}');
+  assert.deepEqual(roundTrip({}, to), roundTrip({}, to));
+  roundTrip(JSON.parse('{"a/b":0,"~":0}'), to);
+});
+
+test("the patch shares no structure with the inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to) as { value: { b: number } }[];
+  patch[0].value.b = 2;
+  assert.equal(to.a.b, 1);
+});
