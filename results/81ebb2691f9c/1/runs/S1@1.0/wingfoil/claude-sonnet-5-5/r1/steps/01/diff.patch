@@ -0,0 +1,48 @@
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Decodes one reference token: `~1` becomes `/`, then `~0` becomes `~` (RFC 6901 section 4). */
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in token "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function step(current: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(current)) {
+    if (ARRAY_INDEX.test(token) && Number(token) < current.length) {
+      return current[Number(token)];
+    }
+  } else if (
+    typeof current === "object" &&
+    current !== null &&
+    Object.hasOwn(current, token)
+  ) {
+    return (current as Record<string, unknown>)[token];
+  }
+  throw new Error(`JSON Pointer "${pointer}" does not resolve: no value at "${token}"`);
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer `pointer` refers to (RFC 6901).
+ *
+ * The empty pointer refers to the whole document. Only own properties of objects and existing
+ * array elements resolve; the `-` array token never does, since it refers to a nonexistent element.
+ *
+ * @param document - A parsed JSON value.
+ * @param pointer - A JSON Pointer string, in its string (not URI fragment) representation.
+ * @throws Error if `pointer` is not a valid JSON Pointer, or does not resolve to a value of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: must be a string");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  const tokens = pointer.slice(1).split("/").map(unescapeToken);
+  return tokens.reduce<unknown>((current, token) => step(current, token, pointer), document);
+}
