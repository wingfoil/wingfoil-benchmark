@@ -0,0 +1,83 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// RFC 6901 section 5 example document.
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("unescapes ~01 as ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("resolves null and falsy values", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer([false], "/0"), false);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("nested paths", () => {
+  assert.equal(resolvePointer({ a: [{ b: [10, 20] }] }, "/a/0/b/1"), 20);
+});
+
+test("rejects invalid pointers", () => {
+  for (const p of ["foo", "a/b", "/a~", "/a~2", "/a~b", "#/a"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), p);
+  }
+  assert.throws(() => resolvePointer({}, undefined as unknown as string));
+  assert.throws(() => resolvePointer({}, 1 as unknown as string));
+});
+
+test("throws when the pointer does not resolve", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer("str", "/0"));
+  assert.throws(() => resolvePointer("str", "/length"));
+});
+
+test("array indices are strict", () => {
+  const arr = ["a", "b"];
+  assert.throws(() => resolvePointer(arr, "/2"));
+  assert.throws(() => resolvePointer(arr, "/-"));
+  assert.throws(() => resolvePointer(arr, "/01"));
+  assert.throws(() => resolvePointer(arr, "/+1"));
+  assert.throws(() => resolvePointer(arr, "/-1"));
+  assert.throws(() => resolvePointer(arr, "/1.0"));
+  assert.throws(() => resolvePointer(arr, "/length"));
+  assert.throws(() => resolvePointer(arr, "/"));
+  assert.equal(resolvePointer(arr, "/0"), "a");
+});
+
+test("only own properties resolve", () => {
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer({}, "/constructor"));
+  assert.throws(() => resolvePointer({}, "/toString"));
+  const parsed = JSON.parse('{"__proto__": 1}');
+  assert.equal(resolvePointer(parsed, "/__proto__"), 1);
+});
