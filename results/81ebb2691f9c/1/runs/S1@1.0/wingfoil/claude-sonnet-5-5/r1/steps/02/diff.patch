@@ -0,0 +1,251 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+// RFC 6902 appendix A examples.
+test("A.1 adding an object member", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), {
+    foo: "bar",
+    baz: "qux",
+  });
+});
+
+test("A.2 adding an array element", () => {
+  assert.deepEqual(
+    applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]),
+    { foo: ["bar", "qux", "baz"] },
+  );
+});
+
+test("A.3 removing an object member", () => {
+  assert.deepEqual(
+    applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]),
+    { foo: "bar" },
+  );
+});
+
+test("A.4 removing an array element", () => {
+  assert.deepEqual(
+    applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]),
+    { foo: ["bar", "baz"] },
+  );
+});
+
+test("A.5 replacing a value", () => {
+  assert.deepEqual(
+    applyPatch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]),
+    { baz: "boo", foo: "bar" },
+  );
+});
+
+test("A.6 moving a value", () => {
+  assert.deepEqual(
+    applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [
+      { op: "move", from: "/foo/waldo", path: "/qux/thud" },
+    ]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+});
+
+test("A.7 moving an array element", () => {
+  assert.deepEqual(
+    applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [
+      { op: "move", from: "/foo/1", path: "/foo/3" },
+    ]),
+    { foo: ["all", "cows", "eat", "grass"] },
+  );
+});
+
+test("A.8 / A.9 testing a value", () => {
+  const doc = { baz: "qux", foo: ["a", 2, "c"] };
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/baz", value: "qux" }]), doc);
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/foo/1", value: 2 }]), doc);
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/baz", value: "bar" }]));
+});
+
+test("A.10 adding a nested member object", () => {
+  assert.deepEqual(
+    applyPatch({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]),
+    { foo: "bar", child: { grandchild: {} } },
+  );
+});
+
+test("A.11 ignoring unrecognized elements", () => {
+  assert.deepEqual(
+    applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }]),
+    { foo: "bar", baz: "qux" },
+  );
+});
+
+test("A.12 adding to a nonexistent target", () => {
+  assert.throws(() =>
+    applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]),
+  );
+});
+
+test("A.14 ~ escape ordering", () => {
+  assert.deepEqual(
+    applyPatch({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }]),
+    { "/": 9, "~1": 10 },
+  );
+});
+
+test("A.15 / A.16 comparing strings to numbers, adding an array value", () => {
+  assert.throws(() => applyPatch({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]));
+  assert.deepEqual(
+    applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]),
+    { foo: ["bar", ["abc", "def"]] },
+  );
+});
+
+test("copy duplicates the value rather than aliasing it", () => {
+  const result = applyPatch({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }]) as {
+    a: object;
+    b: object;
+  };
+  assert.deepEqual(result, { a: { x: 1 }, b: { x: 1 } });
+  assert.notEqual(result.a, result.b);
+});
+
+test("operations apply in order, each on the previous result", () => {
+  assert.deepEqual(
+    applyPatch({}, [
+      { op: "add", path: "/a", value: 1 },
+      { op: "copy", from: "/a", path: "/b" },
+      { op: "replace", path: "/a", value: 2 },
+      { op: "remove", path: "/b" },
+    ]),
+    { a: 2 },
+  );
+});
+
+test("empty path targets the whole document", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: null }]), null);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "" }]), 1);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]));
+});
+
+test("empty patch returns an equal document", () => {
+  assert.deepEqual(applyPatch({ a: [1] }, []), { a: [1] });
+});
+
+test("does not mutate the document or the patch, and shares no structure with them", () => {
+  const doc = { a: { b: [1, 2] }, c: 1 };
+  const patch = [
+    { op: "add", path: "/d", value: { e: [1] } },
+    { op: "move", from: "/a/b", path: "/f" },
+    { op: "remove", path: "/c" },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const result = applyPatch(doc, patch) as Record<string, any>;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  result.d.e.push(2);
+  result.a.x = 1;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+});
+
+test("a failing operation throws and leaves the input untouched", () => {
+  const doc = { a: 1 };
+  assert.throws(() =>
+    applyPatch(doc, [
+      { op: "add", path: "/b", value: 2 },
+      { op: "remove", path: "/missing" },
+    ]),
+  );
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("add: index bounds, strict indices and '-'", () => {
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/1", value: 2 }]), [1, 2]);
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/0", value: 0 }]), [0, 1]);
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/2", value: 2 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/01", value: 2 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/-1", value: 2 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/x", value: 2 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/-/a", value: 2 }]));
+});
+
+test("add replaces an existing object member", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+});
+
+test("add under a primitive parent throws", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 2 }]));
+  assert.throws(() => applyPatch({ a: null }, [{ op: "add", path: "/a/b", value: 2 }]));
+});
+
+test("remove and replace require an existing target", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "/b" }]));
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/1" }]));
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/-" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "replace", path: "/b", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/1", value: 1 }]));
+  assert.deepEqual(applyPatch([1, 2], [{ op: "replace", path: "/1", value: 3 }]), [1, 3]);
+});
+
+test("move: missing source, into own child, onto itself", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "/b", path: "/c" }]));
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "/b", path: "/b" }]));
+});
+
+test("copy: missing source", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", from: "/b", path: "/c" }]));
+});
+
+test("test: deep equality ignores key order, respects types and array order", () => {
+  const doc = { a: { x: 1, y: [1, { z: null }] } };
+  applyPatch(doc, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }]);
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/y", value: [{ z: null }, 1] }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/x", value: true }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a", value: { x: 1 } }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/y/1", value: [] }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/missing", value: null }]));
+  applyPatch({ a: null }, [{ op: "test", path: "/a", value: null }]);
+  assert.throws(() => applyPatch({ a: null }, [{ op: "test", path: "/a", value: {} }]));
+});
+
+test("invalid patches throw", () => {
+  const bad: unknown[] = [
+    null,
+    {},
+    "add",
+    [null],
+    [[]],
+    [{}],
+    [{ op: "add", value: 1 }],
+    [{ op: "add", path: 1, value: 1 }],
+    [{ op: "add", path: "/a" }],
+    [{ op: "replace", path: "/a" }],
+    [{ op: "test", path: "/a" }],
+    [{ op: "move", path: "/a" }],
+    [{ op: "copy", path: "/a" }],
+    [{ op: "move", from: 1, path: "/a" }],
+    [{ op: "frobnicate", path: "/a" }],
+    [{ op: "ADD", path: "/a", value: 1 }],
+    [{ op: "add", path: "a", value: 1 }],
+    [{ op: "add", path: "/~2", value: 1 }],
+    [{ op: "copy", from: "a", path: "/a" }],
+  ];
+  for (const patch of bad) {
+    assert.throws(() => applyPatch({ a: 1 }, patch as never), undefined, JSON.stringify(patch));
+  }
+});
+
+test("a missing 'value' is invalid, but an explicit null is a value", () => {
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a", value: null }]), { a: null });
+});
+
+test("prototype-polluting keys are plain data", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]);
+  assert.equal(Object.hasOwn(result as object, "__proto__"), true);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/__proto__" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/constructor/x", value: 1 }]));
+});
