+function applyOperation(document: unknown, operation: Operation): unknown {
+  switch (operation.op) {
+    case "add":
+      return addAt(document, operation.path, structuredClone(operation.value));
+    case "remove":
+      return removeAt(document, operation.path);
+    case "replace":
+      return replaceAt(document, operation.path, structuredClone(operation.value));
+    case "copy":
+      return addAt(document, operation.path, structuredClone(get(document, operation.from)));
+    case "move": {
+      const value = get(document, operation.from);
+      if (isProperPrefix(operation.from, operation.path)) {
+        throw new Error(`JSON Patch: cannot move "${describe(operation.from)}" into one of its own children`);
+      }
+      return addAt(removeAt(document, operation.from), operation.path, value);
+    }
+    case "test":
+      if (!jsonEqual(get(document, operation.path), operation.value)) {
+        throw new Error(`JSON Patch: test failed at "${describe(operation.path)}"`);
+      }
+      return document;
+  }
+}
+
+/**
+ * Applies the JSON Patch `patch` (RFC 6902) to `document` and returns the resulting document.
+ *
+ * Neither argument is mutated, and the result shares no structure with them. Operations run in order;
+ * if one fails the whole patch fails, so there is never a partial result. Paths follow `resolvePointer`
+ * (own properties only, strict array indices), with `-` additionally naming the end of an array for
+ * `add`. Removing the whole document is rejected, as is moving a value into its own child. A `test`
+ * compares by JSON value: object member order is ignored, array order is not.
+ *
+ * @param document - A parsed JSON value.
+ * @param patch - An array of RFC 6902 operations.
+ * @throws Error if `patch` is invalid, or if an operation fails (including a failed `test`).
+ */
+export function applyPatch(document: unknown, patch: unknown[]): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: must be an array of operations");
+  }
+  const operations = patch.map(parseOperation);
+  return operations.reduce(applyOperation, structuredClone(document));
+}
