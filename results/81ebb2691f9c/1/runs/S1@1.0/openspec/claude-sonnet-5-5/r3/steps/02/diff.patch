+++ b/src/patch.ts
@@ -0,0 +1,174 @@
+import { parsePointer } from "./pointer.ts";
+
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Json = unknown;
+type Container = Record<string, Json> | Json[];
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const OPS = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+
+function isObject(value: unknown): value is Record<string, Json> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function has(object: object, key: string): boolean {
+  return Object.hasOwn(object, key);
+}
+
+function clone<T>(value: T): T {
+  return structuredClone(value);
+}
+
+function setMember(object: Record<string, Json>, key: string, value: Json): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function equal(a: Json, b: Json): boolean {
+  if (a === b) return true;
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => equal(v, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((k) => has(b, k) && equal(a[k], b[k]));
+  }
+  return false;
+}
+
+/** Returns the parent container of the target and the final token. */
+function locateParent(root: Json, tokens: string[], pointerText: string): [Container, string] {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new JsonPatchError(`Path "${pointerText}" does not exist`);
+      }
+      current = current[Number(token)];
+    } else if (isObject(current) && has(current, token)) {
+      current = current[token];
+    } else {
+      throw new JsonPatchError(`Path "${pointerText}" does not exist`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new JsonPatchError(`Path "${pointerText}" does not exist`);
+  }
+  return [current, tokens[tokens.length - 1]];
+}
+
+function getAt(root: Json, tokens: string[], pointerText: string): Json {
+  if (tokens.length === 0) return root;
+  const [parent, last] = locateParent(root, tokens, pointerText);
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(last) || Number(last) >= parent.length) {
+      throw new JsonPatchError(`Path "${pointerText}" does not exist`);
+    }
+    return parent[Number(last)];
+  }
+  if (!has(parent, last)) throw new JsonPatchError(`Path "${pointerText}" does not exist`);
+  return parent[last];
+}
+
+function addAt(root: Json, tokens: string[], value: Json, pointerText: string): Json {
+  if (tokens.length === 0) return value;
+  const [parent, last] = locateParent(root, tokens, pointerText);
+  if (Array.isArray(parent)) {
+    if (last === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(last) && Number(last) <= parent.length) {
+      parent.splice(Number(last), 0, value);
+    } else {
+      throw new JsonPatchError(`Path "${pointerText}" is not a valid array position`);
+    }
+  } else {
+    setMember(parent, last, value);
+  }
+  return root;
+}
+
+function removeAt(root: Json, tokens: string[], pointerText: string): Json {
+  if (tokens.length === 0) throw new JsonPatchError("Cannot remove the whole document");
+  getAt(root, tokens, pointerText); // must exist
+  const [parent, last] = locateParent(root, tokens, pointerText);
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete parent[last];
+  return root;
+}
+
+function pointerOf(op: Record<string, Json>, member: "path" | "from", index: number): string[] {
+  const text = op[member];
+  if (typeof text !== "string") {
+    throw new JsonPatchError(`Operation ${index}: "${member}" must be a string`);
+  }
+  return parsePointer(text);
+}
+
+/**
+ * Applies the RFC 6902 JSON Patch `patch` to `document` and returns the result as a new value.
+ * Neither argument is mutated. Throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchError("A JSON Patch must be an array");
+
+  let result: Json = clone(document);
+  patch.forEach((op: unknown, index: number) => {
+    if (!isObject(op)) throw new JsonPatchError(`Operation ${index} must be an object`);
+    if (typeof op.op !== "string" || !OPS.has(op.op)) {
+      throw new JsonPatchError(`Operation ${index}: unknown or missing "op"`);
+    }
+    const path = pointerOf(op, "path", index);
+    const pathText = op.path as string;
+    const needsValue = op.op === "add" || op.op === "replace" || op.op === "test";
+    if (needsValue && !has(op, "value")) {
+      throw new JsonPatchError(`Operation ${index}: "${op.op}" requires "value"`);
+    }
+    const from = op.op === "move" || op.op === "copy" ? pointerOf(op, "from", index) : [];
+    const fromText = op.from as string;
+
+    switch (op.op) {
+      case "add":
+        result = addAt(result, path, clone(op.value), pathText);
+        break;
+      case "remove":
+        result = removeAt(result, path, pathText);
+        break;
+      case "replace":
+        getAt(result, path, pathText);
+        result = path.length === 0 ? clone(op.value) : addReplace(result, path, clone(op.value), pathText);
+        break;
+      case "move": {
+        if (from.length < path.length && from.every((t, i) => t === path[i])) {
+          throw new JsonPatchError(`Operation ${index}: cannot move "${fromText}" into its own child`);
+        }
+        const value = getAt(result, from, fromText);
+        if (from.length === path.length && from.every((t, i) => t === path[i])) break;
+        result = removeAt(result, from, fromText);
+        result = addAt(result, path, value, pathText);
+        break;
+      }
+      case "copy":
+        result = addAt(result, path, clone(getAt(result, from, fromText)), pathText);
+        break;
+      case "test":
+        if (!equal(getAt(result, path, pathText), op.value)) {
+          throw new JsonPatchError(`Operation ${index}: test failed at "${pathText}"`);
+        }
+        break;
+    }
+  });
+  return result;
+}
+
+function addReplace(root: Json, tokens: string[], value: Json, pointerText: string): Json {
+  const [parent, last] = locateParent(root, tokens, pointerText);
+  if (Array.isArray(parent)) parent[Number(last)] = value;
+  else setMember(parent, last, value);
+  return root;
+}
diff --git a/src/pointer.ts b/src/pointer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..315f6c3d086e2a8e398cb99878fa16e3d9a171d6
--- /dev/null
+++ b/src/pointer.ts
@@ -0,0 +1,47 @@
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function decodeToken(token: string, pointer: string): string {
+  return token.replace(/~(.?)/g, (_, next: string) => {
+    if (next === "0") return "~";
+    if (next === "1") return "/";
+    throw new JsonPointerError(`Invalid JSON Pointer "${pointer}": bad escape sequence in "${token}"`);
+  });
+}
+
+/** Parses an RFC 6901 JSON Pointer into its decoded reference tokens. */
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  return pointer.slice(1).split("/").map((t) => decodeToken(t, pointer));
+}
+
+/** Returns the value of `document` that the RFC 6901 JSON Pointer `pointer` refers to. */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  let current: unknown = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new JsonPointerError(`Pointer "${pointer}" does not resolve: no array element "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null && Object.hasOwn(current, token)) {
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Pointer "${pointer}" does not resolve: no value for "${token}"`);
+    }
+  }
+  return current;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2280ad8f78425a8d5f0dafbcce538345f1a5abd4
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,88 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const p = (doc: unknown, ...ops: object[]) => applyPatch(doc, ops);
+
+test("RFC 6902 appendix A", () => {
+  assert.deepEqual(p({ foo: "bar" }, { op: "add", path: "/baz", value: "qux" }), { foo: "bar", baz: "qux" });
+  assert.deepEqual(p({ foo: ["bar", "baz"] }, { op: "add", path: "/foo/1", value: "qux" }), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(p({ baz: "qux", foo: "bar" }, { op: "remove", path: "/baz" }), { foo: "bar" });
+  assert.deepEqual(p({ foo: ["bar", "qux", "baz"] }, { op: "remove", path: "/foo/1" }), { foo: ["bar", "baz"] });
+  assert.deepEqual(p({ baz: "qux", foo: "bar" }, { op: "replace", path: "/baz", value: "boo" }), { baz: "boo", foo: "bar" });
+  assert.deepEqual(
+    p({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, { op: "move", from: "/foo/waldo", path: "/qux/thud" }),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(p({ foo: ["all", "grass", "cows", "eat"] }, { op: "move", from: "/foo/1", path: "/foo/3" }), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  assert.deepEqual(p({ foo: { bar: "baz" } }, { op: "copy", from: "/foo/bar", path: "/foo/qux" }), { foo: { bar: "baz", qux: "baz" } });
+  assert.deepEqual(p({ baz: "qux" }, { op: "test", path: "/baz", value: "qux" }), { baz: "qux" });
+  assert.deepEqual(p({ foo: ["a"] }, { op: "add", path: "/foo/-", value: "b" }), { foo: ["a", "b"] });
+});
+
+test("does not mutate or share structure", () => {
+  const doc = { a: { x: 1 }, l: [1] };
+  const value = { y: 1 };
+  const patch = [
+    { op: "add", path: "/v", value },
+    { op: "copy", from: "/a", path: "/b" },
+    { op: "add", path: "/b/z", value: 2 },
+  ];
+  const snapshot = structuredClone({ doc, patch });
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual({ doc, patch }, snapshot);
+  assert.notEqual(out.v, value);
+  assert.deepEqual(out.a, { x: 1 });
+  assert.deepEqual(out.b, { x: 1, z: 2 });
+});
+
+test("whole document, null values", () => {
+  assert.deepEqual(p({ a: 1 }, { op: "add", path: "", value: [1] }), [1]);
+  assert.deepEqual(p({ a: 1 }, { op: "replace", path: "", value: null }), null);
+  assert.deepEqual(p({}, { op: "add", path: "/a", value: null }), { a: null });
+  assert.deepEqual(applyPatch({ a: 1 }, []), { a: 1 });
+});
+
+test("errors", () => {
+  const bad: [unknown, unknown][] = [
+    [{}, {}],
+    [{}, [null]],
+    [{}, [{ op: "frob", path: "" }]],
+    [{}, [{ path: "" }]],
+    [{}, [{ op: "add", path: "/a" }]],
+    [{}, [{ op: "move", path: "/a" }]],
+    [{}, [{ op: "add", value: 1 }]],
+    [{}, [{ op: "add", path: "a", value: 1 }]],
+    [{}, [{ op: "add", path: "/a~2", value: 1 }]],
+    [{}, [{ op: "add", path: "/a/b", value: 1 }]],
+    [[1], [{ op: "add", path: "/2", value: 1 }]],
+    [[1], [{ op: "add", path: "/-1", value: 1 }]],
+    [[1, 2], [{ op: "add", path: "/01", value: 1 }]],
+    [{}, [{ op: "remove", path: "/a" }]],
+    [[1], [{ op: "remove", path: "/-" }]],
+    [{}, [{ op: "remove", path: "" }]],
+    [{}, [{ op: "replace", path: "/a", value: 1 }]],
+    [{ a: 1 }, [{ op: "move", from: "/b", path: "/c" }]],
+    [{ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]],
+    [{}, [{ op: "copy", from: "/b", path: "/c" }]],
+    [{ a: 1 }, [{ op: "test", path: "/a", value: "1" }]],
+    [{ a: 1 }, [{ op: "test", path: "/b", value: 1 }]],
+    [{ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]],
+  ];
+  for (const [doc, patch] of bad) assert.throws(() => applyPatch(doc, patch), undefined, JSON.stringify(patch));
+});
+
+test("test op uses JSON equality", () => {
+  assert.doesNotThrow(() => p({ a: { b: [1, { c: null }], d: 0 } }, { op: "test", path: "/a", value: { d: 0, b: [1, { c: null }] } }));
+  assert.throws(() => p({ a: null }, { op: "test", path: "/a", value: {} }));
+});
+
+test("move onto itself and __proto__ keys", () => {
+  assert.deepEqual(p({ a: 1 }, { op: "move", from: "/a", path: "/a" }), { a: 1 });
+  const out = p({}, { op: "add", path: "/__proto__", value: { polluted: true } }) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.hasOwn(out, "__proto__"), true);
+  assert.deepEqual(p({ "a/b": 1, "m~n": 2 }, { op: "test", path: "/a~1b", value: 1 }, { op: "test", path: "/m~0n", value: 2 }), { "a/b": 1, "m~n": 2 });
+});
