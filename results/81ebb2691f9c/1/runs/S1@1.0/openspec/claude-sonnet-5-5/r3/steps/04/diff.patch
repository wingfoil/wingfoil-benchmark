@@ -0,0 +1,43 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, r] of cases) assert.deepEqual(applyMergePatch(t, p), r);
+});
+
+test("does not mutate or share structure", () => {
+  const target = { a: { b: [1] }, c: 1 };
+  const patch = { a: { d: { e: 1 } } };
+  const t0 = structuredClone(target);
+  const p0 = structuredClone(patch);
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, t0);
+  assert.deepEqual(patch, p0);
+  assert.notEqual(result.a.b, target.a.b);
+  assert.notEqual(result.a.d, patch.a.d);
+});
+
+test("__proto__ is plain data", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as any;
+  assert.ok(Object.hasOwn(result, "__proto__"));
+  assert.equal(({} as any).x, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
