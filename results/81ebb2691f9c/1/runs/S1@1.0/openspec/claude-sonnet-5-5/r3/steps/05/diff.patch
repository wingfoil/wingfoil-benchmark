index 0000000000000000000000000000000000000000..db54f0aabb59bb953038c77751bc879ee3a3fc9b
--- /dev/null
+++ b/src/diff.ts
@@ -0,0 +1,58 @@
+import { equal } from "./patch.ts";
+
+type Json = unknown;
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: Json };
+
+function isObject(value: unknown): value is Record<string, Json> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diff(from: Json, to: Json, path: string, ops: Operation[]): void {
+  if (equal(from, to)) return;
+
+  if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (!Object.hasOwn(from, key)) ops.push({ op: "add", path: child, value: structuredClone(to[key]) });
+      else diff(from[key], to[key], child, ops);
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    const max = Math.min(from.length, to.length);
+    let start = 0;
+    while (start < max && equal(from[start], to[start])) start++;
+    let end = 0;
+    while (end < max - start && equal(from[from.length - 1 - end], to[to.length - 1 - end])) end++;
+
+    const fromEnd = from.length - end;
+    const toEnd = to.length - end;
+    const common = Math.min(fromEnd, toEnd) - start;
+    for (let i = start; i < start + common; i++) diff(from[i], to[i], `${path}/${i}`, ops);
+    for (let i = start + common; i < fromEnd; i++) ops.push({ op: "remove", path: `${path}/${start + common}` });
+    for (let i = start + common; i < toEnd; i++) {
+      ops.push({ op: "add", path: `${path}/${i}`, value: structuredClone(to[i]) });
+    }
+    return;
+  }
+
+  ops.push({ op: "replace", path, value: structuredClone(to) });
+}
+
+/**
+ * Returns an RFC 6902 JSON Patch that turns `from` into `to` when applied. The patch only describes
+ * the parts that differ. Neither argument is mutated, and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const ops: Operation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
