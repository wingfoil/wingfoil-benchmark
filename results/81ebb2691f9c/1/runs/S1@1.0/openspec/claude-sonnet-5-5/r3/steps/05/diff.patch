index 0000000000000000000000000000000000000000..ffbf05507edba0256ed6385c721869635bd08acd
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,67 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown) {
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: [1, 2] }, { b: [1, 2], a: 1 }), []);
+});
+
+test("one nested change is a single replace", () => {
+  const from = { a: { b: { c: 1, d: [1, 2, 3] } }, e: "x" };
+  const to = { a: { b: { c: 1, d: [1, 9, 3] } }, e: "x" };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/d/1", value: 9 }]);
+});
+
+test("added and removed members", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, c: 3 }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("array tail and middle changes", () => {
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3, 4]), [
+    { op: "add", path: "/2", value: 3 },
+    { op: "add", path: "/3", value: 4 },
+  ]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2]), [
+    { op: "remove", path: "/2" },
+    { op: "remove", path: "/2" },
+  ]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 9, 3, 4], [1, 2, 3, 4]), [{ op: "remove", path: "/2" }]);
+  roundTrip([1, 1, 1], [1, 1]);
+  roundTrip([1, 1], [1, 1, 1]);
+  roundTrip([[1], [2, 3]], [[1, 5], [4], [2, 3]]);
+});
+
+test("type changes and root changes", () => {
+  assert.deepEqual(roundTrip({ a: null }, { a: {} }), [{ op: "replace", path: "/a", value: {} }]);
+  assert.deepEqual(roundTrip({ a: {} }, { a: [] }), [{ op: "replace", path: "/a", value: [] }]);
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip(1, "1"), [{ op: "replace", path: "", value: "1" }]);
+  roundTrip(null, { a: 1 });
+});
+
+test("special keys are escaped", () => {
+  const to = JSON.parse('{"a/b":1,"m~n":2,"":3,"__proto__":{"x":1},"-":4,"0":5}');
+  const patch = roundTrip({}, to);
+  assert.deepEqual(patch.map((o) => o.path), ["/0", "/a~1b", "/m~0n", "/", "/__proto__", "/-"]);
+  roundTrip(to, JSON.parse('{"__proto__":{"x":2},"a/b":2}'));
+});
+
+test("patch shares no structure with the inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  assert.notEqual(patch[0].value, to.a);
+});
