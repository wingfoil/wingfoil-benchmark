index 0000000000000000000000000000000000000000..55fe6030777e406c569628bd2d6065e9e49d7af5
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,70 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("falsy and null values resolve", () => {
+  const doc = { a: null, b: 0, c: false, d: "" };
+  for (const [p, v] of [["/a", null], ["/b", 0], ["/c", false], ["/d", ""]] as const) {
+    assert.equal(resolvePointer(doc, p), v);
+  }
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("decoding order", () => {
+  assert.equal(resolvePointer({ "~1": 7 }, "/~01"), 7);
+});
+
+test("invalid escapes and syntax throw", () => {
+  for (const p of ["/a~2", "/a~", "foo", "#/foo", " "]) {
+    assert.throws(() => resolvePointer({ a: 1, foo: 1 }, p), p);
+  }
+  assert.throws(() => resolvePointer({}, undefined as unknown as string));
+});
+
+test("missing members and inherited names throw", () => {
+  assert.throws(() => resolvePointer({ foo: 1 }, "/missing"));
+  for (const p of ["/toString", "/__proto__", "/constructor"]) {
+    assert.throws(() => resolvePointer({}, p), p);
+  }
+});
+
+test("bad array indexes throw", () => {
+  for (const p of ["/01", "/-1", "/1.0", "/-", "/2", "/length", "/"]) {
+    assert.throws(() => resolvePointer(["a", "b"], p), p);
+  }
+  assert.equal(resolvePointer(["a", "b"], "/0"), "a");
+});
+
+test("traversing primitives throws", () => {
+  assert.throws(() => resolvePointer({ a: "text" }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: "text" }, "/a/0"));
+});
