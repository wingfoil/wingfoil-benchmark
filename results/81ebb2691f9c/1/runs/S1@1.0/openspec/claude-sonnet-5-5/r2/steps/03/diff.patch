diff --git a/src/index.ts b/src/index.ts
index d941fc466914e3e1edf801ddd51c8208d6db8ca1..643d36900115b50cbd47d62d7713d229a9543f7f 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -144,6 +144,20 @@ function addAt(doc: unknown, path: string, value: unknown): unknown {
   return doc;
 }
 
+function replaceAt(doc: unknown, path: string, value: unknown): unknown {
+  getAt(doc, path);
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(doc, tokens, path);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent[arrayIndex(last, parent.length, false, path)] = value;
+  } else {
+    setMember(parent, last, value);
+  }
+  return doc;
+}
+
 function removeAt(doc: unknown, path: string): unknown {
   const tokens = parsePointer(path);
   if (tokens.length === 0) return null;
@@ -189,8 +203,7 @@ export function applyPatch(document: unknown, patch: unknown): any {
