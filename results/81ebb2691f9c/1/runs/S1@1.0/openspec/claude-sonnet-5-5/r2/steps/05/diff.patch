index 0000000000000000000000000000000000000000..2acb6572b6cc08a1c5edfb384f377a8d2ffc1791
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,53 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown) {
+  const f = structuredClone(from);
+  const t = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, f);
+  assert.deepEqual(to, t);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small nested change is a single op", () => {
+  const patch = roundTrip({ a: { b: { c: 1, d: 2 } }, e: [1, 2, 3] }, { a: { b: { c: 9, d: 2 } }, e: [1, 2, 3] });
+  assert.deepEqual(patch, [{ op: "replace", path: "/a/b/c", value: 9 }]);
+});
+
+test("array insertion and removal in the middle", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 9, 3, 4], [1, 2, 3, 4]), [{ op: "remove", path: "/2" }]);
+});
+
+test("array growth, shrink and multiple removals", () => {
+  roundTrip([1, 2, 3, 4, 5], [1]);
+  roundTrip([1], [1, 2, 3]);
+  roundTrip([1, 2, 3, 4, 5, 6], [1, 7, 6]);
+  roundTrip([[1], [2]], [[1, 5], [3]]);
+});
+
+test("member names are escaped", () => {
+  assert.deepEqual(roundTrip({ "a/b~c": 1 }, { "a/b~c": 2 }), [{ op: "replace", path: "/a~1b~0c", value: 2 }]);
+});
+
+test("type changes, root changes, null and added/removed members", () => {
+  assert.deepEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  roundTrip({ a: 1 }, [1]);
+  roundTrip({ a: null }, { a: { b: [] } });
+  roundTrip({ a: 1, b: 2 }, { b: 2, c: 3 });
+  roundTrip({}, { "": 1, __proto__x: 2 });
+});
+
+test("patch shares no structure with inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0].value as any).b = 2;
+  assert.equal(to.a.b, 1);
+});
