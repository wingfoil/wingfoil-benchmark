index 256608b4a3c488b3c71788a7b341f29dec187bfc..28973a5ca127ac5512e5cc0f38945b7a87d2ba3b 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -276,3 +276,56 @@ export function applyMergePatch(target: unknown, patch: unknown): any {
   }
   return result;
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+type PatchOp = { op: "add" | "remove" | "replace"; path: string; value?: JsonValue };
+
+function diffInto(ops: PatchOp[], from: unknown, to: unknown, path: string): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    let start = 0;
+    while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+    let endFrom = from.length;
+    let endTo = to.length;
+    while (endFrom > start && endTo > start && jsonEqual(from[endFrom - 1], to[endTo - 1])) {
+      endFrom--;
+      endTo--;
+    }
+    const common = Math.min(endFrom - start, endTo - start);
+    for (let i = 0; i < common; i++) {
+      diffInto(ops, from[start + i], to[start + i], `${path}/${start + i}`);
+    }
+    for (let i = common; i < endFrom - start; i++) {
+      ops.push({ op: "remove", path: `${path}/${start + common}` });
+    }
+    for (let i = common; i < endTo - start; i++) {
+      ops.push({ op: "add", path: `${path}/${start + i}`, value: clone(to[start + i]) as JsonValue });
+    }
+    return;
+  }
+  if (isPlainObject(from) && isPlainObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const p = `${path}/${escapeToken(key)}`;
+      if (!has(from, key)) ops.push({ op: "add", path: p, value: clone(to[key]) as JsonValue });
+      else diffInto(ops, from[key], to[key], p);
+    }
+    return;
+  }
+  ops.push({ op: "replace", path, value: clone(to) as JsonValue });
+}
+
+/**
+ * Returns an RFC 6902 JSON Patch that turns `from` into `to` when applied.
+ * The patch only describes what changed. Neither input is mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): any[] {
+  const ops: PatchOp[] = [];
+  diffInto(ops, from, to, "");
+  return ops;
+}
