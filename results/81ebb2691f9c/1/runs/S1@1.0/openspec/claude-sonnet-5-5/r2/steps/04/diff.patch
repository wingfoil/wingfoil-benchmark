+# merge-patch Specification
+
+## Purpose
+TBD - created by archiving change add-merge-patch. Update Purpose after archive.
+
+## Requirements
+
+### Requirement: Apply a JSON Merge Patch
+`applyMergePatch(target, patch)` SHALL apply the patch per RFC 7386 and return the merged document without mutating its inputs.
+
+#### Scenario: Object patch merges members
+- **WHEN** the patch is an object
+- **THEN** each member is merged recursively into the target, a `null` member removes that key, and other members are added or replaced
+
+#### Scenario: Non-object target treated as empty object
+- **WHEN** the patch is an object and the target is not an object (including arrays and scalars)
+- **THEN** the patch is applied to an empty object
+
+#### Scenario: Non-object patch replaces
+- **WHEN** the patch is not an object (scalar, array or `null`)
+- **THEN** the result is the patch itself; arrays are replaced wholesale, and nulls inside array patches are kept
+
+#### Scenario: Nulls in nested new objects
+- **WHEN** a patch object member with nested `null` values is applied where the key is absent
+- **THEN** the nulls are dropped, not stored
+
+#### Scenario: Safe keys
+- **WHEN** a patch contains a key such as `__proto__`
+- **THEN** it is set as an ordinary own property and the object prototype is not modified
diff --git a/src/index.ts b/src/index.ts
index 643d36900115b50cbd47d62d7713d229a9543f7f..256608b4a3c488b3c71788a7b341f29dec187bfc 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -239,3 +239,40 @@ export function applyPatch(document: unknown, patch: unknown): any {
   }
   return doc;
 }
+
+function isPlainObject(value: unknown): value is Record<string, any> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setOwn(obj: Record<string, any>, key: string, value: any): void {
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/**
+ * Applies the RFC 7386 JSON Merge Patch `patch` to `target` and returns the merged document.
+ * Inputs are never mutated and the result shares no structure with them.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): any {
+  if (Array.isArray(patch)) {
+    return patch.map((item) => structuredClone(item));
+  }
+  if (!isPlainObject(patch)) {
+    return patch;
+  }
+  const result: Record<string, any> = {};
+  if (isPlainObject(target)) {
+    for (const key of Object.keys(target)) {
+      setOwn(result, key, structuredClone(target[key]));
+    }
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const existing = Object.prototype.hasOwnProperty.call(result, key) ? result[key] : undefined;
+      setOwn(result, key, applyMergePatch(existing, value));
+    }
+  }
+  return result;
+}
