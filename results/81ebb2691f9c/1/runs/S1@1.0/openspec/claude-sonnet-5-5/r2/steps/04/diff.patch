index 0000000000000000000000000000000000000000..b59bbe290f79f5d86ffbe4c9484f6a8dc1efa8f0
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,42 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [any, any, any][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, r] of cases) assert.deepEqual(applyMergePatch(t, p), r);
+});
+
+test("does not mutate or share structure", () => {
+  const target = { a: { b: 1 } };
+  const patch = { c: { d: [1] } };
+  const out = applyMergePatch(target, patch);
+  assert.deepEqual(target, { a: { b: 1 } });
+  out.a.b = 2;
+  out.c.d.push(2);
+  assert.deepEqual(target, { a: { b: 1 } });
+  assert.deepEqual(patch, { c: { d: [1] } });
+});
+
+test("__proto__ is an ordinary key", () => {
+  const out = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}'));
+  assert.equal(({} as any).x, undefined);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+});
