+++ b/test/pointer.test.ts
@@ -0,0 +1,76 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("returns the referenced value itself", () => {
+  const inner = {};
+  assert.equal(resolvePointer({ a: inner }, "/a"), inner);
+});
+
+test("falsy and null values", () => {
+  const doc = { a: null, b: false, c: 0, d: "" };
+  for (const k of ["a", "b", "c", "d"]) {
+    assert.equal(resolvePointer(doc, "/" + k), (doc as any)[k]);
+  }
+});
+
+test("escape order", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+  assert.equal(resolvePointer({ "~/": "y" }, "/~0~1"), "y");
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["foo", "a/b", "/a~2b", "/a~", "~0", " /a"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), p);
+  }
+  for (const p of [undefined, null, 1, {}]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p as any));
+  }
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+  for (const p of ["/a/2", "/a/-", "/a/01", "/a/+1", "/a/1.0", "/a/length", "/a/", "/a/-1", "/a/0x1"]) {
+    assert.throws(() => resolvePointer({ a: [1, 2] }, p), p);
+  }
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer("str", "/length"));
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer({}, "/constructor"));
+  assert.throws(() => resolvePointer([], "/0"));
+});
+
+test("array elements", () => {
+  assert.equal(resolvePointer({ a: [10, 20] }, "/a/0"), 10);
+  assert.equal(resolvePointer({ a: [10, 20] }, "/a/1"), 20);
+  assert.equal(resolvePointer([[1]], "/0/0"), 1);
+});
