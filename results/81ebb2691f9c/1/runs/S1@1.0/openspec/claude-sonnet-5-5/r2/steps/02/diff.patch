index 0000000000000000000000000000000000000000..4d753ab9640e23b5a28eef5281feaa4c88e91338
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,49 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("add", () => {
+  assert.deepEqual(applyPatch({ a: ["p", "q"] }, [{ op: "add", path: "/a/1", value: "x" }]), { a: ["p", "x", "q"] });
+  assert.deepEqual(applyPatch({ a: [1] }, [{ op: "add", path: "/a/-", value: 2 }]), { a: [1, 2] });
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "", value: 5 }]), 5);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.throws(() => applyPatch({ a: [] }, [{ op: "add", path: "/a/1", value: 1 }]));
+});
+
+test("remove / replace", () => {
+  assert.deepEqual(applyPatch({ a: [1, 2], b: 1 }, [{ op: "remove", path: "/a/0" }, { op: "remove", path: "/b" }]), { a: [2] });
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/x" }]));
+  assert.deepEqual(applyPatch({ a: [1, 2] }, [{ op: "replace", path: "/a/1", value: 9 }]), { a: [1, 9] });
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/x", value: 1 }]));
+  assert.throws(() => applyPatch({ a: [] }, [{ op: "replace", path: "/a/0", value: 1 }]));
+});
+
+test("move / copy", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/b" }]), { b: 1 });
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  const out = applyPatch({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }, { op: "add", path: "/b/y", value: 2 }]);
+  assert.deepEqual(out, { a: { x: 1 }, b: { x: 1, y: 2 } });
+  assert.throws(() => applyPatch({}, [{ op: "copy", from: "/q", path: "/b" }]));
+});
+
+test("test", () => {
+  applyPatch({ a: { x: 1, y: [1] } }, [{ op: "test", path: "/a", value: { y: [1], x: 1 } }]);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/b", value: null }]));
+});
+
+test("invalid patches and no mutation", () => {
+  assert.throws(() => applyPatch({}, {} as any));
+  assert.throws(() => applyPatch({}, [{ op: "frob", path: "" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "a", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "move", path: "/a" }]));
+  const doc = { a: [1] };
+  const value = { z: 1 };
+  const out = applyPatch(doc, [{ op: "add", path: "/b", value }, { op: "remove", path: "/a/0" }]);
+  assert.deepEqual(doc, { a: [1] });
+  out.b.z = 2;
+  assert.equal(value.z, 1);
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/__proto__", value: 1 }]).__proto__, 1);
+  assert.equal(({} as any).polluted, undefined);
+});
