index 96e342e1f491e99836541840e514255a50e0fb94..d941fc466914e3e1edf801ddd51c8208d6db8ca1 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -51,3 +51,178 @@ export function resolvePointer(document: unknown, pointer: string): any {
   }
   return current;
 }
+
+function clone<T>(value: T): T {
+  if (Array.isArray(value)) {
+    return value.map(clone) as unknown as T;
+  }
+  if (typeof value === "object" && value !== null) {
+    const out: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) {
+      Object.defineProperty(out, key, {
+        value: clone((value as Record<string, unknown>)[key]),
+        enumerable: true,
+        writable: true,
+        configurable: true,
+      });
+    }
+    return out as T;
+  }
+  return value;
+}
+
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((x, i) => jsonEqual(x, b[i]))
+    );
+  }
+  if (typeof a === "object" && a !== null && typeof b === "object" && b !== null) {
+    const ka = Object.keys(a);
+    const kb = Object.keys(b);
+    return (
+      ka.length === kb.length &&
+      ka.every(
+        (k) =>
+          Object.prototype.hasOwnProperty.call(b, k) &&
+          jsonEqual((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]),
+      )
+    );
+  }
+  return a === b;
+}
+
+const has = (o: object, k: string) => Object.prototype.hasOwnProperty.call(o, k);
+
+function setMember(obj: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(obj, key, { value, enumerable: true, writable: true, configurable: true });
+}
+
+/** Walks to the container holding the last token of `tokens`; throws if it does not exist. */
+function parentOf(doc: unknown, tokens: string[], path: string): any {
+  let current: any = doc;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`Path "${path}" does not exist`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null && has(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path "${path}" does not exist`);
+    }
+  }
+  if (typeof current !== "object" || current === null) {
+    throw new Error(`Path "${path}" does not exist`);
+  }
+  return current;
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean, path: string): number {
+  if (allowEnd && token === "-") return length;
+  if (!ARRAY_INDEX.test(token)) throw new Error(`Bad array index "${token}" in "${path}"`);
+  const i = Number(token);
+  if (i > length || (i === length && !allowEnd)) throw new Error(`Array index out of range in "${path}"`);
+  return i;
+}
+
+function getAt(doc: unknown, path: string): unknown {
+  return resolvePointer(doc, path);
+}
+
+function addAt(doc: unknown, path: string, value: unknown): unknown {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(doc, tokens, path);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(last, parent.length, true, path), 0, value);
+  } else {
+    setMember(parent, last, value);
+  }
+  return doc;
+}
+
+function removeAt(doc: unknown, path: string): unknown {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return null;
+  const parent = parentOf(doc, tokens, path);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(last, parent.length, false, path), 1);
+  } else if (has(parent, last)) {
+    delete parent[last];
+  } else {
+    throw new Error(`Path "${path}" does not exist`);
+  }
+  return doc;
+}
+
+/**
+ * Applies the RFC 6902 JSON Patch `patch` to `document` and returns the new document.
+ * Neither input is mutated. Throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): any {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: must be an array");
+  }
+  let doc: unknown = clone(document);
+  for (const operation of patch) {
+    if (typeof operation !== "object" || operation === null || Array.isArray(operation)) {
+      throw new Error("Invalid JSON Patch: operation must be an object");
+    }
+    const op = operation as Record<string, unknown>;
+    const name = op.op;
+    if (typeof op.path !== "string") {
+      throw new Error("Invalid JSON Patch: operation needs a string path");
+    }
+    const path = op.path;
+    parsePointer(path);
+    switch (name) {
+      case "add":
+      case "replace":
+      case "test": {
+        if (!has(op, "value") || op.value === undefined) {
+          throw new Error(`Invalid JSON Patch: "${name}" needs a value`);
+        }
+        if (name === "add") {
+          doc = addAt(doc, path, clone(op.value));
+        } else if (name === "replace") {
+          getAt(doc, path);
+          doc = parsePointer(path).length === 0 ? clone(op.value) : addAt(removeAt(doc, path), path, clone(op.value));
+        } else if (!jsonEqual(getAt(doc, path), op.value)) {
+          throw new Error(`Test failed at "${path}"`);
+        }
+        break;
+      }
+      case "remove":
+        getAt(doc, path);
+        doc = removeAt(doc, path);
+        break;
+      case "move":
+      case "copy": {
+        if (typeof op.from !== "string") {
+          throw new Error(`Invalid JSON Patch: "${name}" needs a string from`);
+        }
+        const from = op.from;
+        parsePointer(from);
+        const value = clone(getAt(doc, from));
+        if (name === "copy") {
+          doc = addAt(doc, path, value);
+        } else {
+          if (path !== from && path.startsWith(from + "/")) {
+            throw new Error(`Cannot move "${from}" into its own child "${path}"`);
+          }
+          if (path !== from) {
+            doc = addAt(removeAt(doc, from), path, value);
+          }
+        }
+        break;
+      }
+      default:
+        throw new Error(`Invalid JSON Patch: unknown op ${JSON.stringify(name)}`);
+    }
+  }
+  return doc;
+}
