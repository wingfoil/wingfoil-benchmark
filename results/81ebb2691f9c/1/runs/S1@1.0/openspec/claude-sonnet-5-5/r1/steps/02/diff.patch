@@ -0,0 +1,111 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, JsonPatchError } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) => assert.deepEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch), JsonPatchError);
+
+test("RFC 6902 appendix A", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], { foo: ["all", "cows", "eat", "grass"] });
+  ok({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], { baz: "qux", foo: ["a", 2, "c"] });
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", op2: 1 }, { op: "remove", path: "/x" }]);
+  ok({ foo: { bar: 1 } }, [{ op: "copy", from: "/foo", path: "/baz" }, { op: "replace", path: "/baz/bar", value: 2 }], { foo: { bar: 1 }, baz: { bar: 2 } });
+});
+
+test("does not mutate inputs and result is independent", () => {
+  const doc = { a: [1, { b: 2 }] };
+  const patch = [{ op: "add", path: "/c", value: { d: 1 } }, { op: "copy", from: "/a", path: "/e" }];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const result = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  result.c.d = 9;
+  result.e[1].b = 9;
+  assert.deepEqual(patch, patchCopy);
+  assert.deepEqual(result.a, [1, { b: 2 }]);
+  assert.deepEqual(applyPatch(doc, []), doc);
+});
+
+test("failure is atomic", () => {
+  const doc = { a: 1 };
+  bad(doc, [{ op: "add", path: "/b", value: 2 }, { op: "remove", path: "/zzz" }]);
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("invalid patches", () => {
+  for (const patch of [{}, null, [1], [{ op: "bogus", path: "" }], [{ path: "" }], [{ op: "add", path: "/a" }],
+    [{ op: "replace", path: "/a" }], [{ op: "test", path: "/a" }], [{ op: "move", path: "/a" }],
+    [{ op: "copy", path: "/a", from: "x" }], [{ op: "add", path: "a", value: 1 }], [{ op: "add", value: 1 }],
+    [{ op: "add", path: 1, value: 1 }]]) bad({ a: 1 }, patch);
+  ok({}, [{ op: "add", path: "/a", value: null }], { a: null });
+});
+
+test("add", () => {
+  ok({ a: 1 }, [{ op: "add", path: "/a", value: 2 }], { a: 2 });
+  ok([1, 2], [{ op: "add", path: "/0", value: 0 }], [0, 1, 2]);
+  ok([1, 2], [{ op: "add", path: "/2", value: 3 }], [1, 2, 3]);
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "add", path: "/", value: 5 }], { a: 1, "": 5 });
+  for (const path of ["/3", "/01", "/-1", "/x", "/1.0", "/0/x"]) bad([1, 2], [{ op: "add", path, value: 0 }]);
+  bad(5, [{ op: "add", path: "/a", value: 0 }]);
+});
+
+test("remove and replace", () => {
+  ok([1, 2], [{ op: "remove", path: "/0" }], [2]);
+  for (const path of ["/2", "/-", "/01"]) bad([1, 2], [{ op: "remove", path }]);
+  bad({}, [{ op: "remove", path: "/a" }]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: 2 }], 2);
+  ok([1, 2], [{ op: "replace", path: "/1", value: 3 }], [1, 3]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad([1], [{ op: "replace", path: "/1", value: 1 }]);
+  bad([1], [{ op: "replace", path: "/-", value: 1 }]);
+});
+
+test("move and copy", () => {
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "" }], 1);
+  bad({ a: 1 }, [{ op: "move", from: "/x", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "copy", from: "/x", path: "/b" }]);
+  ok({ a: [1] }, [{ op: "copy", from: "/a", path: "/b" }, { op: "add", path: "/b/-", value: 2 }], { a: [1], b: [1, 2] });
+});
+
+test("test operation equality", () => {
+  const t = (doc: unknown, value: unknown) => applyPatch(doc, [{ op: "test", path: "", value }]);
+  t({ a: 1, b: [1, { c: 2 }] }, { b: [1, { c: 2 }], a: 1 });
+  t(null, null);
+  t(1.0, 1);
+  assert.throws(() => t(1, "1"), JsonPatchError);
+  assert.throws(() => t(1, true), JsonPatchError);
+  assert.throws(() => t([1, 2], [2, 1]), JsonPatchError);
+  assert.throws(() => t({ a: 1 }, { a: 1, b: 2 }), JsonPatchError);
+  assert.throws(() => t({}, []), JsonPatchError);
+  bad({}, [{ op: "test", path: "/a", value: null }]);
+});
+
+test("special member names", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as any;
+  assert.ok(Object.hasOwn(result, "__proto__"));
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as any).x, undefined);
+  bad({}, [{ op: "remove", path: "/toString" }]);
+  bad({}, [{ op: "test", path: "/constructor", value: 1 }]);
+  const parsed = JSON.parse('{"__proto__": {"y": 1}}');
+  const out = applyPatch(parsed, [{ op: "add", path: "/z", value: 1 }]) as any;
+  assert.equal(out.y, undefined);
+  assert.equal(({} as any).y, undefined);
+});
