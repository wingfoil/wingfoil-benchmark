index cd1e9839cf4d8b7ede5da77733160c80664541a1..c06859b690d5710cdabb9ae4313887c3b17e5f56 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -42,3 +42,178 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Container = Record<string, unknown> | unknown[];
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function cloneJson(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(cloneJson);
+  if (isObject(value)) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(copy, key, cloneJson(value[key]));
+    return copy;
+  }
+  return value;
+}
+
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]));
+  }
+  if (isObject(a) || isObject(b)) {
+    if (!isObject(a) || !isObject(b)) return false;
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((key) => Object.hasOwn(b, key) && jsonEqual(a[key], b[key]));
+  }
+  return a === b;
+}
+
+function patchPointer(pointer: unknown, what: string): string[] {
+  try {
+    return parsePointer(pointer);
+  } catch (error) {
+    throw new JsonPatchError(`Invalid ${what}: ${(error as Error).message}`);
+  }
+}
+
+/** Finds the container holding the target of `tokens`; its parent chain must exist. */
+function parentOf(root: unknown, tokens: string[]): Container {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current) && ARRAY_INDEX.test(token) && Number(token) < current.length) {
+      current = current[Number(token)];
+    } else if (isObject(current) && Object.hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new JsonPatchError(`Path /${tokens.join("/")} does not exist: bad token ${JSON.stringify(token)}`);
+    }
+  }
+  if (Array.isArray(current) || isObject(current)) return current;
+  throw new JsonPatchError(`Path /${tokens.join("/")} does not exist: parent is not a container`);
+}
+
+function getAt(root: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) return root;
+  const parent = parentOf(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(key) || Number(key) >= parent.length) {
+      throw new JsonPatchError(`Path /${tokens.join("/")} does not exist: bad array index ${JSON.stringify(key)}`);
+    }
+    return parent[Number(key)];
+  }
+  if (!Object.hasOwn(parent, key)) {
+    throw new JsonPatchError(`Path /${tokens.join("/")} does not exist: no member ${JSON.stringify(key)}`);
+  }
+  return parent[key];
+}
+
+function addAt(root: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (key === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(key) && Number(key) <= parent.length) {
+      parent.splice(Number(key), 0, value);
+    } else {
+      throw new JsonPatchError(`Cannot add at /${tokens.join("/")}: bad array index ${JSON.stringify(key)}`);
+    }
+  } else {
+    setMember(parent, key, value);
+  }
+  return root;
+}
+
+function removeAt(root: unknown, tokens: string[]): unknown {
+  getAt(root, tokens); // the target must exist
+  if (tokens.length === 0) {
+    throw new JsonPatchError("Cannot remove the document root");
+  }
+  const parent = parentOf(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(key), 1);
+  else delete parent[key];
+  return root;
+}
+
+/**
+ * Applies the RFC 6902 JSON Patch `patch` to `document` and returns the result as a new value.
+ * Neither argument is mutated. Throws a `JsonPatchError` if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchError("A JSON Patch must be an array of operations");
+  let result = cloneJson(document);
+  patch.forEach((operation, index) => {
+    const at = `operation ${index}`;
+    if (!isObject(operation)) throw new JsonPatchError(`Invalid ${at}: must be an object`);
+    const op = operation.op;
+    if (typeof op !== "string" || !["add", "remove", "replace", "move", "copy", "test"].includes(op)) {
+      throw new JsonPatchError(`Invalid ${at}: unknown "op" ${JSON.stringify(op)}`);
+    }
+    const path = patchPointer(operation.path, `"path" of ${at}`);
+    const needsValue = op === "add" || op === "replace" || op === "test";
+    if (needsValue && !Object.hasOwn(operation, "value")) {
+      throw new JsonPatchError(`Invalid ${at}: "${op}" requires "value"`);
+    }
+    const from = op === "move" || op === "copy" ? patchPointer(operation.from, `"from" of ${at}`) : [];
+    const value = operation.value;
+    try {
+      switch (op) {
+        case "add":
+          result = addAt(result, path, cloneJson(value));
+          break;
+        case "remove":
+          result = removeAt(result, path);
+          break;
+        case "replace":
+          getAt(result, path);
+          if (path.length === 0) {
+            result = cloneJson(value);
+          } else {
+            const parent = parentOf(result, path);
+            const key = path[path.length - 1];
+            if (Array.isArray(parent)) parent[Number(key)] = cloneJson(value);
+            else setMember(parent, key, cloneJson(value));
+          }
+          break;
+        case "move": {
+          if (from.length < path.length && from.every((token, i) => token === path[i])) {
+            throw new JsonPatchError("Cannot move a value into one of its own children");
+          }
+          const moved = getAt(result, from);
+          if (from.length === path.length && from.every((token, i) => token === path[i])) break;
+          result = addAt(removeAt(result, from), path, moved);
+          break;
+        }
+        case "copy":
+          result = addAt(result, path, cloneJson(getAt(result, from)));
+          break;
+        case "test":
+          if (!jsonEqual(getAt(result, path), value)) throw new JsonPatchError("Test failed: values differ");
+          break;
+      }
+    } catch (error) {
+      if (error instanceof JsonPatchError) throw new JsonPatchError(`${at} (${op}) failed: ${error.message}`);
+      throw error;
+    }
+  });
+  return result;
+}
