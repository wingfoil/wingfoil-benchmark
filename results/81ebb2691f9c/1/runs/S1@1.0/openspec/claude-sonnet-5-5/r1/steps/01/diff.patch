--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,44 @@
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Invalid JSON Pointer ${JSON.stringify(pointer)}: must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new JsonPointerError(`Invalid JSON Pointer ${JSON.stringify(pointer)}: "~" must be followed by 0 or 1`);
+      }
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/** Returns the value of `document` referred to by the RFC 6901 JSON Pointer `pointer`. */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  let current = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token) || Number(token) >= current.length) {
+        throw new JsonPointerError(`Pointer ${JSON.stringify(pointer)} does not resolve to a value: bad array index ${JSON.stringify(token)}`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null && Object.hasOwn(current, token)) {
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Pointer ${JSON.stringify(pointer)} does not resolve to a value: no member ${JSON.stringify(token)}`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c2f452bb7a169a214b6edfd06d293a35c8bd466a
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,72 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  "k\"l": 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("whole document of any type", () => {
+  assert.equal(resolvePointer(5, ""), 5);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("falsy values are values", () => {
+  const d = { a: null, b: false, c: 0, d: "" };
+  for (const k of Object.keys(d)) assert.equal(resolvePointer(d, `/${k}`), (d as any)[k]);
+});
+
+test("decoding order", () => {
+  assert.equal(resolvePointer({ "~1": 3 }, "/~01"), 3);
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["a/b", "a", "/a~2", "/a~", "/~", 5 as any, undefined as any]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), `${p}`);
+  }
+  assert.throws(() => resolvePointer({}, "x/~"));
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer({}, "/toString"));
+  assert.throws(() => resolvePointer({}, "/constructor"));
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer([1], "/1"));
+  assert.throws(() => resolvePointer([1], "/-"));
+  assert.throws(() => resolvePointer("abc", "/0"));
+  for (const t of ["01", "+1", "-1", "1.0", "1e0", "length", ""]) {
+    assert.throws(() => resolvePointer([1, 2], `/${t}`), t);
+  }
+});
+
+test("own __proto__ member is resolvable", () => {
+  const d = JSON.parse('{"__proto__": 1}');
+  assert.equal(resolvePointer(d, "/__proto__"), 1);
+});
