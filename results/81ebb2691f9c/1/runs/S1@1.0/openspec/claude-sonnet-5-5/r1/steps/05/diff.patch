index 0000000000000000000000000000000000000000..09b6fd54438d9b8ea74ba40e90b29a73a6811a01
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,59 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function check(from: unknown, to: unknown) {
+  const f = structuredClone(from);
+  const t = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, f);
+  assert.deepEqual(to, t);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give empty patch", () => {
+  assert.deepEqual(check({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small nested change is one operation", () => {
+  assert.deepEqual(check({ a: { b: 1, c: [1, 2] }, d: 5 }, { a: { b: 1, c: [1, 3] }, d: 5 }), [
+    { op: "replace", path: "/a/c/1", value: 3 },
+  ]);
+});
+
+test("array insertion and removal in the middle", () => {
+  const big = Array.from({ length: 50 }, (_, i) => i);
+  assert.deepEqual(check(big, [...big.slice(0, 20), 99, ...big.slice(20)]), [{ op: "add", path: "/20", value: 99 }]);
+  assert.deepEqual(check(big, big.filter((x) => x !== 7)), [{ op: "remove", path: "/7" }]);
+});
+
+test("object add/remove and type changes", () => {
+  check({ a: 1, b: 2 }, { b: 2, c: 3 });
+  check({ a: [1] }, { a: { x: 1 } });
+  check(1, { a: 1 });
+  assert.deepEqual(check(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  check(null, [null]);
+  check([[1, 2], [3]], [[1], [3, 4], 5]);
+});
+
+test("escapes keys and handles __proto__", () => {
+  assert.deepEqual(check({ "a/b~c": 1 }, { "a/b~c": 2 }), [{ op: "replace", path: "/a~1b~0c", value: 2 }]);
+  const to = JSON.parse('{"__proto__": {"x": 1}}');
+  check({}, to);
+  check(to, JSON.parse('{"__proto__": {"x": 2}}'));
+});
+
+test("randomized round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => (seed = (seed * 1103515245 + 12345) % 2147483648) % n;
+  const gen = (d: number): unknown => {
+    const r = rnd(d > 2 ? 3 : 6);
+    if (r === 0) return rnd(4);
+    if (r === 1) return null;
+    if (r === 2) return "s" + rnd(3);
+    if (r === 3 || r === 4) return Array.from({ length: rnd(5) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let i = 0; i < 2000; i++) check(gen(0), gen(0));
+});
