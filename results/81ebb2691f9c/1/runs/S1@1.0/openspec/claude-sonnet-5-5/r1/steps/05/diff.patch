diff --git a/src/index.ts b/src/index.ts
index 431161724c77d98a706e9b42dd13afe59e76a56d..de0e8add41f67d01d6881e7b41aadc856d0e38f5 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -237,3 +237,86 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Edit script turning array `a` into `b`: for each step, "keep", "del" or "ins". */
+function arrayEdits(a: unknown[], b: unknown[]): ("keep" | "del" | "ins")[] {
+  const lcs: number[][] = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(a[i], b[j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  const edits: ("keep" | "del" | "ins")[] = [];
+  let i = 0;
+  let j = 0;
+  while (i < a.length || j < b.length) {
+    if (i < a.length && j < b.length && jsonEqual(a[i], b[j])) {
+      edits.push("keep");
+      i++;
+      j++;
+    } else if (i < a.length && (j === b.length || lcs[i + 1][j] >= lcs[i][j + 1])) {
+      edits.push("del");
+      i++;
+    } else {
+      edits.push("ins");
+      j++;
+    }
+  }
+  return edits;
+}
+
+function diffInto(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    const edits = arrayEdits(from, to);
+    let ai = 0; // index into from
+    let bi = 0; // index into to; equals the current index in the array being patched
+    let k = 0;
+    while (k < edits.length) {
+      if (edits[k] === "keep") {
+        ai++;
+        bi++;
+        k++;
+        continue;
+      }
+      const dels: unknown[] = [];
+      const inss: unknown[] = [];
+      while (k < edits.length && edits[k] !== "keep") {
+        if (edits[k] === "del") dels.push(from[ai++]);
+        else inss.push(to[bi + inss.length]);
+        k++;
+      }
+      const paired = Math.min(dels.length, inss.length);
+      for (let p = 0; p < paired; p++) diffInto(dels[p], inss[p], `${path}/${bi + p}`, ops);
+      for (let p = paired; p < dels.length; p++) ops.push({ op: "remove", path: `${path}/${bi + paired}` });
+      for (let p = paired; p < inss.length; p++) ops.push({ op: "add", path: `${path}/${bi + p}`, value: cloneJson(inss[p]) });
+      bi += inss.length;
+    }
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (!Object.hasOwn(from, key)) ops.push({ op: "add", path: child, value: cloneJson(to[key]) });
+      else diffInto(from[key], to[key], child, ops);
+    }
+  } else {
+    ops.push({ op: "replace", path, value: cloneJson(to) });
+  }
+}
+
+/** Returns an RFC 6902 JSON Patch that turns `from` into `to`, describing only what changed. */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffInto(from, to, "", ops);
+  return ops;
+}
