+
+test('rentals shorter than a day are priced per hour, only for items with an hourly price', () => {
+  const s = setup();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2550, hourlyPrice: 900 });
+  const h = (day: number, hour: number) => `2026-07-${String(day).padStart(2, '0')}T${String(hour).padStart(2, '0')}:00:00Z`;
+  assert.equal(s.quote({ itemId: 'b2', start: h(1, 9), end: h(1, 13) }).total, 3600);
+  assert.equal(s.book({ itemId: 'b2', start: h(1, 22), end: h(2, 2) }).total, 3600);
+  assert.throws(() => s.book({ itemId: 'b2', start: h(1, 23), end: h(2, 1) }));
+  assert.equal(s.book({ itemId: 'b2', start: h(2, 2), end: h(2, 3) }).total, 900);
+  assert.throws(() => s.quote({ itemId: 'b1', start: h(1, 9), end: h(1, 13) }));
+  assert.throws(() => s.quote({ itemId: 'b2', start: '2026-07-01T09:30:00Z', end: h(1, 13) }));
+  assert.throws(() => s.quote({ itemId: 'b2', start: h(1, 9), end: h(2, 9) }));
+  assert.deepEqual(s.availability({ start: h(1, 9), end: h(1, 10) }), ['b1', 'b2']);
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+});
