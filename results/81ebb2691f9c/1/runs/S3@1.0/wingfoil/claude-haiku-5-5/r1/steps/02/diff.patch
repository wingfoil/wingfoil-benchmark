+
+describe('availability', () => {
+  const july = { start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' };
+
+  it('lists the ids of every item when no kind is given, sorted', () => {
+    const rental = serviceWithBoard();
+    rental.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 900 });
+    rental.addEquipment({ id: 'board-0', kind: 'board', dailyPrice: 1200 });
+    assert.deepEqual(rental.availability(july), ['board-0', 'board-1', 'sail-1']);
+  });
+
+  it('lists only the items of the given kind', () => {
+    const rental = serviceWithBoard();
+    rental.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 900 });
+    rental.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 900 });
+    assert.deepEqual(rental.availability({ ...july, kind: 'sail' }), ['sail-1', 'sail-2']);
+    assert.deepEqual(rental.availability({ ...july, kind: 'board' }), ['board-1']);
+  });
+
+  it('returns an empty list when there is no equipment', () => {
+    assert.deepEqual(createRentalService().availability(july), []);
+  });
+
+  it('leaves out an item that is booked for part of the period', () => {
+    const rental = serviceWithBoard();
+    rental.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 1500 });
+    rental.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+    assert.deepEqual(rental.availability(july), ['board-2']);
+  });
+
+  it('keeps an item that is booked only on days that start after the period ends', () => {
+    const rental = serviceWithBoard();
+    rental.book({ itemId: 'board-1', start: '2026-07-03T00:00:00Z', end: '2026-07-05T00:00:00Z' });
+    assert.deepEqual(rental.availability(july), ['board-1']);
+  });
+
+  it('keeps an item whose booking ends on the day the period starts', () => {
+    const rental = serviceWithBoard();
+    rental.book({ itemId: 'board-1', start: '2026-06-29T00:00:00Z', end: '2026-07-01T00:00:00Z' });
+    assert.deepEqual(rental.availability(july), ['board-1']);
+  });
+
+  it('leaves out an item booked for a period that contains the query', () => {
+    const rental = serviceWithBoard();
+    rental.book({ itemId: 'board-1', start: '2026-06-30T00:00:00Z', end: '2026-07-10T00:00:00Z' });
+    assert.deepEqual(rental.availability(july), []);
+  });
+
+  it('checks every booking of an item, not only the last one', () => {
+    const rental = serviceWithBoard();
+    rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+    rental.book({ itemId: 'board-1', start: '2026-07-10T00:00:00Z', end: '2026-07-11T00:00:00Z' });
+    assert.deepEqual(rental.availability(july), []);
+  });
+
+  it('does not let a booking of one item hide another', () => {
+    const rental = serviceWithBoard();
+    rental.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 900 });
+    rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+    assert.deepEqual(rental.availability({ ...july, kind: 'sail' }), ['sail-1']);
+  });
+
+  it('does not change after a quote for the period', () => {
+    const rental = serviceWithBoard();
+    rental.quote({ itemId: 'board-1', ...july });
+    assert.deepEqual(rental.availability(july), ['board-1']);
+  });
+
+  it('throws for an unknown kind', () => {
+    const rental = serviceWithBoard();
+    assert.throws(() => rental.availability({ ...july, kind: 'kite' as 'board' }));
+  });
+
+  it('throws for an invalid period', () => {
+    const rental = serviceWithBoard();
+    assert.throws(() =>
+      rental.availability({ start: '2026-07-01T09:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    );
+    assert.throws(() =>
+      rental.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-01T00:00:00Z' }),
+    );
+  });
+});
