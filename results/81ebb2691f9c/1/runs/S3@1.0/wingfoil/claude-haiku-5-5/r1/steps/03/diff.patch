+/**
+ * The price of a period after the long-rental discount: 10% off from 3 days, rounded half up to the cent.
+ * Computed in integers, `(price * 9 + 5) / 10`, so no floating-point rounding is involved.
+ */
+function discountedTotal(fullPrice: number, days: number): number {
+  if (days < LONG_RENTAL_DAYS) {
+    return fullPrice;
+  }
+  return Math.floor((fullPrice * 9 + 5) / 10);
+}
+
 function assertKind(kind: unknown): asserts kind is EquipmentKind {
   if (!KINDS.includes(kind as EquipmentKind)) {
     throw new Error(`kind must be 'board' or 'sail', got ${String(kind)}`);
@@ -119,7 +134,7 @@ export function createRentalService(): RentalService {
       itemId: request.itemId,
       start: request.start,
       end: request.end,
-      total: item.dailyPrice * days,
+      total: discountedTotal(item.dailyPrice * days, days),
     };
     return { quote, startMs, endMs };
   }
