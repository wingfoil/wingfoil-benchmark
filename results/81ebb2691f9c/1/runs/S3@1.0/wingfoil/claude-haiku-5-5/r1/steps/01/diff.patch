@@ -0,0 +1,135 @@
+/** The kinds of equipment the school rents out. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item. `dailyPrice` is the price of one day, in integer euro cents. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/**
+ * A period to price or book. `start` and `end` are UTC midnights in ISO-8601, such as
+ * `2026-07-01T00:00:00Z`. `end` is the start of the day after the last rented day.
+ */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The price of renting an item for a period. `total` is in integer euro cents. */
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  total: number;
+}
+
+/** A confirmed booking of an item for a period. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** An in-memory rental service for the booking desk. */
+export interface RentalService {
+  /** Adds an item to the catalogue. Throws when the item is invalid or its id is already taken. */
+  addEquipment(item: Equipment): void;
+  /** Prices a period. Does not check availability; only `book` refuses an overlapping period. */
+  quote(request: RentalRequest): Quote;
+  /** Books an item for a period. Throws when the item is not free for the whole period. */
+  book(request: RentalRequest): Booking;
+}
+
+const KINDS: readonly EquipmentKind[] = ['board', 'sail'];
+const DAY_MS = 24 * 60 * 60 * 1000;
+const UTC_MIDNIGHT = /^(\d{4}-\d{2}-\d{2})T00:00:00(\.000)?Z$/;
+
+interface Priced {
+  quote: Quote;
+  startMs: number;
+  endMs: number;
+}
+
+interface StoredBooking {
+  booking: Booking;
+  startMs: number;
+  endMs: number;
+}
+
+function parseDay(value: string, field: string): number {
+  const match = UTC_MIDNIGHT.exec(value);
+  const ms = Date.parse(value);
+  if (!match || Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== match[1]) {
+    throw new Error(`${field} must be a UTC midnight ISO-8601 date, such as 2026-07-01T00:00:00Z`);
+  }
+  return ms;
+}
+
+/**
+ * Creates a rental service that keeps its items and bookings in memory. Each service has its own
+ * catalogue and its own booking ids, which count up from `booking-1`.
+ */
+export function createRentalService(): RentalService {
+  const items = new Map<string, Equipment>();
+  const bookings: StoredBooking[] = [];
+  let bookingCount = 0;
+
+  function priceOf(request: RentalRequest): Priced {
+    const item = items.get(request.itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${request.itemId}`);
+    }
+    const startMs = parseDay(request.start, 'start');
+    const endMs = parseDay(request.end, 'end');
+    if (endMs <= startMs) {
+      throw new Error('end must be after start');
+    }
+    const days = (endMs - startMs) / DAY_MS;
+    const quote = {
+      itemId: request.itemId,
+      start: request.start,
+      end: request.end,
+      total: item.dailyPrice * days,
+    };
+    return { quote, startMs, endMs };
+  }
+
+  return {
+    addEquipment(item: Equipment): void {
+      if (typeof item.id !== 'string' || item.id === '') {
+        throw new Error('item id must be a non-empty string');
+      }
+      if (!KINDS.includes(item.kind)) {
+        throw new Error(`kind must be 'board' or 'sail', got ${String(item.kind)}`);
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+      }
+      if (items.has(item.id)) {
+        throw new Error(`duplicate item: ${item.id}`);
+      }
+      items.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request: RentalRequest): Quote {
+      return { ...priceOf(request).quote };
+    },
+
+    book(request: RentalRequest): Booking {
+      const { quote, startMs, endMs } = priceOf(request);
+      // Periods are half-open, so one that starts on the day another ends does not overlap it.
+      const clash = bookings.some(
+        (other) =>
+          other.booking.itemId === quote.itemId && other.startMs < endMs && startMs < other.endMs,
+      );
+      if (clash) {
+        throw new Error(`item ${quote.itemId} is already booked for part of that period`);
+      }
+      bookingCount += 1;
+      const booking: Booking = { id: `booking-${bookingCount}`, ...quote };
+      bookings.push({ booking, startMs, endMs });
+      return { ...booking };
+    },
+  };
+}
