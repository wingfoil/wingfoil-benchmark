@@ -0,0 +1,227 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function serviceWithBoard() {
+  const rental = createRentalService();
+  rental.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+  return rental;
+}
+
+describe('addEquipment', () => {
+  it('accepts a board and a sail with integer daily prices', () => {
+    const rental = createRentalService();
+    rental.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+    rental.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 900 });
+    const quote = rental.quote({
+      itemId: 'sail-1',
+      start: '2026-07-01T00:00:00Z',
+      end: '2026-07-02T00:00:00Z',
+    });
+    assert.equal(quote.total, 900);
+  });
+
+  it('rejects a duplicate id', () => {
+    const rental = serviceWithBoard();
+    assert.throws(() => rental.addEquipment({ id: 'board-1', kind: 'sail', dailyPrice: 900 }));
+  });
+
+  it('rejects an unknown kind', () => {
+    const rental = createRentalService();
+    assert.throws(() => rental.addEquipment({ id: 'x', kind: 'kite' as 'board', dailyPrice: 900 }));
+  });
+
+  it('rejects a daily price that is not a non-negative integer of cents', () => {
+    const rental = createRentalService();
+    assert.throws(() => rental.addEquipment({ id: 'a', kind: 'board', dailyPrice: 15.5 }));
+    assert.throws(() => rental.addEquipment({ id: 'b', kind: 'board', dailyPrice: -1 }));
+    assert.throws(() => rental.addEquipment({ id: 'c', kind: 'board', dailyPrice: NaN }));
+  });
+
+  it('rejects an empty id', () => {
+    const rental = createRentalService();
+    assert.throws(() => rental.addEquipment({ id: '', kind: 'board', dailyPrice: 1500 }));
+  });
+});
+
+describe('quote', () => {
+  it('prices a whole number of days as daily price times days', () => {
+    const rental = serviceWithBoard();
+    const quote = rental.quote({
+      itemId: 'board-1',
+      start: '2026-07-01T00:00:00Z',
+      end: '2026-07-04T00:00:00Z',
+    });
+    assert.deepEqual(quote, {
+      itemId: 'board-1',
+      start: '2026-07-01T00:00:00Z',
+      end: '2026-07-04T00:00:00Z',
+      total: 4500,
+    });
+  });
+
+  it('prices a single day', () => {
+    const rental = serviceWithBoard();
+    const quote = rental.quote({
+      itemId: 'board-1',
+      start: '2026-07-01T00:00:00Z',
+      end: '2026-07-02T00:00:00Z',
+    });
+    assert.equal(quote.total, 1500);
+  });
+
+  it('crosses month and year boundaries by calendar days', () => {
+    const rental = serviceWithBoard();
+    const quote = rental.quote({
+      itemId: 'board-1',
+      start: '2027-02-27T00:00:00Z',
+      end: '2027-03-02T00:00:00Z',
+    });
+    assert.equal(quote.total, 1500 * 3);
+  });
+
+  it('does not check availability', () => {
+    const rental = serviceWithBoard();
+    const period = { itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' };
+    rental.book(period);
+    assert.equal(rental.quote(period).total, 3000);
+  });
+
+  it('throws for an unknown item', () => {
+    const rental = serviceWithBoard();
+    assert.throws(() =>
+      rental.quote({ itemId: 'nope', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    );
+  });
+
+  it('throws when the period ends before or at its start', () => {
+    const rental = serviceWithBoard();
+    assert.throws(() =>
+      rental.quote({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-01T00:00:00Z' }),
+    );
+    assert.throws(() =>
+      rental.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-01T00:00:00Z' }),
+    );
+  });
+
+  it('throws when a time is not at midnight UTC', () => {
+    const rental = serviceWithBoard();
+    assert.throws(() =>
+      rental.quote({ itemId: 'board-1', start: '2026-07-01T09:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    );
+    assert.throws(() =>
+      rental.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T12:00:00Z' }),
+    );
+  });
+
+  it('throws when a time is not written in UTC', () => {
+    const rental = serviceWithBoard();
+    assert.throws(() =>
+      rental.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00+02:00', end: '2026-07-02T00:00:00Z' }),
+    );
+  });
+
+  it('throws when a time is not an ISO-8601 date', () => {
+    const rental = serviceWithBoard();
+    assert.throws(() =>
+      rental.quote({ itemId: 'board-1', start: 'July 1 2026', end: '2026-07-02T00:00:00Z' }),
+    );
+    assert.throws(() =>
+      rental.quote({ itemId: 'board-1', start: '2026-02-30T00:00:00Z', end: '2026-03-01T00:00:00Z' }),
+    );
+  });
+});
+
+describe('book', () => {
+  it('returns a booking with an id and the total', () => {
+    const rental = serviceWithBoard();
+    const booking = rental.book({
+      itemId: 'board-1',
+      start: '2026-07-01T00:00:00Z',
+      end: '2026-07-03T00:00:00Z',
+    });
+    assert.equal(booking.itemId, 'board-1');
+    assert.equal(booking.start, '2026-07-01T00:00:00Z');
+    assert.equal(booking.end, '2026-07-03T00:00:00Z');
+    assert.equal(booking.total, 3000);
+    assert.equal(typeof booking.id, 'string');
+  });
+
+  it('gives each booking its own id', () => {
+    const rental = serviceWithBoard();
+    const first = rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+    const second = rental.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+    assert.notEqual(first.id, second.id);
+  });
+
+  it('allows a period that starts on the day another one ends', () => {
+    const rental = serviceWithBoard();
+    rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+    assert.doesNotThrow(() =>
+      rental.book({ itemId: 'board-1', start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z' }),
+    );
+  });
+
+  it('refuses a period that overlaps an existing booking', () => {
+    const rental = serviceWithBoard();
+    rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+    assert.throws(() =>
+      rental.book({ itemId: 'board-1', start: '2026-07-03T00:00:00Z', end: '2026-07-05T00:00:00Z' }),
+    );
+    assert.throws(() =>
+      rental.book({ itemId: 'board-1', start: '2026-06-30T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    );
+    assert.throws(() =>
+      rental.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' }),
+    );
+  });
+
+  it('refuses a period that contains an existing booking', () => {
+    const rental = serviceWithBoard();
+    rental.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+    assert.throws(() =>
+      rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-05T00:00:00Z' }),
+    );
+  });
+
+  it('checks the overlap against every earlier booking, not only the last one', () => {
+    const rental = serviceWithBoard();
+    rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+    rental.book({ itemId: 'board-1', start: '2026-07-05T00:00:00Z', end: '2026-07-06T00:00:00Z' });
+    assert.throws(() =>
+      rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    );
+  });
+
+  it('does not treat other items as overlapping', () => {
+    const rental = serviceWithBoard();
+    rental.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 900 });
+    rental.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+    assert.doesNotThrow(() =>
+      rental.book({ itemId: 'sail-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' }),
+    );
+  });
+
+  it('throws for an unknown item', () => {
+    const rental = serviceWithBoard();
+    assert.throws(() =>
+      rental.book({ itemId: 'nope', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    );
+  });
+
