+
+const hourly = () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  s.addEquipment({ id: 'd1', kind: 'board', dailyPrice: 2500 });
+  return s;
+};
+
+test('an hourly rental costs the hourly price for each hour, in quotes and bookings', () => {
+  const s = hourly();
+  const r = { itemId: 'h1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T17:00:00Z' };
+  assert.equal(s.quote(r).total, 2400);
+  assert.equal(s.book(r).total, 2400);
+  assert.equal(s.quote({ ...r, end: '2026-07-02T12:00:00Z' }).total, 23 * 600);
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  assert.throws(() => hourly().quote({ itemId: 'd1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T17:00:00Z' }));
+});
+
+test('hourly rentals must start and end on the hour and be shorter than a day', () => {
+  const s = hourly();
+  for (const [start, end] of [
+    ['2026-07-01T13:30:00Z', '2026-07-01T17:00:00Z'],
+    ['2026-07-01T13:00:00Z', '2026-07-01T17:15:00Z'],
+    ['2026-07-01T13:00:00Z', '2026-07-01T13:00:00Z'],
+    ['2026-07-01T13:00:00Z', '2026-07-01T12:00:00Z'],
+    ['2026-07-01T13:00:00Z', '2026-07-02T13:00:00Z'],
+    ['2026-07-01T13:00:00+02:00', '2026-07-01T17:00:00Z'],
+  ]) {
+    assert.throws(() => s.quote({ itemId: 'h1', start, end }), undefined, `${start} ${end}`);
+  }
+});
+
+test('hourly bookings clash with overlapping rentals and block availability', () => {
+  const s = hourly();
+  s.book({ itemId: 'h1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T17:00:00Z' });
+  assert.throws(() => s.book({ itemId: 'h1', start: '2026-07-01T16:00:00Z', end: '2026-07-01T18:00:00Z' }));
+  assert.throws(() => s.book({ itemId: 'h1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.doesNotThrow(() => s.book({ itemId: 'h1', start: '2026-07-01T17:00:00Z', end: '2026-07-01T18:00:00Z' }));
+  assert.deepEqual(s.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }), ['d1']);
+});
+
+test('addEquipment rejects an invalid hourly price', () => {
+  const s = createRentalService();
+  for (const hourlyPrice of [-1, 1.5, Number.NaN]) {
+    assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice }));
+  }
+});
+
+test('an hourly rental may start or end at midnight', () => {
+  const s = hourly();
+  assert.equal(s.quote({ itemId: 'h1', start: '2026-07-01T00:00:00Z', end: '2026-07-01T05:00:00Z' }).total, 3000);
+  assert.equal(s.quote({ itemId: 'h1', start: '2026-07-01T20:00:00Z', end: '2026-07-02T00:00:00Z' }).total, 2400);
+});
