@@ -173,3 +173,35 @@ test('an hourly rental may start or end at midnight', () => {
   assert.equal(s.quote({ itemId: 'h1', start: '2026-07-01T00:00:00Z', end: '2026-07-01T05:00:00Z' }).total, 3000);
   assert.equal(s.quote({ itemId: 'h1', start: '2026-07-01T20:00:00Z', end: '2026-07-02T00:00:00Z' }).total, 2400);
 });
+
+test('cancelling before the start refunds the whole total and frees the equipment', () => {
+  const s = hourly();
+  const b = s.book({ itemId: 'h1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T17:00:00Z' });
+  assert.deepEqual(s.cancel(b.id, '2026-07-01T12:59:59Z'), { bookingId: b.id, refund: 2400 });
+  assert.deepEqual(s.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }), ['d1', 'h1']);
+  assert.doesNotThrow(() => s.book({ itemId: 'h1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T17:00:00Z' }));
+});
+
+test('cancelling at or after the start refunds nothing but still frees the equipment', () => {
+  const s = hourly();
+  const b = s.book({ itemId: 'h1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T17:00:00Z' });
+  assert.deepEqual(s.cancel(b.id, '2026-07-01T13:00:00Z'), { bookingId: b.id, refund: 0 });
+  assert.doesNotThrow(() => s.book({ itemId: 'h1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T17:00:00Z' }));
+});
+
+test('a booking can only be cancelled once, and only if it exists', () => {
+  const s = hourly();
+  const b = s.book({ itemId: 'd1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  s.cancel(b.id, '2026-06-01T00:00:00Z');
+  assert.throws(() => s.cancel(b.id, '2026-06-02T00:00:00Z'), /already cancelled/);
+  assert.throws(() => s.cancel('booking-99', '2026-06-01T00:00:00Z'), /unknown booking/);
+});
+
+test('cancel rejects an invalid time and leaves the booking active', () => {
+  const s = hourly();
+  const b = s.book({ itemId: 'd1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  for (const at of ['2026-06-01', '2026-06-01T00:00:00+02:00', '2026-13-01T00:00:00Z', 'soon']) {
+    assert.throws(() => s.cancel(b.id, at), undefined, at);
+  }
+  assert.deepEqual(s.cancel(b.id, '2026-06-01T00:00:00Z'), { bookingId: b.id, refund: 2500 });
+});
