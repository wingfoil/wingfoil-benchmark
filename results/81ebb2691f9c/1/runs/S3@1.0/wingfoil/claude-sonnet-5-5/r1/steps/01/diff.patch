--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,120 @@
+const MS_PER_DAY = 86_400_000;
+const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?Z$/;
+
+/** What the school rents out. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item; `dailyPrice` is an integer number of euro cents per day. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** A rental period: ISO-8601 UTC midnights, `end` being the start of the day after the last day. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The cost of renting an item for a period, in euro cents. */
+export interface Quote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed booking. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** The booking desk's in-memory rental service. */
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+interface Period {
+  from: number;
+  to: number;
+}
+
+function parseMidnight(value: unknown, label: string): number {
+  if (typeof value !== 'string' || !UTC_MIDNIGHT.test(value)) {
+    throw new Error(`${label} must be an ISO-8601 UTC midnight, got ${String(value)}`);
+  }
+  const time = Date.parse(value);
+  if (Number.isNaN(time)) {
+    throw new Error(`${label} is not a valid date: ${value}`);
+  }
+  return time;
+}
+
+function parsePeriod(request: RentalRequest): Period {
+  const from = parseMidnight(request.start, 'start');
+  const to = parseMidnight(request.end, 'end');
+  if (to <= from) {
+    throw new Error('end must be after start');
+  }
+  return { from, to };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item.id !== 'string' || item.id === '') {
+    throw new Error('equipment id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error(`unknown equipment kind: ${String(item.kind)}`);
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+  }
+}
+
+const overlaps = (a: Period, b: Period): boolean => a.from < b.to && b.from < a.to;
+
+/** Creates an empty rental service that keeps everything in memory. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Array<Booking & { period: Period }> = [];
+
+  function price(request: RentalRequest): { quote: Quote; period: Period } {
+    const item = equipment.get(request.itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${request.itemId}`);
+    }
+    const period = parsePeriod(request);
+    const days = (period.to - period.from) / MS_PER_DAY;
+    const total = days * item.dailyPrice;
+    if (!Number.isSafeInteger(total)) {
+      throw new Error('total is not a safe integer number of euro cents');
+    }
+    return { quote: { itemId: request.itemId, start: request.start, end: request.end, total }, period };
+  }
+
+  return {
+    addEquipment(item) {
+      validateEquipment(item);
+      if (equipment.has(item.id)) {
+        throw new Error(`equipment already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, period } = price(request);
+      const clash = bookings.some((b) => b.itemId === quote.itemId && overlaps(b.period, period));
+      if (clash) {
+        throw new Error(`${quote.itemId} is not free from ${quote.start} to ${quote.end}`);
+      }
+      const booking: Booking = { id: `booking-${bookings.length + 1}`, ...quote };
+      bookings.push({ ...booking, period });
+      return booking;
+    },
+  };
+}
