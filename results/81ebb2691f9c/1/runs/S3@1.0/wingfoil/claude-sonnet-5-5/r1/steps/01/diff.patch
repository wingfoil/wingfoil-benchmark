@@ -0,0 +1,73 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+const service = () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  return s;
+};
+
+test('quote prices whole days at the daily price', () => {
+  const q = service().quote({ itemId: 'b1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.deepEqual(q, { itemId: 'b1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z', total: 7500 });
+});
+
+test('quote accepts equivalent UTC spellings of midnight', () => {
+  const q = service().quote({ itemId: 'b1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00Z' });
+  assert.equal(q.total, 2500);
+});
+
+test('quote rejects unknown items', () => {
+  assert.throws(() => service().quote({ itemId: 'x', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+});
+
+test('quote rejects periods that are not whole UTC days', () => {
+  const s = service();
+  for (const [start, end] of [
+    ['2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z'],
+    ['2026-07-01T00:00:00+02:00', '2026-07-02T00:00:00Z'],
+    ['2026-07-01T00:00:00Z', '2026-07-01T00:00:00Z'],
+    ['2026-07-02T00:00:00Z', '2026-07-01T00:00:00Z'],
+    ['2026-07-01', '2026-07-02T00:00:00Z'],
+    ['nonsense', '2026-07-02T00:00:00Z'],
+  ]) {
+    assert.throws(() => s.quote({ itemId: 'b1', start, end }), `${start} -> ${end}`);
+  }
+});
+
+test('addEquipment validates the item', () => {
+  const s = createRentalService();
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'boat' as 'board', dailyPrice: 100 }));
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'board', dailyPrice: 10.5 }));
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'board', dailyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: '', kind: 'board', dailyPrice: 100 }));
+  s.addEquipment({ id: 'a', kind: 'sail', dailyPrice: 100 });
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'sail', dailyPrice: 100 }));
+});
+
+test('book returns a booking with a distinct id', () => {
+  const s = service();
+  const a = s.book({ itemId: 'b1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  const b = s.book({ itemId: 'b1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.equal(a.total, 2500);
+  assert.equal(a.itemId, 'b1');
+  assert.notEqual(a.id, b.id);
+});
+
+test('book rejects overlapping periods for the same item only', () => {
+  const s = service();
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  s.book({ itemId: 'b1', start: '2026-07-02T00:00:00Z', end: '2026-07-05T00:00:00Z' });
+  for (const [start, end] of [
+    ['2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'],
+    ['2026-07-04T00:00:00Z', '2026-07-06T00:00:00Z'],
+    ['2026-07-03T00:00:00Z', '2026-07-04T00:00:00Z'],
+    ['2026-07-01T00:00:00Z', '2026-07-09T00:00:00Z'],
+  ]) {
+    assert.throws(() => s.book({ itemId: 'b1', start, end }), `${start} -> ${end}`);
+  }
+  s.book({ itemId: 'b1', start: '2026-07-05T00:00:00Z', end: '2026-07-06T00:00:00Z' });
+  s.book({ itemId: 'b1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  s.book({ itemId: 's1', start: '2026-07-02T00:00:00Z', end: '2026-07-05T00:00:00Z' });
+});
