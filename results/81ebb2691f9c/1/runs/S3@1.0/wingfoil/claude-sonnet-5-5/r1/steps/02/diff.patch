@@ -71,3 +71,35 @@ test('book rejects overlapping periods for the same item only', () => {
   s.book({ itemId: 'b1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
   s.book({ itemId: 's1', start: '2026-07-02T00:00:00Z', end: '2026-07-05T00:00:00Z' });
 });
+
+const fleet = () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  return s;
+};
+
+test('availability lists free equipment sorted, of any kind when none is given', () => {
+  const s = fleet();
+  s.book({ itemId: 'b1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  const q = { start: '2026-07-01T00:00:00Z', end: '2026-07-05T00:00:00Z' };
+  assert.deepEqual(s.availability(q), ['b2', 's1']);
+  assert.deepEqual(s.availability({ ...q, kind: 'board' }), ['b2']);
+  assert.deepEqual(s.availability({ ...q, kind: 'sail' }), ['s1']);
+});
+
+test('availability treats periods as half-open', () => {
+  const s = fleet();
+  s.book({ itemId: 'b1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.deepEqual(s.availability({ start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z', kind: 'board' }), ['b1', 'b2']);
+  assert.deepEqual(s.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'board' }), ['b1', 'b2']);
+});
+
+test('availability is empty when nothing matches and rejects bad queries', () => {
+  const s = fleet();
+  assert.deepEqual(createRentalService().availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }), []);
+  assert.throws(() => s.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+  assert.throws(() => s.availability({ start: '2026-07-01T10:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.throws(() => s.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'kayak' as never }));
+});
