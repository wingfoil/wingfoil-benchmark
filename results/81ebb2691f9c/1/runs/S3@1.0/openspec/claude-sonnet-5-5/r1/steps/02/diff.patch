diff --git a/src/index.test.ts b/src/index.test.ts
index ed8da83825f23daa1b49a10ddd917237f5a40065..5634cb7d9d6c9d9e8bdfec63e2971f6165c37bf8 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -52,3 +52,27 @@ test('quote does not reserve; no cancellation operation', () => {
   s.book({ itemId: 'b1', start: d(1), end: d(4) });
   assert.equal('cancel' in s, false);
 });
+
+test('availability lists free items sorted, filtered by kind', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 1 });
+  assert.deepEqual(s.availability({ start: d(1), end: d(4) }), ['a0', 'b1', 's1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(4), kind: 'board' }), ['a0', 'b1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(4), kind: 'sail' }), ['s1']);
+});
+
+test('availability excludes overlaps, allows back-to-back, reserves nothing', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: d(3), end: d(5) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(4), kind: 'board' }), []);
+  assert.deepEqual(s.availability({ start: d(5), end: d(6), kind: 'board' }), ['b1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3), kind: 'board' }), ['b1']);
+  s.book({ itemId: 's1', start: d(1), end: d(3) });
+});
+
+test('availability rejects invalid queries', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: d(2), end: d(2) }));
+  assert.throws(() => s.availability({ start: '2026-07-01T10:00:00Z', end: d(2) }));
+  assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'boat' as any }));
+});
