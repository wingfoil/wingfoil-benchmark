index 05cce4ba652f1bc49f402f225711ad9070272452..37c44935ed770ace8eba97306a40b9fae8ba3b19 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -91,3 +91,36 @@ test('availability rejects invalid queries', () => {
   assert.throws(() => s.availability({ start: '2026-07-01T10:00:00Z', end: d(2) }));
   assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'boat' as any }));
 });
+
+const t = (day: number, hour: number) => `2026-07-${String(day).padStart(2, '0')}T${String(hour).padStart(2, '0')}:00:00.000Z`;
+
+test('hourly rentals are priced per hour, without discount', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2500, hourlyPrice: 500 });
+  assert.equal(s.quote({ itemId: 'h', start: t(1, 13), end: t(1, 17) }).total, 2000);
+  assert.equal(s.quote({ itemId: 'h', start: t(1, 22), end: t(2, 2) }).total, 2000);
+  assert.equal(s.book({ itemId: 'h', start: t(3, 9), end: t(3, 12) }).total, 1500);
+  assert.equal(s.quote({ itemId: 'h', start: d(1), end: d(4) }).total, 6750);
+});
+
+test('hourly rentals need an hourly price, whole hours and less than a day', () => {
+  const s = setup();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2500, hourlyPrice: 500 });
+  assert.throws(() => s.quote({ itemId: 'b1', start: t(1, 13), end: t(1, 17) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: t(1, 13), end: t(1, 17) }));
+  assert.throws(() => s.quote({ itemId: 'h', start: '2026-07-01T13:30:00Z', end: t(1, 17) }));
+  assert.throws(() => s.quote({ itemId: 'h', start: t(1, 10), end: t(2, 10) }));
+  assert.throws(() => s.quote({ itemId: 'h', start: t(1, 10), end: t(1, 10) }));
+  assert.throws(() => s.quote({ itemId: 'h', start: t(1, 10), end: d(3) }));
+});
+
+test('hourlyPrice is validated and hourly bookings cannot overlap', () => {
+  const s = createRentalService();
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2500, hourlyPrice: 500 });
+  s.book({ itemId: 'h', start: t(1, 13), end: t(1, 17) });
+  assert.throws(() => s.book({ itemId: 'h', start: t(1, 16), end: t(1, 18) }));
+  s.book({ itemId: 'h', start: t(1, 17), end: t(1, 18) });
+  assert.throws(() => s.book({ itemId: 'h', start: d(1), end: d(2) }));
+});
