@@ -0,0 +1,54 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+const d = (day: number) => `2026-07-${String(day).padStart(2, '0')}T00:00:00.000Z`;
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  return s;
+}
+
+test('registration rejects invalid items', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'boat' as any, dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'y', kind: 'sail', dailyPrice: 1.5 }));
+});
+
+test('quote totals days times price', () => {
+  assert.deepEqual(setup().quote({ itemId: 'b1', start: d(1), end: d(4) }), {
+    itemId: 'b1', start: d(1), end: d(4), total: 7500,
+  });
+});
+
+test('disallowed periods and unknown items throw', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'nope', start: d(1), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(1), end: d(1) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(2), end: d(1) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T10:00:00Z', end: d(2) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: '2026-07-01T00:00:00+02:00', end: d(2) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: '2026-02-30T00:00:00Z', end: d(2) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: '2026-07-01', end: d(2) }));
+});
+
+test('book returns unique ids and rejects overlaps', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.equal(a.total, 7500);
+  assert.throws(() => s.book({ itemId: 'b1', start: d(3), end: d(5) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(1), end: d(2) }));
+  const b = s.book({ itemId: 'b1', start: d(4), end: d(6) });
+  assert.notEqual(a.id, b.id);
+  s.book({ itemId: 's1', start: d(1), end: d(4) });
+});
+
+test('quote does not reserve; no cancellation operation', () => {
+  const s = setup();
+  s.quote({ itemId: 'b1', start: d(1), end: d(4) });
+  s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.equal('cancel' in s, false);
+});
