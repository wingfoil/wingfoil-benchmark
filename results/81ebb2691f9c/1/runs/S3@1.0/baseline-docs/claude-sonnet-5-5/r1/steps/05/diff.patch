diff --git a/test/rental.test.ts b/test/rental.test.ts
index 718e56bc006d597ac513f63b5603fbb23a7a868e..44a2c67d84fa2f1eeb11001f4b9d311a36a7a171 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -240,4 +240,41 @@ describe('rental service', () => {
       assert.throws(() => service.availability({ ...period(1, 2), kind: 'kayak' as never }), /kind/);
     });
   });
+
+  describe('cancel', () => {
+    it('refunds the full total when cancelled at least 24 hours before the start', () => {
+      const booking = service.book(jun(10, 13));
+      assert.deepEqual(service.cancel(booking.id, '2026-06-09T00:00:00.000Z'), {
+        bookingId: booking.id,
+        refund: 12150,
+      });
+    });
+
+    it('refunds nothing when cancelled less than 24 hours before the start or after it', () => {
+      const first = service.book(jun(10, 11));
+      const second = service.book(jun(20, 21));
+      assert.equal(service.cancel(first.id, '2026-06-09T00:00:00.001Z').refund, 0);
+      assert.equal(service.cancel(second.id, '2026-06-22T00:00:00.000Z').refund, 0);
+    });
+
+    it('frees the equipment', () => {
+      const booking = service.book(jun(10, 12));
+      service.cancel(booking.id, '2026-06-01T00:00:00.000Z');
+      assert.deepEqual(service.availability(jun(10, 12)), ['board-1', 'sail-1']);
+      assert.doesNotThrow(() => service.book(jun(10, 12)));
+    });
+
+    it('cancels a booking only once', () => {
+      const booking = service.book(jun(10, 12));
+      service.cancel(booking.id, '2026-06-01T00:00:00.000Z');
+      assert.throws(() => service.cancel(booking.id, '2026-06-01T00:00:00.000Z'));
+    });
+
+    it('throws for an unknown booking and keeps a booking on an invalid time', () => {
+      const booking = service.book(jun(10, 12));
+      assert.throws(() => service.cancel('booking-99', '2026-06-01T00:00:00.000Z'));
+      assert.throws(() => service.cancel(booking.id, 'tomorrow'));
+      assert.throws(() => service.book(jun(10, 12)));
+    });
+  });
 });
