+  describe('hourly rental', () => {
+    const at = (day: number, hour: number) => `2026-06-${String(day).padStart(2, '0')}T${String(hour).padStart(2, '0')}:00:00.000Z`;
+    const hours = (from: string, to: string, itemId = 'hourly') => ({ itemId, start: from, end: to });
+
+    beforeEach(() => {
+      service.addEquipment({ id: 'hourly', kind: 'board', dailyPrice: 4500, hourlyPrice: 900 });
+    });
+
+    it('prices each hour at the hourly price', () => {
+      const request = hours(at(1, 13), at(1, 17));
+      assert.deepEqual(service.quote(request), { ...request, total: 3600 });
+    });
+
+    it('prices a rental running past midnight, under a day, by the hour', () => {
+      assert.equal(service.quote(hours(at(1, 22), at(2, 2))).total, 3600);
+      assert.equal(service.quote(hours(at(1, 0), at(1, 23))).total, 20700);
+    });
+
+    it('accepts a rental from midnight or up to midnight', () => {
+      assert.equal(service.quote(hours(at(1, 0), at(1, 3))).total, 2700);
+      assert.equal(service.quote(hours(at(1, 20), at(2, 0))).total, 3600);
+    });
+
+    it('rejects an item without an hourly price', () => {
+      assert.throws(() => service.quote(hours(at(1, 13), at(1, 15), 'board-1')), /hourly/);
+    });
+
+    it('rejects times that are not on the hour', () => {
+      for (const [start, end] of [
+        ['2026-06-01T13:30:00Z', '2026-06-01T15:00:00Z'],
+        ['2026-06-01T13:00:00Z', '2026-06-01T15:00:01Z'],
+        ['2026-06-01T13:00:00+02:00', '2026-06-01T15:00:00Z'],
+      ]) {
+        assert.throws(() => service.quote(hours(start, end)), /start|end/);
+      }
+    });
+
+    it('rejects an empty or reversed period', () => {
+      assert.throws(() => service.quote(hours(at(1, 13), at(1, 13))), /after start/);
+      assert.throws(() => service.quote(hours(at(1, 15), at(1, 13))), /after start/);
+    });
+
+    it('rejects a day or more that is not whole days', () => {
+      assert.throws(() => service.quote(hours(at(1, 10), at(2, 10))), /midnight/);
+      assert.throws(() => service.quote(hours(at(1, 0), at(2, 10))), /midnight/);
+    });
+
+    it('keeps pricing whole days at the daily price', () => {
+      assert.equal(service.quote(hours(at(1, 0), at(2, 0))).total, 4500);
+    });
+
