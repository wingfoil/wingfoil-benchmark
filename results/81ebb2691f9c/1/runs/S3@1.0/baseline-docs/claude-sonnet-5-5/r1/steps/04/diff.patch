+      assert.throws(() => service.book(hours(at(1, 0), at(2, 0))), /not free/);
+      assert.doesNotThrow(() => service.book(hours(at(1, 15), at(1, 16))));
+    });
+
+    it('takes hourly periods into account in availability', () => {
+      service.book(hours(at(1, 13), at(1, 15)));
