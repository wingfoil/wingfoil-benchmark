+/** Prices `days` days at `dailyPrice` cents; a stay of 3 days or more is 10% cheaper, rounded half up to the cent. */
+function rentalTotal(days: number, dailyPrice: number): number {
+  const fullPrice = days * dailyPrice;
+  if (days < LONG_STAY_DAYS) {
+    return fullPrice;
+  }
+  return Math.floor((fullPrice * LONG_STAY_PERCENT_PAID + 50) / 100);
+}
