diff --git a/test/rental.test.ts b/test/rental.test.ts
index b29da0562050e4d5d07e50f91f093c526329c7ea..1d65b383336a581a07610581391112c5e04baef7 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -106,4 +106,47 @@ describe('rental service', () => {
       assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1 }), /already exists/);
     });
   });
+
+  describe('availability', () => {
+    const period = (from: number, to: number) => {
+      const { start, end } = jun(from, to);
+      return { start, end };
+    };
+
+    beforeEach(() => {
+      service.addEquipment({ id: 'board-0', kind: 'board', dailyPrice: 3000 });
+    });
+
+    it('lists the ids of all free items of any kind, sorted', () => {
+      assert.deepEqual(service.availability(period(1, 3)), ['board-0', 'board-1', 'sail-1']);
+    });
+
+    it('restricts the list to the given kind', () => {
+      assert.deepEqual(service.availability({ ...period(1, 3), kind: 'sail' }), ['sail-1']);
+    });
+
+    it('leaves out items booked for part of the period', () => {
+      service.book(jun(2, 4));
+      assert.deepEqual(service.availability(period(1, 3)), ['board-0', 'sail-1']);
+      assert.deepEqual(service.availability(period(3, 6)), ['board-0', 'sail-1']);
+      assert.deepEqual(service.availability(period(1, 6)), ['board-0', 'sail-1']);
+    });
+
+    it('keeps items booked back-to-back with the period', () => {
+      service.book(jun(1, 3));
+      assert.deepEqual(service.availability({ ...period(3, 5), kind: 'board' }), ['board-0', 'board-1']);
+      assert.deepEqual(service.availability({ ...period(1, 2), kind: 'board' }), ['board-0']);
+    });
+
+    it('returns an empty list when nothing is free', () => {
+      service.book(jun(1, 3, 'sail-1'));
+      assert.deepEqual(service.availability({ ...period(1, 3), kind: 'sail' }), []);
+    });
+
+    it('rejects a disallowed period or an invalid kind', () => {
+      assert.throws(() => service.availability(period(3, 3)), /end must be after start/);
+      assert.throws(() => service.availability({ start: '2026-06-01T10:00:00.000Z', end: '2026-06-02T00:00:00.000Z' }), /midnight/);
+      assert.throws(() => service.availability({ ...period(1, 2), kind: 'kayak' as never }), /kind/);
+    });
+  });
 });
