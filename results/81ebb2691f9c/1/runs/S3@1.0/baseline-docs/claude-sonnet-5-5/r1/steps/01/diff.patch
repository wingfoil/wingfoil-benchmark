--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,129 @@
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00(:00(\.0+)?)?(Z|\+00:00)$/;
+
+/** The kinds of equipment the school rents out. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item; `dailyPrice` is the cost of one day, in integer euro cents. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** A rental period for an item: UTC midnight ISO-8601 strings, `end` being the start of the day after the last day. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The price of renting an item for a period; `total` is in integer euro cents. */
+export interface Quote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed booking; `id` identifies it. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** The in-memory rental service of the booking desk. */
+export interface RentalService {
+  /** Registers an item for rental; throws on an invalid item or a duplicate id. */
+  addEquipment(item: Equipment): void;
+  /** Prices a rental; throws for an unknown item or a disallowed period. */
+  quote(request: RentalRequest): Quote;
+  /** Books an item; throws like `quote`, and when the item is not free for the whole period. */
+  book(request: RentalRequest): Booking;
+}
+
+interface Period {
+  from: number;
+  to: number;
+}
+
+function parseMidnight(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 string at midnight UTC`);
+  }
+  const time = Date.parse(value);
+  if (Number.isNaN(time)) {
+    throw new Error(`${name} is not a valid date`);
+  }
+  return time;
+}
+
+function parsePeriod(request: RentalRequest): Period {
+  const from = parseMidnight(request.start, 'start');
+  const to = parseMidnight(request.end, 'end');
+  if (to <= from) {
+    throw new Error('end must be after start');
+  }
+  return { from, to };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item.id !== 'string' || item.id === '') {
+    throw new Error('id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error("kind must be 'board' or 'sail'");
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('dailyPrice must be a non-negative integer number of cents');
+  }
+}
+
+function overlaps(a: Period, b: Period): boolean {
+  return a.from < b.to && b.from < a.to;
+}
+
+/** Creates an empty rental service that keeps its equipment and bookings in memory. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const booked = new Map<string, Period[]>();
+  let bookingCount = 0;
+
+  function price(request: RentalRequest): { quote: Quote; period: Period } {
+    const item = equipment.get(request.itemId);
+    if (item === undefined) {
+      throw new Error(`unknown item: ${String(request.itemId)}`);
+    }
+    const period = parsePeriod(request);
+    const days = (period.to - period.from) / DAY_MS;
+    const quote = {
+      itemId: item.id,
+      start: new Date(period.from).toISOString(),
+      end: new Date(period.to).toISOString(),
+      total: days * item.dailyPrice,
+    };
+    return { quote, period };
+  }
+
+  return {
+    addEquipment(item) {
+      validateEquipment(item);
+      if (equipment.has(item.id)) {
+        throw new Error(`item already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+      booked.set(item.id, []);
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, period } = price(request);
+      const periods = booked.get(quote.itemId) ?? [];
+      if (periods.some((existing) => overlaps(existing, period))) {
+        throw new Error(`item ${quote.itemId} is not free for the whole period`);
+      }
+      periods.push(period);
+      bookingCount += 1;
+      return { id: `booking-${bookingCount}`, ...quote };
+    },
+  };
+}
diff --git a/test/rental.test.ts b/test/rental.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b29da0562050e4d5d07e50f91f093c526329c7ea
--- /dev/null
+++ b/test/rental.test.ts
@@ -0,0 +1,109 @@
+import assert from 'node:assert/strict';
+import { beforeEach, describe, it } from 'node:test';
+import { createRentalService, type RentalService } from '../src/index.ts';
+
+describe('rental service', () => {
+  let service: RentalService;
+
+  beforeEach(() => {
+    service = createRentalService();
+    service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 4500 });
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 2000 });
+  });
+
+  const jun = (from: number, to: number, itemId = 'board-1') => ({
+    itemId,
+    start: `2026-06-${String(from).padStart(2, '0')}T00:00:00.000Z`,
+    end: `2026-06-${String(to).padStart(2, '0')}T00:00:00.000Z`,
+  });
+
+  describe('quote', () => {
+    it('prices whole days in integer cents', () => {
+      assert.deepEqual(service.quote(jun(1, 4)), { ...jun(1, 4), total: 13500 });
+    });
+
+    it('normalises equivalent UTC spellings', () => {
+      const quote = service.quote({ itemId: 'sail-1', start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' });
+      assert.deepEqual(quote, { ...jun(1, 2, 'sail-1'), total: 2000 });
+    });
+
+    it('does not reserve the item', () => {
+      service.quote(jun(1, 2));
+      assert.doesNotThrow(() => service.book(jun(1, 2)));
+    });
+
+    it('rejects an unknown item', () => {
+      assert.throws(() => service.quote(jun(1, 2, 'nope')), /unknown item/);
+    });
+
+    it('rejects periods not at midnight UTC', () => {
+      for (const [start, end] of [
+        ['2026-06-01T10:00:00Z', '2026-06-02T10:00:00Z'],
+        ['2026-06-01T00:00:00+02:00', '2026-06-02T00:00:00Z'],
+        ['2026-06-01', '2026-06-02'],
+        ['2026-06-01T00:00:00', '2026-06-02T00:00:00'],
+        ['2026-02-30T00:00:00Z', '2026-03-02T00:00:00Z'],
+      ]) {
+        assert.throws(() => service.quote({ itemId: 'board-1', start, end }), /start|end/);
+      }
+    });
+
+    it('rejects an empty or reversed period', () => {
+      assert.throws(() => service.quote(jun(2, 2)), /after start/);
+      assert.throws(() => service.quote(jun(3, 2)), /after start/);
+    });
+  });
+
+  describe('book', () => {
+    it('returns a booking with an id and the quoted total', () => {
+      const booking = service.book(jun(1, 3));
+      assert.equal(booking.total, 9000);
+      assert.deepEqual({ ...booking, id: undefined }, { ...jun(1, 3), total: 9000, id: undefined });
+    });
+
+    it('gives each booking its own id', () => {
+      assert.notEqual(service.book(jun(1, 2)).id, service.book(jun(2, 3)).id);
+    });
+
+    it('rejects overlapping periods for the same item', () => {
+      service.book(jun(5, 8));
+      for (const [from, to] of [[5, 8], [6, 7], [4, 6], [7, 10], [1, 20]]) {
+        assert.throws(() => service.book(jun(from, to)), /not free/);
+      }
+    });
+
+    it('allows back-to-back periods and other items', () => {
+      service.book(jun(5, 8));
+      assert.doesNotThrow(() => service.book(jun(8, 9)));
+      assert.doesNotThrow(() => service.book(jun(3, 5)));
+      assert.doesNotThrow(() => service.book(jun(5, 8, 'sail-1')));
+    });
+
+    it('does not record a failed booking', () => {
+      assert.throws(() => service.book(jun(2, 2)));
+      assert.doesNotThrow(() => service.book(jun(1, 3)));
+    });
+
+    it('rejects an unknown item', () => {
+      assert.throws(() => service.book(jun(1, 2, 'nope')), /unknown item/);
+    });
+  });
+
+  describe('addEquipment', () => {
+    it('rejects invalid items', () => {
+      const bad = [
+        { id: '', kind: 'board', dailyPrice: 100 },
+        { id: 'x', kind: 'kayak', dailyPrice: 100 },
+        { id: 'x', kind: 'board', dailyPrice: 10.5 },
+        { id: 'x', kind: 'board', dailyPrice: -1 },
+      ];
+      for (const item of bad) {
+        assert.throws(() => service.addEquipment(item as never));
+      }
+    });
+
+    it('rejects a duplicate id', () => {
+      assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1 }), /already exists/);
+    });
+  });
+});
