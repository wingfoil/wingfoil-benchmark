diff --git a/test/rental.test.ts b/test/rental.test.ts
index 55873d19d7e213f861a762e7b67117f5d8a81a2e..3b81e187640f9b92e1b3e81dd223c1874bec183d 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -200,3 +200,77 @@ test('services are independent of each other', () => {
   b.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 100 });
   assert.doesNotThrow(() => b.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-05' }));
 });
+
+test('availability lists every item when no kind is given, sorted', () => {
+  const service = setup();
+  service.addEquipment({ id: 'a-board', kind: 'board', dailyPrice: 100 });
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01', end: '2026-07-02' }),
+    ['a-board', 'board-1', 'sail-1'],
+  );
+});
+
+test('availability filters by kind', () => {
+  const service = setup();
+  service.addEquipment({ id: 'sail-0', kind: 'sail', dailyPrice: 100 });
+  assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-02', kind: 'sail' }), [
+    'sail-0',
+    'sail-1',
+  ]);
+  assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-02', kind: 'board' }), [
+    'board-1',
+  ]);
+});
+
+test('availability leaves out items booked for any part of the period', () => {
+  const service = setup();
+  service.book({ itemId: 'board-1', start: '2026-07-03', end: '2026-07-05' });
+  assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-04' }), ['sail-1']);
+  assert.deepEqual(service.availability({ start: '2026-07-04', end: '2026-07-05' }), ['sail-1']);
+  assert.deepEqual(service.availability({ start: '2026-07-05', end: '2026-07-06' }), [
+    'board-1',
+    'sail-1',
+  ]);
+});
+
+test('availability treats back-to-back periods as free', () => {
+  const service = setup();
+  service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-03' });
+  assert.deepEqual(service.availability({ start: '2026-07-03', end: '2026-07-04', kind: 'board' }), [
+    'board-1',
+  ]);
+  assert.deepEqual(service.availability({ start: '2026-06-30', end: '2026-07-01', kind: 'board' }), [
+    'board-1',
+  ]);
+});
+
+test('availability returns an empty list when nothing is free', () => {
+  const service = setup();
+  service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-02' });
+  service.book({ itemId: 'sail-1', start: '2026-07-01', end: '2026-07-02' });
+  assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-02' }), []);
+});
+
+test('availability does not reserve anything', () => {
+  const service = setup();
+  service.availability({ start: '2026-07-01', end: '2026-07-03' });
+  assert.doesNotThrow(() =>
+    service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-03' }),
+  );
+});
+
+test('availability refuses an invalid period or kind', () => {
+  const service = setup();
+  assert.throws(
+    () => service.availability({ start: '2026-07-01T10:00:00Z', end: '2026-07-02' }),
+    /ISO-8601 UTC midnight/,
+  );
+  assert.throws(
+    () => service.availability({ start: '2026-07-02', end: '2026-07-02' }),
+    /end must be after start/,
+  );
+  assert.throws(
+    () => service.availability({ start: '2026-07-01', end: '2026-07-02', kind: 'kite' as 'board' }),
+    /kind must be/,
+  );
+});
