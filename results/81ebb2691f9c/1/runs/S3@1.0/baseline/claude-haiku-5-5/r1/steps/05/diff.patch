diff --git a/test/rental.test.ts b/test/rental.test.ts
index c46e7506985ffcb3b8666b1fed17edf4744042dc..ac87014a6a647193fc5ea0462c4b7e44d92ca926 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -392,3 +392,58 @@ test('availability refuses an invalid period or kind', () => {
     /kind must be/,
   );
 });
+
+test('cancelling before the rental starts refunds the whole booking', () => {
+  const service = setup();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+  assert.deepEqual(service.cancel(booking.id, '2026-06-30T09:00:00Z'), {
+    bookingId: booking.id,
+    refund: 6750,
+  });
+});
+
+test('cancelling once the rental has started refunds nothing', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 800 });
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' });
+  assert.equal(service.cancel(booking.id, '2026-07-01T10:00:00Z').refund, 0);
+  const other = service.book({ itemId: 'board-1', start: '2026-07-01T12:00:00Z', end: '2026-07-01T14:00:00Z' });
+  assert.equal(service.cancel(other.id, '2026-07-01T13:00:00Z').refund, 0);
+});
+
+test('a cancelled booking no longer holds its equipment', () => {
+  const service = setup();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+  assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-04', kind: 'board' }), []);
+  service.cancel(booking.id, '2026-06-30T00:00:00Z');
+  assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-04', kind: 'board' }), [
+    'board-1',
+  ]);
+  assert.doesNotThrow(() =>
+    service.book({ itemId: 'board-1', start: '2026-07-02', end: '2026-07-03' }),
+  );
+});
+
+test('a booking can only be cancelled once', () => {
+  const service = setup();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+  service.cancel(booking.id, '2026-06-30T00:00:00Z');
+  assert.throws(() => service.cancel(booking.id, '2026-06-29T00:00:00Z'), /already cancelled/);
+});
+
+test('cancel refuses an unknown booking', () => {
+  const service = setup();
+  assert.throws(() => service.cancel('missing', '2026-06-30T00:00:00Z'), /unknown booking/);
+});
+
+test('cancel refuses an invalid time and leaves the booking holding its equipment', () => {
+  const service = setup();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+  assert.throws(() => service.cancel(booking.id, '2026-06-30T09:30:00Z'), /at must be an ISO-8601 UTC time on the hour/);
+  assert.throws(() => service.cancel(booking.id, 'soon'), /at must be/);
+  assert.throws(
+    () => service.book({ itemId: 'board-1', start: '2026-07-02', end: '2026-07-03' }),
+    /overlapping/,
+  );
+  assert.equal(service.cancel(booking.id, '2026-06-30T00:00:00Z').refund, 6750);
+});
