@@ -55,3 +55,19 @@ test('rentals of 3 days or more cost 10% less, in quotes and bookings', () => {
   // 3015 * 0.9 = 2713.5 -> rounds up to 2714
   assert.equal(s.quote({ itemId: 'odd', start: d(1), end: d(4) }).total, 2714);
