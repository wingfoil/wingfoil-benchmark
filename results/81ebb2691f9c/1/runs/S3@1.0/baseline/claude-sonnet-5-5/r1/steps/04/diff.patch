+
+test('rentals shorter than a day are priced per hour', () => {
+  const s = setup();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  const start = '2026-07-01T13:00:00Z';
+  const end = '2026-07-01T17:00:00.000Z';
+  assert.equal(s.quote({ itemId: 'h1', start, end }).total, 2400);
+  assert.equal(s.quote({ itemId: 'h1', start: '2026-07-01T22:00:00Z', end: d(2) }).total, 1200);
+  assert.throws(() => s.quote({ itemId: 'b1', start, end }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-07-01T13:30:00Z', end }));
+  assert.throws(() => s.quote({ itemId: 'h1', start, end: '2026-07-02T13:00:00Z' }));
+  s.book({ itemId: 'h1', start, end });
+  assert.throws(() => s.book({ itemId: 'h1', start: '2026-07-01T16:00:00Z', end: d(2) }));
+  s.book({ itemId: 'h1', start: end, end: d(2) });
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+});
