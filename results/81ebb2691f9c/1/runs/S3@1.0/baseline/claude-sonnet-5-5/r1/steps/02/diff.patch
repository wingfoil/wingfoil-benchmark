   const b = s.book({ itemId: 'b1', start: d(3), end: d(4) });
   assert.notEqual(a.id, b.id);
 });
+
+test('availability lists free items of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a-sail', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'b0', kind: 'board', dailyPrice: 2500 });
+  s.book({ itemId: 'b1', start: d(2), end: d(4) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(2) }), ['a-sail', 'b0', 'b1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3) }), ['a-sail', 'b0']);
+  assert.deepEqual(s.availability({ start: d(3), end: d(6), kind: 'board' }), ['b0']);
+  assert.deepEqual(s.availability({ start: d(4), end: d(5), kind: 'board' }), ['b0', 'b1']);
+  assert.throws(() => s.availability({ start: d(3), end: d(3) }));
+});
