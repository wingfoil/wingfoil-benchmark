 }
 
 const DAY_MS = 86_400_000;
@@ -46,6 +57,13 @@ function parseInstant(value: unknown, name: string): number {
   return ms;
 }
 
+function parsePeriod(start: unknown, end: unknown) {
+  const startMs = parseInstant(start, 'start');
+  const endMs = parseInstant(end, 'end');
+  if (endMs <= startMs) throw new Error('end must be after start');
+  return { startMs, endMs };
+}
+
 export function createRentalService(): RentalService {
   const equipment = new Map<string, Equipment>();
   const bookings: (Booking & { startMs: number; endMs: number })[] = [];
@@ -54,9 +72,7 @@ export function createRentalService(): RentalService {
   function price(request: RentalRequest) {
     const item = equipment.get(request?.itemId);
     if (!item) throw new Error(`Unknown item: ${String(request?.itemId)}`);
-    const startMs = parseInstant(request.start, 'start');
-    const endMs = parseInstant(request.end, 'end');
-    if (endMs <= startMs) throw new Error('end must be after start');
+    const { startMs, endMs } = parsePeriod(request.start, request.end);
     const total = ((endMs - startMs) / DAY_MS) * item.dailyPrice;
     if (!Number.isSafeInteger(total)) throw new Error('total is too large');
     const quote: Quote = {
@@ -93,5 +109,18 @@ export function createRentalService(): RentalService {
       bookings.push({ ...booking, startMs, endMs });
       return booking;
     },
+
+    availability(query) {
+      const { startMs, endMs } = parsePeriod(query?.start, query?.end);
+      const kind = query.kind;
+      if (kind !== undefined && kind !== 'board' && kind !== 'sail') {
+        throw new Error("kind must be 'board' or 'sail'");
+      }
+      return [...equipment.values()]
+        .filter((item) => kind === undefined || item.kind === kind)
+        .filter((item) => !bookings.some((b) => b.itemId === item.id && b.startMs < endMs && startMs < b.endMs))
