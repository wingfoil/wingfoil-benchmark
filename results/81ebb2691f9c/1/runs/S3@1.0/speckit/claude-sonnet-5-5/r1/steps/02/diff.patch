 });
+
+test('availability lists free items sorted, optionally by kind', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 100 });
+  assert.deepEqual(s.availability({ start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' }), ['a0', 'b1', 's1']);
+  assert.deepEqual(s.availability({ start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z', kind: 'board' }), ['a0', 'b1']);
+  assert.deepEqual(s.availability({ start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z', kind: undefined }), ['a0', 'b1', 's1']);
+});
+
+test('availability excludes overlapping bookings only', () => {
+  const s = setup();
+  s.book(r('b1', '2026-06-02T00:00:00Z', '2026-06-05T00:00:00Z'));
+  const q = (start: string, end: string) => s.availability({ start, end, kind: 'board' });
+  assert.deepEqual(q('2026-06-01T00:00:00Z', '2026-06-03T00:00:00Z'), []);
+  assert.deepEqual(q('2026-06-04T00:00:00Z', '2026-06-08T00:00:00Z'), []);
+  assert.deepEqual(q('2026-06-03T00:00:00Z', '2026-06-04T00:00:00Z'), []);
+  assert.deepEqual(q('2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z'), ['b1']);
+  assert.deepEqual(q('2026-06-05T00:00:00Z', '2026-06-06T00:00:00Z'), ['b1']);
+  assert.deepEqual(s.availability({ start: '2026-06-03T00:00:00Z', end: '2026-06-04T00:00:00Z' }), ['s1']);
+});
+
+test('availability rejects bad periods and kinds', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: '2026-06-01T10:00:00Z', end: '2026-06-02T00:00:00Z' }));
+  assert.throws(() => s.availability({ start: '2026-06-01T00:00:00Z', end: '2026-06-01T00:00:00Z' }));
+  assert.throws(() => s.availability({ start: 'junk', end: '2026-06-02T00:00:00Z' }));
+  assert.throws(() => s.availability({ start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z', kind: 'kayak' as never }));
