@@ -0,0 +1,58 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  return s;
+}
+const r = (itemId: string, start: string, end: string) => ({ itemId, start, end });
+
+test('quote multiplies days by daily price', () => {
+  assert.deepEqual(setup().quote(r('b1', '2026-06-01T00:00:00Z', '2026-06-04T00:00:00.000Z')), {
+    itemId: 'b1', start: '2026-06-01T00:00:00.000Z', end: '2026-06-04T00:00:00.000Z', total: 7500,
+  });
+});
+
+test('quote and book reject unknown items and bad periods', () => {
+  const s = setup();
+  for (const f of [s.quote, s.book]) {
+    assert.throws(() => f(r('nope', '2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z')));
+    assert.throws(() => f(r('b1', '2026-06-01T10:00:00Z', '2026-06-02T00:00:00Z')));
+    assert.throws(() => f(r('b1', '2026-06-01T00:00:00Z', '2026-06-02T12:00:00Z')));
+    assert.throws(() => f(r('b1', '2026-06-01T00:00:00Z', '2026-06-01T00:00:00Z')));
+    assert.throws(() => f(r('b1', '2026-06-03T00:00:00Z', '2026-06-01T00:00:00Z')));
+    assert.throws(() => f(r('b1', '2026-06-01T00:00:00+02:00', '2026-06-02T00:00:00Z')));
+    assert.throws(() => f(r('b1', 'junk', '2026-06-02T00:00:00Z')));
+  }
+});
+
+test('book returns a booking with unique ids', () => {
+  const s = setup();
+  const a = s.book(r('b1', '2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z'));
+  const b = s.book(r('b1', '2026-06-02T00:00:00Z', '2026-06-03T00:00:00Z'));
+  assert.equal(a.total, 2500);
+  assert.notEqual(a.id, b.id);
+});
+
+test('overlapping bookings of the same item are refused, others allowed', () => {
+  const s = setup();
+  s.book(r('b1', '2026-06-02T00:00:00Z', '2026-06-05T00:00:00Z'));
+  assert.throws(() => s.book(r('b1', '2026-06-01T00:00:00Z', '2026-06-03T00:00:00Z')));
+  assert.throws(() => s.book(r('b1', '2026-06-04T00:00:00Z', '2026-06-08T00:00:00Z')));
+  assert.throws(() => s.book(r('b1', '2026-06-03T00:00:00Z', '2026-06-04T00:00:00Z')));
+  assert.throws(() => s.book(r('b1', '2026-06-01T00:00:00Z', '2026-06-09T00:00:00Z')));
+  s.book(r('b1', '2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z'));
+  s.book(r('b1', '2026-06-05T00:00:00Z', '2026-06-06T00:00:00Z'));
+  s.book(r('s1', '2026-06-02T00:00:00Z', '2026-06-05T00:00:00Z'));
+});
+
+test('addEquipment validates input', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'kayak' as never, dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 10.5 }));
+  assert.throws(() => s.addEquipment({ id: '', kind: 'sail', dailyPrice: 10 }));
+});
