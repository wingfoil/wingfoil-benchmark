@@ -0,0 +1,32 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  return s;
+}
+const req = (start: string, end: string) => ({ itemId: 'b1', start, end });
+
+test('quotes whole days', () => {
+  const q = setup().quote(req('2026-05-01T00:00:00.000Z', '2026-05-04T00:00:00.000Z'));
+  assert.equal(q.total, 7500);
+});
+
+test('rejects unknown items and non-midnight or inverted periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'x', start: '2026-05-01T00:00:00Z', end: '2026-05-02T00:00:00Z' }));
+  assert.throws(() => s.quote(req('2026-05-01T10:00:00Z', '2026-05-02T00:00:00Z')));
+  assert.throws(() => s.quote(req('2026-05-02T00:00:00Z', '2026-05-02T00:00:00Z')));
+  assert.throws(() => s.quote(req('2026-05-01T00:00:00+02:00', '2026-05-02T00:00:00Z')));
+});
+
+test('book prevents overlaps but allows back-to-back', () => {
+  const s = setup();
+  const a = s.book(req('2026-05-01T00:00:00Z', '2026-05-03T00:00:00Z'));
+  assert.equal(a.total, 5000);
+  assert.throws(() => s.book(req('2026-05-02T00:00:00Z', '2026-05-04T00:00:00Z')));
+  const b = s.book(req('2026-05-03T00:00:00Z', '2026-05-04T00:00:00Z'));
+  assert.notEqual(a.id, b.id);
+});
