+
+test('cancel refunds before the start, frees the equipment, and works once', () => {
+  const s = setup();
+  const b = s.book(req('2026-05-10T00:00:00Z', '2026-05-12T00:00:00Z'));
+  assert.deepEqual(s.cancel(b.id, '2026-05-09T12:00:00Z'), { bookingId: b.id, refund: 5000 });
+  assert.throws(() => s.cancel(b.id, '2026-05-09T13:00:00Z'));
+  assert.throws(() => s.cancel('nope', '2026-05-09T13:00:00Z'));
+  assert.deepEqual(s.availability({ start: '2026-05-10T00:00:00Z', end: '2026-05-12T00:00:00Z' }), ['b1']);
+  const c = s.book(req('2026-05-10T00:00:00Z', '2026-05-12T00:00:00Z'));
+  assert.equal(s.cancel(c.id, '2026-05-10T00:00:00Z').refund, 0);
+  assert.throws(() => s.cancel(c.id, 'garbage'));
+});
