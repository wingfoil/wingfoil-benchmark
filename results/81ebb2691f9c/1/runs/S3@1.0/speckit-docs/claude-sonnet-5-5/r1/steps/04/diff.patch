@@ -49,3 +49,19 @@ test('rentals of 3 days or more get 10% off, in quotes and bookings', () => {
   assert.equal(s.quote(req('2026-05-01T00:00:00Z', '2026-05-04T00:00:00Z')).total, 6750);
   assert.equal(s.book(req('2026-06-01T00:00:00Z', '2026-06-06T00:00:00Z')).total, 11250);
 });
+
+test('hourly rentals', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  s.addEquipment({ id: 'd1', kind: 'board', dailyPrice: 2500 });
+  const h = (id: string, a: string, b: string) => ({ itemId: id, start: `2026-05-01T${a}Z`, end: `2026-05-01T${b}Z` });
+  assert.equal(s.quote(h('h1', '13:00:00', '17:00:00')).total, 2400);
+  assert.equal(s.quote({ itemId: 'h1', start: '2026-05-01T22:00:00Z', end: '2026-05-02T02:00:00Z' }).total, 2400);
+  assert.throws(() => s.quote(h('d1', '13:00:00', '17:00:00')));
+  assert.throws(() => s.quote(h('h1', '13:30:00', '17:00:00')));
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-05-01T10:00:00Z', end: '2026-05-02T10:00:00Z' }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+  s.book(h('h1', '13:00:00', '17:00:00'));
+  assert.throws(() => s.book(h('h1', '16:00:00', '18:00:00')));
+  assert.deepEqual(s.availability({ start: '2026-05-01T17:00:00Z', end: '2026-05-01T18:00:00Z', kind: 'board' }), ['d1', 'h1']);
+});
