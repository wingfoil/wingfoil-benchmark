+++ b/test/reports-fixes.test.ts
@@ -0,0 +1,27 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createShop } from '../src/index.ts';
+import { shippingCost } from '../src/shipping.ts';
+import { lineVat } from '../src/tax.ts';
+
+describe('reported fixes', () => {
+  it('finds a product by a lower-case or padded SKU, in the catalogue and when ordering', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'LB-220', name: 'Lamp', priceCents: 1000, vatClass: 'standard', weightGrams: 300 });
+    s.inventory.restock('LB-220', 10);
+    assert.equal(s.catalog.find(' lb-220 ')?.sku, 'LB-220');
+    const order = s.orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'lb-220', quantity: 1 }] });
+    assert.equal(order.lines[0]?.sku, 'LB-220');
+  });
+
+  it('ships free from exactly €50.00 of goods, not below', () => {
+    assert.equal(shippingCost(5000, 500), 0);
+    assert.equal(shippingCost(4999, 500), 490);
+  });
+
+  it('rounds line VAT half up', () => {
+    assert.equal(lineVat(199, 'standard'), 44);
+    assert.equal(lineVat(100, 'standard'), 22);
+  });
+});
