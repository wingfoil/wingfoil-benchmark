+
+describe('single-use coupon after cancellation', () => {
+  it('can be used again once the order that used it is cancelled', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'MUG-01', name: 'Enamel mug', priceCents: 1000, vatClass: 'standard', weightGrams: 300 });
+    s.inventory.restock('MUG-01', 10);
+    s.coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const request = { customer: 'paolo', date: '2026-03-02', coupon: 'WELCOME', lines: [{ sku: 'MUG-01', quantity: 1 }] };
+    const first = s.orders.place(request);
+    s.orders.cancel(first.id, '2026-03-02');
+    assert.equal(s.coupons.usedBy('WELCOME'), undefined);
+    assert.doesNotThrow(() => s.orders.place(request));
+  });
+});
