+
+  it('gives a single-use coupon back when the order that used it is cancelled', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'ONCE', kind: 'fixed', value: 100, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = orders.place({ customer: 'c-1', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'ONCE' });
+    orders.cancel(first.id, '2026-05-05');
+    assert.equal(coupons.usedBy('ONCE'), undefined);
+    const second = orders.place({ customer: 'c-1', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'ONCE' });
+    assert.equal(coupons.usedBy('ONCE'), second.id);
+  });
 });
