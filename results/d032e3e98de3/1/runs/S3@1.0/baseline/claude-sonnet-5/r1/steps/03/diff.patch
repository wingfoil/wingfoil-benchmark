+const LONG_RENTAL_DAYS = 3;
+const LONG_RENTAL_DISCOUNT = 0.1;
+
+function computeTotal(days: number, dailyPrice: number): number {
+  const fullPrice = days * dailyPrice;
+  if (days >= LONG_RENTAL_DAYS) {
+    return Math.round(fullPrice * (1 - LONG_RENTAL_DISCOUNT));
+  }
+  return fullPrice;
+}
