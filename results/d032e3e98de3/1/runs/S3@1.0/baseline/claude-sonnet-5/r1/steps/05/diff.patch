diff --git a/src/index.test.ts b/src/index.test.ts
index 07749a5b7316636fedcf140d3d5f0429050e1108..646adb54500c8d486ddd8ad573c893cdcaba6464 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -161,3 +161,46 @@ test('book treats an hourly booking as overlapping a daily booking on the same i
     svc.book({ itemId: 'board-1', start: '2026-07-01T10:00:00.000Z', end: '2026-07-01T13:00:00.000Z' }),
   );
 });
+
+test('cancel before the rental starts gives a full refund', () => {
+  const svc = service();
+  const booking = svc.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+  const cancellation = svc.cancel(booking.id, '2026-06-30T00:00:00.000Z');
+  assert.deepEqual(cancellation, { bookingId: booking.id, refund: booking.total });
+});
+
+test('cancel after the rental ends gives no refund', () => {
+  const svc = service();
+  const booking = svc.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+  const cancellation = svc.cancel(booking.id, '2026-07-06T00:00:00.000Z');
+  assert.equal(cancellation.refund, 0);
+});
+
+test('cancel partway through the rental gives a prorated refund for the unused time', () => {
+  const svc = service();
+  const booking = svc.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+  const cancellation = svc.cancel(booking.id, '2026-07-02T00:00:00.000Z');
+  assert.equal(cancellation.refund, Math.round(booking.total * (3 / 4)));
+});
+
+test('cancel frees up the equipment for the cancelled period', () => {
+  const svc = service();
+  const booking = svc.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+  svc.cancel(booking.id, '2026-06-30T00:00:00.000Z');
+  const ids = svc.availability({ start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+  assert.ok(ids.includes('board-1'));
+  const rebooked = svc.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+  assert.equal(rebooked.itemId, 'board-1');
+});
+
+test('cancel throws when called twice for the same booking', () => {
+  const svc = service();
+  const booking = svc.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+  svc.cancel(booking.id, '2026-06-30T00:00:00.000Z');
+  assert.throws(() => svc.cancel(booking.id, '2026-06-30T00:00:00.000Z'));
+});
+
+test('cancel throws for an unknown booking id', () => {
+  const svc = service();
+  assert.throws(() => svc.cancel('nope', '2026-06-30T00:00:00.000Z'));
+});
