@@ -0,0 +1,129 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  total: number;
+}
+
+export interface Booking {
+  id: string;
+  itemId: string;
+  start: string;
+  end: string;
+  total: number;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+function isMidnightUtc(date: Date): boolean {
+  return (
+    date.getUTCHours() === 0 &&
+    date.getUTCMinutes() === 0 &&
+    date.getUTCSeconds() === 0 &&
+    date.getUTCMilliseconds() === 0
+  );
+}
+
+function parsePeriod(start: string, end: string): { startMs: number; endMs: number; days: number } {
+  const startDate = new Date(start);
+  const endDate = new Date(end);
+
+  if (Number.isNaN(startDate.getTime()) || Number.isNaN(endDate.getTime())) {
+    throw new Error('Invalid period: start and end must be valid ISO-8601 dates.');
+  }
+  if (!isMidnightUtc(startDate) || !isMidnightUtc(endDate)) {
+    throw new Error('Invalid period: start and end must fall at midnight UTC.');
+  }
+
+  const startMs = startDate.getTime();
+  const endMs = endDate.getTime();
+  const spanMs = endMs - startMs;
+
+  if (spanMs <= 0 || spanMs % DAY_MS !== 0) {
+    throw new Error('Invalid period: end must be a whole number of days after start.');
+  }
+
+  return { startMs, endMs, days: spanMs / DAY_MS };
+}
+
+function periodsOverlap(aStart: number, aEnd: number, bStart: number, bEnd: number): boolean {
+  return aStart < bEnd && bStart < aEnd;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings = new Map<string, Booking[]>();
+  let nextBookingId = 1;
+
+  function getEquipmentOrThrow(itemId: string): Equipment {
+    const item = equipment.get(itemId);
+    if (!item) {
+      throw new Error(`Unknown item: ${itemId}`);
+    }
+    return item;
+  }
+
+  function addEquipment(item: Equipment): void {
+    equipment.set(item.id, item);
+  }
+
+  function quote(request: RentalRequest): Quote {
+    const item = getEquipmentOrThrow(request.itemId);
+    const { days } = parsePeriod(request.start, request.end);
+    return {
+      itemId: request.itemId,
+      start: request.start,
+      end: request.end,
+      total: days * item.dailyPrice,
+    };
+  }
+
+  function book(request: RentalRequest): Booking {
+    const item = getEquipmentOrThrow(request.itemId);
+    const { startMs, endMs, days } = parsePeriod(request.start, request.end);
+
+    const existing = bookings.get(item.id) ?? [];
+    for (const existingBooking of existing) {
+      const existingStartMs = new Date(existingBooking.start).getTime();
+      const existingEndMs = new Date(existingBooking.end).getTime();
+      if (periodsOverlap(startMs, endMs, existingStartMs, existingEndMs)) {
+        throw new Error(`Item ${item.id} is already booked for part of that period.`);
+      }
+    }
+
+    const newBooking: Booking = {
+      id: String(nextBookingId++),
+      itemId: item.id,
+      start: request.start,
+      end: request.end,
+      total: days * item.dailyPrice,
+    };
+
+    existing.push(newBooking);
+    bookings.set(item.id, existing);
+
+    return newBooking;
+  }
+
+  return { addEquipment, quote, book };
+}
