@@ -0,0 +1,76 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+function service() {
+  const svc = createRentalService();
+  svc.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  svc.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  return svc;
+}
+
+test('quote computes total for whole days', () => {
+  const svc = service();
+  const quote = svc.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-04T00:00:00.000Z' });
+  assert.deepEqual(quote, {
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00.000Z',
+    end: '2026-07-04T00:00:00.000Z',
+    total: 7500,
+  });
+});
+
+test('quote throws for unknown item', () => {
+  const svc = service();
+  assert.throws(() => svc.quote({ itemId: 'nope', start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z' }));
+});
+
+test('quote throws when period is not whole days', () => {
+  const svc = service();
+  assert.throws(() => svc.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-01T12:00:00.000Z' }));
+});
+
+test('quote throws when start is not midnight UTC', () => {
+  const svc = service();
+  assert.throws(() => svc.quote({ itemId: 'board-1', start: '2026-07-01T06:00:00.000Z', end: '2026-07-02T06:00:00.000Z' }));
+});
+
+test('quote throws when end is before or equal to start', () => {
+  const svc = service();
+  assert.throws(() => svc.quote({ itemId: 'board-1', start: '2026-07-02T00:00:00.000Z', end: '2026-07-01T00:00:00.000Z' }));
+  assert.throws(() => svc.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-01T00:00:00.000Z' }));
+});
+
+test('book returns a booking with an id', () => {
+  const svc = service();
+  const booking = svc.book({ itemId: 'sail-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+  assert.equal(booking.itemId, 'sail-1');
+  assert.equal(booking.total, 3000);
+  assert.ok(typeof booking.id === 'string' && booking.id.length > 0);
+});
+
+test('book throws for overlapping periods on the same item', () => {
+  const svc = service();
+  svc.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+  assert.throws(() => svc.book({ itemId: 'board-1', start: '2026-07-03T00:00:00.000Z', end: '2026-07-06T00:00:00.000Z' }));
+  assert.throws(() => svc.book({ itemId: 'board-1', start: '2026-06-30T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z' }));
+});
+
+test('book allows back-to-back, non-overlapping periods on the same item', () => {
+  const svc = service();
+  svc.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+  const second = svc.book({ itemId: 'board-1', start: '2026-07-05T00:00:00.000Z', end: '2026-07-06T00:00:00.000Z' });
+  assert.equal(second.itemId, 'board-1');
+});
+
+test('book throws for unknown item', () => {
+  const svc = service();
+  assert.throws(() => svc.book({ itemId: 'nope', start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z' }));
+});
+
+test('different items can be booked for the same period', () => {
+  const svc = service();
+  svc.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z' });
+  const sailBooking = svc.book({ itemId: 'sail-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z' });
+  assert.equal(sailBooking.itemId, 'sail-1');
+});
