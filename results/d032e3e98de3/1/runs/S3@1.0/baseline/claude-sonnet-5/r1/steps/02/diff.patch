@@ -64,10 +64,17 @@ function periodsOverlap(aStart: number, aEnd: number, bStart: number, bEnd: numb
   return aStart < bEnd && bStart < aEnd;
 }
 
+export interface AvailabilityQuery {
+  start: string;
+  end: string;
+  kind?: EquipmentKind;
+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  availability(query: AvailabilityQuery): string[];
 }
 
 export function createRentalService(): RentalService {
@@ -125,5 +132,27 @@ export function createRentalService(): RentalService {
     return newBooking;
   }
 
-  return { addEquipment, quote, book };
+  function availability(query: AvailabilityQuery): string[] {
+    const { startMs, endMs } = parsePeriod(query.start, query.end);
+
+    const available: string[] = [];
+    for (const item of equipment.values()) {
+      if (query.kind !== undefined && item.kind !== query.kind) {
+        continue;
+      }
+      const existing = bookings.get(item.id) ?? [];
+      const isFree = existing.every((existingBooking) => {
+        const existingStartMs = new Date(existingBooking.start).getTime();
+        const existingEndMs = new Date(existingBooking.end).getTime();
+        return !periodsOverlap(startMs, endMs, existingStartMs, existingEndMs);
+      });
+      if (isFree) {
+        available.push(item.id);
+      }
+    }
+
+    return available.sort();
+  }
+
+  return { addEquipment, quote, book, availability };
 }
