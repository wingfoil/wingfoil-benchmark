diff --git a/src/index.test.ts b/src/index.test.ts
index fa6d40e272bb9ee8f1ffd7d1128a2ca389a000fb..4bfae9bb1bcc6ec9ba0cd57ea3372ed5ccac237c 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -74,3 +74,34 @@ test('different items can be booked for the same period', () => {
   const sailBooking = svc.book({ itemId: 'sail-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z' });
   assert.equal(sailBooking.itemId, 'sail-1');
 });
+
+test('availability returns all equipment ids, sorted, when nothing is booked', () => {
+  const svc = service();
+  const ids = svc.availability({ start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z' });
+  assert.deepEqual(ids, ['board-1', 'sail-1']);
+});
+
+test('availability filters by kind when given', () => {
+  const svc = service();
+  const ids = svc.availability({ start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z', kind: 'sail' });
+  assert.deepEqual(ids, ['sail-1']);
+});
+
+test('availability excludes items booked for part of the period', () => {
+  const svc = service();
+  svc.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+  const ids = svc.availability({ start: '2026-07-02T00:00:00.000Z', end: '2026-07-04T00:00:00.000Z' });
+  assert.deepEqual(ids, ['sail-1']);
+});
+
+test('availability includes items whose booking is back-to-back, not overlapping', () => {
+  const svc = service();
+  svc.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+  const ids = svc.availability({ start: '2026-07-03T00:00:00.000Z', end: '2026-07-04T00:00:00.000Z' });
+  assert.deepEqual(ids, ['board-1', 'sail-1']);
+});
+
+test('availability throws for an invalid period', () => {
+  const svc = service();
+  assert.throws(() => svc.availability({ start: '2026-07-01T06:00:00.000Z', end: '2026-07-02T00:00:00.000Z' }));
+});
diff --git a/src/index.ts b/src/index.ts
