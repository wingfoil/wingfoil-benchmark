+
+test("RFC 6902 edge cases", () => {
+  assert.deepEqual(applyPatch([1, 2, 3], [{ op: "move", from: "/0", path: "/2" }]), [2, 3, 1]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.deepEqual(applyPatch({ "": 1 }, [{ op: "test", path: "/", value: 1 }]), { "": 1 });
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "/b", path: "/b" }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/-/x", value: 1 }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "ADD", path: "/a", value: 1 }]));
+});
