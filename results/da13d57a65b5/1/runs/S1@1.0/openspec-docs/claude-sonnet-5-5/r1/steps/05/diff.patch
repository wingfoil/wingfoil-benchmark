--- /dev/null
+++ b/src/diff.ts
@@ -0,0 +1,57 @@
+import { clone, equal } from "./patch.ts";
+
+type Json = unknown;
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: Json };
+
+function isObject(value: unknown): value is Record<string, Json> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function escapeToken(token: string): string {
+  // "~" must be escaped before "/" (RFC 6901 section 3).
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diff(from: Json, to: Json, path: string, ops: Operation[]): void {
+  if (equal(from, to)) return;
+  if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(from, key)) diff(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    let start = 0;
+    while (start < from.length && start < to.length && equal(from[start], to[start])) start++;
+    let endFrom = from.length;
+    let endTo = to.length;
+    while (endFrom > start && endTo > start && equal(from[endFrom - 1], to[endTo - 1])) {
+      endFrom--;
+      endTo--;
+    }
+    const common = Math.min(endFrom - start, endTo - start);
+    for (let i = 0; i < common; i++) diff(from[start + i], to[start + i], `${path}/${start + i}`, ops);
+    // Remove from the highest index down so that earlier indices stay valid.
+    for (let i = endFrom - 1; i >= start + common; i--) ops.push({ op: "remove", path: `${path}/${i}` });
+    for (let i = start + common; i < endTo; i++) {
+      ops.push({ op: "add", path: `${path}/${i}`, value: clone(to[i]) });
+    }
+    return;
+  }
+  ops.push({ op: "replace", path, value: clone(to) });
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied, containing only the
+ * changes between them. Neither input is mutated.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const ops: Operation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
