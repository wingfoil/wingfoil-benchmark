diff --git a/test/diff.test.ts b/test/diff.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cc706b4e46a8f961d067b81a1f45dd8b539bc8b5
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,53 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown) {
+  const a = structuredClone(from);
+  const b = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, a);
+  assert.deepEqual(to, b);
+  return patch;
+}
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a small change yields a small patch", () => {
+  const patch = roundTrip({ a: { b: 1, c: [1, 2, 3] }, d: "x" }, { a: { b: 1, c: [1, 5, 3] }, d: "x" });
+  assert.deepEqual(patch, [{ op: "replace", path: "/a/c/1", value: 5 }]);
+});
+
+test("escapes keys", () => {
+  const patch = roundTrip({ "a/b": 1, "m~n": 1 }, { "a/b": 2, "m~n": 2 });
+  assert.deepEqual(patch.map((o) => o.path), ["/a~1b", "/m~0n"]);
+});
+
+test("array growth, shrink, insertion", () => {
+  assert.equal(roundTrip([1, 2, 3, 4], [1, 4]).length, 2);
+  assert.equal(roundTrip([1], [1, 2, 3]).length, 2);
+  assert.equal(roundTrip([1, 2, 3], [1, 9, 2, 3]).length, 1);
+  roundTrip([[1, 2], { a: 1 }, 3], [[1, 2, 3], { a: 2 }]);
+});
+
+test("type changes and root replacement", () => {
+  roundTrip({ a: 1 }, [1]);
+  roundTrip(null, { a: null });
+  roundTrip({ a: [1] }, { a: { b: 1 } });
+  assert.deepEqual(createPatch(1, 2), [{ op: "replace", path: "", value: 2 }]);
+});
+
+test("added values are not aliased to the input", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0].value as { b: number }).b = 9;
+  assert.equal(to.a.b, 1);
+});
+
+test("__proto__ member", () => {
+  const to = JSON.parse('{"__proto__": {"x": 1}}');
+  roundTrip({}, to);
+});
