diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e369554289b4a8fdf3be9a4b48d209acf8c333c6
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,46 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("add, replace, remove", () => {
+  const doc = { foo: "bar", list: [1, 2] };
+  const out = applyPatch(doc, [
+    { op: "add", path: "/baz", value: "qux" },
+    { op: "add", path: "/list/1", value: 9 },
+    { op: "add", path: "/list/-", value: 3 },
+    { op: "replace", path: "/foo", value: "x" },
+    { op: "remove", path: "/list/0" },
+  ]);
+  assert.deepEqual(out, { foo: "x", baz: "qux", list: [9, 2, 3] });
+  assert.deepEqual(doc, { foo: "bar", list: [1, 2] });
+});
+
+test("move, copy, test", () => {
+  const out = applyPatch({ a: { b: [1] }, c: 1 }, [
+    { op: "copy", from: "/a", path: "/d" },
+    { op: "move", from: "/c", path: "/a/e" },
+    { op: "test", path: "/d", value: { b: [1] } },
+  ]);
+  assert.deepEqual(out, { a: { b: [1], e: 1 }, d: { b: [1] } });
+});
+
+test("root operations", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: 2 }]), 2);
+});
+
+test("errors", () => {
+  const bad = (patch: unknown) => assert.throws(() => applyPatch({ a: [1], b: 1 }, patch as never));
+  bad({});
+  bad([{ op: "nope", path: "" }]);
+  bad([{ op: "add", path: "/a" }]);
+  bad([{ op: "add", path: "/x/y", value: 1 }]);
+  bad([{ op: "add", path: "/a/3", value: 1 }]);
+  bad([{ op: "add", path: "/a/01", value: 1 }]);
+  bad([{ op: "remove", path: "/zz" }]);
+  bad([{ op: "replace", path: "/zz", value: 1 }]);
+  bad([{ op: "test", path: "/b", value: 2 }]);
+  bad([{ op: "test", path: "/b", value: "1" }]);
+  bad([{ op: "move", from: "/a", path: "/a/0" }]);
+  bad([{ op: "copy", path: "/c" }]);
+});
