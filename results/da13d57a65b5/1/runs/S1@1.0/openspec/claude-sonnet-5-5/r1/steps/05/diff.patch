+
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: Json };
+
+const escapeToken = (t: string) => t.replaceAll("~", "~0").replaceAll("/", "~1");
+
+function diffArray(a: Json[], b: Json[], path: string, ops: Operation[]): void {
+  let start = 0;
+  while (start < a.length && start < b.length && deepEqual(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && deepEqual(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const am = a.slice(start, endA);
+  const bm = b.slice(start, endB);
+  // lcs[i][j]: length of the longest common subsequence of am[i..] and bm[j..]
+  const lcs = Array.from({ length: am.length + 1 }, () => new Array<number>(bm.length + 1).fill(0));
+  for (let i = am.length - 1; i >= 0; i--) {
+    for (let j = bm.length - 1; j >= 0; j--) {
+      lcs[i][j] = deepEqual(am[i], bm[j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  let index = start; // position in the array as it evolves while the patch is applied
+  let i = 0;
+  let j = 0;
+  while (i < am.length || j < bm.length) {
+    if (i < am.length && j < bm.length && deepEqual(am[i], bm[j])) {
+      i++;
+      j++;
+      index++;
+      continue;
+    }
+    const dels: Json[] = [];
+    const inss: Json[] = [];
+    while ((i < am.length || j < bm.length) && !(i < am.length && j < bm.length && deepEqual(am[i], bm[j]))) {
+      if (j >= bm.length || (i < am.length && lcs[i + 1][j] >= lcs[i][j + 1])) dels.push(am[i++]);
+      else inss.push(bm[j++]);
+    }
+    const paired = Math.min(dels.length, inss.length);
+    for (let k = 0; k < paired; k++) diff(dels[k], inss[k], `${path}/${index + k}`, ops);
+    for (let k = paired; k < dels.length; k++) ops.push({ op: "remove", path: `${path}/${index + paired}` });
+    for (let k = paired; k < inss.length; k++) {
+      ops.push({ op: "add", path: `${path}/${index + k}`, value: clone(inss[k]) });
+    }
+    index += inss.length;
+  }
+}
+
+function diff(from: Json, to: Json, path: string, ops: Operation[]): void {
+  if (deepEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (has(from, key)) diff(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Returns an RFC 6902 JSON Patch that turns `from` into `to` when applied with `applyPatch`.
+ * Only what changed is described. Neither argument is mutated.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  const ops: Operation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
