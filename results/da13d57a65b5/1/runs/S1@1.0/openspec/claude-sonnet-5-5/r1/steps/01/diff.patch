+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer, JsonPointerError } from "./index.ts";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("~01 decodes to ~1", () => {
+  assert.equal(resolvePointer({ "~1": 3 }, "/~01"), 3);
+});
+
+test("falsy values and nested access", () => {
+  const doc = { a: null, b: false, c: 0, d: "", e: { f: [10, 20] } };
+  for (const k of ["a", "b", "c", "d"]) {
+    assert.equal(resolvePointer(doc, `/${k}`), (doc as Record<string, unknown>)[k]);
+  }
+  assert.equal(resolvePointer(doc, "/e/f/1"), 20);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("invalid pointers throw, independent of the document", () => {
+  for (const p of ["foo", "a/b", "/a~2b", "/a~", "~0", "#/a"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), JsonPointerError, p);
+  }
+  assert.throws(() => resolvePointer({}, "/a~"), JsonPointerError);
+  assert.throws(() => resolvePointer({}, undefined as unknown as string), JsonPointerError);
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"), JsonPointerError);
+  for (const p of ["/toString", "/constructor", "/__proto__"]) {
+    assert.throws(() => resolvePointer({}, p), JsonPointerError, p);
+  }
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"), JsonPointerError);
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"), JsonPointerError);
+  assert.throws(() => resolvePointer({ a: "str" }, "/a/length"), JsonPointerError);
+});
+
+test("array indices", () => {
+  assert.equal(resolvePointer([10, 20], "/0"), 10);
+  for (const p of ["/2", "/-", "/01", "/+1", "/-1", "/1.0", "/length", "/", "/99999999999999999999"]) {
+    assert.throws(() => resolvePointer([10, 20], p), JsonPointerError, p);
+  }
+});
diff --git a/src/json-pointer.ts b/src/json-pointer.ts
