index 0000000000000000000000000000000000000000..ac26da103e47a591a28c9a86a8f7d82bcfcea4a5
--- /dev/null
+++ b/src/json-patch.ts
@@ -0,0 +1,169 @@
+import { JsonPointerError, parsePointer } from "./json-pointer.ts";
+
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Json = unknown;
+type Container = Json[] | Record<string, Json>;
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const OPS = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+
+const isObject = (v: unknown): v is Record<string, Json> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+const has = (o: object, k: string) => Object.hasOwn(o, k);
+
+function pointer(p: unknown): string[] {
+  try {
+    return parsePointer(p);
+  } catch (e) {
+    if (e instanceof JsonPointerError) throw new JsonPatchError(e.message);
+    throw e;
+  }
+}
+
+function deepEqual(a: Json, b: Json): boolean {
+  if (a === b) return true;
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => deepEqual(v, b[i]));
+  }
+  if (isObject(a) && isObject(b)) {
+    const ka = Object.keys(a);
+    return ka.length === Object.keys(b).length && ka.every((k) => has(b, k) && deepEqual(a[k], b[k]));
+  }
+  return false;
+}
+
+function clone<T>(v: T): T {
+  return structuredClone(v);
+}
+
+function setMember(obj: Record<string, Json>, key: string, value: Json): void {
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Walks to the parent container of the location `tokens`. */
+function parentOf(root: Json, tokens: string[]): Container {
+  let cur = root;
+  for (const t of tokens.slice(0, -1)) {
+    if (Array.isArray(cur)) {
+      if (!ARRAY_INDEX.test(t) || Number(t) >= cur.length) throw new JsonPatchError(`No array element "${t}"`);
+      cur = cur[Number(t)];
+    } else if (isObject(cur) && has(cur, t)) {
+      cur = cur[t];
+    } else {
+      throw new JsonPatchError(`No member "${t}"`);
+    }
+  }
+  if (!Array.isArray(cur) && !isObject(cur)) throw new JsonPatchError("Parent is not an object or array");
+  return cur;
+}
+
+function get(root: Json, tokens: string[]): Json {
+  if (tokens.length === 0) return root;
+  const parent = parentOf(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(key) || Number(key) >= parent.length) throw new JsonPatchError(`No array element "${key}"`);
+    return parent[Number(key)];
+  }
+  if (!has(parent, key)) throw new JsonPatchError(`No member "${key}"`);
+  return parent[key];
+}
+
+function add(root: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (key === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(key) && Number(key) <= parent.length) {
+      parent.splice(Number(key), 0, value);
+    } else {
+      throw new JsonPatchError(`Invalid array index "${key}"`);
+    }
+  } else {
+    setMember(parent, key, value);
+  }
+  return root;
+}
+
+function remove(root: Json, tokens: string[]): Json {
+  if (tokens.length === 0) throw new JsonPatchError("Cannot remove the whole document");
+  get(root, tokens); // target must exist
+  const parent = parentOf(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(key), 1);
+  else delete parent[key];
+  return root;
+}
+
+function replace(root: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  get(root, tokens);
+  const parent = parentOf(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(key)] = value;
+  else setMember(parent, key, value);
+  return root;
+}
+
+/**
+ * Applies the RFC 6902 JSON Patch `patch` to `document` and returns the result as a new value.
+ * Neither argument is mutated. Throws a `JsonPatchError` if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchError("A JSON Patch must be an array");
+  let result = clone(document);
+  patch.forEach((operation, i) => {
+    const where = `Operation ${i}`;
+    if (!isObject(operation)) throw new JsonPatchError(`${where} must be an object`);
+    const { op } = operation;
+    if (typeof op !== "string" || !OPS.has(op)) throw new JsonPatchError(`${where} has an unknown "op"`);
+    if (typeof operation.path !== "string") throw new JsonPatchError(`${where} needs a string "path"`);
+    if ((op === "add" || op === "replace" || op === "test") && !has(operation, "value")) {
+      throw new JsonPatchError(`${where} needs a "value"`);
+    }
+    if ((op === "move" || op === "copy") && typeof operation.from !== "string") {
+      throw new JsonPatchError(`${where} needs a string "from"`);
+    }
+    const path = pointer(operation.path);
+    const from = op === "move" || op === "copy" ? pointer(operation.from) : [];
+    try {
+      switch (op) {
+        case "add":
+          result = add(result, path, clone(operation.value));
+          break;
+        case "remove":
+          result = remove(result, path);
+          break;
+        case "replace":
+          result = replace(result, path, clone(operation.value));
+          break;
+        case "copy":
+          result = add(result, path, clone(get(result, from)));
+          break;
+        case "move": {
+          const isPrefix = from.length < path.length && from.every((t, k) => t === path[k]);
+          if (isPrefix) throw new JsonPatchError('"from" must not be a proper prefix of "path"');
+          const value = get(result, from);
+          if (from.length === path.length && from.every((t, k) => t === path[k])) break;
+          result = add(remove(result, from), path, value);
+          break;
+        }
+        case "test":
+          if (!deepEqual(get(result, path), operation.value)) throw new JsonPatchError("Test failed");
+          break;
+      }
+    } catch (e) {
+      if (e instanceof JsonPatchError) throw new JsonPatchError(`${where} (${op}) failed: ${e.message}`);
+      throw e;
+    }
+  });
+  return result;
+}
