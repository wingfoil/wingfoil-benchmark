@@ -0,0 +1,85 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, JsonPatchError } from "./index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) => assert.deepEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch), JsonPatchError);
+
+test("RFC 6902 appendix A examples", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  ok({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  });
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  ok({ foo: { bar: 1 } }, [{ op: "copy", from: "/foo", path: "/baz" }], { foo: { bar: 1 }, baz: { bar: 1 } });
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] });
+});
+
+test("does not mutate or alias inputs", () => {
+  const doc = { a: [1, { b: 2 }] };
+  const patch = [{ op: "add", path: "/c", value: { x: 1 } }, { op: "copy", from: "/a/1", path: "/d" }, { op: "replace", path: "/d/b", value: 9 }];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const res = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.equal(res.a[1].b, 2);
+  assert.notEqual(res.c, patch[0].value);
+});
+
+test("root operations", () => {
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: 5 }], 5);
+  bad({ a: 1 }, [{ op: "remove", path: "" }]);
+  ok(null, [{ op: "test", path: "", value: null }], null);
+});
+
+test("errors", () => {
+  bad({}, {});
+  bad({}, [1]);
+  bad({}, [{ op: "nope", path: "" }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "move", path: "/a" }]);
+  bad({}, [{ op: "add", path: "a", value: 1 }]);
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad([1], [{ op: "add", path: "/2", value: 1 }]);
+  bad([1], [{ op: "add", path: "/01", value: 1 }]);
+  bad([1], [{ op: "replace", path: "/-", value: 1 }]);
+  bad([1], [{ op: "remove", path: "/1" }]);
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  bad({}, [{ op: "copy", from: "/x", path: "/y" }]);
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+  bad({}, [{ op: "test", path: "/a", value: null }]);
+});
+
+test("test uses deep equality ignoring key order", () => {
+  ok({ a: { x: 1, y: [1, 2] } }, [{ op: "test", path: "/a", value: { y: [1, 2], x: 1 } }], { a: { x: 1, y: [1, 2] } });
+  bad({ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]);
+});
+
+test("escaped tokens and __proto__", () => {
+  ok({}, [{ op: "add", path: "/a~1b", value: 1 }], { "a/b": 1 });
+  const r = applyPatch({}, [{ op: "add", path: "/__proto__", value: 1 }]) as any;
+  assert.equal(Object.hasOwn(r, "__proto__"), true);
+  assert.equal(({} as any).polluted, undefined);
+});
+
+test("move to same location is a no-op", () => {
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+});
