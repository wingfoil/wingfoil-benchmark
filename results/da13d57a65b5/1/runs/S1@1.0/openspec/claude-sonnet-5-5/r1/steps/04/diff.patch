index 0000000000000000000000000000000000000000..fcfe360b2fab31f69f498db07f3236e1f8b98669
--- /dev/null
+++ b/src/json-merge-patch.ts
@@ -0,0 +1,29 @@
+type Json = unknown;
+
+const isObject = (v: unknown): v is Record<string, Json> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+function set(o: Record<string, Json>, k: string, v: Json): void {
+  Object.defineProperty(o, k, { value: v, writable: true, enumerable: true, configurable: true });
+}
+
+function copy(v: Json): Json {
+  if (Array.isArray(v)) return v.map(copy);
+  if (isObject(v)) {
+    const out: Record<string, Json> = {};
+    for (const k of Object.keys(v)) set(out, k, copy(v[k]));
+    return out;
+  }
+  return v;
+}
+
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return copy(patch);
+  const result: Record<string, Json> = isObject(target) ? (copy(target) as Record<string, Json>) : {};
+  for (const k of Object.keys(patch)) {
+    const v = patch[k];
+    if (v === null) delete result[k];
+    else set(result, k, applyMergePatch(Object.hasOwn(result, k) ? result[k] : undefined, v));
+  }
+  return result;
+}
