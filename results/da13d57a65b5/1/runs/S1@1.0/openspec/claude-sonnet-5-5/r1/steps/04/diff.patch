+++ b/src/json-merge-patch.test.ts
@@ -0,0 +1,41 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "./index.ts";
+
+test("RFC 7386 appendix A", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, r] of cases) assert.deepEqual(applyMergePatch(t, p), r);
+});
+
+test("does not mutate or share structure", () => {
+  const t = { a: { b: 1 } };
+  const p = { c: { d: [1] }, a: { e: 2 } };
+  const r = applyMergePatch(t, p) as any;
+  assert.deepEqual(t, { a: { b: 1 } });
+  assert.deepEqual(p, { c: { d: [1] }, a: { e: 2 } });
+  assert.notEqual(r.c, p.c);
+  assert.notEqual(r.c.d, p.c.d);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const r = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as any;
+  assert.equal(Object.getPrototypeOf(r), Object.prototype);
+  assert.equal(({} as any).x, undefined);
+  assert.deepEqual(Object.keys(r), ["__proto__"]);
+});
