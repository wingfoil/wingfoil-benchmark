index 0000000000000000000000000000000000000000..0631ab6a4f017c8f1e8b90b2b832e8fe72da3d52
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,62 @@
+/** A parsed JSON value. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Decodes one reference token (RFC 6901 §4): `~1` is `/` and `~0` is `~`. */
+function unescapeToken(token: string): string {
+  return token.replace(/~(.?)/g, (_match, next: string) => {
+    if (next === "0") return "~";
+    if (next === "1") return "/";
+    throw new Error(`Invalid JSON Pointer: bad escape "~${next}"`);
+  });
+}
+
+/** Resolves one reference token against `current`, or throws if it names no value. */
+function step(current: unknown, token: string, pointer: string): JsonValue {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: no array element "${token}"`);
+    }
+    return current[Number(token)];
+  }
+  if (
+    typeof current === "object" &&
+    current !== null &&
+    Object.prototype.hasOwnProperty.call(current, token)
+  ) {
+    return (current as { [key: string]: JsonValue })[token];
+  }
+  throw new Error(`JSON Pointer "${pointer}" does not resolve: no member "${token}"`);
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer `pointer` (RFC 6901) refers to.
+ *
+ * The empty pointer refers to the whole document. The array end marker `-` refers to a
+ * nonexistent element, so it never resolves.
+ *
+ * @throws Error if `pointer` is not a valid JSON Pointer, or if it does not resolve to a
+ * value of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): JsonValue {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return document as JsonValue;
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  const tokens = pointer.slice(1).split("/").map(unescapeToken);
+  let current: unknown = document;
+  for (const token of tokens) {
+    current = step(current, token, pointer);
+  }
+  return current as JsonValue;
+}
