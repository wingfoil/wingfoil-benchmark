   }
   return result;
 }
+
+/** Merges `patch` into `target` (RFC 7386 §2); the result is always new structure. */
+function mergeValue(target: unknown, patch: unknown): JsonValue {
+  if (!isObject(patch)) return clone(patch as JsonValue);
+  const result: { [key: string]: JsonValue } = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) setMember(result, key, clone(target[key] as JsonValue));
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, mergeValue(result[key], value));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies the JSON Merge Patch `patch` (RFC 7386) to `target` and returns the merged document.
+ *
+ * Object patches merge member by member: a `null` member removes the target's member, any other
+ * value is merged recursively. A patch that is not an object (an array, a scalar or `null`)
+ * replaces the target outright, and arrays are never merged. A target that is not an object is
+ * treated as an empty object when the patch is an object. Neither argument is mutated, and the
+ * result shares no structure with either.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
+  return mergeValue(target, patch);
+}
