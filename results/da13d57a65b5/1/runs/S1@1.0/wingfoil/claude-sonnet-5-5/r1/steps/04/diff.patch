@@ -0,0 +1,59 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("a non-object patch replaces the whole target, including with null", () => {
+  assert.equal(applyMergePatch({ a: 1 }, 5), 5);
+  assert.equal(applyMergePatch(undefined, null), null);
+});
+
+test("neither argument is mutated and the result shares no structure", () => {
+  const target = { a: { b: 1 }, c: [1] };
+  const patch = { a: { d: { e: 2 } }, f: [{ g: 1 }] };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 }, c: [1] });
+  assert.deepEqual(patch, { a: { d: { e: 2 } }, f: [{ g: 1 }] });
+  assert.notEqual(result.a.d, patch.a.d);
+  assert.notEqual(result.f, patch.f);
+  assert.notEqual(result.c, target.c);
+});
+
+test("__proto__ is an ordinary member and never pollutes prototypes", () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}, "a": 1}');
+  const result = applyMergePatch({}, patch) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__", "a"]);
+  assert.deepEqual(result.__proto__, { polluted: true });
+  const removed = applyMergePatch(result, JSON.parse('{"__proto__": null}')) as any;
+  assert.deepEqual(Object.keys(removed), ["a"]);
+});
+
+test("inherited properties of the target are not members", () => {
+  const result = applyMergePatch({}, { toString: { a: 1 }, constructor: null }) as any;
+  assert.deepEqual(Object.keys(result), ["toString"]);
+  assert.deepEqual(result.toString, { a: 1 });
+});
