index 0000000000000000000000000000000000000000..495cf7bb7e237777e0e16f57e75a313d9ad45a8a
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,142 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("add: object member, replacing an existing one, and array insertion", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), {
+    foo: "bar",
+    baz: "qux",
+  });
+  assert.deepEqual(applyPatch({ foo: 1 }, [{ op: "add", path: "/foo", value: 2 }]), { foo: 2 });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), {
+    foo: ["bar", "qux", "baz"],
+  });
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: "baz" }]), {
+    foo: ["bar", "baz"],
+  });
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/1", value: "baz" }]), {
+    foo: ["bar", "baz"],
+  });
+});
+
+test("add: whole document, and a null value", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a", value: null }]), { a: null });
+});
+
+test("add: errors", () => {
+  assert.throws(() => applyPatch({ foo: ["a"] }, [{ op: "add", path: "/foo/2", value: 1 }]));
+  assert.throws(() => applyPatch({ foo: ["a"] }, [{ op: "add", path: "/foo/01", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]));
+});
+
+test("add: __proto__ is an ordinary member", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as object;
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+  assert.equal(({} as { x?: number }).x, undefined);
+});
+
+test("remove", () => {
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(applyPatch({ foo: ["a", "b", "c"] }, [{ op: "remove", path: "/foo/1" }]), {
+    foo: ["a", "c"],
+  });
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/-" }]));
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "" }]));
+});
+
+test("replace", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch([1, 2], [{ op: "replace", path: "/1", value: 9 }]), [1, 9]);
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/1", value: 1 }]));
+});
+
+test("move", () => {
+  assert.deepEqual(
+    applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [
+      { op: "move", from: "/foo/waldo", path: "/qux/thud" },
+    ]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "/b", path: "/c" }]));
+  assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/c" }]));
+});
+
+test("copy duplicates rather than aliases", () => {
+  const out = applyPatch({ a: { b: 1 } }, [{ op: "copy", from: "/a", path: "/c" }]) as {
+    a: object;
+    c: object;
+  };
+  assert.deepEqual(out.c, { b: 1 });
+  assert.notEqual(out.a, out.c);
+  assert.throws(() => applyPatch({}, [{ op: "copy", from: "/x", path: "/y" }]));
+});
+
+test("test", () => {
+  const doc = { a: { x: 1, y: [1, 2] }, n: null, "": 0 };
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/a", value: { y: [1, 2], x: 1 } }]), doc);
+  assert.doesNotThrow(() => applyPatch(doc, [{ op: "test", path: "/n", value: null }]));
+  assert.doesNotThrow(() => applyPatch(doc, [{ op: "test", path: "", value: doc }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/y", value: [2, 1] }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/x", value: "1" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/missing", value: null }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a", value: { x: 1 } }]));
+});
+
+test("operations apply in order, and a failure aborts everything", () => {
+  assert.deepEqual(
+    applyPatch({}, [
+      { op: "add", path: "/a", value: 1 },
+      { op: "copy", from: "/a", path: "/b" },
+      { op: "test", path: "/b", value: 1 },
+    ]),
+    { a: 1, b: 1 },
+  );
+  assert.throws(() =>
+    applyPatch({}, [
+      { op: "add", path: "/a", value: 1 },
+      { op: "test", path: "/a", value: 2 },
+    ]),
+  );
+});
+
+test("inputs are never mutated and the result shares nothing with them", () => {
+  const doc = { a: { b: [1, 2] } };
+  const value = { v: 1 };
+  const patch = [
+    { op: "add", path: "/a/b/-", value: 3 },
+    { op: "add", path: "/c", value },
+    { op: "remove", path: "/a/b/0" },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const out = applyPatch(doc, patch) as { c: object };
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.notEqual(out.c, value);
+  assert.deepEqual(applyPatch(doc, []), doc);
+  assert.notEqual(applyPatch(doc, []), doc);
+});
+
+test("invalid patches", () => {
+  assert.throws(() => applyPatch({}, {} as never));
+  assert.throws(() => applyPatch({}, [null] as never));
+  assert.throws(() => applyPatch({}, [[]] as never));
+  assert.throws(() => applyPatch({}, [{ path: "/a", value: 1 }] as never));
+  assert.throws(() => applyPatch({}, [{ op: "bogus", path: "/a" }] as never));
+  assert.throws(() => applyPatch({}, [{ op: "add", value: 1 }] as never));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: 1, value: 1 }] as never));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "a", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "move", path: "/a" }] as never));
+  assert.throws(() => applyPatch({}, [{ op: "copy", path: "/a", from: 1 }] as never));
+});
