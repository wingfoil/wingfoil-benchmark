+
+# Task
+
+Implement JSON Patch (RFC 6902) as `applyPatch(document, patch)`, exported from `src/index.ts`.
+
+## What was done
+
+- `src/index.ts`: `applyPatch` and the `PatchOperation` type, with the six operations add, remove,
+  replace, move, copy and test. `resolvePointer` now shares a `parsePointer` helper with it.
+- `test/patch.test.ts`: RFC §4 and Appendix A cases, error paths, atomicity, non-mutation and
+  `__proto__` handling. Run with `npm test`.
+- Design choices are in decision-log dl-002.
diff --git a/src/index.ts b/src/index.ts
index 0631ab6a4f017c8f1e8b90b2b832e8fe72da3d52..4e1d1b92c2224f616a7058eafc2e2e700aeff415 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -46,17 +46,191 @@ function step(current: unknown, token: string, pointer: string): JsonValue {
  * value of `document`.
  */
 export function resolvePointer(document: unknown, pointer: string): JsonValue {
+  let current: unknown = document;
+  for (const token of parsePointer(pointer)) {
+    current = step(current, token, pointer);
+  }
+  return current as JsonValue;
+}
+
+/** Splits a JSON Pointer into its decoded reference tokens, or throws if it is invalid. */
+function parsePointer(pointer: string): string[] {
   if (typeof pointer !== "string") {
     throw new Error("Invalid JSON Pointer: not a string");
   }
-  if (pointer === "") return document as JsonValue;
+  if (pointer === "") return [];
   if (!pointer.startsWith("/")) {
     throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
   }
-  const tokens = pointer.slice(1).split("/").map(unescapeToken);
-  let current: unknown = document;
-  for (const token of tokens) {
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+/** A JSON Patch operation (RFC 6902 §4). */
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; path: string; from: string };
+
+type Container = JsonValue[] | { [key: string]: JsonValue };
+
+const HAS_VALUE = new Set(["add", "replace", "test"]);
+const HAS_FROM = new Set(["move", "copy"]);
+const OPERATIONS = new Set(["remove", ...HAS_VALUE, ...HAS_FROM]);
+
+function isObject(value: unknown): value is { [key: string]: unknown } {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** Checks the shape of one operation (RFC 6902 §4), or throws. */
+function validateOperation(operation: unknown, index: number): PatchOperation {
+  const where = `Invalid JSON Patch: operation ${index}`;
+  if (!isObject(operation)) throw new Error(`${where} is not an object`);
+  const { op } = operation;
+  if (typeof op !== "string" || !OPERATIONS.has(op)) {
+    throw new Error(`${where} has a missing or unknown "op"`);
+  }
+  if (typeof operation.path !== "string") throw new Error(`${where} needs a string "path"`);
+  if (HAS_FROM.has(op) && typeof operation.from !== "string") {
+    throw new Error(`${where} needs a string "from"`);
+  }
+  if (HAS_VALUE.has(op) && !Object.prototype.hasOwnProperty.call(operation, "value")) {
+    throw new Error(`${where} needs a "value"`);
+  }
+  return operation as PatchOperation;
+}
+
+/** Deep copy, so the result never shares structure with the document or the patch. */
+function clone<T extends JsonValue>(value: T): T {
+  return structuredClone(value);
+}
+
+/** Deep equality as defined for `test` (RFC 6902 §4.6): member order is irrelevant. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.prototype.hasOwnProperty.call(b, key) && jsonEqual(a[key], b[key]))
+    );
+  }
+  return a === b;
+}
+
+/** Finds the container holding the last token of `tokens`, which must already exist. */
+function parentOf(document: JsonValue, tokens: string[], pointer: string): Container {
+  let current: JsonValue = document;
+  for (const token of tokens.slice(0, -1)) {
     current = step(current, token, pointer);
   }
-  return current as JsonValue;
+  if (typeof current !== "object" || current === null) {
+    throw new Error(`JSON Pointer "${pointer}" does not resolve: parent is not a container`);
+  }
+  return current;
+}
+
+/** Sets an object member as an own data property, so `__proto__` stays an ordinary key. */
+function setMember(object: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
+
+/** Reads the array index named by `token`, allowing one past the end when `allowEnd` is set. */
+function arrayIndex(array: JsonValue[], token: string, allowEnd: boolean, pointer: string): number {
+  if (allowEnd && token === "-") return array.length;
+  const index = ARRAY_INDEX.test(token) ? Number(token) : -1;
+  if (index < 0 || index > array.length || (index === array.length && !allowEnd)) {
+    throw new Error(`JSON Pointer "${pointer}" does not resolve: bad array index "${token}"`);
+  }
+  return index;
+}
+
+/** `add` (RFC 6902 §4.1); returns the new document. */
+function addValue(document: JsonValue, pointer: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(document, tokens, pointer);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(parent, token, true, pointer), 0, value);
+  } else {
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+/** Removes the value at `pointer`, which must exist; returns the document and the removed value. */
+function removeValue(document: JsonValue, pointer: string): [JsonValue, JsonValue] {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    throw new Error("Cannot remove the whole document: the result would not be a JSON value");
+  }
+  const parent = parentOf(document, tokens, pointer);
+  const token = tokens[tokens.length - 1];
+  const removed = step(parent, token, pointer);
+  if (Array.isArray(parent)) {
+    parent.splice(Number(token), 1);
+  } else {
+    delete parent[token];
+  }
+  return [document, removed];
+}
+
+/** Applies one validated operation to `document` (already private to the caller). */
+function applyOperation(document: JsonValue, operation: PatchOperation): JsonValue {
+  switch (operation.op) {
+    case "add":
+      return addValue(document, operation.path, clone(operation.value));
+    case "remove":
+      return removeValue(document, operation.path)[0];
+    case "replace": {
+      if (parsePointer(operation.path).length === 0) return clone(operation.value);
+      resolvePointer(document, operation.path);
+      return addValue(removeValue(document, operation.path)[0], operation.path, clone(operation.value));
+    }
+    case "move": {
+      const from = parsePointer(operation.from);
+      const to = parsePointer(operation.path);
+      if (from.length < to.length && from.every((token, i) => token === to[i])) {
+        throw new Error(`Cannot move "${operation.from}" into one of its own children`);
+      }
+      const [without, moved] = removeValue(document, operation.from);
+      return addValue(without, operation.path, moved);
+    }
+    case "copy":
+      return addValue(document, operation.path, clone(resolvePointer(document, operation.from)));
+    case "test":
+      if (!jsonEqual(resolvePointer(document, operation.path), operation.value)) {
+        throw new Error(`JSON Patch test failed at "${operation.path}"`);
+      }
+      return document;
+  }
+}
+
+/**
+ * Applies the JSON Patch `patch` (RFC 6902) to `document` and returns the resulting document.
+ *
+ * Neither argument is mutated, and the result shares no structure with either. Operations
+ * run in order and the patch is atomic: if one fails, nothing is returned. `-` addresses
+ * the end of an array for `add`, `move` and `copy` targets only. Removing the whole
+ * document is rejected, since the result would not be a JSON value.
+ *
+ * @throws Error if `patch` is not a valid JSON Patch, or if an operation fails (a pointer
+ * that does not resolve, a failed `test`, a `move` into its own child).
+ */
+export function applyPatch(document: unknown, patch: PatchOperation[]): JsonValue {
+  if (!Array.isArray(patch)) throw new Error("Invalid JSON Patch: not an array");
+  const operations = patch.map(validateOperation);
+  let result = clone(document as JsonValue);
+  for (const operation of operations) {
+    result = applyOperation(result, operation);
+  }
+  return result;
 }
diff --git a/test/patch.test.ts b/test/patch.test.ts
