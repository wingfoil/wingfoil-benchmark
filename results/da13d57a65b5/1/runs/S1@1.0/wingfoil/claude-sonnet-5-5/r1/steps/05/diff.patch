+---
+id: task-005-implement-createpatch-json-patch-diff-rfc-6902
+type: task
+title: "Implement createPatch (JSON Patch diff, RFC 6902)"
+status: pending
+format: 1
+---
+
+
+## Request
+Clients want to send only what changed between two JSON documents: add `createPatch(from, to)` returning an RFC 6902 patch.
+
+## Done
+- Added `createPatch` to `src/index.ts`; it descends into objects and arrays and emits only the differing `add`/`remove`/`replace` operations.
+- Equal documents give `[]`; inputs are not mutated and the patch shares no structure with them.
+- Added `test/create-patch.test.ts` (round trip through `applyPatch`, minimality, escaping, `__proto__`, non-mutation).
diff --git a/src/index.ts b/src/index.ts
index e8c806cd40812e4f4af21e5aa398e9ad6b934114..c4b39efad1f6f146172d29dab8835e26168a25a3 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -277,3 +277,87 @@ function mergeValue(target: unknown, patch: unknown): JsonValue {
 export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
   return mergeValue(target, patch);
 }
+
+/** Encodes one reference token (RFC 6901 §3): `~` is `~0` and `/` is `~1`. */
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Appends the operations turning `from` into `to`, both found at `path`, to `operations`. */
+function diffValue(from: JsonValue, to: JsonValue, path: string, operations: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(from, to, path, operations);
+  } else if (isObject(from) && isObject(to)) {
+    diffObject(from, to, path, operations);
+  } else {
+    operations.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+function diffObject(
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  path: string,
+  operations: PatchOperation[],
+): void {
+  const has = (object: object, key: string) => Object.prototype.hasOwnProperty.call(object, key);
+  for (const key of Object.keys(from)) {
+    if (!has(to, key)) operations.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+  }
+  for (const key of Object.keys(to)) {
+    const member = `${path}/${escapeToken(key)}`;
+    if (has(from, key)) {
+      diffValue(from[key], to[key], member, operations);
+    } else {
+      operations.push({ op: "add", path: member, value: clone(to[key]) });
+    }
+  }
+}
+
+/**
+ * Arrays are compared after trimming the elements they share at both ends, so inserting or
+ * removing one element does not rewrite every element after it. What is left in between is
+ * diffed position by position, then extra elements are removed (last first) or appended.
+ */
+function diffArray(
+  from: JsonValue[],
+  to: JsonValue[],
+  path: string,
+  operations: PatchOperation[],
+): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && jsonEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+  const common = Math.min(fromEnd, toEnd) - start;
+  for (let i = start; i < start + common; i++) {
+    diffValue(from[i], to[i], `${path}/${i}`, operations);
+  }
+  for (let i = fromEnd - 1; i >= start + common; i--) {
+    operations.push({ op: "remove", path: `${path}/${i}` });
+  }
+  for (let i = start + common; i < toEnd; i++) {
+    operations.push({ op: "add", path: `${path}/${i}`, value: clone(to[i]) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch is minimal in granularity: it descends into objects and arrays and only touches
+ * what differs, using `add`, `remove` and `replace` (never `test`, `move` or `copy`). Equal
+ * documents give an empty patch, and documents that differ at the root, or are not both
+ * objects or both arrays, give a single `replace` of the whole document. Member order is
+ * irrelevant, as for `test`. Neither argument is mutated, and the patch shares no structure
+ * with either.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const operations: PatchOperation[] = [];
+  diffValue(from as JsonValue, to as JsonValue, "", operations);
+  return operations;
+}
