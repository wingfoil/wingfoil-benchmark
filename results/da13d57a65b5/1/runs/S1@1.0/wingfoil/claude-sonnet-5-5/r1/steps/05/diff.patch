index 0000000000000000000000000000000000000000..62a84fb6a8bc39cf78ab37e01a6b8bcf0543f223
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,63 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown) {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch, whatever the member order", () => {
+  assert.deepEqual(createPatch({ a: 1, b: [1, 2] }, { b: [1, 2], a: 1 }), []);
+  assert.deepEqual(createPatch(1, 1), []);
+});
+
+test("a small change gives a small patch", () => {
+  const from = { name: "x", tags: ["a", "b"], deep: { n: 1, big: { k: [1, 2, 3] } } };
+  const to = { name: "x", tags: ["a", "b"], deep: { n: 2, big: { k: [1, 2, 3] } } };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/deep/n", value: 2 }]);
+});
+
+test("members are added, removed and replaced", () => {
+  const patch = roundTrip({ a: 1, b: 2, c: { d: 1 } }, { a: 1, c: { d: 1, e: 5 }, f: null });
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c/e", value: 5 },
+    { op: "add", path: "/f", value: null },
+  ]);
+});
+
+test("array insertion and removal do not rewrite the following elements", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 9, 2, 3, 4]), [{ op: "add", path: "/1", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 4]), [{ op: "remove", path: "/2" }]);
+  assert.deepEqual(roundTrip([1, 2, 3], []).length, 3);
+  roundTrip([], [1, 2]);
+  roundTrip([1, 2, 3, 4, 5], [1, 7, 5]);
+  roundTrip([{ a: 1 }, { b: 2 }], [{ a: 1 }, { b: 3 }, { c: 4 }]);
+});
+
+test("different types and root changes are replaced", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  roundTrip({ a: [1] }, { a: { b: 1 } });
+  roundTrip({ a: null }, { a: 0 });
+  roundTrip("x", null);
+});
+
+test("keys needing escapes and __proto__ are handled", () => {
+  const from = JSON.parse('{"a/b":1,"m~n":2,"__proto__":{"x":1}}');
+  const to = JSON.parse('{"a/b":2,"m~n":3,"__proto__":{"x":2}}');
+  const patch = roundTrip(from, to);
+  assert.deepEqual(patch.map((op) => op.path), ["/a~1b", "/m~0n", "/__proto__/x"]);
+});
+
+test("inputs are not mutated and the patch shares no structure with them", () => {
+  const from = { a: [1] };
+  const to = { a: [1], b: { c: [2] } };
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  assert.notEqual((patch[0] as { value: unknown }).value, to.b);
+});
