@@ -0,0 +1,51 @@
+import { deepEqual } from "./patch.ts";
+
+type Operation = { op: "add" | "replace"; path: string; value: unknown } | { op: "remove"; path: string };
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: Operation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && deepEqual(from[start], to[start])) start++;
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && deepEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+  const common = Math.min(fromEnd, toEnd) - start;
+  for (let i = 0; i < common; i++) diff(from[start + i], to[start + i], `${path}/${start + i}`, ops);
+  for (let i = start + common; i < fromEnd; i++) ops.push({ op: "remove", path: `${path}/${start + common}` });
+  for (let i = start + common; i < toEnd; i++) ops.push({ op: "add", path: `${path}/${i}`, value: structuredClone(to[i]) });
+}
+
+function diff(from: unknown, to: unknown, path: string, ops: Operation[]): void {
+  if (deepEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(from, key)) diff(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: structuredClone(to[key]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/** Returns a JSON Patch (RFC 6902) that turns `from` into `to`, describing only what changed; inputs are not mutated. */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const ops: Operation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
