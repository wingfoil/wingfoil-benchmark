@@ -0,0 +1,38 @@
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/** Splits a JSON Pointer (RFC 6901 §3) into its unescaped reference tokens. */
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return [];
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`);
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+/** Returns the value of `document` that `pointer` (RFC 6901) refers to; throws if invalid or unresolvable. */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const token of parsePointer(pointer)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`JSON Pointer "${pointer}" does not resolve: no array element "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null && Object.hasOwn(current, token)) {
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: no value at "${token}"`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f82a9bf5545f275cda7d5928f2c289ede82ca05d
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,62 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+  nil: null,
+  "01": "zero-one",
+};
+
+test("RFC 6901 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("null values, object numeric keys, ~01", () => {
+  assert.equal(resolvePointer(doc, "/nil"), null);
+  assert.equal(resolvePointer(doc, "/01"), "zero-one");
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["foo", "#/foo", "/a~", "/a~2", "/~", "/a~x"]) {
+    assert.throws(() => resolvePointer(doc, p), p);
+  }
+  assert.throws(() => resolvePointer(doc, undefined as never));
+});
+
+test("unresolvable pointers throw", () => {
+  for (const p of [
+    "/missing", "/foo/2", "/foo/-", "/foo/00", "/foo/01", "/foo/+1", "/foo/1e0",
+    "/foo/-1", "/foo/x", "/foo/0/0", "/nil/x", "/a~1b/x", "/constructor", "/__proto__",
+    "/toString", "/foo/length",
+  ]) {
+    assert.throws(() => resolvePointer(doc, p), p);
+  }
+  assert.throws(() => resolvePointer(5, "/x"));
+});
+
+test("own __proto__ member resolves", () => {
+  const d = JSON.parse('{"__proto__": 1}');
+  assert.equal(resolvePointer(d, "/__proto__"), 1);
+});
