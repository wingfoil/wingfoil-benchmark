+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 Appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) assert.deepEqual(applyMergePatch(target, patch), expected);
+});
+
+test("nulls inside arrays are kept", () => {
+  assert.deepEqual(applyMergePatch({}, { a: [null, { b: null }] }), { a: [null, { b: null }] });
+});
+
+test("does not mutate or share structure", () => {
+  const target = { a: { b: 1 } };
+  const patch = { c: { d: [1] } };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 } });
+  assert.deepEqual(patch, { c: { d: [1] } });
+  assert.notEqual(result.a, target.a);
+  assert.notEqual(result.c.d, patch.c.d);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true}}');
+  const result = applyMergePatch({}, patch) as any;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as any).polluted, undefined);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+});
