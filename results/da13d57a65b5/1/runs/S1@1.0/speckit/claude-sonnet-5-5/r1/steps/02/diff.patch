@@ -0,0 +1,92 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) => assert.deepEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch));
+
+test("RFC 6902 Appendix A examples", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  ok(
+    { baz: "qux", foo: ["a", 2, "c"] },
+    [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }],
+    { baz: "qux", foo: ["a", 2, "c"] },
+  );
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], {
+    foo: "bar",
+    child: { grandchild: {} },
+  });
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }, ], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  bad({ foo: "bar" }, [{ op: "remove", path: "/baz" }]);
+});
+
+test("copy, root operations, test equality", () => {
+  const doc = { a: { b: [1] } };
+  const out = applyPatch(doc, [{ op: "copy", from: "/a", path: "/c" }]) as any;
+  assert.deepEqual(out.c, { b: [1] });
+  assert.notEqual(out.c, out.a);
+  ok(doc, [{ op: "add", path: "", value: 5 }], 5);
+  ok(doc, [{ op: "replace", path: "", value: [] }], []);
+  ok({ a: 1, b: 2 }, [{ op: "test", path: "", value: { b: 2, a: 1 } }], { a: 1, b: 2 });
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+  bad({ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]);
+  ok({ a: null }, [{ op: "test", path: "/a", value: null }], { a: null });
+  bad({}, [{ op: "test", path: "/a", value: null }]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+});
+
+test("failures", () => {
+  bad({}, {});
+  bad({}, [null]);
+  bad({}, [{ op: "nope", path: "" }]);
+  bad({}, [{ path: "/a" }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "add", value: 1 }]);
+  bad({}, [{ op: "add", path: "a", value: 1 }]);
+  bad({}, [{ op: "move", path: "/a" }]);
+  bad({}, [{ op: "copy", path: "/a", from: "/x" }]);
+  bad({}, [{ op: "remove", path: "" }]);
+  bad({ a: 1 }, [{ op: "replace", path: "/b", value: 1 }]);
+  bad([1], [{ op: "add", path: "/2", value: 1 }]);
+  bad([1], [{ op: "add", path: "/01", value: 1 }]);
+  bad([1], [{ op: "replace", path: "/1", value: 1 }]);
+  bad([1], [{ op: "remove", path: "/-" }]);
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/c" }]);
+  bad(1, [{ op: "add", path: "/a", value: 1 }]);
+  ok({ ab: 1, a: 2 }, [{ op: "move", from: "/a", path: "/ab" }], { ab: 2 });
+});
+
+test("does not mutate input and shares no structure", () => {
+  const doc = { a: [1, { b: 2 }] };
+  const value = { x: [1] };
+  const patch = [{ op: "add", path: "/a/0", value }, { op: "remove", path: "/a/2/b" }];
+  const snapshot = structuredClone({ doc, patch });
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual({ doc, patch }, snapshot);
+  assert.notEqual(out.a[0], value);
+  assert.notEqual(out.a[2], doc.a[1]);
+  assert.throws(() => applyPatch(doc, [{ op: "remove", path: "/a/0" }, { op: "remove", path: "/zz" }]));
+  assert.deepEqual(doc, snapshot.doc);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as any;
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(({} as any).polluted, undefined);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+});
