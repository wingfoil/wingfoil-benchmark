@@ -0,0 +1,153 @@
+import { parsePointer } from "./pointer.ts";
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+type Container = Record<string, unknown> | unknown[];
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function has(value: object, key: string): boolean {
+  return Object.hasOwn(value, key);
+}
+
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => deepEqual(item, b[i]));
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((k) => has(b, k) && deepEqual(a[k], b[k]));
+  }
+  return false;
+}
+
+/** Walks to the container holding the last token of `tokens`. */
+function parentOf(root: unknown, tokens: string[], pointer: string): Container {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current) && ARRAY_INDEX.test(token) && Number(token) < current.length) {
+      current = current[Number(token)];
+    } else if (isObject(current) && has(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`JSON Patch: path "${pointer}" does not exist`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new Error(`JSON Patch: parent of "${pointer}" is not an object or array`);
+  }
+  return current;
+}
+
+function get(root: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return root;
+  const parent = parentOf(root, tokens, pointer);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(key) || Number(key) >= parent.length) {
+      throw new Error(`JSON Patch: path "${pointer}" does not exist`);
+    }
+    return parent[Number(key)];
+  }
+  if (!has(parent, key)) throw new Error(`JSON Patch: path "${pointer}" does not exist`);
+  return parent[key];
+}
+
+function add(root: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens, pointer);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (key === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(key) && Number(key) <= parent.length) {
+      parent.splice(Number(key), 0, value);
+    } else {
+      throw new Error(`JSON Patch: invalid array index in "${pointer}"`);
+    }
+  } else {
+    setMember(parent, key, value);
+  }
+  return root;
+}
+
+function remove(root: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) throw new Error("JSON Patch: cannot remove the whole document");
+  get(root, pointer); // throws if the target does not exist
+  const parent = parentOf(root, tokens, pointer);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(key), 1);
+  else delete parent[key];
+  return root;
+}
+
+function requireMember(operation: Record<string, unknown>, name: string, index: number): unknown {
+  if (!has(operation, name)) throw new Error(`JSON Patch: operation ${index} is missing "${name}"`);
+  return operation[name];
+}
+
+function requireFrom(operation: Record<string, unknown>, index: number): string {
+  const from = requireMember(operation, "from", index);
+  if (typeof from !== "string") throw new Error(`JSON Patch: operation ${index} has a non-string "from"`);
+  parsePointer(from);
+  return from;
+}
+
+/** Applies a JSON Patch (RFC 6902) to `document`, returning a new document; throws on invalid patch or failed operation. */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new Error("JSON Patch: patch must be an array");
+  let result = structuredClone(document);
+  patch.forEach((operation: unknown, index: number) => {
+    if (!isObject(operation)) throw new Error(`JSON Patch: operation ${index} is not an object`);
+    const { op, path } = operation;
+    if (typeof path !== "string") throw new Error(`JSON Patch: operation ${index} has a missing or non-string "path"`);
+    parsePointer(path);
+    switch (op) {
+      case "add":
+        result = add(result, path, structuredClone(requireMember(operation, "value", index)));
+        break;
+      case "remove":
+        result = remove(result, path);
+        break;
+      case "replace": {
+        const value = structuredClone(requireMember(operation, "value", index));
+        get(result, path);
+        result = parsePointer(path).length === 0 ? value : add(remove(result, path), path, value);
+        break;
+      }
+      case "move": {
+        const from = requireFrom(operation, index);
+        if (from !== path && (path + "/").startsWith(from + "/")) {
+          throw new Error(`JSON Patch: cannot move "${from}" into its own child "${path}"`);
+        }
+        const value = get(result, from);
+        if (from === path) break;
+        result = add(remove(result, from), path, value);
+        break;
+      }
+      case "copy": {
+        const from = requireFrom(operation, index);
+        result = add(result, path, structuredClone(get(result, from)));
+        break;
+      }
+      case "test":
+        if (!deepEqual(get(result, path), requireMember(operation, "value", index))) {
+          throw new Error(`JSON Patch: test failed at "${path}"`);
+        }
+        break;
+      default:
+        throw new Error(`JSON Patch: operation ${index} has an unknown "op"`);
+    }
+  });
+  return result;
+}
