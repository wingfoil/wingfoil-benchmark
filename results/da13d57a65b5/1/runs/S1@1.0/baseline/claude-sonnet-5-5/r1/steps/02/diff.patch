--- a/src/index.ts
+++ b/src/index.ts
@@ -53,3 +53,170 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; path: string; from: string };
+
+function clone(value: unknown): JsonValue {
+  if (Array.isArray(value)) return value.map(clone);
+  if (typeof value === "object" && value !== null) {
+    const out: Record<string, JsonValue> = {};
+    for (const key of Object.keys(value)) {
+      // defineProperty so that a "__proto__" member stays an ordinary member.
+      Object.defineProperty(out, key, {
+        value: clone((value as Record<string, unknown>)[key]),
+        enumerable: true,
+        writable: true,
+        configurable: true,
+      });
+    }
+    return out;
+  }
+  return value as JsonValue;
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return (
+      Array.isArray(b) && a.length === b.length && a.every((v, i) => deepEqual(v, b[i]))
+    );
+  }
+  if (typeof a === "object" && a !== null) {
+    if (typeof b !== "object" || b === null || Array.isArray(b)) return false;
+    const ka = Object.keys(a);
+    if (ka.length !== Object.keys(b).length) return false;
+    return ka.every(
+      (k) =>
+        Object.hasOwn(b, k) &&
+        deepEqual((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]),
+    );
+  }
+  return a === b;
+}
+
+/** Splits a pointer into the pointer of its parent and its unescaped last token. */
+function splitPointer(pointer: string): { parent: string; token: string } {
+  resolvePointerSyntax(pointer);
+  const i = pointer.lastIndexOf("/");
+  return { parent: pointer.slice(0, i), token: unescapeToken(pointer.slice(i + 1)) };
+}
+
+function resolvePointerSyntax(pointer: string): void {
+  if (pointer !== "" && pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  for (const raw of pointer.split("/").slice(1)) unescapeToken(raw);
+}
+
+function setMember(obj: object, key: string, value: JsonValue): void {
+  Object.defineProperty(obj, key, {
+    value,
+    enumerable: true,
+    writable: true,
+    configurable: true,
+  });
+}
+
+function arrayIndex(token: string, max: number): number {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`Invalid array index "${token}"`);
+  }
+  const index = Number(token);
+  if (index > max) throw new Error(`Array index ${token} out of range`);
+  return index;
+}
+
+function addValue(doc: JsonValue, path: string, value: JsonValue): JsonValue {
+  if (path === "") return value;
+  const { parent, token } = splitPointer(path);
+  const target = resolvePointer(doc, parent);
+  if (Array.isArray(target)) {
+    const index = token === "-" ? target.length : arrayIndex(token, target.length);
+    target.splice(index, 0, value);
+  } else if (typeof target === "object" && target !== null) {
+    setMember(target, token, value);
+  } else {
+    throw new Error(`Cannot add at "${path}": parent is a scalar`);
+  }
+  return doc;
+}
+
+function removeValue(doc: JsonValue, path: string): JsonValue {
+  if (path === "") throw new Error("Cannot remove the document root");
+  const { parent, token } = splitPointer(path);
+  resolvePointer(doc, path); // must exist
+  const target = resolvePointer(doc, parent);
+  if (Array.isArray(target)) target.splice(arrayIndex(token, target.length - 1), 1);
+  else delete (target as Record<string, unknown>)[token];
+  return doc;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a document and returns the result as a new value.
+ * The inputs are not modified. Throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): JsonValue {
+  if (!Array.isArray(patch)) throw new Error("Invalid JSON Patch: not an array");
+  let doc = clone(document);
+
+  for (const operation of patch) {
+    if (typeof operation !== "object" || operation === null || Array.isArray(operation)) {
+      throw new Error("Invalid JSON Patch: operation is not an object");
+    }
+    const o = operation as Record<string, unknown>;
+    if (typeof o.path !== "string") {
+      throw new Error('Invalid JSON Patch: "path" must be a string');
+    }
+    const hasValue = Object.hasOwn(o, "value") && o.value !== undefined;
+    const needFrom = () => {
+      if (typeof o.from !== "string") {
+        throw new Error('Invalid JSON Patch: "from" must be a string');
+      }
+      return o.from;
+    };
+    const needValue = () => {
+      if (!hasValue) throw new Error('Invalid JSON Patch: missing "value"');
+      return clone(o.value);
+    };
+
+    switch (o.op) {
+      case "add":
+        doc = addValue(doc, o.path, needValue());
+        break;
+      case "remove":
+        doc = removeValue(doc, o.path);
+        break;
+      case "replace": {
+        const value = needValue();
+        resolvePointer(doc, o.path); // must exist
+        doc = o.path === "" ? value : addValue(removeValue(doc, o.path), o.path, value);
+        break;
+      }
+      case "move": {
+        const from = needFrom();
+        const value = clone(resolvePointer(doc, from));
+        if (from === o.path) break;
+        if (o.path.startsWith(from + "/")) {
+          throw new Error("Cannot move a value into one of its children");
+        }
+        doc = addValue(removeValue(doc, from), o.path, value);
+        break;
+      }
+      case "copy": {
+        const from = needFrom();
+        doc = addValue(doc, o.path, clone(resolvePointer(doc, from)));
+        break;
+      }
+      case "test":
+        if (!deepEqual(resolvePointer(doc, o.path), needValue())) {
+          throw new Error(`Test failed at "${o.path}"`);
+        }
+        break;
+      default:
+        throw new Error(`Invalid JSON Patch: unknown op ${JSON.stringify(o.op)}`);
+    }
+  }
+  return doc;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9b7fefd8093958f42dad66fc3c27fcaac09235fb
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,34 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("RFC 6902 examples", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(applyPatch({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(applyPatch([1, 2, 3], [{ op: "remove", path: "/1" }]), [1, 3]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]),
+    { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(applyPatch({ a: [1] }, [{ op: "copy", from: "/a", path: "/b" }]), { a: [1], b: [1] });
+  assert.deepEqual(applyPatch({ a: { b: 1, c: 2 } }, [{ op: "test", path: "/a", value: { c: 2, b: 1 } }]), { a: { b: 1, c: 2 } });
+});
+
+test("errors and purity", () => {
+  const d = { a: [1] };
+  assert.throws(() => applyPatch(d, [{ op: "add", path: "/a/-", value: 2 }, { op: "test", path: "/a", value: [] }]));
+  assert.deepEqual(d, { a: [1] });
+  assert.throws(() => applyPatch(d, [{ op: "add", path: "/x/y", value: 1 }]));
+  assert.throws(() => applyPatch(d, [{ op: "add", path: "/a/3", value: 1 }]));
+  assert.throws(() => applyPatch(d, [{ op: "remove", path: "/b" }]));
+  assert.throws(() => applyPatch(d, [{ op: "replace", path: "/b", value: 1 }]));
+  assert.throws(() => applyPatch(d, [{ op: "move", from: "/a", path: "/a/0" }]));
+  assert.throws(() => applyPatch(d, [{ op: "add", path: "/b" }]));
+  assert.throws(() => applyPatch(d, [{ op: "bogus", path: "/b" }]));
+  assert.throws(() => applyPatch(d, {}));
+  assert.deepEqual(applyPatch(d, [{ op: "add", path: "", value: 5 }]), 5);
+});
