@@ -242,3 +242,27 @@ export function applyPatch(document: unknown, patch: unknown): JsonValue {
   }
   return doc;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a document and returns the result as a new value.
+ * The inputs are not modified.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
+  if (typeof patch !== "object" || patch === null || Array.isArray(patch)) {
+    return clone(patch);
+  }
+  const result: Record<string, JsonValue> =
+    typeof target === "object" && target !== null && !Array.isArray(target)
+      ? (clone(target) as Record<string, JsonValue>)
+      : {};
+  for (const key of Object.keys(patch)) {
+    const value = (patch as Record<string, unknown>)[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = Object.hasOwn(result, key) ? result[key] : undefined;
+      setMember(result, key, applyMergePatch(current, value));
+    }
+  }
+  return result;
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..92ba5fad69cd2b5fc33f81f67a4a0d087336b6f9
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,30 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 examples", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: "c" }), { a: "c" });
+  assert.deepEqual(applyMergePatch({ a: "b" }, { b: "c" }), { a: "b", b: "c" });
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: null }), {});
+  assert.deepEqual(applyMergePatch({ a: "b", b: "c" }, { a: null }), { b: "c" });
+  assert.deepEqual(applyMergePatch({ a: ["b"] }, { a: "c" }), { a: "c" });
+  assert.deepEqual(applyMergePatch({ a: "c" }, { a: ["b"] }), { a: ["b"] });
+  assert.deepEqual(applyMergePatch({ a: { b: "c" } }, { a: { b: "d", c: null } }), { a: { b: "d" } });
+  assert.deepEqual(applyMergePatch({ a: [{ b: "c" }] }, { a: [1] }), { a: [1] });
+  assert.deepEqual(applyMergePatch(["a", "b"], ["c", "d"]), ["c", "d"]);
+  assert.deepEqual(applyMergePatch({ a: "b" }, ["c"]), ["c"]);
+  assert.deepEqual(applyMergePatch({ a: "foo" }, null), null);
+  assert.deepEqual(applyMergePatch({ a: "foo" }, "bar"), "bar");
+  assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+  assert.deepEqual(applyMergePatch([1, 2], { a: "b", c: null }), { a: "b" });
+  assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+});
+
+test("does not mutate inputs; __proto__ is an ordinary member", () => {
+  const t = { a: { b: 1 } };
+  const p = JSON.parse('{"a":{"c":2},"__proto__":{"x":1}}');
+  const r = applyMergePatch(t, p) as Record<string, unknown>;
+  assert.deepEqual(t, { a: { b: 1 } });
+  assert.deepEqual(Object.getPrototypeOf(r), Object.prototype);
+  assert.deepEqual(Object.keys(r), ["a", "__proto__"]);
+});
