@@ -77,6 +77,23 @@ function clone(value: unknown): JsonValue {
   return value as JsonValue;
 }
 
+function assertJson(value: unknown): void {
+  if (value === null || typeof value === "boolean" || typeof value === "string") return;
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) throw new Error("Invalid JSON Patch: \"value\" is not a JSON number");
+    return;
+  }
+  if (Array.isArray(value)) {
+    for (let i = 0; i < value.length; i++) assertJson(value[i]);
+    return;
+  }
+  if (typeof value === "object") {
+    for (const key of Object.keys(value)) assertJson((value as Record<string, unknown>)[key]);
+    return;
+  }
+  throw new Error("Invalid JSON Patch: \"value\" is not a JSON value");
+}
