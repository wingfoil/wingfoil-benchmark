--- a/src/index.ts
+++ b/src/index.ts
@@ -239,3 +239,24 @@ export function applyPatch(document: unknown, patch: unknown): JsonValue {
   }
   return result;
 }
+
+/**
+ * Applies an RFC 7386 JSON Merge Patch to a target document and returns the result as a new value.
+ * Neither input is mutated. A `null` member in the patch removes the member from the target.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
+  if (!isObject(patch)) return structuredClone(patch) as JsonValue;
+  const result: Record<string, JsonValue> = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) setMember(result, key, structuredClone(target[key]));
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d6ce2916db1a770fc1c7d5a55d0b0553f9a34d47
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,24 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 example", () => {
+  const target = { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["a", "b"], content: "x" };
+  const patch = { title: "Hello!", phoneNumber: "+01-123", author: { familyName: null }, tags: ["c"] };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!", author: { givenName: "John" }, tags: ["c"], content: "x", phoneNumber: "+01-123",
+  });
+});
+
+test("non-object patch replaces; non-object target treated as {}", () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, [1]), [1]);
+  assert.deepEqual(applyMergePatch([1], { a: { b: null } }), { a: {} });
+  assert.equal(applyMergePatch({ a: 1 }, null), null);
+});
+
+test("does not mutate inputs or pollute prototypes", () => {
+  const target = { a: { b: 1 } };
+  applyMergePatch(target, JSON.parse('{"a":{"c":2},"__proto__":{"x":1}}'));
+  assert.deepEqual(target, { a: { b: 1 } });
+  assert.equal(({} as any).x, undefined);
+});
