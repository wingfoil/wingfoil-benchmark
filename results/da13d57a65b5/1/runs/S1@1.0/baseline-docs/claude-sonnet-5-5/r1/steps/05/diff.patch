new file mode 100644
index 0000000000000000000000000000000000000000..88f8381401b1ff66bfaafb9ca5f5a466c9a64f44
--- /dev/null
+++ b/src/diff.ts
@@ -0,0 +1,60 @@
+import type { Operation } from "./patch.ts";
+import type { JsonValue } from "./pointer.ts";
+
+type JsonObject = { [key: string]: JsonValue };
+
+function isObject(value: JsonValue): value is JsonObject {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function escapeToken(token: string): string {
+  // "~" must be encoded before "/", otherwise the "~" of "~1" would be encoded again.
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffObjects(from: JsonObject, to: JsonObject, path: string): Operation[] {
+  const removed = Object.keys(from)
+    .filter((key) => !Object.hasOwn(to, key))
+    .map((key): Operation => ({ op: "remove", path: `${path}/${escapeToken(key)}` }));
+  const changed = Object.keys(to).flatMap((key) => {
+    const child = `${path}/${escapeToken(key)}`;
+    return Object.hasOwn(from, key)
+      ? diffValues(from[key], to[key], child)
+      : [{ op: "add", path: child, value: structuredClone(to[key]) } as Operation];
+  });
+  return [...removed, ...changed];
+}
+
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string): Operation[] {
+  const shared = Math.min(from.length, to.length);
+  const changed = to.slice(0, shared).flatMap((item, index) => diffValues(from[index], item, `${path}/${index}`));
+  // Surplus elements are removed from the end, so that the remaining indices stay valid.
+  const removed = from
+    .slice(shared)
+    .map((_, offset): Operation => ({ op: "remove", path: `${path}/${from.length - 1 - offset}` }));
+  const appended = to
+    .slice(shared)
+    .map((item): Operation => ({ op: "add", path: `${path}/-`, value: structuredClone(item) }));
+  return [...changed, ...removed, ...appended];
+}
+
+function diffValues(from: JsonValue, to: JsonValue, path: string): Operation[] {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    return diffArrays(from, to, path);
+  }
+  if (isObject(from) && isObject(to)) {
+    return diffObjects(from, to, path);
+  }
+  return from === to ? [] : [{ op: "replace", path, value: structuredClone(to) }];
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * Only what changed is described: objects are compared member by member and arrays element by
+ * element, so a small difference yields a small patch, and equal documents yield an empty patch.
+ * Neither argument is modified and the patch shares no structure with them.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): Operation[] {
+  return diffValues(from, to, "");
+}
