index 0000000000000000000000000000000000000000..bfeee457a4d164c0ec1d6d493c63dfb37ce0fdfb
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,68 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { applyPatch, createPatch } from "../src/index.ts";
+import type { JsonValue } from "../src/index.ts";
+
+function roundTrip(from: JsonValue, to: JsonValue) {
+  const before = structuredClone(from);
+  const after = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, before);
+  assert.deepEqual(to, after);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: null }] }, { a: [1, { b: null }] }), []);
+  assert.deepEqual(roundTrip(1, 1), []);
+});
+
+test("a small change deep in a document gives one operation", () => {
+  const from = { a: { b: { c: 1, d: [1, 2, 3] } }, big: { x: "y" } };
+  const to = { a: { b: { c: 1, d: [1, 5, 3] } }, big: { x: "y" } };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/d/1", value: 5 }]);
+});
+
+test("object members are added, removed and replaced", () => {
+  const patch = roundTrip({ a: 1, b: 2, c: 3 }, { a: 1, c: 4, d: 5 });
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/b" },
+    { op: "replace", path: "/c", value: 4 },
+    { op: "add", path: "/d", value: 5 },
+  ]);
+});
+
+test("arrays grow and shrink at the end", () => {
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3, 4]), [
+    { op: "add", path: "/-", value: 3 },
+    { op: "add", path: "/-", value: 4 },
+  ]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2]), [
+    { op: "remove", path: "/3" },
+    { op: "remove", path: "/2" },
+  ]);
+});
+
+test("a change of type replaces the value, the whole document included", () => {
+  assert.deepEqual(roundTrip({ a: [1] }, { a: { 0: 1 } }), [{ op: "replace", path: "/a", value: { 0: 1 } }]);
+  assert.deepEqual(roundTrip(null, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip({ a: null }, { a: false }), [{ op: "replace", path: "/a", value: false }]);
+});
+
+test("keys with special characters are escaped", () => {
+  const patch = roundTrip({ "a/b": 1, "m~n": 1, "": 1 }, { "a/b": 2, "m~n": 2, "": 2 });
+  assert.deepEqual(patch.map((operation) => operation.path), ["/a~1b", "/m~0n", "/"]);
+});
+
+test("an own __proto__ member is handled as an ordinary key", () => {
+  const to = JSON.parse('{"__proto__": {"x": 1}}');
+  roundTrip({}, to);
+  roundTrip(to, {});
+});
+
+test("the patch shares no structure with the inputs", () => {
+  const to = { a: { b: 1 } };
+  const [operation] = createPatch({}, to);
+  assert.ok(operation.op === "add" && operation.value !== to.a);
+});
