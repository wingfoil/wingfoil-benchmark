diff --git a/test/rental.test.ts b/test/rental.test.ts
index 02fa93d3d68fa75a969c42f8c824cb8c55cdfc47..fcd78118b1bacadb8bee8486c32cadbf40d472a4 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -133,3 +133,51 @@ test('availability rejects an invalid period or kind', () => {
   assert.throws(() => service.availability({ start: day(2), end: day(2) }));
   assert.throws(() => service.availability({ start: day(1), end: day(2), kind: 'kite' as 'board' }));
 });
+
+const at = (hour: number, d = 1) => `2026-07-${String(d).padStart(2, '0')}T${String(hour).padStart(2, '0')}:00:00Z`;
+
+function hourlySetup() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-h', kind: 'board', dailyPrice: 4500, hourlyPrice: 800 });
+  service.addEquipment({ id: 'sail-d', kind: 'sail', dailyPrice: 2000 });
+  return service;
+}
+
+test('quote prices an hourly rental per hour', () => {
+  const quote = hourlySetup().quote({ itemId: 'board-h', start: at(13), end: at(17) });
+  assert.equal(quote.total, 3200);
+  assert.equal(quote.start, '2026-07-01T13:00:00.000Z');
+});
+
+test('hourly rental can end at midnight and is not discounted', () => {
+  assert.equal(hourlySetup().quote({ itemId: 'board-h', start: at(1), end: at(0, 2) }).total, 23 * 800);
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  const service = hourlySetup();
+  assert.throws(() => service.quote({ itemId: 'sail-d', start: at(13), end: at(15) }));
+  assert.throws(() => service.book({ itemId: 'sail-d', start: at(13), end: at(15) }));
+});
+
+test('hourly rentals reject off-the-hour times and a day or more that is not whole days', () => {
+  const service = hourlySetup();
+  assert.throws(() => service.quote({ itemId: 'board-h', start: '2026-07-01T13:30:00Z', end: at(17) }));
+  assert.throws(() => service.quote({ itemId: 'board-h', start: at(10), end: at(10, 2) }));
+  assert.throws(() => service.quote({ itemId: 'board-h', start: at(17), end: at(13) }));
+});
+
+test('hourly bookings block overlapping periods only', () => {
+  const service = hourlySetup();
+  service.book({ itemId: 'board-h', start: at(13), end: at(17) });
+  assert.throws(() => service.book({ itemId: 'board-h', start: at(16), end: at(18) }));
+  assert.throws(() => service.book({ itemId: 'board-h', start: day(1), end: day(2) }));
+  assert.equal(service.book({ itemId: 'board-h', start: at(17), end: at(18) }).total, 800);
+  assert.deepEqual(service.availability({ start: day(1), end: day(2) }), ['sail-d']);
+});
+
+test('addEquipment rejects an invalid hourly price', () => {
+  const service = createRentalService();
+  for (const hourlyPrice of [-1, 1.5, Number.NaN]) {
+    assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice }));
+  }
+});
