diff --git a/test/rental.test.ts b/test/rental.test.ts
index 39b7e48da94e50eb676b4be595126e3ece53d1e6..9a30633b5b849dc11c89c6ece7fbd97cba9c7a28 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -79,3 +79,39 @@ test('addEquipment validates items', () => {
   service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100 });
   assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100 }));
 });
+
+test('availability lists the free items of a kind, sorted', () => {
+  const service = setup();
+  service.addEquipment({ id: 'board-0', kind: 'board', dailyPrice: 4000 });
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 4000 });
+  service.book({ itemId: 'board-2', start: day(5), end: day(8) });
+  assert.deepEqual(service.availability({ start: day(6), end: day(7), kind: 'board' }), ['board-0', 'board-1']);
+  assert.deepEqual(service.availability({ start: day(8), end: day(9), kind: 'board' }), ['board-0', 'board-1', 'board-2']);
+});
+
+test('availability without a kind covers every kind', () => {
+  const service = setup();
+  service.book({ itemId: 'sail-1', start: day(1), end: day(2) });
+  assert.deepEqual(service.availability({ start: day(1), end: day(2) }), ['board-1']);
+  assert.deepEqual(service.availability({ start: day(2), end: day(3) }), ['board-1', 'sail-1']);
+});
+
+test('availability excludes items booked for any part of the period', () => {
+  const service = setup();
+  service.book({ itemId: 'board-1', start: day(5), end: day(8) });
+  for (const [s, e] of [[4, 6], [7, 9], [5, 8], [6, 7], [3, 10]]) {
+    assert.deepEqual(service.availability({ start: day(s), end: day(e), kind: 'board' }), []);
+  }
+  assert.deepEqual(service.availability({ start: day(3), end: day(5), kind: 'board' }), ['board-1']);
+});
+
+test('availability is empty when there is no equipment of the kind', () => {
+  assert.deepEqual(createRentalService().availability({ start: day(1), end: day(2) }), []);
+});
+
+test('availability rejects an invalid period or kind', () => {
+  const service = setup();
+  assert.throws(() => service.availability({ start: '2026-07-01T10:00:00Z', end: day(2) }));
+  assert.throws(() => service.availability({ start: day(2), end: day(2) }));
+  assert.throws(() => service.availability({ start: day(1), end: day(2), kind: 'kite' as 'board' }));
+});
