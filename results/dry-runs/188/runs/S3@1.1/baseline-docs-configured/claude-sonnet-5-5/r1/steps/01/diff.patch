index 0000000000000000000000000000000000000000..39b7e48da94e50eb676b4be595126e3ece53d1e6
--- /dev/null
+++ b/test/rental.test.ts
@@ -0,0 +1,81 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 4500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 2000 });
+  return service;
+}
+
+const day = (d: number) => `2026-07-${String(d).padStart(2, '0')}T00:00:00.000Z`;
+
+test('quote prices whole days in euro cents', () => {
+  const quote = setup().quote({ itemId: 'board-1', start: day(1), end: day(4) });
+  assert.deepEqual(quote, { itemId: 'board-1', start: day(1), end: day(4), total: 13500 });
+});
+
+test('quote accepts timestamps without milliseconds', () => {
+  const quote = setup().quote({ itemId: 'sail-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  assert.equal(quote.total, 2000);
+  assert.equal(quote.start, day(1));
+});
+
+test('quote rejects an unknown item', () => {
+  assert.throws(() => setup().quote({ itemId: 'nope', start: day(1), end: day(2) }));
+});
+
+test('quote rejects periods that are not whole UTC days', () => {
+  const service = setup();
+  for (const [start, end] of [
+    ['2026-07-01T10:00:00Z', day(2)],
+    [day(1), '2026-07-02T00:00:00+02:00'],
+    [day(1), '2026-07-02'],
+    [day(1), 'garbage'],
+    ['2026-02-30T00:00:00Z', day(2)],
+  ]) {
+    assert.throws(() => service.quote({ itemId: 'board-1', start, end }), start + ' ' + end);
+  }
+});
+
+test('quote rejects empty and reversed periods', () => {
+  const service = setup();
+  assert.throws(() => service.quote({ itemId: 'board-1', start: day(2), end: day(2) }));
+  assert.throws(() => service.quote({ itemId: 'board-1', start: day(3), end: day(2) }));
+});
+
+test('book returns a booking with a distinct id', () => {
+  const service = setup();
+  const a = service.book({ itemId: 'board-1', start: day(1), end: day(2) });
+  const b = service.book({ itemId: 'board-1', start: day(2), end: day(3) });
+  assert.deepEqual({ ...a, id: '' }, { id: '', itemId: 'board-1', start: day(1), end: day(2), total: 4500 });
+  assert.notEqual(a.id, b.id);
+});
+
+test('book rejects overlapping periods on the same item only', () => {
+  const service = setup();
+  service.book({ itemId: 'board-1', start: day(5), end: day(8) });
+  for (const [s, e] of [[4, 6], [7, 9], [5, 8], [6, 7], [3, 10]]) {
+    assert.throws(() => service.book({ itemId: 'board-1', start: day(s), end: day(e) }));
+  }
+  service.book({ itemId: 'board-1', start: day(3), end: day(5) });
+  service.book({ itemId: 'sail-1', start: day(5), end: day(8) });
+});
+
+test('quote does not reserve and a failed book leaves no trace', () => {
+  const service = setup();
+  service.quote({ itemId: 'board-1', start: day(1), end: day(3) });
+  assert.throws(() => service.book({ itemId: 'board-1', start: day(1), end: '2026-07-03T01:00:00Z' }));
+  service.book({ itemId: 'board-1', start: day(1), end: day(3) });
+});
+
+test('addEquipment validates items', () => {
+  const service = createRentalService();
+  assert.throws(() => service.addEquipment({ id: '', kind: 'board', dailyPrice: 100 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'kite' as 'board', dailyPrice: 100 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10.5 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
+  service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100 });
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100 }));
+});
