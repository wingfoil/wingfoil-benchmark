@@ -0,0 +1,129 @@
+/** The kinds of equipment the school rents out. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item; `dailyPrice` is an integer number of euro cents per day. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** A rental period as UTC ISO-8601 strings, midnight to midnight, `end` exclusive. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** What renting an item for a period costs, `total` in euro cents. */
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  total: number;
+}
+
+/** A confirmed booking. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** The booking desk's in-memory rental service. */
+export interface RentalService {
+  /** Registers an item; throws on an invalid item or an id already in use. */
+  addEquipment(item: Equipment): void;
+  /** Prices a period; throws for an unknown item or a disallowed period. */
+  quote(request: RentalRequest): Quote;
+  /** Books a period; throws like `quote`, and when the item is not free throughout. */
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?Z$/;
+
+interface Period {
+  start: number;
+  end: number;
+}
+
+/** Parses a UTC-midnight ISO string into epoch milliseconds; throws otherwise. */
+function parseMidnight(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !UTC_MIDNIGHT.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC timestamp at midnight, e.g. 2026-07-01T00:00:00Z`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a valid date`);
+  }
+  return ms;
+}
+
+function parsePeriod(request: RentalRequest): Period {
+  const start = parseMidnight(request.start, 'start');
+  const end = parseMidnight(request.end, 'end');
+  if (end <= start) {
+    throw new Error('end must be after start');
+  }
+  return { start, end };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item.id !== 'string' || item.id === '') {
+    throw new Error('id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error("kind must be 'board' or 'sail'");
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+  }
+}
+
+/** Creates an empty rental service that keeps all its state in memory. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const periodsByItem = new Map<string, Period[]>();
+  let bookingCount = 0;
+
+  function price(request: RentalRequest): { quote: Quote; period: Period } {
+    const item = equipment.get(request.itemId);
+    if (item === undefined) {
+      throw new Error(`unknown item: ${request.itemId}`);
+    }
+    const period = parsePeriod(request);
+    const days = (period.end - period.start) / DAY_MS;
+    const quote = {
+      itemId: item.id,
+      start: new Date(period.start).toISOString(),
+      end: new Date(period.end).toISOString(),
+      total: days * item.dailyPrice,
+    };
+    return { quote, period };
+  }
+
+  return {
+    addEquipment(item) {
+      validateEquipment(item);
+      if (equipment.has(item.id)) {
+        throw new Error(`item already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+      periodsByItem.set(item.id, []);
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, period } = price(request);
+      const taken = periodsByItem.get(quote.itemId) as Period[];
+      if (taken.some((other) => period.start < other.end && other.start < period.end)) {
+        throw new Error(`item ${quote.itemId} is not free for the whole period`);
+      }
+      taken.push(period);
+      bookingCount += 1;
+      return { id: `booking-${bookingCount}`, ...quote };
+    },
+  };
+}
