+/** Parses any UTC ISO instant into epoch milliseconds; throws otherwise. */
+function parseInstant(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !UTC_INSTANT.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC timestamp, e.g. 2026-07-01T09:30:00Z`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a valid date`);
+  }
+  return ms;
+}
