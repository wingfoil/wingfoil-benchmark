diff --git a/test/rental.test.ts b/test/rental.test.ts
index fcd78118b1bacadb8bee8486c32cadbf40d472a4..e415a7d8673baead7a0164ad893b5c83edf1d9e4 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -181,3 +181,44 @@ test('addEquipment rejects an invalid hourly price', () => {
     assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice }));
   }
 });
+
+test('cancel refunds the full total at least 24 hours before the start', () => {
+  const service = setup();
+  const booking = service.book({ itemId: 'board-1', start: day(10), end: day(13) });
+  assert.deepEqual(service.cancel(booking.id, '2026-07-09T00:00:00Z'), { bookingId: booking.id, refund: 12150 });
+});
+
+test('cancel refunds nothing under 24 hours before the start or after it', () => {
+  const service = setup();
+  const first = service.book({ itemId: 'board-1', start: day(10), end: day(11) });
+  assert.equal(service.cancel(first.id, '2026-07-09T00:00:01Z').refund, 0);
+  const second = service.book({ itemId: 'board-1', start: day(10), end: day(11) });
+  assert.equal(service.cancel(second.id, day(10)).refund, 0);
+  const third = service.book({ itemId: 'board-1', start: day(10), end: day(11) });
+  assert.equal(service.cancel(third.id, day(12)).refund, 0);
+});
+
+test('cancel frees the equipment', () => {
+  const service = setup();
+  const booking = service.book({ itemId: 'board-1', start: day(1), end: day(3) });
+  assert.deepEqual(service.availability({ start: day(1), end: day(3), kind: 'board' }), []);
+  service.cancel(booking.id, day(1));
+  assert.deepEqual(service.availability({ start: day(1), end: day(3), kind: 'board' }), ['board-1']);
+  assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: day(1), end: day(3) }));
+});
+
+test('a booking can only be cancelled once', () => {
+  const service = setup();
+  const booking = service.book({ itemId: 'board-1', start: day(10), end: day(11) });
+  service.cancel(booking.id, day(1));
+  assert.throws(() => service.cancel(booking.id, day(1)));
+});
+
+test('cancel rejects an unknown booking or an invalid time', () => {
+  const service = setup();
+  const booking = service.book({ itemId: 'board-1', start: day(10), end: day(11) });
+  assert.throws(() => service.cancel('booking-99', day(1)));
+  assert.throws(() => service.cancel(booking.id, 'tomorrow'));
+  assert.throws(() => service.cancel(booking.id, '2026-02-30T00:00:00Z'));
+  assert.equal(service.cancel(booking.id, day(1)).refund, 4500);
+});
