+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of an import that could not be added, and why. `line` counts from 1. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and every line that was not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds one task per line of `text` to `list`, each line as `title;priority;tags`. The priority may be
+ * empty, for a normal one; the tags are separated by spaces. Blank lines are skipped. A line that cannot
+ * be added is reported, and the others are still added.
+ *
+ * @param list - the task list to add to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+
+  text.split(/\r?\n/).forEach((raw, index) => {
+    const line = index + 1;
+    if (raw.trim() === '') return;
+
+    const fields = raw.split(';');
+    if (fields.length !== 3) {
+      const reason = `a line needs a title, a priority and tags separated by ";", but this one has ${fields.length} fields`;
+      rejected.push({ line, reason });
+      return;
+    }
+    const [title, priority, tags] = fields;
+
+    // The priority and tags are only typed here; `list.add` checks them and reports what is wrong.
+    const result = list.add({
+      title,
+      ...(priority.trim() === '' ? {} : { priority: priority.trim() as Priority }),
+      tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line, reason: result.error.message });
+  });
+
+  return { imported, rejected };
+}
