diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e4f969d62eb82d412e929bc00a4e9a6bebe8b08a
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,60 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds one task per line, with priority and tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;;\nSweep;low;');
+    assert.deepEqual(result, { imported: 3, rejected: [] });
+    const titles = list.list().map((task) => [task.title, task.priority, [...task.tags].sort()]);
+    assert.deepEqual(titles, [
+      ['Renew the insurance', 'high', ['admin', 'money']],
+      ['Buy milk', 'normal', []],
+      ['Sweep', 'low', []],
+    ]);
+  });
+
+  it('skips blank lines but counts them in line numbers', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;\n\n   \nBad;urgent;\n');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(result.rejected, [{ line: 4, reason: result.rejected[0]?.reason }]);
+    assert.match(result.rejected[0]?.reason ?? '', /urgent/);
+  });
+
+  it('reports a line with the wrong number of fields and still adds the rest', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Good;;\nno separators here\nA;b;c;d\nAlso good;high;');
+    assert.equal(result.imported, 2);
+    assert.deepEqual(
+      result.rejected.map((rejected) => rejected.line),
+      [2, 3],
+    );
+  });
+
+  it('reports a duplicate title, an empty title and a bad priority', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;\nBuy milk;high;\n ;;\nTidy;Medium;');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(
+      result.rejected.map((rejected) => rejected.line),
+      [2, 3, 4],
+    );
+    assert.match(result.rejected[0]?.reason ?? '', /already a task "Buy milk"/);
+    assert.match(result.rejected[2]?.reason ?? '', /Medium/);
+  });
+
+  it('accepts Windows line endings', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'One;;\r\nTwo;low;x\r\n');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+  });
+
+  it('imports nothing from empty text', () => {
+    const list = createTodoList();
+    assert.deepEqual(importTasks(list, ''), { imported: 0, rejected: [] });
+    assert.equal(list.list().length, 0);
+  });
+});
