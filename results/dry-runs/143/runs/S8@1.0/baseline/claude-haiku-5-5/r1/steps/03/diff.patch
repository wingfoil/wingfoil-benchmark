 /** Every priority, from the least urgent to the most. */
 export const PRIORITIES: readonly Priority[] = ['low', 'normal', 'high'];
 
+/** The longest title a task may have, in characters. */
+export const MAX_TITLE_LENGTH = 120;
+
 /** Whether a task still has to be done. */
 export type Status = 'open' | 'done';
 
@@ -31,6 +34,60 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/**
+ * The title, trimmed, if it can be a task's title: not empty, and at most `MAX_TITLE_LENGTH` characters.
+ *
+ * @param title - the title as typed
+ */
+export function checkTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'a task needs a title, but this one is empty or only spaces');
+  const length = [...trimmed].length;
+  if (length > MAX_TITLE_LENGTH)
+    return err('invalid-input', `a title can be at most ${MAX_TITLE_LENGTH} characters, but this one has ${length}`);
+  return ok(trimmed);
+}
+
+/**
+ * The priority, if it is one of `PRIORITIES`. Input from the screens is not typed, so it is checked here.
+ *
+ * @param priority - the priority as given
+ */
+export function checkPriority(priority: string): Result<Priority> {
+  if ((PRIORITIES as readonly string[]).includes(priority)) return ok(priority as Priority);
+  return err('invalid-input', `a priority must be low, normal or high, not "${priority}"`);
+}
+
+/**
+ * The tag, if it can be a tag: not empty, and without a space.
+ *
+ * @param tag - the tag as typed
+ */
+export function checkTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'a tag cannot be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `a tag cannot contain a space, but "${tag}" does`);
+  return ok(tag);
+}
+
+/**
+ * The new task's input, if all of it is valid, with the title trimmed.
+ *
+ * @param input - the title, priority and tags as given
+ */
+export function checkNewTask(input: NewTask): Result<NewTask> {
+  const title = checkTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined) {
+    const priority = checkPriority(input.priority);
+    if (!priority.ok) return priority;
+  }
+  for (const tag of input.tags ?? []) {
+    const checked = checkTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok({ ...input, title: title.value });
+}
