+describe('input checks', () => {
+  function refused<T>(result: Result<T>, message: RegExp): void {
+    assert.equal(result.ok, false);
+    if (!result.ok) {
+      assert.equal(result.error.code, 'invalid-input');
+      assert.match(result.error.message, message);
+    }
+  }
+
+  it('refuses an empty title or one of only spaces, and leaves the list alone', () => {
+    const list = createTodoList();
+    refused(list.add({ title: '' }), /title/);
+    refused(list.add({ title: '   ' }), /empty or only spaces/);
+    assert.deepEqual(list.list(), []);
+
+    const task = valueOf(list.add({ title: 'Dust' }));
+    refused(list.rename(task.id, '  '), /empty or only spaces/);
+    assert.equal(valueOf(list.get(task.id)).title, 'Dust');
+  });
+
+  it('accepts a title of exactly 120 characters and refuses one of 121', () => {
+    const list = createTodoList();
+    const longest = 'a'.repeat(120);
+    assert.equal(valueOf(list.add({ title: longest })).title, longest);
+    const tooLong = list.add({ title: 'b'.repeat(121) });
+    refused(tooLong, /at most 120 characters, but this one has 121/);
+    assert.equal(list.list().length, 1);
+  });
+
+  it('refuses a priority other than low, normal or high', () => {
+    const list = createTodoList();
+    refused(list.add({ title: 'Air beds', priority: 'urgent' as Priority }), /low, normal or high, not "urgent"/);
+    assert.deepEqual(list.list(), []);
+  });
+
+  it('refuses a tag that is empty or has a space, on add and on tag', () => {
+    const list = createTodoList();
+    refused(list.add({ title: 'Recycling', tags: ['home', ''] }), /cannot be empty/);
+    refused(list.add({ title: 'Recycling', tags: ['sort out'] }), /cannot contain a space, but "sort out" does/);
+    assert.deepEqual(list.list(), []);
+
+    const task = valueOf(list.add({ title: 'Recycling' }));
+    refused(list.tag(task.id, ''), /cannot be empty/);
+    refused(list.tag(task.id, 'sort out'), /cannot contain a space/);
+    assert.deepEqual(valueOf(list.get(task.id)).tags, []);
+  });
+
+  it('checks a rename before it looks up the task', () => {
+    const list = createTodoList();
+    refused(list.rename('no such task', ''), /empty or only spaces/);
+  });
+});
