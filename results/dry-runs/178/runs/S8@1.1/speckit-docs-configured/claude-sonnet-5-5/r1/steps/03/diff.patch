index aaf8590857a8d9ba9ec3050c5a7ecb70f3da705b..b6ce4f70034953da836557a5b34fe702884f68da 100644
--- a/test/list.test.ts
+++ b/test/list.test.ts
@@ -168,3 +168,48 @@ describe('task timestamps', () => {
     assert.equal(valueOf(list.find('Sweep')).updatedAt, added.updatedAt);
   });
 });
+
+describe('input validation', () => {
+  const code = (result: { ok: true } | { ok: false; error: { code: string } }) =>
+    result.ok ? 'ok' : result.error.code;
+
+  it('rejects an empty, blank or too long title when adding', () => {
+    const list = createTodoList();
+    assert.equal(code(list.add({ title: '' })), 'invalid-input');
+    assert.equal(code(list.add({ title: '   ' })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'x'.repeat(121) })), 'invalid-input');
+    assert.equal(code(list.add({ title: ` ${'x'.repeat(120)} ` })), 'ok');
+    assert.equal(list.list().length, 1);
+  });
+
+  it('rejects an unknown priority', () => {
+    const list = createTodoList();
+    const result = list.add({ title: 'A', priority: 'urgent' as never });
+    assert.equal(code(result), 'invalid-input');
+    if (!result.ok) assert.match(result.error.message, /urgent/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a bad tag when adding, and adds nothing', () => {
+    const list = createTodoList();
+    assert.equal(code(list.add({ title: 'A', tags: ['ok', ''] })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'A', tags: ['two words'] })), 'invalid-input');
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a bad rename and leaves the task as it was', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'A' }));
+    assert.equal(code(list.rename('A', '  ')), 'invalid-input');
+    assert.equal(code(list.rename('A', 'y'.repeat(121))), 'invalid-input');
+    assert.deepEqual(valueOf(list.find('A')), before);
+  });
+
+  it('rejects a bad tag when tagging and leaves the task as it was', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'A', tags: ['home'] }));
+    assert.equal(code(list.tag('A', '')), 'invalid-input');
+    assert.equal(code(list.tag('A', 'a b')), 'invalid-input');
+    assert.deepEqual(valueOf(list.find('A')), before);
+  });
+});
