+
+describe('task timestamps', () => {
+  function steppingClock(): () => Date {
+    let ms = Date.parse('2026-01-01T00:00:00.000Z');
+    return () => new Date((ms += 1000));
+  }
+
+  it('gives a new task equal createdAt and updatedAt, in ISO-8601', () => {
+    const task = valueOf(createTodoList(steppingClock()).add({ title: 'Sweep' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:01.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    const list = createTodoList(steppingClock());
+    const added = valueOf(list.add({ title: 'Sweep' }));
+    const steps = [
+      () => list.complete('Sweep'),
+      () => list.reopen('Sweep'),
+      () => list.rename('Sweep', 'Mop'),
+      () => list.tag('Mop', 'home'),
+      () => list.untag('Mop', 'home'),
+    ];
+    let previous = added.updatedAt;
+    for (const step of steps) {
+      const task = valueOf(step());
+      assert.ok(task.updatedAt > previous);
+      assert.equal(task.createdAt, added.createdAt);
+      previous = task.updatedAt;
+    }
+    assert.equal(previous, '2026-01-01T00:00:06.000Z');
+  });
+
+  it('leaves updatedAt alone when a change is refused', () => {
+    const list = createTodoList(steppingClock());
+    const added = valueOf(list.add({ title: 'Sweep' }));
+    assert.equal(list.reopen('Sweep').ok, false);
+    assert.equal(valueOf(list.find('Sweep')).updatedAt, added.updatedAt);
+  });
+});
