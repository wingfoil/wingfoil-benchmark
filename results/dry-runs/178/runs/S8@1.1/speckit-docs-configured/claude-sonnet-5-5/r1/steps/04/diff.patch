new file mode 100644
index 0000000000000000000000000000000000000000..330312aafb51cd080158d8dd07b7d1e56cfc8e4a
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,40 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds each valid line with its priority and tags', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk\nWater plants;;home\n');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok && insurance.value.priority === 'high');
+    assert.deepEqual(insurance.ok && insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok && milk.value.priority === 'normal');
+  });
+
+  it('skips blank lines but still counts them in line numbers', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'A\r\n\r\n   \r\n;high\n');
+    assert.equal(report.imported, 1);
+    assert.equal(report.rejected.length, 1);
+    assert.equal(report.rejected[0]?.line, 4);
+  });
+
+  it('rejects bad priorities, bad titles, duplicates and extra parts, and keeps going', () => {
+    const list = createTodoList();
+    const report = importTasks(
+      list,
+      ['A;urgent', 'B;low;x', 'B;high', `${'t'.repeat(121)}`, 'C;low;a;b', 'D'].join('\n'),
+    );
+    assert.equal(report.imported, 2);
+    assert.deepEqual(
+      report.rejected.map((r) => r.line),
+      [1, 3, 4, 5],
+    );
+    assert.ok(report.rejected.every((r) => r.reason !== ''));
+    assert.equal(list.openCount(), 2);
+  });
+});
