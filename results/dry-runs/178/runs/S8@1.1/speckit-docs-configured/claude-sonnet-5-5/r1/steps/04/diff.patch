+import type { TaskList } from './list.ts';
+import { PRIORITIES } from './task.ts';
+import type { Priority } from './task.ts';
+
+/** A line of an import that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may be
+ * empty (normal), tags are separated by spaces, and blank lines are skipped. Lines that cannot be added
+ * are reported, the others are still added.
+ *
+ * @param list - the task list to add to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  text.split(/\r\n|\n|\r/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: 'the line has more than three parts: use title;priority;tags' });
+      return;
+    }
+    const priorityText = (fields[1] ?? '').trim().toLowerCase();
+    if (priorityText !== '' && !PRIORITIES.includes(priorityText as Priority)) {
+      rejected.push({
+        line,
+        reason: `the priority "${(fields[1] ?? '').trim()}" is not one of ${PRIORITIES.join(', ')}`,
+      });
+      return;
+    }
+    const tags = (fields[2] ?? '').split(/\s+/).filter((tag) => tag !== '');
+    const added = list.add({
+      title: fields[0] ?? '',
+      priority: priorityText === '' ? 'normal' : (priorityText as Priority),
+      tags,
+    });
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
