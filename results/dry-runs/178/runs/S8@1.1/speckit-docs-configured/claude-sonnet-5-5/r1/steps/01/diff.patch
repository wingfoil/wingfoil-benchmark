+
+describe('task ids', () => {
+  it('gives each task its own id, never reused after a removal', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'A' }));
+    const b = valueOf(list.add({ title: 'B' }));
+    assert.notEqual(a.id, b.id);
+    list.remove(b.id);
+    const c = valueOf(list.add({ title: 'C' }));
+    assert.notEqual(c.id, a.id);
+    assert.notEqual(c.id, b.id);
+  });
+
+  it('gets a task by id, even after a rename', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'Old' }));
+    valueOf(list.rename(task.id, 'New'));
+    const got = valueOf(list.get(task.id));
+    assert.equal(got.title, 'New');
+    assert.equal(got.id, task.id);
+    assert.equal(valueOf(list.find(task.id)).title, 'New');
+  });
+
+  it('accepts an id wherever a title is taken', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'Task' }));
+    assert.equal(valueOf(list.tag(id, 'home')).tags[0], 'home');
+    assert.equal(valueOf(list.untag(id, 'home')).tags.length, 0);
+    assert.equal(valueOf(list.complete(id)).status, 'done');
+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.equal(valueOf(list.rename(id, 'Renamed')).title, 'Renamed');
+    assert.equal(valueOf(list.remove(id)).title, 'Renamed');
+    assert.equal(list.openCount(), 0);
+  });
+
+  it('refuses renaming to another task\'s title when renaming by id', () => {
+    const list = createTodoList();
+    list.add({ title: 'A' });
+    const b = valueOf(list.add({ title: 'B' }));
+    const result = list.rename(b.id, 'A');
+    assert.equal(result.ok, false);
+    if (!result.ok) assert.equal(result.error.code, 'duplicate');
+  });
+
+  it('fails with not-found for an unknown id', () => {
+    const result = createTodoList().get('nope');
+    assert.equal(result.ok, false);
+    if (!result.ok) assert.equal(result.error.code, 'not-found');
+  });
+});
