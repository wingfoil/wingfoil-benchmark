+describe('task timestamps', () => {
+  it('stamps creation and every change', () => {
+    let time = Date.parse('2026-01-01T00:00:00.000Z');
+    const list = createTodoList(() => new Date(time));
+    const added = valueOf(list.add({ title: 'a' }));
+    assert.equal(added.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(added.updatedAt, added.createdAt);
+    const steps = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.rename('a', 'b'),
+      () => list.tag('b', 'x'),
+      () => list.untag('b', 'x'),
+    ];
+    for (const step of steps) {
+      time += 1000;
+      const task = valueOf(step());
+      assert.equal(task.createdAt, added.createdAt);
+      assert.equal(task.updatedAt, new Date(time).toISOString());
+    }
+  });
+});
