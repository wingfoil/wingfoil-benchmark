+
+describe('importTasks', () => {
+  it('imports valid lines and reports the others by line number', () => {
+    const list = createTodoList();
+    const report = importTasks(
+      list,
+      'Renew the insurance;high;admin money\n\nBuy milk\nBad;urgent;\nBuy milk;low;\n;;\na;b;c;d\r\nFine;;x x',
+    );
+    assert.equal(report.imported, 3);
+    assert.deepEqual(
+      report.rejected.map((r) => r.line),
+      [4, 5, 6, 7],
+    );
+    assert.deepEqual(valueOf(list.find('Renew the insurance')).tags, ['admin', 'money']);
+    assert.equal(valueOf(list.find('Buy milk')).priority, 'normal');
+    assert.deepEqual(valueOf(list.find('Fine')).tags, ['x']);
+  });
