+
+describe('input validation', () => {
+  it('rejects invalid input and changes nothing', () => {
+    const list = createTodoList();
+    list.add({ title: 'Keep me' });
+    const bad = [
+      list.add({ title: '   ' }),
+      list.add({ title: 'x'.repeat(121) }),
+      list.add({ title: 'Ok', priority: 'urgent' as never }),
+      list.add({ title: 'Ok', tags: ['fine', 'two words'] }),
+      list.add({ title: 'Ok', tags: [''] }),
+      list.rename('Keep me', ' '),
+      list.rename('Keep me', 'y'.repeat(121)),
+      list.tag('Keep me', ''),
+      list.tag('Keep me', 'a b'),
+    ];
+    for (const r of bad) {
+      assert.equal(r.ok, false);
+      if (!r.ok) assert.equal(r.error.code, 'invalid-input');
+    }
+    assert.equal(list.list().length, 1);
+    const kept = valueOf(list.find('Keep me'));
+    assert.equal(kept.title, 'Keep me');
+    assert.deepEqual(kept.tags, []);
+    assert.equal(valueOf(list.add({ title: 'z'.repeat(120) })).title.length, 120);
+  });
+});
