diff --git a/src/domain/validate.ts b/src/domain/validate.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6de876fc209dc81a66a00833bee6ec0098752408
--- /dev/null
+++ b/src/domain/validate.ts
@@ -0,0 +1,45 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { Priority } from './task.ts';
+
+/** The longest title a task may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a task title and trims it. It must not be empty or only spaces, nor longer than 120 characters.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title is empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; the limit is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be `low`, `normal` or `high`.
+ *
+ * @param priority - the priority as given
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  const known = PRIORITIES.find((candidate) => candidate === priority);
+  if (known === undefined) {
+    return err('invalid-input', `the priority "${String(priority)}" is not one of ${PRIORITIES.join(', ')}`);
+  }
+  return ok(known);
+}
+
+/**
+ * Checks a tag: it must not be empty and must not contain a space.
+ *
+ * @param tag - the tag as given
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'the tag is empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space`);
+  return ok(tag);
+}
