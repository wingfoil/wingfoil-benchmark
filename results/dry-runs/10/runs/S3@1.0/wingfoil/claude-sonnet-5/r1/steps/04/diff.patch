-const MS_PER_DAY = 24 * 60 * 60 * 1000;
+const MS_PER_HOUR = 60 * 60 * 1000;
+const MS_PER_DAY = 24 * MS_PER_HOUR;
 const LONG_STAY_DISCOUNT_THRESHOLD_DAYS = 3;
 const LONG_STAY_DISCOUNT_RATE = 0.1;
 
-function parseMidnightUtc(value: string, label: string): number {
+function parseIsoDateTime(value: string, label: string): number {
   const time = Date.parse(value);
   if (Number.isNaN(time)) {
     throw new Error(`${label} is not a valid ISO-8601 date-time: ${value}`);
   }
-  if (time % MS_PER_DAY !== 0) {
-    throw new Error(`${label} must fall on midnight UTC: ${value}`);
-  }
   return time;
 }
 
-function countWholeDays(startTime: number, endTime: number): number {
+/**
+ * A validated period, priced either by the day (whole days, midnight UTC to midnight UTC) or, when
+ * shorter than a day, by the hour (start and end on the hour UTC).
+ */
+type Period =
+  | { readonly unit: 'daily'; readonly startTime: number; readonly endTime: number; readonly days: number }
+  | { readonly unit: 'hourly'; readonly startTime: number; readonly endTime: number; readonly hours: number };
+
+function validatePeriod(request: { start: string; end: string }): Period {
+  const startTime = parseIsoDateTime(request.start, 'start');
+  const endTime = parseIsoDateTime(request.end, 'end');
   if (endTime <= startTime) {
     throw new Error('end must be after start');
   }
-  return (endTime - startTime) / MS_PER_DAY;
+
+  const durationMs = endTime - startTime;
+  if (durationMs < MS_PER_DAY) {
+    if (startTime % MS_PER_HOUR !== 0) {
+      throw new Error(`start must fall on the hour UTC: ${request.start}`);
+    }
+    if (endTime % MS_PER_HOUR !== 0) {
+      throw new Error(`end must fall on the hour UTC: ${request.end}`);
+    }
+    return { unit: 'hourly', startTime, endTime, hours: durationMs / MS_PER_HOUR };
+  }
+
+  if (startTime % MS_PER_DAY !== 0) {
+    throw new Error(`start must fall on midnight UTC: ${request.start}`);
+  }
+  if (endTime % MS_PER_DAY !== 0) {
+    throw new Error(`end must fall on midnight UTC: ${request.end}`);
+  }
+  return { unit: 'daily', startTime, endTime, days: durationMs / MS_PER_DAY };
 }
 
 function periodsOverlap(aStart: number, aEnd: number, bStart: number, bEnd: number): boolean {
