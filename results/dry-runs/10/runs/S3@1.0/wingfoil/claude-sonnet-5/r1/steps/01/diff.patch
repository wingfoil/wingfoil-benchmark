+++ b/test/rental-service.test.ts
@@ -0,0 +1,111 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function board(id: string, dailyPrice: number) {
+  return { id, kind: 'board' as const, dailyPrice };
+}
+
+test('quotes a multi-day rental at the item daily price', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+
+  const quote = service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+
+  assert.deepEqual(quote, {
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00.000Z',
+    end: '2026-07-03T00:00:00.000Z',
+    total: 3000,
+  });
+});
+
+test('quote throws for an unknown item', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.quote({ itemId: 'nope', start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z' }));
+});
+
+test('quote throws when the period does not start at midnight UTC', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-01T08:00:00.000Z', end: '2026-07-02T00:00:00.000Z' }));
+});
+
+test('quote throws when the period does not end at midnight UTC', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T08:00:00.000Z' }));
+});
+
+test('quote throws when the period does not cover at least one whole day', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-01T00:00:00.000Z' }));
+});
+
+test('quote throws when the period ends before it starts', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-03T00:00:00.000Z', end: '2026-07-01T00:00:00.000Z' }));
+});
+
+test('books a free item and returns a booking with an id', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+
+  assert.equal(booking.itemId, 'board-1');
+  assert.equal(booking.start, '2026-07-01T00:00:00.000Z');
+  assert.equal(booking.end, '2026-07-03T00:00:00.000Z');
+  assert.equal(booking.total, 3000);
+  assert.equal(typeof booking.id, 'string');
+  assert.notEqual(booking.id, '');
+});
+
+test('book throws for an unknown item', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.book({ itemId: 'nope', start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z' }));
+});
+
+test('book throws for an invalid period', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+
+  assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-01T08:00:00.000Z', end: '2026-07-02T00:00:00.000Z' }));
+});
+
+test('book throws when the item is already booked for an overlapping period', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+
+  assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-04T00:00:00.000Z', end: '2026-07-06T00:00:00.000Z' }));
+});
+
+test('book allows adjacent, non-overlapping periods for the same item', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+
+  const second = service.book({ itemId: 'board-1', start: '2026-07-05T00:00:00.000Z', end: '2026-07-06T00:00:00.000Z' });
+
+  assert.equal(second.itemId, 'board-1');
+});
+
+test('book allows overlapping periods on different items', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+  service.addEquipment(board('board-2', 2000));
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+
+  const second = service.book({ itemId: 'board-2', start: '2026-07-01T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+
+  assert.equal(second.itemId, 'board-2');
+});
