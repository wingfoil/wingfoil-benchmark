+/** The two kinds of equipment the school rents out. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A board or sail available for rental. */
+export interface Equipment {
+  readonly id: string;
+  readonly kind: EquipmentKind;
+  /** The cost of one day of rental, in integer euro cents. */
+  readonly dailyPrice: number;
+}
+
+/** A request to price or book an item for a period. */
+export interface RentalRequest {
+  readonly itemId: string;
+  /** Start of the period, midnight UTC, as an ISO-8601 string. */
+  readonly start: string;
+  /** End of the period: midnight UTC of the day after its last day. */
+  readonly end: string;
+}
+
+/** The price of a period for an item, without booking it. */
+export interface Quote {
+  readonly itemId: string;
+  readonly start: string;
+  readonly end: string;
+  /** Total cost of the period, in integer euro cents. */
+  readonly total: number;
+}
+
+/** A confirmed rental of an item for a period. */
+export interface Booking {
+  readonly id: string;
+  readonly itemId: string;
+  readonly start: string;
+  readonly end: string;
+  /** Total cost of the period, in integer euro cents. */
+  readonly total: number;
+}
+
+/** The booking desk's rental module: equipment, quotes and bookings, kept in memory. */
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  /** Prices a period for an item without booking it. Throws for an unknown item or an invalid period. */
+  quote(request: RentalRequest): Quote;
+  /**
+   * Books an item for a period. Throws for an unknown item, an invalid period, or a period that
+   * overlaps a booking already on that item.
+   */
+  book(request: RentalRequest): Booking;
+}
+
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+function parseMidnightUtc(value: string, label: string): number {
+  const time = Date.parse(value);
+  if (Number.isNaN(time)) {
+    throw new Error(`${label} is not a valid ISO-8601 date-time: ${value}`);
+  }
+  if (time % MS_PER_DAY !== 0) {
+    throw new Error(`${label} must fall on midnight UTC: ${value}`);
+  }
+  return time;
+}
+
+function countWholeDays(startTime: number, endTime: number): number {
+  if (endTime <= startTime) {
+    throw new Error('end must be after start');
+  }
+  return (endTime - startTime) / MS_PER_DAY;
+}
+
+function periodsOverlap(aStart: number, aEnd: number, bStart: number, bEnd: number): boolean {
+  return aStart < bEnd && bStart < aEnd;
+}
+
+export function createRentalService(): RentalService {
+  const equipmentById = new Map<string, Equipment>();
+  const bookings: Booking[] = [];
+  let nextBookingSequence = 1;
+
+  function requireEquipment(itemId: string): Equipment {
+    const item = equipmentById.get(itemId);
+    if (!item) {
+      throw new Error(`Unknown item: ${itemId}`);
+    }
+    return item;
+  }
+
+  function priceRequest(item: Equipment, request: RentalRequest): { startTime: number; endTime: number; total: number } {
+    const startTime = parseMidnightUtc(request.start, 'start');
+    const endTime = parseMidnightUtc(request.end, 'end');
+    const days = countWholeDays(startTime, endTime);
+    return { startTime, endTime, total: days * item.dailyPrice };
+  }
+
+  return {
+    addEquipment(item) {
+      equipmentById.set(item.id, { ...item });
+    },
+
+    quote(request) {
+      const item = requireEquipment(request.itemId);
+      const { total } = priceRequest(item, request);
+      return { itemId: request.itemId, start: request.start, end: request.end, total };
+    },
+
+    book(request) {
+      const item = requireEquipment(request.itemId);
+      const { startTime, endTime, total } = priceRequest(item, request);
+
+      const hasConflict = bookings.some(
+        (existing) =>
+          existing.itemId === request.itemId &&
+          periodsOverlap(startTime, endTime, Date.parse(existing.start), Date.parse(existing.end)),
+      );
+      if (hasConflict) {
+        throw new Error(`Item ${request.itemId} is already booked for part of that period`);
+      }
+
+      const booking: Booking = {
+        id: `booking-${nextBookingSequence++}`,
+        itemId: request.itemId,
+        start: request.start,
+        end: request.end,
+        total,
+      };
+      bookings.push(booking);
+      return booking;
+    },
+  };
+}
