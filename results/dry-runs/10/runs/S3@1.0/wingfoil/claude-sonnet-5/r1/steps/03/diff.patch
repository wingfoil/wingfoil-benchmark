+/** Applies the long-stay discount: 10% off for a rental of 3 days or more, rounded to the nearest cent. */
+function applyLongStayDiscount(fullPrice: number, days: number): number {
+  if (days < LONG_STAY_DISCOUNT_THRESHOLD_DAYS) {
+    return fullPrice;
+  }
+  return Math.round(fullPrice * (1 - LONG_STAY_DISCOUNT_RATE));
+}
