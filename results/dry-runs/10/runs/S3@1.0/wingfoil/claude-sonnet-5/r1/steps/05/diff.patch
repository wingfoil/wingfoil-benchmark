+
+test('cancel refunds the full total and echoes the booking id', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1000));
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-04T00:00:00.000Z' });
+
+  const cancellation = service.cancel(booking.id, '2026-06-20T00:00:00.000Z');
+
+  assert.deepEqual(cancellation, { bookingId: booking.id, refund: booking.total });
+});
+
+test('cancel frees the equipment for booking the same period again', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+
+  service.cancel(booking.id, '2026-06-20T00:00:00.000Z');
+  const second = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+
+  assert.equal(second.itemId, 'board-1');
+});
+
+test('cancel frees the equipment for availability', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+
+  service.cancel(booking.id, '2026-06-20T00:00:00.000Z');
+  const available = service.availability({ start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z', kind: 'board' });
+
+  assert.deepEqual(available, ['board-1']);
+});
+
+test('cancel throws for an unknown booking', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.cancel('nope', '2026-06-20T00:00:00.000Z'));
+});
+
+test('cancel throws when the booking is already cancelled', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+  service.cancel(booking.id, '2026-06-20T00:00:00.000Z');
+
+  assert.throws(() => service.cancel(booking.id, '2026-06-21T00:00:00.000Z'));
+});
+
+test('cancel throws when at is not a valid ISO-8601 date-time', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+
+  assert.throws(() => service.cancel(booking.id, 'not-a-date'));
+});
