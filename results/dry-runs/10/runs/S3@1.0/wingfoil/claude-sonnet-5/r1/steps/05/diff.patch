 }
 
 /** The booking desk's rental module: equipment, quotes and bookings, kept in memory. */
@@ -70,6 +79,11 @@ export interface RentalService {
    * that is free for the whole period. Throws for an invalid period.
    */
   availability(query: AvailabilityQuery): string[];
+  /**
+   * Cancels a booking at the given time, freeing the equipment it held. Throws for an unknown
+   * booking, an invalid `at`, or a booking already cancelled.
+   */
+  cancel(bookingId: string, at: string): Cancellation;
 }
 
 const MS_PER_HOUR = 60 * 60 * 1000;
@@ -160,7 +174,9 @@ export function createRentalService(): RentalService {
   function isFree(itemId: string, startTime: number, endTime: number): boolean {
     return !bookings.some(
       (existing) =>
-        existing.itemId === itemId && periodsOverlap(startTime, endTime, Date.parse(existing.start), Date.parse(existing.end)),
+        existing.itemId === itemId &&
+        existing.cancelledAt === undefined &&
+        periodsOverlap(startTime, endTime, Date.parse(existing.start), Date.parse(existing.end)),
     );
   }
 
@@ -204,5 +220,19 @@ export function createRentalService(): RentalService {
       }
       return ids.sort();
     },
+
+    cancel(bookingId, at) {
+      parseIsoDateTime(at, 'at');
+      const index = bookings.findIndex((booking) => booking.id === bookingId);
+      if (index === -1) {
+        throw new Error(`Unknown booking: ${bookingId}`);
+      }
+      const booking = bookings[index]!;
+      if (booking.cancelledAt !== undefined) {
+        throw new Error(`Booking ${bookingId} is already cancelled`);
+      }
+      bookings[index] = { ...booking, cancelledAt: at };
+      return { bookingId, refund: booking.total };
+    },
   };
 }
