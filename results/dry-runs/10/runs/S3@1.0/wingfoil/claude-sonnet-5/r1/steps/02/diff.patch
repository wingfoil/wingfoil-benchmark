diff --git a/test/rental-service.test.ts b/test/rental-service.test.ts
index 841c1d99fce5f63b21ccb8f02c2f5b6539df6707..880915a8ff84424635ccd2f29b00958d9c1beb52 100644
--- a/test/rental-service.test.ts
+++ b/test/rental-service.test.ts
@@ -109,3 +109,54 @@ test('book allows overlapping periods on different items', () => {
 
   assert.equal(second.itemId, 'board-2');
 });
+
+function sail(id: string, dailyPrice: number) {
+  return { id, kind: 'sail' as const, dailyPrice };
+}
+
+test('availability lists the free ids of a kind, sorted, excluding items booked for part of the period', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-2', 1500));
+  service.addEquipment(board('board-1', 1500));
+  service.addEquipment(sail('sail-1', 1000));
+  service.book({ itemId: 'board-2', start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+
+  const available = service.availability({
+    start: '2026-07-01T00:00:00.000Z',
+    end: '2026-07-03T00:00:00.000Z',
+    kind: 'board',
+  });
+
+  assert.deepEqual(available, ['board-1']);
+});
+
+test('availability returns ids of any kind when none is given, sorted', () => {
+  const service = createRentalService();
+  service.addEquipment(sail('sail-1', 1000));
+  service.addEquipment(board('board-1', 1500));
+
+  const available = service.availability({ start: '2026-07-01T00:00:00.000Z', end: '2026-07-03T00:00:00.000Z' });
+
+  assert.deepEqual(available, ['board-1', 'sail-1']);
+});
+
+test('availability includes an item whose booking does not overlap the period', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+  service.book({ itemId: 'board-1', start: '2026-07-03T00:00:00.000Z', end: '2026-07-05T00:00:00.000Z' });
+
+  const available = service.availability({
+    start: '2026-07-01T00:00:00.000Z',
+    end: '2026-07-03T00:00:00.000Z',
+    kind: 'board',
+  });
+
+  assert.deepEqual(available, ['board-1']);
+});
+
+test('availability throws for an invalid period', () => {
+  const service = createRentalService();
+  service.addEquipment(board('board-1', 1500));
+
+  assert.throws(() => service.availability({ start: '2026-07-01T08:00:00.000Z', end: '2026-07-02T00:00:00.000Z' }));
+});
