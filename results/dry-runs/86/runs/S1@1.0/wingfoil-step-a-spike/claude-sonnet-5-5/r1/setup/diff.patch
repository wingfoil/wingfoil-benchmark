+# Capture an ADR on demand
+name: adr-ingest
+kind: main
+format: 1
+description: "Capture an ADR on demand"
+phases:
+  - name: capture
+    description: "Write the adr and submit it for approval."
+    role: architect
+    actions:
+      - 'memory.add(type: adr)'
+      - memory.submit
+    produces:
+      - docs/memory/adr/{id}.md
+  - name: approve
+    description: "Approve the adr (approval gate; a reject sends it back to capture)."
+    role: approver
+    actions:
+      - memory.approve
+    approval: { by_role: approver }
+    fallback: { step: capture }
