+# Kanban delivery loop (sub-workflow) — scaffolded by `wingfoil init`.
+# Work flows continuously across the board; there are no timeboxed iterations. A state takes a WIP limit when its type's machine in .wingfoil/memory.yaml declares one with `limits:` (the commented `bug` example shows how).
+name: kanban-delivery
+kind: sub
+format: 1
+description: "Kanban delivery loop"
+phases:
+  - name: plan
+    description: "Select the next slice of work: write each item as a task and submit it."
+    role: product-owner
+    actions:
+      - 'memory.add(type: task)'
+      - memory.submit
+    produces:
+      - docs/memory/task/
+  - name: build
+    description: "Implement the work test-first (TDD)."
+    role: developer
+  - name: review
+    description: "Review against the directives; run unit + acceptance tests; the approver approves each task."
+    role: reviewer
+    where: { type: task, status: pending }
+    actions:
+      - memory.approve
+    approval: { by_role: approver }
+  - name: deliver
+    description: "Integrate the completed work."
+    role: developer
