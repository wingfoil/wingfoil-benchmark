index 0000000000000000000000000000000000000000..351a09d58f74bf144c1a52155d11303220a47b90
--- /dev/null
+++ b/.wingfoil/dna.yaml
@@ -0,0 +1,67 @@
+# Project DNA (P2.4) — scaffolded by `wingfoil init` (Kanban template).
+# Structural map of the project: modules, stacks, team + roles, resource paths. Customize freely.
+# `version` is this file's content revision; `format` the file format it is written in (bumped by
+# WingFoil only on a backward-incompatible change).
+version: 1.1
+format: 1
+
+project:
+  name: ""                        # your project name
+  description: ""
+  methodology: Kanban        # Continuous-flow delivery; work-in-progress limits are declared per state with `limits:` in memory.yaml.
+
+# Modules — the parts of the system (anatomy for navigation). Add your own.
+modules: []
+
+# Stacks — technologies + methodologies in use. The methodologies come from the Kanban template.
+stacks:
+  # Each technology is a {name, category} entry: `category` is required (free text: language,
+  # runtime, framework, database, ...); `version` and `notes` are optional. To declare one, replace
+  # `technologies: []` with a list like this example, uncommented:
+  # technologies:
+  #   - name: TypeScript
+  #     category: language
+  # or run: wingfoil dna add stacks.technologies --value TypeScript --entry-category language
+  technologies: []
+  methodologies:
+    - name: Kanban
+    - name: Specification by Example (BDD)
+    - name: TDD
+
+# Team & roles — AI agents execute as developer/reviewer/qa/architect and never hold approval authority.
+team:
+  members:
+    - name: Benchmark Approver
+      email: approver@benchmark.localhost
+      roles: [approver]
+  # AI agents: the roles each one executes as (never approver: agents hold no approval authority), its
+  # commit identity (`email`, written in the Co-Authored-By trailer of the commits it co-authors) and
+  # the adapter under .wingfoil/agents/ that `wingfoil agent execute` launches it with (`email` is
+  # required with `adapter`). To declare one, replace `agents: []` with a list like this example,
+  # uncommented:
+  # agents:
+  #   - name: claude
+  #     email: noreply@anthropic.com
+  #     executes_as: [ developer, reviewer, qa, architect ]
+  #     approval_authority: false
+  #     adapter: claude-code
+  # or run: wingfoil dna add team.agents --value claude --entry-adapter claude-code --entry-email noreply@anthropic.com --entry-executes_as developer,reviewer
+  agents: []
+  roles:
+    - name: developer
+    - name: reviewer
+    - name: qa
+    - name: architect
+    - name: product-owner
+    - name: tech-lead
+    - name: approver
+
+# Resource paths — query categories used to navigate the project.
+# `runs` holds exactly one directory: the agent run log, one <element-id>.jsonl per element.
+paths:
+  sources: []
+  tests: []
+  docs: []
+  config: [.wingfoil]
+  governance: []
+  runs: [docs/runs/]
diff --git a/.wingfoil/memory.yaml b/.wingfoil/memory.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..dc66f7d5a8a1041adccbaede5f77b8988beb32c6
--- /dev/null
+++ b/.wingfoil/memory.yaml
@@ -0,0 +1,96 @@
+# Memory element schema (P1.13) — scaffolded by `wingfoil init`.
+# One entry per element type: its path pattern, its id pattern and its scaffold template. Every type
+# below shares the `defaults` state machine; give a type its own `states:` block to override it for
+# that type only (REQ-STATE-08) — `bug` carries a commented example. `amendable` says whether
+# `memory amend` may record a correction to the type's documents without a state change; absent
+# means false. `version` is this file's content revision; `format` the file format it is written in.
+version: 1
+format: 1
+
+# Default state machine — applies to every type that declares no `states:` block of its own.
+# `sequence` is the ordered forward chain (`submit` walks it); a `gates` state's forward edge needs
+# `approve` instead, and its `reject` target is where a rejection lands. `deprecated` is implicit:
+# `memory deprecate` reaches it from any state, so it is never listed here.
+defaults:
+  states:
+    sequence: [ draft, pending, approved ]
+    gates:
+      pending: { reject: draft }
+
+types:
+  adr:
+    path: docs/memory/adr/{id}.md
+    id_pattern: "adr-{n}-{slug}"
+    amendable: true
+    template:
+      file: memory/templates/adr.md
+      frontmatter:
+        required: [id, type, title, status]
+  bug:
+    path: docs/memory/bug/{id}.md
+    id_pattern: "bug-{n}-{slug}"
+    amendable: true
+    template:
+      file: memory/templates/bug.md
+      frontmatter:
+        required: [id, type, title, status]
+    # Example — uncomment to give `bug` its own state machine instead of `defaults` (spec-001):
+    # states:
+    #   sequence: [ draft, open, in-progress, resolved, closed ]
+    #   gates:
+    #     open: { reject: closed }
+    #     resolved: { reject: in-progress }
+    #   returns: { in-progress: open }    # memory park: back to open, with a reason
+    #   limits: { in-progress: 3 }        # at most 3 bugs in progress at once
+  decision-log:
+    path: docs/memory/decision-log/{id}.md
+    id_pattern: "dl-{n}-{slug}"
+    amendable: true
+    template:
+      file: memory/templates/decision-log.md
+      frontmatter:
+        required: [id, type, title, status]
+  plan:
+    path: docs/memory/plan/{scope}/{id}.md
+    id_pattern: "{workflow}-{phase}-plan"
+    amendable: true
+    template:
+      file: memory/templates/plan.md
+      frontmatter:
+        required: [id, type, title, status, workflow, phase]
+    # A started workflow: `wingfoil workflow start` adds and submits it, `wingfoil workflow end` closes it.
+    states:
+      sequence: [ draft, active, done ]
+      waiting: [ active ]
+  release:
+    path: docs/memory/release/{id}.md
+    id_pattern: "release-{n}"
+    amendable: true
+    template:
+      file: memory/templates/release.md
+      frontmatter:
+        required: [id, type, title, status]
+  release-line:
+    path: docs/memory/release-line/{id}.md
+    id_pattern: "rl-{n}"
+    amendable: false
+    template:
+      file: memory/templates/release-line.md
+      frontmatter:
+        required: [id, type, title, status]
+  task:
+    path: docs/memory/task/{id}.md
+    id_pattern: "task-{n}-{slug}"
+    amendable: true
+    template:
+      file: memory/templates/task.md
+      frontmatter:
+        required: [id, type, title, status]
+  tech-spec:
+    path: docs/memory/tech-spec/{id}.md
+    id_pattern: "spec-{n}-{slug}"
+    amendable: true
+    template:
+      file: memory/templates/tech-spec.md
+      frontmatter:
+        required: [id, type, title, status]
