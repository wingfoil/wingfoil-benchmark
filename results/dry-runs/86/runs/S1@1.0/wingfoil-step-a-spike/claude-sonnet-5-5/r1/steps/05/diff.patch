index 3cb0348cea859d31869829e18f86a630eb6e8004..53be17e6f5c2970a919d7a04c7725c39bf7d77e7 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -201,3 +201,66 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: unknown };
+
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, operations: Operation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && deepEqual(from[start], to[start])) start++;
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && deepEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+  const common = Math.min(fromEnd, toEnd) - start;
+  for (let i = start; i < start + common; i++) {
+    diffValues(from[i], to[i], `${path}/${i}`, operations);
+  }
+  for (let i = fromEnd - 1; i >= start + common; i--) {
+    operations.push({ op: "remove", path: `${path}/${i}` });
+  }
+  for (let i = start + common; i < toEnd; i++) {
+    operations.push({ op: "add", path: `${path}/${i}`, value: structuredClone(to[i]) });
+  }
+}
+
+function diffObjects(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  path: string,
+  operations: Operation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) operations.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+  }
+  for (const key of Object.keys(to)) {
+    const childPath = `${path}/${encodeToken(key)}`;
+    if (Object.hasOwn(from, key)) diffValues(from[key], to[key], childPath, operations);
+    else operations.push({ op: "add", path: childPath, value: structuredClone(to[key]) });
+  }
+}
+
+function diffValues(from: unknown, to: unknown, path: string, operations: Operation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) diffArrays(from, to, path, operations);
+  else if (isObject(from) && isObject(to)) diffObjects(from, to, path, operations);
+  else if (!deepEqual(from, to)) operations.push({ op: "replace", path, value: structuredClone(to) });
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ * Neither argument is mutated, and values in the patch are copies.
+ *
+ * The patch is limited to what changed: objects are compared member by member and arrays element by
+ * element (an unchanged head and tail are skipped), and only the differing values are emitted. The
+ * result is empty when the documents are deeply equal.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  const operations: Operation[] = [];
+  diffValues(from, to, "", operations);
+  return operations;
+}
