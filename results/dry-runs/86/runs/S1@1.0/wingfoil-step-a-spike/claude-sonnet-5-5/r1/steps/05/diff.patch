+test("createPatch describes only what changed", async () => {
+  const { createPatch } = await import("./index.ts");
+  assert.deepEqual(createPatch({ a: 1, b: { c: [1, 2, 3] } }, { a: 1, b: { c: [1, 2, 3] } }), []);
+  assert.deepEqual(createPatch({ a: 1, b: { c: 2 } }, { a: 1, b: { c: 3 } }), [
+    { op: "replace", path: "/b/c", value: 3 },
+  ]);
+  assert.deepEqual(createPatch({ a: 1, b: 2 }, { b: 2, c: 3 }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+  assert.deepEqual(createPatch([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(createPatch([1, 2, 3], [0, 1, 2, 3]), [{ op: "add", path: "/0", value: 0 }]);
+  assert.deepEqual(createPatch({ "a/b": { "m~n": 1 } }, { "a/b": { "m~n": 2 } }), [
+    { op: "replace", path: "/a~1b/m~0n", value: 2 },
+  ]);
+  assert.deepEqual(createPatch(1, "1"), [{ op: "replace", path: "", value: "1" }]);
+  assert.deepEqual(createPatch({ a: [] }, { a: {} }), [{ op: "replace", path: "/a", value: {} }]);
+});
+
+test("createPatch round-trips through applyPatch without mutating inputs", async () => {
+  const { createPatch, applyPatch } = await import("./index.ts");
+  const cases: [unknown, unknown][] = [
+    [{ a: [1, 2, 3, 4, 5], b: { x: 1 } }, { a: [1, 9, 3, 7, 8, 5, 6], b: { y: [1] } }],
+    [[1, 2, 3, 4, 5], [5]],
+    [[], [{ a: 1 }, { b: 2 }]],
+    [{ a: null }, { a: false }],
+    [JSON.parse('{"__proto__": {"x": 1}}'), JSON.parse('{"__proto__": {"x": 2}, "y": 1}')],
+    [{ a: 1 }, [1]],
+  ];
+  for (const [from, to] of cases) {
+    const fromCopy = structuredClone(from);
+    const toCopy = structuredClone(to);
+    const patch = createPatch(from, to);
+    assert.deepEqual(applyPatch(from, patch), to);
+    assert.deepEqual(from, fromCopy);
+    assert.deepEqual(to, toCopy);
+  }
+  const to = { v: { n: 1 } };
+  const patch = createPatch({}, to) as { value: { n: number } }[];
+  patch[0].value.n = 2;
+  assert.equal(to.v.n, 1);
+});
