 test("a sparse patch array is not a valid patch", () => {
   assert.throws(() => applyPatch({}, [, { op: "add", path: "/a", value: 1 }] as unknown[]));
 });
+
+import { applyMergePatch } from "./index.ts";
+
+test("RFC 7386 merge patch", () => {
+  const target = { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["a", "b"], content: "x" };
+  const patch = { title: "Hello!", phoneNumber: "+01-123", author: { familyName: null }, tags: ["c"] };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!", author: { givenName: "John" }, tags: ["c"], content: "x", phoneNumber: "+01-123",
+  });
+  assert.deepEqual(target.author, { givenName: "John", familyName: "Doe" });
+  assert.deepEqual(applyMergePatch({ a: "b" }, ["c"]), ["c"]);
+  assert.deepEqual(applyMergePatch(["a"], { a: "b" }), { a: "b" });
+  assert.deepEqual(applyMergePatch({ a: "foo" }, null), null);
+  assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+  assert.deepEqual(applyMergePatch({ a: 1 }, {}), { a: 1 });
+  const p = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as object;
+  assert.equal(Object.getPrototypeOf(p), Object.prototype);
+  assert.equal(({} as { x?: number }).x, undefined);
+});
