--- a/README.md
+++ b/README.md
@@ -11,3 +11,15 @@ to. It throws a `JsonPointerError` if the pointer is not valid per RFC 6901, or
 of the document (missing member, array index out of range, `-`, or leading zeros, or traversal into a
 primitive). A value of `null` is a valid result. Only own object members are resolved, and the document is
 never modified.
+
+## JSON Patch (RFC 6902)
+
+`applyPatch(document, patch)` (exported from `src/index.ts`) applies a JSON Patch, an array of `add`,
+`remove`, `replace`, `move`, `copy` and `test` operations, and returns the resulting document as a new
+value. Neither the document nor the patch is modified, and the result shares no structure with them.
+It throws a `JsonPatchError` if the patch is malformed (not an array, bad operation, missing or invalid
+`path`, `from` or `value`) or if an operation fails (missing target, array index out of range or with leading
+zeros, failed `test`, `move` from a proper prefix of its path, removing the whole document). Paths are JSON
+Pointers (RFC 6901); `-` is accepted only to append with `add`. Operations are applied in order and the patch
+is atomic: on failure no result is returned. `__proto__` and similar keys are treated as plain members
+and never reach the prototype chain.
diff --git a/src/index.ts b/src/index.ts
index 0b7c3c8f331a0eda3ff4492d595be1c87b972dce..99422f42134c388a9a94911e32e09935c53896ac 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -65,3 +65,192 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+/** Error thrown by `applyPatch` for an invalid patch or an operation that fails. */
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+/** A JSON Patch operation (RFC 6902 section 4). */
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; path: string; from: string };
+
+const has = (obj: object, key: string): boolean => Object.prototype.hasOwnProperty.call(obj, key);
+
+function isContainer(value: unknown): value is Record<string, unknown> | unknown[] {
+  return typeof value === "object" && value !== null;
+}
+
+/** Deep copy using own members only; "__proto__" keys are copied as plain data. */
+function clone(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(clone);
+  if (typeof value === "object" && value !== null) {
+    const out: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(out, key, clone((value as Record<string, unknown>)[key]));
+    return out;
+  }
+  return value;
+}
+
+function setMember(obj: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** RFC 6902 section 4.6: equality of JSON values; object member order is irrelevant. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (isContainer(a) && isContainer(b)) {
+    const keysA = Object.keys(a);
+    return (
+      keysA.length === Object.keys(b).length &&
+      keysA.every((k) => has(b, k) && jsonEqual((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]))
+    );
+  }
+  return a === b;
+}
+
+function pointerTokens(pointer: unknown, name: string): string[] {
+  if (typeof pointer !== "string") throw new JsonPatchError(`"${name}" must be a string`);
+  try {
+    return parsePointer(pointer);
+  } catch (e) {
+    throw new JsonPatchError(`Invalid "${name}": ${(e as Error).message}`);
+  }
+}
+
+/** Finds the container holding the target of `tokens` (which must be non-empty). */
+function parentOf(root: unknown, tokens: string[]): Record<string, unknown> | unknown[] {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new JsonPatchError(`No array element "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (isContainer(current) && has(current, token)) {
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPatchError(`Path does not exist at "${token}"`);
+    }
+  }
+  if (!isContainer(current)) throw new JsonPatchError("Parent of target is not an object or array");
+  return current;
+}
+
+function getAt(root: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) return root;
+  const parent = parentOf(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(key) || Number(key) >= parent.length) throw new JsonPatchError(`No array element "${key}"`);
+    return parent[Number(key)];
+  }
+  if (!has(parent, key)) throw new JsonPatchError(`No member "${key}"`);
+  return parent[key];
+}
+
+/** Returns the new document. Mutates `root` (a private copy) in place. */
+function addAt(root: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (key === "-") parent.push(value);
+    else if (ARRAY_INDEX.test(key) && Number(key) <= parent.length) parent.splice(Number(key), 0, value);
+    else throw new JsonPatchError(`Invalid array index "${key}"`);
+  } else {
+    setMember(parent, key, value);
+  }
+  return root;
+}
+
+function removeAt(root: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) throw new JsonPatchError("Cannot remove the whole document");
+  getAt(root, tokens); // must exist
+  const parent = parentOf(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(key), 1);
+  else delete parent[key];
+  return root;
+}
+
+function replaceAt(root: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  getAt(root, tokens); // must exist
+  const parent = parentOf(root, tokens);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(key)] = value;
+  else setMember(parent, key, value);
+  return root;
+}
+
+/**
+ * Applies a JSON Patch to a JSON document.
+ *
+ * Implements JSON Patch, RFC 6902: operations add, remove, replace, move, copy and
+ * test (section 4), evaluated in order, with error handling per section 5. Paths are
+ * JSON Pointers (RFC 6901). Members of an operation other than the ones it uses are
+ * ignored. The patch is atomic: if any operation fails, an error is thrown and no
+ * result is produced. Neither `document` nor `patch` is modified, and the result
+ * shares no structure with them.
+ *
+ * @param document any parsed JSON value
+ * @param patch an array of operation objects
+ * @returns the patched document
+ * @throws JsonPatchError if the patch is malformed or an operation fails
+ */
+export function applyPatch(document: unknown, patch: PatchOperation[]): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchError("A JSON Patch must be an array");
+  let result = clone(document);
+  for (const operation of patch as unknown[]) {
+    if (!isContainer(operation) || Array.isArray(operation)) {
+      throw new JsonPatchError("Each patch operation must be an object");
+    }
+    const o = operation as Record<string, unknown>;
+    const path = pointerTokens(o.path, "path");
+    const needValue = () => {
+      if (!has(o, "value")) throw new JsonPatchError(`Operation "${String(o.op)}" requires "value"`);
+      return clone(o.value);
+    };
+    switch (o.op) {
+      case "add":
+        result = addAt(result, path, needValue());
+        break;
+      case "remove":
+        result = removeAt(result, path);
+        break;
+      case "replace":
+        result = replaceAt(result, path, needValue());
+        break;
+      case "test":
+        if (!jsonEqual(getAt(result, path), needValue())) throw new JsonPatchError("Test operation failed");
+        break;
+      case "move":
+      case "copy": {
+        const from = pointerTokens(o.from, "from");
+        const value = clone(getAt(result, from));
+        if (o.op === "copy") {
+          result = addAt(result, path, value);
+          break;
+        }
+        // Section 4.4: "from" must not be a proper prefix of "path".
+        if (from.length < path.length && from.every((t, i) => t === path[i])) {
+          throw new JsonPatchError('"from" must not be a proper prefix of "path"');
+        }
+        if (from.length === path.length && from.every((t, i) => t === path[i])) break;
+        result = addAt(removeAt(result, from), path, value);
+        break;
+      }
+      default:
+        throw new JsonPatchError(`Unknown operation "${String(o.op)}"`);
+    }
+  }
+  return result;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a48c21d68b06a0ebfd307273c0fc3bd9918c3478
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,135 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { applyPatch, JsonPatchError } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) =>
+  assert.deepStrictEqual(applyPatch(doc, patch as never), expected);
+const bad = (doc: unknown, patch: unknown) =>
+  assert.throws(() => applyPatch(doc, patch as never), JsonPatchError);
+
+// RFC 6902 Appendix A examples.
+test("A.1 adding an object member", () =>
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" }));
+test("A.2 adding an array element", () =>
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] }));
+test("A.3 removing an object member", () =>
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }));
+test("A.4 removing an array element", () =>
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }));
+test("A.5 replacing a value", () =>
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" }));
+test("A.6 moving a value", () =>
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  ));
+test("A.7 moving an array element", () =>
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  }));
+test("A.8 testing a value: success", () =>
+  ok({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  }));
+test("A.9 testing a value: error", () => bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]));
+test("A.10 adding a nested member object", () =>
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } }));
+test("A.11 ignoring unrecognized elements", () =>
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" }));
+test("A.12 adding to a nonexistent target", () =>
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]));
+test("A.14 ~ escape ordering", () =>
+  ok({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }));
+test("A.15 comparing strings and numbers", () =>
+  bad({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]));
+test("A.16 adding an array value", () =>
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] }));
+
+test("add: root replaces document; array bounds; leading zeros", () => {
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok([1], [{ op: "add", path: "/1", value: 2 }], [1, 2]);
+  ok([1], [{ op: "add", path: "/0", value: 0 }], [0, 1]);
+  bad([1], [{ op: "add", path: "/2", value: 2 }]);
+  bad([1], [{ op: "add", path: "/01", value: 2 }]);
+  bad([1], [{ op: "add", path: "/x", value: 2 }]);
+  bad([1], [{ op: "add", path: "/-1", value: 2 }]);
+  ok({ a: 1 }, [{ op: "add", path: "/a", value: null }], { a: null });
+});
+test("remove/replace require an existing target", () => {
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad([1], [{ op: "remove", path: "/1" }]);
+  bad([1], [{ op: "remove", path: "/-" }]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad([1], [{ op: "replace", path: "/-", value: 1 }]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: 5 }], 5);
+  ok({ a: 1 }, [{ op: "replace", path: "/a", value: null }], { a: null });
+  bad({ a: 1 }, [{ op: "remove", path: "" }]);
+});
+test("move", () => {
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  bad({}, [{ op: "move", from: "/a", path: "/b" }]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "" }], 1);
+});
+test("copy is deep and independent", () => {
+  const out = applyPatch({ a: { b: [1] } }, [
+    { op: "copy", from: "/a", path: "/c" },
+    { op: "add", path: "/c/b/-", value: 2 },
+  ]) as { a: { b: number[] }; c: { b: number[] } };
+  assert.deepStrictEqual(out, { a: { b: [1] }, c: { b: [1, 2] } });
+  bad({}, [{ op: "copy", from: "/x", path: "/y" }]);
+});
+test("test: deep equality semantics", () => {
+  const t = (v: unknown, value: unknown) => applyPatch({ v }, [{ op: "test", path: "/v", value }]);
+  t({ a: 1, b: [1, { c: null }] }, { b: [1, { c: null }], a: 1 });
+  t(1.0, 1);
+  t(null, null);
+  assert.throws(() => t([1, 2], [2, 1]), JsonPatchError);
+  assert.throws(() => t({ a: 1 }, { a: 1, b: 2 }), JsonPatchError);
+  assert.throws(() => t(null, 0), JsonPatchError);
+  assert.throws(() => t([], {}), JsonPatchError);
+  bad({ a: 1 }, [{ op: "test", path: "/b", value: null }]); // missing is not null
+});
+test("invalid patches", () => {
+  bad({}, {});
+  bad({}, [null]);
+  bad({}, [[]]);
+  bad({}, [{ path: "/a", value: 1 }]);
+  bad({}, [{ op: "bogus", path: "/a" }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "add", value: 1 }]);
+  bad({}, [{ op: "add", path: 1, value: 1 }]);
+  bad({}, [{ op: "add", path: "a", value: 1 }]);
+  bad({}, [{ op: "add", path: "/~2", value: 1 }]);
+  bad({}, [{ op: "move", path: "/a" }]);
+  bad({ a: 1 }, [{ op: "copy", path: "/b" }]);
+  bad({}, [{ op: "test", path: "/a" }]);
+});
+test("no mutation of input, atomic on failure", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const snapshot = JSON.parse(JSON.stringify(doc));
+  const value = { x: [1] };
+  const out = applyPatch(doc, [{ op: "add", path: "/d", value }, { op: "remove", path: "/a/0" }]) as Record<string, unknown>;
+  assert.deepStrictEqual(doc, snapshot);
+  assert.notStrictEqual(out.d, value);
+  assert.throws(() => applyPatch(doc, [{ op: "remove", path: "/a/0" }, { op: "remove", path: "/zzz" }]));
+  assert.deepStrictEqual(doc, snapshot);
+  assert.deepStrictEqual(applyPatch(doc, []), snapshot);
+});
+test("prototype pollution is rejected or harmless", () => {
+  bad({}, [{ op: "add", path: "/__proto__/polluted", value: 1 }]);
+  bad({}, [{ op: "add", path: "/constructor/prototype/polluted", value: 1 }]);
+  bad({}, [{ op: "remove", path: "/__proto__" }]);
+  bad({}, [{ op: "copy", from: "/constructor", path: "/a" }]);
+  assert.strictEqual(({} as Record<string, unknown>).polluted, undefined);
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: 1 } }]) as Record<string, unknown>;
+  assert.strictEqual(({} as Record<string, unknown>).polluted, undefined);
+  assert.strictEqual(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepStrictEqual(Object.keys(out), ["__proto__"]);
+  const parsed = JSON.parse('{"__proto__": {"x": 1}}');
+  const out2 = applyPatch(parsed, [{ op: "add", path: "/a", value: 1 }]) as Record<string, unknown>;
+  assert.strictEqual(Object.getPrototypeOf(out2), Object.prototype);
+  assert.deepStrictEqual(Object.keys(out2), ["__proto__", "a"]);
+});
