index 7a1723fa2ab7c129ddbe5de55239109062d9bbe5..aa6800c17d8e4db1518d3bc41e4ef5dc2f1921e5 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -284,3 +284,106 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return out;
 }
+
+function escapeToken(token: string): string {
+  // ~ first, then /, the reverse of the decoding order (RFC 6901 section 3).
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && jsonEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  // Longest common subsequence of the middle parts: the items it keeps are left untouched.
+  const n = endFrom - start;
+  const m = endTo - start;
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(from[start + i], to[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  // `index` is the position in the array being built, i.e. where the next gap starts.
+  let index = start;
+  const gap = (i0: number, i1: number, j0: number, j1: number) => {
+    const paired = Math.min(i1 - i0, j1 - j0);
+    for (let k = 0; k < paired; k++) diffValues(from[start + i0 + k], to[start + j0 + k], `${path}/${index + k}`, ops);
+    for (let k = paired; k < i1 - i0; k++) ops.push({ op: "remove", path: `${path}/${index + paired}` });
+    for (let k = paired; k < j1 - j0; k++) {
+      ops.push({ op: "add", path: `${path}/${index + k}`, value: clone(to[start + j0 + k]) });
+    }
+    index += j1 - j0;
+  };
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (jsonEqual(from[start + i], to[start + j]) && lcs[i][j] === lcs[i + 1][j + 1] + 1) {
+      i++;
+      j++;
+      index++;
+      continue;
+    }
+    // Next kept item: advance to the nearest pair that continues the common subsequence.
+    let ni = i;
+    let nj = j;
+    while (ni < n && nj < m && !(jsonEqual(from[start + ni], to[start + nj]) && lcs[ni][nj] === lcs[ni + 1][nj + 1] + 1)) {
+      if (lcs[ni + 1][nj] >= lcs[ni][nj + 1]) ni++;
+      else nj++;
+    }
+    if (ni >= n || nj >= m) {
+      ni = n;
+      nj = m;
+    }
+    gap(i, ni, j, nj);
+    i = ni;
+    j = nj;
+  }
+  gap(i, n, j, m);
+}
+
+function diffValues(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isContainer(from) && isContainer(to) && !Array.isArray(from) && !Array.isArray(to)) {
+    const a = from as Record<string, unknown>;
+    const b = to as Record<string, unknown>;
+    for (const key of Object.keys(a)) {
+      if (!has(b, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(b)) {
+      const member = `${path}/${escapeToken(key)}`;
+      if (!has(a, key)) ops.push({ op: "add", path: member, value: clone(b[key]) });
+      else diffValues(a[key], b[key], member, ops);
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Creates a JSON Patch that turns one JSON document into another.
+ *
+ * Produces a JSON Patch, RFC 6902 (operations add, remove and replace, section 4), with
+ * paths escaped as JSON Pointers (RFC 6901 section 3). Equality of values follows RFC 6902
+ * section 4.6. Objects are compared member by member and arrays item by item, so only the
+ * parts that differ are described: an item added to or removed from an array is a single
+ * `add` or `remove`, and an item that moves is a `remove` followed by an `add`, with the items
+ * around it left alone. Neither argument is modified and the patch shares no structure with them.
+ *
+ * @param from any parsed JSON value
+ * @param to any parsed JSON value
+ * @returns a patch such that `applyPatch(from, patch)` equals `to`; empty if they are equal
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffValues(from, to, "", ops);
+  return ops;
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3fa8794f8b3e21ecc5a670a6aa6936bae5d0bbe7
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,123 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+/** The patch must turn `from` into `to`, leave both inputs untouched, and return the patch. */
+const roundTrip = (from: unknown, to: unknown) => {
+  const fromCopy = JSON.stringify(from);
+  const toCopy = JSON.stringify(to);
+  const patch = createPatch(from, to);
+  assert.deepStrictEqual(applyPatch(from, patch), to);
+  assert.strictEqual(JSON.stringify(from), fromCopy);
+  assert.strictEqual(JSON.stringify(to), toCopy);
+  return patch;
+};
+
+test("equal documents give an empty patch", () => {
+  assert.deepStrictEqual(roundTrip({ a: [1, { b: null }] }, { a: [1, { b: null }] }), []);
+  assert.deepStrictEqual(roundTrip({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+  assert.deepStrictEqual(roundTrip(null, null), []);
+});
+
+test("root replacement", () => {
+  assert.deepStrictEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepStrictEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  roundTrip(null, {});
+  roundTrip([], {});
+});
+
+test("object members: add, remove, replace, null versus missing", () => {
+  assert.deepStrictEqual(roundTrip({ a: 1, b: 2, c: 3 }, { a: 1, b: 5, d: 4 }), [
+    { op: "remove", path: "/c" },
+    { op: "replace", path: "/b", value: 5 },
+    { op: "add", path: "/d", value: 4 },
+  ]);
+  assert.deepStrictEqual(roundTrip({ a: null }, {}), [{ op: "remove", path: "/a" }]);
+  assert.deepStrictEqual(roundTrip({}, { a: null }), [{ op: "add", path: "/a", value: null }]);
+  assert.deepStrictEqual(roundTrip({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+});
+
+test("small change deep inside is described locally", () => {
+  const from = { a: { b: [1, 2, { c: "x", d: "y" }], e: "same" }, f: [1, 2, 3] };
+  const to = { a: { b: [1, 2, { c: "x", d: "z" }], e: "same" }, f: [1, 2, 3] };
+  assert.deepStrictEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/2/d", value: "z" }]);
+});
+
+test("pointer escaping", () => {
+  assert.deepStrictEqual(roundTrip({ "a/b": 1, "m~n": 1, "": 1 }, { "a/b": 2, "m~n": 2, "": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/m~0n", value: 2 },
+    { op: "replace", path: "/", value: 2 },
+  ]);
+});
+
+test("array gains an item", () => {
+  assert.deepStrictEqual(roundTrip([1, 2, 4, 5], [1, 2, 3, 4, 5]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepStrictEqual(roundTrip([1], [1, 2]), [{ op: "add", path: "/1", value: 2 }]);
+  assert.deepStrictEqual(roundTrip([], [1]), [{ op: "add", path: "/0", value: 1 }]);
+  assert.deepStrictEqual(roundTrip([{ a: 1 }, { a: 2 }], [{ a: 0 }, { a: 1 }, { a: 2 }]).length, 1);
+});
+
+test("array loses an item", () => {
+  assert.deepStrictEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepStrictEqual(roundTrip([1], []), [{ op: "remove", path: "/0" }]);
+  assert.deepStrictEqual(roundTrip([{ a: 1 }, { a: 2 }, { a: 3 }], [{ a: 1 }, { a: 3 }]), [
+    { op: "remove", path: "/1" },
+  ]);
+});
+
+test("array item moves without rewriting the items between", () => {
+  for (const [from, to] of [
+    [[1, 2, 3, 4, 5], [1, 3, 4, 5, 2]],
+    [[1, 2, 3, 4, 5], [5, 1, 2, 3, 4]],
+    [[1, 2, 3, 4, 5], [1, 4, 2, 3, 5]],
+  ]) {
+    const patch = roundTrip(from, to);
+    assert.ok(patch.length <= 2, JSON.stringify(patch));
+    assert.ok(patch.every((o) => o.op !== "replace"), JSON.stringify(patch));
+  }
+});
+
+test("a changed array item is patched in place", () => {
+  assert.deepStrictEqual(roundTrip([{ a: 1, b: 2 }, 5], [{ a: 1, b: 3 }, 5]), [
+    { op: "replace", path: "/0/b", value: 3 },
+  ]);
+  assert.deepStrictEqual(roundTrip([1, 2, 3], [1, 9, 3]), [{ op: "replace", path: "/1", value: 9 }]);
+});
+
+test("arrays with duplicates and mixed edits", () => {
+  roundTrip([1, 1, 1], [1, 1]);
+  roundTrip([1, 2, 1, 2], [2, 1, 2, 1]);
+  roundTrip([[1], [2]], [[2], [1, 1]]);
+  roundTrip([1, "a", null, { x: [1] }], [{ x: [1, 2] }, null, "b", 1, 7]);
+});
+
+test("randomised round trips", () => {
+  let seed = 12345;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) % n);
+  const gen = (depth: number): unknown => {
+    const k = rnd(depth > 2 ? 4 : 6);
+    if (k === 0) return rnd(3);
+    if (k === 1) return null;
+    if (k === 2) return ["a", "b"][rnd(2)];
+    if (k === 3) return rnd(2) === 0;
+    if (k === 4) return Array.from({ length: rnd(5) }, () => gen(depth + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => [["a", "b", "c/d", "~"][rnd(4)], gen(depth + 1)]));
+  };
+  for (let i = 0; i < 500; i++) roundTrip(gen(0), gen(0));
+});
+
+test("__proto__ keys are plain members", () => {
+  const from = JSON.parse('{"__proto__": {"x": 1}}');
+  const to = JSON.parse('{"__proto__": {"x": 2}}');
+  const patch = roundTrip(from, to);
+  assert.deepStrictEqual(patch, [{ op: "replace", path: "/__proto__/x", value: 2 }]);
+  assert.strictEqual(({} as Record<string, unknown>).x, undefined);
+});
+
+test("patch values share no structure with the inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0] as { value: { b: number } }).value.b = 99;
+  assert.strictEqual(to.a.b, 1);
+});
