@@ -0,0 +1,67 @@
+/** Error thrown for an invalid JSON Pointer or a pointer that does not resolve. */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new JsonPointerError(`Invalid JSON Pointer "${pointer}": "~" must be followed by 0 or 1`);
+      }
+      // ~1 first, then ~0, so that "~01" becomes "~1" and not "/" (RFC 6901 section 4).
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/**
+ * Resolves a JSON Pointer against a JSON document.
+ *
+ * Implements JSON Pointer, RFC 6901: syntax (section 3), evaluation (section 4) and
+ * error handling (section 7). The document is not modified.
+ *
+ * @param document any parsed JSON value
+ * @param pointer a JSON Pointer string; "" refers to the whole document
+ * @returns the referenced value (which may be `null`)
+ * @throws JsonPointerError if the pointer is syntactically invalid, or does not
+ *   resolve to a value (missing member, out-of-range or "-" array index, or
+ *   traversal into a primitive)
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const token of parsePointer(pointer)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token)) {
+        throw new JsonPointerError(`"${token}" is not a valid array index`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new JsonPointerError(`Array index ${token} is out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      // Own members only: never reach inherited ones such as __proto__ or constructor.
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new JsonPointerError(`No member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Cannot resolve "${token}" in a non-container value`);
+    }
+  }
+  return current;
+}
