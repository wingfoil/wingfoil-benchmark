--- a/test/list.test.ts
+++ b/test/list.test.ts
@@ -169,3 +169,43 @@ describe('task timestamps', () => {
     assert.deepEqual(valueOf(list.get(added.id)), added);
   });
 });
+
+describe('input validation', () => {
+  const rejected = (result: { ok: boolean; error?: { code: string } }): void => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+  };
+
+  it('rejects an empty, blank or too long title when adding', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: '' }));
+    rejected(list.add({ title: '   ' }));
+    rejected(list.add({ title: 'x'.repeat(121) }));
+    assert.equal(list.list().length, 0);
+    assert.equal(list.add({ title: 'x'.repeat(120) }).ok, true);
+  });
+
+  it('rejects an unknown priority and a bad tag when adding', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: 'A', priority: 'urgent' as 'low' }));
+    rejected(list.add({ title: 'A', tags: ['ok', ''] }));
+    rejected(list.add({ title: 'A', tags: ['two words'] }));
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a bad new title when renaming, and changes nothing', () => {
+    const list = createTodoList();
+    list.add({ title: 'A' });
+    rejected(list.rename('A', ' '));
+    rejected(list.rename('A', 'x'.repeat(121)));
+    assert.deepEqual(list.list().map((task) => task.title), ['A']);
+  });
+
+  it('rejects a bad tag when tagging, and changes nothing', () => {
+    const list = createTodoList();
+    list.add({ title: 'A' });
+    rejected(list.tag('A', ''));
+    rejected(list.tag('A', 'a b'));
+    assert.deepEqual(valueOf(list.find('A')).tags, []);
+  });
+});
