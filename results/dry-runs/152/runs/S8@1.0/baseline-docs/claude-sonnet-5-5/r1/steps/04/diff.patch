+import type { TaskList } from './list.ts';
+import type { NewTask } from './task.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { validatePriority } from './task.ts';
+
+/** A line of an import that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * The task a line describes, or why it is not one. A line is `title;priority;tags`: the priority and the
+ * tags may be left out, a missing priority is `normal`, and the tags are separated by spaces.
+ *
+ * @param line - one non-blank line of the import
+ */
+function parseLine(line: string): Result<NewTask> {
+  const fields = line.split(';');
+  if (fields.length > 3) return err('invalid-input', `expected at most 3 fields (title;priority;tags), found ${fields.length}`);
+  const [title, priority = '', tags = ''] = fields;
+  const wanted = priority.trim().toLowerCase();
+  const checked = validatePriority(wanted === '' ? 'normal' : wanted);
+  if (!checked.ok) return checked;
+  return ok({ title, priority: checked.value, tags: tags.split(/\s+/).filter((tag) => tag !== '') });
+}
+
+/**
+ * Adds to the list a task for every valid line of `text`, one task per line; blank lines are skipped.
+ * A line that cannot be added (bad format, invalid task, or a title already in the list) is reported
+ * with its number, counting from 1 over all lines, and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import, as `title;priority;tags`
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((line, index) => {
+    if (line.trim() === '') return;
+    const parsed = parseLine(line);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
