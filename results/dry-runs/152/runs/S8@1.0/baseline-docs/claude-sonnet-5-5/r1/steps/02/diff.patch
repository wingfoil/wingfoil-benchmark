+
+describe('task timestamps', () => {
+  function steppingClock() {
+    let minute = 0;
+    return () => new Date(Date.UTC(2026, 0, 1, 0, minute++));
+  }
+
+  it('gives a new task the same createdAt and updatedAt', () => {
+    const list = createTodoList(steppingClock());
+    const task = valueOf(list.add({ title: 'Buy milk' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    const list = createTodoList(steppingClock());
+    list.add({ title: 'a' });
+    const changes = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.rename('a', 'b'),
+      () => list.tag('b', 'home'),
+      () => list.untag('b', 'home'),
+    ];
+    changes.forEach((change, index) => {
+      const task = valueOf(change());
+      assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+      assert.equal(task.updatedAt, `2026-01-01T00:0${index + 1}:00.000Z`);
+    });
+  });
+
+  it('leaves updatedAt alone when a change fails', () => {
+    const list = createTodoList(steppingClock());
+    const added = valueOf(list.add({ title: 'a' }));
+    assert.equal(list.reopen('a').ok, false);
+    assert.deepEqual(valueOf(list.get(added.id)), added);
+  });
+});
