diff --git a/src/domain/validation.ts b/src/domain/validation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1a0f540910555a08207e1c0b0fb39295912a452f
--- /dev/null
+++ b/src/domain/validation.ts
@@ -0,0 +1,59 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { NewTask } from './task.ts';
+
+/** The longest title a task may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a title: after trimming it must be neither empty nor longer than `MAX_TITLE_LENGTH`.
+ *
+ * @param title - the title to check
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title is empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; the limit is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be one of `PRIORITIES`.
+ *
+ * @param priority - the priority to check
+ */
+export function validatePriority(priority: string): Result<string> {
+  if (!(PRIORITIES as readonly string[]).includes(priority)) {
+    return err('invalid-input', `the priority "${priority}" is not one of ${PRIORITIES.join(', ')}`);
+  }
+  return ok(priority);
+}
+
+/**
+ * Checks a tag: it must not be empty nor contain a space.
+ *
+ * @param tag - the tag to check
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'the tag is empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space`);
+  return ok(tag);
+}
+
+/**
+ * Checks everything a new task is made of: its title, its priority when given, and each tag.
+ *
+ * @param input - the task to check
+ */
+export function validateNewTask(input: NewTask): Result<NewTask> {
+  const checks = [
+    validateTitle(input.title),
+    ...(input.priority === undefined ? [] : [validatePriority(input.priority)]),
+    ...(input.tags ?? []).map(validateTag),
+  ];
+  const failed = checks.find((check) => !check.ok);
+  return failed !== undefined && !failed.ok ? failed : ok(input);
+}
diff --git a/test/list.test.ts b/test/list.test.ts
index cf04b80d19c8edec37845629ef2eaaecdec14a1f..02a73dbedd5ef2547b9f21a15825fbb11df80ac6 100644
--- a/test/list.test.ts
+++ b/test/list.test.ts
@@ -155,3 +155,48 @@ describe('task timestamps', () => {
     assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
   });
 });
+
+describe('input validation', () => {
+  const rejected = (result: { ok: boolean; error?: { code: string; message: string } }, pattern: RegExp) => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+    assert.match(result.error?.message ?? '', pattern);
+  };
+
+  it('rejects an empty or blank title, and a title over 120 characters', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: '' }), /empty/);
+    rejected(list.add({ title: '   ' }), /empty/);
+    rejected(list.add({ title: 'x'.repeat(121) }), /121 characters.*120/);
+    assert.equal(list.list().length, 0);
+    assert.equal(list.add({ title: 'x'.repeat(120) }).ok, true);
+  });
+
+  it('rejects an unknown priority', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: 'Buy milk', priority: 'urgent' as 'high' }), /"urgent".*low, normal, high/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects an empty tag or one with a space, when adding and when tagging', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: 'Buy milk', tags: ['ok', ''] }), /empty/);
+    rejected(list.add({ title: 'Buy milk', tags: ['two words'] }), /space/);
+    assert.equal(list.list().length, 0);
+    list.add({ title: 'Buy milk', tags: ['shop'] });
+    const before = valueOf(list.find('Buy milk'));
+    rejected(list.tag('Buy milk', ''), /empty/);
+    rejected(list.tag('Buy milk', ' '), /space/);
+    rejected(list.tag('Buy milk', 'a b'), /space/);
+    assert.deepEqual(valueOf(list.find('Buy milk')), before);
+  });
+
+  it('rejects an invalid new title on rename and leaves the task as it was', () => {
+    const list = createTodoList();
+    list.add({ title: 'Buy milk' });
+    const before = valueOf(list.find('Buy milk'));
+    rejected(list.rename('Buy milk', '  '), /empty/);
+    rejected(list.rename('Buy milk', 'x'.repeat(121)), /limit/);
+    assert.deepEqual(valueOf(list.find('Buy milk')), before);
+  });
+});
