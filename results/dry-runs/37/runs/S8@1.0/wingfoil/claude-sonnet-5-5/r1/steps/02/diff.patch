+
+describe('task timestamps', () => {
+  function steppingClock(): () => string {
+    let minute = 0;
+    return () => new Date(Date.UTC(2026, 0, 1, 0, (minute += 1))).toISOString();
+  }
+
+  it('gives a new task the same createdAt and updatedAt', () => {
+    const list = createTodoList(steppingClock());
+    const task = valueOf(list.add({ title: 'Buy milk' }));
+    assert.equal(task.createdAt, '2026-01-01T00:01:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    const list = createTodoList(steppingClock());
+    list.add({ title: 'Buy milk' });
+    const changes = [
+      valueOf(list.tag('Buy milk', 'shop')),
+      valueOf(list.untag('Buy milk', 'shop')),
+      valueOf(list.rename('Buy milk', 'Buy oat milk')),
+      valueOf(list.complete('Buy oat milk')),
+      valueOf(list.reopen('Buy oat milk')),
+    ];
+    changes.forEach((task, index) => {
+      assert.equal(task.createdAt, '2026-01-01T00:01:00.000Z');
+      assert.equal(task.updatedAt, `2026-01-01T00:0${index + 2}:00.000Z`);
+    });
+  });
+
+  it('leaves updatedAt alone when a change is refused', () => {
+    const list = createTodoList(steppingClock());
+    const added = valueOf(list.add({ title: 'Buy milk' }));
+    assert.equal(list.reopen('Buy milk').ok, false);
+    assert.equal(valueOf(list.get(added.id)).updatedAt, added.updatedAt);
+  });
+
+  it('uses the system clock by default', () => {
+    const task = valueOf(createTodoList().add({ title: 'Buy milk' }));
+    assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
+  });
+});
