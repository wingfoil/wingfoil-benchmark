+describe('task ids', () => {
+  it('gives each task its own id, kept when renamed, and finds it by id', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    const b = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(a.id, b.id);
+    const renamed = valueOf(list.rename(a.id, 'c'));
+    assert.equal(renamed.id, a.id);
+    assert.equal(valueOf(list.get(a.id)).title, 'c');
+    assert.equal(valueOf(list.find(b.id)).title, 'b');
+    assert.equal(valueOf(list.complete(a.id)).status, 'done');
+    assert.equal(valueOf(list.tag(b.id, 'x')).tags[0], 'x');
+    assert.equal(valueOf(list.remove(b.id)).title, 'b');
+    assert.equal(list.get(b.id).ok, false);
+  });
+
+  it('does not reuse the id of a removed task, and reports an unknown id', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    list.remove('a');
+    assert.notEqual(valueOf(list.add({ title: 'a' })).id, a.id);
+    const missing = list.get('nope');
+    assert.equal(missing.ok, false);
+    if (!missing.ok) assert.equal(missing.error.code, 'not-found');
+  });
+
+  it('still refuses a duplicate title when renaming by id', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    list.add({ title: 'b' });
+    assert.equal(list.rename(a.id, 'b').ok, false);
+    assert.equal(list.rename(a.id, 'a').ok, true);
+  });
+});
