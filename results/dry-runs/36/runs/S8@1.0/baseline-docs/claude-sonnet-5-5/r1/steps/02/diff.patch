+
+describe('task timestamps', () => {
+  function steppingList() {
+    let minute = 0;
+    return createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, minute++)).toISOString());
+  }
+
+  it('creates a task with equal createdAt and updatedAt', () => {
+    const task = valueOf(steppingList().add({ title: 'Buy milk' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    const list = steppingList();
+    const created = valueOf(list.add({ title: 'a' }));
+    const changes = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.rename('a', 'b'),
+      () => list.tag('b', 'home'),
+      () => list.untag('b', 'home'),
+    ];
+    let previous = created.updatedAt;
+    for (const change of changes) {
+      const task = valueOf(change());
+      assert.equal(task.createdAt, created.createdAt);
+      assert.ok(task.updatedAt > previous);
+      previous = task.updatedAt;
+    }
+  });
+
+  it('leaves updatedAt alone when a change fails', () => {
+    const list = steppingList();
+    const created = valueOf(list.add({ title: 'a' }));
+    assert.equal(list.reopen('a').ok, false);
+    assert.equal(valueOf(list.find('a')).updatedAt, created.updatedAt);
+  });
+
+  it('uses the system clock by default', () => {
+    const task = valueOf(createTodoList().add({ title: 'a' }));
+    assert.ok(!Number.isNaN(Date.parse(task.createdAt)));
+  });
+});
