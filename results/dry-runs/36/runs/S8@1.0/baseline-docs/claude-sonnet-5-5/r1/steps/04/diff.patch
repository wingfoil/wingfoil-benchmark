+
+## Bulk import
+
+`importTasks(list, text)` adds tasks from text with one task per line, as `title;priority;tags`. The
+priority may be empty for a normal one (`low`, `normal` or `high`); tags are separated by spaces, as in
+`Renew the insurance;high;admin money`. Blank lines are skipped. It returns `{ imported, rejected }`, where
+`rejected` lists each line that could not be added as `{ line, reason }`, `line` counting from 1 (blank
+lines included). A bad line never stops the import of the others.
diff --git a/src/domain/import.ts b/src/domain/import.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b7f855ff5573055b908c3bb5220d2764f3466f06
--- /dev/null
+++ b/src/domain/import.ts
@@ -0,0 +1,57 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { TaskList } from './list.ts';
+import { PRIORITIES } from './task.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** A line of the text that could not be added, with its number (from 1) and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * The task a line `title;priority;tags` describes, or why it does not. The priority may be empty
+ * for a normal one, and the tags, separated by spaces, may be left out.
+ *
+ * @param line - one non-blank line of the text
+ */
+function parseLine(line: string): Result<NewTask> {
+  const fields = line.split(';');
+  if (fields.length > 3) return err('invalid', `expected "title;priority;tags" but found ${fields.length} fields`);
+  const [title = '', priority = '', tags = ''] = fields.map((field) => field.trim());
+  if (priority !== '' && !PRIORITIES.includes(priority as Priority)) {
+    return err('invalid', `the priority "${priority}" is not one of ${PRIORITIES.join(', ')}`);
+  }
+  return ok({
+    title,
+    ...(priority === '' ? {} : { priority: priority as Priority }),
+    tags: tags === '' ? [] : tags.split(/\s+/),
+  });
+}
+
+/**
+ * Adds the tasks described in `text` to `list`, one per line as `title;priority;tags`. Blank lines are
+ * skipped; every other line that cannot be added is reported with its number, counting from 1.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importLines(list: TaskList, text: string): ImportReport {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  text.split(/\r\n|\n|\r/).forEach((line, index) => {
+    if (line.trim() === '') return;
+    const parsed = parseLine(line);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
