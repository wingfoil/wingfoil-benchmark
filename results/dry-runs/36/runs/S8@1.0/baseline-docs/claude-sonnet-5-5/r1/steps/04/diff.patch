+
+/**
+ * Adds tasks to `list` from text with one task per line, as `title;priority;tags`. The priority may be
+ * left empty for a normal one; tags are separated by spaces, e.g. `Renew the insurance;high;admin money`.
+ * Blank lines are skipped, and a line that cannot be added (bad priority, empty title, duplicate...) is
+ * reported rather than stopping the import.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ * @returns how many tasks were added, and the rejected lines as `{ line, reason }`, `line` counting from 1
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  return importLines(list, text);
+}
