+
+describe('importTasks', () => {
+  it('adds every valid line, skipping blank ones', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\nBuy milk;;\nWalk dog');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = valueOf(list.find('Renew the insurance'));
+    assert.equal(insurance.priority, 'high');
+    assert.deepEqual(insurance.tags, ['admin', 'money']);
+    assert.equal(valueOf(list.find('Buy milk')).priority, 'normal');
+  });
+
+  it('reports rejected lines by their number, counting blank lines', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'A;urgent;x\n\n;high;\nA\nB;;a b;extra\nC;low;ok');
+    assert.equal(report.imported, 2);
+    assert.deepEqual(
+      report.rejected.map((rejected) => rejected.line),
+      [1, 3, 5],
+    );
+    assert.equal(list.list().length, 2);
+  });
+
+  it('handles Windows line endings', () => {
+    const report = importTasks(createTodoList(), 'A;low;\r\nB\r\n');
+    assert.deepEqual(report, { imported: 2, rejected: [] });
+  });
+});
