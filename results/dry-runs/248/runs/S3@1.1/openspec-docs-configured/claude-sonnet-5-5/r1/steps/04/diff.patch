+
+test('rentals shorter than a day on the hour cost the hourly price per hour, and need an hourly price', () => {
+  const s = setup();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2550, hourlyPrice: 700 });
+  assert.equal(s.quote(req('2026-06-01T13:00:00Z', '2026-06-01T16:00:00Z', 'h1')).total, 2100);
+  assert.equal(s.book(req('2026-06-01T00:00:00Z', '2026-06-01T23:00:00Z', 'h1')).total, 16100);
+  assert.throws(() => s.book(req('2026-06-01T15:00:00Z', '2026-06-01T17:00:00Z', 'h1')));
+  assert.equal(s.book(req('2026-06-01T23:00:00Z', '2026-06-02T00:00:00Z', 'h1')).total, 700);
+  assert.throws(() => s.quote(req('2026-06-01T13:00:00Z', '2026-06-01T16:00:00Z')));
+  assert.throws(() => s.quote(req('2026-06-01T13:30:00Z', '2026-06-01T16:00:00Z', 'h1')));
+  assert.throws(() => s.quote(req('2026-06-01T13:00:00Z', '2026-06-02T13:00:00Z', 'h1')));
+  assert.equal(s.quote(req('2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z', 'h1')).total, 2550);
+  assert.throws(() => s.addEquipment({ id: 'z', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: 'z', kind: 'sail', dailyPrice: 1, hourlyPrice: 1.5 }));
+});
