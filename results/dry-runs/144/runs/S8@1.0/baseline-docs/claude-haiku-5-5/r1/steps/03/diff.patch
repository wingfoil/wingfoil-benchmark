diff --git a/src/domain/validation.ts b/src/domain/validation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..82d274f454a950020a5485e364edc2f06850bf32
--- /dev/null
+++ b/src/domain/validation.ts
@@ -0,0 +1,65 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** The most characters a title may have, once the spaces around it are removed. */
+const MAX_TITLE_LENGTH = 120;
+
+/**
+ * The title without its surrounding spaces, when it is neither empty nor longer than 120 characters.
+ *
+ * @param title - the title as the person typed it
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'a title cannot be empty');
+  const length = [...trimmed].length;
+  if (length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `a title can be at most ${MAX_TITLE_LENGTH} characters, this one has ${length}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority, when it is one of `low`, `normal` and `high`.
+ *
+ * @param priority - the priority as the person chose it
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  const known = PRIORITIES.find((candidate) => candidate === priority);
+  if (known === undefined) {
+    return err('invalid-input', `a priority must be low, normal or high, not "${priority}"`);
+  }
+  return ok(known);
+}
+
+/**
+ * The tag, when it is not empty and has no space in it.
+ *
+ * @param tag - the tag as the person typed it
+ */
+export function validateTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'a tag cannot be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `a tag cannot contain spaces: "${tag}"`);
+  return ok(tag);
+}
+
+/**
+ * The new task, when its title, priority and every tag are valid; otherwise the first reason it is not.
+ *
+ * @param input - the task as the person entered it
+ */
+export function validateNewTask(input: NewTask): Result<NewTask> {
+  const title = validateTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined) {
+    const priority = validatePriority(input.priority);
+    if (!priority.ok) return priority;
+  }
+  for (const tag of input.tags ?? []) {
+    const checked = validateTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok(input);
+}
diff --git a/test/list.test.ts b/test/list.test.ts
index 14e4938d6541942abde49a8ca0485c228ffd9794..2a863b2899e0888cdf839407c7b2134ffc5fb508 100644
--- a/test/list.test.ts
+++ b/test/list.test.ts
@@ -221,3 +221,78 @@ describe('task list', () => {
     assert.deepEqual([summary.open, summary.done], [2, 1]);
   });
 });
+
+function refusedWith(result: { ok: true } | { ok: false; error: { code: string; message: string } }, code: string) {
+  assert.equal(result.ok, false);
+  if (result.ok) return;
+  assert.equal(result.error.code, code);
+  assert.notEqual(result.error.message.trim(), '');
+}
+
+describe('input validation', () => {
+  it('refuses a title that is empty or only spaces, and adds nothing', () => {
+    const list = createTodoList();
+    refusedWith(list.add({ title: '' }), 'invalid-input');
+    refusedWith(list.add({ title: '   ' }), 'invalid-input');
+    assert.deepEqual(list.list(), []);
+  });
+
+  it('accepts a title of exactly 120 characters and refuses one of 121', () => {
+    const list = createTodoList();
+    assert.equal(valueOf(list.add({ title: 'a'.repeat(120) })).title.length, 120);
+    refusedWith(list.add({ title: 'b'.repeat(121) }), 'invalid-input');
+    assert.equal(list.list().length, 1);
+  });
+
+  it('measures the title length without the spaces around it', () => {
+    const list = createTodoList();
+    assert.equal(valueOf(list.add({ title: `  ${'c'.repeat(120)}  ` })).title, 'c'.repeat(120));
+  });
+
+  it('refuses a priority other than low, normal and high', () => {
+    const list = createTodoList();
+    const urgent = { title: 'Urgent', priority: 'urgent' } as unknown as Parameters<typeof list.add>[0];
+    const capitalised = { title: 'Capital', priority: 'High' } as unknown as Parameters<typeof list.add>[0];
+    refusedWith(list.add(urgent), 'invalid-input');
+    refusedWith(list.add(capitalised), 'invalid-input');
+    assert.deepEqual(list.list(), []);
+    assert.equal(valueOf(list.add({ title: 'Low one', priority: 'low' })).priority, 'low');
+    assert.equal(valueOf(list.add({ title: 'High one', priority: 'high' })).priority, 'high');
+  });
+
+  it('refuses an empty tag or a tag with a space, and adds no task', () => {
+    const list = createTodoList();
+    refusedWith(list.add({ title: 'No empty tags', tags: ['home', ''] }), 'invalid-input');
+    refusedWith(list.add({ title: 'No spaces', tags: ['front room'] }), 'invalid-input');
+    assert.deepEqual(list.list(), []);
+  });
+
+  it('does not use up an id when an add is refused for its input', () => {
+    const list = createTodoList();
+    refusedWith(list.add({ title: '   ' }), 'invalid-input');
+    assert.equal(valueOf(list.add({ title: 'Valid' })).id, 'task-1');
+  });
+
+  it('refuses a rename to an empty or over-long title and keeps the old title', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'Keep me' }));
+    refusedWith(list.rename(task.id, ' '), 'invalid-input');
+    refusedWith(list.rename(task.id, 'd'.repeat(121)), 'invalid-input');
+    const after = valueOf(list.get(task.id));
+    assert.deepEqual(after, task);
+  });
+
+  it('refuses a tag that is empty or has a space, and keeps the task as it was', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'Tag me', tags: ['home'] }));
+    refusedWith(list.tag(task.id, ''), 'invalid-input');
+    refusedWith(list.tag(task.id, 'front room'), 'invalid-input');
+    assert.deepEqual(valueOf(list.get(task.id)), task);
+  });
+
+  it('refuses invalid input for an unknown task with invalid-input, not not-found', () => {
+    const list = createTodoList();
+    refusedWith(list.tag('no-such-task', 'a b'), 'invalid-input');
+    refusedWith(list.rename('no-such-task', ''), 'invalid-input');
+  });
+});
