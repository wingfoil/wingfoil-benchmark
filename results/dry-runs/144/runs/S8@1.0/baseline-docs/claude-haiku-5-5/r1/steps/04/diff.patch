diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2e861281a084f17ac2bc700c3859407ce8591e82
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,117 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('bulk import', () => {
+  it('adds each line as a task, with its priority and tags', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;low;');
+    assert.deepEqual(report, { imported: 2, rejected: [] });
+    assert.deepEqual(
+      list.list().map((task) => [task.title, task.priority, task.tags]),
+      [
+        ['Renew the insurance', 'high', ['admin', 'money']],
+        ['Buy milk', 'low', []],
+      ],
+    );
+  });
+
+  it('gives a task a normal priority when the priority is left empty', () => {
+    const list = createTodoList();
+    importTasks(list, 'Sweep the porch;  ;home');
+    assert.equal(list.list()[0]?.priority, 'normal');
+  });
+
+  it('treats any run of spaces between tags as one separator', () => {
+    const list = createTodoList();
+    importTasks(list, 'Fix the tap;normal;  house   garden ');
+    assert.deepEqual(list.list()[0]?.tags, ['house', 'garden']);
+  });
+
+  it('skips blank lines, without counting them as rejected', () => {
+    const list = createTodoList();
+    const report = importTasks(list, '\nFirst;;\n   \n\t\nSecond;;\n');
+    assert.deepEqual(report, { imported: 2, rejected: [] });
+    assert.equal(list.list().length, 2);
+  });
+
+  it('counts line numbers from 1, blank lines included', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Good;;\n\nBad;urgent;\nAlso good;;');
+    assert.equal(report.imported, 2);
+    assert.deepEqual(report.rejected, [
+      { line: 3, reason: 'a priority must be low, normal or high, not "urgent"' },
+    ]);
+  });
+
+  it('reads lines that end with CRLF line endings, as spreadsheets write them', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'One;;\r\nTwo;high;\r\n');
+    assert.deepEqual(report, { imported: 2, rejected: [] });
+    assert.deepEqual(
+      list.list().map((task) => task.title),
+      ['Two', 'One'],
+    );
+  });
+
+  it('rejects a priority other than low, normal and high, and adds the rest', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Capital;High;\nPlain;normal;');
+    assert.equal(report.imported, 1);
+    assert.equal(report.rejected.length, 1);
+    assert.equal(report.rejected[0]?.line, 1);
+    assert.notEqual(report.rejected[0]?.reason.trim(), '');
+    assert.deepEqual(
+      list.list().map((task) => task.title),
+      ['Plain'],
+    );
+  });
+
+  it('rejects a line with an empty title, with the reason', () => {
+    const list = createTodoList();
+    const report = importTasks(list, ' ;high;home');
+    assert.deepEqual(report, {
+      imported: 0,
+      rejected: [{ line: 1, reason: 'a title cannot be empty' }],
+    });
+    assert.deepEqual(list.list(), []);
+  });
+
+  it('rejects a title longer than 120 characters', () => {
+    const list = createTodoList();
+    const report = importTasks(list, `${'x'.repeat(121)};;`);
+    assert.equal(report.imported, 0);
+    assert.equal(report.rejected[0]?.line, 1);
+    assert.match(report.rejected[0]?.reason ?? '', /120 characters/);
+  });
+
+  it('rejects a line that does not have exactly three fields', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'No separators\nToo;many;fields;here\nTwo;;');
+    assert.deepEqual(
+      report.rejected.map((entry) => entry.line),
+      [1, 2],
+    );
+    assert.equal(report.imported, 1);
+    assert.equal(list.list()[0]?.title, 'Two');
+  });
+
+  it('rejects a title already in the list, and one repeated within the text', () => {
+    const list = createTodoList();
+    list.add({ title: 'Call the plumber' });
+    const report = importTasks(list, 'Call the plumber;;\nNew one;;\nNew one;;');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(
+      report.rejected.map((entry) => entry.line),
+      [1, 3],
+    );
+    assert.equal(list.list().length, 2);
+  });
+
+  it('returns an empty report for empty text', () => {
+    const list = createTodoList();
+    assert.deepEqual(importTasks(list, ''), { imported: 0, rejected: [] });
+    assert.deepEqual(list.list(), []);
+  });
+});
