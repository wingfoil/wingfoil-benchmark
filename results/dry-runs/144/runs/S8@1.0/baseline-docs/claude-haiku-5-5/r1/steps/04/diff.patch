index 0000000000000000000000000000000000000000..f5aadc5a8f6d48e427c7e5cea494ec4f9edb392e
--- /dev/null
+++ b/src/domain/import.ts
@@ -0,0 +1,56 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { TaskList } from './list.ts';
+import type { NewTask } from './task.ts';
+import { validatePriority } from './validation.ts';
+
+/** A line of an import that did not become a task, and why. `line` counts from 1, blank lines included. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks it added, and every line it could not add. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds every valid line of `text` to `list`. Each line is one task, written `title;priority;tags`: the priority
+ * may be left empty for a normal one, and the tags are separated by spaces. Blank lines are skipped. A line that
+ * cannot be added is left out and reported; the lines around it are still added. Lines may end in LF or CRLF.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import, as typed or pasted from a spreadsheet
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  for (const [index, raw] of text.split(/\r?\n/).entries()) {
+    if (raw.trim() === '') continue;
+    const line = index + 1;
+    const parsed = parseLine(raw);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  }
+  return { imported, rejected };
+}
+
+/**
+ * The new task a line describes, when it has exactly three `;`-separated fields and a valid priority if one is
+ * given. The title and tags are checked when the task is added.
+ *
+ * @param raw - one line of the import
+ */
+function parseLine(raw: string): Result<NewTask> {
+  const fields = raw.split(';');
+  if (fields.length !== 3) return err('invalid-input', 'a line must be title;priority;tags, with two semicolons');
+  const [title, priority, tags] = fields;
+  const tagList = tags.split(/\s+/).filter((tag) => tag !== '');
+  if (priority.trim() === '') return ok({ title, tags: tagList });
+  const checked = validatePriority(priority.trim());
+  if (!checked.ok) return checked;
+  return ok({ title, priority: checked.value, tags: tagList });
+}
