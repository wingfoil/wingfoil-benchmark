     assert.equal(coupons.usedBy('ONCE'), 'ORD-0001');
     assert.throws(() => orders.place({ customer: 'c-2', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'ONCE' }), CouponError);
   });
+
+  it('gives a single-use coupon back when its order is cancelled, so the customer can use it again', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const wrongSize = orders.place({ customer: 'c-1', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'WELCOME' });
+    orders.cancel(wrongSize.id, '2026-05-05');
+    assert.equal(coupons.usedBy('WELCOME'), undefined);
+    const corrected = orders.place({ customer: 'c-1', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'WELCOME' });
+    assert.equal(corrected.totals.couponDiscountCents, 200);
+    assert.equal(coupons.usedBy('WELCOME'), corrected.id);
+  });
 });
