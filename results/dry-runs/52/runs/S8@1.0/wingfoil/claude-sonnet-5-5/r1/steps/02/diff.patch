+
+describe('task timestamps', () => {
+  function steppingList() {
+    let minute = 0;
+    return createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, minute++)).toISOString());
+  }
+
+  it('gives a new task equal createdAt and updatedAt', () => {
+    const task = valueOf(steppingList().add({ title: 'a' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every kind of change, and keeps createdAt', () => {
+    const list = steppingList();
+    list.add({ title: 'a' });
+    const changes = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.tag('a', 'x'),
+      () => list.untag('a', 'x'),
+      () => list.rename('a', 'b'),
+    ];
+    let previous = '2026-01-01T00:00:00.000Z';
+    for (const change of changes) {
+      const task = valueOf(change());
+      assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+      assert.ok(task.updatedAt > previous);
+      previous = task.updatedAt;
+    }
+  });
+
+  it('leaves updatedAt alone when a change is refused', () => {
+    const list = steppingList();
+    const task = valueOf(list.add({ title: 'a' }));
+    assert.equal(list.reopen('a').ok, false);
+    assert.equal(valueOf(list.find('a')).updatedAt, task.updatedAt);
+  });
+
+  it('uses the real clock by default', () => {
+    const task = valueOf(createTodoList().add({ title: 'a' }));
+    assert.ok(!Number.isNaN(Date.parse(task.createdAt)));
+  });
+});
