+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { NewTask } from './task.ts';
+import { validatePriority } from './task.ts';
+
+/** A line of an import that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/** The most fields a line has: title, priority and tags. */
+const MAX_FIELDS = 3;
+
+/**
+ * Reads one line of `title;priority;tags` into a new task. The priority and the tags may be left out;
+ * an empty priority means a normal one, and tags are separated by spaces.
+ *
+ * @param line - a non-blank line as written in the spreadsheet
+ */
+export function parseTaskLine(line: string): Result<NewTask> {
+  const fields = line.split(';');
+  if (fields.length > MAX_FIELDS) {
+    return err('invalid-input', `the line has ${fields.length} fields; the most is ${MAX_FIELDS} (title;priority;tags)`);
+  }
+  const [title = '', rawPriority = '', rawTags = ''] = fields;
+  const tags = rawTags.split(/\s+/).filter((tag) => tag !== '');
+  const priority = rawPriority.trim();
+  if (priority === '') return ok({ title, tags });
+  const valid = validatePriority(priority);
+  return valid.ok ? ok({ title, priority: valid.value, tags }) : valid;
+}
+
+/**
+ * Splits import text into its non-blank lines, each with its number counting from 1; blank lines are
+ * skipped but still counted.
+ *
+ * @param text - one task per line
+ */
+export function numberedLines(text: string): readonly { readonly line: number; readonly text: string }[] {
+  return text
+    .split(/\r?\n/)
+    .map((content, index) => ({ line: index + 1, text: content }))
+    .filter((entry) => entry.text.trim() !== '');
+}
diff --git a/src/index.ts b/src/index.ts
