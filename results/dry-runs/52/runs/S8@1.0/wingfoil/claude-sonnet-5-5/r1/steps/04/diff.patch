@@ -0,0 +1,43 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds every line with its priority and tags', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;;\nCall mum;low;family');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok);
+    assert.equal(milk.value.priority, 'normal');
+    assert.deepEqual(milk.value.tags, []);
+  });
+
+  it('skips blank lines but still counts them in line numbers', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Buy milk\r\n\r\n   \r\n;high;x\r\n');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(report.rejected.map((item) => item.line), [4]);
+  });
+
+  it('accepts a line with only a title or only a title and a priority', () => {
+    const list = createTodoList();
+    assert.equal(importTasks(list, 'One\nTwo;high').imported, 2);
+  });
+
+  it('rejects bad lines with a reason and imports the others', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const report = importTasks(list, 'Good\nBad priority;urgent\nExisting\nToo;many;tags;fields\nGood');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(report.rejected.map((item) => item.line), [2, 3, 4, 5]);
+    for (const item of report.rejected) assert.ok(item.reason.length > 0);
+    assert.match(report.rejected[0]?.reason ?? '', /urgent/);
+    assert.equal(list.list().length, 2);
+  });
+});
