@@ -1,6 +1,9 @@
 import { createTaskList } from './domain/list.ts';
 import type { TaskList } from './domain/list.ts';
+import { numberedLines, parseTaskLine } from './domain/import.ts';
+import type { ImportReport, RejectedLine } from './domain/import.ts';
 
+export type { ImportReport, RejectedLine };
 export type { TaskFilter, TaskList } from './domain/list.ts';
 export type { Result, TodoError, TodoErrorCode } from './domain/result.ts';
 export { summarize } from './domain/summary.ts';
@@ -16,3 +19,24 @@ export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 export function createTodoList(clock: () => string = () => new Date().toISOString()): TaskList {
   return createTaskList(clock);
 }
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`: the priority may
+ * be left empty for a normal one, and tags are separated by spaces. Blank lines are skipped. A line
+ * that cannot be added (bad input, or a title already in the list) is reported and the rest go on.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ * @returns how many tasks were added, and each rejected line with its number (from 1) and reason
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  for (const { line, text: content } of numberedLines(text)) {
+    const parsed = parseTaskLine(content);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  }
+  return { imported, rejected };
+}
