@@ -160,3 +160,53 @@ describe('task timestamps', () => {
     assert.ok(!Number.isNaN(Date.parse(task.createdAt)));
   });
 });
+
+describe('input validation', () => {
+  const invalid = (result: { ok: boolean; error?: { code: string } }) => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+  };
+
+  it('rejects an empty, blank or too long title when adding', () => {
+    const list = createTodoList();
+    invalid(list.add({ title: '' }));
+    invalid(list.add({ title: '   ' }));
+    invalid(list.add({ title: 'x'.repeat(121) }));
+    assert.equal(list.list().length, 0);
+  });
+
+  it('accepts a title of 120 characters, counted once trimmed', () => {
+    const list = createTodoList();
+    assert.equal(list.add({ title: ` ${'x'.repeat(120)} ` }).ok, true);
+  });
+
+  it('rejects an unknown priority and a bad tag when adding', () => {
+    const list = createTodoList();
+    invalid(list.add({ title: 'a', priority: 'urgent' as 'high' }));
+    invalid(list.add({ title: 'a', tags: ['ok', ''] }));
+    invalid(list.add({ title: 'a', tags: ['two words'] }));
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a bad new title when renaming, and changes nothing', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'a' }));
+    invalid(list.rename('a', ' '));
+    invalid(list.rename('a', 'x'.repeat(121)));
+    assert.deepEqual(valueOf(list.find('a')), before);
+  });
+
+  it('rejects a bad tag when tagging, and changes nothing', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'a' }));
+    invalid(list.tag('a', ''));
+    invalid(list.tag('a', 'a b'));
+    assert.deepEqual(valueOf(list.find('a')), before);
+  });
+
+  it('does not use up an id when an addition is rejected', () => {
+    const list = createTodoList();
+    list.add({ title: '' });
+    assert.equal(valueOf(list.add({ title: 'a' })).id, 'task-1');
+  });
+});
