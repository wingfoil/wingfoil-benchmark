+describe('timestamps', () => {
+  it('sets createdAt and updatedAt together, and updatedAt on every change', () => {
+    let tick = 0;
+    const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)).toISOString());
+    const added = valueOf(list.add({ title: 'a' }));
+    assert.equal(added.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(added.updatedAt, added.createdAt);
+    const steps = [
+      valueOf(list.complete('a')),
+      valueOf(list.reopen('a')),
+      valueOf(list.rename('a', 'b')),
+      valueOf(list.tag('b', 'x')),
+      valueOf(list.untag('b', 'x')),
+    ];
+    steps.forEach((task, i) => {
+      assert.equal(task.createdAt, added.createdAt);
+      assert.equal(task.updatedAt, new Date(Date.UTC(2026, 0, 1, 0, 0, i + 1)).toISOString());
+    });
+  });
+});
