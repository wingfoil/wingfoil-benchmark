+describe('importTasks', () => {
+  it('imports valid lines and reports the others by line number', () => {
+    const list = createTodoList();
+    const report = importTasks(
+      list,
+      'Renew the insurance;high;admin money\n\nBuy milk\nBad;urgent;x\n  ;low;\nBuy milk;;\r\nWater plants;low',
+    );
+    assert.equal(report.imported, 3);
+    assert.deepEqual(report.rejected.map((r) => r.line), [4, 5, 6]);
+    const insurance = valueOf(list.find('Renew the insurance'));
+    assert.equal(insurance.priority, 'high');
+    assert.deepEqual(insurance.tags, ['admin', 'money']);
+    assert.equal(valueOf(list.find('Buy milk')).priority, 'normal');
+  });
+
+  it('rejects a line with too many fields', () => {
