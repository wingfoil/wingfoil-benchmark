+++ b/src/domain/import.ts
@@ -0,0 +1,46 @@
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of an import that could not be added, and why. */
+export interface RejectedLine {
+  /** The line's number in the text, counting from 1. */
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks of `text` to `list`, one per line, as `title;priority;tags`. The priority may be left
+ * empty for a normal one; tags are separated by spaces. Blank lines are skipped, and a line that cannot
+ * be added does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  text.split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `expected "title;priority;tags", found ${fields.length} fields` });
+      return;
+    }
+    const [title = '', priority = '', tags = ''] = fields;
+    const added = list.add({
+      title,
+      priority: (priority.trim() === '' ? undefined : priority.trim()) as Priority | undefined,
+      tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+    });
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
