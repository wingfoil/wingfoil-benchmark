+  it('gives each task a unique id that survives renaming', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    const b = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(a.id, b.id);
+    const renamed = valueOf(list.rename(a.id, 'a2'));
+    assert.equal(renamed.id, a.id);
+    assert.equal(valueOf(list.get(a.id)).title, 'a2');
+    assert.equal(list.get('nope').ok, false);
+    assert.equal(valueOf(list.rename(a.id, 'a2')).title, 'a2');
+    assert.equal(list.rename(a.id, 'b').ok, false);
+  });
+
