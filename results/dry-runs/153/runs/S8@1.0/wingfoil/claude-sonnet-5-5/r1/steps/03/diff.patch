diff --git a/src/domain/task.ts b/src/domain/task.ts
index dfb1580fc4b5f196c656e78dff97d2ec9297a6de..edcfe76821713f07d9432e1635ce1e6b490bce93 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -7,6 +7,9 @@ export type Priority = 'low' | 'normal' | 'high';
 /** Every priority, from the least urgent to the most. */
 export const PRIORITIES: readonly Priority[] = ['low', 'normal', 'high'];
 
+/** The longest title a task may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
 /** Whether a task still has to be done. */
 export type Status = 'open' | 'done';
 
@@ -129,3 +132,59 @@ export function compareTasks(a: Task, b: Task): number {
 function unique(tags: readonly string[]): string[] {
   return tags.filter((tag, index) => tags.indexOf(tag) === index);
 }
+
+/**
+ * Checks a title: once trimmed it must be neither empty nor longer than 120 characters.
+ *
+ * @param title - the title to check
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title must not be empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title must be at most ${MAX_TITLE_LENGTH} characters, not ${trimmed.length}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be `low`, `normal` or `high`.
+ *
+ * @param priority - the priority to check
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  if (!(PRIORITIES as readonly string[]).includes(priority)) {
+    return err('invalid-input', `the priority must be one of ${PRIORITIES.join(', ')}, not "${String(priority)}"`);
+  }
+  return ok(priority as Priority);
+}
+
+/**
+ * Checks a tag: it must not be empty nor contain a space.
+ *
+ * @param tag - the tag to check
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'a tag must not be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `a tag must not contain a space: "${tag}"`);
+  return ok(tag);
+}
+
+/**
+ * Checks everything a new task is made of: its title, priority and tags.
+ *
+ * @param input - the new task to check
+ */
+export function validateNewTask(input: NewTask): Result<NewTask> {
+  const title = validateTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined) {
+    const priority = validatePriority(input.priority);
+    if (!priority.ok) return priority;
+  }
+  for (const tag of input.tags ?? []) {
+    const checked = validateTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok(input);
+}
