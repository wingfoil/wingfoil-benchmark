+
+describe('input validation', () => {
+  const code = (r: { ok: boolean; error?: { code: string } }) => (r.ok ? 'ok' : r.error?.code);
+
+  it('rejects bad titles, priorities and tags on add, leaving the list empty', () => {
+    const list = createTodoList();
+    assert.equal(code(list.add({ title: '' })), 'invalid-input');
+    assert.equal(code(list.add({ title: '   ' })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'x'.repeat(121) })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'a', priority: 'urgent' as never })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'a', tags: ['ok', ''] })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'a', tags: ['two words'] })), 'invalid-input');
+    assert.equal(list.list().length, 0);
+    assert.equal(code(list.add({ title: 'x'.repeat(120) })), 'ok');
+  });
+
+  it('rejects bad rename and tag input without changing the task', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'Task' }));
+    assert.equal(code(list.rename('Task', '  ')), 'invalid-input');
+    assert.equal(code(list.rename('Task', 'y'.repeat(121))), 'invalid-input');
+    assert.equal(code(list.tag('Task', '')), 'invalid-input');
+    assert.equal(code(list.tag('Task', 'a b')), 'invalid-input');
+    assert.deepEqual(valueOf(list.get(before.id)), before);
+  });
+});
