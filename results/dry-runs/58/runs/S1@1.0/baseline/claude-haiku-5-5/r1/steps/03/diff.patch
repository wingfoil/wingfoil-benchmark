+
+test("rejects a sparse patch array rather than skipping the hole", () => {
+  const patch = [, { op: "add", path: "/a", value: 1 }];
+  assert.throws(() => applyPatch({}, patch), JsonPatchError);
+});
+
+test("rejects values that are not JSON", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: undefined }]), JsonPatchError);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: NaN }]), JsonPatchError);
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "", value: Infinity }]), JsonPatchError);
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "", value: new Date(0) }]), JsonPatchError);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: [1, , 2] }]), JsonPatchError);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: { b: undefined } }]), JsonPatchError);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: () => 1 }]), JsonPatchError);
+  const cyclic: Record<string, unknown> = {};
+  cyclic.self = cyclic;
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: cyclic }]), JsonPatchError);
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a", value: [null, true, 0.5, "s", { b: [] }] }]), {
+    a: [null, true, 0.5, "s", { b: [] }],
+  });
+});
+
+test("moving a location onto itself is a no-op, including the whole document", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "", path: "" }]), { a: 1 });
+  assert.deepEqual(applyPatch({ a: [1, 2] }, [{ op: "move", from: "/a/1", path: "/a/1" }]), { a: [1, 2] });
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/x", path: "/x" }]), JsonPatchError);
+});
