+describe('input validation', () => {
+  it('rejects invalid input and changes nothing', () => {
+    const list = createTodoList();
+    valueOf(list.add({ title: 'a' }));
+    for (const input of [
+      { title: '   ' },
+      { title: 'x'.repeat(121) },
+      { title: 'b', priority: 'urgent' as never },
+      { title: 'b', tags: ['ok', ''] },
+      { title: 'b', tags: ['a b'] },
+    ]) {
+      const result = list.add(input);
+      assert.equal(!result.ok && result.error.code, 'invalid-input');
+    }
+    assert.equal(list.rename('a', ' ').ok, false);
+    assert.equal(list.rename('a', 'x'.repeat(121)).ok, false);
+    assert.equal(list.tag('a', '').ok, false);
+    assert.equal(list.tag('a', 'a b').ok, false);
+    assert.equal(list.list().length, 1);
+    assert.equal(valueOf(list.find('a')).title, 'a');
+    assert.deepEqual(valueOf(list.find('a')).tags, []);
+    valueOf(list.add({ title: 'x'.repeat(120) }));
+  });
+});
