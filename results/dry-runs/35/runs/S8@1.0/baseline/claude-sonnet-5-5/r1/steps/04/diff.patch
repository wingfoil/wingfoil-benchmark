+
+describe('importTasks', () => {
+  it('imports valid lines and reports the others by line number', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\nBuy milk\nTea;urgent;\n;low;\nBuy milk;;\r\nWalk;;a b;x');
+    assert.equal(report.imported, 2);
+    assert.deepEqual(report.rejected.map((r) => r.line), [4, 5, 6, 7]);
+    const task = valueOf(list.find('Renew the insurance'));
+    assert.equal(task.priority, 'high');
+    assert.deepEqual(task.tags, ['admin', 'money']);
+  });
+});
