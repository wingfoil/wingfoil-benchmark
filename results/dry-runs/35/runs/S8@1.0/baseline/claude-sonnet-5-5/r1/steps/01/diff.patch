 describe('task list', () => {
+  it('gives each task a unique id that survives a rename', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    const b = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(a.id, b.id);
+    const renamed = valueOf(list.rename(a.id, 'c'));
+    assert.equal(renamed.id, a.id);
+    assert.equal(valueOf(list.get(a.id)).title, 'c');
+    assert.equal(list.get('nope').ok, false);
+    assert.equal(valueOf(list.find('c')).id, a.id);
+    assert.equal(valueOf(list.rename(a.id, 'c')).title, 'c');
+    assert.equal(list.rename(a.id, 'b').ok, false);
+    assert.equal(valueOf(list.complete(a.id)).status, 'done');
+    valueOf(list.tag(b.id, 'x'));
+    valueOf(list.untag(b.id, 'x'));
+    valueOf(list.remove(b.id));
+    assert.equal(list.get(b.id).ok, false);
+  });
+
   it('adds an open task with a normal priority by default', () => {
     const list = createTodoList();
     const task = valueOf(list.add({ title: '  Buy milk ' }));
-    assert.deepEqual(task, { title: 'Buy milk', priority: 'normal', tags: [], status: 'open' });
+    assert.deepEqual(task, { id: task.id, title: 'Buy milk', priority: 'normal', tags: [], status: 'open' });
     assert.equal(list.openCount(), 1);
   });
 
