+
+describe('task timestamps', () => {
+  it('sets updatedAt on every change and keeps createdAt', async () => {
+    const list = createTodoList();
+    const added = valueOf(list.add({ title: 'a' }));
+    let previous = added;
+    const steps = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.rename('a', 'b'),
+      () => list.tag('b', 'x'),
+      () => list.untag('b', 'x'),
+    ];
+    for (const step of steps) {
+      await new Promise((resolve) => setTimeout(resolve, 5));
+      const next = valueOf(step());
+      assert.equal(next.createdAt, added.createdAt);
+      assert.ok(next.updatedAt > previous.updatedAt);
+      previous = next;
+    }
+  });
+});
