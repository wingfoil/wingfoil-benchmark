+
+describe('input validation', () => {
+  const invalid = (result: { ok: boolean; error?: { code: string } }) => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+  };
+
+  it('rejects bad input on add and changes nothing', () => {
+    const list = createTodoList();
+    invalid(list.add({ title: '' }));
+    invalid(list.add({ title: '   ' }));
+    invalid(list.add({ title: 'x'.repeat(121) }));
+    invalid(list.add({ title: 'ok', priority: 'urgent' as never }));
+    invalid(list.add({ title: 'ok', tags: ['fine', ''] }));
+    invalid(list.add({ title: 'ok', tags: ['a b'] }));
+    assert.equal(list.list().length, 0);
+    assert.equal(valueOf(list.add({ title: 'x'.repeat(120) })).id, 'task-1');
+  });
+
+  it('rejects bad input on rename and tag', () => {
+    const list = createTodoList();
+    list.add({ title: 'Task' });
+    invalid(list.rename('Task', ' '));
+    invalid(list.rename('Task', 'x'.repeat(121)));
+    invalid(list.tag('Task', ''));
+    invalid(list.tag('Task', 'a b'));
+    const task = valueOf(list.find('Task'));
+    assert.deepEqual(task.tags, []);
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+});
