index 078cd551459a13002c75a44555c55aea95cd0c0f..d368585dc8365a8c45b15afa411bf56f30c9e0eb 100644
--- a/test/apply-patch.test.mjs
+++ b/test/apply-patch.test.mjs
@@ -177,3 +177,31 @@ test("throws when an operation fails, naming its index", () => {
     (error) => error instanceof Error && /operation 1 \(remove\)/.test(error.message),
   );
 });
+
+test("throws for a patch or a document that is not JSON", () => {
+  const add = [{ op: "add", path: "/b", value: 1 }];
+  assert.throws(() => applyPatch({ a: undefined }, add), TypeError);
+  assert.throws(() => applyPatch(undefined, [{ op: "add", path: "", value: 1 }]), TypeError);
+  assert.throws(() => applyPatch({ a: NaN }, add), TypeError);
+  assert.throws(() => applyPatch({ a: new Date(0) }, add), TypeError);
+  assert.throws(() => applyPatch({}, [, { op: "remove", path: "/a" }]), TypeError);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: [, 1] }]), TypeError);
+  assert.throws(() => applyPatch({}, Object.create([{ op: "remove", path: "/a" }])), TypeError);
+  assert.throws(() => applyPatch({}, [Object.create({ op: "remove", path: "/a" })]), TypeError);
+});
+
+test("throws for a value that is not JSON, in any operation", () => {
+  const cyclic = {};
+  cyclic.self = cyclic;
+  for (const value of [undefined, NaN, Infinity, 1n, () => 1, Symbol("s"), cyclic, new Map()]) {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/b", value }]), TypeError);
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "replace", path: "/a", value }]), TypeError);
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value }]), TypeError);
+  }
+});
+
+test("a patch that is not JSON leaves the document unchanged", () => {
+  const doc = { a: 1 };
+  assert.throws(() => applyPatch(doc, [{ op: "remove", path: "/a" }, { op: "add", path: "/b", value: undefined }]), TypeError);
+  assert.deepEqual(doc, { a: 1 });
+});
