diff --git a/test/rental.test.ts b/test/rental.test.ts
index 8423d66288ca71fe2757eb719924140698eacf35..65ca8fd34fda65af8f232dc06110969f0ee7797c 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -56,3 +56,26 @@ test('availability lists free items of a kind, sorted', () => {
   assert.deepEqual(q('2026-07-03T00:00:00Z', '2026-07-04T00:00:00Z', 'board'), ['a0', 'b1']);
   assert.throws(() => q('2026-07-03T00:00:00Z', '2026-07-03T00:00:00Z'));
 });
+
+test('rentals shorter than a day are priced per hour', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  assert.equal(s.quote(req2('h', '2026-07-01T13:00:00Z', '2026-07-01T16:00:00Z')).total, 1800);
+  assert.equal(s.quote(req2('h', '2026-07-01T10:00:00Z', '2026-07-02T00:00:00Z')).total, 8400);
+  assert.equal(s.quote(req2('h', '2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z')).total, 2500);
+  assert.throws(() => s.quote(req2('h', '2026-07-01T13:30:00Z', '2026-07-01T16:00:00Z')));
+  assert.throws(() => s.quote(req2('h', '2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z')));
+  s.book(req2('h', '2026-07-01T13:00:00Z', '2026-07-01T16:00:00Z'));
+  assert.throws(() => s.book(req2('h', '2026-07-01T15:00:00Z', '2026-07-01T17:00:00Z')));
+  assert.deepEqual(s.availability({ start: '2026-07-01T16:00:00Z', end: '2026-07-01T17:00:00Z' }), ['h']);
+});
+
+test('items without an hourly price cannot be rented by the hour', () => {
+  const s = setup();
+  assert.throws(() => s.quote(req('2026-07-01T13:00:00Z', '2026-07-01T16:00:00Z')));
+  assert.throws(() => s.addEquipment({ id: 'z', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+});
+
+function req2(itemId: string, start: string, end: string) {
+  return { itemId, start, end };
+}
