+
+test('availability lists free items of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a1', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 1000 });
+  s.book(req('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  const q = (start: string, end: string, kind?: 'board' | 'sail') => s.availability({ start, end, kind });
+  assert.deepEqual(q('2026-07-02T00:00:00Z', '2026-07-04T00:00:00Z'), ['a0', 'a1']);
+  assert.deepEqual(q('2026-07-02T00:00:00Z', '2026-07-04T00:00:00Z', 'board'), ['a0']);
+  assert.deepEqual(q('2026-07-03T00:00:00Z', '2026-07-04T00:00:00Z', 'board'), ['a0', 'b1']);
+  assert.throws(() => q('2026-07-03T00:00:00Z', '2026-07-03T00:00:00Z'));
+});
