diff --git a/src/index.ts b/src/index.ts
index 0f318b4ace5dd7689c08c3659fe02795f607841b..2fe31fc37e5ba28d6fe55fa40a75652771045d1d 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -250,3 +250,87 @@ export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
   }
   return result as JsonValue;
 }
+
+const escapeToken = (token: string) => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, ops: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && deepEqual(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && deepEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const a = from.slice(start, endFrom);
+  const b = to.slice(start, endTo);
+
+  // Longest common subsequence of the differing middle parts.
+  const lcs: number[][] = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lcs[i][j] = deepEqual(a[i], b[j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  let cur = start; // index in the array as it stands after the operations emitted so far
+  let i = 0;
+  let j = 0;
+  const flush = (removedEnd: number, addedEnd: number) => {
+    const removed = a.slice(i, removedEnd);
+    const added = b.slice(j, addedEnd);
+    const paired = Math.min(removed.length, added.length);
+    for (let k = 0; k < paired; k++) diffValues(removed[k], added[k], `${path}/${cur + k}`, ops);
+    for (let k = paired; k < removed.length; k++) ops.push({ op: "remove", path: `${path}/${cur + paired}` });
+    for (let k = paired; k < added.length; k++) {
+      ops.push({ op: "add", path: `${path}/${cur + k}`, value: clone(added[k]) });
+    }
+    cur += added.length;
+  };
+  while (i < a.length || j < b.length) {
+    // Find the next matched pair on the LCS path.
+    let ni = i;
+    let nj = j;
+    while (ni < a.length && nj < b.length && !deepEqual(a[ni], b[nj])) {
+      if (lcs[ni + 1][nj] >= lcs[ni][nj + 1]) ni++;
+      else nj++;
+    }
+    if (ni >= a.length || nj >= b.length) {
+      flush(a.length, b.length);
+      break;
+    }
+    flush(ni, nj);
+    i = ni + 1;
+    j = nj + 1;
+    cur++;
+  }
+}
+
+function diffValues(from: JsonValue, to: JsonValue, path: string, ops: PatchOperation[]): void {
+  if (deepEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (!hasOwn(from, key)) ops.push({ op: "add", path: child, value: clone(to[key] as JsonValue) });
+      else diffValues(from[key] as JsonValue, to[key] as JsonValue, child, ops);
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied.
+ * Only the differing parts are described. The inputs are not mutated.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) throw new TypeError("Both documents must be valid JSON values");
+  const ops: PatchOperation[] = [];
+  diffValues(from as JsonValue, to as JsonValue, "", ops);
+  return ops;
+}
diff --git a/test/createpatch.test.ts b/test/createpatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f301c2118159ae8d2e84c41546036881ca91e3ec
--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,33 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+test("minimal object changes", () => {
+  const from = { a: 1, b: { c: [1, 2], d: "x" }, "k/~": 1 };
+  const to = { a: 1, b: { c: [1, 2], d: "y" }, "k/~": 2 };
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [
+    { op: "replace", path: "/b/d", value: "y" },
+    { op: "replace", path: "/k~1~0", value: 2 },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("array insert, remove and move do not rewrite neighbours", () => {
+  assert.deepEqual(createPatch([1, 2, 3], [1, 2, 9, 3]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(createPatch([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+  const patch = createPatch([1, 2, 3, 4, 5], [1, 5, 2, 3, 4]);
+  assert.equal(patch.length, 2);
+  assert.deepEqual(applyPatch([1, 2, 3, 4, 5], patch), [1, 5, 2, 3, 4]);
+});
+
+test("does not mutate inputs; equal documents give an empty patch", () => {
+  const from = { a: [{ x: 1 }] };
+  const to = { a: [{ x: 1 }, { y: 2 }] };
+  const f = JSON.stringify(from), t = JSON.stringify(to);
+  const patch = createPatch(from, to);
+  assert.equal(JSON.stringify(from), f);
+  assert.equal(JSON.stringify(to), t);
+  assert.notEqual((patch[0].value as any), to.a[1]);
+  assert.deepEqual(createPatch(to, to), []);
+});
