@@ -232,3 +232,21 @@ export function applyPatch(document: unknown, patch: unknown): JsonValue {
   }
   return doc;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to `target` and returns the result as a new value.
+ * The inputs are not mutated. A non-object patch replaces the target; `null` members delete.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
+  if (!isObject(patch)) return clone(patch) as JsonValue;
+  const result: Record<string, unknown> = isObject(target) ? (clone(target) as Record<string, unknown>) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result as JsonValue;
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..72fb4d25cef6a8162694511f296cc35c61e43aeb
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,33 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, r] of cases) assert.deepEqual(applyMergePatch(t, p), r);
+});
+
+test("does not mutate inputs and handles __proto__", () => {
+  const t = { a: { b: 1 } };
+  const p = JSON.parse('{"a":{"c":2},"__proto__":{"x":1}}');
+  const r = applyMergePatch(t, p) as any;
+  assert.deepEqual(t, { a: { b: 1 } });
+  assert.equal(({} as any).x, undefined);
+  assert.deepEqual(r.a, { b: 1, c: 2 });
+});
