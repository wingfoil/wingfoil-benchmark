diff --git a/src/index.test.ts b/src/index.test.ts
index ff6d1cbd3b03b0248a2797c46019193c2e07776d..b813b6816a5c6cea8bd551c3c682fbcf871509e4 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -83,3 +83,51 @@ test('addEquipment validates its input', () => {
   service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100 });
   assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100 }));
 });
+
+function serviceWithStock() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 3000 });
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 4500 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 4500 });
+  return service;
+}
+
+test('availability lists the sorted ids of all kinds, or of the given kind', () => {
+  const service = serviceWithStock();
+  const period = { start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' };
+  assert.deepEqual(service.availability(period), ['board-1', 'board-2', 'sail-1']);
+  assert.deepEqual(service.availability({ ...period, kind: 'board' }), ['board-1', 'board-2']);
+  assert.deepEqual(service.availability({ ...period, kind: 'sail' }), ['sail-1']);
+});
+
+test('availability leaves out items booked during any part of the period', () => {
+  const service = serviceWithStock();
+  service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z', kind: 'board' }),
+    ['board-2'],
+  );
+});
+
+test('availability treats back-to-back bookings as free', () => {
+  const service = serviceWithStock();
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  assert.deepEqual(
+    service.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z', kind: 'board' }),
+    ['board-1', 'board-2'],
+  );
+});
+
+test('availability rejects invalid periods and kinds', () => {
+  const service = serviceWithStock();
+  assert.throws(() => service.availability({ start: '2026-07-01T10:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.throws(() => service.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+  assert.throws(() =>
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z', kind: 'kite' as 'board' }),
+  );
+});
+
+test('availability is empty when nothing matches', () => {
+  const service = createRentalService();
+  assert.deepEqual(service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }), []);
+});
