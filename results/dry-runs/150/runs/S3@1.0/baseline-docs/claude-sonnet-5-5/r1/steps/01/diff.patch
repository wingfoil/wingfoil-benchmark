+++ b/src/index.test.ts
@@ -0,0 +1,85 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+function serviceWithBoard() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 4500 });
+  return service;
+}
+
+test('quote prices whole days at the daily price', () => {
+  const service = serviceWithBoard();
+  assert.deepEqual(
+    service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' }),
+    { itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-04T00:00:00.000Z', total: 13500 },
+  );
+});
+
+test('quote rejects an unknown item', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.quote({ itemId: 'nope', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+});
+
+test('quote rejects periods that are not whole UTC days', () => {
+  const service = serviceWithBoard();
+  const bad = [
+    ['2026-07-01T10:00:00Z', '2026-07-02T00:00:00Z'],
+    ['2026-07-01T00:00:00Z', '2026-07-02T00:00:01Z'],
+    ['2026-07-01T00:00:00+02:00', '2026-07-02T00:00:00Z'],
+    ['2026-07-01', '2026-07-02'],
+    ['2026-02-30T00:00:00Z', '2026-03-02T00:00:00Z'],
+    ['garbage', '2026-07-02T00:00:00Z'],
+  ];
+  for (const [start, end] of bad) {
+    assert.throws(() => service.quote({ itemId: 'board-1', start, end }), undefined, `${start} -> ${end}`);
+  }
+});
+
+test('quote rejects empty and reversed periods', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+});
+
+test('book returns a booking with a distinct id per booking', () => {
+  const service = serviceWithBoard();
+  const first = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  const second = service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.equal(first.total, 4500);
+  assert.equal(first.itemId, 'board-1');
+  assert.notEqual(first.id, second.id);
+});
+
+test('book rejects overlapping periods for the same item only', () => {
+  const service = serviceWithBoard();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 3000 });
+  service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-05T00:00:00Z' });
+  const overlapping = [
+    ['2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'],
+    ['2026-07-04T00:00:00Z', '2026-07-06T00:00:00Z'],
+    ['2026-07-03T00:00:00Z', '2026-07-04T00:00:00Z'],
+    ['2026-07-01T00:00:00Z', '2026-07-08T00:00:00Z'],
+  ];
+  for (const [start, end] of overlapping) {
+    assert.throws(() => service.book({ itemId: 'board-1', start, end }), undefined, `${start} -> ${end}`);
+  }
+  service.book({ itemId: 'board-1', start: '2026-07-05T00:00:00Z', end: '2026-07-06T00:00:00Z' });
+  service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  service.book({ itemId: 'sail-1', start: '2026-07-02T00:00:00Z', end: '2026-07-05T00:00:00Z' });
+});
+
+test('book rejects an unknown item', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.book({ itemId: 'nope', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+});
+
+test('addEquipment validates its input', () => {
+  const service = createRentalService();
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
+  assert.throws(() => service.addEquipment({ id: '', kind: 'board', dailyPrice: 100 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'mast' as 'board', dailyPrice: 100 }));
+  service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100 });
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100 }));
+});
