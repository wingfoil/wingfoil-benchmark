@@ -0,0 +1,132 @@
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00(:00(\.0+)?)?Z$/;
+
+/** The kinds of equipment the school rents. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item; `dailyPrice` is in integer euro cents. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** A rental period as ISO-8601 UTC midnights; `end` is the start of the day after the last day. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The price of a rental; `total` is in integer euro cents. */
+export interface Quote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed rental. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** The in-memory rental module of the booking desk. */
+export interface RentalService {
+  /** Registers an item; throws on invalid input or a duplicate id. */
+  addEquipment(item: Equipment): void;
+  /** Prices a rental; throws for an unknown item or a period that is not whole UTC days. */
+  quote(request: RentalRequest): Quote;
+  /** Books a rental; throws like `quote`, and when the item is taken during the period. */
+  book(request: RentalRequest): Booking;
+}
+
+interface Period {
+  startTime: number;
+  endTime: number;
+}
+
+/** Parses a strict ISO-8601 UTC midnight into epoch milliseconds, throwing otherwise. */
+function parseMidnight(value: unknown, label: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${label} must be an ISO-8601 UTC midnight, e.g. 2026-07-01T00:00:00Z`);
+  }
+  const time = Date.parse(value);
+  if (Number.isNaN(time) || new Date(time).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${label} is not a valid date`);
+  }
+  return time;
+}
+
+function parsePeriod(request: RentalRequest): Period {
+  const start = parseMidnight(request.start, 'start');
+  const end = parseMidnight(request.end, 'end');
+  if (end <= start) {
+    throw new Error('end must be after start');
+  }
+  return { startTime: start, endTime: end };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item.id !== 'string' || item.id === '') {
+    throw new Error('id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error("kind must be 'board' or 'sail'");
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+  }
+}
+
+/** Creates a rental service that keeps equipment and bookings in memory. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Array<{ itemId: string } & Period> = [];
+
+  function price(request: RentalRequest): Quote & Period {
+    const item = equipment.get(request.itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${String(request.itemId)}`);
+    }
+    const period = parsePeriod(request);
+    return {
+      itemId: item.id,
+      start: new Date(period.startTime).toISOString(),
+      end: new Date(period.endTime).toISOString(),
+      total: ((period.endTime - period.startTime) / DAY_MS) * item.dailyPrice,
+      ...period,
+    };
+  }
+
+  return {
+    addEquipment(item) {
+      validateEquipment(item);
+      if (equipment.has(item.id)) {
+        throw new Error(`equipment already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      const { itemId, start, end, total } = price(request);
+      return { itemId, start, end, total };
+    },
+
+    book(request) {
+      const priced = price(request);
+      const taken = bookings.some(
+        (b) => b.itemId === priced.itemId && b.startTime < priced.endTime && priced.startTime < b.endTime,
+      );
+      if (taken) {
+        throw new Error(`${priced.itemId} is not free for the whole period`);
+      }
+      const booking = {
+        id: `booking-${bookings.length + 1}`,
+        itemId: priced.itemId,
+        start: priced.start,
+        end: priced.end,
+        total: priced.total,
+      };
+      bookings.push({ itemId: priced.itemId, startTime: priced.startTime, endTime: priced.endTime });
+      return booking;
+    },
+  };
+}
