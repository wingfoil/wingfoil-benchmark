+
+test('quote prices a rental shorter than a day at the hourly price per hour', () => {
+  const service = serviceWithHourlyBoard();
+  assert.deepEqual(
+    service.quote({ itemId: 'board-1', start: '2026-07-01T14:00:00Z', end: '2026-07-01T17:00:00Z' }),
+    { itemId: 'board-1', start: '2026-07-01T14:00:00.000Z', end: '2026-07-01T17:00:00.000Z', total: 3600 },
+  );
