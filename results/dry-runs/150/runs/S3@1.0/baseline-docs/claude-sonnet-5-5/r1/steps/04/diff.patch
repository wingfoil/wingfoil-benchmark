+
+function serviceWithHourlyBoard() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 4500, hourlyPrice: 1200 });
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 4500 });
+  return service;
