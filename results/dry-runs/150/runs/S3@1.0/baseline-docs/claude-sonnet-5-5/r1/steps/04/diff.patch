+  assert.equal(service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-01T23:00:00Z' }).total, 27600);
+});
+
+test('whole days are still priced at the daily price when an hourly price exists', () => {
+  const service = serviceWithHourlyBoard();
+  assert.equal(service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }).total, 4500);
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  const service = serviceWithHourlyBoard();
+  const request = { itemId: 'board-2', start: '2026-07-01T14:00:00Z', end: '2026-07-01T17:00:00Z' };
+  assert.throws(() => service.quote(request));
+  assert.throws(() => service.book(request));
+});
+
+test('hourly periods must be on the hour and shorter than a day unless whole days', () => {
+  const service = serviceWithHourlyBoard();
+  for (const [start, end] of [
+    ['2026-07-01T14:30:00Z', '2026-07-01T17:00:00Z'],
+    ['2026-07-01T14:00:00Z', '2026-07-01T17:15:00Z'],
+    ['2026-07-01T14:00:00Z', '2026-07-02T14:00:00Z'],
+    ['2026-07-01T14:00:00Z', '2026-07-03T00:00:00Z'],
+    ['2026-07-01T17:00:00Z', '2026-07-01T14:00:00Z'],
+    ['2026-07-01T14:00:00Z', '2026-07-01T14:00:00Z'],
+  ]) {
+    assert.throws(() => service.quote({ itemId: 'board-1', start, end }), undefined, `${start} -> ${end}`);
+  }
+});
+
+test('hourly bookings conflict only when the hours overlap', () => {
+  const service = serviceWithHourlyBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-01T14:00:00Z', end: '2026-07-01T17:00:00Z' });
+  assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-01T16:00:00Z', end: '2026-07-01T18:00:00Z' }));
+  assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.equal(
+    service.book({ itemId: 'board-1', start: '2026-07-01T17:00:00Z', end: '2026-07-01T18:00:00Z' }).total,
+    1200,
+  );
+});
+
+test('availability by the hour lists only items that can be rented by the hour and are free', () => {
+  const service = serviceWithHourlyBoard();
+  const query = { start: '2026-07-01T14:00:00Z', end: '2026-07-01T17:00:00Z' };
+  assert.deepEqual(service.availability(query), ['board-1']);
+  service.book({ itemId: 'board-1', start: '2026-07-01T15:00:00Z', end: '2026-07-01T16:00:00Z' });
+  assert.deepEqual(service.availability(query), []);
+});
+
+test('addEquipment validates the hourly price', () => {
+  const service = createRentalService();
+  for (const hourlyPrice of [12.5, -1, Number.NaN, '10' as unknown as number]) {
+    assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice }));
+  }
+  service.addEquipment({ id: 'free', kind: 'board', dailyPrice: 100, hourlyPrice: 0 });
+  assert.equal(service.quote({ itemId: 'free', start: '2026-07-01T14:00:00Z', end: '2026-07-01T15:00:00Z' }).total, 0);
+});
