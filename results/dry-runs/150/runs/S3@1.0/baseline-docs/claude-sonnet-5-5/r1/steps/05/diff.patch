diff --git a/src/index.test.ts b/src/index.test.ts
index cd0e78eabeb7805ff4369fcc01ea44e42101c8e7..a7451ef95f068a451d711a837aa8eb8f7ed22db2 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -222,3 +222,46 @@ test('addEquipment validates the hourly price', () => {
   service.addEquipment({ id: 'free', kind: 'board', dailyPrice: 100, hourlyPrice: 0 });
   assert.equal(service.quote({ itemId: 'free', start: '2026-07-01T14:00:00Z', end: '2026-07-01T15:00:00Z' }).total, 0);
 });
+
+function serviceWithBooking() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1000 });
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-10T00:00:00Z', end: '2026-07-12T00:00:00Z' });
+  return { service, booking };
+}
+
+test('cancelling at least 24 hours before the start refunds the full total', () => {
+  const { service, booking } = serviceWithBooking();
+  assert.deepEqual(service.cancel(booking.id, '2026-07-09T00:00:00Z'), { bookingId: booking.id, refund: 2000 });
+});
+
+test('cancelling under 24 hours before the start, or after it, refunds nothing', () => {
+  for (const at of ['2026-07-09T00:00:01Z', '2026-07-10T00:00:00Z', '2026-07-11T00:00:00Z']) {
+    const { service, booking } = serviceWithBooking();
+    assert.equal(service.cancel(booking.id, at).refund, 0, at);
+  }
+});
+
+test('a cancelled booking frees its equipment', () => {
+  const { service, booking } = serviceWithBooking();
+  const query = { start: '2026-07-10T00:00:00Z', end: '2026-07-11T00:00:00Z' };
+  assert.deepEqual(service.availability(query), []);
+  service.cancel(booking.id, '2026-07-01T00:00:00Z');
+  assert.deepEqual(service.availability(query), ['board-1']);
+  assert.equal(service.book({ itemId: 'board-1', start: query.start, end: query.end }).total, 1000);
+});
+
+test('a booking can only be cancelled once', () => {
+  const { service, booking } = serviceWithBooking();
+  service.cancel(booking.id, '2026-07-01T00:00:00Z');
+  assert.throws(() => service.cancel(booking.id, '2026-07-01T00:00:00Z'));
+});
+
+test('cancel rejects an unknown booking or an invalid time and leaves the booking active', () => {
+  const { service, booking } = serviceWithBooking();
+  assert.throws(() => service.cancel('booking-99', '2026-07-01T00:00:00Z'));
+  for (const at of ['yesterday', '2026-07-01', '2026-02-30T00:00:00Z', undefined as unknown as string]) {
+    assert.throws(() => service.cancel(booking.id, at));
+  }
+  assert.equal(service.cancel(booking.id, '2026-07-01T00:00:00Z').refund, 2000);
+});
