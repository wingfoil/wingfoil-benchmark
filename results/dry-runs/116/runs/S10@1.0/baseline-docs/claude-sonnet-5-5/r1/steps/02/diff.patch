diff --git a/test/shop.test.ts b/test/shop.test.ts
index ffbc8b27071a0750eeaf079234c089a442137b21..d96e937d18b9165b5d94cf82d44e121215f84cd0 100644
--- a/test/shop.test.ts
+++ b/test/shop.test.ts
@@ -85,3 +85,34 @@ describe('order book', () => {
     assert.equal(formatEuros(5), '0.05');
   });
 });
+
+describe('monthly export', () => {
+  const HEADER = 'order,date,customer,email,phone,total';
+
+  it('lists the orders of a month by number with what each customer pays', () => {
+    const shop = stocked();
+    shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'APL-1KG', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-10-03', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    shop.orders.applyCode(3, 'SPRING10');
+    assert.equal(
+      shop.orders.exportMonth('2026-10'),
+      [HEADER, '2,2026-10-02,Mira Holt,mira@example.org,555-0101,17.80', '3,2026-10-03,Mira Holt,mira@example.org,555-0101,57.60'].join('\n'),
+    );
+  });
+
+  it('gives the header alone for a month without orders', () => {
+    assert.equal(stocked().orders.exportMonth('2026-11'), HEADER);
+  });
+
+  it('quotes values holding a comma or a quote', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, "Bo"', email: 'bo@example.org', phone: '555-0102' }));
+    shop.orders.place({ customerId: 'c2', date: '2026-10-05', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    assert.equal(shop.orders.exportMonth('2026-10').split('\n')[1], '1,2026-10-05,"Holt, ""Bo""",bo@example.org,555-0102,64.00');
+  });
+
+  it('refuses a month that is not YYYY-MM', () => {
+    assert.throws(() => stocked().orders.exportMonth('2026-13'), RangeError);
+  });
+});
