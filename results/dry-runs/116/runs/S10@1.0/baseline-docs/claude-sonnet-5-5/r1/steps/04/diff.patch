+## Review status of the free-shipping fix
+
+Orders were charged shipping when their items came to exactly 50.00 €, and quantities were not counted towards the
+50.00 € (`shippingFor` summed unit prices only and used `>`). It now sums price × quantity and ships free from 50.00 €
+(`>=`). Status: **fix committed, submitted for approval, awaiting Dana Okafor's verdict**. No verdict is recorded, and
+the version in `package.json` and `CHANGELOG.md` is not raised until she approves; the fix is not released yet.
diff --git a/src/domain/shipping.ts b/src/domain/shipping.ts
index 5c8587fb45c4e5067317ac7db327b8d47df73cd3..d5ba330a43444f0c4ad1667982f61b7b3304a965 100644
--- a/src/domain/shipping.ts
+++ b/src/domain/shipping.ts
@@ -18,6 +18,6 @@ export interface PricedLine {
  * @param lines - the order's lines, priced
  */
 export function shippingFor(lines: readonly PricedLine[]): Cents {
-  const value = lines.reduce((sum, line) => sum + line.unitPriceCents, 0);
-  return value > FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
+  const value = lines.reduce((sum, line) => sum + line.unitPriceCents * line.quantity, 0);
+  return value >=FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
 }
