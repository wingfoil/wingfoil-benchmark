+describe('input validation', () => {
+  const code = (result: { ok: boolean; error?: { code: string } }) => (result.ok ? 'ok' : result.error?.code);
+
+  it('rejects empty, blank and too long titles on add', () => {
+    const list = createTodoList();
+    assert.equal(code(list.add({ title: '' })), 'invalid-input');
+    assert.equal(code(list.add({ title: '   ' })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'x'.repeat(121) })), 'invalid-input');
+    assert.equal(list.list().length, 0);
+    assert.equal(code(list.add({ title: 'x'.repeat(120) })), 'ok');
+  });
+
+  it('rejects an unknown priority on add', () => {
+    const list = createTodoList();
+    assert.equal(code(list.add({ title: 'A', priority: 'urgent' as never })), 'invalid-input');
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a bad tag on add and consumes no id', () => {
+    const list = createTodoList();
+    assert.equal(code(list.add({ title: 'A', tags: ['ok', 'not ok'] })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'A', tags: [''] })), 'invalid-input');
+    assert.equal(list.list().length, 0);
+    assert.equal(valueOf(list.add({ title: 'A' })).id, 'task-1');
+  });
+
+  it('rejects a bad new title on rename and leaves the task alone', () => {
+    const list = createTodoList(() => '2026-01-01T00:00:00.000Z');
+    const task = valueOf(list.add({ title: 'A' }));
+    assert.equal(code(list.rename('A', '  ')), 'invalid-input');
+    assert.equal(code(list.rename('A', 'y'.repeat(121))), 'invalid-input');
+    assert.deepEqual(valueOf(list.get(task.id)), task);
+  });
+
+  it('rejects a bad tag on tag and leaves the task alone', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'A' }));
+    assert.equal(code(list.tag('A', '')), 'invalid-input');
+    assert.equal(code(list.tag('A', 'a b')), 'invalid-input');
+    assert.deepEqual(valueOf(list.get(task.id)), task);
+  });
+});
