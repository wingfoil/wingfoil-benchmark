diff --git a/src/index.ts b/src/index.ts
index c115005734f806de2b80445c94be666a7dd7923e..7d8e509df2c03389e10f565a48ceb2cb3e1d53a2 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -266,3 +266,90 @@ function mergeValue(target: Json, patch: Json): Json {
 export function applyMergePatch(target: unknown, patch: unknown): unknown {
   return mergeValue(target, patch);
 }
+
+/**
+ * Patch creation: the inverse of applyPatch (JSON Patch, RFC 6902; pointers per RFC 6901 section 3).
+ */
+
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: Json };
+
+/** Escapes a reference token (RFC 6901 section 3): "~" first, then "/". */
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Longest common subsequence of two arrays, as matched index pairs (items compared by jsonEqual). */
+function matchItems(a: Json[], b: Json[]): Array<[number, number]> {
+  const lengths: number[][] = Array.from({ length: a.length + 1 }, () => new Array(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lengths[i][j] = jsonEqual(a[i], b[j]) ? lengths[i + 1][j + 1] + 1 : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  const pairs: Array<[number, number]> = [];
+  let i = 0;
+  let j = 0;
+  while (i < a.length && j < b.length) {
+    if (jsonEqual(a[i], b[j])) pairs.push([i++, j++]);
+    else if (lengths[i + 1][j] >= lengths[i][j + 1]) i++;
+    else j++;
+  }
+  return pairs;
+}
+
+function diffValue(from: Json, to: Json, path: string, ops: Operation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(from, key)) diffValue(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: structuredClone(to[key]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+function diffArray(from: Json[], to: Json[], path: string, ops: Operation[]): void {
+  // Unchanged items are matched; between two matches, the differing items are edited in place
+  // pairwise, and the surplus is removed or added. Positions refer to the array as patched so far.
+  const matches = matchItems(from, to);
+  matches.push([from.length, to.length]);
+  let fromPos = 0;
+  let toPos = 0;
+  for (const [fromEnd, toEnd] of matches) {
+    const removed = fromEnd - fromPos;
+    const added = toEnd - toPos;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) diffValue(from[fromPos + k], to[toPos + k], `${path}/${toPos + k}`, ops);
+    for (let k = paired; k < removed; k++) ops.push({ op: "remove", path: `${path}/${toPos + paired}` });
+    for (let k = paired; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${toPos + k}`, value: structuredClone(to[toPos + k]) });
+    }
+    fromPos = fromEnd + 1;
+    toPos = toEnd + 1;
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with applyPatch.
+ *
+ * The patch is minimal in granularity, not guaranteed minimal in size: objects are compared
+ * member by member and arrays item by item, so a one-place change yields a one-operation patch.
+ * An item inserted into or removed from an array yields one "add" or "remove" without touching
+ * its neighbours; a moved item yields a "remove" and an "add" (no "move" or "copy" is emitted).
+ * Only "add", "remove" and "replace" are used; equal documents give an empty patch, and
+ * documents of different types give a single "replace" of the root (path ""). Object member
+ * order is irrelevant (section 4.6). Neither input is mutated and the patch shares no
+ * structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const ops: Operation[] = [];
+  diffValue(from, to, "", ops);
+  return ops;
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..50e320e718a4380849761a2736f3b1735a289aed
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,82 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown) {
+  const before = structuredClone(from);
+  const target = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, before, "from not mutated");
+  assert.deepEqual(to, target, "to not mutated");
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch; member order is irrelevant (RFC 6902 4.6)", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: [1, { c: null }] }, { b: [1, { c: null }], a: 1 }), []);
+  assert.deepEqual(roundTrip(1, 1), []);
+});
+
+test("one small change is one operation, deep in the document", () => {
+  const from = { a: { b: [1, { c: 1, d: 2 }], e: "x" }, f: [1, 2, 3] };
+  const to = { a: { b: [1, { c: 1, d: 3 }], e: "x" }, f: [1, 2, 3] };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/1/d", value: 3 }]);
+});
+
+test("object members: add, remove, null values (RFC 6902 4.1-4.3)", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, { a: 1, b: null }), [{ op: "add", path: "/b", value: null }]);
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1 }), [{ op: "remove", path: "/b" }]);
+  assert.deepEqual(roundTrip({ a: null }, { a: 0 }), [{ op: "replace", path: "/a", value: 0 }]);
+});
+
+test("root replacement when types differ or for scalars", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip(null, {}), [{ op: "replace", path: "", value: {} }]);
+  assert.deepEqual(roundTrip({ a: [] }, { a: {} }), [{ op: "replace", path: "/a", value: {} }]);
+});
+
+test("pointer escaping of keys (RFC 6901 section 3)", () => {
+  const patch = roundTrip({ "a/b": 1, "m~n": 1, "": 1 }, { "a/b": 2, "m~n": 2, "": 2 });
+  assert.deepEqual(patch.map((o) => o.path).sort(), ["/", "/a~1b", "/m~0n"]);
+});
+
+test("hostile keys such as __proto__ are handled safely", () => {
+  const from = JSON.parse('{"__proto__": {"x": 1}, "a": 1}');
+  const to = JSON.parse('{"__proto__": {"x": 2}, "a": 1, "constructor": 1}');
+  const patch = roundTrip(from, to);
+  assert.deepEqual(patch.map((o) => o.path).sort(), ["/__proto__/x", "/constructor"]);
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+});
+
+test("array insert and remove touch only that item", () => {
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 9, 2, 3]), [{ op: "add", path: "/1", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(roundTrip([], [1]), [{ op: "add", path: "/0", value: 1 }]);
+  assert.deepEqual(roundTrip([{ a: 1 }, { b: 2 }], [{ b: 2 }]), [{ op: "remove", path: "/0" }]);
+});
+
+test("array item move does not rewrite the items in between", () => {
+  const from = [1, 2, 3, 4, 5];
+  const patch = roundTrip(from, [1, 3, 4, 2, 5]);
+  assert.ok(patch.length <= 2);
+  for (const op of patch) assert.ok(["move", "add", "remove"].includes(op.op));
+  roundTrip([{ id: 1 }, { id: 2 }, { id: 3 }], [{ id: 3 }, { id: 1 }, { id: 2 }]);
+});
+
+test("array item edited in place, nested arrays", () => {
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 5, 3]), [{ op: "replace", path: "/1", value: 5 }]);
+  assert.deepEqual(roundTrip([[1], [2]], [[1], [2, 3]]), [{ op: "add", path: "/1/1", value: 3 }]);
+});
+
+test("mixed changes round trip", () => {
+  roundTrip([1, 2, 3, 4, 5, 6], [6, 1, 7, 8, 4]);
+  roundTrip({ a: [1, 2, { x: [1, 2] }, 3], b: 1 }, { a: [0, 2, { x: [2, 1, 3] }], c: 1 });
+});
+
+test("patch shares no structure with the inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0].value as { b: number }).b = 99;
+  assert.equal(to.a.b, 1);
+});
