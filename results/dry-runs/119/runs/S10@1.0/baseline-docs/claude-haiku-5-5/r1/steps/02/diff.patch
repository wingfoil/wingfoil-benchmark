+
+describe('monthly export', () => {
+  function placeOn(shop: ReturnType<typeof createShop>, customerId: string, date: string, sku: string): number {
+    return valueOf(shop.orders.place({ customerId, date, lines: [{ sku, quantity: 1 }] })).number;
+  }
+
+  it('gives the header line alone for a month with no orders', () => {
+    const shop = stocked();
+    placeOn(shop, 'c1', '2026-09-30', 'OIL-1L');
+    assert.equal(valueOf(shop.orders.exportMonth('2026-10')), 'order,date,customer,total\r\n');
+  });
+
+  it('lists the orders placed in the month by number, with what each customer pays', () => {
+    const shop = stocked();
+    placeOn(shop, 'c1', '2026-10-02', 'OIL-1L');
+    placeOn(shop, 'c1', '2026-09-30', 'OIL-1L');
+    placeOn(shop, 'c1', '2026-11-01', 'OIL-1L');
+    const discounted = placeOn(shop, 'c1', '2026-10-30', 'BRD-LOAF');
+    valueOf(shop.orders.applyCode(discounted, 'SPRING10'));
+    assert.equal(
+      valueOf(shop.orders.exportMonth('2026-10')),
+      [
+        'order,date,customer,total',
+        '1,2026-10-02,Mira Holt,17.80',
+        '4,2026-10-30,Mira Holt,31.90',
+        '',
+      ].join('\r\n'),
+    );
+  });
+
+  it('quotes a value that contains a comma or a quote', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Lee, "Sam"', email: 'sam@example.org', phone: '' }));
+    placeOn(shop, 'c2', '2026-10-05', 'APL-1KG');
+    assert.equal(
+      valueOf(shop.orders.exportMonth('2026-10')),
+      'order,date,customer,total\r\n1,2026-10-05,"Lee, ""Sam""",8.39\r\n',
+    );
+  });
+
+  it('leaves out the email and phone of the customer', () => {
+    const shop = stocked();
+    placeOn(shop, 'c1', '2026-10-02', 'OIL-1L');
+    const csv = valueOf(shop.orders.exportMonth('2026-10'));
+    assert.doesNotMatch(csv, /mira@example\.org|555-0101/);
+  });
+
+  it('refuses a month that is not YYYY-MM', () => {
+    const shop = stocked();
+    for (const month of ['2026-13', '2026-1', '26-10', '2026-10-01', 'October']) {
+      const result = shop.orders.exportMonth(month);
+      assert.equal(result.ok, false, month);
+      if (result.ok) continue;
+      assert.equal(result.error.code, 'invalid');
+    }
+  });
+});
