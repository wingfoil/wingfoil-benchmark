+
+describe('discount codes', () => {
+  it('takes ten percent off the items with SPRING10, and keeps the shipping', () => {
+    const shop = stocked();
+    const number = placeOne(shop, 'OIL-1L');
+    const order = valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.equal(order.discountCode, 'SPRING10');
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 1290, discountCents: 129, shippingCents: 490, totalCents: 1651 });
+  });
+
+  it('rounds the SPRING10 discount half a cent up', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'TEA-25', name: 'Tea, 25 bags', priceCents: 1295 }));
+    const number = placeOne(shop, 'TEA-25');
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 130);
+  });
+
+  it('takes 5.00 € off an order of 30.00 € or more with WELCOME5', () => {
+    const shop = stocked();
+    const number = placeOne(shop, 'BRD-LOAF');
+    valueOf(shop.orders.applyCode(number, 'WELCOME5'));
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 3000, discountCents: 500, shippingCents: 490, totalCents: 2990 });
+  });
+
+  it('refuses WELCOME5 on an order under 30.00 € and leaves the order as it was', () => {
+    const shop = stocked();
+    const number = placeOne(shop, 'APL-1KG', 8);
+    const result = shop.orders.applyCode(number, 'WELCOME5');
+    assert.equal(result.ok, false);
+    if (result.ok) return;
+    assert.equal(result.error.code, 'invalid');
+    assert.match(result.error.message, /WELCOME5.*30\.00 €/);
+    assert.equal(valueOf(shop.orders.get(number)).discountCode, undefined);
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 0);
+  });
+
+  it('refuses an unknown code and leaves the order as it was', () => {
+    const shop = stocked();
+    const number = placeOne(shop, 'OIL-1L');
+    const result = shop.orders.applyCode(number, 'FREESTUFF');
+    assert.equal(result.ok, false);
+    if (result.ok) return;
+    assert.equal(result.error.code, 'not-found');
+    assert.match(result.error.message, /FREESTUFF/);
+    assert.equal(valueOf(shop.orders.get(number)).discountCode, undefined);
+  });
+
+  it('lets a second code replace the first', () => {
+    const shop = stocked();
+    const number = placeOne(shop, 'HAM-W');
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    valueOf(shop.orders.applyCode(number, 'WELCOME5'));
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 500);
+  });
+
+  it('keeps the code already applied when a second code is refused', () => {
+    const shop = stocked();
+    const number = placeOne(shop, 'OIL-1L');
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.equal(shop.orders.applyCode(number, 'WELCOME5').ok, false);
+    assert.equal(valueOf(shop.orders.get(number)).discountCode, 'SPRING10');
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 129);
+  });
+
+  it('decides free shipping on the items before the discount', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'CHE-BRD', name: 'Cheese board', priceCents: 5100 }));
+    const number = placeOne(shop, 'CHE-BRD');
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 5100, discountCents: 510, shippingCents: 0, totalCents: 4590 });
+  });
+
+  it('refuses a code for an order that does not exist', () => {
