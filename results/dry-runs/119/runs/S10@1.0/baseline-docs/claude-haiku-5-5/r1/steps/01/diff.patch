+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** The least items an order must have for WELCOME5 to apply. */
+export const WELCOME5_MIN_ITEMS_CENTS: Cents = 3000;
+
+/** What WELCOME5 takes off an order. */
+const WELCOME5_CENTS: Cents = 500;
+
+/**
+ * What a discount code takes off an order's items. SPRING10 takes ten percent, rounded to the nearest cent with
+ * half a cent rounding up; WELCOME5 takes 5.00 € off an order of 30.00 € or more.
+ *
+ * @param code - the code as the customer entered it
+ * @param itemsCents - the order's items, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  switch (code) {
+    case 'SPRING10':
+      return ok(Math.floor((itemsCents * 10 + 50) / 100));
+    case 'WELCOME5':
+      if (itemsCents < WELCOME5_MIN_ITEMS_CENTS) {
+        return err('invalid', `WELCOME5 needs items of ${formatEuros(WELCOME5_MIN_ITEMS_CENTS)} € or more`);
+      }
+      return ok(WELCOME5_CENTS);
+    default:
+      return err('not-found', `no discount code ${code}`);
+  }
+}
