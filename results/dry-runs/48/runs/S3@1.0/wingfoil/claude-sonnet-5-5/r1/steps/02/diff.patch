   if (endMs <= startMs) {
@@ -64,13 +73,17 @@ function overlaps(a: Period, b: Period): boolean {
   return a.startMs < b.endMs && b.startMs < a.endMs;
 }
 
+function validateKind(kind: unknown): void {
+  if (kind !== 'board' && kind !== 'sail') {
+    throw new Error(`equipment kind must be 'board' or 'sail', got ${String(kind)}`);
+  }
+}
+
 function validateEquipment(item: Equipment): void {
   if (typeof item.id !== 'string' || item.id === '') {
     throw new Error('equipment id must be a non-empty string');
   }
-  if (item.kind !== 'board' && item.kind !== 'sail') {
