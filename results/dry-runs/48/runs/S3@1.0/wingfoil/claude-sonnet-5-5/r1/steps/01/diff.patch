@@ -0,0 +1,90 @@
+import assert from 'node:assert/strict';
+import { beforeEach, describe, it } from 'node:test';
+import { createRentalService } from '../src/index.ts';
+
+describe('rental service', () => {
+  let service: ReturnType<typeof createRentalService>;
+
+  beforeEach(() => {
+    service = createRentalService();
+    service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1200 });
+  });
+
+  const request = (itemId: string, start: string, end: string) => ({ itemId, start, end });
+
+  it('quotes the daily price times the number of days, in cents', () => {
+    const quote = service.quote(request('board-1', '2026-07-01T00:00:00.000Z', '2026-07-04T00:00:00.000Z'));
+    assert.deepEqual(quote, {
+      itemId: 'board-1',
+      start: '2026-07-01T00:00:00.000Z',
+      end: '2026-07-04T00:00:00.000Z',
+      total: 7500,
+    });
+  });
+
+  it('accepts ISO strings without milliseconds', () => {
+    const quote = service.quote(request('sail-1', '2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z'));
+    assert.equal(quote.total, 1200);
+  });
+
+  it('rejects an unknown item', () => {
+    assert.throws(() => service.quote(request('nope', '2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z')));
+    assert.throws(() => service.book(request('nope', '2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z')));
+  });
+
+  it('rejects periods that are not whole UTC days', () => {
+    assert.throws(() => service.quote(request('board-1', '2026-07-01T10:00:00Z', '2026-07-02T00:00:00Z')));
+    assert.throws(() => service.quote(request('board-1', '2026-07-01T00:00:00Z', '2026-07-02T12:00:00Z')));
+    assert.throws(() => service.quote(request('board-1', '2026-07-01T00:00:00+02:00', '2026-07-02T00:00:00Z')));
+    assert.throws(() => service.quote(request('board-1', '2026-07-01', '2026-07-02')));
+    assert.throws(() => service.quote(request('board-1', 'garbage', '2026-07-02T00:00:00Z')));
+  });
+
+  it('rejects empty or reversed periods', () => {
+    assert.throws(() => service.quote(request('board-1', '2026-07-02T00:00:00Z', '2026-07-02T00:00:00Z')));
+    assert.throws(() => service.quote(request('board-1', '2026-07-03T00:00:00Z', '2026-07-02T00:00:00Z')));
+  });
+
+  it('books and returns an identified booking with the quoted total', () => {
+    const booking = service.book(request('board-1', '2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+    assert.equal(booking.total, 5000);
+    assert.equal(booking.itemId, 'board-1');
+    assert.equal(typeof booking.id, 'string');
+    const other = service.book(request('sail-1', '2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+    assert.notEqual(other.id, booking.id);
+  });
+
+  it('refuses overlapping bookings of the same item', () => {
+    service.book(request('board-1', '2026-07-05T00:00:00Z', '2026-07-08T00:00:00Z'));
+    for (const [start, end] of [
+      ['2026-07-05T00:00:00Z', '2026-07-08T00:00:00Z'],
+      ['2026-07-03T00:00:00Z', '2026-07-06T00:00:00Z'],
+      ['2026-07-07T00:00:00Z', '2026-07-10T00:00:00Z'],
+      ['2026-07-06T00:00:00Z', '2026-07-07T00:00:00Z'],
+      ['2026-07-01T00:00:00Z', '2026-07-20T00:00:00Z'],
+    ]) {
+      assert.throws(() => service.book(request('board-1', start, end)), `${start}..${end}`);
+    }
+  });
+
+  it('allows adjacent periods and other items', () => {
+    service.book(request('board-1', '2026-07-05T00:00:00Z', '2026-07-08T00:00:00Z'));
+    service.book(request('board-1', '2026-07-08T00:00:00Z', '2026-07-09T00:00:00Z'));
+    service.book(request('board-1', '2026-07-04T00:00:00Z', '2026-07-05T00:00:00Z'));
+    service.book(request('sail-1', '2026-07-05T00:00:00Z', '2026-07-08T00:00:00Z'));
+  });
+
+  it('does not book when the request is invalid', () => {
+    assert.throws(() => service.book(request('board-1', '2026-07-05T10:00:00Z', '2026-07-08T00:00:00Z')));
+    service.book(request('board-1', '2026-07-05T00:00:00Z', '2026-07-08T00:00:00Z'));
+  });
+
+  it('rejects invalid equipment', () => {
+    assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 100 }));
+    assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
+    assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
+    assert.throws(() => service.addEquipment({ id: '', kind: 'board', dailyPrice: 100 }));
+    assert.throws(() => service.addEquipment({ id: 'x', kind: 'kite' as 'board', dailyPrice: 100 }));
+  });
+});
