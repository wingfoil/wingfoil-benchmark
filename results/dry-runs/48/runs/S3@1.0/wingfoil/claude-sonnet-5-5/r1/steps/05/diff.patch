-      return { id: `booking-${bookingCount}`, ...quote };
+      const booking = { id: `booking-${bookingCount}`, ...quote };
+      bookings.set(booking.id, { booking, period, cancelled: false });
+      return booking;
+    },
+
+    cancel(bookingId, at) {
+      const entry = bookings.get(bookingId);
+      if (!entry) {
+        throw new Error(`unknown booking ${String(bookingId)}`);
+      }
+      if (entry.cancelled) {
+        throw new Error(`booking ${bookingId} is already cancelled`);
+      }
+      const atMs = typeof at === 'string' && UTC_ISO.test(at) ? Date.parse(at) : NaN;
+      if (Number.isNaN(atMs)) {
+        throw new Error(`at must be an ISO-8601 UTC string, got ${String(at)}`);
+      }
+      if (atMs >= entry.period.endMs) {
+        throw new Error(`booking ${bookingId} has already ended`);
+      }
+      entry.cancelled = true;
+      const taken = periodsByItem.get(entry.booking.itemId) ?? [];
+      taken.splice(taken.indexOf(entry.period), 1);
+      return { bookingId, refund: refundFor(entry.booking.total, entry.period.startMs - atMs) };
     },
 
     availability(query) {
