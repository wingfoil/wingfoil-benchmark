 }
 
+/** Refund by notice before the start: all from 48 hours, half (rounded down) from 24 hours, else nothing. */
+function refundFor(total: number, noticeMs: number): number {
+  if (noticeMs >= FULL_REFUND_NOTICE_MS) {
+    return total;
+  }
+  return noticeMs >= HALF_REFUND_NOTICE_MS ? Math.floor(total / 2) : 0;
+}
