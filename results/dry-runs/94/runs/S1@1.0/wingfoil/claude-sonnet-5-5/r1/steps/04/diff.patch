   return doc;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document.
+ *
+ * @param target the JSON document to patch; it is never mutated.
+ * @param patch the merge patch: a non-object replaces the target, an object merges member by member
+ *   (`null` removes a member, nested objects merge recursively, arrays replace wholesale).
+ * @returns the merged document, as a new value sharing no structure with the inputs.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (typeof patch !== "object" || patch === null || Array.isArray(patch)) return clone(patch);
+  const isObject = typeof target === "object" && target !== null && !Array.isArray(target);
+  const result = (isObject ? clone(target) : {}) as Record<string, unknown>;
+  const members = patch as Record<string, unknown>;
+  for (const key of Object.keys(members)) {
+    const value = members[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = hasOwn(result, key) ? result[key] : undefined;
+      setMember(result, key, applyMergePatch(current, value));
+    }
+  }
+  return result;
+}
