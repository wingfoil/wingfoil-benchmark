--- a/src/index.ts
+++ b/src/index.ts
@@ -54,3 +54,161 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+/** Parses a JSON Pointer into its decoded reference tokens ([] for the whole document). */
+function parsePointer(pointer: unknown, what: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error(`Invalid JSON Patch: "${what}" must be a string`);
+  }
+  if (pointer === "") return [];
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`);
+  }
+  return pointer.slice(1).split("/").map(decodeToken);
+}
+
+const hasOwn = (o: object, key: string): boolean => Object.prototype.hasOwnProperty.call(o, key);
+
+/** Sets an own member, even for names such as `__proto__`, which must not touch the prototype. */
+function setMember(target: object, key: string, value: unknown): void {
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Deep copy of a JSON value. */
+function clone(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(clone);
+  if (typeof value === "object" && value !== null) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(copy, key, clone((value as Record<string, unknown>)[key]));
+    return copy;
+  }
+  return value;
+}
+
+/** Deep JSON equality (RFC 6902 §4.6): object member order is irrelevant, array order matters. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (typeof a === "object" && a !== null && typeof b === "object" && b !== null) {
+    const keysA = Object.keys(a);
+    return (
+      keysA.length === Object.keys(b).length &&
+      keysA.every(
+        (k) => hasOwn(b, k) && jsonEqual((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]),
+      )
+    );
+  }
+  return a === b;
+}
+
+/** Walks to the container holding the last token of a non-empty path. */
+function parentOf(doc: unknown, tokens: string[], path: string): unknown {
+  let current = doc;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current) && ARRAY_INDEX.test(token) && Number(token) < current.length) {
+      current = current[Number(token)];
+    } else if (
+      typeof current === "object" && current !== null && !Array.isArray(current) && hasOwn(current, token)
+    ) {
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Patch path "${path}" does not resolve at "${token}"`);
+    }
+  }
+  if (typeof current !== "object" || current === null) {
+    throw new Error(`JSON Patch path "${path}" does not resolve: parent is not a container`);
+  }
+  return current;
+}
+
+function getAt(doc: unknown, path: string): unknown {
+  return resolvePointer(doc, path);
+}
+
+function addAt(doc: unknown, path: string, value: unknown): unknown {
+  const tokens = parsePointer(path, "path");
+  if (tokens.length === 0) return value;
+  const parent = parentOf(doc, tokens, path);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (last === "-") parent.push(value);
+    else if (ARRAY_INDEX.test(last) && Number(last) <= parent.length) parent.splice(Number(last), 0, value);
+    else throw new Error(`JSON Patch add: invalid array index "${last}" in "${path}"`);
+  } else {
+    setMember(parent, last, value);
+  }
+  return doc;
+}
+
+function removeAt(doc: unknown, path: string): unknown {
+  const tokens = parsePointer(path, "path");
+  if (tokens.length === 0) throw new Error("JSON Patch: cannot remove the whole document");
+  getAt(doc, path); // must exist
+  const parent = parentOf(doc, tokens, path);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete (parent as Record<string, unknown>)[last];
+  return doc;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document.
+ *
+ * @param document the JSON document to patch; it is never mutated.
+ * @param patch an array of operations (`add`, `remove`, `replace`, `move`, `copy`, `test`), applied in order.
+ * @returns the patched document, as a new value sharing no structure with the inputs.
+ * @throws Error when `patch` is invalid, or when an operation fails (including a failed `test`).
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new Error("Invalid JSON Patch: not an array");
+  let doc = clone(document);
+
+  for (const operation of patch) {
+    if (typeof operation !== "object" || operation === null || Array.isArray(operation)) {
+      throw new Error("Invalid JSON Patch: operation is not an object");
+    }
+    const op = operation as Record<string, unknown>;
+    if (typeof op.op !== "string") throw new Error('Invalid JSON Patch: missing "op"');
+    if (typeof op.path !== "string") throw new Error(`Invalid JSON Patch: "${op.op}" lacks a string "path"`);
+    const path = op.path;
+    parsePointer(path, "path");
+
+    switch (op.op) {
+      case "add":
+      case "replace":
+      case "test": {
+        if (!hasOwn(op, "value")) throw new Error(`Invalid JSON Patch: "${op.op}" lacks "value"`);
+        if (op.op === "add") {
+          doc = addAt(doc, path, clone(op.value));
+        } else if (op.op === "replace") {
+          getAt(doc, path); // must exist
+          doc = parsePointer(path, "path").length === 0 ? clone(op.value) : addAt(removeAt(doc, path), path, clone(op.value));
+        } else if (!jsonEqual(getAt(doc, path), op.value)) {
+          throw new Error(`JSON Patch test failed at "${path}"`);
+        }
+        break;
+      }
+      case "remove":
+        doc = removeAt(doc, path);
+        break;
+      case "move":
+      case "copy": {
+        const from = op.from;
+        parsePointer(from, "from");
+        const source = from as string;
+        const value = getAt(doc, source);
+        if (op.op === "copy") {
+          doc = addAt(doc, path, clone(value));
+        } else if (source !== path) {
+          if (path.startsWith(source + "/")) throw new Error(`JSON Patch move: "${source}" is a parent of "${path}"`);
+          doc = addAt(removeAt(doc, source), path, value);
+        }
+        break;
+      }
+      default:
+        throw new Error(`Invalid JSON Patch: unknown op "${op.op}"`);
+    }
+  }
+  return doc;
+}
