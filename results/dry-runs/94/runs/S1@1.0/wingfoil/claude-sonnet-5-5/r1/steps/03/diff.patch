+/** Replaces the value at an existing, non-root path in place, keeping object member order. */
+function replaceAt(doc: unknown, path: string, value: unknown): void {
+  getAt(doc, path); // must exist
+  const tokens = parsePointer(path, "path");
+  const parent = parentOf(doc, tokens, path);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(last)] = value;
+  else setMember(parent, last, value);
+}
+
+/** Checks the whole patch before any operation is applied (RFC 6902 §3 and §4). */
+function validatePatch(patch: unknown[]): void {
+  for (const operation of patch) {
+    if (typeof operation !== "object" || operation === null || Array.isArray(operation)) {
+      throw new Error("Invalid JSON Patch: operation is not an object");
+    }
+    const op = operation as Record<string, unknown>;
+    if (!hasOwn(op, "op") || typeof op.op !== "string") throw new Error('Invalid JSON Patch: missing "op"');
+    if (!hasOwn(op, "path") || typeof op.path !== "string") {
+      throw new Error(`Invalid JSON Patch: "${op.op}" lacks a string "path"`);
+    }
+    parsePointer(op.path, "path");
+    switch (op.op) {
+      case "add":
+      case "replace":
+      case "test":
+        if (!hasOwn(op, "value")) throw new Error(`Invalid JSON Patch: "${op.op}" lacks "value"`);
+        break;
+      case "remove":
+        break;
+      case "move":
+      case "copy":
+        if (!hasOwn(op, "from")) throw new Error(`Invalid JSON Patch: "${op.op}" lacks "from"`);
+        parsePointer(op.from, "from");
+        break;
+      default:
+        throw new Error(`Invalid JSON Patch: unknown op "${op.op}"`);
+    }
+  }
+}
