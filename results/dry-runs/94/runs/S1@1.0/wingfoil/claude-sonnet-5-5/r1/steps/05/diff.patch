index de1fff2b8ef995491d630a07dcbfbeeba1f093e1..0cee239badcb5b5a384d622b03a14dc66bea81c2 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -279,3 +279,94 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+/** Encodes one object key or array index as a JSON Pointer reference token (RFC 6901 §3). */
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+type PatchOperation = { op: "add" | "remove" | "replace"; path: string; value?: unknown };
+
+const isPlainObject = (v: unknown): v is Record<string, unknown> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+/** Appends to `out` the operations turning `from` into `to`, both found at `path`. */
+function diffInto(from: unknown, to: unknown, path: string, out: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isPlainObject(from) && isPlainObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!hasOwn(to, key)) out.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${encodeToken(key)}`;
+      if (hasOwn(from, key)) diffInto(from[key], to[key], child, out);
+      else out.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+  } else {
+    out.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/** Array diff: shared head and tail are skipped, the rest is aligned on a longest common subsequence. */
+function diffArrays(from: unknown[], to: unknown[], path: string, out: PatchOperation[]): void {
+  let head = 0;
+  while (head < from.length && head < to.length && jsonEqual(from[head], to[head])) head++;
+  let tail = 0;
+  while (
+    tail < from.length - head && tail < to.length - head &&
+    jsonEqual(from[from.length - 1 - tail], to[to.length - 1 - tail])
+  ) tail++;
+  const a = from.slice(head, from.length - tail);
+  const b = to.slice(head, to.length - tail);
+
+  // lcs[i][j]: length of the longest common subsequence of a[i..] and b[j..].
+  const lcs: number[][] = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(a[i], b[j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  let index = head; // position in the array as patched so far
+  let i = 0;
+  let j = 0;
+  while (i < a.length || j < b.length) {
+    if (i < a.length && j < b.length && jsonEqual(a[i], b[j])) {
+      i++; j++; index++;
+      continue;
+    }
+    // A run of removals and insertions up to the next common element.
+    const removed: unknown[] = [];
+    const added: unknown[] = [];
+    while ((i < a.length || j < b.length) && !(i < a.length && j < b.length && jsonEqual(a[i], b[j]))) {
+      if (j >= b.length || (i < a.length && lcs[i + 1][j] >= lcs[i][j + 1])) removed.push(a[i++]);
+      else added.push(b[j++]);
+    }
+    const paired = Math.min(removed.length, added.length);
+    for (let k = 0; k < paired; k++) diffInto(removed[k], added[k], `${path}/${index + k}`, out);
+    index += paired;
+    for (let k = paired; k < removed.length; k++) out.push({ op: "remove", path: `${path}/${index}` });
+    for (let k = paired; k < added.length; k++) {
+      out.push({ op: "add", path: `${path}/${index++}`, value: clone(added[k]) });
+    }
+  }
+}
+
+/**
+ * Computes a JSON Patch (RFC 6902) that turns one JSON document into another.
+ *
+ * Only what changed is described: objects are compared member by member and arrays element by element
+ * (with insertions and removals aligned), so a small difference yields a small patch.
+ *
+ * @param from the original JSON document; it is never mutated.
+ * @param to the target JSON document; it is never mutated.
+ * @returns operations (`add`, `remove`, `replace`) such that `applyPatch(from, patch)` equals `to`;
+ *   empty when the documents are equal. Values in the patch share no structure with the inputs.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diffInto(from, to, "", out);
+  return out;
+}
