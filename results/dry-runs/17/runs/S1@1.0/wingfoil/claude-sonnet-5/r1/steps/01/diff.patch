diff --git a/src/jsonPointer.test.ts b/src/jsonPointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..457be1358f394faa90ecf8accbffdb5001af45dc
--- /dev/null
+++ b/src/jsonPointer.test.ts
@@ -0,0 +1,85 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "./jsonPointer.ts";
+
+const document = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+  nested: { deeper: { value: 42 } },
+};
+
+test("empty pointer resolves to the whole document", () => {
+  assert.equal(resolvePointer(document, ""), document);
+});
+
+test("resolves a top-level property", () => {
+  assert.deepEqual(resolvePointer(document, "/foo"), ["bar", "baz"]);
+});
+
+test("resolves a nested property", () => {
+  assert.equal(resolvePointer(document, "/nested/deeper/value"), 42);
+});
+
+test("resolves an array element by index", () => {
+  assert.equal(resolvePointer(document, "/foo/0"), "bar");
+  assert.equal(resolvePointer(document, "/foo/1"), "baz");
+});
+
+test("unescapes ~1 to / and ~0 to ~, in that order", () => {
+  assert.equal(resolvePointer(document, "/a~1b"), 1);
+  assert.equal(resolvePointer(document, "/m~0n"), 8);
+});
+
+test("resolves the empty-string key", () => {
+  assert.equal(resolvePointer(document, "/"), 0);
+});
+
+test("resolves keys that need no escaping", () => {
+  assert.equal(resolvePointer(document, "/c%d"), 2);
+  assert.equal(resolvePointer(document, "/e^f"), 3);
+  assert.equal(resolvePointer(document, "/g|h"), 4);
+  assert.equal(resolvePointer(document, "/i\\j"), 5);
+  assert.equal(resolvePointer(document, '/k"l'), 6);
+  assert.equal(resolvePointer(document, "/ "), 7);
+});
+
+test("rejects a pointer that is neither empty nor starting with /", () => {
+  assert.throws(() => resolvePointer(document, "foo"), Error);
+});
+
+test("rejects a non-string pointer", () => {
+  // @ts-expect-error exercising runtime validation for non-TS callers
+  assert.throws(() => resolvePointer(document, null), TypeError);
+});
+
+test("rejects a pointer to a missing object property", () => {
+  assert.throws(() => resolvePointer(document, "/missing"), Error);
+});
+
+test("rejects a pointer to an out-of-range array index", () => {
+  assert.throws(() => resolvePointer(document, "/foo/2"), Error);
+});
+
+test("rejects a non-numeric array token", () => {
+  assert.throws(() => resolvePointer(document, "/foo/bar"), Error);
+});
+
+test("rejects a leading-zero array index", () => {
+  assert.throws(() => resolvePointer(document, "/foo/01"), Error);
+});
+
+test("rejects the '-' array token", () => {
+  assert.throws(() => resolvePointer(document, "/foo/-"), Error);
+});
+
+test("rejects stepping into a scalar value", () => {
+  assert.throws(() => resolvePointer(document, "/nested/deeper/value/x"), Error);
+});
diff --git a/src/jsonPointer.ts b/src/jsonPointer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7823e96a7d00545a5dca03bd4d6675bd1a576aaa
--- /dev/null
+++ b/src/jsonPointer.ts
@@ -0,0 +1,55 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @param document - The JSON document to read from.
+ * @param pointer - A JSON Pointer string, e.g. "/foo/0/bar".
+ * @returns The value the pointer refers to.
+ * @throws {Error} If `pointer` is not a valid JSON Pointer, or does not
+ *   resolve to a value within `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new TypeError("JSON Pointer must be a string");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}"`);
+  }
+
+  return pointer
+    .split("/")
+    .slice(1)
+    .map(unescapeToken)
+    .reduce(resolveToken, document);
+}
+
+function unescapeToken(token: string): string {
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function resolveToken(value: unknown, token: string): unknown {
+  if (Array.isArray(value)) {
+    const index = parseArrayIndex(token);
+    if (index === undefined || index >= value.length) {
+      throw new Error(`JSON Pointer does not resolve: no element at index "${token}"`);
+    }
+    return value[index];
+  }
+  if (isJsonObject(value)) {
+    if (!Object.prototype.hasOwnProperty.call(value, token)) {
+      throw new Error(`JSON Pointer does not resolve: no property "${token}"`);
+    }
+    return value[token];
+  }
+  throw new Error(`JSON Pointer does not resolve: cannot step into ${typeof value} with "${token}"`);
+}
+
+function parseArrayIndex(token: string): number | undefined {
+  return /^(?:0|[1-9][0-9]*)$/.test(token) ? Number(token) : undefined;
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
