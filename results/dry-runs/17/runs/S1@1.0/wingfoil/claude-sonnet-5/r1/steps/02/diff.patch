+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "./jsonPatch.ts";
+
+test("add: adds a new member to an object", () => {
+  const document = { foo: "bar" };
+  const result = applyPatch(document, [{ op: "add", path: "/baz", value: "qux" }]);
+  assert.deepEqual(result, { foo: "bar", baz: "qux" });
+});
+
+test("add: inserts an array element at the given index, shifting the rest", () => {
+  const document = { foo: ["bar", "baz"] };
+  const result = applyPatch(document, [{ op: "add", path: "/foo/1", value: "qux" }]);
+  assert.deepEqual(result, { foo: ["bar", "qux", "baz"] });
+});
+
+test("add: appends to an array with the '-' token", () => {
+  const document = { foo: ["bar", "baz"] };
+  const result = applyPatch(document, [{ op: "add", path: "/foo/-", value: "qux" }]);
+  assert.deepEqual(result, { foo: ["bar", "baz", "qux"] });
+});
+
+test("add: an index equal to the array length appends", () => {
+  const document = { foo: ["bar"] };
+  const result = applyPatch(document, [{ op: "add", path: "/foo/1", value: "baz" }]);
+  assert.deepEqual(result, { foo: ["bar", "baz"] });
+});
+
+test("add: replaces an existing array element when adding at its index", () => {
+  const document = { foo: ["bar", "baz"] };
+  const result = applyPatch(document, [{ op: "add", path: "/foo/0", value: "qux" }]);
+  assert.deepEqual(result, { foo: ["qux", "bar", "baz"] });
+});
+
+test("add: creates nested members along an existing path", () => {
+  const document = { foo: { bar: "baz" } };
+  const result = applyPatch(document, [{ op: "add", path: "/foo/child", value: { grandchild: {} } }]);
+  assert.deepEqual(result, { foo: { bar: "baz", child: { grandchild: {} } } });
+});
+
+test("add: at the root path replaces the whole document", () => {
+  const document = { foo: "bar" };
+  const result = applyPatch(document, [{ op: "add", path: "", value: { replaced: true } }]);
+  assert.deepEqual(result, { replaced: true });
+});
+
+test("add: fails when an intermediate parent does not exist", () => {
+  const document = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "add", path: "/missing/child", value: 1 }]), Error);
+});
+
+test("add: fails when the array index is out of bounds", () => {
+  const document = { foo: ["bar"] };
+  assert.throws(() => applyPatch(document, [{ op: "add", path: "/foo/5", value: 1 }]), Error);
+});
+
+test("remove: removes a member from an object", () => {
+  const document = { foo: "bar", baz: "qux" };
+  const result = applyPatch(document, [{ op: "remove", path: "/baz" }]);
+  assert.deepEqual(result, { foo: "bar" });
+});
+
+test("remove: removes an array element, shifting the rest down", () => {
+  const document = { foo: ["bar", "qux", "baz"] };
+  const result = applyPatch(document, [{ op: "remove", path: "/foo/1" }]);
+  assert.deepEqual(result, { foo: ["bar", "baz"] });
+});
+
+test("remove: fails when the target property does not exist", () => {
+  const document = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "remove", path: "/missing" }]), Error);
+});
+
+test("remove: fails at the root path", () => {
+  const document = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "remove", path: "" }]), Error);
+});
+
+test("replace: replaces an existing object member", () => {
+  const document = { foo: "bar", baz: "qux" };
+  const result = applyPatch(document, [{ op: "replace", path: "/baz", value: "boo" }]);
+  assert.deepEqual(result, { foo: "bar", baz: "boo" });
+});
+
+test("replace: replaces an existing array element", () => {
+  const document = { foo: ["bar", "baz"] };
+  const result = applyPatch(document, [{ op: "replace", path: "/foo/0", value: "qux" }]);
+  assert.deepEqual(result, { foo: ["qux", "baz"] });
+});
+
+test("replace: at the root path replaces the whole document", () => {
+  const document = { foo: "bar" };
+  const result = applyPatch(document, [{ op: "replace", path: "", value: { replaced: true } }]);
+  assert.deepEqual(result, { replaced: true });
+});
+
+test("replace: fails when the target does not exist", () => {
+  const document = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "replace", path: "/missing", value: 1 }]), Error);
+});
+
+test("move: moves a member to a new key", () => {
+  const document = { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } };
+  const result = applyPatch(document, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]);
+  assert.deepEqual(result, { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+});
+
+test("move: moves an array element within the same array, accounting for the shift", () => {
+  const document = { foo: ["all", "grass", "cows", "eat"] };
+  const result = applyPatch(document, [{ op: "move", from: "/foo/1", path: "/foo/3" }]);
+  assert.deepEqual(result, { foo: ["all", "cows", "eat", "grass"] });
+});
+
+test("move: fails when 'from' is a proper prefix of 'path'", () => {
+  const document = { foo: { bar: "baz" } };
+  assert.throws(() => applyPatch(document, [{ op: "move", from: "/foo", path: "/foo/bar" }]), Error);
+});
+
+test("move: fails when 'from' does not exist", () => {
+  const document = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "move", from: "/missing", path: "/foo" }]), Error);
+});
+
+test("copy: duplicates a value at a new location", () => {
+  const document = { foo: { bar: "baz" }, qux: {} };
+  const result = applyPatch(document, [{ op: "copy", from: "/foo", path: "/qux/copied" }]);
+  assert.deepEqual(result, { foo: { bar: "baz" }, qux: { copied: { bar: "baz" } } });
+});
+
+test("copy: the copy is independent of the source", () => {
+  const document = { foo: { bar: "baz" } };
+  const result = applyPatch(document, [
+    { op: "copy", from: "/foo", path: "/copied" },
+    { op: "replace", path: "/copied/bar", value: "changed" },
+  ]) as { foo: { bar: string }; copied: { bar: string } };
+  assert.equal(result.foo.bar, "baz");
+  assert.equal(result.copied.bar, "changed");
+});
+
+test("copy: fails when 'from' does not exist", () => {
+  const document = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "copy", from: "/missing", path: "/foo" }]), Error);
+});
+
+test("test: succeeds and leaves the document unchanged when values match", () => {
+  const document = { foo: { bar: [1, 2, 3] } };
+  const result = applyPatch(document, [{ op: "test", path: "/foo", value: { bar: [1, 2, 3] } }]);
+  assert.deepEqual(result, document);
+});
+
+test("test: succeeds regardless of object key order", () => {
+  const document = { foo: { a: 1, b: 2 } };
+  const result = applyPatch(document, [{ op: "test", path: "/foo", value: { b: 2, a: 1 } }]);
+  assert.deepEqual(result, document);
+});
+
+test("test: fails when the value differs", () => {
+  const document = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "test", path: "/foo", value: "qux" }]), Error);
+});
+
+test("test: fails when array order differs", () => {
+  const document = { foo: [1, 2] };
+  assert.throws(() => applyPatch(document, [{ op: "test", path: "/foo", value: [2, 1] }]), Error);
+});
+
+test("applies several operations in sequence", () => {
+  const document = { foo: "bar" };
+  const result = applyPatch(document, [
+    { op: "add", path: "/baz", value: "qux" },
+    { op: "replace", path: "/foo", value: "boo" },
+    { op: "remove", path: "/baz" },
+  ]);
+  assert.deepEqual(result, { foo: "boo" });
+});
+
+test("does not mutate the input document", () => {
+  const document = { foo: { bar: "baz" }, list: [1, 2, 3] };
+  const snapshot = structuredClone(document);
+  applyPatch(document, [
+    { op: "add", path: "/foo/child", value: 1 },
+    { op: "remove", path: "/list/0" },
+  ]);
+  assert.deepEqual(document, snapshot);
+});
+
+test("rejects a patch that is not an array", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, { op: "add", path: "/foo", value: 1 } as never), TypeError);
+});
+
+test("rejects an operation with an unknown 'op'", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "patch", path: "/foo", value: 1 } as never]), TypeError);
+});
+
+test("rejects an operation missing its required 'value'", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/foo" } as never]), TypeError);
+});
+
+test("rejects a move or copy operation missing its required 'from'", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "move", path: "/foo" } as never]), TypeError);
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "copy", path: "/foo" } as never]), TypeError);
+});
+
+test("rejects an operation that is not an object", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, ["add" as never]), TypeError);
+});
+
+test("leaves the document untouched when a later operation in the patch fails", () => {
+  const document = { foo: "bar" };
+  const snapshot = structuredClone(document);
+  assert.throws(() =>
+    applyPatch(document, [
+      { op: "add", path: "/baz", value: "qux" },
+      { op: "remove", path: "/missing" },
+    ]),
+  );
+  assert.deepEqual(document, snapshot);
+});
+
+test("refuses to add a '__proto__' member, to avoid prototype pollution", () => {
+  const document = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "add", path: "/__proto__/polluted", value: true }]), Error);
+  assert.throws(() => applyPatch(document, [{ op: "add", path: "/__proto__", value: { polluted: true } }]), Error);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
