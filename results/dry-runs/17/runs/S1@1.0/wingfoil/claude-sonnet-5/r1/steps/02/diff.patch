index 0000000000000000000000000000000000000000..015039eb095bfe515ecfe8533011cdb62ccdaade
--- /dev/null
+++ b/src/jsonPatch.ts
@@ -0,0 +1,242 @@
+import { isJsonObject, parseArrayIndex, parsePointer, resolvePointer, resolveToken } from "./jsonPointer.ts";
+
+/** A single operation of a JSON Patch (RFC 6902). */
+export type JsonPatchOperation =
+  | { op: "add"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "replace"; path: string; value: unknown }
+  | { op: "move"; path: string; from: string }
+  | { op: "copy"; path: string; from: string }
+  | { op: "test"; path: string; value: unknown };
+
+const OPERATION_NAMES = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document.
+ *
+ * @param document - The JSON document to patch.
+ * @param patch - An array of patch operations, applied in order.
+ * @returns A new document with the patch applied; `document` is left untouched.
+ * @throws {Error} If `patch` is malformed, or if one of its operations fails to apply.
+ */
+export function applyPatch(document: unknown, patch: readonly unknown[]): unknown {
+  if (!Array.isArray(patch)) {
+    throw new TypeError("JSON Patch must be an array of operations");
+  }
+  const operations = patch.map(validateOperation);
+
+  let result = structuredClone(document);
+  for (const operation of operations) {
+    result = applyOperation(result, operation);
+  }
+  return result;
+}
+
+function validateOperation(raw: unknown): JsonPatchOperation {
+  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+    throw new TypeError("Each JSON Patch operation must be an object");
+  }
+  const operation = raw as Record<string, unknown>;
+
+  if (typeof operation.op !== "string" || !OPERATION_NAMES.has(operation.op)) {
+    throw new TypeError(`Invalid JSON Patch operation "op": ${JSON.stringify(operation.op)}`);
+  }
+  if (typeof operation.path !== "string") {
+    throw new TypeError(`JSON Patch operation "${operation.op}" requires a string "path"`);
+  }
+  if (
+    (operation.op === "add" || operation.op === "replace" || operation.op === "test") &&
+    !("value" in operation)
+  ) {
+    throw new TypeError(`JSON Patch operation "${operation.op}" requires a "value"`);
+  }
+  if ((operation.op === "move" || operation.op === "copy") && typeof operation.from !== "string") {
+    throw new TypeError(`JSON Patch operation "${operation.op}" requires a string "from"`);
+  }
+
+  return operation as JsonPatchOperation;
+}
+
+function applyOperation(document: unknown, operation: JsonPatchOperation): unknown {
+  switch (operation.op) {
+    case "add":
+      return applyAdd(document, operation.path, operation.value);
+    case "remove":
+      return applyRemove(document, operation.path);
+    case "replace":
+      return applyReplace(document, operation.path, operation.value);
+    case "move":
+      return applyMove(document, operation.path, operation.from);
+    case "copy":
+      return applyCopy(document, operation.path, operation.from);
+    case "test":
+      return applyTest(document, operation.path, operation.value);
+  }
+}
+
+function navigateToParent(document: unknown, tokens: readonly string[]): unknown {
+  return tokens.reduce(resolveToken, document);
+}
+
+function guardAgainstPrototypePollution(token: string, path: string): void {
+  if (token === "__proto__") {
+    throw new Error(`JSON Patch operation refused: "__proto__" is not an allowed member name (in "${path}")`);
+  }
+}
+
+function applyAdd(document: unknown, path: string, value: unknown): unknown {
+  const tokens = parsePointer(path);
+  const clonedValue = structuredClone(value);
+  if (tokens.length === 0) {
+    return clonedValue;
+  }
+  const lastToken = tokens[tokens.length - 1];
+  guardAgainstPrototypePollution(lastToken, path);
+  const parent = navigateToParent(document, tokens.slice(0, -1));
+  addToParent(parent, lastToken, clonedValue, path);
+  return document;
+}
+
+function addToParent(parent: unknown, token: string, value: unknown, path: string): void {
+  if (Array.isArray(parent)) {
+    const index = token === "-" ? parent.length : parseArrayIndex(token);
+    if (index === undefined || index > parent.length) {
+      throw new Error(`JSON Patch "add" failed: invalid array index "${token}" in "${path}"`);
+    }
+    parent.splice(index, 0, value);
+    return;
+  }
+  if (isJsonObject(parent)) {
+    parent[token] = value;
+    return;
+  }
+  throw new Error(`JSON Patch "add" failed: cannot add a member into ${typeof parent} at "${path}"`);
+}
+
+function applyRemove(document: unknown, path: string): unknown {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    throw new Error('JSON Patch "remove" cannot target the root document');
+  }
+  const lastToken = tokens[tokens.length - 1];
+  const parent = navigateToParent(document, tokens.slice(0, -1));
+  removeFromParent(parent, lastToken, path);
+  return document;
+}
+
+function removeFromParent(parent: unknown, token: string, path: string): unknown {
+  if (Array.isArray(parent)) {
+    const index = parseArrayIndex(token);
+    if (index === undefined || index >= parent.length) {
+      throw new Error(`JSON Patch "remove" failed: no element at index "${token}" in "${path}"`);
+    }
+    return parent.splice(index, 1)[0];
+  }
+  if (isJsonObject(parent)) {
+    if (!Object.prototype.hasOwnProperty.call(parent, token)) {
+      throw new Error(`JSON Patch "remove" failed: no member "${token}" in "${path}"`);
+    }
+    const value = parent[token];
+    delete parent[token];
+    return value;
+  }
+  throw new Error(`JSON Patch "remove" failed: cannot remove a member from ${typeof parent} at "${path}"`);
+}
+
+function applyReplace(document: unknown, path: string, value: unknown): unknown {
+  const tokens = parsePointer(path);
