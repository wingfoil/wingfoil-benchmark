+/**
+ * Computes a JSON Patch (RFC 6902) that turns `from` into `to`.
+ *
+ * @param from - The document the patch is computed against.
+ * @param to - The document the patch produces when applied to `from`.
+ * @returns A patch describing only the differences between `from` and `to`; neither is mutated.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  return diff(from, to, "");
+}
+
+function diff(from: unknown, to: unknown, path: string): JsonPatchOperation[] {
+  if (deepEqual(from, to)) {
+    return [];
+  }
+  if (isJsonObject(from) && isJsonObject(to)) {
+    return diffObjects(from, to, path);
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    return diffArrays(from, to, path);
+  }
+  return [{ op: "replace", path, value: structuredClone(to) }];
+}
+
+function diffObjects(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  path: string,
+): JsonPatchOperation[] {
+  const ops: JsonPatchOperation[] = [];
+  for (const key of Object.keys(from)) {
+    if (!Object.prototype.hasOwnProperty.call(to, key)) {
+      ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const childPath = `${path}/${escapeToken(key)}`;
+    if (!Object.prototype.hasOwnProperty.call(from, key)) {
+      ops.push({ op: "add", path: childPath, value: structuredClone(to[key]) });
+    } else {
+      ops.push(...diff(from[key], to[key], childPath));
+    }
+  }
+  return ops;
+}
+
+type ArrayEditStep = { kind: "match" } | { kind: "delete" } | { kind: "insert"; value: unknown };
+
+function diffArrays(from: readonly unknown[], to: readonly unknown[], path: string): JsonPatchOperation[] {
+  const script = arrayEditScript(from, to);
+  const ops: JsonPatchOperation[] = [];
+  let index = 0;
+  for (let i = 0; i < script.length; i++) {
+    const step = script[i];
+    if (step.kind === "match") {
+      index++;
+      continue;
+    }
+    const next = script[i + 1];
+    if (step.kind === "delete" && next?.kind === "insert") {
+      ops.push({ op: "replace", path: `${path}/${index}`, value: structuredClone(next.value) });
+      index++;
+      i++;
+      continue;
+    }
+    if (step.kind === "delete") {
+      ops.push({ op: "remove", path: `${path}/${index}` });
+      continue;
+    }
+    ops.push({ op: "add", path: `${path}/${index}`, value: structuredClone(step.value) });
+    index++;
+  }
+  return ops;
+}
+
+/**
+ * Computes a left-to-right edit script turning `from` into `to`, via the longest common
+ * subsequence of elements shared between them (by deep equality).
+ */
+function arrayEditScript(from: readonly unknown[], to: readonly unknown[]): ArrayEditStep[] {
+  const n = from.length;
+  const m = to.length;
+  const lcsLength: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = 1; i <= n; i++) {
+    for (let j = 1; j <= m; j++) {
+      lcsLength[i][j] = deepEqual(from[i - 1], to[j - 1])
+        ? lcsLength[i - 1][j - 1] + 1
+        : Math.max(lcsLength[i - 1][j], lcsLength[i][j - 1]);
+    }
+  }
