+  const script: ArrayEditStep[] = [];
+  let i = n;
+  let j = m;
+  while (i > 0 || j > 0) {
+    if (i > 0 && j > 0 && deepEqual(from[i - 1], to[j - 1]) && lcsLength[i][j] === lcsLength[i - 1][j - 1] + 1) {
+      script.push({ kind: "match" });
+      i--;
+      j--;
+    } else if (j > 0 && (i === 0 || lcsLength[i][j - 1] >= lcsLength[i - 1][j])) {
+      script.push({ kind: "insert", value: to[j - 1] });
+      j--;
+    } else {
+      script.push({ kind: "delete" });
+      i--;
+    }
+  }
+  return script.reverse();
+}
