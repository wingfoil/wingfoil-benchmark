-test("refuses to add a '__proto__' member, to avoid prototype pollution", () => {
+test("add: accepts a member literally named '__proto__', without polluting Object.prototype", () => {
+  const document = { foo: "bar" };
+  const result = applyPatch(document, [
+    { op: "add", path: "/__proto__", value: { polluted: true } },
+  ]) as Record<string, unknown>;
+  assert.deepEqual(JSON.parse(JSON.stringify(result)), JSON.parse('{"foo":"bar","__proto__":{"polluted":true}}'));
+  assert.equal(Object.prototype.hasOwnProperty.call(result, "__proto__"), true);
+  assert.deepEqual(result.__proto__, { polluted: true });
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("replace: accepts a member literally named '__proto__', without polluting Object.prototype", () => {
+  const document = JSON.parse('{"__proto__": 1}') as Record<string, unknown>;
+  const result = applyPatch(document, [{ op: "replace", path: "/__proto__", value: 2 }]) as Record<
+    string,
+    unknown
+  >;
+  assert.equal(Object.prototype.hasOwnProperty.call(result, "__proto__"), true);
+  assert.equal(result.__proto__, 2);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("move: moves a value into a member literally named '__proto__'", () => {
+  const document = { foo: 1 };
+  const result = applyPatch(document, [{ op: "move", from: "/foo", path: "/__proto__" }]) as Record<
+    string,
+    unknown
+  >;
+  assert.equal(Object.prototype.hasOwnProperty.call(result, "__proto__"), true);
+  assert.equal(result.__proto__, 1);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("copy: copies a value into a member literally named '__proto__'", () => {
+  const document = { foo: 1 };
+  const result = applyPatch(document, [{ op: "copy", from: "/foo", path: "/__proto__" }]) as Record<
+    string,
+    unknown
+  >;
+  assert.equal(Object.prototype.hasOwnProperty.call(result, "__proto__"), true);
+  assert.equal(result.__proto__, 1);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("remove: removes a member literally named '__proto__' without touching Object.prototype", () => {
+  const document = JSON.parse('{"__proto__": 1, "foo": "bar"}') as Record<string, unknown>;
+  const result = applyPatch(document, [{ op: "remove", path: "/__proto__" }]);
+  assert.deepEqual(result, { foo: "bar" });
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("navigating through an inherited (non-own) '__proto__' reference never resolves", () => {
   const document = { foo: "bar" };
   assert.throws(() => applyPatch(document, [{ op: "add", path: "/__proto__/polluted", value: true }]), Error);
-  assert.throws(() => applyPatch(document, [{ op: "add", path: "/__proto__", value: { polluted: true } }]), Error);
   assert.equal(({} as Record<string, unknown>).polluted, undefined);
 });
