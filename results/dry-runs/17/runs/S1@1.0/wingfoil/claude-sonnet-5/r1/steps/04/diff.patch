diff --git a/src/jsonPointer.ts b/src/jsonPointer.ts
index 474cd9f0f1429f4cdcb2ab9436ddc6afe8b6e168..b915783e0724f0ee843676a1fd63bc957307c5a2 100644
--- a/src/jsonPointer.ts
+++ b/src/jsonPointer.ts
@@ -81,3 +81,17 @@ export function parseArrayIndex(token: string): number | undefined {
 export function isJsonObject(value: unknown): value is Record<string, unknown> {
   return typeof value === "object" && value !== null && !Array.isArray(value);
 }
+
+/**
+ * Sets a genuine own data property on a JSON object, named `token`.
+ *
+ * @param parent - The object to write the property onto.
+ * @param token - The property name, e.g. a JSON Pointer reference token or a merge patch key.
+ * @param value - The property's value.
+ */
+export function setOwnProperty(parent: Record<string, unknown>, token: string, value: unknown): void {
+  // Bracket assignment would invoke the inherited `__proto__` accessor instead of
+  // creating an own member named "__proto__", silently dropping the value; defineProperty
+  // always creates a genuine own data property, exactly as JSON.parse does.
+  Object.defineProperty(parent, token, { value, writable: true, enumerable: true, configurable: true });
+}
