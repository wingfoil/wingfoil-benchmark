+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "./jsonMergePatch.ts";
+
+test("replaces an existing member", () => {
+  const result = applyMergePatch({ a: "b" }, { a: "c" });
+  assert.deepEqual(result, { a: "c" });
+});
+
+test("adds a new member", () => {
+  const result = applyMergePatch({ a: "b" }, { b: "c" });
+  assert.deepEqual(result, { a: "b", b: "c" });
+});
+
+test("a null member value removes the member", () => {
+  const result = applyMergePatch({ a: "b" }, { a: null });
+  assert.deepEqual(result, {});
+});
+
+test("a null member value removes only that member", () => {
+  const result = applyMergePatch({ a: "b", b: "c" }, { a: null });
+  assert.deepEqual(result, { b: "c" });
+});
+
+test("a null value for a member that does not exist is a no-op", () => {
+  const result = applyMergePatch({ a: "b" }, { c: null });
+  assert.deepEqual(result, { a: "b" });
+});
+
+test("a scalar patch member replaces an array member wholesale", () => {
+  const result = applyMergePatch({ a: ["b"] }, { a: "c" });
+  assert.deepEqual(result, { a: "c" });
+});
+
+test("an array patch member replaces a scalar member wholesale", () => {
+  const result = applyMergePatch({ a: "c" }, { a: ["b"] });
+  assert.deepEqual(result, { a: ["b"] });
+});
+
+test("merges nested objects recursively", () => {
+  const result = applyMergePatch({ a: { b: "c" } }, { a: { b: "d", c: null } });
+  assert.deepEqual(result, { a: { b: "d" } });
+});
+
+test("an array member inside an object is replaced wholesale, not merged element-wise", () => {
+  const result = applyMergePatch({ a: [{ b: "c" }] }, { a: [1] });
+  assert.deepEqual(result, { a: [1] });
+});
+
+test("a top-level array patch replaces the whole document", () => {
+  const result = applyMergePatch(["a", "b"], ["c", "d"]);
+  assert.deepEqual(result, ["c", "d"]);
+});
+
+test("a top-level array patch replaces a non-array document", () => {
+  const result = applyMergePatch({ a: "b" }, ["c"]);
+  assert.deepEqual(result, ["c"]);
+});
+
+test("a top-level null patch replaces the document with null", () => {
+  const result = applyMergePatch({ a: "foo" }, null);
+  assert.equal(result, null);
+});
+
+test("a top-level scalar patch replaces the document with that scalar", () => {
+  const result = applyMergePatch({ a: "foo" }, "bar");
+  assert.equal(result, "bar");
+});
+
+test("an object patch member alongside an existing null-valued member is kept, not merged away", () => {
+  const result = applyMergePatch({ e: null }, { a: 1 });
+  assert.deepEqual(result, { e: null, a: 1 });
+});
+
+test("merging an object patch into a non-object target discards the target", () => {
+  const result = applyMergePatch([1, 2], { a: "b", c: null });
+  assert.deepEqual(result, { a: "b" });
+});
+
+test("deeply nested objects are created along the way, pruning null leaves", () => {
+  const result = applyMergePatch({}, { a: { bb: { ccc: null } } });
+  assert.deepEqual(result, { a: { bb: {} } });
+});
+
+test("does not mutate the input target", () => {
+  const target = { a: { b: "c" }, list: [1, 2, 3] };
+  const snapshot = structuredClone(target);
+  applyMergePatch(target, { a: { b: "d" }, list: [4] });
+  assert.deepEqual(target, snapshot);
+});
+
+test("does not mutate the input patch", () => {
+  const target = { a: "b" };
+  const patch = { a: { nested: ["x"] } };
+  const snapshot = structuredClone(patch);
+  const result = applyMergePatch(target, patch) as { a: { nested: string[] } };
+  result.a.nested.push("y");
+  assert.deepEqual(patch, snapshot);
+});
+
+test("the result shares no mutable references with the target", () => {
+  const target = { a: { b: "c" } };
+  const result = applyMergePatch(target, { d: "e" }) as { a: { b: string } };
+  result.a.b = "changed";
+  assert.equal(target.a.b, "c");
+});
+
+test("accepts a member literally named '__proto__', without polluting Object.prototype", () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}}') as Record<string, unknown>;
+  const result = applyMergePatch({ foo: "bar" }, patch) as Record<string, unknown>;
+  assert.equal(Object.prototype.hasOwnProperty.call(result, "__proto__"), true);
+  assert.deepEqual(result.__proto__, { polluted: true });
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("removes a member literally named '__proto__' without touching Object.prototype", () => {
+  const target = JSON.parse('{"__proto__": 1, "foo": "bar"}') as Record<string, unknown>;
+  const patch = JSON.parse('{"__proto__": null}') as Record<string, unknown>;
+  const result = applyMergePatch(target, patch);
+  assert.deepEqual(result, { foo: "bar" });
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("a non-own '__proto__' on the target is treated as absent, not merged into", () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}}') as Record<string, unknown>;
+  const result = applyMergePatch({ foo: "bar" }, patch) as Record<string, unknown>;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
