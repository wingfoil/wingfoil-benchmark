new file mode 100644
index 0000000000000000000000000000000000000000..832b6e7c949d19fd01b811bcbe93732c0f9e9d8b
--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,56 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown): unknown[] {
+  const f = structuredClone(from);
+  const t = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, f);
+  assert.deepEqual(to, t);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a small change gives a small patch", () => {
+  const patch = roundTrip({ a: 1, b: { c: [1, 2, 3], d: "x" } }, { a: 1, b: { c: [1, 2, 3], d: "y" } });
+  assert.deepEqual(patch, [{ op: "replace", path: "/b/d", value: "y" }]);
+});
+
+test("object member add and remove, with escaped keys", () => {
+  const patch = roundTrip({ "a/b": 1, "~": 2 }, { "~": 2, "c/d": 3 });
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/a~1b" },
+    { op: "add", path: "/c~1d", value: 3 },
+  ]);
+});
+
+test("array insert, delete and edit", () => {
+  assert.deepEqual(roundTrip([1, 2, 3], [0, 1, 2, 3]), [{ op: "add", path: "/0", value: 0 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 4]), [
+    { op: "remove", path: "/1" },
+    { op: "remove", path: "/1" },
+  ]);
+  roundTrip([1, 2, 3], [1, 9, 3]);
+  roundTrip([1, 2, 3, 4, 5], [1, 9, 8, 7, 5]);
+  roundTrip([{ a: 1 }, { b: 2 }], [{ a: 1, c: 3 }]);
+});
+
+test("type changes and root replacement", () => {
+  roundTrip({ a: 1 }, [1]);
+  roundTrip([1], { a: 1 });
+  roundTrip(1, null);
+  roundTrip({ a: null }, { a: { b: 1 } });
+  assert.deepEqual(createPatch("x", "y"), [{ op: "replace", path: "", value: "y" }]);
+});
+
+test("patch shares no structure with the inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to) as { value: { b: number } }[];
+  patch[0].value.b = 2;
+  assert.equal(to.a.b, 1);
+});
