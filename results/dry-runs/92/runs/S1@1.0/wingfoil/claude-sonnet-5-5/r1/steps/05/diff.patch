+---
+id: task-005-add-createpatch-to-produce-a-minimal-rfc-6902-json-patch
+type: task
+title: "Add createPatch to produce a minimal RFC 6902 JSON Patch"
+status: approved
+format: 1
+---
+
+<!-- task body. `wingfoil memory add` copies this scaffold, setting only `id`, `title` and
+     `status` (and any `--tags` or `--set` value). Fill the required frontmatter fields and replace
+     these placeholder comments yourself; `wingfoil memory submit` then checks the required fields,
+     moves `status` forward and commits the document as you left it, naming in the commit body the
+     content it carries. -->
+
+## Request
+
+Clients want to send only what changed between two JSON document versions. Export
+`createPatch(from, to)` from `src/index.ts`: it returns an RFC 6902 patch that turns `from` into `to`
+when applied, mutates neither input, and describes only what changed (no whole-document resends for
+small changes).
+
+## Done
+
+- `createPatch` in `src/index.ts`: recursive object diff (remove/add/replace per member, RFC 6901
+  escaping), arrays diffed by common prefix/suffix with pairwise recursion in the middle, `replace` at
+  the root for type changes; values in the patch are cloned.
+- Tests in `test/createpatch.test.ts` (round trip through `applyPatch`, minimality, non-mutation).
+- README section added.
diff --git a/src/index.ts b/src/index.ts
index ed0306ad75a207f791310817dcb4716a40de5749..7e109d967815e4274e2e8f0f7abd38c321e000fc 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -286,3 +286,70 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+type PatchOperation = { op: "add" | "remove" | "replace"; path: string; value?: unknown };
+
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffInto(from: unknown, to: unknown, path: string, out: PatchOperation[]): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    let start = 0;
+    while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+      start++;
+    }
+    let fromEnd = from.length;
+    let toEnd = to.length;
+    while (fromEnd > start && toEnd > start && jsonEqual(from[fromEnd - 1], to[toEnd - 1])) {
+      fromEnd--;
+      toEnd--;
+    }
+    const removed = fromEnd - start;
+    const added = toEnd - start;
+    const common = Math.min(removed, added);
+    for (let i = 0; i < common; i++) {
+      diffInto(from[start + i], to[start + i], `${path}/${start + i}`, out);
+    }
+    // Removals repeat at one index, so later indices need no adjustment.
+    for (let i = common; i < removed; i++) {
+      out.push({ op: "remove", path: `${path}/${start + common}` });
+    }
+    for (let i = common; i < added; i++) {
+      out.push({ op: "add", path: `${path}/${start + i}`, value: structuredClone(to[start + i]) });
+    }
+    return;
+  }
+  if (isPlainObject(from) && isPlainObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!hasOwn(to, key)) {
+        out.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${encodeToken(key)}`;
+      if (!hasOwn(from, key)) {
+        out.push({ op: "add", path: child, value: structuredClone(to[key]) });
+      } else {
+        diffInto(from[key], to[key], child, out);
+      }
+    }
+    return;
+  }
+  out.push({ op: "replace", path, value: structuredClone(to) });
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ * Only what changed is described: objects are compared member by member and arrays by their
+ * common prefix and suffix, recursing into nested values. Equal documents give `[]`.
+ * Neither argument is mutated, and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  const out: PatchOperation[] = [];
+  diffInto(from, to, "", out);
+  return out;
+}
