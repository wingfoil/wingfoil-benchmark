+/** The RFC 6902 `replace` operation: the target must exist; replaced in place; returns the new root. */
+function replaceValue(root: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = parentOf(root, tokens, pointer);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent[arrayIndex(token, parent.length, pointer)] = value;
+  } else if (hasOwn(parent, token)) {
+    setMember(parent, token, value);
+  } else {
+    throw new Error(`JSON Patch: "${pointer}" does not resolve: no member "${token}"`);
+  }
+  return root;
+}
