+
+/**
+ * Applies the JSON Merge Patch `patch` (RFC 7386) to `target` and returns the merged document
+ * as a new value, without mutating `target` or `patch`. A non-object patch replaces the target;
+ * an object patch merges member by member, where `null` removes a member. Arrays are replaced
+ * whole, and a non-object target is treated as `{}` when the patch is an object.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isPlainObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result: Record<string, unknown> = {};
+  if (isPlainObject(target)) {
+    for (const key of Object.keys(target)) {
+      setMember(result, key, structuredClone(target[key]));
+    }
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
