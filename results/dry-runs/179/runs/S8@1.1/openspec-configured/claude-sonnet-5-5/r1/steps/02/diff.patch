+
+describe('task timestamps', () => {
+  function clockedList() {
+    let tick = 0;
+    const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)).toISOString());
+    return list;
+  }
+  const at = (second: number) => new Date(Date.UTC(2026, 0, 1, 0, 0, second)).toISOString();
+
+  it('gives an added task equal createdAt and updatedAt', () => {
+    const task = valueOf(clockedList().add({ title: 'a' }));
+    assert.equal(task.createdAt, at(0));
+    assert.equal(task.updatedAt, at(0));
+  });
+
+  it('sets updatedAt on every kind of change and keeps createdAt', () => {
+    const list = clockedList();
+    list.add({ title: 'a' });
+    const steps = [
+      list.complete('a'),
+      list.reopen('a'),
+      list.rename('a', 'b'),
+      list.tag('b', 't'),
+      list.untag('b', 't'),
+    ];
+    steps.forEach((result, index) => {
+      const task = valueOf(result);
+      assert.equal(task.createdAt, at(0));
+      assert.equal(task.updatedAt, at(index + 1));
+    });
+  });
+
+  it('shows the new updatedAt through find, get and list', () => {
+    const list = clockedList();
+    const added = valueOf(list.add({ title: 'a' }));
+    list.tag('a', 't');
+    assert.equal(valueOf(list.find('a')).updatedAt, at(1));
+    assert.equal(valueOf(list.get(added.id)).updatedAt, at(1));
+    assert.equal(list.list()[0]?.updatedAt, at(1));
+  });
+
+  it('leaves updatedAt alone when a change fails', () => {
+    const list = clockedList();
+    list.add({ title: 'a' });
+    list.add({ title: 'b' });
+    list.complete('a');
+    const before = valueOf(list.find('a'));
+    assert.equal(list.complete('a').ok, false);
+    assert.equal(list.reopen('b').ok, false);
+    assert.equal(list.rename('a', 'b').ok, false);
+    assert.equal(list.tag('zzz', 't').ok, false);
+    assert.deepEqual(valueOf(list.find('a')), before);
+    assert.equal(valueOf(list.find('b')).updatedAt, at(1));
+  });
+
+  it('uses the real time by default', () => {
+    const task = valueOf(createTodoList().add({ title: 'a' }));
+    assert.ok(Math.abs(Date.now() - Date.parse(task.createdAt)) < 5000);
+  });
+});
