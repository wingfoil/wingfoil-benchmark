+
+/**
+ * The title trimmed, or `invalid-input` when it is empty or longer than 120 characters.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title is empty: give the task a title');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is too long (${trimmed.length} characters): use at most ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority, or `invalid-input` when it is not `low`, `normal` or `high`.
+ *
+ * @param priority - the priority as given
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  if (!(PRIORITIES as readonly string[]).includes(priority)) {
+    return err('invalid-input', `"${String(priority)}" is not a priority: use ${PRIORITIES.join(', ')}`);
+  }
+  return ok(priority as Priority);
+}
+
+/**
+ * The tag, or `invalid-input` when it is empty or contains a space.
+ *
+ * @param tag - the tag as given
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'the tag is empty: give a tag name');
+  if (tag.includes(' ')) return err('invalid-input', `the tag "${tag}" contains a space: tags are one word`);
+  return ok(tag);
 }
 
