@@ -0,0 +1,61 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds full lines, with priority and tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin  money');
+    assert.deepEqual(result, { imported: 1, rejected: [] });
+    const task = list.list()[0];
+    assert.equal(task.priority, 'high');
+    assert.deepEqual(task.tags, ['admin', 'money']);
+  });
+
+  it('defaults priority and tags, and handles CRLF', () => {
+    const list = createTodoList();
+    const result = importTasks(list, ' Buy milk \r\nCall;;dairy\r\nWalk;low');
+    assert.deepEqual(result, { imported: 3, rejected: [] });
+    assert.equal(list.find('Buy milk').ok && list.list().length, 3);
+    const call = list.find('Call');
+    assert.ok(call.ok && call.value.priority === 'normal' && call.value.tags[0] === 'dairy');
+  });
+
+  it('skips blank lines but counts them in line numbers', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'A\n\n   \nB;urgent;x');
+    assert.equal(result.imported, 1);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0].line, 4);
+    assert.match(result.rejected[0].reason, /low, normal, high/);
+  });
+
+  it('rejects empty and too long titles', () => {
+    const list = createTodoList();
+    const result = importTasks(list, `;high;admin\n${'x'.repeat(121)}`);
+    assert.deepEqual(result.rejected.map((r) => r.line), [1, 2]);
+    assert.match(result.rejected[0].reason, /empty/);
+    assert.match(result.rejected[1].reason, /too long/);
+    assert.equal(result.imported, 0);
+  });
+
+  it('rejects lines with too many fields', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'a;high;x;y');
+    assert.equal(result.imported, 0);
+    assert.equal(result.rejected[0].line, 1);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects duplicates of the list and of earlier lines, keeping the rest', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing', priority: 'low' });
+    const result = importTasks(list, 'Existing;high\nNew\nNew\nOther');
+    assert.equal(result.imported, 2);
+    assert.deepEqual(result.rejected.map((r) => r.line), [1, 3]);
+    assert.match(result.rejected[0].reason, /already/);
+    const existing = list.find('Existing');
+    assert.ok(existing.ok && existing.value.priority === 'low');
+  });
+});
