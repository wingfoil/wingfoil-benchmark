index 0000000000000000000000000000000000000000..9398ee8f11d6df5e8cb53e767f961e4b2f75d964
--- /dev/null
+++ b/src/domain/import.ts
@@ -0,0 +1,45 @@
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of the imported text that could not be added: its number, from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks were added, and the lines that were not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text` to the list, one per line as `title;priority;tags`. The priority may be
+ * empty for a normal one, tags are separated by spaces, and blank lines are skipped. Lines that cannot be
+ * added are reported, with their number counting from 1, and do not stop the others.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r?\n/).forEach((content, index) => {
+    if (content.trim() === '') return;
+    const line = index + 1;
+    const fields = content.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `the line has ${fields.length} parts: use title;priority;tags` });
+      return;
+    }
+    const [title, priority = '', tags = ''] = fields;
+    const added = list.add({
+      title,
+      priority: priority.trim() === '' ? 'normal' : (priority.trim() as Priority),
+      tags: tags.split(' ').filter((tag) => tag !== ''),
+    });
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
