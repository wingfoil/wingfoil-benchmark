+import { test } from "node:test";
+import assert from "node:assert";
+import { applyPatch, JsonPatchError } from "../src/index.ts";
+
+type Op = Record<string, unknown>;
+const ok = (doc: unknown, patch: Op[], expected: unknown) => assert.deepStrictEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch as Op[]), JsonPatchError);
+
+test("RFC 6902 Appendix A examples", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }],
+    { foo: ["all", "cows", "eat", "grass"] });
+  ok({ baz: "qux" }, [{ op: "test", path: "/baz", value: "qux" }], { baz: "qux" });
+  ok({ foo: ["a", 2, "c"] }, [{ op: "test", path: "/foo/1", value: 2 }], { foo: ["a", 2, "c"] });
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  ok({ foo: "bar", baz: [1, 2, 3] }, [{ op: "copy", from: "/baz/1", path: "/boo" }], { foo: "bar", baz: [1, 2, 3], boo: 2 });
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] });
+  ok({ foo: 1, bar: 2 }, [{ op: "test", path: "/foo", value: 1 }, { op: "replace", path: "/bar", value: 3 }], { foo: 1, bar: 3 });
+});
+
+test("root and empty patch", () => {
+  ok({ a: 1 }, [], { a: 1 });
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: null }], null);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "" }], 1);
+  bad({ a: 1 }, [{ op: "remove", path: "" }]);
+});
+
+test("add edge cases", () => {
+  ok([1], [{ op: "add", path: "/1", value: 2 }], [1, 2]);
+  ok([1], [{ op: "add", path: "/0", value: 0 }], [0, 1]);
+  ok({ a: 1 }, [{ op: "add", path: "/a", value: null }], { a: null });
+  for (const p of ["/2", "/-1", "/01", "/x", "/1.0"]) bad([1], [{ op: "add", path: p, value: 0 }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "add", path: "/a/b/c", value: 1 }]);
+  bad(5, [{ op: "add", path: "/a", value: 1 }]);
+});
+
+test("remove/replace require existing target", () => {
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad([1], [{ op: "remove", path: "/1" }]);
+  bad([1], [{ op: "remove", path: "/-" }]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad([1], [{ op: "replace", path: "/-", value: 1 }]);
+  bad({ a: 1 }, [{ op: "replace", path: "/a" }]);
+  ok({ a: 1 }, [{ op: "replace", path: "/a", value: null }], { a: null });
+});
+
+test("move and copy rules", () => {
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  ok({ a: { b: 1 } }, [{ op: "move", from: "/a/b", path: "/a" }], { a: 1 });
+  bad({}, [{ op: "move", from: "/a", path: "/b" }]);
+  bad({}, [{ op: "copy", from: "/a", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "move", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "copy", from: 3, path: "/b" }]);
+  const doc = { a: { x: [1] } };
+  const out = applyPatch(doc, [{ op: "copy", from: "/a", path: "/b" }]) as { a: { x: number[] }; b: { x: number[] } };
+  assert.notStrictEqual(out.a, out.b);
+  assert.notStrictEqual(out.a.x, out.b.x);
+});
+
+test("test op equality", () => {
+  const t = (a: unknown, b: unknown) => applyPatch({ v: a }, [{ op: "test", path: "/v", value: b }]);
+  t({ a: 1, b: [1, { c: null }] }, { b: [1, { c: null }], a: 1 });
+  t(null, null);
+  t(1, 1.0);
+  t("", "");
+  for (const [a, b] of [[1, "1"], [null, 0], [[1, 2], [2, 1]], [{ a: 1 }, { a: 1, b: 2 }], [{ a: 1 }, { b: 1 }], [{}, []], [[], {}], [false, 0], [{ a: null }, {}]])
+    assert.throws(() => t(a, b), JsonPatchError, JSON.stringify([a, b]));
+  bad({ v: 1 }, [{ op: "test", path: "/missing", value: null }]);
+  bad({ v: 1 }, [{ op: "test", path: "/v" }]);
+});
+
+test("invalid patches", () => {
+  for (const p of [null, {}, "x", 1, [null], [1], [[]], [{}], [{ op: "nope", path: "" }], [{ op: 1, path: "" }],
+    [{ op: "add", value: 1 }], [{ op: "add", path: 1, value: 1 }], [{ op: "remove", path: "a" }],
+    [{ op: "remove", path: "/a~2" }], [{ op: "toString", path: "" }]])
+    bad({ a: 1 }, p);
+});
+
+test("atomic and non-mutating", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const copy = structuredClone(doc);
+  const patch = [{ op: "add", path: "/a/-", value: 3 }, { op: "remove", path: "/b/c" }, { op: "remove", path: "/zzz" }];
+  const patchCopy = structuredClone(patch);
+  bad(doc, patch);
+  assert.deepStrictEqual(doc, copy);
+  const val = { k: [1] };
+  const good = [{ op: "add", path: "/v", value: val }];
+  const out = applyPatch(doc, good) as { v: typeof val; a: number[] };
+  assert.deepStrictEqual(doc, copy);
+  assert.deepStrictEqual(patch, patchCopy);
+  assert.notStrictEqual(out.v, val);
+  assert.notStrictEqual(out.a, doc.a);
+  out.v.k.push(2);
+  assert.deepStrictEqual(val, { k: [1] });
+});
+
+test("prototype pollution safety", () => {
+  const out = applyPatch({}, [
+    { op: "add", path: "/__proto__", value: { polluted: true } },
+    { op: "add", path: "/constructor", value: { prototype: { polluted: true } } },
+  ]);
+  assert.strictEqual(({} as Record<string, unknown>).polluted, undefined);
+  assert.strictEqual(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepStrictEqual(Object.keys(out as object), ["__proto__", "constructor"]);
+  bad({}, [{ op: "remove", path: "/__proto__" }]);
+  bad({}, [{ op: "replace", path: "/constructor", value: 1 }]);
+  bad({}, [{ op: "add", path: "/toString/x", value: 1 }]);
+  bad({}, [{ op: "copy", from: "/hasOwnProperty", path: "/x" }]);
+  const parsed = JSON.parse('{"__proto__":{"a":1}}');
+  const r = applyPatch(parsed, [{ op: "add", path: "/__proto__/b", value: 2 }]);
+  assert.deepStrictEqual(Object.keys(r as object), ["__proto__"]);
+  assert.strictEqual(Object.getPrototypeOf(r), Object.prototype);
+  assert.deepStrictEqual(JSON.parse(JSON.stringify(r)), { ["__proto__"]: { a: 1, b: 2 } });
+});
