+/** Error thrown when a JSON Patch is invalid or one of its operations fails (RFC 6902 sections 3, 4, 5). */
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Container = unknown[] | Record<string, unknown>;
+
+const isObject = (v: unknown): v is Record<string, unknown> => typeof v === "object" && v !== null && !Array.isArray(v);
+
+/** Assigns an own data member, so that keys such as `__proto__` never reach the prototype. */
+function setMember(o: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(o, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Deep copy of a JSON value that shares no structure with the original. */
+function clone(v: unknown): unknown {
+  if (Array.isArray(v)) return v.map(clone);
+  if (isObject(v)) {
+    const out: Record<string, unknown> = {};
+    for (const k of Object.keys(v)) setMember(out, k, clone(v[k]));
+    return out;
+  }
+  return v;
+}
+
+/** JSON equality as defined for `test` in RFC 6902 section 4.6. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) return Array.isArray(b) && a.length === b.length && a.every((x, i) => jsonEqual(x, b[i]));
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((k) => hasOwn(b, k) && jsonEqual(a[k], b[k]));
+  }
+  return a === b;
+}
+
+const INDEX = /^(0|[1-9][0-9]*)$/;
+
+function parseTokens(pointer: unknown, member: string): string[] {
+  if (typeof pointer !== "string") throw new JsonPatchError(`"${member}" must be a string`);
+  try {
+    return parsePointer(pointer);
+  } catch (e) {
+    throw new JsonPatchError((e as Error).message);
+  }
+}
+
+/** Returns the container holding the last token's target, following own members only. */
+function parentOf(root: unknown, tokens: string[]): Container {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!INDEX.test(token) || Number(token) >= current.length) throw new JsonPatchError(`no element "${token}"`);
+      current = current[Number(token)];
+    } else if (isObject(current) && hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new JsonPatchError(`path does not exist at "${token}"`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) throw new JsonPatchError("parent of target is not a container");
+  return current;
+}
+
+function getAt(root: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) return root;
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!INDEX.test(last) || Number(last) >= parent.length) throw new JsonPatchError(`no element "${last}"`);
+    return parent[Number(last)];
+  }
+  if (!hasOwn(parent, last)) throw new JsonPatchError(`no member "${last}"`);
+  return parent[last];
+}
+
+/** Adds (RFC 6902 section 4.1) `value` at `tokens`; returns the new root. */
+function addAt(root: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (last === "-") parent.push(value);
+    else if (INDEX.test(last) && Number(last) <= parent.length) parent.splice(Number(last), 0, value);
+    else throw new JsonPatchError(`invalid array index "${last}"`);
+  } else {
+    setMember(parent, last, value);
+  }
+  return root;
+}
+
+/** Removes (section 4.2) the existing value at `tokens`; returns the new root. */
+function removeAt(root: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) throw new JsonPatchError("cannot remove the whole document");
+  getAt(root, tokens);
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete parent[last];
+  return root;
+}
+
+function valueOf(op: Record<string, unknown>): unknown {
+  if (!hasOwn(op, "value")) throw new JsonPatchError(`operation "${String(op.op)}" requires "value"`);
+  return clone(op.value);
+}
+
+/**
+ * Applies a JSON Patch to a JSON document, as specified by RFC 6902, and returns the new document.
+ *
+ * Supports `add`, `remove`, `replace`, `move`, `copy` and `test` (section 4), applied in order
+ * (section 5). Paths are JSON Pointers (RFC 6901). The patch is atomic: the document and the patch
+ * are never modified, and on failure nothing is returned. The result shares no structure with
+ * either input. Removing the whole document (`remove` with path `""`) is rejected.
+ *
+ * @throws {JsonPatchError} if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchError("a JSON Patch must be an array");
+  let root = clone(document);
+  for (const op of patch) {
+    if (!isObject(op)) throw new JsonPatchError("each operation must be an object");
+    if (typeof op.op !== "string") throw new JsonPatchError('operation requires a string "op"');
+    const path = parseTokens(op.path, "path");
+    switch (op.op) {
+      case "add":
+        root = addAt(root, path, valueOf(op));
+        break;
+      case "remove":
+        root = removeAt(root, path);
+        break;
+      case "replace": {
+        const value = valueOf(op);
+        getAt(root, path);
+        root = path.length === 0 ? value : addAt(removeAt(root, path), path, value);
+        break;
+      }
+      case "move":
+      case "copy": {
+        const from = parseTokens(op.from, "from");
+        const value = clone(getAt(root, from));
+        if (op.op === "move") {
+          if (from.length < path.length && from.every((t, i) => t === path[i]))
+            throw new JsonPatchError('"from" must not be a proper prefix of "path"');
+          if (from.length === path.length && from.every((t, i) => t === path[i])) break;
+          root = removeAt(root, from);
+        }
+        root = addAt(root, path, value);
+        break;
+      }
+      case "test":
+        if (!jsonEqual(getAt(root, path), valueOf(op))) throw new JsonPatchError(`test failed at "${String(op.path)}"`);
+        break;
+      default:
+        throw new JsonPatchError(`unknown operation "${op.op}"`);
+    }
+  }
+  return root;
+}
