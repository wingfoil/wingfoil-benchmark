new file mode 100644
index 0000000000000000000000000000000000000000..38e0ff0abe21eb7fb12fd4172e88be95e24e384b
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,106 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepStrictEqual(from, fromCopy);
+  assert.deepStrictEqual(to, toCopy);
+  assert.deepStrictEqual(applyPatch(from, patch), to);
+  return patch;
+};
+
+test("equal documents give an empty patch", () => {
+  assert.deepStrictEqual(roundTrip({ a: [1, { b: null }] }, { a: [1, { b: null }] }), []);
+  assert.deepStrictEqual(roundTrip(1, 1), []);
+});
+
+test("root replacement", () => {
+  assert.deepStrictEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepStrictEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  roundTrip(null, {});
+});
+
+test("objects: small change gives a small patch", () => {
+  const patch = roundTrip({ a: { b: 1, c: [1, 2] }, d: "x" }, { a: { b: 2, c: [1, 2] }, d: "x" });
+  assert.deepStrictEqual(patch, [{ op: "replace", path: "/a/b", value: 2 }]);
+  const p2 = roundTrip({ a: 1, b: 2 }, { b: 2, c: 3 });
+  assert.strictEqual(p2.length, 2);
+});
+
+test("null differs from missing", () => {
+  assert.deepStrictEqual(roundTrip({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+  assert.deepStrictEqual(roundTrip({}, { a: null }), [{ op: "add", path: "/a", value: null }]);
+  roundTrip({ a: null }, {});
+});
+
+test("pointer escaping", () => {
+  assert.deepStrictEqual(roundTrip({ "a/b": 1, "m~n": 1 }, { "a/b": 2, "m~n": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/m~0n", value: 2 },
+  ]);
+});
+
+test("__proto__ keys", () => {
+  const to = JSON.parse('{"__proto__": {"x": 1}}');
+  const patch = roundTrip({}, to);
+  assert.deepStrictEqual(patch.length, 1);
+  assert.strictEqual(({} as Record<string, unknown>).x, undefined);
+});
+
+test("array insert and remove are single operations", () => {
+  assert.deepStrictEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepStrictEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepStrictEqual(roundTrip([1, 2], [0, 1, 2]), [{ op: "add", path: "/0", value: 0 }]);
+  assert.deepStrictEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepStrictEqual(roundTrip([1, 2, 3], [1, 2]), [{ op: "remove", path: "/2" }]);
+  assert.strictEqual(roundTrip([{ id: 1 }, { id: 2 }, { id: 3 }], [{ id: 1 }, { id: 3 }]).length, 1);
+  roundTrip([], [1]);
+  roundTrip([1], []);
+});
+
+test("array move does not rewrite items in between", () => {
+  const from = [{ id: 1 }, { id: 2 }, { id: 3 }, { id: 4 }, { id: 5 }];
+  const patch = roundTrip(from, [{ id: 2 }, { id: 3 }, { id: 4 }, { id: 5 }, { id: 1 }]);
+  assert.ok(patch.length <= 2);
+  assert.ok(patch.every((o) => o.op === "move" || o.op === "remove" || o.op === "add"));
+  const p2 = roundTrip([1, 2, 3, 4, 5], [1, 5, 2, 3, 4]);
+  assert.ok(p2.length <= 2);
+});
+
+test("changed array items are patched in place", () => {
+  assert.deepStrictEqual(roundTrip([{ a: 1, b: 1 }, { a: 2 }], [{ a: 1, b: 2 }, { a: 2 }]), [
+    { op: "replace", path: "/0/b", value: 2 },
+  ]);
+  assert.deepStrictEqual(roundTrip([1, 2, 3], [1, 5, 3]), [{ op: "replace", path: "/1", value: 5 }]);
+});
+
+test("mixed changes round trip", () => {
+  roundTrip({ l: [1, 2, 3, 4, 5, 6], o: { x: [ { a: 1 } ] } }, { l: [6, 1, 7, 3, 4, 8, 9], o: { x: [ { a: 2 }, 1 ] } });
+  roundTrip([[1, 2], [3]], [[3], [1, 2, 4]]);
+  roundTrip([1, [2], { a: [3] }], [{ a: [3] }, 1, [2, 2]]);
+});
+
+test("randomised round trips", () => {
+  let s = 12345;
+  const rnd = (n: number) => ((s = (s * 1103515245 + 12345) & 0x7fffffff), s % n);
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 4 : 6);
+    if (k === 0) return rnd(4);
+    if (k === 1) return null;
+    if (k === 2) return "s" + rnd(3);
+    if (k === 3) return rnd(2) === 0;
+    if (k === 4) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let i = 0; i < 2000; i++) roundTrip(gen(0), gen(0));
+});
+
+test("patch shares no structure with inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to) as Array<{ value: { b: number } }>;
+  patch[0].value.b = 99;
+  assert.strictEqual(to.a.b, 1);
+});
