+/** A JSON Patch operation as produced by `createPatch` (RFC 6902 section 4). */
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+/** Encodes a member name as a JSON Pointer reference token (RFC 6901 section 3). */
+const escapeToken = (token: string): string => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+/** Longest common subsequence of two arrays under JSON equality, as ascending index pairs. */
+function commonPairs(a: unknown[], b: unknown[]): Array<[number, number]> {
+  const n = a.length;
+  const m = b.length;
+  const len: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--)
+    for (let j = m - 1; j >= 0; j--)
+      len[i][j] = jsonEqual(a[i], b[j]) ? len[i + 1][j + 1] + 1 : Math.max(len[i + 1][j], len[i][j + 1]);
+  const pairs: Array<[number, number]> = [];
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (jsonEqual(a[i], b[j])) pairs.push([i++, j++]);
+    else if (len[i + 1][j] >= len[i][j + 1]) i++;
+    else j++;
+  }
+  return pairs;
+}
+
+function diffInto(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    let start = 0;
+    while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+    let endA = from.length;
+    let endB = to.length;
+    while (endA > start && endB > start && jsonEqual(from[endA - 1], to[endB - 1])) {
+      endA--;
+      endB--;
+    }
+    const a = from.slice(start, endA);
+    const b = to.slice(start, endB);
+    // Gaps between matched items, as [fromStart, fromEnd, toStart, toEnd] relative to the slices.
+    const anchors = [...commonPairs(a, b), [a.length, b.length] as [number, number]];
+    const gaps: Array<[number, number, number, number]> = [];
+    let pi = 0;
+    let pj = 0;
+    for (const [i, j] of anchors) {
+      if (i > pi || j > pj) gaps.push([pi, i, pj, j]);
+      pi = i + 1;
+      pj = j + 1;
+    }
+    // Last gap first, so that the indices of earlier gaps are still those of `from`.
+    for (const [i0, i1, j0, j1] of gaps.reverse()) {
+      const at = start + i0;
+      const paired = Math.min(i1 - i0, j1 - j0);
+      for (let k = 0; k < paired; k++) {
+        const sub: PatchOperation[] = [];
+        const itemPath = `${path}/${at + k}`;
+        diffInto(a[i0 + k], b[j0 + k], itemPath, sub);
+        const replace: PatchOperation = { op: "replace", path: itemPath, value: clone(b[j0 + k]) };
+        const nested = JSON.stringify(sub).length <= JSON.stringify(replace).length;
+        ops.push(...(nested ? sub : [replace]));
+      }
+      for (let k = i1 - i0 - 1; k >= paired; k--) ops.push({ op: "remove", path: `${path}/${at + k}` });
+      for (let k = paired; k < j1 - j0; k++) ops.push({ op: "add", path: `${path}/${at + k}`, value: clone(b[j0 + k]) });
+    }
+    return;
+  }
+  if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) if (!hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (hasOwn(from, key)) diffInto(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+    return;
+  }
+  ops.push({ op: "replace", path, value: clone(to) });
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * Only what changed is described: object members are added, removed or patched recursively
+ * (paths are RFC 6901 pointers with `~` and `/` escaped), and arrays are compared by JSON equality
+ * of their items, so an inserted or deleted item is a single `add` or `remove`, and a moved item is a
+ * `remove` plus an `add`, without rewriting the items around it. Equal documents give `[]`. The inputs
+ * are never modified and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffInto(from, to, "", ops);
+  return ops;
+}
