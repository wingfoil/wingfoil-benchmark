+/** Error thrown for an invalid JSON Pointer or one that does not resolve to a value. */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+const hasOwn = (o: object, k: string): boolean => Object.prototype.hasOwnProperty.call(o, k);
+
+/**
+ * Resolves a JSON Pointer against a JSON document, as specified by RFC 6901.
+ *
+ * Syntax follows section 3 and evaluation section 4: `""` is the whole document, `~1` and `~0`
+ * decode to `/` and `~` (in that order), array indices are `0` or digits without a leading zero,
+ * and `-` (the nonexistent element after the last) does not resolve. Only own members are followed.
+ * The input is never modified.
+ *
+ * @throws {JsonPointerError} if the pointer is invalid or does not resolve to a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") throw new JsonPointerError("pointer must be a string");
+  if (pointer === "") return document;
+  if (pointer[0] !== "/") throw new JsonPointerError(`invalid pointer "${pointer}": must start with "/"`);
+
+  let current: unknown = document;
+  for (const raw of pointer.slice(1).split("/")) {
+    if (/~(?![01])/.test(raw)) throw new JsonPointerError(`invalid escape in "${raw}": "~" must be followed by 0 or 1`);
+    const token = raw.replace(/~1/g, "/").replace(/~0/g, "~");
+
+    if (Array.isArray(current)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) throw new JsonPointerError(`invalid array index "${token}"`);
+      const index = Number(token);
+      if (index >= current.length) throw new JsonPointerError(`array index ${token} is out of range`);
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!hasOwn(current, token)) throw new JsonPointerError(`no member "${token}"`);
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`cannot resolve "${token}" in a primitive value`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..989f60bd4d533646fc87f60081d558764dcdac6d
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,61 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { resolvePointer, JsonPointerError } from "../src/index.ts";
+
+const doc = JSON.parse(`{
+  "foo": ["bar", "baz"], "": 0, "a/b": 1, "c%d": 2, "e^f": 3, "g|h": 4,
+  "i\\\\j": 5, "k\\"l": 6, " ": 7, "m~n": 8, "n": null, "~1": 9, "__proto__": 10
+}`);
+
+test("RFC 6901 section 5 examples", () => {
+  assert.strictEqual(resolvePointer(doc, ""), doc);
+  assert.deepStrictEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.strictEqual(resolvePointer(doc, "/foo/0"), "bar");
+  const expected: Array<[string, number]> = [
+    ["/", 0], ["/a~1b", 1], ["/c%d", 2], ["/e^f", 3], ["/g|h", 4],
+    ["/i\\j", 5], ['/k"l', 6], ["/ ", 7], ["/m~0n", 8],
+  ];
+  for (const [p, v] of expected) assert.strictEqual(resolvePointer(doc, p), v);
+});
+
+test("escape order: ~01 is the key ~1", () => {
+  assert.strictEqual(resolvePointer(doc, "/~01"), 9);
+});
+
+test("null is a value, missing is an error", () => {
+  assert.strictEqual(resolvePointer(doc, "/n"), null);
+  assert.throws(() => resolvePointer(doc, "/nope"), JsonPointerError);
+  assert.throws(() => resolvePointer(doc, "/n/x"), JsonPointerError);
+});
+
+test("invalid syntax", () => {
+  for (const p of ["foo", "~0", "/a~", "/a~2", "/~x", "#/foo"])
+    assert.throws(() => resolvePointer(doc, p), JsonPointerError, p);
+  assert.throws(() => resolvePointer(doc, 5 as unknown as string), JsonPointerError);
+});
+
+test("array indices", () => {
+  const a = [10, 20, 30];
+  assert.strictEqual(resolvePointer(a, "/2"), 30);
+  for (const p of ["/3", "/-", "/01", "/+1", "/-1", "/1.0", "/x", "/", "/1e0"])
+    assert.throws(() => resolvePointer(a, p), JsonPointerError, p);
+  assert.strictEqual(resolvePointer([[1]], "/0/0"), 1);
+  assert.throws(() => resolvePointer(a, "/length"), JsonPointerError);
+});
+
+test("primitives cannot be descended into", () => {
+  assert.throws(() => resolvePointer("abc", "/0"), JsonPointerError);
+  assert.throws(() => resolvePointer(5, "/x"), JsonPointerError);
+  assert.strictEqual(resolvePointer(5, ""), 5);
+});
+
+test("only own members; no mutation", () => {
+  const o = JSON.parse('{"a":{"b":1}}');
+  const copy = structuredClone(o);
+  for (const k of ["constructor", "toString", "prototype", "hasOwnProperty"])
+    assert.throws(() => resolvePointer(o, "/" + k), JsonPointerError, k);
+  assert.throws(() => resolvePointer(o, "/__proto__"), JsonPointerError);
+  assert.strictEqual(resolvePointer(doc, "/__proto__"), 10);
+  resolvePointer(o, "/a/b");
+  assert.deepStrictEqual(o, copy);
+});
