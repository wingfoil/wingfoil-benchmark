index 0000000000000000000000000000000000000000..4a3156032693ee1f70b3f44a3c551ff359514f76
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,51 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { applyMergePatch } from "../src/index.ts";
+
+const ok = (target: unknown, patch: unknown, expected: unknown) =>
+  assert.deepStrictEqual(applyMergePatch(target, patch), expected);
+
+test("RFC 7396 Appendix A examples", () => {
+  ok({ a: "b" }, { a: "c" }, { a: "c" });
+  ok({ a: "b" }, { b: "c" }, { a: "b", b: "c" });
+  ok({ a: "b" }, { a: null }, {});
+  ok({ a: "b", b: "c" }, { a: null }, { b: "c" });
+  ok({ a: ["b"] }, { a: "c" }, { a: "c" });
+  ok({ a: "c" }, { a: ["b"] }, { a: ["b"] });
+  ok({ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } });
+  ok({ a: [{ b: "c" }] }, { a: [1] }, { a: [1] });
+  ok(["a", "b"], ["c", "d"], ["c", "d"]);
+  ok({ a: "b" }, ["c"], ["c"]);
+  ok({ a: "foo" }, null, null);
+  ok({ a: "foo" }, "bar", "bar");
+  ok({ e: null }, { a: 1 }, { e: null, a: 1 });
+  ok([1, 2], { a: "b", c: null }, { a: "b" });
+  ok({}, { a: { bb: { ccc: null } } }, { a: { bb: {} } });
+});
+
+test("non-object target is treated as an empty object", () => {
+  ok(undefined, { a: 1 }, { a: 1 });
+  ok("x", { a: { b: null } }, { a: {} });
+});
+
+test("inputs are not mutated and result shares no structure", () => {
+  const target = { a: { b: 1 }, c: [1] };
+  const patch = { a: { d: { e: 2 } }, f: [3] };
+  const tc = structuredClone(target), pc = structuredClone(patch);
+  const out = applyMergePatch(target, patch) as any;
+  assert.deepStrictEqual(target, tc);
+  assert.deepStrictEqual(patch, pc);
+  assert.notStrictEqual(out.c, target.c);
+  assert.notStrictEqual(out.a.d, patch.a.d);
+  assert.notStrictEqual(out.f, patch.f);
+});
+
+test("__proto__ keys are plain data, no prototype pollution", () => {
+  const out = applyMergePatch({}, JSON.parse('{"__proto__":{"polluted":true},"constructor":{"prototype":{"x":1}}}')) as any;
+  assert.strictEqual(({} as any).polluted, undefined);
+  assert.strictEqual(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepStrictEqual(Object.keys(out), ["__proto__", "constructor"]);
+  const out2 = applyMergePatch(JSON.parse('{"__proto__":{"a":1}}'), JSON.parse('{"__proto__":{"b":2}}')) as any;
+  assert.deepStrictEqual(Object.getOwnPropertyDescriptor(out2, "__proto__")?.value, { a: 1, b: 2 });
+  ok({}, JSON.parse('{"__proto__":null}'), {});
+});
