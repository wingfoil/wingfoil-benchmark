 }
+
+/**
+ * Applies a JSON Merge Patch to a JSON document, as specified by RFC 7396 section 2 (which obsoletes
+ * RFC 7386), and returns the merged document.
+ *
+ * A non-object patch replaces the target. Otherwise, a non-object target is treated as `{}`, members
+ * of the patch set to `null` are removed, and other members are merged recursively; arrays are
+ * replaced whole. The inputs are never modified and the result shares no structure with them.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch);
+  const result = isObject(target) ? (clone(target) as Record<string, unknown>) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) delete result[key];
+    else setMember(result, key, applyMergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+  }
+  return result;
+}
diff --git a/test/merge-patch.test.ts b/test/merge-patch.test.ts
