+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of the imported text that could not be added, and why. */
+export interface RejectedLine {
+  /** The line's number in the text, counting from 1 (blank lines count too). */
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks were added, and the lines that were not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may be
+ * empty for a normal one; tags are separated by spaces. Blank lines are skipped; a line that cannot be
+ * added is reported in `rejected` and the other lines are still added.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `the line has ${fields.length} fields: expected title;priority;tags` });
+      return;
+    }
+    const priority = (fields[1] ?? '').trim().toLowerCase();
+    const tags = (fields[2] ?? '').split(/\s+/).filter((tag) => tag !== '');
+    const added = list.add({
+      title: fields[0],
+      ...(priority === '' ? {} : { priority: priority as Priority }),
+      tags,
+    });
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
