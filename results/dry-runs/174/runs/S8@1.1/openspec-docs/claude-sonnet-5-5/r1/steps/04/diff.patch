@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds valid lines and reports the others by line number', () => {
+    const list = createTodoList();
+    const text = 'Renew the insurance;high;admin money\n\nBuy milk\nBad;urgent;\n;low;x\nBuy milk;;\nA;;b;c\r\nTea;;  ';
+    const result = importTasks(list, text);
+    assert.equal(result.imported, 3);
+    assert.deepEqual(result.rejected.map((r) => r.line), [4, 5, 6, 7]);
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok && insurance.value.priority === 'high');
+    assert.ok(insurance.ok && insurance.value.tags.join() === 'admin,money');
+    assert.equal(list.list().length, 3);
+  });
+});
