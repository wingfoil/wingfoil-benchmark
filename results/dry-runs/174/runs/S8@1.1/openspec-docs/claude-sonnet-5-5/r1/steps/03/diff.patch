+describe('input validation', () => {
+  const rejected = (r: { ok: boolean }) => assert.equal(r.ok, false);
+
+  it('rejects bad titles, priorities and tags without changing the list', () => {
+    const list = createTodoList();
+    list.add({ title: 'Keep' });
+    const before = JSON.stringify(list.list());
+    rejected(list.add({ title: '   ' }));
+    rejected(list.add({ title: 'x'.repeat(121) }));
+    rejected(list.add({ title: 'ok', priority: 'urgent' as never }));
+    rejected(list.add({ title: 'ok', tags: ['a b'] }));
+    rejected(list.add({ title: 'ok', tags: [''] }));
+    rejected(list.rename('Keep', ''));
+    rejected(list.rename('Keep', 'y'.repeat(121)));
+    rejected(list.tag('Keep', ''));
+    rejected(list.tag('Keep', 'two words'));
+    assert.equal(JSON.stringify(list.list()), before);
+    assert.equal(list.add({ title: 'x'.repeat(120) }).ok, true);
+  });
+});
