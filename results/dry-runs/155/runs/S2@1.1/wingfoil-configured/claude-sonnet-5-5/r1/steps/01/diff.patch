+
+describe('reported fixes', () => {
+  it('accepts a lower-case SKU on an order line', () => {
+    const { orders } = shop();
+    const order = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: ' mug-01 ', quantity: 1 }] });
+    assert.equal(order.lines[0]?.sku, 'MUG-01');
+  });
+
+  it('ships free at exactly €50.00 of goods, not at €49.99', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'A-1', name: 'A', priceCents: 5000, vatClass: 'exempt', weightGrams: 100 });
+    s.catalog.add({ sku: 'B-1', name: 'B', priceCents: 4999, vatClass: 'exempt', weightGrams: 100 });
+    s.inventory.restock('A-1', 5);
+    s.inventory.restock('B-1', 5);
+    assert.equal(s.orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'A-1', quantity: 1 }] }).totals.shippingCents, 0);
+    assert.equal(s.orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'B-1', quantity: 1 }] }).totals.shippingCents, 490);
+  });
+
+  it('rounds line VAT half up: 22% of €1.99 is €0.44', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'C-1', name: 'C', priceCents: 199, vatClass: 'standard', weightGrams: 10 });
+    s.inventory.restock('C-1', 5);
+    const order = s.orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'C-1', quantity: 1 }] });
+    assert.equal(order.lines[0]?.vatCents, 44);
+  });
+});
