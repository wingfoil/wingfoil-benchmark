+describe('single-use coupon on cancel', () => {
+  it('can be used again after the order that used it is cancelled', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'T-1', name: 'T', priceCents: 3000, vatClass: 'standard', weightGrams: 100 });
+    s.inventory.restock('T-1', 10);
+    s.coupons.add({ code: 'WELCOME', kind: 'fixed', value: 500, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = s.orders.place({ customer: 'paolo', date: '2026-03-02', coupon: 'welcome', lines: [{ sku: 'T-1', quantity: 1 }] });
+    s.orders.cancel(first.id, '2026-03-02');
+    const second = s.orders.place({ customer: 'paolo', date: '2026-03-02', coupon: 'WELCOME', lines: [{ sku: 'T-1', quantity: 1 }] });
