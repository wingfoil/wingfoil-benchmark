@@ -0,0 +1,247 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch } from './patch.ts';
+import type { JsonValue } from './types.ts';
+import type { JsonPatch } from './patch-types.ts';
+
+// RFC 6902 §A.1
+test('add: adds an object member', () => {
+  const document = { foo: 'bar' };
+  const patch: JsonPatch = [{ op: 'add', path: '/baz', value: 'qux' }];
+  assert.deepEqual(applyPatch(document, patch), { foo: 'bar', baz: 'qux' });
+});
+
+// RFC 6902 §A.2
+test('add: inserts an array element at the given index', () => {
+  const document = { foo: ['bar', 'baz'] };
+  const patch: JsonPatch = [{ op: 'add', path: '/foo/1', value: 'qux' }];
+  assert.deepEqual(applyPatch(document, patch), { foo: ['bar', 'qux', 'baz'] });
+});
+
+// RFC 6902 §A.16
+test('add: appends an array element with the "-" index', () => {
+  const document = { foo: ['bar'] };
+  const patch: JsonPatch = [{ op: 'add', path: '/foo/-', value: 'qux' }];
+  assert.deepEqual(applyPatch(document, patch), { foo: ['bar', 'qux'] });
+});
+
+// RFC 6902 §A.10
+test('add: creates nested object members along a new path', () => {
+  const document = { foo: 'bar' };
+  const patch: JsonPatch = [{ op: 'add', path: '/child', value: { grandchild: {} } }];
+  assert.deepEqual(applyPatch(document, patch), { foo: 'bar', child: { grandchild: {} } });
+});
+
+test('add: replaces the whole document when path is empty', () => {
+  const document = { foo: 'bar' };
+  const patch: JsonPatch = [{ op: 'add', path: '', value: { replaced: true } }];
+  assert.deepEqual(applyPatch(document, patch), { replaced: true });
+});
+
+// RFC 6902 §A.12
+test('add: fails when a path segment does not exist', () => {
+  const document = { foo: 'bar' };
+  const patch: JsonPatch = [{ op: 'add', path: '/baz/bat', value: 'qux' }];
+  assert.throws(() => applyPatch(document, patch));
+});
+
+test('add: fails when the array index is out of bounds', () => {
+  const document = { foo: ['bar'] };
+  const patch: JsonPatch = [{ op: 'add', path: '/foo/5', value: 'qux' }];
+  assert.throws(() => applyPatch(document, patch));
+});
+
+// RFC 6902 §A.3
+test('remove: removes an object member', () => {
+  const document = { foo: 'bar', baz: 'qux' };
+  const patch: JsonPatch = [{ op: 'remove', path: '/baz' }];
+  assert.deepEqual(applyPatch(document, patch), { foo: 'bar' });
+});
+
+// RFC 6902 §A.4
+test('remove: removes an array element and shifts later elements down', () => {
+  const document = { foo: ['bar', 'qux', 'baz'] };
+  const patch: JsonPatch = [{ op: 'remove', path: '/foo/1' }];
+  assert.deepEqual(applyPatch(document, patch), { foo: ['bar', 'baz'] });
+});
+
+test('remove: fails when the member does not exist', () => {
+  const document = { foo: 'bar' };
+  const patch: JsonPatch = [{ op: 'remove', path: '/baz' }];
+  assert.throws(() => applyPatch(document, patch));
+});
+
+test('remove: fails for the root document', () => {
+  const document = { foo: 'bar' };
+  const patch: JsonPatch = [{ op: 'remove', path: '' }];
+  assert.throws(() => applyPatch(document, patch));
+});
+
+// RFC 6902 §A.5
+test('replace: replaces an existing value', () => {
+  const document = { baz: 'qux', foo: 'bar' };
+  const patch: JsonPatch = [{ op: 'replace', path: '/baz', value: 'boo' }];
+  assert.deepEqual(applyPatch(document, patch), { baz: 'boo', foo: 'bar' });
+});
+
+test('replace: replaces an existing array element', () => {
+  const document = { foo: ['bar', 'baz'] };
+  const patch: JsonPatch = [{ op: 'replace', path: '/foo/0', value: 'qux' }];
+  assert.deepEqual(applyPatch(document, patch), { foo: ['qux', 'baz'] });
+});
+
+test('replace: replaces the whole document when path is empty', () => {
+  const document = { foo: 'bar' };
+  const patch: JsonPatch = [{ op: 'replace', path: '', value: ['replaced'] }];
+  assert.deepEqual(applyPatch(document, patch), ['replaced']);
+});
+
+test('replace: fails when the target does not exist', () => {
+  const document = { foo: 'bar' };
+  const patch: JsonPatch = [{ op: 'replace', path: '/baz', value: 'qux' }];
+  assert.throws(() => applyPatch(document, patch));
+});
+
+// RFC 6902 §A.6
+test('move: moves a value from one object member to another', () => {
+  const document = { foo: { bar: 'baz', waldo: 'fred' }, qux: { corge: 'grault' } };
+  const patch: JsonPatch = [{ op: 'move', from: '/foo/waldo', path: '/qux/thud' }];
+  assert.deepEqual(applyPatch(document, patch), {
+    foo: { bar: 'baz' },
+    qux: { corge: 'grault', thud: 'fred' },
+  });
+});
+
+// RFC 6902 §A.7
+test('move: moves an array element to another index', () => {
+  const document = { foo: ['all', 'grass', 'cows', 'eat'] };
+  const patch: JsonPatch = [{ op: 'move', from: '/foo/1', path: '/foo/3' }];
+  assert.deepEqual(applyPatch(document, patch), { foo: ['all', 'cows', 'eat', 'grass'] });
+});
+
+test('move: fails when "from" does not resolve', () => {
+  const document = { foo: 'bar' };
+  const patch: JsonPatch = [{ op: 'move', from: '/baz', path: '/qux' }];
+  assert.throws(() => applyPatch(document, patch));
+});
+
+test('move: fails when moving a value into one of its own children', () => {
+  const document = { foo: { bar: 'baz' } };
+  const patch: JsonPatch = [{ op: 'move', from: '/foo', path: '/foo/bar' }];
+  assert.throws(() => applyPatch(document, patch));
+});
+
+test('copy: copies a value to a new object member', () => {
+  const document = { foo: { bar: 'baz' }, qux: { corge: 'grault' } };
+  const patch: JsonPatch = [{ op: 'copy', from: '/foo/bar', path: '/qux/thud' }];
+  assert.deepEqual(applyPatch(document, patch), {
+    foo: { bar: 'baz' },
+    qux: { corge: 'grault', thud: 'baz' },
+  });
+});
+
+test('copy: does not alias the copied value with its source', () => {
+  const document = { foo: { bar: 'baz' } };
+  const patch: JsonPatch = [
+    { op: 'copy', from: '/foo', path: '/qux' },
+    { op: 'replace', path: '/foo/bar', value: 'changed' },
+  ];
+  assert.deepEqual(applyPatch(document, patch), {
+    foo: { bar: 'changed' },
+    qux: { bar: 'baz' },
+  });
+});
+
+test('copy: fails when "from" does not resolve', () => {
+  const document = { foo: 'bar' };
+  const patch: JsonPatch = [{ op: 'copy', from: '/baz', path: '/qux' }];
+  assert.throws(() => applyPatch(document, patch));
+});
+
+// RFC 6902 §A.8
+test('test: succeeds when the value matches', () => {
+  const document = { baz: 'qux', foo: ['a', 2, 'c'] };
+  const patch: JsonPatch = [{ op: 'test', path: '/baz', value: 'qux' }];
+  assert.deepEqual(applyPatch(document, patch), document);
+});
+
+test('test: succeeds for deep structural equality regardless of key order', () => {
+  const document = { foo: { a: 1, b: 2 } };
+  const patch: JsonPatch = [{ op: 'test', path: '/foo', value: { b: 2, a: 1 } }];
+  assert.deepEqual(applyPatch(document, patch), document);
+});
+
+// RFC 6902 §A.9
+test('test: fails when the value does not match', () => {
+  const document = { baz: 'qux' };
+  const patch: JsonPatch = [{ op: 'test', path: '/baz', value: 'bar' }];
+  assert.throws(() => applyPatch(document, patch));
+});
+
+// RFC 6902 §A.15
+test('test: distinguishes strings from numbers', () => {
+  const document = { foo: ['0'] };
+  const patch: JsonPatch = [{ op: 'test', path: '/foo/0', value: 0 }];
+  assert.throws(() => applyPatch(document, patch));
+});
+
+test('applies several operations in sequence', () => {
+  const document = { a: 1 };
+  const patch: JsonPatch = [
+    { op: 'add', path: '/b', value: 2 },
+    { op: 'replace', path: '/a', value: 10 },
+    { op: 'remove', path: '/b' },
+  ];
+  assert.deepEqual(applyPatch(document, patch), { a: 10 });
+});
+
+test('does not mutate the input document', () => {
+  const document = { foo: { bar: 'baz' }, list: [1, 2, 3] };
+  const snapshot = structuredClone(document);
+  applyPatch(document, [
+    { op: 'replace', path: '/foo/bar', value: 'changed' },
+    { op: 'add', path: '/list/-', value: 4 },
+    { op: 'remove', path: '/list/0' },
+  ]);
+  assert.deepEqual(document, snapshot);
+});
+
+test('does not apply any operation when the patch fails partway through', () => {
+  const document: JsonValue = { a: 1 };
+  const snapshot = structuredClone(document);
+  const patch: JsonPatch = [
+    { op: 'add', path: '/b', value: 2 },
+    { op: 'remove', path: '/does-not-exist' },
+  ];
+  assert.throws(() => applyPatch(document, patch));
+  assert.deepEqual(document, snapshot);
+});
+
+test('rejects a patch that is not an array', () => {
+  const document = { foo: 'bar' };
+  assert.throws(() => applyPatch(document, { op: 'add', path: '/x', value: 1 } as unknown as JsonPatch));
+});
+
+test('rejects an operation with an unknown "op"', () => {
+  const document = { foo: 'bar' };
+  const patch = [{ op: 'frobnicate', path: '/foo', value: 1 }] as unknown as JsonPatch;
+  assert.throws(() => applyPatch(document, patch));
+});
+
+test('rejects an "add" operation missing "value"', () => {
+  const document = { foo: 'bar' };
+  const patch = [{ op: 'add', path: '/baz' }] as unknown as JsonPatch;
+  assert.throws(() => applyPatch(document, patch));
+});
+
+test('rejects a "move" operation missing "from"', () => {
+  const document = { foo: 'bar' };
+  const patch = [{ op: 'move', path: '/baz' }] as unknown as JsonPatch;
+  assert.throws(() => applyPatch(document, patch));
+});
+
+test('rejects an operation that is not an object', () => {
+  const document = { foo: 'bar' };
+  const patch = ['add'] as unknown as JsonPatch;
+  assert.throws(() => applyPatch(document, patch));
+});
