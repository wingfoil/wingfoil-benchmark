index 0000000000000000000000000000000000000000..b7dbbca8164ddc8517b93b4598dd688b67ed368d
--- /dev/null
+++ b/src/patch.ts
@@ -0,0 +1,197 @@
+import type { JsonValue } from './types.ts';
+import type { JsonPatch, JsonPatchOperation } from './patch-types.ts';
+import { isArrayIndex, parsePointer, resolvePointer, resolveTokens } from './pointer.ts';
+
+const OPERATIONS = new Set(['add', 'remove', 'replace', 'move', 'copy', 'test']);
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result
+ * as a new value; `document` is left untouched.
+ *
+ * Throws if `patch` is not a well-formed sequence of operations, or if any
+ * operation fails to apply. In that case, `document` is still left untouched.
+ */
+export function applyPatch(document: JsonValue, patch: JsonPatch): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error('Invalid JSON Patch: a patch must be an array of operations');
+  }
+  return patch.reduce((current, operation) => applyOperation(current, operation), structuredClone(document));
+}
+
+function applyOperation(document: JsonValue, operation: JsonPatchOperation): JsonValue {
+  validateOperation(operation);
+  switch (operation.op) {
+    case 'add':
+      return add(document, operation.path, operation.value);
+    case 'remove':
+      return remove(document, operation.path);
+    case 'replace':
+      return replace(document, operation.path, operation.value);
+    case 'move':
+      return move(document, operation.from, operation.path);
+    case 'copy':
+      return copy(document, operation.from, operation.path);
+    case 'test':
+      return test(document, operation.path, operation.value);
+  }
+}
+
+function validateOperation(operation: unknown): asserts operation is JsonPatchOperation {
+  if (typeof operation !== 'object' || operation === null || Array.isArray(operation)) {
+    throw new Error('Invalid JSON Patch operation: each operation must be an object');
+  }
+  const candidate = operation as Record<string, unknown>;
+  if (typeof candidate.op !== 'string' || !OPERATIONS.has(candidate.op)) {
+    throw new Error(`Invalid JSON Patch operation: unknown "op" ${JSON.stringify(candidate.op)}`);
+  }
+  if (typeof candidate.path !== 'string') {
+    throw new Error('Invalid JSON Patch operation: "path" must be a string');
+  }
+  if ((candidate.op === 'add' || candidate.op === 'replace' || candidate.op === 'test') && !('value' in candidate)) {
+    throw new Error(`Invalid JSON Patch operation: "${candidate.op}" requires a "value"`);
+  }
+  if ((candidate.op === 'move' || candidate.op === 'copy') && typeof candidate.from !== 'string') {
+    throw new Error(`Invalid JSON Patch operation: "${candidate.op}" requires a "from"`);
+  }
+}
+
+function add(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  if (path === '') {
+    return structuredClone(value);
+  }
+  const { parentTokens, key } = splitPath(path);
+  insertMember(resolveTokens(document, parentTokens, path), key, structuredClone(value), path);
+  return document;
+}
+
+function remove(document: JsonValue, path: string): JsonValue {
+  const { parentTokens, key } = splitPath(path);
+  deleteMember(resolveTokens(document, parentTokens, path), key, path);
+  return document;
+}
+
+function replace(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  if (path === '') {
+    return structuredClone(value);
+  }
+  const { parentTokens, key } = splitPath(path);
+  overwriteMember(resolveTokens(document, parentTokens, path), key, structuredClone(value), path);
+  return document;
+}
+
+function move(document: JsonValue, from: string, path: string): JsonValue {
+  if (isProperPrefix(from, path)) {
+    throw new Error(`Invalid JSON Patch: cannot move "${from}" into one of its own children`);
+  }
+  const value = resolvePointer(document, from);
+  return add(remove(document, from), path, value);
+}
+
+function copy(document: JsonValue, from: string, path: string): JsonValue {
+  return add(document, path, resolvePointer(document, from));
+}
+
+function test(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  if (!deepEqual(resolvePointer(document, path), value)) {
+    throw new Error(`JSON Patch test failed for path "${path}"`);
+  }
+  return document;
+}
+
+function splitPath(path: string): { parentTokens: string[]; key: string } {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    throw new Error(`Invalid JSON Patch path: "${path}"`);
+  }
+  return { parentTokens: tokens.slice(0, -1), key: tokens[tokens.length - 1] };
+}
+
+function insertMember(parent: JsonValue, key: string, value: JsonValue, path: string): void {
+  if (Array.isArray(parent)) {
+    if (key === '-') {
+      parent.push(value);
+      return;
+    }
+    const index = toArrayIndex(key, path);
+    if (index > parent.length) {
+      throw new Error(`Invalid JSON Patch path: "${path}"`);
+    }
+    parent.splice(index, 0, value);
+    return;
+  }
+  if (isJsonObject(parent)) {
+    parent[key] = value;
+    return;
+  }
+  throw new Error(`Invalid JSON Patch path: "${path}"`);
+}
+
+function overwriteMember(parent: JsonValue, key: string, value: JsonValue, path: string): void {
+  if (Array.isArray(parent)) {
+    const index = toArrayIndex(key, path);
+    if (index >= parent.length) {
+      throw new Error(`Invalid JSON Patch path: "${path}"`);
+    }
+    parent[index] = value;
+    return;
+  }
+  if (isJsonObject(parent) && Object.prototype.hasOwnProperty.call(parent, key)) {
+    parent[key] = value;
+    return;
+  }
+  throw new Error(`Invalid JSON Patch path: "${path}"`);
+}
+
+function deleteMember(parent: JsonValue, key: string, path: string): void {
+  if (Array.isArray(parent)) {
+    const index = toArrayIndex(key, path);
+    if (index >= parent.length) {
+      throw new Error(`Invalid JSON Patch path: "${path}"`);
+    }
+    parent.splice(index, 1);
+    return;
+  }
+  if (isJsonObject(parent) && Object.prototype.hasOwnProperty.call(parent, key)) {
+    delete parent[key];
+    return;
+  }
+  throw new Error(`Invalid JSON Patch path: "${path}"`);
+}
+
+function toArrayIndex(token: string, path: string): number {
+  if (!isArrayIndex(token)) {
+    throw new Error(`Invalid JSON Patch path: "${path}"`);
+  }
+  return Number(token);
+}
+
+function isJsonObject(value: JsonValue): value is { [key: string]: JsonValue } {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function isProperPrefix(ancestor: string, pointer: string): boolean {
+  const ancestorTokens = parsePointer(ancestor);
+  const pointerTokens = parsePointer(pointer);
+  return (
+    ancestorTokens.length < pointerTokens.length &&
+    ancestorTokens.every((token, index) => token === pointerTokens[index])
+  );
+}
+
+function deepEqual(a: JsonValue, b: JsonValue): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (Array.isArray(a) && Array.isArray(b)) {
+    return a.length === b.length && a.every((item, index) => deepEqual(item, b[index]));
+  }
+  if (isJsonObject(a) && isJsonObject(b)) {
+    const aKeys = Object.keys(a);
+    const bKeys = Object.keys(b);
+    return (
+      aKeys.length === bKeys.length &&
+      aKeys.every((key) => Object.prototype.hasOwnProperty.call(b, key) && deepEqual(a[key], b[key]))
+    );
+  }
+  return false;
+}
