+import type { JsonValue } from './types.ts';
+
+/** Adds a value to an object member or inserts it into an array. */
+export type AddOperation = {
+  readonly op: 'add';
+  readonly path: string;
+  readonly value: JsonValue;
+};
+
+/** Removes the value at `path` from its containing object or array. */
+export type RemoveOperation = {
+  readonly op: 'remove';
+  readonly path: string;
+};
+
+/** Replaces the value already present at `path`. */
+export type ReplaceOperation = {
+  readonly op: 'replace';
+  readonly path: string;
+  readonly value: JsonValue;
+};
+
+/** Removes the value at `from` and inserts it at `path`. */
+export type MoveOperation = {
+  readonly op: 'move';
+  readonly path: string;
+  readonly from: string;
+};
+
+/** Copies the value at `from` to `path`. */
+export type CopyOperation = {
+  readonly op: 'copy';
+  readonly path: string;
+  readonly from: string;
+};
+
+/** Asserts that the value at `path` deep-equals `value`. */
+export type TestOperation = {
+  readonly op: 'test';
+  readonly path: string;
+  readonly value: JsonValue;
+};
+
+/** A single JSON Patch operation, as specified by RFC 6902. */
+export type JsonPatchOperation =
+  | AddOperation
+  | RemoveOperation
+  | ReplaceOperation
+  | MoveOperation
+  | CopyOperation
+  | TestOperation;
+
+/** An ordered sequence of JSON Patch operations. */
+export type JsonPatch = readonly JsonPatchOperation[];
