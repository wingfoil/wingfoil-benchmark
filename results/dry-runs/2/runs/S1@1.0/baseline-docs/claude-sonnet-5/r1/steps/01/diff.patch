diff --git a/src/pointer.test.ts b/src/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7aace5908c71624c127183e57a8a43f050e86646
--- /dev/null
+++ b/src/pointer.test.ts
@@ -0,0 +1,84 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { resolvePointer } from './pointer.ts';
+import type { JsonValue } from './types.ts';
+
+// Document from RFC 6901 §5.
+const document: JsonValue = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+test('resolves the whole document for the empty pointer', () => {
+  assert.deepEqual(resolvePointer(document, ''), document);
+});
+
+test('resolves a top-level array', () => {
+  assert.deepEqual(resolvePointer(document, '/foo'), ['bar', 'baz']);
+});
+
+test('resolves an array element by index', () => {
+  assert.equal(resolvePointer(document, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(document, '/foo/1'), 'baz');
+});
+
+test('resolves a member with an empty-string key', () => {
+  assert.equal(resolvePointer(document, '/'), 0);
+});
+
+test('unescapes ~1 to / in reference tokens', () => {
+  assert.equal(resolvePointer(document, '/a~1b'), 1);
+});
+
+test('unescapes ~0 to ~ in reference tokens', () => {
+  assert.equal(resolvePointer(document, '/m~0n'), 8);
+});
+
+test('resolves keys containing other special characters verbatim', () => {
+  assert.equal(resolvePointer(document, '/c%d'), 2);
+  assert.equal(resolvePointer(document, '/e^f'), 3);
+  assert.equal(resolvePointer(document, '/g|h'), 4);
+  assert.equal(resolvePointer(document, '/i\\j'), 5);
+  assert.equal(resolvePointer(document, '/k"l'), 6);
+  assert.equal(resolvePointer(document, '/ '), 7);
+});
+
+test('rejects a pointer that does not start with / and is not empty', () => {
+  assert.throws(() => resolvePointer(document, 'foo'));
+});
+
+test('rejects a reference token with a dangling ~ escape', () => {
+  assert.throws(() => resolvePointer(document, '/m~n'));
+});
+
+test('rejects a pointer to a member that does not exist', () => {
+  assert.throws(() => resolvePointer(document, '/bar'));
+});
+
+test('rejects a pointer to an array index that is out of bounds', () => {
+  assert.throws(() => resolvePointer(document, '/foo/2'));
+});
+
+test('rejects the "-" array index when resolving', () => {
+  assert.throws(() => resolvePointer(document, '/foo/-'));
+});
+
+test('rejects an array index with a leading zero', () => {
+  assert.throws(() => resolvePointer(document, '/foo/01'));
+});
+
+test('rejects a non-numeric array index', () => {
+  assert.throws(() => resolvePointer(document, '/foo/bar'));
+});
+
+test('rejects stepping into a scalar value', () => {
+  assert.throws(() => resolvePointer(document, '/foo/0/x'));
+});
