index 0000000000000000000000000000000000000000..d1eb8c253242e54a604e14270e9d0d45d6ccf3fe
--- /dev/null
+++ b/src/pointer.ts
@@ -0,0 +1,48 @@
+import type { JsonValue } from './types.ts';
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+const DANGLING_ESCAPE = /~(?![01])/;
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * Throws if `pointer` is not syntactically valid, or if it does not resolve
+ * to a value within `document`.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  if (pointer === '') {
+    return document;
+  }
+  if (!pointer.startsWith('/')) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}"`);
+  }
+
+  return pointer
+    .split('/')
+    .slice(1)
+    .map((token) => unescapeToken(token, pointer))
+    .reduce((current, token) => step(current, token, pointer), document);
+}
+
+function unescapeToken(token: string, pointer: string): string {
+  if (DANGLING_ESCAPE.test(token)) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}"`);
+  }
+  return token.replace(/~1/g, '/').replace(/~0/g, '~');
+}
+
+function step(current: JsonValue, token: string, pointer: string): JsonValue {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+      throw new Error(`Pointer "${pointer}" does not resolve to a value`);
+    }
+    return current[Number(token)];
+  }
+  if (typeof current === 'object' && current !== null) {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new Error(`Pointer "${pointer}" does not resolve to a value`);
+    }
+    return current[token];
+  }
+  throw new Error(`Pointer "${pointer}" does not resolve to a value`);
+}
