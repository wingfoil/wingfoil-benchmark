index 0000000000000000000000000000000000000000..1dabf8aa7b3465f3ca73b265af0a1381a5037f21
--- /dev/null
+++ b/src/pointer.ts
@@ -0,0 +1,52 @@
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function parse(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("a JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (!pointer.startsWith("/")) {
+    throw new JsonPointerError(`invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((segment) => {
+      if (/~(?![01])/.test(segment)) {
+        throw new JsonPointerError(`invalid JSON Pointer "${pointer}": "~" must be followed by 0 or 1`);
+      }
+      return segment.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/** Returns the value of `document` that the RFC 6901 `pointer` refers to, or throws. */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const segment of parse(pointer)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(segment)) {
+        throw new JsonPointerError(`"${segment}" is not a valid array index`);
+      }
+      const index = Number(segment);
+      if (index >= current.length) {
+        throw new JsonPointerError(`array index ${segment} is out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, segment)) {
+        throw new JsonPointerError(`no member "${segment}" at "${pointer}"`);
+      }
+      current = (current as Record<string, unknown>)[segment];
+    } else {
+      throw new JsonPointerError(`cannot resolve "${segment}" in a non-container value`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b4626e0e35f7689ee13f81dfadedd91cacfc3af2
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,79 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer, JsonPointerError } from "../src/index.ts";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("empty pointer returns any document", () => {
+  assert.equal(resolvePointer(null, ""), null);
+  assert.equal(resolvePointer(5, ""), 5);
+});
+
+test("escape order", () => {
+  const doc = { "~1": 1, "/": 2 };
+  assert.equal(resolvePointer(doc, "/~01"), 1);
+  assert.equal(resolvePointer(doc, "/~1"), 2);
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["a/b", "/a~2b", "/a~", "a", undefined, null, 1] as any[]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), JsonPointerError, String(p));
+  }
+});
+
+test("missing and inherited members throw", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"), JsonPointerError);
+  for (const p of ["/__proto__", "/constructor", "/toString"]) {
+    assert.throws(() => resolvePointer({}, p), JsonPointerError, p);
+  }
+});
+
+test("array indexes", () => {
+  assert.equal(resolvePointer(["a", "b"], "/1"), "b");
+  for (const p of ["/01", "/+1", "/-1", "/1.0", "/x", "/"]) {
+    assert.throws(() => resolvePointer(["a", "b"], p), JsonPointerError, p);
+  }
+  assert.throws(() => resolvePointer(["a"], "/1"), JsonPointerError);
+  assert.throws(() => resolvePointer(["a"], "/-"), JsonPointerError);
+});
+
+test("primitives have no children", () => {
+  for (const p of ["/a/0", "/a/length"]) {
+    assert.throws(() => resolvePointer({ a: "text" }, p), JsonPointerError, p);
+  }
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"), JsonPointerError);
+});
+
+test("falsy values are returned", () => {
+  const doc = { a: null, b: false, c: 0, d: "" };
+  assert.equal(resolvePointer(doc, "/a"), null);
+  assert.equal(resolvePointer(doc, "/b"), false);
+  assert.equal(resolvePointer(doc, "/c"), 0);
+  assert.equal(resolvePointer(doc, "/d"), "");
+});
