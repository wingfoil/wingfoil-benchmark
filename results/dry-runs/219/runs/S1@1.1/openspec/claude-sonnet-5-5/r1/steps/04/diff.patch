@@ -0,0 +1,51 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [string, string, string][] = [
+    ['{"a":"b"}', '{"a":"c"}', '{"a":"c"}'],
+    ['{"a":"b"}', '{"b":"c"}', '{"a":"b","b":"c"}'],
+    ['{"a":"b"}', '{"a":null}', "{}"],
+    ['{"a":"b","b":"c"}', '{"a":null}', '{"b":"c"}'],
+    ['{"a":["b"]}', '{"a":"c"}', '{"a":"c"}'],
+    ['{"a":"c"}', '{"a":["b"]}', '{"a":["b"]}'],
+    ['{"a":{"b":"c"}}', '{"a":{"b":"d","c":null}}', '{"a":{"b":"d"}}'],
+    ['{"a":[{"b":"c"}]}', '{"a":[1]}', '{"a":[1]}'],
+    ['["a","b"]', '["c","d"]', '["c","d"]'],
+    ['{"a":"b"}', '["c"]', '["c"]'],
+    ['{"a":"foo"}', "null", "null"],
+    ['{"a":"foo"}', '"bar"', '"bar"'],
+    ['{"e":null}', '{"a":1}', '{"e":null,"a":1}'],
+    ['[1,2]', '{"a":"b","c":null}', '{"a":"b"}'],
+    ['{}', '{"a":{"bb":{"ccc":null}}}', '{"a":{"bb":{}}}'],
+    ['{"a":"foo"}', '{"a":{"bb":{"ccc":null}}}', '{"a":{"bb":{}}}'],
+    ['{"a":1}', '{"b":null}', '{"a":1}'],
+    ['{"a":1}', "{}", '{"a":1}'],
+    ['{"a":1}', "3", "3"],
+  ];
+  for (const [t, p, r] of cases) {
+    assert.deepEqual(applyMergePatch(JSON.parse(t), JSON.parse(p)), JSON.parse(r), `${t} + ${p}`);
+  }
+});
+
+test("inputs are not modified or shared", () => {
+  const target = { a: { b: 1 }, l: [1] };
+  const patch = { a: { c: { d: 2 } }, m: [{ x: 1 }] };
+  const t = structuredClone(target);
+  const p = structuredClone(patch);
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, t);
+  assert.deepEqual(patch, p);
+  assert.notEqual(result.l, target.l);
+  assert.notEqual(result.a.c, patch.a.c);
+  assert.notEqual(result.m, patch.m);
+  assert.notEqual(result.m[0], patch.m[0]);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as any;
+  assert.ok(Object.hasOwn(result, "__proto__"));
+  assert.equal(({} as any).x, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
