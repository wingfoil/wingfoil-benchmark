index 0000000000000000000000000000000000000000..c323d701501d5a5c1c26f9f45f9ae173b5ec4941
--- /dev/null
+++ b/src/merge-patch.ts
@@ -0,0 +1,34 @@
+type JsonObject = Record<string, unknown>;
+
+function isObject(value: unknown): value is JsonObject {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function set(object: JsonObject, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function copy(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(copy);
+  if (isObject(value)) return merge({}, value);
+  return value;
+}
+
+function merge(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return copy(patch);
+  const result: JsonObject = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) set(result, key, copy(target[key]));
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) delete result[key];
+    else set(result, key, merge(Object.hasOwn(result, key) ? result[key] : undefined, value));
+  }
+  return result;
+}
+
+/** Applies an RFC 7386 JSON Merge Patch; neither input is modified. */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return merge(target, patch);
+}
