index c323d701501d5a5c1c26f9f45f9ae173b5ec4941..d4c77ea045b6bd5b133b40745c3a07d9155e2f77 100644
--- a/src/merge-patch.ts
+++ b/src/merge-patch.ts
@@ -10,7 +10,11 @@ function set(object: JsonObject, key: string, value: unknown): void {
 
 function copy(value: unknown): unknown {
   if (Array.isArray(value)) return value.map(copy);
-  if (isObject(value)) return merge({}, value);
+  if (isObject(value)) {
+    const clone: JsonObject = {};
+    for (const key of Object.keys(value)) set(clone, key, copy(value[key]));
+    return clone;
+  }
   return value;
 }
 
