@@ -0,0 +1,86 @@
+import { clone, equal } from "./patch.ts";
+
+export interface PatchOperation {
+  op: "add" | "remove" | "replace";
+  path: string;
+  value?: unknown;
+}
+
+type Obj = Record<string, unknown>;
+
+const isObject = (v: unknown): v is Obj => typeof v === "object" && v !== null && !Array.isArray(v);
+
+function escape(segment: string | number): string {
+  return "/" + String(segment).replaceAll("~", "~0").replaceAll("/", "~1");
+}
+
+function diffValue(from: unknown, to: unknown, path: string, out: PatchOperation[]): void {
+  if (equal(from, to)) return;
+  if (isObject(from) && isObject(to)) {
+    const fromKeys = Object.keys(from);
+    for (const key of fromKeys) {
+      if (!Object.hasOwn(to, key)) out.push({ op: "remove", path: path + escape(key) });
+    }
+    for (const key of Object.keys(to)) {
+      if (Object.hasOwn(from, key)) diffValue(from[key], to[key], path + escape(key), out);
+      else out.push({ op: "add", path: path + escape(key), value: clone(to[key]) });
+    }
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(from, to, path, out);
+  } else {
+    out.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+// Longest common subsequence of equal items, as [indexInFrom, indexInTo] pairs.
+function commonItems(from: unknown[], to: unknown[]): [number, number][] {
+  const n = from.length;
+  const m = to.length;
+  const len: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      len[i][j] = equal(from[i], to[j]) ? len[i + 1][j + 1] + 1 : Math.max(len[i + 1][j], len[i][j + 1]);
+    }
+  }
+  const pairs: [number, number][] = [];
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (equal(from[i], to[j])) pairs.push([i++, j++]);
+    else if (len[i + 1][j] >= len[i][j + 1]) i++;
+    else j++;
+  }
+  return pairs;
+}
+
+function diffArray(from: unknown[], to: unknown[], path: string, out: PatchOperation[]): void {
+  // `at` is the index in the array as it stands after the operations emitted so far.
+  let at = 0;
+  let i = 0;
+  let j = 0;
+  const gap = (fromEnd: number, toEnd: number) => {
+    const removed = fromEnd - i;
+    const added = toEnd - j;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) diffValue(from[i + k], to[j + k], path + escape(at + k), out);
+    for (let k = paired; k < removed; k++) out.push({ op: "remove", path: path + escape(at + paired) });
+    for (let k = paired; k < added; k++) {
+      out.push({ op: "add", path: path + escape(at + k), value: clone(to[j + k]) });
+    }
+    at += added;
+  };
+  for (const [pi, pj] of commonItems(from, to)) {
+    gap(pi, pj);
+    i = pi + 1;
+    j = pj + 1;
+    at++;
+  }
+  gap(from.length, to.length);
+}
+
+/** Returns an RFC 6902 JSON Patch that turns `from` into `to`. Neither input is modified. */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diffValue(from, to, "", out);
+  return out;
+}
