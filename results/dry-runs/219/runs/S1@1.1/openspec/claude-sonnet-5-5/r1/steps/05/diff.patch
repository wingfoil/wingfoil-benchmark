+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const patch = (a: unknown, b: unknown) => createPatch(a, b);
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(patch({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+  assert.deepEqual(patch(1, 1), []);
+});
+
+test("one small change in a large document", () => {
+  assert.deepEqual(patch({ a: { b: 1, c: [1, 2] }, d: "x" }, { a: { b: 2, c: [1, 2] }, d: "x" }), [
+    { op: "replace", path: "/a/b", value: 2 },
+  ]);
+});
+
+test("members added and removed", () => {
+  assert.deepEqual(patch({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("names are escaped", () => {
+  assert.deepEqual(patch({ "a/b~c": 1 }, { "a/b~c": 2 }), [{ op: "replace", path: "/a~1b~0c", value: 2 }]);
+});
+
+test("type changes and the root", () => {
+  assert.deepEqual(patch({ a: {} }, { a: [] }), [{ op: "replace", path: "/a", value: [] }]);
+  assert.deepEqual(patch({ a: 1 }, null), [{ op: "replace", path: "", value: null }]);
+  assert.deepEqual(patch([1], { a: 1 }), [{ op: "replace", path: "", value: { a: 1 } }]);
+});
+
+test("array insert, remove, move, in-place change", () => {
+  assert.deepEqual(patch([1, 2, 3], [1, 9, 2, 3]), [{ op: "add", path: "/1", value: 9 }]);
+  assert.deepEqual(patch([1, 2, 3], [2, 3]), [{ op: "remove", path: "/0" }]);
+  assert.deepEqual(patch(["a", "b", "c", "d"], ["b", "c", "d", "a"]), [
+    { op: "remove", path: "/0" },
+    { op: "add", path: "/3", value: "a" },
+  ]);
+  assert.deepEqual(patch([{ id: 1, n: 1 }, { id: 2 }], [{ id: 1, n: 2 }, { id: 2 }]), [
+    { op: "replace", path: "/0/n", value: 2 },
+  ]);
+});
+
+test("inputs are untouched and not shared", () => {
+  const a = { x: [1] };
+  const b = { y: { z: [2] } };
+  const ca = structuredClone(a);
+  const cb = structuredClone(b);
+  const p = patch(a, b) as { value?: { z: number[] } }[];
+  p.forEach((o) => o.value?.z.push(99));
+  assert.deepEqual(a, ca);
+  assert.deepEqual(b, cb);
+});
+
+test("__proto__ members", () => {
+  const a = JSON.parse('{"__proto__":1}');
+  const b = JSON.parse('{"__proto__":2,"c":{"__proto__":[]}}');
+  assert.deepEqual(applyPatch(a, patch(a, b)), b);
+});
+
+test("random round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff), seed % n);
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 4 : 6);
+    if (k === 0) return rnd(3);
+    if (k === 1) return ["a", "b", "c/~"][rnd(3)];
+    if (k === 2) return null;
+    if (k === 3) return rnd(2) === 0;
+    if (k === 4) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => [["a", "b", "c", "a/b"][rnd(4)], gen(d + 1)]));
+  };
+  const mutate = (v: unknown): unknown => {
+    if (Array.isArray(v)) {
+      const c = v.map((x) => (rnd(4) === 0 ? mutate(x) : x));
+      if (rnd(2)) c.splice(rnd(c.length + 1), rnd(3), ...(rnd(2) ? [gen(2)] : []));
+      if (rnd(3) === 0 && c.length > 1) c.push(c.shift());
+      return c;
+    }
+    return rnd(3) === 0 ? gen(1) : v;
+  };
+  for (let n = 0; n < 2000; n++) {
+    const a = gen(0);
+    const b = rnd(2) ? mutate(a) : gen(0);
+    const ca = structuredClone(a);
+    assert.deepEqual(applyPatch(a, patch(a, b)), b);
+    assert.deepEqual(a, ca);
+  }
+});
