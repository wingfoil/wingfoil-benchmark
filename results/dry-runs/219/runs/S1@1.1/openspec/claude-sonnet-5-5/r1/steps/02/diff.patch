@@ -0,0 +1,127 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, JsonPatchError } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) =>
+  assert.deepEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) =>
+  assert.throws(() => applyPatch(doc, patch), JsonPatchError);
+
+test("RFC 6902 appendix A examples", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  const t = { baz: "qux", foo: ["a", 2, "c"] };
+  ok(t, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], t);
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" });
+  ok({ foo: "bar", baz: [1, 2, 3] }, [{ op: "copy", from: "/foo", path: "/bar" }], { foo: "bar", baz: [1, 2, 3], bar: "bar" });
+});
+
+test("validity", () => {
+  for (const p of [{}, null, undefined, "x", [1], [null], [[]], [{}], [{ op: "merge", path: "" }], [{ op: 1, path: "" }],
+    [{ path: "/a", value: 1 }], [{ op: "add", value: 1 }], [{ op: "add", path: "a", value: 1 }], [{ op: "add", path: 1, value: 1 }],
+    [{ op: "add", path: "/a" }], [{ op: "replace", path: "/a" }], [{ op: "test", path: "/a" }],
+    [{ op: "move", path: "/a" }], [{ op: "copy", path: "/a", from: "x" }]]) {
+    bad({ a: 1 }, p);
+  }
+  bad({}, [{ op: "add", path: "/a", value: 1 }, { op: "bogus", path: "/a" }]);
+  ok({}, [{ op: "add", path: "/a", value: null }], { a: null });
+  ok({ a: 1 }, [], { a: 1 });
+});
+
+test("add", () => {
+  ok({ a: 1 }, [{ op: "add", path: "/a", value: 2 }], { a: 2 });
+  ok({ a: ["p"] }, [{ op: "add", path: "/a/-", value: "x" }], { a: ["p", "x"] });
+  ok({ a: ["p"] }, [{ op: "add", path: "/a/1", value: "x" }], { a: ["p", "x"] });
+  ok({ a: ["p"] }, [{ op: "add", path: "/a/0", value: "x" }], { a: ["x", "p"] });
+  bad({ a: ["p"] }, [{ op: "add", path: "/a/2", value: "x" }]);
+  for (const i of ["01", "-1", "1.0", "x", ""]) bad({ a: ["p"] }, [{ op: "add", path: `/a/${i}`, value: 1 }]);
+  bad({}, [{ op: "add", path: "/a/b", value: 1 }]);
+  bad({ a: "s" }, [{ op: "add", path: "/a/b", value: 1 }]);
+  bad({ a: null }, [{ op: "add", path: "/a/b", value: 1 }]);
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ "": 1 }, [{ op: "add", path: "/", value: 2 }], { "": 2 });
+});
+
+test("remove", () => {
+  ok({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }], { b: 2 });
+  ok(["x", "y"], [{ op: "remove", path: "/0" }], ["y"]);
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad(["x"], [{ op: "remove", path: "/1" }]);
+  bad(["x"], [{ op: "remove", path: "/-" }]);
+  bad({}, [{ op: "remove", path: "/a/b" }]);
+  bad({ a: 1 }, [{ op: "remove", path: "" }]);
+});
+
+test("replace", () => {
+  ok({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }], { a: 2 });
+  ok(["x"], [{ op: "replace", path: "/0", value: "z" }], ["z"]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: null }], null);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad(["x"], [{ op: "replace", path: "/1", value: 1 }]);
+  bad(["x"], [{ op: "replace", path: "/-", value: 1 }]);
+});
+
+test("move", () => {
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/b" }], { b: 1 });
+  ok({ a: [1, 2, 3] }, [{ op: "move", from: "/a/0", path: "/a/2" }], { a: [2, 3, 1] });
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  bad({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  bad({ a: {} }, [{ op: "move", from: "", path: "/a/b" }]);
+  bad({}, [{ op: "move", from: "/a", path: "/b" }]);
+  bad({ a: [1] }, [{ op: "move", from: "/a/0", path: "/a/2" }]);
+});
+
+test("copy", () => {
+  const out = applyPatch({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }]) as any;
+  assert.deepEqual(out, { a: { x: 1 }, b: { x: 1 } });
+  assert.notEqual(out.a, out.b);
+  bad({}, [{ op: "copy", from: "/a", path: "/b" }]);
+});
+
+test("test", () => {
+  ok({ a: { x: 1, y: 2 } }, [{ op: "test", path: "/a", value: { y: 2, x: 1 } }], { a: { x: 1, y: 2 } });
+  bad({ a: [2, 1] }, [{ op: "test", path: "/a", value: [1, 2] }]);
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+  bad({ a: {} }, [{ op: "test", path: "/a", value: [] }]);
+  bad({ a: { x: 1 } }, [{ op: "test", path: "/a", value: { x: 1, y: 2 } }]);
+  bad({}, [{ op: "test", path: "/a", value: null }]);
+  ok(1, [{ op: "test", path: "", value: 1 }], 1);
+  bad(1, [{ op: "test", path: "", value: 2 }]);
+});
+
+test("does not mutate or share structure", () => {
+  const doc = { a: { b: [1, 2] } };
+  const patch = [{ op: "add", path: "/c", value: { d: 1 } }, { op: "remove", path: "/a/b/0" }, { op: "copy", from: "/a", path: "/e" }];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  out.c.d = 9;
+  out.a.b.push(7);
+  assert.deepEqual(patch, patchCopy);
+  assert.deepEqual(doc, docCopy);
+});
+
+test("own members only", () => {
+  bad({}, [{ op: "remove", path: "/toString" }]);
+  bad({}, [{ op: "test", path: "/constructor", value: null }]);
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as any;
+  assert.ok(Object.hasOwn(out, "__proto__"));
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(({} as any).x, undefined);
+});
