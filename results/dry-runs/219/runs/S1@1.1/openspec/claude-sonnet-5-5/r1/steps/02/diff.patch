@@ -0,0 +1,190 @@
+import { JsonPointerError, parse } from "./pointer.ts";
+
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Container = unknown[] | Record<string, unknown>;
+
+interface Operation {
+  op: "add" | "remove" | "replace" | "move" | "copy" | "test";
+  path: string[];
+  from?: string[];
+  value?: unknown;
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const OPS = ["add", "remove", "replace", "move", "copy", "test"];
+
+function pointer(value: unknown, where: string): string[] {
+  try {
+    return parse(value);
+  } catch (error) {
+    if (error instanceof JsonPointerError) throw new JsonPatchError(`${where}: ${error.message}`);
+    throw error;
+  }
+}
+
+function validate(patch: unknown): Operation[] {
+  if (!Array.isArray(patch)) throw new JsonPatchError("a JSON Patch must be an array");
+  return patch.map((raw, i) => {
+    const where = `operation ${i}`;
+    if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+      throw new JsonPatchError(`${where}: must be an object`);
+    }
+    const o = raw as Record<string, unknown>;
+    if (typeof o.op !== "string" || !OPS.includes(o.op)) {
+      throw new JsonPatchError(`${where}: invalid "op"`);
+    }
+    const op = o.op as Operation["op"];
+    const result: Operation = { op, path: pointer(o.path, `${where} "path"`) };
+    if (op === "add" || op === "replace" || op === "test") {
+      if (!Object.hasOwn(o, "value") || o.value === undefined) {
+        throw new JsonPatchError(`${where}: "${op}" requires "value"`);
+      }
+      result.value = o.value;
+    }
+    if (op === "move" || op === "copy") {
+      result.from = pointer(o.from, `${where} "from"`);
+    }
+    return result;
+  });
+}
+
+function clone<T>(value: T): T {
+  if (Array.isArray(value)) return value.map(clone) as T;
+  if (typeof value === "object" && value !== null) {
+    const out: Record<string, unknown> = {};
+    for (const [k, v] of Object.entries(value)) {
+      Object.defineProperty(out, k, { value: clone(v), enumerable: true, writable: true, configurable: true });
+    }
+    return out as T;
+  }
+  return value;
+}
+
+function equal(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => equal(v, b[i]));
+  }
+  if (typeof a === "object" && typeof b === "object" && a !== null && b !== null) {
+    const ka = Object.keys(a);
+    return (
+      ka.length === Object.keys(b).length &&
+      ka.every((k) => Object.hasOwn(b, k) && equal((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]))
+    );
+  }
+  return false;
+}
+
+function parentOf(doc: unknown, path: string[]): Container {
+  let current = doc;
+  for (const segment of path.slice(0, -1)) current = child(current, segment);
+  if (typeof current !== "object" || current === null) {
+    throw new JsonPatchError("the parent of the target is not an object or array");
+  }
+  return current as Container;
+}
+
+function child(container: unknown, segment: string): unknown {
+  if (Array.isArray(container)) {
+    if (!ARRAY_INDEX.test(segment) || Number(segment) >= container.length) {
+      throw new JsonPatchError(`"${segment}" is not an existing array index`);
+    }
+    return container[Number(segment)];
+  }
+  if (typeof container === "object" && container !== null) {
+    if (!Object.hasOwn(container, segment)) throw new JsonPatchError(`no member "${segment}"`);
+    return (container as Record<string, unknown>)[segment];
+  }
+  throw new JsonPatchError(`cannot step into a non-container value at "${segment}"`);
+}
+
+function get(doc: unknown, path: string[]): unknown {
+  let current = doc;
+  for (const segment of path) current = child(current, segment);
+  return current;
+}
+
+function setMember(obj: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(obj, key, { value, enumerable: true, writable: true, configurable: true });
+}
+
+function add(doc: unknown, path: string[], value: unknown): unknown {
+  if (path.length === 0) return value;
+  const parent = parentOf(doc, path);
+  const key = path[path.length - 1];
+  if (Array.isArray(parent)) {
+    if (key === "-") parent.push(value);
+    else if (ARRAY_INDEX.test(key) && Number(key) <= parent.length) parent.splice(Number(key), 0, value);
+    else throw new JsonPatchError(`"${key}" is not a valid array index for add`);
+  } else {
+    setMember(parent, key, value);
+  }
+  return doc;
+}
+
+function remove(doc: unknown, path: string[]): unknown {
+  if (path.length === 0) throw new JsonPatchError("the document root cannot be removed");
+  const parent = parentOf(doc, path);
+  const key = path[path.length - 1];
+  child(parent, key); // must exist
+  if (Array.isArray(parent)) parent.splice(Number(key), 1);
+  else delete (parent as Record<string, unknown>)[key];
+  return doc;
+}
+
+function isPrefix(prefix: string[], path: string[]): boolean {
+  return prefix.length < path.length && prefix.every((s, i) => s === path[i]);
+}
+
+/** Applies an RFC 6902 JSON Patch to `document` and returns the result; inputs are not modified. */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  const operations = validate(patch);
+  let doc = clone(document);
+  for (const [i, op] of operations.entries()) {
+    try {
+      switch (op.op) {
+        case "add":
+          doc = add(doc, op.path, clone(op.value));
+          break;
+        case "remove":
+          doc = remove(doc, op.path);
+          break;
+        case "replace":
+          get(doc, op.path);
+          if (op.path.length === 0) {
+            doc = clone(op.value);
+          } else {
+            const parent = parentOf(doc, op.path);
+            const key = op.path[op.path.length - 1];
+            if (Array.isArray(parent)) parent[Number(key)] = clone(op.value);
+            else setMember(parent, key, clone(op.value));
+          }
+          break;
+        case "move": {
+          const from = op.from!;
+          const value = get(doc, from);
+          if (isPrefix(from, op.path)) throw new JsonPatchError("cannot move a value into its own child");
+          if (from.length === op.path.length && from.every((s, k) => s === op.path[k])) break;
+          doc = add(remove(doc, from), op.path, value);
+          break;
+        }
+        case "copy":
+          doc = add(doc, op.path, clone(get(doc, op.from!)));
+          break;
+        case "test":
+          if (!equal(get(doc, op.path), op.value)) throw new JsonPatchError("test failed: values differ");
+          break;
+      }
+    } catch (error) {
+      if (error instanceof JsonPatchError) throw new JsonPatchError(`operation ${i} (${op.op}): ${error.message}`);
+      throw error;
+    }
+  }
+  return doc;
+}
