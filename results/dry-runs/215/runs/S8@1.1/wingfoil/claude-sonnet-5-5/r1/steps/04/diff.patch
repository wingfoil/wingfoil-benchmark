@@ -0,0 +1,30 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds valid lines, skips blank ones and reports the rest by line number', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const text = [
+      'Renew the insurance;high;admin money',
+      '',
+      'Buy milk',
+      'Walk;urgent;',
+      'Existing;low;',
+      '  ;low;x',
+      'a;b;c;d',
+      'Plain;;',
+    ].join('\r\n');
+    const report = importTasks(list, text);
+    assert.equal(report.imported, 3);
+    assert.deepEqual(report.rejected.map((r) => r.line), [4, 5, 6, 7]);
+    assert.ok(report.rejected.every((r) => r.reason.length > 0));
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok && insurance.value.priority === 'high' && insurance.value.tags.join() === 'admin,money');
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok && milk.value.priority === 'normal' && milk.value.tags.length === 0);
+    assert.equal(list.list().length, 4);
+  });
+});
