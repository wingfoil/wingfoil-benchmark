+
+describe('input validation', () => {
+  const invalid = (result: { ok: boolean; error?: { code: string } }): void => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+  };
+
+  it('rejects bad titles on add and rename, changing nothing', () => {
+    const list = createTodoList();
+    list.add({ title: 'keep' });
+    invalid(list.add({ title: '' }));
+    invalid(list.add({ title: '   ' }));
+    invalid(list.add({ title: 'x'.repeat(121) }));
+    invalid(list.rename('keep', '  '));
+    invalid(list.rename('keep', 'y'.repeat(121)));
+    assert.deepEqual(list.list().map((task) => task.title), ['keep']);
+    assert.equal(valueOf(list.add({ title: 'z'.repeat(120) })).title.length, 120);
+  });
+
+  it('rejects a bad priority or tag on add, adding nothing', () => {
+    const list = createTodoList();
+    invalid(list.add({ title: 'a', priority: 'urgent' as never }));
+    invalid(list.add({ title: 'b', tags: ['ok', ''] }));
+    invalid(list.add({ title: 'c', tags: ['two words'] }));
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a bad tag when tagging, changing nothing', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'a' }));
+    invalid(list.tag('a', ''));
+    invalid(list.tag('a', 'a b'));
+    assert.deepEqual(valueOf(list.get(before.id)), before);
+  });
+});
