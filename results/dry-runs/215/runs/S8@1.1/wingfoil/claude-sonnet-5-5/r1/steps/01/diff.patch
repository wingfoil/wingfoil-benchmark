+
+describe('task ids', () => {
+  it('gives each task a unique id that survives renaming', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    const b = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(a.id, b.id);
+    valueOf(list.rename(a.id, 'c'));
+    assert.equal(valueOf(list.get(a.id)).title, 'c');
+    assert.equal(list.get('nope').ok, false);
+  });
+
+  it('accepts an id wherever a title is accepted', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    assert.equal(valueOf(list.complete(a.id)).status, 'done');
+    assert.equal(valueOf(list.reopen(a.id)).status, 'open');
+    assert.deepEqual(valueOf(list.tag(a.id, 'x')).tags, ['x']);
+    assert.deepEqual(valueOf(list.untag(a.id, 'x')).tags, []);
+    assert.equal(valueOf(list.find(a.id)).title, 'a');
+    assert.equal(list.rename(a.id, 'a').ok, true);
+    valueOf(list.remove(a.id));
+    assert.equal(list.get(a.id).ok, false);
+    assert.equal(valueOf(list.add({ title: 'a' })).id === a.id, false);
+  });
+});
