+/**
+ * Checks a task title: rejected when empty or only spaces once trimmed, or longer than
+ * {@link MAX_TITLE_LENGTH} characters trimmed. Returns the trimmed title otherwise.
+ *
+ * @param title - the title to check
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'title cannot be empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `title cannot be longer than ${MAX_TITLE_LENGTH} characters`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a task priority: rejected unless it is one of {@link PRIORITIES}. Missing defaults to `normal`.
+ *
+ * @param priority - the priority to check, if any
+ */
+export function validatePriority(priority: Priority | undefined): Result<Priority> {
+  if (priority === undefined) return ok('normal');
+  if (!PRIORITIES.includes(priority)) {
+    return err('invalid-input', `priority must be one of ${PRIORITIES.join(', ')}, not "${priority}"`);
+  }
+  return ok(priority);
+}
+
+/**
+ * Checks a tag: rejected when empty or containing a space.
+ *
+ * @param tag - the tag to check
+ */
+export function validateTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'tag cannot be empty');
+  if (tag.includes(' ')) return err('invalid-input', `tag "${tag}" cannot contain a space`);
+  return ok(tag);
+}
