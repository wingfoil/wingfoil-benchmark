+
+describe('input validation', () => {
+  it('rejects a title that is empty or only spaces, and a priority that is not low, normal or high', () => {
+    const list = createTodoList();
+    const empty = list.add({ title: '   ' });
+    assert.equal(empty.ok, false);
+    if (!empty.ok) assert.equal(empty.error.code, 'invalid-input');
+
+    const badPriority = list.add({ title: 'Buy milk', priority: 'urgent' as never });
+    assert.equal(badPriority.ok, false);
+    if (!badPriority.ok) assert.equal(badPriority.error.code, 'invalid-input');
+
+    assert.equal(list.openCount(), 0);
+    assert.deepEqual(list.list(), []);
+  });
+
+  it('rejects a title longer than 120 characters, but accepts one of exactly 120', () => {
+    const list = createTodoList();
+    const tooLong = list.add({ title: 'x'.repeat(121) });
+    assert.equal(tooLong.ok, false);
+    if (!tooLong.ok) assert.equal(tooLong.error.code, 'invalid-input');
+    assert.equal(list.openCount(), 0);
+    assert.equal(list.add({ title: 'x'.repeat(120) }).ok, true);
+  });
+
+  it('rejects an empty tag or one with a space, on add and on tag, leaving the task unchanged', () => {
+    const list = createTodoList();
+    const rejected = list.add({ title: 'Buy milk', tags: ['a b'] });
+    assert.equal(rejected.ok, false);
+    if (!rejected.ok) assert.equal(rejected.error.code, 'invalid-input');
+    assert.equal(list.openCount(), 0);
+
+    const added = valueOf(list.add({ title: 'Call the plumber' }));
+    const badTag = list.tag(added.id, 'has space');
+    assert.equal(badTag.ok, false);
+    if (!badTag.ok) assert.equal(badTag.error.code, 'invalid-input');
+    const emptyTag = list.tag(added.id, '');
+    assert.equal(emptyTag.ok, false);
+    if (!emptyTag.ok) assert.equal(emptyTag.error.code, 'invalid-input');
+    assert.deepEqual(valueOf(list.get(added.id)).tags, []);
+  });
+
+  it('rejects renaming a task to an empty title or one longer than 120 characters, keeping its title', () => {
+    const list = createTodoList();
+    const added = valueOf(list.add({ title: 'Buy milk' }));
+    const renamedEmpty = list.rename(added.id, '   ');
+    assert.equal(renamedEmpty.ok, false);
+    if (!renamedEmpty.ok) assert.equal(renamedEmpty.error.code, 'invalid-input');
+    const renamedTooLong = list.rename(added.id, 'x'.repeat(121));
+    assert.equal(renamedTooLong.ok, false);
+    if (!renamedTooLong.ok) assert.equal(renamedTooLong.error.code, 'invalid-input');
+    assert.equal(valueOf(list.get(added.id)).title, 'Buy milk');
+  });
+});
