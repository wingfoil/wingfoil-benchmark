+
+describe('single-use coupons and cancellation', () => {
+  it('gives a single-use coupon back when its order is cancelled', () => {
+    const s = shop();
+    s.coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-03-01', validUntil: '2026-03-31', singleUse: true });
+    const first = s.orders.place({ customer: 'Paolo', date: '2026-03-02', coupon: 'welcome', lines: [{ sku: 'MUG-01', quantity: 1 }] });
+    s.orders.cancel(first.id, '2026-03-02');
+    const again = s.orders.place({ customer: 'Paolo', date: '2026-03-02', coupon: 'WELCOME', lines: [{ sku: 'MUG-01', quantity: 2 }] });
+    assert.equal(again.coupon, 'WELCOME');
+  });
+});
+
+describe('free shipping at exactly €50.00 after discounts', () => {
+  it('ships free when a coupon brings the goods to exactly €50.00', () => {
+    const s = shop();
+    s.coupons.add({ code: 'TEN', kind: 'fixed', value: 1000, validFrom: '2026-03-01', validUntil: '2026-03-31' });
+    const order = s.orders.place({ customer: 'Anna', date: '2026-03-02', coupon: 'TEN', lines: [{ sku: 'MUG-01', quantity: 6 }] });
+    assert.equal(order.totals.goodsCents, 5000);
+    assert.equal(order.totals.shippingCents, 0);
+  });
+});
