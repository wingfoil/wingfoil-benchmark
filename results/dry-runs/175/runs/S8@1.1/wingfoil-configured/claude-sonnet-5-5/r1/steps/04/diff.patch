+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds valid lines, skips blank ones and reports the rest by line number', () => {
+    const list = createTodoList();
+    const report = importTasks(
+      list,
+      'Renew the insurance;high;admin money\n\nBuy milk\r\nWalk;;\n;low;x\nBad;urgent;a\nBuy milk;low;\nA;low;b;c\nTag;low;ok',
+    );
+    assert.equal(report.imported, 4);
+    assert.deepEqual(report.rejected.map((r) => r.line), [5, 6, 7, 8]);
+    assert.equal(list.find('Renew the insurance').ok && list.list()[0]?.priority, 'high');
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok && insurance.value.tags.join() === 'admin,money');
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok && milk.value.priority === 'normal');
+  });
+
+  it('imports nothing from empty text', () => {
+    assert.deepEqual(importTasks(createTodoList(), ''), { imported: 0, rejected: [] });
+  });
+});
