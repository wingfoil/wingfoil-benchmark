+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of the import text that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks it added, and every line it could not add. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds to the list the tasks written in `text`, one per line, as `title;priority;tags`. The priority may be
+ * empty for a normal one; the tags are separated by spaces. Blank lines are skipped, and a line that cannot be
+ * added is reported without stopping the import.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the tasks, one per line
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+
+  text.split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `the line has ${fields.length} fields: use title;priority;tags` });
+      return;
+    }
+    const [title = '', priority = '', tags = ''] = fields;
+    const added = list.add({
+      title,
+      // An unknown priority is passed on as typed, so that the list's own check refuses it.
+      ...(priority.trim() === '' ? {} : { priority: priority.trim() as Priority }),
+      tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+    });
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+
+  return { imported, rejected };
+}
