+describe('input validation', () => {
+  const rejected = (result: { ok: boolean; error?: { code: string; message: string } }) => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+    assert.ok((result.error?.message.length ?? 0) > 0);
+  };
+
+  it('rejects an empty, blank or too long title on add, and keeps the list', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: '' }));
+    rejected(list.add({ title: '   ' }));
+    rejected(list.add({ title: 'x'.repeat(121) }));
+    assert.equal(list.list().length, 0);
+    assert.equal(valueOf(list.add({ title: 'x'.repeat(120) })).id, 'task-1');
+  });
+
+  it('rejects an unknown priority or a bad tag on add', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: 'a', priority: 'urgent' as 'high' }));
+    rejected(list.add({ title: 'a', tags: ['ok', ''] }));
+    rejected(list.add({ title: 'a', tags: ['two words'] }));
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a bad new title on rename, and changes nothing', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'Keep' }));
+    rejected(list.rename('Keep', '  '));
+    rejected(list.rename('Keep', 'y'.repeat(121)));
+    assert.deepEqual(list.list(), [before]);
+    assert.equal(valueOf(list.rename('Keep', ' Kept ')).title, 'Kept');
+  });
+
+  it('rejects an empty tag or one with a space on tag, and changes nothing', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'Keep' }));
+    rejected(list.tag('Keep', ''));
+    rejected(list.tag('Keep', ' '));
+    rejected(list.tag('Keep', 'a b'));
+    assert.deepEqual(list.list(), [before]);
+    assert.deepEqual(valueOf(list.tag('Keep', 'home')).tags, ['home']);
+  });
+});
