+
+describe('task ids', () => {
+  it('gives each task a unique id that survives a rename', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    const b = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(a.id, b.id);
+    list.rename('a', 'a2');
+    assert.equal(valueOf(list.get(a.id)).title, 'a2');
+  });
+
+  it('accepts an id wherever a title is accepted', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'a' }));
+    assert.equal(valueOf(list.tag(id, 'x')).tags[0], 'x');
+    assert.equal(valueOf(list.untag(id, 'x')).tags.length, 0);
+    assert.equal(valueOf(list.complete(id)).status, 'done');
+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.equal(valueOf(list.rename(id, 'b')).title, 'b');
+    assert.equal(valueOf(list.find(id)).title, 'b');
+    assert.equal(list.rename(id, 'b').ok, true);
+    assert.equal(valueOf(list.remove(id)).id, id);
+    assert.equal(list.openCount(), 0);
+  });
+
+  it('does not reuse the id of a removed task, and reports an unknown id', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'a' }));
+    list.remove('a');
+    assert.notEqual(valueOf(list.add({ title: 'a' })).id, id);
+    const missing = list.get(id);
+    assert.equal(missing.ok, false);
+    if (!missing.ok) assert.equal(missing.error.code, 'not-found');
+  });
+});
