+  describe('timestamps', () => {
+    function clocked() {
+      let tick = 0;
+      const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)).toISOString());
+      return list;
+    }
+
+    it('stamps createdAt and updatedAt alike when a task is added', () => {
+      const task = valueOf(clocked().add({ title: 'Buy milk' }));
+      assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+      assert.equal(task.updatedAt, task.createdAt);
+    });
+
+    it('sets updatedAt on every change and keeps createdAt', () => {
+      const list = clocked();
+      const added = valueOf(list.add({ title: 'a' }));
+      const steps = [
+        () => list.complete('a'),
+        () => list.reopen('a'),
+        () => list.rename('a', 'b'),
+        () => list.tag('b', 'home'),
+        () => list.untag('b', 'home'),
+      ];
+      let previous = added.updatedAt;
+      for (const step of steps) {
+        const task = valueOf(step());
+        assert.equal(task.createdAt, added.createdAt);
+        assert.ok(task.updatedAt > previous);
+        previous = task.updatedAt;
+      }
+    });
+
+    it('leaves updatedAt alone when a change is refused', () => {
+      const list = clocked();
+      const added = valueOf(list.add({ title: 'a' }));
