diff --git a/test/rental-cancel.test.mjs b/test/rental-cancel.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..413ae3220efd3a2f98535d95f92319e7ad9713ee
--- /dev/null
+++ b/test/rental-cancel.test.mjs
@@ -0,0 +1,26 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function service() {
+  const rental = createRentalService();
+  rental.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1000 });
+  return rental;
+}
+
+test('cancels a booking and refunds the unused proportion rounded to cents', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' });
+
+  assert.deepEqual(rental.cancel(booking.id, '2026-06-01T12:00:00Z'), { bookingId: booking.id, refund: 1500 });
+  assert.deepEqual(rental.availability({ start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z' }), ['board-1']);
+});
+
+test('rejects a second cancellation and unknown booking IDs', () => {
+  const rental = service();
+  const booking = rental.book({ itemId: 'board-1', start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' });
+  rental.cancel(booking.id, '2026-05-31T00:00:00Z');
+
+  assert.throws(() => rental.cancel(booking.id, '2026-05-31T01:00:00Z'), /already cancelled/);
+  assert.throws(() => rental.cancel('missing', '2026-05-31T00:00:00Z'), /Unknown booking/);
+});
