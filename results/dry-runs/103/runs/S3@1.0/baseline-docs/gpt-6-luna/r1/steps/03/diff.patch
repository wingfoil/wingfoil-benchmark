@@ -0,0 +1,38 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+test('applies a 10% discount to rentals of three days or more in quotes and bookings', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 1000 });
+  const request = {
+    itemId: 'board',
+    start: '2026-06-01T00:00:00Z',
+    end: '2026-06-04T00:00:00Z',
+  };
+
+  assert.equal(service.quote(request).total, 2700);
+  assert.equal(service.book(request).total, 2700);
+});
+
+test('does not discount rentals shorter than three days', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail', kind: 'sail', dailyPrice: 1000 });
+
+  assert.equal(service.quote({
+    itemId: 'sail',
+    start: '2026-06-01T00:00:00Z',
+    end: '2026-06-03T00:00:00Z',
+  }).total, 2000);
+});
+
+test('rounds a discounted total to the nearest euro cent', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 101 });
+
+  assert.equal(service.quote({
+    itemId: 'board',
+    start: '2026-06-01T00:00:00Z',
+    end: '2026-06-04T00:00:00Z',
+  }).total, 273);
+});
