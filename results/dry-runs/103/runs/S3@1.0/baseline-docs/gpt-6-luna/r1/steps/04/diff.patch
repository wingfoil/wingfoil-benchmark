+test('prices an hourly rental by the number of exact hours in quotes and bookings', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 5000, hourlyPrice: 700 });
+  const request = {
+    itemId: 'board',
+    start: '2026-06-01T10:00:00Z',
+    end: '2026-06-01T14:00:00Z',
+  };
+
+  assert.equal(service.quote(request).total, 2800);
+  assert.equal(service.book(request).total, 2800);
+});
+
+test('rejects hourly rentals without hourly pricing and periods off an hour boundary', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 5000 });
+  service.addEquipment({ id: 'sail', kind: 'sail', dailyPrice: 5000, hourlyPrice: 300 });
+
+  assert.throws(() => service.quote({
+    itemId: 'board', start: '2026-06-01T10:00:00Z', end: '2026-06-01T11:00:00Z',
