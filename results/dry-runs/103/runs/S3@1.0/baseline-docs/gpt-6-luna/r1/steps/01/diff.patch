+/** A piece of equipment available for rental. Prices are integer euro cents per day. */
+export interface RentalEquipment {
+  id: string;
+  kind: 'board' | 'sail';
+  dailyPrice: number;
+}
+
+/** A UTC, whole-day rental request. `end` is exclusive. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The cost returned for a valid rental request. */
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed reservation. */
+export interface RentalBooking extends RentalQuote {
+  id: string;
+}
+
+/** In-memory operations for equipment quotes and reservations. */
+export interface RentalService {
+  addEquipment(item: RentalEquipment): void;
+  quote(request: RentalRequest): RentalQuote;
+  book(request: RentalRequest): RentalBooking;
+}
+
+function utcMidnight(value: string): number {
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}T00:00:00(?:\.0+)?Z$/.test(value)) {
+    throw new Error('Rental dates must be UTC ISO-8601 timestamps at midnight.');
+  }
+  const time = Date.parse(value);
+  if (!Number.isFinite(time) || new Date(time).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error('Rental dates must be valid UTC dates.');
+  }
+  return time;
+}
+
+/**
+ * Creates an isolated, in-memory rental service. The service validates whole UTC-day periods,
+ * calculates prices in euro cents, and prevents overlapping bookings for the same item.
+ */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, RentalEquipment>();
+  const bookings: RentalBooking[] = [];
+  let nextBookingId = 1;
+
+  function quote(request: RentalRequest): RentalQuote {
+    if (!request || typeof request.itemId !== 'string') {
+      throw new Error('A valid item ID is required.');
+    }
+    const item = equipment.get(request.itemId);
+    if (!item) throw new Error(`Unknown rental item: ${request.itemId}`);
+
+    const start = utcMidnight(request.start);
+    const end = utcMidnight(request.end);
+    if (end <= start) throw new Error('Rental end must be after its start.');
+    const days = (end - start) / 86_400_000;
+    const total = days * item.dailyPrice;
+    if (!Number.isSafeInteger(total)) throw new Error('Rental total exceeds the supported amount.');
+
+    return { itemId: request.itemId, start: request.start, end: request.end, total };
+  }
+
+  return {
+    addEquipment(item: RentalEquipment): void {
+      if (!item || typeof item.id !== 'string' || item.id.length === 0) {
+        throw new Error('Equipment ID must be a non-empty string.');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error('Equipment kind must be board or sail.');
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('Daily price must be a non-negative integer number of euro cents.');
+      }
+      if (equipment.has(item.id)) throw new Error(`Equipment ID already exists: ${item.id}`);
+      equipment.set(item.id, { ...item });
+    },
+
+    quote,
+
+    book(request: RentalRequest): RentalBooking {
+      const priced = quote(request);
+      const start = Date.parse(priced.start);
+      const end = Date.parse(priced.end);
+      if (bookings.some((booking) => booking.itemId === priced.itemId &&
+        start < Date.parse(booking.end) && Date.parse(booking.start) < end)) {
+        throw new Error(`Rental item is already booked for part of this period: ${priced.itemId}`);
+      }
+      const booking: RentalBooking = { id: `booking-${nextBookingId++}`, ...priced };
+      bookings.push(booking);
+      return { ...booking };
+    },
+  };
+}
