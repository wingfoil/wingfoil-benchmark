@@ -0,0 +1,39 @@
+---
+id: task-003-conform-applypatch-validation-and-errors-to-rfc-6902
+type: task
+title: "Conform applyPatch validation and errors to RFC 6902"
+status: approved
+format: 1
+---
+
+## Request
+
+Users of `applyPatch` report that some patches they consider invalid are accepted, that some edge cases
+give unexpected results, and that a failing patch does not always behave as the standard reads. Review how
+patches are checked and applied, and make the behaviour conform to RFC 6902 in every case, errors included.
+
+## Work done
+
+Probed `applyPatch` with inputs outside the standard in a scratch directory. These were accepted, although
+RFC 6902 does not allow them:
+
+- `value` set to `undefined`, `NaN`, `Infinity`, a function or a `Date` (dl-003 checks presence only).
+- A sparse patch array such as `[ , op]`: `map` and `reduce` skip the hole, so it is accepted silently
+  (dl-003 requires each operation to be an object).
+- An operation whose `op`, `path` or `from` is inherited rather than an own member.
+- A sparse array used as a `value`, whose holes survive into the result.
+
+Plan:
+
+- Done: holes and inherited members are rejected (red-first tests, then `Array.from` and `ownMember` in
+  `src/index.ts`).
+- Done after dl-005 was approved: `value` is checked deeply by `isJsonValue`, during validation, so
+  `undefined`, non-finite numbers, functions, non-plain objects and holes throw. Red-first tests were added
+  first.
+- `npm test`: 60 pass, 0 fail. No TypeScript compiler is installed, so `tsc --noEmit` was not run; a Node
+  syntax check passed.
+
+## Open points
+
+- `move` onto its own location reorders object members (`{a,b}` becomes `{b,a}`). The result is equal as
+  JSON, so it is left as it is.
diff --git a/src/index.ts b/src/index.ts
index b44f32a1bbfa8dad1dc954e5edb3c22ab6cfa5df..aaacddafb94dace0066762a7cb1b44a67b0c4e4f 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -67,13 +67,46 @@ export type JsonPatch = JsonPatchOperation[];
 
 const OPERATION_NAMES: readonly string[] = ["add", "remove", "replace", "move", "copy", "test"];
 
+/**
+ * Whether `value` is a JSON value (RFC 8259): null, a boolean, a finite number, a string, an array of
+ * JSON values without holes, or a plain object whose members are JSON values.
+ */
+function isJsonValue(value: unknown): value is JsonValue {
+  if (value === null || typeof value === "string" || typeof value === "boolean") {
+    return true;
+  }
+  if (typeof value === "number") {
+    return Number.isFinite(value);
+  }
+  if (Array.isArray(value)) {
+    // Array.from turns a hole into undefined, which is not a JSON value.
+    return Array.from(value).every(isJsonValue);
+  }
+  if (typeof value === "object") {
+    const prototype = Object.getPrototypeOf(value);
+    const fields = value as Record<string, unknown>;
+    return (
+      (prototype === Object.prototype || prototype === null) &&
+      Object.keys(fields).every((key) => isJsonValue(fields[key]))
+    );
+  }
+  return false;
+}
+
+/** Returns the own member `name` of `fields`, or undefined: a JSON object has no inherited members. */
+function ownMember(fields: Record<string, unknown>, name: string): unknown {
+  return Object.hasOwn(fields, name) ? fields[name] : undefined;
+}
+
 /** Checks that `operation` is a well-formed JSON Patch operation (RFC 6902, section 4). */
 function parseOperation(operation: unknown, index: number): JsonPatchOperation {
   if (typeof operation !== "object" || operation === null || Array.isArray(operation)) {
     throw new Error(`invalid JSON Patch: operation ${index} is not an object`);
   }
   const fields = operation as Record<string, unknown>;
-  const { op, path, from } = fields;
+  const op = ownMember(fields, "op");
+  const path = ownMember(fields, "path");
+  const from = ownMember(fields, "from");
   if (typeof op !== "string" || !OPERATION_NAMES.includes(op)) {
     throw new Error(`invalid JSON Patch: operation ${index} has an unknown "op"`);
   }
@@ -95,7 +128,11 @@ function parseOperation(operation: unknown, index: number): JsonPatchOperation {
   if (!Object.hasOwn(fields, "value")) {
     throw new Error(`invalid JSON Patch: operation ${index} (${op}) needs a "value"`);
   }
-  return { op: name, path, value: fields.value as JsonValue };
+  const value = fields.value;
+  if (!isJsonValue(value)) {
+    throw new Error(`invalid JSON Patch: operation ${index} (${op}) has a "value" that is not JSON`);
+  }
+  return { op: name, path, value };
 }
 
 /** Returns a copy of `value` that shares no arrays or objects with it. */
@@ -258,6 +295,7 @@ export function applyPatch(document: JsonValue, patch: JsonPatch): JsonValue {
   if (!Array.isArray(patch)) {
     throw new Error("invalid JSON Patch: the patch must be an array of operations");
   }
-  const operations = patch.map(parseOperation);
+  // Array.from, unlike map, visits a hole as undefined, so a hole is rejected rather than skipped.
+  const operations = Array.from(patch, parseOperation);
   return operations.reduce<JsonValue>(applyOperation, clone(document));
 }
