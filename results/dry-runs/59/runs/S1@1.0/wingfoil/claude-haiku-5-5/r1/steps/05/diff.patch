@@ -0,0 +1,36 @@
+---
+id: task-005-implement-createpatch-to-produce-a-minimal-json-patch-between-two-documents
+type: task
+title: "Implement createPatch to produce a minimal JSON Patch between two documents"
+status: pending
+format: 1
+---
+
+## Request
+
+Clients want to send only what changed between two versions of a JSON document, not the whole new
+version. Export `createPatch(from, to)` from `src/index.ts`. It returns a JSON Patch (RFC 6902) that
+turns `from` into `to` when applied, must not mutate either input, and describes what changed and
+nothing more: a small change in a large document must not produce a patch that replaces the whole
+document.
+
+## Work done
+
+- Decisions recorded: dl-009 (recursion into objects and arrays, so the patch describes only what
+  changed) and dl-010 (arrays are compared after stripping the common prefix and suffix).
+- Red first: `test/create-patch.test.ts` added with 19 tests (equal documents, primitive, member add and
+  remove, deep change, kind change, root replacement, array append, insert, remove and change, key
+  escaping, a one-field change in a 1000-item document, non-mutation, no shared structure, round trip
+  through `applyPatch`, and a `__proto__` member). Run before the implementation: the import failed, as
+  `createPatch` did not exist.
+- Implemented `createPatch` in `src/index.ts`, with private `diff`, `diffObjects`, `diffArrays` and
+  `escapeToken` helpers. It reuses `clone`, `jsonEqual` and `isObject` from the existing code.
+- `npm test`: 97 pass, 0 fail (78 existing and 19 new).
+
+## Open points
+
+- No TypeScript compiler is installed, so `tsc --noEmit` was not run; the tests run through Node's
+  type stripping, which does not type-check.
+- Arrays are compared by prefix, suffix and index (dl-010), not by an optimal diff, so several scattered
+  changes inside one array can give more operations than the minimum.
+- Approval of this task and of dl-009 and dl-010 is pending.
diff --git a/src/index.ts b/src/index.ts
index 0de923cdecafab464cc6c77d25bc5a442f746750..0f29cdc06e495efef1dc19268d35478bb349f563 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -331,3 +331,89 @@ export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue
   }
   return mergePatch(clone(target), patch);
 }
+
+/** Escapes a member name as a reference token of a JSON Pointer (RFC 6901, section 3). */
+function escapeToken(name: string): string {
+  return name.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/**
+ * Compares two arrays (dl-010): the common prefix and suffix are skipped, and the middle parts are
+ * compared by index. Operations are emitted in ascending index order, so each one leaves the
+ * positions before it correct.
+ */
+function diffArrays(from: JsonValue[], to: JsonValue[], pointer: string): JsonPatch {
+  let prefix = 0;
+  while (prefix < from.length && prefix < to.length && jsonEqual(from[prefix], to[prefix])) {
+    prefix++;
+  }
+  let suffix = 0;
+  while (
+    suffix < from.length - prefix &&
+    suffix < to.length - prefix &&
+    jsonEqual(from[from.length - 1 - suffix], to[to.length - 1 - suffix])
+  ) {
+    suffix++;
+  }
+  const fromMiddle = from.slice(prefix, from.length - suffix);
+  const toMiddle = to.slice(prefix, to.length - suffix);
+  const shared = Math.min(fromMiddle.length, toMiddle.length);
+  const patch: JsonPatch = [];
+  for (let i = 0; i < shared; i++) {
+    patch.push(...diff(fromMiddle[i], toMiddle[i], `${pointer}/${prefix + i}`));
+  }
+  // Each removal at the same index brings the next extra element into it.
+  for (let i = shared; i < fromMiddle.length; i++) {
+    patch.push({ op: "remove", path: `${pointer}/${prefix + shared}` });
+  }
+  for (let i = shared; i < toMiddle.length; i++) {
+    patch.push({ op: "add", path: `${pointer}/${prefix + i}`, value: clone(toMiddle[i]) });
+  }
+  return patch;
+}
+
+/** Compares two objects member by member: removed and added members, and recursion into shared ones. */
+function diffObjects(
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  pointer: string,
+): JsonPatch {
+  const patch: JsonPatch = [];
+  for (const name of Object.keys(from)) {
+    if (!Object.hasOwn(to, name)) {
+      patch.push({ op: "remove", path: `${pointer}/${escapeToken(name)}` });
+    }
+  }
+  for (const name of Object.keys(to)) {
+    const location = `${pointer}/${escapeToken(name)}`;
+    if (Object.hasOwn(from, name)) {
+      patch.push(...diff(from[name], to[name], location));
+    } else {
+      patch.push({ op: "add", path: location, value: clone(to[name]) });
+    }
+  }
+  return patch;
+}
+
+/** Returns the operations that turn `from` into `to`, at the location `pointer` (see createPatch). */
+function diff(from: JsonValue, to: JsonValue, pointer: string): JsonPatch {
+  if (jsonEqual(from, to)) {
+    return [];
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    return diffArrays(from, to, pointer);
+  }
+  if (isObject(from) && isObject(to)) {
+    return diffObjects(from, to, pointer);
+  }
+  return [{ op: "replace", path: pointer, value: clone(to) }];
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`. The patch
+ * describes only what changed, so equal documents give an empty patch and a change in one place gives
+ * operations at that place alone. Neither input is mutated, and the patch shares no structure with them.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatch {
+  return diff(from, to, "");
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..97b28a0cf16e6732d0b81eb70ae1b920133a72b8
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,135 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+test("createPatch returns an empty patch for equal documents", () => {
+  assert.deepEqual(createPatch({ a: [1, { b: "x" }] }, { a: [1, { b: "x" }] }), []);
+  assert.deepEqual(createPatch(1, 1), []);
+});
+
+test("createPatch describes a changed primitive member with one replace", () => {
+  assert.deepEqual(createPatch({ a: 1, b: 2 }, { a: 1, b: 3 }), [
+    { op: "replace", path: "/b", value: 3 },
+  ]);
+});
+
+test("createPatch adds a member that only the new document has", () => {
+  assert.deepEqual(createPatch({ a: 1 }, { a: 1, b: null }), [{ op: "add", path: "/b", value: null }]);
+});
+
+test("createPatch removes a member that only the old document has", () => {
+  assert.deepEqual(createPatch({ a: 1, b: 2 }, { a: 1 }), [{ op: "remove", path: "/b" }]);
+});
+
+test("createPatch reaches a change at depth with one operation at that location", () => {
+  const from = { a: { b: { c: [1, 2, { d: "old" }] } } };
+  const to = { a: { b: { c: [1, 2, { d: "new" }] } } };
+  assert.deepEqual(createPatch(from, to), [{ op: "replace", path: "/a/b/c/2/d", value: "new" }]);
+});
+
+test("createPatch replaces the whole value when its kind changes", () => {
+  assert.deepEqual(createPatch({ a: [1] }, { a: { x: 1 } }), [{ op: "replace", path: "/a", value: { x: 1 } }]);
+  assert.deepEqual(createPatch({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+});
+
+test("createPatch replaces the root with the empty path when the root changes kind", () => {
+  assert.deepEqual(createPatch([1], "x"), [{ op: "replace", path: "", value: "x" }]);
+  assert.deepEqual(createPatch({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+});
+
+test("createPatch names a changed array element without touching the others", () => {
+  assert.deepEqual(createPatch({ a: [1, 2, 3] }, { a: [1, 9, 3] }), [
+    { op: "replace", path: "/a/1", value: 9 },
+  ]);
+});
+
+test("createPatch appends elements that the new array adds at the end", () => {
+  assert.deepEqual(createPatch({ a: [1] }, { a: [1, 2, 3] }), [
+    { op: "add", path: "/a/1", value: 2 },
+    { op: "add", path: "/a/2", value: 3 },
+  ]);
+});
+
+test("createPatch removes trailing elements that the new array lacks", () => {
+  assert.deepEqual(createPatch({ a: [1, 2, 3] }, { a: [1] }), [
+    { op: "remove", path: "/a/1" },
+    { op: "remove", path: "/a/1" },
+  ]);
+});
+
+test("createPatch inserts one element into the middle of an array with one operation", () => {
+  assert.deepEqual(createPatch({ a: [1, 2, 3, 4] }, { a: [1, 2, 9, 3, 4] }), [
+    { op: "add", path: "/a/2", value: 9 },
+  ]);
+});
+
+test("createPatch removes one element from the middle of an array with one operation", () => {
+  assert.deepEqual(createPatch({ a: [1, 2, 3, 4] }, { a: [1, 3, 4] }), [{ op: "remove", path: "/a/1" }]);
+});
+
+test("createPatch copes with arrays of objects when an element is added at the front", () => {
+  const from = [{ id: 1 }, { id: 2 }];
+  const to = [{ id: 0 }, { id: 1 }, { id: 2 }];
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.ok(patch.length <= 2);
+});
+
+test("createPatch escapes ~ and / in member names as RFC 6901 requires", () => {
+  assert.deepEqual(createPatch({ "a/b": 1, "c~d": 1 }, { "a/b": 2, "c~d": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/c~0d", value: 2 },
+  ]);
+});
+
+test("createPatch describes a one-field change in a large document with a small patch", () => {
+  const from = { items: Array.from({ length: 1000 }, (_, i) => ({ id: i, name: `item ${i}` })) };
+  const to = structuredClone(from);
+  to.items[500].name = "changed";
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [{ op: "replace", path: "/items/500/name", value: "changed" }]);
+});
+
+test("createPatch does not mutate either input", () => {
+  const from = { a: [1, { b: 2 }], c: "x" };
+  const to = { a: [1, { b: 3 }, 4], d: { e: [5] } };
+  const fromBefore = structuredClone(from);
+  const toBefore = structuredClone(to);
+  createPatch(from, to);
+  assert.deepEqual(from, fromBefore);
+  assert.deepEqual(to, toBefore);
+});
+
+test("createPatch shares no arrays or objects with the inputs", () => {
+  const from = { a: 1 };
+  const to = { a: { deep: [1] } };
+  const patch = createPatch(from, to);
+  const value = patch[0].op === "replace" ? (patch[0].value as { deep: number[] }) : undefined;
+  assert.ok(value);
+  assert.notEqual(value, to.a);
+  value.deep.push(2);
+  assert.deepEqual(to.a, { deep: [1] });
+});
+
+test("createPatch output applied to the old document gives the new document", () => {
+  const cases: [unknown, unknown][] = [
+    [{ a: 1, b: [1, 2, 3], c: { d: null } }, { a: 2, b: [0, 2], c: { d: [true] }, e: "x" }],
+    [[{ x: 1 }, { x: 2 }], [{ x: 2 }, { x: 1 }]],
+    [[], [1, [2, 3], { a: null }]],
+    [{ "~/": [1, 2] }, { "~/": [] }],
+    [null, { a: 1 }],
+  ];
+  for (const [from, to] of cases) {
+    const patch = createPatch(from as never, to as never);
+    assert.deepEqual(applyPatch(from as never, patch), to);
+  }
+});
+
+test("createPatch treats a __proto__ member as ordinary data", () => {
+  const from = JSON.parse('{"a": 1}');
+  const to = JSON.parse('{"a": 1, "__proto__": {"polluted": true}}');
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [{ op: "add", path: "/__proto__", value: { polluted: true } }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.equal(({} as { polluted?: boolean }).polluted, undefined);
+});
