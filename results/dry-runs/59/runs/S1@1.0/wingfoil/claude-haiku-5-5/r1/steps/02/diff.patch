@@ -0,0 +1,240 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("add sets a new object member", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/b", value: 2 }]), { a: 1, b: 2 });
+});
+
+test("add replaces an existing object member", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+});
+
+test("add inserts into an array, shifting later elements", () => {
+  assert.deepEqual(applyPatch({ a: [1, 3] }, [{ op: "add", path: "/a/1", value: 2 }]), { a: [1, 2, 3] });
+});
+
+test("add appends to an array with the - token", () => {
+  assert.deepEqual(applyPatch({ a: [1] }, [{ op: "add", path: "/a/-", value: 2 }]), { a: [1, 2] });
+});
+
+test("add accepts an index equal to the array length, and rejects a larger one", () => {
+  assert.deepEqual(applyPatch({ a: [1] }, [{ op: "add", path: "/a/1", value: 2 }]), { a: [1, 2] });
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/2", value: 2 }]), Error);
+});
+
+test("add treats - as an ordinary member name in an object", () => {
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/-", value: 1 }]), { "-": 1 });
+});
+
+test("add with the empty path replaces the whole document", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+});
+
+test("add throws when the parent location does not exist", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a/b", value: 1 }]), Error);
+});
+
+test("remove deletes an object member", () => {
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+});
+
+test("remove deletes an array element, shifting later elements", () => {
+  assert.deepEqual(applyPatch({ a: [1, 2, 3] }, [{ op: "remove", path: "/a/0" }]), { a: [2, 3] });
+});
+
+test("remove throws when the target does not exist", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "/b" }]), Error);
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "remove", path: "/a/-" }]), Error);
+});
+
+test("remove throws for the whole document, which cannot be left empty", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]), Error);
+});
+
+test("replace changes an existing value", () => {
+  assert.deepEqual(applyPatch({ a: [1, 2] }, [{ op: "replace", path: "/a/1", value: "x" }]), {
+    a: [1, "x"],
+  });
+});
+
+test("replace with the empty path replaces the whole document", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: null }]), null);
+});
+
+test("replace throws when the target does not exist", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "replace", path: "/b", value: 2 }]), Error);
+});
+
+test("move removes the source and adds its value at the target", () => {
+  assert.deepEqual(applyPatch({ a: { x: 1 }, b: {} }, [{ op: "move", from: "/a", path: "/b/c" }]), {
+    b: { c: { x: 1 } },
+  });
+});
+
+test("move from an array element shifts the array", () => {
+  assert.deepEqual(applyPatch({ a: [1, 2, 3] }, [{ op: "move", from: "/a/0", path: "/a/2" }]), {
+    a: [2, 3, 1],
+  });
+});
+
+test("move to the same location leaves the document unchanged", () => {
+  assert.deepEqual(applyPatch({ a: [1, 2] }, [{ op: "move", from: "/a/0", path: "/a/0" }]), {
+    a: [1, 2],
+  });
+});
+
+test("move throws when the source does not exist", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "/b", path: "/c" }]), Error);
+});
+
+test("move throws when the target is inside the source", () => {
+  assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]), Error);
+});
+
+test("copy adds a copy of the source and keeps the source", () => {
+  assert.deepEqual(applyPatch({ a: [1], b: 2 }, [{ op: "copy", from: "/a", path: "/c" }]), {
+    a: [1],
+    b: 2,
+    c: [1],
+  });
+});
+
+test("copy throws when the source does not exist", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", from: "/b", path: "/c" }]), Error);
+});
+
+test("test passes when the value is equal, ignoring object key order", () => {
+  const document = { a: { x: 1, y: [null, "s"] } };
+  assert.deepEqual(
+    applyPatch(document, [{ op: "test", path: "/a", value: { y: [null, "s"], x: 1 } }]),
+    document,
+  );
+});
+
+test("test throws when the value differs, including by type", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]), Error);
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "test", path: "/a", value: [1, 2] }]), Error);
+});
+
+test("test throws when the target does not exist", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/b", value: 1 }]), Error);
+});
+
+test("a failing test stops the patch", () => {
+  assert.throws(
+    () =>
+      applyPatch({ a: 1 }, [
+        { op: "test", path: "/a", value: 2 },
+        { op: "add", path: "/b", value: 1 },
+      ]),
+    Error,
+  );
+});
+
+test("operations apply in order", () => {
+  assert.deepEqual(
+    applyPatch({ a: 1 }, [
+      { op: "add", path: "/b", value: 2 },
+      { op: "move", from: "/b", path: "/c" },
+      { op: "replace", path: "/a", value: 3 },
+    ]),
+    { a: 3, c: 2 },
+  );
+});
+
+test("an empty patch returns a copy of the document", () => {
+  const document = { a: [1] };
+  const result = applyPatch(document, []);
+  assert.deepEqual(result, document);
+  assert.notEqual(result, document);
+});
+
+test("does not mutate the input document", () => {
+  const document = { a: { b: [1, 2] }, c: 3 };
+  const snapshot = structuredClone(document);
+  applyPatch(document, [
+    { op: "add", path: "/a/b/-", value: 4 },
+    { op: "remove", path: "/c" },
+    { op: "replace", path: "/a/b/0", value: 9 },
+    { op: "move", from: "/a/b/1", path: "/d" },
+    { op: "copy", from: "/a", path: "/e" },
+  ]);
+  assert.deepEqual(document, snapshot);
+});
+
+test("a failed patch throws and leaves the input document unchanged", () => {
+  const document = { a: [1] };
+  assert.throws(
+    () =>
+      applyPatch(document, [
+        { op: "add", path: "/a/-", value: 2 },
+        { op: "remove", path: "/missing" },
+      ]),
+    Error,
+  );
+  assert.deepEqual(document, { a: [1] });
+});
+
+test("the result does not share structure with the patch value", () => {
+  const value = { x: [1] };
+  const result = applyPatch({}, [{ op: "add", path: "/a", value }]) as { a: { x: number[] } };
+  value.x.push(2);
+  assert.deepEqual(result, { a: { x: [1] } });
+});
+
+test("copy produces an independent value", () => {
+  const result = applyPatch({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }]) as {
+    a: { x: number };
+    b: { x: number };
+  };
+  result.b.x = 2;
+  assert.equal(result.a.x, 1);
+});
+
+test("an own __proto__ member is set as data, not as the prototype", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as Record<
+    string,
+    unknown
+  >;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+test("throws when the patch is not an array", () => {
+  assert.throws(() => applyPatch({}, { op: "add", path: "/a", value: 1 } as never), Error);
+});
+
+test("throws for an unknown operation", () => {
+  assert.throws(() => applyPatch({}, [{ op: "set", path: "/a", value: 1 }] as never), Error);
+});
+
+test("throws when an operation is not an object", () => {
+  assert.throws(() => applyPatch({}, [null] as never), Error);
+});
+
+test("throws when path is missing or not a valid JSON Pointer", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", value: 1 }] as never), Error);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "a" }]), Error);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "/a~2" }]), Error);
+});
+
+test("throws when add, replace or test has no value", () => {
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }] as never), Error);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "replace", path: "/a" }] as never), Error);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a" }] as never), Error);
+});
+
+test("accepts a null value", () => {
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a", value: null }]), { a: null });
+});
+
+test("throws when move or copy has no from", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", path: "/b" }] as never), Error);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", path: "/b" }] as never), Error);
+});
+
+test("throws when from is not a valid JSON Pointer", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", from: "a", path: "/b" }]), Error);
+});
