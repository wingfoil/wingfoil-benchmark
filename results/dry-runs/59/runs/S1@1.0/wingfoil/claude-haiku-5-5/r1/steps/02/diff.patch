index ee63a1d27ea28ab359ce5c2771d08584636f040c..b44f32a1bbfa8dad1dc954e5edb3c22ab6cfa5df 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -55,3 +55,209 @@ export function resolvePointer(document: JsonValue, pointer: string): JsonValue
     document,
   );
 }
+
+/** One operation of a JSON Patch (RFC 6902, section 4). */
+export type JsonPatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; from: string; path: string };
+
+/** A JSON Patch: operations applied in order (RFC 6902, section 3). */
+export type JsonPatch = JsonPatchOperation[];
+
+const OPERATION_NAMES: readonly string[] = ["add", "remove", "replace", "move", "copy", "test"];
+
+/** Checks that `operation` is a well-formed JSON Patch operation (RFC 6902, section 4). */
+function parseOperation(operation: unknown, index: number): JsonPatchOperation {
+  if (typeof operation !== "object" || operation === null || Array.isArray(operation)) {
+    throw new Error(`invalid JSON Patch: operation ${index} is not an object`);
+  }
+  const fields = operation as Record<string, unknown>;
+  const { op, path, from } = fields;
+  if (typeof op !== "string" || !OPERATION_NAMES.includes(op)) {
+    throw new Error(`invalid JSON Patch: operation ${index} has an unknown "op"`);
+  }
+  if (typeof path !== "string") {
+    throw new Error(`invalid JSON Patch: operation ${index} (${op}) needs a string "path"`);
+  }
+  parsePointer(path);
+  const name = op as JsonPatchOperation["op"];
+  if (name === "remove") {
+    return { op: name, path };
+  }
+  if (name === "move" || name === "copy") {
+    if (typeof from !== "string") {
+      throw new Error(`invalid JSON Patch: operation ${index} (${op}) needs a string "from"`);
+    }
+    parsePointer(from);
+    return { op: name, from, path };
+  }
+  if (!Object.hasOwn(fields, "value")) {
+    throw new Error(`invalid JSON Patch: operation ${index} (${op}) needs a "value"`);
+  }
+  return { op: name, path, value: fields.value as JsonValue };
+}
+
+/** Returns a copy of `value` that shares no arrays or objects with it. */
+function clone(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(clone);
+  }
+  if (value !== null && typeof value === "object") {
+    return Object.fromEntries(Object.entries(value).map(([key, member]) => [key, clone(member)]));
+  }
+  return value;
+}
+
+/** Whether two JSON values are equal: arrays by order, objects by members regardless of order. */
+function jsonEqual(a: JsonValue, b: JsonValue): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) &&
+      Array.isArray(b) &&
+      a.length === b.length &&
+      a.every((item, i) => jsonEqual(item, b[i]))
+    );
+  }
+  if (a !== null && typeof a === "object" && b !== null && typeof b === "object") {
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.hasOwn(b, key) && jsonEqual(a[key], b[key]))
+    );
+  }
+  return a === b;
+}
+
+function isObject(value: JsonValue): value is { [key: string]: JsonValue } {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+/** Sets an own member. `defineProperty` keeps a name such as "__proto__" a data member. */
+function defineMember(target: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(target, key, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
+
+/** Returns the unescaped last reference token of a non-empty pointer. */
+function lastToken(pointer: string): string {
+  const tokens = parsePointer(pointer);
+  return tokens[tokens.length - 1];
+}
+
+/** Returns the value that holds the location `pointer` names, which must be an object or array. */
+function containerOf(document: JsonValue, pointer: string): JsonValue {
+  return resolvePointer(document, pointer.slice(0, pointer.lastIndexOf("/")));
+}
+
+/** Adds `value` at `pointer`, inserting into arrays (RFC 6902, section 4.1). Mutates `document`. */
+function add(document: JsonValue, pointer: string, value: JsonValue): JsonValue {
+  if (pointer === "") {
+    return value;
+  }
+  const container = containerOf(document, pointer);
+  const token = lastToken(pointer);
+  if (Array.isArray(container)) {
+    if (token === "-") {
+      container.push(value);
+    } else if (ARRAY_INDEX.test(token) && Number(token) <= container.length) {
+      container.splice(Number(token), 0, value);
+    } else {
+      throw new Error(`JSON Patch "${pointer}" does not apply: "${token}" is not an array index`);
+    }
+  } else if (isObject(container)) {
+    defineMember(container, token, value);
+  } else {
+    throw new Error(`JSON Patch "${pointer}" does not apply: its parent is not a container`);
+  }
+  return document;
+}
+
+/** Removes the value at `pointer` (RFC 6902, section 4.2). Mutates `document`. */
+function remove(document: JsonValue, pointer: string): JsonValue {
+  if (pointer === "") {
+    throw new Error("JSON Patch does not apply: the whole document cannot be removed");
+  }
+  resolvePointer(document, pointer);
+  const container = containerOf(document, pointer);
+  const token = lastToken(pointer);
+  if (Array.isArray(container)) {
+    container.splice(Number(token), 1);
+  } else if (isObject(container)) {
+    delete container[token];
+  }
+  return document;
+}
+
+/**
+ * Replaces the value at `pointer`, which must exist (RFC 6902, section 4.3). Mutates `document`.
+ */
+function replace(document: JsonValue, pointer: string, value: JsonValue): JsonValue {
+  if (pointer === "") {
+    return value;
+  }
+  resolvePointer(document, pointer);
+  const container = containerOf(document, pointer);
+  const token = lastToken(pointer);
+  if (Array.isArray(container)) {
+    container[Number(token)] = value;
+  } else if (isObject(container)) {
+    defineMember(container, token, value);
+  }
+  return document;
+}
+
+/** Whether `from` is a proper prefix of `path`, so that moving `from` would move it into itself. */
+function isProperPrefix(from: string, path: string): boolean {
+  const fromTokens = parsePointer(from);
+  const pathTokens = parsePointer(path);
+  return (
+    fromTokens.length < pathTokens.length &&
+    fromTokens.every((token, i) => token === pathTokens[i])
+  );
+}
+
+/** Applies one operation (RFC 6902, section 4), returning the resulting document. */
+function applyOperation(document: JsonValue, operation: JsonPatchOperation): JsonValue {
+  switch (operation.op) {
+    case "add":
+      return add(document, operation.path, clone(operation.value));
+    case "remove":
+      return remove(document, operation.path);
+    case "replace":
+      return replace(document, operation.path, clone(operation.value));
+    case "move": {
+      if (isProperPrefix(operation.from, operation.path)) {
+        throw new Error(
+          `JSON Patch does not apply: "${operation.from}" cannot be moved into "${operation.path}"`,
+        );
+      }
+      const value = clone(resolvePointer(document, operation.from));
+      return add(remove(document, operation.from), operation.path, value);
+    }
+    case "copy":
+      return add(document, operation.path, clone(resolvePointer(document, operation.from)));
+    case "test":
+      if (!jsonEqual(resolvePointer(document, operation.path), operation.value)) {
+        throw new Error(`JSON Patch test failed at "${operation.path}"`);
+      }
+      return document;
+  }
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the resulting document. The input is
+ * not mutated: the result is a new value. Throws if the patch is invalid or if an operation fails,
+ * in which case no result is returned.
+ */
+export function applyPatch(document: JsonValue, patch: JsonPatch): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("invalid JSON Patch: the patch must be an array of operations");
+  }
+  const operations = patch.map(parseOperation);
+  return operations.reduce<JsonValue>(applyOperation, clone(document));
+}
