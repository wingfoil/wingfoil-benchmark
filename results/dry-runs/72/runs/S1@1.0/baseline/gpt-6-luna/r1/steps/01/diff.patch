+/**
+ * Resolve a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * The empty pointer identifies the document itself. All other pointers are
+ * slash-prefixed paths whose reference tokens are decoded using ~1 and ~0.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new TypeError("JSON Pointer must be a string");
+  }
+
+  if (pointer === "") return document;
+  if (!pointer.startsWith("/")) {
+    throw new Error("Invalid JSON Pointer: a non-empty pointer must start with '/'");
+  }
+
+  const tokens = pointer.slice(1).split("/").map((token) => {
+    if (/~(?:[^01]|$)/.test(token)) {
+      throw new Error("Invalid JSON Pointer escape sequence");
+    }
+    // Decode in one pass so ~01 correctly becomes the literal string ~1.
+    return token.replace(/~[01]/g, (escape) => (escape === "~1" ? "/" : "~"));
+  });
+
+  let value: unknown = document;
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      // RFC 6901 array indices are unsigned decimal integers without leading
+      // zeroes, except for the index "0" itself. '-' never resolves a value.
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`JSON Pointer does not resolve: invalid array index '${token}'`);
+      }
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= value.length) {
+        throw new Error(`JSON Pointer does not resolve: array index '${token}' is out of range`);
+      }
+      value = value[index];
+    } else if (value !== null && typeof value === "object") {
+      if (!Object.prototype.hasOwnProperty.call(value, token)) {
+        throw new Error(`JSON Pointer does not resolve: object member '${token}' does not exist`);
+      }
+      value = (value as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer does not resolve at '${token}'`);
+    }
+  }
+
+  return value;
+}
