diff --git a/src/rental.test.ts b/src/rental.test.ts
index e44e1920242c96806ae21ccb929c0f397f7a4693..c1295408e43d575fb49e0eaee3a97a26985570d4 100644
--- a/src/rental.test.ts
+++ b/src/rental.test.ts
@@ -67,3 +67,49 @@ test('a refused booking leaves state unchanged', () => {
   assert.throws(() => service.book({ itemId: 'b1', start: day(3), end: day(8) }));
   assert.doesNotThrow(() => service.book({ itemId: 'b1', start: day(4), end: day(8) }));
 });
+
+function stocked() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  service.book({ itemId: 'b1', start: day(1), end: day(4) });
+  return service;
+}
+
+test('availability lists free items of any kind, sorted', () => {
+  const service = stocked();
+  assert.deepEqual(service.availability({ start: day(2), end: day(3) }), ['b2', 's1']);
+  assert.deepEqual(service.availability({ start: day(10), end: day(11) }), ['b1', 'b2', 's1']);
+});
+
+test('availability filters by kind', () => {
+  const service = stocked();
+  assert.deepEqual(service.availability({ start: day(2), end: day(3), kind: 'board' }), ['b2']);
+  assert.deepEqual(service.availability({ start: day(2), end: day(3), kind: 'sail' }), ['s1']);
+});
+
+test('availability excludes partial overlaps but not touching periods', () => {
+  const service = stocked();
+  assert.ok(!service.availability({ start: day(3), end: day(6) }).includes('b1'));
+  assert.ok(!service.availability({ start: day(0 + 1), end: day(2) }).includes('b1'));
+  assert.ok(service.availability({ start: day(4), end: day(6) }).includes('b1'));
+});
+
+test('availability returns an empty list when nothing is free or matches', () => {
+  const service = createRentalService();
+  assert.deepEqual(service.availability({ start: day(1), end: day(2) }), []);
+  service.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 100 });
+  service.book({ itemId: 'b1', start: day(1), end: day(4) });
+  assert.deepEqual(service.availability({ start: day(2), end: day(3), kind: 'board' }), []);
+  assert.deepEqual(service.availability({ start: day(2), end: day(3), kind: 'sail' }), []);
+});
+
+test('availability rejects invalid periods and kinds, and does not reserve', () => {
+  const service = stocked();
+  assert.throws(() => service.availability({ start: '2026-07-01T09:00:00Z', end: day(2) }));
+  assert.throws(() => service.availability({ start: day(2), end: day(2) }));
+  assert.throws(() => service.availability({ start: day(2), end: day(3), kind: 'kayak' as never }));
+  service.availability({ start: day(10), end: day(12) });
+  assert.doesNotThrow(() => service.book({ itemId: 'b2', start: day(10), end: day(12) }));
+});
