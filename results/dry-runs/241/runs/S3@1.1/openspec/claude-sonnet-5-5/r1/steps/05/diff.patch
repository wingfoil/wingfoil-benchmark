+}
+
+function parseUtc(value: unknown, name: string): number {
+  const ms = parseInstant(value, name);
   if (ms % HOUR_MS !== 0) throw new Error(`${name} must be on the hour`);
   return ms;
 }
diff --git a/src/rental.test.ts b/src/rental.test.ts
index 96150f74f752b5403d3f2541b10a7fecaf7171ac..b4d9c095e1eb4cf67c17fb2c63fd0799b44280e8 100644
