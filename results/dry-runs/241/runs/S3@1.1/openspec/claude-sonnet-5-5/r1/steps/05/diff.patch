@@ -175,3 +175,42 @@ test('a refused hourly booking reserves nothing', () => {
   assert.doesNotThrow(() => service.book({ itemId: 'd1', start: day(2), end: day(3) }));
   assert.ok(!service.availability({ start: day(2), end: day(3) }).includes('d1'));
 });
+
+test('cancel refunds in full at least 24 hours before start, nothing later', () => {
+  const service = setup();
+  const full = service.book({ itemId: 'b1', start: day(10), end: day(13) });
+  assert.deepEqual(service.cancel(full.id, '2026-07-01T10:00:00Z'), { bookingId: full.id, refund: 6750 });
+  const edge = service.book({ itemId: 'b1', start: day(10), end: day(11) });
+  assert.equal(service.cancel(edge.id, '2026-07-09T00:00:00Z').refund, 2500);
+  const late = service.book({ itemId: 'b1', start: day(10), end: day(11) });
+  assert.equal(service.cancel(late.id, '2026-07-09T00:00:01Z').refund, 0);
+  const after = service.book({ itemId: 'b1', start: day(10), end: day(11) });
+  assert.equal(service.cancel(after.id, '2026-07-12T00:00:00Z').refund, 0);
+});
+
+test('a booking can only be cancelled once', () => {
+  const service = setup();
+  const b = service.book({ itemId: 'b1', start: day(10), end: day(11) });
+  service.cancel(b.id, day(1));
+  assert.throws(() => service.cancel(b.id, day(2)));
+});
+
+test('cancel rejects unknown bookings and invalid times without cancelling', () => {
+  const service = setup();
+  assert.throws(() => service.cancel('nope', day(1)));
+  const b = service.book({ itemId: 'b1', start: day(10), end: day(11) });
+  for (const at of ['tomorrow', '2026-07-01T00:00:00', '2026-07-01T00:00:00+02:00', undefined as never]) {
+    assert.throws(() => service.cancel(b.id, at));
+  }
+  assert.throws(() => service.book({ itemId: 'b1', start: day(10), end: day(11) }));
+  assert.deepEqual(service.cancel(b.id, day(1)), { bookingId: b.id, refund: 2500 });
+});
+
+test('a cancelled booking frees its period for book and availability', () => {
+  const service = setup();
+  const b = service.book({ itemId: 'b1', start: day(1), end: day(4) });
+  assert.ok(!service.availability({ start: day(2), end: day(3) }).includes('b1'));
+  service.cancel(b.id, '2026-06-01T00:00:00Z');
+  assert.ok(service.availability({ start: day(2), end: day(3) }).includes('b1'));
+  assert.doesNotThrow(() => service.book({ itemId: 'b1', start: day(2), end: day(3) }));
+});
