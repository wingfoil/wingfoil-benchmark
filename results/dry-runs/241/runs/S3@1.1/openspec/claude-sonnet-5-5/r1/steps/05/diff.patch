-function parseUtc(value: unknown, name: string): number {
+/** Validates an ISO-8601 UTC timestamp (any instant, not only on the hour) and returns epoch milliseconds. */
+export function parseInstant(value: unknown, name: string): number {
   if (typeof value !== 'string' || !UTC_TIMESTAMP.test(value)) {
     throw new Error(`${name} must be an ISO-8601 UTC timestamp ending in Z`);
   }
