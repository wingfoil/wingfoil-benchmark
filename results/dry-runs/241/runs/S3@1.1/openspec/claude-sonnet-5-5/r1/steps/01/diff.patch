@@ -0,0 +1,69 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+const day = (n: number) => `2026-07-${String(n).padStart(2, '0')}T00:00:00Z`;
+
+function setup() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  return service;
+}
+
+test('quote prices whole days in integer cents without reserving', () => {
+  const service = setup();
+  const q = service.quote({ itemId: 'b1', start: day(1), end: day(4) });
+  assert.deepEqual(q, { itemId: 'b1', start: day(1), end: day(4), total: 7500 });
+  assert.doesNotThrow(() => service.book({ itemId: 'b1', start: day(1), end: day(4) }));
+});
+
+test('quote and book reject unknown items and invalid periods', () => {
+  const service = setup();
+  for (const op of [service.quote, service.book]) {
+    assert.throws(() => op({ itemId: 'x', start: day(1), end: day(2) }));
+    assert.throws(() => op({ itemId: 'b1', start: '2026-07-01T09:00:00Z', end: day(2) }));
+    assert.throws(() => op({ itemId: 'b1', start: day(2), end: day(2) }));
+  }
+});
+
+test('addEquipment validates input and duplicate ids', () => {
+  const service = setup();
+  assert.throws(() => service.addEquipment({ id: 'k1', kind: 'kayak' as never, dailyPrice: 100 }));
+  assert.throws(() => service.addEquipment({ id: 'k1', kind: 'board', dailyPrice: 12.5 }));
+  assert.throws(() => service.addEquipment({ id: 'k1', kind: 'board', dailyPrice: -1 }));
+  assert.throws(() => service.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 100 }));
+});
+
+test('book returns a booking with a unique id and the quoted total', () => {
+  const service = setup();
+  const a = service.book({ itemId: 'b1', start: day(1), end: day(4) });
+  const b = service.book({ itemId: 's1', start: day(1), end: day(2) });
+  assert.equal(a.total, 7500);
+  assert.equal(a.itemId, 'b1');
+  assert.equal(a.start, day(1));
+  assert.equal(a.end, day(4));
+  assert.notEqual(a.id, b.id);
+});
+
+test('overlapping bookings of one item are refused', () => {
+  const service = setup();
+  service.book({ itemId: 'b1', start: day(1), end: day(4) });
+  assert.throws(() => service.book({ itemId: 'b1', start: day(3), end: day(6) }));
+  assert.throws(() => service.book({ itemId: 'b1', start: day(2), end: day(3) }));
+  assert.throws(() => service.book({ itemId: 'b1', start: day(1), end: day(10) }));
+});
+
+test('back-to-back bookings and other items are allowed', () => {
+  const service = setup();
+  service.book({ itemId: 'b1', start: day(1), end: day(4) });
+  assert.doesNotThrow(() => service.book({ itemId: 'b1', start: day(4), end: day(6) }));
+  assert.doesNotThrow(() => service.book({ itemId: 's1', start: day(1), end: day(4) }));
+});
+
+test('a refused booking leaves state unchanged', () => {
+  const service = setup();
+  service.book({ itemId: 'b1', start: day(1), end: day(4) });
+  assert.throws(() => service.book({ itemId: 'b1', start: day(3), end: day(8) }));
+  assert.doesNotThrow(() => service.book({ itemId: 'b1', start: day(4), end: day(8) }));
+});
