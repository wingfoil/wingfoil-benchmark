+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { parsePeriod } from './period.ts';
+
+test('accepts a whole-day period and counts days', () => {
+  assert.equal(parsePeriod('2026-07-01T00:00:00Z', '2026-07-04T00:00:00Z').days, 3);
+  assert.equal(parsePeriod('2026-07-01T00:00:00.000Z', '2026-07-02T00:00:00Z').days, 1);
+});
+
+test('rejects times that are not midnight UTC', () => {
+  assert.throws(() => parsePeriod('2026-07-01T10:00:00Z', '2026-07-04T00:00:00Z'));
+  assert.throws(() => parsePeriod('2026-07-01T00:00:00Z', '2026-07-04T00:00:01Z'));
+});
+
+test('rejects empty or reversed periods', () => {
+  assert.throws(() => parsePeriod('2026-07-01T00:00:00Z', '2026-07-01T00:00:00Z'));
+  assert.throws(() => parsePeriod('2026-07-04T00:00:00Z', '2026-07-01T00:00:00Z'));
+});
+
+test('rejects non-UTC, date-only, invalid and non-string input', () => {
+  assert.throws(() => parsePeriod('2026-07-01T00:00:00+02:00', '2026-07-04T00:00:00Z'));
+  assert.throws(() => parsePeriod('2026-07-01T00:00:00', '2026-07-04T00:00:00Z'));
+  assert.throws(() => parsePeriod('2026-07-01', '2026-07-04'));
+  assert.throws(() => parsePeriod('2026-13-01T00:00:00Z', '2026-07-04T00:00:00Z'));
+  assert.throws(() => parsePeriod(undefined, '2026-07-04T00:00:00Z'));
+});
