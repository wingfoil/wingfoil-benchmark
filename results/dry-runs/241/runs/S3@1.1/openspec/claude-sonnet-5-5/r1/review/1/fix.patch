+
+test('rejects impossible calendar dates and hour 24', () => {
+  assert.throws(() => parseInstant('2026-02-30T00:00:00Z', 'at'));
+  assert.throws(() => parseInstant('2026-07-01T24:00:00Z', 'at'));
+  assert.throws(() => parsePeriod('2026-02-30T00:00:00Z', '2026-03-04T00:00:00Z'));
