@@ -8,7 +8,9 @@ export function parseInstant(value: unknown, name: string): number {
     throw new Error(`${name} must be an ISO-8601 UTC timestamp ending in Z`);
   }
   const ms = Date.parse(value);
-  if (Number.isNaN(ms)) throw new Error(`${name} is not a valid date`);
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 19) !== value.slice(0, 19)) {
