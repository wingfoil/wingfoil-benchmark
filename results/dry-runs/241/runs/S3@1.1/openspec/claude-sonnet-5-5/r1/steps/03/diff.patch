+const LONG_STAY_DAYS = 3;
+
+/** Full price, less 10% from 3 days on, rounded half up to the cent. */
+function rentalTotal(dailyPrice: number, days: number): number {
+  const full = dailyPrice * days;
+  return days >= LONG_STAY_DAYS ? Math.floor((full * 9 + 5) / 10) : full;
+}
+
 function isFree(existing: Reserved[], period: Reserved): boolean {
   return !existing.some((r) => period.startMs < r.endMs && r.startMs < period.endMs);
 }
