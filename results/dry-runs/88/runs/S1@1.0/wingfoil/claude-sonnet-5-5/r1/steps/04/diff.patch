+---
+id: task-004-implement-json-merge-patch-rfc-7386-applymergepatch
+type: task
+title: "Implement JSON Merge Patch (RFC 7386) applyMergePatch"
+status: approved
+format: 1
+---
+
+Request: implement JSON Merge Patch (RFC 7386) for clients sending partial updates; export
+`applyMergePatch(target, patch)` from `src/index.ts`, returning the merged document.
+
+Done: `applyMergePatch` in `src/index.ts` (non-mutating, null deletes, non-object patch replaces, safe
+for `__proto__` keys), tests in `test/mergepatch.test.ts` (RFC appendix A cases), README section.
diff --git a/src/index.ts b/src/index.ts
index a4aaace5ee1e3a254777c15b02aee828dea1f329..656ef9da43329ff876f44ed9a950443338ac8346 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -224,3 +224,32 @@ function deepEqual(a: Json, b: Json): boolean {
   const kb = Object.keys(b);
   return ka.length === kb.length && ka.every((k) => has(b, k) && deepEqual((a as any)[k], (b as any)[k]));
 }
+
+function isPlainObject(v: unknown): v is Record<string, unknown> {
+  return typeof v === "object" && v !== null && !Array.isArray(v);
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document.
+ *
+ * @param target - the JSON document to patch; it is never mutated.
+ * @param patch - the merge patch: an object whose `null` members delete and other members merge
+ *   recursively; any non-object patch (including an array) replaces the target.
+ * @returns the merged document, as a new value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isPlainObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result: Record<string, Json> = isPlainObject(target) ? (structuredClone(target) as Record<string, Json>) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = has(result, key) ? result[key] : undefined;
+      setMember(result, key, applyMergePatch(current, value) as Json);
+    }
+  }
+  return result;
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6786e3beba0e9c942d5653663d32695f40352da6
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,39 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch as mp } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, r] of cases) assert.deepEqual(mp(t, p), r);
+});
+
+test("does not mutate inputs and ignores inherited members", () => {
+  const t = { a: { b: 1 } };
+  const p = { a: { c: 2 } };
+  const r = mp(t, p) as any;
+  assert.deepEqual(t, { a: { b: 1 } });
+  assert.deepEqual(p, { a: { c: 2 } });
+  r.a.c = 9;
+  assert.equal(p.a.c, 2);
+  assert.deepEqual(mp({}, { toString: { x: null } }), { toString: {} });
+  const evil = JSON.parse('{"__proto__": {"x": 1}}');
+  const out = mp({}, evil) as any;
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+});
