index 0000000000000000000000000000000000000000..1b2850f8fb4bb5e7d7dca1e7e6a8b274f3985e1e
--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,44 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(a: unknown, b: unknown) {
+  const ca = structuredClone(a);
+  const cb = structuredClone(b);
+  const p = createPatch(a, b);
+  assert.deepEqual(a, ca);
+  assert.deepEqual(b, cb);
+  assert.deepEqual(applyPatch(a, p), b);
+  return p;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small change gives a small patch", () => {
+  const p = roundTrip({ a: { b: 1, c: [1, 2, 3] }, d: "x" }, { a: { b: 1, c: [1, 9, 3] }, d: "x" });
+  assert.deepEqual(p, [{ op: "replace", path: "/a/c/1", value: 9 }]);
+});
+
+test("members and escaping", () => {
+  const p = roundTrip({ "a/b": 1, "~": 2, gone: 3 }, { "a/b": 2, "~": 2, new: [1] });
+  assert.equal(p.length, 3);
+});
+
+test("arrays: insert, delete, append", () => {
+  assert.equal(roundTrip([1, 2, 3, 4], [1, 2, 5, 3, 4]).length, 1);
+  assert.equal(roundTrip([1, 2, 3, 4], [1, 4]).length, 2);
+  roundTrip([1], [1, 2, 3]);
+  roundTrip([], [1]);
+  roundTrip([1, 2, 3], []);
+});
+
+test("type changes and root", () => {
+  roundTrip({ a: 1 }, [1]);
+  roundTrip([1], { a: 1 });
+  roundTrip(null, { a: null });
+  roundTrip({ a: null }, { a: {} });
+  roundTrip(1, 2);
+  roundTrip({ __proto__x: 1 }, JSON.parse('{"__proto__": {"x": 1}}'));
+});
