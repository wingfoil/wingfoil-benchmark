+++ b/src/index.ts
@@ -253,3 +253,51 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diff(from: Json, to: Json, path: string, ops: Record<string, unknown>[]): void {
+  if (deepEqual(from, to)) return;
+  const fromArr = Array.isArray(from);
+  if (fromArr && Array.isArray(to)) {
+    let start = 0;
+    while (start < from.length && start < to.length && deepEqual(from[start], to[start])) start++;
+    let endFrom = from.length;
+    let endTo = to.length;
+    while (endFrom > start && endTo > start && deepEqual(from[endFrom - 1], to[endTo - 1])) {
+      endFrom--;
+      endTo--;
+    }
+    const common = Math.min(endFrom, endTo) - start;
+    for (let i = 0; i < common; i++) diff(from[start + i], to[start + i], `${path}/${start + i}`, ops);
+    for (let i = start + common; i < endFrom; i++) ops.push({ op: "remove", path: `${path}/${start + common}` });
+    for (let i = start + common; i < endTo; i++) ops.push({ op: "add", path: `${path}/${i}`, value: structuredClone(to[i]) });
+  } else if (!fromArr && isPlainObject(from) && isPlainObject(to) && !Array.isArray(to)) {
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const p = `${path}/${escapeToken(key)}`;
+      if (has(from, key)) diff(from[key] as Json, to[key] as Json, p, ops);
+      else ops.push({ op: "add", path: p, value: structuredClone(to[key]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Computes a JSON Patch (RFC 6902) that turns one JSON document into another.
+ *
+ * @param from - the original document; it is never mutated.
+ * @param to - the target document; it is never mutated.
+ * @returns a patch which, applied to `from`, yields a value deeply equal to `to`. It only describes the
+ *   differences: unchanged members and array elements are left out (empty array when equal).
+ */
+export function createPatch(from: unknown, to: unknown): Record<string, unknown>[] {
+  const ops: Record<string, unknown>[] = [];
+  diff(from as Json, to as Json, "", ops);
+  return ops;
+}
