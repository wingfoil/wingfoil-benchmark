@@ -0,0 +1,79 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// The document of RFC 6901, section 5.
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("escape order: ~01 decodes to ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+});
+
+test("null, false and falsy values resolve", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer({ a: false }, "/a"), false);
+  assert.equal(resolvePointer([0], "/0"), 0);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("nested arrays and objects", () => {
+  assert.equal(resolvePointer({ a: [{ b: [1, 2, 3] }] }, "/a/0/b/2"), 3);
+  assert.equal(resolvePointer([[1]], "/0/0"), 1);
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["foo", "a/b", "/a~", "/a~2", "/~x", "~0"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, p), undefined, p);
+  }
+  assert.throws(() => resolvePointer({}, 1 as unknown as string));
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer("str", "/0"));
+  assert.throws(() => resolvePointer("str", "/length"));
+});
+
+test("array index rules", () => {
+  const arr = ["a", "b"];
+  for (const p of ["/2", "/-", "/01", "/+1", "/1.0", "/-1", "/ 1", "/1e0", "/length", "/"]) {
+    assert.throws(() => resolvePointer(arr, p), undefined, p);
+  }
+  assert.throws(() => resolvePointer(arr, "/99999999999999999999"));
+});
+
+test("only own members resolve", () => {
+  for (const p of ["/__proto__", "/constructor", "/toString", "/hasOwnProperty"]) {
+    assert.throws(() => resolvePointer({}, p), undefined, p);
+  }
+  const own = JSON.parse('{"__proto__": 5}');
+  assert.equal(resolvePointer(own, "/__proto__"), 5);
+});
