@@ -0,0 +1,55 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @param document - the JSON document to look into.
+ * @param pointer - a JSON Pointer string: empty (the whole document) or a sequence of `/`-prefixed
+ *   reference tokens, where `~1` stands for `/` and `~0` for `~`.
+ * @returns the value the pointer refers to (which may be `null`).
+ * @throws Error when `pointer` is not a valid JSON Pointer, or does not resolve to a value of
+ *   `document`: missing member, index out of range, `-`, a non-canonical index, or a step into a primitive.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: ${JSON.stringify(pointer)} does not start with "/"`);
+  }
+  let current = document;
+  for (const raw of pointer.slice(1).split("/")) {
+    current = step(current, decodeToken(raw, pointer), pointer);
+  }
+  return current;
+}
+
+function decodeToken(raw: string, pointer: string): string {
+  if (/~(?![01])/.test(raw)) {
+    throw new Error(`Invalid JSON Pointer: ${JSON.stringify(pointer)} has an invalid "~" escape`);
+  }
+  return raw.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function step(current: unknown, token: string, pointer: string): unknown {
+  const unresolved = (why: string): Error =>
+    new Error(`JSON Pointer ${JSON.stringify(pointer)} does not resolve: ${why}`);
+  if (Array.isArray(current)) {
+    if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+      throw unresolved(`${JSON.stringify(token)} is not an array index`);
+    }
+    const index = Number(token);
+    if (index >= current.length) {
+      throw unresolved(`index ${token} is out of range`);
+    }
+    return current[index];
+  }
+  if (typeof current === "object" && current !== null) {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw unresolved(`no member ${JSON.stringify(token)}`);
+    }
+    return (current as Record<string, unknown>)[token];
+  }
+  throw unresolved(`cannot step into a primitive value with ${JSON.stringify(token)}`);
+}
