+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of the import text that could not be added. */
+export interface RejectedLine {
+  /** The line's number in the text, counting from 1. */
+  readonly line: number;
+  /** What was wrong with the line. */
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and the lines that were not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds tasks to a list from text with one task per line, as `title;priority;tags`. The priority may be
+ * empty for a normal one, tags are separated by spaces, and blank lines are skipped. A line that cannot
+ * be added is reported and does not stop the others.
+ *
+ * @param list - the task list to add to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r?\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `the line has ${fields.length} fields; the most is 3 (title;priority;tags)` });
+      return;
+    }
+    const [title = '', priority = '', tags = ''] = fields.map((field) => field.trim());
+    const result = list.add({
+      title,
+      ...(priority === '' ? {} : { priority: priority as Priority }),
+      tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line, reason: result.error.message });
+  });
+  return { imported, rejected };
+}
