+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('imports valid lines, skips blank ones and reports the rest by line number', () => {
+    const list = createTodoList();
+    const text = [
+      'Renew the insurance;high;admin money',
+      '',
+      'Buy milk;;home',
+      'Plain title',
+      'Bad;urgent;x',
+      'Bad tag;low;a;b',
+      ';high;',
+      'Buy milk;low;',
+      '  ',
+      'Tagged;normal;a b',
+    ].join('\r\n');
+    const result = importTasks(list, text);
+    assert.equal(result.imported, 4);
+    assert.deepEqual(
+      result.rejected.map((r) => r.line),
+      [5, 6, 7, 8],
+    );
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok && insurance.value.priority === 'high');
+    assert.ok(insurance.ok && insurance.value.tags.join() === 'admin,money');
+    assert.equal(list.list().length, 4);
+  });
+
+  it('imports nothing from empty text', () => {
+    assert.deepEqual(importTasks(createTodoList(), ''), { imported: 0, rejected: [] });
+  });
+});
