+/** The longest title a task may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a title: after trimming it must not be empty nor longer than 120 characters.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title is empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; the limit is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be `low`, `normal` or `high`.
+ *
+ * @param priority - the priority as given
+ */
+export function validatePriority(priority: unknown): Result<Priority> {
+  if (PRIORITIES.includes(priority as Priority)) return ok(priority as Priority);
+  return err('invalid-input', `the priority ${JSON.stringify(priority)} is not one of ${PRIORITIES.join(', ')}`);
+}
+
+/**
+ * Checks a tag: it must not be empty nor contain a space.
+ *
+ * @param tag - the tag as typed
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'the tag is empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space`);
+  return ok(tag);
+}
+
