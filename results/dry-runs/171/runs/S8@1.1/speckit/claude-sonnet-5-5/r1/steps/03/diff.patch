+describe('input validation', () => {
+  const bad = (result: { ok: boolean; error?: { code: string } }) => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+  };
+
+  it('refuses bad input on add and leaves the list unchanged', () => {
+    const list = createTodoList();
+    bad(list.add({ title: '' }));
+    bad(list.add({ title: '   ' }));
+    bad(list.add({ title: 'x'.repeat(121) }));
+    bad(list.add({ title: 'ok', priority: 'urgent' as never }));
+    bad(list.add({ title: 'ok', tags: ['fine', ''] }));
+    bad(list.add({ title: 'ok', tags: ['two words'] }));
+    assert.equal(list.list().length, 0);
+    assert.equal(valueOf(list.add({ title: 'x'.repeat(120) })).id, 'task-1');
+  });
+
+  it('refuses bad input on rename and tag, changing nothing', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'Task' }));
+    bad(list.rename('Task', ' '));
+    bad(list.rename('Task', 'y'.repeat(121)));
+    bad(list.tag('Task', ''));
+    bad(list.tag('Task', 'a b'));
+    assert.deepEqual(list.list(), [before]);
+  });
+});
