new file mode 100644
index 0000000000000000000000000000000000000000..bd90bdab8a40c2baaed6abea68984300e7f36602
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,56 @@
+/** A JSON value as defined by RFC 8259. */
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+function decodeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function step(current: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token)) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: "${token}" is not an array index`);
+    }
+    const index = Number(token);
+    if (index >= current.length) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: index ${token} is out of range`);
+    }
+    return current[index];
+  }
+  if (typeof current === "object" && current !== null) {
+    if (!Object.hasOwn(current, token)) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: no member "${token}"`);
+    }
+    return (current as Record<string, unknown>)[token];
+  }
+  throw new Error(`JSON Pointer "${pointer}" does not resolve: cannot descend into a primitive at "${token}"`);
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document and returns the referenced value.
+ *
+ * @param document the JSON document to look into.
+ * @param pointer a JSON Pointer string: empty (the whole document) or `/`-prefixed reference tokens.
+ * @throws Error when `pointer` is not a valid JSON Pointer, or does not resolve to a value of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return document;
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+  return tokens.reduce<unknown>((current, token) => step(current, token, pointer), document);
+}
