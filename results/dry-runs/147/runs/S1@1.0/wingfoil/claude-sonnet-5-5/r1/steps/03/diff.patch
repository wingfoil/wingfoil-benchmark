@@ -87,6 +87,31 @@ function jsonEqual(a: unknown, b: unknown): boolean {
   return a === b;
 }
 
+function assertJsonValue(value: unknown, where: string, ancestors: unknown[] = []): void {
+  if (value === null || typeof value === "string" || typeof value === "boolean") return;
+  if (typeof value === "number") {
+    if (Number.isFinite(value)) return;
+    throw new Error(`Invalid JSON Patch: ${where} has a number that is not a JSON value`);
+  }
+  if (typeof value === "object") {
+    if (ancestors.includes(value)) throw new Error(`Invalid JSON Patch: ${where} is circular`);
+    const inner = [...ancestors, value];
+    if (Array.isArray(value)) {
+      for (let i = 0; i < value.length; i++) {
+        if (!(i in value)) throw new Error(`Invalid JSON Patch: ${where} has an array with a hole`);
+        assertJsonValue(value[i], where, inner);
+      }
+      return;
+    }
+    const proto = Object.getPrototypeOf(value);
+    if (proto === Object.prototype || proto === null) {
+      for (const member of Object.values(value)) assertJsonValue(member, where, inner);
+      return;
+    }
+  }
+  throw new Error(`Invalid JSON Patch: ${where} has a value that is not a JSON value`);
+}
