@@ -0,0 +1,49 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+const ok = (target: unknown, patch: unknown, expected: unknown) =>
+  assert.deepEqual(applyMergePatch(target, patch), expected);
+
+test("RFC 7386 appendix A examples", () => {
+  ok({ a: "b" }, { a: "c" }, { a: "c" });
+  ok({ a: "b" }, { b: "c" }, { a: "b", b: "c" });
+  ok({ a: "b" }, { a: null }, {});
+  ok({ a: "b", b: "c" }, { a: null }, { b: "c" });
+  ok({ a: ["b"] }, { a: "c" }, { a: "c" });
+  ok({ a: "c" }, { a: ["b"] }, { a: ["b"] });
+  ok({ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } });
+  ok({ a: [{ b: "c" }] }, { a: [1] }, { a: [1] });
+  ok(["a", "b"], ["c", "d"], ["c", "d"]);
+  ok({ a: "b" }, ["c"], ["c"]);
+  ok({ a: "foo" }, null, null);
+  ok({ a: "foo" }, "bar", "bar");
+  ok({ e: null }, { a: 1 }, { e: null, a: 1 });
+  ok([1, 2], { a: "b", c: null }, { a: "b" });
+  ok({}, { a: { bb: { ccc: null } } }, { a: { bb: {} } });
+});
+
+test("does not mutate or share structure", () => {
+  const target = { a: { b: 1 }, l: [1] };
+  const patch = { a: { c: 2 }, n: { x: [1] } };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 }, l: [1] });
+  assert.deepEqual(patch, { a: { c: 2 }, n: { x: [1] } });
+  result.n.x.push(2);
+  result.l.push(2);
+  assert.deepEqual(patch.n.x, [1]);
+  assert.deepEqual(target.l, [1]);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__": {"x": 1}}')) as any;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.equal(({} as any).x, undefined);
+});
+
+test("rejects non-JSON values", () => {
+  assert.throws(() => applyMergePatch({}, { a: NaN }), Error);
+  assert.throws(() => applyMergePatch({}, undefined), Error);
+  assert.throws(() => applyMergePatch(() => 1, {}), Error);
+});
