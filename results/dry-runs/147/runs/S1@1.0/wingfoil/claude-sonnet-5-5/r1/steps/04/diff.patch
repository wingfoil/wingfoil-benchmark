@@ -229,3 +229,35 @@ export function applyPatch(document: unknown, patch: unknown): JsonValue {
   }
   return result;
 }
+
+function mergeValue(target: unknown, patch: JsonValue): JsonValue {
+  if (!isObject(patch)) return patch;
+  const result: { [key: string]: JsonValue } = isObject(target) ? (target as { [key: string]: JsonValue }) : {};
+  for (const key of Object.keys(patch)) {
+    const member = patch[key];
+    if (member === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, mergeValue(Object.hasOwn(result, key) ? result[key] : undefined, member));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document.
+ *
+ * A patch that is not an object (an array included) replaces the target. An object patch merges into the
+ * target member by member: a `null` member removes it, any other member is merged recursively. Neither
+ * input is mutated and the result shares no structure with them.
+ *
+ * @param target the JSON document to update.
+ * @param patch the JSON Merge Patch.
+ * @returns the merged document, as a new value.
+ * @throws Error when `target` or `patch` is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
+  assertJsonValue(target, "target");
+  assertJsonValue(patch, "patch");
+  return mergeValue(structuredClone(target), structuredClone(patch) as JsonValue);
+}
