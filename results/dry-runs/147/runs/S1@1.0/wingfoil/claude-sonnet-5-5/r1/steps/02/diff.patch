+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) => assert.deepEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch), Error);
+
+test("RFC 6902 appendix A examples", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ foo: "bar", baz: "qux" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  ok({ baz: "qux", foo: ["bar", "baz"] }, [{ op: "copy", from: "/foo/1", path: "/foo/-" }], {
+    baz: "qux",
+    foo: ["bar", "baz", "baz"],
+  });
+  ok({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  });
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/foo", value: null }], { foo: null });
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] });
+  ok({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 });
+  ok({ foo: ["bar", "baz"], "": 0 }, [{ op: "test", path: "/", value: 0 }], { foo: ["bar", "baz"], "": 0 });
+});
+
+test("whole-document operations", () => {
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: 5 }], 5);
+  ok({ a: 1 }, [{ op: "copy", from: "/a", path: "" }], 1);
+  ok({ a: 1 }, [], { a: 1 });
+  bad({ a: 1 }, [{ op: "remove", path: "" }]);
+});
+
+test("operations apply in order and fail atomically", () => {
+  ok({}, [{ op: "add", path: "/a", value: 1 }, { op: "move", from: "/a", path: "/b" }], { b: 1 });
+  const doc = { a: [1] };
+  bad(doc, [{ op: "add", path: "/a/-", value: 2 }, { op: "remove", path: "/zz" }]);
+  assert.deepEqual(doc, { a: [1] });
+});
+
+test("does not mutate or share structure with its inputs", () => {
+  const doc = { a: { b: [1, 2] } };
+  const value = { x: [1] };
+  const out = applyPatch(doc, [
+    { op: "add", path: "/a/b/0", value: 0 },
+    { op: "add", path: "/v", value },
+    { op: "copy", from: "/a", path: "/c" },
+  ]) as any;
+  assert.deepEqual(doc, { a: { b: [1, 2] } });
+  assert.notEqual(out.v, value);
+  assert.notEqual(out.c, out.a);
+  out.v.x.push(2);
+  assert.deepEqual(value, { x: [1] });
+});
+
+test("array index rules", () => {
+  ok([1], [{ op: "add", path: "/1", value: 2 }], [1, 2]);
+  bad([1], [{ op: "add", path: "/2", value: 2 }]);
+  bad([1], [{ op: "add", path: "/01", value: 2 }]);
+  bad([1], [{ op: "add", path: "/x", value: 2 }]);
+  bad([1], [{ op: "remove", path: "/1" }]);
+  bad([1], [{ op: "remove", path: "/-" }]);
+  bad([1], [{ op: "replace", path: "/-", value: 2 }]);
+  bad([1], [{ op: "replace", path: "/1", value: 2 }]);
+});
+
+test("remove, replace, test need an existing target", () => {
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad({}, [{ op: "test", path: "/a", value: 1 }]);
+  bad({}, [{ op: "move", from: "/a", path: "/b" }]);
+  bad({}, [{ op: "copy", from: "/a", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]);
+});
+
+test("move: onto itself is a no-op, into own child fails", () => {
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  ok({ a: 1, b: 2 }, [{ op: "move", from: "/a", path: "/b" }], { b: 1 });
+});
+
+test("test compares JSON values structurally and strictly", () => {
+  ok({ a: { x: 1, y: [1, { z: null }] } }, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }], {
+    a: { x: 1, y: [1, { z: null }] },
+  });
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+  bad({ a: [1, 2] }, [{ op: "test", path: "/a", value: [2, 1] }]);
+  bad({ a: { x: 1 } }, [{ op: "test", path: "/a", value: { x: 1, y: 2 } }]);
+  bad({ a: null }, [{ op: "test", path: "/a", value: {} }]);
+  bad({ a: [] }, [{ op: "test", path: "/a", value: {} }]);
+});
+
+test("invalid patches throw", () => {
+  bad({}, {});
+  bad({}, null);
+  bad({}, [null]);
+  bad({}, [[]]);
+  bad({}, [{ path: "/a", value: 1 }]);
+  bad({}, [{ op: "bogus", path: "/a" }]);
+  bad({}, [{ op: "add", value: 1 }]);
+  bad({}, [{ op: "add", path: 1, value: 1 }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "/a" }]);
+  bad({}, [{ op: "test", path: "/a" }]);
+  bad({ a: 1 }, [{ op: "move", path: "/b" }]);
+  bad({ a: 1 }, [{ op: "copy", path: "/b" }]);
+  bad({}, [{ op: "add", path: "a", value: 1 }]);
+  bad({}, [{ op: "add", path: "/a~2", value: 1 }]);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as any;
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+});
