+
+/** One operation of a JSON Patch document (RFC 6902). */
+export interface PatchOperation {
+  op: "add" | "remove" | "replace" | "move" | "copy" | "test";
+  path: string;
+  value?: JsonValue;
+  from?: string;
+}
+
+type Container = JsonValue[] | { [key: string]: JsonValue };
+
+function isObject(value: unknown): value is { [key: string]: unknown } {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]));
   }
-  if (pointer === "") return document;
-  if (!pointer.startsWith("/")) {
-    throw new Error(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.hasOwn(b, key) && jsonEqual(a[key], b[key]))
+    );
   }
-  const tokens = pointer.slice(1).split("/").map(decodeToken);
-  return tokens.reduce<unknown>((current, token) => step(current, token, pointer), document);
+  return a === b;
+}
+
+function setMember(object: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  // defineProperty keeps a "__proto__" key an ordinary member instead of changing the prototype.
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function parentOf(document: unknown, tokens: string[], path: string): Container {
+  const parent = tokens.slice(0, -1).reduce<unknown>((current, token) => step(current, token, path), document);
+  if (typeof parent !== "object" || parent === null) {
+    throw new Error(`JSON Patch: parent of "${path}" is not an object or array`);
+  }
+  return parent as Container;
+}
+
+function addValue(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(document, tokens, path);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (key === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(key) && Number(key) <= parent.length) {
+      parent.splice(Number(key), 0, value);
+    } else {
+      throw new Error(`JSON Patch: cannot add at "${path}": invalid array index`);
+    }
+  } else {
+    setMember(parent, key, value);
+  }
+  return document;
+}
+
+function removeValue(document: JsonValue, path: string): JsonValue {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) throw new Error("JSON Patch: cannot remove the whole document");
+  resolvePointer(document, path);
+  const parent = parentOf(document, tokens, path);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(Number(key), 1);
+  } else {
+    delete parent[key];
+  }
+  return document;
+}
+
+function requireString(operation: Record<string, unknown>, member: "path" | "from", index: number): string {
+  const value = operation[member];
+  if (typeof value !== "string") {
+    throw new Error(`Invalid JSON Patch: operation ${index} needs a string "${member}"`);
+  }
+  return value;
+}
+
+function applyOperation(document: JsonValue, raw: unknown, index: number): JsonValue {
+  if (!isObject(raw)) throw new Error(`Invalid JSON Patch: operation ${index} is not an object`);
+  const path = requireString(raw, "path", index);
+  const op = raw.op;
+  switch (op) {
+    case "add":
+    case "replace":
+    case "test": {
+      if (!Object.hasOwn(raw, "value") || raw.value === undefined) {
+        throw new Error(`Invalid JSON Patch: operation ${index} needs a "value"`);
+      }
+      const value = structuredClone(raw.value) as JsonValue;
+      if (op === "add") return addValue(document, path, value);
+      if (op === "replace") {
+        resolvePointer(document, path);
+        return parsePointer(path).length === 0 ? value : addValue(removeValue(document, path), path, value);
+      }
+      if (!jsonEqual(resolvePointer(document, path), value)) {
+        throw new Error(`JSON Patch: test failed at "${path}"`);
+      }
+      return document;
+    }
+    case "remove":
+      return removeValue(document, path);
+    case "move":
+    case "copy": {
+      const from = requireString(raw, "from", index);
+      const value = structuredClone(resolvePointer(document, from)) as JsonValue;
+      if (op === "copy") return addValue(document, path, value);
+      const fromTokens = parsePointer(from);
+      const pathTokens = parsePointer(path);
+      if (pathTokens.length > fromTokens.length && fromTokens.every((t, i) => t === pathTokens[i])) {
+        throw new Error(`JSON Patch: cannot move "${from}" into one of its own children`);
+      }
+      if (from === path) return document;
+      return addValue(removeValue(document, from), path, value);
+    }
+    default:
+      throw new Error(`Invalid JSON Patch: operation ${index} has unknown op ${JSON.stringify(op)}`);
+  }
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document.
+ *
+ * Operations apply in order, each to the result of the previous one; the input is never mutated and the
+ * result shares no structure with `document` or `patch`.
+ *
+ * @param document the JSON document to patch.
+ * @param patch an array of operations (`add`, `remove`, `replace`, `move`, `copy`, `test`).
+ * @returns the patched document, as a new value.
+ * @throws Error when `patch` is invalid, or when an operation fails (including a failed `test`).
+ */
+export function applyPatch(document: unknown, patch: unknown): JsonValue {
+  if (!Array.isArray(patch)) throw new Error("Invalid JSON Patch: not an array");
+  let result = structuredClone(document) as JsonValue;
+  patch.forEach((operation, index) => {
+    result = applyOperation(result, operation, index);
+  });
+  return result;
 }
