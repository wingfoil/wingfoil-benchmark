  */
 export function resolvePointer(document: unknown, pointer: string): unknown {
-  if (typeof pointer !== "string") {
-    throw new Error("Invalid JSON Pointer: not a string");
+  return parsePointer(pointer).reduce<unknown>((current, token) => step(current, token, pointer), document);
