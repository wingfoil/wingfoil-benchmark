+
+Export `createPatch(from, to)` from `src/index.ts`: it returns a minimal-ish JSON Patch (RFC 6902) that
+turns `from` into `to` via `applyPatch`, describing only what changed (recursive object and array diff,
+not a whole-document replace), without mutating or sharing structure with the inputs. Non-JSON inputs throw.
+Covered by `test/createpatch.test.ts` and documented in README.md.
diff --git a/src/index.ts b/src/index.ts
index 1b9acf3c18bcc4999ac29f81f8d59d42e881fe55..2074cdce4c80ac898e1ee5e1678f8b2ca89952c1 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -261,3 +261,65 @@ export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
   assertJsonValue(patch, "patch");
   return mergeValue(structuredClone(target), structuredClone(patch) as JsonValue);
 }
+
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffValues(from: JsonValue, to: JsonValue, path: string, patch: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, patch);
+  } else if (isObject(from) && isObject(to)) {
+    const source = from as { [key: string]: JsonValue };
+    const target = to as { [key: string]: JsonValue };
+    for (const key of Object.keys(source)) {
+      if (!Object.hasOwn(target, key)) patch.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+    }
+    for (const key of Object.keys(target)) {
+      const child = `${path}/${encodeToken(key)}`;
+      if (Object.hasOwn(source, key)) diffValues(source[key], target[key], child, patch);
+      else patch.push({ op: "add", path: child, value: target[key] });
+    }
+  } else {
+    patch.push({ op: "replace", path, value: to });
+  }
+}
+
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, patch: PatchOperation[]): void {
+  // Equal leading and trailing items need no operation, so an insertion or removal stays a single operation.
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && jsonEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const common = Math.min(endFrom, endTo) - start;
+  for (let i = 0; i < common; i++) diffValues(from[start + i], to[start + i], `${path}/${start + i}`, patch);
+  // Removing from the highest index down keeps the lower indexes valid.
+  for (let i = endFrom - 1; i >= start + common; i--) patch.push({ op: "remove", path: `${path}/${i}` });
+  for (let i = start + common; i < endTo; i++) patch.push({ op: "add", path: `${path}/${i}`, value: to[i] });
+}
+
+/**
+ * Computes a JSON Patch (RFC 6902) that turns `from` into `to`.
+ *
+ * The patch holds only the differences: unchanged members and array items are left out, and nested
+ * changes are addressed by their own path rather than by replacing the enclosing value. Applying it to
+ * `from` with `applyPatch` gives a value equal to `to`; equal inputs give an empty patch. Neither input is
+ * mutated and the patch shares no structure with them.
+ *
+ * @param from the original JSON document.
+ * @param to the updated JSON document.
+ * @returns the JSON Patch, as a new array.
+ * @throws Error when `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  assertJsonValue(from, "from");
+  assertJsonValue(to, "to");
+  const patch: PatchOperation[] = [];
+  diffValues(from as JsonValue, to as JsonValue, "", patch);
+  return structuredClone(patch);
+}
