index 0000000000000000000000000000000000000000..82bf7f5cb7dbded793dbedc086cbe638818c746b
--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,62 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const before = structuredClone(from);
+  const after = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, before);
+  assert.deepEqual(to, after);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+};
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+  assert.deepEqual(roundTrip(1, 1), []);
+});
+
+test("a small change gives a small patch", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: { c: [1, 2, 3] } }, { a: 1, b: { c: [1, 2, 4] } }), [
+    { op: "replace", path: "/b/c/2", value: 4 },
+  ]);
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1 }), [{ op: "remove", path: "/b" }]);
+  assert.deepEqual(roundTrip({ a: 1 }, { a: 1, b: 2 }), [{ op: "add", path: "/b", value: 2 }]);
+});
+
+test("array insertions and removals", () => {
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 9, 2, 3]), [{ op: "add", path: "/1", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 4]), [
+    { op: "remove", path: "/2" },
+    { op: "remove", path: "/1" },
+  ]);
+  roundTrip([], [1, 2]);
+  roundTrip([1, 2], []);
+  roundTrip([[1], [2]], [[1, 5], [3], [4]]);
+});
+
+test("root and type changes", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  roundTrip(null, { a: null });
+  roundTrip({ a: [] }, { a: {} });
+  roundTrip(1, "1");
+});
+
+test("keys needing escapes and __proto__", () => {
+  const patch = roundTrip({ "a/b": 1, "m~n": 1 }, { "a/b": 2, "m~n": 2 });
+  assert.deepEqual(patch.map((o) => o.path), ["/a~1b", "/m~0n"]);
+  roundTrip({}, JSON.parse('{"__proto__": {"x": 1}}'));
+});
+
+test("the patch shares nothing with the inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0].value as { b: number }).b = 9;
+  assert.equal(to.a.b, 1);
+});
+
+test("invalid inputs throw", () => {
+  assert.throws(() => createPatch(undefined, 1), Error);
+  assert.throws(() => createPatch({}, { a: NaN }), Error);
+});
