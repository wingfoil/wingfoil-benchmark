 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to `target` and returns the result as a new value.
+ * The inputs are never mutated. A non-object patch replaces the target; in an object patch,
+ * `null` members delete and other members are merged recursively.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return clone(patch);
+  }
+  const result: Record<string, unknown> = isObject(target) ? (clone(target) as Record<string, unknown>) : {};
+  for (const key of Object.keys(patch)) {
+    if (patch[key] === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(Object.hasOwn(result, key) ? result[key] : undefined, patch[key]));
+    }
+  }
+  return result;
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
