   return result;
 }
+
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: unknown };
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diff(from: Json, to: Json, path: string, ops: Operation[]): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+  if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) {
+        ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(from, key)) {
+        diff(from[key], to[key], child, ops);
+      } else {
+        ops.push({ op: "add", path: child, value: clone(to[key]) });
+      }
+    }
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    let start = 0;
+    while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+      start++;
+    }
+    let endFrom = from.length;
+    let endTo = to.length;
+    while (endFrom > start && endTo > start && jsonEqual(from[endFrom - 1], to[endTo - 1])) {
+      endFrom--;
+      endTo--;
+    }
+    const common = Math.min(endFrom, endTo) - start;
+    for (let i = 0; i < common; i++) {
+      diff(from[start + i], to[start + i], `${path}/${start + i}`, ops);
+    }
+    for (let i = endFrom - 1; i >= start + common; i--) {
+      ops.push({ op: "remove", path: `${path}/${i}` });
+    }
+    for (let i = start + common; i < endTo; i++) {
+      ops.push({ op: "add", path: `${path}/${i}`, value: clone(to[i]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only
+ * the parts that changed. The inputs are never mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  const ops: Operation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
