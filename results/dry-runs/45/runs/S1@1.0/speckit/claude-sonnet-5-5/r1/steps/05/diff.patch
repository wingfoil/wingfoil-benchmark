@@ -0,0 +1,63 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+};
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a small change yields a single small operation", () => {
+  const from = { a: { b: 1, c: [1, 2, 3] }, d: "x" };
+  const to = { a: { b: 1, c: [1, 9, 3] }, d: "x" };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/c/1", value: 9 }]);
+});
+
+test("object add/remove and type changes", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, c: 3 }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+  assert.deepEqual(roundTrip({ a: [1] }, { a: { x: 1 } }), [{ op: "replace", path: "/a", value: { x: 1 } }]);
+  assert.deepEqual(roundTrip(1, "s"), [{ op: "replace", path: "", value: "s" }]);
+  roundTrip(null, { a: null });
+  roundTrip({ a: null }, { a: false });
+});
+
+test("arrays: insert, append, delete", () => {
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 2, 3, 4]), [{ op: "add", path: "/3", value: 4 }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4, 5], [1, 5]), [
+    { op: "remove", path: "/3" },
+    { op: "remove", path: "/2" },
+    { op: "remove", path: "/1" },
+  ]);
+  roundTrip([], [1, 2]);
+  roundTrip([1, 2], []);
+  roundTrip([{ a: 1 }, { b: 2 }], [{ a: 1, z: 0 }, { b: 3 }, 7]);
+});
+
+test("pointer escaping and __proto__", () => {
+  const patch = roundTrip({ "a/b": 1, "m~n": 2 }, { "a/b": 2, "m~n": 3 });
+  assert.deepEqual(patch.map((o: any) => o.path), ["/a~1b", "/m~0n"]);
+  const to = JSON.parse('{"__proto__": {"x": 1}}');
+  const result = applyPatch({}, createPatch({}, to)) as object;
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
+
+test("inputs are not mutated and the patch shares no structure", () => {
+  const from = { a: [1, 2], b: { c: 1 } };
+  const to = { a: [1, 2, { n: 1 }], b: { c: 1 } };
+  const f = structuredClone(from);
+  const t = structuredClone(to);
+  const patch = createPatch(from, to) as any[];
+  assert.deepEqual(from, f);
+  assert.deepEqual(to, t);
+  assert.notEqual(patch[0].value, to.a[2]);
+});
