index 0000000000000000000000000000000000000000..76471fdfb9a2c75c3b9bc16998be9f1f5d5c99aa
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,120 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+// RFC 6902 appendix A: the specification's own examples.
+const appendixA: [string, unknown, unknown[], unknown][] = [
+  ["A.1 adding an object member", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { baz: "qux", foo: "bar" }],
+  ["A.2 adding an array element", { foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] }],
+  ["A.3 removing an object member", { baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }],
+  ["A.4 removing an array element", { foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }],
+  ["A.5 replacing a value", { baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" }],
+  [
+    "A.6 moving a value",
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  ],
+  ["A.7 moving an array element", { foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], { foo: ["all", "cows", "eat", "grass"] }],
+  ["A.8 testing a value: success", { baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], { baz: "qux", foo: ["a", 2, "c"] }],
+  ["A.10 adding a nested member object", { foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } }],
+  ["A.11 ignoring unrecognized elements", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" }],
+  ["A.14 ~ escape ordering", { "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }],
+  ["A.15 comparing strings and numbers", { "/": 9, "~1": 10 }, [{ op: "test", path: "/~1", value: 9 }], { "/": 9, "~1": 10 }],
+  ["A.16 adding an array value", { foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] }],
+];
+
+for (const [name, document, patch, expected] of appendixA) {
+  test(`RFC 6902 ${name}`, () => {
+    assert.deepEqual(applyPatch(document, patch), expected);
+  });
+}
+
+const fails: [string, unknown, unknown, RegExp?][] = [
+  ["A.9 testing a value: error", { baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]],
+  ["A.12 adding to a nonexistent target", { foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]],
+  ["unknown operation", {}, [{ op: "bogus", path: "/a" }]],
+  ["patch that is not an array", {}, { op: "add", path: "/a", value: 1 }],
+  ["operation that is not an object", {}, [null]],
+  ["missing path", {}, [{ op: "remove" }]],
+  ["add without value", {}, [{ op: "add", path: "/a" }]],
+  ["move without from", { a: 1 }, [{ op: "move", path: "/b" }]],
+  ["copy without from", { a: 1 }, [{ op: "copy", path: "/b" }]],
+  ["invalid pointer", {}, [{ op: "add", path: "a", value: 1 }], /Invalid JSON Pointer/],
+  ["remove of a missing member", {}, [{ op: "remove", path: "/a" }]],
+  ["remove of the root", {}, [{ op: "remove", path: "" }]],
+  ["remove with the - marker", { a: [1] }, [{ op: "remove", path: "/a/-" }]],
+  ["replace of a missing member", {}, [{ op: "replace", path: "/a", value: 1 }]],
+  ["add past the end of an array", [1], [{ op: "add", path: "/2", value: 1 }]],
+  ["array index with a leading zero", [1], [{ op: "add", path: "/01", value: 1 }]],
+  ["non-numeric array index", [1], [{ op: "add", path: "/x", value: 1 }]],
+  ["move from a missing location", {}, [{ op: "move", from: "/a", path: "/b" }]],
+  ["move into its own child", { a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]],
+  ["copy from a missing location", {}, [{ op: "copy", from: "/a", path: "/b" }]],
+  ["test of a missing member", {}, [{ op: "test", path: "/a", value: null }]],
+  ["add into a scalar", { a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]],
+  ["a later failure aborts the patch", {}, [{ op: "add", path: "/a", value: 1 }, { op: "remove", path: "/b" }]],
+];
+
+for (const [name, document, patch, message] of fails) {
+  test(`throws: ${name}`, () => {
+    assert.throws(() => applyPatch(document, patch as unknown[]), message);
+  });
+}
+
+test("add and replace on the whole document", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: 2 }]), 2);
+});
+
+test("add replaces an existing member; replace keeps array position", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch([1, 2, 3], [{ op: "replace", path: "/1", value: 9 }]), [1, 9, 3]);
+});
+
+test("copy duplicates the value", () => {
+  const result = applyPatch({ a: { b: 1 } }, [{ op: "copy", from: "/a", path: "/c" }, { op: "add", path: "/c/b", value: 2 }]);
+  assert.deepEqual(result, { a: { b: 1 }, c: { b: 2 } });
+});
+
+test("move to its own location is a no-op", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+});
+
+test("test compares objects regardless of member order, and distinguishes types", () => {
+  const doc = { o: { x: 1, y: [1, { z: null }] } };
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/o", value: { y: [1, { z: null }], x: 1 } }]), doc);
+  for (const value of [{ x: 1 }, { x: 1, y: [1, { z: 0 }] }, "1", [1]]) {
+    assert.throws(() => applyPatch(doc, [{ op: "test", path: "/o", value }]));
+  }
+  assert.throws(() => applyPatch([1], [{ op: "test", path: "/0", value: "1" }]));
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "", value: [] }]));
+});
+
+test("neither the document nor the patch is mutated or aliased", () => {
+  const document = { a: [1, 2], b: { c: 1 } };
+  const patch = [{ op: "add", path: "/d", value: { e: [1] } }, { op: "remove", path: "/a/0" }, { op: "move", from: "/b", path: "/f" }];
+  const documentCopy = structuredClone(document);
+  const patchCopy = structuredClone(patch);
+  const result = applyPatch(document, patch) as Record<string, unknown>;
+  assert.deepEqual(document, documentCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.notEqual(result.d, patch[0].value);
+});
+
+test("an empty patch returns an equal copy", () => {
+  const document = { a: 1 };
+  const result = applyPatch(document, []);
+  assert.deepEqual(result, document);
+  assert.notEqual(result, document);
+});
+
+test("__proto__ keys do not pollute prototypes", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as object;
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.ok(Object.hasOwn(result, "__proto__"));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/__proto__/polluted", value: true }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/constructor/prototype/polluted", value: true }]));
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
