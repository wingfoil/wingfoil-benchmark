+
+/** Encodes one reference token (RFC 6901 section 3): `~` becomes `~0`, then `/` becomes `~1`. */
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/**
+ * Pairs up the items of two arrays that are equal, as a longest common subsequence.
+ * Returns the matching `[indexInFrom, indexInTo]` pairs in increasing order.
+ */
+function commonItems(from: unknown[], to: unknown[]): [number, number][] {
+  const lengths = Array.from({ length: from.length + 1 }, () => new Array<number>(to.length + 1).fill(0));
+  for (let i = from.length - 1; i >= 0; i--) {
+    for (let j = to.length - 1; j >= 0; j--) {
+      lengths[i][j] = equal(from[i], to[j]) ? lengths[i + 1][j + 1] + 1 : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  const pairs: [number, number][] = [];
+  let i = 0;
+  let j = 0;
+  while (i < from.length && j < to.length) {
+    if (equal(from[i], to[j])) {
+      pairs.push([i++, j++]);
+    } else if (lengths[i + 1][j] >= lengths[i][j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
+
+/**
+ * Appends the operations that turn the array `from` into `to`, found at `path`.
+ *
+ * Items present in both arrays are left alone. Between them, items that changed in place are diffed
+ * recursively, and the surplus is removed or added. A moved item is removed and added back. Indexes
+ * refer to the array as it is after the operations already emitted, as RFC 6902 section 5 requires.
+ */
+function diffArrays(from: unknown[], to: unknown[], path: string, operations: Operation[]): void {
+  const anchors: [number, number][] = [...commonItems(from, to), [from.length, to.length]];
+  let fromStart = 0;
+  let toStart = 0;
+  let position = 0;
+  for (const [fromEnd, toEnd] of anchors) {
+    const removed = fromEnd - fromStart;
+    const added = toEnd - toStart;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) {
+      diffValues(from[fromStart + k], to[toStart + k], `${path}/${position + k}`, operations);
+    }
+    for (let k = paired; k < removed; k++) {
+      operations.push({ op: "remove", path: `${path}/${position + paired}` });
+    }
+    for (let k = paired; k < added; k++) {
+      operations.push({ op: "add", path: `${path}/${position + k}`, value: structuredClone(to[toStart + k]) });
+    }
+    position += added + 1;
+    fromStart = fromEnd + 1;
+    toStart = toEnd + 1;
+  }
+}
+
+function diffObjects(from: Record<string, unknown>, to: Record<string, unknown>, path: string, operations: Operation[]): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      operations.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const memberPath = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) {
+      diffValues(from[key], to[key], memberPath, operations);
+    } else {
+      operations.push({ op: "add", path: memberPath, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+function diffValues(from: unknown, to: unknown, path: string, operations: Operation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, operations);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from, to, path, operations);
+  } else if (!equal(from, to)) {
+    operations.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch holds only what changed: object members are added, removed or diffed recursively, and
+ * array items that were inserted or deleted are added or removed without touching their neighbours.
+ * An item that moved is removed and added back. Equal documents give an empty patch, and values of
+ * different types are replaced as a whole (path `""` for the document itself). Neither argument is
+ * mutated and the patch shares no structure with either; `__proto__` and similar keys are ordinary
+ * members.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  const operations: Operation[] = [];
+  diffValues(from, to, "", operations);
+  return operations;
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6da1b6906afdb39e092b0c12037a05ab681641e5
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,96 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown): unknown[] {
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+});
+
+test("a change in one small place gives one operation", () => {
+  const from = { name: "x", deep: { list: [1, 2, 3], other: "keep" }, big: { k: "v" } };
+  const to = { name: "x", deep: { list: [1, 2, 3], other: "new" }, big: { k: "v" } };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/deep/other", value: "new" }]);
+});
+
+test("object members are added and removed", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, c: 3 }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("null is a value, not a removal", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+  assert.deepEqual(roundTrip(null, { a: null }), [{ op: "replace", path: "", value: { a: null } }]);
+});
+
+test("values of different types are replaced as a whole", () => {
+  assert.deepEqual(roundTrip(1, "1"), [{ op: "replace", path: "", value: "1" }]);
+  assert.deepEqual(roundTrip({ a: [1] }, { a: { 0: 1 } }), [{ op: "replace", path: "/a", value: { 0: 1 } }]);
+  assert.deepEqual(roundTrip([], {}), [{ op: "replace", path: "", value: {} }]);
+});
+
+test("keys are escaped in pointers (RFC 6901 section 3)", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "~": 1, "": 1 }, { "a/b": 2, "~": 2, "": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/~0", value: 2 },
+    { op: "replace", path: "/", value: 2 },
+  ]);
+});
+
+test("an array that gains an item adds only that item", () => {
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 2, 9, 3]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2], [0, 1, 2]), [{ op: "add", path: "/0", value: 0 }]);
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+});
+
+test("an array that loses an item removes only that item", () => {
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [2, 3]), [{ op: "remove", path: "/0" }]);
+  assert.deepEqual(roundTrip([{ id: 1 }, { id: 2 }], [{ id: 1 }]), [{ op: "remove", path: "/1" }]);
+});
+
+test("an item that moves does not rewrite the items in between", () => {
+  const patch = roundTrip(["a", "b", "c", "d", "e"], ["a", "e", "b", "c", "d"]);
+  assert.ok(patch.length <= 2);
+  assert.deepEqual(roundTrip(["a", "b", "c", "d"], ["b", "c", "d", "a"]).length, 2);
+});
+
+test("a changed array item is diffed in place", () => {
+  assert.deepEqual(roundTrip([{ id: 1, v: "a" }, { id: 2, v: "b" }], [{ id: 1, v: "a" }, { id: 2, v: "c" }]), [
+    { op: "replace", path: "/1/v", value: "c" },
+  ]);
+});
+
+test("several insertions and deletions use correct running indexes", () => {
+  roundTrip([1, 2, 3, 4, 5, 6], [0, 2, 3, 7, 8, 6, 9]);
+  roundTrip([1, 2, 3], []);
+  roundTrip([], [1, 2, 3]);
+  roundTrip([1, 1, 1, 2], [1, 2, 1, 1, 1]);
+  roundTrip([[1, 2], [3]], [[3], [1, 2, 4]]);
+});
+
+test("the patch shares no structure with its inputs", () => {
+  const to = { a: { b: [1] } };
+  const patch = createPatch({}, to) as { value: { b: unknown[] } }[];
+  patch[0].value.b.push(2);
+  assert.deepEqual(to, { a: { b: [1] } });
+});
+
+test("__proto__ keys are ordinary members", () => {
+  const to = JSON.parse('{"__proto__": {"polluted": true}}');
+  const result = roundTrip({}, to) as { path: string }[];
+  assert.equal(result[0].path, "/__proto__");
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
