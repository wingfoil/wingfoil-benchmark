diff --git a/test/reports-fixes.test.ts b/test/reports-fixes.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a3a754da905d8705eee4f7a9d074a68f760b27f8
--- /dev/null
+++ b/test/reports-fixes.test.ts
@@ -0,0 +1,34 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createShop } from '../src/index.ts';
+
+function shop() {
+  const s = createShop();
+  s.catalog.add({ sku: 'LB-220', name: 'Lamp', priceCents: 199, vatClass: 'standard', weightGrams: 100 });
+  s.catalog.add({ sku: 'BX-1', name: 'Box', priceCents: 5000, vatClass: 'exempt', weightGrams: 100 });
+  s.inventory.restock('LB-220', 40);
+  s.inventory.restock('BX-1', 40);
+  return s;
+}
+
+describe('reported defects', () => {
+  it('finds a product by a lower-case SKU', () => {
+    const { catalog, orders } = shop();
+    assert.equal(catalog.get('lb-220').sku, 'LB-220');
+    const order = orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: ' lb-220 ', quantity: 1 }] });
+    assert.equal(order.lines[0]?.sku, 'LB-220');
+  });
+
+  it('ships free when the goods come to exactly €50.00', () => {
+    const { orders } = shop();
+    const order = orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'BX-1', quantity: 1 }] });
+    assert.equal(order.totals.shippingCents, 0);
+  });
+
+  it('rounds line VAT half up: 22% of €1.99 is €0.44', () => {
+    const { orders } = shop();
+    const order = orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'LB-220', quantity: 1 }] });
+    assert.equal(order.lines[0]?.vatCents, 44);
+  });
+});
