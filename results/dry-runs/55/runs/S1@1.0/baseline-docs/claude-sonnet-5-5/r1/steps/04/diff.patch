index 0000000000000000000000000000000000000000..78dae17c7000ebc9b913d77bf3b4e85061bee6e7
--- /dev/null
+++ b/src/merge-patch.ts
@@ -0,0 +1,36 @@
+import { isJsonValue, isObject, setMember } from "./json.ts";
+
+/** Merges `patch` into `target` per RFC 7386, section 2; `target` is only read, never mutated. */
+function merge(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result: Record<string, unknown> = {};
+  if (isObject(target)) {
+    for (const [name, value] of Object.entries(target)) {
+      setMember(result, name, value);
+    }
+  }
+  for (const [name, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[name];
+    } else {
+      setMember(result, name, merge(Object.hasOwn(result, name) ? result[name] : undefined, value));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies the JSON Merge Patch `patch` (RFC 7386) to `target` and returns the merged document as a new value;
+ * neither argument is mutated. A non-object patch replaces the target, `null` members delete, and arrays are
+ * replaced as a whole. Only own members are considered and `__proto__` is an ordinary member name.
+ *
+ * @throws TypeError when `patch` is not JSON (e.g. contains `undefined` or `NaN`).
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonValue(patch)) {
+    throw new TypeError("Invalid JSON Merge Patch: not a JSON value");
+  }
+  return merge(structuredClone(target), patch);
+}
