diff --git a/test/merge-patch.test.ts b/test/merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fb2f7dce7f280e845956db80ea1e416882f43d90
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,52 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+// RFC 7386 appendix A: [target, patch, result].
+const examples: Array<[unknown, unknown, unknown]> = [
+  [{ a: "b" }, { a: "c" }, { a: "c" }],
+  [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  [{ a: "b" }, { a: null }, {}],
+  [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+  [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+  [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  [["a", "b"], ["c", "d"], ["c", "d"]],
+  [{ a: "b" }, ["c"], ["c"]],
+  [{ a: "foo" }, null, null],
+  [{ a: "foo" }, "bar", "bar"],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: "b", c: null }, { a: "b" }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+
+for (const [target, patch, result] of examples) {
+  test(`merge ${JSON.stringify(patch)} into ${JSON.stringify(target)}`, () => {
+    assert.deepEqual(applyMergePatch(target, patch), result);
+  });
+}
+
+test("does not mutate its arguments", () => {
+  const target = { a: { b: 1 } };
+  const patch = { a: { c: [1] } };
+  const result = applyMergePatch(target, patch) as { a: { c: number[] } };
+  result.a.c.push(2);
+  assert.deepEqual(target, { a: { b: 1 } });
+  assert.deepEqual(patch, { a: { c: [1] } });
+});
+
+test("__proto__ is an ordinary member", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as object;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+});
+
+test("inherited properties are not members", () => {
+  assert.deepEqual(applyMergePatch({}, { constructor: null }), {});
+});
+
+test("rejects a patch that is not JSON", () => {
+  assert.throws(() => applyMergePatch({}, { a: undefined }), TypeError);
+  assert.throws(() => applyMergePatch({}, NaN), TypeError);
+});
