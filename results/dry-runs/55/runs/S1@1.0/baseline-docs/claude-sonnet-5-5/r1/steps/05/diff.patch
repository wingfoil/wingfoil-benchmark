diff --git a/test/diff.test.ts b/test/diff.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..33015e5d48e7752e5d846c44d1d8e42e53e4f1f7
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,49 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const cases: Array<[string, unknown, unknown, unknown[]?]> = [
+  ["equal documents", { a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }, []],
+  ["one nested change", { a: { b: 1, c: 2 }, d: [1] }, { a: { b: 1, c: 3 }, d: [1] }, [{ op: "replace", path: "/a/c", value: 3 }]],
+  ["added member", { a: 1 }, { a: 1, b: 2 }, [{ op: "add", path: "/b", value: 2 }]],
+  ["removed member", { a: 1, b: 2 }, { a: 1 }, [{ op: "remove", path: "/b" }]],
+  ["key order is irrelevant", { a: 1, b: 2 }, { b: 2, a: 1 }, []],
+  ["escaped pointer tokens", { "a/b": { "~": 1 } }, { "a/b": { "~": 2 } }, [{ op: "replace", path: "/a~1b/~0", value: 2 }]],
+  ["__proto__ member", JSON.parse('{"__proto__":1}'), JSON.parse('{"__proto__":2}'), [{ op: "replace", path: "/__proto__", value: 2 }]],
+  ["whole document replaced", { a: 1 }, [1], [{ op: "replace", path: "", value: [1] }]],
+  ["type change", { a: [] }, { a: {} }, [{ op: "replace", path: "/a", value: {} }]],
+  ["null vs missing", { a: null }, {}, [{ op: "remove", path: "/a" }]],
+  ["array append", [1, 2], [1, 2, 3], [{ op: "add", path: "/2", value: 3 }]],
+  ["array truncate", [1, 2, 3], [1], [{ op: "remove", path: "/2" }, { op: "remove", path: "/1" }]],
+  ["array insert at front", [1, 2, 3], [0, 1, 2, 3], [{ op: "add", path: "/0", value: 0 }]],
+  ["array delete in middle", [1, 2, 3], [1, 3], [{ op: "remove", path: "/1" }]],
+  ["array element change", [{ a: 1 }, { b: 2 }], [{ a: 1 }, { b: 3 }], [{ op: "replace", path: "/1/b", value: 3 }]],
+  ["scalars", 1, 2, [{ op: "replace", path: "", value: 2 }]],
+  ["array from empty", [], [1, 2], [{ op: "add", path: "/0", value: 1 }, { op: "add", path: "/1", value: 2 }]],
+  ["array replace and grow", [1, 5], [2, 5, 7, 8], [{ op: "replace", path: "/0", value: 2 }, { op: "add", path: "/2", value: 7 }, { op: "add", path: "/3", value: 8 }]],
+];
+
+for (const [name, from, to, expected] of cases) {
+  test(`createPatch: ${name}`, () => {
+    const patch = createPatch(from, to);
+    if (expected) {
+      assert.deepEqual(patch, expected);
+    }
+    assert.deepEqual(applyPatch(from, patch), to);
+  });
+}
+
+test("createPatch does not mutate inputs and copies values", () => {
+  const from = { a: [1] };
+  const to = { a: [1], b: { c: 1 } };
+  const snapshot = structuredClone([from, to]);
+  const patch = createPatch(from, to);
+  assert.deepEqual([from, to], snapshot);
+  (patch[0] as { value: { c: number } }).value.c = 9;
+  assert.deepEqual(to, snapshot[1]);
+});
+
+test("createPatch rejects non-JSON input", () => {
+  assert.throws(() => createPatch({ a: undefined }, {}), TypeError);
+  assert.throws(() => createPatch({}, NaN), TypeError);
+});
