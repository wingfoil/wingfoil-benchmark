 It throws a `TypeError` when the patch is not JSON (such as `undefined` or `NaN`).
 
+## Creating a patch
+
+`createPatch(from, to)`, exported from `src/index.ts`, returns a JSON Patch (RFC 6902; `add`, `remove` and
+`replace` operations only) that `applyPatch` turns from `from` into `to`. It sends only what changed: equal
+documents give `[]`, objects are compared member by member, and arrays are compared after skipping their
+common head and tail, so inserting or deleting one element does not rewrite those after it. Only when the
+two values differ in kind (or are different scalars) is the value at that path replaced. Neither argument is
+mutated and values in the patch are copies.
+
+It throws a `TypeError` when either document is not JSON (such as `undefined` or `NaN`).
+
 Run the tests with `npm test`.
diff --git a/src/diff.ts b/src/diff.ts
new file mode 100644
index 0000000000000000000000000000000000000000..860ccde8e15e8e61b692e012f39b30aa9f0ec811
--- /dev/null
+++ b/src/diff.ts
@@ -0,0 +1,91 @@
+import { isJsonValue, isObject } from "./json.ts";
+
+/** A JSON Patch operation produced by `createPatch`. */
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+function escapeToken(token: string): string {
+  return token.replaceAll("~", "~0").replaceAll("/", "~1");
+}
+
+function isEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) && Array.isArray(b)) {
+    return a.length === b.length && a.every((item, i) => isEqual(item, b[i]));
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((k) => Object.hasOwn(b, k) && isEqual(a[k], b[k]));
+  }
+  return a === b;
+}
+
+function diffObjects(from: Record<string, unknown>, to: Record<string, unknown>, path: string, ops: PatchOperation[]): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const child = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) {
+      diff(from[key], to[key], child, ops);
+    } else {
+      ops.push({ op: "add", path: child, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+/**
+ * Diffs two arrays by skipping their common head and tail, comparing the differing middle index by index and
+ * then removing or appending the surplus, so an insertion or deletion does not rewrite the elements after it.
+ */
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: PatchOperation[]): void {
+  const shortest = Math.min(from.length, to.length);
+  let head = 0;
+  while (head < shortest && isEqual(from[head], to[head])) {
+    head++;
+  }
+  let tail = 0;
+  while (tail < shortest - head && isEqual(from[from.length - 1 - tail], to[to.length - 1 - tail])) {
+    tail++;
+  }
+  const fromEnd = from.length - tail;
+  const toEnd = to.length - tail;
+  const common = Math.min(fromEnd, toEnd);
+  for (let i = head; i < common; i++) {
+    diff(from[i], to[i], `${path}/${i}`, ops);
+  }
+  for (let i = fromEnd - 1; i >= common; i--) {
+    ops.push({ op: "remove", path: `${path}/${i}` });
+  }
+  for (let i = common; i < toEnd; i++) {
+    ops.push({ op: "add", path: `${path}/${i}`, value: structuredClone(to[i]) });
+  }
+}
+
+function diff(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from, to, path, ops);
+  } else if (!isEqual(from, to)) {
+    ops.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Returns an RFC 6902 JSON Patch that turns `from` into `to` when applied, describing only what changed:
+ * equal documents give `[]`, and objects and arrays are compared recursively. Neither argument is mutated and
+ * values in the patch are copies. Only own members are considered and `__proto__` is an ordinary member name.
+ *
+ * @throws TypeError when `from` or `to` is not JSON (e.g. contains `undefined` or `NaN`).
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new TypeError("Cannot create a JSON Patch: not a JSON value");
+  }
+  const ops: PatchOperation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
