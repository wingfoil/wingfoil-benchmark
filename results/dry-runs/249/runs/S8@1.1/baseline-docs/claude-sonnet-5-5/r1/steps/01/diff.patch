+++ b/test/list.test.ts
@@ -9,10 +9,41 @@ function valueOf<T>(result: { ok: true; value: T } | { ok: false; error: unknown
 }
 
 describe('task list', () => {
+  it('gives each task its own id, which survives a rename', () => {
+    const list = createTodoList();
+    const first = valueOf(list.add({ title: 'a' }));
+    const second = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(first.id, second.id);
+    valueOf(list.rename(first.id, 'c'));
+    assert.equal(valueOf(list.get(first.id)).title, 'c');
+    assert.equal(list.get('nope').ok, false);
+  });
+
+  it('does not reuse the id of a removed task', () => {
+    const list = createTodoList();
+    const first = valueOf(list.add({ title: 'a' }));
+    list.remove(first.id);
+    assert.notEqual(valueOf(list.add({ title: 'a' })).id, first.id);
+    assert.equal(list.get(first.id).ok, false);
+  });
+
+  it('accepts an id wherever a title is taken', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'a' }));
+    assert.equal(valueOf(list.find(id)).title, 'a');
+    assert.equal(valueOf(list.tag(id, 'x')).tags[0], 'x');
+    assert.equal(valueOf(list.untag(id, 'x')).tags.length, 0);
+    assert.equal(valueOf(list.complete(id)).status, 'done');
+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.equal(valueOf(list.rename(id, 'a')).title, 'a');
+    assert.equal(valueOf(list.remove(id)).title, 'a');
+    assert.equal(list.find(id).ok, false);
+  });
+
   it('adds an open task with a normal priority by default', () => {
     const list = createTodoList();
     const task = valueOf(list.add({ title: '  Buy milk ' }));
-    assert.deepEqual(task, { title: 'Buy milk', priority: 'normal', tags: [], status: 'open' });
+    assert.deepEqual(task, { id: task.id, title: 'Buy milk', priority: 'normal', tags: [], status: 'open' });
     assert.equal(list.openCount(), 1);
   });
 
