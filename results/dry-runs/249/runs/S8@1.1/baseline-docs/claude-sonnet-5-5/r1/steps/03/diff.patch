+describe('input validation', () => {
+  const rejected = (list: ReturnType<typeof createTodoList>, result: { ok: boolean; error?: { code: string } }) => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+    assert.deepEqual(list.list().map((task) => [task.title, task.priority, [...task.tags]]), [['a', 'normal', []]]);
+  };
+
+  it('rejects an invalid new task', () => {
+    const list = createTodoList();
+    valueOf(list.add({ title: 'a' }));
+    rejected(list, list.add({ title: '' }));
+    rejected(list, list.add({ title: '   ' }));
+    rejected(list, list.add({ title: 'x'.repeat(121) }));
+    rejected(list, list.add({ title: 'b', priority: 'urgent' as 'low' }));
+    rejected(list, list.add({ title: 'b', tags: [''] }));
+    rejected(list, list.add({ title: 'b', tags: ['ok', 'two words'] }));
+    assert.equal(valueOf(list.add({ title: 'x'.repeat(120) })).title.length, 120);
+  });
+
+  it('rejects an invalid rename or tag', () => {
+    const list = createTodoList();
+    valueOf(list.add({ title: 'a' }));
+    rejected(list, list.rename('a', ' '));
+    rejected(list, list.rename('a', 'x'.repeat(121)));
+    rejected(list, list.tag('a', ''));
+    rejected(list, list.tag('a', 'two words'));
+    assert.equal(valueOf(list.tag('a', 'ok')).tags[0], 'ok');
+  });
+});
