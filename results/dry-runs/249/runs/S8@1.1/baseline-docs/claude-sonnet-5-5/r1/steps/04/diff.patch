+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { TaskList } from './list.ts';
+import type { NewTask } from './task.ts';
+
+/** A line of an import that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks it added, and every line it could not add. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+const FIELD_COUNT = 3;
+
+function parseLine(row: string): Result<NewTask> {
+  const fields = row.split(';');
+  if (fields.length > FIELD_COUNT) {
+    return err('invalid-input', `the line has ${fields.length} fields; the most allowed is ${FIELD_COUNT} (title;priority;tags)`);
+  }
+  const [title = '', priority = '', tags = ''] = fields;
+  const wanted = priority.trim();
+  return ok({
+    title,
+    ...(wanted === '' ? {} : { priority: wanted as NewTask['priority'] }),
+    tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+  });
+}
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may be
+ * empty for a normal one; tags are separated by spaces. Blank lines are skipped; a line that is not valid,
+ * or whose title is already in the list, is rejected and the others are still added.
+ *
+ * @param list - the task list to add to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((row, index) => {
+    if (row.trim() === '') return;
+    const parsed = parseLine(row);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
