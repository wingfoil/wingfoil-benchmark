@@ -0,0 +1,42 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds every valid line, with its priority and tags', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\nWater plants;;');
+    assert.deepEqual(report, { imported: 2, rejected: [] });
+    const [insurance] = list.list({ priority: 'high' });
+    assert.deepEqual(insurance?.tags, ['admin', 'money']);
+    assert.equal(list.find('Water plants').ok && list.find('Water plants').value.priority, 'normal');
+  });
+
+  it('accepts a title alone and CRLF line endings', () => {
+    const list = createTodoList();
+    assert.equal(importTasks(list, 'a\r\nb;low\r\n').imported, 2);
+  });
+
+  it('skips blank lines but still counts them in line numbers', () => {
+    const list = createTodoList();
+    const report = importTasks(list, '\nok\n   \n;high;x');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(report.rejected.map((r) => r.line), [4]);
+  });
+
+  it('rejects bad priorities, long titles, extra fields and duplicates, and keeps going', () => {
+    const list = createTodoList();
+    const report = importTasks(list, `a;urgent\n${'x'.repeat(121)}\nb;low;t;extra\nc\nc\nd`);
+    assert.equal(report.imported, 2);
+    assert.deepEqual(report.rejected.map((r) => r.line), [1, 2, 3, 5]);
+    assert.ok(report.rejected.every((r) => r.reason !== ''));
+    assert.equal(list.list().length, 2);
+  });
+
+  it('rejects a title already in the list', () => {
+    const list = createTodoList();
+    list.add({ title: 'a' });
+    assert.equal(importTasks(list, 'a').rejected[0]?.line, 1);
+  });
+});
