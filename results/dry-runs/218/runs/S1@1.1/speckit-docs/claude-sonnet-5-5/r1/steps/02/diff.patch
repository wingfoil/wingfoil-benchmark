--- a/src/index.ts
+++ b/src/index.ts
@@ -50,3 +50,201 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; path: string; from: string };
+
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function hasOwn(object: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(object, key);
+}
+
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
+
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (Array.isArray(a)) {
+    return (
+      Array.isArray(b) && a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]))
+    );
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => hasOwn(b, key) && jsonEqual(a[key], b[key]))
+    );
+  }
+  return false;
+}
+
+function parseIndex(token: string, max: number, allowEnd: boolean): number {
+  if (allowEnd && token === "-") return max;
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`Invalid array index "${token}"`);
+  }
+  const index = Number(token);
+  if (index > max || (index === max && !allowEnd)) {
+    throw new Error(`Array index ${token} out of range`);
+  }
+  return index;
+}
+
+function getParent(document: unknown, tokens: string[]): unknown {
+  let current = document;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      current = current[parseIndex(token, current.length, false)];
+    } else if (isObject(current) && hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path does not resolve at "${token}"`);
+    }
+  }
+  return current;
+}
+
+function getValue(document: unknown, pointer: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return document;
+  const parent = getParent(document, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) return parent[parseIndex(last, parent.length, false)];
+  if (isObject(parent) && hasOwn(parent, last)) return parent[last];
+  throw new Error(`Path does not resolve at "${last}"`);
+}
+
+function addValue(document: unknown, pointer: unknown, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = getParent(document, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(parseIndex(last, parent.length, true), 0, value);
+  } else if (isObject(parent)) {
+    setMember(parent, last, value);
+  } else {
+    throw new Error(`Cannot add into a scalar at "${last}"`);
+  }
+  return document;
+}
+
+function removeValue(document: unknown, pointer: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) throw new Error("Cannot remove the document root");
+  const parent = getParent(document, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(parseIndex(last, parent.length, false), 1);
+  } else if (isObject(parent) && hasOwn(parent, last)) {
+    delete parent[last];
+  } else {
+    throw new Error(`Path does not resolve at "${last}"`);
+  }
+  return document;
+}
+
+function clone<T>(value: T): T {
+  return structuredClone(value);
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a document and returns the result as a new value.
+ * The inputs are not mutated. Throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: not an array");
+  }
+  let result: unknown = clone(document);
+
+  for (const operation of patch as unknown[]) {
+    if (!isObject(operation)) {
+      throw new Error("Invalid JSON Patch: operation is not an object");
+    }
+    const { op, path, from, value } = operation as Record<string, unknown>;
+    if (typeof path !== "string") {
+      throw new Error("Invalid JSON Patch: operation lacks a string 'path'");
+    }
+    const needsValue = op === "add" || op === "replace" || op === "test";
+    if (needsValue && !hasOwn(operation, "value")) {
+      throw new Error(`Invalid JSON Patch: "${op}" lacks 'value'`);
+    }
+    const needsFrom = op === "move" || op === "copy";
+    if (needsFrom && typeof from !== "string") {
+      throw new Error(`Invalid JSON Patch: "${op}" lacks a string 'from'`);
+    }
+
+    switch (op) {
+      case "add":
+        result = addValue(result, path, clone(value));
+        break;
+      case "remove":
+        result = removeValue(result, path);
+        break;
+      case "replace":
+        getValue(result, path); // must exist
+        result = parsePointer(path).length === 0 ? clone(value) : addAfterRemove(result, path, clone(value));
+        break;
+      case "test":
+        if (!jsonEqual(getValue(result, path), value)) {
+          throw new Error(`Test failed at "${path}"`);
+        }
+        break;
+      case "copy":
+        result = addValue(result, path, clone(getValue(result, from as string)));
+        break;
+      case "move": {
+        const fromTokens = parsePointer(from);
+        const pathTokens = parsePointer(path);
+        const isPrefix =
+          fromTokens.length < pathTokens.length && fromTokens.every((t, i) => t === pathTokens[i]);
+        if (isPrefix) throw new Error("Cannot move a value into one of its children");
+        const moved = getValue(result, from as string);
+        if (jsonEqual(fromTokens, pathTokens)) break;
+        result = removeValue(result, from as string);
+        result = addValue(result, path, moved);
+        break;
+      }
+      default:
+        throw new Error(`Invalid JSON Patch: unknown op "${String(op)}"`);
+    }
+  }
+  return result;
+}
+
+function addAfterRemove(document: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  const parent = getParent(document, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent[parseIndex(last, parent.length, false)] = value;
+  } else {
+    setMember(parent as Record<string, unknown>, last, value);
+  }
+  return document;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f63438233792eac170362233592a02e747b4d459
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,30 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("operations", () => {
+  const doc = { foo: "bar", a: { b: [1, 2, 3] }, n: null };
+  const copy = structuredClone(doc);
+  const out = applyPatch(doc, [
+    { op: "add", path: "/a/b/1", value: 9 },
+    { op: "add", path: "/a/b/-", value: 4 },
+    { op: "remove", path: "/foo" },
+    { op: "replace", path: "/n", value: 1 },
+    { op: "copy", from: "/a/b", path: "/c" },
+    { op: "move", from: "/c/0", path: "/d" },
+    { op: "test", path: "/d", value: 1 },
+  ]);
+  assert.deepEqual(out, { a: { b: [1, 9, 2, 3, 4] }, n: 1, c: [9, 2, 3, 4], d: 1 });
+  assert.deepEqual(doc, copy);
+});
+
+test("errors", () => {
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/x" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: 2 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/2", value: 0 }]));
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => applyPatch({}, [{ op: "bogus", path: "" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]));
+  assert.throws(() => applyPatch({}, {}));
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+});
