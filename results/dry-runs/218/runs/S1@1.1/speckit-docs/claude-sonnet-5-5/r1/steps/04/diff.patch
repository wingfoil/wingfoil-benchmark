--- a/src/index.ts
+++ b/src/index.ts
@@ -248,3 +248,24 @@ function addAfterRemove(document: unknown, pointer: string, value: unknown): unk
   }
   return document;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a target document and returns the result as a new value.
+ * The inputs are not mutated.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch);
+  const result: Record<string, unknown> = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) setMember(result, key, clone(target[key]));
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2bb71cbbd14fa957a3f3e29e3f6c4346eeec75c4
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,41 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("does not mutate inputs or alias them", () => {
+  const target = { a: { b: 1 } };
+  const patch = { c: { d: [1] } };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 } });
+  assert.notEqual(result.a, target.a);
+  assert.notEqual(result.c, patch.c);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as any;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+});
