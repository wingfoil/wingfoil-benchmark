diff --git a/test/patch.test.ts b/test/patch.test.ts
index f63438233792eac170362233592a02e747b4d459..305db1ab979ba1f825c62009d3b2014857c362cb 100644
--- a/test/patch.test.ts
+++ b/test/patch.test.ts
@@ -28,3 +28,25 @@ test("errors", () => {
   assert.throws(() => applyPatch({}, {}));
   assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
 });
+
+test("RFC 6902 edge cases", () => {
+  // "-" is only valid as the final token of an add target
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/-", value: 0 }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/-/b", value: 0 }]));
+  // array indices: no leading zeros, no signs
+  assert.throws(() => applyPatch([1, 2], [{ op: "add", path: "/01", value: 0 }]));
+  // replace and test require an existing target
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/a", value: null }]));
+  // move: from must exist, even when it equals path
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/a", path: "/a" }]));
+  // a failing patch leaves the input untouched
+  const doc = { a: [1] };
+  assert.throws(() =>
+    applyPatch(doc, [{ op: "add", path: "/a/0", value: 0 }, { op: "remove", path: "/x" }]),
+  );
+  assert.deepEqual(doc, { a: [1] });
+  // test compares types strictly
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]));
+  assert.throws(() => applyPatch({ a: [] }, [{ op: "test", path: "/a", value: {} }]));
+});
