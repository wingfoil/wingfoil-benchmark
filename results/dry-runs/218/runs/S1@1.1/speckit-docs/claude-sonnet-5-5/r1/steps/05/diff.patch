--- a/src/index.ts
+++ b/src/index.ts
@@ -269,3 +269,97 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, out: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && jsonEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+
+  // Longest common subsequence of the differing middle part.
+  const n = endFrom - start;
+  const m = endTo - start;
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(from[start + i], to[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  let i = 0;
+  let j = 0;
+  let index = start; // position in the array as patched so far
+  while (i < n || j < m) {
+    // Collect the run of unmatched items before the next common item.
+    const removedFrom = i;
+    const addedFrom = j;
+    while (i < n || j < m) {
+      if (i < n && j < m && jsonEqual(from[start + i], to[start + j])) break;
+      if (j >= m || (i < n && lcs[i + 1][j] >= lcs[i][j + 1])) i++;
+      else j++;
+    }
+    const removed = i - removedFrom;
+    const added = j - addedFrom;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) {
+      diffValues(
+        from[start + removedFrom + k],
+        to[start + addedFrom + k],
+        `${path}/${index + k}`,
+        out,
+      );
+    }
+    index += paired;
+    for (let k = paired; k < removed; k++) {
+      out.push({ op: "remove", path: `${path}/${index}` });
+    }
+    for (let k = paired; k < added; k++) {
+      out.push({ op: "add", path: `${path}/${index}`, value: clone(to[start + addedFrom + k]) as JsonValue });
+      index++;
+    }
+    // Skip the common item that ended the run.
+    if (i < n && j < m) {
+      i++;
+      j++;
+      index++;
+    }
+  }
+}
+
+function diffValues(from: unknown, to: unknown, path: string, out: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!hasOwn(to, key)) out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (hasOwn(from, key)) diffValues(from[key], to[key], child, out);
+      else out.push({ op: "add", path: child, value: clone(to[key]) as JsonValue });
+    }
+  } else {
+    out.push({ op: "replace", path, value: clone(to) as JsonValue });
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied.
+ * Only the parts that differ are described. The inputs are not mutated.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diffValues(from, to, "", out);
+  return out;
+}
diff --git a/test/createpatch.test.ts b/test/createpatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..47cbc8bd8e5ce0d8ef65083e499b82739f7eebaf
--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,47 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown) {
+  const a = structuredClone(from);
+  const b = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, a);
+  assert.deepEqual(to, b);
+  return patch;
+}
+
+test("minimal object changes", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: { c: [1, 2] } }, { a: 1, b: { c: [1, 2] } }), []);
+  assert.deepEqual(roundTrip({ a: 1, b: { c: 1, d: 2 } }, { a: 1, b: { c: 1, d: 3 } }), [
+    { op: "replace", path: "/b/d", value: 3 },
+  ]);
+  assert.deepEqual(roundTrip({ "a/b": 1, "~": 2 }, { "a/b": 1, x: 2 }), [
+    { op: "remove", path: "/~0" },
+    { op: "add", path: "/x", value: 2 },
+  ]);
+  assert.deepEqual(roundTrip(1, [1]), [{ op: "replace", path: "", value: [1] }]);
+});
+
+test("array insert, delete, move", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.equal(roundTrip([1, 2, 3, 4, 5], [1, 3, 4, 5, 2]).length, 2);
+  assert.equal(roundTrip([{ a: 1 }, { a: 2 }, { a: 3 }], [{ a: 3 }, { a: 1 }, { a: 2 }]).length, 2);
+  assert.deepEqual(roundTrip([{ a: 1, b: 1 }, { a: 2 }], [{ a: 1, b: 2 }, { a: 2 }]), [
+    { op: "replace", path: "/0/b", value: 2 },
+  ]);
+});
+
+test("random round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) % n);
+  const gen = (d: number): unknown =>
+    rnd(4) === 0 || d > 2
+      ? rnd(4)
+      : rnd(2)
+        ? Array.from({ length: rnd(6) }, () => gen(d + 1))
+        : Object.fromEntries(Array.from({ length: rnd(4) }, () => [["a", "b/", "~", "c"][rnd(4)], gen(d + 1)]));
+  for (let k = 0; k < 2000; k++) roundTrip(gen(0), gen(0));
+});
