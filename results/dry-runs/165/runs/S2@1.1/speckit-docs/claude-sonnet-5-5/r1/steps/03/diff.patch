+
+describe('coupon return on cancellation', () => {
+  it('gives a single-use coupon back when its order is cancelled', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'NB-1', name: 'Notebook', priceCents: 500, vatClass: 'standard', weightGrams: 100 });
+    s.inventory.restock('NB-1', 20);
+    s.coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const request = { customer: 'paolo', date: '2026-06-01', lines: [{ sku: 'NB-1', quantity: 2 }], coupon: 'WELCOME' };
+    const first = s.orders.place(request);
+    s.orders.cancel(first.id, '2026-06-01');
+    assert.equal(s.coupons.usedBy('WELCOME'), undefined);
+    assert.equal(s.orders.place(request).coupon, 'WELCOME');
+  });
+});
