-const { applyPatch } = await import("../src/index.ts");
+const { applyMergePatch, applyPatch } = await import("../src/index.ts");
+
+test("applies RFC 7386 object merge semantics without modifying either input", () => {
+  const target = {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+  assert.deepEqual(target, {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  });
+  assert.deepEqual(patch, {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  });
+});
+
+test("replaces the target for non-object patches and merges objects into an empty object", () => {
+  assert.deepEqual(applyMergePatch({ value: true }, ["replacement"]), ["replacement"]);
+  assert.equal(applyMergePatch({ value: true }, null), null);
+  assert.deepEqual(applyMergePatch("not an object", { enabled: true }), { enabled: true });
+  assert.deepEqual(applyMergePatch([1, 2], { "0": "replaced" }), { "0": "replaced" });
+});
+
+test("rejects non-JSON merge-patch inputs", () => {
+  assert.throws(() => applyMergePatch({ valid: true }, { invalid: Number.NaN }));
+  assert.throws(() => applyMergePatch({ valid: true }, { invalid: undefined }));
+});
 
