+/**
+ * Applies an RFC 7386 JSON Merge Patch without modifying either input.
+ *
+ * A null member in an object patch removes that member; a non-object patch replaces its target.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  assertJsonValue(target, "target");
+  assertJsonValue(patch, "patch");
+  return mergePatch(target, patch);
+}
+
+function mergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return cloneJson(patch);
+  }
+
+  const result: JsonObject = isJsonObject(target) ? cloneJson(target) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = hasOwn(result, key) ? result[key] : null;
+      setMember(result, key, mergePatch(current, value));
+    }
+  }
+  return result;
+}
+
 function applyOperation(document: JsonValue, operation: unknown, index: number): JsonValue {
