+const { applyMergePatch, applyPatch, createPatch } = await import("../src/index.ts");
+
+test("creates a minimal structural patch for a nested change without modifying inputs", () => {
+  const from = { title: "draft", author: { name: "Ada", active: true }, unchanged: [1, 2] };
+  const to = { title: "draft", author: { name: "Ada", active: false }, unchanged: [1, 2] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: "replace", path: "/author/active", value: false }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, { title: "draft", author: { name: "Ada", active: true }, unchanged: [1, 2] });
+  assert.deepEqual(to, { title: "draft", author: { name: "Ada", active: false }, unchanged: [1, 2] });
+});
+
+test("creates escaped member paths and array insertion operations", () => {
+  const patch = createPatch({ "a/b": ["first", "third"] }, { "a/b": ["first", "second", "third"] });
+
+  assert.deepEqual(patch, [{ op: "add", path: "/a~1b/1", value: "second" }]);
+  assert.deepEqual(applyPatch({ "a/b": ["first", "third"] }, patch), { "a/b": ["first", "second", "third"] });
+});
+
+test("creates no operations for equal values and handles root, member, and array removal", () => {
+  assert.deepEqual(createPatch({ retained: true }, { retained: true }), []);
