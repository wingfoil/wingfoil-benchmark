+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to` without modifying either input.
+ *
+ * The generated patch describes structural changes where possible; `replace` is used only when a
+ * value cannot be decomposed into smaller object-member or array operations.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatchOperation[] {
+  assertJsonValue(from, "from");
+  assertJsonValue(to, "to");
+
+  const patch: JsonPatchOperation[] = [];
+  createPatchAt(from, to, [], patch);
+  return patch;
+}
