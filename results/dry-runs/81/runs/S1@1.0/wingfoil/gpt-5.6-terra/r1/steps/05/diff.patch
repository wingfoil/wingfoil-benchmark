+function createPatchAt(from: JsonValue, to: JsonValue, path: string[], patch: JsonPatchOperation[]): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+  if (isJsonObject(from) && isJsonObject(to)) {
+    createObjectPatch(from, to, path, patch);
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatch(from, to, path, patch);
+    return;
+  }
+  patch.push({ op: "replace", path: formatPointer(path), value: cloneJson(to) });
+}
+
+function createObjectPatch(from: JsonObject, to: JsonObject, path: string[], patch: JsonPatchOperation[]): void {
+  const fromKeys = Object.keys(from).sort();
+  const toKeys = Object.keys(to).sort();
+
+  for (const key of fromKeys) {
+    if (!hasOwn(to, key)) {
+      patch.push({ op: "remove", path: formatPointer([...path, key]) });
+    }
+  }
+  for (const key of fromKeys) {
+    if (hasOwn(to, key)) {
+      createPatchAt(from[key], to[key], [...path, key], patch);
+    }
+  }
+  for (const key of toKeys) {
+    if (!hasOwn(from, key)) {
+      patch.push({ op: "add", path: formatPointer([...path, key]), value: cloneJson(to[key]) });
+    }
+  }
+}
+
+function createArrayPatch(from: JsonValue[], to: JsonValue[], path: string[], patch: JsonPatchOperation[]): void {
+  if (from.length === to.length) {
+    for (let index = 0; index < from.length; index += 1) {
+      createPatchAt(from[index], to[index], [...path, String(index)], patch);
+    }
+    return;
+  }
+
+  const matches = longestCommonSubsequence(from, to);
+  let fromIndex = 0;
+  let toIndex = 0;
+  let position = 0;
+  for (const [matchedFrom, matchedTo] of matches) {
+    while (fromIndex < matchedFrom) {
+      patch.push({ op: "remove", path: formatPointer([...path, String(position)]) });
+      fromIndex += 1;
+    }
+    while (toIndex < matchedTo) {
+      patch.push({ op: "add", path: formatPointer([...path, String(position)]), value: cloneJson(to[toIndex]) });
+      toIndex += 1;
+      position += 1;
+    }
+    fromIndex += 1;
+    toIndex += 1;
+    position += 1;
+  }
+  while (fromIndex < from.length) {
+    patch.push({ op: "remove", path: formatPointer([...path, String(position)]) });
+    fromIndex += 1;
+  }
+  while (toIndex < to.length) {
+    patch.push({ op: "add", path: formatPointer([...path, String(position)]), value: cloneJson(to[toIndex]) });
+    toIndex += 1;
+    position += 1;
+  }
+}
+
+function longestCommonSubsequence(from: JsonValue[], to: JsonValue[]): Array<[number, number]> {
+  const lengths = Array.from({ length: from.length + 1 }, () => new Array<number>(to.length + 1).fill(0));
+  for (let fromIndex = from.length - 1; fromIndex >= 0; fromIndex -= 1) {
+    for (let toIndex = to.length - 1; toIndex >= 0; toIndex -= 1) {
+      lengths[fromIndex][toIndex] = jsonEqual(from[fromIndex], to[toIndex])
+        ? lengths[fromIndex + 1][toIndex + 1] + 1
+        : Math.max(lengths[fromIndex + 1][toIndex], lengths[fromIndex][toIndex + 1]);
+    }
+  }
+
+  const matches: Array<[number, number]> = [];
+  let fromIndex = 0;
+  let toIndex = 0;
+  while (fromIndex < from.length && toIndex < to.length) {
+    if (jsonEqual(from[fromIndex], to[toIndex])) {
+      matches.push([fromIndex, toIndex]);
+      fromIndex += 1;
+      toIndex += 1;
+    } else if (lengths[fromIndex + 1][toIndex] >= lengths[fromIndex][toIndex + 1]) {
+      fromIndex += 1;
+    } else {
+      toIndex += 1;
+    }
+  }
+  return matches;
+}
+
+function formatPointer(path: string[]): string {
+  return path.length === 0 ? "" : `/${path.map((token) => token.replace(/~/g, "~0").replace(/\//g, "~1")).join("/")}`;
+}
