+
+function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed.length === 0) return err('invalid-input', 'title must not be empty');
+  if (trimmed.length > 120) return err('invalid-input', 'title must be at most 120 characters');
+  return ok(trimmed);
+}
+
+function validatePriority(priority: Priority | undefined): Result<Priority | undefined> {
+  if (priority !== undefined && !PRIORITIES.includes(priority)) {
+    return err('invalid-input', 'priority must be one of "low", "normal", or "high"');
+  }
+  return ok(priority);
+}
+
+function validateTag(tag: string): Result<string> {
+  if (tag.length === 0) return err('invalid-input', 'tag must not be empty');
+  if (tag.includes(' ')) return err('invalid-input', 'tag must not contain spaces');
+  return ok(tag);
+}
