@@ -1,5 +1,6 @@
 import { createTaskList } from './domain/list.ts';
 import type { TaskList } from './domain/list.ts';
+import type { Priority } from './domain/task.ts';
 
 export type { TaskFilter, TaskList } from './domain/list.ts';
 export type { Result, TodoError, TodoErrorCode } from './domain/result.ts';
@@ -8,6 +9,20 @@ export type { Summary } from './domain/summary.ts';
 export { PRIORITIES } from './domain/task.ts';
 export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 
+/** A source line that could not be imported and why it was rejected. */
+export interface RejectedTaskImport {
+  /** The one-based line number in the imported text. */
+  readonly line: number;
+  /** The reason the line could not be added. */
+  readonly reason: string;
+}
+
+/** The number of tasks imported and the non-blank lines that were rejected. */
+export interface TaskImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedTaskImport[];
+}
+
 /**
  * A new, empty task list for the app, kept in memory.
  *
@@ -16,3 +31,35 @@ export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 export function createTodoList(now: () => string = () => new Date().toISOString()): TaskList {
   return createTaskList(now);
 }
+
+/**
+ * Adds every valid `title;priority;tags` line in `text` to `list`.
+ *
+ * @param list - the task list to add imported tasks to
+ * @param text - one task per line, with space-separated tags and an optional priority
+ */
+export function importTasks(list: TaskList, text: string): TaskImportResult {
+  const rejected: RejectedTaskImport[] = [];
+  let imported = 0;
+
+  for (const [index, line] of text.split(/\r?\n/).entries()) {
+    if (line.trim() === '') continue;
+
+    const fields = line.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'expected title;priority;tags' });
+      continue;
+    }
+
+    const [title, priority, tags] = fields;
+    const added = list.add({
+      title,
+      priority: (priority.trim() || undefined) as Priority | undefined,
+      tags: tags.trim() === '' ? [] : tags.trim().split(/\s+/),
+    });
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  }
+
+  return { imported, rejected };
+}
