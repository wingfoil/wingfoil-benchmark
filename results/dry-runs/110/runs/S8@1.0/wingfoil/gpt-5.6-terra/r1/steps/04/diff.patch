+
+describe('importTasks', () => {
+  it('imports valid rows, using normal priority for an empty priority and skipping blank rows', () => {
+    const list = createTodoList(() => '2026-10-28T10:00:00.000Z');
+
+    const result = importTasks(list, 'Renew the insurance;high;admin money\n\nBuy milk;;errands');
+
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+    assert.deepEqual(
+      list.list().map(({ title, priority, tags }) => ({ title, priority, tags })),
+      [
+        { title: 'Renew the insurance', priority: 'high', tags: ['admin', 'money'] },
+        { title: 'Buy milk', priority: 'normal', tags: ['errands'] },
+      ],
+    );
+  });
+
+  it('reports malformed and invalid rows by their original line number while importing other rows', () => {
+    const list = createTodoList();
+
+    const result = importTasks(list, 'Pay rent;urgent;home\nMissing tags;high\n\nPay rent;;home');
+
+    assert.deepEqual(result, {
+      imported: 1,
+      rejected: [
+        { line: 1, reason: 'priority must be one of "low", "normal", or "high"' },
+        { line: 2, reason: 'expected title;priority;tags' },
+      ],
