@@ -62,3 +62,16 @@ test('rentals shorter than a day are priced by the hour', () => {
   assert.throws(() => s.quote({ ...r, end: '2026-07-02T13:00:00Z' }));
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
 });
+
+test('cancel refunds before the start, frees the equipment and works only once', () => {
+  const s = setup();
+  const r = { itemId: 'b1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' };
+  const a = s.book(r);
+  assert.throws(() => s.cancel('nope', '2026-06-01T00:00:00Z'));
+  assert.throws(() => s.cancel(a.id, 'yesterday'));
+  assert.deepEqual(s.cancel(a.id, '2026-06-30T23:59:59Z'), { bookingId: a.id, refund: 5000 });
+  assert.throws(() => s.cancel(a.id, '2026-06-30T23:59:59Z'));
+  assert.deepEqual(s.availability({ start: r.start, end: r.end }), ['b1']);
+  const b = s.book(r);
+  assert.deepEqual(s.cancel(b.id, '2026-07-01T00:00:00Z'), { bookingId: b.id, refund: 0 });
+});
