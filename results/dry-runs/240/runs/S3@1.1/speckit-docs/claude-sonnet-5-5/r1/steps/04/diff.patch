@@ -48,3 +48,17 @@ test('availability lists free items of a kind, sorted', () => {
   assert.deepEqual(s.availability({ start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z', kind: 'board' }), ['b0', 'b1']);
   assert.throws(() => s.availability({ start: q.end, end: q.start }));
 });
+
+test('rentals shorter than a day are priced by the hour', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  const r = { itemId: 'h1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T16:00:00Z' };
+  assert.equal(s.quote(r).total, 1800);
+  assert.equal(s.book(r).total, 1800);
+  assert.throws(() => s.book({ ...r, end: '2026-07-01T14:00:00Z' }));
+  assert.throws(() => s.quote({ ...r, itemId: 'b1' }));
+  assert.throws(() => s.quote({ ...r, end: '2026-07-01T16:30:00Z' }));
+  assert.throws(() => s.quote({ ...r, end: '2026-07-02T13:00:00Z' }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+});
