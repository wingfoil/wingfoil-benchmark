+import type { TaskList } from './list.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** A line of the import text that could not be added, with its number (from 1) and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks it added, and the lines it could not add. */
+export interface ImportSummary {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds to a list the tasks written one per line as `title;priority;tags`. The priority may be empty for a
+ * normal one, tags are separated by spaces, and blank lines are skipped. A line that cannot be added is
+ * reported with its number and reason, and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportSummary {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  text.split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `expected "title;priority;tags" but found ${fields.length} parts` });
+      return;
+    }
+    const [title, priority = '', tags = ''] = fields;
+    const input: NewTask = {
+      title,
+      priority: priority.trim() === '' ? undefined : (priority.trim() as Priority),
+      tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+    };
+    const added = list.add(input);
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
