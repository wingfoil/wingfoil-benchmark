@@ -0,0 +1,41 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds each valid line with its priority and tags, skipping blank lines', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin money\n\n  \nBuy milk;;\nCall mum\r\nWater plants;low;home home');
+    assert.deepEqual(result, { imported: 4, rejected: [] });
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok && milk.value.priority === 'normal');
+    const plants = list.find('Water plants');
+    assert.ok(plants.ok && plants.value.tags.length === 1);
+  });
+
+  it('rejects an empty title, a bad priority, a long title and extra parts, counting lines from 1', () => {
+    const list = createTodoList();
+    const result = importTasks(list, `;high;x\n\nOk task;urgent;\n${'a'.repeat(121)};;\nToo;high;a;b\nFine;;`);
+    assert.equal(result.imported, 1);
+    assert.deepEqual(result.rejected.map((r) => r.line), [1, 3, 4, 5]);
+    assert.ok(result.rejected.every((r) => r.reason !== ''));
+    assert.equal(list.list().length, 1);
+  });
+
+  it('rejects a duplicate title, in the list or in the text', () => {
+    const list = createTodoList();
+    list.add({ title: 'Buy milk' });
+    const result = importTasks(list, 'Buy milk;;\nNew;;\nNew;high;');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(result.rejected.map((r) => r.line), [1, 3]);
+  });
+
+  it('imports nothing from empty text', () => {
+    assert.deepEqual(importTasks(createTodoList(), ''), { imported: 0, rejected: [] });
+  });
+});
