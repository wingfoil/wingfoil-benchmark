+    code(list.add({ title: '   ' }));
+    code(list.add({ title: 'x'.repeat(121) }));
+    code(list.add({ title: 'ok', priority: 'urgent' as never }));
+    code(list.add({ title: 'ok', tags: ['fine', ''] }));
+    code(list.add({ title: 'ok', tags: ['a b'] }));
+    assert.equal(list.list().length, 0);
+    assert.equal(valueOf(list.add({ title: 'x'.repeat(120) })).title.length, 120);
