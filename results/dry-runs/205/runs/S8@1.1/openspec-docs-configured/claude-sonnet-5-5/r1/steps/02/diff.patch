+describe('task timestamps', () => {
+  const clock = () => {
+    let minute = 0;
+    return () => new Date(Date.UTC(2026, 0, 1, 0, minute++)).toISOString();
+  };
+
+  it('sets createdAt and updatedAt to the same time when a task is added', () => {
+    const list = createTodoList(clock());
+    const task = valueOf(list.add({ title: 'a' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    const list = createTodoList(clock());
+    const created = valueOf(list.add({ title: 'a' })).createdAt;
+    const steps = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.rename('a', 'b'),
+      () => list.tag('b', 'x'),
+      () => list.untag('b', 'x'),
+    ];
+    let previous = created;
+    for (const step of steps) {
+      const task = valueOf(step());
+      assert.equal(task.createdAt, created);
+      assert.ok(task.updatedAt > previous);
+      previous = task.updatedAt;
+    }
+  });
+
+  it('leaves updatedAt alone when a change fails', () => {
+    const list = createTodoList(clock());
+    const before = valueOf(list.add({ title: 'a' }));
+    assert.equal(list.reopen('a').ok, false);
+    assert.deepEqual(valueOf(list.find('a')), before);
+  });
+});
