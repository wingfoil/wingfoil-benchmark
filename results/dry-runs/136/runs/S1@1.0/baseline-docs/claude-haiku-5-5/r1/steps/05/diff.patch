diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d489bc1a33f1dac810fe7c901af7a6abe2fb477d
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,170 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch, JsonPatchError } from "../src/index.ts";
+
+describe("createPatch", () => {
+  describe("describes the change", () => {
+    it("returns an empty patch for equal documents", () => {
+      assert.deepEqual(createPatch({ a: [1, { b: "c" }] }, { a: [1, { b: "c" }] }), []);
+    });
+
+    it("ignores the order of object members", () => {
+      assert.deepEqual(createPatch({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+    });
+
+    it("replaces a changed scalar member", () => {
+      assert.deepEqual(createPatch({ name: "old" }, { name: "new" }), [
+        { op: "replace", path: "/name", value: "new" },
+      ]);
+    });
+
+    it("adds a new member", () => {
+      assert.deepEqual(createPatch({ a: 1 }, { a: 1, b: { c: [true] } }), [
+        { op: "add", path: "/b", value: { c: [true] } },
+      ]);
+    });
+
+    it("removes a member that is gone", () => {
+      assert.deepEqual(createPatch({ a: 1, b: 2 }, { a: 1 }), [{ op: "remove", path: "/b" }]);
+    });
+
+    it("keeps a member whose value is null, and removes one that is absent", () => {
+      assert.deepEqual(createPatch({ a: null }, { a: null }), []);
+      assert.deepEqual(createPatch({ a: null }, {}), [{ op: "remove", path: "/a" }]);
+    });
+
+    it("describes a change deep in the document by its own path", () => {
+      assert.deepEqual(
+        createPatch({ order: { customer: { address: { city: "Lyon", zip: "69001" } } } }, {
+          order: { customer: { address: { city: "Paris", zip: "69001" } } },
+        }),
+        [{ op: "replace", path: "/order/customer/address/city", value: "Paris" }],
+      );
+    });
+
+    it("replaces the whole document when its kind changes", () => {
+      assert.deepEqual(createPatch({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+      assert.deepEqual(createPatch([1], "x"), [{ op: "replace", path: "", value: "x" }]);
+      assert.deepEqual(createPatch(null, { a: 1 }), [{ op: "replace", path: "", value: { a: 1 } }]);
+    });
+
+    it("replaces the root when two scalars differ", () => {
+      assert.deepEqual(createPatch(1, 2), [{ op: "replace", path: "", value: 2 }]);
+    });
+
+    it("replaces an element of an array in place", () => {
+      assert.deepEqual(
+        createPatch({ items: [{ sku: "A-1" }, { sku: "B-2" }] }, { items: [{ sku: "A-1" }, { sku: "C-3" }] }),
+        [{ op: "replace", path: "/items/1/sku", value: "C-3" }],
+      );
+    });
+
+    it("adds an element inserted into the middle of an array", () => {
+      assert.deepEqual(createPatch({ tags: ["a", "c"] }, { tags: ["a", "b", "c"] }), [
+        { op: "add", path: "/tags/1", value: "b" },
+      ]);
+    });
+
+    it("removes an element taken out of the middle of an array", () => {
+      assert.deepEqual(createPatch({ tags: ["a", "b", "c"] }, { tags: ["a", "c"] }), [
+        { op: "remove", path: "/tags/1" },
+      ]);
+    });
+
+    it("adds elements appended to an array", () => {
+      assert.deepEqual(createPatch({ tags: ["a"] }, { tags: ["a", "b", "c"] }), [
+        { op: "add", path: "/tags/1", value: "b" },
+        { op: "add", path: "/tags/2", value: "c" },
+      ]);
+    });
+
+    it("removes elements cut from the end of an array", () => {
+      assert.deepEqual(createPatch({ tags: ["a", "b", "c"] }, { tags: ["a"] }), [
+        { op: "remove", path: "/tags/1" },
+        { op: "remove", path: "/tags/1" },
+      ]);
+    });
+
+    it("empties an array and fills an empty one", () => {
+      assert.deepEqual(createPatch({ tags: [] }, { tags: ["a"] }), [{ op: "add", path: "/tags/0", value: "a" }]);
+      assert.deepEqual(createPatch({ tags: ["a"] }, { tags: [] }), [{ op: "remove", path: "/tags/0" }]);
+    });
+
+    it("escapes slash and tilde in member names", () => {
+      assert.deepEqual(createPatch({ "a/b": 1, "c~d": 1 }, { "a/b": 2, "c~d": 3 }), [
+        { op: "replace", path: "/a~1b", value: 2 },
+        { op: "replace", path: "/c~0d", value: 3 },
+      ]);
+    });
+  });
+
+  describe("round trip", () => {
+    const cases: [string, unknown, unknown][] = [
+      ["scalar members", { a: 1, b: "x" }, { a: 2, c: true }],
+      ["nested objects", { a: { b: { c: 1, d: [1, 2] } } }, { a: { b: { d: [2] }, e: null } }],
+      ["arrays of objects", [{ id: 1 }, { id: 2 }, { id: 3 }], [{ id: 0 }, { id: 2 }, { id: 3 }, { id: 4 }]],
+      ["nested arrays", [[1, 2], [3]], [[2], [3, 4], []]],
+      ["an array emptied", { a: [1, 2, 3] }, { a: [] }],
+      ["an array filled", { a: [] }, { a: [{ x: [] }] }],
+      ["the root changing kind", [1, 2], { a: "b" }],
+      ["member names with escapes", { "~/": 1 }, { "~/": 2, "/~": [] }],
+      ["a member named __proto__", JSON.parse('{"__proto__": {"a": 1}}'), JSON.parse('{"__proto__": {"a": 2}}')],
+    ];
+    for (const [name, from, to] of cases) {
+      it(`turns one into the other for ${name}`, () => {
+        assert.deepEqual(applyPatch(from, createPatch(from, to)), to);
+      });
+    }
+  });
+
+  describe("size of the patch", () => {
+    it("describes one small edit in a large document with one operation", () => {
+      const items = Array.from({ length: 1000 }, (_, i) => ({ id: i, price: i, label: `item ${i}` }));
+      const from = { catalogue: { items } };
+      const to = structuredClone(from);
+      to.catalogue.items[500].price = 9999;
+
+      const patch = createPatch(from, to);
+
+      assert.deepEqual(patch, [{ op: "replace", path: "/catalogue/items/500/price", value: 9999 }]);
+    });
+
+    it("describes an element inserted into a large array with one operation", () => {
+      const ids = Array.from({ length: 1000 }, (_, i) => i);
+      const to = [...ids.slice(0, 400), -1, ...ids.slice(400)];
+
+      assert.deepEqual(createPatch({ ids }, { ids: to }), [{ op: "add", path: "/ids/400", value: -1 }]);
+    });
+  });
+
+  describe("inputs", () => {
+    it("does not mutate either document", () => {
+      const from = { a: { b: [1, 2, { c: "x" }] }, d: "y" };
+      const to = { a: { b: [1, 3, { c: "z" }, 4] }, e: [null] };
+      const fromBefore = structuredClone(from);
+      const toBefore = structuredClone(to);
+
+      createPatch(from, to);
+
+      assert.deepEqual(from, fromBefore);
+      assert.deepEqual(to, toBefore);
+    });
+
+    it("returns values that share no structure with the documents", () => {
+      const from = { a: 1 };
+      const to = { a: { nested: [1] } };
+      const patch = createPatch(from, to);
+
+      (patch[0].value as { nested: number[] }).nested.push(2);
+
+      assert.deepEqual(to, { a: { nested: [1] } });
+    });
+
+    it("rejects a document that is not a JSON value", () => {
+      assert.throws(() => createPatch({ a: undefined }, {}), JsonPatchError);
+      assert.throws(() => createPatch({}, { a: Number.NaN }), JsonPatchError);
+      assert.throws(() => createPatch(new Date(), {}), JsonPatchError);
+      assert.throws(() => createPatch({}, () => 1), JsonPatchError);
+    });
+  });
+});
