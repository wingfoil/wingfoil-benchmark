@@ -427,6 +427,125 @@ function jsonEqual(actual: unknown, expected: unknown): boolean {
   return actual === expected;
 }
 
+/** One operation of a JSON Patch, as `createPatch` produces it. */
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+/**
+ * Produces the JSON Patch (RFC 6902) that turns `from` into `to` when applied
+ * with `applyPatch`. The patch describes only what changed: objects are
+ * compared member by member, and arrays element by element, once the elements
+ * they share at the start and at the end are set aside. So one edit to a large
+ * document gives one operation, and an element inserted into an array gives
+ * one `add`, not a `replace` for every element after it.
+ *
+ * Equal documents give an empty patch. Neither input is mutated, and the values
+ * in the patch are copies, so the patch shares no structure with `from` or `to`.
+ *
+ * @throws {JsonPatchError} when `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new JsonPatchError("createPatch needs two JSON values");
+  }
+  const operations: PatchOperation[] = [];
+  diffValues(from, to, [], operations);
+  return operations;
+}
+
+/**
+ * Appends the operations that turn `from` into `to`, located at the reference
+ * `tokens`, to `operations`.
+ */
+function diffValues(from: unknown, to: unknown, tokens: string[], operations: PatchOperation[]): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, tokens, operations);
+  } else if (isJsonObject(from) && isJsonObject(to)) {
+    diffMembers(from, to, tokens, operations);
+  } else {
+    operations.push({ op: "replace", path: pointerOf(tokens), value: structuredClone(to) });
+  }
+}
+
+/** Appends the operations that turn the members of `from` into those of `to`. */
+function diffMembers(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  tokens: string[],
+  operations: PatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      operations.push({ op: "remove", path: pointerOf([...tokens, key]) });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const path = [...tokens, key];
+    if (Object.hasOwn(from, key)) {
+      diffValues(from[key], to[key], path, operations);
+    } else {
+      operations.push({ op: "add", path: pointerOf(path), value: structuredClone(to[key]) });
+    }
+  }
+}
+
+/**
+ * Appends the operations that turn the elements of `from` into those of `to`.
+ * The elements at the same positions in the middle of both arrays are compared
+ * in place; the surplus of the longer array is then removed or added at the
+ * position where the middle ends.
+ */
+function diffArrays(from: unknown[], to: unknown[], tokens: string[], operations: PatchOperation[]): void {
+  const head = commonHead(from, to);
+  const tail = commonTail(from, to, head);
+  const fromEnd = from.length - tail;
+  const toEnd = to.length - tail;
+  const paired = Math.min(fromEnd, toEnd) - head;
+  for (let i = head; i < head + paired; i++) {
+    diffValues(from[i], to[i], [...tokens, String(i)], operations);
+  }
+  const at = head + paired;
+  // Each removal takes the element that follows the last one removed, so they all name `at`.
+  for (let i = at; i < fromEnd; i++) {
+    operations.push({ op: "remove", path: pointerOf([...tokens, String(at)]) });
+  }
+  for (let i = at; i < toEnd; i++) {
+    operations.push({ op: "add", path: pointerOf([...tokens, String(i)]), value: structuredClone(to[i]) });
+  }
+}
+
+/** Counts the elements at the start of both arrays that are equal. */
+function commonHead(from: unknown[], to: unknown[]): number {
+  const limit = Math.min(from.length, to.length);
+  let count = 0;
+  while (count < limit && jsonEqual(from[count], to[count])) {
+    count++;
+  }
+  return count;
+}
+
+/**
+ * Counts the elements at the end of both arrays that are equal, without
+ * reaching into the first `head` elements of either.
+ */
+function commonTail(from: unknown[], to: unknown[], head: number): number {
+  const limit = Math.min(from.length, to.length) - head;
+  let count = 0;
+  while (count < limit && jsonEqual(from[from.length - 1 - count], to[to.length - 1 - count])) {
+    count++;
+  }
+  return count;
+}
+
+/** Builds the JSON Pointer (RFC 6901) for reference tokens, escaping "~" and "/". */
+function pointerOf(tokens: readonly string[]): string {
+  return tokens.map((token) => `/${token.replace(/~/g, "~0").replace(/\//g, "~1")}`).join("");
+}
