+
+/**
+ * Thrown when a JSON Patch (RFC 6902) is not valid, or when one of its
+ * operations fails.
+ */
+export class JsonPatchError extends Error {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = "JsonPatchError";
+  }
+}
+
+/** One operation of a JSON Patch whose members have been checked. */
+type Operation =
+  | { op: "add" | "replace" | "test"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; path: string; from: string };
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the resulting
+ * document. The operations are applied in order.
+ *
+ * The input is not mutated: the result is a new value that shares no
+ * structure with `document` or `patch`. The patch is checked as a whole before
+ * any operation runs, and a failing operation discards every change made so
+ * far.
+ *
+ * @throws {JsonPatchError} when `patch` is not a valid JSON Patch, or when one
+ * of its operations fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  let result = structuredClone(document);
+  for (const operation of parsePatch(patch)) {
+    result = applyOperation(result, operation);
+  }
+  return result;
+}
+
+/** Checks that `patch` is an array of well-formed operations. */
+function parsePatch(patch: unknown): Operation[] {
+  if (!Array.isArray(patch)) {
+    throw new JsonPatchError("a JSON Patch must be an array of operations");
+  }
+  return patch.map(parseOperation);
+}
+
+/** Checks the members that each kind of operation requires. */
+function parseOperation(input: unknown, index: number): Operation {
+  if (!isContainer(input) || Array.isArray(input)) {
+    throw new JsonPatchError(`operation ${index} must be an object`);
+  }
+  const { op, path, value, from } = input as Record<string, unknown>;
+  if (typeof path !== "string") {
+    throw new JsonPatchError(`operation ${index} needs a string "path"`);
+  }
+  switch (op) {
+    case "add":
+    case "replace":
+    case "test":
+      // `undefined` is not a JSON value, so a missing "value" is an error.
+      if (value === undefined) {
+        throw new JsonPatchError(`operation ${index} (${op}) needs a "value"`);
+      }
+      return { op, path, value };
+    case "remove":
+      return { op, path };
+    case "move":
+    case "copy":
+      if (typeof from !== "string") {
+        throw new JsonPatchError(`operation ${index} (${op}) needs a string "from"`);
+      }
+      return { op, path, from };
+    default:
+      throw new JsonPatchError(`operation ${index} has an unknown "op": ${JSON.stringify(op)}`);
+  }
+}
+
+/**
+ * Applies one operation and returns the resulting document. Pointer errors are
+ * reported as patch errors, so callers see a single error type.
+ */
+function applyOperation(document: unknown, operation: Operation): unknown {
+  try {
+    return perform(document, operation);
+  } catch (error) {
+    if (error instanceof JsonPointerError) {
+      throw new JsonPatchError(error.message, { cause: error });
+    }
+    throw error;
+  }
+}
+
+function perform(document: unknown, operation: Operation): unknown {
+  switch (operation.op) {
+    case "add":
+      return add(document, operation.path, structuredClone(operation.value));
+    case "remove":
+      return remove(document, operation.path);
+    case "replace":
+      return replace(document, operation.path, structuredClone(operation.value));
+    case "move":
+      return move(document, operation.from, operation.path);
+    case "copy":
+      return add(document, operation.path, structuredClone(resolvePointer(document, operation.from)));
+    case "test":
+      return testValue(document, operation.path, operation.value);
+  }
+}
+
+/**
+ * Adds `value` at `pointer`. The document is changed in place, so it must be a
+ * copy owned by `applyPatch`; the root that results is returned.
+ */
+function add(document: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const { parent, token } = locate(document, tokens, pointer);
+  insertMember(parent, token, value, pointer);
+  return document;
+}
+
+/** Removes the member or element at `pointer`, which must exist. */
+function remove(document: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    throw new JsonPatchError("the whole document cannot be removed");
+  }
+  resolveTokens(document, tokens, pointer);
+  const { parent, token } = locate(document, tokens, pointer);
+  removeMember(parent, token);
+  return document;
+}
+
+/** Replaces the value at `pointer`, which must exist. */
+function replace(document: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    return value;
+  }
+  resolveTokens(document, tokens, pointer);
+  const { parent, token } = locate(document, tokens, pointer);
+  assignMember(parent, token, value);
+  return document;
+}
+
+/** Moves the value at `from` to `pointer`. The value cannot move into itself. */
+function move(document: unknown, from: string, pointer: string): unknown {
+  if (isProperPrefix(parsePointer(from), parsePointer(pointer))) {
+    throw new JsonPatchError(`${JSON.stringify(from)} cannot be moved into one of its own children`);
+  }
+  const value = resolvePointer(document, from);
+  return add(remove(document, from), pointer, value);
+}
+
+/** Returns the document unchanged when the value at `pointer` equals `expected`. */
+function testValue(document: unknown, pointer: string, expected: unknown): unknown {
+  if (!jsonEqual(resolvePointer(document, pointer), expected)) {
+    throw new JsonPatchError(`the value at ${JSON.stringify(pointer)} is not the tested value`);
+  }
+  return document;
+}
+
+/**
+ * Finds the container holding the target of a non-empty pointer, and the token
+ * that names the target within it. The container must resolve.
+ */
+function locate(document: unknown, tokens: string[], pointer: string): { parent: object; token: string } {
+  const parent = resolveTokens(document, tokens.slice(0, -1), pointer);
+  if (!isContainer(parent)) {
+    throw new JsonPatchError(`${JSON.stringify(pointer)} has a parent that is neither an object nor an array`);
+  }
+  return { parent, token: tokens[tokens.length - 1] };
+}
+
+/** Inserts `value` as a new member, or as an element at an insertion index, of `parent`. */
+function insertMember(parent: object, token: string, value: unknown, pointer: string): void {
+  if (!Array.isArray(parent)) {
+    setMember(parent, token, value);
+    return;
+  }
+  if (token === "-") {
+    parent.push(value);
+    return;
+  }
+  const index = arrayIndex(token);
+  if (index === undefined || index > parent.length) {
+    throw new JsonPatchError(`${JSON.stringify(pointer)} is not an index into the array`);
+  }
+  parent.splice(index, 0, value);
+}
+
+/** Replaces an existing member or element of `parent`. Its position is kept. */
+function assignMember(parent: object, token: string, value: unknown): void {
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else {
+    setMember(parent, token, value);
+  }
+}
+
+/** Removes an existing member or element of `parent`. */
+function removeMember(parent: object, token: string): void {
+  if (Array.isArray(parent)) {
+    parent.splice(Number(token), 1);
+  } else {
+    delete (parent as Record<string, unknown>)[token];
+  }
+}
+
+/**
+ * Sets an object member. A property is defined rather than assigned, so that a
+ * key such as "__proto__" becomes an own member and does not change the prototype.
+ */
+function setMember(object: object, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Reports whether `prefix` is a proper prefix of `tokens`, so `tokens` lies inside the location `prefix` names. */
+function isProperPrefix(prefix: string[], tokens: string[]): boolean {
+  return prefix.length < tokens.length && prefix.every((token, i) => token === tokens[i]);
+}
+
+/**
+ * Compares two JSON values. Object members match in any order; array elements
+ * must match in order.
+ */
+function jsonEqual(actual: unknown, expected: unknown): boolean {
+  if (Array.isArray(actual)) {
+    return (
+      Array.isArray(expected) &&
+      actual.length === expected.length &&
+      actual.every((item, i) => jsonEqual(item, expected[i]))
+    );
+  }
+  if (isContainer(actual)) {
+    if (!isContainer(expected) || Array.isArray(expected)) {
+      return false;
+    }
+    const members = actual as Record<string, unknown>;
+    const others = expected as Record<string, unknown>;
+    const keys = Object.keys(members);
+    return (
+      keys.length === Object.keys(others).length &&
+      keys.every((key) => Object.hasOwn(others, key) && jsonEqual(members[key], others[key]))
+    );
+  }
+  return actual === expected;
+}
