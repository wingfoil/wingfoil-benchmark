@@ -0,0 +1,325 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, JsonPatchError } from "../src/index.ts";
+
+describe("applyPatch", () => {
+  describe("RFC 6902 appendix A examples", () => {
+    it("adds an object member", () => {
+      assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), {
+        foo: "bar",
+        baz: "qux",
+      });
+    });
+
+    it("adds an array element before the given index", () => {
+      assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), {
+        foo: ["bar", "qux", "baz"],
+      });
+    });
+
+    it("removes an object member", () => {
+      assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+    });
+
+    it("removes an array element", () => {
+      assert.deepEqual(applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), {
+        foo: ["bar", "baz"],
+      });
+    });
+
+    it("replaces a value", () => {
+      assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), {
+        baz: "boo",
+        foo: "bar",
+      });
+    });
+
+    it("moves a value to another member", () => {
+      const doc = { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } };
+      assert.deepEqual(applyPatch(doc, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]), {
+        foo: { bar: "baz" },
+        qux: { corge: "grault", thud: "fred" },
+      });
+    });
+
+    it("moves an array element to a later index", () => {
+      assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+        foo: ["all", "cows", "eat", "grass"],
+      });
+    });
+
+    it("copies a value", () => {
+      const doc = { foo: { bar: ["baz"] } };
+      assert.deepEqual(applyPatch(doc, [{ op: "copy", from: "/foo/bar", path: "/qux" }]), {
+        foo: { bar: ["baz"] },
+        qux: ["baz"],
+      });
+    });
+
+    it("keeps the document when a test succeeds", () => {
+      const doc = { baz: "qux", foo: ["a", 2, "c"] };
+      assert.deepEqual(
+        applyPatch(doc, [
+          { op: "test", path: "/baz", value: "qux" },
+          { op: "test", path: "/foo/1", value: 2 },
+        ]),
+        doc,
+      );
+    });
+
+    it("throws when a test fails", () => {
+      assert.throws(() => applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]), JsonPatchError);
+    });
+
+    it("adds a nested object", () => {
+      assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]), {
+        foo: "bar",
+        child: { grandchild: {} },
+      });
+    });
+
+    it("ignores unrecognized members of an operation", () => {
+      assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }]), {
+        foo: "bar",
+        baz: "qux",
+      });
+    });
+
+    it("throws when adding under a target that does not exist", () => {
+      assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]), JsonPatchError);
+    });
+
+    it("compares keys and escaped pointer tokens exactly", () => {
+      const doc = { "/": 9, "~1": 10 };
+      assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/~01", value: 10 }]), doc);
+      assert.throws(() => applyPatch(doc, [{ op: "test", path: "/~01", value: "10" }]), JsonPatchError);
+    });
+
+    it("appends an array value with the - token", () => {
+      assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]), {
+        foo: ["bar", ["abc", "def"]],
+      });
+    });
+  });
+
+  describe("add", () => {
+    it("replaces an existing object member", () => {
+      assert.deepEqual(applyPatch({ foo: 1 }, [{ op: "add", path: "/foo", value: 2 }]), { foo: 2 });
+    });
+
+    it("appends to an array with the - token", () => {
+      assert.deepEqual(applyPatch({ a: [1] }, [{ op: "add", path: "/a/-", value: 2 }]), { a: [1, 2] });
+    });
+
+    it("inserts at the index equal to the length of an array", () => {
+      assert.deepEqual(applyPatch({ a: [1] }, [{ op: "add", path: "/a/1", value: 2 }]), { a: [1, 2] });
+    });
+
+    it("throws when the index is past the end of an array", () => {
+      assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/2", value: 2 }]), JsonPatchError);
+    });
+
+    it("throws when the array index has a leading zero", () => {
+      assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/01", value: 2 }]), JsonPatchError);
+    });
+
+    it("replaces the whole document when the path is empty", () => {
+      assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [2] }]), [2]);
+    });
+
+    it("throws when the parent is a primitive", () => {
+      assert.throws(() => applyPatch({ a: 5 }, [{ op: "add", path: "/a/b", value: 1 }]), JsonPatchError);
+    });
+
+    it("throws when the parent is null", () => {
+      assert.throws(() => applyPatch({ a: null }, [{ op: "add", path: "/a/b", value: 1 }]), JsonPatchError);
+    });
+
+    it("adds a member named __proto__ as an own property", () => {
+      const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as object;
+      assert.deepEqual(Object.keys(result), ["__proto__"]);
+      assert.equal(Object.getPrototypeOf(result), Object.prototype);
+      assert.equal(({} as Record<string, unknown>).polluted, undefined);
+    });
+  });
+
+  describe("remove", () => {
+    it("throws when the member does not exist", () => {
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "/b" }]), JsonPatchError);
+    });
+
+    it("throws when the array index does not exist", () => {
+      assert.throws(() => applyPatch({ a: [1] }, [{ op: "remove", path: "/a/1" }]), JsonPatchError);
+    });
+
+    it("throws when the path is empty", () => {
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]), JsonPatchError);
+    });
+  });
+
+  describe("replace", () => {
+    it("replaces the whole document when the path is empty", () => {
+      assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: "x" }]), "x");
+    });
+
+    it("throws when the target does not exist", () => {
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: "replace", path: "/b", value: 2 }]), JsonPatchError);
+    });
+
+    it("throws when the array index is past the end", () => {
+      assert.throws(() => applyPatch({ a: [1] }, [{ op: "replace", path: "/a/1", value: 2 }]), JsonPatchError);
+    });
+  });
+
+  describe("move and copy", () => {
+    it("moves a value to the same location unchanged", () => {
+      assert.deepEqual(applyPatch({ a: [1, 2] }, [{ op: "move", from: "/a/0", path: "/a/0" }]), { a: [1, 2] });
+    });
+
+    it("copies a value into an independent location", () => {
+      const result = applyPatch({ a: { b: 1 } }, [{ op: "copy", from: "/a", path: "/c" }]) as {
+        a: { b: number };
+        c: { b: number };
+      };
+      result.c.b = 2;
+      assert.deepEqual(result.a, { b: 1 });
+    });
+
+    it("throws when moving a value into one of its own children", () => {
+      assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b/c" }]), JsonPatchError);
+    });
+
+    it("throws when the source of a move does not exist", () => {
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "/b", path: "/c" }]), JsonPatchError);
+    });
+
+    it("throws when the source of a copy does not exist", () => {
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", from: "/b", path: "/c" }]), JsonPatchError);
+    });
+  });
+
+  describe("test", () => {
+    it("compares objects regardless of key order", () => {
+      const doc = { a: { x: 1, y: [true, null] } };
+      assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/a", value: { y: [true, null], x: 1 } }]), doc);
+    });
+
+    it("compares a null value", () => {
+      const doc = { a: null };
+      assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/a", value: null }]), doc);
+    });
+
+    it("fails when a value has a different type", () => {
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]), JsonPatchError);
+    });
+
+    it("fails when arrays differ in length", () => {
+      assert.throws(() => applyPatch({ a: [1] }, [{ op: "test", path: "/a", value: [1, 2] }]), JsonPatchError);
+    });
+
+    it("fails when the target does not exist", () => {
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/b", value: 1 }]), JsonPatchError);
+    });
+  });
+
+  describe("whole patch", () => {
+    it("applies the operations in order", () => {
+      const patch = [
+        { op: "add", path: "/list", value: [] },
+        { op: "add", path: "/list/-", value: "first" },
+        { op: "replace", path: "/list/0", value: "second" },
+      ];
+      assert.deepEqual(applyPatch({}, patch), { list: ["second"] });
+    });
+
+    it("applies an empty patch to a copy of the document", () => {
+      const doc = { a: [1] };
+      const result = applyPatch(doc, []);
+      assert.deepEqual(result, doc);
+      assert.notEqual(result, doc);
+    });
+
+    it("throws when any operation fails, and does not mutate the input", () => {
+      const doc = { a: [1] };
+      const snapshot = structuredClone(doc);
+      assert.throws(
+        () =>
+          applyPatch(doc, [
+            { op: "add", path: "/a/-", value: 2 },
+            { op: "remove", path: "/missing" },
+          ]),
+        JsonPatchError,
+      );
+      assert.deepEqual(doc, snapshot);
+    });
+
+    it("does not mutate the input or the patch when it succeeds", () => {
+      const doc = { a: { b: [1] } };
+      const patch = [{ op: "add", path: "/a/b/-", value: { c: 2 } }];
+      const docSnapshot = structuredClone(doc);
+      const patchSnapshot = structuredClone(patch);
+      const result = applyPatch(doc, patch) as { a: { b: unknown[] } };
+      assert.deepEqual(doc, docSnapshot);
+      assert.deepEqual(patch, patchSnapshot);
+      assert.notEqual(result.a, doc.a);
+    });
+
+    it("does not share the patch values with the result", () => {
+      const value = { items: [1] };
+      const result = applyPatch({}, [{ op: "add", path: "/v", value }]) as { v: { items: number[] } };
+      result.v.items.push(2);
+      assert.deepEqual(value, { items: [1] });
+    });
+
+    it("wraps a pointer error from an operation in a JsonPatchError", () => {
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "a" }]), JsonPatchError);
+    });
+  });
+
+  describe("invalid patches", () => {
+    it("rejects a patch that is not an array", () => {
+      for (const patch of [{}, "add", null, undefined, 1]) {
+        assert.throws(() => applyPatch({}, patch as unknown as []), JsonPatchError);
+      }
+    });
+
+    it("rejects an operation that is not an object", () => {
+      assert.throws(() => applyPatch({}, [null] as unknown as []), JsonPatchError);
+      assert.throws(() => applyPatch({}, [["add"]] as unknown as []), JsonPatchError);
+    });
+
+    it("rejects an unknown operation", () => {
+      assert.throws(() => applyPatch({}, [{ op: "increment", path: "/a", value: 1 }] as unknown as []), JsonPatchError);
+    });
+
+    it("rejects an operation without a string op", () => {
+      assert.throws(() => applyPatch({}, [{ path: "/a", value: 1 }] as unknown as []), JsonPatchError);
+    });
+
+    it("rejects an operation without a string path", () => {
+      assert.throws(() => applyPatch({}, [{ op: "remove" }] as unknown as []), JsonPatchError);
+      assert.throws(() => applyPatch({}, [{ op: "remove", path: 1 }] as unknown as []), JsonPatchError);
+    });
+
+    it("rejects a path that is not a JSON Pointer", () => {
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "#/a" }]), JsonPatchError);
+    });
+
+    it("rejects add, replace and test without a value", () => {
+      for (const op of ["add", "replace", "test"]) {
+        assert.throws(() => applyPatch({ a: 1 }, [{ op, path: "/a" }] as unknown as []), JsonPatchError);
+      }
+    });
+
+    it("rejects an undefined value, which JSON cannot hold", () => {
+      assert.throws(() => applyPatch({}, [{ op: "add", path: "/a", value: undefined }]), JsonPatchError);
+    });
+
+    it("rejects move and copy without a string from", () => {
+      for (const op of ["move", "copy"]) {
+        assert.throws(() => applyPatch({ a: 1 }, [{ op, path: "/b" }] as unknown as []), JsonPatchError);
+        assert.throws(() => applyPatch({ a: 1 }, [{ op, from: 1, path: "/b" }] as unknown as []), JsonPatchError);
+      }
+    });
+  });
