index 78e71690c8381cb81ea5650640308994d7e01f29..b28a8b6d94964e1afb5557281ebcd55de90d8df7 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -247,3 +247,103 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+type PatchOp = { op: "add" | "remove" | "replace"; path: string; value?: unknown };
+
+function encodeToken(token: string): string {
+  // RFC 6901 section 3: '~' becomes '~0' and '/' becomes '~1' (in that order).
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Lengths-table LCS over `a` and `b`, returning the matched index pairs in order. */
+function matchArrays(a: Json[], b: Json[]): Array<[number, number]> {
+  let start = 0;
+  while (start < a.length && start < b.length && jsonEqual(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && jsonEqual(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const n = endA - start;
+  const m = endB - start;
+  const table: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      table[i][j] = jsonEqual(a[start + i], b[start + j])
+        ? table[i + 1][j + 1] + 1
+        : Math.max(table[i + 1][j], table[i][j + 1]);
+    }
+  }
+  const pairs: Array<[number, number]> = [];
+  for (let i = 0; i < start; i++) pairs.push([i, i]);
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (jsonEqual(a[start + i], b[start + j])) {
+      pairs.push([start + i, start + j]);
+      i++;
+      j++;
+    } else if (table[i + 1][j] >= table[i][j + 1]) i++;
+    else j++;
+  }
+  for (let k = 0; endA + k < a.length; k++) pairs.push([endA + k, endB + k]);
+  return pairs;
+}
+
+function diffInto(from: Json, to: Json, path: string, ops: PatchOp[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    const pairs = matchArrays(from, to);
+    pairs.push([from.length, to.length]);
+    let ai = 0;
+    let bi = 0;
+    let out = 0; // index in the array being built, as seen by the operations emitted so far
+    for (const [aj, bj] of pairs) {
+      const removed = aj - ai;
+      const added = bj - bi;
+      const paired = Math.min(removed, added);
+      for (let p = 0; p < paired; p++) {
+        const sub: PatchOp[] = [];
+        diffInto(from[ai + p], to[bi + p], `${path}/${out + p}`, sub);
+        ops.push(...sub);
+      }
+      for (let p = paired; p < removed; p++) ops.push({ op: "remove", path: `${path}/${out + paired}` });
+      for (let p = paired; p < added; p++) {
+        ops.push({ op: "add", path: `${path}/${out + p}`, value: clone(to[bi + p]) });
+      }
+      out += added + 1; // the gap, then the matched item that follows it
+      ai = aj + 1;
+      bi = bj + 1;
+    }
+    return;
+  }
+  if (isObject(from) && isObject(to)) {
+    const fromKeys = Object.keys(from);
+    for (const key of fromKeys) {
+      if (!hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+    }
+    for (const key of fromKeys) {
+      if (hasOwn(to, key)) diffInto(from[key], to[key], `${path}/${encodeToken(key)}`, ops);
+    }
+    for (const key of Object.keys(to)) {
+      if (!hasOwn(from, key)) {
+        ops.push({ op: "add", path: `${path}/${encodeToken(key)}`, value: clone(to[key]) });
+      }
+    }
+    return;
+  }
+  if (!jsonEqual(from, to)) ops.push({ op: "replace", path, value: clone(to) });
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ * The patch is minimal in spirit: unchanged members and array items are left alone, array items
+ * that are inserted or deleted produce a single `add` or `remove`, and nested changes are
+ * addressed by their own path. A moved array item is expressed as a `remove` plus an `add`.
+ * Neither argument is mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  const ops: PatchOp[] = [];
+  diffInto(from, to, "", ops);
+  return ops;
+}
