index 0000000000000000000000000000000000000000..d773080bc6b1ad5b5e10e83a24a5194bb433b79c
--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,74 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function check(from: unknown, to: unknown) {
+  const a = JSON.stringify(from);
+  const b = JSON.stringify(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.equal(JSON.stringify(from), a);
+  assert.equal(JSON.stringify(to), b);
+  return patch;
+}
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(check({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+test("one small change is a single operation (RFC 6902 4.3 replace)", () => {
+  assert.deepEqual(check({ a: { b: 1, c: [1, 2] }, d: 4 }, { a: { b: 1, c: [1, 3] }, d: 4 }), [
+    { op: "replace", path: "/a/c/1", value: 3 },
+  ]);
+});
+test("object member add and remove", () => {
+  assert.deepEqual(check({ a: 1, b: 2 }, { b: 2, c: 3 }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+test("root replacement and type changes", () => {
+  check(1, 2);
+  check([1], { a: 1 });
+  check({ a: [] }, { a: {} });
+  check(null, { a: null });
+  assert.deepEqual(check({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+});
+test("keys needing RFC 6901 escaping and __proto__", () => {
+  check({ "a/b": 1, "~": 2 }, { "a/b": 3, "~": 2, "m~/": 1 });
+  const to = JSON.parse('{"__proto__": {"x": 1}}');
+  const out = applyPatch({}, createPatch({}, to)) as object;
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+  assert.equal(({} as { x?: number }).x, undefined);
+});
+test("array insertion and deletion touch only that item", () => {
+  assert.deepEqual(check([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(check([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(check([{ a: 1 }, { b: 2 }], [{ b: 2 }]), [{ op: "remove", path: "/0" }]);
+  assert.deepEqual(check([], [1]), [{ op: "add", path: "/0", value: 1 }]);
+  assert.deepEqual(check([1], []), [{ op: "remove", path: "/0" }]);
+});
+test("array item move does not rewrite items in between", () => {
+  const big = Array.from({ length: 10 }, (_, i) => ({ id: i, name: `n${i}` }));
+  const moved = [big[5], ...big.slice(0, 5), ...big.slice(6)];
+  assert.ok(check(big, moved).length <= 2);
+  const back = [...big.slice(1), big[0]];
+  assert.ok(check(big, back).length <= 2);
+});
+test("changes inside array items recurse", () => {
+  assert.deepEqual(check([{ a: 1, b: 2 }, { c: 3 }], [{ a: 1, b: 5 }, { c: 3 }]), [
+    { op: "replace", path: "/0/b", value: 5 },
+  ]);
+});
+test("randomized round trips", () => {
+  let seed = 12345;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) % n);
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 4 : 6);
+    if (k === 0) return rnd(3);
+    if (k === 1) return ["x", "y", null, true][rnd(4)];
+    if (k === 2 || k === 3) return k === 2 ? rnd(2) : "s";
+    if (k === 4) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => [["a", "b", "c/d", "~"][rnd(4)], gen(d + 1)]));
+  };
+  for (let i = 0; i < 500; i++) check(gen(0), gen(0));
+});
