@@ -231,3 +231,19 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+/**
+ * Applies the JSON Merge Patch `patch` (RFC 7396, which obsoletes RFC 7386; section 2 gives the
+ * MergePatch algorithm) to `target` and returns the result. Neither argument is mutated and the
+ * result shares no structure with them.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch as Json);
+  const result: Record<string, unknown> = isObject(target) ? (clone(target) as Record<string, unknown>) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) delete result[key];
+    else setMember(result, key, applyMergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+  }
+  return result;
+}
