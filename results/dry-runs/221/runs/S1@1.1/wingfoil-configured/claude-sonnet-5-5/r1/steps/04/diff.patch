+++ b/test/mergepatch.test.ts
@@ -0,0 +1,45 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+// RFC 7396 appendix A
+const cases: [unknown, unknown, unknown][] = [
+  [{ a: "b" }, { a: "c" }, { a: "c" }],
+  [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  [{ a: "b" }, { a: null }, {}],
+  [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+  [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+  [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  [["a", "b"], ["c", "d"], ["c", "d"]],
+  [{ a: "b" }, ["c"], ["c"]],
+  [{ a: "foo" }, null, null],
+  [{ a: "foo" }, "bar", "bar"],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: "b", c: null }, { a: "b" }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+cases.forEach(([target, patch, expected], i) =>
+  test(`RFC 7396 A case ${i + 1}`, () => assert.deepEqual(applyMergePatch(target, patch), expected)),
+);
+
+test("does not mutate or share structure", () => {
+  const target = { a: { b: 1 } };
+  const patch = { a: { c: [1] }, d: { e: null } };
+  const out = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 } });
+  assert.deepEqual(patch, { a: { c: [1] }, d: { e: null } });
+  assert.notEqual(out.a.c, patch.a.c);
+});
+test("__proto__ is an ordinary key", () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true}}');
+  const out = applyMergePatch({}, patch) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+});
+test("inherited keys are not patched", () => {
+  assert.deepEqual(applyMergePatch({}, { toString: null }), {});
+  assert.deepEqual(applyMergePatch({}, { constructor: { a: 1 } }), { constructor: { a: 1 } });
+});
