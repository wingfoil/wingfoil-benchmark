index 0000000000000000000000000000000000000000..b48e10a7eca9d6c89c34fbb1525b026199c31352
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,179 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ap = (doc: unknown, patch: unknown) => applyPatch(doc, patch);
+
+// RFC 6902 appendix A
+test("A.1 adding an object member", () => {
+  assert.deepEqual(ap({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+});
+test("A.2 adding an array element", () => {
+  assert.deepEqual(ap({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), {
+    foo: ["bar", "qux", "baz"],
+  });
+});
+test("A.3 removing an object member", () => {
+  assert.deepEqual(ap({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+});
+test("A.4 removing an array element", () => {
+  assert.deepEqual(ap({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+});
+test("A.5 replacing a value", () => {
+  assert.deepEqual(ap({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), {
+    baz: "boo",
+    foo: "bar",
+  });
+});
+test("A.6 moving a value", () => {
+  assert.deepEqual(
+    ap({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [
+      { op: "move", from: "/foo/waldo", path: "/qux/thud" },
+    ]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+});
+test("A.7 moving an array element", () => {
+  assert.deepEqual(ap({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+});
+test("A.8/A.9 testing a value", () => {
+  assert.deepEqual(ap({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }]), {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  });
+  assert.throws(() => ap({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]));
+});
+test("A.10 adding a nested member object", () => {
+  assert.deepEqual(ap({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]), {
+    foo: "bar",
+    child: { grandchild: {} },
+  });
+});
+test("A.11 ignoring unrecognized elements", () => {
+  assert.deepEqual(ap({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }]), {
+    foo: "bar",
+    baz: "qux",
+  });
+});
+test("A.12 adding to a nonexistent target", () => {
+  assert.throws(() => ap({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]));
+});
+test("A.14 ~ escape ordering", () => {
+  assert.deepEqual(ap({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }]), { "/": 9, "~1": 10 });
+});
+test("A.15 comparing strings and numbers", () => {
+  assert.throws(() => ap({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }]));
+});
+test("A.16 adding an array value", () => {
+  assert.deepEqual(ap({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]), {
+    foo: ["bar", ["abc", "def"]],
+  });
+});
+
+test("whole-document add/replace, copy, empty patch", () => {
+  assert.deepEqual(ap({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(ap({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+  assert.deepEqual(ap({ a: { b: 1 } }, [{ op: "copy", from: "/a", path: "/c" }]), { a: { b: 1 }, c: { b: 1 } });
+  assert.deepEqual(ap({ a: 1 }, []), { a: 1 });
+});
+
+test("does not mutate input or alias patch/result", () => {
+  const doc = { a: { b: [1, 2] }, c: 1 };
+  const snapshot = structuredClone(doc);
+  const value = { x: [1] };
+  const patch = [
+    { op: "add", path: "/a/b/0", value: 0 },
+    { op: "copy", from: "/a", path: "/d" },
+    { op: "add", path: "/e", value },
+    { op: "remove", path: "/c" },
+  ];
+  const patchSnapshot = structuredClone(patch);
+  const out = ap(doc, patch) as any;
+  assert.deepEqual(doc, snapshot);
+  assert.deepEqual(patch, patchSnapshot);
+  assert.notEqual(out.e, value);
+  out.d.b.push(9);
+  assert.deepEqual(out.a.b, [0, 1, 2]);
+});
+
+test("failure is atomic and leaves input intact", () => {
+  const doc = { a: 1 };
+  assert.throws(() => ap(doc, [{ op: "add", path: "/b", value: 2 }, { op: "remove", path: "/zz" }]));
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("invalid patches throw", () => {
+  const bad: unknown[] = [
+    {},
+    "x",
+    [1],
+    [{ path: "/a" }],
+    [{ op: "nope", path: "/a" }],
+    [{ op: "add", path: "/a" }],
+    [{ op: "add", path: "/a", value: undefined }],
+    [{ op: "replace", path: "/a" }],
+    [{ op: "test", path: "/a" }],
+    [{ op: "add", value: 1 }],
+    [{ op: "add", path: "a", value: 1 }],
+    [{ op: "add", path: "/~2", value: 1 }],
+    [{ op: "move", path: "/a" }],
+    [{ op: "copy", path: "/a" }],
+    [{ op: "copy", from: 1, path: "/a" }],
+  ];
+  for (const p of bad) assert.throws(() => ap({ a: 1 }, p), undefined, JSON.stringify(p));
+});
+
+test("operation failures throw", () => {
+  const doc = { a: [1, 2], o: { k: 1 } };
+  const fails: unknown[] = [
+    [{ op: "remove", path: "/missing" }],
+    [{ op: "remove", path: "" }],
+    [{ op: "remove", path: "/a/2" }],
+    [{ op: "remove", path: "/a/-" }],
+    [{ op: "replace", path: "/missing", value: 1 }],
+    [{ op: "replace", path: "/a/2", value: 1 }],
+    [{ op: "replace", path: "/a/-", value: 1 }],
+    [{ op: "add", path: "/a/3", value: 1 }],
+    [{ op: "add", path: "/a/01", value: 1 }],
+    [{ op: "add", path: "/a/x", value: 1 }],
+    [{ op: "add", path: "/a/0/z", value: 1 }],
+    [{ op: "move", from: "/missing", path: "/x" }],
+    [{ op: "move", from: "/o", path: "/o/k/z" }],
+    [{ op: "move", from: "/o", path: "/o/new" }],
+    [{ op: "copy", from: "/missing", path: "/x" }],
+    [{ op: "test", path: "/missing", value: 1 }],
+  ];
+  for (const p of fails) assert.throws(() => ap(doc, p), undefined, JSON.stringify(p));
+});
+
+test("test op: deep equality semantics", () => {
+  const doc = { a: { x: 1, y: [1, { z: null }] }, n: null };
+  assert.doesNotThrow(() => ap(doc, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }]));
+  assert.doesNotThrow(() => ap(doc, [{ op: "test", path: "/n", value: null }]));
+  assert.throws(() => ap(doc, [{ op: "test", path: "/a/y", value: [{ z: null }, 1] }]));
+  assert.throws(() => ap(doc, [{ op: "test", path: "/a", value: { x: 1 } }]));
+  assert.throws(() => ap(doc, [{ op: "test", path: "/n", value: 0 }]));
+  assert.throws(() => ap(doc, [{ op: "test", path: "/a/y", value: { 0: 1, 1: { z: null } } }]));
+});
+
+test("move to same location is a no-op; move root-level keys", () => {
+  assert.deepEqual(ap({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.deepEqual(ap({ a: 1 }, [{ op: "move", from: "/a", path: "/b" }]), { b: 1 });
+});
+
+test("no prototype pollution; only own members", () => {
+  const out = ap({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+  const parsed = JSON.parse('{"__proto__": {"x": 1}}');
+  const cloned = ap(parsed, []) as any;
+  assert.equal(Object.getPrototypeOf(cloned), Object.prototype);
+  assert.deepEqual(Object.keys(cloned), ["__proto__"]);
+  assert.throws(() => ap({}, [{ op: "remove", path: "/constructor" }]));
+  assert.throws(() => ap({}, [{ op: "replace", path: "/__proto__", value: 1 }]));
+  assert.throws(() => ap({}, [{ op: "add", path: "/constructor/prototype/x", value: 1 }]));
+  assert.equal(({} as any).x, undefined);
+});
