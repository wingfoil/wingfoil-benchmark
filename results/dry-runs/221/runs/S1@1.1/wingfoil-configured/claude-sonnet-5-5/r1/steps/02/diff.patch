index 72d92e9f0a8b36a0e1c156285994ed1a62eca454..3e20fa59706c22bacce213776fd5aa1af852420d 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -49,3 +49,185 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+/**
+ * JSON Patch, RFC 6902.
+ */
+
+type Json = unknown;
+
+const hasOwn = (o: object, k: string): boolean => Object.prototype.hasOwnProperty.call(o, k);
+
+function isObject(v: unknown): v is Record<string, unknown> {
+  return typeof v === "object" && v !== null && !Array.isArray(v);
+}
+
+/** Sets an own data property, safe for keys such as `__proto__`. */
+function setMember(obj: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone(value: Json): Json {
+  if (Array.isArray(value)) return value.map(clone);
+  if (isObject(value)) {
+    const out: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(out, key, clone(value[key]));
+    return out;
+  }
+  return value;
+}
+
+/** Deep equality as defined by RFC 6902 section 4.6. */
+function jsonEqual(a: Json, b: Json): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((x, i) => jsonEqual(x, b[i]))
+    );
+  }
+  if (isObject(a) || isObject(b)) {
+    if (!isObject(a) || !isObject(b)) return false;
+    const ka = Object.keys(a);
+    return (
+      ka.length === Object.keys(b).length && ka.every((k) => hasOwn(b, k) && jsonEqual(a[k], b[k]))
+    );
+  }
+  return a === b;
+}
+
+/** Splits a pointer into decoded tokens, reusing the RFC 6901 syntax rules. */
+function parseTokens(pointer: unknown, what: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error(`Invalid JSON Patch: "${what}" must be a string`);
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new Error(`Invalid JSON Patch: "${what}" is not a valid JSON Pointer`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((raw) => decodeToken(raw));
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (allowEnd && token === "-") return length;
+  if (!ARRAY_INDEX.test(token)) throw new Error(`JSON Patch: "${token}" is not an array index`);
+  const index = Number(token);
+  if (index > length || (index === length && !allowEnd)) {
+    throw new Error(`JSON Patch: index ${token} out of range`);
+  }
+  return index;
+}
+
+/** Returns the container holding the target of `tokens` (which must be non-empty). */
+function parentOf(root: Json, tokens: string[]): Json {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      current = current[arrayIndex(token, current.length, false)];
+    } else if (isObject(current) && hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`JSON Patch: path does not resolve at "${token}"`);
+    }
+  }
+  return current;
+}
+
+function getAt(root: Json, tokens: string[]): Json {
+  if (tokens.length === 0) return root;
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) return parent[arrayIndex(last, parent.length, false)];
+  if (isObject(parent) && hasOwn(parent, last)) return parent[last];
+  throw new Error(`JSON Patch: path does not resolve at "${last}"`);
+}
+
+/** Removes the target (which must exist) and returns the new root and the removed value. */
+function removeAt(root: Json, tokens: string[]): { root: Json; removed: Json } {
+  if (tokens.length === 0) throw new Error("JSON Patch: cannot remove the document root");
+  const removed = getAt(root, tokens);
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete (parent as Record<string, unknown>)[last];
+  return { root, removed };
+}
+
+/** Adds `value` at the target per section 4.1 and returns the new root. */
+function addAt(root: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(arrayIndex(last, parent.length, true), 0, value);
+  else if (isObject(parent)) setMember(parent, last, value);
+  else throw new Error(`JSON Patch: cannot add into a primitive at "${last}"`);
+  return root;
+}
+
+function replaceAt(root: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) return value;
+  getAt(root, tokens); // target must exist
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(last)] = value;
+  else setMember(parent as Record<string, unknown>, last, value);
+  return root;
+}
+
+const OPS = ["add", "remove", "replace", "move", "copy", "test"];
+
+function requireValue(op: Record<string, unknown>): Json {
+  if (!hasOwn(op, "value") || op.value === undefined) {
+    throw new Error(`Invalid JSON Patch: "${String(op.op)}" requires "value"`);
+  }
+  return op.value;
+}
+
+/**
+ * Applies the JSON Patch `patch` (RFC 6902) to `document` and returns the result.
+ * Neither argument is mutated. Throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new Error("Invalid JSON Patch: not an array");
+  let result = clone(document);
+  for (const op of patch) {
+    if (!isObject(op)) throw new Error("Invalid JSON Patch: operation is not an object");
+    if (typeof op.op !== "string" || !OPS.includes(op.op)) {
+      throw new Error(`Invalid JSON Patch: unknown operation ${JSON.stringify(op.op)}`);
+    }
+    const path = parseTokens(op.path, "path");
+    switch (op.op) {
+      case "add":
+        result = addAt(result, path, clone(requireValue(op)));
+        break;
+      case "replace":
+        result = replaceAt(result, path, clone(requireValue(op)));
+        break;
+      case "test":
+        if (!jsonEqual(getAt(result, path), requireValue(op))) {
+          throw new Error(`JSON Patch: test failed at "${op.path as string}"`);
+        }
+        break;
+      case "remove":
+        result = removeAt(result, path).root;
+        break;
+      case "copy": {
+        const from = parseTokens(op.from, "from");
+        result = addAt(result, path, clone(getAt(result, from)));
+        break;
+      }
+      case "move": {
+        const from = parseTokens(op.from, "from");
+        getAt(result, from); // must exist
+        if (from.length === path.length && from.every((t, i) => t === path[i])) break;
+        const isPrefix = from.length < path.length && from.every((t, i) => t === path[i]);
+        if (isPrefix) throw new Error('JSON Patch: "from" must not be a prefix of "path"');
+        const removed = removeAt(result, from);
+        result = addAt(removed.root, path, removed.removed);
+        break;
+      }
+    }
+  }
+  return result;
+}
