+describe('monthly export', () => {
+  function shopWithOrdersInTwoMonths() {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Tomas "Tom" Reyes, Jr', email: 'tom@example.org', phone: '555-0102' }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'APL-1KG', quantity: 2 }] }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c2', date: '2026-10-15', lines: [{ sku: 'HAM-W', quantity: 1 }] }));
+    valueOf(shop.orders.applyCode(3, 'SPRING10'));
+    return shop;
+  }
+
+  it('exports the orders placed in a month, by number, under a header line', () => {
+    const shop = shopWithOrdersInTwoMonths();
+    assert.equal(
+      valueOf(shop.orders.exportMonth('2026-10')),
+      [
+        'order,date,customer,total',
+        '1,2026-10-02,Mira Holt,11.88',
+        '3,2026-10-15,"Tomas ""Tom"" Reyes, Jr",57.60',
+        '',
+      ].join('\n'),
+    );
+  });
+
+  it('gives the header line alone for a month with no orders', () => {
+    const shop = shopWithOrdersInTwoMonths();
+    assert.equal(valueOf(shop.orders.exportMonth('2026-11')), 'order,date,customer,total\n');
+  });
+
+  it('refuses a month that is not YYYY-MM', () => {
+    const shop = shopWithOrdersInTwoMonths();
+    for (const month of ['2026-13', '2026-00', '2026-1', '2026-10-02', 'October']) {
+      assert.equal(refusalOf(shop.orders.exportMonth(month)).code, 'invalid', month);
+    }
+  });
+});
