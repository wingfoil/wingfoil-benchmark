+function refusalOf(result: { ok: true; value: unknown } | { ok: false; error: { code: string; message: string } }) {
+  if (result.ok) assert.fail('expected the code to be refused');
+  return result.error;
+}
+
+function orderOfPriced(priceCents: number) {
+  const shop = stocked();
+  valueOf(shop.catalogue.add({ sku: 'TEST', name: 'Test item', priceCents }));
+  valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-04', lines: [{ sku: 'TEST', quantity: 1 }] }));
+  return shop;
+}
+
+describe('discount codes', () => {
+  it('takes 10 % off the items with SPRING10, and charges shipping on the items as before', () => {
+    const shop = stocked();
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-04', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 1290, discountCents: 129, shippingCents: 490, totalCents: 1651 });
+  });
+
+  it('rounds the SPRING10 discount half a cent up', () => {
+    const shop = orderOfPriced(345);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 35);
+  });
+
+  it('rounds the SPRING10 discount down below half a cent', () => {
+    const shop = orderOfPriced(344);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 34);
+  });
+
+  it('does not cost the customer free shipping: the size of the order is decided before the discount', () => {
+    const shop = orderOfPriced(5010);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 5010, discountCents: 501, shippingCents: 0, totalCents: 4509 });
+  });
+
+  it('takes 5.00 € off an order of 30.00 € or more with WELCOME5', () => {
+    const shop = orderOfPriced(3000);
+    valueOf(shop.orders.applyCode(1, 'WELCOME5'));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 3000, discountCents: 500, shippingCents: 490, totalCents: 2990 });
+  });
+
+  it('refuses WELCOME5 on an order under 30.00 €, saying why, and leaves the order as it was', () => {
+    const shop = orderOfPriced(2999);
+    const error = refusalOf(shop.orders.applyCode(1, 'WELCOME5'));
+    assert.equal(error.code, 'invalid');
+    assert.match(error.message, /WELCOME5/);
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 0);
+  });
+
+  it('refuses an unknown code, saying why, and leaves the order as it was', () => {
+    const shop = orderOfPriced(1290);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    const error = refusalOf(shop.orders.applyCode(1, 'SUMMER50'));
+    assert.equal(error.code, 'invalid');
+    assert.match(error.message, /SUMMER50/);
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 129);
+  });
+
+  it('keeps the code of a refused second code', () => {
+    const shop = orderOfPriced(1290);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    refusalOf(shop.orders.applyCode(1, 'WELCOME5'));
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 129);
+  });
+
+  it('replaces the first code with a second one that applies', () => {
+    const shop = orderOfPriced(6400);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    valueOf(shop.orders.applyCode(1, 'WELCOME5'));
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 500);
+  });
+
+  it('has no discount without a code', () => {
+    const shop = orderOfPriced(1290);
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 0);
+  });
+
+  it('refuses a code for an order that does not exist', () => {
+    const shop = stocked();
+    const error = refusalOf(shop.orders.applyCode(9, 'SPRING10'));
+    assert.equal(error.code, 'not-found');
+  });
+});
