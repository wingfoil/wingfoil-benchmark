+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** WELCOME5 takes this much off an order. */
+const WELCOME5_CENTS: Cents = 500;
+
+/** WELCOME5 applies only to orders whose items come to this amount or more. */
+const WELCOME5_MIN_ITEMS_CENTS: Cents = 3000;
+
+/**
+ * The discount a code takes off an order's items, or why the code does not apply to them. SPRING10 takes 10 %,
+ * rounded to the nearest cent with a half cent rounding up. Shipping is never discounted, so the caller decides
+ * shipping on the items before this discount.
+ *
+ * @param code - the discount code the customer gave
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  if (code === 'SPRING10') return ok(Math.floor((itemsCents + 5) / 10));
+  if (code === 'WELCOME5') {
+    return itemsCents >= WELCOME5_MIN_ITEMS_CENTS
+      ? ok(WELCOME5_CENTS)
+      : err('invalid', `WELCOME5 is for orders of ${formatEuros(WELCOME5_MIN_ITEMS_CENTS)} € or more; these items come to ${formatEuros(itemsCents)} €`);
+  }
+  return err('invalid', `${code} is not a discount code`);
+}
