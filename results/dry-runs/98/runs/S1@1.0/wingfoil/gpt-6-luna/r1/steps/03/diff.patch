diff --git a/test/apply-patch.test.js b/test/apply-patch.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..f14fd0419a6da476c01a887136dff008e326a65b
--- /dev/null
+++ b/test/apply-patch.test.js
@@ -0,0 +1,53 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch } from '../src/index.ts';
+
+test('applies operations in order without mutating the source', () => {
+  const document = { list: ['a', 'b', 'c'], copied: null };
+  const result = applyPatch(document, [
+    { op: 'move', from: '/list/0', path: '/list/2' },
+    { op: 'copy', from: '/list/0', path: '/copied' },
+    { op: 'test', path: '/list', value: ['b', 'c', 'a'] },
+  ]);
+
+  assert.deepEqual(result, { list: ['b', 'c', 'a'], copied: 'b' });
+  assert.deepEqual(document, { list: ['a', 'b', 'c'], copied: null });
+});
+
+test('ignores operation members not defined by RFC 6902', () => {
+  assert.deepEqual(applyPatch({}, [{ op: 'add', path: '/value', value: 1, ignored: true }]), { value: 1 });
+});
+
+test('compares JSON arrays by every ordered element', () => {
+  assert.throws(() => applyPatch([1], [{ op: 'test', path: '', value: [2] }]), /test failed/);
+});
+
+test('requires operation members to be present on the operation itself', () => {
+  const inheritedPath = Object.assign(Object.create({ path: '' }), { op: 'test', value: 1 });
+  const inheritedFrom = Object.assign(Object.create({ from: '' }), { op: 'copy', path: '/x' });
+
+  assert.throws(() => applyPatch(1, [inheritedPath]), TypeError);
+  assert.throws(() => applyPatch(1, [inheritedFrom]), TypeError);
+});
+
+test('rejects non-JSON input and operation values', () => {
+  assert.throws(() => applyPatch(Number.NaN, []), TypeError);
+  assert.throws(() => applyPatch([,], []), TypeError);
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: '/x', value: undefined }]), TypeError);
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: '/x', value: new Date() }]), TypeError);
+});
+
+test('enforces array index and move destination rules', () => {
+  assert.deepEqual(applyPatch(['a'], [{ op: 'add', path: '/-', value: 'b' }]), ['a', 'b']);
+  assert.throws(() => applyPatch(['a'], [{ op: 'add', path: '/01', value: 'b' }]), /array index/);
+  assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: 'move', from: '/a', path: '/a/b/c' }]), /child/);
+});
+
+test('a failed operation leaves the original document untouched', () => {
+  const document = { value: 1 };
+  assert.throws(() => applyPatch(document, [
+    { op: 'replace', path: '/value', value: 2 },
+    { op: 'remove', path: '/missing' },
+  ]));
+  assert.deepEqual(document, { value: 1 });
+});
