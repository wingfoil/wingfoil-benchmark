+++ b/src/index.ts
@@ -0,0 +1,62 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * The empty pointer refers to the whole document. Pointer tokens decode `~1`
+ * to `/` and `~0` to `~`; malformed escapes and paths that do not exist throw.
+ *
+ * @param document The JSON value to traverse.
+ * @param pointer An RFC 6901 JSON Pointer string.
+ * @returns The value identified by the pointer.
+ * @throws {TypeError} If the pointer is not a valid JSON Pointer string.
+ * @throws {Error} If the pointer does not identify a value in the document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== 'string') {
+    throw new TypeError('JSON Pointer must be a string');
+  }
+
+  if (pointer === '') {
+    return document;
+  }
+
+  if (!pointer.startsWith('/')) {
+    throw new TypeError('JSON Pointer must be empty or begin with "/"');
+  }
+
+  const tokens = pointer.slice(1).split('/').map(decodeToken);
+  let value: unknown = document;
+
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`JSON Pointer array index does not exist: ${token}`);
+      }
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= value.length) {
+        throw new Error(`JSON Pointer array index does not exist: ${token}`);
+      }
+      value = value[index];
+      continue;
+    }
+
+    if (value !== null && typeof value === 'object') {
+      if (!Object.prototype.hasOwnProperty.call(value, token)) {
+        throw new Error(`JSON Pointer object member does not exist: ${token}`);
+      }
+      value = (value as Record<string, unknown>)[token];
+      continue;
+    }
+
+    throw new Error(`JSON Pointer cannot traverse value at token: ${token}`);
+  }
+
+  return value;
+}
+
+function decodeToken(token: string): string {
+  // RFC 6901 permits only the two escapes ~0 and ~1.
+  if (/~(?![01])/.test(token)) {
+    throw new TypeError(`Invalid escape in JSON Pointer token: ${token}`);
+  }
+  return token.replace(/~1/g, '/').replace(/~0/g, '~');
+}
