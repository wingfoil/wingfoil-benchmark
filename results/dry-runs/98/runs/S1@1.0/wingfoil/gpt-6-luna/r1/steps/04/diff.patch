+
+test('applies RFC 7386 object member merges and deletions without mutation', () => {
+  const target = { title: 'old', author: { givenName: 'Ada', familyName: 'Lovelace' }, tags: ['a'] };
+  const patch = { title: 'new', author: { familyName: null, role: 'writer' }, tags: ['b'] };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: 'new', author: { givenName: 'Ada', role: 'writer' }, tags: ['b'],
+  });
+  assert.deepEqual(target, { title: 'old', author: { givenName: 'Ada', familyName: 'Lovelace' }, tags: ['a'] });
+});
+
+test('replaces the entire target when the patch is not an object', () => {
+  assert.equal(applyMergePatch({ a: 1 }, null), null);
+  assert.deepEqual(applyMergePatch({ a: 1 }, ['x', 2]), ['x', 2]);
+  assert.deepEqual(applyMergePatch(1, { a: 1 }), { a: 1 });
+});
+
+test('safely merges special object member names', () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true},"constructor":null}');
+  const result = applyMergePatch({ constructor: 1 }, patch);
+
+  assert.equal(Object.prototype.hasOwnProperty.call(result, '__proto__'), true);
+  assert.deepEqual(result['__proto__'], { polluted: true });
+  assert.equal('polluted' in Object.prototype, false);
+});
