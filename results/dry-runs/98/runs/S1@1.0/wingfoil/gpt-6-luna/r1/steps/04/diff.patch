@@ -143,6 +143,42 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   return result;
 }
 
+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document without changing either input.
+ * Object patches recursively merge members, null-valued members remove target members,
+ * and any non-object patch replaces the entire target.
+ *
+ * @param target The JSON value to update.
+ * @param patch An RFC 7386 merge patch JSON value.
+ * @returns The merged JSON value.
+ * @throws {TypeError} If either input is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJsonValue(target, 'JSON Merge Patch target');
+  assertJsonValue(patch, 'JSON Merge Patch patch');
+  return mergePatchValue(target, patch);
+}
+
+function mergePatchValue(target: unknown, patch: unknown): unknown {
+  if (!isRecord(patch)) return cloneJson(patch);
+
+  const result: Record<string, unknown> = isRecord(target) ? cloneJson(target) as Record<string, unknown> : {};
+  for (const key of Object.keys(patch)) {
+    const patchValue = patch[key];
+    if (patchValue === null) {
+      delete result[key];
+    } else {
+      Object.defineProperty(result, key, {
+        value: mergePatchValue(result[key], patchValue),
+        enumerable: true,
+        configurable: true,
+        writable: true,
+      });
+    }
+  }
+  return result;
+}
+
 function parsePointer(pointer: string): string[] {
   if (pointer === '') return [];
   if (!pointer.startsWith('/')) throw new TypeError('JSON Pointer must be empty or begin with "/"');
