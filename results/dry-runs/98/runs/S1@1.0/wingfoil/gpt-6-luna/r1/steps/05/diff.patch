+test('creates a minimal patch for nested changes and preserves both inputs', () => {
+  const from = { keep: [1, 2], object: { old: true, value: 1 }, 'a/b~c': 0 };
+  const to = { keep: [1, 2], object: { value: 2, added: null }, 'a/b~c': 0 };
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'remove', path: '/object/old' },
+    { op: 'replace', path: '/object/value', value: 2 },
+    { op: 'add', path: '/object/added', value: null },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, { keep: [1, 2], object: { old: true, value: 1 }, 'a/b~c': 0 });
+  assert.deepEqual(to, { keep: [1, 2], object: { value: 2, added: null }, 'a/b~c': 0 });
+});
+
+test('creates patches for array length changes, escaped keys, and root replacement', () => {
