index 466e0c03f0e855dc42c74d77e9b642d6518cce76..6fe3d37dd9a2140f3cebf21605268082d46569c8 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -68,6 +68,69 @@ type PatchOperation = {
   value?: unknown;
 };
 
+type GeneratedPatchOperation = { op: 'add' | 'remove' | 'replace'; path: string; value?: unknown };
+
+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ * The inputs must contain only JSON values; the returned operations contain
+ * only changed paths and do not share mutable values with either input.
+ *
+ * @param from The original JSON document.
+ * @param to The desired JSON document.
+ * @returns A JSON Patch that transforms `from` into `to`.
+ * @throws {TypeError} If either input is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): GeneratedPatchOperation[] {
+  assertJsonValue(from, 'JSON Patch source');
+  assertJsonValue(to, 'JSON Patch target');
+  const patch: GeneratedPatchOperation[] = [];
+  diffJson(from, to, [], patch);
+  return patch;
+}
+
+function diffJson(from: unknown, to: unknown, path: string[], patch: GeneratedPatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  const pointer = path.map(encodeToken).join('/');
+  const jsonPath = pointer === '' ? '' : `/${pointer}`;
+
+  if (isRecord(from) && isRecord(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.prototype.hasOwnProperty.call(to, key)) {
+        patch.push({ op: 'remove', path: `${jsonPath}/${encodeToken(key)}` });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      const childPath = [...path, key];
+      if (!Object.prototype.hasOwnProperty.call(from, key)) {
+        patch.push({ op: 'add', path: `/${childPath.map(encodeToken).join('/')}`, value: cloneJson(to[key]) });
+      } else {
+        diffJson(from[key], to[key], childPath, patch);
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    const sharedLength = Math.min(from.length, to.length);
+    for (let index = 0; index < sharedLength; index += 1) {
+      diffJson(from[index], to[index], [...path, String(index)], patch);
+    }
+    for (let index = from.length - 1; index >= to.length; index -= 1) {
+      patch.push({ op: 'remove', path: `/${[...path, String(index)].map(encodeToken).join('/')}` });
+    }
+    for (let index = sharedLength; index < to.length; index += 1) {
+      patch.push({ op: 'add', path: `/${[...path, String(index)].map(encodeToken).join('/')}`, value: cloneJson(to[index]) });
+    }
+    return;
+  }
+
+  patch.push({ op: 'replace', path: jsonPath, value: cloneJson(to) });
+}
+
+function encodeToken(token: string): string {
+  return token.replace(/~/g, '~0').replace(/\//g, '~1');
+}
