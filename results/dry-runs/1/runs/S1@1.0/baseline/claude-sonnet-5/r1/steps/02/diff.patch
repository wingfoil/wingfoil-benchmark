@@ -56,3 +63,234 @@ function step(value: JsonValue, token: string): JsonValue {
 function isJsonObject(value: JsonValue): value is { [key: string]: JsonValue } {
   return typeof value === "object" && value !== null && !Array.isArray(value);
 }
+
+export type AddOperation = { op: "add"; path: string; value: JsonValue };
+export type RemoveOperation = { op: "remove"; path: string };
+export type ReplaceOperation = { op: "replace"; path: string; value: JsonValue };
+export type MoveOperation = { op: "move"; from: string; path: string };
+export type CopyOperation = { op: "copy"; from: string; path: string };
+export type TestOperation = { op: "test"; path: string; value: JsonValue };
+
+export type JsonPatchOperation =
+  | AddOperation
+  | RemoveOperation
+  | ReplaceOperation
+  | MoveOperation
+  | CopyOperation
+  | TestOperation;
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document, returning the resulting
+ * document as a new value. Neither `document` nor `patch` is mutated.
+ */
+export function applyPatch(document: JsonValue, patch: JsonValue): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("A JSON Patch must be an array of operations");
+  }
+
+  let root = structuredClone(document);
+
+  for (const entry of patch) {
+    root = applyOperation(root, validateOperation(entry));
+  }
+
+  return root;
+}
+
+function validateOperation(entry: JsonValue): JsonPatchOperation {
+  if (!isJsonObject(entry)) {
+    throw new Error(`Invalid JSON Patch operation: expected an object, got ${JSON.stringify(entry)}`);
+  }
+
+  const op = entry["op"];
+  const path = requireString(entry, "path");
+
+  switch (op) {
+    case "add":
+      return { op, path, value: requireValue(entry) };
+    case "remove":
+      return { op, path };
+    case "replace":
+      return { op, path, value: requireValue(entry) };
+    case "move":
+      return { op, path, from: requireString(entry, "from") };
+    case "copy":
+      return { op, path, from: requireString(entry, "from") };
+    case "test":
+      return { op, path, value: requireValue(entry) };
+    default:
+      throw new Error(`Invalid JSON Patch operation: unknown "op" value ${JSON.stringify(op)}`);
+  }
+}
+
+function requireString(entry: { [key: string]: JsonValue }, field: string): string {
+  const value = entry[field];
+  if (typeof value !== "string") {
+    throw new Error(`Invalid JSON Patch operation: missing or invalid "${field}" member`);
+  }
+  return value;
+}
+
+function requireValue(entry: { [key: string]: JsonValue }): JsonValue {
+  if (!Object.prototype.hasOwnProperty.call(entry, "value")) {
+    throw new Error('Invalid JSON Patch operation: missing "value" member');
+  }
+  return entry["value"];
+}
+
+function applyOperation(root: JsonValue, operation: JsonPatchOperation): JsonValue {
+  switch (operation.op) {
+    case "add":
+      return applyAdd(root, operation.path, operation.value);
+    case "remove":
+      return applyRemove(root, operation.path);
+    case "replace":
+      return applyReplace(root, operation.path, operation.value);
+    case "move":
+      return applyMove(root, operation.from, operation.path);
+    case "copy":
+      return applyCopy(root, operation.from, operation.path);
+    case "test":
+      return applyTest(root, operation.path, operation.value);
+  }
+}
+
+function parseArrayIndex(token: string, length: number, allowAppend: boolean): number {
+  if (allowAppend && token === "-") {
+    return length;
+  }
+  if (!/^(?:0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`Invalid array index in JSON Pointer: ${JSON.stringify(token)}`);
+  }
+  const index = Number(token);
+  const max = allowAppend ? length : length - 1;
+  if (index > max) {
+    throw new Error(`JSON Pointer references a nonexistent array element: ${index}`);
+  }
+  return index;
+}
+
+function applyAdd(root: JsonValue, path: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(path);
+  const clonedValue = structuredClone(value);
+  if (tokens.length === 0) {
+    return clonedValue;
+  }
+
+  const lastToken = tokens[tokens.length - 1];
+  const parent = resolveTokens(root, tokens.slice(0, -1));
+  if (Array.isArray(parent)) {
+    const index = parseArrayIndex(lastToken, parent.length, true);
+    parent.splice(index, 0, clonedValue);
+  } else if (isJsonObject(parent)) {
+    parent[lastToken] = clonedValue;
+  } else {
+    throw new Error("JSON Pointer cannot descend into a non-container value");
+  }
+  return root;
+}
+
+function applyRemove(root: JsonValue, path: string): JsonValue {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    throw new Error('Invalid "remove" operation: the root document cannot be removed');
+  }
+
+  const lastToken = tokens[tokens.length - 1];
+  const parent = resolveTokens(root, tokens.slice(0, -1));
+  if (Array.isArray(parent)) {
+    const index = parseArrayIndex(lastToken, parent.length, false);
+    parent.splice(index, 1);
+  } else if (isJsonObject(parent)) {
+    if (!Object.prototype.hasOwnProperty.call(parent, lastToken)) {
+      throw new Error(`JSON Pointer references a nonexistent member: ${JSON.stringify(lastToken)}`);
+    }
+    delete parent[lastToken];
+  } else {
+    throw new Error("JSON Pointer cannot descend into a non-container value");
+  }
+  return root;
+}
+
+function applyReplace(root: JsonValue, path: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(path);
+  const clonedValue = structuredClone(value);
+  if (tokens.length === 0) {
+    return clonedValue;
+  }
+
+  const lastToken = tokens[tokens.length - 1];
+  const parent = resolveTokens(root, tokens.slice(0, -1));
+  if (Array.isArray(parent)) {
+    const index = parseArrayIndex(lastToken, parent.length, false);
+    parent[index] = clonedValue;
+  } else if (isJsonObject(parent)) {
+    if (!Object.prototype.hasOwnProperty.call(parent, lastToken)) {
+      throw new Error(`JSON Pointer references a nonexistent member: ${JSON.stringify(lastToken)}`);
+    }
+    parent[lastToken] = clonedValue;
+  } else {
+    throw new Error("JSON Pointer cannot descend into a non-container value");
+  }
+  return root;
+}
+
+function applyMove(root: JsonValue, from: string, path: string): JsonValue {
+  if (isProperPrefix(from, path)) {
+    throw new Error(
+      `Invalid "move" operation: "from" (${JSON.stringify(from)}) is a proper prefix of "path" (${JSON.stringify(path)})`,
+    );
+  }
+
+  const fromTokens = parsePointer(from);
+  const pathTokens = parsePointer(path);
+  const value = resolvePointer(root, from);
+
+  if (fromTokens.length === 0 && pathTokens.length === 0) {
+    return structuredClone(value);
+  }
+
+  root = applyRemove(root, from);
+  root = applyAdd(root, path, value);
+  return root;
+}
+
+function applyCopy(root: JsonValue, from: string, path: string): JsonValue {
+  const value = resolvePointer(root, from);
+  return applyAdd(root, path, value);
+}
+
+function applyTest(root: JsonValue, path: string, value: JsonValue): JsonValue {
+  const actual = resolvePointer(root, path);
+  if (!deepEqual(actual, value)) {
+    throw new Error(`Test operation failed for path ${JSON.stringify(path)}`);
+  }
+  return root;
+}
+
+function isProperPrefix(from: string, path: string): boolean {
+  const fromTokens = parsePointer(from);
+  const pathTokens = parsePointer(path);
+  if (fromTokens.length >= pathTokens.length) {
+    return false;
+  }
+  return fromTokens.every((token, index) => token === pathTokens[index]);
+}
+
+function deepEqual(a: JsonValue, b: JsonValue): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((item, index) => deepEqual(item, b[index]));
+  }
+  if (isJsonObject(a) && isJsonObject(b)) {
+    const aKeys = Object.keys(a);
+    const bKeys = Object.keys(b);
+    return (
+      aKeys.length === bKeys.length &&
+      aKeys.every((key) => Object.prototype.hasOwnProperty.call(b, key) && deepEqual(a[key], b[key]))
+    );
+  }
+  return false;
+}
