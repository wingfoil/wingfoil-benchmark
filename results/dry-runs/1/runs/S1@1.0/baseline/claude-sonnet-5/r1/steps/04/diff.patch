+
+// JSON Merge Patch (RFC 7386)
+
+test("merge patch: RFC 7386 section 1 example", () => {
+  const target = {
+    a: "b",
+    c: {
+      d: "e",
+      f: "g",
+    },
+  };
+  const patch = {
+    a: "z",
+    c: {
+      f: null,
+    },
+  };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    a: "z",
+    c: {
+      d: "e",
+    },
+  });
+});
+
+// RFC 7386 appendix A test cases.
+const appendixCases: Array<{ target: unknown; patch: unknown; result: unknown }> = [
+  { target: { a: "b" }, patch: { a: "c" }, result: { a: "c" } },
+  { target: { a: "b" }, patch: { b: "c" }, result: { a: "b", b: "c" } },
+  { target: { a: "b" }, patch: { a: null }, result: {} },
+  { target: { a: "b", b: "c" }, patch: { a: null }, result: { b: "c" } },
+  { target: { a: ["b"] }, patch: { a: "c" }, result: { a: "c" } },
+  { target: { a: "c" }, patch: { a: ["b"] }, result: { a: ["b"] } },
+  { target: { a: { b: "c" } }, patch: { a: { b: "d", c: null } }, result: { a: { b: "d" } } },
+  { target: { a: [{ b: "c" }] }, patch: { a: [1] }, result: { a: [1] } },
+  { target: ["a", "b"], patch: ["c", "d"], result: ["c", "d"] },
+  { target: { a: "b" }, patch: ["c"], result: ["c"] },
+  { target: { a: "foo" }, patch: null, result: null },
+  { target: { a: "foo" }, patch: "bar", result: "bar" },
+  { target: { e: null }, patch: { a: 1 }, result: { e: null, a: 1 } },
+  { target: [1, 2], patch: { a: "b", c: null }, result: { a: "b" } },
+  { target: {}, patch: { a: { bb: {} } }, result: { a: { bb: {} } } },
+];
+
+test("merge patch: RFC 7386 appendix A test cases", () => {
+  for (const { target, patch, result } of appendixCases) {
+    assert.deepEqual(applyMergePatch(target as never, patch as never), result);
+  }
+});
+
+test("merge patch: does not mutate the input target or patch", () => {
+  const target = { a: { b: 1 }, c: 2 };
+  const patch = { a: { b: null, d: 3 }, c: 4 };
+  const result = applyMergePatch(target, patch);
+  assert.deepEqual(target, { a: { b: 1 }, c: 2 });
+  assert.deepEqual(patch, { a: { b: null, d: 3 }, c: 4 });
+  assert.deepEqual(result, { a: { d: 3 }, c: 4 });
+});
+
+test("merge patch: treats '__proto__' as an ordinary member name", () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}}');
+  const result = applyMergePatch({}, patch);
+  assert.equal(Object.prototype.hasOwnProperty.call(result, "__proto__"), true);
+  assert.deepEqual((result as { __proto__: unknown }).__proto__, { polluted: true });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
