+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document, returning the
+ * resulting document as a new value. Neither `target` nor `patch` is
+ * mutated.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return structuredClone(patch);
+  }
+
+  const result: { [key: string]: JsonValue } = isJsonObject(target) ? structuredClone(target) : {};
+
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = Object.prototype.hasOwnProperty.call(result, key) ? result[key] : null;
+      setMember(result, key, applyMergePatch(current, value));
+    }
+  }
+
+  return result;
+}
