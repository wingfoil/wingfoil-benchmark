+++ b/src/importTasks.ts
@@ -0,0 +1,54 @@
+import type { NewTask, Priority } from './domain/task.ts';
+import type { TaskList } from './domain/list.ts';
+
+/** A line of `importTasks`'s input that could not be added, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of `importTasks`: how many tasks were added, and every line that was not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds every task described in `text` to `list`, one per line, as `title;priority;tags`: `priority`
+ * may be empty for a normal task, and `tags` is zero or more tags separated by spaces (for example
+ * `Renew the insurance;high;admin money`). Blank lines are skipped. Every task added shares the same
+ * `now`, the current time unless given.
+ *
+ * @param list - the task list to add to
+ * @param text - the tasks to import, one per line
+ * @param now - the current time, as an ISO-8601 date-time string, for every task added
+ */
+export function importTasks(list: TaskList, text: string, now: string = new Date().toISOString()): ImportResult {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+
+  const lines = text.split(/\r?\n/);
+  for (const [index, line] of lines.entries()) {
+    if (line.trim() === '') continue;
+
+    const fields = line.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'line must have the form "title;priority;tags"' });
+      continue;
+    }
+
+    const [title, priorityField, tagsField] = fields;
+    const trimmedPriority = priorityField.trim();
+    const input: NewTask = {
+      title,
+      priority: trimmedPriority === '' ? undefined : (trimmedPriority as Priority),
+      tags: tagsField.trim() === '' ? [] : tagsField.trim().split(/\s+/),
+    };
+
+    const result = list.add(input, now);
+    if (result.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  }
+
+  return { imported, rejected };
+}
