diff --git a/src/domain/validation.ts b/src/domain/validation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4f13d6fdd6f4da8aaaaa4e59033f013b259a8525
--- /dev/null
+++ b/src/domain/validation.ts
@@ -0,0 +1,46 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { Priority } from './task.ts';
+
+/** The longest a task's title may be, in characters. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * `title`, trimmed, or an error when it is empty, only spaces, or longer than
+ * {@link MAX_TITLE_LENGTH} characters.
+ *
+ * @param title - the title to validate
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'title must not be empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `title must be at most ${MAX_TITLE_LENGTH} characters, not ${trimmed.length}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * `priority`, or an error when it is neither `undefined` nor one of {@link PRIORITIES}.
+ *
+ * @param priority - the priority to validate, if any
+ */
+export function validatePriority(priority: Priority | undefined): Result<Priority | undefined> {
+  if (priority === undefined) return ok(undefined);
+  if (!PRIORITIES.includes(priority)) {
+    return err('invalid-input', `priority must be one of ${PRIORITIES.join(', ')}, not "${priority}"`);
+  }
+  return ok(priority);
+}
+
+/**
+ * `tag`, or an error when it is empty or contains a space.
+ *
+ * @param tag - the tag to validate
+ */
+export function validateTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'tag must not be empty');
+  if (tag.includes(' ')) return err('invalid-input', `tag "${tag}" must not contain a space`);
+  return ok(tag);
+}
