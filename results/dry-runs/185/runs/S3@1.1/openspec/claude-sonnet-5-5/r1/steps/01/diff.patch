+++ b/test/rental.test.ts
@@ -0,0 +1,80 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+const d = (day: number) => `2026-07-${String(day).padStart(2, '0')}T00:00:00.000Z`;
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  return s;
+}
+
+test('addEquipment rejects bad kind, price and duplicate id', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'boat' as never, dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+  assert.equal(s.quote({ itemId: 'b1', start: d(1), end: d(2) }).total, 2500);
+});
+
+test('quote prices whole days in cents', () => {
+  const s = setup();
+  assert.deepEqual(s.quote({ itemId: 'b1', start: d(1), end: d(2) }), {
+    itemId: 'b1', start: d(1), end: d(2), total: 2500,
+  });
+  assert.equal(s.quote({ itemId: 'b1', start: d(1), end: d(4) }).total, 7500);
+  assert.equal(s.quote({ itemId: 'b1', start: '2026-07-01T00:00:00Z', end: d(2) }).start, d(1));
+});
+
+test('quote rejects unknown items and disallowed periods', () => {
+  const s = setup();
+  const bad = (start: string, end: string) =>
+    assert.throws(() => s.quote({ itemId: 'b1', start, end }));
+  assert.throws(() => s.quote({ itemId: 'nope', start: d(1), end: d(2) }));
+  bad('2026-07-01T10:00:00.000Z', d(2));
+  bad(d(1), '2026-07-02T00:00:01.000Z');
+  bad('2026-07-01T00:00:00+02:00', d(2));
+  bad(d(1), '2026-07-02T02:00:00+02:00');
+  bad(d(2), d(1));
+  bad(d(1), d(1));
+  bad('garbage', d(1));
+  bad('2026-02-30T00:00:00.000Z', d(1));
+  bad(d(1), '2026-07-01T24:00:00.000Z');
+});
+
+test('book returns a booking with the quoted total', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.equal(b.total, 5000);
+  assert.equal(b.itemId, 'b1');
+  assert.equal(b.start, d(1));
+  assert.equal(b.end, d(3));
+  assert.equal(typeof b.id, 'string');
+});
+
+test('book rejects overlaps, allows back-to-back and other items', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.throws(() => s.book({ itemId: 'b1', start: d(3), end: d(5) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(1), end: d(2) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(0 + 1), end: d(10) }));
+  s.book({ itemId: 'b1', start: d(4), end: d(6) });
+  s.book({ itemId: 's1', start: d(1), end: d(4) });
+});
+
+test('booking ids are unique and failures record nothing', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(1), end: d(2) });
+  assert.throws(() => s.book({ itemId: 'b1', start: d(1), end: d(2) }));
+  assert.throws(() => s.book({ itemId: 'nope', start: d(1), end: d(2) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: '2026-07-03T01:00:00.000Z', end: d(5) }));
+  const b = s.book({ itemId: 'b1', start: d(3), end: d(5) });
+  assert.notEqual(a.id, b.id);
+});
+
+test('service exposes only addEquipment, quote and book', () => {
+  assert.deepEqual(Object.keys(createRentalService()).sort(), ['addEquipment', 'book', 'quote']);
+});
