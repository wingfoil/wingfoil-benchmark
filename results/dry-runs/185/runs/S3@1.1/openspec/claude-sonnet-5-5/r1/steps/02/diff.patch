@@ -101,15 +121,24 @@ export function createRentalService(): RentalService {
 
     book(request) {
       const { quote, from, to } = price(request);
-      const clash = bookings.some(
-        (b) => b.itemId === quote.itemId && from < b.to && b.from < to,
