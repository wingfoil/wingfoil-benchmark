+});
+
+test('availability lists free equipment, sorted, optionally by kind', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 1 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1 });
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 });
+  assert.deepEqual(s.availability({ start: d(1), end: d(3) }), ['b1', 'b2', 's1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3), kind: 'sail' }), ['s1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3), kind: 'board' }), ['b1', 'b2']);
+});
+
+test('availability excludes items not free for the whole period', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.deepEqual(s.availability({ start: d(3), end: d(5) }), ['s1']);
+  const t = setup();
+  t.book({ itemId: 'b1', start: d(3), end: d(4) });
+  assert.deepEqual(t.availability({ start: d(1), end: d(5) }), ['s1']);
+  assert.deepEqual(t.availability({ start: d(1), end: d(5), kind: 'board' }), []);
+});
+
+test('availability treats back-to-back periods as free and reserves nothing', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.deepEqual(s.availability({ start: d(3), end: d(5) }), ['b1', 's1']);
+  assert.deepEqual(s.availability({ start: d(3), end: d(5) }), ['b1', 's1']);
+});
+
+test('availability rejects disallowed periods and unknown kinds', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: '2026-07-01T10:00:00.000Z', end: d(2) }));
+  assert.throws(() => s.availability({ start: d(2), end: d(2) }));
