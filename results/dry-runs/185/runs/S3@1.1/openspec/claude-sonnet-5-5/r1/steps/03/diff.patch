       start: new Date(from).toISOString(),
       end: new Date(to).toISOString(),
-      total: item.dailyPrice * ((to - from) / DAY_MS),
+      total: days >= LONG_RENTAL_DAYS ? Math.round((full * LONG_RENTAL_PERCENT) / 100) : full,
