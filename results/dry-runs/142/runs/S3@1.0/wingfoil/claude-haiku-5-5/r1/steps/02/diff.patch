 });
+
+describe('availability', () => {
+  it('lists every item free for the whole period, sorted, when no kind is given', () => {
+    const rental = service();
+    rental.addEquipment({ id: 'board-0', kind: 'board', dailyPrice: 2000 });
+    assert.deepEqual(
+      rental.availability({ start: dayOf('2026-07-01'), end: dayOf('2026-07-03') }),
+      ['board-0', 'board-1', 'sail-1'],
+    );
+  });
+
+  it('lists only the items of the given kind', () => {
+    const rental = service();
+    assert.deepEqual(
+      rental.availability({ start: dayOf('2026-07-01'), end: dayOf('2026-07-03'), kind: 'sail' }),
+      ['sail-1'],
+    );
+    assert.deepEqual(
+      rental.availability({ start: dayOf('2026-07-01'), end: dayOf('2026-07-03'), kind: 'board' }),
+      ['board-1'],
+    );
+  });
+
+  it('leaves out an item booked for an overlapping period', () => {
+    const rental = service();
+    rental.book({ itemId: 'board-1', start: dayOf('2026-07-02'), end: dayOf('2026-07-05') });
+    assert.deepEqual(
+      rental.availability({ start: dayOf('2026-07-01'), end: dayOf('2026-07-03') }),
+      ['sail-1'],
+    );
+    assert.deepEqual(
+      rental.availability({ start: dayOf('2026-07-05'), end: dayOf('2026-07-06') }),
+      ['board-1', 'sail-1'],
+    );
+  });
+
+  it('lists an item whose booking ends where the period starts', () => {
+    const rental = service();
+    rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-02') });
+    assert.deepEqual(
+      rental.availability({ start: dayOf('2026-07-02'), end: dayOf('2026-07-03'), kind: 'board' }),
+      ['board-1'],
+    );
+  });
+
+  it('returns an empty array when nothing is free', () => {
+    const rental = service();
+    rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') });
+    assert.deepEqual(
+      rental.availability({ start: dayOf('2026-07-01'), end: dayOf('2026-07-02'), kind: 'board' }),
+      [],
+    );
+    assert.deepEqual(createRentalService().availability({ start: dayOf('2026-07-01'), end: dayOf('2026-07-02') }), []);
+  });
+
+  it('does not reserve anything, so a listed item can still be booked', () => {
+    const rental = service();
+    rental.availability({ start: dayOf('2026-07-01'), end: dayOf('2026-07-03') });
+    assert.doesNotThrow(() =>
+      rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') }),
+    );
+  });
+
+  it('throws for an unknown kind', () => {
+    const rental = service();
+    assert.throws(
+      () => rental.availability({ start: dayOf('2026-07-01'), end: dayOf('2026-07-02'), kind: 'kite' as 'board' }),
+      /kind/,
+    );
+  });
+
+  it('throws for a period the rules do not allow', () => {
+    const rental = service();
+    assert.throws(
+      () => rental.availability({ start: '2026-07-01T09:00:00Z', end: dayOf('2026-07-02') }),
+      /midnight/,
+    );
+    assert.throws(
+      () => rental.availability({ start: dayOf('2026-07-02'), end: dayOf('2026-07-01') }),
+      /after/,
+    );
+  });
+});
