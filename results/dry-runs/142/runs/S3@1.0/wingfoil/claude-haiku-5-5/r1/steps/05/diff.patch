+
+describe('cancel', () => {
+  it('refunds the full total when cancelled more than 24 hours before the start', () => {
+    const rental = service();
+    const booking = rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') });
+    assert.deepEqual(rental.cancel(booking.id, '2026-06-29T12:00:00Z'), {
+      bookingId: booking.id,
+      refund: 5000,
+    });
+  });
+
+  it('refunds the full total when cancelled exactly 24 hours before the start', () => {
+    const rental = service();
+    const booking = rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') });
+    assert.equal(rental.cancel(booking.id, '2026-06-30T00:00:00Z').refund, 5000);
+  });
+
+  it('gives no refund when cancelled less than 24 hours before the start', () => {
+    const rental = service();
