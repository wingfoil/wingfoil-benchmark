+    assert.equal(rental.cancel(booking.id, '2026-06-30T01:00:00Z').refund, 0);
+  });
+
+  it('gives no refund when cancelled after the start', () => {
+    const rental = service();
+    const booking = rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') });
+    assert.equal(rental.cancel(booking.id, '2026-07-01T10:00:00Z').refund, 0);
+  });
+
+  it('refunds the discounted total of a rental of three days or more', () => {
+    const rental = service();
+    const booking = rental.book({ itemId: 'sail-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-04') });
+    assert.equal(rental.cancel(booking.id, '2026-06-01T00:00:00Z').refund, 4860);
+  });
+
+  it('refunds the full hourly total of a rental under a day', () => {
+    const rental = hourlyService();
+    const booking = rental.book({ itemId: 'board-h', start: '2026-07-01T09:00:00Z', end: '2026-07-01T12:00:00Z' });
+    assert.equal(rental.cancel(booking.id, '2026-06-30T09:00:00Z').refund, 3000);
+  });
+
+  it('throws for an unknown booking and changes nothing', () => {
+    const rental = service();
+    const booking = rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') });
+    assert.throws(() => rental.cancel('booking-99', '2026-06-01T00:00:00Z'), /unknown booking/);
+    assert.deepEqual(rental.availability({ start: dayOf('2026-07-01'), end: dayOf('2026-07-03') }), ['sail-1']);
+    assert.equal(rental.cancel(booking.id, '2026-06-01T00:00:00Z').refund, 5000);
+  });
+
+  it('throws for a second cancel of the same booking', () => {
+    const rental = service();
+    const booking = rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') });
+    rental.cancel(booking.id, '2026-06-01T00:00:00Z');
+    assert.throws(() => rental.cancel(booking.id, '2026-06-02T00:00:00Z'), /already cancelled/);
+  });
+
+  it('throws for an at that is not a UTC ISO-8601 timestamp, and leaves the booking cancellable', () => {
+    const rental = service();
+    const booking = rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') });
+    assert.throws(() => rental.cancel(booking.id, '2026-06-01'), /at must be/);
+    assert.equal(rental.cancel(booking.id, '2026-06-01T00:00:00Z').refund, 5000);
+  });
+
+  it('frees the equipment, so the same period can be booked again', () => {
+    const rental = service();
+    const booking = rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') });
+    rental.cancel(booking.id, '2026-06-01T00:00:00Z');
+    assert.equal(
+      rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') }).id,
+      'booking-2',
+    );
+  });
+
+  it('lists the item as available again for the period of a cancelled booking', () => {
+    const rental = service();
+    const booking = rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') });
+    assert.deepEqual(rental.availability({ start: dayOf('2026-07-01'), end: dayOf('2026-07-03') }), ['sail-1']);
+    rental.cancel(booking.id, '2026-06-01T00:00:00Z');
+    assert.deepEqual(rental.availability({ start: dayOf('2026-07-01'), end: dayOf('2026-07-03') }), [
+      'board-1',
+      'sail-1',
+    ]);
+  });
+});
