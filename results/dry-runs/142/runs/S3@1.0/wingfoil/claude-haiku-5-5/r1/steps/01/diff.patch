@@ -0,0 +1,215 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.js';
+
+const DAY = 'T00:00:00Z';
+
+function dayOf(date: string): string {
+  return `${date}${DAY}`;
+}
+
+function service() {
+  const rental = createRentalService();
+  rental.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  rental.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1800 });
+  return rental;
+}
+
+describe('createRentalService', () => {
+  it('returns a service with the rental operations', () => {
+    const rental = createRentalService();
+    assert.equal(typeof rental.addEquipment, 'function');
+    assert.equal(typeof rental.quote, 'function');
+    assert.equal(typeof rental.book, 'function');
+  });
+});
+
+describe('addEquipment', () => {
+  it('rejects an unknown kind', () => {
+    const rental = createRentalService();
+    assert.throws(
+      () => rental.addEquipment({ id: 'x', kind: 'kite' as 'board', dailyPrice: 100 }),
+      /kind/,
+    );
+  });
+
+  it('rejects a non-integer or negative daily price', () => {
+    const rental = createRentalService();
+    assert.throws(() => rental.addEquipment({ id: 'a', kind: 'board', dailyPrice: 25.5 }), /dailyPrice/);
+    assert.throws(() => rental.addEquipment({ id: 'b', kind: 'board', dailyPrice: -1 }), /dailyPrice/);
+  });
+
+  it('rejects a duplicate id', () => {
+    const rental = service();
+    assert.throws(() => rental.addEquipment({ id: 'board-1', kind: 'sail', dailyPrice: 100 }), /already exists/);
+  });
+});
+
+describe('quote', () => {
+  it('prices one day as the daily price', () => {
+    const rental = service();
+    assert.deepEqual(
+      rental.quote({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-02') }),
+      { itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-02'), total: 2500 },
+    );
+  });
+
+  it('prices each whole day of the period', () => {
+    const rental = service();
+    const quote = rental.quote({ itemId: 'sail-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-04') });
+    assert.equal(quote.total, 3 * 1800);
+  });
+
+  it('returns an integer number of cents', () => {
+    const rental = service();
+    const quote = rental.quote({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-08') });
+    assert.ok(Number.isInteger(quote.total));
+  });
+
+  it('throws for an unknown item', () => {
+    const rental = service();
+    assert.throws(
+      () => rental.quote({ itemId: 'nope', start: dayOf('2026-07-01'), end: dayOf('2026-07-02') }),
+      /unknown item/,
+    );
+  });
+
+  it('does not reserve the item, so it quotes a period that is already booked', () => {
+    const rental = service();
+    rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') });
+    assert.equal(
+      rental.quote({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-02') }).total,
+      2500,
+    );
+  });
+
+  it('throws for a start that is not at midnight UTC', () => {
+    const rental = service();
+    assert.throws(
+      () => rental.quote({ itemId: 'board-1', start: '2026-07-01T09:00:00Z', end: dayOf('2026-07-02') }),
+      /midnight/,
+    );
+  });
+
+  it('throws for an end that is not at midnight UTC', () => {
+    const rental = service();
+    assert.throws(
+      () => rental.quote({ itemId: 'board-1', start: dayOf('2026-07-01'), end: '2026-07-02T12:00:00Z' }),
+      /midnight/,
+    );
+  });
+
+  it('throws for an end that is not after the start', () => {
+    const rental = service();
+    assert.throws(
+      () => rental.quote({ itemId: 'board-1', start: dayOf('2026-07-02'), end: dayOf('2026-07-01') }),
+      /after/,
+    );
+    assert.throws(
+      () => rental.quote({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-01') }),
+      /after/,
+    );
+  });
+
+  it('throws for a date that does not exist in the calendar', () => {
+    const rental = service();
+    assert.throws(
+      () => rental.quote({ itemId: 'board-1', start: '2026-02-30T00:00:00Z', end: dayOf('2026-03-02') }),
+      /not a valid date/,
+    );
+  });
+
+  it('throws for a time that is not a UTC ISO-8601 timestamp', () => {
+    const rental = service();
+    assert.throws(
+      () => rental.quote({ itemId: 'board-1', start: '2026-07-01', end: dayOf('2026-07-02') }),
+      /ISO-8601 UTC/,
+    );
+    assert.throws(
+      () => rental.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00+02:00', end: dayOf('2026-07-02') }),
+      /ISO-8601 UTC/,
+    );
+  });
+});
+
+describe('book', () => {
+  it('books the item and returns the booking with its total', () => {
+    const rental = service();
+    assert.deepEqual(
+      rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') }),
+      { id: 'booking-1', itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03'), total: 5000 },
+    );
+  });
+
+  it('gives each booking a different id', () => {
+    const rental = service();
+    const first = rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-02') });
+    const second = rental.book({ itemId: 'board-1', start: dayOf('2026-07-02'), end: dayOf('2026-07-03') });
+    assert.notEqual(first.id, second.id);
+  });
+
+  it('allows back-to-back periods, since a period ends where the next starts', () => {
+    const rental = service();
+    rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-02') });
+    assert.doesNotThrow(() =>
+      rental.book({ itemId: 'board-1', start: dayOf('2026-07-02'), end: dayOf('2026-07-03') }),
+    );
+  });
+
+  it('rejects a period overlapping an existing booking of the same item', () => {
+    const rental = service();
+    rental.book({ itemId: 'board-1', start: dayOf('2026-07-02'), end: dayOf('2026-07-05') });
+    assert.throws(
+      () => rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') }),
+      /overlapping/,
+    );
+    assert.throws(
+      () => rental.book({ itemId: 'board-1', start: dayOf('2026-07-03'), end: dayOf('2026-07-04') }),
+      /overlapping/,
+    );
+  });
+
+  it('rejects a period that contains an existing booking', () => {
+    const rental = service();
+    rental.book({ itemId: 'board-1', start: dayOf('2026-07-02'), end: dayOf('2026-07-03') });
+    assert.throws(
+      () => rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-05') }),
+      /overlapping/,
+    );
+  });
+
+  it('allows another item for the same period', () => {
+    const rental = service();
+    rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') });
+    assert.doesNotThrow(() =>
+      rental.book({ itemId: 'sail-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') }),
+    );
+  });
+
+  it('throws for an unknown item and does not book it', () => {
+    const rental = service();
+    assert.throws(
+      () => rental.book({ itemId: 'nope', start: dayOf('2026-07-01'), end: dayOf('2026-07-02') }),
+      /unknown item/,
+    );
+  });
+
+  it('throws for a period that is not whole days', () => {
+    const rental = service();
+    assert.throws(
+      () => rental.book({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: dayOf('2026-07-02') }),
+      /midnight/,
+    );
+  });
+
+  it('does not book a rejected request, so its period stays free', () => {
+    const rental = service();
+    assert.throws(() =>
+      rental.book({ itemId: 'board-1', start: dayOf('2026-07-02'), end: dayOf('2026-07-01') }),
+    );
+    assert.equal(
+      rental.book({ itemId: 'board-1', start: dayOf('2026-07-01'), end: dayOf('2026-07-03') }).id,
+      'booking-1',
+    );
+  });
+});
