     if (!clash.ok) assert.equal(clash.error.code, 'duplicate');
     assert.equal(valueOf(list.rename(id, 'Sweep')).title, 'Sweep');
   });
+
+  it('dates a task when it is added, with the same time for both dates', () => {
+    const list = createTodoList(steppingClock());
+    const task = valueOf(list.add({ title: 'Sweep' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    const list = createTodoList(steppingClock());
+    const added = valueOf(list.add({ title: 'Sweep' }));
+    const changes = [
+      () => list.complete('Sweep'),
+      () => list.reopen('Sweep'),
+      () => list.rename('Sweep', 'Mop'),
+      () => list.tag('Mop', 'home'),
+      () => list.untag('Mop', 'home'),
+    ];
+    let previous = added.updatedAt;
+    for (const change of changes) {
+      const task = valueOf(change());
+      assert.ok(task.updatedAt > previous);
+      assert.equal(task.createdAt, added.createdAt);
+      assert.equal(valueOf(list.get(added.id)).updatedAt, task.updatedAt);
+      previous = task.updatedAt;
+    }
+  });
+
+  it('leaves updatedAt alone when a change fails', () => {
+    const list = createTodoList(steppingClock());
