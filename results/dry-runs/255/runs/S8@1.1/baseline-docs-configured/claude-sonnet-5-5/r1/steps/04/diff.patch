+import type { TaskList } from './list.ts';
+import type { NewTask } from './task.ts';
+import { validatePriority } from './validate.ts';
+
+/** A line of the text that could not be added, with its number (from 1) and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks it added, and the lines it could not add. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+const MAX_FIELDS = 3;
+
+function parseLine(text: string): NewTask | string {
+  const fields = text.split(';');
+  if (fields.length > MAX_FIELDS) {
+    return `the line has ${fields.length} fields: use title;priority;tags`;
+  }
+  const [title = '', priority = '', tags = ''] = fields.map((field) => field.trim());
+  const words = tags === '' ? [] : tags.split(/\s+/);
+  if (priority === '') return { title, tags: words };
+  const checked = validatePriority(priority);
+  return checked.ok ? { title, priority: checked.value, tags: words } : checked.error.message;
+}
+
+/**
+ * Adds the tasks written in `text`, one per line as `title;priority;tags`, to `list`. The priority may be
+ * empty for a normal one; tags are separated by spaces. Blank lines are skipped, and a line that cannot be
+ * added is reported and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((content, index) => {
+    if (content.trim() === '') return;
+    const parsed = parseLine(content);
+    const added = typeof parsed === 'string' ? undefined : list.add(parsed);
+    if (added?.ok) {
+      imported += 1;
+      return;
+    }
+    const reason = typeof parsed === 'string' ? parsed : added?.error.message ?? '';
+    rejected.push({ line: index + 1, reason });
+  });
+  return { imported, rejected };
+}
