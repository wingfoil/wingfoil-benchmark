diff --git a/src/domain/validate.ts b/src/domain/validate.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fff08203ce45f8031300ff561d229a406bf8395d
--- /dev/null
+++ b/src/domain/validate.ts
@@ -0,0 +1,63 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** The most characters a title can have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * The title, trimmed, when it is fit for a task: not empty and at most `MAX_TITLE_LENGTH` characters.
+ *
+ * @param title - the title as the person typed it
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title is empty: give the task a title');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long: at most ${MAX_TITLE_LENGTH} are allowed`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority when it is one of `PRIORITIES`.
+ *
+ * @param priority - the priority as given
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  if (!PRIORITIES.includes(priority as Priority)) {
+    return err('invalid-input', `the priority "${priority}" is not known: use ${PRIORITIES.join(', ')}`);
+  }
+  return ok(priority as Priority);
+}
+
+/**
+ * The tag when it is fit to tag a task with: not empty and without a space.
+ *
+ * @param tag - the tag as given
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'the tag is empty: give a tag a name');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space: a tag is a single word`);
+  return ok(tag);
+}
+
+/**
+ * The new task's title, priority and tags when all of them are valid; otherwise the first problem found.
+ *
+ * @param input - what the person asked to add
+ */
+export function validateNewTask(input: NewTask): Result<NewTask> {
+  const title = validateTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined) {
+    const priority = validatePriority(input.priority);
+    if (!priority.ok) return priority;
+  }
+  for (const tag of input.tags ?? []) {
+    const checked = validateTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok(input);
+}
diff --git a/test/list.test.ts b/test/list.test.ts
index 0211ae6dfbda9951aa8e153f35f6640ff7c59dc8..ec174f64ae4d32676307c1a03f5586523716940f 100644
--- a/test/list.test.ts
+++ b/test/list.test.ts
@@ -164,4 +164,51 @@ describe('task list', () => {
     const task = valueOf(createTodoList().add({ title: 'Sweep' }));
     assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
   });
+
+  describe('input validation', () => {
+    const invalid = (result: { ok: boolean; error?: { code: string } }) => {
+      assert.equal(result.ok, false);
+      assert.equal(result.error?.code, 'invalid-input');
+    };
+
+    it('accepts a title of 120 characters and a known priority', () => {
+      const list = createTodoList();
+      assert.equal(valueOf(list.add({ title: 'x'.repeat(120), priority: 'high' })).priority, 'high');
+    });
+
+    it('rejects an empty, blank or too long title when adding, and adds nothing', () => {
+      const list = createTodoList();
+      for (const title of ['', '   ', 'x'.repeat(121)]) invalid(list.add({ title }));
+      assert.equal(list.list().length, 0);
+      assert.equal(valueOf(list.add({ title: 'Sweep' })).id, 'task-1');
+    });
+
+    it('rejects a priority that is not low, normal or high', () => {
+      const list = createTodoList();
+      invalid(list.add({ title: 'Sweep', priority: 'urgent' as 'high' }));
+      assert.equal(list.list().length, 0);
+    });
+
+    it('rejects a bad tag when adding', () => {
+      const list = createTodoList();
+      invalid(list.add({ title: 'Sweep', tags: ['home', ''] }));
+      invalid(list.add({ title: 'Sweep', tags: ['two words'] }));
+      assert.equal(list.list().length, 0);
+    });
+
+    it('rejects a bad title when renaming and leaves the task as it was', () => {
+      const list = createTodoList(steppingClock());
+      const before = valueOf(list.add({ title: 'Sweep' }));
+      for (const title of ['', '  ', 'x'.repeat(121)]) invalid(list.rename('Sweep', title));
+      assert.deepEqual(valueOf(list.get(before.id)), before);
+    });
+
+    it('rejects an empty tag or one with a space, and leaves the task as it was', () => {
+      const list = createTodoList(steppingClock());
+      const before = valueOf(list.add({ title: 'Sweep' }));
+      for (const tag of ['', ' ', 'two words']) invalid(list.tag('Sweep', tag));
+      assert.deepEqual(valueOf(list.get(before.id)), before);
+      assert.deepEqual(valueOf(list.tag('Sweep', 'home')).tags, ['home']);
+    });
+  });
 });
