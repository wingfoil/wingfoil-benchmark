index be00414bc6a7834c0bf1c17cdf0d0ad3c6eb9314..1dbff64206d881325824b243203da9ff6e7352b9 100644
--- a/test/index.test.js
+++ b/test/index.test.js
@@ -111,3 +111,40 @@ test('rejects invalid patches and failed operations', () => {
   assert.throws(() => applyPatch(document, [{ op: 'copy', path: '/copy' }]));
   assert.throws(() => applyPatch(document, [{ op: 'test', path: '/list/0', value: 'b' }]));
 });
+
+test('enforces RFC 6902 array-token rules for every operation', () => {
+  const document = { list: ['a'] };
+
+  assert.deepEqual(applyPatch(document, [{ op: 'move', from: '/list/0', path: '/list/-' }]), { list: ['a'] });
+  assert.throws(() => applyPatch(document, [{ op: 'replace', path: '/list/-', value: 'b' }]));
+  assert.throws(() => applyPatch(document, [{ op: 'remove', path: '/list/-' }]));
+  assert.throws(() => applyPatch(document, [{ op: 'copy', from: '/list/-', path: '/copy' }]));
+  assert.throws(() => applyPatch(document, [{ op: 'add', path: '/list/01', value: 'b' }]));
+  assert.throws(() => applyPatch(document, [{ op: 'add', path: '/list/-/child', value: 'b' }]));
+});
+
+test('stops on the first error without mutating the original target', () => {
+  const document = { value: 1, list: ['a'] };
+  const patch = [
+    { op: 'replace', path: '/value', value: 2 },
+    { op: 'remove', path: '/missing' },
+    { op: 'add', path: '/list/-', value: 'b' },
+  ];
+
+  assert.throws(() => applyPatch(document, patch));
+  assert.deepEqual(document, { value: 1, list: ['a'] });
+});
+
+test('treats JSON member names literally, including __proto__', () => {
+  const result = applyPatch({}, [{ op: 'add', path: '/__proto__', value: { safe: true } }]);
+
+  assert.deepEqual(result, JSON.parse('{"__proto__":{"safe":true}}'));
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.getOwnPropertyDescriptor(result, '__proto__')?.value, { safe: true });
+});
+
+test('rejects JavaScript values that are not JSON documents', () => {
+  assert.throws(() => applyPatch(new Date(), []));
+  assert.throws(() => applyPatch({ value: Infinity }, []));
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: '/value', value: new Date() }]));
+});
