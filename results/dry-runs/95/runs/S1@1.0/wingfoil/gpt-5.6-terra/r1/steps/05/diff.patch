+function diffValues(from: JsonValue, to: JsonValue, path: string, patch: PatchOperation[]): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (isJsonObjectValue(from) && isJsonObjectValue(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) {
+        patch.push({ op: 'remove', path: appendPointer(path, key) });
+      }
+    }
+    for (const key of Object.keys(from)) {
+      if (Object.hasOwn(to, key)) {
+        diffValues(from[key], to[key], appendPointer(path, key), patch);
+      }
+    }
+    for (const key of Object.keys(to)) {
+      if (!Object.hasOwn(from, key)) {
+        patch.push({ op: 'add', path: appendPointer(path, key), value: cloneJson(to[key]) });
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: 'replace', path, value: cloneJson(to) });
+}
+
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, patch: PatchOperation[]): void {
+  let prefixLength = 0;
+  while (prefixLength < from.length && prefixLength < to.length
+    && jsonEqual(from[prefixLength], to[prefixLength])) {
+    prefixLength += 1;
+  }
+
+  let suffixLength = 0;
+  while (suffixLength < from.length - prefixLength && suffixLength < to.length - prefixLength
+    && jsonEqual(from[from.length - suffixLength - 1], to[to.length - suffixLength - 1])) {
+    suffixLength += 1;
+  }
+
+  const fromMiddleLength = from.length - prefixLength - suffixLength;
+  const toMiddleLength = to.length - prefixLength - suffixLength;
+  const sharedLength = Math.min(fromMiddleLength, toMiddleLength);
+
+  for (let index = 0; index < sharedLength; index += 1) {
+    diffValues(from[prefixLength + index], to[prefixLength + index], appendPointer(path, String(prefixLength + index)), patch);
+  }
+
+  for (let index = sharedLength; index < fromMiddleLength; index += 1) {
+    patch.push({ op: 'remove', path: appendPointer(path, String(prefixLength + sharedLength)) });
+  }
+
+  for (let index = sharedLength; index < toMiddleLength; index += 1) {
+    patch.push({
+      op: 'add',
+      path: appendPointer(path, String(prefixLength + index)),
+      value: cloneJson(to[prefixLength + index]),
+    });
+  }
+}
+
+function isJsonObjectValue(value: JsonValue): value is { [key: string]: JsonValue } {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function appendPointer(path: string, token: string): string {
+  return `${path}/${token.replaceAll('~', '~0').replaceAll('/', '~1')}`;
+}
