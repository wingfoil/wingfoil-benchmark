+test('creates a localized RFC 6902 patch for nested object changes', () => {
+  const from = { service: { port: 8080, enabled: false }, unchanged: ['keep'] };
+  const to = { service: { port: 8081, host: 'localhost' }, unchanged: ['keep'] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'remove', path: '/service/enabled' },
+    { op: 'replace', path: '/service/port', value: 8081 },
+    { op: 'add', path: '/service/host', value: 'localhost' },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, { service: { port: 8080, enabled: false }, unchanged: ['keep'] });
+  assert.deepEqual(to, { service: { port: 8081, host: 'localhost' }, unchanged: ['keep'] });
+});
+
+test('creates compact ordered array edits and escapes JSON Pointer tokens', () => {
+  const from = { 'a/b~c': ['one', 'three'] };
+  const to = { 'a/b~c': ['one', 'two', 'three'] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: 'add', path: '/a~1b~0c/1', value: 'two' }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test('creates an empty patch for equal values, clones patch values, and rejects non-JSON inputs', () => {
+  const from = { value: 1 };
+  const to = { added: { nested: true } };
+
+  assert.deepEqual(createPatch(from, { value: 1 }), []);
+  const patch = createPatch(from, to);
+  (patch[1].value).nested = false;
+  assert.deepEqual(to, { added: { nested: true } });
+  assert.throws(() => createPatch(new Date(), {}));
+  assert.throws(() => createPatch({}, { value: Infinity }));
+});
