+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ *
+ * The returned patch contains only structural changes and does not mutate
+ * either input. Values included in operations are independent clones.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new Error('JSON Patch documents must be JSON values');
+  }
+
+  const patch: PatchOperation[] = [];
+  diffValues(from, to, '', patch);
+  return patch;
+}
