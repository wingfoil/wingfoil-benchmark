+
+test('applies the RFC 7386 merge-patch example without mutating either input', () => {
+  const target = {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  };
+  const patch = {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  };
+
+  const result = applyMergePatch(target, patch);
+
+  assert.deepEqual(result, {
+    title: 'Hello!',
+    author: { givenName: 'John' },
+    tags: ['example'],
+    content: 'This will be unchanged',
+    phoneNumber: '+01-123-456-7890',
+  });
+  assert.deepEqual(target, {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  });
+  assert.deepEqual(patch, {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  });
+});
+
+test('replaces non-object targets and patches, and ignores null members that do not exist', () => {
+  assert.deepEqual(applyMergePatch('target', { value: 1 }), { value: 1 });
+  assert.deepEqual(applyMergePatch({ value: 1 }, ['replacement']), ['replacement']);
+  assert.equal(applyMergePatch({ value: 1 }, null), null);
+  assert.deepEqual(applyMergePatch({}, { absent: null }), {});
+});
+
+test('rejects non-JSON merge-patch inputs', () => {
+  assert.throws(() => applyMergePatch({ value: 1 }, new Date()));
+  assert.throws(() => applyMergePatch({ value: Infinity }, {}));
+});
