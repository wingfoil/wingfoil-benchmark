+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document.
+ *
+ * Object patches recursively merge members, with `null` deleting a member. A
+ * non-object patch replaces the target. Neither input is mutated.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonValue(target)) {
+    throw new Error('JSON Merge Patch target must be a JSON value');
+  }
+  if (!isJsonValue(patch)) {
+    throw new Error('JSON Merge Patch must be a JSON value');
+  }
+
+  return mergePatch(target, patch);
+}
+
+function mergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (patch === null || typeof patch !== 'object' || Array.isArray(patch)) {
+    return cloneJson(patch);
+  }
+
+  const result: { [key: string]: JsonValue } = target !== null
+    && typeof target === 'object' && !Array.isArray(target)
+    ? cloneJson(target) as { [key: string]: JsonValue }
+    : {};
+
+  for (const [key, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[key];
+    } else {
+      const existing = Object.hasOwn(result, key) ? result[key] : null;
+      setObjectMember(result, key, mergePatch(existing, value));
+    }
+  }
+
+  return result;
+}
