 }
 
+type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
+
+type PatchOperation = {
+  op: string;
+  path: string;
+  from?: string;
+  value?: JsonValue;
+};
+
+/**
+ * Applies an RFC 6902 JSON Patch to a JSON document.
+ *
+ * Both inputs are validated, and the original document is never mutated. Throws
+ * when an operation is malformed or cannot be applied.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!isJsonValue(document)) {
+    throw new Error('JSON Patch document must be a JSON value');
+  }
+
+  if (!Array.isArray(patch)) {
+    throw new Error('JSON Patch must be an array of operations');
+  }
+
+  let result: JsonValue | undefined = cloneJson(document);
+
+  for (const candidate of patch) {
+    const operation = validateOperation(candidate);
+    const path = parsePointer(operation.path);
+
+    switch (operation.op) {
+      case 'add':
+        result = addValue(result, path, cloneJson(operation.value as JsonValue));
+        break;
+      case 'remove':
+        result = removeValue(result, path).document;
+        break;
+      case 'replace':
+        getValue(result, path, operation.path);
+        result = replaceValue(result, path, cloneJson(operation.value as JsonValue));
+        break;
+      case 'move': {
+        const from = parsePointer(operation.from as string);
+        if (isProperPrefix(from, path)) {
+          throw new Error('JSON Patch move destination cannot be inside its source');
+        }
+        const removed = removeValue(result, from);
+        result = addValue(removed.document, path, removed.value);
+        break;
+      }
+      case 'copy': {
+        const value = getValue(result, parsePointer(operation.from as string), operation.from as string);
+        result = addValue(result, path, cloneJson(value));
+        break;
+      }
+      case 'test':
+        if (!jsonEqual(getValue(result, path, operation.path), operation.value as JsonValue)) {
+          throw new Error(`JSON Patch test operation failed at ${operation.path}`);
+        }
+        break;
+    }
+  }
+
+  return result;
+}
+
+function validateOperation(candidate: unknown): PatchOperation {
+  if (candidate === null || typeof candidate !== 'object' || Array.isArray(candidate)) {
+    throw new Error('JSON Patch operation must be an object');
+  }
+
+  const operation = candidate as Record<string, unknown>;
+  if (typeof operation.op !== 'string' || typeof operation.path !== 'string') {
+    throw new Error('JSON Patch operation requires string "op" and "path" members');
+  }
+
+  const requiresValue = operation.op === 'add' || operation.op === 'replace' || operation.op === 'test';
+  const requiresFrom = operation.op === 'move' || operation.op === 'copy';
+  if (!['add', 'remove', 'replace', 'move', 'copy', 'test'].includes(operation.op)) {
+    throw new Error(`Unsupported JSON Patch operation: ${operation.op}`);
+  }
+  if (requiresValue && (!Object.hasOwn(operation, 'value') || !isJsonValue(operation.value))) {
+    throw new Error(`JSON Patch ${operation.op} operation requires a JSON "value" member`);
+  }
+  if (requiresFrom && typeof operation.from !== 'string') {
+    throw new Error(`JSON Patch ${operation.op} operation requires a string "from" member`);
+  }
+
+  return operation as PatchOperation;
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === '') {
+    return [];
+  }
+  if (!pointer.startsWith('/')) {
+    throw new Error('Invalid JSON Pointer: a non-empty pointer must start with "/"');
+  }
+  return pointer.slice(1).split('/').map(decodeReferenceToken);
+}
+
+function getValue(document: JsonValue | undefined, tokens: string[], pointer: string): JsonValue {
+  let value = document;
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(token) || !Object.hasOwn(value, token)) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+      value = value[Number(token)];
+    } else if (value !== null && typeof value === 'object' && Object.hasOwn(value, token)) {
+      value = value[token];
+    } else {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+  }
+  if (value === undefined) {
+    throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+  }
+  return value;
+}
+
+function addValue(document: JsonValue | undefined, path: string[], value: JsonValue): JsonValue {
+  if (path.length === 0) {
+    return value;
+  }
+  const parent = getValue(document, path.slice(0, -1), `/${path.slice(0, -1).join('/')}`);
+  const token = path[path.length - 1];
+  if (Array.isArray(parent)) {
+    if (token === '-') {
+      parent.push(value);
+    } else if (isArrayIndex(token) && Number(token) <= parent.length) {
+      parent.splice(Number(token), 0, value);
+    } else {
+      throw new Error(`JSON Patch add operation has invalid array index: ${token}`);
+    }
+  } else if (parent !== null && typeof parent === 'object') {
+    parent[token] = value;
+  } else {
+    throw new Error('JSON Patch add operation parent is not a container');
+  }
+  return document as JsonValue;
+}
+
+function removeValue(document: JsonValue | undefined, path: string[]): { document: JsonValue | undefined; value: JsonValue } {
+  if (path.length === 0) {
+    if (document === undefined) {
+      throw new Error('JSON Patch remove operation cannot remove a missing document');
+    }
+    return { document: undefined, value: document };
+  }
+  const parent = getValue(document, path.slice(0, -1), '');
+  const token = path[path.length - 1];
+  if (Array.isArray(parent)) {
+    if (!isArrayIndex(token) || !Object.hasOwn(parent, token)) {
+      throw new Error(`JSON Patch remove operation cannot find array index: ${token}`);
+    }
+    return { document, value: parent.splice(Number(token), 1)[0] };
+  }
+  if (parent !== null && typeof parent === 'object' && Object.hasOwn(parent, token)) {
+    const value = parent[token];
+    delete parent[token];
+    return { document, value };
+  }
+  throw new Error(`JSON Patch remove operation cannot find path token: ${token}`);
+}
+
+function replaceValue(document: JsonValue | undefined, path: string[], value: JsonValue): JsonValue {
+  if (path.length === 0) {
+    return value;
+  }
+  const parent = getValue(document, path.slice(0, -1), '');
+  const token = path[path.length - 1];
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else {
+    (parent as { [key: string]: JsonValue })[token] = value;
+  }
+  return document as JsonValue;
+}
+
+function isArrayIndex(token: string): boolean {
+  return /^(?:0|[1-9][0-9]*)$/.test(token) && Number.isSafeInteger(Number(token));
+}
+
+function isProperPrefix(prefix: string[], value: string[]): boolean {
+  return prefix.length < value.length && prefix.every((token, index) => token === value[index]);
+}
+
+function isJsonValue(value: unknown, ancestors = new Set<unknown>()): value is JsonValue {
+  if (value === null || typeof value === 'string' || typeof value === 'boolean') {
+    return true;
+  }
+  if (typeof value === 'number') {
+    return Number.isFinite(value);
+  }
+  if (typeof value !== 'object' || ancestors.has(value)) {
+    return false;
+  }
+  ancestors.add(value);
+  const valid = Array.isArray(value)
+    ? value.length === Object.keys(value).length
+      && Object.keys(value).every(isArrayIndex)
+      && value.every((item) => isJsonValue(item, ancestors))
+    : Object.values(value as Record<string, unknown>).every((item) => isJsonValue(item, ancestors));
+  ancestors.delete(value);
+  return valid;
+}
+
+function cloneJson(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(cloneJson);
+  }
+  if (value !== null && typeof value === 'object') {
+    return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, cloneJson(item)]));
+  }
+  return value;
+}
+
+function jsonEqual(left: JsonValue, right: JsonValue): boolean {
+  if (left === right) {
+    return true;
+  }
+  if (Array.isArray(left) && Array.isArray(right)) {
+    return left.length === right.length && left.every((value, index) => jsonEqual(value, right[index]));
+  }
+  if (left !== null && right !== null && typeof left === 'object' && typeof right === 'object'
+    && !Array.isArray(left) && !Array.isArray(right)) {
+    const leftKeys = Object.keys(left);
+    const rightKeys = Object.keys(right);
+    return leftKeys.length === rightKeys.length
+      && leftKeys.every((key) => Object.hasOwn(right, key) && jsonEqual(left[key], right[key]));
+  }
+  return false;
+}
+
 function decodeReferenceToken(token: string): string {
   if (/~(?:[^01]|$)/.test(token)) {
     throw new Error(`Invalid JSON Pointer reference token: ${token}`);
