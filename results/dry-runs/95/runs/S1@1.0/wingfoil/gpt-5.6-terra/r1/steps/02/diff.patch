+test('applies add, remove, and replace operations without mutating its input', () => {
+  const original = { items: ['one', 'three'], meta: { active: false } };
+  const added = { nested: 1 };
+  const result = applyPatch(original, [
+    { op: 'add', path: '/items/1', value: 'two' },
+    { op: 'add', path: '/items/-', value: 'four' },
+    { op: 'add', path: '/meta/name', value: 'example' },
+    { op: 'add', path: '/added', value: added },
+    { op: 'replace', path: '/added/nested', value: 2 },
+    { op: 'replace', path: '/meta/active', value: true },
+    { op: 'remove', path: '/items/0' },
+  ]);
+
+  assert.deepEqual(result, {
+    items: ['two', 'three', 'four'],
+    meta: { active: true, name: 'example' },
+    added: { nested: 2 },
+  });
+  assert.deepEqual(original, { items: ['one', 'three'], meta: { active: false } });
+  assert.deepEqual(added, { nested: 1 });
+  assert.notStrictEqual(result, original);
+});
+
+test('can add or replace the complete document', () => {
+  assert.deepEqual(applyPatch({ old: true }, [{ op: 'add', path: '', value: ['new'] }]), ['new']);
+  assert.deepEqual(applyPatch({ old: true }, [{ op: 'replace', path: '', value: null }]), null);
+});
+
+test('moves values after removing their source and copies values independently', () => {
+  const result = applyPatch(
+    { items: ['a', 'b', 'c'], source: { nested: { value: 1 } } },
+    [
+      { op: 'move', from: '/items/0', path: '/items/2' },
+      { op: 'copy', from: '/source', path: '/copy' },
+      { op: 'replace', path: '/copy/nested/value', value: 2 },
+    ],
+  );
+
+  assert.deepEqual(result, {
+    items: ['b', 'c', 'a'],
+    source: { nested: { value: 1 } },
+    copy: { nested: { value: 2 } },
+  });
+});
+
+test('test compares JSON values structurally', () => {
+  const result = applyPatch({ value: { list: [1, 2], enabled: true } }, [
+    { op: 'test', path: '/value', value: { enabled: true, list: [1, 2] } },
