+
+describe('single-use coupon and cancellation', () => {
+  it('gives a single-use coupon back when its order is cancelled', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'WELCOME', kind: 'fixed', value: 100, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const lines = [{ sku: 'PEN-4', quantity: 1 }];
+    const first = orders.place({ customer: 'paolo', date: '2026-05-05', lines, coupon: 'WELCOME' });
+    orders.cancel(first.id, '2026-05-05');
+    assert.equal(coupons.usedBy('WELCOME'), undefined);
+    const second = orders.place({ customer: 'paolo', date: '2026-05-05', lines, coupon: 'WELCOME' });
+    assert.equal(second.totals.couponDiscountCents, 100);
+  });
+});
+
+describe('free shipping', () => {
+  it('is free on an order whose goods come to exactly €50.00', () => {
+    const { orders, catalog, inventory } = shop();
+    catalog.add({ sku: 'BX-5', name: 'Box', priceCents: 2500, vatClass: 'standard', weightGrams: 100 });
+    inventory.restock('BX-5', 5);
+    const order = orders.quote({ customer: 'c-1', date: '2026-06-01', lines: [{ sku: 'BX-5', quantity: 2 }] });
+    assert.equal(order.totals.goodsCents, 5000);
+    assert.equal(order.totals.shippingCents, 0);
+  });
+});
