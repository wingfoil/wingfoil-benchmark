@@ -0,0 +1,74 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('bulk import', () => {
+  it('imports a task with a priority and tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin money');
+    assert.deepEqual(result, { imported: 1, rejected: [] });
+    const task = list.list()[0];
+    assert.equal(task?.title, 'Renew the insurance');
+    assert.equal(task?.priority, 'high');
+    assert.deepEqual(task?.tags, ['admin', 'money']);
+  });
+
+  it('defaults to a normal priority when it is left empty', () => {
+    const list = createTodoList();
+    importTasks(list, 'Buy milk;;');
+    assert.equal(list.list()[0]?.priority, 'normal');
+  });
+
+  it('adds a task with no tags when the tags are left empty', () => {
+    const list = createTodoList();
+    importTasks(list, 'Buy milk;low;');
+    assert.deepEqual(list.list()[0]?.tags, []);
+  });
+
+  it('imports several lines, and skips blank lines', () => {
+    const list = createTodoList();
+    const result = importTasks(list, '\nBuy milk;;\n\nWalk the dog;low;outdoors\n');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+    assert.deepEqual(
+      list.list().map((task) => task.title),
+      ['Buy milk', 'Walk the dog'],
+    );
+  });
+
+  it('rejects a line with an invalid priority, counting lines from 1, and keeps importing', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;urgent;\nWalk the dog;low;outdoors');
+    assert.equal(result.imported, 1);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0]?.line, 1);
+    assert.match(result.rejected[0]?.reason ?? '', /priority/);
+  });
+
+  it('rejects a line that is not title;priority;tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'not enough fields');
+    assert.deepEqual(result, {
+      imported: 0,
+      rejected: [{ line: 1, reason: 'expected "title;priority;tags", got "not enough fields"' }],
+    });
+  });
+
+  it('rejects a duplicate title, keeping the first', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;\nBuy milk;high;urgent');
+    assert.equal(result.imported, 1);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0]?.line, 2);
+    assert.match(result.rejected[0]?.reason ?? '', /already a task/);
+    assert.equal(list.list()[0]?.priority, 'normal');
+  });
+
+  it('counts blank lines when numbering rejected lines', () => {
+    const list = createTodoList();
+    const result = importTasks(list, '\n\nbad line');
+    assert.deepEqual(result.rejected, [
+      { line: 3, reason: 'expected "title;priority;tags", got "bad line"' },
+    ]);
+  });
+});
