+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** One rejected line of a bulk import: its 1-based line number, and why it was rejected. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of a bulk import: how many tasks were added, and every line that was rejected. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds every valid line of `text` to `list`. Each line holds one task, as `title;priority;tags`: the
+ * priority may be left empty for `normal`, and the tags are separated by spaces. Blank lines are
+ * skipped.
+ *
+ * @param list - the task list to add to
+ * @param text - the lines to import, one task per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split('\n').forEach((line, index) => {
+    if (line.trim() === '') return;
+    const parts = line.split(';');
+    if (parts.length !== 3) {
+      rejected.push({ line: index + 1, reason: `expected "title;priority;tags", got "${line}"` });
+      return;
+    }
+    const [title, priority, tags] = parts as [string, string, string];
+    const result = list.add({
+      title,
+      priority: priority.trim() === '' ? undefined : (priority.trim() as Priority),
+      tags: tags.trim() === '' ? [] : tags.trim().split(/\s+/),
+    });
+    if (result.ok) imported++;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  });
+  return { imported, rejected };
+}
