diff --git a/test/timestamps.test.ts b/test/timestamps.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..556e6810fddd5036021f101fbfc99c2765f4a7d3
--- /dev/null
+++ b/test/timestamps.test.ts
@@ -0,0 +1,51 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTaskList } from '../src/domain/list.ts';
+
+function valueOf<T>(result: { ok: true; value: T } | { ok: false; error: unknown }): T {
+  if (!result.ok) assert.fail(JSON.stringify(result.error));
+  return result.value;
+}
+
+function fakeClock(...times: readonly string[]): () => string {
+  let index = 0;
+  return () => times[Math.min(index++, times.length - 1)] as string;
+}
+
+describe('task timestamps', () => {
+  it('stamps a new task with the same createdAt and updatedAt', () => {
+    const list = createTaskList(fakeClock('2026-01-01T00:00:00.000Z'));
+    const task = valueOf(list.add({ title: 'Buy milk' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, '2026-01-01T00:00:00.000Z');
+  });
+
+  it('keeps createdAt and bumps updatedAt when completing a task', () => {
+    const list = createTaskList(fakeClock('2026-01-01T00:00:00.000Z', '2026-01-02T00:00:00.000Z'));
+    const task = valueOf(list.add({ title: 'Buy milk' }));
+    const completed = valueOf(list.complete(task.id));
+    assert.equal(completed.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(completed.updatedAt, '2026-01-02T00:00:00.000Z');
+  });
+
+  it('bumps updatedAt on reopen, rename, tag and untag, but never createdAt', () => {
+    const times = [
+      '2026-01-01T00:00:00.000Z', // add
+      '2026-01-02T00:00:00.000Z', // complete
+      '2026-01-03T00:00:00.000Z', // reopen
+      '2026-01-04T00:00:00.000Z', // rename
+      '2026-01-05T00:00:00.000Z', // tag
+      '2026-01-06T00:00:00.000Z', // untag
+    ];
+    const list = createTaskList(fakeClock(...times));
+    const task = valueOf(list.add({ title: 'Buy milk' }));
+    valueOf(list.complete(task.id));
+    assert.equal(valueOf(list.reopen(task.id)).updatedAt, times[2]);
+    assert.equal(valueOf(list.rename(task.id, 'Buy oat milk')).updatedAt, times[3]);
+    assert.equal(valueOf(list.tag(task.id, 'shopping')).updatedAt, times[4]);
+    const untagged = valueOf(list.untag(task.id, 'shopping'));
+    assert.equal(untagged.updatedAt, times[5]);
+    assert.equal(untagged.createdAt, times[0]);
+  });
+});
