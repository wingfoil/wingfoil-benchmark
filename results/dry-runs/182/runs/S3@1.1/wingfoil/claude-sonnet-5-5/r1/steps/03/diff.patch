+
+A rental of 3 days or more costs 10% less than its full price (daily price × days). Quotes and bookings both
+carry the reduced total, rounded to the nearest cent (half up). Shorter rentals are unchanged.
diff --git a/src/index.ts b/src/index.ts
index 68d89e2015f9a3dea1d6905e9c3ea98a6bcfb40c..78c9c7a523a0602aa8de4a140cb70a30e99afb73 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -38,6 +38,8 @@ export interface RentalService {
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
+const LONG_RENTAL_DAYS = 3;
+const LONG_RENTAL_DISCOUNT_PERCENT = 10;
 const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?Z$/;
 
 function parseMidnightUtc(value: unknown, label: string): number {
@@ -65,7 +67,10 @@ export function createRentalService(): RentalService {
     const startMs = parseMidnightUtc(request.start, 'start');
     const endMs = parseMidnightUtc(request.end, 'end');
     if (endMs <= startMs) throw new Error('end must be after start');
-    const total = item.dailyPrice * ((endMs - startMs) / DAY_MS);
+    const days = (endMs - startMs) / DAY_MS;
+    const full = item.dailyPrice * days;
+    // Rentals of LONG_RENTAL_DAYS or more get 10% off, rounded to the nearest cent (half up).
+    const total = days >= LONG_RENTAL_DAYS ? Math.round((full * (100 - LONG_RENTAL_DISCOUNT_PERCENT)) / 100) : full;
     return { startMs, endMs, quote: { itemId: item.id, start: request.start, end: request.end, total } };
   }
 
