+
+test('rentals of 3 days or more cost 10% less, in quotes and bookings', () => {
+  const s = service();
+  const day3 = '2026-07-03T00:00:00Z';
+  assert.equal(s.quote({ itemId: 'b1', start: day1, end: day3 }).total, 5100);
+  assert.equal(s.quote({ itemId: 'b1', start: day1, end: day4 }).total, 6885);
+  assert.equal(s.book({ itemId: 'b1', start: day1, end: day4 }).total, 6885);
+});
+
+test('long rental discount rounds to the nearest cent', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1005 });
+  // 3015 * 0.9 = 2713.5 -> 2714
+  assert.equal(s.quote({ itemId: 'x', start: day1, end: day4 }).total, 2714);
+});
