@@ -121,3 +121,27 @@ test('hourly rentals need an hourly price and whole hours', () => {
   assert.throws(() => s.addEquipment({ id: 'z', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
   assert.throws(() => s.addEquipment({ id: 'z', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
 });
+
+test('cancel refunds in full at least 24h before start, nothing later', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1000 });
+  const a = s.book({ itemId: 'x', start: day1, end: day4 });
+  assert.deepEqual(s.cancel(a.id, '2026-06-30T00:00:00Z'), { bookingId: a.id, refund: a.total });
+  const b = s.book({ itemId: 'x', start: day1, end: day4 });
+  assert.equal(s.cancel(b.id, '2026-06-30T00:00:01Z').refund, 0);
+  const c = s.book({ itemId: 'x', start: day1, end: day4 });
+  assert.equal(s.cancel(c.id, '2026-07-02T00:00:00Z').refund, 0);
+});
+
+test('cancelled booking frees its equipment and cannot be cancelled twice', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1000 });
+  const a = s.book({ itemId: 'x', start: day1, end: day4 });
+  assert.deepEqual(s.availability({ start: day1, end: day4 }), []);
+  s.cancel(a.id, '2026-06-01T00:00:00Z');
+  assert.deepEqual(s.availability({ start: day1, end: day4 }), ['x']);
+  assert.doesNotThrow(() => s.book({ itemId: 'x', start: day1, end: day4 }));
+  assert.throws(() => s.cancel(a.id, '2026-06-01T00:00:00Z'));
+  assert.throws(() => s.cancel('nope', '2026-06-01T00:00:00Z'));
+  assert.throws(() => s.cancel(a.id, 'yesterday'));
+});
