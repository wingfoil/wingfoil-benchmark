+    cancel(bookingId, at) {
+      if (typeof at !== 'string' || !ISO_UTC.test(at) || Number.isNaN(Date.parse(at))) {
+        throw new Error('at must be an ISO-8601 UTC time, like 2026-07-01T10:00:00Z');
