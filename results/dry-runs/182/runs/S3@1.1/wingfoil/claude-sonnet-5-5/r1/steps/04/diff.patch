 });
+
+test('rentals shorter than a day on the hour are priced per hour', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2550, hourlyPrice: 700 });
+  const t10 = '2026-07-01T10:00:00Z';
+  const t13 = '2026-07-01T13:00:00Z';
+  assert.equal(s.quote({ itemId: 'h', start: t10, end: t13 }).total, 2100);
+  assert.equal(s.book({ itemId: 'h', start: t10, end: t13 }).total, 2100);
+  assert.equal(s.quote({ itemId: 'h', start: '2026-07-01T10:00:00Z', end: '2026-07-02T09:00:00Z' }).total, 23 * 700);
+  assert.throws(() => s.book({ itemId: 'h', start: '2026-07-01T12:00:00Z', end: '2026-07-01T14:00:00Z' }));
+  assert.deepEqual(s.availability({ start: t10, end: t13 }), []);
+  assert.deepEqual(s.availability({ start: '2026-07-01T13:00:00Z', end: '2026-07-01T14:00:00Z' }), ['h']);
+});
+
+test('hourly rentals need an hourly price and whole hours', () => {
+  const s = service();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2550, hourlyPrice: 700 });
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' }));
+  assert.throws(() => s.quote({ itemId: 'h', start: '2026-07-01T10:30:00Z', end: '2026-07-01T12:00:00Z' }));
+  assert.throws(() => s.quote({ itemId: 'h', start: '2026-07-01T10:00:00Z', end: '2026-07-02T10:00:00Z' }));
+  assert.throws(() => s.quote({ itemId: 'h', start: '2026-07-01T10:00:00Z', end: '2026-07-04T10:00:00Z' }));
+  assert.throws(() => s.addEquipment({ id: 'z', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: 'z', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
