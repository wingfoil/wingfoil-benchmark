diff --git a/test/rental.test.ts b/test/rental.test.ts
index 98c7779558b97caa36278afc68c24f5c78c8327f..c09cbed10a81fba4c21b8773cd60b8387a27f329 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -84,3 +84,57 @@ test('discounted total rounds half up to the cent', () => {
   // 3 x 1005 = 3015; 90% = 2713.5 -> 2714
   assert.strictEqual(s.quote({ itemId: 'x', start: d(1), end: d(4) }).total, 2714);
 });
+
+const h = (day: number, hour: number) => `2026-07-${String(day).padStart(2, '0')}T${String(hour).padStart(2, '0')}:00:00.000Z`;
+
+function setupHourly() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2550, hourlyPrice: 700 });
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2550 });
+  return s;
+}
+
+test('hourly rental is priced per hour, without the long-rental discount', () => {
+  const s = setupHourly();
+  assert.strictEqual(s.quote({ itemId: 'b1', start: h(1, 13), end: h(1, 17) }).total, 2800);
+  assert.strictEqual(s.quote({ itemId: 'b1', start: h(1, 1), end: h(1, 23) }).total, 15400);
+  assert.strictEqual(s.quote({ itemId: 'b1', start: h(1, 22), end: h(2, 2) }).total, 2800);
+  assert.strictEqual(s.quote({ itemId: 'b1', start: h(1, 0), end: h(1, 5) }).total, 3500);
+});
+
+test('item without hourly price cannot be rented by the hour', () => {
+  const s = setupHourly();
+  assert.throws(() => s.quote({ itemId: 'b2', start: h(1, 13), end: h(1, 17) }));
+  assert.throws(() => s.book({ itemId: 'b2', start: h(1, 13), end: h(1, 17) }));
+});
+
+test('hourly periods must be on the hour and shorter than a day', () => {
+  const s = setupHourly();
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T13:30:00.000Z', end: h(1, 17) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: h(1, 13), end: '2026-07-01T17:00:01.000Z' }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: h(1, 13), end: h(1, 13) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: h(1, 13), end: h(2, 13) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: h(1, 13), end: h(3, 0) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T13:00:00+02:00', end: h(1, 17) }));
+});
+
+test('whole days still use the daily price on an item with an hourly price', () => {
+  assert.strictEqual(setupHourly().quote({ itemId: 'b1', start: d(1), end: d(2) }).total, 2550);
+});
+
+test('hourly bookings block overlaps, allow adjacent hours, and show in availability', () => {
+  const s = setupHourly();
+  s.book({ itemId: 'b1', start: h(1, 13), end: h(1, 17) });
+  assert.throws(() => s.book({ itemId: 'b1', start: h(1, 16), end: h(1, 18) }));
+  s.book({ itemId: 'b1', start: h(1, 17), end: h(1, 19) });
+  assert.deepStrictEqual(s.availability({ start: h(1, 9), end: h(1, 12) }), ['b1']);
+  assert.deepStrictEqual(s.availability({ start: h(1, 12), end: h(1, 14) }), []);
+  assert.deepStrictEqual(s.availability({ start: d(1), end: d(2) }), ['b2']);
+});
+
+test('hourlyPrice is validated', () => {
+  const s = createRentalService();
+  for (const hourlyPrice of [-1, 1.5, NaN, '5' as unknown as number]) {
+    assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice }));
+  }
+});
