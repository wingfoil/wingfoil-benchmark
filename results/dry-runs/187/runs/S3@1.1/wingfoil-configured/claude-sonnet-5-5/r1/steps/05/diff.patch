     assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice }));
   }
 });
+
+test('cancel refunds in full at least 24 h before the start, nothing later', () => {
+  const s = setupHourly();
+  const a = s.book({ itemId: 'b1', start: h(5, 13), end: h(5, 17) });
+  const b = s.book({ itemId: 'b2', start: d(10), end: d(12) });
+  assert.deepStrictEqual(s.cancel(a.id, h(4, 13)), { bookingId: a.id, refund: 2800 });
+  assert.deepStrictEqual(s.cancel(b.id, h(9, 1)), { bookingId: b.id, refund: 0 });
+  const c = s.book({ itemId: 'b1', start: h(5, 13), end: h(5, 17) });
+  assert.deepStrictEqual(s.cancel(c.id, h(6, 0)), { bookingId: c.id, refund: 0 });
+});
+
+test('cancelled booking frees its equipment and cannot be cancelled twice', () => {
+  const s = setupHourly();
+  const a = s.book({ itemId: 'b2', start: d(1), end: d(2) });
+  assert.deepStrictEqual(s.availability({ start: d(1), end: d(2) }), ['b1']);
+  s.cancel(a.id, '2026-06-29T00:00:00.000Z');
+  assert.deepStrictEqual(s.availability({ start: d(1), end: d(2) }), ['b1', 'b2']);
+  assert.throws(() => s.cancel(a.id, '2026-06-29T00:00:00.000Z'), /already cancelled/);
+  s.book({ itemId: 'b2', start: d(1), end: d(2) });
+});
+
+test('cancel rejects unknown bookings and invalid times without cancelling', () => {
+  const s = setupHourly();
+  const a = s.book({ itemId: 'b2', start: d(1), end: d(2) });
+  assert.throws(() => s.cancel('nope', '2026-06-29T00:00:00.000Z'), /unknown booking/);
+  assert.throws(() => s.cancel(a.id, 'soon'));
+  assert.throws(() => s.cancel(a.id, undefined as unknown as string));
+  assert.deepStrictEqual(s.cancel(a.id, '2026-06-29T00:00:00.000Z'), { bookingId: a.id, refund: 2550 });
+});
