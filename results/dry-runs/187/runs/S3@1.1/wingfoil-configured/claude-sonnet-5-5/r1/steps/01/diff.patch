@@ -0,0 +1,53 @@
+import { test } from 'node:test';
+import assert from 'node:assert';
+import { createRentalService } from '../src/index.ts';
+
+const d = (day: number) => `2026-07-${String(day).padStart(2, '0')}T00:00:00.000Z`;
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2550 });
+  return s;
+}
+
+test('quote prices whole days in cents', () => {
+  assert.deepStrictEqual(setup().quote({ itemId: 'b1', start: d(1), end: d(4) }), {
+    itemId: 'b1', start: d(1), end: d(4), total: 7650,
+  });
+});
+
+test('quote accepts Z without milliseconds and spans month ends', () => {
+  const q = setup().quote({ itemId: 'b1', start: '2026-07-31T00:00:00Z', end: '2026-08-02T00:00:00Z' });
+  assert.strictEqual(q.total, 5100);
+});
+
+test('rejects unknown item and bad periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'x', start: d(1), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(2), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(3), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T10:00:00.000Z', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T00:00:00+02:00', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-02-30T00:00:00Z', end: d(2) }));
+});
+
+test('book returns an id and blocks overlaps, allows adjacent periods', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.strictEqual(a.total, 5100);
+  assert.throws(() => s.book({ itemId: 'b1', start: d(2), end: d(4) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(1), end: d(2) }));
+  const b = s.book({ itemId: 'b1', start: d(3), end: d(5) });
+  assert.notStrictEqual(a.id, b.id);
+});
+
+test('other items are independent; invalid equipment rejected', () => {
+  const s = setup();
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  s.book({ itemId: 's1', start: d(1), end: d(3) });
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'z', kind: 'board', dailyPrice: 10.5 }));
+  assert.throws(() => s.addEquipment({ id: 'z', kind: 'mast' as never, dailyPrice: 10 }));
+});
