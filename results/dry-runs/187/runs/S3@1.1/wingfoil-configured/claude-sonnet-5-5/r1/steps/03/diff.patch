 });
 
@@ -70,3 +70,17 @@ test('availability rejects bad periods and kinds', () => {
   assert.throws(() => s.availability({ start: '2026-07-01', end: d(2) }));
   assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'mast' as never }));
 });
+
+test('rentals of 3 days or more get 10% off, in quotes and bookings', () => {
+  const s = setup();
+  assert.strictEqual(s.quote({ itemId: 'b1', start: d(1), end: d(3) }).total, 5100);
+  assert.strictEqual(s.quote({ itemId: 'b1', start: d(1), end: d(4) }).total, 6885);
+  assert.strictEqual(s.book({ itemId: 'b1', start: d(1), end: d(5) }).total, 9180);
+});
+
+test('discounted total rounds half up to the cent', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1005 });
+  // 3 x 1005 = 3015; 90% = 2713.5 -> 2714
+  assert.strictEqual(s.quote({ itemId: 'x', start: d(1), end: d(4) }).total, 2714);
+});
