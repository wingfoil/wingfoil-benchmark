+---
+id: task-003-long-rental-discount
+type: task
+title: "Long rental discount"
+status: approved
+format: 1
+---
+
+## Request
+
+A rental of 3 days or more costs 10% less than its full price. Quotes and bookings both show the reduced total.
+
+## Done
+
+- `price` in `src/index.ts` applies the discount for periods of 3+ days: total = full price x 90%, rounded
+  half up to the cent. Shorter rentals are unchanged.
+- Tests in `test/rental.test.ts`; `npm test` passes.
diff --git a/src/index.ts b/src/index.ts
index 04ec08575262180db9cbf28e46420a02ddd046b3..8e8a6d4ab7d28ec772fcc8d4d545b7c1cba19a6e 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -1,6 +1,9 @@
 
 const DAY_MS = 24 * 60 * 60 * 1000;
 
+const LONG_RENTAL_DAYS = 3;
+const LONG_RENTAL_PERCENT = 90;
+
 /** The kinds of equipment the school rents. */
 export type EquipmentKind = 'board' | 'sail';
 
@@ -75,8 +78,11 @@ export function createRentalService(): RentalService {
     const from = parseMidnight(request.start, 'start');
     const to = parseMidnight(request.end, 'end');
     if (to <= from) throw new Error('end must be after start');
-    const total = ((to - from) / DAY_MS) * item.dailyPrice;
-    if (!Number.isSafeInteger(total)) throw new Error('total is too large');
+    const days = (to - from) / DAY_MS;
+    const full = days * item.dailyPrice;
+    if (!Number.isSafeInteger(full * LONG_RENTAL_PERCENT)) throw new Error('total is too large');
+    // Long rentals get 10% off, rounded half up to the cent.
+    const total = days >= LONG_RENTAL_DAYS ? Math.floor((full * LONG_RENTAL_PERCENT + 50) / 100) : full;
     return { quote: { itemId: item.id, start: request.start, end: request.end, total }, from, to };
   }
 
