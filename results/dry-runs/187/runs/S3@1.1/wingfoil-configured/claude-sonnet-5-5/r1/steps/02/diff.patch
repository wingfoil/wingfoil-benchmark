+     content it carries. -->
+
+## Request
+
+Add `availability(query)` to the rental service, with `query` = `{ start, end, kind? }`. It returns the
+sorted ids of the equipment of that kind (any kind when omitted) that is free for the whole period.
+
+## Done
+
+- `RentalService.availability` and `AvailabilityQuery` in `src/index.ts`; same period rules as `quote`
+  (midnight UTC, `end` after `start`) and the same overlap rule as `book` (adjacent periods do not clash).
+- Invalid period or kind throws.
+- Tests in `test/rental.test.ts`; `npm test` passes.
diff --git a/src/index.ts b/src/index.ts
index e2ae260799e4cb67f54e3136a282454b0e666883..04ec08575262180db9cbf28e46420a02ddd046b3 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -31,6 +31,13 @@ export interface Booking extends Quote {
   id: string;
 }
 
+/** An availability query: a period (as in `RentalRequest`) and an optional kind of equipment. */
+export interface AvailabilityQuery {
+  start: string;
+  end: string;
+  kind?: EquipmentKind;
+}
+
 /** The in-memory rental service of the booking desk. */
 export interface RentalService {
   /** Registers an item; throws on an invalid item or a duplicate id. */
@@ -39,6 +46,8 @@ export interface RentalService {
   quote(request: RentalRequest): Quote;
   /** Books an item; throws like `quote`, and when the item is not free for the whole period. */
   book(request: RentalRequest): Booking;
+  /** Ids, sorted, of the items (of `kind` when given) free for the whole period; throws on an invalid query. */
+  availability(query: AvailabilityQuery): string[];
 }
 
 const MIDNIGHT_UTC = /^(\d{4})-(\d{2})-(\d{2})T00:00(?::00(?:\.0+)?)?(?:Z|\+00:00)$/;
@@ -93,5 +102,17 @@ export function createRentalService(): RentalService {
       bookings.push({ ...booking, from, to });
       return booking;
     },
+    availability(query) {
+      const from = parseMidnight(query?.start, 'start');
+      const to = parseMidnight(query.end, 'end');
+      if (to <= from) throw new Error('end must be after start');
+      const { kind } = query;
+      if (kind !== undefined && kind !== 'board' && kind !== 'sail') throw new Error("kind must be 'board' or 'sail'");
+      return [...items.values()]
+        .filter((i) => (kind === undefined || i.kind === kind) &&
+          !bookings.some((b) => b.itemId === i.id && from < b.to && b.from < to))
+        .map((i) => i.id)
+        .sort();
+    },
   };
 }
diff --git a/test/rental.test.ts b/test/rental.test.ts
index d8ffd23e60118eeda270d456b78fae09306478a7..e2713d63fd7ec4b4f82de70846d725ffe016cfd8 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -51,3 +51,22 @@ test('other items are independent; invalid equipment rejected', () => {
   assert.throws(() => s.addEquipment({ id: 'z', kind: 'board', dailyPrice: 10.5 }));
   assert.throws(() => s.addEquipment({ id: 'z', kind: 'mast' as never, dailyPrice: 10 }));
 });
+
+test('availability lists free items of a kind, sorted, excluding overlaps', () => {
+  const s = setup();
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 1000 });
+  s.book({ itemId: 'b1', start: d(2), end: d(4) });
+  assert.deepStrictEqual(s.availability({ start: d(1), end: d(5) }), ['a0', 's1']);
+  assert.deepStrictEqual(s.availability({ start: d(1), end: d(5), kind: 'board' }), ['a0']);
+  assert.deepStrictEqual(s.availability({ start: d(1), end: d(2) }), ['a0', 'b1', 's1']);
+  assert.deepStrictEqual(s.availability({ start: d(4), end: d(6), kind: 'board' }), ['a0', 'b1']);
+  assert.deepStrictEqual(s.availability({ start: d(3), end: d(4), kind: 'board' }), ['a0']);
+});
+
+test('availability rejects bad periods and kinds', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: d(2), end: d(2) }));
+  assert.throws(() => s.availability({ start: '2026-07-01', end: d(2) }));
+  assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'mast' as never }));
+});
