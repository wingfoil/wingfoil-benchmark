+
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: JsonValue }
+  | { op: "remove"; path: string };
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffInto(ops: PatchOperation[], path: string, from: unknown, to: unknown): void {
+  if (deepEqual(from, to)) return;
+
+  if (isObject(from) && isObject(to)) {
+    const has = (o: Record<string, unknown>, k: string) => Object.prototype.hasOwnProperty.call(o, k);
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (!has(from, key)) ops.push({ op: "add", path: child, value: clone(to[key]) as JsonValue });
+      else diffInto(ops, child, from[key], to[key]);
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(ops, path, from, to);
+    return;
+  }
+
+  ops.push({ op: "replace", path, value: clone(to) as JsonValue });
+}
+
+function diffArrays(ops: PatchOperation[], path: string, from: unknown[], to: unknown[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && deepEqual(from[start], to[start])) start++;
+  let endA = from.length;
+  let endB = to.length;
+  while (endA > start && endB > start && deepEqual(from[endA - 1], to[endB - 1])) {
+    endA--;
+    endB--;
+  }
+
+  // Longest common subsequence of the middle parts.
+  const n = endA - start;
+  const m = endB - start;
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = deepEqual(from[start + i], to[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  // `index` is the position in the array being transformed, which already matches `to` before it.
+  let index = start;
+  const flushGap = (i0: number, i1: number, j0: number, j1: number) => {
+    const removed = i1 - i0;
+    const added = j1 - j0;
+    const paired = Math.min(removed, added);
+    for (let t = 0; t < paired; t++) {
+      diffInto(ops, `${path}/${index + t}`, from[start + i0 + t], to[start + j0 + t]);
+    }
+    for (let t = paired; t < removed; t++) ops.push({ op: "remove", path: `${path}/${index + paired}` });
+    for (let t = paired; t < added; t++) {
+      ops.push({ op: "add", path: `${path}/${index + t}`, value: clone(to[start + j0 + t]) as JsonValue });
+    }
+    index += added;
+  };
+
+  let i = 0;
+  let j = 0;
+  let gapI = 0;
+  let gapJ = 0;
+  while (i < n && j < m) {
+    if (deepEqual(from[start + i], to[start + j])) {
+      flushGap(gapI, i, gapJ, j);
+      index++;
+      i++;
+      j++;
+      gapI = i;
+      gapJ = j;
+    } else if (lcs[i + 1][j] >= lcs[i][j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  flushGap(gapI, n, gapJ, m);
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied.
+ * Only the parts that differ are described. Neither input is mutated.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffInto(ops, "", from, to);
+  return ops;
+}
