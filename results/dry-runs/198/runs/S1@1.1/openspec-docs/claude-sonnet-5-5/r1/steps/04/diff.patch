+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a document and returns the result as a new value.
+ * The input document and patch are not mutated.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): any {
+  if (!isObject(patch)) return clone(patch);
+
+  const result: Record<string, unknown> = isObject(target) ? clone(target) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = Object.prototype.hasOwnProperty.call(result, key) ? result[key] : undefined;
+      setMember(result, key, applyMergePatch(current, value));
+    }
+  }
+  return result;
+}
