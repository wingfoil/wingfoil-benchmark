diff --git a/test/rental.test.ts b/test/rental.test.ts
index 4b8ce885bcc4ecd50e1347967b68e02650588f00..197458ed3e92a83b01fec25ce80abb7c52002b03 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -113,4 +113,42 @@ describe('rental service', () => {
       assert.throws(() => service.availability({ start: day(1), end: day(2), kind: 'kite' as 'board' }));
     });
   });
+
+  describe('hourly rental', () => {
+    const at = (h: number, d = 1) => `2026-07-${String(d).padStart(2, '0')}T${String(h).padStart(2, '0')}:00:00.000Z`;
+    beforeEach(() => {
+      service.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 4000, hourlyPrice: 900 });
+    });
+
+    it('charges the hourly price for each hour, without discount', () => {
+      assert.equal(service.quote({ itemId: 'h1', start: at(9), end: at(12) }).total, 2700);
+      assert.equal(service.quote({ itemId: 'h1', start: at(1), end: at(0, 2) }).total, 20700);
+    });
+
+    it('cannot rent by the hour an item without an hourly price', () => {
+      assert.throws(() => service.quote(period(at(9), at(12))));
+      assert.throws(() => service.book(period(at(9), at(12))));
+    });
+
+    it('rejects times off the hour and day-long rentals off midnight', () => {
+      assert.throws(() => service.quote({ itemId: 'h1', start: '2026-07-01T09:30:00Z', end: at(12) }));
+      assert.throws(() => service.quote({ itemId: 'h1', start: at(9), end: at(9, 2) }));
+      assert.throws(() => service.quote({ itemId: 'h1', start: at(9), end: day(3) }));
+    });
+
+    it('prices whole days at the daily price', () => {
+      assert.equal(service.quote({ itemId: 'h1', start: day(1), end: day(2) }).total, 4000);
+    });
+
+    it('refuses overlapping hourly bookings but allows adjacent ones', () => {
+      service.book({ itemId: 'h1', start: at(9), end: at(11) });
+      assert.throws(() => service.book({ itemId: 'h1', start: at(10), end: at(12) }));
+      assert.equal(service.book({ itemId: 'h1', start: at(11), end: at(12) }).total, 900);
+    });
+
+    it('validates the hourly price', () => {
+      assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+      assert.throws(() => service.addEquipment({ id: 'y', kind: 'sail', dailyPrice: 1, hourlyPrice: 1.5 }));
+    });
+  });
 });
