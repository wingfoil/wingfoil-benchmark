diff --git a/test/rental.test.ts b/test/rental.test.ts
index 01dd8dee10d03acd7660549bdf593817afe7e60d..6ff46dbb8fa4da7852c7580a5d1fdeffb77a1907 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -58,4 +58,44 @@ describe('rental service', () => {
     assert.throws(() => service.addEquipment({ id: 'n', kind: 'board', dailyPrice: 10.5 }));
     assert.throws(() => service.addEquipment({ id: 'n', kind: 'kite' as 'board', dailyPrice: 10 }));
   });
+
+  describe('availability', () => {
+    beforeEach(() => {
+      service.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+      service.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 2000 });
+    });
+
+    it('lists free items of any kind, sorted', () => {
+      assert.deepEqual(service.availability({ start: day(1), end: day(3) }), ['a0', 'b1', 's1']);
+    });
+
+    it('filters by kind', () => {
+      assert.deepEqual(service.availability({ start: day(1), end: day(3), kind: 'board' }), ['a0', 'b1']);
+      assert.deepEqual(service.availability({ start: day(1), end: day(3), kind: 'sail' }), ['s1']);
+    });
+
+    it('excludes items booked for any part of the period', () => {
+      service.book(period(day(2), day(4)));
+      assert.deepEqual(service.availability({ start: day(1), end: day(3) }), ['a0', 's1']);
+      assert.deepEqual(service.availability({ start: day(3), end: day(6) }), ['a0', 's1']);
+      assert.deepEqual(service.availability({ start: day(1), end: day(7) }), ['a0', 's1']);
+    });
+
+    it('keeps items booked only next to the period', () => {
+      service.book(period(day(2), day(4)));
+      assert.deepEqual(service.availability({ start: day(4), end: day(5) }), ['a0', 'b1', 's1']);
+      assert.deepEqual(service.availability({ start: day(1), end: day(2) }), ['a0', 'b1', 's1']);
+    });
+
+    it('returns an empty list when nothing is free', () => {
+      service.book({ itemId: 's1', start: day(1), end: day(3) });
+      assert.deepEqual(service.availability({ start: day(2), end: day(3), kind: 'sail' }), []);
+    });
+
+    it('rejects invalid periods and kinds', () => {
+      assert.throws(() => service.availability({ start: day(2), end: day(2) }));
+      assert.throws(() => service.availability({ start: '2026-07-01', end: day(2) }));
+      assert.throws(() => service.availability({ start: day(1), end: day(2), kind: 'kite' as 'board' }));
+    });
+  });
 });
