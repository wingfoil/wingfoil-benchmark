--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,122 @@
+/** The kinds of equipment the school rents out. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A piece of rental equipment; `dailyPrice` is in euro cents. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** A rental period for an item; `start` and `end` are midnight-UTC ISO-8601 strings, `end` exclusive. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The price of renting an item for a period; `total` is in euro cents. */
+export interface Quote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed booking. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** The in-memory rental service of the booking desk. */
+export interface RentalService {
+  /** Registers an item; throws on an invalid item or a duplicate id. */
+  addEquipment(item: Equipment): void;
+  /** Prices a rental; throws on an unknown item or a period the rules do not allow. */
+  quote(request: RentalRequest): Quote;
+  /** Books a rental; throws like `quote`, and when the item is not free for the whole period. */
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00(:00(\.0+)?)?(Z|\+00:00)$/;
+
+interface Period {
+  start: number;
+  end: number;
+}
+
+function parseMidnightUtc(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC string at midnight`);
+  }
+  const time = Date.parse(value);
+  if (Number.isNaN(time) || new Date(time).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a valid date`);
+  }
+  return time;
+}
+
+function parsePeriod(request: RentalRequest): Period {
+  const start = parseMidnightUtc(request.start, 'start');
+  const end = parseMidnightUtc(request.end, 'end');
+  if (end <= start) {
+    throw new Error('end must be after start');
+  }
+  return { start, end };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item.id !== 'string' || item.id === '') {
+    throw new Error('id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error("kind must be 'board' or 'sail'");
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+  }
+}
+
+const overlaps = (a: Period, b: Period): boolean => a.start < b.end && b.start < a.end;
+
+/** Creates an empty rental service that keeps everything in memory. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const periods = new Map<string, Period[]>();
+  let bookingCount = 0;
+
+  function price(request: RentalRequest): { quote: Quote; period: Period } {
+    const item = equipment.get(request.itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${request.itemId}`);
+    }
+    const period = parsePeriod(request);
+    const days = (period.end - period.start) / DAY_MS;
+    const { itemId, start, end } = request;
+    return { quote: { itemId, start, end, total: days * item.dailyPrice }, period };
+  }
+
+  return {
+    addEquipment(item) {
+      validateEquipment(item);
+      if (equipment.has(item.id)) {
+        throw new Error(`item already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+      periods.set(item.id, []);
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, period } = price(request);
+      const booked = periods.get(request.itemId) ?? [];
+      if (booked.some((other) => overlaps(other, period))) {
+        throw new Error(`item ${request.itemId} is not free for the whole period`);
+      }
+      booked.push(period);
+      bookingCount += 1;
+      return { id: `booking-${bookingCount}`, ...quote };
+    },
+  };
+}
diff --git a/test/rental.test.ts b/test/rental.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..01dd8dee10d03acd7660549bdf593817afe7e60d
--- /dev/null
+++ b/test/rental.test.ts
@@ -0,0 +1,61 @@
+import { strict as assert } from 'node:assert';
+import { beforeEach, describe, it } from 'node:test';
+import { createRentalService, type RentalService } from '../src/index.ts';
+
+const period = (start: string, end: string) => ({ itemId: 'b1', start, end });
+const day = (n: number) => `2026-07-${String(n).padStart(2, '0')}T00:00:00.000Z`;
+
+describe('rental service', () => {
+  let service: RentalService;
+  beforeEach(() => {
+    service = createRentalService();
+    service.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2550 });
+  });
+
+  it('quotes whole days in euro cents', () => {
+    assert.deepEqual(service.quote(period(day(1), day(4))), {
+      itemId: 'b1', start: day(1), end: day(4), total: 7650,
+    });
+  });
+
+  it('rejects unknown items', () => {
+    assert.throws(() => service.quote({ itemId: 'x', start: day(1), end: day(2) }));
+    assert.throws(() => service.book({ itemId: 'x', start: day(1), end: day(2) }));
+  });
+
+  it('rejects periods that are not whole UTC days', () => {
+    assert.throws(() => service.quote(period('2026-07-01T10:00:00Z', day(2))));
+    assert.throws(() => service.quote(period(day(1), '2026-07-02T00:00:00+02:00')));
+    assert.throws(() => service.quote(period('2026-07-01', day(2))));
+    assert.throws(() => service.quote(period('2026-02-30T00:00:00Z', day(2))));
+  });
+
+  it('rejects empty or reversed periods', () => {
+    assert.throws(() => service.quote(period(day(2), day(2))));
+    assert.throws(() => service.quote(period(day(3), day(2))));
+  });
+
+  it('books and returns distinct ids', () => {
+    const first = service.book(period(day(1), day(2)));
+    const second = service.book(period(day(2), day(3)));
+    assert.equal(first.total, 2550);
+    assert.notEqual(first.id, second.id);
+  });
+
+  it('refuses overlapping bookings of the same item only', () => {
+    service.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+    service.book(period(day(2), day(5)));
+    assert.throws(() => service.book(period(day(4), day(6))));
+    assert.throws(() => service.book(period(day(1), day(3))));
+    assert.throws(() => service.book(period(day(1), day(7))));
+    assert.throws(() => service.book(period(day(3), day(4))));
+    service.book(period(day(5), day(6)));
+    service.book({ itemId: 's1', start: day(2), end: day(5) });
+  });
+
+  it('validates equipment', () => {
+    assert.throws(() => service.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+    assert.throws(() => service.addEquipment({ id: 'n', kind: 'board', dailyPrice: 10.5 }));
+    assert.throws(() => service.addEquipment({ id: 'n', kind: 'kite' as 'board', dailyPrice: 10 }));
+  });
+});
