diff --git a/src/rental.test.ts b/src/rental.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3d60da62de4b7bfe616ac8df1d08e1acc865c12b
--- /dev/null
+++ b/src/rental.test.ts
@@ -0,0 +1,91 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.js';
+
+function setup() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 4550 });
+  service.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 2000 });
+  return service;
+}
+const day = (d: number) => `2026-07-${String(d).padStart(2, '0')}T00:00:00.000Z`;
+
+test('quote multiplies the daily price by the number of days', () => {
+  const q = setup().quote({ itemId: 'b1', start: day(10), end: day(13) });
+  assert.deepEqual(q, { itemId: 'b1', start: day(10), end: day(13), total: 13650 });
+});
+
+test('quote accepts a period spanning a month end', () => {
+  const q = setup().quote({ itemId: 's1', start: '2026-07-31T00:00:00Z', end: '2026-08-02T00:00:00Z' });
+  assert.equal(q.total, 4000);
+});
+
+test('quote rejects unknown items', () => {
+  assert.throws(() => setup().quote({ itemId: 'x', start: day(1), end: day(2) }));
+});
+
+test('quote rejects periods that are not whole UTC days', () => {
+  const s = setup();
+  for (const [start, end] of [
+    ['2026-07-10T09:00:00Z', day(11)],
+    [day(10), '2026-07-11T00:00:00+02:00'],
+    [day(10), '2026-07-11'],
+    [day(10), 'nonsense'],
+    ['2026-02-30T00:00:00Z', day(11)],
+  ]) {
+    assert.throws(() => s.quote({ itemId: 'b1', start, end }), `${start} ${end}`);
+  }
+});
+
+test('quote rejects empty and reversed periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'b1', start: day(10), end: day(10) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: day(11), end: day(10) }));
+});
+
+test('book returns a booking with distinct ids', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: day(10), end: day(11) });
+  const b = s.book({ itemId: 'b1', start: day(11), end: day(12) });
+  assert.equal(a.total, 4550);
+  assert.equal(a.itemId, 'b1');
+  assert.notEqual(a.id, b.id);
+});
+
+test('book uses the injected id generator', () => {
+  const s = createRentalService({ generateId: () => 'fixed' });
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 100 });
+  assert.equal(s.book({ itemId: 'b1', start: day(1), end: day(2) }).id, 'fixed');
+});
+
+test('book rejects overlapping periods for the same item only', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: day(10), end: day(13) });
+  for (const [start, end] of [[10, 11], [12, 14], [9, 11], [9, 14], [11, 12]]) {
+    assert.throws(() => s.book({ itemId: 'b1', start: day(start), end: day(end) }), `${start}-${end}`);
+  }
+  s.book({ itemId: 'b1', start: day(13), end: day(14) });
+  s.book({ itemId: 'b1', start: day(9), end: day(10) });
+  s.book({ itemId: 's1', start: day(10), end: day(13) });
+});
+
+test('quote does not reserve the item', () => {
+  const s = setup();
+  s.quote({ itemId: 'b1', start: day(10), end: day(11) });
+  s.book({ itemId: 'b1', start: day(10), end: day(11) });
+});
+
+test('book rejects unknown items and invalid periods', () => {
+  const s = setup();
+  assert.throws(() => s.book({ itemId: 'x', start: day(1), end: day(2) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: '2026-07-01T12:00:00Z', end: day(2) }));
+});
+
+test('addEquipment validates its input', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'n', kind: 'board', dailyPrice: 10.5 }));
+  assert.throws(() => s.addEquipment({ id: 'n', kind: 'board', dailyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: '', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'n', kind: 'kayak' as never, dailyPrice: 1 }));
+});
diff --git a/src/rental.ts b/src/rental.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f62a6dc16f123f7ae61e50b9bf67ca48dd247e5a
--- /dev/null
+++ b/src/rental.ts
@@ -0,0 +1,108 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one day of rental, in euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  /** ISO-8601 UTC midnight, first day of the rental. */
+  start: string;
+  /** ISO-8601 UTC midnight, the start of the day after the last day. */
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  /** Euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+export interface RentalServiceOptions {
+  /** Source of booking ids; defaults to a sequence "booking-1", "booking-2", ... */
+  generateId?: () => string;
+}
+
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+// Whole-day boundaries: midnight UTC, written with an explicit "Z".
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00(:00(\.0+)?)?Z$/;
+
+/** Rule 3: parses a midnight-UTC ISO-8601 string into epoch milliseconds. */
+function parseMidnightUtc(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC midnight, got ${String(value)}`);
+  }
+  const ms = Date.parse(value);
+  // Date.parse rolls impossible dates such as February 30 over; reject them.
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a valid date: ${value}`);
+  }
+  return ms;
+}
+
+export function createRentalService(options: RentalServiceOptions = {}): RentalService {
+  let sequence = 0;
+  const generateId = options.generateId ?? (() => `booking-${++sequence}`);
+  const equipment = new Map<string, Equipment>();
+  const bookings: Array<Booking & { startMs: number; endMs: number }> = [];
+
+  function price(request: RentalRequest) {
+    const item = equipment.get(request.itemId);
+    if (!item) throw new Error(`Unknown item: ${request.itemId}`);
+    const startMs = parseMidnightUtc(request.start, 'start');
+    const endMs = parseMidnightUtc(request.end, 'end');
+    if (endMs <= startMs) throw new Error('end must be after start');
+    const days = (endMs - startMs) / MS_PER_DAY;
+    const quote: Quote = {
+      itemId: item.id,
+      start: request.start,
+      end: request.end,
+      total: item.dailyPrice * days,
+    };
+    return { quote, startMs, endMs };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item.id !== 'string' || item.id === '') throw new Error('Equipment id must be a non-empty string');
+      if (item.kind !== 'board' && item.kind !== 'sail') throw new Error(`Unknown kind: ${String(item.kind)}`);
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+      }
+      if (equipment.has(item.id)) throw new Error(`Equipment already exists: ${item.id}`);
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, startMs, endMs } = price(request);
+      // Rule 4: periods are half-open [start, end), so back-to-back bookings do not overlap.
+      const clash = bookings.some(
+        (b) => b.itemId === quote.itemId && b.startMs < endMs && startMs < b.endMs,
+      );
+      if (clash) throw new Error(`Item ${quote.itemId} is not free for that period`);
+      const booking: Booking = { id: generateId(), ...quote };
+      bookings.push({ ...booking, startMs, endMs });
+      return booking;
+    },
+  };
+}
