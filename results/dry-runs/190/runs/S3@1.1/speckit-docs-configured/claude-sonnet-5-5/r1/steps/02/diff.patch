diff --git a/src/rental.test.ts b/src/rental.test.ts
index 3d60da62de4b7bfe616ac8df1d08e1acc865c12b..507b3d915e98d9e188abadba5ea19be62e65967a 100644
--- a/src/rental.test.ts
+++ b/src/rental.test.ts
@@ -89,3 +89,43 @@ test('addEquipment validates its input', () => {
   assert.throws(() => s.addEquipment({ id: '', kind: 'board', dailyPrice: 1 }));
   assert.throws(() => s.addEquipment({ id: 'n', kind: 'kayak' as never, dailyPrice: 1 }));
 });
+
+test('availability lists the free equipment, sorted, of any kind by default', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a0', kind: 'sail', dailyPrice: 100 });
+  assert.deepEqual(s.availability({ start: day(10), end: day(12) }), ['a0', 'b1', 's1']);
+});
+
+test('availability filters by kind', () => {
+  const s = setup();
+  assert.deepEqual(s.availability({ start: day(10), end: day(12), kind: 'board' }), ['b1']);
+  assert.deepEqual(s.availability({ start: day(10), end: day(12), kind: 'sail' }), ['s1']);
+});
+
+test('availability excludes items booked during any part of the period', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: day(11), end: day(12) });
+  assert.deepEqual(s.availability({ start: day(10), end: day(13) }), ['s1']);
+  assert.deepEqual(s.availability({ start: day(11), end: day(12) }), ['s1']);
+});
+
+test('availability treats periods as half-open', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: day(11), end: day(12) });
+  assert.deepEqual(s.availability({ start: day(10), end: day(11) }), ['b1', 's1']);
+  assert.deepEqual(s.availability({ start: day(12), end: day(13) }), ['b1', 's1']);
+});
+
+test('availability is empty without equipment or free items', () => {
+  assert.deepEqual(createRentalService().availability({ start: day(1), end: day(2) }), []);
+  const s = setup();
+  s.book({ itemId: 'b1', start: day(1), end: day(5) });
+  assert.deepEqual(s.availability({ start: day(2), end: day(3), kind: 'board' }), []);
+});
+
+test('availability rejects invalid periods and kinds', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: day(10), end: day(10) }));
+  assert.throws(() => s.availability({ start: '2026-07-10T09:00:00Z', end: day(11) }));
+  assert.throws(() => s.availability({ start: day(10), end: day(11), kind: 'kayak' as never }));
+});
