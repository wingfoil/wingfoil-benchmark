diff --git a/src/rental.test.ts b/src/rental.test.ts
index 4a7441e88c65c47e7d1dc331a4826c2833767cee..9229e7fac5fb699d5a4a667c4729395ec98f88ce 100644
--- a/src/rental.test.ts
+++ b/src/rental.test.ts
@@ -159,3 +159,62 @@ test('availability rejects invalid periods and kinds', () => {
   assert.throws(() => s.availability({ start: '2026-07-10T09:00:00Z', end: day(11) }));
   assert.throws(() => s.availability({ start: day(10), end: day(11), kind: 'kayak' as never }));
 });
+
+const at = (d: number, h: number) => `2026-07-${String(d).padStart(2, '0')}T${String(h).padStart(2, '0')}:00:00Z`;
+
+function hourly() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 4550, hourlyPrice: 1200 });
+  s.addEquipment({ id: 'd1', kind: 'board', dailyPrice: 4550 });
+  return s;
+}
+
+test('hourly rental costs the hourly price for each hour, with no long-stay discount', () => {
+  const s = hourly();
+  assert.equal(s.quote({ itemId: 'h1', start: at(10, 13), end: at(10, 14) }).total, 1200);
+  assert.equal(s.quote({ itemId: 'h1', start: at(10, 13), end: at(10, 17) }).total, 4800);
+  assert.equal(s.quote({ itemId: 'h1', start: at(10, 13), end: at(11, 12) }).total, 23 * 1200); // 23 h, may cross midnight
+  assert.equal(s.quote({ itemId: 'h1', start: at(10, 0), end: at(10, 5) }).total, 6000);
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  assert.throws(() => hourly().quote({ itemId: 'd1', start: at(10, 13), end: at(10, 15) }));
+  assert.throws(() => hourly().book({ itemId: 'd1', start: at(10, 13), end: at(10, 15) }));
+});
+
+test('a rental of a day or more is still priced by the day', () => {
+  const s = hourly();
+  assert.equal(s.quote({ itemId: 'h1', start: day(10), end: day(11) }).total, 4550);
+  assert.throws(() => s.quote({ itemId: 'h1', start: at(10, 9), end: at(11, 9) }));
+});
+
+test('hourly rentals must start and end on the hour', () => {
+  const s = hourly();
+  for (const [start, end] of [
+    ['2026-07-10T13:30:00Z', at(10, 15)],
+    [at(10, 13), '2026-07-10T15:00:01Z'],
+    [at(10, 13), '2026-07-10T15:00:00+02:00'],
+    [at(10, 13), at(10, 13)],
+    [at(10, 15), at(10, 13)],
+  ]) {
+    assert.throws(() => s.quote({ itemId: 'h1', start, end }), `${start} ${end}`);
+  }
+});
+
+test('hourly bookings conflict with overlapping bookings only', () => {
+  const s = hourly();
+  const b = s.book({ itemId: 'h1', start: at(10, 13), end: at(10, 15) });
+  assert.equal(b.total, 2400);
+  assert.throws(() => s.book({ itemId: 'h1', start: at(10, 14), end: at(10, 16) }));
+  assert.throws(() => s.book({ itemId: 'h1', start: day(10), end: day(11) }));
+  s.book({ itemId: 'h1', start: at(10, 15), end: at(10, 16) });
+  s.book({ itemId: 'h1', start: at(10, 12), end: at(10, 13) });
+  assert.deepEqual(s.availability({ start: day(10), end: day(11) }), ['d1']);
+});
+
+test('addEquipment validates the hourly price', () => {
+  const s = createRentalService();
+  assert.throws(() => s.addEquipment({ id: 'n', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'n', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+  s.addEquipment({ id: 'n', kind: 'board', dailyPrice: 1, hourlyPrice: 0 });
+});
