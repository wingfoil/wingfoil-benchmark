   assert.throws(() => service.addEquipment(invalid({ id: 'x-3', kind: 'board', dailyPrice: 100, hourlyPrice: '800' })));
 });
+
+test('cancel refunds the full total when the rental has not started', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-03') });
+
+  assert.deepEqual(service.cancel(booking.id, '2026-06-30T23:59:59Z'), { bookingId: booking.id, refund: 2 * 2500 });
+});
+
+test('cancel refunds the discounted total of a rental of three days or more', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-04') });
+
+  assert.equal(service.cancel(booking.id, '2026-06-01T08:00:00Z').refund, 6750);
+});
+
+test('cancel refunds nothing once the rental has started', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-02') });
+
+  assert.equal(service.cancel(booking.id, midnight('2026-07-01')).refund, 0);
+
+  const later = service.book({ itemId: 'board-1', start: midnight('2026-08-01'), end: midnight('2026-08-02') });
+  assert.equal(service.cancel(later.id, '2026-08-01T09:30:00Z').refund, 0);
+});
+
+test('a cancelled booking no longer holds its equipment', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+  const booking = service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-02') });
+
+  service.cancel(booking.id, '2026-06-01T00:00:00Z');
+
+  assert.deepEqual(service.availability({ start: midnight('2026-07-01'), end: midnight('2026-07-02') }), ['board-1', 'board-2']);
+  assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-02') }));
+});
+
+test('a cancelled booking does not use up or reuse a booking id', () => {
+  const service = serviceWithBoard();
+  const first = service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-02') });
+  service.cancel(first.id, '2026-06-01T00:00:00Z');
+
+  assert.equal(service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-02') }).id, 'booking-2');
+});
+
+test('a booking can be cancelled only once', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-02') });
+  service.cancel(booking.id, '2026-06-01T00:00:00Z');
+
+  assert.throws(() => service.cancel(booking.id, '2026-06-02T00:00:00Z'), /already cancelled/);
+});
+
+test('cancel throws for an unknown booking', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() => service.cancel('booking-99', '2026-06-01T00:00:00Z'), /unknown booking/);
+});
+
+test('cancel rejects a time that is not a UTC instant in the ISO form', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-02') });
+
+  assert.throws(() => service.cancel(booking.id, '2026-06-01T10:00:00+01:00'));
+  assert.throws(() => service.cancel(booking.id, '2026-06-01 10:00:00Z'));
+  assert.throws(() => service.cancel(booking.id, '2026-02-30T10:00:00Z'));
+});
