diff --git a/src/rental.test.ts b/src/rental.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4be3348e2b46a49b9eb21171248d54e759681a83
--- /dev/null
+++ b/src/rental.test.ts
@@ -0,0 +1,234 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.js';
+
+// Times are written as UTC midnights, the only form the rental rules allow.
+const midnight = (date: string) => `${date}T00:00:00Z`;
+
+// Passes input that the type system would otherwise refuse, to exercise the runtime checks.
+const invalid = (value: object) => value as never;
+
+function serviceWithBoard() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  return service;
+}
+
+test('quote prices one day as one daily price', () => {
+  const service = serviceWithBoard();
+
+  const quote = service.quote({
+    itemId: 'board-1',
+    start: midnight('2026-07-01'),
+    end: midnight('2026-07-02'),
+  });
+
+  assert.deepEqual(quote, {
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-02T00:00:00Z',
+    total: 2500,
+  });
+});
+
+test('quote multiplies the daily price by the number of days', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1800 });
+
+  const quote = service.quote({
+    itemId: 'sail-1',
+    start: midnight('2026-07-01'),
+    end: midnight('2026-07-04'),
+  });
+
+  assert.equal(quote.total, 3 * 1800);
+  assert.ok(Number.isInteger(quote.total));
+});
+
+test('quote does not change what is booked', () => {
+  const service = serviceWithBoard();
+  const period = { itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-02') };
+
+  service.quote(period);
+
+  assert.doesNotThrow(() => service.book(period));
+});
+
+test('book returns the booking with an id and the total', () => {
+  const service = serviceWithBoard();
+
+  const booking = service.book({
+    itemId: 'board-1',
+    start: midnight('2026-07-01'),
+    end: midnight('2026-07-03'),
+  });
+
+  assert.equal(typeof booking.id, 'string');
+  assert.notEqual(booking.id, '');
+  assert.deepEqual(
+    { itemId: booking.itemId, start: booking.start, end: booking.end, total: booking.total },
+    {
+      itemId: 'board-1',
+      start: '2026-07-01T00:00:00Z',
+      end: '2026-07-03T00:00:00Z',
+      total: 2 * 2500,
+    },
+  );
+});
+
+test('each booking gets its own id, in order', () => {
+  const service = serviceWithBoard();
+
+  const first = service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-02') });
+  const second = service.book({ itemId: 'board-1', start: midnight('2026-07-02'), end: midnight('2026-07-03') });
+
+  assert.equal(first.id, 'booking-1');
+  assert.equal(second.id, 'booking-2');
+});
+
+test('a period may start on the day another booking ends', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-03') });
+
+  assert.doesNotThrow(() =>
+    service.book({ itemId: 'board-1', start: midnight('2026-07-03'), end: midnight('2026-07-04') }),
+  );
+});
+
+test('different items can be booked for the same period', () => {
+  const service = serviceWithBoard();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1800 });
+  const period = { start: midnight('2026-07-01'), end: midnight('2026-07-02') };
+
+  service.book({ itemId: 'board-1', ...period });
+
+  assert.doesNotThrow(() => service.book({ itemId: 'sail-1', ...period }));
+});
+
+test('a rejected booking does not use up a booking id', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-03') });
+  assert.throws(() =>
+    service.book({ itemId: 'board-1', start: midnight('2026-07-02'), end: midnight('2026-07-04') }),
+  );
+
+  const next = service.book({ itemId: 'board-1', start: midnight('2026-07-03'), end: midnight('2026-07-04') });
+
+  assert.equal(next.id, 'booking-2');
+});
+
+test('services do not share equipment or bookings', () => {
+  const service = serviceWithBoard();
+  const other = createRentalService();
+
+  assert.throws(() =>
+    other.quote({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-02') }),
+  );
+  service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-02') });
+  other.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 100 });
+  assert.doesNotThrow(() =>
+    other.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-02') }),
+  );
+});
+
+test('quote throws for an unknown item', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() =>
+    service.quote({ itemId: 'no-such-item', start: midnight('2026-07-01'), end: midnight('2026-07-02') }),
+  );
+});
+
+test('book throws for an unknown item', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() =>
+    service.book({ itemId: 'no-such-item', start: midnight('2026-07-01'), end: midnight('2026-07-02') }),
+  );
+});
+
+test('book throws when the item is already booked for an overlapping period', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-05') });
+
+  const overlaps = [
+    { start: midnight('2026-07-01'), end: midnight('2026-07-05') }, // same period
+    { start: midnight('2026-06-30'), end: midnight('2026-07-02') }, // starts before, ends inside
+    { start: midnight('2026-07-04'), end: midnight('2026-07-08') }, // starts inside, ends after
+    { start: midnight('2026-07-02'), end: midnight('2026-07-03') }, // inside
+    { start: midnight('2026-06-28'), end: midnight('2026-07-10') }, // contains
+  ];
+  for (const period of overlaps) {
+    assert.throws(() => service.book({ itemId: 'board-1', ...period }), Error, JSON.stringify(period));
+  }
+});
+
+test('addEquipment rejects an id that is already in use', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'sail', dailyPrice: 900 }));
+});
+
+test('addEquipment rejects an unknown kind, an empty id and a bad price', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.addEquipment(invalid({ id: 'x-1', kind: 'wetsuit', dailyPrice: 100 })));
+  assert.throws(() => service.addEquipment(invalid({ id: '', kind: 'board', dailyPrice: 100 })));
+  assert.throws(() => service.addEquipment(invalid({ id: 'x-2', kind: 'board', dailyPrice: -1 })));
+  assert.throws(() => service.addEquipment(invalid({ id: 'x-3', kind: 'board', dailyPrice: 12.5 })));
+  assert.throws(() => service.addEquipment(invalid({ id: 'x-4', kind: 'board', dailyPrice: '100' })));
+});
+
+test('addEquipment accepts a zero daily price', () => {
+  const service = createRentalService();
+
+  service.addEquipment({ id: 'free-1', kind: 'board', dailyPrice: 0 });
+
+  assert.equal(
+    service.quote({ itemId: 'free-1', start: midnight('2026-07-01'), end: midnight('2026-07-02') }).total,
+    0,
+  );
+});
+
+test('periods must start and end at UTC midnight in the ISO form', () => {
+  const service = serviceWithBoard();
+  const badTimes = [
+    '2026-07-01T10:00:00Z', // not midnight
+    '2026-07-01T00:00:00+01:00', // not UTC
+    '2026-07-01T00:00:30Z', // not whole minutes
+    '2026-07-01', // date only
+    '2026-07-01 00:00:00Z', // not ISO
+    '2026-02-30T00:00:00Z', // no such day
+    'tomorrow',
+  ];
+  for (const bad of badTimes) {
+    assert.throws(() => service.quote({ itemId: 'board-1', start: bad, end: midnight('2026-07-05') }), Error, bad);
+    assert.throws(() => service.quote({ itemId: 'board-1', start: midnight('2026-07-01'), end: bad }), Error, bad);
+  }
+});
+
+test('a period must end after it starts', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() =>
+    service.quote({ itemId: 'board-1', start: midnight('2026-07-02'), end: midnight('2026-07-01') }),
+  );
+  assert.throws(() =>
+    service.book({ itemId: 'board-1', start: midnight('2026-07-02'), end: midnight('2026-07-02') }),
+  );
+});
+
+test('a rejected quote or booking reports a clear error', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(
+    () => service.quote({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: midnight('2026-07-02') }),
+    /UTC midnight|midnight/i,
+  );
+});
+
+test('the rental module is exported from the package entry point', async () => {
+  const entry = await import('./index.js');
+
+  assert.equal(typeof entry.createRentalService, 'function');
+});
