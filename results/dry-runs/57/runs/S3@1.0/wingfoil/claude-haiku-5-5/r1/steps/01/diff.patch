index 0000000000000000000000000000000000000000..f928925b8d3049de8f5d3f59e17275580d5d86a0
--- /dev/null
+++ b/src/rental.ts
@@ -0,0 +1,145 @@
+/** The kinds of equipment the school rents out. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A rentable item. `dailyPrice` is the price of one day, in euro cents. */
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** The period asked for. Both times are UTC midnights in ISO-8601 form; `end` is exclusive. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The price of renting an item for a period, in euro cents. */
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  total: number;
+}
+
+/** A confirmed rental. `id` identifies the booking. */
+export interface Booking extends Quote {
+  id: string;
+}
+
+/** An in-memory rental service. */
+export interface RentalService {
+  /** Adds an item. Throws if the id is empty or already in use, or the kind or price is invalid. */
+  addEquipment(item: Equipment): void;
+  /** Prices a period for an item. Throws for an unknown item or a period the rules do not allow. */
+  quote(request: RentalRequest): Quote;
+  /** Books an item for a period. Throws as `quote` does, and also when the item is already booked for an overlapping period. */
+  book(request: RentalRequest): Booking;
+}
+
+interface Period {
+  startMs: number;
+  endMs: number;
+}
+
+interface BookedPeriod extends Period {
+  itemId: string;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+// A UTC midnight, written as the rules require. Anything else is refused before it is parsed.
+const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00:00(\.000)?Z$/;
+
+/**
+ * Creates an empty rental service. Each call returns a separate service with its own items and
+ * bookings, so the school's data is never shared between instances.
+ */
+export function createRentalService(): RentalService {
+  const items = new Map<string, Equipment>();
+  const bookedPeriods: BookedPeriod[] = [];
+  let lastBookingNumber = 0;
+
+  function findItem(itemId: string): Equipment {
+    const item = items.get(itemId);
+    if (item === undefined) {
+      throw new Error(`unknown item: ${itemId}`);
+    }
+    return item;
+  }
+
+  return {
+    addEquipment(item) {
+      validateEquipment(item);
+      if (items.has(item.id)) {
+        throw new Error(`equipment id already in use: ${item.id}`);
+      }
+      items.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      const { item, period } = resolve(request);
+      return priceOf(item, request, period);
+    },
+
+    book(request) {
+      const { item, period } = resolve(request);
+      if (isBooked(item.id, period)) {
+        throw new Error(`item ${item.id} is already booked for an overlapping period`);
+      }
+      lastBookingNumber += 1;
+      bookedPeriods.push({ itemId: item.id, ...period });
+      return { id: `booking-${lastBookingNumber}`, ...priceOf(item, request, period) };
+    },
+  };
+
+  function resolve(request: RentalRequest): { item: Equipment; period: Period } {
+    return { item: findItem(request.itemId), period: parsePeriod(request) };
+  }
+
+  function isBooked(itemId: string, period: Period): boolean {
+    // Half-open periods: two periods overlap only when each starts before the other ends.
+    return bookedPeriods.some(
+      (booked) => booked.itemId === itemId && booked.startMs < period.endMs && period.startMs < booked.endMs,
+    );
+  }
+}
+
+function priceOf(item: Equipment, request: RentalRequest, period: Period): Quote {
+  const days = (period.endMs - period.startMs) / DAY_MS;
+  return { itemId: item.id, start: request.start, end: request.end, total: days * item.dailyPrice };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item.id !== 'string' || item.id === '') {
+    throw new Error('equipment id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error(`equipment kind must be 'board' or 'sail', got ${String(item.kind)}`);
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('daily price must be a non-negative whole number of euro cents');
+  }
+}
+
+function parsePeriod(request: RentalRequest): Period {
+  const startMs = parseUtcMidnight(request.start, 'start');
+  const endMs = parseUtcMidnight(request.end, 'end');
+  if (endMs <= startMs) {
+    throw new Error('end must be after start');
+  }
+  return { startMs, endMs };
+}
+
+function parseUtcMidnight(value: string, name: string): number {
+  if (typeof value !== 'string' || !UTC_MIDNIGHT.test(value)) {
+    throw new Error(`${name} must be a UTC midnight written as YYYY-MM-DDT00:00:00Z`);
+  }
+  const ms = Date.parse(value);
+  // Rejects dates that do not exist, such as 30 February, which Date would otherwise roll over.
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a real date: ${value}`);
+  }
+  return ms;
+}
