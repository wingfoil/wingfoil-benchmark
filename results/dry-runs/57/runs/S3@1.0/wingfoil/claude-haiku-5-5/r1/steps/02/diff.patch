+
+test('availability lists every item when nothing is booked, sorted by id', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 1800 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1800 });
+
+  assert.deepEqual(
+    service.availability({ start: midnight('2026-07-01'), end: midnight('2026-07-02') }),
+    ['board-1', 'sail-1', 'sail-2'],
+  );
+});
+
+test('availability filters by kind when one is given', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1800 });
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+
+  assert.deepEqual(
+    service.availability({ start: midnight('2026-07-01'), end: midnight('2026-07-02'), kind: 'board' }),
+    ['board-1', 'board-2'],
+  );
+  assert.deepEqual(
+    service.availability({ start: midnight('2026-07-01'), end: midnight('2026-07-02'), kind: 'sail' }),
+    ['sail-1'],
+  );
+});
+
+test('availability leaves out an item booked for an overlapping period', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+  service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-05') });
+
+  const overlaps = [
+    { start: midnight('2026-07-01'), end: midnight('2026-07-05') }, // same period
+    { start: midnight('2026-06-30'), end: midnight('2026-07-02') }, // starts before, ends inside
+    { start: midnight('2026-07-04'), end: midnight('2026-07-08') }, // starts inside, ends after
+    { start: midnight('2026-07-02'), end: midnight('2026-07-03') }, // inside
+    { start: midnight('2026-06-28'), end: midnight('2026-07-10') }, // contains
+  ];
+  for (const period of overlaps) {
+    assert.deepEqual(service.availability(period), ['board-2'], JSON.stringify(period));
+  }
+});
+
+test('availability keeps an item for a period that starts or ends on a booking boundary', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.book({ itemId: 'board-1', start: midnight('2026-07-03'), end: midnight('2026-07-05') });
+
+  assert.deepEqual(
+    service.availability({ start: midnight('2026-07-01'), end: midnight('2026-07-03') }),
+    ['board-1'],
+  );
+  assert.deepEqual(
+    service.availability({ start: midnight('2026-07-05'), end: midnight('2026-07-06') }),
+    ['board-1'],
+  );
+});
+
+test('availability returns an empty list when nothing is free', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.book({ itemId: 'board-1', start: midnight('2026-07-01'), end: midnight('2026-07-05') });
+
+  assert.deepEqual(
+    service.availability({ start: midnight('2026-07-01'), end: midnight('2026-07-02'), kind: 'board' }),
+    [],
+  );
+  assert.deepEqual(createRentalService().availability({ start: midnight('2026-07-01'), end: midnight('2026-07-02') }), []);
+});
+
+test('availability does not reserve anything', () => {
+  const service = serviceWithBoard();
+  const period = { start: midnight('2026-07-01'), end: midnight('2026-07-02') };
+
+  service.availability(period);
+
+  assert.deepEqual(service.book({ itemId: 'board-1', ...period }).id, 'booking-1');
+});
+
+test('availability throws for an unknown kind', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() =>
+    service.availability(
+      invalid({ start: midnight('2026-07-01'), end: midnight('2026-07-02'), kind: 'wetsuit' }),
+    ),
+  );
+});
+
+test('availability rejects a period the rules do not allow', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() => service.availability({ start: '2026-07-01T10:00:00Z', end: midnight('2026-07-02') }));
+  assert.throws(() => service.availability({ start: midnight('2026-07-02'), end: midnight('2026-07-02') }));
+});
