     },
+    exportMonth(month) {
+      if (!MONTH.test(month)) return err('invalid', `${month} is not a month (YYYY-MM)`);
+      const lines = [CSV_HEADER];
+      for (const order of orders.filter((placed) => placed.date.startsWith(`${month}-`))) {
+        const customer = customers.get(order.customerId);
+        if (!customer.ok) return customer;
+        const totals = totalsOf(order.number, codes.get(order.number));
+        if (!totals.ok) return totals;
+        lines.push([String(order.number), order.date, customer.value.name, formatEuros(totals.value.totalCents)]);
+      }
+      return ok(lines.map((line) => line.map(csvField).join(',')).join('\n') + '\n');
+    },
   };
 }
