@@ -0,0 +1,45 @@
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of an import that could not be added, with its number (from 1) and the reason. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and the lines that were not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds tasks to the list from text with one task per line, as `title;priority;tags`. The priority may be
+ * empty for a normal one, the tags are separated by spaces, and both may be left out. Blank lines are
+ * skipped; a line that cannot be added is reported and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: 'a line must have at most three fields: title;priority;tags' });
+      return;
+    }
+    const [title = '', priority = '', tags = ''] = fields;
+    const result = list.add({
+      title,
+      priority: (priority.trim() === '' ? undefined : priority.trim().toLowerCase()) as Priority | undefined,
+      tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line, reason: result.error.message });
+  });
+  return { imported, rejected };
+}
