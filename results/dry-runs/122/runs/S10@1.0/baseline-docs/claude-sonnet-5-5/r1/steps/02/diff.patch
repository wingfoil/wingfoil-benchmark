 });
+
+describe('monthly export', () => {
+  const header = 'order,date,customer,total\n';
+
+  it('lists the orders of the month by number, with what the customer pays', () => {
+    const shop = stocked();
+    shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-10-03', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    shop.orders.applyCode(3, 'SPRING10');
+    assert.equal(
+      shop.orders.exportMonth('2026-10'),
+      `${header}2,2026-10-02,Mira Holt,17.80\n3,2026-10-03,Mira Holt,57.60\n`,
+    );
+  });
+
+  it('gives the header alone for a month without orders', () => {
+    assert.equal(stocked().orders.exportMonth('2026-11'), header);
+  });
+
+  it('quotes values holding a comma or a quote', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, Mira "Mimi"', email: 'm@example.org', phone: '' }));
+    shop.orders.place({ customerId: 'c2', date: '2026-10-04', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    assert.equal(shop.orders.exportMonth('2026-10'), `${header}1,2026-10-04,"Holt, Mira ""Mimi""",17.80\n`);
+  });
+
+  it('refuses a malformed month', () => {
+    assert.throws(() => stocked().orders.exportMonth('2026-13'), RangeError);
+  });
+});
