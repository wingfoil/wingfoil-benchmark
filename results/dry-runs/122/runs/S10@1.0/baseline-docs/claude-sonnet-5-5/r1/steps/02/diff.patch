+  exportMonth(month: string): string;
+}
+
+const MONTH = /^\d{4}-(0[1-9]|1[0-2])$/;
+const EXPORT_HEADER = ['order', 'date', 'customer', 'total'];
+
+/** A CSV field, quoted when it holds a comma, a quote or a line break. */
+function csvField(value: string): string {
+  return /[",\r\n]/.test(value) ? `"${value.replaceAll('"', '""')}"` : value;
 }
 
 const DATE = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
@@ -121,5 +135,21 @@ export function createOrderBook(catalogue: Catalogue, customers: Customers): Ord
       if (totals.ok) codes.set(number, code);
       return totals;
     },
+    exportMonth(month) {
+      if (!MONTH.test(month)) throw new RangeError(`${month} is not a month (YYYY-MM)`);
+      const rows = orders
+        .filter((order) => order.date.startsWith(`${month}-`))
+        .map((order) => {
+          const customer = customers.get(order.customerId);
+          const totals = totalsOf(order, codes.get(order.number));
+          return [
+            String(order.number),
+            order.date,
+            customer.ok ? customer.value.name : '',
+            totals.ok ? formatEuros(totals.value.totalCents) : '',
+          ];
+        });
+      return [EXPORT_HEADER, ...rows].map((row) => `${row.map(csvField).join(',')}\n`).join('');
+    },
   };
 }
diff --git a/test/shop.test.ts b/test/shop.test.ts
