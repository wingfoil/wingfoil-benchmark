diff --git a/test/index.test.ts b/test/index.test.ts
index 98ccd8d1265478379b30990237dafffb1efbc80c..11bd363028de9f124b13cf0db77985d8bd8ce88d 100644
--- a/test/index.test.ts
+++ b/test/index.test.ts
@@ -93,3 +93,23 @@ test("rejects invalid and unsuccessful JSON Patch operations", () => {
     assert.throws(() => applyPatch(document, patch));
   }
 });
+
+test("rejects non-JSON patch documents before applying any operation", () => {
+  const document = { unchanged: true };
+  const patch = [
+    { op: "replace", path: "/unchanged", value: false },
+    { op: "add", path: "/invalid", value: true, metadata: undefined },
+  ];
+
+  assert.throws(() => applyPatch(document, patch));
+  assert.deepEqual(document, { unchanged: true });
+});
+
+test("does not treat inherited fields as JSON Patch operation members", () => {
+  const operation = Object.assign(
+    Object.create({ op: "add", path: "/added" }),
+    { value: true },
+  );
+
+  assert.throws(() => applyPatch({}, [operation]));
+});
