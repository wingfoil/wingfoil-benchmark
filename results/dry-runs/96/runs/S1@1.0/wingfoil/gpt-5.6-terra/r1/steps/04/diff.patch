 const exampleDocument = {
   foo: ["bar", "baz"],
@@ -113,3 +113,60 @@ test("does not treat inherited fields as JSON Patch operation members", () => {
 
   assert.throws(() => applyPatch({}, [operation]));
 });
+
+test("applies the RFC 7386 JSON Merge Patch examples without mutating inputs", () => {
+  const target = {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+  assert.deepEqual(target, {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  });
+  assert.deepEqual(patch, {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  });
+});
+
+test("uses non-object merge patches as whole-document replacements", () => {
+  assert.equal(applyMergePatch({ replace: true }, null), null);
+  assert.deepEqual(applyMergePatch({ replace: true }, ["a", "b"]), ["a", "b"]);
+  assert.deepEqual(applyMergePatch([1, 2], { added: true }), { added: true });
+});
+
+test("handles null deletions, absent members, and nested object creation", () => {
+  assert.deepEqual(applyMergePatch({ keep: true, remove: false }, {
+    remove: null,
+    absent: null,
+    created: { nested: "value" },
+  }), {
+    keep: true,
+    created: { nested: "value" },
+  });
+});
+
+test("rejects non-JSON merge patch inputs", () => {
+  assert.throws(() => applyMergePatch({ valid: true }, { invalid: undefined }));
+  assert.throws(() => applyMergePatch({ invalid: Number.NaN }, {}));
+});
