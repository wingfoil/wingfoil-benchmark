+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document.
+ *
+ * Object-valued patches merge recursively; a `null` member removes the corresponding
+ * target member. Any non-object patch replaces the target entirely.
+ *
+ * @param target - The JSON value to update.
+ * @param patch - The RFC 7386 merge patch document.
+ * @returns A new JSON value containing the merged document.
+ * @throws {Error} If the target or patch contains a non-JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return mergePatch(cloneJson(target, "target"), cloneJson(patch, "JSON Merge Patch"));
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonObject(patch)) {
+    return patch;
+  }
+
+  const result: Record<string, unknown> = isJsonObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const patchValue = patch[key];
+    if (patchValue === null) {
+      delete result[key];
+    } else {
+      defineJsonProperty(
+        result,
+        key,
+        mergePatch(Object.hasOwn(result, key) ? result[key] : undefined, patchValue),
+      );
+    }
+  }
+  return result;
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
 function applyOperation(document: unknown, operation: unknown): unknown {
   if (operation === null || typeof operation !== "object" || Array.isArray(operation)) {
     throw new Error("A JSON Patch operation must be an object.");
