+/**
+ * Creates an RFC 6902 JSON Patch that transforms one JSON value into another.
+ *
+ * The patch uses member-level operations for objects and localized edits for arrays.
+ * Neither input is changed.
+ *
+ * @param from - The JSON value to transform from.
+ * @param to - The JSON value to transform to.
+ * @returns An RFC 6902 JSON Patch document.
+ * @throws {Error} If either input contains a non-JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): Array<Record<string, unknown>> {
+  const fromDocument = cloneJson(from, "from");
+  const toDocument = cloneJson(to, "to");
+  const patch: Array<Record<string, unknown>> = [];
+
+  createPatchOperations(fromDocument, toDocument, "", patch);
+  return patch;
+}
+
 /**
  * Applies an RFC 7386 JSON Merge Patch to a JSON document.
  *
@@ -110,6 +130,89 @@ function isJsonObject(value: unknown): value is Record<string, unknown> {
   return value !== null && typeof value === "object" && !Array.isArray(value);
 }
 
+function createPatchOperations(
+  from: unknown,
+  to: unknown,
+  path: string,
+  patch: Array<Record<string, unknown>>,
+): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) {
+        patch.push({ op: "remove", path: childPath(path, key) });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      const memberPath = childPath(path, key);
+      if (Object.hasOwn(from, key)) {
+        createPatchOperations(from[key], to[key], memberPath, patch);
+      } else {
+        patch.push({ op: "add", path: memberPath, value: to[key] });
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatchOperations(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: "replace", path, value: to });
+}
+
+function createArrayPatchOperations(
+  from: unknown[],
+  to: unknown[],
+  path: string,
+  patch: Array<Record<string, unknown>>,
+): void {
+  let prefixLength = 0;
+  while (prefixLength < from.length && prefixLength < to.length
+    && jsonEqual(from[prefixLength], to[prefixLength])) {
+    prefixLength += 1;
+  }
+
+  let suffixLength = 0;
+  while (suffixLength < from.length - prefixLength && suffixLength < to.length - prefixLength
+    && jsonEqual(from[from.length - suffixLength - 1], to[to.length - suffixLength - 1])) {
+    suffixLength += 1;
+  }
+
+  const fromMiddleLength = from.length - prefixLength - suffixLength;
+  const toMiddleLength = to.length - prefixLength - suffixLength;
+  if (fromMiddleLength === toMiddleLength) {
+    for (let index = 0; index < fromMiddleLength; index += 1) {
+      createPatchOperations(
+        from[prefixLength + index],
+        to[prefixLength + index],
+        childPath(path, String(prefixLength + index)),
+        patch,
+      );
+    }
+    return;
+  }
+
+  for (let index = 0; index < fromMiddleLength; index += 1) {
+    patch.push({ op: "remove", path: childPath(path, String(prefixLength)) });
+  }
+  for (let index = 0; index < toMiddleLength; index += 1) {
+    patch.push({
+      op: "add",
+      path: childPath(path, String(prefixLength + index)),
+      value: to[prefixLength + index],
+    });
+  }
+}
+
+function childPath(path: string, token: string): string {
+  return `${path}/${encodeToken(token)}`;
+}
