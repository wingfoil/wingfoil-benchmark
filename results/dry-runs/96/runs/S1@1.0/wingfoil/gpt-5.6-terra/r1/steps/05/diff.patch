+
+test("creates a granular JSON Patch for nested object changes", () => {
+  const from = {
+    unchanged: true,
+    profile: { name: "Ada", role: "developer", obsolete: true },
+  };
+  const to = {
+    unchanged: true,
+    profile: { name: "Ada", role: "maintainer", team: "platform" },
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/profile/obsolete" },
+    { op: "replace", path: "/profile/role", value: "maintainer" },
+    { op: "add", path: "/profile/team", value: "platform" },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    unchanged: true,
+    profile: { name: "Ada", role: "developer", obsolete: true },
+  });
+  assert.deepEqual(to, {
+    unchanged: true,
+    profile: { name: "Ada", role: "maintainer", team: "platform" },
+  });
+});
+
+test("creates compact array edits and escapes JSON Pointer tokens", () => {
+  const from = { "a/b": ["first", "last"] };
+  const to = { "a/b": ["first", "middle", "last"] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: "add", path: "/a~1b/1", value: "middle" }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("creates an empty patch for equal JSON and validates both inputs", () => {
+  assert.deepEqual(createPatch({ nested: [null, true] }, { nested: [null, true] }), []);
+  assert.throws(() => createPatch({ invalid: undefined }, {}));
+  assert.throws(() => createPatch({}, { invalid: Number.NaN }));
+});
