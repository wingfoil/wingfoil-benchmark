+
+test("applies the RFC 6902 operation examples without mutating the document", () => {
+  const document = {
+    foo: ["bar", "baz"],
+    nested: { value: 1 },
+  };
+  const patch = [
+    { op: "add", path: "/foo/1", value: "qux" },
+    { op: "add", path: "/new", value: { copied: true } },
+    { op: "replace", path: "/nested/value", value: 2 },
+    { op: "copy", from: "/new", path: "/copied" },
+    { op: "move", from: "/foo/0", path: "/foo/2" },
+    { op: "remove", path: "/foo/0" },
+    { op: "test", path: "/nested", value: { value: 2 } },
+  ];
+
+  const result = applyPatch(document, patch);
+
+  assert.deepEqual(result, {
+    foo: ["baz", "bar"],
+    nested: { value: 2 },
+    new: { copied: true },
+    copied: { copied: true },
+  });
+  assert.deepEqual(document, { foo: ["bar", "baz"], nested: { value: 1 } });
+  assert.notEqual((result as { new: object }).new, (result as { copied: object }).copied);
+});
+
+test("supports root replacement, array append, and escaped member names", () => {
+  assert.deepEqual(applyPatch({ "a/b": [1] }, [{ op: "add", path: "/a~1b/-", value: 2 }]), {
+    "a/b": [1, 2],
+  });
+  assert.deepEqual(applyPatch({ old: true }, [{ op: "replace", path: "", value: ["new"] }]), ["new"]);
+});
+
+test("rejects invalid and unsuccessful JSON Patch operations", () => {
+  const document = { foo: ["bar"], object: { value: 1 } };
+
+  for (const patch of [
+    [{ op: "add", path: "/foo/2", value: "baz" }],
+    [{ op: "remove", path: "/missing" }],
+    [{ op: "replace", path: "/missing", value: null }],
+    [{ op: "move", from: "/object", path: "/object/value/child" }],
+    [{ op: "test", path: "/object", value: { value: 2 } }],
+    [{ op: "unknown", path: "/foo" }],
+    [{ op: "copy", path: "/copy" }],
+    [{ op: "add", path: "/foo" }],
+    [{ op: "test", path: "/object", value: undefined }],
+  ]) {
+    assert.throws(() => applyPatch(document, patch));
+  }
+});
