+/**
+ * Applies an RFC 6902 JSON Patch to a JSON document.
+ *
+ * @param document - The JSON value to patch.
+ * @param patch - An array of RFC 6902 patch operation objects.
+ * @returns A new JSON value containing the patched document.
+ * @throws {Error} If the document or patch is invalid, or an operation cannot be applied.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  let result = cloneJson(document, "document");
+
+  if (!Array.isArray(patch)) {
+    throw new Error("A JSON Patch must be an array of operations.");
+  }
+
+  for (const operation of patch) {
+    result = applyOperation(result, operation);
+  }
+
+  return result;
+}
+
+function applyOperation(document: unknown, operation: unknown): unknown {
+  if (operation === null || typeof operation !== "object" || Array.isArray(operation)) {
+    throw new Error("A JSON Patch operation must be an object.");
+  }
+
+  const record = operation as Record<string, unknown>;
+  const op = requiredString(record, "op");
+  const path = requiredString(record, "path");
+  const tokens = parsePointer(path);
+
+  switch (op) {
+    case "add":
+      return addValue(document, tokens, requiredValue(record));
+    case "remove":
+      return removeValue(document, tokens);
+    case "replace":
+      return replaceValue(document, tokens, requiredValue(record));
+    case "move": {
+      const from = requiredString(record, "from");
+      const fromTokens = parsePointer(from);
+      if (from === path) {
+        getValue(document, fromTokens, from);
+        return document;
+      }
+      if (path.startsWith(`${from}/`)) {
+        throw new Error("A move operation cannot move a value into one of its children.");
+      }
+      const value = getValue(document, fromTokens, from);
+      return addValue(removeValue(document, fromTokens), tokens, value);
+    }
+    case "copy": {
+      const from = requiredString(record, "from");
+      return addValue(document, tokens, getValue(document, parsePointer(from), from));
+    }
+    case "test": {
+      const value = cloneJson(requiredValue(record), "operation value");
+      if (!jsonEqual(getValue(document, tokens, path), value)) {
+        throw new Error(`JSON Patch test operation failed at path: ${path}`);
+      }
+      return document;
+    }
+    default:
+      throw new Error(`Unsupported JSON Patch operation: ${op}`);
+  }
+}
+
+function addValue(document: unknown, tokens: string[], value: unknown): unknown {
+  const newValue = cloneJson(value, "operation value");
+  if (tokens.length === 0) {
+    return newValue;
+  }
+
+  const [parent, token] = getParent(document, tokens);
+  if (Array.isArray(parent)) {
+    const index = token === "-" ? parent.length : arrayIndex(token, parent.length, true);
+    parent.splice(index, 0, newValue);
+  } else {
+    defineJsonProperty(parent, token, newValue);
+  }
+  return document;
+}
+
+function removeValue(document: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) {
+    throw new Error("A remove operation cannot remove the document root.");
+  }
+
+  const [parent, token] = getParent(document, tokens);
+  if (Array.isArray(parent)) {
+    const index = arrayIndex(token, parent.length, false);
+    parent.splice(index, 1);
+  } else {
+    if (!Object.hasOwn(parent, token)) {
+      throw new Error(`JSON Pointer does not resolve: /${tokens.map(encodeToken).join("/")}`);
+    }
+    delete parent[token];
+  }
+  return document;
+}
+
+function replaceValue(document: unknown, tokens: string[], value: unknown): unknown {
+  const newValue = cloneJson(value, "operation value");
+  if (tokens.length === 0) {
+    return newValue;
+  }
+
+  const [parent, token] = getParent(document, tokens);
+  if (Array.isArray(parent)) {
+    parent[arrayIndex(token, parent.length, false)] = newValue;
+  } else {
+    if (!Object.hasOwn(parent, token)) {
+      throw new Error(`JSON Pointer does not resolve: /${tokens.map(encodeToken).join("/")}`);
+    }
+    defineJsonProperty(parent, token, newValue);
+  }
+  return document;
+}
+
+function getParent(document: unknown, tokens: string[]): [Record<string, unknown> | unknown[], string] {
+  const parentTokens = tokens.slice(0, -1);
+  const parent = getValue(document, parentTokens, `/${parentTokens.map(encodeToken).join("/")}`);
+  if (parent === null || typeof parent !== "object") {
+    throw new Error("JSON Patch path parent is not an object or array.");
+  }
+  return [parent as Record<string, unknown> | unknown[], tokens[tokens.length - 1]];
+}
+
+function getValue(document: unknown, tokens: string[], originalPointer: string): unknown {
+  let value = document;
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      value = value[arrayIndex(token, value.length, false)];
+    } else if (value !== null && typeof value === "object" && Object.hasOwn(value, token)) {
+      value = (value as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer does not resolve: ${originalPointer}`);
+    }
+  }
+  return value;
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error("A non-empty JSON Pointer must begin with '/'.");
+  }
+  return pointer.slice(1).split("/").map(decodeToken);
+}
+
+function requiredString(operation: Record<string, unknown>, member: string): string {
+  if (typeof operation[member] !== "string") {
+    throw new Error(`A JSON Patch operation requires a string '${member}' member.`);
+  }
+  return operation[member];
+}
+
+function requiredValue(operation: Record<string, unknown>): unknown {
+  if (!Object.hasOwn(operation, "value")) {
+    throw new Error("A JSON Patch operation requires a 'value' member.");
+  }
+  return operation.value;
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`Invalid JSON Pointer array index: ${token}`);
+  }
+  const index = Number(token);
+  if (!Number.isSafeInteger(index) || index > length || (!allowEnd && index === length)) {
+    throw new Error(`JSON Pointer array index is out of bounds: ${token}`);
+  }
+  return index;
+}
+
+function cloneJson(value: unknown, name: string, seen = new Set<object>()): unknown {
+  if (value === null || typeof value === "string" || typeof value === "boolean") {
+    return value;
+  }
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) {
+      throw new Error(`${name} must contain only JSON values.`);
+    }
+    return value;
+  }
+  if (typeof value !== "object" || seen.has(value)) {
+    throw new Error(`${name} must contain only JSON values.`);
+  }
+
+  seen.add(value);
+  if (Array.isArray(value)) {
+    const copy: unknown[] = [];
+    for (let index = 0; index < value.length; index += 1) {
+      if (!Object.hasOwn(value, index)) {
+        throw new Error(`${name} must contain only JSON values.`);
+      }
+      copy.push(cloneJson(value[index], name, seen));
+    }
+    seen.delete(value);
+    return copy;
+  }
+
+  if (Object.getPrototypeOf(value) !== Object.prototype && Object.getPrototypeOf(value) !== null) {
+    throw new Error(`${name} must contain only JSON values.`);
+  }
+  const copy: Record<string, unknown> = {};
+  for (const key of Object.keys(value)) {
+    defineJsonProperty(copy, key, cloneJson((value as Record<string, unknown>)[key], name, seen));
+  }
+  seen.delete(value);
+  return copy;
+}
+
+function jsonEqual(left: unknown, right: unknown): boolean {
+  if (left === right) {
+    return true;
+  }
+  if (left === null || right === null || typeof left !== "object" || typeof right !== "object") {
+    return false;
+  }
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return Array.isArray(left) && Array.isArray(right)
+      && left.length === right.length
+      && left.every((value, index) => jsonEqual(value, right[index]));
+  }
+  const leftKeys = Object.keys(left);
+  const rightKeys = Object.keys(right);
+  return leftKeys.length === rightKeys.length
+    && leftKeys.every((key) => Object.hasOwn(right, key) && jsonEqual(
+      (left as Record<string, unknown>)[key],
+      (right as Record<string, unknown>)[key],
+    ));
+}
+
+function defineJsonProperty(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, enumerable: true, configurable: true, writable: true });
+}
+
+function encodeToken(token: string): string {
+  return token.replaceAll("~", "~0").replaceAll("/", "~1");
+}
+
 function decodeToken(token: string): string {
   let decoded = "";
 
