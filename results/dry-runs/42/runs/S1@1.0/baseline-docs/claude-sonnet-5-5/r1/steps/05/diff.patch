index 0000000000000000000000000000000000000000..ed45a807aa318d2c00972ce6dfb873870f265f2f
--- /dev/null
+++ b/test/createPatch.test.ts
@@ -0,0 +1,74 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function assertRoundTrip(from: unknown, to: unknown): unknown[] {
+  const snapshot = structuredClone([from, to]);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual([from, to], snapshot);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(assertRoundTrip({ a: [1, { b: 2 }], c: "x" }, { c: "x", a: [1, { b: 2 }] }), []);
+});
+
+test("a small change gives a single operation", () => {
+  const from = { a: { b: 1, c: [1, 2, 3] }, d: "x" };
+  const to = { a: { b: 1, c: [1, 2, 4] }, d: "x" };
+  assert.deepEqual(assertRoundTrip(from, to), [{ op: "replace", path: "/a/c/2", value: 4 }]);
+});
+
+test("members are added and removed", () => {
+  assert.deepEqual(assertRoundTrip({ a: 1, b: 2 }, { b: 2, c: 3 }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("null values and type changes are handled", () => {
+  assertRoundTrip({ a: null, b: [1], c: { d: 1 } }, { a: 1, b: { x: 1 }, c: null });
+});
+
+test("root values of different kinds are replaced", () => {
+  assert.deepEqual(assertRoundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assertRoundTrip(1, 2);
+  assertRoundTrip(null, {});
+});
+
+test("keys with special characters are escaped", () => {
+  assert.deepEqual(assertRoundTrip({ "a/b": 1, "m~n": 1, "": 1 }, { "a/b": 2, "m~n": 2, "": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/m~0n", value: 2 },
+    { op: "replace", path: "/", value: 2 },
+  ]);
+});
+
+test("array insertions, deletions and appends stay minimal", () => {
+  assert.deepEqual(assertRoundTrip([1, 2, 3, 4], [1, 2, 3, 4, 5]), [{ op: "add", path: "/4", value: 5 }]);
+  assert.deepEqual(assertRoundTrip([1, 2, 3, 4], [1, 4]), [
+    { op: "remove", path: "/1" },
+    { op: "remove", path: "/1" },
+  ]);
+  assert.deepEqual(assertRoundTrip([1, 4], [1, 2, 3, 4]), [
+    { op: "add", path: "/1", value: 2 },
+    { op: "add", path: "/2", value: 3 },
+  ]);
+  assertRoundTrip([], [1, 2]);
+  assertRoundTrip([1, 2], []);
+  assertRoundTrip([[1], [2, 3]], [[1, 0], [3], 9]);
+});
+
+test("the patch shares no structure with the inputs", () => {
+  const to = { a: { b: [1] } };
+  const patch = createPatch({}, to);
+  (patch[0] as { value: { b: number[] } }).value.b.push(2);
+  assert.deepEqual(to, { a: { b: [1] } });
+});
+
+test("own member named __proto__ round-trips", () => {
+  const to = JSON.parse('{"__proto__": {"x": 1}}');
+  assertRoundTrip({}, to);
+  assertRoundTrip(to, JSON.parse('{"__proto__": {"x": 2}}'));
+});
