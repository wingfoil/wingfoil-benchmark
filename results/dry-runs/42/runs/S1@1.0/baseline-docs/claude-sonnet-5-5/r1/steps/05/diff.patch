@@ -48,3 +48,17 @@ applyMergePatch({ a: "b", c: 1 }, { a: null, d: 2 }); // { c: 1, d: 2 }
 - A non-object target is treated as an empty object when the patch is an object.
 - The input is never mutated and the result shares no structure with the target or the patch.
 - As in the RFC, a `null` cannot be set as a member value; use JSON Patch for that.
+
+## Creating a patch
+
+`createPatch(from, to)`, exported from `src/index.ts`, returns a JSON Patch (RFC 6902) that turns `from`
+into `to` when passed to `applyPatch`.
+
+```ts
+createPatch({ a: 1, b: [1, 2] }, { a: 1, b: [1, 3] }); // [{ op: "replace", path: "/b/1", value: 3 }]
+```
+
+- The patch describes only what changed: objects are compared member by member and arrays element by
+  element, after skipping their unchanged head and tail. Equal documents give an empty patch.
+- It emits `add`, `remove` and `replace` only; it does not detect moves or copies.
+- Object member order is irrelevant. The inputs are never mutated and the patch shares no structure with them.
diff --git a/src/index.ts b/src/index.ts
index 47005c4ee6d4ca9e42702c645b741a115ada74e3..a1cacb5007bceeb296ba06ee5b71d12455d103e0 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -246,3 +246,77 @@ function mergeInto(target: unknown, patch: Record<string, unknown>): Record<stri
 export function applyMergePatch(target: unknown, patch: unknown): unknown {
   return isObject(patch) ? mergeInto(target, patch) : structuredClone(patch);
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffObjects(from: Record<string, unknown>, to: Record<string, unknown>, path: string): PatchOperation[] {
+  const removed = Object.keys(from).filter((key) => !Object.hasOwn(to, key));
+  const operations: PatchOperation[] = removed.map((key) => ({ op: "remove", path: `${path}/${escapeToken(key)}` }));
+  for (const key of Object.keys(to)) {
+    const memberPath = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) {
+      operations.push(...diffValues(from[key], to[key], memberPath));
+    } else {
+      operations.push({ op: "add", path: memberPath, value: structuredClone(to[key]) });
+    }
+  }
+  return operations;
+}
+
+function commonLength(from: unknown[], to: unknown[], offset: number, limit: number, step: 1 | -1): number {
+  let length = 0;
+  while (length < limit) {
+    const i = step === 1 ? offset + length : from.length - 1 - length;
+    const j = step === 1 ? offset + length : to.length - 1 - length;
+    if (!deepEqual(from[i], to[j])) {
+      break;
+    }
+    length++;
+  }
+  return length;
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string): PatchOperation[] {
+  const shortest = Math.min(from.length, to.length);
+  const start = commonLength(from, to, 0, shortest, 1);
+  const end = commonLength(from, to, 0, shortest - start, -1);
+  const fromMiddle = from.length - start - end;
+  const toMiddle = to.length - start - end;
+  const operations: PatchOperation[] = [];
+  for (let i = 0; i < Math.min(fromMiddle, toMiddle); i++) {
+    operations.push(...diffValues(from[start + i], to[start + i], `${path}/${start + i}`));
+  }
+  for (let i = toMiddle; i < fromMiddle; i++) {
+    operations.push({ op: "remove", path: `${path}/${start + toMiddle}` });
+  }
+  for (let i = fromMiddle; i < toMiddle; i++) {
+    operations.push({ op: "add", path: `${path}/${start + i}`, value: structuredClone(to[start + i]) });
+  }
+  return operations;
+}
+
+function diffValues(from: unknown, to: unknown, path: string): PatchOperation[] {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    return diffArrays(from, to, path);
+  }
+  if (isObject(from) && isObject(to)) {
+    return diffObjects(from, to, path);
+  }
+  return deepEqual(from, to) ? [] : [{ op: "replace", path, value: structuredClone(to) }];
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when passed to `applyPatch`.
+ *
+ * The patch holds only what changed: objects are compared member by member, and arrays
+ * element by element after skipping the unchanged head and tail, so a small difference
+ * yields a small patch. Equal documents give an empty patch. Object member order is
+ * irrelevant, as in `applyPatch`'s `test`.
+ *
+ * The inputs are never mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  return diffValues(from, to, "");
+}
