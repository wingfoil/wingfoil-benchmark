@@ -0,0 +1,72 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { resolvePointer } from "../src/index.ts";
+
+// The example document and pointers of RFC 6901, section 5.
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("resolves the RFC 6901 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("decodes ~01 as ~1, not as /", () => {
+  assert.equal(resolvePointer({ "~1": "x", "~/": "y" }, "/~01"), "x");
+});
+
+test("resolves falsy values, including null", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer([false], "/0"), false);
+});
+
+test("rejects invalid pointers", () => {
+  for (const pointer of ["foo", "foo/bar", "/a~", "/a~2b", "#/a"]) {
+    assert.throws(() => resolvePointer({ a: 1 }, pointer), SyntaxError, pointer);
+  }
+  assert.throws(() => resolvePointer({}, undefined as unknown as string), TypeError);
+});
+
+test("rejects an invalid escape even when resolution fails earlier", () => {
+  assert.throws(() => resolvePointer({}, "/missing/~"), SyntaxError);
+});
+
+test("throws when the pointer does not resolve", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"), RangeError);
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"), RangeError);
+  assert.throws(() => resolvePointer(null, "/a"), RangeError);
+  assert.throws(() => resolvePointer("abc", "/0"), RangeError);
+});
+
+test("array tokens must be canonical in-range indexes", () => {
+  const doc = ["a", "b"];
+  for (const pointer of ["/2", "/-", "/-1", "/01", "/1.0", "/ 1", "/length", "/"]) {
+    assert.throws(() => resolvePointer(doc, pointer), RangeError, pointer);
+  }
+});
+
+test("only follows own members of objects", () => {
+  for (const pointer of ["/__proto__", "/constructor", "/toString"]) {
+    assert.throws(() => resolvePointer({}, pointer), RangeError, pointer);
+  }
+});
