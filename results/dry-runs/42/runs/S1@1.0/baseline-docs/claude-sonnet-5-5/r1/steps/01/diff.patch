index 0000000000000000000000000000000000000000..f631d4272a285c04aba10a77c70d6151049f9196
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,52 @@
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const INVALID_ESCAPE = /~(?![01])/;
+
+function unescapeToken(token: string): string {
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new TypeError("A JSON Pointer must be a string");
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new SyntaxError(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  if (INVALID_ESCAPE.test(pointer)) {
+    throw new SyntaxError(`Invalid JSON Pointer "${pointer}": "~" must be followed by "0" or "1"`);
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+function resolveToken(current: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(current)) {
+    if (ARRAY_INDEX.test(token) && Number(token) < current.length) {
+      return current[Number(token)];
+    }
+  } else if (typeof current === "object" && current !== null) {
+    if (Object.hasOwn(current, token)) {
+      return (current as Record<string, unknown>)[token];
+    }
+  }
+  throw new RangeError(`JSON Pointer "${pointer}" does not resolve to a value of the document`);
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer (RFC 6901) `pointer` refers to.
+ *
+ * The empty pointer refers to the whole document. Only own members of objects are
+ * followed, and the array token "-" never resolves since it names a nonexistent element.
+ *
+ * @throws SyntaxError when `pointer` is not a valid JSON Pointer.
+ * @throws TypeError when `pointer` is not a string.
+ * @throws RangeError when `pointer` does not resolve to a value of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  return parsePointer(pointer).reduce(
+    (current, token) => resolveToken(current, token, pointer),
+    document,
+  );
+}
