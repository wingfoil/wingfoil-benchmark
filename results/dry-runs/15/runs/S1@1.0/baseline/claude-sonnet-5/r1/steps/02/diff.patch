index 0000000000000000000000000000000000000000..a405a1ed6ea3693886560e18d5a6340eccba4262
--- /dev/null
+++ b/src/apply-patch.test.ts
@@ -0,0 +1,177 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch } from './index.ts';
+
+// Examples from RFC 6902, appendix A.
+
+test('A.1. Adding an Object Member', () => {
+  const doc = { foo: 'bar' };
+  const result = applyPatch(doc, [{ op: 'add', path: '/baz', value: 'qux' }]);
+  assert.deepEqual(result, { foo: 'bar', baz: 'qux' });
+});
+
+test('A.2. Adding an Array Element', () => {
+  const doc = { foo: ['bar', 'baz'] };
+  const result = applyPatch(doc, [{ op: 'add', path: '/foo/1', value: 'qux' }]);
+  assert.deepEqual(result, { foo: ['bar', 'qux', 'baz'] });
+});
+
+test('A.3. Removing an Object Member', () => {
+  const doc = { baz: 'qux', foo: 'bar' };
+  const result = applyPatch(doc, [{ op: 'remove', path: '/baz' }]);
+  assert.deepEqual(result, { foo: 'bar' });
+});
+
+test('A.4. Removing an Array Element', () => {
+  const doc = { foo: ['bar', 'qux', 'baz'] };
+  const result = applyPatch(doc, [{ op: 'remove', path: '/foo/1' }]);
+  assert.deepEqual(result, { foo: ['bar', 'baz'] });
+});
+
+test('A.5. Replacing a Value', () => {
+  const doc = { baz: 'qux', foo: 'bar' };
+  const result = applyPatch(doc, [{ op: 'replace', path: '/baz', value: 'boo' }]);
+  assert.deepEqual(result, { baz: 'boo', foo: 'bar' });
+});
+
+test('A.6. Moving a Value', () => {
+  const doc = { foo: { bar: 'baz', waldo: 'fred' }, qux: { corge: 'grault' } };
+  const result = applyPatch(doc, [{ op: 'move', from: '/foo/waldo', path: '/qux/thud' }]);
+  assert.deepEqual(result, { foo: { bar: 'baz' }, qux: { corge: 'grault', thud: 'fred' } });
+});
+
+test('A.7. Moving an Array Element', () => {
+  const doc = { foo: ['all', 'grass', 'cows', 'eat'] };
+  const result = applyPatch(doc, [{ op: 'move', from: '/foo/1', path: '/foo/3' }]);
+  assert.deepEqual(result, { foo: ['all', 'cows', 'eat', 'grass'] });
+});
+
+test('A.8. Testing a Value: Success', () => {
+  const doc = { baz: 'qux', foo: ['a', 2, 'c'] };
+  assert.doesNotThrow(() =>
+    applyPatch(doc, [
+      { op: 'test', path: '/baz', value: 'qux' },
+      { op: 'test', path: '/foo/1', value: 2 },
+    ]),
+  );
+});
+
+test('A.9. Testing a Value: Error', () => {
+  const doc = { baz: 'qux' };
+  assert.throws(() => applyPatch(doc, [{ op: 'test', path: '/baz', value: 'bar' }]));
+});
+
+test('A.10. Adding a Nested Member Object', () => {
+  const doc = { foo: 'bar' };
+  const result = applyPatch(doc, [{ op: 'add', path: '/child', value: { grandchild: {} } }]);
+  assert.deepEqual(result, { foo: 'bar', child: { grandchild: {} } });
+});
+
+test('A.11. Ignoring Unrecognized Elements', () => {
+  const doc = { foo: 'bar' };
+  const result = applyPatch(doc, [{ op: 'add', path: '/baz', value: 'qux', xyz: 123 }]);
+  assert.deepEqual(result, { foo: 'bar', baz: 'qux' });
+});
+
+test('A.12. Adding to a Nonexistent Target', () => {
+  const doc = { foo: 'bar' };
+  assert.throws(() => applyPatch(doc, [{ op: 'add', path: '/baz/bat', value: 'qux' }]));
+});
+
+test('A.14. ~ Escape Ordering', () => {
+  const doc = { '/': 9, '~1': 10 };
+  const result = applyPatch(doc, [{ op: 'test', path: '/~01', value: 10 }]);
+  assert.deepEqual(result, doc);
+});
+
+test('A.15. Comparing Strings and Numbers', () => {
+  const doc = { '/': 9, '~1': 10 };
+  assert.throws(() => applyPatch(doc, [{ op: 'test', path: '/~01', value: '10' }]));
+});
+
+test('A.16. Adding an Array Value', () => {
+  const doc = { foo: ['bar'] };
+  const result = applyPatch(doc, [{ op: 'add', path: '/foo/-', value: ['abc', 'def'] }]);
+  assert.deepEqual(result, { foo: ['bar', ['abc', 'def']] });
+});
+
+test('does not mutate the input document', () => {
+  const doc = { foo: { bar: [1, 2, 3] } };
+  const snapshot = structuredClone(doc);
+  applyPatch(doc, [
+    { op: 'add', path: '/foo/baz', value: 'qux' },
+    { op: 'replace', path: '/foo/bar/0', value: 99 },
+  ]);
+  assert.deepEqual(doc, snapshot);
+});
+
+test('does not mutate or alias values from the patch', () => {
+  const doc = {};
+  const value = { nested: [1, 2] };
+  const result = applyPatch(doc, [{ op: 'add', path: '/x', value }]) as any;
+  result.x.nested.push(3);
+  assert.deepEqual(value, { nested: [1, 2] });
+});
+
+test('copy duplicates rather than aliases', () => {
+  const doc = { a: { nested: [1, 2] }, b: {} };
+  const result = applyPatch(doc, [{ op: 'copy', from: '/a', path: '/b/copy' }]) as any;
+  result.b.copy.nested.push(3);
+  assert.deepEqual(result.a, { nested: [1, 2] });
+});
+
+test('move rejects moving a container into its own child', () => {
+  const doc = { a: { b: 1 } };
+  assert.throws(() => applyPatch(doc, [{ op: 'move', from: '/a', path: '/a/b' }]));
+});
+
+test('move to the same location is a no-op', () => {
+  const doc = { a: { b: 1 } };
+  const result = applyPatch(doc, [{ op: 'move', from: '/a', path: '/a' }]);
+  assert.deepEqual(result, doc);
+});
+
+test('replace requires the target to already exist', () => {
+  const doc = { a: 1 };
+  assert.throws(() => applyPatch(doc, [{ op: 'replace', path: '/b', value: 2 }]));
+});
+
+test('remove requires the target to exist', () => {
+  const doc = { a: 1 };
+  assert.throws(() => applyPatch(doc, [{ op: 'remove', path: '/b' }]));
+});
+
+test('add at root replaces the whole document', () => {
+  const doc = { a: 1 };
+  const result = applyPatch(doc, [{ op: 'add', path: '', value: { b: 2 } }]);
+  assert.deepEqual(result, { b: 2 });
+});
+
+test('test op deep-equals objects regardless of key order', () => {
+  const doc = { a: { x: 1, y: 2 } };
+  assert.doesNotThrow(() => applyPatch(doc, [{ op: 'test', path: '/a', value: { y: 2, x: 1 } }]));
+});
+
+test('throws when patch is not an array', () => {
+  assert.throws(() => applyPatch({}, { op: 'add', path: '/a', value: 1 }));
+});
+
+test('throws on unknown operation', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'frobnicate', path: '/a' }]));
+});
+
+test('throws when a required member is missing', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: '/a' }]));
+  assert.throws(() => applyPatch({}, [{ op: 'move', path: '/a' }]));
+  assert.throws(() => applyPatch({}, [{ op: 'test', path: '/a' }]));
+});
+
+test('applies multiple operations in order', () => {
+  const doc = { a: 1 };
+  const result = applyPatch(doc, [
+    { op: 'add', path: '/b', value: 2 },
+    { op: 'replace', path: '/a', value: 10 },
+    { op: 'remove', path: '/b' },
+  ]);
+  assert.deepEqual(result, { a: 10 });
+});
