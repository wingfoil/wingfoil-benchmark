   throw new Error(`JSON Pointer does not resolve to a value: cannot index into ${JSON.stringify(current)}`);
 }
+
+/** Parses `token` as an index into an existing element of `array` (no `-`, no trailing append). */
+function parseArrayIndex(array: unknown[], token: string): number {
+  if (!/^(?:0|[1-9][0-9]*)$/.test(token) || Number(token) >= array.length) {
+    throw new Error(`JSON Pointer does not resolve to a value: index ${JSON.stringify(token)} not found`);
+  }
+  return Number(token);
+}
+
+/** Parses `token` as an insertion point into `array`: an existing index, one past the end, or `-`. */
+function parseArrayInsertIndex(array: unknown[], token: string): number {
+  if (token === '-') {
+    return array.length;
+  }
+  if (!/^(?:0|[1-9][0-9]*)$/.test(token) || Number(token) > array.length) {
+    throw new Error(`JSON Pointer does not resolve to an insertion point: index ${JSON.stringify(token)} not found`);
+  }
+  return Number(token);
+}
+
+/**
+ * Describes one operation of a JSON Patch document (RFC 6902).
+ */
+export type JsonPatchOperation =
+  | { op: 'add'; path: string; value: unknown }
+  | { op: 'remove'; path: string }
+  | { op: 'replace'; path: string; value: unknown }
+  | { op: 'move'; path: string; from: string }
+  | { op: 'copy'; path: string; from: string }
+  | { op: 'test'; path: string; value: unknown };
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the resulting
+ * document as a new value. The input `document` and `patch` are not mutated.
+ *
+ * @throws Error if `patch` is not a well-formed JSON Patch document, or if
+ *   any of its operations fails (e.g. a path does not resolve, or a "test"
+ *   operation's value does not match).
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error('Invalid JSON Patch: patch must be an array of operations');
+  }
+
+  // A box lets the document root be addressed like any other container
+  // property, so "" (the root pointer) needs no special-casing below.
+  const box: { doc: unknown } = { doc: structuredClone(document) };
+
+  for (const rawOperation of patch) {
+    applyOperation(box, validateOperation(rawOperation));
+  }
+
+  return box.doc;
+}
+
+function validateOperation(raw: unknown): JsonPatchOperation {
+  if (raw === null || typeof raw !== 'object' || Array.isArray(raw)) {
+    throw new Error(`Invalid JSON Patch operation: ${JSON.stringify(raw)}`);
+  }
+  const candidate = raw as Record<string, unknown>;
+  if (typeof candidate.path !== 'string') {
+    throw new Error('Invalid JSON Patch operation: "path" must be a string');
+  }
+  const path = candidate.path;
+
+  switch (candidate.op) {
+    case 'add':
+    case 'replace':
+    case 'test':
+      if (!Object.prototype.hasOwnProperty.call(candidate, 'value')) {
+        throw new Error(`Invalid JSON Patch operation: "${candidate.op}" requires a "value" member`);
+      }
+      return { op: candidate.op, path, value: candidate.value };
+    case 'remove':
+      return { op: 'remove', path };
+    case 'move':
+    case 'copy':
+      if (typeof candidate.from !== 'string') {
+        throw new Error(`Invalid JSON Patch operation: "${candidate.op}" requires a "from" member`);
+      }
+      return { op: candidate.op, path, from: candidate.from };
+    default:
+      throw new Error(`Invalid JSON Patch operation: unknown "op" ${JSON.stringify(candidate.op)}`);
+  }
+}
+
+function applyOperation(box: { doc: unknown }, operation: JsonPatchOperation): void {
+  switch (operation.op) {
+    case 'add':
+      performAdd(box, operation.path, structuredClone(operation.value));
+      return;
+    case 'remove':
+      performRemove(box, operation.path);
+      return;
+    case 'replace':
+      performReplace(box, operation.path, structuredClone(operation.value));
+      return;
+    case 'move': {
+      if (isProperPrefix(operation.from, operation.path)) {
+        throw new Error(
+          `Invalid "move" operation: ${JSON.stringify(operation.path)} is inside ${JSON.stringify(operation.from)}`,
+        );
+      }
+      const value = performRemove(box, operation.from);
+      performAdd(box, operation.path, value);
+      return;
+    }
+    case 'copy': {
+      const value = structuredClone(resolvePointer(box.doc, operation.from));
+      performAdd(box, operation.path, value);
+      return;
+    }
+    case 'test':
+      if (!deepEqual(resolvePointer(box.doc, operation.path), operation.value)) {
+        throw new Error(`"test" operation failed at ${JSON.stringify(operation.path)}`);
+      }
+      return;
+  }
+}
+
+/** Whether `from` is a strict ancestor of `path`, i.e. `path` names a location inside `from`. */
+function isProperPrefix(from: string, path: string): boolean {
+  return path.length > from.length && path.startsWith(from) && path[from.length] === '/';
+}
+
+interface WriteTarget {
+  container: any;
+  key: string;
+  isArray: boolean;
+}
+
+function locateForWrite(box: { doc: unknown }, pointer: string): WriteTarget {
+  const tokens = splitPointer(pointer);
+  if (tokens.length === 0) {
+    return { container: box, key: 'doc', isArray: false };
+  }
+
+  let current: unknown = box.doc;
+  for (const token of tokens.slice(0, -1)) {
+    current = step(current, token);
+  }
+  const key = tokens[tokens.length - 1];
+
+  if (Array.isArray(current)) {
+    return { container: current, key, isArray: true };
+  }
+  if (current !== null && typeof current === 'object') {
+    return { container: current, key, isArray: false };
+  }
+  throw new Error(`JSON Pointer does not resolve to a container: cannot index into ${JSON.stringify(current)}`);
+}
+
+function performAdd(box: { doc: unknown }, pointer: string, value: unknown): void {
+  const { container, key, isArray } = locateForWrite(box, pointer);
+  if (isArray) {
+    container.splice(parseArrayInsertIndex(container, key), 0, value);
+    return;
+  }
+  container[key] = value;
+}
+
+function performReplace(box: { doc: unknown }, pointer: string, value: unknown): void {
+  const { container, key, isArray } = locateForWrite(box, pointer);
+  if (isArray) {
+    container[parseArrayIndex(container, key)] = value;
+    return;
+  }
+  if (!Object.prototype.hasOwnProperty.call(container, key)) {
+    throw new Error(`JSON Pointer does not resolve to a value: property ${JSON.stringify(key)} not found`);
+  }
+  container[key] = value;
+}
+
+function performRemove(box: { doc: unknown }, pointer: string): unknown {
+  const { container, key, isArray } = locateForWrite(box, pointer);
+  if (isArray) {
+    return container.splice(parseArrayIndex(container, key), 1)[0];
+  }
+  if (!Object.prototype.hasOwnProperty.call(container, key)) {
+    throw new Error(`JSON Pointer does not resolve to a value: property ${JSON.stringify(key)} not found`);
+  }
+  const value = container[key];
+  delete container[key];
+  return value;
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (Array.isArray(a) && Array.isArray(b)) {
+    return a.length === b.length && a.every((value, index) => deepEqual(value, b[index]));
+  }
+  if (isPlainObject(a) && isPlainObject(b)) {
+    const aKeys = Object.keys(a);
+    const bKeys = Object.keys(b);
+    return (
+      aKeys.length === bKeys.length &&
+      aKeys.every((key) => Object.prototype.hasOwnProperty.call(b, key) && deepEqual(a[key], b[key]))
+    );
+  }
+  return false;
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
