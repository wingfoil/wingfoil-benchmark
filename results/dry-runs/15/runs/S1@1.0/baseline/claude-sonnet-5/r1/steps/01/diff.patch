@@ -0,0 +1,45 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @throws Error if `pointer` is not a syntactically valid JSON Pointer, or if
+ *   it does not resolve to a value within `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (pointer === '') {
+    return document;
+  }
+  if (pointer[0] !== '/') {
+    throw new Error(`Invalid JSON Pointer: ${JSON.stringify(pointer)}`);
+  }
+
+  let current = document;
+  for (const rawToken of pointer.split('/').slice(1)) {
+    current = step(current, decodeToken(rawToken, pointer));
+  }
+  return current;
+}
+
+function decodeToken(rawToken: string, pointer: string): string {
+  if (/~(?![01])/.test(rawToken)) {
+    throw new Error(`Invalid JSON Pointer: ${JSON.stringify(pointer)}`);
+  }
+  return rawToken.replace(/~1/g, '/').replace(/~0/g, '~');
+}
+
+function step(current: unknown, token: string): unknown {
+  if (Array.isArray(current)) {
+    if (!/^(?:0|[1-9][0-9]*)$/.test(token) || Number(token) >= current.length) {
+      throw new Error(`JSON Pointer does not resolve to a value: index ${JSON.stringify(token)} not found`);
+    }
+    return current[Number(token)];
+  }
+
+  if (current !== null && typeof current === 'object') {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new Error(`JSON Pointer does not resolve to a value: property ${JSON.stringify(token)} not found`);
+    }
+    return (current as Record<string, unknown>)[token];
+  }
+
+  throw new Error(`JSON Pointer does not resolve to a value: cannot index into ${JSON.stringify(current)}`);
+}
