 }
+
+/**
+ * Computes a JSON Patch (RFC 6902) that turns `from` into `to` when applied
+ * via {@link applyPatch}. Neither `from` nor `to` is mutated. The patch
+ * contains only operations for parts of the document that actually differ.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const ops: JsonPatchOperation[] = [];
+  diffValues(from, to, '', ops);
+  return ops;
+}
+
+function diffValues(from: unknown, to: unknown, path: string, ops: JsonPatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (isPlainObject(from) && isPlainObject(to)) {
+    diffObjects(from, to, path, ops);
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+    return;
+  }
+  ops.push({ op: 'replace', path, value: structuredClone(to) });
+}
+
+function diffObjects(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  path: string,
+  ops: JsonPatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.prototype.hasOwnProperty.call(to, key)) {
+      ops.push({ op: 'remove', path: `${path}/${encodeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const childPath = `${path}/${encodeToken(key)}`;
+    if (!Object.prototype.hasOwnProperty.call(from, key)) {
+      ops.push({ op: 'add', path: childPath, value: structuredClone(to[key]) });
+    } else {
+      diffValues(from[key], to[key], childPath, ops);
+    }
+  }
+}
+
+type ArrayEdit = { type: 'equal' } | { type: 'delete'; fromIndex: number } | { type: 'insert'; toIndex: number };
+
+/** Longest-common-subsequence alignment of `from` and `to`, by element equality. */
+function computeArrayEdits(from: unknown[], to: unknown[]): ArrayEdit[] {
+  const n = from.length;
+  const m = to.length;
+  const lengths: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = 1; i <= n; i++) {
+    for (let j = 1; j <= m; j++) {
+      lengths[i][j] = deepEqual(from[i - 1], to[j - 1])
+        ? lengths[i - 1][j - 1] + 1
+        : Math.max(lengths[i - 1][j], lengths[i][j - 1]);
+    }
+  }
+
+  const edits: ArrayEdit[] = [];
+  let i = n;
+  let j = m;
+  while (i > 0 || j > 0) {
+    if (i > 0 && j > 0 && deepEqual(from[i - 1], to[j - 1]) && lengths[i][j] === lengths[i - 1][j - 1] + 1) {
+      edits.push({ type: 'equal' });
+      i--;
+      j--;
+    } else if (j > 0 && (i === 0 || lengths[i][j - 1] >= lengths[i - 1][j])) {
+      edits.push({ type: 'insert', toIndex: j - 1 });
+      j--;
+    } else {
+      edits.push({ type: 'delete', fromIndex: i - 1 });
+      i--;
+    }
+  }
+  return edits.reverse();
+}
+
+/**
+ * Diffs two arrays by aligning their common elements (see
+ * {@link computeArrayEdits}) and, for the runs of elements in between,
+ * pairing up same-position deletions and insertions as a nested "replace"
+ * rather than a wholesale "remove" plus "add".
+ */
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: JsonPatchOperation[]): void {
+  let cursor = 0;
+  let deletions: number[] = [];
+  let insertions: number[] = [];
+
+  const flushChangeBlock = (): void => {
+    const pairs = Math.min(deletions.length, insertions.length);
+    for (let k = 0; k < pairs; k++) {
+      diffValues(from[deletions[k]], to[insertions[k]], `${path}/${cursor}`, ops);
+      cursor++;
+    }
+    for (let k = pairs; k < deletions.length; k++) {
+      ops.push({ op: 'remove', path: `${path}/${cursor}` });
+    }
+    for (let k = pairs; k < insertions.length; k++) {
+      ops.push({ op: 'add', path: `${path}/${cursor}`, value: structuredClone(to[insertions[k]]) });
+      cursor++;
+    }
+    deletions = [];
+    insertions = [];
+  };
+
+  for (const edit of computeArrayEdits(from, to)) {
+    if (edit.type === 'equal') {
+      flushChangeBlock();
+      cursor++;
+    } else if (edit.type === 'delete') {
+      deletions.push(edit.fromIndex);
+    } else {
+      insertions.push(edit.toIndex);
+    }
+  }
+  flushChangeBlock();
+}
