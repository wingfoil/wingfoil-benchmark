@@ -0,0 +1,98 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch, createPatch } from './index.ts';
+
+/** Asserts that the patch from `from` to `to` actually produces `to`. */
+function assertRoundTrips(from: unknown, to: unknown): ReturnType<typeof createPatch> {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test('identical documents produce an empty patch', () => {
+  assert.deepEqual(createPatch({ a: 1, b: [1, 2] }, { a: 1, b: [1, 2] }), []);
+});
+
+test('changing a scalar property produces a single replace', () => {
+  const patch = assertRoundTrips({ a: 1, b: 2 }, { a: 1, b: 3 });
+  assert.deepEqual(patch, [{ op: 'replace', path: '/b', value: 3 }]);
+});
+
+test('adding a property produces a single add', () => {
+  const patch = assertRoundTrips({ a: 1 }, { a: 1, b: 2 });
+  assert.deepEqual(patch, [{ op: 'add', path: '/b', value: 2 }]);
+});
+
+test('removing a property produces a single remove', () => {
+  const patch = assertRoundTrips({ a: 1, b: 2 }, { a: 1 });
+  assert.deepEqual(patch, [{ op: 'remove', path: '/b' }]);
+});
+
+test('changing a deeply nested value produces a single nested replace', () => {
+  const from = { a: { b: { c: 1, keep: 'x' } } };
+  const to = { a: { b: { c: 2, keep: 'x' } } };
+  const patch = assertRoundTrips(from, to);
+  assert.deepEqual(patch, [{ op: 'replace', path: '/a/b/c', value: 2 }]);
+});
+
+test('appending an array element produces a single add', () => {
+  const patch = assertRoundTrips([1, 2, 3], [1, 2, 3, 4]);
+  assert.deepEqual(patch, [{ op: 'add', path: '/3', value: 4 }]);
+});
+
+test('prepending an array element produces a single add, not a cascade of replaces', () => {
+  const patch = assertRoundTrips([1, 2, 3], [0, 1, 2, 3]);
+  assert.deepEqual(patch, [{ op: 'add', path: '/0', value: 0 }]);
+});
+
+test('removing a middle array element produces a single remove', () => {
+  const patch = assertRoundTrips([1, 2, 3], [1, 3]);
+  assert.deepEqual(patch, [{ op: 'remove', path: '/1' }]);
+});
+
+test('changing a middle array element produces a single replace', () => {
+  const patch = assertRoundTrips([1, 2, 3], [1, 99, 3]);
+  assert.deepEqual(patch, [{ op: 'replace', path: '/1', value: 99 }]);
+});
+
+test('changing a field of an object inside an array produces a nested replace', () => {
+  const from = { items: [{ id: 1, name: 'a' }, { id: 2, name: 'b' }] };
+  const to = { items: [{ id: 1, name: 'a' }, { id: 2, name: 'changed' }] };
+  const patch = assertRoundTrips(from, to);
+  assert.deepEqual(patch, [{ op: 'replace', path: '/items/1/name', value: 'changed' }]);
+});
+
+test('empty array to non-empty and back round-trip', () => {
+  assertRoundTrips({ a: [] }, { a: [1, 2, 3] });
+  assertRoundTrips({ a: [1, 2, 3] }, { a: [] });
+});
+
+test('replacing an array with a scalar produces a single replace', () => {
+  const patch = assertRoundTrips({ a: [1, 2] }, { a: 'scalar' });
+  assert.deepEqual(patch, [{ op: 'replace', path: '/a', value: 'scalar' }]);
+});
+
+test('does not mutate either input', () => {
+  const from = { a: 1, b: [1, 2, 3] };
+  const to = { a: 2, b: [1, 2, 3, 4] };
+  const fromSnapshot = structuredClone(from);
+  const toSnapshot = structuredClone(to);
+
+  createPatch(from, to);
+
+  assert.deepEqual(from, fromSnapshot);
+  assert.deepEqual(to, toSnapshot);
+});
+
+test('does not alias values from "to" into the patch', () => {
+  const to = { a: { nested: [1, 2] } };
+  const patch = createPatch({}, to) as any;
+  patch[0].value.nested.push(3);
+  assert.deepEqual(to.a.nested, [1, 2]);
+});
+
+test('combination of additions, removals and replacements', () => {
+  const from = { a: 1, b: 2, c: [1, 2, 3] };
+  const to = { a: 1, c: [1, 99, 3], d: 4 };
+  assertRoundTrips(from, to);
+});
