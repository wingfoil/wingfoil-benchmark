+/**
+ * Creates JSON Patch documents (RFC 6902) that describe the differences between two versions of a
+ * JSON document, so that clients can send what changed instead of the whole new version.
+ */
+
+import type { PatchOperation } from "./json-patch.ts";
+import type { JsonValue } from "./json-pointer.ts";
+import { cloneValue, isJsonValue, isPlainObject, jsonEqual } from "./json-value.ts";
+
+type JsonObject = { [key: string]: JsonValue };
+
+/** One step of the alignment of two arrays: an element kept, removed from `from`, or inserted from `to`. */
+type Edit = "keep" | "delete" | "insert";
+
+/**
+ * Beyond this many removed and inserted elements, two arrays are compared position by position rather
+ * than aligned, which bounds the time and memory spent on arrays that have little in common.
+ */
+const MAX_ARRAY_EDITS = 1000;
+
+/** Raised when a document given to `createPatch` is not a JSON value. */
+export class InvalidDocumentError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = new.target.name;
+  }
+}
+
+/**
+ * Creates a JSON Patch that turns one JSON document into another.
+ *
+ * The patch only touches what differs: unchanged members and array elements are left out, a changed
+ * member is patched where it changed, and array elements are aligned so that an insertion or removal
+ * does not rewrite the elements after it. Where rewriting a value whole is shorter than patching its
+ * parts, it is replaced in a single operation. The patch uses `add`, `remove` and `replace` only.
+ *
+ * @param from - The original document.
+ * @param to - The new document.
+ * @returns A patch that `applyPatch` turns `from` into `to` with; empty when they are equal. It
+ *   shares no value with `from` or `to`, and neither is modified.
+ * @throws {InvalidDocumentError} When `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  for (const [name, document] of [["from", from], ["to", to]] as const) {
+    if (!isJsonValue(document)) {
+      throw new InvalidDocumentError(`"${name}" is not a JSON value`);
+    }
+  }
+  return diff(from, to, "");
+}
+
+// Patches the parts of a value when both versions are containers of the same kind, unless one
+// replace operation is shorter once serialized.
+function diff(from: JsonValue, to: JsonValue, path: string): PatchOperation[] {
+  if (jsonEqual(from, to)) {
+    return [];
+  }
+  const parts = diffContainers(from, to, path);
+  if (parts !== undefined && serializedLength(parts) < serializedLength([{ op: "replace", path, value: to }])) {
+    return parts;
+  }
+  return [{ op: "replace", path, value: cloneValue(to) }];
+}
+
+function diffContainers(from: JsonValue, to: JsonValue, path: string): PatchOperation[] | undefined {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    return diffArrays(from, to, path);
+  }
+  if (isPlainObject(from) && isPlainObject(to)) {
+    return diffObjects(from as JsonObject, to as JsonObject, path);
+  }
+  return undefined;
+}
+
+function diffObjects(from: JsonObject, to: JsonObject, path: string): PatchOperation[] {
+  const operations: PatchOperation[] = [];
+  for (const key of Object.keys(from)) {
+    const memberPath = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(to, key)) {
+      operations.push(...diff(from[key], to[key], memberPath));
+    } else {
+      operations.push({ op: "remove", path: memberPath });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (!Object.hasOwn(from, key)) {
+      operations.push({ op: "add", path: `${path}/${escapeToken(key)}`, value: cloneValue(to[key]) });
+    }
+  }
+  return operations;
+}
+
+// Walks the alignment of the two arrays. The elements before `index` already match `to`, so an index
+// into `to` is also the index into the array as patched so far.
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string): PatchOperation[] {
+  const operations: PatchOperation[] = [];
+  let removed: JsonValue[] = [];
+  let inserted: JsonValue[] = [];
+  let index = 0;
+  let fromIndex = 0;
+  for (const edit of alignArrays(from, to)) {
+    if (edit === "delete") {
+      removed.push(from[fromIndex++]);
+      continue;
+    }
+    if (edit === "insert") {
+      inserted.push(to[index + inserted.length]);
+      continue;
+    }
+    operations.push(...diffGap(removed, inserted, path, index));
+    index += inserted.length + 1;
+    fromIndex++;
+    removed = [];
+    inserted = [];
+  }
+  operations.push(...diffGap(removed, inserted, path, index));
+  return operations;
+}
+
+// Turns a run of removed elements and a run of inserted ones, at the same position, into operations:
+// the elements are paired off and patched in place, then the surplus is removed or added.
+function diffGap(removed: JsonValue[], inserted: JsonValue[], path: string, index: number): PatchOperation[] {
+  const paired = Math.min(removed.length, inserted.length);
+  const operations: PatchOperation[] = [];
+  for (let offset = 0; offset < paired; offset++) {
+    operations.push(...diff(removed[offset], inserted[offset], `${path}/${index + offset}`));
+  }
+  for (let offset = paired; offset < removed.length; offset++) {
+    operations.push({ op: "remove", path: `${path}/${index + paired}` });
+  }
+  for (let offset = paired; offset < inserted.length; offset++) {
+    operations.push({ op: "add", path: `${path}/${index + offset}`, value: cloneValue(inserted[offset]) });
+  }
+  return operations;
+}
+
+// The shortest edit script of Myers' "An O(ND) Difference Algorithm and Its Variations" (1986), so
+// that the elements the two arrays have in common are kept wherever they are. When more than
+// MAX_ARRAY_EDITS edits are needed, every element is removed and inserted, which diffGap then pairs
+// position by position.
+function alignArrays(from: JsonValue[], to: JsonValue[]): Edit[] {
+  const trace = furthestPaths(from, to);
+  if (trace === undefined) {
+    return [...Array<Edit>(from.length).fill("delete"), ...Array<Edit>(to.length).fill("insert")];
+  }
+  return backtrack(trace, from.length, to.length);
+}
+
+// trace[d][k + d] is the furthest x reached on diagonal k = x - y with d edits, where x indexes `from`
+// and y indexes `to`. Returns undefined when the arrays need more than MAX_ARRAY_EDITS edits.
+function furthestPaths(from: JsonValue[], to: JsonValue[]): number[][] | undefined {
+  const trace: number[][] = [];
+  const limit = Math.min(from.length + to.length, MAX_ARRAY_EDITS);
+  for (let d = 0; d <= limit; d++) {
+    const previous = trace[d - 1];
+    const furthest: number[] = [];
+    for (let k = -d; k <= d; k += 2) {
+      let x = d === 0 ? 0 : startOfDiagonal(previous, d, k);
+      while (x < from.length && x - k < to.length && jsonEqual(from[x], to[x - k])) {
+        x++;
+      }
+      furthest.push(x);
+      if (x >= from.length && x - k >= to.length) {
+        trace.push(furthest);
+        return trace;
+      }
+    }
+    trace.push(furthest);
+  }
+  return undefined;
+}
+
+// With d edits, diagonal k is reached by an insertion from diagonal k + 1 or a deletion from k - 1.
+function startOfDiagonal(previous: number[], d: number, k: number): number {
+  return comesFromInsertion(previous, d, k) ? at(previous, d - 1, k + 1) : at(previous, d - 1, k - 1) + 1;
+}
+
+function comesFromInsertion(previous: number[], d: number, k: number): boolean {
+  return k === -d || (k !== d && at(previous, d - 1, k - 1) < at(previous, d - 1, k + 1));
+}
+
+// Reads diagonal k from the d-edit row of the trace, which holds diagonals -d, -d + 2, ..., d.
+function at(row: number[], d: number, k: number): number {
+  return row[(k + d) / 2];
+}
+
+function backtrack(trace: number[][], fromLength: number, toLength: number): Edit[] {
+  const edits: Edit[] = [];
+  let x = fromLength;
+  let y = toLength;
+  for (let d = trace.length - 1; d > 0; d--) {
+    const k = x - y;
+    const insertion = comesFromInsertion(trace[d - 1], d, k);
+    const previousK = insertion ? k + 1 : k - 1;
+    const previousX = at(trace[d - 1], d - 1, previousK);
+    const previousY = previousX - previousK;
+    for (; x > previousX && y > previousY; x--, y--) {
+      edits.push("keep");
+    }
+    edits.push(insertion ? "insert" : "delete");
+    x = previousX;
+    y = previousY;
+  }
+  for (; x > 0; x--) {
+    edits.push("keep");
+  }
+  return edits.reverse();
+}
+
+// RFC 6901, section 3: "~" is escaped before "/", so that "/" does not become "~01".
+function escapeToken(token: string): string {
+  return token.replaceAll("~", "~0").replaceAll("/", "~1");
+}
+
+function serializedLength(operations: PatchOperation[]): number {
+  return JSON.stringify(operations).length;
+}
