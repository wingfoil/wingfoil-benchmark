+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { InvalidDocumentError, applyPatch, createPatch } from "../src/index.ts";
+import type { JsonValue } from "../src/index.ts";
+
+// Checks that the patch turns `from` into `to`, and returns it for closer inspection.
+function roundTrip(from: JsonValue, to: JsonValue) {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+// An unchanged value long enough that resending it costs more than patching around it.
+const filler = "an unchanged value, long enough to be worth leaving out of the patch";
+
+describe("createPatch", () => {
+  describe("equal documents", () => {
+    const documents: JsonValue[] = [null, 0, "a", true, [], {}, { a: [1, { b: null }] }];
+    for (const document of documents) {
+      it(`returns an empty patch for ${JSON.stringify(document)}`, () => {
+        assert.deepEqual(createPatch(document, structuredClone(document)), []);
+      });
+    }
+
+    it("ignores the order of object members", () => {
+      assert.deepEqual(createPatch({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+    });
+  });
+
+  describe("objects", () => {
+    it("adds a new member", () => {
+      assert.deepEqual(roundTrip({ a: 1 }, { a: 1, b: 2 }), [{ op: "add", path: "/b", value: 2 }]);
+    });
+
+    it("removes a missing member", () => {
+      assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1 }), [{ op: "remove", path: "/b" }]);
+    });
+
+    it("replaces a changed member", () => {
+      assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1, b: 3 }), [{ op: "replace", path: "/b", value: 3 }]);
+    });
+
+    it("sets a member to null", () => {
+      assert.deepEqual(roundTrip({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+    });
+
+    it("changes only the nested member that differs", () => {
+      const from = { servers: { a: { host: "a.example", port: 80 }, b: { host: "b.example", port: 80 } } };
+      const to = { servers: { a: { host: "a.example", port: 80 }, b: { host: "b.example", port: 443 } } };
+      assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/servers/b/port", value: 443 }]);
+    });
+
+    it("escapes member names in paths", () => {
+      assert.deepEqual(roundTrip({ "a/b": 1, "c~d": 1, filler }, { "a/b": 2, "c~d": 2, filler }), [
+        { op: "replace", path: "/a~1b", value: 2 },
+        { op: "replace", path: "/c~0d", value: 2 },
+      ]);
+    });
+
+    it("handles the empty member name", () => {
+      assert.deepEqual(roundTrip({ "": 1 }, { "": 2 }), [{ op: "replace", path: "/", value: 2 }]);
+    });
+
+    it("treats members named __proto__ as ordinary members", () => {
+      const from = JSON.parse(`{"__proto__": {"a": 1, "filler": "${filler}"}}`);
+      const to = JSON.parse(`{"__proto__": {"a": 2, "filler": "${filler}"}, "constructor": 1}`);
+      assert.deepEqual(roundTrip(from, to), [
+        { op: "replace", path: "/__proto__/a", value: 2 },
+        { op: "add", path: "/constructor", value: 1 },
+      ]);
+    });
+
+    it("replaces an object whose members all change with one operation", () => {
+      assert.deepEqual(roundTrip({ a: { x: 1, y: 2 } }, { a: { z: 3 } }), [{ op: "replace", path: "/a", value: { z: 3 } }]);
+    });
+  });
+
+  describe("arrays", () => {
+    it("inserts an element in the middle", () => {
+      assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+    });
+
+    it("appends an element", () => {
+      assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+    });
+
+    it("removes an element", () => {
+      assert.deepEqual(roundTrip(["a", "b", "c"], ["a", "c"]), [{ op: "remove", path: "/1" }]);
+    });
+
+    it("removes consecutive elements", () => {
+      assert.deepEqual(roundTrip([filler, 2, 3, 4, filler], [filler, filler]), [
+        { op: "remove", path: "/1" },
+        { op: "remove", path: "/1" },
+        { op: "remove", path: "/1" },
+      ]);
+    });
+
+    it("changes only the nested member of the element that differs", () => {
+      const from = { items: [{ id: 1, qty: 1 }, { id: 2, qty: 1 }, { id: 3, qty: 1 }] };
+      const to = { items: [{ id: 1, qty: 1 }, { id: 2, qty: 5 }, { id: 3, qty: 1 }] };
+      assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/items/1/qty", value: 5 }]);
+    });
+
+    it("keeps the elements common to both versions, wherever they are", () => {
+      assert.deepEqual(roundTrip(["a", filler, "c", "d", filler], ["x", filler, "c", "y", filler, "z"]), [
+        { op: "replace", path: "/0", value: "x" },
+        { op: "replace", path: "/3", value: "y" },
+        { op: "add", path: "/5", value: "z" },
+      ]);
+    });
+
+    it("handles insertions and removals in the same array", () => {
+      const cases: Array<[JsonValue[], JsonValue[]]> = [
+        [[1, 2, 3], [0, 1, 3, 4]],
+        [[1, 2, 3, 4, 5, 6], [6, 5, 4, 3, 2, 1]],
+        [["a", "b", "a", "b"], ["b", "a", "b", "a"]],
+        [[{ a: 1 }, { b: 2 }], [{ b: 2 }, { a: 1 }, { c: 3 }]],
+        [[1, 2, 3], []],
+        [[], [1, 2, 3]],
+      ];
+      for (const [from, to] of cases) {
+        roundTrip(from, to);
+      }
+    });
+
+    it("handles long arrays", () => {
+      const from = Array.from({ length: 5000 }, (_, index) => index);
