+
+  describe("test", () => {
+    const document: JsonValue = { obj: { a: 1, b: [true, null, "s"] }, n: 1, z: 0 };
+
+    it("compares objects regardless of member order", () => {
+      const patch = [{ op: "test", path: "/obj", value: { b: [true, null, "s"], a: 1 } }];
+      assert.deepEqual(applyPatch(document, patch), document);
+    });
+
+    it("compares numbers by value", () => {
