+
+    it("rejects a missing from location", () => {
+      assert.throws(() => applyPatch({}, [{ op: "move", from: "/a", path: "/b" }]), PatchConflictError);
+    });
+  });
+
+  describe("copy", () => {
+    it("copies a value without sharing it", () => {
+      const patch = [
+        { op: "copy", from: "/a", path: "/b" },
+        { op: "add", path: "/b/x", value: 2 },
