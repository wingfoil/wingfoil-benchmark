+      assert.ok(error.cause instanceof Error);
+    });
+  });
+});
+
+function captureError(action: () => unknown): JsonPatchError {
+  try {
+    action();
+  } catch (error) {
+    if (error instanceof JsonPatchError) {
+      return error;
+    }
+    throw error;
+  }
+  assert.fail("expected an error to be thrown");
+}
