index 0000000000000000000000000000000000000000..7576e2cbaaf7e533d064a5c58c49fd85299f3b3b
--- /dev/null
+++ b/src/json-patch.ts
@@ -0,0 +1,306 @@
+/**
+ * JSON Patch, as specified by RFC 6902: a sequence of operations (add, remove, replace, move, copy
+ * and test) that change a JSON document, each addressing its target with a JSON Pointer.
+ */
+
+import { JsonPointerError, isArrayIndex, parsePointer, resolvePointer } from "./json-pointer.ts";
+import type { JsonValue } from "./json-pointer.ts";
+
+/** One JSON Patch operation, once validated (RFC 6902, section 4). */
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; from: string; path: string };
+
+/** Base class of every error raised while applying a JSON Patch. */
+export class JsonPatchError extends Error {
+  /** The position of the failing operation in the patch; `undefined` when the patch is not an array. */
+  readonly index: number | undefined;
+  /** The failing operation, as given in the patch. */
+  readonly operation: unknown;
+
+  constructor(message: string, index?: number, operation?: unknown, options?: ErrorOptions) {
+    super(message, options);
+    this.name = new.target.name;
+    this.index = index;
+    this.operation = operation;
+  }
+}
+
+/** Raised when the patch does not follow RFC 6902 (sections 3 and 4): nothing is applied. */
+export class InvalidPatchError extends JsonPatchError {}
+
+/** Raised when an operation cannot be applied to the document, such as when its target does not exist. */
+export class PatchConflictError extends JsonPatchError {}
+
+/** Raised when a `test` operation finds a value that differs from the expected one. */
+export class PatchTestFailedError extends JsonPatchError {}
+
+type Container = JsonValue[] | { [key: string]: JsonValue };
+
+/**
+ * Applies a JSON Patch to a JSON document.
+ *
+ * The whole patch is validated before any operation runs, then the operations are applied in order
+ * to a copy of `document`. The result shares no value with `document` or `patch`, and neither is
+ * modified, so a failing patch leaves nothing half-applied.
+ *
+ * @param document - The JSON document to patch.
+ * @param patch - The JSON Patch: an array of operation objects, typically parsed from JSON.
+ * @returns The patched document, as a new value.
+ * @throws {InvalidPatchError} When `patch` is not a valid JSON Patch.
+ * @throws {PatchConflictError} When an operation's `path` or `from` does not fit the document.
+ * @throws {PatchTestFailedError} When a `test` operation fails.
+ */
+export function applyPatch(document: JsonValue, patch: unknown): JsonValue {
+  const operations = validatePatch(patch);
+  let result = cloneValue(document);
+  operations.forEach((operation, index) => {
+    try {
+      result = applyOperation(result, operation);
+    } catch (error) {
+      throw withOperation(error, index, (patch as unknown[])[index]);
+    }
+  });
+  return result;
+}
+
+function validatePatch(patch: unknown): PatchOperation[] {
+  if (!Array.isArray(patch)) {
+    throw new InvalidPatchError("JSON Patch must be an array of operations");
+  }
+  return patch.map((operation: unknown, index) => {
+    try {
+      return validateOperation(operation);
+    } catch (error) {
+      throw withOperation(error, index, operation);
+    }
+  });
+}
+
+function validateOperation(operation: unknown): PatchOperation {
+  if (!isPlainObject(operation)) {
+    throw new InvalidPatchError("operation must be an object");
+  }
+  const op = operation.op;
+  const path = memberPointer(operation, "path");
+  switch (op) {
+    case "remove":
+      return { op, path };
+    case "add":
+    case "replace":
+    case "test":
+      return { op, path, value: memberValue(operation) };
+    case "move":
+    case "copy":
+      return { op, path, from: memberFrom(operation, op, path) };
+    default:
+      throw new InvalidPatchError(`unknown operation ${JSON.stringify(op)}`);
+  }
+}
+
+function memberPointer(operation: Record<string, unknown>, member: "path" | "from"): string {
+  const pointer = operation[member];
+  if (typeof pointer !== "string") {
+    throw new InvalidPatchError(`operation must have a "${member}" string`);
+  }
+  try {
+    parsePointer(pointer);
+  } catch (error) {
+    throw new InvalidPatchError(`"${member}" is not a valid JSON Pointer: ${JSON.stringify(pointer)}`, undefined, undefined, {
+      cause: error,
+    });
+  }
+  return pointer;
+}
+
+// RFC 6902, section 4.4: a value cannot be moved into one of its own children.
+function memberFrom(operation: Record<string, unknown>, op: "move" | "copy", path: string): string {
+  const from = memberPointer(operation, "from");
+  if (op === "move" && path.startsWith(`${from}/`)) {
+    throw new InvalidPatchError(`cannot move ${JSON.stringify(from)} into its own child ${JSON.stringify(path)}`);
+  }
+  return from;
+}
+
+function memberValue(operation: Record<string, unknown>): JsonValue {
+  if (!Object.hasOwn(operation, "value")) {
+    throw new InvalidPatchError('operation must have a "value" member');
+  }
+  if (!isJsonValue(operation.value)) {
+    throw new InvalidPatchError('"value" is not a JSON value');
+  }
+  return operation.value;
+}
+
+function applyOperation(document: JsonValue, operation: PatchOperation): JsonValue {
+  switch (operation.op) {
+    case "add":
+      return add(document, operation.path, cloneValue(operation.value));
+    case "remove":
+      remove(document, operation.path);
+      return document;
+    case "replace":
+      return replace(document, operation.path, cloneValue(operation.value));
+    case "move":
+      return move(document, operation.from, operation.path);
+    case "copy":
+      return add(document, operation.path, cloneValue(resolvePointer(document, operation.from)));
+    case "test":
+      test(document, operation.path, operation.value);
+      return document;
+  }
+}
+
+function add(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  if (path === "") {
+    return value;
+  }
+  const { parent, token } = locate(document, path);
+  if (!Array.isArray(parent)) {
+    setMember(parent, token, value);
+  } else if (token === "-") {
+    parent.push(value);
+  } else {
+    parent.splice(arrayIndex(parent, token, path), 0, value);
+  }
+  return document;
+}
+
+function remove(document: JsonValue, path: string): JsonValue {
+  if (path === "") {
+    throw new PatchConflictError("cannot remove the whole document");
+  }
+  const removed = resolvePointer(document, path);
+  const { parent, token } = locate(document, path);
+  if (Array.isArray(parent)) {
+    parent.splice(Number(token), 1);
+  } else {
+    delete parent[token];
+  }
+  return removed;
+}
+
+function replace(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  resolvePointer(document, path);
+  if (path === "") {
+    return value;
+  }
+  const { parent, token } = locate(document, path);
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else {
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+function move(document: JsonValue, from: string, path: string): JsonValue {
+  if (from === path) {
+    resolvePointer(document, from);
+    return document;
+  }
+  return add(document, path, remove(document, from));
+}
+
+function test(document: JsonValue, path: string, expected: JsonValue): void {
+  if (!jsonEqual(resolvePointer(document, path), expected)) {
+    throw new PatchTestFailedError(`test failed: the value at ${JSON.stringify(path)} differs from the expected value`);
+  }
+}
+
+// Finds the container that holds the target of a non-empty path, and the target's token within it.
+function locate(document: JsonValue, path: string): { parent: Container; token: string } {
+  const parent = resolvePointer(document, path.slice(0, path.lastIndexOf("/")));
+  if (parent === null || typeof parent !== "object") {
+    throw new PatchConflictError(`the parent of ${JSON.stringify(path)} is not an object or an array`);
+  }
+  return { parent, token: parsePointer(path).at(-1) as string };
+}
+
+// The index may equal the array's length: inserting there appends.
+function arrayIndex(array: JsonValue[], token: string, path: string): number {
+  const index = isArrayIndex(token) ? Number(token) : Number.NaN;
+  if (index <= array.length) {
+    return index;
+  }
+  throw new PatchConflictError(`${JSON.stringify(path)} is not a valid index into an array of length ${array.length}`);
+}
+
+// Defining the property, rather than assigning it, keeps a "__proto__" member an own property.
+function setMember(object: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+// RFC 6902, section 4.6: equal types and values; object members compared regardless of order.
+function jsonEqual(left: JsonValue, right: JsonValue): boolean {
+  if (left === null || right === null || typeof left !== "object" || typeof right !== "object") {
+    return left === right;
+  }
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return (
+      Array.isArray(left) &&
+      Array.isArray(right) &&
+      left.length === right.length &&
+      left.every((item, index) => jsonEqual(item, right[index]))
+    );
+  }
+  const keys = Object.keys(left);
+  return (
+    keys.length === Object.keys(right).length &&
+    keys.every((key) => Object.hasOwn(right, key) && jsonEqual(left[key], right[key]))
+  );
+}
+
+function cloneValue(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(cloneValue);
+  }
+  if (value === null || typeof value !== "object") {
+    return value;
+  }
+  const clone: { [key: string]: JsonValue } = {};
+  for (const [key, member] of Object.entries(value)) {
+    setMember(clone, key, cloneValue(member));
+  }
+  return clone;
+}
+
+function isJsonValue(value: unknown): value is JsonValue {
+  switch (typeof value) {
+    case "string":
+    case "boolean":
+      return true;
+    case "number":
+      return Number.isFinite(value);
+    case "object":
+      if (value === null) {
+        return true;
+      }
+      if (Array.isArray(value)) {
+        return value.every(isJsonValue);
+      }
+      return isPlainObject(value) && Object.values(value).every(isJsonValue);
+    default:
+      return false;
+  }
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  if (value === null || typeof value !== "object" || Array.isArray(value)) {
+    return false;
+  }
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
+
+// Pointer errors become conflicts; every error is tagged with the operation that raised it.
+function withOperation(error: unknown, index: number, operation: unknown): JsonPatchError {
+  if (error instanceof JsonPatchError) {
+    return new (error.constructor as typeof JsonPatchError)(error.message, index, operation, { cause: error.cause });
+  }
+  if (error instanceof JsonPointerError) {
+    return new PatchConflictError(error.message, index, operation, { cause: error });
+  }
+  throw error;
+}
