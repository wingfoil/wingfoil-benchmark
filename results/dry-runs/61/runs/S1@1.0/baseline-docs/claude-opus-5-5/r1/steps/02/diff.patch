+/**
+ * Tells whether a reference token is an array index: `"0"` or digits without a leading zero
+ * (RFC 6901, section 4). The token `"-"` is not an index.
+ *
+ * @param token - An unescaped reference token.
+ * @returns `true` when `token` can index an array.
+ */
+export function isArrayIndex(token: string): boolean {
+  return ARRAY_INDEX.test(token);
+}
+
