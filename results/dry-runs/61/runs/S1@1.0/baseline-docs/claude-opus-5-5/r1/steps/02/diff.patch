diff --git a/test/json-patch.test.ts b/test/json-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4fea3ec8a88c49ebbcc84f97a25b993ebb73d2e3
--- /dev/null
+++ b/test/json-patch.test.ts
@@ -0,0 +1,335 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import {
+  InvalidPatchError,
+  JsonPatchError,
+  PatchConflictError,
+  PatchTestFailedError,
+  applyPatch,
+} from "../src/index.ts";
+import type { JsonValue } from "../src/index.ts";
+
+// The examples of RFC 6902, appendix A, that succeed.
+const rfcExamples: Array<[string, JsonValue, unknown, JsonValue]> = [
+  ["A.1 adding an object member", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { baz: "qux", foo: "bar" }],
+  ["A.2 adding an array element", { foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] }],
+  ["A.3 removing an object member", { baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }],
+  ["A.4 removing an array element", { foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }],
+  ["A.5 replacing a value", { baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" }],
+  [
+    "A.6 moving a value",
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  ],
+  [
+    "A.7 moving an array element",
+    { foo: ["all", "grass", "cows", "eat"] },
+    [{ op: "move", from: "/foo/1", path: "/foo/3" }],
+    { foo: ["all", "cows", "eat", "grass"] },
+  ],
+  [
+    "A.8 testing a value: success",
+    { baz: "qux", foo: ["a", 2, "c"] },
+    [
+      { op: "test", path: "/baz", value: "qux" },
+      { op: "test", path: "/foo/1", value: 2 },
+    ],
+    { baz: "qux", foo: ["a", 2, "c"] },
+  ],
+  ["A.10 adding a nested member object", { foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } }],
+  ["A.11 ignoring unrecognized elements", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" }],
+  ["A.14 ~ escape ordering", { "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }],
+  ["A.16 adding an array value", { foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] }],
+];
+
+describe("applyPatch", () => {
+  describe("RFC 6902 appendix A examples", () => {
+    for (const [name, document, patch, expected] of rfcExamples) {
+      it(name, () => {
+        assert.deepEqual(applyPatch(document, patch), expected);
+      });
+    }
+
+    it("A.9 testing a value: error", () => {
+      const document: JsonValue = { baz: "qux" };
+      assert.throws(() => applyPatch(document, [{ op: "test", path: "/baz", value: "bar" }]), PatchTestFailedError);
+    });
+
+    it("A.12 adding to a nonexistent target", () => {
+      const document: JsonValue = { foo: "bar" };
+      assert.throws(() => applyPatch(document, [{ op: "add", path: "/baz/bat", value: "qux" }]), PatchConflictError);
+    });
+
+    it("A.15 comparing strings and numbers", () => {
+      const document: JsonValue = { "/": 9, "~1": 10 };
+      assert.throws(() => applyPatch(document, [{ op: "test", path: "/~01", value: "10" }]), PatchTestFailedError);
+    });
+  });
+
+  describe("add", () => {
+    it("replaces an existing member", () => {
+      assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+    });
+
+    it("replaces the whole document with the empty path", () => {
+      assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+    });
+
+    it("inserts at the end of an array with an index equal to its length", () => {
+      assert.deepEqual(applyPatch([1, 2], [{ op: "add", path: "/2", value: 3 }]), [1, 2, 3]);
+    });
+
+    it("adds a null value", () => {
+      assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a", value: null }]), { a: null });
+    });
+
+    it("treats - and digits as member names on objects", () => {
+      const patch = [
+        { op: "add", path: "/-", value: 1 },
+        { op: "add", path: "/01", value: 2 },
+      ];
+      assert.deepEqual(applyPatch({}, patch), { "-": 1, "01": 2 });
+    });
+
+    it("adds an own __proto__ member without changing the prototype", () => {
+      const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]);
+      assert.equal(Object.getPrototypeOf(result), Object.prototype);
+      assert.ok(Object.hasOwn(result as object, "__proto__"));
+      assert.equal((result as Record<string, unknown>).polluted, undefined);
+      assert.equal(({} as Record<string, unknown>).polluted, undefined);
+    });
+
+    for (const path of ["/3", "/01", "/-1", "/x"]) {
+      it(`rejects array index ${JSON.stringify(path)}`, () => {
+        assert.throws(() => applyPatch([1, 2], [{ op: "add", path, value: 0 }]), PatchConflictError);
+      });
+    }
+
+    it("rejects a parent that is not a container", () => {
+      assert.throws(() => applyPatch({ a: "text" }, [{ op: "add", path: "/a/b", value: 0 }]), PatchConflictError);
+    });
+  });
+
+  describe("remove", () => {
+    it("removes a nested member", () => {
