+    });
+
+    it("tests the whole document with the empty path", () => {
+      assert.deepEqual(applyPatch(document, [{ op: "test", path: "", value: document }]), document);
+    });
+
+    const mismatches: Array<[string, unknown]> = [
+      ["/obj", { a: 1 }],
+      ["/obj", { a: 1, b: [true, null, "s"], c: 2 }],
+      ["/obj/b", [true, null]],
+      ["/obj/b", [null, true, "s"]],
