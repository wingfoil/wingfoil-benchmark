+    });
+
+    for (const path of ["/missing", "/list/2", "/list/-", "/list/01", ""]) {
+      it(`rejects ${JSON.stringify(path)}`, () => {
+        assert.throws(() => applyPatch({ list: [1, 2] }, [{ op: "remove", path }]), PatchConflictError);
+      });
+    }
+
+    it("ignores inherited properties", () => {
+      assert.throws(() => applyPatch({}, [{ op: "remove", path: "/toString" }]), PatchConflictError);
