+
+  describe("invalid patches", () => {
+    const invalid: Array<[string, unknown]> = [
+      ["a patch that is not an array", { op: "add", path: "/a", value: 1 }],
+      ["an operation that is not an object", [null]],
+      ["an operation that is an array", [["add"]]],
+      ["a missing op", [{ path: "/a", value: 1 }]],
+      ["an unknown op", [{ op: "merge", path: "/a", value: 1 }]],
+      ["an op in the wrong case", [{ op: "Add", path: "/a", value: 1 }]],
+      ["a missing path", [{ op: "add", value: 1 }]],
+      ["a path that is not a string", [{ op: "remove", path: 1 }]],
+      ["a path that is not a valid pointer", [{ op: "remove", path: "a" }]],
+      ["a missing value for add", [{ op: "add", path: "/a" }]],
+      ["a missing value for replace", [{ op: "replace", path: "/a" }]],
+      ["a missing value for test", [{ op: "test", path: "/a" }]],
+      ["a missing from for move", [{ op: "move", path: "/a" }]],
+      ["a missing from for copy", [{ op: "copy", path: "/a" }]],
+      ["a from that is not a valid pointer", [{ op: "copy", from: "a~", path: "/a" }]],
+      ["a value that is not JSON", [{ op: "add", path: "/a", value: undefined }]],
