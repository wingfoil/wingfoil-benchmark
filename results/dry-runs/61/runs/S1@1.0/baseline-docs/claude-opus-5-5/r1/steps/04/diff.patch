@@ -0,0 +1,53 @@
+/**
+ * JSON Merge Patch, as specified by RFC 7386: a JSON document that describes changes by example.
+ * Its members replace or add the members of the target, a null member removes one, and any value
+ * that is not an object replaces the target as a whole.
+ */
+
+import type { JsonValue } from "./json-pointer.ts";
+import { cloneValue, isJsonValue, isPlainObject, setMember } from "./json-value.ts";
+
+type JsonObject = { [key: string]: JsonValue };
+
+/** Raised when a merge patch is not a JSON value: nothing is applied. */
+export class InvalidMergePatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = new.target.name;
+  }
+}
+
+/**
+ * Applies a JSON Merge Patch to a JSON document.
+ *
+ * The merge follows the algorithm of RFC 7386, section 2, applied to a copy of `target`. The result
+ * shares no value with `target` or `patch`, and neither is modified.
+ *
+ * @param target - The JSON document to patch.
+ * @param patch - The merge patch: any JSON value, typically parsed from JSON.
+ * @returns The merged document, as a new value.
+ * @throws {InvalidMergePatchError} When `patch` is not a JSON value.
+ */
+export function applyMergePatch(target: JsonValue, patch: unknown): JsonValue {
+  if (!isJsonValue(patch)) {
+    throw new InvalidMergePatchError("JSON Merge Patch must be a JSON value");
+  }
+  return merge(cloneValue(target), patch);
+}
+
+// RFC 7386, section 2. `target` is owned by the merge, so it is changed in place; it is undefined
+// when the member being patched does not exist.
+function merge(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isPlainObject(patch)) {
+    return cloneValue(patch);
+  }
+  const result: JsonObject = isPlainObject(target) ? (target as JsonObject) : {};
+  for (const [key, value] of Object.entries(patch as JsonObject)) {
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, merge(Object.hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
