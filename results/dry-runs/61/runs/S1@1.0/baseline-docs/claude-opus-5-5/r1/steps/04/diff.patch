diff --git a/src/json-value.ts b/src/json-value.ts
new file mode 100644
index 0000000000000000000000000000000000000000..41f6cd08b98a2790a00bae740f8ab0d7738a1f01
--- /dev/null
+++ b/src/json-value.ts
@@ -0,0 +1,73 @@
+/**
+ * Helpers shared by the modules that build JSON documents from untrusted input: checking that a
+ * value is JSON, copying it, and writing members safely. They are internal to the library.
+ */
+
+import type { JsonValue } from "./json-pointer.ts";
+
+/** Defines a member, rather than assigning it, so that a "__proto__" member stays an own property. */
+export function setMember(object: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Returns a deep copy of a JSON value, which shares no object or array with it. */
+export function cloneValue(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(cloneValue);
+  }
+  if (value === null || typeof value !== "object") {
+    return value;
+  }
+  const clone: { [key: string]: JsonValue } = {};
+  for (const [key, member] of Object.entries(value)) {
+    setMember(clone, key, cloneValue(member));
+  }
+  return clone;
+}
+
+/**
+ * Tells whether a value is JSON: no `undefined`, non-finite number, function, class instance, sparse
+ * array or cycle anywhere in it. A value may still hold the same object twice.
+ */
+export function isJsonValue(value: unknown): value is JsonValue {
+  return isJsonMember(value, new Set());
+}
+
+/** Tells whether a value is an object literal or an object without a prototype, not an array. */
+export function isPlainObject(value: unknown): value is Record<string, unknown> {
+  if (value === null || typeof value !== "object" || Array.isArray(value)) {
+    return false;
+  }
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
+
+function isJsonMember(value: unknown, ancestors: Set<object>): boolean {
+  switch (typeof value) {
+    case "string":
+    case "boolean":
+      return true;
+    case "number":
+      return Number.isFinite(value);
+    case "object":
+      return value === null || isJsonContainer(value, ancestors);
+    default:
+      return false;
+  }
+}
+
+// A container that holds one of its ancestors is cyclic, which JSON cannot represent. Array.from
+// turns the holes of a sparse array into undefined, so they are rejected rather than skipped.
+function isJsonContainer(value: object, ancestors: Set<object>): boolean {
+  if (ancestors.has(value)) {
+    return false;
+  }
+  const members = Array.isArray(value) ? Array.from(value) : isPlainObject(value) ? Object.values(value) : undefined;
+  if (members === undefined) {
+    return false;
+  }
+  ancestors.add(value);
+  const valid = members.every((member) => isJsonMember(member, ancestors));
+  ancestors.delete(value);
+  return valid;
+}
