@@ -0,0 +1,137 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { InvalidMergePatchError, applyMergePatch } from "../src/index.ts";
+import type { JsonValue } from "../src/index.ts";
+
+// The test cases of RFC 7386, appendix A: original, patch, result.
+const rfcExamples: Array<[JsonValue, JsonValue, JsonValue]> = [
+  [{ a: "b" }, { a: "c" }, { a: "c" }],
+  [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  [{ a: "b" }, { a: null }, {}],
+  [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+  [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+  [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  [["a", "b"], ["c", "d"], ["c", "d"]],
+  [{ a: "b" }, ["c"], ["c"]],
+  [{ a: "foo" }, null, null],
+  [{ a: "foo" }, "bar", "bar"],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: "b", c: null }, { a: "b" }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+
+describe("applyMergePatch", () => {
+  describe("RFC 7386 appendix A examples", () => {
+    for (const [target, patch, expected] of rfcExamples) {
+      it(`${JSON.stringify(target)} merged with ${JSON.stringify(patch)}`, () => {
+        assert.deepEqual(applyMergePatch(target, patch), expected);
+      });
+    }
+  });
+
+  it("applies the example of RFC 7386, section 3", () => {
+    const target: JsonValue = {
+      title: "Goodbye!",
+      author: { givenName: "John", familyName: "Doe" },
+      tags: ["example", "sample"],
+      content: "This will be unchanged",
+    };
+    const patch: JsonValue = {
+      title: "Hello!",
+      phoneNumber: "+01-123-456-7890",
+      author: { familyName: null },
+      tags: ["example"],
+    };
+    assert.deepEqual(applyMergePatch(target, patch), {
+      title: "Hello!",
+      author: { givenName: "John" },
+      tags: ["example"],
+      content: "This will be unchanged",
+      phoneNumber: "+01-123-456-7890",
+    });
+  });
+
+  it("keeps null elements of an array in the patch", () => {
+    assert.deepEqual(applyMergePatch({ a: 1 }, { a: [null, { b: null }] }), { a: [null, { b: null }] });
+  });
+
+  it("ignores a null member that the target does not have", () => {
+    assert.deepEqual(applyMergePatch({ a: 1 }, { b: null }), { a: 1 });
+  });
+
+  it("returns the target unchanged for an empty object patch", () => {
+    assert.deepEqual(applyMergePatch({ a: [1] }, {}), { a: [1] });
+  });
+
+  it("does not treat inherited properties as members of the target", () => {
+    assert.deepEqual(applyMergePatch({}, { toString: { a: 1 } }), { toString: { a: 1 } });
+  });
+
+  it("merges an own __proto__ member without changing the prototype", () => {
+    const patch = JSON.parse('{"__proto__": {"polluted": true}}') as JsonValue;
+    const result = applyMergePatch({}, patch);
+    assert.equal(Object.getPrototypeOf(result), Object.prototype);
+    assert.ok(Object.hasOwn(result as object, "__proto__"));
+    assert.equal((result as Record<string, unknown>).polluted, undefined);
+    assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  });
+
+  describe("immutability", () => {
+    it("does not mutate the target or the patch", () => {
+      const target: JsonValue = { a: { b: 1, c: [1] }, d: 2 };
+      const patch: JsonValue = { a: { b: null, e: { f: 1 } }, d: null };
+      const targetBefore = structuredClone(target);
+      const patchBefore = structuredClone(patch);
+      const result = applyMergePatch(target, patch);
+      assert.deepEqual(target, targetBefore);
+      assert.deepEqual(patch, patchBefore);
+      assert.deepEqual(result, { a: { c: [1], e: { f: 1 } } });
+    });
+
+    it("shares no value with the target or the patch", () => {
+      const target = { kept: { x: [1] } };
+      const patch = { added: { y: [2] } };
+      const result = applyMergePatch(target, patch) as { kept: { x: number[] }; added: { y: number[] } };
+      result.kept.x.push(3);
+      result.added.y.push(3);
+      assert.deepEqual(target, { kept: { x: [1] } });
+      assert.deepEqual(patch, { added: { y: [2] } });
+    });
+
+    it("returns a new value for an empty patch", () => {
+      const target: JsonValue = { a: 1 };
+      assert.notEqual(applyMergePatch(target, {}), target);
+    });
+  });
+
+  describe("invalid patches", () => {
+    const invalid: Array<[string, unknown]> = [
+      ["undefined", undefined],
+      ["a member that is undefined", { a: undefined }],
+      ["a number that is not finite", { a: Number.NaN }],
+      ["a function", { a: () => 1 }],
+      ["a class instance", { a: new Date(0) }],
+      ["a sparse array", { a: [1, , 3] }],
+      ["a value that contains itself", cyclicValue()],
+    ];
+    for (const [name, patch] of invalid) {
+      it(`rejects ${name}`, () => {
+        assert.throws(() => applyMergePatch({ a: 1 }, patch), InvalidMergePatchError);
+      });
+    }
+
+    it("accepts a patch that holds the same object twice", () => {
+      const shared = { n: 1 };
+      assert.deepEqual(applyMergePatch({}, { a: shared, b: shared }), { a: { n: 1 }, b: { n: 1 } });
+    });
+  });
+});
+
+// An object whose member, nested in an array, refers back to the object.
+function cyclicValue(): unknown {
+  const value: { list: unknown[] } = { list: [] };
+  value.list.push(value);
+  return value;
+}
