+function calculateRentalTotal(dailyPrice: number, startTime: number, endTime: number): number {
+  const days = (endTime - startTime) / MILLISECONDS_PER_DAY;
+  const fullPrice = days * dailyPrice;
+
+  return days >= LONG_RENTAL_MINIMUM_DAYS
+    ? Math.round(fullPrice * (100 - LONG_RENTAL_DISCOUNT_PERCENTAGE) / 100)
+    : fullPrice;
+}
