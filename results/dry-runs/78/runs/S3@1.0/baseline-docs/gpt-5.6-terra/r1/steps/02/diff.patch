+function validateAvailabilityQuery(
+  query: AvailabilityQuery,
+): { startTime: number; endTime: number; kind: EquipmentKind | undefined } {
+  if (typeof query !== 'object' || query === null
+    || typeof query.start !== 'string'
+    || typeof query.end !== 'string'
+    || (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail')) {
+    throw new Error('An availability query must contain string start and end values, and an optional board or sail kind.');
+  }
+
+  const startTime = parseMidnightUtc(query.start);
+  const endTime = parseMidnightUtc(query.end);
+  if (endTime <= startTime) {
+    throw new Error('An availability period must end after it starts.');
+  }
+
+  return { startTime, endTime, kind: query.kind };
+}
