+test('cancels a booking, refunds its unused time, and releases its equipment', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: firstDay, end: thirdDay });
+
+  assert.deepEqual(service.cancel(booking.id, secondDay), {
+    bookingId: booking.id,
+    refund: 2_500,
+  });
+  assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: firstDay, end: thirdDay }));
+});
+
+test('calculates cancellation refunds at booking boundaries and prevents repeat cancellations', () => {
+  const service = serviceWithBoard();
+  const beforeStart = service.book({ itemId: 'board-1', start: firstDay, end: secondDay });
+
+  assert.deepEqual(service.cancel(beforeStart.id, '2026-05-31T00:00:00Z'), {
+    bookingId: beforeStart.id,
+    refund: 2_500,
+  });
+
+  const afterEnd = service.book({ itemId: 'board-1', start: firstDay, end: secondDay });
+  assert.deepEqual(service.cancel(afterEnd.id, secondDay), {
+    bookingId: afterEnd.id,
+    refund: 0,
+  });
+  assert.throws(() => service.cancel(afterEnd.id, secondDay));
+  assert.throws(() => service.cancel('booking-missing', firstDay));
+  assert.throws(() => service.cancel(beforeStart.id, '2026-06-01T09:30:00Z'));
+});
