+function calculateRefund(booking: StoredBooking, cancelledAt: number): number {
+  if (cancelledAt <= booking.startTime) {
+    return booking.total;
+  }
+  if (cancelledAt >= booking.endTime) {
+    return 0;
+  }
+
+  return Math.round(booking.total * (booking.endTime - cancelledAt) / (booking.endTime - booking.startTime));
+}
