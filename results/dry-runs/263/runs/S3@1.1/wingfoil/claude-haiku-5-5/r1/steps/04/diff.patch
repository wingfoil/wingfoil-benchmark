+
+const HOUR_OF = (day: string, hour: number) => `${day}T${String(hour).padStart(2, '0')}:00:00Z`;
+
+function serviceWithHourlyBoard() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 1000 });
+  return service;
+}
+
+test('addEquipment accepts an item without an hourly price', () => {
+  const service = createRentalService();
+  assert.doesNotThrow(() => service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 }));
+});
+
+test('quote prices a rental by the hour at the hourly price', () => {
+  const service = serviceWithHourlyBoard();
+  const quote = service.quote({ itemId: 'board-1', start: HOUR_OF('2026-07-01', 13), end: HOUR_OF('2026-07-01', 16) });
+  assert.equal(quote.total, 3000);
+});
+
+test('quote prices a one-hour rental at the hourly price', () => {
+  const service = serviceWithHourlyBoard();
+  const quote = service.quote({ itemId: 'board-1', start: HOUR_OF('2026-07-01', 9), end: HOUR_OF('2026-07-01', 10) });
+  assert.equal(quote.total, 1000);
+});
+
+test('quote prices an hourly rental that crosses midnight by its hours', () => {
+  const service = serviceWithHourlyBoard();
+  const quote = service.quote({ itemId: 'board-1', start: HOUR_OF('2026-07-01', 22), end: HOUR_OF('2026-07-02', 2) });
+  assert.equal(quote.total, 4000);
+});
+
+test('quote gives no long-stay discount to an hourly rental', () => {
+  const service = serviceWithHourlyBoard();
+  const quote = service.quote({ itemId: 'board-1', start: HOUR_OF('2026-07-01', 0), end: HOUR_OF('2026-07-01', 23) });
+  assert.equal(quote.total, 23000);
+});
+
+test('quote throws for an hourly rental of an item without an hourly price', () => {
+  const service = serviceWithBoard();
+  assert.throws(
+    () => service.quote({ itemId: 'board-1', start: HOUR_OF('2026-07-01', 13), end: HOUR_OF('2026-07-01', 16) }),
+    /cannot be rented by the hour/,
+  );
+});
+
+test('quote still prices daily rentals of an item with an hourly price', () => {
+  const service = serviceWithHourlyBoard();
+  const quote = service.quote({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-02' + DAY });
+  assert.equal(quote.total, 2500);
+});
+
+test('quote throws for a period of 24 hours that does not start at midnight', () => {
+  const service = serviceWithHourlyBoard();
+  assert.throws(() => service.quote({ itemId: 'board-1', start: HOUR_OF('2026-07-01', 10), end: HOUR_OF('2026-07-02', 10) }));
+});
+
+test('quote throws for a daily rental that does not start and end at midnight', () => {
+  const service = serviceWithHourlyBoard();
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-01' + DAY, end: HOUR_OF('2026-07-02', 10) }));
+});
+
+test('book returns the hourly total and blocks overlapping hours', () => {
+  const service = serviceWithHourlyBoard();
+  const booking = service.book({ itemId: 'board-1', start: HOUR_OF('2026-07-01', 10), end: HOUR_OF('2026-07-01', 13) });
+  assert.equal(booking.total, 3000);
+  assert.throws(
+    () => service.book({ itemId: 'board-1', start: HOUR_OF('2026-07-01', 12), end: HOUR_OF('2026-07-01', 14) }),
+    /overlapping period/,
+  );
+  assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: HOUR_OF('2026-07-01', 13), end: HOUR_OF('2026-07-01', 15) }));
+});
+
+test('availability respects hourly bookings', () => {
+  const service = serviceWithHourlyBoard();
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500, hourlyPrice: 1000 });
+  service.book({ itemId: 'board-1', start: HOUR_OF('2026-07-01', 10), end: HOUR_OF('2026-07-01', 13) });
+  assert.deepEqual(
+    service.availability({ start: HOUR_OF('2026-07-01', 12), end: HOUR_OF('2026-07-01', 14), kind: 'board' }),
+    ['board-2'],
+  );
+  assert.deepEqual(
+    service.availability({ start: HOUR_OF('2026-07-01', 13), end: HOUR_OF('2026-07-01', 14), kind: 'board' }),
+    ['board-1', 'board-2'],
+  );
+});
