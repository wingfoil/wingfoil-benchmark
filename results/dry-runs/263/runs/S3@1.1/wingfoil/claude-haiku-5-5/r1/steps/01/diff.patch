diff --git a/src/period.ts b/src/period.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1c6fb0052d6daa54e26f19841b23a6fa0ea21787
--- /dev/null
+++ b/src/period.ts
@@ -0,0 +1,37 @@
+const DAY_MS = 86_400_000;
+
+// A school day starts at midnight UTC: `YYYY-MM-DD`, or the same with `T00:00:00Z` (optionally `.000`).
+const MIDNIGHT_UTC = /^(\d{4}-\d{2}-\d{2})(T00:00:00(\.000)?Z)?$/;
+
+export interface Period {
+  readonly start: number;
+  readonly end: number;
+  readonly days: number;
+}
+
+function parseMidnightUtc(value: string, name: string): number {
+  const match = MIDNIGHT_UTC.exec(value);
+  if (match === null) {
+    throw new Error(`${name} must be midnight UTC, e.g. 2026-07-01T00:00:00Z`);
+  }
+  const day = match[1];
+  const ms = Date.parse(`${day}T00:00:00Z`);
+  // Rejects impossible dates such as 2026-02-30, which Date.parse would otherwise roll over.
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== day) {
+    throw new Error(`${name} is not a valid date: ${value}`);
+  }
+  return ms;
+}
+
+export function parsePeriod(start: string, end: string): Period {
+  const from = parseMidnightUtc(start, 'start');
+  const to = parseMidnightUtc(end, 'end');
+  if (to <= from) {
+    throw new Error('end must be after start');
+  }
+  return { start: from, end: to, days: (to - from) / DAY_MS };
+}
+
+export function overlaps(a: Period, b: Period): boolean {
+  return a.start < b.end && b.start < a.end;
+}
diff --git a/src/rental.test.ts b/src/rental.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ec9e2893c3adc629f91e66908d8194fc32505ca4
--- /dev/null
+++ b/src/rental.test.ts
@@ -0,0 +1,153 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.js';
+
+const DAY = 'T00:00:00Z';
+
+function serviceWithBoard() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  return service;
+}
+
+test('quote prices one day at the daily price', () => {
+  const service = serviceWithBoard();
+  const quote = service.quote({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-02' + DAY });
+  assert.deepEqual(quote, {
+    itemId: 'board-1',
+    start: '2026-07-01' + DAY,
+    end: '2026-07-02' + DAY,
+    total: 2500,
+  });
+});
+
+test('quote multiplies the daily price by the number of days', () => {
+  const service = serviceWithBoard();
+  const quote = service.quote({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-04' + DAY });
+  assert.equal(quote.total, 7500);
+});
+
+test('quote accepts date-only and .000 midnight forms', () => {
+  const service = serviceWithBoard();
+  const quote = service.quote({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-02T00:00:00.000Z' });
+  assert.equal(quote.total, 2500);
+});
+
+test('quote does not check availability', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-03' + DAY });
+  const quote = service.quote({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-02' + DAY });
+  assert.equal(quote.total, 2500);
+});
+
+test('quote throws for an unknown item', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.quote({ itemId: 'sail-9', start: '2026-07-01' + DAY, end: '2026-07-02' + DAY }));
+});
+
+test('quote throws for a time that is not midnight UTC', () => {
+  const service = serviceWithBoard();
+  assert.throws(() =>
+    service.quote({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-02' + DAY }),
+  );
+  assert.throws(() =>
+    service.quote({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-02T00:00:00+01:00' }),
+  );
+});
+
+test('quote throws for a malformed or impossible date', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-01 00:00', end: '2026-07-02' + DAY }));
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-02-30', end: '2026-03-01' + DAY }));
+});
+
+test('quote throws when end is not after start', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-02' + DAY, end: '2026-07-01' + DAY }));
+  assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-01' + DAY }));
+});
+
+test('addEquipment rejects an invalid item', () => {
+  const service = createRentalService();
+  assert.throws(() => service.addEquipment({ id: '', kind: 'board', dailyPrice: 2500 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'kite' as 'board', dailyPrice: 2500 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 0 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 12.5 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'sail', dailyPrice: -100 }));
+});
+
+test('addEquipment rejects a duplicate id', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'sail', dailyPrice: 1000 }));
+});
+
+test('book returns the booking with an id and total', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-03' + DAY });
+  assert.equal(typeof booking.id, 'string');
+  assert.deepEqual(
+    { itemId: booking.itemId, start: booking.start, end: booking.end, total: booking.total },
+    { itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-03' + DAY, total: 5000 },
+  );
+});
+
+test('book gives each booking a different id', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  const first = service.book({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-02' + DAY });
+  const second = service.book({ itemId: 'sail-1', start: '2026-07-01' + DAY, end: '2026-07-02' + DAY });
+  assert.notEqual(first.id, second.id);
+});
+
+test('book throws for an unknown item', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.book({ itemId: 'sail-9', start: '2026-07-01' + DAY, end: '2026-07-02' + DAY }));
+});
+
+test('book throws for a period the rules do not allow', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-01T12:00:00Z', end: '2026-07-02' + DAY }));
+  assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-02' + DAY, end: '2026-07-01' + DAY }));
+});
+
+test('book throws when the item is already booked for an overlapping period', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-03' + DAY, end: '2026-07-06' + DAY });
+  // identical, partly overlapping at either end, contained, and containing
+  const overlapping = [
+    ['2026-07-03', '2026-07-06'],
+    ['2026-07-02', '2026-07-04'],
+    ['2026-07-05', '2026-07-08'],
+    ['2026-07-04', '2026-07-05'],
+    ['2026-07-01', '2026-07-10'],
+  ];
+  for (const [start, end] of overlapping) {
+    assert.throws(
+      () => service.book({ itemId: 'board-1', start: start + DAY, end: end + DAY }),
+      /overlapping period/,
+      start,
+    );
+  }
+});
+
+test('book allows back-to-back periods for the same item', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-03' + DAY, end: '2026-07-06' + DAY });
+  assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-03' + DAY }));
+  assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: '2026-07-06' + DAY, end: '2026-07-07' + DAY }));
+});
+
+test('book does not let items conflict with each other', () => {
+  const service = serviceWithBoard();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  service.book({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-05' + DAY });
+  assert.doesNotThrow(() => service.book({ itemId: 'sail-1', start: '2026-07-01' + DAY, end: '2026-07-05' + DAY }));
+});
+
+test('a rejected booking does not block later periods', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-03' + DAY });
+  assert.throws(() => service.book({ itemId: 'board-1', start: '2026-07-02' + DAY, end: '2026-07-04' + DAY }));
+  assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: '2026-07-03' + DAY, end: '2026-07-04' + DAY }));
+});
diff --git a/src/rental.ts b/src/rental.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e5088dea432ad93c1b4d1c5543065eaad5a4e92d
--- /dev/null
+++ b/src/rental.ts
@@ -0,0 +1,117 @@
+import { overlaps, parsePeriod, type Period } from './period.js';
+
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  readonly id: string;
+  readonly kind: EquipmentKind;
+  /** Price of one rental day, in euro cents. */
+  readonly dailyPrice: number;
+}
+
+export interface RentalRequest {
+  readonly itemId: string;
+  /** Midnight UTC, ISO-8601. */
+  readonly start: string;
+  /** Midnight UTC, ISO-8601; the start of the day after the last day. */
+  readonly end: string;
+}
+
+export interface Quote {
+  readonly itemId: string;
+  readonly start: string;
+  readonly end: string;
+  /** Euro cents. */
+  readonly total: number;
+}
+
+export interface Booking extends Quote {
+  readonly id: string;
+}
+
+/**
+ * The rental desk for boards and sails. Everything is kept in memory.
+ * Money is in euro cents; every period covers whole days, from midnight UTC to midnight UTC.
+ */
+export interface RentalService {
+  /** Registers an item for rent. Throws on an invalid or duplicate item. */
+  addEquipment(item: Equipment): void;
+  /** Prices a rental. Does not check availability. Throws on an unknown item or a period not allowed. */
+  quote(request: RentalRequest): Quote;
+  /** Books an item for a free period and returns the booking. Throws if the item is not free. */
+  book(request: RentalRequest): Booking;
+}
+
+interface StoredBooking {
+  readonly itemId: string;
+  readonly period: Period;
+}
+
+const KINDS: readonly string[] = ['board', 'sail'];
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item.id !== 'string' || item.id === '') {
+    throw new Error('equipment id must be a non-empty string');
+  }
+  if (!KINDS.includes(item.kind)) {
+    throw new Error(`equipment kind must be 'board' or 'sail', got ${String(item.kind)}`);
+  }
+  if (!Number.isInteger(item.dailyPrice) || item.dailyPrice <= 0) {
+    throw new Error('dailyPrice must be a positive integer number of euro cents');
+  }
+}
+
+/**
+ * Creates an empty in-memory rental service. Booking ids are sequential, so runs are reproducible.
+ */
+export function createRentalService(): RentalService {
+  const items = new Map<string, Equipment>();
+  const bookings: StoredBooking[] = [];
+
+  function priceOf(request: RentalRequest, period: Period): number {
+    const item = items.get(request.itemId);
+    if (item === undefined) {
+      throw new Error(`unknown item: ${request.itemId}`);
+    }
+    return item.dailyPrice * period.days;
+  }
+
+  return {
+    addEquipment(item) {
+      validateEquipment(item);
+      if (items.has(item.id)) {
+        throw new Error(`equipment already exists: ${item.id}`);
+      }
+      items.set(item.id, item);
+    },
+
+    quote(request) {
+      const period = parsePeriod(request.start, request.end);
+      return {
+        itemId: request.itemId,
+        start: request.start,
+        end: request.end,
+        total: priceOf(request, period),
+      };
+    },
+
+    book(request) {
+      const period = parsePeriod(request.start, request.end);
+      const total = priceOf(request, period);
+      const clash = bookings.some(
+        (booking) => booking.itemId === request.itemId && overlaps(booking.period, period),
+      );
+      if (clash) {
+        throw new Error(`${request.itemId} is already booked for an overlapping period`);
+      }
+      bookings.push({ itemId: request.itemId, period });
+      return {
+        id: `booking-${bookings.length}`,
+        itemId: request.itemId,
+        start: request.start,
+        end: request.end,
+        total,
+      };
+    },
+  };
+}
