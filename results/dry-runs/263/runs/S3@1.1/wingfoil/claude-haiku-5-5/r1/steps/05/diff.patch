+
+test('cancel refunds the full total two or more days before the start', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-10' + DAY, end: '2026-07-11' + DAY });
+  assert.deepEqual(service.cancel(booking.id, '2026-07-08T10:00:00Z'), { bookingId: booking.id, refund: 2500 });
+});
+
+test('cancel gives no refund less than 24 hours before the start', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-10' + DAY, end: '2026-07-11' + DAY });
+  assert.equal(service.cancel(booking.id, '2026-07-09T00:01:00Z').refund, 0);
+});
+
+test('cancel refunds the full total exactly 24 hours before the start', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-10' + DAY, end: '2026-07-11' + DAY });
+  assert.equal(service.cancel(booking.id, '2026-07-09T00:00:00Z').refund, 2500);
+});
+
+test('cancel gives no refund once the rental has started', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-10' + DAY, end: '2026-07-11' + DAY });
+  assert.equal(service.cancel(booking.id, '2026-07-10T09:00:00Z').refund, 0);
+});
+
+test('cancel refunds the long-stay total of a discounted booking', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-10' + DAY, end: '2026-07-13' + DAY });
+  assert.equal(service.cancel(booking.id, '2026-07-01T00:00:00Z').refund, 6750);
+});
+
+test('cancel refunds an hourly booking in full when cancelled in time', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 1000 });
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2026-07-10T10:00:00Z',
+    end: '2026-07-10T13:00:00Z',
+  });
+  assert.equal(booking.total, 3000);
+  assert.equal(service.cancel(booking.id, '2026-07-08T10:00:00Z').refund, 3000);
+});
+
+test('cancel frees the item for an overlapping period', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-10' + DAY, end: '2026-07-12' + DAY });
+  assert.deepEqual(service.availability({ start: '2026-07-11' + DAY, end: '2026-07-12' + DAY }), []);
+  service.cancel(booking.id, '2026-07-01T00:00:00Z');
+  assert.deepEqual(service.availability({ start: '2026-07-11' + DAY, end: '2026-07-12' + DAY }), ['board-1']);
+  assert.equal(service.book({ itemId: 'board-1', start: '2026-07-11' + DAY, end: '2026-07-12' + DAY }).total, 2500);
+});
+
+test('cancel throws for an unknown booking', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.cancel('booking-99', '2026-07-01T00:00:00Z'));
+});
+
+test('cancel throws when the same booking is cancelled twice', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-10' + DAY, end: '2026-07-11' + DAY });
+  service.cancel(booking.id, '2026-07-01T00:00:00Z');
+  assert.throws(() => service.cancel(booking.id, '2026-07-01T01:00:00Z'));
+});
+
+test('cancel throws for an invalid time', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-10' + DAY, end: '2026-07-11' + DAY });
+  assert.throws(() => service.cancel(booking.id, '2026-07-01'));
+  assert.throws(() => service.cancel(booking.id, '2026-07-01T10:00:00+01:00'));
+  assert.throws(() => service.cancel(booking.id, '2026-02-30T10:00:00Z'));
+  assert.throws(() => service.cancel(booking.id, 'yesterday'));
+  // The booking is still live after the rejected calls.
+  assert.deepEqual(service.availability({ start: '2026-07-10' + DAY, end: '2026-07-11' + DAY }), []);
+});
