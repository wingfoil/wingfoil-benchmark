index 86010afb3126551d843fc1ada8457c0fba7e143a..a6089db4d2f12b942910b48dd6e716058c1fb94b 100644
--- a/src/period.ts
+++ b/src/period.ts
@@ -4,6 +4,8 @@ const DAY_MS = 86_400_000;
 // A school time is UTC on the hour: `YYYY-MM-DD` (midnight), or `YYYY-MM-DDTHH:00:00Z` (optionally `.000`).
 const ON_THE_HOUR_UTC = /^(\d{4}-\d{2}-\d{2})(?:T(\d{2}):00:00(?:\.000)?Z)?$/;
 
+const UTC_INSTANT = /^(\d{4}-\d{2}-\d{2})T([01]\d|2[0-3]):[0-5]\d(?::[0-5]\d(?:\.\d+)?)?Z$/;
+
 /** A daily rental covers whole days; an hourly one is shorter than a day and covers whole hours. */
 export type Period =
   | { readonly unit: 'day'; readonly start: number; readonly end: number; readonly days: number }
@@ -47,6 +49,20 @@ export function parsePeriod(start: string, end: string): Period {
   throw new Error('a rental of a day or more must start and end at midnight UTC');
 }
 
+/** A UTC instant such as `2026-07-01T10:30:00Z`, with optional seconds and fraction. Returns epoch milliseconds. */
+export function parseInstantUtc(value: string, name: string): number {
+  const match = UTC_INSTANT.exec(value);
+  if (match === null) {
+    throw new Error(`${name} must be a UTC instant ending in Z, e.g. 2026-07-01T10:00:00Z`);
+  }
+  const ms = Date.parse(value);
+  // Rejects impossible dates such as 2026-02-30, which Date.parse would otherwise roll over.
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== match[1]) {
+    throw new Error(`${name} is not a valid date: ${value}`);
+  }
+  return ms;
+}
+
 export function overlaps(a: Period, b: Period): boolean {
   return a.start < b.end && b.start < a.end;
 }
