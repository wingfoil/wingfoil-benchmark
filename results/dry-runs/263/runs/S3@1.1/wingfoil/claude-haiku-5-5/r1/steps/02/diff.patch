+    ['board-1', 'sail-1', 'sail-2'],
+  );
+});
+
+test('availability lists only the given kind', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01' + DAY, end: '2026-07-02' + DAY, kind: 'board' }),
+    ['board-1', 'board-2'],
+  );
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01' + DAY, end: '2026-07-02' + DAY, kind: 'sail' }),
+    ['sail-1'],
+  );
+});
+
+test('availability excludes an item with an overlapping booking', () => {
+  const service = serviceWithBoard();
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+  service.book({ itemId: 'board-1', start: '2026-07-03' + DAY, end: '2026-07-06' + DAY });
+  const query = { start: '2026-07-05' + DAY, end: '2026-07-08' + DAY, kind: 'board' as const };
+  assert.deepEqual(service.availability(query), ['board-2']);
+});
+
+test('availability keeps an item whose bookings only touch the period', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-03' + DAY });
+  service.book({ itemId: 'board-1', start: '2026-07-05' + DAY, end: '2026-07-07' + DAY });
+  assert.deepEqual(
+    service.availability({ start: '2026-07-03' + DAY, end: '2026-07-05' + DAY }),
+    ['board-1'],
+  );
+});
+
+test('availability returns an empty array when nothing is free', () => {
+  const service = serviceWithBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-10' + DAY });
+  assert.deepEqual(service.availability({ start: '2026-07-02' + DAY, end: '2026-07-03' + DAY }), []);
+  assert.deepEqual(createRentalService().availability({ start: '2026-07-01' + DAY, end: '2026-07-02' + DAY }), []);
+});
+
+test('availability does not change the bookings', () => {
+  const service = serviceWithBoard();
+  service.availability({ start: '2026-07-01' + DAY, end: '2026-07-02' + DAY });
+  assert.equal(service.book({ itemId: 'board-1', start: '2026-07-01' + DAY, end: '2026-07-02' + DAY }).id, 'booking-1');
+});
+
+test('availability throws for an invalid period', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.availability({ start: '2026-07-01T10:00:00Z', end: '2026-07-02' + DAY }));
+  assert.throws(() => service.availability({ start: '2026-07-02' + DAY, end: '2026-07-02' + DAY }));
+  assert.throws(() => service.availability({ start: '2026-02-30', end: '2026-03-01' + DAY }));
+});
+
+test('availability throws for an invalid kind', () => {
