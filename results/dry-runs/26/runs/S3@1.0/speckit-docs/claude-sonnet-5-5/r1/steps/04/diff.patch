@@ -48,3 +48,24 @@ test('lists sorted equipment free for the whole period, optionally by kind', ()
   assert.deepEqual(s.availability({ start: d(4), end: d(5), kind: 'board' }), ['b1', 'b2']);
   assert.throws(() => s.availability({ start: d(3), end: d(3) }));
 });
+
+const h = (day: number, hour: number) => `2026-07-${String(day).padStart(2, '0')}T${String(hour).padStart(2, '0')}:00:00.000Z`;
+
+test('rentals shorter than a day are priced per hour, without discount', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500, hourlyPrice: 800 });
+  assert.equal(s.quote({ itemId: 'b1', start: h(1, 13), end: h(1, 17) }).total, 3200);
+  assert.equal(s.quote({ itemId: 'b1', start: h(1, 13), end: h(2, 12) }).total, 23 * 800);
+  assert.equal(s.book({ itemId: 'b1', start: h(1, 0), end: h(1, 3) }).total, 2400);
+  assert.throws(() => s.book({ itemId: 'b1', start: h(1, 2), end: h(1, 4) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T13:30:00Z', end: h(1, 17) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: h(1, 13), end: h(2, 13) }));
+});
+
+test('items without an hourly price cannot be rented by the hour', () => {
+  const s = setup();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2500, hourlyPrice: 800 });
+  assert.throws(() => s.quote({ itemId: 'b1', start: h(1, 13), end: h(1, 17) }));
+  assert.deepEqual(s.availability({ start: h(1, 13), end: h(1, 17) }), ['b2']);
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+});
