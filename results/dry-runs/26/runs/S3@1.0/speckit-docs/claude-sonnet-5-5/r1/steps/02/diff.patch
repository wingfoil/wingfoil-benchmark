+
+test('lists sorted equipment free for the whole period, optionally by kind', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a1', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2500 });
+  s.book({ itemId: 'b1', start: d(2), end: d(4) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(3) }), ['a1', 'b2']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3), kind: 'board' }), ['b2']);
+  assert.deepEqual(s.availability({ start: d(4), end: d(5), kind: 'board' }), ['b1', 'b2']);
+  assert.throws(() => s.availability({ start: d(3), end: d(3) }));
+});
