+
+test('cancelling frees the equipment, refunds before the start only, and works once', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.deepEqual(s.cancel(a.id, '2026-06-30T12:00:00Z'), { bookingId: a.id, refund: 6750 });
+  assert.deepEqual(s.availability({ start: d(1), end: d(4) }), ['b1']);
+  assert.throws(() => s.cancel(a.id, d(1)));
+  const b = s.book({ itemId: 'b1', start: d(1), end: d(2) });
+  assert.equal(s.cancel(b.id, '2026-07-01T10:00:00Z').refund, 0);
+  assert.throws(() => s.cancel('nope', d(1)));
+  assert.throws(() => s.cancel(b.id, 'garbage'));
+});
