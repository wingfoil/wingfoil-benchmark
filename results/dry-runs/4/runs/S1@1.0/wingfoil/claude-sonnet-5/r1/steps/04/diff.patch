+// applyMergePatch — RFC 7386 Appendix A examples.
+
+test("A: replaces an existing member's value", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: "c" }), { a: "c" });
+});
+
+test("A: adds a new member", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { b: "c" }), { a: "b", b: "c" });
+});
+
+test("A: a null value removes an existing member", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: null }), {});
+});
+
+test("A: a null value removes an existing member, leaving the others untouched", () => {
+  assert.deepEqual(applyMergePatch({ a: "b", b: "c" }, { a: null }), { b: "c" });
+});
+
+test("A: a scalar patch value replaces an array value wholesale", () => {
+  assert.deepEqual(applyMergePatch({ a: ["b"] }, { a: "c" }), { a: "c" });
+});
+
+test("A: an array patch value replaces a scalar value wholesale", () => {
+  assert.deepEqual(applyMergePatch({ a: "c" }, { a: ["b"] }), { a: ["b"] });
+});
+
+test("A: merges nested objects recursively, applying a nested null removal", () => {
+  assert.deepEqual(applyMergePatch({ a: { b: "c" } }, { a: { b: "d", c: null } }), { a: { b: "d" } });
+});
+
+test("A: an array value is replaced wholesale, not merged element-wise", () => {
+  assert.deepEqual(applyMergePatch({ a: [{ b: "c" }] }, { a: [1] }), { a: [1] });
+});
+
+test("A: an array patch replaces an array target wholesale", () => {
+  assert.deepEqual(applyMergePatch(["a", "b"], ["c", "d"]), ["c", "d"]);
+});
+
+test("A: an array patch replaces a non-array target wholesale", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, ["c"]), ["c"]);
+});
+
+test("A: a null patch replaces the whole target with null", () => {
+  assert.deepEqual(applyMergePatch({ a: "foo" }, null), null);
+});
+
+test("A: a scalar patch replaces the whole target", () => {
+  assert.deepEqual(applyMergePatch({ a: "foo" }, "bar"), "bar");
+});
+
+test("A: a null-valued member already in the target is left alone when the patch doesn't touch it", () => {
+  assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+});
+
+test("A: a non-object target is discarded in favor of an object patch", () => {
+  assert.deepEqual(applyMergePatch([1, 2], { a: "b", c: null }), { a: "b" });
+});
+
+test("A: building up nested objects from an empty target, pruning a nested null", () => {
+  assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+});
+
+test("does not mutate the target document", () => {
+  const target = { a: { b: "c" }, d: "e" };
+  const snapshot = structuredClone(target);
+  applyMergePatch(target, { a: { b: "f" }, d: null });
+  assert.deepEqual(target, snapshot);
+});
+
+test("does not mutate a nested object the patch doesn't touch", () => {
+  const nested = { b: "c" };
+  const target = { a: nested, d: "e" };
+  const result = applyMergePatch(target, { d: "f" }) as Record<string, unknown>;
+  assert.equal(result.a, nested);
+});
diff --git a/src/index.ts b/src/index.ts
index f3593d8b034211ac893be95290a3ba242ee10fef..03de016145e299f9aecbd8943dadb484dfd1b220 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -288,3 +288,26 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
 
   return patch.reduce((current, raw, index) => applyOperation(current, raw, index), document);
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a target JSON document and returns the merged
+ * document as a new value; `target` is never mutated. Per RFC 7386 §2: if `patch` is not an
+ * object, it replaces `target` entirely; otherwise each member of `patch` is merged into
+ * `target` recursively, and a member whose value is `null` removes the corresponding member
+ * from `target` instead of setting it.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isRecord(patch)) {
+    return patch;
+  }
+
+  const merged: Record<string, unknown> = isRecord(target) ? { ...target } : {};
+  for (const [member, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete merged[member];
+    } else {
+      merged[member] = applyMergePatch(merged[member], value);
+    }
+  }
+  return merged;
+}
