+// escape sequences "~0" and "~1"; a "~" not immediately followed by "0" or "1" is not covered by
+// the grammar at all and is a syntax error, not a literal "~".
+
+test("rejects a '~' not followed by '0' or '1'", () => {
+  assert.throws(() => resolvePointer({ "foo~bar": 1 }, "/foo~bar"));
+});
+
+test("rejects a trailing '~' with nothing following it", () => {
+  assert.throws(() => resolvePointer({ "foo~": 1 }, "/foo~"));
+});
+
+test("rejects a '~' followed by a digit other than '0' or '1'", () => {
+  assert.throws(() => resolvePointer({ "foo~2": 1 }, "/foo~2"));
+});
+
