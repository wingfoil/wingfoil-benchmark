diff --git a/src/index.ts b/src/index.ts
index a480a17839f358e50d04f9076e4f4a8948f9e2de..f3593d8b034211ac893be95290a3ba242ee10fef 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -1,8 +1,20 @@
+/**
+ * Per RFC 6901 §3's ABNF, "~" may only appear in a reference token as the first character of the
+ * two-character escape sequences "~0" and "~1"; a "~" not followed by "0" or "1" is not part of
+ * the grammar at all.
+ */
+const UNESCAPED_TILDE = /~(?![01])/;
+
 /**
  * Decodes a single reference token per RFC 6901 §3: first "~1" becomes "/",
  * then "~0" becomes "~" (in that order, so "~01" decodes to "~1").
+ *
+ * @throws {Error} if `token` contains a "~" not followed by "0" or "1".
  */
 function decodeToken(token: string): string {
+  if (UNESCAPED_TILDE.test(token)) {
+    throw new Error(`Invalid JSON Pointer reference token: "${token}" has a "~" not followed by "0" or "1"`);
+  }
   return token.replace(/~1/g, "/").replace(/~0/g, "~");
 }
 
