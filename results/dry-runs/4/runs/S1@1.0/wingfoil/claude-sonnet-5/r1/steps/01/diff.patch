+++ b/src/index.test.ts
@@ -0,0 +1,64 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "./index.ts";
+
+// Document from RFC 6901 §5.
+const rfcDocument = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("empty pointer resolves to the whole document", () => {
+  assert.deepEqual(resolvePointer(rfcDocument, ""), rfcDocument);
+});
+
+test("resolves each RFC 6901 §5 example pointer", () => {
+  assert.deepEqual(resolvePointer(rfcDocument, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfcDocument, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfcDocument, "/"), 0);
+  assert.equal(resolvePointer(rfcDocument, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfcDocument, "/c%d"), 2);
+  assert.equal(resolvePointer(rfcDocument, "/e^f"), 3);
+  assert.equal(resolvePointer(rfcDocument, "/g|h"), 4);
+  assert.equal(resolvePointer(rfcDocument, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfcDocument, '/k"l'), 6);
+  assert.equal(resolvePointer(rfcDocument, "/ "), 7);
+  assert.equal(resolvePointer(rfcDocument, "/m~0n"), 8);
+});
+
+test("walks nested objects and arrays", () => {
+  const document = { a: { b: [{ c: 42 }] } };
+  assert.equal(resolvePointer(document, "/a/b/0/c"), 42);
+});
+
+test("rejects a pointer that does not start with '/' and is not empty", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "foo"));
+});
+
+test("rejects a pointer referring to a missing object member", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/missing"));
+});
+
+test("rejects an array index that is out of bounds", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/foo/2"));
+});
+
+test("rejects the '-' array index since it names no element", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/foo/-"));
+});
+
+test("rejects an array index written with a leading zero", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/foo/00"));
+});
+
+test("rejects a pointer that descends into a scalar", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/foo/0/bar"));
+});
