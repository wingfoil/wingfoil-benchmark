+++ b/src/index.ts
@@ -0,0 +1,54 @@
+/**
+ * Decodes a single reference token per RFC 6901 §3: first "~1" becomes "/",
+ * then "~0" becomes "~" (in that order, so "~01" decodes to "~1").
+ */
+function decodeToken(token: string): string {
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/**
+ * Resolves a single reference token against the current value, per RFC 6901 §4.
+ */
+function step(current: unknown, token: string): unknown {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token)) {
+      throw new Error(`Invalid array index in JSON Pointer: "${token}"`);
+    }
+    const index = Number(token);
+    if (index >= current.length) {
+      throw new Error(`JSON Pointer array index out of bounds: "${token}"`);
+    }
+    return current[index];
+  }
+
+  if (typeof current === "object" && current !== null) {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new Error(`JSON Pointer does not resolve to a value: member "${token}" not found`);
+    }
+    return (current as Record<string, unknown>)[token];
+  }
+
+  throw new Error(`JSON Pointer does not resolve to a value: cannot descend into a non-container at "${token}"`);
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document and returns the value it refers to.
+ *
+ * @throws {Error} if `pointer` is not a syntactically valid JSON Pointer, or if it does not
+ *   resolve to a value within `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}"`);
+  }
+
+  const tokens = pointer.split("/").slice(1).map(decodeToken);
+
+  return tokens.reduce(step, document);
+}
