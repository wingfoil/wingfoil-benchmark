+
+describe('coupon rules (reports)', () => {
+  it('applies a percentage coupon to the subtotal after volume discounts', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'NB-1', name: 'Notebook', priceCents: 500, vatClass: 'standard', weightGrams: 100 });
+    s.inventory.restock('NB-1', 20);
+    s.coupons.add({ code: 'TEN', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31' });
+    const t = s.orders.quote({ customer: 'c-1', date: '2026-06-01', lines: [{ sku: 'NB-1', quantity: 12 }], coupon: 'TEN' }).totals;
+    assert.equal(t.goodsCents, 4860);
+  });
+
+  it('is still valid on its last day', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'AUTUMN', kind: 'percent', value: 10, validFrom: '2026-09-01', validUntil: '2026-11-30' });
+    const line = { customer: 'c-1', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'AUTUMN' };
+    assert.equal(orders.quote({ ...line, date: '2026-11-30' }).totals.couponDiscountCents, 200);
+    assert.throws(() => orders.quote({ ...line, date: '2026-12-01' }), CouponError);
+  });
+});
