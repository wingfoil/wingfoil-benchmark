+# Order fixes (reports of the week)
+
+Rules are those of README.md; the code was wrong, not the README.
+
+1. SKU lookup is case-insensitive and ignores surrounding spaces (`lb-220` finds `LB-220`) — `Catalog.find`.
+2. Shipping is free when goods (after discounts, before VAT) are €50.00 **or more** — `shippingCost` used `>`.
+3. Line VAT is rounded half up, not down (€1.99 × 22% = €0.4378 → €0.44) — `lineVat` used `floor`.
+
+Tests: test/catalog.test.ts, test/orders.test.ts.
diff --git a/src/catalog.ts b/src/catalog.ts
index 0dfc92645f10374f948e9312a79dc7dca44318e5..b114b9c78623136e5ee8c9b1fc6d118c4c478c33 100644
--- a/src/catalog.ts
+++ b/src/catalog.ts
@@ -56,7 +56,7 @@ export class Catalog {
 
   /** The product with `sku`, or undefined. */
   find(sku: string): Product | undefined {
-    return this.#products.get(sku.trim());
+    return this.#products.get(canonicalSku(sku));
   }
 
   /** The product with `sku`; throws UnknownProductError when there is none. */
