+
+describe('catalogue lookups', () => {
+  it('finds a product by a lower-case SKU', () => {
+    const { catalog } = createShop();
+    catalog.add({ sku: 'LB-220', name: 'Lunch box', priceCents: 1990, vatClass: 'standard', weightGrams: 400 });
+    assert.equal(catalog.get('lb-220').sku, 'LB-220');
+    assert.equal(catalog.getForSale(' Lb-220 ').sku, 'LB-220');
+  });
+});
diff --git a/test/orders.test.ts b/test/orders.test.ts
index d07f06bd09b3489b674e3119a14ea7d2ced148a7..c7efc54f71f94d62e5f738bbac9e1323d6e6cb6d 100644
--- a/test/orders.test.ts
+++ b/test/orders.test.ts
@@ -80,3 +80,28 @@ describe('orders', () => {
     assert.match(text, /Total\s+€/);
   });
 });
+
+describe('order pricing rules', () => {
+  it('orders a product keyed in lower case', () => {
+    const { orders } = shop();
+    const order = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'mug-01', quantity: 1 }] });
+    assert.equal(order.lines[0]?.sku, 'MUG-01');
+  });
+
+  it('ships free when the goods come to exactly €50.00', () => {
+    const { orders } = shop();
+    const order = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'TEA-7', quantity: 10 }] });
+    assert.equal(order.totals.goodsCents, 4500);
+    const exact = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 5 }] });
+    assert.equal(exact.totals.goodsCents, 5000);
+    assert.equal(exact.totals.shippingCents, 0);
+  });
+
+  it('rounds the VAT of a line half up: €1.99 at 22% is €0.44', () => {
+    const s = shop();
+    s.catalog.add({ sku: 'LB-220', name: 'Lunch box', priceCents: 199, vatClass: 'standard', weightGrams: 400 });
+    s.inventory.restock('LB-220', 5);
+    const order = s.orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'LB-220', quantity: 1 }] });
+    assert.equal(order.lines[0]?.vatCents, 44);
+  });
+});
