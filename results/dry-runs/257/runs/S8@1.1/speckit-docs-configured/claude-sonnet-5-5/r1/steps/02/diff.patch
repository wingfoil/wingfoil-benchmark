+
+describe('task timestamps', () => {
+  it('stamps creation and every change with the time of the change', () => {
+    let tick = 0;
+    const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)).toISOString());
+    const added = valueOf(list.add({ title: 'Sweep' }));
+    assert.equal(added.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(added.updatedAt, added.createdAt);
+    const changes = [
+      () => list.complete('Sweep'),
+      () => list.reopen('Sweep'),
+      () => list.rename('Sweep', 'Mop'),
+      () => list.tag('Mop', 'home'),
+      () => list.untag('Mop', 'home'),
+    ];
+    changes.forEach((change, index) => {
+      const task = valueOf(change());
+      assert.equal(task.createdAt, added.createdAt);
+      assert.equal(task.updatedAt, new Date(Date.UTC(2026, 0, 1, 0, 0, index + 1)).toISOString());
+    });
+  });
+
+  it('defaults to the system clock as an ISO-8601 string', () => {
+    const task = valueOf(createTodoList().add({ title: 'Now' }));
+    assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
+  });
+});
