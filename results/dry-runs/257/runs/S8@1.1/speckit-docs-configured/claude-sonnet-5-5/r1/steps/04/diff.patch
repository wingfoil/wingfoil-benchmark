@@ -0,0 +1,44 @@
+import type { TaskList } from './list.ts';
+
+/** A line of an import that could not be added, with its number (from 1) and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks it added, and the lines it could not add. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may be
+ * empty for a normal one, tags are separated by spaces, and blank lines are skipped. A line that cannot
+ * be added is reported and does not stop the others.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  String(text).split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: 'a line has at most three parts: title;priority;tags' });
+      return;
+    }
+    const [title, priority = '', tags = ''] = fields;
+    const result = list.add({
+      title,
+      ...(priority.trim() === '' ? {} : { priority: priority.trim().toLowerCase() as 'low' }),
+      tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line, reason: result.error.message });
+  });
+  return { imported, rejected };
+}
