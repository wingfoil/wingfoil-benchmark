diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d6099181fdb029264ae1be03a3cd24c14ea5b4e2
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds valid lines, with priority and tags, skipping blank lines', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\r\nBuy milk;;\nWalk dog');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const task = list.find('Renew the insurance');
+    assert.ok(task.ok);
+    assert.equal(task.value.priority, 'high');
+    assert.deepEqual(task.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok);
+    assert.equal(milk.value.priority, 'normal');
+  });
+
+  it('rejects bad lines with their number and keeps going', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'A;urgent;\n\n;high;x\nB;low;t\nB;;\nC;low;t;extra');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(report.rejected.map((r) => r.line), [1, 3, 5, 6]);
+    assert.ok(report.rejected.every((r) => r.reason.length > 0));
+    assert.equal(list.list().length, 1);
+  });
+});
