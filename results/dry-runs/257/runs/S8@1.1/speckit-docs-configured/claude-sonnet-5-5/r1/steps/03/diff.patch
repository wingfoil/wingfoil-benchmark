@@ -142,3 +142,45 @@ describe('task timestamps', () => {
     assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
   });
 });
+
+describe('input validation', () => {
+  const invalid = (result: { ok: boolean; error?: { code: string; message: string } }) => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+    assert.ok(result.error!.message.length > 0);
+  };
+
+  it('rejects empty, blank and too long titles when adding', () => {
+    const list = createTodoList();
+    invalid(list.add({ title: '' }));
+    invalid(list.add({ title: '   ' }));
+    invalid(list.add({ title: 'x'.repeat(121) }));
+    assert.equal(list.list().length, 0);
+    assert.equal(list.add({ title: 'x'.repeat(120) }).ok, true);
+  });
+
+  it('rejects an unknown priority and bad tags when adding', () => {
+    const list = createTodoList();
+    invalid(list.add({ title: 'A', priority: 'urgent' as never }));
+    invalid(list.add({ title: 'A', tags: ['ok', ''] }));
+    invalid(list.add({ title: 'A', tags: ['two words'] }));
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a bad new title when renaming, leaving the task alone', () => {
+    const list = createTodoList();
+    list.add({ title: 'A' });
+    invalid(list.rename('A', '  '));
+    invalid(list.rename('A', 'y'.repeat(121)));
+    assert.equal(list.find('A').ok, true);
+    assert.equal(list.list().length, 1);
+  });
+
+  it('rejects an empty tag or one with a space when tagging', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'A' }));
+    invalid(list.tag('A', ''));
+    invalid(list.tag('A', 'a b'));
+    assert.deepEqual(valueOf(list.get(task.id)), task);
+  });
+});
