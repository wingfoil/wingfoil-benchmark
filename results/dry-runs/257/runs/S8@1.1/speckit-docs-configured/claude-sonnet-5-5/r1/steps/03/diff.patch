index 375fbcf08c06addc1f9c5d1dfc03a6b482f7bb09..9c44f401dd1cd0c0f9b3e5f16101d2fa096fec39 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -28,6 +28,46 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/** The longest title a task can have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * The title, trimmed, or an error when it is empty or longer than `MAX_TITLE_LENGTH` characters.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title cannot be empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; the limit is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority, or an error when it is not one of `PRIORITIES`.
+ *
+ * @param priority - the priority as given
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  if (!(PRIORITIES as readonly string[]).includes(priority)) {
+    return err('invalid-input', `the priority "${priority}" is not one of ${PRIORITIES.join(', ')}`);
+  }
+  return ok(priority as Priority);
+}
+
+/**
+ * The tag, or an error when it is empty or contains a space.
+ *
+ * @param tag - the tag as given
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'a tag cannot be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" cannot contain a space`);
+  return ok(tag);
+}
+
