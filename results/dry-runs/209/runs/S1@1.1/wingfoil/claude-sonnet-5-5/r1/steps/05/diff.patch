+
+# createPatch JSON Patch diff
+
+Clients want to send only what changed between two JSON documents. Export `createPatch(from, to)` from
+`src/index.ts`: it returns an RFC 6902 patch turning `from` into `to`, mutates neither input, and is
+minimal in spirit (no whole-document resend for a small change; array insert/remove yields one
+add/remove; array moves yield move or remove+add, not rewrites of items in between).
+
+Done: implemented in `src/index.ts`, tests in `test/createpatch.test.ts`, documented in `README.md`.
diff --git a/src/index.ts b/src/index.ts
index b00d9893d816a083103e76a74912c365287cc046..4c8a921c8a39233e5cfe7f6077664172a4add58b 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -275,3 +275,104 @@ function mergePatch(target: Json, patch: Json): Json {
   }
   return result;
 }
+
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: Json };
+
+function encodeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ * Neither argument is mutated and the patch shares no structure with them. Only what changed is
+ * described: object members are compared recursively, and arrays are aligned on their longest
+ * common run of equal items, so an inserted or removed item yields a single `add` or `remove`
+ * (a moved item yields a `remove` and an `add`). The result is deterministic.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  const ops: Operation[] = [];
+  diffValue(from as Json, to as Json, "", ops);
+  return ops;
+}
+
+function diffValue(from: Json, to: Json, path: string, ops: Operation[]): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) {
+        ops.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${encodeToken(key)}`;
+      if (Object.hasOwn(from, key)) {
+        diffValue(from[key], to[key], child, ops);
+      } else {
+        ops.push({ op: "add", path: child, value: clone(to[key]) });
+      }
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+function diffArray(from: Json[], to: Json[], path: string, ops: Operation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+    start++;
+  }
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && jsonEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const a = from.slice(start, endFrom);
+  const b = to.slice(start, endTo);
+
+  // lcs[i][j]: length of the longest common subsequence of a[i..] and b[j..].
+  const lcs: number[][] = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(a[i], b[j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  // `index` is the position in the array as already transformed by the operations emitted so far.
+  let index = start;
+  let i = 0;
+  let j = 0;
+  while (i < a.length || j < b.length) {
+    if (i < a.length && j < b.length && jsonEqual(a[i], b[j])) {
+      index++;
+      i++;
+      j++;
+      continue;
+    }
+    // A gap between two matches: items dropped from `a` and items new in `b`.
+    const gapA: Json[] = [];
+    const gapB: Json[] = [];
+    while (i < a.length && (j >= b.length || !jsonEqual(a[i], b[j])) && (j >= b.length || lcs[i + 1][j] >= lcs[i][j + 1])) {
+      gapA.push(a[i++]);
+    }
+    while (j < b.length && (i >= a.length || !jsonEqual(a[i], b[j]))) {
+      gapB.push(b[j++]);
+    }
+    const paired = Math.min(gapA.length, gapB.length);
+    for (let k = 0; k < paired; k++) {
+      diffValue(gapA[k], gapB[k], `${path}/${index}`, ops);
+      index++;
+    }
+    for (let k = paired; k < gapA.length; k++) {
+      ops.push({ op: "remove", path: `${path}/${index}` });
+    }
+    for (let k = paired; k < gapB.length; k++) {
+      ops.push({ op: "add", path: `${path}/${index}`, value: clone(gapB[k]) });
+      index++;
+    }
+  }
+}
