+++ b/src/index.ts
@@ -0,0 +1,47 @@
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Decodes one reference token (RFC 6901 section 4): `~1` becomes `/`, then `~0` becomes `~`. */
+function decodeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in token "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/**
+ * Returns the value that a JSON Pointer (RFC 6901) refers to in `document`.
+ *
+ * Throws an `Error` when `pointer` is not a valid JSON Pointer, or when it does not resolve to a
+ * value of the document (missing member, out-of-range or non-canonical array index, `-`, or
+ * descent into a primitive). Object members are matched on own properties only.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`);
+  }
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+
+  let current: unknown = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`JSON Pointer "${pointer}" does not resolve: no array index "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new Error(`JSON Pointer "${pointer}" does not resolve: no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve: cannot descend into a primitive`);
+    }
+  }
+  return current;
+}
