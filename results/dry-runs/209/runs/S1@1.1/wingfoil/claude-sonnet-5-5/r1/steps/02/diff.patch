+
+type Json = unknown;
+type Container = Json[] | Record<string, Json>;
+
+/** Sets an own member without ever touching the prototype (a member may be named `__proto__`). */
+function setMember(target: Record<string, Json>, key: string, value: Json): void {
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Deep copy of a JSON value, preserving own members named `__proto__`. */
+function clone(value: Json): Json {
+  if (Array.isArray(value)) {
+    return value.map(clone);
+  }
+  if (typeof value === "object" && value !== null) {
+    const copy: Record<string, Json> = {};
+    for (const key of Object.keys(value)) {
+      setMember(copy, key, clone((value as Record<string, Json>)[key]));
+    }
+    return copy;
+  }
+  return value;
+}
+
+/** JSON equality (RFC 6902 section 4.6): object member order is irrelevant. */
+function jsonEqual(a: Json, b: Json): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((x, i) => jsonEqual(x, b[i]));
+  }
+  if (typeof a === "object" && a !== null) {
+    if (typeof b !== "object" || b === null) {
+      return false;
+    }
+    const ka = Object.keys(a);
+    return (
+      ka.length === Object.keys(b).length &&
+      ka.every((k) => Object.hasOwn(b, k) && jsonEqual((a as Record<string, Json>)[k], (b as Record<string, Json>)[k]))
+    );
+  }
+  return a === b;
+}
+
+/** Resolves the parent container of the last token; every earlier token must exist. */
+function parentOf(document: Json, tokens: string[], pointer: string): Container {
+  let current = document;
+  for (const token of tokens.slice(0, -1)) {
+    current = child(current, token, pointer);
+  }
+  if (typeof current !== "object" || current === null) {
+    throw new Error(`JSON Patch: parent of "${pointer}" is not an object or array`);
+  }
+  return current as Container;
+}
+
+function child(container: Json, token: string, pointer: string): Json {
+  if (Array.isArray(container)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= container.length) {
+      throw new Error(`JSON Patch: "${pointer}" does not exist: no array index "${token}"`);
+    }
+    return container[Number(token)];
+  }
+  if (typeof container === "object" && container !== null && Object.hasOwn(container, token)) {
+    return (container as Record<string, Json>)[token];
+  }
+  throw new Error(`JSON Patch: "${pointer}" does not exist: no member "${token}"`);
+}
+
+function getAt(document: Json, pointer: string): Json {
+  return parsePointer(pointer).reduce((cur, token) => child(cur, token, pointer), document);
+}
+
+/** Adds (or, for objects, sets) a value; returns the new document. */
+function addAt(document: Json, pointer: string, value: Json): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = parentOf(document, tokens, pointer);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (token === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(token) && Number(token) <= parent.length) {
+      parent.splice(Number(token), 0, value);
+    } else {
+      throw new Error(`JSON Patch: cannot add at "${pointer}": bad array index "${token}"`);
+    }
+  } else {
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+/** Removes an existing value; returns the new document. */
+function removeAt(document: Json, pointer: string): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    throw new Error("JSON Patch: cannot remove the document root");
+  }
+  const parent = parentOf(document, tokens, pointer);
+  const token = tokens[tokens.length - 1];
+  child(parent, token, pointer);
+  if (Array.isArray(parent)) {
+    parent.splice(Number(token), 1);
+  } else {
+    delete parent[token];
+  }
+  return document;
+}
+
+/** Replaces an existing value; returns the new document. */
+function replaceAt(document: Json, pointer: string, value: Json): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = parentOf(document, tokens, pointer);
+  const token = tokens[tokens.length - 1];
+  child(parent, token, pointer);
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else {
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+function requireString(op: Record<string, Json>, member: string, index: number): string {
+  const v = op[member];
+  if (typeof v !== "string") {
+    throw new Error(`JSON Patch: operation ${index} needs a string "${member}"`);
+  }
+  return v;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the resulting document. The input and
+ * the patch are never mutated, and the result shares no structure with either. The patch is atomic:
+ * it throws an `Error` if the patch is invalid or any operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error("JSON Patch: a patch must be an array of operations");
+  }
+  let result = clone(document);
+  patch.forEach((raw: Json, index: number) => {
+    if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+      throw new Error(`JSON Patch: operation ${index} is not an object`);
+    }
+    const op = raw as Record<string, Json>;
+    const name = op.op;
+    const path = requireString(op, "path", index);
+    const needsValue = name === "add" || name === "replace" || name === "test";
+    if (needsValue && !Object.hasOwn(op, "value")) {
+      throw new Error(`JSON Patch: operation ${index} ("${name}") needs a "value"`);
+    }
+    switch (name) {
+      case "add":
+        result = addAt(result, path, clone(op.value));
+        break;
+      case "remove":
+        result = removeAt(result, path);
+        break;
+      case "replace":
+        result = replaceAt(result, path, clone(op.value));
+        break;
+      case "move": {
+        const from = requireString(op, "from", index);
+        const value = getAt(result, from);
+        if (path !== from && path.startsWith(from + "/")) {
+          throw new Error(`JSON Patch: operation ${index} cannot move "${from}" into its own child`);
+        }
+        if (path !== from) {
+          result = addAt(removeAt(result, from), path, value);
+        }
+        break;
+      }
+      case "copy": {
+        const from = requireString(op, "from", index);
+        result = addAt(result, path, clone(getAt(result, from)));
+        break;
+      }
+      case "test":
+        if (!jsonEqual(getAt(result, path), op.value)) {
+          throw new Error(`JSON Patch: test failed at "${path}" (operation ${index})`);
+        }
+        break;
+      default:
+        throw new Error(`JSON Patch: operation ${index} has unknown op ${JSON.stringify(name)}`);
+    }
+  });
+  return result;
+}
