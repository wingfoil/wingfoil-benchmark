index 0000000000000000000000000000000000000000..ba622785eab2599e002b510fea57f37237a00544
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,83 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("add", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/-", value: 2 }, { op: "add", path: "/2", value: 3 }]), [1, 2, 3]);
+  assert.equal(applyPatch({ a: 1 }, [{ op: "add", path: "", value: 5 }]), 5);
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/3", value: 0 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/01", value: 0 }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a/b", value: 0 }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 0 }]));
+});
+
+test("remove", () => {
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(applyPatch([1, 2, 3], [{ op: "remove", path: "/1" }]), [1, 3]);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/-" }]));
+});
+
+test("replace", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch([1, 2], [{ op: "replace", path: "/1", value: 9 }]), [1, 9]);
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: null }]), null);
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]));
+});
+
+test("move", () => {
+  assert.deepEqual(applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/x", path: "/y" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", path: "/y" }]));
+});
+
+test("copy", () => {
+  const doc = { a: { b: 1 } };
+  const out = applyPatch(doc, [{ op: "copy", from: "/a", path: "/c" }]) as any;
+  assert.deepEqual(out, { a: { b: 1 }, c: { b: 1 } });
+  assert.notEqual(out.a, out.c);
+  assert.throws(() => applyPatch(doc, [{ op: "copy", from: "/x", path: "/c" }]));
+});
+
+test("test", () => {
+  assert.deepEqual(applyPatch({ a: { x: 1, y: [1] } }, [{ op: "test", path: "/a", value: { y: [1], x: 1 } }]), { a: { x: 1, y: [1] } });
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "test", path: "/a", value: [1, 2] }]));
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/a", value: null }]));
+  applyPatch({ a: null }, [{ op: "test", path: "/a", value: null }]);
+});
+
+test("invalid patches", () => {
+  assert.throws(() => applyPatch({}, {} as any));
+  assert.throws(() => applyPatch({}, [null]));
+  assert.throws(() => applyPatch({}, [{ op: "nope", path: "" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "a", value: 1 }]));
+});
+
+test("does not mutate input or patch, and is atomic", () => {
+  const doc = { a: [1, { b: 2 }] };
+  const patch = [{ op: "add", path: "/c", value: { d: 1 } }, { op: "remove", path: "/a/0" }];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.notEqual(out.c, (patch[0] as any).value);
+  assert.throws(() => applyPatch(doc, [{ op: "remove", path: "/a/0" }, { op: "remove", path: "/zz" }]));
+  assert.deepEqual(doc, docCopy);
+});
+
+test("__proto__ members do not pollute", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+});
