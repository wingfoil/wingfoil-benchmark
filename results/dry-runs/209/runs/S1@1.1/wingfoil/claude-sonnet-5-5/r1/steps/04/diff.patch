@@ -0,0 +1,46 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("does not mutate inputs and does not share structure", () => {
+  const target = { a: { b: 1 } };
+  const patch = { a: { c: [1] }, d: { e: 2 } };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 } });
+  assert.deepEqual(patch, { a: { c: [1] }, d: { e: 2 } });
+  result.d.e = 9;
+  result.a.c.push(2);
+  assert.equal(patch.d.e, 2);
+  assert.deepEqual(patch.a.c, [1]);
+});
+
+test("__proto__ members are plain data", () => {
+  const patch = JSON.parse('{"__proto__": {"x": 1}}');
+  const result = applyMergePatch({}, patch) as any;
+  assert.equal(Object.hasOwn(result, "__proto__"), true);
+  assert.equal(({} as any).x, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+});
