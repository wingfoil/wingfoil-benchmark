 }
+
+function isObject(value: Json): value is Record<string, Json> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to `target` and returns the merged document as a new value;
+ * neither argument is mutated. A non-object patch replaces the target; for an object patch, a `null`
+ * member removes the key, any other member is merged recursively (arrays are replaced whole), and a
+ * non-object target is treated as `{}`.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return mergePatch(target as Json, patch as Json);
+}
+
+function mergePatch(target: Json, patch: Json): Json {
+  if (!isObject(patch)) {
+    return clone(patch);
+  }
+  const result: Record<string, Json> = isObject(target) ? (clone(target) as Record<string, Json>) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = Object.hasOwn(result, key) ? result[key] : undefined;
+      setMember(result, key, mergePatch(current as Json, value));
+    }
+  }
+  return result;
+}
