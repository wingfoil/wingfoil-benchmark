+type: task
+title: "Rental module: equipment, quote, book"
+status: approved
+format: 1
+---
+
+# Rental module: equipment, quote, book
+
+Export `createRentalService()` from `src/index.ts`: an in-memory service with `addEquipment({ id, kind, dailyPrice })`
+(`kind` is `'board'` or `'sail'`), `quote({ itemId, start, end })` and `book({ itemId, start, end })`.
+
+School rules: money in integer euro cents; times are UTC ISO-8601; whole days only (midnight UTC start and end,
+end = start of the day after the last day); no overlapping bookings of the same item; cancellation policy
+(no refund under 24 h before start, else full refund) is recorded but cancellations are out of scope.
+
+`quote` and `book` throw for an unknown item or a disallowed period; `book` also throws when the item is not free.
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1ceecef60b9d0ace8b9c781d1865cb66f122258b
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,104 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one day of rental, in integer euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  /** ISO-8601 UTC, midnight. */
+  start: string;
+  /** ISO-8601 UTC, midnight; the start of the day after the last rented day. */
+  end: string;
+}
+
+export interface Quote extends RentalRequest {
+  /** Euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00(:00(\.0+)?)?(Z|\+00:00)$/;
+
+function parseMidnight(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC time at midnight, got ${String(value)}`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a valid date: ${value}`);
+  }
+  return ms;
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item?.id !== 'string' || item.id === '') {
+    throw new Error('equipment id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error(`equipment kind must be 'board' or 'sail', got ${String(item.kind)}`);
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+  }
+}
+
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Array<Booking & { startMs: number; endMs: number }> = [];
+
+  function price(request: RentalRequest): { quote: Quote; startMs: number; endMs: number } {
+    const item = equipment.get(request?.itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${String(request?.itemId)}`);
+    }
+    const startMs = parseMidnight(request.start, 'start');
+    const endMs = parseMidnight(request.end, 'end');
+    if (endMs <= startMs) {
+      throw new Error('end must be after start');
+    }
+    const days = (endMs - startMs) / DAY_MS;
+    const quote = { itemId: item.id, start: request.start, end: request.end, total: days * item.dailyPrice };
+    return { quote, startMs, endMs };
+  }
+
+  return {
+    addEquipment(item) {
+      validateEquipment(item);
+      if (equipment.has(item.id)) {
+        throw new Error(`equipment already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, startMs, endMs } = price(request);
+      const clash = bookings.some(
+        (b) => b.itemId === quote.itemId && startMs < b.endMs && b.startMs < endMs,
+      );
+      if (clash) {
+        throw new Error(`item ${quote.itemId} is not free from ${quote.start} to ${quote.end}`);
+      }
+      const booking = { id: `booking-${bookings.length + 1}`, ...quote };
+      bookings.push({ ...booking, startMs, endMs });
+      return booking;
+    },
+  };
+}
