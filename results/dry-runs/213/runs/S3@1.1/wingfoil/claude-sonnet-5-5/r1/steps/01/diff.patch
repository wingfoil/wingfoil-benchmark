@@ -0,0 +1,69 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+const d = (day: number) => `2026-06-${String(day).padStart(2, '0')}T00:00:00.000Z`;
+
+function service() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  return s;
+}
+
+test('quote multiplies the daily price by the number of days, in cents', () => {
+  assert.deepEqual(service().quote({ itemId: 'b1', start: d(1), end: d(4) }), {
+    itemId: 'b1', start: d(1), end: d(4), total: 7500,
+  });
+});
+
+test('quote accepts times without milliseconds', () => {
+  const q = service().quote({ itemId: 'b1', start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z' });
+  assert.equal(q.total, 2500);
+});
+
+test('quote rejects unknown items and disallowed periods', () => {
+  const s = service();
+  assert.throws(() => s.quote({ itemId: 'nope', start: d(1), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-06-01T10:00:00.000Z', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(1), end: '2026-06-02T12:00:00.000Z' }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-06-01T00:00:00+02:00', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(1), end: d(1) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(3), end: d(1) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: 'garbage', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-02-30T00:00:00.000Z', end: d(2) }));
+});
+
+test('book returns a booking with its own id and does not need a quote first', () => {
+  const s = service();
+  const a = s.book({ itemId: 'b1', start: d(1), end: d(2) });
+  const b = s.book({ itemId: 'b1', start: d(2), end: d(3) });
+  assert.equal(a.total, 2500);
+  assert.equal(a.itemId, 'b1');
+  assert.notEqual(a.id, b.id);
+});
+
+test('book refuses overlapping periods on the same item only', () => {
+  const s = service();
+  s.book({ itemId: 'b1', start: d(5), end: d(8) });
+  for (const [from, to] of [[5, 8], [4, 6], [7, 9], [6, 7], [3, 10]]) {
+    assert.throws(() => s.book({ itemId: 'b1', start: d(from), end: d(to) }));
+  }
+  s.book({ itemId: 'b1', start: d(8), end: d(9) });
+  s.book({ itemId: 'b1', start: d(4), end: d(5) });
+  s.book({ itemId: 's1', start: d(5), end: d(8) });
+});
+
+test('a refused booking leaves the item free', () => {
+  const s = service();
+  assert.throws(() => s.book({ itemId: 'b1', start: d(2), end: d(2) }));
+  s.book({ itemId: 'b1', start: d(1), end: d(3) });
+});
+
+test('addEquipment validates its input', () => {
+  const s = service();
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'boat' as never, dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
+});
