@@ -155,3 +155,39 @@ test('addEquipment validates the hourly price', () => {
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
   s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 0 });
 });
+
+test('cancel refunds in full 24 h or more before the start, nothing later', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2500, hourlyPrice: 700 });
+  const a = s.book({ itemId: 'h', start: d(10), end: d(12) });
+  assert.deepEqual(s.cancel(a.id, h(9, 0)), { bookingId: a.id, refund: 5000 });
+  const b = s.book({ itemId: 'h', start: d(10), end: d(12) });
+  assert.deepEqual(s.cancel(b.id, h(9, 1)), { bookingId: b.id, refund: 0 });
+  const c = s.book({ itemId: 'h', start: h(10, 12), end: h(10, 14) });
+  assert.deepEqual(s.cancel(c.id, '2026-06-10T13:00:00Z'), { bookingId: c.id, refund: 0 });
+  const e = s.book({ itemId: 'h', start: h(10, 12), end: h(10, 14) });
+  assert.deepEqual(s.cancel(e.id, h(9, 12)), { bookingId: e.id, refund: 1400 });
+});
+
+test('a cancelled booking frees its item, and cannot be cancelled twice', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b', kind: 'board', dailyPrice: 2500 });
+  const a = s.book({ itemId: 'b', start: d(10), end: d(12) });
+  assert.deepEqual(s.availability({ start: d(10), end: d(12) }), []);
+  s.cancel(a.id, d(1));
+  assert.deepEqual(s.availability({ start: d(10), end: d(12) }), ['b']);
+  const again = s.book({ itemId: 'b', start: d(10), end: d(12) });
+  assert.notEqual(again.id, a.id);
+  assert.throws(() => s.cancel(a.id, d(2)));
+});
+
+test('cancel rejects unknown bookings and invalid times, leaving the booking active', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b', kind: 'board', dailyPrice: 2500 });
+  const a = s.book({ itemId: 'b', start: d(10), end: d(12) });
+  assert.throws(() => s.cancel('nope', d(1)));
+  assert.throws(() => s.cancel(a.id, 'yesterday'));
+  assert.throws(() => s.cancel(a.id, '2026-06-01T00:00:00+02:00'));
+  assert.deepEqual(s.availability({ start: d(10), end: d(12) }), []);
+  assert.equal(s.cancel(a.id, d(1)).refund, 5000);
+});
