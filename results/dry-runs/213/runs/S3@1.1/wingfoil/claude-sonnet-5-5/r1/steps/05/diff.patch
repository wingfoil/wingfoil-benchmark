+function parseAnyInstant(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !INSTANT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC time, got ${String(value)}`);
+  }
+  return parseInstant(value, name);
+}
