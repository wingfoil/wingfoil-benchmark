+        (b) => !b.cancelled && b.itemId === quote.itemId && startMs < b.endMs && b.startMs < endMs,
       );
       if (clash) {
         throw new Error(`item ${quote.itemId} is not free from ${quote.start} to ${quote.end}`);
@@ -169,9 +190,22 @@ export function createRentalService(): RentalService {
       }
       return [...equipment.values()]
         .filter((item) => query.kind === undefined || item.kind === query.kind)
-        .filter((item) => !bookings.some((b) => b.itemId === item.id && startMs < b.endMs && b.startMs < endMs))
+        .filter((item) => !bookings.some((b) => !b.cancelled && b.itemId === item.id && startMs < b.endMs && b.startMs < endMs))
         .map((item) => item.id)
         .sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
     },
+
+    cancel(bookingId, at) {
+      const atMs = parseAnyInstant(at, 'at');
+      const booking = bookings.find((b) => b.id === bookingId);
+      if (!booking) {
+        throw new Error(`unknown booking: ${String(bookingId)}`);
