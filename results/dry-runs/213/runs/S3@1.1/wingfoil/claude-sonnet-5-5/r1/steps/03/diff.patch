     }
     const days = (endMs - startMs) / DAY_MS;
-    const quote = { itemId: item.id, start: request.start, end: request.end, total: days * item.dailyPrice };
+    const quote = { itemId: item.id, start: request.start, end: request.end, total: rentalTotal(days, item.dailyPrice) };
     return { quote, startMs, endMs };
   }
 
