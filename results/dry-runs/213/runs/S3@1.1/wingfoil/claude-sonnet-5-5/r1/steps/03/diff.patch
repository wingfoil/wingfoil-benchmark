 const DAY_MS = 24 * 60 * 60 * 1000;
+/** Rentals of at least this many days get the long-stay discount. */
+const LONG_STAY_DAYS = 3;
+/** Long-stay discount, in percent of the full price. */
+const LONG_STAY_DISCOUNT_PERCENT = 10;
 const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00(:00(\.0+)?)?(Z|\+00:00)$/;
 
 function parseMidnight(value: unknown, name: string): number {
@@ -55,6 +59,15 @@ function parseMidnight(value: unknown, name: string): number {
   return ms;
 }
 
+/** Full price in cents, less the long-stay discount when it applies, rounded half up to a whole cent. */
+function rentalTotal(days: number, dailyPrice: number): number {
+  const full = days * dailyPrice;
+  if (days < LONG_STAY_DAYS) {
+    return full;
+  }
+  return Math.floor((full * (100 - LONG_STAY_DISCOUNT_PERCENT) + 50) / 100);
+}
+
 function validateKind(kind: unknown): void {
