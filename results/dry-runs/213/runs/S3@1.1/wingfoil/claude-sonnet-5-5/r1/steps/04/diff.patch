+const HOUR_MS = 60 * 60 * 1000;
 const DAY_MS = 24 * 60 * 60 * 1000;
 /** Rentals of at least this many days get the long-stay discount. */
 const LONG_STAY_DAYS = 3;
 /** Long-stay discount, in percent of the full price. */
 const LONG_STAY_DISCOUNT_PERCENT = 10;
 const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00(:00(\.0+)?)?(Z|\+00:00)$/;
+const HOUR_UTC = /^\d{4}-\d{2}-\d{2}T\d{2}:00(:00(\.0+)?)?(Z|\+00:00)$/;
 
 function parseMidnight(value: unknown, name: string): number {
   if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
     throw new Error(`${name} must be an ISO-8601 UTC time at midnight, got ${String(value)}`);
   }
+  return parseInstant(value, name);
+}
+
+function parseHour(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !HOUR_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC time on the hour, got ${String(value)}`);
+  }
+  return parseInstant(value, name);
+}
+
+function parseInstant(value: string, name: string): number {
   const ms = Date.parse(value);
   if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
     throw new Error(`${name} is not a valid date: ${value}`);
