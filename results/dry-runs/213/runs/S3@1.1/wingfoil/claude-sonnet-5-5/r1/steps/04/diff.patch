diff --git a/test/rental.test.ts b/test/rental.test.ts
index 0a0be9ce751dadf443e44276afb64fe4bd94ac0a..cd628f417b2d8a35c83b96e4b03e3b552977ae70 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -108,3 +108,50 @@ test('availability rejects disallowed periods and unknown kinds', () => {
   assert.throws(() => s.availability({ start: '2026-06-01T10:00:00.000Z', end: d(2) }));
   assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'kayak' as never }));
 });
+
+const h = (day: number, hour: number) => `2026-06-${String(day).padStart(2, '0')}T${String(hour).padStart(2, '0')}:00:00.000Z`;
+
+test('a rental shorter than a day is priced per hour, without the long-stay discount', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2500, hourlyPrice: 700 });
+  assert.equal(s.quote({ itemId: 'h', start: h(1, 13), end: h(1, 14) }).total, 700);
+  assert.equal(s.quote({ itemId: 'h', start: h(1, 13), end: h(1, 17) }).total, 2800);
+  assert.equal(s.quote({ itemId: 'h', start: h(1, 10), end: h(2, 9) }).total, 16100); // 23 h, across midnight
+  assert.equal(s.book({ itemId: 'h', start: h(1, 9), end: h(1, 12) }).total, 2100);
+  assert.equal(s.quote({ itemId: 'h', start: d(1), end: d(2) }).total, 2500);
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  const s = service();
+  assert.throws(() => s.quote({ itemId: 'b1', start: h(1, 13), end: h(1, 14) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: h(1, 13), end: h(1, 14) }));
+});
+
+test('hourly rentals must start and end on the hour, and a day or more stays on midnights', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2500, hourlyPrice: 700 });
+  assert.throws(() => s.quote({ itemId: 'h', start: '2026-06-01T13:30:00.000Z', end: h(1, 15) }));
+  assert.throws(() => s.quote({ itemId: 'h', start: h(1, 13), end: '2026-06-01T15:00:01.000Z' }));
+  assert.throws(() => s.quote({ itemId: 'h', start: h(1, 13), end: h(1, 13) }));
+  assert.throws(() => s.quote({ itemId: 'h', start: '2026-06-01T13:00:00+02:00', end: h(1, 15) }));
+  assert.throws(() => s.quote({ itemId: 'h', start: h(1, 10), end: h(2, 10) }));
+  assert.throws(() => s.quote({ itemId: 'h', start: h(1, 0), end: h(2, 10) }));
+});
+
+test('hourly bookings clash with overlapping ones and block availability', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2500, hourlyPrice: 700 });
+  s.book({ itemId: 'h', start: h(1, 13), end: h(1, 15) });
+  assert.throws(() => s.book({ itemId: 'h', start: h(1, 14), end: h(1, 16) }));
+  assert.throws(() => s.book({ itemId: 'h', start: d(1), end: d(2) }));
+  s.book({ itemId: 'h', start: h(1, 15), end: h(1, 16) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(2) }), []);
+  assert.deepEqual(s.availability({ start: d(2), end: d(3) }), ['h']);
+});
+
+test('addEquipment validates the hourly price', () => {
+  const s = createRentalService();
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+  s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 0 });
+});
