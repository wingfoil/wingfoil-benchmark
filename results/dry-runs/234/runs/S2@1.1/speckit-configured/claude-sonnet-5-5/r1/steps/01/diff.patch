@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { Catalog } from '../src/catalog.ts';
+import { shippingCost } from '../src/shipping.ts';
+import { lineVat } from '../src/tax.ts';
+
+test('SKU lookup is case-insensitive and trimmed', () => {
+  const catalog = new Catalog();
+  catalog.add({ sku: 'LB-220', name: 'Lamp', priceCents: 1000, vatClass: 'standard', weightGrams: 100 });
+  assert.equal(catalog.find('lb-220')?.sku, 'LB-220');
+  assert.equal(catalog.getForSale(' lb-220 ').sku, 'LB-220');
+});
+
+test('shipping is free from exactly €50.00 of goods', () => {
+  assert.equal(shippingCost(5000, 100), 0);
+  assert.equal(shippingCost(4999, 100), 490);
+});
+
+test('line VAT rounds half up', () => {
+  assert.equal(lineVat(199, 'standard'), 44);
+  assert.equal(lineVat(25, 'reduced'), 3);
+});
