diff --git a/test/fixes.test.ts b/test/fixes.test.ts
index 57b1d080a6b2279bfd18c3583e7ee4afd75b92bf..aede68533aecf2de7d05d1eb80f8670014b250b5 100644
--- a/test/fixes.test.ts
+++ b/test/fixes.test.ts
@@ -35,3 +35,26 @@ test('a coupon is redeemable on its last day, not after', async () => {
   assert.equal(coupons.redeemable('autumn', '2026-11-30', 1000).code, 'AUTUMN');
   assert.throws(() => coupons.redeemable('autumn', '2026-12-01', 1000));
 });
+
+test('cancelling an order gives its single-use coupon back for a new order', async () => {
+  const { createShop } = await import('../src/index.ts');
+  const shop = createShop();
+  shop.catalog.add({ sku: 'SH-1', name: 'Shirt', priceCents: 2000, vatClass: 'standard', weightGrams: 100 });
+  shop.inventory.restock('SH-1', 10);
+  shop.coupons.add({ code: 'WELCOME', kind: 'fixed', value: 500, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+  const first = shop.orders.place({ customer: 'Paolo', date: '2026-11-01', lines: [{ sku: 'SH-1', quantity: 1 }], coupon: 'welcome' });
+  shop.orders.cancel(first.id, '2026-11-01');
+  assert.equal(shop.coupons.usedBy('WELCOME'), undefined);
+  const second = shop.orders.place({ customer: 'Paolo', date: '2026-11-01', lines: [{ sku: 'SH-1', quantity: 1 }], coupon: 'WELCOME' });
+  assert.equal(shop.coupons.usedBy('WELCOME'), second.id);
+});
+
+test('an order whose goods come to exactly €50.00 ships free', async () => {
+  const { createShop } = await import('../src/index.ts');
+  const shop = createShop();
+  shop.catalog.add({ sku: 'SH-2', name: 'Shirt', priceCents: 2500, vatClass: 'standard', weightGrams: 100 });
+  shop.inventory.restock('SH-2', 10);
+  const order = shop.orders.place({ customer: 'Anna', date: '2026-11-01', lines: [{ sku: 'SH-2', quantity: 2 }] });
+  assert.equal(order.totals.goodsCents, 5000);
+  assert.equal(order.totals.shippingCents, 0);
+});
