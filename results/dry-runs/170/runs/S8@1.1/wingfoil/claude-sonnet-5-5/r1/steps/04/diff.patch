+++ b/test/import.test.ts
@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds valid lines, skips blanks and reports the rest by line number', () => {
+    const list = createTodoList();
+    const text = [
+      'Renew the insurance;high;admin money',
+      '',
+      'Buy milk',
+      'Walk;urgent;home',
+      ';high;',
+      'Buy milk;low;',
+      'a;b;c;d',
+      'Water plants;;garden\r',
+    ].join('\n');
+    const report = importTasks(list, text);
+    assert.equal(report.imported, 3);
+    assert.deepEqual(
+      report.rejected.map((r) => r.line),
+      [4, 5, 6, 7],
+    );
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok && insurance.value.priority === 'high');
+    assert.ok(insurance.ok && insurance.value.tags.join(',') === 'admin,money');
+    const plants = list.find('Water plants');
+    assert.ok(plants.ok && plants.value.priority === 'normal' && plants.value.tags.join() === 'garden');
+  });
+});
