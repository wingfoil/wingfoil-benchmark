@@ -0,0 +1,52 @@
+import type { TaskList } from './list.ts';
+import { validatePriority } from './task.ts';
+import type { NewTask } from './task.ts';
+
+/** A line of an import that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds to the list the tasks written in `text`, one per line as `title;priority;tags`. The priority may be
+ * empty for a normal one; the tags are separated by spaces and may be left out. Blank lines are skipped.
+ * A line that cannot be added is reported and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const parsed = parseLine(raw);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: 'error' in added ? added.error.message : '' });
+  });
+  return { imported, rejected };
+}
+
+function parseLine(raw: string):
+  | { readonly ok: true; readonly value: NewTask }
+  | { readonly ok: false; readonly error: { readonly message: string } } {
+  const fields = raw.split(';');
+  if (fields.length > 3) {
+    return { ok: false, error: { message: `the line has ${fields.length} fields: use title;priority;tags` } };
+  }
+  const [title = '', priority = '', tags = ''] = fields.map((field) => field.trim());
+  const tagList = tags === '' ? [] : tags.split(/\s+/);
+  if (priority === '') return { ok: true, value: { title, tags: tagList } };
+  const checked = validatePriority(priority);
+  if (!checked.ok) return checked;
+  return { ok: true, value: { title, priority: checked.value, tags: tagList } };
+}
