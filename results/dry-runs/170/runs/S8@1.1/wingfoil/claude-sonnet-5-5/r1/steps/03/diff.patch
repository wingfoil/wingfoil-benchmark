diff --git a/src/domain/task.ts b/src/domain/task.ts
index db952f3708890bc2c6667e81b3978ce51d4473bd..22c857b06b15833e3a47b7da05703eb7784f45fb 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -31,6 +31,71 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/** The longest title a task can have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a title: it must not be empty or only spaces, nor longer than 120 characters once trimmed.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: unknown): Result<string> {
+  if (typeof title !== 'string' || title.trim() === '') {
+    return err('invalid-input', 'the title is empty: give the task a title');
+  }
+  const trimmed = title.trim();
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long: at most ${MAX_TITLE_LENGTH} are allowed`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be `low`, `normal` or `high`.
+ *
+ * @param priority - the priority as typed
+ */
+export function validatePriority(priority: unknown): Result<Priority> {
+  const found = PRIORITIES.find((candidate) => candidate === priority);
+  if (found === undefined) {
+    return err('invalid-input', `the priority ${JSON.stringify(priority)} is not valid: use low, normal or high`);
+  }
+  return ok(found);
+}
+
+/**
+ * Checks a tag: it must not be empty, nor contain a space.
+ *
+ * @param tag - the tag as typed
+ */
+export function validateTag(tag: unknown): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'the tag is empty: give a tag');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space: a tag is a single word`);
+  return ok(tag);
+}
+
+/**
+ * Checks everything a new task is made of.
+ *
+ * @param input - the new task as typed
+ */
+export function validateNewTask(input: NewTask): Result<NewTask> {
+  const title = validateTitle(input?.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined) {
+    const priority = validatePriority(input.priority);
+    if (!priority.ok) return priority;
+  }
+  if (input.tags !== undefined && !Array.isArray(input.tags)) {
+    return err('invalid-input', 'the tags are not a list');
+  }
+  for (const tag of input.tags ?? []) {
+    const checked = validateTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok(input);
+}
+
