+
+describe('input validation', () => {
+  const rejected = (result: { ok: boolean; error?: { code: string } }) => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+  };
+
+  it('rejects bad titles, priorities and tags on add, changing nothing', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: '' }));
+    rejected(list.add({ title: '   ' }));
+    rejected(list.add({ title: 'x'.repeat(121) }));
+    rejected(list.add({ title: 'ok', priority: 'urgent' as never }));
+    rejected(list.add({ title: 'ok', tags: ['a b'] }));
+    rejected(list.add({ title: 'ok', tags: [''] }));
+    assert.equal(list.list().length, 0);
+    valueOf(list.add({ title: 'x'.repeat(120) }));
+    assert.equal(list.list().length, 1);
+  });
+
+  it('rejects bad renames and tags, changing nothing', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'Keep' }));
+    rejected(list.rename('Keep', ' '));
+    rejected(list.rename('Keep', 'x'.repeat(121)));
+    rejected(list.tag('Keep', ''));
+    rejected(list.tag('Keep', 'two words'));
+    assert.deepEqual(valueOf(list.get(before.id)), before);
+  });
+});
