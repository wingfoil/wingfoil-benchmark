+
+test('hourly rentals are priced per hour, need an hourly price, and respect overlaps', () => {
+  const s = setup();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 800 });
+  const t = (h: number) => `2026-05-01T${String(h).padStart(2, '0')}:00:00.000Z`;
+  assert.equal(s.quote({ itemId: 'h1', start: t(13), end: t(17) }).total, 3200);
+  assert.equal(s.book({ itemId: 'h1', start: t(13), end: t(17) }).total, 3200);
+  assert.equal(s.book({ itemId: 'h1', start: t(17), end: t(18) }).total, 800);
+  assert.throws(() => s.book({ itemId: 'h1', start: t(16), end: t(18) }));
+  assert.ok(!s.availability({ start: t(14), end: t(15) }).includes('h1'));
+  assert.throws(() => s.quote({ itemId: 'b1', start: t(13), end: t(17) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-05-01T13:30:00Z', end: t(17) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: t(17), end: t(13) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: t(10), end: '2026-05-02T10:00:00Z' }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: 'y', kind: 'sail', dailyPrice: 1, hourlyPrice: 1.5 }));
+});
