+
+test('availability lists free items of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 1 });
+  s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.deepEqual(s.availability({ start: d(2), end: d(4) }), ['a0', 's1']);
+  assert.deepEqual(s.availability({ start: d(2), end: d(4), kind: 'board' }), ['a0']);
+  assert.deepEqual(s.availability({ start: d(3), end: d(4), kind: 'board' }), ['a0', 'b1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(2), kind: 'sail' }), ['s1']);
+});
+
+test('availability rejects bad input', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: d(2), end: d(2) }));
+  assert.throws(() => s.availability({ start: '2026-05-01', end: d(2) }));
+  assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'kite' as any }));
+});
