@@ -136,9 +142,28 @@ export function createRentalService(): RentalService {
       if (kind !== undefined && kind !== 'board' && kind !== 'sail') throw new Error('Invalid kind');
       return [...items.values()]
         .filter((item) => kind === undefined || item.kind === kind)
-        .filter((item) => !bookings.some((b) => b.itemId === item.id && startMs < b.endMs && b.startMs < endMs))
+        .filter((item) => !bookings.some((b) => !b.cancelled && b.itemId === item.id && startMs < b.endMs && b.startMs < endMs))
         .map((item) => item.id)
         .sort();
     },
+
+    cancel(bookingId, at) {
+      const atMs = parseUtc(at, 'at');
+      const booking = bookings.find((b) => b.id === bookingId);
+      if (!booking) throw new Error(`Unknown booking: ${bookingId}`);
+      if (booking.cancelled) throw new Error(`Booking ${bookingId} is already cancelled`);
+      let refund: number;
+      if (atMs <= booking.startMs) {
+        refund = booking.total;
+      } else if (atMs >= booking.endMs) {
+        refund = 0;
+      } else {
+        const totalHours = (booking.endMs - booking.startMs) / HOUR_MS;
+        const remainingHours = (booking.endMs - atMs) / HOUR_MS;
+        refund = Math.floor((booking.total * remainingHours) / totalHours);
+      }
+      booking.cancelled = true;
+      return { bookingId, refund };
+    },
   };
