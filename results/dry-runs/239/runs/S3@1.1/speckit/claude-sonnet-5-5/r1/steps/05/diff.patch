+
+test('cancel refunds in full before the start, pro rata during, nothing after', () => {
+  const s = setup();
+  s.addEquipment({ id: 'c1', kind: 'board', dailyPrice: 2500 });
+  const b = s.book({ itemId: 'c1', start: d(1), end: d(5) });
+  assert.equal(b.total, 9000);
+  assert.deepEqual(s.cancel(b.id, d(1)), { bookingId: b.id, refund: 9000 });
+  const b2 = s.book({ itemId: 'c1', start: d(1), end: d(5) });
+  assert.equal(s.cancel(b2.id, d(2)).refund, 6750);
+  const b3 = s.book({ itemId: 'c1', start: d(1), end: d(5) });
+  assert.equal(s.cancel(b3.id, '2026-05-02T01:00:00Z').refund, Math.floor((9000 * 71) / 96));
+  const b4 = s.book({ itemId: 'c1', start: d(1), end: d(5) });
+  assert.equal(s.cancel(b4.id, d(5)).refund, 0);
+});
+
+test('cancel frees the equipment, only once, and validates input', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.throws(() => s.cancel(b.id, '2026-05-01'));
+  assert.throws(() => s.cancel(b.id, '2026-05-01T00:30:00Z'));
+  assert.ok(!s.availability({ start: d(1), end: d(3) }).includes('b1'));
+  s.cancel(b.id, d(1));
+  assert.ok(s.availability({ start: d(1), end: d(3) }).includes('b1'));
+  assert.doesNotThrow(() => s.book({ itemId: 'b1', start: d(1), end: d(3) }));
+  assert.throws(() => s.cancel(b.id, d(1)));
+  assert.throws(() => s.cancel('nope', d(1)));
+});
