+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: '5' as never }));
+  s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 0 });
+});
+
+test('hourly quote and booking price each hour without discount', () => {
+  const s = hourly();
+  assert.deepEqual(s.quote({ itemId: 'h1', start: H(14), end: H(17) }), {
+    itemId: 'h1', start: H(14), end: H(17), total: 3000,
+  });
+  assert.equal(s.quote({ itemId: 'h1', start: H(0), end: H(23) }).total, 23000);
+  assert.equal(s.quote({ itemId: 'h1', start: H(23), end: H(2, 11) }).total, 3000);
+  assert.equal(s.book({ itemId: 'h1', start: H(14), end: H(17) }).total, 3000);
+});
+
+test('whole-day pricing is unchanged for items with an hourly price', () => {
+  const s = hourly();
+  assert.equal(s.quote({ itemId: 'h1', start: D(10), end: D(11) }).total, 4000);
+  assert.equal(s.quote({ itemId: 'h1', start: D(10), end: D(13) }).total, 10800);
+});
+
+test('item without hourly price cannot be rented by the hour', () => {
+  const s = hourly();
+  assert.throws(() => s.quote({ itemId: 'b1', start: H(14), end: H(17) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: H(14), end: H(17) }));
+});
+
+test('hourly periods must be on the hour, UTC, and under a day unless at midnight', () => {
+  const s = hourly();
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-07-10T10:30:00.000Z', end: H(12) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: H(10), end: '2026-07-10T12:00:01.000Z' }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-07-10T10:00:00+02:00', end: H(12) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: H(10), end: H(10) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: H(12), end: H(10) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: H(10), end: H(10, 11) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: H(10), end: D(12) }));
+});
+
+test('hourly bookings overlap like day bookings', () => {
+  const s = hourly();
+  s.book({ itemId: 'h1', start: H(14), end: H(17) });
+  assert.throws(() => s.book({ itemId: 'h1', start: H(16), end: H(18) }));
+  s.book({ itemId: 'h1', start: H(17), end: H(18) });
+  assert.throws(() => s.book({ itemId: 'h1', start: D(10), end: D(11) }));
+});
