diff --git a/src/index.ts b/src/index.ts
index f5b6f80c46348307d3ab65e4fdac3a894c7a91cf..762294cee013d9a6320a3a64f3449d5328796663 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -25,10 +25,17 @@ export interface Booking extends Quote {
   id: string;
 }
 
+export interface AvailabilityQuery {
+  start: string;
+  end: string;
+  kind?: EquipmentKind;
+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  availability(query: AvailabilityQuery): string[];
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
@@ -49,6 +56,10 @@ export function createRentalService(): RentalService {
   const equipment = new Map<string, Equipment>();
   const bookings: (Booking & { from: number; to: number })[] = [];
 
+  function isFree(itemId: string, from: number, to: number) {
+    return !bookings.some((b) => b.itemId === itemId && from < b.to && b.from < to);
+  }
+
   function price(request: RentalRequest) {
     const item = equipment.get(request?.itemId);
     if (!item) throw new Error(`Unknown item: ${request?.itemId}`);
@@ -78,11 +89,22 @@ export function createRentalService(): RentalService {
 
     book(request) {
       const { from, to, quote } = price(request);
-      const clash = bookings.some((b) => b.itemId === quote.itemId && from < b.to && b.from < to);
-      if (clash) throw new Error(`Item ${quote.itemId} is not free for the whole period`);
+      if (!isFree(quote.itemId, from, to)) throw new Error(`Item ${quote.itemId} is not free for the whole period`);
       const booking = { id: randomUUID(), ...quote };
       bookings.push({ ...booking, from, to });
       return booking;
     },
+
+    availability(query) {
+      const from = parseMidnight(query?.start, 'start');
+      const to = parseMidnight(query.end, 'end');
+      if (to <= from) throw new Error('end must be after start');
+      const { kind } = query;
+      if (kind !== undefined && kind !== 'board' && kind !== 'sail') throw new Error("kind must be 'board' or 'sail'");
+      return [...equipment.values()]
+        .filter((item) => (kind === undefined || item.kind === kind) && isFree(item.id, from, to))
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
diff --git a/test/rental.test.ts b/test/rental.test.ts
index c54097afaa312846c1f3e07ba5de6381f2c7aed9..71128490a16ef309fdd2c6278a60ec5e7523196c 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -64,3 +64,46 @@ test('book throws for unknown item and disallowed period', () => {
   assert.throws(() => s.book({ itemId: 'nope', start: D(10), end: D(11) }));
   assert.throws(() => s.book({ itemId: 'b1', start: D(10), end: D(10) }));
 });
+
+function setupMany() {
+  const s = setup();
+  s.addEquipment({ id: 'b0', kind: 'board', dailyPrice: 3000 });
+  s.addEquipment({ id: 's0', kind: 'sail', dailyPrice: 2000 });
+  return s;
+}
+
+test('availability returns sorted ids of free items, optionally by kind', () => {
+  const s = setupMany();
+  assert.deepEqual(s.availability({ start: D(10), end: D(13) }), ['b0', 'b1', 's0', 's1']);
+  assert.deepEqual(s.availability({ start: D(10), end: D(13), kind: 'sail' }), ['s0', 's1']);
+  assert.deepEqual(s.availability({ start: D(10), end: D(13), kind: undefined }), ['b0', 'b1', 's0', 's1']);
+});
+
+test('availability excludes overlapping bookings but not back-to-back ones', () => {
+  const s = setupMany();
+  s.book({ itemId: 'b1', start: D(10), end: D(13) });
+  assert.deepEqual(s.availability({ start: D(12), end: D(14), kind: 'board' }), ['b0']);
+  assert.deepEqual(s.availability({ start: D(8), end: D(11), kind: 'board' }), ['b0']);
+  assert.deepEqual(s.availability({ start: D(9), end: D(15), kind: 'board' }), ['b0']);
+  assert.deepEqual(s.availability({ start: D(11), end: D(12), kind: 'board' }), ['b0']);
+  assert.deepEqual(s.availability({ start: D(13), end: D(15), kind: 'board' }), ['b0', 'b1']);
+  assert.deepEqual(s.availability({ start: D(8), end: D(10), kind: 'board' }), ['b0', 'b1']);
+});
+
+test('availability returns an empty list when nothing is free and does not reserve', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: D(10), end: D(13) });
+  assert.deepEqual(s.availability({ start: D(10), end: D(13), kind: 'board' }), []);
+  s.availability({ start: D(10), end: D(13), kind: 'sail' });
+  s.book({ itemId: 's1', start: D(10), end: D(13) });
+});
+
+test('availability throws for disallowed periods and invalid kind', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: '2026-07-10T10:00:00.000Z', end: D(11) }));
+  assert.throws(() => s.availability({ start: '2026-07-10T00:00:00+02:00', end: D(11) }));
+  assert.throws(() => s.availability({ start: 'garbage', end: D(11) }));
+  assert.throws(() => s.availability({ start: D(10), end: D(10) }));
+  assert.throws(() => s.availability({ start: D(11), end: D(10) }));
+  assert.throws(() => s.availability({ start: D(10), end: D(11), kind: 'kayak' as never }));
+});
