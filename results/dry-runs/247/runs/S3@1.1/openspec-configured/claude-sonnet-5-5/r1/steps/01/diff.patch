index 0000000000000000000000000000000000000000..c54097afaa312846c1f3e07ba5de6381f2c7aed9
--- /dev/null
+++ b/test/rental.test.ts
@@ -0,0 +1,66 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+const D = (day: number) => `2026-07-${String(day).padStart(2, '0')}T00:00:00.000Z`;
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 4000 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 2500 });
+  return s;
+}
+
+test('addEquipment rejects invalid kind, price and duplicate id', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'kayak' as never, dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+});
+
+test('quote multiplies daily price by days', () => {
+  const s = setup();
+  assert.deepEqual(s.quote({ itemId: 'b1', start: D(10), end: D(13) }), {
+    itemId: 'b1', start: D(10), end: D(13), total: 12000,
+  });
+  assert.equal(s.quote({ itemId: 's1', start: '2026-07-10T00:00:00Z', end: D(11) }).total, 2500);
+});
+
+test('quote throws for unknown item and disallowed periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'nope', start: D(10), end: D(11) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-10T10:00:00.000Z', end: D(11) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-10T00:00:00+02:00', end: D(11) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: 'garbage', end: D(11) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-02-30T00:00:00.000Z', end: D(11) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: D(10), end: D(10) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: D(11), end: D(10) }));
+});
+
+test('book returns a booking with unique id and the quoted total', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: D(10), end: D(13) });
+  const b = s.book({ itemId: 'b1', start: D(13), end: D(15) });
+  assert.equal(a.total, 12000);
+  assert.equal(b.total, 8000);
+  assert.notEqual(a.id, b.id);
+  assert.equal(a.itemId, 'b1');
+});
+
+test('book rejects overlaps, keeps the first booking, allows other items', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: D(10), end: D(13) });
+  assert.throws(() => s.book({ itemId: 'b1', start: D(12), end: D(14) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: D(9), end: D(11) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: D(11), end: D(12) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: D(10), end: D(13) }));
+  s.book({ itemId: 's1', start: D(10), end: D(13) });
+  s.book({ itemId: 'b1', start: D(8), end: D(10) });
+});
+
+test('book throws for unknown item and disallowed period', () => {
+  const s = setup();
+  assert.throws(() => s.book({ itemId: 'nope', start: D(10), end: D(11) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: D(10), end: D(10) }));
+});
