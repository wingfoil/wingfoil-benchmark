@@ -180,3 +180,42 @@ test('hourly bookings overlap like day bookings', () => {
   s.book({ itemId: 'h1', start: H(17), end: H(18) });
   assert.throws(() => s.book({ itemId: 'h1', start: D(10), end: D(11) }));
 });
+
+test('cancel refunds in full 24 hours or more before start, nothing later', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: D(10), end: D(13) });
+  assert.deepEqual(s.cancel(a.id, '2026-07-01T09:30:00.000Z'), { bookingId: a.id, refund: 10800 });
+  const b = s.book({ itemId: 'b1', start: D(10), end: D(13) });
+  assert.equal(s.cancel(b.id, '2026-07-09T00:00:00.000Z').refund, 10800);
+  const c = s.book({ itemId: 'b1', start: D(10), end: D(13) });
+  assert.equal(s.cancel(c.id, '2026-07-09T01:00:00.000Z').refund, 0);
+  const d = s.book({ itemId: 'b1', start: D(10), end: D(13) });
+  assert.equal(s.cancel(d.id, '2026-07-11T00:00:00.000Z').refund, 0);
+});
+
+test('cancel an hourly booking', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 4000, hourlyPrice: 1000 });
+  const a = s.book({ itemId: 'b2', start: '2026-07-10T14:00:00.000Z', end: '2026-07-10T17:00:00.000Z' });
+  assert.equal(s.cancel(a.id, '2026-07-09T14:00:00.000Z').refund, 3000);
+});
+
+test('cancel rejects unknown booking, invalid time and second cancellation', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: D(10), end: D(13) });
+  assert.throws(() => s.cancel('nope', '2026-07-01T00:00:00.000Z'));
+  assert.throws(() => s.cancel(a.id, 'garbage'));
+  assert.throws(() => s.cancel(a.id, '2026-07-01T00:00:00+02:00'));
+  assert.throws(() => s.cancel(a.id, '2026-02-30T00:00:00.000Z'));
+  assert.equal(s.availability({ start: D(10), end: D(13), kind: 'board' }).length, 0);
+  assert.equal(s.cancel(a.id, '2026-07-01T00:00:00.000Z').refund, 10800);
+  assert.throws(() => s.cancel(a.id, '2026-07-01T00:00:00.000Z'));
+});
+
+test('cancelled booking releases its equipment', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: D(10), end: D(13) });
+  s.cancel(a.id, '2026-07-01T00:00:00.000Z');
+  assert.deepEqual(s.availability({ start: D(10), end: D(13) }), ['b1', 's1']);
+  s.book({ itemId: 'b1', start: D(10), end: D(13) });
+});
