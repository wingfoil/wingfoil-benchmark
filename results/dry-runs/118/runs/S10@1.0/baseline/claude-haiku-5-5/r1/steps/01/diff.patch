+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** The items an order must come to before WELCOME5 applies. */
+const WELCOME_MINIMUM_CENTS: Cents = 3000;
+
+/** What WELCOME5 takes off an order. */
+const WELCOME_DISCOUNT_CENTS: Cents = 500;
+
+/**
+ * What a discount code takes off an order's items.
+ *
+ * @param code - the code the customer gave
+ * @param itemsCents - the order's items, before any discount
+ * @returns the discount in cents, or why the code is refused for this order
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  switch (code) {
+    case 'SPRING10':
+      // 10 % of the items, to the nearest cent with a half cent rounding up
+      return ok(Math.floor((itemsCents + 5) / 10));
+    case 'WELCOME5':
+      if (itemsCents < WELCOME_MINIMUM_CENTS) {
+        return err('invalid', `WELCOME5 needs items of ${formatEuros(WELCOME_MINIMUM_CENTS)} € or more; these come to ${formatEuros(itemsCents)} €`);
+      }
+      return ok(WELCOME_DISCOUNT_CENTS);
+    default:
+      return err('invalid', `${code} is not a discount code`);
+  }
+}
