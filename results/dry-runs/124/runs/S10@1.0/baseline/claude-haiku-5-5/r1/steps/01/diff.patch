@@ -0,0 +1,30 @@
+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** Orders whose items come to this amount or more can use `WELCOME5`. */
+export const WELCOME_MIN_ITEMS_CENTS: Cents = 3000;
+
+/** What `WELCOME5` takes off the items of an order. */
+export const WELCOME_DISCOUNT_CENTS: Cents = 500;
+
+/**
+ * What a discount code takes off an order's items.
+ *
+ * @param code - the code as the customer gave it, already trimmed and upper-cased
+ * @param itemsCents - the items of the order, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  if (code === 'SPRING10') {
+    // 10 % of the items, to the nearest cent with a half cent rounding up.
+    return ok(Math.floor((itemsCents * 10 + 50) / 100));
+  }
+  if (code === 'WELCOME5') {
+    if (itemsCents < WELCOME_MIN_ITEMS_CENTS) {
+      return err('invalid', `WELCOME5 is for orders of ${formatEuros(WELCOME_MIN_ITEMS_CENTS)} € or more`);
+    }
+    return ok(WELCOME_DISCOUNT_CENTS);
+  }
+  return err('invalid', `${code} is not a discount code`);
+}
