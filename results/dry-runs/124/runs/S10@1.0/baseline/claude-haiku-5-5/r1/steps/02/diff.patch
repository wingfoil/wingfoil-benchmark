+    exportMonth(month) {
+      if (!MONTH.test(month)) return err('invalid', `${month} is not a month (YYYY-MM)`);
+      const header = ['order', 'date', 'customer', 'email', 'phone', 'total'];
+      const lines = [header.join(',')];
+      for (const order of orders) {
+        if (!order.date.startsWith(`${month}-`)) continue;
+        const customer = customers.get(order.customerId);
+        const fields = [
+          String(order.number),
+          order.date,
+          customer.ok ? customer.value.name : '',
+          customer.ok ? customer.value.email : '',
+          customer.ok ? customer.value.phone : '',
+          formatEuros(priceOf(order).totalCents),
+        ];
+        lines.push(fields.map(csvField).join(','));
