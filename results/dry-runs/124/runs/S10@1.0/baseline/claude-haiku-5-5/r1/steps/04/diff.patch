+  it('ships free at exactly 50.00 € of items', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'FIFTY', name: 'Fifty-euro hamper', priceCents: 5000 }));
+    shop.orders.place({ customerId: 'c1', date: '2026-10-03', lines: [{ sku: 'FIFTY', quantity: 1 }] });
+    assert.equal(valueOf(shop.orders.totals(1)).shippingCents, 0);
+  });
+
+  it('counts quantities towards free shipping', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'OIL-17', name: 'Olive oil, 750 ml', priceCents: 1700 }));
+    // Three bottles of 17.00 € make 51.00 € of items.
+    shop.orders.place({ customerId: 'c1', date: '2026-10-03', lines: [{ sku: 'OIL-17', quantity: 3 }] });
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 5100, discountCents: 0, shippingCents: 0, totalCents: 5100 });
+  });
+
+  it('charges shipping just under 50.00 € of items', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'JUST-UNDER', name: 'Hamper', priceCents: 4999 }));
+    shop.orders.place({ customerId: 'c1', date: '2026-10-03', lines: [{ sku: 'JUST-UNDER', quantity: 1 }] });
+    assert.equal(valueOf(shop.orders.totals(1)).shippingCents, 490);
+  });
+
