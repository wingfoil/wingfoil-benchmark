@@ -0,0 +1,169 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { applyPatch, PatchError } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) =>
+  assert.deepStrictEqual(applyPatch(doc, patch as never), expected);
+const bad = (doc: unknown, patch: unknown, code: string) =>
+  assert.throws(
+    () => applyPatch(doc, patch as never),
+    (e: unknown) => e instanceof PatchError && e.code === code,
+  );
+
+// RFC 6902 Appendix A
+test("A.1 add object member", () =>
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" }));
+test("A.2 add array element", () =>
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] }));
+test("A.3 remove member", () =>
+  ok({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }));
+test("A.4 remove array element", () =>
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }));
+test("A.5 replace", () =>
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" }));
+test("A.6 move member", () =>
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  ));
+test("A.7 move array element", () =>
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  }));
+test("A.8 test success", () =>
+  ok({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  }));
+test("A.9 test failure", () => bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }], "OPERATION_FAILED"));
+test("A.10 add nested member object", () =>
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } }));
+test("A.11 add existing member replaces", () =>
+  ok({ foo: "bar" }, [{ op: "add", path: "/foo", value: ["bar", "baz"] }], { foo: ["bar", "baz"] }));
+test("A.12 add to nonexistent target", () =>
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }], "OPERATION_FAILED"));
+test("A.14 ~ escape", () =>
+  ok({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }));
+test("A.15 test string vs number", () => bad({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: "10" }], "OPERATION_FAILED"));
+test("A.16 add array value", () =>
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] }));
+
+test("empty patch returns equal copy", () => {
+  const d = { a: [1] };
+  const r = applyPatch(d, []);
+  assert.deepStrictEqual(r, d);
+  assert.notStrictEqual(r, d);
+  assert.notStrictEqual((r as typeof d).a, d.a);
+});
+test("whole-document add/replace/copy", () => {
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: null }], null);
+  ok({ a: 1 }, [{ op: "copy", from: "/a", path: "" }], 1);
+});
+test("add: index bounds, '-' and non-canonical indexes", () => {
+  ok([1, 2], [{ op: "add", path: "/2", value: 3 }], [1, 2, 3]);
+  ok([1, 2], [{ op: "add", path: "/0", value: 0 }], [0, 1, 2]);
+  bad([1, 2], [{ op: "add", path: "/3", value: 3 }], "OPERATION_FAILED");
+  bad([1, 2], [{ op: "add", path: "/01", value: 3 }], "OPERATION_FAILED");
+  bad([1, 2], [{ op: "add", path: "/-1", value: 3 }], "OPERATION_FAILED");
+  bad([1, 2], [{ op: "add", path: "/x", value: 3 }], "OPERATION_FAILED");
+  bad(1, [{ op: "add", path: "/a", value: 3 }], "OPERATION_FAILED");
+  bad({ a: 1 }, [{ op: "add", path: "/a/b", value: 3 }], "OPERATION_FAILED");
+});
+test("remove/replace need an existing target", () => {
+  bad({ a: 1 }, [{ op: "remove", path: "/b" }], "OPERATION_FAILED");
+  bad({ a: 1 }, [{ op: "replace", path: "/b", value: 1 }], "OPERATION_FAILED");
+  bad([1], [{ op: "remove", path: "/-" }], "OPERATION_FAILED");
+  bad([1], [{ op: "remove", path: "/1" }], "OPERATION_FAILED");
+  bad([1], [{ op: "replace", path: "/1", value: 1 }], "OPERATION_FAILED");
+  ok({ a: null }, [{ op: "remove", path: "/a" }], {});
+  ok([1, 2], [{ op: "replace", path: "/1", value: 5 }], [1, 5]);
+});
+test("move rules", () => {
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b/c" }], "OPERATION_FAILED");
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/c" }], "OPERATION_FAILED");
+  bad({ a: 1 }, [{ op: "move", from: "/x", path: "/y" }], "OPERATION_FAILED");
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  ok({ a: { b: 1 } }, [{ op: "move", from: "/a/b", path: "" }], 1);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/ab" }], { ab: 1 });
+});
+test("copy is a deep copy", () => {
+  const r = applyPatch({ a: { b: [1] } }, [{ op: "copy", from: "/a", path: "/c" }]) as { a: { b: number[] }; c: { b: number[] } };
+  assert.deepStrictEqual(r.c, r.a);
+  assert.notStrictEqual(r.c, r.a);
+  assert.notStrictEqual(r.c.b, r.a.b);
+  bad({ a: 1 }, [{ op: "copy", from: "/x", path: "/y" }], "OPERATION_FAILED");
+});
+test("test op: deep equality", () => {
+  const d = { a: { x: 1, y: [1, { z: null }] }, n: null, f: 1.0 };
+  ok(d, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }], d);
+  ok(d, [{ op: "test", path: "/n", value: null }, { op: "test", path: "/f", value: 1 }, { op: "test", path: "", value: d }], d);
+  bad(d, [{ op: "test", path: "/a/y", value: [{ z: null }, 1] }], "OPERATION_FAILED");
+  bad(d, [{ op: "test", path: "/a", value: { x: 1 } }], "OPERATION_FAILED");
+  bad(d, [{ op: "test", path: "/missing", value: null }], "OPERATION_FAILED");
+  bad(d, [{ op: "test", path: "/n", value: 0 }], "OPERATION_FAILED");
+  bad({ a: [] }, [{ op: "test", path: "/a", value: {} }], "OPERATION_FAILED");
+});
+test("invalid patches", () => {
+  bad({}, {}, "INVALID_PATCH");
+  bad({}, null, "INVALID_PATCH");
+  bad({}, [1], "INVALID_PATCH");
+  bad({}, [null], "INVALID_PATCH");
+  bad({}, [[]], "INVALID_PATCH");
+  bad({}, [{ path: "/a", value: 1 }], "INVALID_PATCH");
+  bad({}, [{ op: "bogus", path: "/a" }], "INVALID_PATCH");
+  bad({}, [{ op: "add", value: 1 }], "INVALID_PATCH");
+  bad({}, [{ op: "add", path: 1, value: 1 }], "INVALID_PATCH");
+  bad({}, [{ op: "add", path: "/a" }], "INVALID_PATCH");
+  bad({}, [{ op: "replace", path: "/a" }], "INVALID_PATCH");
+  bad({}, [{ op: "test", path: "/a" }], "INVALID_PATCH");
+  bad({}, [{ op: "move", path: "/a" }], "INVALID_PATCH");
+  bad({}, [{ op: "copy", path: "/a", from: 1 }], "INVALID_PATCH");
+  bad({}, [{ op: "add", path: "a", value: 1 }], "INVALID_PATCH");
+  bad({}, [{ op: "add", path: "/a~2", value: 1 }], "INVALID_PATCH");
+  bad({ a: 1 }, [{ op: "move", from: "a", path: "/b" }], "INVALID_PATCH");
+  bad({}, [{ op: "ADD", path: "/a", value: 1 }], "INVALID_PATCH");
+});
+test("failure is atomic", () => {
+  const d = { a: 1 };
+  bad(d, [{ op: "add", path: "/b", value: 2 }, { op: "bogus", path: "/c" }], "INVALID_PATCH");
+  bad(d, [{ op: "add", path: "/b", value: 2 }, { op: "test", path: "/a", value: 9 }], "OPERATION_FAILED");
+  assert.deepStrictEqual(d, { a: 1 });
+});
+test("does not mutate or alias document and patch", () => {
+  const d = { a: [1, { b: 2 }] };
+  const dCopy = structuredClone(d);
+  const value = { v: [1] };
+  const patch = [
+    { op: "add", path: "/a/0", value },
+    { op: "remove", path: "/a/2/b" },
+    { op: "add", path: "/c", value },
+  ];
+  const pCopy = structuredClone(patch);
+  const r = applyPatch(d, patch) as { a: unknown[]; c: typeof value };
+  assert.deepStrictEqual(d, dCopy);
+  assert.deepStrictEqual(patch, pCopy);
+  assert.notStrictEqual(r.c, value);
+  assert.notStrictEqual(r.a[0], value);
+  assert.notStrictEqual(r.a[0], r.c);
+});
+test("prototype keys are ordinary members", () => {
+  const r = applyPatch({}, [
+    { op: "add", path: "/__proto__", value: { polluted: true } },
+    { op: "add", path: "/constructor", value: 1 },
+    { op: "add", path: "/prototype", value: 2 },
+  ]) as Record<string, unknown>;
+  assert.strictEqual(({} as Record<string, unknown>).polluted, undefined);
+  assert.strictEqual(Object.getPrototypeOf(r), Object.prototype);
+  assert.deepStrictEqual(Object.keys(r), ["__proto__", "constructor", "prototype"]);
+  assert.deepStrictEqual(Object.getOwnPropertyDescriptor(r, "__proto__")?.value, { polluted: true });
+  bad({}, [{ op: "remove", path: "/__proto__" }], "OPERATION_FAILED");
+  bad({}, [{ op: "replace", path: "/constructor", value: 1 }], "OPERATION_FAILED");
+  bad({}, [{ op: "test", path: "/toString", value: 1 }], "OPERATION_FAILED");
+  bad({}, [{ op: "copy", from: "/__proto__", path: "/x" }], "OPERATION_FAILED");
+  const parsed = JSON.parse('{"__proto__":{"x":1}}');
+  const r2 = applyPatch(parsed, [{ op: "replace", path: "/__proto__/x", value: 2 }]) as object;
+  assert.strictEqual(Object.getPrototypeOf(r2), Object.prototype);
+  assert.deepStrictEqual(Object.getOwnPropertyDescriptor(r2, "__proto__")?.value, { x: 2 });
