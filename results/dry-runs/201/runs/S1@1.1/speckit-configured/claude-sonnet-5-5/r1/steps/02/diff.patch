+
+export type PatchErrorCode = "INVALID_PATCH" | "OPERATION_FAILED";
+
+/**
+ * Thrown by `applyPatch`. `INVALID_PATCH` means the patch itself is malformed
+ * (not an array, bad operation, missing member, bad pointer); `OPERATION_FAILED`
+ * means a well-formed operation could not be applied or a `test` did not match.
+ */
+export class PatchError extends Error {
+  readonly code: PatchErrorCode;
+
+  constructor(code: PatchErrorCode, message: string) {
+    super(message);
+    this.name = "PatchError";
+    this.code = code;
+  }
+}
+
+type Container = Record<string, unknown> | unknown[];
+
+const isObject = (v: unknown): v is Record<string, unknown> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+const failed = (message: string): never => {
+  throw new PatchError("OPERATION_FAILED", message);
+};
+
+function setMember(obj: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty makes `__proto__` an ordinary own member instead of a prototype setter
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Deep copy of JSON data that shares no structure with the original. */
+function clone(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(clone);
+  if (typeof value === "object" && value !== null) {
+    const out: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(out, key, clone((value as Record<string, unknown>)[key]));
+    return out;
+  }
+  return value;
+}
+
+/** JSON equality per RFC 6902 §4.6. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((k) => Object.hasOwn(b, k) && jsonEqual(a[k], b[k]))
+    );
+  }
+  return a === b;
+}
+
+function arrayIndex(token: string, arr: unknown[], allowEnd: boolean): number {
+  if (allowEnd && token === "-") return arr.length;
+  if (!ARRAY_INDEX.test(token)) return failed(`Invalid array index '${token}'`);
+  const index = Number(token);
+  if (index > arr.length || (index === arr.length && !allowEnd)) return failed(`Array index '${token}' out of range`);
+  return index;
+}
+
+/** Finds the container holding the last token of `tokens`. */
+function parentOf(doc: unknown, tokens: string[]): Container {
+  let current = doc;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      current = current[arrayIndex(token, current, false)];
+    } else if (isObject(current) && Object.hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      return failed(`Path does not exist at '${token}'`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) return failed("Parent is not an object or array");
+  return current;
+}
+
+function getAt(doc: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) return doc;
+  const parent = parentOf(doc, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) return parent[arrayIndex(token, parent, false)];
+  if (!Object.hasOwn(parent, token)) return failed(`No member '${token}'`);
+  return parent[token];
+}
+
+function addAt(doc: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(doc, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(arrayIndex(token, parent, true), 0, value);
+  else setMember(parent, token, value);
+  return doc;
+}
+
+function removeAt(doc: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) return failed("Cannot remove the whole document");
+  const parent = parentOf(doc, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(arrayIndex(token, parent, false), 1);
+  else if (Object.hasOwn(parent, token)) delete parent[token];
+  else failed(`No member '${token}'`);
+  return doc;
+}
+
+function pointerTokens(value: unknown, member: string): string[] {
+  if (typeof value !== "string") throw new PatchError("INVALID_PATCH", `'${member}' must be a string`);
+  try {
+    return parseTokens(value);
+  } catch (e) {
+    throw new PatchError("INVALID_PATCH", (e as Error).message);
+  }
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result as
+ * a new value. Operations (`add`, `remove`, `replace`, `move`, `copy`, `test`;
+ * §4) run in order, each on the result of the previous one (§3). Neither
+ * `document` nor `patch` is mutated and the result shares no structure with
+ * them. Patching is atomic (§5): on any error nothing is returned and the input
+ * is unchanged.
+ *
+ * @throws {PatchError} `INVALID_PATCH` if the patch is malformed,
+ * `OPERATION_FAILED` if an operation cannot be applied or a `test` fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new PatchError("INVALID_PATCH", "A JSON Patch must be an array");
+  let doc = clone(document);
+  for (const operation of patch as unknown[]) {
+    if (!isObject(operation)) throw new PatchError("INVALID_PATCH", "Each operation must be an object");
+    const op = operation.op;
+    const path = pointerTokens(operation.path, "path");
+    const needValue = () => {
+      if (!Object.hasOwn(operation, "value")) throw new PatchError("INVALID_PATCH", `'${String(op)}' requires 'value'`);
+      return operation.value;
+    };
+    switch (op) {
+      case "add":
+        doc = addAt(doc, path, clone(needValue()));
+        break;
+      case "remove":
+        doc = removeAt(doc, path);
+        break;
+      case "replace": {
+        const value = clone(needValue());
+        if (path.length === 0) doc = value;
+        else {
+          getAt(doc, path); // the target must exist
+          doc = addAt(removeAt(doc, path), path, value);
+        }
+        break;
+      }
+      case "move":
+      case "copy": {
+        const from = pointerTokens(operation.from, "from");
+        const value = getAt(doc, from);
+        if (op === "copy") {
+          doc = addAt(doc, path, clone(value));
+        } else {
+          if (from.length < path.length && from.every((t, i) => t === path[i])) {
+            failed("'from' must not be a proper prefix of 'path'");
+          }
+          doc = addAt(removeAt(doc, from), path, value);
+        }
+        break;
+      }
+      case "test": {
+        const expected = needValue();
+        if (!jsonEqual(getAt(doc, path), expected)) failed("Test operation did not match");
+        break;
+      }
+      default:
+        throw new PatchError("INVALID_PATCH", `Unknown operation '${String(op)}'`);
+    }
+  }
+  return doc;
+}
