@@ -0,0 +1,54 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { applyMergePatch } from "../src/index.ts";
+
+const ok = (target: unknown, patch: unknown, expected: unknown) =>
+  assert.deepStrictEqual(applyMergePatch(target, patch), expected);
+
+test("RFC 7396 Appendix A examples", () => {
+  ok({ a: "b" }, { a: "c" }, { a: "c" });
+  ok({ a: "b" }, { b: "c" }, { a: "b", b: "c" });
+  ok({ a: "b" }, { a: null }, {});
+  ok({ a: "b", b: "c" }, { a: null }, { b: "c" });
+  ok({ a: ["b"] }, { a: "c" }, { a: "c" });
+  ok({ a: "c" }, { a: ["b"] }, { a: ["b"] });
+  ok({ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } });
+  ok({ a: [{ b: "c" }] }, { a: [1] }, { a: [1] });
+  ok(["a", "b"], ["c", "d"], ["c", "d"]);
+  ok({ a: "b" }, ["c"], ["c"]);
+  ok({ a: "foo" }, null, null);
+  ok({ a: "foo" }, "bar", "bar");
+  ok({ e: null }, { a: 1 }, { e: null, a: 1 });
+  ok([1, 2], { a: "b", c: null }, { a: "b" });
+  ok({}, { a: { bb: { ccc: null } } }, { a: { bb: {} } });
+});
+
+test("empty object patch", () => {
+  ok({ a: 1 }, {}, { a: 1 });
+  ok(5, {}, {});
+});
+
+test("does not mutate or share structure", () => {
+  const target = { a: { b: 1 }, l: [1] };
+  const patch = { a: { c: { d: 1 } }, x: { y: [1] } };
+  const t = structuredClone(target);
+  const p = structuredClone(patch);
+  const r = applyMergePatch(target, patch) as any;
+  assert.deepStrictEqual(target, t);
+  assert.deepStrictEqual(patch, p);
+  assert.notStrictEqual(r.l, target.l);
+  assert.notStrictEqual(r.a.c, patch.a.c);
+  assert.notStrictEqual(r.x.y, patch.x.y);
+});
+
+test("prototype keys are ordinary members", () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":1},"constructor":{"prototype":{"p":2}}}');
+  const r = applyMergePatch({}, patch) as any;
+  assert.strictEqual(({} as any).polluted, undefined);
+  assert.strictEqual(({} as any).p, undefined);
+  assert.deepStrictEqual(Object.keys(r), ["__proto__", "constructor"]);
+  assert.deepStrictEqual(Object.getOwnPropertyDescriptor(r, "__proto__")!.value, { polluted: 1 });
+  ok({}, JSON.parse('{"__proto__":null}'), {});
+  const inherited = applyMergePatch({}, JSON.parse('{"constructor":{"a":1}}')) as any;
+  assert.deepStrictEqual(inherited.constructor, { a: 1 });
+});
