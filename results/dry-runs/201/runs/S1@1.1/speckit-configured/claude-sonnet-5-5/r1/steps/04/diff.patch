   return doc;
 }
+
+/**
+ * Applies a JSON Merge Patch to `target`, per RFC 7396 §2 (obsoletes RFC 7386).
+ * A non-object patch replaces the target; an object patch is merged member by
+ * member, with `null` removing a member. Arrays are replaced, never merged.
+ * Neither argument is mutated and the result shares no structure with them.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (typeof patch !== "object" || patch === null || Array.isArray(patch)) return clone(patch);
+  const isObject = typeof target === "object" && target !== null && !Array.isArray(target);
+  const out = isObject ? (clone(target) as Record<string, unknown>) : {};
+  const source = isObject ? (target as Record<string, unknown>) : {};
+  for (const [name, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete out[name];
+    } else {
+      const current = Object.hasOwn(source, name) ? source[name] : undefined;
+      setMember(out, name, applyMergePatch(current, value));
+    }
+  }
+  return out;
+}
