@@ -0,0 +1,59 @@
+export type PointerErrorCode = "INVALID_POINTER" | "UNRESOLVABLE";
+
+/**
+ * Thrown by `resolvePointer`. `code` tells a syntactically invalid pointer
+ * (`INVALID_POINTER`) from a valid one that references no value (`UNRESOLVABLE`).
+ */
+export class PointerError extends Error {
+  readonly code: PointerErrorCode;
+
+  constructor(code: PointerErrorCode, message: string) {
+    super(message);
+    this.name = "PointerError";
+    this.code = code;
+  }
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/**
+ * Resolves a JSON Pointer against a JSON document, per RFC 6901 (§3 syntax,
+ * §4 evaluation). The empty pointer returns the whole document. Only own
+ * properties of objects and existing array elements resolve; `-` (the
+ * nonexistent element after the last) does not. The document is not mutated
+ * and the referenced value itself is returned, not a copy.
+ *
+ * @throws {PointerError} `INVALID_POINTER` if `pointer` is not a valid JSON
+ * Pointer, `UNRESOLVABLE` if it does not resolve to a value of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new PointerError("INVALID_POINTER", "JSON Pointer must be a string");
+  }
+  if (pointer === "") return document;
+  if (pointer[0] !== "/") {
+    throw new PointerError("INVALID_POINTER", "JSON Pointer must be empty or start with '/'");
+  }
+  if (/~(?![01])/.test(pointer)) {
+    throw new PointerError("INVALID_POINTER", "'~' must be followed by '0' or '1'");
+  }
+
+  let current: unknown = document;
+  for (const raw of pointer.slice(1).split("/")) {
+    const token = raw.replace(/~1/g, "/").replace(/~0/g, "~");
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new PointerError("UNRESOLVABLE", `No array element '${token}'`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.hasOwn(current, token)) {
+        throw new PointerError("UNRESOLVABLE", `No member '${token}'`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new PointerError("UNRESOLVABLE", `Cannot take '${token}' of a non-container value`);
+    }
+  }
+  return current;
+}
