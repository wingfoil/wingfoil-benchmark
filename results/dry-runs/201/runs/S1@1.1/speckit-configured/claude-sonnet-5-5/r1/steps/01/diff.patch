index 0000000000000000000000000000000000000000..7a4240043ab5d042b7d3f643b4365a93268c6e2f
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,108 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { resolvePointer, PointerError } from "../src/index.ts";
+
+// RFC 6901 §5 sample document
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+const fails = (doc: unknown, ptr: unknown, code: string) =>
+  assert.throws(
+    () => resolvePointer(doc, ptr as string),
+    (e: unknown) => e instanceof PointerError && e.code === code,
+    `${JSON.stringify(ptr)} should fail with ${code}`,
+  );
+
+test("RFC 6901 §5 examples", () => {
+  assert.strictEqual(resolvePointer(rfc, ""), rfc);
+  assert.deepStrictEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.strictEqual(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.strictEqual(resolvePointer(rfc, "/"), 0);
+  assert.strictEqual(resolvePointer(rfc, "/a~1b"), 1);
+  assert.strictEqual(resolvePointer(rfc, "/c%d"), 2);
+  assert.strictEqual(resolvePointer(rfc, "/e^f"), 3);
+  assert.strictEqual(resolvePointer(rfc, "/g|h"), 4);
+  assert.strictEqual(resolvePointer(rfc, "/i\\j"), 5);
+  assert.strictEqual(resolvePointer(rfc, '/k"l'), 6);
+  assert.strictEqual(resolvePointer(rfc, "/ "), 7);
+  assert.strictEqual(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("null and falsy values are valid results", () => {
+  const doc = { a: null, b: false, c: 0, d: "" };
+  assert.strictEqual(resolvePointer(doc, "/a"), null);
+  assert.strictEqual(resolvePointer(doc, "/b"), false);
+  assert.strictEqual(resolvePointer(doc, "/c"), 0);
+  assert.strictEqual(resolvePointer(doc, "/d"), "");
+  assert.strictEqual(resolvePointer(null, ""), null);
+});
+
+test("escapes decode ~1 before ~0", () => {
+  assert.strictEqual(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("nested arrays and index boundaries", () => {
+  const doc = { a: [[1, 2], [3]] };
+  assert.strictEqual(resolvePointer(doc, "/a/0/1"), 2);
+  assert.strictEqual(resolvePointer(doc, "/a/1/0"), 3);
+  assert.strictEqual(resolvePointer([10, 20], "/1"), 20);
+});
+
+test("invalid pointers", () => {
+  for (const p of ["foo", "a/b", " ", "/a~", "/a~2", "/~", "/~a/b", "/a/b~"]) {
+    fails(rfc, p, "INVALID_POINTER");
+  }
+  for (const p of [undefined, null, 1, {}, ["/foo"]]) {
+    fails(rfc, p, "INVALID_POINTER");
+  }
+});
+
+test("pointers that resolve to nothing", () => {
+  fails(rfc, "/nope", "UNRESOLVABLE");
+  fails(rfc, "/foo/2", "UNRESOLVABLE");
+  fails(rfc, "/foo/-", "UNRESOLVABLE");
+  for (const p of ["/foo/00", "/foo/01", "/foo/-0", "/foo/+1", "/foo/1.0", "/foo/1e0", "/foo/ 1", "/foo/length", "/foo/", "/foo/a"]) {
+    fails(rfc, p, "UNRESOLVABLE");
+  }
+  fails(rfc, "/foo/0/x", "UNRESOLVABLE"); // string
+  fails({ a: 1 }, "/a/b", "UNRESOLVABLE"); // number
+  fails({ a: true }, "/a/b", "UNRESOLVABLE"); // boolean
+  fails({ a: null }, "/a/b", "UNRESOLVABLE"); // null
+  fails("str", "/0", "UNRESOLVABLE");
+  fails({}, "/", "UNRESOLVABLE");
+});
+
+test("inherited properties do not resolve", () => {
+  for (const k of ["__proto__", "constructor", "prototype", "toString", "hasOwnProperty"]) {
+    fails({}, `/${k}`, "UNRESOLVABLE");
+  }
+  fails({}, "/constructor/name", "UNRESOLVABLE");
+  fails({}, "/__proto__/x", "UNRESOLVABLE");
+  fails([], "/constructor", "UNRESOLVABLE");
+});
+
+test("own properties named like prototype keys resolve", () => {
+  const doc = JSON.parse('{"__proto__":{"x":1},"constructor":2}');
+  assert.deepStrictEqual(resolvePointer(doc, "/__proto__"), { x: 1 });
+  assert.strictEqual(resolvePointer(doc, "/__proto__/x"), 1);
+  assert.strictEqual(resolvePointer(doc, "/constructor"), 2);
+});
+
+test("does not mutate the document and returns the referenced value itself", () => {
+  const doc = { a: { b: [1, 2] } };
+  const snapshot = JSON.stringify(doc);
+  assert.strictEqual(resolvePointer(doc, "/a/b"), doc.a.b);
+  assert.strictEqual(JSON.stringify(doc), snapshot);
+  assert.throws(() => resolvePointer(doc, "/a/c"));
+  assert.strictEqual(JSON.stringify(doc), snapshot);
+});
