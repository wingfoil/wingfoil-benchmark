index 0000000000000000000000000000000000000000..6d8e42f42052bc2a899e8ada856d30f66f8fb26f
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,98 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepStrictEqual(from, fromCopy);
+  assert.deepStrictEqual(to, toCopy);
+  assert.deepStrictEqual(applyPatch(from, patch), to);
+  return patch;
+};
+
+test("equal documents give an empty patch", () => {
+  assert.deepStrictEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+  assert.deepStrictEqual(roundTrip({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+  assert.deepStrictEqual(roundTrip(null, null), []);
+});
+
+test("object members", () => {
+  assert.deepStrictEqual(roundTrip({ a: 1, b: 2 }, { a: 1, b: 3 }), [{ op: "replace", path: "/b", value: 3 }]);
+  assert.deepStrictEqual(roundTrip({ a: 1 }, { a: 1, b: null }), [{ op: "add", path: "/b", value: null }]);
+  assert.deepStrictEqual(roundTrip({ a: 1, b: 2 }, { a: 1 }), [{ op: "remove", path: "/b" }]);
+});
+
+test("small change deep inside is a small patch", () => {
+  const from = { a: { b: { c: [1, 2, 3], d: "x" }, e: true }, f: [1] };
+  const to = { a: { b: { c: [1, 2, 3], d: "y" }, e: true }, f: [1] };
+  assert.deepStrictEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/d", value: "y" }]);
+});
+
+test("root and type changes", () => {
+  assert.deepStrictEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepStrictEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepStrictEqual(roundTrip({ a: [] }, { a: {} }), [{ op: "replace", path: "/a", value: {} }]);
+  assert.deepStrictEqual(roundTrip({ a: null }, { a: 0 }), [{ op: "replace", path: "/a", value: 0 }]);
+});
+
+test("array insert and remove touch only that item", () => {
+  assert.deepStrictEqual(roundTrip([1, 2, 4], [1, 2, 3, 4]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepStrictEqual(roundTrip([0, 1, 2], [1, 2]), [{ op: "remove", path: "/0" }]);
+  assert.deepStrictEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepStrictEqual(roundTrip([], [1]), [{ op: "add", path: "/0", value: 1 }]);
+  assert.deepStrictEqual(roundTrip([{ a: 1 }, { b: 2 }], [{ b: 2 }]), [{ op: "remove", path: "/0" }]);
+  assert.deepStrictEqual(roundTrip([1, 1, 1], [1, 1]), [{ op: "remove", path: "/2" }]);
+});
+
+test("array item moved does not rewrite the items in between", () => {
+  const patch = roundTrip(["a", "b", "c", "d", "e"], ["b", "c", "d", "e", "a"]);
+  assert.ok(patch.length <= 2);
+  assert.ok(patch.every((o) => o.op === "move" || o.op === "add" || o.op === "remove"));
+  const patch2 = roundTrip([1, 2, 3, 4, 5, 6], [1, 5, 2, 3, 4, 6]);
+  assert.ok(patch2.length <= 2);
+});
+
+test("changed array item is diffed in place", () => {
+  assert.deepStrictEqual(roundTrip([{ a: 1, b: 2 }, 5], [{ a: 1, b: 3 }, 5]), [
+    { op: "replace", path: "/0/b", value: 3 },
+  ]);
+  assert.deepStrictEqual(roundTrip([1, 2, 3], [1, 9, 3]), [{ op: "replace", path: "/1", value: 9 }]);
+});
+
+test("pointer escaping", () => {
+  assert.deepStrictEqual(roundTrip({ "a/b": 1, "m~n": 1 }, { "a/b": 2, "m~n": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/m~0n", value: 2 },
+  ]);
+  roundTrip({ "": 1 }, { "": 2 });
+});
+
+test("prototype keys are ordinary members", () => {
+  const from = JSON.parse('{"__proto__": {"x": 1}}');
+  const to = JSON.parse('{"__proto__": {"x": 2}, "constructor": 1}');
+  roundTrip(from, to);
+  assert.strictEqual(({} as Record<string, unknown>).x, undefined);
+});
+
+test("patch shares no structure with inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to) as { value: { b: number } }[];
+  patch[0].value.b = 99;
+  assert.strictEqual(to.a.b, 1);
+});
+
+test("randomised round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff), seed % n);
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 3 : 6);
+    if (k === 0) return rnd(4);
+    if (k === 1) return ["x", "y", null, true][rnd(4)];
+    if (k === 2) return rnd(2) ? 1 : "a";
+    if (k === 3 || k === 4) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => [["a", "b", "c/", "~"][rnd(4)], gen(d + 1)]));
+  };
+  for (let i = 0; i < 2000; i++) roundTrip(gen(0), gen(0));
+});
