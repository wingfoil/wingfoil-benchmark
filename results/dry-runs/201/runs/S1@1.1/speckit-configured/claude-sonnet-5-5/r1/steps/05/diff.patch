+/** A JSON Patch operation as produced by `createPatch`. */
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+const escapeToken = (token: string): string => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+function diffValues(from: unknown, to: unknown, path: string, out: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) return diffArrays(from, to, path, out);
+  if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(from, key)) diffValues(from[key], to[key], child, out);
+      else out.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+    return;
+  }
+  out.push({ op: "replace", path, value: clone(to) });
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, out: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && jsonEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const n = endFrom - start;
+  const m = endTo - start;
+  // lcs[i][j]: length of the longest common subsequence of from[start+i..] and to[start+j..]
+  const lcs = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(from[start + i], to[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  let index = start; // position in the array as modified by the operations emitted so far
+  let i = 0;
+  let j = 0;
+  while (i < n || j < m) {
+    if (i < n && j < m && jsonEqual(from[start + i], to[start + j])) {
+      i++;
+      j++;
+      index++;
+      continue;
+    }
+    // collect a run of unmatched items on both sides up to the next common item
+    const dels: unknown[] = [];
+    const inss: unknown[] = [];
+    while ((i < n || j < m) && !(i < n && j < m && jsonEqual(from[start + i], to[start + j]))) {
+      if (j >= m || (i < n && lcs[i + 1][j] >= lcs[i][j + 1])) dels.push(from[start + i++]);
+      else inss.push(to[start + j++]);
+    }
+    const paired = Math.min(dels.length, inss.length);
+    for (let k = 0; k < paired; k++) diffValues(dels[k], inss[k], `${path}/${index++}`, out);
+    for (let k = paired; k < dels.length; k++) out.push({ op: "remove", path: `${path}/${index}` });
+    for (let k = paired; k < inss.length; k++) {
+      out.push({ op: "add", path: `${path}/${index++}`, value: clone(inss[k]) });
+    }
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied with
+ * `applyPatch`, containing only the changes. Objects are compared member by
+ * member; arrays are aligned by longest common subsequence so that an inserted
+ * or removed item yields a single `add`/`remove` (indices follow the sequential
+ * semantics of §3) and a moved item a `remove` plus an `add`. Values are
+ * compared per §4.6 and pointers escaped per RFC 6901 §3. Neither argument is
+ * mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diffValues(from, to, "", out);
+  return out;
+}
