diff --git a/test/catalog.test.ts b/test/catalog.test.ts
index 3c78feb21517c68b01432b4e6c8fdfee3e3914d9..8c1008e25b09e19ed2b007b7c0be7fff72a1557c 100644
--- a/test/catalog.test.ts
+++ b/test/catalog.test.ts
@@ -28,4 +28,12 @@ describe('catalogue', () => {
     assert.throws(() => catalog.getForSale('TEA-7'), InactiveProductError);
     assert.throws(() => catalog.get('TEA-8'), UnknownProductError);
   });
+
+  it('finds a product whatever the case or surrounding spaces of the SKU', () => {
+    const { catalog } = createShop();
+    catalog.add({ sku: 'LB-220', name: 'Lunch box', priceCents: 650, vatClass: 'standard', weightGrams: 200 });
+    assert.equal(catalog.get('lb-220').sku, 'LB-220');
+    assert.equal(catalog.getForSale(' Lb-220 ').sku, 'LB-220');
+    assert.equal(catalog.find('lb-221'), undefined);
+  });
 });
diff --git a/test/orders.test.ts b/test/orders.test.ts
index d07f06bd09b3489b674e3119a14ea7d2ced148a7..682d2746eb529ec8079137fc706b608d67e82516 100644
--- a/test/orders.test.ts
+++ b/test/orders.test.ts
@@ -79,4 +79,27 @@ describe('orders', () => {
     assert.match(text, /1 × Enamel mug \(MUG-01\)\s+€10\.00/);
     assert.match(text, /Total\s+€/);
   });
+
+  it('ships free from exactly €50.00 of goods, not below', () => {
+    const s = shop();
+    s.catalog.add({ sku: 'PEN-1', name: 'Pen', priceCents: 4999, vatClass: 'standard', weightGrams: 10 });
+    s.inventory.restock('PEN-1', 5);
+    const exact = s.orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 5 }] });
+    assert.equal(exact.totals.goodsCents, 5000);
+    assert.equal(exact.totals.shippingCents, 0);
+    const below = s.orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'PEN-1', quantity: 1 }] });
+    assert.equal(below.totals.shippingCents, 490);
+  });
+
+  it('rounds the VAT of a line half up to the cent', () => {
+    const s = shop();
+    s.catalog.add({ sku: 'CLIP-1', name: 'Clip', priceCents: 199, vatClass: 'standard', weightGrams: 1 });
+    s.catalog.add({ sku: 'PIN-1', name: 'Pin', priceCents: 25, vatClass: 'standard', weightGrams: 1 });
+    s.inventory.restock('CLIP-1', 5);
+    s.inventory.restock('PIN-1', 5);
+    const clip = s.orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'CLIP-1', quantity: 1 }] });
+    assert.equal(clip.lines[0]?.vatCents, 44);
+    const pin = s.orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'PIN-1', quantity: 1 }] });
+    assert.equal(pin.lines[0]?.vatCents, 6);
+  });
 });
