+  it('gives a single-use coupon back when its order is cancelled', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const request = { customer: 'paolo', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 2 }], coupon: 'welcome' };
+    const first = orders.place(request);
+    assert.equal(coupons.usedBy('WELCOME'), first.id);
+    assert.throws(() => orders.place(request), /already used/);
+    orders.cancel(first.id, '2026-03-02');
+    assert.equal(coupons.usedBy('WELCOME'), undefined);
+    assert.equal(orders.place(request).coupon, 'welcome');
+  });
+
+  it('ships free from exactly 50.00 of goods, and not from 49.99', () => {
+    const { orders, catalog, inventory } = shop();
+    catalog.add({ sku: 'PEN-1', name: 'Pen', priceCents: 4999, vatClass: 'standard', weightGrams: 50 });
+    inventory.restock('PEN-1', 5);
+    const exact = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 5 }] });
+    assert.equal(exact.totals.goodsCents, 5000);
+    assert.equal(exact.totals.shippingCents, 0);
+    const below = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'PEN-1', quantity: 1 }] });
+    assert.equal(below.totals.shippingCents, 490);
