index 0000000000000000000000000000000000000000..eae09e101509ec3ffb9b2f04c5cbcb817744190a
--- /dev/null
+++ b/test/rules.test.ts
@@ -0,0 +1,26 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createShop } from '../src/index.ts';
+import { shippingCost } from '../src/shipping.ts';
+import { lineVat } from '../src/tax.ts';
+
+describe('reported rule bugs', () => {
+  it('finds a product by a lower-case or padded SKU', () => {
+    const { catalog } = createShop();
+    catalog.add({ sku: 'LB-220', name: 'Lamp', priceCents: 1000, vatClass: 'standard', weightGrams: 100 });
+    assert.equal(catalog.get('lb-220').sku, 'LB-220');
+    assert.equal(catalog.getForSale(' lb-220 ').sku, 'LB-220');
+  });
+
+  it('ships free from exactly €50.00 of goods', () => {
+    assert.equal(shippingCost(5000, 500), 0);
+    assert.equal(shippingCost(4999, 500), 490);
+  });
+
+  it('rounds line VAT half up', () => {
+    assert.equal(lineVat(199, 'standard'), 44);
+    assert.equal(lineVat(125, 'reduced'), 13); // 12.5 cents
+    assert.equal(lineVat(124, 'reduced'), 12);
+  });
+});
