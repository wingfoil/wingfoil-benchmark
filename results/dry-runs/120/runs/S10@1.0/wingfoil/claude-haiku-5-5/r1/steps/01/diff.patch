+
+describe('discount codes', () => {
+  function orderOf(shop: ReturnType<typeof stocked>, sku: string, quantity = 1): number {
+    return valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku, quantity }] })).number;
+  }
+
+  it('takes 10 % off the items with SPRING10', () => {
+    const shop = stocked();
+    const number = orderOf(shop, 'OIL-1L');
+    assert.deepEqual(valueOf(shop.orders.applyCode(number, 'SPRING10')), {
+      itemsCents: 1290,
+      discountCents: 129,
+      shippingCents: 490,
+      totalCents: 1290 - 129 + 490,
+    });
+  });
+
+  it('rounds the SPRING10 discount half a cent up', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'EGG-6', name: 'Eggs, 6', priceCents: 105 }));
+    const number = orderOf(shop, 'EGG-6');
+    assert.equal(valueOf(shop.orders.applyCode(number, 'SPRING10')).discountCents, 11);
+  });
+
+  it('takes 5.00 € off a WELCOME5 order of 30.00 € or more', () => {
+    const shop = stocked();
+    const number = orderOf(shop, 'HAM-W');
+    assert.deepEqual(valueOf(shop.orders.applyCode(number, 'WELCOME5')), {
+      itemsCents: 6400,
+      discountCents: 500,
+      shippingCents: 0,
+      totalCents: 5900,
+    });
+  });
+
+  it('refuses WELCOME5 on an order under 30.00 €, and leaves the order as it was', () => {
+    const shop = stocked();
+    const number = orderOf(shop, 'OIL-1L');
+    const refused = shop.orders.applyCode(number, 'WELCOME5');
+    assert.equal(refused.ok, false);
+    if (refused.ok) return;
+    assert.equal(refused.error.code, 'invalid');
+    assert.match(refused.error.message, /30\.00/);
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 0);
+  });
+
+  it('refuses an unknown code, and leaves the order as it was', () => {
+    const shop = stocked();
+    const number = orderOf(shop, 'HAM-W');
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    const refused = shop.orders.applyCode(number, 'SUMMER50');
+    assert.equal(refused.ok, false);
+    if (refused.ok) return;
+    assert.equal(refused.error.code, 'not-found');
+    assert.match(refused.error.message, /SUMMER50/);
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 640);
+  });
+
+  it('refuses a code on an unknown order', () => {
+    const shop = stocked();
+    const refused = shop.orders.applyCode(9, 'SPRING10');
+    assert.equal(refused.ok, false);
+    if (refused.ok) return;
+    assert.equal(refused.error.code, 'not-found');
+  });
+
+  it('replaces the code an order had with a second one', () => {
+    const shop = stocked();
+    const number = orderOf(shop, 'HAM-W');
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    valueOf(shop.orders.applyCode(number, 'WELCOME5'));
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 500);
+  });
+
+  it('keeps the code an order had when a second one is refused', () => {
+    const shop = stocked();
+    const number = orderOf(shop, 'OIL-1L');
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    shop.orders.applyCode(number, 'WELCOME5');
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 129);
+  });
+
