@@ -0,0 +1,37 @@
+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** The items of an order must come to this amount or more for `WELCOME5` to apply. */
+const WELCOME_MINIMUM_CENTS: Cents = 3000;
+
+/** What `WELCOME5` takes off an order. */
+const WELCOME_DISCOUNT_CENTS: Cents = 500;
+
+/** How much a code takes off an order's items, given their total; refused when the order does not qualify. */
+type Discount = (itemsCents: Cents) => Result<Cents>;
+
+const DISCOUNTS = new Map<string, Discount>([
+  // Half a cent rounds up: integer arithmetic, so no float error.
+  ['SPRING10', (itemsCents) => ok(Math.floor((itemsCents * 10 + 50) / 100))],
+  [
+    'WELCOME5',
+    (itemsCents) =>
+      itemsCents >= WELCOME_MINIMUM_CENTS
+        ? ok(WELCOME_DISCOUNT_CENTS)
+        : err('invalid', `WELCOME5 needs items of ${formatEuros(WELCOME_MINIMUM_CENTS)} € or more`),
+  ],
+]);
+
+/**
+ * What a discount code takes off an order's items.
+ *
+ * @param code - the code the customer gave
+ * @param itemsCents - the order's items, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  const discount = DISCOUNTS.get(code);
+  if (discount === undefined) return err('not-found', `no discount code ${code}`);
+  return discount(itemsCents);
+}
