+describe('monthly export', () => {
+  it('lists the orders of the month by number, under a header line, without contact details', () => {
+    const shop = stocked();
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-10-31', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    assert.equal(
+      valueOf(shop.orders.exportMonth('2026-10')),
+      [
+        'order,date,customer,total',
+        '1,2026-10-02,Mira Holt,17.80',
+        '3,2026-10-31,Mira Holt,64.00',
+      ].join('\n'),
+    );
+  });
+
+  it('totals each order as the customer pays it, with its discount', () => {
+    const shop = stocked();
+    const number = valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'HAM-W', quantity: 1 }] })).number;
+    valueOf(shop.orders.applyCode(number, 'WELCOME5'));
+    assert.match(valueOf(shop.orders.exportMonth('2026-10')), /,59\.00$/);
+  });
+
+  it('quotes a value that contains a comma or a quote, doubling the quotes', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Oak "The Shop", Ltd', email: 'oak@example.org', phone: '' }));
+    shop.orders.place({ customerId: 'c2', date: '2026-10-05', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    assert.equal(
+      valueOf(shop.orders.exportMonth('2026-10')).split('\n')[1],
+      '1,2026-10-05,"Oak ""The Shop"", Ltd",17.80',
+    );
+  });
+
+  it('gives the header line alone for a month with no orders', () => {
+    const shop = stocked();
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    assert.equal(valueOf(shop.orders.exportMonth('2026-11')), 'order,date,customer,total');
+  });
+
+  it('refuses a month that is not YYYY-MM', () => {
+    const shop = stocked();
