diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6d902df1b0dac0bde4d311d41edc6a6507ef0c8b
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,67 @@
+/** A value that can appear in a JSON document. */
+export type JsonValue =
+  | string
+  | number
+  | boolean
+  | null
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document and returns the
+ * value it refers to.
+ *
+ * @throws {Error} if `pointer` is not a syntactically valid JSON Pointer, or
+ * if it does not resolve to a value within `document`.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  if (typeof pointer !== "string") {
+    throw new Error("A JSON Pointer must be a string");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}" must be empty or start with "/"`);
+  }
+
+  return pointer
+    .split("/")
+    .slice(1)
+    .map(decodeToken)
+    .reduce(step, document);
+}
+
+function decodeToken(rawToken: string): string {
+  if (/~(?![01])/.test(rawToken)) {
+    throw new Error(`Invalid JSON Pointer token: "${rawToken}" has an unescaped "~"`);
+  }
+  return rawToken.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function step(current: JsonValue, token: string): JsonValue {
+  if (Array.isArray(current)) {
+    if (token === "-") {
+      throw new Error('JSON Pointer does not resolve: "-" does not reference an existing array element');
+    }
+    if (!ARRAY_INDEX.test(token)) {
+      throw new Error(`Invalid JSON Pointer token: "${token}" is not a valid array index`);
+    }
+    const index = Number(token);
+    if (index >= current.length) {
+      throw new Error(`JSON Pointer does not resolve: index ${index} is out of bounds`);
+    }
+    return current[index];
+  }
+
+  if (current !== null && typeof current === "object") {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new Error(`JSON Pointer does not resolve: no member named "${token}"`);
+    }
+    return (current as { [key: string]: JsonValue })[token];
+  }
+
+  throw new Error(`JSON Pointer does not resolve: cannot traverse into "${token}" of a non-container value`);
+}
diff --git a/test/index.test.ts b/test/index.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..56bdc1c8070ac23539a9335ac242f24bc813f873
--- /dev/null
+++ b/test/index.test.ts
@@ -0,0 +1,98 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import { resolvePointer, type JsonValue } from "../src/index.ts";
+
+// Canonical example document from RFC 6901, section 5.
+const document: JsonValue = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("the empty pointer resolves to the whole document", () => {
+  assert.deepEqual(resolvePointer(document, ""), document);
+});
+
+test("a pointer resolves to a nested object member", () => {
+  assert.deepEqual(resolvePointer(document, "/foo"), ["bar", "baz"]);
+});
+
+test("a pointer resolves to an array element by index", () => {
+  assert.equal(resolvePointer(document, "/foo/0"), "bar");
+  assert.equal(resolvePointer(document, "/foo/1"), "baz");
+});
+
+test("a pointer resolves the member with the empty-string key", () => {
+  assert.equal(resolvePointer(document, "/"), 0);
+});
+
+test("~1 decodes to /", () => {
+  assert.equal(resolvePointer(document, "/a~1b"), 1);
+});
+
+test("~0 decodes to ~", () => {
+  assert.equal(resolvePointer(document, "/m~0n"), 8);
+});
+
+test("members whose keys need no escaping resolve directly", () => {
+  assert.equal(resolvePointer(document, "/c%d"), 2);
+  assert.equal(resolvePointer(document, "/e^f"), 3);
+  assert.equal(resolvePointer(document, "/g|h"), 4);
+  assert.equal(resolvePointer(document, "/i\\j"), 5);
+  assert.equal(resolvePointer(document, '/k"l'), 6);
+  assert.equal(resolvePointer(document, "/ "), 7);
+});
+
+test("~1 is decoded before ~0, so ~01 decodes to the literal key ~1", () => {
+  const doc: JsonValue = { "~1": "literal-tilde-one" };
+  assert.equal(resolvePointer(doc, "/~01"), "literal-tilde-one");
+});
+
+test("a pointer can traverse nested objects and arrays together", () => {
+  const nested: JsonValue = { a: [{ b: "c" }, { b: "d" }] };
+  assert.equal(resolvePointer(nested, "/a/1/b"), "d");
+});
+
+test("throws when the pointer is not a string", () => {
+  assert.throws(() => resolvePointer(document, null as unknown as string));
+});
+
+test("throws when a non-empty pointer does not start with /", () => {
+  assert.throws(() => resolvePointer(document, "foo"));
+});
+
+test("throws when a token has an unescaped ~", () => {
+  assert.throws(() => resolvePointer(document, "/foo~2bar"));
+});
+
+test("throws when an object member does not exist", () => {
+  assert.throws(() => resolvePointer(document, "/missing"));
+});
+
+test("throws when traversing past a non-container value", () => {
+  assert.throws(() => resolvePointer(document, "/foo/0/bar"));
+});
+
+test("throws when an array index is out of bounds", () => {
+  assert.throws(() => resolvePointer(document, "/foo/2"));
+});
+
+test("throws when an array index has a leading zero", () => {
+  assert.throws(() => resolvePointer(document, "/foo/01"));
+});
+
+test("throws when an array index is not numeric", () => {
+  assert.throws(() => resolvePointer(document, "/foo/bar"));
+});
+
+test("throws on the - token, which never references an existing array element", () => {
+  assert.throws(() => resolvePointer(document, "/foo/-"));
+});
