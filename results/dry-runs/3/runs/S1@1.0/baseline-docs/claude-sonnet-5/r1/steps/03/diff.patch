 function move(document: JsonValue, from: string, path: string): JsonValue {
+  if (isProperPrefix(parsePointer(from), parsePointer(path))) {
+    throw new Error(`JSON Patch "move" failed: "from" ("${from}") cannot be a proper prefix of "path" ("${path}")`);
