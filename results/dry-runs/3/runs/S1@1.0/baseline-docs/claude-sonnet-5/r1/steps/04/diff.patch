new file mode 100644
index 0000000000000000000000000000000000000000..af0223df225a11a02b6639a9d293314f1699d291
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,94 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import { applyMergePatch, type JsonValue } from "../src/index.ts";
+
+// Examples are drawn from RFC 7386, Appendix A, unless noted otherwise.
+
+test("A.1: replacing a member's value", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: "c" }), { a: "c" });
+});
+
+test("A.2: adding a new member", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { b: "c" }), { a: "b", b: "c" });
+});
+
+test("A.3: a null value removes an existing member", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, { a: null }), {});
+});
+
+test("A.4: a null value removes only the targeted member", () => {
+  assert.deepEqual(applyMergePatch({ a: "b", b: "c" }, { a: null }), { b: "c" });
+});
+
+test("A.5: a scalar patch value replaces an array wholesale", () => {
+  assert.deepEqual(applyMergePatch({ a: ["b"] }, { a: "c" }), { a: "c" });
+});
+
+test("A.6: an array patch value replaces a scalar wholesale", () => {
+  assert.deepEqual(applyMergePatch({ a: "c" }, { a: ["b"] }), { a: ["b"] });
+});
+
+test("A.7: nested objects are merged member-by-member", () => {
+  const target: JsonValue = { a: { b: "c" } };
+  const patch: JsonValue = { a: { b: "d", c: null } };
+  assert.deepEqual(applyMergePatch(target, patch), { a: { b: "d" } });
+});
+
+test("A.8: arrays are replaced wholesale, never merged element-by-element", () => {
+  const target: JsonValue = { a: [{ b: "c" }] };
+  const patch: JsonValue = { a: [1] };
+  assert.deepEqual(applyMergePatch(target, patch), { a: [1] });
+});
+
+test("A.9: a top-level array patch replaces the whole document", () => {
+  assert.deepEqual(applyMergePatch(["a", "b"], ["c", "d"]), ["c", "d"]);
+});
+
+test("A.10: a top-level array patch replaces a top-level object target", () => {
+  assert.deepEqual(applyMergePatch({ a: "b" }, ["c"]), ["c"]);
+});
+
+test("A.11: a null patch replaces the whole document with null", () => {
+  assert.equal(applyMergePatch({ a: "foo" }, null), null);
+});
+
+test("A.12: a scalar patch replaces the whole document", () => {
+  assert.equal(applyMergePatch({ a: "foo" }, "bar"), "bar");
+});
+
+test("A.13: an existing null member is left untouched by an unrelated addition", () => {
+  assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+});
+
+test("A.14: a nested null member removes only the innermost target, pruning no ancestors", () => {
+  const patch: JsonValue = { a: { bb: { ccc: null } } };
+  assert.deepEqual(applyMergePatch({}, patch), { a: { bb: {} } });
+});
+
+test("a non-object target is discarded when the patch is an object", () => {
+  assert.deepEqual(applyMergePatch("scalar", { a: "b" }), { a: "b" });
+});
+
+test("applyMergePatch does not mutate the input target", () => {
+  const target: JsonValue = { a: { b: "c" } };
+  const original = structuredClone(target);
+  applyMergePatch(target, { a: { b: "d" } });
+  assert.deepEqual(target, original);
+});
+
+test("applyMergePatch does not mutate the input patch", () => {
+  const target: JsonValue = { a: "b" };
+  const patch: JsonValue = { a: { nested: true } };
+  const original = structuredClone(patch);
+  applyMergePatch(target, patch);
+  assert.deepEqual(patch, original);
+});
+
+test("the result shares no structure with the patch, so later mutation of one does not affect the other", () => {
+  const target: JsonValue = {};
+  const patch: JsonValue = { a: { nested: ["x"] } };
+  const result = applyMergePatch(target, patch) as { a: { nested: string[] } };
+  result.a.nested.push("y");
+  assert.deepEqual(patch, { a: { nested: ["x"] } });
+});
