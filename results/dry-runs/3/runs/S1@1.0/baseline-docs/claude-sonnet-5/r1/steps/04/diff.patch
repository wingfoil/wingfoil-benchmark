+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the
+ * resulting document as a new value. `target` is not mutated.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (patch === null || typeof patch !== "object" || Array.isArray(patch)) {
+    return structuredClone(patch);
+  }
+
+  const merged: JsonObject = target !== null && typeof target === "object" && !Array.isArray(target) ? { ...target } : {};
+  for (const [key, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete merged[key];
+    } else {
+      merged[key] = applyMergePatch(merged[key] ?? null, value);
+    }
+  }
+  return merged;
+}
