index 0000000000000000000000000000000000000000..922d00c7b0ca5612407a4de6e1eeb2688363254e
--- /dev/null
+++ b/test/apply-patch.test.ts
@@ -0,0 +1,211 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import { applyPatch, type JsonValue } from "../src/index.ts";
+
+// Examples are drawn from RFC 6902, Appendix A, unless noted otherwise.
+
+test("A.1: adding an object member", () => {
+  const document: JsonValue = { foo: "bar" };
+  const result = applyPatch(document, [{ op: "add", path: "/baz", value: "qux" }]);
+  assert.deepEqual(result, { baz: "qux", foo: "bar" });
+});
+
+test("A.2: adding an array element", () => {
+  const document: JsonValue = { foo: ["bar", "baz"] };
+  const result = applyPatch(document, [{ op: "add", path: "/foo/1", value: "qux" }]);
+  assert.deepEqual(result, { foo: ["bar", "qux", "baz"] });
+});
+
+test("A.3: removing an object member", () => {
+  const document: JsonValue = { baz: "qux", foo: "bar" };
+  const result = applyPatch(document, [{ op: "remove", path: "/baz" }]);
+  assert.deepEqual(result, { foo: "bar" });
+});
+
+test("A.4: removing an array element", () => {
+  const document: JsonValue = { foo: ["bar", "qux", "baz"] };
+  const result = applyPatch(document, [{ op: "remove", path: "/foo/1" }]);
+  assert.deepEqual(result, { foo: ["bar", "baz"] });
+});
+
+test("A.5: replacing a value", () => {
+  const document: JsonValue = { baz: "qux", foo: "bar" };
+  const result = applyPatch(document, [{ op: "replace", path: "/baz", value: "boo" }]);
+  assert.deepEqual(result, { baz: "boo", foo: "bar" });
+});
+
+test("A.6: moving a value", () => {
+  const document: JsonValue = {
+    foo: { bar: "baz", waldo: "fred" },
+    qux: { corge: "grault" },
+  };
+  const result = applyPatch(document, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]);
+  assert.deepEqual(result, {
+    foo: { bar: "baz" },
+    qux: { corge: "grault", thud: "fred" },
+  });
+});
+
+test("A.7: moving an array element", () => {
+  const document: JsonValue = { foo: ["all", "grass", "cows", "eat"] };
+  const result = applyPatch(document, [{ op: "move", from: "/foo/1", path: "/foo/3" }]);
+  assert.deepEqual(result, { foo: ["all", "cows", "eat", "grass"] });
+});
+
+test("A.8: testing a value succeeds and leaves the document unchanged", () => {
+  const document: JsonValue = { baz: "qux", foo: ["a", 2, "c"] };
+  const result = applyPatch(document, [
+    { op: "test", path: "/baz", value: "qux" },
+    { op: "test", path: "/foo/1", value: 2 },
+  ]);
+  assert.deepEqual(result, document);
+});
+
+test("A.9: a failing test operation throws", () => {
+  const document: JsonValue = { baz: "qux" };
+  assert.throws(() => applyPatch(document, [{ op: "test", path: "/baz", value: "bar" }]));
+});
+
+test("A.10: adding a nested member object", () => {
+  const document: JsonValue = { foo: "bar" };
+  const result = applyPatch(document, [{ op: "add", path: "/child", value: { grandchild: {} } }]);
+  assert.deepEqual(result, { foo: "bar", child: { grandchild: {} } });
+});
+
+test("A.12: adding to a nonexistent target throws", () => {
+  const document: JsonValue = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "add", path: "/baz/bat", value: "qux" }]));
+});
+
+test("A.14: ~ escape ordering lets /~01 address the member literally named ~1", () => {
+  const document: JsonValue = { "/": 9, "~1": 10 };
+  const result = applyPatch(document, [{ op: "test", path: "/~01", value: 10 }]);
+  assert.deepEqual(result, document);
+});
+
+test("A.15: comparing a string and a number in a test operation fails", () => {
+  const document: JsonValue = { "/": 9, "~1": 10 };
+  assert.throws(() => applyPatch(document, [{ op: "test", path: "/~01", value: "10" }]));
+});
+
+test("A.16: adding a composite array value", () => {
+  const document: JsonValue = { foo: ["bar"] };
+  const result = applyPatch(document, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]);
+  assert.deepEqual(result, { foo: ["bar", ["abc", "def"]] });
+});
+
+test("add at the root path replaces the whole document", () => {
+  const document: JsonValue = { foo: "bar" };
+  const result = applyPatch(document, [{ op: "add", path: "", value: { baz: "qux" } }]);
+  assert.deepEqual(result, { baz: "qux" });
+});
+
+test("replace at the root path replaces the whole document", () => {
+  const document: JsonValue = { foo: "bar" };
+  const result = applyPatch(document, [{ op: "replace", path: "", value: { baz: "qux" } }]);
+  assert.deepEqual(result, { baz: "qux" });
+});
+
+test("remove at the root path throws", () => {
+  const document: JsonValue = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "remove", path: "" }]));
+});
+
+test("replace of a value that does not exist throws", () => {
+  const document: JsonValue = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "replace", path: "/baz", value: "qux" }]));
+});
+
+test("copying a value duplicates it without removing the source", () => {
+  const document: JsonValue = { foo: ["bar", "baz"] };
+  const result = applyPatch(document, [{ op: "copy", from: "/foo/0", path: "/foo/-" }]);
+  assert.deepEqual(result, { foo: ["bar", "baz", "bar"] });
+});
+
+test("copying a composite value deep-copies it, so later mutation of one does not affect the other", () => {
+  const document: JsonValue = { foo: { nested: ["a"] }, bar: null };
+  const result = applyPatch(document, [
+    { op: "copy", from: "/foo", path: "/bar" },
+    { op: "add", path: "/bar/nested/0", value: "z" },
+  ]);
+  assert.deepEqual(result, {
+    foo: { nested: ["a"] },
+    bar: { nested: ["z", "a"] },
+  });
+});
+
+test("moving a value into one of its own children throws", () => {
+  const document: JsonValue = { foo: { bar: "baz" } };
+  assert.throws(() => applyPatch(document, [{ op: "move", from: "/foo", path: "/foo/bar" }]));
+});
+
+test("applyPatch does not mutate the input document", () => {
+  const document: JsonValue = { foo: ["bar", "baz"] };
+  const original = structuredClone(document);
+  applyPatch(document, [
+    { op: "add", path: "/foo/0", value: "new" },
+    { op: "remove", path: "/foo/2" },
+    { op: "replace", path: "/foo/1", value: "changed" },
+  ]);
+  assert.deepEqual(document, original);
+});
+
+test("applyPatch does not mutate the input patch", () => {
+  const document: JsonValue = { foo: "bar" };
+  const patch: JsonValue = [{ op: "add", path: "/baz", value: { nested: true } }];
+  const original = structuredClone(patch);
+  applyPatch(document, patch);
+  assert.deepEqual(patch, original);
+});
+
+test("applying several operations in sequence composes their effects", () => {
+  const document: JsonValue = { items: ["a", "b", "c"] };
+  const result = applyPatch(document, [
+    { op: "add", path: "/items/-", value: "d" },
+    { op: "remove", path: "/items/0" },
+    { op: "replace", path: "/items/0", value: "B" },
+  ]);
+  assert.deepEqual(result, { items: ["B", "c", "d"] });
+});
+
+test("if an operation in the middle of a patch fails, the whole patch is rejected", () => {
+  const document: JsonValue = { foo: "bar" };
+  assert.throws(() =>
+    applyPatch(document, [
+      { op: "add", path: "/baz", value: "qux" },
+      { op: "remove", path: "/missing" },
+    ]),
+  );
+});
+
+test("throws when the patch is not an array", () => {
+  const document: JsonValue = { foo: "bar" };
+  assert.throws(() => applyPatch(document, { op: "add", path: "/baz", value: "qux" } as unknown as JsonValue));
+});
+
+test("throws when an operation has an unrecognized op", () => {
+  const document: JsonValue = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "frobnicate", path: "/foo" } as unknown as JsonValue]));
+});
+
+test("throws when an add operation is missing its value", () => {
+  const document: JsonValue = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "add", path: "/baz" } as unknown as JsonValue]));
+});
+
+test("throws when an operation is missing its path", () => {
+  const document: JsonValue = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "remove" } as unknown as JsonValue]));
+});
+
+test("throws when a move operation is missing its from member", () => {
+  const document: JsonValue = { foo: "bar" };
+  assert.throws(() => applyPatch(document, [{ op: "move", path: "/baz" } as unknown as JsonValue]));
+});
+
+test("an explicit null value is a valid value, distinct from a missing value", () => {
+  const document: JsonValue = { foo: "bar" };
+  const result = applyPatch(document, [{ op: "add", path: "/baz", value: null }]);
+  assert.deepEqual(result, { foo: "bar", baz: null });
+});
