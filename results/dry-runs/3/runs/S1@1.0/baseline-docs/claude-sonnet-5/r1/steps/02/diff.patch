+
+type JsonObject = { [key: string]: JsonValue };
+
+/** A single operation of a JSON Patch (RFC 6902). */
+export type JsonPatchOperation =
+  | { op: "add"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "replace"; path: string; value: JsonValue }
+  | { op: "move"; from: string; path: string }
+  | { op: "copy"; from: string; path: string }
+  | { op: "test"; path: string; value: JsonValue };
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the
+ * resulting document as a new value. `document` is not mutated.
+ *
+ * @throws {Error} if `patch` is not a syntactically valid JSON Patch, or if
+ * one of its operations fails (for example, a "test" operation whose value
+ * does not match, or a "remove" of a path that does not exist).
+ */
+export function applyPatch(document: JsonValue, patch: JsonValue): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("A JSON Patch must be an array of operations");
+  }
+
+  return patch.map(parseOperation).reduce(applyOperation, document);
+}
+
+function parseOperation(raw: JsonValue): JsonPatchOperation {
+  if (raw === null || typeof raw !== "object" || Array.isArray(raw)) {
+    throw new Error("Invalid JSON Patch operation: each operation must be an object");
+  }
+
+  const op = raw.op;
+  switch (op) {
+    case "add":
+      return { op, path: requireString(raw, "path", 'an "add" operation'), value: requireValue(raw, 'an "add" operation') };
+    case "remove":
+      return { op, path: requireString(raw, "path", 'a "remove" operation') };
+    case "replace":
+      return {
+        op,
+        path: requireString(raw, "path", 'a "replace" operation'),
+        value: requireValue(raw, 'a "replace" operation'),
+      };
+    case "move":
+      return { op, from: requireString(raw, "from", 'a "move" operation'), path: requireString(raw, "path", 'a "move" operation') };
+    case "copy":
+      return { op, from: requireString(raw, "from", 'a "copy" operation'), path: requireString(raw, "path", 'a "copy" operation') };
+    case "test":
+      return {
+        op,
+        path: requireString(raw, "path", 'a "test" operation'),
+        value: requireValue(raw, 'a "test" operation'),
+      };
+    default:
+      throw new Error(`Invalid JSON Patch operation: unknown "op" value ${JSON.stringify(op)}`);
+  }
+}
+
+function requireString(raw: JsonObject, key: string, context: string): string {
+  const value = raw[key];
+  if (typeof value !== "string") {
+    throw new Error(`Invalid JSON Patch operation: "${key}" must be a string in ${context}`);
+  }
+  return value;
+}
+
+function requireValue(raw: JsonObject, context: string): JsonValue {
+  if (!Object.prototype.hasOwnProperty.call(raw, "value")) {
+    throw new Error(`Invalid JSON Patch operation: "value" is required in ${context}`);
+  }
+  return raw.value;
+}
+
+function applyOperation(document: JsonValue, operation: JsonPatchOperation): JsonValue {
+  switch (operation.op) {
+    case "add":
+      return add(document, operation.path, operation.value);
+    case "remove":
+      return remove(document, operation.path);
+    case "replace":
+      return replace(document, operation.path, operation.value);
+    case "move":
+      return move(document, operation.from, operation.path);
+    case "copy":
+      return copy(document, operation.from, operation.path);
+    case "test":
+      return test(document, operation.path, operation.value);
+  }
+}
+
+function add(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(path);
+  const addedValue = structuredClone(value);
+  if (tokens.length === 0) {
+    return addedValue;
+  }
+  return updateContainer(document, tokens, (parent, token) => addMember(parent, token, addedValue));
+}
+
+function remove(document: JsonValue, path: string): JsonValue {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    throw new Error('JSON Patch "remove" failed: the root document cannot be removed');
+  }
+  return updateContainer(document, tokens, removeMember);
+}
+
+function replace(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(path);
+  const replacedValue = structuredClone(value);
+  if (tokens.length === 0) {
+    return replacedValue;
+  }
+  return updateContainer(document, tokens, (parent, token) => replaceMember(parent, token, replacedValue));
+}
+
+function move(document: JsonValue, from: string, path: string): JsonValue {
+  const value = resolvePointer(document, from);
+  return add(remove(document, from), path, value);
+}
+
+function copy(document: JsonValue, from: string, path: string): JsonValue {
+  return add(document, path, resolvePointer(document, from));
+}
+
+function test(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  if (!deepEqual(resolvePointer(document, path), value)) {
+    throw new Error(`JSON Patch "test" failed: value at "${path}" does not match`);
+  }
+  return document;
+}
+
+/**
+ * Rebuilds `document` with the member identified by the last of `tokens`
+ * replaced by the result of `mutateLast`, applied to its immediate
+ * container. All but the last token must already resolve to a container
+ * within `document`; the last token is left for `mutateLast` to interpret,
+ * since add/remove/replace each give it different meaning (for example,
+ * "add" may reference a not-yet-existing member, but "remove" may not).
+ */
+function updateContainer(
+  document: JsonValue,
+  tokens: string[],
+  mutateLast: (parent: JsonValue, token: string) => JsonValue,
+): JsonValue {
+  const [token, ...rest] = tokens;
+  if (rest.length === 0) {
+    return mutateLast(document, token);
+  }
+  const newChild = updateContainer(step(document, token), rest, mutateLast);
+  return setMember(document, token, newChild);
+}
+
+function setMember(parent: JsonValue, token: string, value: JsonValue): JsonValue {
+  if (Array.isArray(parent)) {
+    const copy = parent.slice();
+    copy[Number(token)] = value;
+    return copy;
+  }
+  return { ...(parent as JsonObject), [token]: value };
+}
+
+function addMember(parent: JsonValue, token: string, value: JsonValue): JsonValue {
+  if (Array.isArray(parent)) {
+    if (token === "-") {
+      return [...parent, value];
+    }
+    const index = arrayIndex(token);
+    if (index > parent.length) {
+      throw new Error(`JSON Patch "add" failed: index ${index} is out of bounds`);
+    }
+    return [...parent.slice(0, index), value, ...parent.slice(index)];
+  }
+  if (parent !== null && typeof parent === "object") {
+    return { ...parent, [token]: value };
+  }
+  throw new Error('JSON Patch "add" failed: cannot add a member to a non-container value');
+}
+
+function removeMember(parent: JsonValue, token: string): JsonValue {
+  if (Array.isArray(parent)) {
+    const index = arrayIndex(token);
+    if (index >= parent.length) {
+      throw new Error(`JSON Patch "remove" failed: index ${index} is out of bounds`);
+    }
+    return [...parent.slice(0, index), ...parent.slice(index + 1)];
+  }
+  if (parent !== null && typeof parent === "object") {
+    if (!Object.prototype.hasOwnProperty.call(parent, token)) {
+      throw new Error(`JSON Patch "remove" failed: no member named "${token}"`);
+    }
+    const copy = { ...parent };
+    delete copy[token];
+    return copy;
+  }
+  throw new Error('JSON Patch "remove" failed: cannot remove a member from a non-container value');
+}
+
+function replaceMember(parent: JsonValue, token: string, value: JsonValue): JsonValue {
+  if (Array.isArray(parent)) {
+    const index = arrayIndex(token);
+    if (index >= parent.length) {
+      throw new Error(`JSON Patch "replace" failed: index ${index} is out of bounds`);
+    }
+    const copy = parent.slice();
+    copy[index] = value;
+    return copy;
+  }
+  if (parent !== null && typeof parent === "object") {
+    if (!Object.prototype.hasOwnProperty.call(parent, token)) {
+      throw new Error(`JSON Patch "replace" failed: no member named "${token}"`);
+    }
+    return { ...parent, [token]: value };
+  }
+  throw new Error('JSON Patch "replace" failed: cannot replace a member of a non-container value');
+}
+
+function arrayIndex(token: string): number {
+  if (!ARRAY_INDEX.test(token)) {
+    throw new Error(`Invalid JSON Pointer token: "${token}" is not a valid array index`);
+  }
+  return Number(token);
+}
+
+function deepEqual(a: JsonValue, b: JsonValue): boolean {
+  if (a === b) {
+    return true;
+  }
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((value, i) => deepEqual(value, b[i]));
+  }
+  if (a !== null && b !== null && typeof a === "object" && typeof b === "object") {
+    const aKeys = Object.keys(a);
+    const bKeys = Object.keys(b);
+    return (
+      aKeys.length === bKeys.length &&
+      aKeys.every((key) => Object.prototype.hasOwnProperty.call(b, key) && deepEqual((a as JsonObject)[key], (b as JsonObject)[key]))
+    );
+  }
+  return false;
+}
diff --git a/test/apply-patch.test.ts b/test/apply-patch.test.ts
