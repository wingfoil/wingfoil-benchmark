+
+function serviceWithHourlyBoard() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  return service;
+}
+
+test('a rental by the hour is priced at the hourly price for each hour', () => {
+  const service = serviceWithHourlyBoard();
+  const request = { itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T13:00:00Z' };
+  assert.equal(service.quote(request).total, 1800);
+  const booking = service.book(request);
+  assert.deepEqual(
+    { itemId: booking.itemId, start: booking.start, end: booking.end, total: booking.total },
+    { itemId: 'board-1', start: request.start, end: request.end, total: 1800 },
+  );
+});
+
+test('an hourly rental from midnight is not priced as a day', () => {
+  const service = serviceWithHourlyBoard();
+  assert.equal(service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-01T05:00:00Z' }).total, 3000);
+  // Almost a whole day, still by the hour and without the long-rental discount.
+  assert.equal(service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-01T23:00:00Z' }).total, 13800);
+});
+
+test('a rental by the hour must be shorter than a day', () => {
+  const service = serviceWithHourlyBoard();
+  assert.throws(
+    () => service.quote({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-02T10:00:00Z' }),
+    /shorter than a day/,
+  );
+  assert.throws(
+    () => service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T12:00:00Z' }),
+    /shorter than a day/,
+  );
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  const service = serviceWithBoard();
+  const request = { itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' };
+  assert.throws(() => service.quote(request), /by the hour/);
+  assert.throws(() => service.book(request), /by the hour/);
+});
+
+test('availability by the hour leaves out items without an hourly price', () => {
+  const service = serviceWithHourlyBoard();
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+  const hours = { start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' };
+  assert.deepEqual(service.availability(hours), ['board-1']);
+  assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-02' }), ['board-1', 'board-2']);
+});
+
+test('hourly bookings conflict only when their hours overlap', () => {
+  const service = serviceWithHourlyBoard();
+  service.book({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' });
+  assert.throws(
+    () => service.book({ itemId: 'board-1', start: '2026-07-01T11:00:00Z', end: '2026-07-01T13:00:00Z' }),
+    /not free/,
+  );
+  // Back-to-back hours do not overlap.
+  assert.equal(
+    service.book({ itemId: 'board-1', start: '2026-07-01T12:00:00Z', end: '2026-07-01T13:00:00Z' }).total,
+    600,
+  );
+  // An hourly rental inside a day rental conflicts with it.
+  service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.throws(
+    () => service.book({ itemId: 'board-1', start: '2026-07-02T14:00:00Z', end: '2026-07-02T15:00:00Z' }),
+    /not free/,
+  );
+});
+
+test('addEquipment rejects an invalid hourly price', () => {
+  const service = createRentalService();
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }), /hourly price/);
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }), /hourly price/);
+});
