+test('availability lists the free equipment, sorted, optionally filtered by kind', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 1000 });
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1000 });
+  const period = { start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' };
+  assert.deepEqual(service.availability(period), ['board-1', 'board-2', 'sail-1', 'sail-2']);
+  assert.deepEqual(service.availability({ ...period, kind: 'board' }), ['board-1', 'board-2']);
+  assert.deepEqual(service.availability({ ...period, kind: 'sail' }), ['sail-1', 'sail-2']);
+});
+
+test('availability leaves out equipment booked for any part of the period', () => {
+  const service = serviceWithBoard();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1000 });
+  service.book({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  const overlapping = { start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' };
+  assert.deepEqual(service.availability(overlapping), ['sail-1']);
+  assert.deepEqual(service.availability({ ...overlapping, kind: 'board' }), []);
+  // Back-to-back with the booking is still free.
+  assert.deepEqual(
+    service.availability({ start: '2026-07-04T00:00:00Z', end: '2026-07-05T00:00:00Z', kind: 'board' }),
+    ['board-1'],
+  );
+  assert.deepEqual(
+    service.availability({ start: '2026-06-30T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    ['board-1', 'sail-1'],
+  );
+});
+
+test('availability is empty when there is no matching equipment', () => {
+  const service = serviceWithBoard();
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01', end: '2026-07-02', kind: 'sail' }),
+    [],
+  );
+  assert.deepEqual(createRentalService().availability({ start: '2026-07-01', end: '2026-07-02' }), []);
+});
+
+test('availability validates the period and the kind', () => {
+  const service = serviceWithBoard();
+  assert.throws(() => service.availability({ start: '2026-07-02', end: '2026-07-01' }), /end after/);
+  assert.throws(() => service.availability({ start: '2026-07-01T10:00:00Z', end: '2026-07-02' }), /midnight UTC/);
+  assert.throws(() => service.availability({ start: '2026-07-01', end: '2026-07-02', kind: 'kite' as 'board' }), /kind/);
+});
+
