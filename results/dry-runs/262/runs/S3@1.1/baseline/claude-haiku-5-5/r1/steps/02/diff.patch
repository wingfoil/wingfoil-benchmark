+    availability(query: AvailabilityQuery): string[] {
+      const { start, end } = parsePeriod(query);
+      if (query.kind !== undefined && !KINDS.includes(query.kind)) {
+        throw new Error(`the item kind must be 'board' or 'sail', got ${String(query.kind)}`);
+      }
+      const free: string[] = [];
+      for (const item of items.values()) {
+        if (query.kind !== undefined && item.kind !== query.kind) {
+          continue;
+        }
+        const taken = reservations.some(
+          (r) => r.itemId === item.id && r.start < end && start < r.end,
+        );
+        if (!taken) {
+          free.push(item.id);
+        }
+      }
+      return free.sort();
+    },
   };
 }
