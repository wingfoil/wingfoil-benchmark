diff --git a/test/rental.test.ts b/test/rental.test.ts
index 45034fb14ce7dfb2703a2f3fe8765c85192ae9f6..35379b58164d059eaebbf76c1f2001a2ee956901 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -269,3 +269,53 @@ test('addEquipment rejects an invalid hourly price', () => {
   assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }), /hourly price/);
   assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }), /hourly price/);
 });
+
+test('cancelling before the rental starts refunds the whole total', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.deepEqual(service.cancel(booking.id, '2026-06-30T23:59:59Z'), { bookingId: booking.id, refund: 6750 });
+});
+
+test('cancelling once the rental has started refunds nothing', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.deepEqual(service.cancel(booking.id, '2026-07-01T00:00:00Z'), { bookingId: booking.id, refund: 0 });
+});
+
+test('a cancelled booking no longer holds its equipment', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-02' }), []);
+  service.cancel(booking.id, '2026-06-01T00:00:00Z');
+  assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-02' }), ['board-1']);
+  assert.equal(service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' }).total, 5000);
+});
+
+test('a booking cancelled after it started also frees its equipment', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  service.cancel(booking.id, '2026-07-01T12:00:00Z');
+  assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-03' }), ['board-1']);
+});
+
+test('a booking can only be cancelled once', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  service.cancel(booking.id, '2026-06-01T00:00:00Z');
+  assert.throws(() => service.cancel(booking.id, '2026-06-02T00:00:00Z'), /already cancelled/);
+});
+
+test('cancel rejects unknown bookings and invalid times', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' });
+  assert.throws(() => service.cancel('nope', '2026-06-01T00:00:00Z'), /unknown booking/);
+  assert.throws(() => service.cancel(booking.id, 'not a time'), /ISO-8601/);
+  // The booking is still active after a rejected cancellation.
+  assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-02' }), []);
+});
+
+test('cancelling an hourly booking refunds its hourly total', () => {
+  const service = serviceWithHourlyBoard();
+  const booking = service.book({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T13:00:00Z' });
+  assert.deepEqual(service.cancel(booking.id, '2026-07-01T09:00:00Z'), { bookingId: booking.id, refund: 1800 });
+});
