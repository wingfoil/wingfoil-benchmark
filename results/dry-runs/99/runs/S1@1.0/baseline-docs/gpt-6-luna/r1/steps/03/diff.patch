diff --git a/src/index.test.js b/src/index.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..d1f73d864ce4c7f8b48789c4b9048a59da847f4d
--- /dev/null
+++ b/src/index.test.js
@@ -0,0 +1,45 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch } from './index.ts';
+
+test('applies RFC 6902 operations in sequence and leaves the input untouched', () => {
+  const source = { list: ['a', 'b'], value: { ok: true } };
+  const result = applyPatch(source, [
+    { op: 'add', path: '/list/1', value: 'x' },
+    { op: 'copy', from: '/value', path: '/copy', ignored: true },
+    { op: 'move', from: '/list/0', path: '/list/2' },
+    { op: 'test', path: '/copy/ok', value: true },
+  ]);
+  assert.deepEqual(result, { list: ['x', 'b', 'a'], value: { ok: true }, copy: { ok: true } });
+  assert.deepEqual(source, { list: ['a', 'b'], value: { ok: true } });
+});
+
+test('add replaces object members and can replace the document root', () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: 'add', path: '/a', value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: 'add', path: '', value: [1, 2] }]), [1, 2]);
+});
+
+test('move to the same location is a no-op and moving into a child fails', () => {
+  assert.deepEqual(applyPatch({ a: [1, 2] }, [{ op: 'move', from: '/a/1', path: '/a/1' }]), { a: [1, 2] });
+  assert.throws(() => applyPatch({ a: {} }, [{ op: 'move', from: '/a', path: '/a/b' }]));
+});
+
+test('rejects malformed operations, unresolved paths, and invalid JSON values', () => {
+  for (const patch of [
+    [{ op: 'add', path: '/x' }],
+    [{ op: 'wat', path: '' }],
+    [{ op: 'remove', path: '/missing' }],
+    [{ op: 'test', path: '', value: undefined }],
+    [{ op: 'add', path: '', value: Number.NaN }],
+    [{ op: 'add', path: '', value: new Date() }],
+  ]) assert.throws(() => applyPatch({}, patch));
+});
+
+test('failed patches do not mutate the original document', () => {
+  const source = { list: [1, 2] };
+  assert.throws(() => applyPatch(source, [
+    { op: 'remove', path: '/list/0' },
+    { op: 'test', path: '/list/0', value: 99 },
+  ]));
+  assert.deepEqual(source, { list: [1, 2] });
+});
