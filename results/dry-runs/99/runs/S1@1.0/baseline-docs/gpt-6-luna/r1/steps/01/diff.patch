--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,52 @@
+/**
+ * Resolves a string-form JSON Pointer (RFC 6901) against a JSON document.
+ * The empty pointer refers to the document itself. Invalid pointers and pointers
+ * that do not identify a value throw an Error.
+ *
+ * @param document The JSON document to search.
+ * @param pointer A string-form JSON Pointer.
+ * @returns The value identified by the pointer.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("JSON Pointer must be a string");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error("A non-empty JSON Pointer must start with '/'");
+  }
+
+  const tokens = pointer.slice(1).split("/").map(decodeToken);
+  let value = document;
+
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new Error(`Invalid array index in JSON Pointer: ${token}`);
+      }
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= value.length) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+      value = value[index];
+      continue;
+    }
+
+    if (value === null || typeof value !== "object" || !Object.hasOwn(value, token)) {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+    value = (value as Record<string, unknown>)[token];
+  }
+
+  return value;
+}
+
+function decodeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid escape sequence in JSON Pointer: ${token}`);
+  }
+  return token.replace(/~[01]/g, (escape) => (escape === "~1" ? "/" : "~"));
+}
