+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document without mutating the input.
+ * Object patches merge recursively, null members remove properties, and other
+ * patch values replace the target.
+ *
+ * @param target The JSON document to patch.
+ * @param patch The JSON Merge Patch value.
+ * @returns The merged document as a new value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  const patchCopy = cloneJson(patch);
+  const targetCopy = cloneJson(target);
+  return mergePatchValue(targetCopy, patchCopy);
+}
+
+function mergePatchValue(target: unknown, patch: unknown): unknown {
+  if (patch === null || typeof patch !== "object" || Array.isArray(patch)) return patch;
+
+  const result: Record<string, unknown> = {};
+  if (target !== null && typeof target === "object" && !Array.isArray(target)) {
+    for (const key of Object.keys(target)) {
+      Object.defineProperty(result, key, {
+        value: (target as Record<string, unknown>)[key], enumerable: true, configurable: true, writable: true,
+      });
+    }
+  }
+
+  for (const key of Object.keys(patch)) {
+    const value = (patch as Record<string, unknown>)[key];
+    if (value === null) delete result[key];
+    else Object.defineProperty(result, key, {
+      value: mergePatchValue(result[key], value), enumerable: true, configurable: true, writable: true,
+    });
+  }
+  return result;
+}
