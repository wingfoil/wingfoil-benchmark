--- a/src/index.ts
+++ b/src/index.ts
@@ -54,3 +54,189 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; from: string; path: string };
+
+type Container = JsonValue[] | { [key: string]: JsonValue };
+
+function isObject(value: unknown): value is { [key: string]: JsonValue } {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setMember(target: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  // defineProperty so that a "__proto__" member is an own property, not a prototype change
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) return value.map(clone);
+  if (isObject(value)) {
+    const copy: { [key: string]: JsonValue } = {};
+    for (const key of Object.keys(value)) setMember(copy, key, clone(value[key]));
+    return copy;
+  }
+  return value;
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return (
+      Array.isArray(b) && a.length === b.length && a.every((item, i) => deepEqual(item, b[i]))
+    );
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keysA = Object.keys(a);
+    return (
+      keysA.length === Object.keys(b).length &&
+      keysA.every((key) => Object.prototype.hasOwnProperty.call(b, key) && deepEqual(a[key], b[key]))
+    );
+  }
+  return a === b;
+}
+
+/** Walks to the parent of the location designated by `tokens` (which must not be empty). */
+function parentOf(document: JsonValue, tokens: string[]): Container {
+  let current: JsonValue = document;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`Path does not resolve: bad array index "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (isObject(current) && Object.prototype.hasOwnProperty.call(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path does not resolve at "${token}"`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new Error("Path does not resolve: parent is not a container");
+  }
+  return current;
+}
+
+function get(document: JsonValue, pointer: string): JsonValue {
+  parsePointer(pointer);
+  return resolvePointer(document, pointer) as JsonValue;
+}
+
+function arrayIndex(parent: JsonValue[], token: string, allowEnd: boolean): number {
+  if (allowEnd && token === "-") return parent.length;
+  if (!ARRAY_INDEX.test(token)) throw new Error(`Invalid array index "${token}"`);
+  const index = Number(token);
+  if (index > parent.length || (!allowEnd && index === parent.length)) {
+    throw new Error(`Array index ${token} is out of bounds`);
+  }
+  return index;
+}
+
+function add(document: JsonValue, pointer: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(document, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(arrayIndex(parent, last, true), 0, value);
+  else setMember(parent, last, value);
+  return document;
+}
+
+function remove(document: JsonValue, pointer: string): JsonValue {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) throw new Error("Cannot remove the document root");
+  const parent = parentOf(document, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(parent, last, false), 1);
+  } else {
+    if (!Object.prototype.hasOwnProperty.call(parent, last)) {
+      throw new Error(`Cannot remove: no member "${last}"`);
+    }
+    delete parent[last];
+  }
+  return document;
+}
+
+function replace(document: JsonValue, pointer: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(document, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent[arrayIndex(parent, last, false)] = value;
+  } else {
+    if (!Object.prototype.hasOwnProperty.call(parent, last)) {
+      throw new Error(`Cannot replace: no member "${last}"`);
+    }
+    setMember(parent, last, value);
+  }
+  return document;
+}
+
+function requireString(operation: Record<string, unknown>, member: string): string {
+  const value = operation[member];
+  if (typeof value !== "string") {
+    throw new Error(`Invalid patch operation: "${member}" must be a string`);
+  }
+  return value;
+}
+
+function requireValue(operation: Record<string, unknown>): JsonValue {
+  if (!Object.prototype.hasOwnProperty.call(operation, "value") || operation.value === undefined) {
+    throw new Error('Invalid patch operation: missing "value"');
+  }
+  return operation.value as JsonValue;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the resulting document.
+ * The input document and patch are never mutated. Throws if the patch is invalid or if an
+ * operation fails; in that case no result is returned.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new Error("Invalid patch: must be an array of operations");
+  let result = clone(document as JsonValue);
+  for (const operation of patch) {
+    if (!isObject(operation)) throw new Error("Invalid patch operation: must be an object");
+    const op = operation as Record<string, unknown>;
+    const path = requireString(op, "path");
+    switch (op.op) {
+      case "add":
+        result = add(result, path, clone(requireValue(op)));
+        break;
+      case "remove":
+        result = remove(result, path);
+        break;
+      case "replace":
+        result = replace(result, path, clone(requireValue(op)));
+        break;
+      case "test":
+        if (!deepEqual(get(result, path), requireValue(op))) {
+          throw new Error(`Test failed at "${path}"`);
+        }
+        break;
+      case "move": {
+        const from = requireString(op, "from");
+        const value = get(result, from);
+        if (from === path) break;
+        if (path.startsWith(from + "/")) {
+          throw new Error("Cannot move a value into one of its own children");
+        }
+        result = remove(result, from);
+        result = add(result, path, value);
+        break;
+      }
+      case "copy": {
+        const from = requireString(op, "from");
+        result = add(result, path, clone(get(result, from)));
+        break;
+      }
+      default:
+        throw new Error(`Invalid patch operation: unknown op ${JSON.stringify(op.op)}`);
+    }
+  }
+  return result;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cdcca738a216d40049489e68eceef6b485b518c7
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,49 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("RFC 6902 appendix examples", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(applyPatch({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(
+    applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  assert.deepEqual(applyPatch({ a: [1] }, [{ op: "copy", from: "/a", path: "/b" }]), { a: [1], b: [1] });
+  assert.deepEqual(applyPatch({ a: { x: 1, y: [2] } }, [{ op: "test", path: "/a", value: { y: [2], x: 1 } }]), { a: { x: 1, y: [2] } });
+});
+
+test("failures throw", () => {
+  const bad = (d: unknown, p: unknown) => assert.throws(() => applyPatch(d, p));
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: 2 }]);
+  bad({ a: 1 }, [{ op: "test", path: "/b", value: 2 }]);
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad([1], [{ op: "add", path: "/2", value: 1 }]);
+  bad([1], [{ op: "add", path: "/01", value: 1 }]);
+  bad([1], [{ op: "remove", path: "/1" }]);
+  bad({}, [{ op: "add", path: "/a/b", value: 1 }]);
+  bad({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "nope", path: "/a" }]);
+  bad({}, { op: "add" });
+  bad({}, [{ op: "copy", path: "/a" }]);
+});
+
+test("does not mutate input; root ops work", () => {
+  const doc = { a: [1, { b: 2 }] };
+  const patch = [{ op: "add", path: "/a/1/c", value: { d: 1 } }, { op: "copy", from: "/a/1/c", path: "/e" }];
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, { a: [1, { b: 2 }] });
+  assert.equal(patch[0].op, "add");
+  out.e.d = 9;
+  assert.equal(out.a[1].c.d, 1);
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: [1] }]) instanceof Array, true);
+  assert.deepEqual(applyPatch({ a: 1 }, []), { a: 1 });
+});
