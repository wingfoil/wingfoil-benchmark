diff --git a/test/rental.test.ts b/test/rental.test.ts
index 5a7c62a8973b2adf8a89acda8d0971685c39dd8a..010398758b2b5072bfc9ef335053832ce29605f2 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -45,7 +45,7 @@ test('quote rejects unknown items and bad periods', () => {
   assert.throws(() => s.quote({ itemId: 'nope', start: may(1), end: may(2) }));
   assert.throws(() => s.quote({ itemId: 'board-1', start: may(2), end: may(2) }));
   assert.throws(() => s.quote({ itemId: 'board-1', start: may(3), end: may(2) }));
-  assert.throws(() => s.quote({ itemId: 'board-1', start: '2026-05-01T10:00:00Z', end: may(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: '2026-05-01T10:30:00Z', end: may(2) }));
   assert.throws(() => s.quote({ itemId: 'board-1', start: may(1), end: '2026-05-02T00:00:00+02:00' }));
   assert.throws(() => s.quote({ itemId: 'board-1', start: 'tomorrow', end: may(2) }));
   assert.throws(() => s.quote({ itemId: 'board-1', start: '2026-02-30T00:00:00Z', end: may(2) }));
@@ -114,3 +114,65 @@ test('availability returns an empty list when nothing matches and rejects bad qu
   assert.throws(() => s.availability({ start: may(1), end: '2026-05-02T10:00:00Z' }));
   assert.throws(() => s.availability({ start: may(1), end: may(2), kind: 'kayak' as 'board' }));
 });
+
+const at = (d: number, h: number) => `2026-05-${String(d).padStart(2, '0')}T${String(h).padStart(2, '0')}:00:00Z`;
+
+function hourlyService() {
+  const s = service();
+  s.addEquipment({ id: 'board-h', kind: 'board', dailyPrice: 2500, hourlyPrice: 700 });
+  return s;
+}
+
+test('a rental shorter than a day is priced per hour, without discount', () => {
+  const s = hourlyService();
+  assert.strictEqual(s.quote({ itemId: 'board-h', start: at(1, 10), end: at(1, 11) }).total, 700);
+  assert.strictEqual(s.quote({ itemId: 'board-h', start: at(1, 9), end: at(1, 14) }).total, 3500);
+  assert.strictEqual(s.quote({ itemId: 'board-h', start: at(1, 0), end: at(1, 23) }).total, 16100);
+  assert.strictEqual(s.quote({ itemId: 'board-h', start: at(1, 14), end: at(2, 13) }).total, 16100);
+  assert.strictEqual(s.book({ itemId: 'board-h', start: at(1, 10), end: at(1, 12) }).total, 1400);
+});
+
+test('a full day, even on an item with an hourly price, is still priced per day', () => {
+  assert.strictEqual(hourlyService().quote({ itemId: 'board-h', start: may(1), end: may(2) }).total, 2500);
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  const s = hourlyService();
+  assert.throws(() => s.quote({ itemId: 'board-1', start: at(1, 10), end: at(1, 12) }), /by the hour/);
+  assert.throws(() => s.book({ itemId: 'board-1', start: at(1, 10), end: at(1, 12) }), /by the hour/);
+});
+
+test('hourly periods must be on the hour, and longer ones whole days', () => {
+  const s = hourlyService();
+  assert.throws(() => s.quote({ itemId: 'board-h', start: '2026-05-01T10:30:00Z', end: at(1, 12) }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: at(1, 10), end: '2026-05-01T12:00:01Z' }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: at(1, 10), end: at(2, 10) }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: at(1, 10), end: at(3, 0) }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: at(1, 12), end: at(1, 12) }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: at(1, 12), end: at(1, 10) }));
+});
+
+test('hourly bookings conflict only when the hours overlap', () => {
+  const s = hourlyService();
+  s.book({ itemId: 'board-h', start: at(1, 10), end: at(1, 12) });
+  assert.throws(() => s.book({ itemId: 'board-h', start: at(1, 11), end: at(1, 13) }));
+  assert.throws(() => s.book({ itemId: 'board-h', start: may(1), end: may(2) }));
+  s.book({ itemId: 'board-h', start: at(1, 12), end: at(1, 14) });
+  s.book({ itemId: 'board-h', start: at(1, 8), end: at(1, 10) });
+});
+
+test('availability for an hourly period leaves out items that cannot be rented by the hour', () => {
+  const s = hourlyService();
+  s.book({ itemId: 'board-h', start: at(1, 10), end: at(1, 12) });
+  assert.deepStrictEqual(s.availability({ start: at(1, 12), end: at(1, 13) }), ['board-h']);
+  assert.deepStrictEqual(s.availability({ start: at(1, 11), end: at(1, 13) }), []);
+  assert.deepStrictEqual(s.availability({ start: may(1), end: may(2) }), ['board-1', 'sail-1']);
+});
+
+test('addEquipment validates the hourly price', () => {
+  const s = service();
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 0 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: null as unknown as number }));
+  s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 30 });
+});
