diff --git a/test/rental.test.ts b/test/rental.test.ts
index 010398758b2b5072bfc9ef335053832ce29605f2..71ea9959c47e96072a3cd78bb3ac437132a5977d 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -176,3 +176,44 @@ test('addEquipment validates the hourly price', () => {
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: null as unknown as number }));
   s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 30 });
 });
+
+test('cancel refunds the whole total when done before the rental starts', () => {
+  const s = service();
+  const booking = s.book({ itemId: 'board-1', start: may(5), end: may(8) });
+  assert.deepStrictEqual(s.cancel(booking.id, may(4)), { bookingId: booking.id, refund: 6750 });
+});
+
+test('cancel refunds nothing once the rental has started', () => {
+  const s = hourlyService();
+  const a = s.book({ itemId: 'board-h', start: at(1, 10), end: at(1, 12) });
+  const b = s.book({ itemId: 'board-h', start: at(2, 10), end: at(2, 12) });
+  assert.strictEqual(s.cancel(a.id, at(1, 10)).refund, 0);
+  assert.strictEqual(s.cancel(b.id, '2026-05-02T09:59:59Z').refund, 1400);
+});
+
+test('a cancelled booking no longer holds its equipment', () => {
+  const s = service();
+  const booking = s.book({ itemId: 'board-1', start: may(5), end: may(8) });
+  s.cancel(booking.id, may(1));
+  assert.deepStrictEqual(s.availability({ start: may(5), end: may(8), kind: 'board' }), ['board-1']);
+  const again = s.book({ itemId: 'board-1', start: may(5), end: may(8) });
+  assert.notStrictEqual(again.id, booking.id);
+});
+
+test('a booking can only be cancelled once', () => {
+  const s = service();
+  const booking = s.book({ itemId: 'board-1', start: may(5), end: may(8) });
+  s.cancel(booking.id, may(1));
+  assert.throws(() => s.cancel(booking.id, may(2)), /already cancelled/);
+});
+
+test('cancel rejects unknown bookings and bad instants, and leaves the booking in place', () => {
+  const s = service();
+  const booking = s.book({ itemId: 'board-1', start: may(5), end: may(8) });
+  assert.throws(() => s.cancel('nope', may(1)), /Unknown booking/);
+  assert.throws(() => s.cancel(booking.id, 'yesterday'));
+  assert.throws(() => s.cancel(booking.id, '2026-02-30T00:00:00Z'));
+  assert.throws(() => s.cancel(booking.id, '2026-05-01T00:00:00+02:00'));
+  assert.deepStrictEqual(s.availability({ start: may(5), end: may(8), kind: 'board' }), []);
+  assert.strictEqual(s.cancel(booking.id, '2026-05-01T10:30:15Z').refund, 6750);
+});
