diff --git a/test/rental.test.ts b/test/rental.test.ts
index a1e5672016a3a3b9b3fd90942c5f18946a651208..4c5a7010c1cf8b6ae016b1d39279b27b351e4d10 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -70,3 +70,31 @@ test('addEquipment validates items', () => {
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 0 }));
 });
+
+test('availability lists the free items of a kind, sorted', () => {
+  const s = service();
+  s.addEquipment({ id: 'board-0', kind: 'board', dailyPrice: 2000 });
+  s.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 3000 });
+  s.book({ itemId: 'board-2', start: may(5), end: may(8) });
+  assert.deepStrictEqual(s.availability({ start: may(1), end: may(10), kind: 'board' }), ['board-0', 'board-1']);
+  assert.deepStrictEqual(s.availability({ start: may(1), end: may(10) }), ['board-0', 'board-1', 'sail-1']);
+  assert.deepStrictEqual(s.availability({ start: may(1), end: may(10), kind: 'sail' }), ['sail-1']);
+});
+
+test('availability treats back-to-back bookings as free and any overlap as taken', () => {
+  const s = service();
+  s.book({ itemId: 'board-1', start: may(5), end: may(8) });
+  assert.deepStrictEqual(s.availability({ start: may(8), end: may(9), kind: 'board' }), ['board-1']);
+  assert.deepStrictEqual(s.availability({ start: may(4), end: may(5), kind: 'board' }), ['board-1']);
+  assert.deepStrictEqual(s.availability({ start: may(7), end: may(9), kind: 'board' }), []);
+  assert.deepStrictEqual(s.availability({ start: may(1), end: may(20), kind: 'board' }), []);
+  assert.deepStrictEqual(s.availability({ start: may(6), end: may(7), kind: 'board' }), []);
+});
+
+test('availability returns an empty list when nothing matches and rejects bad queries', () => {
+  const s = createRentalService();
+  assert.deepStrictEqual(s.availability({ start: may(1), end: may(2) }), []);
+  assert.throws(() => s.availability({ start: may(2), end: may(2) }));
+  assert.throws(() => s.availability({ start: may(1), end: '2026-05-02T10:00:00Z' }));
+  assert.throws(() => s.availability({ start: may(1), end: may(2), kind: 'kayak' as 'board' }));
+});
