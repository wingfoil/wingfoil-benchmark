index a920c505caa7f6986226fa2e1694ad69bb41b50c..502a21fed9ba074bb99c890ad12ce63511ce1c49 100644
--- a/src/domain/task.ts
+++ b/src/domain/task.ts
@@ -31,6 +31,65 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/** The longest title a task may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a title: it must not be empty or only spaces, and must be at most 120 characters once trimmed.
+ *
+ * @param title - the title to check
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title is empty: give the task a title');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long: at most ${MAX_TITLE_LENGTH} are allowed`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be `low`, `normal` or `high`.
+ *
+ * @param priority - the priority to check
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  if (!(PRIORITIES as readonly string[]).includes(priority)) {
+    return err('invalid-input', `the priority "${priority}" is not valid: use low, normal or high`);
+  }
+  return ok(priority as Priority);
+}
+
+/**
+ * Checks a tag: it must not be empty and must not contain a space.
+ *
+ * @param tag - the tag to check
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'the tag is empty: give a tag');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space: tags cannot have spaces`);
+  return ok(tag);
+}
+
+/**
+ * Checks everything of a new task: its title, its priority when given, and its tags.
+ *
+ * @param input - the new task to check
+ */
+export function validateNewTask(input: NewTask): Result<NewTask> {
+  const title = validateTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined) {
+    const priority = validatePriority(input.priority);
+    if (!priority.ok) return priority;
+  }
+  for (const tag of input.tags ?? []) {
+    const checked = validateTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok(input);
+}
+
