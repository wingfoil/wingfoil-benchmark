@@ -0,0 +1,46 @@
+import type { TaskList } from './list.ts';
+import type { NewTask } from './task.ts';
+
+/** A line of the imported text that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of a bulk import: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may be
+ * empty for a normal one; the tags are separated by spaces. Blank lines are skipped, but still counted in
+ * the line numbers. A line that cannot be added is reported and does not stop the others.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `the line has ${fields.length} fields: expected title;priority;tags` });
+      return;
+    }
+    const [title = '', priority = '', tags = ''] = fields.map((field) => field.trim());
+    const input: NewTask = {
+      title,
+      ...(priority === '' ? {} : { priority: priority as NewTask['priority'] }),
+      tags: tags === '' ? [] : tags.split(/\s+/),
+    };
+    const added = list.add(input);
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
