@@ -0,0 +1,57 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * Only own properties of objects and existing array elements resolve: the "-" array token
+ * (one past the end), inherited properties and characters of strings do not, since none of
+ * them refers to a value of the document.
+ *
+ * @param document - the JSON document to look into; any JSON value.
+ * @param pointer - a JSON Pointer string: "" for the whole document, otherwise "/"-prefixed tokens.
+ * @returns the value the pointer refers to (which may be `null`).
+ * @throws {Error} if `pointer` is not a valid JSON Pointer, or does not resolve to a value of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: ${JSON.stringify(pointer)} must be empty or start with "/"`);
+  }
+  const tokens = pointer.slice(1).split("/").map(unescapeToken);
+
+  let current = document;
+  for (const token of tokens) {
+    current = step(current, token, pointer);
+  }
+  return current;
+}
+
+/** Decodes "~1" to "/" then "~0" to "~"; a "~" followed by anything else is invalid. */
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad "~" escape in token ${JSON.stringify(token)}`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/** Moves from `value` to its child named by `token`. */
+function step(value: unknown, token: string, pointer: string): unknown {
+  const unresolved = () => new Error(`JSON Pointer ${JSON.stringify(pointer)} does not resolve: no value at token ${JSON.stringify(token)}`);
+
+  if (Array.isArray(value)) {
+    if (!/^(0|[1-9][0-9]*)$/.test(token) || Number(token) >= value.length) {
+      throw unresolved();
+    }
+    return value[Number(token)];
+  }
+  if (typeof value === "object" && value !== null) {
+    if (!Object.prototype.hasOwnProperty.call(value, token)) {
+      throw unresolved();
+    }
+    return (value as Record<string, unknown>)[token];
+  }
+  throw unresolved();
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..96041c9314cbc3055975634964d7183d0f08a63a
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,78 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// The document of RFC 6901 section 5.
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("escape order: ~01 is the key ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x", "~/": "y" }, "/~01"), "x");
+  assert.equal(resolvePointer({ "~/": "y" }, "/~0~1"), "y");
+});
+
+test("falsy and null values resolve", () => {
+  const d = { a: null, b: false, c: 0, d: "" };
+  assert.equal(resolvePointer(d, "/a"), null);
+  assert.equal(resolvePointer(d, "/b"), false);
+  assert.equal(resolvePointer(d, "/c"), 0);
+  assert.equal(resolvePointer(d, "/d"), "");
+  assert.equal(resolvePointer(null, ""), null);
+  assert.equal(resolvePointer(5, ""), 5);
+});
+
+test("invalid pointer syntax throws", () => {
+  assert.throws(() => resolvePointer(doc, "foo"));
+  assert.throws(() => resolvePointer(doc, "/m~n"));
+  assert.throws(() => resolvePointer(doc, "/m~"));
+  assert.throws(() => resolvePointer(doc, "/m~2"));
+  assert.throws(() => resolvePointer(doc, 5 as unknown as string));
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer(doc, "/missing"));
+  assert.throws(() => resolvePointer(doc, "/foo/2"));
+  assert.throws(() => resolvePointer(doc, "/foo/-"));
+  assert.throws(() => resolvePointer(doc, "/foo/00"));
+  assert.throws(() => resolvePointer(doc, "/foo/01"));
+  assert.throws(() => resolvePointer(doc, "/foo/+1"));
+  assert.throws(() => resolvePointer(doc, "/foo/1.0"));
+  assert.throws(() => resolvePointer(doc, "/foo/-0"));
+  assert.throws(() => resolvePointer(doc, "/foo/length"));
+  assert.throws(() => resolvePointer(doc, "/foo/0/x"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer("abc", "/0"));
+  assert.throws(() => resolvePointer("abc", "/length"));
+});
+
+test("inherited properties do not resolve", () => {
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer({}, "/constructor"));
+  assert.throws(() => resolvePointer({}, "/toString"));
+  assert.equal(resolvePointer(JSON.parse('{"__proto__": 1}'), "/__proto__"), 1);
+});
