+++ b/test/patch.test.ts
@@ -0,0 +1,107 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const patch = (document: unknown, ops: unknown[]) => applyPatch(document, ops as never);
+
+test("RFC 6902 appendix A examples", () => {
+  assert.deepEqual(patch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(patch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(patch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+  assert.deepEqual(patch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+  assert.deepEqual(patch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), { baz: "boo", foo: "bar" });
+  assert.deepEqual(
+    patch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(patch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  assert.deepEqual(patch({ baz: "qux", foo: ["bar"] }, [{ op: "copy", from: "/baz", path: "/foo/-" }]), { baz: "qux", foo: ["bar", "qux"] });
+  assert.deepEqual(patch({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }]), {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  });
+  assert.deepEqual(patch({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]), { foo: "bar", child: { grandchild: {} } });
+});
+
+test("whole-document paths and null values", () => {
+  assert.deepEqual(patch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.equal(patch({ a: 1 }, [{ op: "replace", path: "", value: null }]), null);
+  assert.deepEqual(patch({ a: null }, [{ op: "test", path: "/a", value: null }]), { a: null });
+  assert.deepEqual(patch({ a: 1 }, []), { a: 1 });
+});
+
+test("does not mutate the input and shares no structure", () => {
+  const document = { a: { b: [1, 2] } };
+  const value = { x: 1 };
+  const result = patch(document, [
+    { op: "add", path: "/a/b/0", value: 0 },
+    { op: "copy", from: "/a", path: "/c" },
+    { op: "add", path: "/v", value },
+  ]) as any;
+  assert.deepEqual(document, { a: { b: [1, 2] } });
+  result.v.x = 2;
+  result.c.b.push(9);
+  assert.equal(value.x, 1);
+  assert.deepEqual(result.a.b, [0, 1, 2]);
+});
+
+test("test compares by JSON equality", () => {
+  assert.doesNotThrow(() => patch({ a: { x: 1, y: [1, { z: 2 }] } }, [{ op: "test", path: "/a", value: { y: [1, { z: 2 }], x: 1 } }]));
+  assert.throws(() => patch({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]));
+  assert.throws(() => patch({ a: [1, 2] }, [{ op: "test", path: "/a", value: [1] }]));
+  assert.throws(() => patch({ a: {} }, [{ op: "test", path: "/a", value: [] }]));
+});
+
+test("failing operations throw", () => {
+  const fails = (document: unknown, op: unknown) => assert.throws(() => patch(document, [op]), Error);
+  fails({}, { op: "add", path: "/a/b", value: 1 });
+  fails({ a: [1] }, { op: "add", path: "/a/2", value: 1 });
+  fails({ a: [1] }, { op: "add", path: "/a/01", value: 1 });
+  fails({ a: [1] }, { op: "add", path: "/a/x", value: 1 });
+  fails({ a: 1 }, { op: "add", path: "/a/b", value: 1 });
+  fails({}, { op: "remove", path: "/a" });
+  fails({ a: [1] }, { op: "remove", path: "/a/1" });
+  fails({ a: [1] }, { op: "remove", path: "/a/-" });
+  fails({ a: 1 }, { op: "remove", path: "" });
+  fails({}, { op: "replace", path: "/a", value: 1 });
+  fails({ a: [1] }, { op: "replace", path: "/a/1", value: 1 });
+  fails({}, { op: "move", from: "/a", path: "/b" });
+  fails({ a: { b: 1 } }, { op: "move", from: "/a", path: "/a/b" });
+  fails({}, { op: "copy", from: "/a", path: "/b" });
+  fails({}, { op: "test", path: "/a", value: 1 });
+});
+
+test("inherited properties do not resolve", () => {
+  assert.throws(() => patch({}, [{ op: "test", path: "/toString", value: 1 }]));
+  assert.throws(() => patch({}, [{ op: "remove", path: "/constructor" }]));
+});
+
+test("invalid patches throw", () => {
+  assert.throws(() => applyPatch({}, {} as never));
+  assert.throws(() => patch({}, [null]));
+  assert.throws(() => patch({}, [[]]));
+  assert.throws(() => patch({}, [{ path: "/a", value: 1 }]));
+  assert.throws(() => patch({}, [{ op: "bogus", path: "/a" }]));
+  assert.throws(() => patch({}, [{ op: "add", value: 1 }]));
+  assert.throws(() => patch({}, [{ op: "add", path: "a", value: 1 }]));
+  assert.throws(() => patch({}, [{ op: "add", path: "/~2", value: 1 }]));
+  assert.throws(() => patch({}, [{ op: "add", path: "/a" }]));
+  assert.throws(() => patch({ a: 1 }, [{ op: "move", path: "/b" }]));
+  assert.throws(() => patch({ a: 1 }, [{ op: "copy", path: "/b" }]));
+  assert.throws(() => patch({ a: 1 }, [{ op: "test", path: "/a" }]));
+});
+
+test("a failing patch is atomic and leaves the input untouched", () => {
+  const document = { a: 1 };
+  assert.throws(() => patch(document, [{ op: "add", path: "/b", value: 2 }, { op: "remove", path: "/zz" }]));
+  assert.deepEqual(document, { a: 1 });
+});
+
+test("__proto__ members are plain data, not prototype pollution", () => {
+  const result = patch({}, [{ op: "add", path: "/__proto__", value: { polluted: 1 } }]) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+});
