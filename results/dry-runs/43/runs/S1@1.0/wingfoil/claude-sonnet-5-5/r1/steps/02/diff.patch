+---
+id: task-002-implement-json-patch-applypatch-rfc-6902
+type: task
+title: "Implement JSON Patch applyPatch (RFC 6902)"
+status: pending
+format: 1
+---
+
+## What was done
+
+Added `applyPatch(document, patch)` in `src/index.ts` with the six RFC 6902 operations, without mutating
+its input, with tests in `test/patch.test.ts` (RFC appendix A examples, error and atomicity paths,
+`__proto__` safety). Documented in `README.md`. Design choices: see decision-log dl-002.
diff --git a/src/index.ts b/src/index.ts
index 0864d2afa335d85b81f0c10783ba9c129df0b5ca..5da9767b8213e71b0b1d612577c7e1399361dbe9 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -55,3 +55,235 @@ function step(value: unknown, token: string, pointer: string): unknown {
   }
   throw unresolved();
 }
+
+type Json = null | boolean | number | string | Json[] | { [key: string]: Json };
+
+/** One RFC 6902 operation; members other than the ones an operation uses are ignored. */
+export interface PatchOperation {
+  op: "add" | "remove" | "replace" | "move" | "copy" | "test";
+  path: string;
+  value?: unknown;
+  from?: string;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document.
+ *
+ * The input is never mutated and the patch is atomic: the result is a new value, and if any
+ * operation fails nothing is returned. Removing or moving away the whole document is an error,
+ * since a document cannot be absent. `test` compares values by JSON equality (object member
+ * order does not matter).
+ *
+ * @param document - the JSON document to patch; any JSON value.
+ * @param patch - an array of operations, applied in order.
+ * @returns the patched document, which shares no structure with `document` or `patch`.
+ * @throws {Error} if `patch` is invalid, or an operation fails (unresolved path, failed `test`, ...).
+ */
+export function applyPatch(document: unknown, patch: readonly PatchOperation[]): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: not an array");
+  }
+  let result = clone(document);
+  patch.forEach((operation, index) => {
+    try {
+      result = applyOperation(result, operation);
+    } catch (error) {
+      throw new Error(`JSON Patch operation ${index} failed: ${(error as Error).message}`);
+    }
+  });
+  return result;
+}
+
+function applyOperation(document: Json, operation: PatchOperation): Json {
+  if (typeof operation !== "object" || operation === null || Array.isArray(operation)) {
+    throw new Error("operation is not an object");
+  }
+  const path = pointerMember(operation, "path");
+  switch (operation.op) {
+    case "add":
+      return add(document, path, requireValue(operation));
+    case "remove":
+      return remove(document, path).document;
+    case "replace":
+      return replace(document, path, requireValue(operation));
+    case "move": {
+      const from = pointerMember(operation, "from");
+      if (isProperPrefix(from, path)) {
+        throw new Error(`cannot move ${JSON.stringify(from)} into one of its children`);
+      }
+      const removed = remove(document, from);
+      return add(removed.document, path, removed.value);
+    }
+    case "copy": {
+      const from = pointerMember(operation, "from");
+      return add(document, path, clone(read(document, from)));
+    }
+    case "test":
+      if (!jsonEqual(read(document, path), requireValue(operation))) {
+        throw new Error(`test failed at ${JSON.stringify(path)}`);
+      }
+      return document;
+    default:
+      throw new Error(`unknown op ${JSON.stringify(operation.op)}`);
+  }
+}
+
+function pointerMember(operation: PatchOperation, name: "path" | "from"): string[] {
+  const pointer = operation[name];
+  if (typeof pointer !== "string") {
+    throw new Error(`missing or non-string "${name}"`);
+  }
+  return parsePointer(pointer);
+}
+
+function requireValue(operation: PatchOperation): Json {
+  if (!Object.prototype.hasOwnProperty.call(operation, "value") || operation.value === undefined) {
+    throw new Error(`"${operation.op}" needs a "value"`);
+  }
+  return clone(operation.value);
+}
+
+/** Splits a JSON Pointer into its decoded tokens; the whole-document pointer has none. */
+function parsePointer(pointer: string): string[] {
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: ${JSON.stringify(pointer)} must be empty or start with "/"`);
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+function isProperPrefix(prefix: string[], tokens: string[]): boolean {
+  return prefix.length < tokens.length && prefix.every((token, i) => token === tokens[i]);
+}
+
+function isContainer(value: Json): value is Json[] | { [key: string]: Json } {
+  return typeof value === "object" && value !== null;
+}
+
+function hasOwn(object: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(object, key);
+}
+
+/** Sets an own member, even one named "__proto__", without touching the prototype. */
+function setMember(object: { [key: string]: Json }, key: string, value: Json): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`invalid array index ${JSON.stringify(token)}`);
+  }
+  const index = Number(token);
+  if (index > length || (index === length && !allowEnd)) {
+    throw new Error(`array index ${token} out of range`);
+  }
+  return index;
+}
+
+/** Returns the container holding the target of `tokens` (walking existing values only). */
+function parentOf(document: Json, tokens: string[]): Json[] | { [key: string]: Json } {
+  let current = document;
+  for (const token of tokens.slice(0, -1)) {
+    current = child(current, token);
+  }
+  if (!isContainer(current)) {
+    throw new Error("parent of the target is not an object or array");
+  }
+  return current;
+}
+
+function child(value: Json, token: string): Json {
+  if (Array.isArray(value)) {
+    return value[arrayIndex(token, value.length, false)];
+  }
+  if (isContainer(value) && hasOwn(value, token)) {
+    return value[token];
+  }
+  throw new Error(`no value at token ${JSON.stringify(token)}`);
+}
+
+function read(document: Json, tokens: string[]): Json {
+  return tokens.reduce(child, document);
+}
+
+function add(document: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = parentOf(document, tokens);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    const index = token === "-" ? parent.length : arrayIndex(token, parent.length, true);
+    parent.splice(index, 0, value);
+  } else {
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+function remove(document: Json, tokens: string[]): { document: Json; value: Json } {
+  if (tokens.length === 0) {
+    throw new Error("cannot remove the whole document");
+  }
+  const parent = parentOf(document, tokens);
+  const token = tokens[tokens.length - 1];
+  const value = child(parent, token);
+  if (Array.isArray(parent)) {
+    parent.splice(Number(token), 1);
+  } else {
+    delete parent[token];
+  }
+  return { document, value };
+}
+
+function replace(document: Json, tokens: string[], value: Json): Json {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = parentOf(document, tokens);
+  const token = tokens[tokens.length - 1];
+  child(parent, token);
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else {
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+/** Deep copy that also rejects anything that is not a JSON value. */
+function clone(value: unknown): Json {
+  if (value === null || typeof value === "boolean" || typeof value === "string") {
+    return value;
+  }
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) {
+      throw new Error("not a JSON value: non-finite number");
+    }
+    return value;
+  }
+  if (Array.isArray(value)) {
+    return value.map(clone);
+  }
+  if (typeof value === "object") {
+    const copy: { [key: string]: Json } = {};
+    for (const key of Object.keys(value)) {
+      setMember(copy, key, clone((value as Record<string, unknown>)[key]));
+    }
+    return copy;
+  }
+  throw new Error(`not a JSON value: ${typeof value}`);
+}
+
+function jsonEqual(a: Json, b: Json): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]));
+  }
+  if (isContainer(a) && isContainer(b)) {
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((key) => hasOwn(b, key) && jsonEqual(a[key], b[key]));
+  }
+  return a === b;
+}
