+import type { TaskList } from './list.ts';
+import type { NewTask } from './task.ts';
+
+/** A line of the import text that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may be
+ * empty for a normal one; tags are separated by spaces. Blank lines are skipped but still counted.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  text.split(/\r\n|\n|\r/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: 'the line has too many parts: write it as title;priority;tags' });
+      return;
+    }
+    const [title = '', priority = '', tags = ''] = fields;
+    const input: NewTask = {
+      title,
+      ...(priority.trim() === '' ? {} : { priority: priority.trim() as NewTask['priority'] }),
+      tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+    };
+    const added = list.add(input);
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
