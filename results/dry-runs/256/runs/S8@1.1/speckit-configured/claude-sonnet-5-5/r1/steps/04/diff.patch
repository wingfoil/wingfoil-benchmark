+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds valid lines, with default priority and tags, skipping blank lines', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\nBuy milk;;\r\nCall mum\n');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok);
+    assert.equal(milk.value.priority, 'normal');
+  });
+
+  it('rejects bad lines with their number, and imports the rest', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const report = importTasks(list, ';high;x\n\nFine;urgent;\nExisting;low;\nA;low;b;c\nOk;low;a b');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(report.rejected.map((r) => r.line), [1, 3, 4, 5]);
+    assert.ok(report.rejected.every((r) => r.reason.length > 0));
+    assert.equal(list.list().length, 2);
+  });
+
+  it('rejects a title repeated within the text', () => {
+    const report = importTasks(createTodoList(), 'Same\nSame');
+    assert.equal(report.imported, 1);
+    assert.equal(report.rejected[0]?.line, 2);
+  });
+});
