@@ -7,6 +7,9 @@ export type Priority = 'low' | 'normal' | 'high';
 /** Every priority, from the least urgent to the most. */
 export const PRIORITIES: readonly Priority[] = ['low', 'normal', 'high'];
 
+/** The longest title a task can have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
 /** Whether a task still has to be done. */
 export type Status = 'open' | 'done';
 
@@ -123,6 +126,43 @@ export function compareTasks(a: Task, b: Task): number {
   return a.title < b.title ? -1 : a.title > b.title ? 1 : 0;
 }
 
+/**
+ * Checks a title: after trimming it is not empty and at most `MAX_TITLE_LENGTH` characters.
+ *
+ * @param title - the title to check
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title is empty: give the task a title');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long: at most ${MAX_TITLE_LENGTH} are allowed`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it is `low`, `normal` or `high`.
+ *
+ * @param priority - the priority to check
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  if (!(PRIORITIES as readonly string[]).includes(priority)) {
+    return err('invalid-input', `the priority "${String(priority)}" is not valid: use low, normal or high`);
+  }
+  return ok(priority as Priority);
+}
+
+/**
+ * Checks a tag: it is not empty and has no space in it.
+ *
+ * @param tag - the tag to check
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'the tag is empty: give it a name');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space: tags are a single word`);
+  return ok(tag);
+}
+
 function unique(tags: readonly string[]): string[] {
   return tags.filter((tag, index) => tags.indexOf(tag) === index);
 }
