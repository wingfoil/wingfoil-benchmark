+
+describe('input validation', () => {
+  const code = (r: { ok: boolean; error?: { code: string; message: string } }) => {
+    assert.equal(r.ok, false);
+    return r.error?.code;
+  };
+
+  it('rejects bad titles on add and rename, changing nothing', () => {
+    const list = createTodoList();
+    list.add({ title: 'Keep' });
+    assert.equal(code(list.add({ title: '   ' })), 'invalid-input');
+    assert.equal(code(list.add({ title: '' })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'x'.repeat(121) })), 'invalid-input');
+    assert.equal(valueOf(list.add({ title: ` ${'x'.repeat(120)} ` })).title.length, 120);
+    assert.equal(code(list.rename('Keep', '  ')), 'invalid-input');
+    assert.equal(code(list.rename('Keep', 'y'.repeat(121))), 'invalid-input');
+    assert.deepEqual(list.list().map((t) => t.title).sort(), ['Keep', 'x'.repeat(120)].sort());
+  });
+
+  it('rejects a bad priority or tag, changing nothing', () => {
+    const list = createTodoList();
+    assert.equal(code(list.add({ title: 'A', priority: 'urgent' as never })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'A', tags: ['ok', 'two words'] })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'A', tags: [''] })), 'invalid-input');
+    assert.equal(list.list().length, 0);
+    const task = valueOf(list.add({ title: 'B' }));
+    assert.equal(code(list.tag('B', '')), 'invalid-input');
+    assert.equal(code(list.tag('B', 'a b')), 'invalid-input');
+    assert.deepEqual(valueOf(list.get(task.id)), task);
+  });
+});
