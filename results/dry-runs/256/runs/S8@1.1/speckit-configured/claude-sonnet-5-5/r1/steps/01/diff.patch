+describe('task ids', () => {
+  it('gives each task a distinct id that survives renaming', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    const b = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(a.id, b.id);
+    const renamed = valueOf(list.rename(a.id, 'a2'));
+    assert.equal(renamed.id, a.id);
+    assert.equal(valueOf(list.get(a.id)).title, 'a2');
+  });
+
+  it('never reuses the id of a removed task', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    list.remove(a.id);
+    assert.equal(list.get(a.id).ok, false);
+    assert.notEqual(valueOf(list.add({ title: 'a' })).id, a.id);
+  });
+
+  it('reports an unknown id as not found', () => {
+    const result = createTodoList().get('nope');
+    assert.equal(result.ok, false);
+    if (!result.ok) assert.equal(result.error.code, 'not-found');
+  });
+
+  it('accepts an id wherever a title is accepted', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'x' }));
+    assert.equal(valueOf(list.find(id)).title, 'x');
+    assert.equal(valueOf(list.complete(id)).status, 'done');
+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.deepEqual(valueOf(list.tag(id, 'home')).tags, ['home']);
+    assert.deepEqual(valueOf(list.untag(id, 'home')).tags, []);
+    assert.equal(valueOf(list.remove(id)).title, 'x');
+    assert.equal(list.openCount(), 0);
+  });
+
+  it('prefers an id over a title that looks like it', () => {
+    const list = createTodoList();
+    const first = valueOf(list.add({ title: 'first' }));
+    list.add({ title: first.id });
+    assert.equal(valueOf(list.find(first.id)).title, 'first');
+  });
+});
