diff --git a/test/index.test.mjs b/test/index.test.mjs
index 6ca49559f951f96fbf24315f0ab1fe0cc17fe9ad..f0e40df32d6fcbe3c60a61fa761bd524a0ecd491 100644
--- a/test/index.test.mjs
+++ b/test/index.test.mjs
@@ -84,3 +84,26 @@ test('rejects malformed patches and failed operations', () => {
   assert.throws(() => applyPatch({ value: 1 }, [{ op: 'test', path: '/value', value: 2 }]));
   assert.throws(() => applyPatch({ a: {} }, [{ op: 'move', from: '/a', path: '/a/b' }]));
 });
+
+test('rejects a same-location move when its source does not exist', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'move', from: '/missing', path: '/missing' }]));
+});
+
+test('accepts only JSON Patch documents and ignores defined extra members', () => {
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: '/value', value: 1, extra: undefined }]));
+  assert.deepEqual(
+    applyPatch({}, [{ op: 'add', path: '/value', value: 1, extra: { ignored: true } }]),
+    { value: 1 },
+  );
+});
+
+test('leaves the source document unchanged when a later operation fails', () => {
+  const source = { value: 1 };
+
+  assert.throws(() => applyPatch(source, [
+    { op: 'replace', path: '/value', value: 2 },
+    { op: 'test', path: '/value', value: 3 },
+  ]));
+
+  assert.deepEqual(source, { value: 1 });
+});
