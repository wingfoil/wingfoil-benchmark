+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document.
+ *
+ * Object members set to `null` in an object patch are removed. Other values,
+ * including arrays, replace their corresponding target values. The returned
+ * document is independent from both inputs.
+ *
+ * @param target The JSON document to update.
+ * @param patch The JSON Merge Patch document to apply.
+ * @returns The merged JSON document.
+ * @throws {TypeError} If the target or patch is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJsonValue(target, 'The target');
+  assertJsonValue(patch, 'A JSON Merge Patch');
+
+  return mergePatch(target, patch);
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonObject(patch)) {
+    return cloneJson(patch);
+  }
+
+  const result = isJsonObject(target) ? cloneJson(target) as Record<string, unknown> : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setObjectMember(result, key, mergePatch(result[key], value));
+    }
+  }
+  return result;
+}
+
 function applyOperation(document: unknown, operation: unknown): unknown {
   if (!isJsonObject(operation)) {
     throw new TypeError('A JSON Patch operation must be an object.');
