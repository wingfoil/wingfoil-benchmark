+
+test('applies the RFC 7386 merge patch examples without mutating either input', () => {
+  const target = {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  };
+  const patch = {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  };
+
+  const result = applyMergePatch(target, patch);
+
+  assert.deepEqual(result, {
+    title: 'Hello!',
+    author: { givenName: 'John' },
+    tags: ['example'],
+    content: 'This will be unchanged',
+    phoneNumber: '+01-123-456-7890',
+  });
+  assert.deepEqual(target, {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  });
+  assert.deepEqual(patch, {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  });
+  assert.notEqual(result, target);
+  assert.notEqual(result.author, target.author);
+  assert.notEqual(result.tags, patch.tags);
+});
+
+test('replaces a non-object target for an object patch and replaces the root for non-object patches', () => {
+  assert.deepEqual(applyMergePatch(['a', 'b'], { a: 'b', remove: null }), { a: 'b' });
+  assert.deepEqual(applyMergePatch({ a: 'b' }, null), null);
+  assert.deepEqual(applyMergePatch({ a: 'b' }, ['c']), ['c']);
+});
+
+test('rejects merge patches and targets that are not JSON values', () => {
+  assert.throws(() => applyMergePatch({ value: 1 }, { value: undefined }));
+  assert.throws(() => applyMergePatch({ value: Infinity }, {}));
+});
