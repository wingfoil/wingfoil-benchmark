+/**
+ * Creates an RFC 6902 JSON Patch that transforms one JSON document into another.
+ *
+ * The generated patch contains operations for the changed members or array
+ * elements rather than replacing an unchanged enclosing document. Patch values
+ * are independent copies of `to`, so neither input is mutated.
+ *
+ * @param from The original JSON document.
+ * @param to The desired JSON document.
+ * @returns An RFC 6902 JSON Patch that transforms `from` into `to`.
+ * @throws {TypeError} If either argument is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  assertJsonValue(from, 'The source document');
+  assertJsonValue(to, 'The target document');
+
+  const patch: JsonPatchOperation[] = [];
+  createPatchAt(from, to, '', patch);
+  return patch;
+}
