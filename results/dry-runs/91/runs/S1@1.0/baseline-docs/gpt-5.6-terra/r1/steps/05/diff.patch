+type JsonPatchOperation = Record<string, unknown>;
+
+function createPatchAt(
+  from: unknown,
+  to: unknown,
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    createObjectPatch(from, to, path, patch);
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatch(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: 'replace', path, value: cloneJson(to) });
+}
+
+function createObjectPatch(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    const memberPath = appendPointer(path, key);
+    if (!Object.hasOwn(to, key)) {
+      patch.push({ op: 'remove', path: memberPath });
+    } else {
+      createPatchAt(from[key], to[key], memberPath, patch);
+    }
+  }
+
+  for (const key of Object.keys(to)) {
+    if (!Object.hasOwn(from, key)) {
+      patch.push({ op: 'add', path: appendPointer(path, key), value: cloneJson(to[key]) });
+    }
+  }
+}
+
+function createArrayPatch(
+  from: unknown[],
+  to: unknown[],
+  path: string,
+  patch: JsonPatchOperation[],
+): void {
+  let prefixLength = 0;
+  while (prefixLength < from.length && prefixLength < to.length
+    && jsonEqual(from[prefixLength], to[prefixLength])) {
+    prefixLength += 1;
+  }
+
+  let suffixLength = 0;
+  while (suffixLength < from.length - prefixLength && suffixLength < to.length - prefixLength
+    && jsonEqual(from[from.length - suffixLength - 1], to[to.length - suffixLength - 1])) {
+    suffixLength += 1;
+  }
+
+  const fromMiddleLength = from.length - prefixLength - suffixLength;
+  const toMiddleLength = to.length - prefixLength - suffixLength;
+  const sharedMiddleLength = Math.min(fromMiddleLength, toMiddleLength);
+  for (let index = 0; index < sharedMiddleLength; index += 1) {
+    const arrayIndex = prefixLength + index;
+    createPatchAt(from[arrayIndex], to[arrayIndex], appendPointer(path, String(arrayIndex)), patch);
+  }
+
+  for (let index = fromMiddleLength - 1; index >= sharedMiddleLength; index -= 1) {
+    patch.push({ op: 'remove', path: appendPointer(path, String(prefixLength + index)) });
+  }
+
+  for (let index = sharedMiddleLength; index < toMiddleLength; index += 1) {
+    const arrayIndex = prefixLength + index;
+    const token = suffixLength === 0 ? '-' : String(arrayIndex);
+    patch.push({ op: 'add', path: appendPointer(path, token), value: cloneJson(to[arrayIndex]) });
+  }
+}
+
+function appendPointer(path: string, token: string): string {
+  return `${path}/${token.replaceAll('~', '~0').replaceAll('/', '~1')}`;
+}
