+
+test('creates a granular JSON Patch for nested object changes', () => {
+  const from = {
+    unchanged: true,
+    nested: { remove: 'old', update: 1, keep: 'yes' },
+  };
+  const to = {
+    unchanged: true,
+    nested: { update: 2, keep: 'yes', add: 'new' },
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'remove', path: '/nested/remove' },
+    { op: 'replace', path: '/nested/update', value: 2 },
+    { op: 'add', path: '/nested/add', value: 'new' },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    unchanged: true,
+    nested: { remove: 'old', update: 1, keep: 'yes' },
+  });
+  assert.deepEqual(to, {
+    unchanged: true,
+    nested: { update: 2, keep: 'yes', add: 'new' },
+  });
+});
+
+test('creates granular array changes and escapes JSON Pointer tokens', () => {
+  const from = { 'a/b': [1, 2, 3] };
+  const to = { 'a/b': [1, 4, 3, 5] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'replace', path: '/a~1b/1', value: 4 },
+    { op: 'add', path: '/a~1b/-', value: 5 },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test('preserves unchanged array elements when items are inserted or removed', () => {
+  assert.deepEqual(createPatch([1, 2], [0, 1, 2]), [
+    { op: 'add', path: '/0', value: 0 },
+  ]);
+  assert.deepEqual(createPatch([0, 1, 2], [1, 2]), [
+    { op: 'remove', path: '/0' },
+  ]);
+});
+
+test('creates an empty patch for equal documents and replaces different roots', () => {
+  assert.deepEqual(createPatch({ a: [true] }, { a: [true] }), []);
+  assert.deepEqual(createPatch({ old: true }, ['new']), [
+    { op: 'replace', path: '', value: ['new'] },
+  ]);
+});
+
+test('rejects non-JSON inputs when creating a patch', () => {
+  assert.throws(() => createPatch({ value: undefined }, {}));
+  assert.throws(() => createPatch({}, { value: Infinity }));
