+test('applies all RFC 6902 operations without mutating the source document', () => {
+  const source = { foo: ['bar', 'baz'], obj: { keep: true } };
+  const result = applyPatch(source, [
+    { op: 'add', path: '/foo/1', value: 'qux' },
+    { op: 'remove', path: '/foo/0' },
+    { op: 'copy', from: '/obj', path: '/copy' },
+    { op: 'replace', path: '/obj/keep', value: false },
+    { op: 'move', from: '/foo/1', path: '/foo/0' },
+    { op: 'test', path: '/copy/keep', value: true },
+  ]);
+
+  assert.deepEqual(result, {
+    foo: ['baz', 'qux'],
+    obj: { keep: false },
+    copy: { keep: true },
+  });
+  assert.deepEqual(source, { foo: ['bar', 'baz'], obj: { keep: true } });
+  assert.notEqual(result, source);
+});
+
+test('supports appending to arrays and replacing the document root', () => {
+  assert.deepEqual(
+    applyPatch({ values: [1] }, [{ op: 'add', path: '/values/-', value: 2 }]),
+    { values: [1, 2] },
+  );
+  assert.deepEqual(applyPatch({ old: true }, [{ op: 'replace', path: '', value: ['new'] }]), ['new']);
+});
+
+test('rejects malformed patches and failed operations', () => {
+  assert.throws(() => applyPatch({}, {}));
+  assert.throws(() => applyPatch({}, [{ op: 'add', path: 'missing', value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: 'replace', path: '/missing', value: 1 }]));
+  assert.throws(() => applyPatch({ value: 1 }, [{ op: 'test', path: '/value', value: 2 }]));
+  assert.throws(() => applyPatch({ a: {} }, [{ op: 'move', from: '/a', path: '/a/b' }]));
+});
