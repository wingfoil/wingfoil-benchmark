+/**
+ * Applies an RFC 6902 JSON Patch to a JSON document.
+ *
+ * The input document and all patch values must be JSON values. The returned
+ * document is independent from the input, even when the patch is empty.
+ *
+ * @param document The JSON document to update.
+ * @param patch An array of RFC 6902 operation objects.
+ * @returns The patched JSON document.
+ * @throws {TypeError} If the document or patch is invalid.
+ * @throws {Error} If an operation cannot be applied or a test fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  assertJsonValue(document, 'The document');
+
+  if (!Array.isArray(patch)) {
+    throw new TypeError('A JSON Patch must be an array of operations.');
+  }
+
+  let result = cloneJson(document);
+  for (const operation of patch) {
+    result = applyOperation(result, operation);
+  }
+
+  return result;
+}
+
+function applyOperation(document: unknown, operation: unknown): unknown {
+  if (!isJsonObject(operation)) {
+    throw new TypeError('A JSON Patch operation must be an object.');
+  }
+
+  const op = operation.op;
+  const path = operation.path;
+  if (!Object.hasOwn(operation, 'op') || !Object.hasOwn(operation, 'path')
+    || typeof op !== 'string' || typeof path !== 'string') {
+    throw new TypeError('A JSON Patch operation must have string "op" and "path" members.');
+  }
+
+  const pathTokens = parsePointer(path);
+  switch (op) {
+    case 'add':
+      requireValue(operation, op);
+      return addAt(document, pathTokens, cloneJson(operation.value));
+    case 'remove':
+      return removeAt(document, pathTokens);
+    case 'replace':
+      requireValue(operation, op);
+      assertExisting(document, pathTokens);
+      return replaceAt(document, pathTokens, cloneJson(operation.value));
+    case 'move':
+      return moveAt(document, pathTokens, operation);
+    case 'copy':
+      return copyAt(document, pathTokens, operation);
+    case 'test':
+      requireValue(operation, op);
+      if (!jsonEqual(resolveAt(document, pathTokens), operation.value)) {
+        throw new Error(`JSON Patch test operation failed at "${path}".`);
+      }
+      return document;
+    default:
+      throw new TypeError(`Unsupported JSON Patch operation "${op}".`);
+  }
+}
+
+function moveAt(document: unknown, path: string[], operation: Record<string, unknown>): unknown {
+  const from = getFrom(operation, 'move');
+  const fromTokens = parsePointer(from);
+  if (isProperPrefix(fromTokens, path)) {
+    throw new Error('A JSON Patch move destination cannot be inside its source.');
+  }
+  if (sameTokens(fromTokens, path)) {
+    return document;
+  }
+
+  const value = resolveAt(document, fromTokens);
+  return addAt(removeAt(document, fromTokens), path, value);
+}
+
+function copyAt(document: unknown, path: string[], operation: Record<string, unknown>): unknown {
+  const from = getFrom(operation, 'copy');
+  return addAt(document, path, cloneJson(resolveAt(document, parsePointer(from))));
+}
+
+function getFrom(operation: Record<string, unknown>, op: string): string {
+  if (typeof operation.from !== 'string') {
+    throw new TypeError(`A JSON Patch ${op} operation must have a string "from" member.`);
+  }
+  return operation.from;
+}
+
+function requireValue(operation: Record<string, unknown>, op: string): void {
+  if (!Object.hasOwn(operation, 'value')) {
+    throw new TypeError(`A JSON Patch ${op} operation must have a "value" member.`);
+  }
+  assertJsonValue(operation.value, 'A JSON Patch value');
+}
+
+function addAt(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return value;
+  }
+
+  const [parent, token] = resolveParent(document, tokens);
+  if (Array.isArray(parent)) {
+    if (token === '-') {
+      parent.push(value);
+    } else if (isArrayIndex(token) && Number(token) <= parent.length) {
+      parent.splice(Number(token), 0, value);
+    } else {
+      throw new Error(`JSON Patch add operation has invalid array index "${token}".`);
+    }
+  } else if (isObject(parent)) {
+    setObjectMember(parent, token, value);
+  } else {
+    throw new Error('JSON Patch path does not identify an object or array.');
+  }
+  return document;
+}
+
+function removeAt(document: unknown, tokens: string[]): unknown {
+  if (tokens.length === 0) {
+    throw new Error('A JSON Patch remove operation cannot remove the document root.');
+  }
+
+  const [parent, token] = resolveParent(document, tokens);
+  if (Array.isArray(parent)) {
+    if (!isArrayIndex(token) || Number(token) >= parent.length) {
+      throw new Error(`JSON Patch remove operation does not identify array element "${token}".`);
+    }
+    parent.splice(Number(token), 1);
+  } else if (isObject(parent) && Object.hasOwn(parent, token)) {
+    delete parent[token];
+  } else {
+    throw new Error(`JSON Patch remove operation does not identify object member "${token}".`);
+  }
+  return document;
+}
+
+function replaceAt(document: unknown, tokens: string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return value;
+  }
+
+  const [parent, token] = resolveParent(document, tokens);
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else if (isObject(parent)) {
+    setObjectMember(parent, token, value);
+  }
+  return document;
+}
+
+function assertExisting(document: unknown, tokens: string[]): void {
+  resolveAt(document, tokens);
+}
+
+function resolveAt(document: unknown, tokens: string[]): unknown {
+  let value = document;
+  for (const token of tokens) {
+    value = resolveToken(value, token);
+  }
+  return value;
+}
+
+function resolveParent(document: unknown, tokens: string[]): [unknown, string] {
+  return [resolveAt(document, tokens.slice(0, -1)), tokens[tokens.length - 1]];
+}
+
+function sameTokens(left: string[], right: string[]): boolean {
+  return left.length === right.length && left.every((token, index) => token === right[index]);
+}
+
+function isProperPrefix(prefix: string[], value: string[]): boolean {
+  return prefix.length < value.length && prefix.every((token, index) => token === value[index]);
+}
+
+function cloneJson(value: unknown): unknown {
+  if (Array.isArray(value)) {
+    return value.map(cloneJson);
+  }
+  if (isObject(value)) {
+    const result: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) {
+      setObjectMember(result, key, cloneJson(value[key]));
+    }
+    return result;
+  }
+  return value;
+}
+
+function assertJsonValue(value: unknown, description: string): void {
+  if (!isJsonValue(value, new WeakSet<object>())) {
+    throw new TypeError(`${description} must be a JSON value.`);
+  }
+}
+
+function isJsonValue(value: unknown, ancestors: WeakSet<object>): boolean {
+  if (value === null || typeof value === 'string' || typeof value === 'boolean') {
+    return true;
+  }
+  if (typeof value === 'number') {
+    return Number.isFinite(value);
+  }
+  if (!isObject(value) || ancestors.has(value)) {
+    return false;
+  }
+  if (Array.isArray(value)) {
+    if (Object.keys(value).length !== value.length) {
+      return false;
+    }
+    ancestors.add(value);
+    const valid = value.every((item) => isJsonValue(item, ancestors));
+    ancestors.delete(value);
+    return valid;
+  }
+  if (!isJsonObject(value)) {
+    return false;
+  }
+
+  ancestors.add(value);
+  const valid = Object.keys(value).every((key) => isJsonValue(value[key], ancestors));
+  ancestors.delete(value);
+  return valid;
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return isObject(value) && !Array.isArray(value)
+    && (Object.getPrototypeOf(value) === Object.prototype || Object.getPrototypeOf(value) === null);
+}
+
+function setObjectMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, {
+    configurable: true,
+    enumerable: true,
+    value,
+    writable: true,
+  });
+}
+
+function jsonEqual(left: unknown, right: unknown): boolean {
+  if (left === right) {
+    return true;
+  }
+  if (Array.isArray(left) && Array.isArray(right)) {
+    return left.length === right.length && left.every((value, index) => jsonEqual(value, right[index]));
+  }
+  if (isObject(left) && isObject(right) && !Array.isArray(left) && !Array.isArray(right)) {
+    const leftKeys = Object.keys(left);
+    const rightKeys = Object.keys(right);
+    return leftKeys.length === rightKeys.length
+      && leftKeys.every((key) => Object.hasOwn(right, key) && jsonEqual(left[key], right[key]));
+  }
+  return false;
+}
+
 function parsePointer(pointer: string): string[] {
   if (typeof pointer !== 'string') {
     throw new TypeError('A JSON Pointer must be a string.');
