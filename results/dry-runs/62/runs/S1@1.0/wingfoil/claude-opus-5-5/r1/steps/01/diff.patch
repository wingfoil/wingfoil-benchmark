--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,89 @@
+/**
+ * JSON Pointer (RFC 6901): identify a specific value within a JSON document.
+ *
+ * Pointers are accepted in their JSON string representation (RFC 6901, section 5),
+ * not in their URI fragment representation (section 6).
+ */
+
+/** Error thrown when a pointer is invalid or does not resolve to a value of the document. */
+export class JsonPointerError extends Error {
+  /** The pointer that caused the error. */
+  readonly pointer: string;
+
+  constructor(message: string, pointer: string) {
+    super(message);
+    this.name = "JsonPointerError";
+    this.pointer = pointer;
+  }
+}
+
+// array-index = %x30 / ( %x31-39 *(%x30-39) ), RFC 6901 section 4.
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+// An escape is "~" followed by "0" or "1"; any other "~" is invalid (section 3).
+const INVALID_ESCAPE = /~(?![01])/;
+
+/**
+ * Parses a JSON Pointer into its decoded reference tokens.
+ *
+ * @param pointer A JSON Pointer string, such as `"/foo/0"` or `""` for the whole document.
+ * @returns The reference tokens, with `~1` decoded to `/` and `~0` to `~`.
+ * @throws {JsonPointerError} When `pointer` is not a valid JSON Pointer.
+ */
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("JSON Pointer must be a string", String(pointer));
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new JsonPointerError(`Invalid JSON Pointer ${JSON.stringify(pointer)}: must be empty or start with "/"`, pointer);
+  }
+  if (INVALID_ESCAPE.test(pointer)) {
+    throw new JsonPointerError(`Invalid JSON Pointer ${JSON.stringify(pointer)}: "~" must be followed by "0" or "1"`, pointer);
+  }
+  // Decode "~1" before "~0", so that "~01" becomes "~1" and not "/" (section 4).
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => token.replaceAll("~1", "/").replaceAll("~0", "~"));
+}
+
+/**
+ * Returns the value of `document` that `pointer` refers to (RFC 6901).
+ *
+ * Only the document's own members are reachable: inherited properties such as
+ * `__proto__` or an array's `length` are not values of the JSON document.
+ *
+ * @param document A JSON value: an object, array, string, number, boolean or null.
+ * @param pointer A JSON Pointer string; `""` refers to the whole document.
+ * @returns The referenced value.
+ * @throws {JsonPointerError} When `pointer` is not a valid JSON Pointer, or does not resolve to a value of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let value = document;
+  for (const token of parsePointer(pointer)) {
+    value = resolveToken(value, token, pointer);
+  }
+  return value;
+}
+
+function resolveToken(value: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(value)) {
+    if (!ARRAY_INDEX.test(token)) {
+      throw new JsonPointerError(`JSON Pointer ${JSON.stringify(pointer)}: ${JSON.stringify(token)} is not a valid array index`, pointer);
+    }
+    const index = Number(token);
+    if (index >= value.length) {
+      throw new JsonPointerError(`JSON Pointer ${JSON.stringify(pointer)}: array index ${token} is out of range`, pointer);
+    }
+    return value[index];
+  }
+  if (typeof value === "object" && value !== null) {
+    if (!Object.prototype.hasOwnProperty.call(value, token)) {
+      throw new JsonPointerError(`JSON Pointer ${JSON.stringify(pointer)}: member ${JSON.stringify(token)} does not exist`, pointer);
+    }
+    return (value as Record<string, unknown>)[token];
+  }
+  throw new JsonPointerError(`JSON Pointer ${JSON.stringify(pointer)}: cannot resolve ${JSON.stringify(token)} in a primitive value`, pointer);
+}
diff --git a/test/resolve-pointer.test.ts b/test/resolve-pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0dbe8609a29179007d85944a6a3f307cc606d3e3
--- /dev/null
+++ b/test/resolve-pointer.test.ts
@@ -0,0 +1,94 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { JsonPointerError, parsePointer, resolvePointer } from "../src/index.ts";
+
+// The example document of RFC 6901, section 5.
+const rfcDocument = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("resolves every example of RFC 6901 section 5", () => {
+  assert.equal(resolvePointer(rfcDocument, ""), rfcDocument);
+  assert.deepEqual(resolvePointer(rfcDocument, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfcDocument, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfcDocument, "/"), 0);
+  assert.equal(resolvePointer(rfcDocument, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfcDocument, "/c%d"), 2);
+  assert.equal(resolvePointer(rfcDocument, "/e^f"), 3);
+  assert.equal(resolvePointer(rfcDocument, "/g|h"), 4);
+  assert.equal(resolvePointer(rfcDocument, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfcDocument, '/k"l'), 6);
+  assert.equal(resolvePointer(rfcDocument, "/ "), 7);
+  assert.equal(resolvePointer(rfcDocument, "/m~0n"), 8);
+});
+
+test("decodes ~1 before ~0, so ~01 is the literal ~1", () => {
+  assert.equal(resolvePointer({ "~1": "tilde-one", "/": "slash" }, "/~01"), "tilde-one");
+});
+
+test("resolves nested values and falsy values", () => {
+  const doc = { a: { b: [{ c: null }, false, 0, ""] } };
+  assert.equal(resolvePointer(doc, "/a/b/0/c"), null);
+  assert.equal(resolvePointer(doc, "/a/b/1"), false);
+  assert.equal(resolvePointer(doc, "/a/b/2"), 0);
+  assert.equal(resolvePointer(doc, "/a/b/3"), "");
+});
+
+test("resolves the root of a primitive document", () => {
+  assert.equal(resolvePointer(42, ""), 42);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("treats numeric-looking tokens as member names in objects", () => {
+  assert.equal(resolvePointer({ "01": "x", "-": "y" }, "/01"), "x");
+  assert.equal(resolvePointer({ "01": "x", "-": "y" }, "/-"), "y");
+});
+
+test("rejects pointers that are not valid JSON Pointers", () => {
+  for (const pointer of ["foo", "#/foo", "/a~", "/a~2", "/~x"]) {
+    assert.throws(() => resolvePointer(rfcDocument, pointer), JsonPointerError, pointer);
+  }
+});
+
+test("rejects a pointer that is not a string", () => {
+  assert.throws(() => resolvePointer(rfcDocument, 1 as unknown as string), JsonPointerError);
+});
+
+test("rejects missing object members", () => {
+  assert.throws(() => resolvePointer(rfcDocument, "/missing"), JsonPointerError);
+  assert.throws(() => resolvePointer({ a: {} }, "/a/b/c"), JsonPointerError);
+});
+
+test("does not resolve inherited properties", () => {
+  for (const pointer of ["/__proto__", "/constructor", "/toString", "/foo/length", "/foo/map"]) {
+    assert.throws(() => resolvePointer(rfcDocument, pointer), JsonPointerError, pointer);
+  }
+});
+
+test("rejects array indices that are malformed or out of range", () => {
+  for (const pointer of ["/foo/2", "/foo/-", "/foo/01", "/foo/-1", "/foo/1.0", "/foo/ 1", "/foo/", "/foo/1e0"]) {
+    assert.throws(() => resolvePointer(rfcDocument, pointer), JsonPointerError, pointer);
+  }
+});
+
+test("rejects descending into a primitive value", () => {
+  assert.throws(() => resolvePointer({ a: "text" }, "/a/0"), JsonPointerError);
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"), JsonPointerError);
+  assert.throws(() => resolvePointer(7, "/x"), JsonPointerError);
+});
+
+test("parsePointer returns the decoded reference tokens", () => {
+  assert.deepEqual(parsePointer(""), []);
+  assert.deepEqual(parsePointer("/"), [""]);
+  assert.deepEqual(parsePointer("/a~1b/m~0n//0"), ["a/b", "m~n", "", "0"]);
+  assert.throws(() => parsePointer("a"), JsonPointerError);
+});
