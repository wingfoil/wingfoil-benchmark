@@ -0,0 +1,106 @@
+/**
+ * JSON Pointer (RFC 6901): identify a specific value within a JSON document.
+ *
+ * Pointers are accepted in their JSON string representation (RFC 6901, section 5),
+ * not in their URI fragment representation (section 6).
+ */
+
+/** Error thrown when a pointer is invalid or does not resolve to a value of the document. */
+export class JsonPointerError extends Error {
+  /** The pointer that caused the error. */
+  readonly pointer: string;
+
+  constructor(message: string, pointer: string) {
+    super(message);
+    this.name = "JsonPointerError";
+    this.pointer = pointer;
+  }
+}
+
+// array-index = %x30 / ( %x31-39 *(%x30-39) ), RFC 6901 section 4.
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+// An escape is "~" followed by "0" or "1"; any other "~" is invalid (section 3).
+const INVALID_ESCAPE = /~(?![01])/;
+
+/**
+ * Parses a JSON Pointer into its decoded reference tokens.
+ *
+ * @param pointer A JSON Pointer string, such as `"/foo/0"` or `""` for the whole document.
+ * @returns The reference tokens, with `~1` decoded to `/` and `~0` to `~`.
+ * @throws {JsonPointerError} When `pointer` is not a valid JSON Pointer.
+ */
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("JSON Pointer must be a string", String(pointer));
+  }
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new JsonPointerError(`Invalid JSON Pointer ${JSON.stringify(pointer)}: must be empty or start with "/"`, pointer);
+  }
+  if (INVALID_ESCAPE.test(pointer)) {
+    throw new JsonPointerError(`Invalid JSON Pointer ${JSON.stringify(pointer)}: "~" must be followed by "0" or "1"`, pointer);
+  }
+  // Decode "~1" before "~0", so that "~01" becomes "~1" and not "/" (section 4).
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => token.replaceAll("~1", "/").replaceAll("~0", "~"));
+}
+
+/**
+ * Returns the value of `document` that `pointer` refers to (RFC 6901).
+ *
+ * Only the document's own members are reachable: inherited properties such as
+ * `__proto__` or an array's `length` are not values of the JSON document.
+ *
+ * @param document A JSON value: an object, array, string, number, boolean or null.
+ * @param pointer A JSON Pointer string; `""` refers to the whole document.
+ * @returns The referenced value.
+ * @throws {JsonPointerError} When `pointer` is not a valid JSON Pointer, or does not resolve to a value of `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  return resolveTokens(document, parsePointer(pointer), pointer);
+}
+
+/**
+ * Returns the value of `document` that the decoded reference `tokens` of `pointer` refer to.
+ *
+ * Internal to the library (not re-exported by `index.ts`): it lets JSON Patch resolve the parent of
+ * a target from tokens it has already parsed.
+ *
+ * @throws {JsonPointerError} When the tokens do not resolve to a value of `document`.
+ */
+export function resolveTokens(document: unknown, tokens: readonly string[], pointer: string): unknown {
+  let value = document;
+  for (const token of tokens) {
+    value = resolveToken(value, token, pointer);
+  }
+  return value;
+}
+
+/** Array index syntax of RFC 6901, section 4: `0` or a number without leading zeros. */
+export function isArrayIndex(token: string): boolean {
+  return ARRAY_INDEX.test(token);
+}
+
+function resolveToken(value: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(value)) {
+    if (!ARRAY_INDEX.test(token)) {
+      throw new JsonPointerError(`JSON Pointer ${JSON.stringify(pointer)}: ${JSON.stringify(token)} is not a valid array index`, pointer);
+    }
+    const index = Number(token);
+    if (index >= value.length) {
+      throw new JsonPointerError(`JSON Pointer ${JSON.stringify(pointer)}: array index ${token} is out of range`, pointer);
+    }
+    return value[index];
+  }
+  if (typeof value === "object" && value !== null) {
+    if (!Object.prototype.hasOwnProperty.call(value, token)) {
+      throw new JsonPointerError(`JSON Pointer ${JSON.stringify(pointer)}: member ${JSON.stringify(token)} does not exist`, pointer);
+    }
+    return (value as Record<string, unknown>)[token];
+  }
+  throw new JsonPointerError(`JSON Pointer ${JSON.stringify(pointer)}: cannot resolve ${JSON.stringify(token)} in a primitive value`, pointer);
+}
diff --git a/test/apply-patch.test.ts b/test/apply-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bf9e2b1199884bca4273c309fc120fa460aa03ea
--- /dev/null
+++ b/test/apply-patch.test.ts
@@ -0,0 +1,330 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, JsonPatchError, JsonPointerError } from "../src/index.ts";
+
+// RFC 6902, appendix A: every example, in order.
+
+test("A.1 adds an object member", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+});
+
+test("A.2 adds an array element", () => {
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), {
+    foo: ["bar", "qux", "baz"],
+  });
+});
+
+test("A.3 removes an object member", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+});
+
+test("A.4 removes an array element", () => {
+  assert.deepEqual(applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), { foo: ["bar", "baz"] });
+});
+
+test("A.5 replaces a value", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), {
+    baz: "boo",
+    foo: "bar",
+  });
+});
+
+test("A.6 moves a value", () => {
+  const doc = { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } };
+  assert.deepEqual(applyPatch(doc, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]), {
+    foo: { bar: "baz" },
+    qux: { corge: "grault", thud: "fred" },
+  });
+});
+
+test("A.7 moves an array element", () => {
+  const doc = { foo: ["all", "grass", "cows", "eat"] };
+  assert.deepEqual(applyPatch(doc, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+});
+
+test("A.8 tests a value: success", () => {
+  const doc = { baz: "qux", foo: ["a", 2, "c"] };
+  const patch = [
+    { op: "test", path: "/baz", value: "qux" },
+    { op: "test", path: "/foo/1", value: 2 },
+  ];
+  assert.deepEqual(applyPatch(doc, patch), doc);
+});
+
+test("A.9 tests a value: error", () => {
+  assert.throws(() => applyPatch({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]), JsonPatchError);
+});
+
+test("A.10 adds a nested member object", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]), {
+    foo: "bar",
+    child: { grandchild: {} },
+  });
+});
+
+test("A.11 ignores unrecognized elements in an operation", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }]), {
+    foo: "bar",
+    baz: "qux",
+  });
+});
+
+test("A.12 adding to a nonexistent target is an error", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]), JsonPatchError);
+});
+
+test("A.14 decodes ~ escapes in paths", () => {
+  const doc = { "/": 9, "~1": 10 };
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/~01", value: 10 }]), doc);
+});
+
+test("A.15 comparing strings and numbers fails", () => {
+  const doc = { "/": 9, "~1": 10 };
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/~01", value: "10" }]), JsonPatchError);
+});
+
+test("A.16 adds an array value", () => {
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]), {
+    foo: ["bar", ["abc", "def"]],
+  });
+});
+
+// add
+
+test("add replaces an existing member", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+});
+
+test("add at the end of an array, by index or by -", () => {
+  assert.deepEqual(applyPatch([1, 2], [{ op: "add", path: "/2", value: 3 }]), [1, 2, 3]);
+  assert.deepEqual(applyPatch([], [{ op: "add", path: "/-", value: 1 }]), [1]);
+});
+
+test("add on the root replaces the whole document", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+});
+
+test("add accepts null and falsy values", () => {
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a", value: null }]), { a: null });
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a", value: false }]), { a: false });
+});
+
+test("add treats numeric-looking tokens as member names in objects", () => {
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/-", value: 1 }]), { "-": 1 });
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/01", value: 1 }]), { "01": 1 });
+});
+
+test("add rejects array indices that are out of range or malformed", () => {
+  for (const path of ["/3", "/01", "/-1", "/1.0", "/a", "/"]) {
+    assert.throws(() => applyPatch([1, 2], [{ op: "add", path, value: 0 }]), JsonPatchError, path);
+  }
+});
+
+test("add into a primitive value is an error", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 0 }]), JsonPatchError);
+});
+
+test("add creates an own __proto__ member without touching any prototype", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as Record<string, unknown>;
+  assert.ok(Object.prototype.hasOwnProperty.call(result, "__proto__"));
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+});
+
+// remove
+
+test("remove a nested value and the last array element", () => {
+  assert.deepEqual(applyPatch({ a: { b: 1, c: 2 } }, [{ op: "remove", path: "/a/b" }]), { a: { c: 2 } });
+  assert.deepEqual(applyPatch([1, 2], [{ op: "remove", path: "/1" }]), [1]);
+});
+
+test("remove a missing location is an error", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "/b" }]), JsonPatchError);
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/1" }]), JsonPatchError);
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/-" }]), JsonPatchError);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/constructor" }]), JsonPatchError);
+});
+
+test("remove the whole document is an error", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]), JsonPatchError);
+});
+
+// replace
+
+test("replace an array element and the root", () => {
+  assert.deepEqual(applyPatch([1, 2], [{ op: "replace", path: "/0", value: 9 }]), [9, 2]);
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: 42 }]), 42);
+});
+
+test("replace a missing location is an error", () => {
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]), JsonPatchError);
+  assert.throws(() => applyPatch([], [{ op: "replace", path: "/0", value: 1 }]), JsonPatchError);
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/-", value: 1 }]), JsonPatchError);
+});
+
+// move
+
+test("move onto its own location leaves the document unchanged", () => {
+  assert.deepEqual(applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a" }]), { a: { b: 1 } });
+});
+
+test("move to the root and to the end of an array", () => {
+  assert.deepEqual(applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "" }]), { b: 1 });
+  assert.deepEqual(applyPatch({ a: 1, l: [0] }, [{ op: "move", from: "/a", path: "/l/-" }]), { l: [0, 1] });
+});
+
+test("move into one of its own children is an error", () => {
+  assert.throws(() => applyPatch({ a: { b: {} } }, [{ op: "move", from: "/a", path: "/a/b/c" }]), JsonPatchError);
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "", path: "/a/b" }]), JsonPatchError);
+});
+
+test("move to a sibling whose name starts with the source name is allowed", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/ab" }]), { ab: 1 });
+});
+
+test("move from a missing location is an error", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "/b", path: "/c" }]), JsonPatchError);
+});
+
+// copy
+
+test("copy a value, and the copy is independent of its source", () => {
+  const result = applyPatch({ a: { b: 1 } }, [
+    { op: "copy", from: "/a", path: "/c" },
+    { op: "replace", path: "/c/b", value: 2 },
+  ]);
+  assert.deepEqual(result, { a: { b: 1 }, c: { b: 2 } });
+});
+
+test("copy into its own child and to the end of an array", () => {
+  assert.deepEqual(applyPatch({ a: { b: 1 } }, [{ op: "copy", from: "/a", path: "/a/c" }]), {
+    a: { b: 1, c: { b: 1 } },
+  });
+  assert.deepEqual(applyPatch([1], [{ op: "copy", from: "/0", path: "/-" }]), [1, 1]);
+});
+
+test("copy from a missing location is an error", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", from: "/b", path: "/c" }]), JsonPatchError);
+});
+
+// test
+
+test("test compares values structurally", () => {
+  const doc = { o: { a: 1, b: [1, { c: null }] }, n: 1, e: [], z: {} };
+  const patch = [
+    { op: "test", path: "/o", value: { b: [1, { c: null }], a: 1 } },
+    { op: "test", path: "/n", value: 1.0 },
+    { op: "test", path: "/e", value: [] },
+    { op: "test", path: "/z", value: {} },
+    { op: "test", path: "", value: doc },
+  ];
+  assert.deepEqual(applyPatch(doc, patch), doc);
+});
+
+test("test fails on any structural difference", () => {
+  const cases: [unknown, unknown][] = [
+    [{ a: 1 }, { a: 1, b: 2 }],
+    [{ a: 1, b: 2 }, { a: 1 }],
+    [{ a: 1 }, { b: 1 }],
+    [[1, 2], [2, 1]],
+    [[1], [1, 1]],
+    [[], {}],
+    [{}, []],
+    [null, {}],
+    [0, false],
+    [null, false],
+    [1, "1"],
+    [{ a: undefined }, {}],
+  ];
+  for (const [actual, expected] of cases) {
+    assert.throws(() => applyPatch({ x: actual }, [{ op: "test", path: "/x", value: expected }]), JsonPatchError);
+  }
+});
+
+test("test on a missing location is an error", () => {
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/a", value: null }]), JsonPatchError);
+});
+
+// Invalid patches
+
+test("rejects a patch that is not an array", () => {
+  for (const patch of [null, {}, "[]", { op: "add", path: "/a", value: 1 }]) {
+    assert.throws(() => applyPatch({}, patch as never), JsonPatchError);
+  }
+});
+
+test("rejects malformed operations", () => {
+  const operations = [
+    null,
+    "add",
+    [],
+    { path: "/a", value: 1 },
+    { op: "unknown", path: "/a" },
+    { op: 1, path: "/a" },
+    { op: "add", value: 1 },
+    { op: "add", path: 1, value: 1 },
+    { op: "add", path: "/a" },
+    { op: "replace", path: "/a" },
+    { op: "test", path: "/a" },
+    { op: "move", path: "/a" },
+    { op: "copy", path: "/a" },
+    { op: "move", from: 1, path: "/b" },
+    { op: "add", path: "a", value: 1 },
+    { op: "add", path: "/a~2", value: 1 },
+    { op: "copy", from: "a", path: "/b" },
+  ];
+  for (const operation of operations) {
+    assert.throws(() => applyPatch({ a: 1 }, [operation] as never), JsonPatchError, JSON.stringify(operation));
+  }
+});
+
+test("errors carry the index of the failing operation and the pointer error as cause", () => {
+  const patch = [
+    { op: "add", path: "/a", value: 1 },
+    { op: "remove", path: "/missing" },
+  ];
+  assert.throws(
+    () => applyPatch({}, patch),
+    (error: unknown) =>
+      error instanceof JsonPatchError &&
+      error.index === 1 &&
+      error.operation === patch[1] &&
+      error.cause instanceof JsonPointerError,
+  );
+});
+
+test("an empty patch returns an equal copy of the document", () => {
+  const doc = { a: [1, { b: 2 }] };
+  const result = applyPatch(doc, []);
+  assert.deepEqual(result, doc);
+  assert.notEqual(result, doc);
+});
+
+// Immutability
+
+test("never mutates the document or the patch, even when an operation fails", () => {
+  const doc = { a: { b: [1, 2] }, c: 1 };
+  const snapshot = structuredClone(doc);
+  const patch = [
+    { op: "add", path: "/a/b/-", value: { d: 1 } },
+    { op: "remove", path: "/c" },
+    { op: "move", from: "/a/b/0", path: "/e" },
+  ];
+  const patchSnapshot = structuredClone(patch);
+  const result = applyPatch(doc, patch) as { a: { b: unknown[] } };
+  assert.deepEqual(doc, snapshot);
+  assert.deepEqual(patch, patchSnapshot);
+  assert.deepEqual(result, { a: { b: [2, { d: 1 }] }, e: 1 });
+
+  assert.throws(() => applyPatch(doc, [{ op: "remove", path: "/c" }, { op: "remove", path: "/c" }]), JsonPatchError);
+  assert.deepEqual(doc, snapshot);
+});
+
+test("the result shares no value with the patch", () => {
+  const value = { nested: [1] };
+  const result = applyPatch({}, [{ op: "add", path: "/v", value }]) as { v: { nested: number[] } };
+  result.v.nested.push(2);
+  assert.deepEqual(value, { nested: [1] });
+});
