+++ b/src/json-patch.ts
@@ -0,0 +1,257 @@
+/**
+ * JSON Patch (RFC 6902): apply a sequence of operations to a JSON document.
+ *
+ * The input document and patch are never mutated: the patch is applied to a deep copy of the
+ * document, and the values it inserts are copied too, so the result shares nothing with its inputs.
+ */
+
+import { isArrayIndex, JsonPointerError, parsePointer, resolveTokens } from "./json-pointer.ts";
+
+/** One operation of a JSON Patch (RFC 6902, section 4). Members other than these are ignored. */
+export type JsonPatchOperation =
+  | { op: "add"; path: string; value: unknown }
+  | { op: "remove"; path: string }
+  | { op: "replace"; path: string; value: unknown }
+  | { op: "move"; from: string; path: string }
+  | { op: "copy"; from: string; path: string }
+  | { op: "test"; path: string; value: unknown };
+
+/** A JSON Patch: the operations to apply, in order. */
+export type JsonPatch = readonly JsonPatchOperation[];
+
+/** Error thrown when a patch is invalid or one of its operations fails. */
+export class JsonPatchError extends Error {
+  /** Position in the patch of the operation that failed; `undefined` when the patch itself is not an array. */
+  readonly index: number | undefined;
+  /** The operation that failed, as given in the patch; the patch itself when it is not an array. */
+  readonly operation: unknown;
+
+  constructor(message: string, index: number | undefined, operation: unknown, options?: ErrorOptions) {
+    super(message, options);
+    this.name = "JsonPatchError";
+    this.index = index;
+    this.operation = operation;
+  }
+}
+
+/** Failure of an operation that is not a pointer error; wrapped into a `JsonPatchError` by `applyPatch`. */
+class OperationError extends Error {}
+
+type Document = unknown;
+type Container = unknown[] | Record<string, unknown>;
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the resulting document.
+ *
+ * Operations are applied in order; the first one that fails stops the evaluation and nothing is
+ * returned, so a patch is applied entirely or not at all. Neither `document` nor `patch` is modified.
+ *
+ * @param document A JSON value: an object, array, string, finite number, boolean or null.
+ * @param patch An array of operations: `add`, `remove`, `replace`, `move`, `copy` or `test`.
+ * @returns A new document, the result of applying every operation of `patch` to `document`.
+ * @throws {JsonPatchError} When `patch` is not an array, an operation is malformed (unknown `op`,
+ *   missing or invalid `path`, `from` or `value`), a location does not exist, a `move` targets one of
+ *   its own children, a `test` fails, or `document` or a `value` is not a JSON value. Its `cause` is
+ *   the underlying `JsonPointerError` when a pointer is invalid or does not resolve.
+ */
+export function applyPatch(document: Document, patch: JsonPatch): Document {
+  if (!Array.isArray(patch)) {
+    throw new JsonPatchError("A JSON Patch must be an array of operations", undefined, patch);
+  }
+  let result: Document;
+  try {
+    result = cloneJson(document);
+  } catch (error) {
+    throw new JsonPatchError(`Invalid document: ${(error as Error).message}`, undefined, patch, { cause: error });
+  }
+  patch.forEach((operation: unknown, index) => {
+    try {
+      result = applyOperation(result, operation);
+    } catch (error) {
+      if (!(error instanceof JsonPointerError || error instanceof OperationError)) {
+        throw error;
+      }
+      throw new JsonPatchError(`JSON Patch operation ${index} failed: ${error.message}`, index, operation, { cause: error });
+    }
+  });
+  return result;
+}
+
+function applyOperation(document: Document, operation: unknown): Document {
+  if (typeof operation !== "object" || operation === null || Array.isArray(operation)) {
+    throw new OperationError("an operation must be an object");
+  }
+  const members = operation as Record<string, unknown>;
+  const path = pointerMember(members, "path");
+  switch (members.op) {
+    case "add":
+      return add(document, parsePointer(path), valueMember(members), path);
+    case "remove":
+      remove(document, parsePointer(path), path);
+      return document;
+    case "replace":
+      return replace(document, parsePointer(path), valueMember(members), path);
+    case "move":
+      return move(document, pointerMember(members, "from"), path);
+    case "copy": {
+      const from = pointerMember(members, "from");
+      return add(document, parsePointer(path), cloneJson(resolveTokens(document, parsePointer(from), from)), path);
+    }
+    case "test":
+      test(document, parsePointer(path), valueMember(members), path);
+      return document;
+    default:
+      throw new OperationError(`unknown operation ${JSON.stringify(members.op)}`);
+  }
+}
+
+function pointerMember(members: Record<string, unknown>, name: "path" | "from"): string {
+  const pointer = members[name];
+  if (!Object.hasOwn(members, name) || typeof pointer !== "string") {
+    throw new OperationError(`"${name}" must be a JSON Pointer string`);
+  }
+  return pointer;
+}
+
+function valueMember(members: Record<string, unknown>): unknown {
+  if (!Object.hasOwn(members, "value")) {
+    throw new OperationError(`"value" is required by "${String(members.op)}"`);
+  }
+  return cloneJson(members.value);
+}
+
+// RFC 6902, section 4.1.
+function add(document: Document, tokens: string[], value: unknown, path: string): Document {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const token = tokens[tokens.length - 1];
+  const parent = resolveParent(document, tokens, path);
+  if (Array.isArray(parent)) {
+    if (token === "-") {
+      parent.push(value);
+    } else if (isArrayIndex(token) && Number(token) <= parent.length) {
+      parent.splice(Number(token), 0, value);
+    } else {
+      throw new OperationError(`cannot add at ${JSON.stringify(path)}: ${JSON.stringify(token)} is not an index from 0 to ${parent.length} or "-"`);
+    }
+  } else {
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+// RFC 6902, section 4.2. Returns the removed value.
+function remove(document: Document, tokens: string[], path: string): unknown {
+  if (tokens.length === 0) {
+    throw new OperationError("cannot remove the whole document");
+  }
+  // Resolving the target first rejects a missing member, an out-of-range or malformed index, and "-".
+  const removed = resolveTokens(document, tokens, path);
+  const token = tokens[tokens.length - 1];
+  const parent = resolveParent(document, tokens, path);
+  if (Array.isArray(parent)) {
+    parent.splice(Number(token), 1);
+  } else {
+    delete parent[token];
+  }
+  return removed;
+}
+
+// RFC 6902, section 4.3.
+function replace(document: Document, tokens: string[], value: unknown, path: string): Document {
+  resolveTokens(document, tokens, path);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const token = tokens[tokens.length - 1];
+  const parent = resolveParent(document, tokens, path);
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else {
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+// RFC 6902, section 4.4.
+function move(document: Document, from: string, path: string): Document {
+  const fromTokens = parsePointer(from);
+  const pathTokens = parsePointer(path);
+  const isPrefix = fromTokens.length <= pathTokens.length && fromTokens.every((token, i) => token === pathTokens[i]);
+  if (isPrefix && fromTokens.length < pathTokens.length) {
+    throw new OperationError(`cannot move ${JSON.stringify(from)} into its own child ${JSON.stringify(path)}`);
+  }
+  if (isPrefix) {
+    // Moving a value onto itself changes nothing, but its location must still exist.
+    resolveTokens(document, fromTokens, from);
+    return document;
+  }
+  return add(document, pathTokens, remove(document, fromTokens, from), path);
+}
+
+// RFC 6902, section 4.6.
+function test(document: Document, tokens: string[], value: unknown, path: string): void {
+  if (!jsonEqual(resolveTokens(document, tokens, path), value)) {
+    throw new OperationError(`test failed: the value at ${JSON.stringify(path)} is not equal to ${JSON.stringify(value)}`);
+  }
+}
+
+function resolveParent(document: Document, tokens: string[], path: string): Container {
+  const parent = resolveTokens(document, tokens.slice(0, -1), path);
+  if (typeof parent !== "object" || parent === null) {
+    throw new OperationError(`cannot change ${JSON.stringify(path)}: its parent is a primitive value`);
+  }
+  return parent as Container;
+}
+
+// Defines an own data property, so that a member named "__proto__" is a member and not a prototype.
+function setMember(object: Record<string, unknown>, name: string, value: unknown): void {
+  Object.defineProperty(object, name, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Deep copy of a JSON value; throws an `OperationError` for any value that is not JSON. */
+function cloneJson(value: unknown): unknown {
+  if (value === null || typeof value === "string" || typeof value === "boolean") {
+    return value;
+  }
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) {
+      throw new OperationError(`${value} is not a JSON number`);
+    }
+    return value;
+  }
+  if (Array.isArray(value)) {
+    return value.map(cloneJson);
+  }
+  if (typeof value === "object" && isPlainObject(value)) {
+    const copy: Record<string, unknown> = {};
+    for (const [name, member] of Object.entries(value)) {
+      setMember(copy, name, cloneJson(member));
+    }
+    return copy;
+  }
+  throw new OperationError(`${typeof value === "object" ? "a non-plain object" : typeof value} is not a JSON value`);
+}
+
+function isPlainObject(value: object): boolean {
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
+
+// RFC 6902, section 4.6: same type, and equal members (in any order) or elements (in order).
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((element, i) => jsonEqual(element, b[i]));
+  }
+  if (typeof a === "object" && a !== null && typeof b === "object" && b !== null) {
+    const aMembers = a as Record<string, unknown>;
+    const bMembers = b as Record<string, unknown>;
+    const names = Object.keys(aMembers);
+    return (
+      names.length === Object.keys(bMembers).length &&
+      names.every((name) => Object.hasOwn(bMembers, name) && jsonEqual(aMembers[name], bMembers[name]))
+    );
+  }
+  return a === b;
+}
