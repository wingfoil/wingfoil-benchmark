new file mode 100644
index 0000000000000000000000000000000000000000..26dcaaaa261860e70ed0f61a197077be191cb6cd
--- /dev/null
+++ b/src/json-value.ts
@@ -0,0 +1,65 @@
+/**
+ * JSON values (RFC 8259) at the JavaScript boundary: validation and deep copy, shared by JSON Patch
+ * and JSON Merge Patch so that both accept exactly the same values.
+ */
+
+/** A value that is not JSON: `undefined`, a function, a non-finite number, a non-plain object, a hole, a cycle. */
+export class JsonValueError extends Error {}
+
+// Defines an own data property, so that a member named "__proto__" is a member and not a prototype.
+export function setMember(object: Record<string, unknown>, name: string, value: unknown): void {
+  Object.defineProperty(object, name, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/**
+ * Deep copy of a JSON value; throws a `JsonValueError` for any value that is not JSON.
+ *
+ * `ancestors` holds the containers being copied around `value`: meeting one again is a cycle, which no
+ * JSON text can represent. An object found twice elsewhere (not a cycle) is copied twice.
+ */
+export function cloneJson(value: unknown, ancestors: Set<object> = new Set()): unknown {
+  if (value === null || typeof value === "string" || typeof value === "boolean") {
+    return value;
+  }
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) {
+      throw new JsonValueError(`${value} is not a JSON number`);
+    }
+    return value;
+  }
+  if (typeof value === "object" && (Array.isArray(value) || isPlainObject(value))) {
+    if (ancestors.has(value)) {
+      throw new JsonValueError("a cyclic structure is not a JSON value");
+    }
+    ancestors.add(value);
+    const copy = Array.isArray(value) ? cloneArray(value, ancestors) : cloneObject(value, ancestors);
+    ancestors.delete(value);
+    return copy;
+  }
+  throw new JsonValueError(`${typeof value === "object" ? "a non-plain object" : typeof value} is not a JSON value`);
+}
+
+function cloneArray(array: unknown[], ancestors: Set<object>): unknown[] {
+  const copy: unknown[] = [];
+  for (let index = 0; index < array.length; index++) {
+    // A hole of a sparse array is not a JSON value (map would keep it as a hole).
+    if (!Object.hasOwn(array, index)) {
+      throw new JsonValueError(`a sparse array, with a hole at index ${index}, is not a JSON value`);
+    }
+    copy.push(cloneJson(array[index], ancestors));
+  }
+  return copy;
+}
+
+function cloneObject(object: object, ancestors: Set<object>): Record<string, unknown> {
+  const copy: Record<string, unknown> = {};
+  for (const [name, member] of Object.entries(object)) {
+    setMember(copy, name, cloneJson(member, ancestors));
+  }
+  return copy;
+}
+
+export function isPlainObject(value: object): boolean {
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
