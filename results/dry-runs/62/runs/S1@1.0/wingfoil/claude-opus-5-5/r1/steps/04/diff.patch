+/**
+ * JSON Merge Patch (RFC 7386): describe changes to a JSON document with a document that resembles it.
+ *
+ * The target and patch are never mutated: both are validated and deep-copied first, and the merge is
+ * applied to the copies, so the result shares nothing with its inputs.
+ */
+
+import { cloneJson, setMember } from "./json-value.ts";
+
+/** Error thrown when the target or the patch is not a JSON value. */
+export class JsonMergePatchError extends Error {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = "JsonMergePatchError";
+  }
+}
+
+type Members = Record<string, unknown>;
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the merged document.
+ *
+ * An object patch changes the members it names, recursively: a `null` member removes the member from
+ * the target, any other value is merged into it. A target that is not an object is first replaced by
+ * an empty object. A patch that is not an object (an array, a string, a number, a boolean or `null`)
+ * replaces the target entirely. Neither `target` nor `patch` is modified.
+ *
+ * @param target A JSON value: an object, array, string, finite number, boolean or null.
+ * @param patch A JSON value describing the changes.
+ * @returns A new document, the result of merging `patch` into `target`.
+ * @throws {JsonMergePatchError} When `target` or `patch` is not a JSON value (`undefined`, a function,
+ *   a non-finite number, a non-plain object, a sparse array, a cyclic structure, a structure too deep
+ *   for the call stack...). It is the only error thrown: its `cause` is the underlying error.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  try {
+    return merge(cloneJson(target), cloneJson(patch));
+  } catch (error) {
+    // Any error, including one raised by a getter or by a value too deeply nested to copy or merge.
+    const message = error instanceof Error ? error.message : String(error);
+    throw new JsonMergePatchError(`Invalid JSON Merge Patch input: ${message}`, { cause: error });
+  }
+}
+
+// RFC 7386, section 2: the MergePatch(Target, Patch) function, applied in place to copies.
+function merge(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return patch;
+  }
+  const result: Members = isObject(target) ? target : {};
+  for (const [name, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[name];
+    } else {
+      // Only own members are members of the target: an inherited "constructor" is not merged into.
+      setMember(result, name, merge(Object.hasOwn(result, name) ? result[name] : undefined, value));
+    }
+  }
+  return result;
+}
+
+// A JSON object; the inputs are copies made by cloneJson, so any non-array object is a plain one.
+function isObject(value: unknown): value is Members {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
