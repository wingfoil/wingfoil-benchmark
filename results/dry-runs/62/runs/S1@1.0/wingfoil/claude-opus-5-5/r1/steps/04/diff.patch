@@ -0,0 +1,146 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch, JsonMergePatchError } from "../src/index.ts";
+
+// RFC 7386, appendix A: every example, in order (target, patch, result).
+const APPENDIX_A: [unknown, unknown, unknown][] = [
+  [{ a: "b" }, { a: "c" }, { a: "c" }],
+  [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+  [{ a: "b" }, { a: null }, {}],
+  [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+  [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+  [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+  [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+  [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+  [["a", "b"], ["c", "d"], ["c", "d"]],
+  [{ a: "b" }, ["c"], ["c"]],
+  [{ a: "foo" }, null, null],
+  [{ a: "foo" }, "bar", "bar"],
+  [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+  [[1, 2], { a: "b", c: null }, { a: "b" }],
+  [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+];
+
+APPENDIX_A.forEach(([target, patch, result], i) => {
+  test(`appendix A example ${i + 1}`, () => {
+    assert.deepEqual(applyMergePatch(target, patch), result);
+  });
+});
+
+test("section 3 example: changes, removes and adds members at any depth", () => {
+  const target = {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = { title: "Hello!", phoneNumber: "+01-123-456-7890", author: { familyName: null }, tags: ["example"] };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+});
+
+test("removing a missing member changes nothing", () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, { b: null }), { a: 1 });
+});
+
+test("an object patch replaces a primitive target with an object", () => {
+  assert.deepEqual(applyMergePatch("text", { a: 1, b: null }), { a: 1 });
+  assert.deepEqual(applyMergePatch(null, { a: { b: null, c: 2 } }), { a: { c: 2 } });
+});
+
+test("null inside an array of the patch is kept as a value", () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, { a: [null, { b: null }] }), { a: [null, { b: null }] });
+});
+
+test("the empty patch object leaves an object target unchanged", () => {
+  assert.deepEqual(applyMergePatch({ a: { b: 1 } }, {}), { a: { b: 1 } });
+});
+
+test("neither target nor patch is modified, and the result shares no object with them", () => {
+  const target = { a: { b: 1 }, keep: { k: [1] } };
+  const patch = { a: { c: [2] }, d: { e: 3 } };
+  const targetCopy = structuredClone(target);
+  const patchCopy = structuredClone(patch);
+  const result = applyMergePatch(target, patch) as Record<string, any>;
+  assert.deepEqual(result, { a: { b: 1, c: [2] }, keep: { k: [1] }, d: { e: 3 } });
+  assert.deepEqual(target, targetCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.notEqual(result, target);
+  assert.notEqual(result.keep, target.keep);
+  assert.notEqual(result.keep.k, target.keep.k);
+  assert.notEqual(result.a.c, patch.a.c);
+  assert.notEqual(result.d, patch.d);
+  assert.deepEqual(applyMergePatch(target, ["x"]), ["x"]);
+  assert.notEqual(applyMergePatch(target, patch.a.c), patch.a.c);
+});
+
+test("a member named __proto__ is merged as an ordinary member", () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}}');
+  const result = applyMergePatch({}, patch) as Record<string, unknown>;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  const removed = applyMergePatch(JSON.parse('{"__proto__": 1, "a": 2}'), JSON.parse('{"__proto__": null}'));
+  assert.deepEqual(Object.keys(removed as object), ["a"]);
+});
+
+test("inherited properties of the target are not members", () => {
+  assert.deepEqual(applyMergePatch({}, { constructor: { a: null } }), { constructor: {} });
+  assert.deepEqual(applyMergePatch({}, { toString: null }), {});
+});
+
+const NOT_JSON: [string, unknown][] = [
+  ["undefined", undefined],
+  ["a function", () => 1],
+  ["NaN", NaN],
+  ["Infinity", Infinity],
+  ["a Date", new Date(0)],
+  ["a class instance", new (class Point { x = 1 })()],
+  ["a sparse array", [1, , 3]],
+  ["a bigint", 1n],
+];
+
+for (const [name, value] of NOT_JSON) {
+  test(`rejects ${name} in the patch or the target`, () => {
+    assert.throws(() => applyMergePatch({}, { a: value }), JsonMergePatchError);
+    assert.throws(() => applyMergePatch({ a: value }, {}), JsonMergePatchError);
+  });
+}
+
+test("rejects a non-JSON target member even where the patch replaces it", () => {
+  assert.throws(() => applyMergePatch({ a: undefined }, { a: 1 }), JsonMergePatchError);
+  assert.throws(() => applyMergePatch(undefined, "x"), JsonMergePatchError);
+});
+
+test("rejects a cyclic structure", () => {
+  const cyclic: Record<string, unknown> = {};
+  cyclic.self = cyclic;
+  assert.throws(() => applyMergePatch({}, cyclic), JsonMergePatchError);
+  assert.throws(() => applyMergePatch(cyclic, {}), JsonMergePatchError);
+  const shared = { x: 1 };
+  assert.deepEqual(applyMergePatch({}, { a: shared, b: shared }), { a: { x: 1 }, b: { x: 1 } });
+});
+
+test("any error raised while reading the inputs is a JsonMergePatchError with the error as cause", () => {
+  const failure = new Error("boom");
+  const patch = {
+    get a() {
+      throw failure;
+    },
+  };
+  assert.throws(
+    () => applyMergePatch({}, patch),
+    (error: unknown) => error instanceof JsonMergePatchError && error.cause === failure && error.name === "JsonMergePatchError",
+  );
+});
+
+test("a structure nested too deeply for the call stack is a JsonMergePatchError", () => {
+  let deep: unknown = 1;
+  for (let i = 0; i < 1e6; i++) deep = [deep];
+  assert.throws(() => applyMergePatch({}, deep), JsonMergePatchError);
+});
