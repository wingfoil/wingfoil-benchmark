+++ b/src/create-patch.ts
@@ -0,0 +1,187 @@
+/**
+ * JSON Patch (RFC 6902) generation: compute the operations that turn one JSON document into another.
+ *
+ * The patch describes only what changed: equal parts produce no operation, objects are compared member
+ * by member and arrays element by element, aligned on their longest common subsequence so that an
+ * element inserted or removed does not resend the elements after it.
+ */
+
+import type { JsonPatchOperation } from "./json-patch.ts";
+import { cloneJson } from "./json-value.ts";
+
+/** Error thrown when `from` or `to` is not a JSON value. */
+export class JsonDiffError extends Error {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = "JsonDiffError";
+  }
+}
+
+type Members = Record<string, unknown>;
+
+// Above this many cells (elements of one array times elements of the other, once their common start and
+// end are set aside), the arrays are compared position by position instead of aligned, to bound memory.
+const MAX_ALIGNMENT_CELLS = 4_000_000;
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch contains only `add`, `remove` and `replace` operations, on the smallest locations that
+ * differ: an empty patch when the documents are equal (object members in any order), the changed
+ * members of an object, and the inserted, removed or changed elements of an array. A value whose type
+ * changes is replaced whole. Neither `from` nor `to` is modified, and the patch shares no object with them.
+ *
+ * @param from A JSON value: an object, array, string, finite number, boolean or null.
+ * @param to The JSON value the patch must produce.
+ * @returns The operations, in the order they must be applied.
+ * @throws {JsonDiffError} When `from` or `to` is not a JSON value (`undefined`, a function, a non-finite
+ *   number, a non-plain object, a sparse array, a cyclic structure, a structure too deep for the call
+ *   stack...). It is the only error thrown: its `cause` is the underlying error.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  try {
+    const patch: JsonPatchOperation[] = [];
+    // The copies validate both inputs, and the values put in the patch are taken from the copy of `to`.
+    diff(cloneJson(from), cloneJson(to), "", patch);
+    return patch;
+  } catch (error) {
+    // Any error, including one raised by a getter or by a value too deeply nested to copy or compare.
+    const message = error instanceof Error ? error.message : String(error);
+    throw new JsonDiffError(`Invalid JSON Patch generation input: ${message}`, { cause: error });
+  }
+}
+
+function diff(from: unknown, to: unknown, path: string, patch: JsonPatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, patch);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from, to, path, patch);
+  } else if (from !== to) {
+    patch.push({ op: "replace", path, value: to });
+  }
+}
+
+function diffObjects(from: Members, to: Members, path: string, patch: JsonPatchOperation[]): void {
+  for (const name of Object.keys(from)) {
+    const memberPath = `${path}/${escapeToken(name)}`;
+    if (Object.hasOwn(to, name)) {
+      diff(from[name], to[name], memberPath, patch);
+    } else {
+      patch.push({ op: "remove", path: memberPath });
+    }
+  }
+  for (const name of Object.keys(to)) {
+    if (!Object.hasOwn(from, name)) {
+      patch.push({ op: "add", path: `${path}/${escapeToken(name)}`, value: to[name] });
+    }
+  }
+}
+
+/**
+ * Elements kept unchanged (equal and aligned) produce nothing. Between two kept elements, the removed
+ * and inserted elements are paired in order and each pair is diffed in place, so that a changed element
+ * gives a change inside it; the extra ones are then removed or added.
+ */
+function diffArrays(from: unknown[], to: unknown[], path: string, patch: JsonPatchOperation[]): void {
+  const fromKeys = from.map(canonical);
+  const toKeys = to.map(canonical);
+  let fromIndex = 0;
+  let toIndex = 0;
+  // At each step, the elements before `toIndex` of the patched array are those of `to`.
+  for (const [fromKept, toKept] of [...alignment(fromKeys, toKeys), [from.length, to.length]]) {
+    const removed = fromKept - fromIndex;
+    const inserted = toKept - toIndex;
+    const paired = Math.min(removed, inserted);
+    for (let i = 0; i < paired; i++) {
+      diff(from[fromIndex + i], to[toIndex + i], `${path}/${toIndex + i}`, patch);
+    }
+    for (let i = paired; i < removed; i++) {
+      patch.push({ op: "remove", path: `${path}/${toIndex + paired}` });
+    }
+    for (let i = paired; i < inserted; i++) {
+      patch.push({ op: "add", path: `${path}/${toIndex + i}`, value: to[toIndex + i] });
+    }
+    fromIndex = fromKept + 1;
+    toIndex = toKept + 1;
+  }
+}
+
+/**
+ * Pairs of indexes `[i, j]`, increasing in both, of equal elements `from[i]` and `to[j]` kept in place:
+ * the common start and end, and between them a longest common subsequence. Arrays too large to align
+ * keep only their common start and end.
+ */
+function alignment(from: string[], to: string[]): [number, number][] {
+  let start = 0;
+  while (start < from.length && start < to.length && from[start] === to[start]) {
+    start++;
+  }
+  let end = 0;
+  while (end < from.length - start && end < to.length - start && from[from.length - 1 - end] === to[to.length - 1 - end]) {
+    end++;
+  }
+  const pairs: [number, number][] = [];
+  for (let i = 0; i < start; i++) {
+    pairs.push([i, i]);
+  }
+  const fromMiddle = from.slice(start, from.length - end);
+  const toMiddle = to.slice(start, to.length - end);
+  if (fromMiddle.length * toMiddle.length <= MAX_ALIGNMENT_CELLS) {
+    for (const [i, j] of longestCommonSubsequence(fromMiddle, toMiddle)) {
+      pairs.push([start + i, start + j]);
+    }
+  }
+  for (let k = end; k > 0; k--) {
+    pairs.push([from.length - k, to.length - k]);
+  }
+  return pairs;
+}
+
+// Classic dynamic programming: lengths[i * (m + 1) + j] is the LCS length of a[i..] and b[j..].
+function longestCommonSubsequence(a: string[], b: string[]): [number, number][] {
+  const n = a.length;
+  const m = b.length;
+  const width = m + 1;
+  const lengths = new Uint32Array((n + 1) * width);
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lengths[i * width + j] =
+        a[i] === b[j] ? lengths[(i + 1) * width + j + 1] + 1 : Math.max(lengths[(i + 1) * width + j], lengths[i * width + j + 1]);
+    }
+  }
+  const pairs: [number, number][] = [];
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (a[i] === b[j]) {
+      pairs.push([i++, j++]);
+    } else if (lengths[(i + 1) * width + j] >= lengths[i * width + j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
+
+// A text equal for two JSON values exactly when they are equal: members sorted by name, numbers by value.
+function canonical(value: unknown): string {
+  if (Array.isArray(value)) {
+    return `[${value.map(canonical).join(",")}]`;
+  }
+  if (isObject(value)) {
+    const names = Object.keys(value).sort();
+    return `{${names.map((name) => `${JSON.stringify(name)}:${canonical(value[name])}`).join(",")}}`;
+  }
+  return JSON.stringify(value);
+}
+
+// RFC 6901, section 3: "~" is written "~0" and "/" is written "~1" (in that order).
+function escapeToken(name: string): string {
+  return name.replaceAll("~", "~0").replaceAll("/", "~1");
+}
+
+// A JSON object; the values compared are copies made by cloneJson, so any non-array object is a plain one.
+function isObject(value: unknown): value is Members {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
