+++ b/test/create-patch.test.ts
@@ -0,0 +1,154 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch, JsonDiffError } from "../src/index.ts";
+
+// Asserts that the patch turns `from` into `to`, and returns it for further checks.
+function roundTrip(from: unknown, to: unknown) {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(createPatch({ a: [1, { b: null }] }, { a: [1, { b: null }] }), []);
+  assert.deepEqual(createPatch("x", "x"), []);
+});
+
+test("object members in a different order are equal", () => {
+  assert.deepEqual(createPatch({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+});
+
+test("a changed member is replaced, and only it", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1, b: 3 }), [{ op: "replace", path: "/b", value: 3 }]);
+});
+
+test("added and removed members give add and remove", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("a change deep inside a large document touches only that place", () => {
+  const from = { config: { services: Array.from({ length: 50 }, (_, i) => ({ name: `s${i}`, port: 8000 + i })) } };
+  const to = structuredClone(from);
+  to.config.services[42].port = 9999;
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/config/services/42/port", value: 9999 }]);
+});
+
+test("a member set to null is replaced, not removed", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+});
+
+test("a change of type replaces the value", () => {
+  assert.deepEqual(roundTrip({ a: [1] }, { a: { 0: 1 } }), [{ op: "replace", path: "/a", value: { 0: 1 } }]);
+  assert.deepEqual(roundTrip({ a: "1" }, { a: 1 }), [{ op: "replace", path: "/a", value: 1 }]);
+});
+
+test("a different root value replaces the whole document", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip(1, null), [{ op: "replace", path: "", value: null }]);
+});
+
+test("member names are escaped in paths", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "m~n": 2 }, { "a/b": 3, "m~n": 4, "": 5 }), [
+    { op: "replace", path: "/a~1b", value: 3 },
+    { op: "replace", path: "/m~0n", value: 4 },
+    { op: "add", path: "/", value: 5 },
+  ]);
+});
+
+test("an element appended to an array is a single add", () => {
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+});
+
+test("an element inserted at the start of an array is a single add", () => {
+  const from = Array.from({ length: 20 }, (_, i) => ({ id: i }));
+  const to = [{ id: -1 }, ...from];
+  assert.deepEqual(roundTrip(from, to), [{ op: "add", path: "/0", value: { id: -1 } }]);
+});
+
+test("an element removed from the middle of an array is a single remove", () => {
+  assert.deepEqual(roundTrip(["a", "b", "c", "d"], ["a", "c", "d"]), [{ op: "remove", path: "/1" }]);
+});
+
+test("a changed element of an array is diffed in place", () => {
+  assert.deepEqual(roundTrip([{ id: 1, v: "x" }, { id: 2, v: "y" }], [{ id: 1, v: "x" }, { id: 2, v: "z" }]), [
+    { op: "replace", path: "/1/v", value: "z" },
+  ]);
+});
+
+test("insertions and removals at several places of an array round-trip", () => {
+  roundTrip([1, 2, 3, 4, 5, 6], [0, 1, 3, 4, 7, 8, 6, 9]);
+  roundTrip(["a", "b", "c"], []);
+  roundTrip([], ["a", "b", "c"]);
+  roundTrip([1, 2, 3], [3, 2, 1]);
+  roundTrip([[1, 2], { a: [3] }], [{ a: [3, 4] }, [1, 2], [1]]);
+});
+
+test("generated patches round-trip on many pseudo-random documents", () => {
+  // A fixed linear congruential generator keeps the test deterministic.
+  let seed = 12345;
+  const next = (n: number) => (seed = (seed * 1103515245 + 12345) % 2147483648) % n;
+  const randomValue = (depth: number): unknown => {
+    const kind = next(depth > 2 ? 4 : 6);
+    if (kind === 0) return null;
+    if (kind === 1) return next(4);
+    if (kind === 2) return ["a", "b", "c"][next(3)];
+    if (kind === 3) return next(2) === 0;
+    if (kind === 4) return Array.from({ length: next(5) }, () => randomValue(depth + 1));
+    return Object.fromEntries(Array.from({ length: next(4) }, () => [["x", "y", "z", "~/"][next(4)], randomValue(depth + 1)]));
+  };
+  for (let i = 0; i < 300; i++) {
+    roundTrip(randomValue(0), randomValue(0));
+  }
+});
+
+test("neither input is modified, and the patch shares no object with them", () => {
+  const from = { a: [1, { b: 2 }], c: { d: 1 } };
+  const to = { a: [1, { b: 3 }, { e: [4] }], f: { g: 5 } };
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  for (const operation of patch) {
+    if ("value" in operation) {
+      assert.notEqual(operation.value, to.a[2]);
+      assert.notEqual(operation.value, to.f);
+    }
+  }
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("a member named __proto__ is an ordinary member", () => {
+  const from = JSON.parse('{"__proto__": {"a": 1}}');
+  const to = JSON.parse('{"__proto__": {"a": 2}, "constructor": 1}');
+  assert.deepEqual(roundTrip(from, to), [
+    { op: "replace", path: "/__proto__/a", value: 2 },
+    { op: "add", path: "/constructor", value: 1 },
+  ]);
+  assert.equal(({} as Record<string, unknown>).a, undefined);
+});
+
+test("large, fully different arrays still give a correct patch", () => {
+  const from = Array.from({ length: 3000 }, (_, i) => i);
+  const to = Array.from({ length: 3000 }, (_, i) => -i - 1);
+  roundTrip(from, to);
+});
+
+test("inputs that are not JSON values throw a JsonDiffError", () => {
+  const cyclic: Record<string, unknown> = {};
+  cyclic.self = cyclic;
+  const throwing = Object.defineProperty({}, "a", { enumerable: true, get: () => { throw new TypeError("boom"); } });
+  for (const value of [undefined, () => 1, NaN, new Date(0), [1, , 3], cyclic, throwing, { a: undefined }]) {
+    assert.throws(() => createPatch(value, {}), (error: unknown) => error instanceof JsonDiffError && error.cause !== undefined);
+    assert.throws(() => createPatch({}, value), JsonDiffError);
+  }
+});
+
+test("a structure too deep for the call stack throws a JsonDiffError", () => {
+  let deep: unknown = 1;
+  for (let i = 0; i < 100000; i++) deep = [deep];
+  assert.throws(() => createPatch(deep, 2), JsonDiffError);
+});
