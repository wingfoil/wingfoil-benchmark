diff --git a/src/domain/validation.ts b/src/domain/validation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b9f9809121e64af821487a37c3c6b32d1c300ce1
--- /dev/null
+++ b/src/domain/validation.ts
@@ -0,0 +1,58 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { NewTask } from './task.ts';
+
+/** The longest title a task may have, once surrounding spaces are removed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a title: it must not be empty or only spaces, nor longer than {@link MAX_TITLE_LENGTH}
+ * characters once trimmed.
+ *
+ * @param title - the title as the user typed it
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title is empty: give the task a title');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; the most allowed is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be one of `low`, `normal` and `high`.
+ *
+ * @param priority - the priority as given
+ */
+export function validatePriority(priority: string): Result<string> {
+  if (PRIORITIES.some((known) => known === priority)) return ok(priority);
+  return err('invalid-input', `the priority "${priority}" is not one of ${PRIORITIES.join(', ')}`);
+}
+
+/**
+ * Checks a tag: it must not be empty and must not contain a space.
+ *
+ * @param tag - the tag as given
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'the tag is empty: give a tag a name');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space; tags are a single word`);
+  return ok(tag);
+}
+
+/**
+ * Checks everything a new task is given: its title, its priority when there is one, and each tag.
+ *
+ * @param input - the task to add
+ */
+export function validateNewTask(input: NewTask): Result<NewTask> {
+  const checks = [
+    validateTitle(input.title),
+    ...(input.priority === undefined ? [] : [validatePriority(input.priority)]),
+    ...(input.tags ?? []).map(validateTag),
+  ];
+  const failed = checks.find((check) => !check.ok);
+  return failed === undefined || failed.ok ? ok(input) : failed;
+}
diff --git a/test/list.test.ts b/test/list.test.ts
index 3ba33949496b003acfc1473d6341d23b02d0d6fd..43c4668f9943eefd2b41015566dc81b2814badad 100644
--- a/test/list.test.ts
+++ b/test/list.test.ts
@@ -181,3 +181,39 @@ describe('task timestamps', () => {
     assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
   });
 });
+
+describe('input validation', () => {
+  function rejected(result: { ok: boolean; error?: { code: string; message: string } }, pattern: RegExp): void {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+    assert.match(result.error?.message ?? '', pattern);
+  }
+
+  it('refuses an empty title, or one of only spaces, and a title over 120 characters', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: '' }), /empty/);
+    rejected(list.add({ title: '   ' }), /empty/);
+    rejected(list.add({ title: 'x'.repeat(121) }), /121.*120/);
+    assert.equal(list.add({ title: 'x'.repeat(120) }).ok, true);
+    assert.equal(list.list().length, 1);
+  });
+
+  it('refuses an unknown priority and a bad tag when adding, and does not use up an id', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: 'A', priority: 'urgent' as 'high' }), /urgent/);
+    rejected(list.add({ title: 'A', tags: ['ok', ''] }), /empty/);
+    rejected(list.add({ title: 'A', tags: ['two words'] }), /space/);
+    assert.equal(list.list().length, 0);
+    assert.equal(valueOf(list.add({ title: 'A' })).id, 'task-1');
+  });
+
+  it('refuses a bad rename or tag and leaves the task as it was', () => {
+    const list = createTodoList(steppingClock());
+    const before = valueOf(list.add({ title: 'Buy milk' }));
+    rejected(list.rename('Buy milk', '  '), /empty/);
+    rejected(list.rename('Buy milk', 'y'.repeat(121)), /120/);
+    rejected(list.tag('Buy milk', ''), /empty/);
+    rejected(list.tag('Buy milk', 'a b'), /space/);
+    assert.deepEqual(valueOf(list.find('Buy milk')), before);
+  });
+});
