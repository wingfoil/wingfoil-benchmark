@@ -8,11 +8,24 @@ function valueOf<T>(result: { ok: true; value: T } | { ok: false; error: unknown
   return result.value;
 }
 
+function steppingClock(): () => string {
+  let minute = 0;
+  return () => new Date(Date.UTC(2026, 0, 1, 0, minute++)).toISOString();
+}
+
 describe('task list', () => {
   it('adds an open task with a normal priority by default', () => {
-    const list = createTodoList();
+    const list = createTodoList(() => '2026-01-01T00:00:00.000Z');
     const task = valueOf(list.add({ title: '  Buy milk ' }));
-    assert.deepEqual(task, { id: 'task-1', title: 'Buy milk', priority: 'normal', tags: [], status: 'open' });
+    assert.deepEqual(task, {
+      id: 'task-1',
+      title: 'Buy milk',
+      priority: 'normal',
+      tags: [],
+      status: 'open',
+      createdAt: '2026-01-01T00:00:00.000Z',
+      updatedAt: '2026-01-01T00:00:00.000Z',
+    });
     assert.equal(list.openCount(), 1);
   });
 
@@ -128,3 +141,43 @@ describe('task ids', () => {
     assert.equal(valueOf(list.find('task-1')).id, second.id);
   });
 });
+
+describe('task timestamps', () => {
+  it('gives a new task the same createdAt and updatedAt', () => {
+    const task = valueOf(createTodoList(steppingClock()).add({ title: 'a' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every kind of change and keeps createdAt', () => {
+    const list = createTodoList(steppingClock());
+    list.add({ title: 'a' });
+    const changes = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.rename('a', 'b'),
+      () => list.tag('b', 'x'),
+      () => list.untag('b', 'x'),
+    ];
+    changes.forEach((change, index) => {
+      const task = valueOf(change());
+      assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+      assert.equal(task.updatedAt, `2026-01-01T00:0${index + 1}:00.000Z`);
+    });
+    assert.equal(valueOf(list.get('task-1')).updatedAt, '2026-01-01T00:05:00.000Z');
+  });
+
+  it('leaves updatedAt alone when a change is refused', () => {
+    const list = createTodoList(steppingClock());
+    list.add({ title: 'a' });
+    list.add({ title: 'b' });
+    assert.equal(list.complete('missing').ok, false);
+    assert.equal(list.rename('a', 'b').ok, false);
+    assert.equal(valueOf(list.find('a')).updatedAt, '2026-01-01T00:00:00.000Z');
+  });
+
+  it('uses the system clock by default', () => {
+    const task = valueOf(createTodoList().add({ title: 'a' }));
+    assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
+  });
+});
