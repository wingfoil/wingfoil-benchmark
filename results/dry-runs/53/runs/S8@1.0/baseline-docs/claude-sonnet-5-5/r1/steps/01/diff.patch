+
+describe('task ids', () => {
+  it('gives each task an id of its own, never reused after a removal', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    const b = valueOf(list.add({ title: 'b' }));
+    list.remove('b');
+    const c = valueOf(list.add({ title: 'c' }));
+    assert.equal(new Set([a.id, b.id, c.id]).size, 3);
+  });
+
+  it('does not spend an id on a refused duplicate', () => {
+    const list = createTodoList();
+    list.add({ title: 'a' });
+    list.add({ title: 'a' });
+    assert.equal(valueOf(list.add({ title: 'b' })).id, 'task-2');
+  });
+
+  it('gets a task by id, even after it is renamed', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'Old' }));
+    list.rename('Old', 'New');
+    assert.equal(valueOf(list.get(id)).title, 'New');
+  });
+
+  it('reports an unknown id as not found', () => {
+    const result = createTodoList().get('nope');
+    assert.equal(result.ok, false);
+    if (!result.ok) assert.equal(result.error.code, 'not-found');
+  });
+
+  it('accepts an id wherever a title is taken', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'Task' }));
+    assert.equal(valueOf(list.find(id)).title, 'Task');
+    assert.equal(valueOf(list.complete(id)).status, 'done');
+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.deepEqual(valueOf(list.tag(id, 'x')).tags, ['x']);
+    assert.deepEqual(valueOf(list.untag(id, 'x')).tags, []);
+    assert.equal(valueOf(list.rename(id, 'Other')).title, 'Other');
+    assert.equal(valueOf(list.get(id)).title, 'Other');
+    assert.equal(valueOf(list.remove(id)).id, id);
+    assert.equal(list.get(id).ok, false);
+  });
+
+  it('renames a task to its own title, by id, without a duplicate error', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'Same' }));
+    assert.equal(valueOf(list.rename(id, 'Same')).title, 'Same');
+  });
+
+  it('prefers a title over an id written the same', () => {
+    const list = createTodoList();
+    list.add({ title: 'first' });
+    const second = valueOf(list.add({ title: 'task-1' }));
+    assert.equal(valueOf(list.find('task-1')).id, second.id);
+  });
+});
