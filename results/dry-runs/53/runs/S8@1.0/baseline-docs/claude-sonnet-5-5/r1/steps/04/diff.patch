+
+describe('importTasks', () => {
+  it('adds every valid line, with priority and tags, skipping blank lines', () => {
+    const list = createTodoList(() => '2026-01-01T00:00:00.000Z');
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\nBuy milk;;\r\nCall Ann');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = valueOf(list.find('Renew the insurance'));
+    assert.equal(insurance.priority, 'high');
+    assert.deepEqual(insurance.tags, ['admin', 'money']);
+    assert.equal(valueOf(list.find('Buy milk')).priority, 'normal');
+  });
+
+  it('reports each refused line with its number, counting blank lines', () => {
+    const list = createTodoList();
+    list.add({ title: 'Buy milk' });
+    const report = importTasks(list, ';high;\n\nWalk;urgent;\nBuy milk;;\nA;;b;c\nFine;low;x');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(report.rejected.map((r) => r.line), [1, 3, 4, 5]);
+    assert.equal(list.find('Fine').ok, true);
