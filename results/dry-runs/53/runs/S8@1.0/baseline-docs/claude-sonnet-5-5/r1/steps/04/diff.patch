@@ -22,3 +22,11 @@ Input is checked when a task is added, renamed or tagged, and a refused change l
 title must not be empty or only spaces, nor longer than 120 characters (after trimming); a priority must
 be `low`, `normal` or `high`; a tag must not be empty or contain a space. A refusal is a failed `Result`
 with the code `invalid-input` and a message saying what is wrong.
+
+`importTasks(list, text)` adds many tasks at once, for teams moving from a spreadsheet. The text holds
+one task per line, as `title;priority;tags`: the priority may be left empty for a normal one, tags are
+separated by spaces (`Renew the insurance;high;admin money`), and blank lines are skipped. Each line is
+checked like `add` does, so a line with an empty title, an unknown priority, a duplicate title or more
+than three fields is refused without stopping the others. It returns `{ imported, rejected }`: how many
+tasks were added, and each refused line as `{ line, reason }`, `line` counting from 1 over all lines,
+blank ones included.
diff --git a/src/domain/import.ts b/src/domain/import.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4fac21793b3cc1172777cf2af841afafd60b030a
--- /dev/null
+++ b/src/domain/import.ts
@@ -0,0 +1,50 @@
+import type { TaskList } from './list.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** A line of the import text that could not be added, with its number (from 1) and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text` to `list`, one per line as `title;priority;tags`. The priority may be
+ * empty for a normal one, tags are separated by spaces, and blank lines are skipped. A line the list
+ * refuses is reported, with its number, and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the tasks, one per line
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r?\n/).forEach((content, index) => {
+    if (content.trim() === '') return;
+    const added = addLine(list, content);
+    if (added === undefined) imported += 1;
+    else rejected.push({ line: index + 1, reason: added });
+  });
+  return { imported, rejected };
+}
+
+/** Adds one line to the list; returns why it was refused, or nothing when it was added. */
+function addLine(list: TaskList, content: string): string | undefined {
+  const fields = content.split(';');
+  if (fields.length > 3) {
+    return `the line has ${fields.length} fields; expected at most 3: title;priority;tags`;
+  }
+  const [title = '', priority = '', tags = ''] = fields;
+  const input: NewTask = {
+    title,
+    ...(priority.trim() === '' ? {} : { priority: priority.trim() as Priority }),
+    tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+  };
+  const result = list.add(input);
+  return result.ok ? undefined : result.error.message;
+}
