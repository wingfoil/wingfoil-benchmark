diff --git a/test/diff.test.ts b/test/diff.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fa4d93f558fefb9a863aab976645390d59dcc6b0
--- /dev/null
+++ b/test/diff.test.ts
@@ -0,0 +1,55 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (a: unknown, b: unknown) => {
+  const ca = structuredClone(a);
+  const cb = structuredClone(b);
+  const p = createPatch(a, b);
+  assert.deepEqual(a, ca);
+  assert.deepEqual(b, cb);
+  assert.deepEqual(applyPatch(a, p), b);
+  return p;
+};
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small change in nested object", () => {
+  assert.deepEqual(roundTrip({ a: { b: 1, c: 2 }, d: 3 }, { a: { b: 1, c: 5 }, d: 3 }),
+    [{ op: "replace", path: "/a/c", value: 5 }]);
+});
+
+test("escaping, root and type changes", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "~": 1 }, { "a/b": 2, "~": 1 }), [{ op: "replace", path: "/a~1b", value: 2 }]);
+  roundTrip(1, [1]);
+  roundTrip({ a: 1 }, null);
+  roundTrip({ a: null }, { a: [] });
+  roundTrip({ __proto__x: 1 }, {});
+});
+
+test("array insert / remove", () => {
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 9, 2, 3]), [{ op: "add", path: "/1", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([{ a: 1 }, { a: 2 }], [{ a: 2 }]), [{ op: "remove", path: "/0" }]);
+});
+
+test("array move touches only the moved item", () => {
+  const p = roundTrip([1, 2, 3, 4, 5], [2, 3, 4, 1, 5]);
+  assert.ok(p.length <= 2);
+  roundTrip([{ id: 1 }, { id: 2 }, { id: 3 }], [{ id: 3 }, { id: 1 }, { id: 2 }]);
+});
+
+test("array element modified in place", () => {
+  assert.deepEqual(roundTrip([{ a: 1 }, { a: 2 }], [{ a: 1 }, { a: 3 }]), [{ op: "replace", path: "/1/a", value: 3 }]);
+});
+
+test("randomized round trips", () => {
+  let s = 7;
+  const r = (n: number) => ((s = (s * 1103515245 + 12345) & 0x7fffffff), s % n);
+  const gen = (d: number): unknown =>
+    r(d > 2 ? 3 : 6) < 3 ? r(4) : r(2) ? Array.from({ length: r(5) }, () => gen(d + 1))
+      : Object.fromEntries(Array.from({ length: r(4) }, () => ["k" + r(4), gen(d + 1)]));
+  for (let i = 0; i < 500; i++) roundTrip(gen(0), gen(0));
+});
