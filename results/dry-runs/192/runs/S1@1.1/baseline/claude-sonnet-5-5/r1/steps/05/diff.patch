+import { deepEqual } from "./patch.ts";
+import type { PatchOperation } from "./patch.ts";
+import type { JsonValue } from "./pointer.ts";
+
+const has = (o: object, k: string) => Object.prototype.hasOwnProperty.call(o, k);
+const isObject = (v: unknown): v is Record<string, JsonValue> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+const escape = (token: string) => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+/** Indices of a longest common subsequence of `a` and `b`, as matched [i, j] pairs. */
+function lcs(a: JsonValue[], b: JsonValue[]): Array<[number, number]> {
+  const n = a.length;
+  const m = b.length;
+  const table: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      table[i][j] = deepEqual(a[i], b[j]) ? table[i + 1][j + 1] + 1 : Math.max(table[i + 1][j], table[i][j + 1]);
+    }
+  }
+  const pairs: Array<[number, number]> = [];
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (deepEqual(a[i], b[j])) pairs.push([i++, j++]);
+    else if (table[i + 1][j] >= table[i][j + 1]) i++;
+    else j++;
+  }
+  return pairs;
+}
+
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, ops: PatchOperation[]): void {
+  // Matched pairs, plus a sentinel closing the final gap.
+  const matches = [...lcs(from, to), [from.length, to.length] as [number, number]];
+  let fi = 0; // next unprocessed index in `from`
+  let ti = 0; // next unprocessed index in `to`; also the position in the evolving array
+  for (const [mi, mj] of matches) {
+    const removed = mi - fi;
+    const added = mj - ti;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) diffValues(from[fi + k], to[ti + k], `${path}/${ti + k}`, ops);
+    for (let k = paired; k < removed; k++) ops.push({ op: "remove", path: `${path}/${ti + paired}` });
+    for (let k = paired; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${ti + k}`, value: structuredClone(to[ti + k]) });
+    }
+    fi = mi + 1;
+    ti = mj + 1;
+  }
+}
+
+function diffValues(from: JsonValue, to: JsonValue, path: string, ops: PatchOperation[]): void {
+  if (deepEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) ops.push({ op: "remove", path: `${path}/${escape(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const p = `${path}/${escape(key)}`;
+      if (!has(from, key)) ops.push({ op: "add", path: p, value: structuredClone(to[key]) });
+      else diffValues(from[key], to[key], p, ops);
+    }
+  } else {
+    ops.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/** Returns an RFC 6902 JSON Patch that turns `from` into `to`; neither input is mutated. */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffValues(from as JsonValue, to as JsonValue, "", ops);
+  return ops;
+}
