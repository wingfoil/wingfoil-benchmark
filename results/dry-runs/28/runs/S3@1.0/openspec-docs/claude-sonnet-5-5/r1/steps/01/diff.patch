@@ -0,0 +1,31 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 4000 });
+  return s;
+}
+
+test('quote multiplies days by daily price', () => {
+  const q = setup().quote({ itemId: 'b1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00.000Z' });
+  assert.equal(q.total, 12000);
+});
+
+test('rejects unknown item and non-midnight or reversed periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'x', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T10:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T00:00:00+02:00', end: '2026-07-02T00:00:00Z' }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-02T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+});
+
+test('book refuses overlaps but allows adjacent periods', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  assert.throws(() => s.book({ itemId: 'b1', start: '2026-07-02T00:00:00Z', end: '2026-07-04T00:00:00Z' }));
+  const b = s.book({ itemId: 'b1', start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+  assert.notEqual(a.id, b.id);
+  assert.equal(a.total, 8000);
+});
