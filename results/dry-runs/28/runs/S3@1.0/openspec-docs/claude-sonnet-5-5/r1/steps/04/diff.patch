+
+test('rentals shorter than a day are priced per hour', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 4000, hourlyPrice: 900 });
+  s.addEquipment({ id: 'd1', kind: 'board', dailyPrice: 4000 });
+  const req = { itemId: 'h1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T16:00:00Z' };
+  assert.equal(s.quote(req).total, 2700);
+  assert.equal(s.book(req).total, 2700);
+  assert.throws(() => s.book({ ...req, end: '2026-07-01T14:00:00Z' }));
+  assert.throws(() => s.quote({ ...req, itemId: 'd1' }));
+  assert.throws(() => s.quote({ ...req, end: '2026-07-01T16:30:00Z' }));
+  assert.throws(() => s.quote({ ...req, end: '2026-07-02T13:00:00Z' }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: 1.5 }));
+});
