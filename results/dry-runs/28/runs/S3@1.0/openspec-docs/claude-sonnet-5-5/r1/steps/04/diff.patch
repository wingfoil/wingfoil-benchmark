@@ -48,3 +48,17 @@ test('availability lists free items of a kind, sorted', () => {
   assert.deepEqual(s.availability({ start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z', kind: 'board' }), ['a0', 'b1']);
