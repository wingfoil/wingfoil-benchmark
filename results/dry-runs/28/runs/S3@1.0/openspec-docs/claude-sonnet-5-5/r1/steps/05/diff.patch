+test('cancel refunds in full before the start, nothing after, frees the equipment, only once', () => {
+  const s = setup();
+  const req = { itemId: 'b1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' };
+  const a = s.book(req);
+  assert.deepEqual(s.cancel(a.id, '2026-06-30T12:00:00Z'), { bookingId: a.id, refund: 8000 });
+  assert.throws(() => s.cancel(a.id, '2026-06-30T13:00:00Z'));
+  assert.throws(() => s.cancel('nope', '2026-06-30T13:00:00Z'));
+  const b = s.book(req);
+  assert.equal(s.cancel(b.id, '2026-07-01T00:00:00Z').refund, 0);
+  assert.deepEqual(s.availability({ start: req.start, end: req.end }), ['b1']);
