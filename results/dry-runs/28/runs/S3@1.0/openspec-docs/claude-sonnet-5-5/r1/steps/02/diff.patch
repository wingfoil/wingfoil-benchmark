@@ -29,3 +29,15 @@ test('book refuses overlaps but allows adjacent periods', () => {
   assert.notEqual(a.id, b.id);
   assert.equal(a.total, 8000);
 });
+
+test('availability lists free items of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a1', kind: 'sail', dailyPrice: 2000 });
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 3000 });
+  s.book({ itemId: 'b1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' });
+  const q = { start: '2026-07-02T00:00:00Z', end: '2026-07-04T00:00:00Z' };
+  assert.deepEqual(s.availability(q), ['a0', 'a1']);
+  assert.deepEqual(s.availability({ ...q, kind: 'board' }), ['a0']);
+  assert.deepEqual(s.availability({ start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z', kind: 'board' }), ['a0', 'b1']);
+  assert.throws(() => s.availability({ start: q.end, end: q.start }));
+});
