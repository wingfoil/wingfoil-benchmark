+
+function validateNewTask(input: NewTask): Result<void> {
+  const title = validateTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined && !PRIORITIES.includes(input.priority)) {
+    return err('invalid-input', 'priority must be one of low, normal, or high');
+  }
+  for (const tag of input.tags ?? []) {
+    const validation = validateTag(tag);
+    if (!validation.ok) return validation;
+  }
+  return ok(undefined);
+}
+
+function validateTitle(title: string): Result<void> {
+  if (title.trim().length === 0) return err('invalid-input', 'title must not be empty or only spaces');
+  if (title.length > 120) return err('invalid-input', 'title must be 120 characters or fewer');
+  return ok(undefined);
+}
+
+function validateTag(tag: string): Result<void> {
+  return tag.length === 0 || /\s/.test(tag)
+    ? err('invalid-input', 'tag must not be empty or contain spaces')
+    : ok(undefined);
+}
