+/**
+ * Returns the price of renting an item for a number of whole days, in euro cents. A rental of
+ * `LONG_RENTAL_MIN_DAYS` days or more is reduced by `LONG_RENTAL_PERCENT_OFF` percent, rounded
+ * to the nearest cent with halves rounded up.
+ */
+function totalOf(item: EquipmentItem, days: number): number {
+  const fullPrice = days * item.dailyPrice;
+  if (days < LONG_RENTAL_MIN_DAYS) {
+    return fullPrice;
+  }
+  return Math.round((fullPrice * (100 - LONG_RENTAL_PERCENT_OFF)) / 100);
+}
