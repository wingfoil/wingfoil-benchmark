index 0000000000000000000000000000000000000000..d6e3b5858ef465b6399b64768ca377696cc0c9c7
--- /dev/null
+++ b/test/rentals.test.ts
@@ -0,0 +1,301 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function serviceWithBoard(dailyPrice = 2500) {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice });
+  return service;
+}
+
+test('quote multiplies the daily price by the number of whole days', () => {
+  const service = serviceWithBoard(2500);
+
+  const quote = service.quote({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+  });
+
+  assert.deepEqual(quote, {
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+    total: 5000,
+  });
+});
+
+test('quote for a single day costs one daily price', () => {
+  const service = serviceWithBoard(1800);
+
+  const quote = service.quote({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-02T00:00:00Z',
+  });
+
+  assert.equal(quote.total, 1800);
+});
+
+test('quote does not reserve the item', () => {
+  const service = serviceWithBoard();
+  const request = {
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-02T00:00:00Z',
+  };
+
+  service.quote(request);
+
+  assert.equal(service.book(request).itemId, 'board-1');
+});
+
+test('book returns a booking with an id, the period and the total', () => {
+  const service = serviceWithBoard(2500);
+
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+  });
+
+  assert.equal(typeof booking.id, 'string');
+  assert.notEqual(booking.id, '');
+  assert.deepEqual(
+    { itemId: booking.itemId, start: booking.start, end: booking.end, total: booking.total },
+    {
+      itemId: 'board-1',
+      start: '2026-07-01T00:00:00Z',
+      end: '2026-07-03T00:00:00Z',
+      total: 5000,
+    },
+  );
+});
+
+test('each booking gets its own id', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1200 });
+
+  const first = service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-02T00:00:00Z',
+  });
+  const second = service.book({
+    itemId: 'sail-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-02T00:00:00Z',
+  });
+
+  assert.notEqual(first.id, second.id);
+});
+
+test('quote and book throw for an unknown item', () => {
+  const service = serviceWithBoard();
+  const request = {
+    itemId: 'missing',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-02T00:00:00Z',
+  };
+
+  assert.throws(() => service.quote(request), Error);
+  assert.throws(() => service.book(request), Error);
+});
+
+test('a period must end after it starts', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(
+    () =>
+      service.quote({
+        itemId: 'board-1',
+        start: '2026-07-02T00:00:00Z',
+        end: '2026-07-02T00:00:00Z',
+      }),
+    Error,
+  );
+  assert.throws(
+    () =>
+      service.quote({
+        itemId: 'board-1',
+        start: '2026-07-03T00:00:00Z',
+        end: '2026-07-01T00:00:00Z',
+      }),
+    Error,
+  );
+});
+
+test('a period must start at midnight UTC', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(
+    () =>
+      service.quote({
+        itemId: 'board-1',
+        start: '2026-07-01T09:00:00Z',
+        end: '2026-07-02T00:00:00Z',
+      }),
+    Error,
+  );
+});
+
+test('a period must end at midnight UTC', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(
+    () =>
+      service.quote({
+        itemId: 'board-1',
+        start: '2026-07-01T00:00:00Z',
+        end: '2026-07-02T12:00:00Z',
+      }),
+    Error,
+  );
+});
+
+test('times with a non-UTC offset are rejected', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(
+    () =>
+      service.quote({
+        itemId: 'board-1',
+        start: '2026-07-01T00:00:00+02:00',
+        end: '2026-07-02T00:00:00+02:00',
+      }),
+    Error,
+  );
+});
+
+test('malformed or non-existent dates are rejected', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(
+    () =>
+      service.quote({
+        itemId: 'board-1',
+        start: 'not a date',
+        end: '2026-07-02T00:00:00Z',
+      }),
+    Error,
+  );
+  assert.throws(
+    () =>
+      service.quote({
+        itemId: 'board-1',
+        start: '2026-02-30T00:00:00Z',
+        end: '2026-03-01T00:00:00Z',
+      }),
+    Error,
+  );
+});
+
+test('an overlapping booking of the same item is refused', () => {
+  const service = serviceWithBoard();
+  service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-04T00:00:00Z',
+  });
+
+  assert.throws(
+    () =>
+      service.book({
+        itemId: 'board-1',
+        start: '2026-07-03T00:00:00Z',
+        end: '2026-07-05T00:00:00Z',
+      }),
+    Error,
+  );
+  assert.throws(
+    () =>
+      service.book({
+        itemId: 'board-1',
+        start: '2026-07-02T00:00:00Z',
+        end: '2026-07-03T00:00:00Z',
+      }),
+    Error,
+  );
+});
+
+test('a booking that contains an existing booking is refused', () => {
+  const service = serviceWithBoard();
+  service.book({
+    itemId: 'board-1',
+    start: '2026-07-02T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+  });
+
+  assert.throws(
+    () =>
+      service.book({
+        itemId: 'board-1',
+        start: '2026-07-01T00:00:00Z',
+        end: '2026-07-05T00:00:00Z',
+      }),
+    Error,
+  );
+});
+
+test('back-to-back bookings of the same item are allowed', () => {
+  const service = serviceWithBoard();
+  service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-02T00:00:00Z',
+  });
+
+  const next = service.book({
+    itemId: 'board-1',
+    start: '2026-07-02T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+  });
+
+  assert.equal(next.itemId, 'board-1');
+});
+
+test('overlapping periods of different items are allowed', () => {
+  const service = serviceWithBoard();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1200 });
+  service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+  });
+
+  const sail = service.book({
+    itemId: 'sail-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+  });
+
+  assert.equal(sail.total, 2400);
+});
+
+test('addEquipment rejects an unknown kind', () => {
+  const service = createRentalService();
+
+  assert.throws(
+    () => service.addEquipment({ id: 'x-1', kind: 'kite' as 'board', dailyPrice: 1000 }),
+    Error,
+  );
+});
+
+test('addEquipment rejects a price that is not a positive integer of cents', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.addEquipment({ id: 'b-1', kind: 'board', dailyPrice: 19.5 }), Error);
+  assert.throws(() => service.addEquipment({ id: 'b-2', kind: 'board', dailyPrice: -100 }), Error);
+  assert.throws(() => service.addEquipment({ id: 'b-3', kind: 'board', dailyPrice: 0 }), Error);
+});
+
+test('addEquipment rejects an empty or duplicate id', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() => service.addEquipment({ id: '', kind: 'board', dailyPrice: 1000 }), Error);
+  assert.throws(
+    () => service.addEquipment({ id: 'board-1', kind: 'sail', dailyPrice: 1000 }),
+    Error,
+  );
+});
