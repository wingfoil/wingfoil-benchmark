@@ -0,0 +1,181 @@
+/**
+ * Rental module of the Lakeside Windsurf School booking desk.
+ *
+ * Rules that apply throughout this module:
+ * - Money is an integer number of euro cents.
+ * - Times are UTC ISO-8601 strings.
+ * - A period covers whole days: it starts and ends at midnight UTC, and it ends at the
+ *   start of the day after its last day. Periods are half-open, so `end` is not included,
+ *   which is why back-to-back periods of the same item do not overlap.
+ * - An item cannot be booked for overlapping periods.
+ */
+
+/** The kinds of equipment the school rents. */
+export type EquipmentKind = 'board' | 'sail';
+
+/** A piece of equipment that can be rented. `dailyPrice` is the cost of one day, in euro cents. */
+export interface EquipmentItem {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+/** A request to rent an item for a period. `start` and `end` are midnights UTC, e.g. `2026-07-01T00:00:00Z`. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The price of renting an item for a period, in euro cents. */
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  total: number;
+}
+
+/** A confirmed booking. `id` identifies it for later reference. */
+export interface Booking {
+  id: string;
+  itemId: string;
+  start: string;
+  end: string;
+  total: number;
+}
+
+/** The in-memory rental service. */
+export interface RentalService {
+  /** Adds an item to the catalogue. Throws if the item is invalid or its id is already taken. */
+  addEquipment(item: EquipmentItem): void;
+  /** Prices a rental without reserving the item. Throws if the item is unknown or the period is not allowed. */
+  quote(request: RentalRequest): Quote;
+  /** Reserves the item for the period. Throws if the item is unknown, the period is not allowed, or the item is not free. */
+  book(request: RentalRequest): Booking;
+}
+
+interface Reservation {
+  itemId: string;
+  startMs: number;
+  endMs: number;
+}
+
+interface Period {
+  start: string;
+  end: string;
+  startMs: number;
+  endMs: number;
+  days: number;
+}
+
+const MS_PER_DAY = 86_400_000;
+const MIDNIGHT_UTC = /^(\d{4})-(\d{2})-(\d{2})T00:00:00(?:\.000)?Z$/;
+
+/** Returns the instant of a UTC midnight given as an ISO-8601 string, or throws if it is not one. */
+function parseMidnightUtc(value: unknown, name: string): number {
+  const match = typeof value === 'string' ? MIDNIGHT_UTC.exec(value) : null;
+  if (!match) {
+    throw new Error(`${name} must be a UTC midnight in ISO-8601 form, e.g. 2026-07-01T00:00:00Z`);
+  }
+  const year = Number(match[1]);
+  const month = Number(match[2]);
+  const day = Number(match[3]);
+  const ms = Date.UTC(year, month - 1, day);
+  const date = new Date(ms);
+  // Date.UTC rolls over impossible dates such as February 30, so check the fields survived.
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
+    throw new Error(`${name} is not a real calendar date`);
+  }
+  return ms;
+}
+
+/** Validates a request's period and returns it with its length in whole days. */
+function parsePeriod(request: RentalRequest): Period {
+  const startMs = parseMidnightUtc(request.start, 'start');
+  const endMs = parseMidnightUtc(request.end, 'end');
+  if (endMs <= startMs) {
+    throw new Error('end must be after start');
+  }
+  return {
+    start: request.start,
+    end: request.end,
+    startMs,
+    endMs,
+    days: (endMs - startMs) / MS_PER_DAY,
+  };
+}
+
+function validateItem(item: EquipmentItem): void {
+  if (typeof item.id !== 'string' || item.id === '') {
+    throw new Error('item id must be a non-empty string');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error(`item kind must be 'board' or 'sail', got ${String(item.kind)}`);
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice <= 0) {
+    throw new Error('dailyPrice must be a positive integer number of euro cents');
+  }
+}
+
+/**
+ * Creates an empty in-memory rental service.
+ *
+ * Booking ids are sequential within the service (`booking-1`, `booking-2`, ...), so the same
+ * sequence of calls always produces the same ids.
+ */
+export function createRentalService(): RentalService {
+  const items = new Map<string, EquipmentItem>();
+  const reservations: Reservation[] = [];
+  let bookingCount = 0;
+
+  function requireItem(itemId: string): EquipmentItem {
+    const item = items.get(itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${String(itemId)}`);
+    }
+    return item;
+  }
+
+  function priceOf(item: EquipmentItem, period: Period): Quote {
+    return {
+      itemId: item.id,
+      start: period.start,
+      end: period.end,
+      total: period.days * item.dailyPrice,
+    };
+  }
+
+  function isFree(itemId: string, period: Period): boolean {
+    return reservations.every(
+      (reservation) =>
+        reservation.itemId !== itemId ||
+        reservation.endMs <= period.startMs ||
+        period.endMs <= reservation.startMs,
+    );
+  }
+
+  return {
+    addEquipment(item) {
+      validateItem(item);
+      if (items.has(item.id)) {
+        throw new Error(`item already exists: ${item.id}`);
+      }
+      items.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return priceOf(requireItem(request.itemId), parsePeriod(request));
+    },
+
+    book(request) {
+      const item = requireItem(request.itemId);
+      const period = parsePeriod(request);
+      if (!isFree(item.id, period)) {
+        throw new Error(`item ${item.id} is not free for the whole period`);
+      }
+      reservations.push({ itemId: item.id, startMs: period.startMs, endMs: period.endMs });
+      bookingCount += 1;
+      return { id: `booking-${bookingCount}`, ...priceOf(item, period) };
+    },
+  };
+}
diff --git a/test/rentals.test.ts b/test/rentals.test.ts
