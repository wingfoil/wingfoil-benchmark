diff --git a/test/rentals.test.ts b/test/rentals.test.ts
index 96978d24be6b06ac31958564cfbd811574a99021..e7145674aa6c871bd6e4115e172736f66ad5db12 100644
--- a/test/rentals.test.ts
+++ b/test/rentals.test.ts
@@ -710,3 +710,141 @@ test('availability counts hourly bookings', () => {
     ['board-1'],
   );
 });
+
+test('cancel refunds the full booking when made before the rental starts', () => {
+  const service = serviceWithBoard(2500);
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+  });
+
+  assert.deepEqual(service.cancel(booking.id, '2026-06-30T18:45:30Z'), {
+    bookingId: booking.id,
+    refund: 5000,
+  });
+});
+
+test('cancel refunds the reduced total of a long rental', () => {
+  const service = serviceWithBoard(2500);
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-04T00:00:00Z',
+  });
+
+  assert.equal(service.cancel(booking.id, '2026-06-30T00:00:00Z').refund, 6750);
+});
+
+test('cancel refunds nothing when made at or after the start of the rental', () => {
+  const service = serviceWithBoard(2500);
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+  });
+
+  assert.equal(service.cancel(booking.id, '2026-07-01T00:00:00Z').refund, 0);
+
+  const other = service.book({
+    itemId: 'board-1',
+    start: '2026-07-10T00:00:00Z',
+    end: '2026-07-11T00:00:00Z',
+  });
+  assert.equal(service.cancel(other.id, '2026-07-10T09:00:00Z').refund, 0);
+});
+
+test('a cancelled booking no longer holds its equipment', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+  });
+
+  service.cancel(booking.id, '2026-06-30T00:00:00Z');
+
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' }),
+    ['board-1'],
+  );
+  assert.equal(
+    service.book({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' })
+      .itemId,
+    'board-1',
+  );
+});
+
+test('cancelling one booking leaves the other bookings of the item in place', () => {
+  const service = serviceWithBoard();
+  const first = service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-02T00:00:00Z',
+  });
+  service.book({
+    itemId: 'board-1',
+    start: '2026-07-05T00:00:00Z',
+    end: '2026-07-06T00:00:00Z',
+  });
+
+  service.cancel(first.id, '2026-06-30T00:00:00Z');
+
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-10T00:00:00Z' }),
+    [],
+  );
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    ['board-1'],
+  );
+});
+
+test('a booking can only be cancelled once', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-02T00:00:00Z',
+  });
+  service.cancel(booking.id, '2026-06-30T00:00:00Z');
+
+  assert.throws(() => service.cancel(booking.id, '2026-06-30T01:00:00Z'), Error);
+});
+
+test('cancel throws for an unknown booking', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(() => service.cancel('booking-99', '2026-06-30T00:00:00Z'), Error);
+});
+
+test('cancel throws for a time that is not a UTC instant', () => {
+  const service = serviceWithBoard();
+  const booking = service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-02T00:00:00Z',
+  });
+
+  assert.throws(() => service.cancel(booking.id, 'not a time'), Error);
+  assert.throws(() => service.cancel(booking.id, '2026-06-30T18:00:00+02:00'), Error);
+  assert.throws(() => service.cancel(booking.id, '2026-02-30T18:00:00Z'), Error);
+});
+
+test('booking ids are not reused after a cancellation', () => {
+  const service = serviceWithBoard();
+  const first = service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-02T00:00:00Z',
+  });
+  service.cancel(first.id, '2026-06-30T00:00:00Z');
+
+  const second = service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-02T00:00:00Z',
+  });
+
+  assert.notEqual(second.id, first.id);
+});
