diff --git a/test/rentals.test.ts b/test/rentals.test.ts
index d6e3b5858ef465b6399b64768ca377696cc0c9c7..5f84f2725b9aeca6c7a7c9a21475487cb1c84657 100644
--- a/test/rentals.test.ts
+++ b/test/rentals.test.ts
@@ -299,3 +299,125 @@ test('addEquipment rejects an empty or duplicate id', () => {
     Error,
   );
 });
+
+test('availability lists the ids of free items, sorted', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 1200 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1200 });
+
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' }),
+    ['board-1', 'sail-1', 'sail-2'],
+  );
+});
+
+test('availability leaves out items booked for any part of the period', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 2500 });
+  service.book({
+    itemId: 'board-1',
+    start: '2026-07-02T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+  });
+
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' }),
+    ['board-2'],
+  );
+});
+
+test('availability keeps an item whose booking ends where the period begins', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-03T00:00:00Z',
+  });
+
+  assert.deepEqual(
+    service.availability({ start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z' }),
+    ['board-1'],
+  );
+});
+
+test('availability filters by kind when one is given', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1200 });
+  service.addEquipment({ id: 'sail-2', kind: 'sail', dailyPrice: 1200 });
+  service.book({
+    itemId: 'sail-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-02T00:00:00Z',
+  });
+
+  assert.deepEqual(
+    service.availability({
+      start: '2026-07-01T00:00:00Z',
+      end: '2026-07-02T00:00:00Z',
+      kind: 'sail',
+    }),
+    ['sail-2'],
+  );
+  assert.deepEqual(
+    service.availability({
+      start: '2026-07-01T00:00:00Z',
+      end: '2026-07-02T00:00:00Z',
+      kind: 'board',
+    }),
+    ['board-1'],
+  );
+});
+
+test('availability is empty when no item is free or none exists', () => {
+  const empty = createRentalService();
+  assert.deepEqual(
+    empty.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    [],
+  );
+
+  const service = serviceWithBoard();
+  service.book({
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00Z',
+    end: '2026-07-02T00:00:00Z',
+  });
+  assert.deepEqual(
+    service.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    [],
+  );
+});
+
+test('availability does not reserve anything', () => {
+  const service = serviceWithBoard();
+  const query = { start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' };
+
+  service.availability(query);
+
+  assert.deepEqual(service.availability(query), ['board-1']);
+});
+
+test('availability throws for an invalid period or an unknown kind', () => {
+  const service = serviceWithBoard();
+
+  assert.throws(
+    () => service.availability({ start: '2026-07-02T00:00:00Z', end: '2026-07-01T00:00:00Z' }),
+    Error,
+  );
+  assert.throws(
+    () => service.availability({ start: '2026-07-01T09:00:00Z', end: '2026-07-02T00:00:00Z' }),
+    Error,
+  );
+  assert.throws(
+    () =>
+      service.availability({
+        start: '2026-07-01T00:00:00Z',
+        end: '2026-07-02T00:00:00Z',
+        kind: 'kite' as 'board',
+      }),
+    Error,
+  );
+});
