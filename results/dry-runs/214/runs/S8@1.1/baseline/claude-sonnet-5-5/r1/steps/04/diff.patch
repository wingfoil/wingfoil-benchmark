@@ -0,0 +1,45 @@
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of an import that could not be added, with its number (from 1) and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks it added, and the lines it could not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text`, one per line as `title;priority;tags`, to `list`. The priority may be
+ * empty (or left out) for a normal one; tags are separated by spaces. Blank lines are skipped, but still
+ * count in line numbers. A line that cannot be added is reported and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\r|\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `expected "title;priority;tags" but found ${fields.length} fields` });
+      return;
+    }
+    const [title = '', priority = '', tags = ''] = fields;
+    const result = list.add({
+      title,
+      priority: priority.trim() === '' ? undefined : (priority.trim().toLowerCase() as Priority),
+      tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+    });
+    if (result.ok) imported++;
+    else rejected.push({ line, reason: result.error.message });
+  });
+  return { imported, rejected };
+}
