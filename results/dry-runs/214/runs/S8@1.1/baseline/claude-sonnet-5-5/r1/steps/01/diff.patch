+    assert.equal(valueOf(list.tag(a.id, 'x')).tags[0], 'x');
+    assert.equal(valueOf(list.rename(a.id, 'a')).title, 'a');
+    assert.equal(valueOf(list.complete(a.id)).status, 'done');
+    assert.equal(valueOf(list.reopen(a.id)).status, 'open');
+    assert.equal(valueOf(list.untag(a.id, 'x')).tags.length, 0);
+    valueOf(list.remove(a.id));
+    assert.equal(list.get(a.id).ok, false);
+    assert.equal(list.find('a').ok, false);
