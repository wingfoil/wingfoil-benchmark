+
+describe('reported defects', () => {
+  it('finds a product by a lower-case SKU', () => {
+    const { catalog } = createShop();
+    catalog.add({ sku: 'LB-220', name: 'Lamp', priceCents: 1990, vatClass: 'standard', weightGrams: 100 });
+    assert.equal(catalog.get('lb-220').sku, 'LB-220');
+    assert.equal(catalog.getForSale(' lb-220 ').sku, 'LB-220');
+  });
+
+  it('ships free from exactly €50.00 of goods', async () => {
+    const { shippingCost } = await import('../src/shipping.ts');
+    assert.equal(shippingCost(5000, 100), 0);
+    assert.equal(shippingCost(4999, 100), 490);
+  });
+
+  it('rounds line VAT half up', async () => {
+    const { lineVat } = await import('../src/tax.ts');
+    assert.equal(lineVat(199, 'standard'), 44);
+  });
+});
