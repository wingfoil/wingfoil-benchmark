@@ -79,4 +79,23 @@ describe('orders', () => {
     assert.match(text, /1 × Enamel mug \(MUG-01\)\s+€10\.00/);
     assert.match(text, /Total\s+€/);
   });
+
+  it('ships free when the goods come to exactly 50.00, also after a coupon', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'FIVE', kind: 'fixed', value: 500, validFrom: '2026-01-01', validUntil: '2026-12-31' });
+    const plain = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 5 }] });
+    assert.equal(plain.totals.shippingCents, 0);
+    const coupon = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 5 }, { sku: 'TEA-7', quantity: 1 }], coupon: 'five' });
+    assert.equal(coupon.totals.goodsCents, 5000);
+    assert.equal(coupon.totals.shippingCents, 0);
+  });
+
+  it('gives a single-use coupon back when the order that used it is cancelled', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = orders.place({ customer: 'paolo', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 1 }], coupon: 'WELCOME' });
+    orders.cancel(first.id, '2026-03-02');
+    const second = orders.place({ customer: 'paolo', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 2 }], coupon: 'WELCOME' });
+    assert.equal(second.totals.couponDiscountCents, 200);
+  });
 });
