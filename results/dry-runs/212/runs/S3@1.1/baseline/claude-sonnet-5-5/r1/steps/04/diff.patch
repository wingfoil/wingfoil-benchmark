diff --git a/test/rental.test.ts b/test/rental.test.ts
index 7dab7b02bc12b29cee93b713752271cbcdeb64ef..b1b7a8bb5b20fdf25e5f37c837cabbcdd03a85ce 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -57,3 +57,18 @@ test('availability lists free equipment of a kind, sorted', () => {
   assert.throws(() => s.availability({ start: d(3), end: d(3) }));
   assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'x' as any }));
 });
+
+test('rents by the hour when the item has an hourly price', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 5000, hourlyPrice: 900 });
+  s.addEquipment({ id: 'n', kind: 'board', dailyPrice: 5000 });
+  const r = { itemId: 'h', start: '2026-07-01T13:00:00Z', end: '2026-07-01T16:00:00Z' };
+  assert.equal(s.quote(r).total, 2700);
+  assert.equal(s.book(r).total, 2700);
+  assert.throws(() => s.book({ ...r, start: '2026-07-01T15:00:00Z' }));
+  s.book({ ...r, start: '2026-07-01T16:00:00Z', end: '2026-07-01T17:00:00Z' });
+  assert.throws(() => s.quote({ ...r, itemId: 'n' }));
+  assert.throws(() => s.quote({ ...r, end: '2026-07-01T16:30:00Z' }));
+  assert.throws(() => s.quote({ ...r, start: '2026-07-01T10:00:00Z', end: '2026-07-02T10:00:00Z' }));
+  assert.throws(() => s.addEquipment({ id: 'z', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+});
