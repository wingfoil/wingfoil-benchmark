+++ b/src/index.ts
@@ -0,0 +1,105 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one day of rental, in euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  /** ISO-8601, midnight UTC. */
+  start: string;
+  /** ISO-8601, midnight UTC: the start of the day after the last rented day. */
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  /** Euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^(\d{4}-\d{2}-\d{2})T00:00(?::00(?:\.0+)?)?(?:Z|[+-]00:00)$/;
+
+function parseMidnightUtc(value: unknown, field: string): number {
+  const match = typeof value === 'string' ? MIDNIGHT_UTC.exec(value) : null;
+  if (!match) {
+    throw new Error(`${field} must be an ISO-8601 UTC time at midnight`);
+  }
+  const ms = Date.parse(`${match[1]}T00:00:00.000Z`);
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== match[1]) {
+    throw new Error(`${field} is not a valid date`);
+  }
+  return ms;
+}
+
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: { id: string; itemId: string; startMs: number; endMs: number }[] = [];
+  let nextBookingId = 1;
+
+  function price(request: RentalRequest) {
+    if (typeof request !== 'object' || request === null) {
+      throw new Error('request is required');
+    }
+    const item = equipment.get(request.itemId);
+    if (!item) throw new Error(`unknown item: ${String(request.itemId)}`);
+    const startMs = parseMidnightUtc(request.start, 'start');
+    const endMs = parseMidnightUtc(request.end, 'end');
+    if (endMs <= startMs) throw new Error('end must be after start');
+    const days = (endMs - startMs) / DAY_MS;
+    const quote: Quote = {
+      itemId: item.id,
+      start: new Date(startMs).toISOString(),
+      end: new Date(endMs).toISOString(),
+      total: item.dailyPrice * days,
+    };
+    return { quote, startMs, endMs };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item?.id !== 'string' || item.id === '') {
+        throw new Error('equipment id must be a non-empty string');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error("equipment kind must be 'board' or 'sail'");
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+      }
+      if (equipment.has(item.id)) throw new Error(`equipment already exists: ${item.id}`);
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, startMs, endMs } = price(request);
+      const clash = bookings.some(
+        (b) => b.itemId === quote.itemId && startMs < b.endMs && b.startMs < endMs,
+      );
+      if (clash) throw new Error('item is not free for the whole period');
+      const id = `booking-${nextBookingId++}`;
+      bookings.push({ id, itemId: quote.itemId, startMs, endMs });
+      return { id, ...quote };
+    },
+  };
+}
diff --git a/test/rental.test.ts b/test/rental.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0b30c91c84f6ce03b55f921d251d7f51fb2860ab
--- /dev/null
+++ b/test/rental.test.ts
@@ -0,0 +1,37 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+const d = (day: number) => `2026-07-${String(day).padStart(2, '0')}T00:00:00.000Z`;
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2550 });
+  return s;
+}
+
+test('quotes whole days', () => {
+  assert.deepEqual(setup().quote({ itemId: 'b1', start: d(1), end: d(4) }), {
+    itemId: 'b1', start: d(1), end: d(4), total: 7650,
+  });
+});
+
+test('rejects unknown item and bad periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'x', start: d(1), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(2), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(3), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T10:00:00Z', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-02-30T00:00:00Z', end: d(2) }));
+});
+
+test('book prevents overlaps but allows adjacent periods', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.equal(a.total, 5100);
+  assert.throws(() => s.book({ itemId: 'b1', start: d(2), end: d(4) }));
+  const b = s.book({ itemId: 'b1', start: d(3), end: d(4) });
+  assert.notEqual(a.id, b.id);
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  s.book({ itemId: 's1', start: d(1), end: d(3) });
+});
