@@ -0,0 +1,38 @@
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** `WELCOME5` takes this much off... */
+export const WELCOME5_CENTS: Cents = 500;
+
+/** ...and only on an order whose items come to this amount or more. */
+export const WELCOME5_MINIMUM_CENTS: Cents = 3000;
+
+/**
+ * The canonical form of a code as a customer may have typed it, or an error if the shop does not know it.
+ *
+ * @param code - the code, in any case and with stray spaces
+ * @param itemsCents - what the order's items come to
+ */
+export function checkCode(code: string, itemsCents: Cents): Result<string> {
+  const known = code.trim().toUpperCase();
+  if (known === 'SPRING10') return ok(known);
+  if (known === 'WELCOME5') {
+    return itemsCents >= WELCOME5_MINIMUM_CENTS
+      ? ok(known)
+      : err('invalid', 'WELCOME5 needs items worth 30.00 € or more');
+  }
+  return err('invalid', `${code} is not a discount code`);
+}
+
+/**
+ * What a canonical code takes off an order's items.
+ *
+ * @param code - a code accepted by `checkCode`, or undefined for none
+ * @param itemsCents - what the order's items come to
+ */
+export function discountFor(code: string | undefined, itemsCents: Cents): Cents {
+  if (code === 'SPRING10') return Math.floor((itemsCents * 10 + 50) / 100);
+  if (code === 'WELCOME5') return Math.min(WELCOME5_CENTS, itemsCents);
+  return 0;
+}
