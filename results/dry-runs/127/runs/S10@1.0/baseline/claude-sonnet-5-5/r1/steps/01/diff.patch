+
+describe('discount codes', () => {
+  function orderOf(sku: string, quantity: number) {
+    const shop = stocked();
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku, quantity }] });
+    return shop;
+  }
+
+  it('has no discount without a code', () => {
+    assert.equal(valueOf(orderOf('OIL-1L', 1).orders.totals(1)).discountCents, 0);
+  });
+
+  it('SPRING10 takes 10 % off the items, half a cent rounding up, and not off shipping', () => {
+    const shop = orderOf('APL-1KG', 1); // 349 -> 34.9 -> 35
+    assert.deepEqual(valueOf(shop.orders.applyCode(1, 'SPRING10')), {
+      itemsCents: 349, discountCents: 35, shippingCents: 490, totalCents: 349 - 35 + 490,
+    });
+    assert.equal(valueOf(orderOf('APL-1KG', 3).orders.applyCode(1, 'SPRING10')).discountCents, 105); // 104.7
+  });
+
+  it('rounds an exact half cent up', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'X', name: 'X', priceCents: 105 }));
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'X', quantity: 1 }] });
+    assert.equal(valueOf(shop.orders.applyCode(1, 'SPRING10')).discountCents, 11);
+  });
+
+  it('WELCOME5 takes 5.00 off an order of 30.00 or more', () => {
+    const shop = orderOf('OIL-1L', 3); // 38.70
+    assert.equal(valueOf(shop.orders.applyCode(1, 'WELCOME5')).discountCents, 500);
+  });
+
+  it('refuses WELCOME5 on a smaller order and an unknown code, leaving the order as it was', () => {
+    const shop = orderOf('OIL-1L', 1);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    const before = valueOf(shop.orders.totals(1));
+    const small = shop.orders.applyCode(1, 'WELCOME5');
+    assert.ok(!small.ok && /30\.00/.test(small.error.message));
+    const unknown = shop.orders.applyCode(1, 'NOPE');
+    assert.ok(!unknown.ok && /NOPE/.test(unknown.error.message));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), before);
+  });
+
+  it('a second code replaces the first', () => {
+    const shop = orderOf('OIL-1L', 3);
+    valueOf(shop.orders.applyCode(1, 'WELCOME5'));
+    assert.equal(valueOf(shop.orders.applyCode(1, 'SPRING10')).discountCents, 387);
+  });
+
+  it('decides free shipping on items before the discount', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'Y', name: 'Y', priceCents: 5000 }));
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'Y', quantity: 1 }] });
+    assert.deepEqual(valueOf(shop.orders.applyCode(1, 'SPRING10')), {
+      itemsCents: 5000, discountCents: 500, shippingCents: 0, totalCents: 4500,
+    });
+  });
+
+  it('refuses an unknown order', () => {
+    const r = stocked().orders.applyCode(9, 'SPRING10');
+    assert.ok(!r.ok && r.error.code === 'not-found');
+  });
+});
