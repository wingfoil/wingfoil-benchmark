+describe('monthly export', () => {
+  it('lists the orders of a month as CSV', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, "Al"', email: 'al@example.org', phone: '' }));
+    shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c2', date: '2026-10-03', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    assert.equal(
+      valueOf(shop.orders.exportMonth('2026-10')),
+      'order,date,customer,email,phone,total\n' +
+        '2,2026-10-02,Mira Holt,mira@example.org,555-0101,17.80\n' +
+        '3,2026-10-03,"Holt, ""Al""",al@example.org,,64.00\n',
+    );
+  });
+
+  it('gives only the header for an empty month and refuses a bad one', () => {
+    const shop = stocked();
+    assert.equal(valueOf(shop.orders.exportMonth('2026-11')), 'order,date,customer,email,phone,total\n');
+    assert.equal(shop.orders.exportMonth('2026-13').ok, false);
