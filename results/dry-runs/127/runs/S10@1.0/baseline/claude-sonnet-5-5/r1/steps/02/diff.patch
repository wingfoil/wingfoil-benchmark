     },
+    exportMonth(month) {
+      if (!MONTH.test(month)) return err('invalid', `${month} is not a month (YYYY-MM)`);
+      const lines = ['order,date,customer,email,phone,total'];
+      for (const order of orders) {
+        if (!order.date.startsWith(`${month}-`)) continue;
+        const customer = customers.get(order.customerId);
+        const { name, email, phone } = customer.ok ? customer.value : { name: '', email: '', phone: '' };
+        const total = formatEuros(totalsOf(order).totalCents);
+        lines.push([String(order.number), order.date, name, email, phone, total].map(csvField).join(','));
+      }
+      return ok(`${lines.join('\n')}\n`);
+    },
   };
 }
