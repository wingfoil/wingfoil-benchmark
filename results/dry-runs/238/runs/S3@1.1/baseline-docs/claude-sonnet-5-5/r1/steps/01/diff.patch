+import assert from 'node:assert/strict';
+import { beforeEach, describe, it } from 'node:test';
+import { createRentalService, type RentalService } from './index.ts';
+
+describe('rental service', () => {
+  let service: RentalService;
+
+  beforeEach(() => {
+    service = createRentalService();
+    service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 4500 });
+    service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 2000 });
+  });
+
+  describe('addEquipment', () => {
+    it('rejects a duplicate id', () => {
+      assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 100 }));
+    });
+
+    it('rejects an unknown kind', () => {
+      assert.throws(() => service.addEquipment({ id: 'x', kind: 'kayak' as 'board', dailyPrice: 100 }));
+    });
+
+    it('rejects a price that is not a non-negative integer of cents', () => {
+      for (const dailyPrice of [12.5, -1, Number.NaN, Infinity]) {
+        assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice }));
+      }
+    });
+
+    it('rejects an empty id', () => {
+      assert.throws(() => service.addEquipment({ id: '', kind: 'board', dailyPrice: 100 }));
+    });
+  });
+
+  describe('quote', () => {
+    it('charges the daily price for each whole day', () => {
+      assert.deepEqual(
+        service.quote({ itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' }),
+        { itemId: 'board-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-04T00:00:00.000Z', total: 13500 },
+      );
+    });
+
+    it('quotes a single day', () => {
+      const { total } = service.quote({ itemId: 'sail-1', start: '2026-07-01T00:00:00.000Z', end: '2026-07-02T00:00:00.000Z' });
+      assert.equal(total, 2000);
+    });
+
+    it('does not reserve anything', () => {
+      const request = { itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' };
+      service.quote(request);
+      assert.doesNotThrow(() => service.book(request));
+    });
+
+    it('rejects an unknown item', () => {
+      assert.throws(() => service.quote({ itemId: 'nope', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+    });
+
+    it('rejects periods that do not start and end at midnight UTC', () => {
+      for (const [start, end] of [
+        ['2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z'],
+        ['2026-07-01T00:00:00Z', '2026-07-02T00:00:01Z'],
+        ['2026-07-01T00:00:00+02:00', '2026-07-02T00:00:00+02:00'],
+        ['2026-07-01T00:00:00', '2026-07-02T00:00:00'],
+      ]) {
+        assert.throws(() => service.quote({ itemId: 'board-1', start, end }), undefined, `${start} → ${end}`);
+      }
+    });
+
+    it('rejects an empty or reversed period', () => {
+      assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-02T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+      assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-07-03T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+    });
+
+    it('rejects unparseable or non-string times', () => {
+      assert.throws(() => service.quote({ itemId: 'board-1', start: 'tomorrow', end: '2026-07-02T00:00:00Z' }));
+      assert.throws(() => service.quote({ itemId: 'board-1', start: 0 as unknown as string, end: '2026-07-02T00:00:00Z' }));
+      assert.throws(() => service.quote({ itemId: 'board-1', start: '2026-02-30T00:00:00Z', end: '2026-03-02T00:00:00Z' }));
+    });
+  });
+
+  describe('book', () => {
+    const july = { itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' };
+
+    it('returns the booking with an id and the quoted total', () => {
+      const booking = service.book(july);
+      assert.equal(booking.itemId, 'board-1');
+      assert.equal(booking.total, 13500);
+      assert.equal(typeof booking.id, 'string');
+    });
+
+    it('gives each booking its own id', () => {
+      const first = service.book(july);
+      const second = service.book({ ...july, itemId: 'sail-1' });
+      assert.notEqual(first.id, second.id);
+    });
+
+    it('rejects an overlapping period for the same item', () => {
+      service.book(july);
+      for (const [start, end] of [
+        ['2026-07-01T00:00:00Z', '2026-07-04T00:00:00Z'],
+        ['2026-07-03T00:00:00Z', '2026-07-05T00:00:00Z'],
+        ['2026-06-29T00:00:00Z', '2026-07-02T00:00:00Z'],
+        ['2026-06-29T00:00:00Z', '2026-07-10T00:00:00Z'],
+        ['2026-07-02T00:00:00Z', '2026-07-03T00:00:00Z'],
+      ]) {
+        assert.throws(() => service.book({ itemId: 'board-1', start, end }), undefined, `${start} → ${end}`);
+      }
+    });
+
+    it('allows adjacent periods and other items', () => {
+      service.book(july);
+      assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: '2026-07-04T00:00:00Z', end: '2026-07-05T00:00:00Z' }));
+      assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: '2026-06-30T00:00:00Z', end: '2026-07-01T00:00:00Z' }));
+      assert.doesNotThrow(() => service.book({ ...july, itemId: 'sail-1' }));
+    });
+
+    it('rejects an unknown item or a disallowed period without booking', () => {
+      assert.throws(() => service.book({ ...july, itemId: 'nope' }));
+      assert.throws(() => service.book({ ...july, start: '2026-07-01T09:00:00Z' }));
+      assert.doesNotThrow(() => service.book(july));
+    });
+  });
+});
