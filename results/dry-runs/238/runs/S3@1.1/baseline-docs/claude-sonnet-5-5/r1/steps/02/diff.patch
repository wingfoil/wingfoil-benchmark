diff --git a/src/index.test.ts b/src/index.test.ts
index df5f6c94e2ade18f6eb0dd69ed1b7b03b4e89b73..571bec6f0399b8065a511debb8613d7f8a2b19e4 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -119,4 +119,47 @@ describe('rental service', () => {
       assert.doesNotThrow(() => service.book(july));
     });
   });
+
+  describe('availability', () => {
+    const july = { start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' };
+
+    beforeEach(() => {
+      service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 4000 });
+    });
+
+    it('lists the ids free for the whole period, sorted, of any kind by default', () => {
+      assert.deepEqual(service.availability(july), ['board-1', 'board-2', 'sail-1']);
+    });
+
+    it('restricts the result to the given kind', () => {
+      assert.deepEqual(service.availability({ ...july, kind: 'sail' }), ['sail-1']);
+    });
+
+    it('sorts by id whatever the order of registration', () => {
+      service.addEquipment({ id: 'board-0', kind: 'board', dailyPrice: 100 });
+      assert.deepEqual(service.availability({ ...july, kind: 'board' }), ['board-0', 'board-1', 'board-2']);
+    });
+
+    it('leaves out items booked for any part of the period', () => {
+      service.book({ itemId: 'board-1', start: '2026-07-03T00:00:00Z', end: '2026-07-10T00:00:00Z' });
+      assert.deepEqual(service.availability({ ...july, kind: 'board' }), ['board-2']);
+    });
+
+    it('keeps items whose bookings are only adjacent to the period', () => {
+      service.book({ itemId: 'board-1', start: '2026-07-04T00:00:00Z', end: '2026-07-05T00:00:00Z' });
+      service.book({ itemId: 'board-2', start: '2026-06-30T00:00:00Z', end: '2026-07-01T00:00:00Z' });
+      assert.deepEqual(service.availability({ ...july, kind: 'board' }), ['board-1', 'board-2']);
+    });
+
+    it('returns an empty list when nothing is free or the kind has no equipment', () => {
+      service.book({ itemId: 'sail-1', ...july });
+      assert.deepEqual(service.availability({ ...july, kind: 'sail' }), []);
+    });
+
+    it('throws on a disallowed period or an unknown kind', () => {
+      assert.throws(() => service.availability({ ...july, start: '2026-07-01T09:00:00Z' }));
+      assert.throws(() => service.availability({ start: july.end, end: july.start }));
+      assert.throws(() => service.availability({ ...july, kind: 'kayak' as 'board' }));
+    });
+  });
 });
