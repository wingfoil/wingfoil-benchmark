+  describe('cancel', () => {
+    const july = { itemId: 'board-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' };
+
+    it('refunds the whole total when cancelled before the start', () => {
+      const booking = service.book(july);
+      assert.deepEqual(service.cancel(booking.id, '2026-06-20T10:00:00Z'), { bookingId: booking.id, refund: 12150 });
+    });
+
+    it('refunds the whole total when cancelled exactly at the start', () => {
+      const booking = service.book(july);
+      assert.equal(service.cancel(booking.id, '2026-07-01T00:00:00Z').refund, 12150);
+    });
+
+    it('refunds nothing once the rental has started', () => {
+      const booking = service.book(july);
+      assert.equal(service.cancel(booking.id, '2026-07-01T00:00:01Z').refund, 0);
+    });
+
+    it('refunds an hourly booking in full before its start', () => {
+      service.addEquipment({ id: 'board-h', kind: 'board', dailyPrice: 4500, hourlyPrice: 900 });
+      const booking = service.book({ itemId: 'board-h', start: '2026-07-01T09:00:00Z', end: '2026-07-01T11:00:00Z' });
+      assert.equal(service.cancel(booking.id, '2026-07-01T08:00:00Z').refund, 1800);
+    });
+
+    it('frees the equipment for the period', () => {
+      const booking = service.book(july);
+      service.cancel(booking.id, '2026-06-20T10:00:00Z');
+      assert.deepEqual(service.availability({ start: july.start, end: july.end, kind: 'board' }), ['board-1']);
+      assert.doesNotThrow(() => service.book(july));
+    });
+
+    it('does not reuse the id of a cancelled booking', () => {
+      const first = service.book(july);
+      service.cancel(first.id, '2026-06-20T10:00:00Z');
+      assert.notEqual(service.book(july).id, first.id);
+    });
+
+    it('cancels a booking only once', () => {
+      const booking = service.book(july);
+      service.cancel(booking.id, '2026-06-20T10:00:00Z');
+      assert.throws(() => service.cancel(booking.id, '2026-06-21T10:00:00Z'));
+    });
+
+    it('rejects an unknown booking or an invalid time without cancelling', () => {
+      const booking = service.book(july);
+      assert.throws(() => service.cancel('nope', '2026-06-20T10:00:00Z'));
+      assert.throws(() => service.cancel(booking.id, 'yesterday'));
+      assert.doesNotThrow(() => service.cancel(booking.id, '2026-06-20T10:00:00Z'));
+    });
+  });
+
