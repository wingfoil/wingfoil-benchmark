+++ b/test/patch.test.ts
@@ -0,0 +1,94 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+// RFC 6902 Appendix A examples
+const cases: [string, unknown, unknown[], unknown][] = [
+  ["A.1 add object member", { foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" }],
+  ["A.2 add array element", { foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] }],
+  ["A.3 remove member", { baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }], { foo: "bar" }],
+  ["A.4 remove element", { foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] }],
+  ["A.5 replace", { baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" }],
+  [
+    "A.6 move member",
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  ],
+  ["A.7 move element", { foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], { foo: ["all", "cows", "eat", "grass"] }],
+  ["A.8 test success", { baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], { baz: "qux", foo: ["a", 2, "c"] }],
+  ["A.11 add with existing key replaces", { foo: "bar" }, [{ op: "add", path: "/foo", value: "x" }], { foo: "x" }],
+  ["A.14 ~ escape", { "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 }],
+  ["A.16 add to array end", { foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] }],
+  ["copy", { a: { b: [1] } }, [{ op: "copy", from: "/a/b", path: "/c" }], { a: { b: [1] }, c: [1] }],
+  ["replace whole document", { a: 1 }, [{ op: "replace", path: "", value: [1] }], [1]],
+  ["add whole document", { a: 1 }, [{ op: "add", path: "", value: null }], null],
+  ["move to same location", { a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 }],
+  ["test is order-independent for objects", { a: { x: 1, y: 2 } }, [{ op: "test", path: "/a", value: { y: 2, x: 1 } }], { a: { x: 1, y: 2 } }],
+  ["empty patch", { a: 1 }, [], { a: 1 }],
+];
+for (const [name, doc, patch, expected] of cases) {
+  test(name, () => assert.deepEqual(applyPatch(doc, patch), expected));
+}
+
+const failures: [string, unknown, unknown][] = [
+  ["A.9 test failure", { baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]],
+  ["test type differs", { a: 1 }, [{ op: "test", path: "/a", value: "1" }]],
+  ["A.12 add to nonexistent parent", { foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]],
+  ["A.15 test missing member", { a: 1 }, [{ op: "test", path: "/b", value: null }]],
+  ["remove missing", {}, [{ op: "remove", path: "/a" }]],
+  ["replace missing", {}, [{ op: "replace", path: "/a", value: 1 }]],
+  ["remove root", {}, [{ op: "remove", path: "" }]],
+  ["move into own child", { a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]],
+  ["copy missing from", {}, [{ op: "copy", from: "/x", path: "/y" }]],
+  ["move missing from", {}, [{ op: "move", from: "/x", path: "/y" }]],
+  ["array index past end", [1], [{ op: "add", path: "/2", value: 0 }]],
+  ["array leading zero", [1, 2], [{ op: "add", path: "/01", value: 0 }]],
+  ["'-' in remove", [1], [{ op: "remove", path: "/-" }]],
+  ["remove index at length", [1], [{ op: "remove", path: "/1" }]],
+  ["add into primitive", { a: 1 }, [{ op: "add", path: "/a/b", value: 0 }]],
+  ["unknown op", {}, [{ op: "frob", path: "/a" }]],
+  ["missing op", {}, [{ path: "/a", value: 1 }]],
+  ["missing path", {}, [{ op: "remove" }]],
+  ["bad path", {}, [{ op: "add", path: "a", value: 1 }]],
+  ["missing value", {}, [{ op: "add", path: "/a" }]],
+  ["missing from", {}, [{ op: "move", path: "/a" }]],
+  ["patch not array", {}, { op: "add", path: "/a", value: 1 }],
+  ["operation not object", {}, [null]],
+];
+for (const [name, doc, patch] of failures) {
+  test(`throws: ${name}`, () => assert.throws(() => applyPatch(doc, patch)));
+}
+
+test("does not mutate input document or patch, and does not alias them", () => {
+  const doc = { a: { b: [1, 2] }, c: 1 };
+  const patch = [
+    { op: "add", path: "/a/b/-", value: { z: 1 } },
+    { op: "move", from: "/c", path: "/d" },
+    { op: "copy", from: "/a", path: "/e" },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const out = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.notEqual(out.a, doc.a);
+  assert.notEqual(out.a.b[2], patch[0].value);
+  assert.notEqual(out.e, out.a);
+});
+
+test("failed patch leaves input untouched", () => {
+  const doc = { a: 1 };
+  assert.throws(() => applyPatch(doc, [{ op: "add", path: "/b", value: 2 }, { op: "test", path: "/a", value: 9 }]));
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("no prototype pollution via __proto__", () => {
+  const out = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: 1 } }]) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/__proto__/polluted", value: 1 }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/constructor/prototype/x", value: 1 }]));
+  assert.equal(({} as any).x, undefined);
+});
