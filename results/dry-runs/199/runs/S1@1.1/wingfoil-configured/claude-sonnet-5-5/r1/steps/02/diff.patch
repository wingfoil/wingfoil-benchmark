+---
+id: task-002-implement-json-patch-rfc-6902-applypatch
+type: task
+title: "Implement JSON Patch (RFC 6902) applyPatch"
+status: approved
+format: 1
+---
+
+<!-- task body. `wingfoil memory add` copies this scaffold, setting only `id`, `title` and
+     `status` (and any `--tags` or `--set` value). Fill the required frontmatter fields and replace
+     these placeholder comments yourself; `wingfoil memory submit` then checks the required fields,
+     moves `status` forward and commits the document as you left it, naming in the commit body the
+     content it carries. -->
+
+# Request
+
+Implement JSON Patch (RFC 6902): export `applyPatch(document, patch)` from `src/index.ts`, with the six
+operations add, remove, replace, move, copy and test. It returns a new document, never mutates its input,
+and throws when the patch is invalid or an operation fails.
+
+# Acceptance
+
+- RFC 6902 section 4 semantics: add (replaces existing member, inserts into arrays, "-" appends, "" replaces
+  the document), remove/replace require an existing target, move forbids `from` as a proper prefix of `path`,
+  copy deep-copies, test uses RFC 6902 section 4.6 equality.
+- Invalid patches (non-array, missing/unknown `op`, bad pointers, missing `value`/`from`) throw.
+- Input document and patch are not mutated; `__proto__`/`constructor` keys cannot pollute prototypes.
+- Tests in `test/patch.test.ts` cover the RFC 6902 Appendix A examples and error cases; `npm test` passes.
diff --git a/src/index.ts b/src/index.ts
index 15a9c06abf4effb6afb50e40f537955058010d7f..f5be5caa51e3331092414197ac82df1d0ab7bde3 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -48,3 +48,175 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+const has = (o: object, key: string): boolean => Object.prototype.hasOwnProperty.call(o, key);
+
+function setMember(obj: Record<string, JsonValue>, key: string, value: JsonValue): void {
+  // defineProperty keeps keys such as "__proto__" as plain own members (no prototype pollution).
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone(value: unknown): JsonValue {
+  if (Array.isArray(value)) return value.map(clone);
+  if (typeof value === "object" && value !== null) {
+    const out: Record<string, JsonValue> = {};
+    for (const key of Object.keys(value)) {
+      setMember(out, key, clone((value as Record<string, unknown>)[key]));
+    }
+    return out;
+  }
+  if (value === null || typeof value === "boolean" || typeof value === "string") return value;
+  if (typeof value === "number" && Number.isFinite(value)) return value;
+  throw new Error("Value is not valid JSON");
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => deepEqual(v, b[i]))
+    );
+  }
+  if (typeof a === "object" && a !== null && typeof b === "object" && b !== null) {
+    const ka = Object.keys(a);
+    const kb = Object.keys(b);
+    return (
+      ka.length === kb.length &&
+      ka.every((k) => has(b, k) && deepEqual((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]))
+    );
+  }
+  return a === b;
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (allowEnd && token === "-") return length;
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`JSON Patch: bad array index "${token}"`);
+  }
+  const index = Number(token);
+  if (index > length || (!allowEnd && index === length)) {
+    throw new Error(`JSON Patch: array index ${token} out of range`);
+  }
+  return index;
+}
+
+/** Returns the container holding the target of `tokens` (which must be non-empty) and the last token. */
+function parentOf(root: JsonValue, tokens: string[]): [JsonValue, string] {
+  let current: JsonValue = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      current = current[arrayIndex(token, current.length, false)];
+    } else if (typeof current === "object" && current !== null && has(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`JSON Patch: path does not resolve at "${token}"`);
+    }
+  }
+  return [current, tokens[tokens.length - 1]];
+}
+
+function addAt(root: JsonValue, tokens: string[], value: JsonValue): JsonValue {
+  if (tokens.length === 0) return value;
+  const [parent, last] = parentOf(root, tokens);
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(last, parent.length, true), 0, value);
+  } else if (typeof parent === "object" && parent !== null) {
+    setMember(parent, last, value);
+  } else {
+    throw new Error("JSON Patch: cannot add into a primitive");
+  }
+  return root;
+}
+
+function getAt(root: JsonValue, tokens: string[]): JsonValue {
+  if (tokens.length === 0) return root;
+  const [parent, last] = parentOf(root, tokens);
+  if (Array.isArray(parent)) return parent[arrayIndex(last, parent.length, false)];
+  if (typeof parent === "object" && parent !== null && has(parent, last)) return parent[last];
+  throw new Error(`JSON Patch: path does not resolve at "${last}"`);
+}
+
+function removeAt(root: JsonValue, tokens: string[]): JsonValue {
+  if (tokens.length === 0) {
+    throw new Error("JSON Patch: cannot remove the whole document");
+  }
+  const [parent, last] = parentOf(root, tokens);
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(last, parent.length, false), 1);
+  } else if (typeof parent === "object" && parent !== null && has(parent, last)) {
+    delete parent[last];
+  } else {
+    throw new Error(`JSON Patch: path does not resolve at "${last}"`);
+  }
+  return root;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result as a new value.
+ * The input document and patch are never mutated. Throws if the patch is invalid or any
+ * operation fails (RFC 6902 section 5: evaluation stops at the first error, and nothing is returned).
+ */
+export function applyPatch(document: unknown, patch: unknown): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: not an array");
+  }
+  let result = clone(document);
+  for (const op of patch) {
+    if (typeof op !== "object" || op === null || Array.isArray(op)) {
+      throw new Error("Invalid JSON Patch: operation is not an object");
+    }
+    const o = op as Record<string, unknown>;
+    if (!has(o, "op") || typeof o.op !== "string") {
+      throw new Error('Invalid JSON Patch: missing "op"');
+    }
+    const path = parsePointer(has(o, "path") ? o.path : undefined);
+    const needValue = o.op === "add" || o.op === "replace" || o.op === "test";
+    const needFrom = o.op === "move" || o.op === "copy";
+    if (!needValue && !needFrom && o.op !== "remove") {
+      throw new Error(`Invalid JSON Patch: unknown op "${o.op}"`);
+    }
+    if (needValue && !has(o, "value")) {
+      throw new Error(`Invalid JSON Patch: "${o.op}" requires "value"`);
+    }
+    const from = needFrom ? parsePointer(has(o, "from") ? o.from : undefined) : [];
+    switch (o.op) {
+      case "add":
+        result = addAt(result, path, clone(o.value));
+        break;
+      case "remove":
+        result = removeAt(result, path);
+        break;
+      case "replace":
+        getAt(result, path); // the target must exist
+        result = path.length === 0 ? clone(o.value) : addAt(removeAt(result, path), path, clone(o.value));
+        break;
+      case "move": {
+        if (from.length < path.length && from.every((t, i) => t === path[i])) {
+          throw new Error('JSON Patch: "from" must not be a proper prefix of "path"');
+        }
+        const value = clone(getAt(result, from));
+        result = addAt(removeAt(result, from), path, value);
+        break;
+      }
+      case "copy":
+        result = addAt(result, path, clone(getAt(result, from)));
+        break;
+      case "test":
+        if (!deepEqual(getAt(result, path), o.value)) {
+          throw new Error(`JSON Patch: test failed at "${o.path}"`);
+        }
+        break;
+    }
+  }
+  return result;
+}
