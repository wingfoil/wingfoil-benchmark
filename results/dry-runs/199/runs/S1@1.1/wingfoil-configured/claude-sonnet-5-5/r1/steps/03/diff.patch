+---
+id: task-003-conform-applypatch-to-rfc-6902
+type: task
+title: "Conform applyPatch to RFC 6902"
+status: approved
+format: 1
+---
+
+<!-- task body. `wingfoil memory add` copies this scaffold, setting only `id`, `title` and
+     `status` (and any `--tags` or `--set` value). Fill the required frontmatter fields and replace
+     these placeholder comments yourself; `wingfoil memory submit` then checks the required fields,
+     moves `status` forward and commits the document as you left it, naming in the commit body the
+     content it carries. -->
+
+# Request
+
+Users report `applyPatch` accepting patches they consider invalid and giving unexpected results or
+error behaviour. Review checking and application against RFC 6902 and conform it, errors included.
+
+# Outcome
+
+Reviewed `applyPatch` against RFC 6902 sections 3, 4.1-4.6 and 5 and probed edge cases (array indices
+`-1`, `01`, `1e0`, `-`; move with prefix paths, move past end after removal; replace at array end; test
+equality; missing/ill-typed members; atomicity; `__proto__`). No deviation from the RFC found, so
+`src/index.ts` is unchanged. Added regression tests for these cases in `test/patch.test.ts` (60 pass).
+Open point: `remove` of the root path "" throws; the RFC leaves that result undefined, kept as is.
diff --git a/test/patch.test.ts b/test/patch.test.ts
index 8daafe426b64df977d9955cb4ef1f6c914b3b80f..282386f74028f433f43b47af49b06767e38b34a4 100644
--- a/test/patch.test.ts
+++ b/test/patch.test.ts
@@ -92,3 +92,29 @@ test("no prototype pollution via __proto__", () => {
   assert.throws(() => applyPatch({}, [{ op: "add", path: "/constructor/prototype/x", value: 1 }]));
   assert.equal(({} as any).x, undefined);
 });
+
+// RFC 6902 edge cases: sections 4.1-4.6 and 5 (errors).
+const edgeCases: [string, unknown, unknown[], unknown][] = [
+  ["4.4 move may target a proper prefix of from", { a: { b: 1 } }, [{ op: "move", from: "/a/b", path: "/a" }], { a: 1 }],
+  ["4.4 move to array end", { a: [1, 2, 3] }, [{ op: "move", from: "/a/0", path: "/a/-" }], { a: [2, 3, 1] }],
+  ["4.6 test numbers are numerically equal", { a: 1 }, [{ op: "test", path: "/a", value: 1.0 }], { a: 1 }],
+  ["4 members not defined for the op are ignored", { a: 1 }, [{ op: "remove", path: "/a", value: 5, from: 7 }], {}],
+  ["6901 empty key", { "": 1 }, [{ op: "test", path: "/", value: 1 }], { "": 1 }],
+];
+for (const [name, doc, patch, expected] of edgeCases) {
+  test(name, () => assert.deepEqual(applyPatch(doc, patch), expected));
+}
+
+const edgeFailures: [string, unknown, unknown][] = [
+  ["4.4 move index past end after removal", { a: [1, 2, 3] }, [{ op: "move", from: "/a/0", path: "/a/3" }]],
+  ["4.3 replace at array length", { a: [1] }, [{ op: "replace", path: "/a/1", value: 1 }]],
+  ["4.3 replace at '-'", { a: [1] }, [{ op: "replace", path: "/a/-", value: 1 }]],
+  ["4.6 test requires value", { a: 1 }, [{ op: "test", path: "/a" }]],
+  ["3 path must be a string", { a: 1 }, [{ op: "add", path: 5, value: 1 }]],
+  ["array index '-1'", { a: [1] }, [{ op: "add", path: "/a/-1", value: 1 }]],
+  ["array index '1e0'", { a: [1] }, [{ op: "add", path: "/a/1e0", value: 1 }]],
+  ["5 error after a valid op", { a: 1 }, [{ op: "remove", path: "/a" }, { op: "remove", path: "/a" }]],
+];
+for (const [name, doc, patch] of edgeFailures) {
+  test(`throws: ${name}`, () => assert.throws(() => applyPatch(doc, patch)));
+}
