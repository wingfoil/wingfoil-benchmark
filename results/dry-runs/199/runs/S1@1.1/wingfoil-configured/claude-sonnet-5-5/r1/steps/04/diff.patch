@@ -53,3 +53,38 @@ test("unresolvable pointers throw", () => {
   assert.throws(() => resolvePointer({}, "/toString"));
   assert.throws(() => resolvePointer({}, "/__proto__"));
 });
+
+test("applyMergePatch: RFC 7386 appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, r] of cases) assert.deepEqual(applyMergePatch(t, p), r);
+});
+
+test("applyMergePatch does not mutate or alias, and ignores the prototype", () => {
+  const target = { a: { b: 1 } };
+  const patch = { c: { d: [1] } };
+  const out = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 } });
+  assert.notEqual(out.a, target.a);
+  assert.notEqual(out.c, patch.c);
+  assert.notEqual(out.c.d, patch.c.d);
+  const evil = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as any;
+  assert.equal(({} as any).x, undefined);
+  assert.equal(Object.getPrototypeOf(evil), Object.prototype);
+  assert.deepEqual(Object.keys(evil), ["__proto__"]);
+});
