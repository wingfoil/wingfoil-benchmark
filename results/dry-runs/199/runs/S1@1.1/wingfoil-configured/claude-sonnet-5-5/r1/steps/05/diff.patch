+++ b/test/createPatch.test.ts
@@ -0,0 +1,74 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function check(from: unknown, to: unknown): unknown[] {
+  const f = JSON.stringify(from);
+  const t = JSON.stringify(to);
+  const patch = createPatch(from, to);
+  assert.equal(JSON.stringify(from), f);
+  assert.equal(JSON.stringify(to), t);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(check({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("root replacement and type changes", () => {
+  assert.deepEqual(check(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  check({ a: 1 }, [1]);
+  check({ a: 1 }, { a: [1] });
+  check(null, { a: null });
+});
+
+test("one small change deep in a document", () => {
+  const from = { a: { b: { c: [1, 2, 3], d: "x" } }, e: "y" };
+  const to = { a: { b: { c: [1, 2, 3], d: "z" } }, e: "y" };
+  assert.deepEqual(check(from, to), [{ op: "replace", path: "/a/b/d", value: "z" }]);
+});
+
+test("object member add and remove, with escaped keys", () => {
+  assert.deepEqual(check({ "a/b": 1, "m~n": 2 }, { "m~n": 2, c: 3 }), [
+    { op: "remove", path: "/a~1b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("array insert and remove touch only that item", () => {
+  assert.deepEqual(check([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(check([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(check([], [1]), [{ op: "add", path: "/0", value: 1 }]);
+  assert.deepEqual(check([1], []), [{ op: "remove", path: "/0" }]);
+});
+
+test("array item move does not rewrite the items in between", () => {
+  const patch = check(["a", "b", "c", "d", "e"], ["b", "c", "d", "e", "a"]);
+  assert.equal(patch.length, 2);
+  check(["a", "b", "c", "d", "e"], ["e", "a", "b", "c", "d"]);
+});
+
+test("changed array item yields a nested patch", () => {
+  assert.deepEqual(check([{ id: 1, v: 1 }, { id: 2, v: 2 }], [{ id: 1, v: 1 }, { id: 2, v: 3 }]), [
+    { op: "replace", path: "/1/v", value: 3 },
+  ]);
+});
+
+test("mixed array edits and randomized round trip", () => {
+  check([1, 2, 3], [3, 2, 1]);
+  check([[1], [2]], [[2], [1, 5]]);
+  let seed = 7;
+  const rnd = (n: number) => (seed = (seed * 1103515245 + 12345) % 2147483648) % n;
+  const arr = () => Array.from({ length: rnd(8) }, () => rnd(5));
+  for (let k = 0; k < 300; k++) check({ x: arr(), y: [arr(), { z: arr() }] }, { x: arr(), y: [arr(), { z: arr() }] });
+});
+
+test("__proto__ members are ordinary and the output is not aliased", () => {
+  const from = JSON.parse('{"__proto__":{"a":1}}');
+  const to = JSON.parse('{"__proto__":{"a":2},"n":{"k":[1]}}');
+  const patch = check(from, to) as { value?: { k: number[] } }[];
+  (patch[1].value as { k: number[] }).k.push(2);
+  assert.deepEqual(to.n.k, [1]);
+  assert.equal(({} as Record<string, unknown>).a, undefined);
+});
