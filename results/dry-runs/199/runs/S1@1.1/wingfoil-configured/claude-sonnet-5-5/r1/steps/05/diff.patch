--- a/src/index.ts
+++ b/src/index.ts
@@ -242,3 +242,84 @@ export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
   }
   return result;
 }
+
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: JsonValue }
+  | { op: "remove"; path: string };
+
+const escapeToken = (token: string): string => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+/** Longest common subsequence table over deep equality: lcs[i][j] is for a[i..] and b[j..]. */
+function lcsTable(a: JsonValue[], b: JsonValue[]): Uint32Array[] {
+  const table = Array.from({ length: a.length + 1 }, () => new Uint32Array(b.length + 1));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      table[i][j] = deepEqual(a[i], b[j]) ? table[i + 1][j + 1] + 1 : Math.max(table[i + 1][j], table[i][j + 1]);
+    }
+  }
+  return table;
+}
+
+function diffArrays(a: JsonValue[], b: JsonValue[], path: string, ops: PatchOperation[]): void {
+  const table = lcsTable(a, b);
+  let i = 0;
+  let j = 0;
+  let index = 0; // position in the array as patched so far
+  while (i < a.length || j < b.length) {
+    if (i < a.length && j < b.length && deepEqual(a[i], b[j])) {
+      i++;
+      j++;
+      index++;
+      continue;
+    }
+    // A gap between two matched items: items removed from `a` and items added from `b`.
+    const removed: JsonValue[] = [];
+    const added: JsonValue[] = [];
+    while (i < a.length || j < b.length) {
+      if (i < a.length && j < b.length && deepEqual(a[i], b[j])) break;
+      if (j >= b.length || (i < a.length && table[i + 1][j] >= table[i][j + 1])) removed.push(a[i++]);
+      else added.push(b[j++]);
+    }
+    // Pair removed and added items in place, so a changed item yields a nested patch.
+    const paired = Math.min(removed.length, added.length);
+    for (let k = 0; k < paired; k++) diffValues(removed[k], added[k], `${path}/${index + k}`, ops);
+    for (let k = paired; k < removed.length; k++) ops.push({ op: "remove", path: `${path}/${index + paired}` });
+    for (let k = paired; k < added.length; k++) {
+      ops.push({ op: "add", path: `${path}/${index + k}`, value: added[k] });
+    }
+    index += added.length;
+  }
+}
+
+function diffValues(a: JsonValue, b: JsonValue, path: string, ops: PatchOperation[]): void {
+  if (deepEqual(a, b)) return;
+  if (Array.isArray(a) && Array.isArray(b)) {
+    diffArrays(a, b, path, ops);
+  } else if (isObject(a) && isObject(b)) {
+    const from = a as Record<string, JsonValue>;
+    const to = b as Record<string, JsonValue>;
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (has(from, key)) diffValues(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: to[key] });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: b });
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ * The patch is minimal in the sense of describing only what changed: objects are compared member by
+ * member, arrays by longest common subsequence (so inserted, removed and moved items do not rewrite
+ * their neighbours; a moved item is expressed as a remove and an add). Neither input is mutated, and
+ * the patch shares no structure with them. Throws if either input is not valid JSON.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffValues(clone(from), clone(to), "", ops);
+  return ops;
+}
