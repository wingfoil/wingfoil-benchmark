+
+test('cancel refunds in full before the start and frees the equipment', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(5), end: d(7) });
+  assert.deepEqual(s.cancel(b.id, '2026-05-04T10:15:00Z'), { bookingId: b.id, refund: b.total });
+  assert.deepEqual(s.availability({ start: d(5), end: d(7), kind: 'board' }), ['b1']);
+  assert.equal(s.book({ itemId: 'b1', start: d(5), end: d(7) }).total, b.total);
+});
+
+test('cancel after the start refunds nothing; after the end or twice is rejected', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(5), end: d(7) });
+  assert.throws(() => s.cancel(b.id, d(7)));
+  assert.equal(s.cancel(b.id, d(5)).refund, 0);
+  assert.throws(() => s.cancel(b.id, d(1)), /already cancelled/);
+});
+
+test('cancel rejects unknown ids and malformed times', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(5), end: d(7) });
+  assert.throws(() => s.cancel('nope', d(1)));
+  assert.throws(() => s.cancel(b.id, 'yesterday'));
