+test('hourly rentals under a day use the hourly price', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  const h = (n: number) => `2026-05-01T${String(n).padStart(2, '0')}:00:00.000Z`;
+  assert.equal(s.quote({ itemId: 'h1', start: h(9), end: h(13) }).total, 2400);
+  assert.equal(s.book({ itemId: 'h1', start: h(9), end: h(13) }).total, 2400);
+  assert.throws(() => s.book({ itemId: 'h1', start: h(12), end: h(14) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: h(9), end: h(13) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-05-01T09:30:00.000Z', end: h(13) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: h(9), end: '2026-05-02T09:00:00.000Z' }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+});
