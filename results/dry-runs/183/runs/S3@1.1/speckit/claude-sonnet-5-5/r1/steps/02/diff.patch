   assert.throws(() => s.addEquipment({ id: 'z', kind: 'boat' as any, dailyPrice: 1 }));
   assert.throws(() => s.addEquipment({ id: 'z', kind: 'board', dailyPrice: 1.5 }));
 });
+
+test('availability lists free equipment of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 1000 });
+  assert.deepEqual(s.availability({ start: d(1), end: d(4) }), ['a0', 'b1', 's1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(4), kind: 'board' }), ['a0', 'b1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(4), kind: 'sail' }), ['s1']);
+});
+
+test('availability excludes overlaps but not adjacent bookings', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: d(3), end: d(5) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(4) }), ['s1']);
+  assert.deepEqual(s.availability({ start: d(4), end: d(6) }), ['s1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3) }), ['b1', 's1']);
+  assert.deepEqual(s.availability({ start: d(5), end: d(7) }), ['b1', 's1']);
+  assert.deepEqual(s.availability({ start: d(3), end: d(5), kind: 'board' }), []);
+});
+
+test('availability rejects bad input', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: d(2), end: d(2) }));
+  assert.throws(() => s.availability({ start: '2026-05-01T10:00:00Z', end: d(2) }));
+  assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'boat' as any }));
+});
