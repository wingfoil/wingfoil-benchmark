+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+const d = (day: number) => `2026-05-${String(day).padStart(2, '0')}T00:00:00.000Z`;
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  return s;
+}
+
+test('quote totals whole days in cents', () => {
+  assert.deepEqual(setup().quote({ itemId: 'b1', start: d(1), end: d(4) }), {
+    itemId: 'b1', start: d(1), end: d(4), total: 7500,
+  });
+});
+
+test('quote rejects bad input', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'x', start: d(1), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-05-01T10:00:00Z', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(2), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(3), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: 'nope', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-05-01', end: d(2) }));
+});
+
+test('book returns id and refuses overlaps only on same item', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.equal(a.total, 7500);
+  assert.throws(() => s.book({ itemId: 'b1', start: d(3), end: d(5) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(1), end: d(2) }));
+  const b = s.book({ itemId: 'b1', start: d(4), end: d(5) });
+  s.book({ itemId: 's1', start: d(1), end: d(4) });
+  assert.notEqual(a.id, b.id);
+});
+
+test('addEquipment validates', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'z', kind: 'boat' as any, dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'z', kind: 'board', dailyPrice: 1.5 }));
+});
