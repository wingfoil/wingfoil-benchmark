+
+describe('monthly export', () => {
+  it('lists the orders of a month as CSV, with totals as paid', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Orla "O" Finn, Jr', email: 'orla@example.org', phone: '555-0102' }));
+    shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'APL-1KG', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c2', date: '2026-10-03', lines: [{ sku: 'OIL-1L', quantity: 3 }] });
+    valueOf(shop.orders.applyCode(3, 'spring10'));
+    assert.equal(
+      shop.orders.exportMonth('2026-10'),
+      'order,date,customer,email,phone,total\n' +
+        '2,2026-10-02,Mira Holt,mira@example.org,555-0101,17.80\n' +
+        '3,2026-10-03,"Orla ""O"" Finn, Jr",orla@example.org,555-0102,39.73\n',
+    );
+  });
+
+  it('gives the header alone for a month without orders', () => {
+    assert.equal(stocked().orders.exportMonth('2026-11'), 'order,date,customer,email,phone,total\n');
+  });
+});
