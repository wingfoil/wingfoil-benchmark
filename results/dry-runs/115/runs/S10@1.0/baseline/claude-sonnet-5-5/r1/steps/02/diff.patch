+  /**
+   * CSV text of the orders placed in a month (`YYYY-MM`), by number: a header line, then one line per order
+   * with its number, date, customer name, email, phone and total in euros. Throws on a malformed month.
+   */
+  exportMonth(month: string): string;
+}
+
+const MONTH = /^\d{4}-(0[1-9]|1[0-2])$/;
+
+/** A CSV field, quoted if it holds a comma, a quote or a line break. */
+function csvField(value: string): string {
+  return /[",\r\n]/.test(value) ? `"${value.replaceAll('"', '""')}"` : value;
 }
 
 const DATE = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
@@ -87,7 +100,27 @@ export function createOrderBook(catalogue: Catalogue, customers: Customers): Ord
     return { itemsCents, priced };
   }
 
+  function totalOf(order: Order): Cents {
+    const { itemsCents, priced } = itemsOf(order);
+    return itemsCents - discountFor(order.code, itemsCents) + shippingFor(priced);
+  }
+
   return {
+    exportMonth(month) {
+      if (!MONTH.test(month)) throw new RangeError(`${month} is not a month (YYYY-MM)`);
+      const rows = ['order,date,customer,email,phone,total'];
+      for (const order of orders) {
+        if (!order.date.startsWith(`${month}-`)) continue;
+        const found = customers.get(order.customerId);
+        const customer = found.ok ? found.value : { name: '', email: '', phone: '' };
+        rows.push(
+          [String(order.number), order.date, customer.name, customer.email, customer.phone, formatEuros(totalOf(order))]
+            .map(csvField)
+            .join(','),
+        );
+      }
+      return rows.join('\n') + '\n';
+    },
     applyCode(orderNumber, code) {
       const order = orders[orderNumber - 1];
       if (order === undefined) return err('not-found', `no order ${orderNumber}`);
