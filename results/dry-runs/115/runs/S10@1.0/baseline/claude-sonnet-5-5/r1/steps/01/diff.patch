+describe('discount codes', () => {
+  function withOrder(sku: string, quantity: number) {
+    const shop = stocked();
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku, quantity }] });
+    return shop;
+  }
+
+  it('SPRING10 takes 10 % off the items, half cents up, not shipping', () => {
+    const shop = withOrder('APL-1KG', 1); // 349 -> 34.9 -> 35
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 349, discountCents: 35, shippingCents: 490, totalCents: 804 });
+  });
+
+  it('WELCOME5 needs 30.00 of items', () => {
