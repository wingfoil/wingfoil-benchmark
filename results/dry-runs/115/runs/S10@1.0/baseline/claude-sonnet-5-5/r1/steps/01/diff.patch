@@ -0,0 +1,43 @@
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** `WELCOME5` only applies to an order whose items come to this amount or more. */
+export const WELCOME_MIN_ITEMS_CENTS: Cents = 3000;
+
+/**
+ * The code as the shop knows it, or undefined if it is not one of the shop's codes.
+ *
+ * @param code - the code as a customer typed it
+ */
+function known(code: string): 'SPRING10' | 'WELCOME5' | undefined {
+  const normalised = code.trim().toUpperCase();
+  return normalised === 'SPRING10' || normalised === 'WELCOME5' ? normalised : undefined;
+}
+
+/**
+ * The code as it is kept on an order, if it may be used on an order whose items come to this amount.
+ *
+ * @param code - the code as a customer typed it
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function checkCode(code: string, itemsCents: Cents): Result<string> {
+  const name = known(code);
+  if (name === undefined) return err('invalid', `${code} is not a discount code`);
+  if (name === 'WELCOME5' && itemsCents < WELCOME_MIN_ITEMS_CENTS) {
+    return err('invalid', 'WELCOME5 needs items of 30.00 or more');
+  }
+  return ok(name);
+}
+
+/**
+ * What a code takes off an order's items; never more than the items.
+ *
+ * @param code - a code accepted by `checkCode`, or undefined for none
+ * @param itemsCents - what the order's items come to
+ */
+export function discountFor(code: string | undefined, itemsCents: Cents): Cents {
+  if (code === 'SPRING10') return Math.floor((itemsCents + 5) / 10);
+  if (code === 'WELCOME5') return Math.min(500, itemsCents);
+  return 0;
+}
