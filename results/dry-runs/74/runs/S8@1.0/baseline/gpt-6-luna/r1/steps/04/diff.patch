 }
+
+/**
+ * Add tasks from semicolon-separated rows (`title;priority;tags`), skipping blank lines.
+ *
+ * @param list - the list to add tasks to
+ * @param text - one task per line, with space-separated tags
+ */
+export function importTasks(list: TaskList, text: string): TaskImportResult {
+  let imported = 0;
+  const rejected: RejectedTaskImport[] = [];
+
+  for (const [index, rawLine] of text.split(/\r?\n/).entries()) {
+    if (rawLine.trim().length === 0) continue;
+
+    const fields = rawLine.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'line must contain title, priority and tags separated by semicolons' });
+      continue;
+    }
+
+    const [title, rawPriority, rawTags] = fields;
+    const priority = rawPriority.trim();
+    if (priority !== '' && priority !== 'low' && priority !== 'normal' && priority !== 'high') {
+      rejected.push({ line: index + 1, reason: 'priority must be low, normal or high' });
+      continue;
+    }
+
+    const result = list.add({
+      title,
+      ...(priority === '' ? {} : { priority: priority as Priority }),
+      tags: rawTags.trim() === '' ? [] : rawTags.trim().split(/\s+/),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  }
+
+  return { imported, rejected };
+}
