+/** Rule 6: full refund 24h or more before the start, half (to the nearest cent) before the start, none after. */
+function refundFor(total: number, startMs: number, atMs: number): number {
+  if (startMs - atMs >= FULL_REFUND_NOTICE_MS) {
+    return total;
+  }
+  return atMs < startMs ? Math.round(total / 2) : 0;
