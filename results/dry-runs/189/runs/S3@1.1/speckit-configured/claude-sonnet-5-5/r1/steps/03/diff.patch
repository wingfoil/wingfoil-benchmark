--- a/src/rental.ts
+++ b/src/rental.ts
@@ -69,6 +69,14 @@ function overlaps(a: { start: number; end: number }, b: { start: number; end: nu
   return a.start < b.end && b.start < a.end;
 }
 
+const LONG_RENTAL_DAYS = 3;
+
+/** Rule 5: a rental of 3 days or more costs 10% less than full price, rounded to the nearest cent. */
+function rentalTotal(days: number, dailyPrice: number): number {
+  const full = days * dailyPrice;
+  return days >= LONG_RENTAL_DAYS ? Math.round((full * 9) / 10) : full;
+}
