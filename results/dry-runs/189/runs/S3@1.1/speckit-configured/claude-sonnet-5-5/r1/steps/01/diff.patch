@@ -0,0 +1,86 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createRentalService } from '../src/rental.ts';
+
+const D = (day: number) => `2027-06-${String(day).padStart(2, '0')}T00:00:00Z`;
+
+function desk() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  return s;
+}
+
+test('addEquipment refuses invalid items', () => {
+  const s = desk();
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: ' ', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'kite' as 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
+});
+
+test('quote is days times daily price, in cents', () => {
+  const s = desk();
+  assert.deepEqual(s.quote({ itemId: 'b1', start: D(1), end: D(4) }), {
+    itemId: 'b1', start: D(1), end: D(4), total: 7500,
+  });
+  assert.equal(s.quote({ itemId: 'b1', start: D(1), end: D(2) }).total, 2500);
+});
+
+test('quote and book refuse unknown items', () => {
+  const s = desk();
+  assert.throws(() => s.quote({ itemId: 'nope', start: D(1), end: D(2) }));
+  assert.throws(() => s.book({ itemId: 'nope', start: D(1), end: D(2) }));
+});
+
+test('periods must be whole UTC days, in order', () => {
+  const s = desk();
+  const bad = [
+    ['2027-06-01T10:00:00Z', D(2)],
+    [D(1), '2027-06-02T00:00:00+00:00'],
+    [D(1), '2027-06-02T02:00:00+02:00'],
+    ['2027-06-01', D(2)],
+    [D(2), D(1)],
+    [D(1), D(1)],
+    ['2027-02-30T00:00:00Z', '2027-03-02T00:00:00Z'],
+    ['garbage', D(2)],
+  ];
+  for (const [start, end] of bad) {
+    assert.throws(() => s.quote({ itemId: 'b1', start, end }), `${start} ${end}`);
+    assert.throws(() => s.book({ itemId: 'b1', start, end }), `${start} ${end}`);
+  }
+});
+
+test('book returns a booking with a unique id and the total', () => {
+  const s = desk();
+  const a = s.book({ itemId: 'b1', start: D(1), end: D(4) });
+  const b = s.book({ itemId: 's1', start: D(1), end: D(4) });
+  assert.equal(a.total, 7500);
+  assert.deepEqual({ ...a, id: '' }, { id: '', itemId: 'b1', start: D(1), end: D(4), total: 7500 });
+  assert.notEqual(a.id, b.id);
+});
+
+test('same item cannot be booked for overlapping periods', () => {
+  const s = desk();
+  s.book({ itemId: 'b1', start: D(5), end: D(8) });
+  for (const [a, b] of [[3, 6], [6, 7], [4, 9], [5, 8], [7, 10], [1, 20]]) {
+    assert.throws(() => s.book({ itemId: 'b1', start: D(a), end: D(b) }), `${a}-${b}`);
+  }
+});
+
+test('back-to-back bookings and other items are fine; quote ignores bookings', () => {
+  const s = desk();
+  s.book({ itemId: 'b1', start: D(5), end: D(8) });
+  s.book({ itemId: 'b1', start: D(8), end: D(9) });
+  s.book({ itemId: 'b1', start: D(3), end: D(5) });
+  s.book({ itemId: 's1', start: D(5), end: D(8) });
+  assert.equal(s.quote({ itemId: 'b1', start: D(5), end: D(8) }).total, 7500);
+});
+
+test('services are independent', () => {
+  const a = desk();
+  const b = createRentalService();
+  assert.throws(() => b.quote({ itemId: 'b1', start: D(1), end: D(2) }));
+  a.book({ itemId: 'b1', start: D(1), end: D(2) });
+});
