@@ -0,0 +1,117 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one day of rental, in euro cents. */
+  dailyPrice: number;
+}
+
+/** A rental period: ISO-8601 UTC strings, midnight to midnight. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+export interface Quote extends RentalRequest {
+  /** Total in euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 86_400_000;
+const MIDNIGHT_UTC = /^(\d{4}-\d{2}-\d{2})T00:00:00(?:\.0+)?Z$/;
+
+/** Rule 2 and 3: an ISO-8601 UTC string at midnight; returns epoch milliseconds. */
+function parseMidnightUtc(value: unknown, name: string): number {
+  const match = typeof value === 'string' ? MIDNIGHT_UTC.exec(value) : null;
+  if (!match) {
+    throw new RangeError(`${name} must be an ISO-8601 UTC time at midnight, like 2027-06-01T00:00:00Z`);
+  }
+  const ms = Date.parse(`${match[1]}T00:00:00Z`);
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== match[1]) {
+    throw new RangeError(`${name} is not a real date`);
+  }
+  return ms;
+}
+
+/** Rule 3: a period covers one or more whole days. */
+function parsePeriod(request: RentalRequest): { start: number; end: number; days: number } {
+  const start = parseMidnightUtc(request.start, 'start');
+  const end = parseMidnightUtc(request.end, 'end');
+  if (end <= start) {
+    throw new RangeError('end must be after start');
+  }
+  return { start, end, days: (end - start) / DAY_MS };
+}
+
+/** Rule 4: half-open periods overlap when each starts before the other ends. */
+function overlaps(a: { start: number; end: number }, b: { start: number; end: number }): boolean {
+  return a.start < b.end && b.start < a.end;
+}
+
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Array<Booking & { startMs: number; endMs: number }> = [];
+
+  function price(request: RentalRequest) {
+    const item = equipment.get(request.itemId);
+    if (!item) {
+      throw new Error(`Unknown item: ${String(request.itemId)}`);
+    }
+    const period = parsePeriod(request);
+    return { period, total: period.days * item.dailyPrice };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item.id !== 'string' || item.id.trim() === '') {
+        throw new TypeError('id must be a non-empty string');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new TypeError("kind must be 'board' or 'sail'");
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new RangeError('dailyPrice must be a non-negative integer number of euro cents');
+      }
+      if (equipment.has(item.id)) {
+        throw new Error(`Item already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      const { total } = price(request);
+      return { itemId: request.itemId, start: request.start, end: request.end, total };
+    },
+
+    book(request) {
+      const { period, total } = price(request);
+      const taken = bookings.some(
+        (b) => b.itemId === request.itemId && overlaps({ start: b.startMs, end: b.endMs }, period),
+      );
+      if (taken) {
+        throw new Error(`Item ${request.itemId} is not free for the whole period`);
+      }
+      const booking: Booking = {
+        id: `booking-${bookings.length + 1}`,
+        itemId: request.itemId,
+        start: request.start,
+        end: request.end,
+        total,
+      };
+      bookings.push({ ...booking, startMs: period.start, endMs: period.end });
+      return booking;
+    },
+  };
+}
