+
+test('rental by the hour: hourly price per hour, only for items that have one', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  s.addEquipment({ id: 'n1', kind: 'board', dailyPrice: 2500 });
+  const at = (h: number, day = 1) => `2027-06-${String(day).padStart(2, '0')}T${String(h).padStart(2, '0')}:00:00Z`;
+  assert.equal(s.quote({ itemId: 'h1', start: at(14), end: at(15) }).total, 600);
+  assert.equal(s.quote({ itemId: 'h1', start: at(13), end: at(17) }).total, 2400);
+  assert.equal(s.quote({ itemId: 'h1', start: at(22), end: at(3, 2) }).total, 3000);
+  assert.equal(s.quote({ itemId: 'h1', start: at(0), end: at(23) }).total, 13800);
+  assert.throws(() => s.quote({ itemId: 'n1', start: at(14), end: at(15) }));
+  assert.throws(() => s.book({ itemId: 'n1', start: at(14), end: at(15) }));
+  // not on the hour, a day or more off midnight, or reversed
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2027-06-01T14:30:00Z', end: at(16) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: at(10), end: at(10, 2) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: at(15), end: at(14) }));
+  // day rentals still use the daily price
+  assert.equal(s.quote({ itemId: 'h1', start: at(0), end: at(0, 2) }).total, 2500);
+  // hourly bookings conflict like any other
+  s.book({ itemId: 'h1', start: at(13), end: at(15) });
+  assert.throws(() => s.book({ itemId: 'h1', start: at(14), end: at(16) }));
+  assert.equal(s.book({ itemId: 'h1', start: at(15), end: at(16) }).total, 600);
+  assert.deepEqual(s.availability({ start: at(14), end: at(15) }), ['n1']);
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'y', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+});
