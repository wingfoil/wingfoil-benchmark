+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  /** Ids of the equipment free for the whole period, sorted. */
+  availability(query: AvailabilityQuery): string[];
 }
 
 const DAY_MS = 86_400_000;
@@ -46,7 +55,7 @@ function parseMidnightUtc(value: unknown, name: string): number {
 }
 
 /** Rule 3: a period covers one or more whole days. */
-function parsePeriod(request: RentalRequest): { start: number; end: number; days: number } {
+function parsePeriod(request: { start: string; end: string }): { start: number; end: number; days: number } {
   const start = parseMidnightUtc(request.start, 'start');
   const end = parseMidnightUtc(request.end, 'end');
   if (end <= start) {
@@ -113,5 +122,22 @@ export function createRentalService(): RentalService {
       bookings.push({ ...booking, startMs: period.start, endMs: period.end });
       return booking;
     },
+
+    availability(query) {
+      const period = parsePeriod(query);
+      if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+        throw new TypeError("kind must be 'board' or 'sail'");
+      }
+      return [...equipment.values()]
+        .filter((item) => query.kind === undefined || item.kind === query.kind)
+        .filter(
+          (item) =>
+            !bookings.some(
+              (b) => b.itemId === item.id && overlaps({ start: b.startMs, end: b.endMs }, period),
+            ),
+        )
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
