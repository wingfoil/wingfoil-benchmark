+
+test('availability lists the free equipment, sorted, optionally by kind', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 1 });
+  s.addEquipment({ id: 'b10', kind: 'board', dailyPrice: 1 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1 });
+  assert.deepEqual(s.availability({ start: D(1), end: D(4) }), ['b10', 'b2', 's1']);
+  assert.deepEqual(s.availability({ start: D(1), end: D(4), kind: 'board' }), ['b10', 'b2']);
+  assert.deepEqual(s.availability({ start: D(1), end: D(4), kind: 'sail' }), ['s1']);
+});
+
+test('availability leaves out items booked within the period, keeps back-to-back ones', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 });
+  s.book({ itemId: 'b1', start: D(1), end: D(4) });
+  assert.deepEqual(s.availability({ start: D(3), end: D(6) }), []);
+  assert.deepEqual(s.availability({ start: D(1), end: D(2) }), []);
+  assert.deepEqual(s.availability({ start: D(4), end: D(6) }), ['b1']);
+  assert.deepEqual(s.availability({ start: '2027-05-30T00:00:00Z', end: D(1) }), ['b1']);
+  const t = createRentalService();
+  t.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 });
+  t.book({ itemId: 'b1', start: D(3), end: D(4) });
+  assert.deepEqual(t.availability({ start: D(1), end: D(6) }), []);
+});
+
+test('availability is empty without matching equipment, and refuses bad queries', () => {
+  const s = desk();
+  assert.deepEqual(s.availability({ start: D(1), end: D(2), kind: 'sail' }), ['s1']);
+  assert.deepEqual(createRentalService().availability({ start: D(1), end: D(2) }), []);
+  assert.throws(() => s.availability({ start: D(2), end: D(2) }));
+  assert.throws(() => s.availability({ start: '2027-06-01T10:00:00Z', end: D(2) }));
+  assert.throws(() => s.availability({ start: D(1), end: D(2), kind: 'kite' as 'board' }));
+  s.book({ itemId: 'b1', start: D(1), end: D(2) });
+  assert.deepEqual(s.availability({ start: D(1), end: D(2), kind: 'board' }), []);
+  assert.equal(s.availability({ start: D(1), end: D(2) }) === s.availability({ start: D(1), end: D(2) }), false);
+});
