+/**
+ * The title, trimmed, or the reason it cannot be a title: it is empty, or longer than `MAX_TITLE_LENGTH`.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'the title is empty: give the task a title');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title has ${trimmed.length} characters; the most allowed is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority, or the reason it is not one: only the values of `PRIORITIES` are accepted.
+ *
+ * @param priority - the priority as given, which may not be a valid one when it comes from a screen
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  const known = PRIORITIES.find((candidate) => candidate === priority);
+  if (known === undefined) {
+    return err('invalid-input', `the priority "${priority}" is not one of ${PRIORITIES.join(', ')}`);
+  }
+  return ok(known);
+}
+
+/**
+ * The tag, or the reason it cannot be one: it is empty, or contains a space.
+ *
+ * @param tag - the tag as given
+ */
+export function validateTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'the tag is empty: give a tag of at least one character');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space; tags are single words`);
+  return ok(tag);
+}
+
