@@ -164,3 +164,58 @@ describe('task list', () => {
     assert.equal(new Date(task.createdAt).toISOString(), task.createdAt);
   });
 });
+
+describe('input validation', () => {
+  function rejected(result: { ok: boolean; error?: { code: string; message: string } }): string {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+    return result.error?.message ?? '';
+  }
+
+  it('rejects an empty or blank title when adding', () => {
+    const list = createTodoList();
+    assert.match(rejected(list.add({ title: '' })), /title is empty/);
+    assert.match(rejected(list.add({ title: '   ' })), /title is empty/);
+    assert.deepEqual(list.list(), []);
+  });
+
+  it('accepts a title of 120 characters and rejects one of 121', () => {
+    const list = createTodoList();
+    assert.equal(list.add({ title: 'a'.repeat(120) }).ok, true);
+    assert.match(rejected(list.add({ title: 'b'.repeat(121) })), /121 characters/);
+    assert.equal(list.list().length, 1);
+  });
+
+  it('rejects an unknown priority', () => {
+    const list = createTodoList();
+    const input = { title: 'Mow', priority: 'urgent' } as unknown as Parameters<typeof list.add>[0];
+    assert.match(rejected(list.add(input)), /"urgent"/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects an empty tag or one with a space when adding, and changes nothing', () => {
+    const list = createTodoList();
+    assert.match(rejected(list.add({ title: 'Mow', tags: ['ok', ''] })), /tag is empty/);
+    assert.match(rejected(list.add({ title: 'Mow', tags: ['two words'] })), /contains a space/);
+    assert.equal(list.list().length, 0);
+    assert.equal(valueOf(list.add({ title: 'Mow' })).id, 'task-1');
+  });
+
+  it('rejects an invalid new title when renaming, and keeps the task', () => {
+    const list = createTodoList();
+    list.add({ title: 'Mow' });
+    rejected(list.rename('Mow', '  '));
+    rejected(list.rename('Mow', 'x'.repeat(121)));
+    assert.deepEqual(list.list().map((task) => task.title), ['Mow']);
+    assert.equal(valueOf(list.rename('Mow', 'Mow the lawn')).title, 'Mow the lawn');
+  });
+
+  it('rejects an invalid tag when tagging, and keeps the task', () => {
+    const list = createTodoList();
+    const before = valueOf(list.add({ title: 'Mow' }));
+    rejected(list.tag('Mow', ''));
+    rejected(list.tag('Mow', 'a b'));
+    assert.deepEqual(valueOf(list.find('Mow')), before);
+    assert.deepEqual(valueOf(list.tag('Mow', 'garden')).tags, ['garden']);
+  });
+});
