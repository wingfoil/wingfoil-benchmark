diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3537aef41270045a9b52d56dab8d455825c9294f
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,32 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds every valid line, skipping blank ones', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\nBuy milk;;\r\nWalk the dog');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok);
+    assert.equal(milk.value.priority, 'normal');
+  });
+
+  it('rejects bad lines with their number and keeps importing', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const report = importTasks(list, 'Good\n;high;x\nBad priority;urgent;\nExisting;;\nToo;many;fields;here\nGood');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(
+      report.rejected.map((rejected) => rejected.line),
+      [2, 3, 4, 5, 6],
+    );
+    assert.ok(report.rejected.every((rejected) => rejected.reason !== ''));
+    assert.equal(list.list().length, 2);
+  });
+});
