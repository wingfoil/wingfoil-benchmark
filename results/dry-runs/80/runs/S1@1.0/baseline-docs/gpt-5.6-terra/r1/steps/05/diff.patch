@@ -47,6 +47,157 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
 
 type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
 
+/** An RFC 6902 operation produced or accepted by this package. */
+export type JsonPatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; path: string; from: string };
+
+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ *
+ * The patch changes individual object members and array elements wherever
+ * possible, instead of replacing an enclosing document. Neither input nor any
+ * value reachable from either input is mutated or shared with the patch.
+ *
+ * @param from The original JSON document.
+ * @param to The desired JSON document.
+ * @returns A JSON Patch that transforms `from` into `to`.
+ * @throws {TypeError} If either input is not valid JSON data.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const source = cloneJson(from);
+  const target = cloneJson(to);
+  const patch: JsonPatchOperation[] = [];
+  createPatchOperations(source, target, [], patch);
+  return patch;
+}
+
+function createPatchOperations(
+  from: JsonValue,
+  to: JsonValue,
+  path: string[],
+  patch: JsonPatchOperation[],
+): void {
+  if (jsonEqual(from, to)) return;
+
+  if (isPlainJsonObject(from) && isPlainJsonObject(to)) {
+    const fromObject = from as { [key: string]: JsonValue };
+    const toObject = to as { [key: string]: JsonValue };
+
+    for (const key of Object.keys(fromObject)) {
+      if (!Object.hasOwn(toObject, key)) patch.push({ op: "remove", path: formatPatchPath([...path, key]) });
+    }
+    for (const key of Object.keys(fromObject)) {
+      if (Object.hasOwn(toObject, key)) createPatchOperations(fromObject[key]!, toObject[key]!, [...path, key], patch);
+    }
+    for (const key of Object.keys(toObject)) {
+      if (!Object.hasOwn(fromObject, key)) {
+        patch.push({ op: "add", path: formatPatchPath([...path, key]), value: cloneJson(toObject[key]!) });
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatchOperations(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: "replace", path: formatPatchPath(path), value: cloneJson(to) });
+}
+
+function createArrayPatchOperations(
+  from: JsonValue[],
+  to: JsonValue[],
+  path: string[],
+  patch: JsonPatchOperation[],
+): void {
+  if (from.length === to.length) {
+    for (let index = 0; index < from.length; index += 1) {
+      createPatchOperations(from[index]!, to[index]!, [...path, String(index)], patch);
+    }
+    return;
+  }
+
+  const matches = longestCommonSubsequence(from, to);
+  const matchedFrom = new Set(matches.map(([fromIndex]) => fromIndex));
+  const matchedTo = new Set(matches.map(([, toIndex]) => toIndex));
+  const changedElements = alignChangedArrayElements(from, to, matches);
+
+  for (const [fromIndex, toIndex] of changedElements) {
+    matchedFrom.add(fromIndex);
+    matchedTo.add(toIndex);
+  }
+
+  for (let index = from.length - 1; index >= 0; index -= 1) {
+    if (!matchedFrom.has(index)) patch.push({ op: "remove", path: formatPatchPath([...path, String(index)]) });
+  }
+  for (let index = 0; index < to.length; index += 1) {
+    if (!matchedTo.has(index)) {
+      patch.push({ op: "add", path: formatPatchPath([...path, String(index)]), value: cloneJson(to[index]!) });
+    }
+  }
+  for (const [fromIndex, toIndex] of changedElements) {
+    createPatchOperations(from[fromIndex]!, to[toIndex]!, [...path, String(toIndex)], patch);
+  }
+}
+
+function alignChangedArrayElements(
+  from: JsonValue[],
+  to: JsonValue[],
+  matches: Array<[number, number]>,
+): Array<[number, number]> {
+  const changed: Array<[number, number]> = [];
+  let previousFrom = 0;
+  let previousTo = 0;
+
+  for (const [matchedFrom, matchedTo] of [...matches, [from.length, to.length] as [number, number]]) {
+    const sharedLength = Math.min(matchedFrom - previousFrom, matchedTo - previousTo);
+    for (let offset = 0; offset < sharedLength; offset += 1) {
+      const fromIndex = previousFrom + offset;
+      const toIndex = previousTo + offset;
+      if (!jsonEqual(from[fromIndex]!, to[toIndex]!)) changed.push([fromIndex, toIndex]);
+    }
+    previousFrom = matchedFrom + 1;
+    previousTo = matchedTo + 1;
+  }
+
+  return changed;
+}
+
+function longestCommonSubsequence(from: JsonValue[], to: JsonValue[]): Array<[number, number]> {
+  const lengths = Array.from({ length: from.length + 1 }, () => Array<number>(to.length + 1).fill(0));
+
+  for (let fromIndex = from.length - 1; fromIndex >= 0; fromIndex -= 1) {
+    for (let toIndex = to.length - 1; toIndex >= 0; toIndex -= 1) {
+      lengths[fromIndex]![toIndex] = jsonEqual(from[fromIndex]!, to[toIndex]!)
+        ? lengths[fromIndex + 1]![toIndex + 1]! + 1
+        : Math.max(lengths[fromIndex + 1]![toIndex]!, lengths[fromIndex]![toIndex + 1]!);
+    }
+  }
+
+  const matches: Array<[number, number]> = [];
+  let fromIndex = 0;
+  let toIndex = 0;
+  while (fromIndex < from.length && toIndex < to.length) {
+    if (jsonEqual(from[fromIndex]!, to[toIndex]!)) {
+      matches.push([fromIndex, toIndex]);
+      fromIndex += 1;
+      toIndex += 1;
+    } else if (lengths[fromIndex + 1]![toIndex]! >= lengths[fromIndex]![toIndex + 1]!) {
+      fromIndex += 1;
+    } else {
+      toIndex += 1;
+    }
+  }
+  return matches;
+}
+
+function formatPatchPath(tokens: string[]): string {
+  return tokens.length === 0 ? "" : `/${tokens.map((token) => token.replace(/~/g, "~0").replace(/\//g, "~1")).join("/")}`;
+}
