 import assert from "node:assert/strict";
 import test from "node:test";
 
-import { applyPatch } from "../src/index.ts";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+test("creates a minimal patch for nested JSON changes without mutating either input", () => {
+  const from = {
+    retained: { enabled: true, retries: 2 },
+    "a/b": "old",
+    obsolete: true,
+  };
+  const to = {
+    retained: { enabled: true, retries: 3 },
+    "a/b": "new",
+    added: { timeout: 500 },
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/obsolete" },
+    { op: "replace", path: "/retained/retries", value: 3 },
+    { op: "replace", path: "/a~1b", value: "new" },
+    { op: "add", path: "/added", value: { timeout: 500 } },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, { retained: { enabled: true, retries: 2 }, "a/b": "old", obsolete: true });
+  assert.deepEqual(to, { retained: { enabled: true, retries: 3 }, "a/b": "new", added: { timeout: 500 } });
+});
+
+test("creates compact array edits and root replacements", () => {
+  assert.deepEqual(createPatch(["a", "b"], ["a", "new", "b"]), [
+    { op: "add", path: "/1", value: "new" },
+  ]);
+  assert.deepEqual(createPatch(["a", "b", "c"], ["a", "c"]), [
+    { op: "remove", path: "/1" },
+  ]);
+  assert.deepEqual(createPatch({ nested: { before: 1, unchanged: true } }, { nested: { before: 2, unchanged: true } }), [
+    { op: "replace", path: "/nested/before", value: 2 },
+  ]);
+  assert.deepEqual(createPatch({ value: true }, [1, 2]), [{ op: "replace", path: "", value: [1, 2] }]);
+  assert.deepEqual(createPatch({ value: true }, { value: true }), []);
+});
+
+test("keeps nested array changes targeted when the array length also changes", () => {
+  const from = { services: [{ name: "api", retries: 2 }, { name: "worker" }] };
+  const to = { services: [{ name: "api", retries: 3 }, { name: "cron" }, { name: "worker" }] };
+
+  assert.deepEqual(createPatch(from, to), [
+    { op: "add", path: "/services/1", value: { name: "cron" } },
+    { op: "replace", path: "/services/0/retries", value: 3 },
+  ]);
+});
+
+test("rejects non-JSON values when creating a patch", () => {
+  assert.throws(() => createPatch({ value: 1 }, { value: Number.NaN }), /JSON/i);
+  assert.throws(() => createPatch({}, new Date()), /JSON/i);
+});
 
