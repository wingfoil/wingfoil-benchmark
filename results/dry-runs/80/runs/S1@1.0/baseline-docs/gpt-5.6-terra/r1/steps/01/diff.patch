diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..451f7c60019c1afaa864a55b39f505f5b623b6de
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,58 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @param document The JSON document to search.
+ * @param pointer An RFC 6901 JSON Pointer.
+ * @returns The value identified by the pointer.
+ * @throws {TypeError} If `pointer` is not a valid JSON Pointer.
+ * @throws {Error} If the pointer does not identify a value in `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string" || (pointer !== "" && !pointer.startsWith("/"))) {
+    throw new TypeError("Pointer is not a valid JSON Pointer");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+
+  let value = document;
+
+  for (const token of pointer.slice(1).split("/")) {
+    const referenceToken = decodeReferenceToken(token);
+
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(referenceToken)) {
+        throw new Error("Pointer does not resolve to a value in the document");
+      }
+
+      const index = Number(referenceToken);
+      if (index >= value.length) {
+        throw new Error("Pointer does not resolve to a value in the document");
+      }
+
+      value = value[index];
+      continue;
+    }
+
+    if (value === null || typeof value !== "object" || !Object.hasOwn(value, referenceToken)) {
+      throw new Error("Pointer does not resolve to a value in the document");
+    }
+
+    value = (value as Record<string, unknown>)[referenceToken];
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  if (/~(?:[^01]|$)/.test(token)) {
+    throw new TypeError("Pointer is not a valid JSON Pointer");
+  }
+
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function isArrayIndex(token: string): boolean {
+  return /^(?:0|[1-9][0-9]*)$/.test(token) && Number.isSafeInteger(Number(token));
+}
diff --git a/test/json-pointer.test.ts b/test/json-pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1c7b9018898fa5e93384b30d9a2177c94fb62003
--- /dev/null
+++ b/test/json-pointer.test.ts
@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { resolvePointer } from "../src/index.ts";
+
+const document = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+  values: [null, false, 0, ""],
+};
+
+test("resolves the RFC 6901 examples", () => {
+  assert.equal(resolvePointer(document, ""), document);
+  assert.equal(resolvePointer(document, "/foo"), document.foo);
+  assert.equal(resolvePointer(document, "/foo/0"), "bar");
+  assert.equal(resolvePointer(document, "/"), 0);
+  assert.equal(resolvePointer(document, "/a~1b"), 1);
+  assert.equal(resolvePointer(document, "/c%d"), 2);
+  assert.equal(resolvePointer(document, "/e^f"), 3);
+  assert.equal(resolvePointer(document, "/g|h"), 4);
+  assert.equal(resolvePointer(document, "/i\\j"), 5);
+  assert.equal(resolvePointer(document, '/k"l'), 6);
+  assert.equal(resolvePointer(document, "/ "), 7);
+  assert.equal(resolvePointer(document, "/m~0n"), 8);
+});
+
+test("resolves JSON values that are falsy", () => {
+  assert.equal(resolvePointer(document, "/values/0"), null);
+  assert.equal(resolvePointer(document, "/values/1"), false);
+  assert.equal(resolvePointer(document, "/values/2"), 0);
+  assert.equal(resolvePointer(document, "/values/3"), "");
+});
+
+test("rejects malformed JSON Pointers", () => {
+  for (const pointer of ["foo", "~", "/bad~", "/bad~2"]) {
+    assert.throws(() => resolvePointer(document, pointer), /valid JSON Pointer/i);
+  }
+});
+
+test("rejects unresolvable paths", () => {
+  for (const pointer of ["/missing", "/foo/2", "/foo/-", "/foo/01", "/foo/1.0"]) {
+    assert.throws(() => resolvePointer(document, pointer), /does not resolve/i);
+  }
+});
+
+test("does not resolve inherited object properties", () => {
+  assert.throws(() => resolvePointer({}, "/toString"), /does not resolve/i);
+});
