 ```
 
 Invalid operation objects, invalid JSON Pointers, unresolvable paths (including removal of the document root), and failed `test` operations throw an error. Operations are evaluated in order and stop at the first error; the supplied document is never changed.
+
+## JSON Merge Patch
+
+`applyMergePatch(target, patch)` applies an [RFC 7386 JSON Merge Patch](https://www.rfc-editor.org/rfc/rfc7386)
+and returns a new document. Object-valued patches merge recursively; a `null` member deletes that member, while any other patch value replaces its target. Neither input is mutated.
+
+```ts
+import { applyMergePatch } from "json-toolkit";
+
+const updated = applyMergePatch(
+  { service: { host: "api.example.test", retries: 3 } },
+  { service: { retries: null, timeout: 5_000 } },
+); // { service: { host: "api.example.test", timeout: 5_000 } }
+```
diff --git a/src/index.ts b/src/index.ts
index 7a53d374d7b4503242d544dbc310b28f4face39b..e333f973910c089593c788424c39b6349e4272f1 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -47,6 +47,43 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
 
 type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
 
+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document.
+ *
+ * Object-valued patches merge their members recursively. A `null` member
+ * deletes that member; any other patch value replaces the target entirely.
+ * Neither input nor any value reachable from either input is shared with the
+ * returned document.
+ *
+ * @param target The JSON document to update.
+ * @param patch An RFC 7386 JSON Merge Patch document.
+ * @returns The merged JSON document.
+ * @throws {TypeError} If `target` or `patch` is not valid JSON data.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return applyMergePatchValue(cloneJson(target), cloneJson(patch));
+}
+
+function applyMergePatchValue(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isPlainJsonObject(patch)) return cloneJson(patch);
+
+  const result: { [key: string]: JsonValue } = isPlainJsonObject(target) ? target : {};
+  const patchObject = patch as { [key: string]: JsonValue };
+
+  for (const key of Object.keys(patchObject)) {
+    const patchValue = patchObject[key]!;
+    if (patchValue === null) {
+      delete result[key];
+      continue;
+    }
+
+    const targetValue = Object.hasOwn(result, key) ? result[key]! : null;
+    setJsonMember(result, key, applyMergePatchValue(targetValue, patchValue));
+  }
+
+  return result;
+}
+
