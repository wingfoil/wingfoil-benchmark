new file mode 100644
index 0000000000000000000000000000000000000000..db795f6c9f8b780b23547920cb777275d7af6e25
--- /dev/null
+++ b/test/json-merge-patch.test.ts
@@ -0,0 +1,47 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyMergePatch } from "../src/index.ts";
+
+test("applies the RFC 7386 merge-patch examples", () => {
+  for (const { target, patch, expected } of [
+    { target: { a: "b" }, patch: { a: "c" }, expected: { a: "c" } },
+    { target: { a: "b" }, patch: { b: "c" }, expected: { a: "b", b: "c" } },
+    { target: { a: "b" }, patch: { a: null }, expected: {} },
+    { target: { a: "b", b: "c" }, patch: { a: null }, expected: { b: "c" } },
+    { target: { a: ["b"] }, patch: { a: "c" }, expected: { a: "c" } },
+    { target: { a: "c" }, patch: { a: ["b"] }, expected: { a: ["b"] } },
+    { target: { a: { b: "c" } }, patch: { a: { b: "d", c: null } }, expected: { a: { b: "d" } } },
+    { target: { a: [{ b: "c" }] }, patch: { a: [1] }, expected: { a: [1] } },
+    { target: ["a", "b"], patch: ["c", "d"], expected: ["c", "d"] },
+    { target: { a: "foo" }, patch: null, expected: null },
+    { target: { a: "foo" }, patch: "bar", expected: "bar" },
+    { target: { e: null }, patch: { a: 1 }, expected: { e: null, a: 1 } },
+    { target: [1, 2], patch: { a: "b", c: null }, expected: { a: "b" } },
+    { target: {}, patch: { a: { bb: { ccc: null } } }, expected: { a: { bb: {} } } },
+  ]) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("does not mutate or share objects from either input", () => {
+  const target = { retained: { value: 1 }, removed: true };
+  const patch = { retained: { added: [2] }, replacement: { value: 3 }, removed: null };
+
+  const result = applyMergePatch(target, patch) as {
+    retained: { value: number; added: number[] };
+    replacement: { value: number };
+  };
+  result.retained.value = 9;
+  result.retained.added.push(4);
+  result.replacement.value = 5;
+
+  assert.deepEqual(target, { retained: { value: 1 }, removed: true });
+  assert.deepEqual(patch, { retained: { added: [2] }, replacement: { value: 3 }, removed: null });
+});
+
+test("rejects non-JSON targets and patches", () => {
+  assert.throws(() => applyMergePatch({ value: 1 }, { value: Number.NaN }), /JSON/i);
+  assert.throws(() => applyMergePatch(new Date(), {}), /JSON/i);
+  assert.throws(() => applyMergePatch({}, new Array(1)), /JSON/i);
+});
