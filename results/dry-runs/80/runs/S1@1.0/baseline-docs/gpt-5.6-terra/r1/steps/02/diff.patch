index 0000000000000000000000000000000000000000..c2858c309920e978dc59fd5d70d702f692c88901
--- /dev/null
+++ b/test/json-patch.test.ts
@@ -0,0 +1,61 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { applyPatch } from "../src/index.ts";
+
+test("applies all RFC 6902 operations without mutating the input", () => {
+  const document = {
+    foo: ["bar", "baz"],
+    object: { nested: true },
+  };
+  const patch = [
+    { op: "add", path: "/foo/1", value: "qux" },
+    { op: "remove", path: "/foo/0" },
+    { op: "replace", path: "/foo/1", value: "boo" },
+    { op: "copy", from: "/object", path: "/copied" },
+    { op: "move", from: "/foo/0", path: "/foo/-" },
+    { op: "test", path: "/object/nested", value: true },
+  ];
+
+  const result = applyPatch(document, patch);
+
+  assert.deepEqual(result, {
+    foo: ["boo", "baz", "qux"],
+    object: { nested: true },
+    copied: { nested: true },
+  });
+  assert.deepEqual(document, { foo: ["bar", "baz"], object: { nested: true } });
+  assert.notEqual(result, document);
+  assert.notEqual((result as { copied: object }).copied, document.object);
+});
+
+test("supports root replacement and escaped pointer tokens", () => {
+  assert.deepEqual(applyPatch({ "a/b": 1 }, [{ op: "replace", path: "/a~1b", value: 2 }]), {
+    "a/b": 2,
+  });
+  assert.deepEqual(applyPatch({ old: true }, [{ op: "add", path: "", value: [1, 2] }]), [1, 2]);
+});
+
+test("rejects invalid patches and failed operations", () => {
+  const document = { array: [1], value: 1 };
+
+  for (const patch of [
+    {} as unknown,
+    [{ op: "unknown", path: "/value" }],
+    [{ op: "add", path: "/array/01", value: 2 }],
+    [{ op: "remove", path: "/missing" }],
+    [{ op: "replace", path: "/missing", value: 2 }],
+    [{ op: "move", from: "/array", path: "/array/child" }],
+    [{ op: "test", path: "/value", value: 2 }],
+  ]) {
+    assert.throws(() => applyPatch(document, patch), /patch|path|operation|test|child/i);
+  }
+});
+
+test("does not share patch values with the result", () => {
+  const value = { nested: [1] };
+  const result = applyPatch({}, [{ op: "add", path: "/value", value }]) as { value: typeof value };
+
+  result.value.nested.push(2);
+  assert.deepEqual(value, { nested: [1] });
+});
