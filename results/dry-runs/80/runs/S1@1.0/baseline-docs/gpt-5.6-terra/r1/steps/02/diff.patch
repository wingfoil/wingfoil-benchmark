+type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
+
+/**
+ * Applies an RFC 6902 JSON Patch to a JSON document.
+ *
+ * The source document and values supplied by the patch are never mutated or
+ * shared with the result.
+ *
+ * @param document The JSON document to update.
+ * @param patch An array of RFC 6902 operation objects.
+ * @returns The patched JSON document.
+ * @throws {TypeError} If the document or patch is not valid JSON data/JSON Patch.
+ * @throws {Error} If an operation cannot be applied or a `test` fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new TypeError("Patch must be an array of operations");
+  }
+
+  let result: JsonValue | undefined = cloneJson(document);
+  let exists = true;
+
+  for (const operation of patch) {
+    const parsed = parseOperation(operation);
+
+    switch (parsed.op) {
+      case "add":
+        result = addValue(result, exists, parsed.path, parsed.value);
+        exists = true;
+        break;
+      case "remove": {
+        const removed = removeValue(result, exists, parsed.path);
+        result = removed.value;
+        exists = removed.exists;
+        break;
+      }
+      case "replace":
+        ensureValueExists(result, exists, parsed.path);
+        result = addValue(result, exists, parsed.path, parsed.value);
+        break;
+      case "copy":
+        result = addValue(result, exists, parsed.path, cloneJson(getValue(result, exists, parsed.from)));
+        exists = true;
+        break;
+      case "move": {
+        if (isDescendantPath(parsed.from, parsed.path)) {
+          throw new Error("Cannot move a value into one of its children");
+        }
+        const moved = cloneJson(getValue(result, exists, parsed.from));
+        const removed = removeValue(result, exists, parsed.from);
+        result = addValue(removed.value, removed.exists, parsed.path, moved);
+        exists = true;
+        break;
+      }
+      case "test":
+        if (!jsonEqual(getValue(result, exists, parsed.path), parsed.value)) {
+          throw new Error("JSON Patch test operation failed");
+        }
+        break;
+    }
+  }
+
+  return result;
+}
+
+function parseOperation(value: unknown):
+  | { op: "add" | "replace" | "test"; path: string[]; value: JsonValue }
+  | { op: "remove"; path: string[] }
+  | { op: "move" | "copy"; path: string[]; from: string[] } {
+  if (!isJsonObject(value) || typeof value.op !== "string" || !Object.hasOwn(value, "op")) {
+    throw new TypeError("Patch operation must be an object with an op member");
+  }
+  if (typeof value.path !== "string" || !Object.hasOwn(value, "path")) {
+    throw new TypeError("Patch operation must have a string path");
+  }
+
+  const path = parsePatchPath(value.path);
+  if (value.op === "remove") return { op: "remove", path };
+
+  if (value.op === "move" || value.op === "copy") {
+    if (typeof value.from !== "string" || !Object.hasOwn(value, "from")) {
+      throw new TypeError("Move and copy operations must have a string from path");
+    }
+    return { op: value.op, path, from: parsePatchPath(value.from) };
+  }
+
+  if (value.op === "add" || value.op === "replace" || value.op === "test") {
+    if (!Object.hasOwn(value, "value")) {
+      throw new TypeError(`${value.op} operation must have a value member`);
+    }
+    return { op: value.op, path, value: cloneJson(value.value) };
+  }
+
+  throw new TypeError("Patch operation is not supported");
+}
+
+function parsePatchPath(pointer: string): string[] {
+  if (pointer !== "" && !pointer.startsWith("/")) {
+    throw new TypeError("Patch path is not a valid JSON Pointer");
+  }
+  return pointer === "" ? [] : pointer.slice(1).split("/").map(decodeReferenceToken);
+}
+
+function getValue(document: JsonValue | undefined, exists: boolean, path: string[]): JsonValue {
+  if (!exists) throw new Error("Patch path does not identify a value");
+  let value = document as JsonValue;
+  for (const token of path) {
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(token) || Number(token) >= value.length) throw new Error("Patch path does not identify a value");
+      value = value[Number(token)]!;
+    } else if (isJsonObject(value) && Object.hasOwn(value, token)) {
+      value = value[token]!;
+    } else {
+      throw new Error("Patch path does not identify a value");
+    }
+  }
+  return value;
+}
+
+function ensureValueExists(document: JsonValue | undefined, exists: boolean, path: string[]): void {
+  getValue(document, exists, path);
+}
+
+function addValue(document: JsonValue | undefined, exists: boolean, path: string[], value: JsonValue): JsonValue {
+  if (path.length === 0) return cloneJson(value);
+  const parent = getValue(document, exists, path.slice(0, -1));
+  const token = path[path.length - 1]!;
+  if (Array.isArray(parent)) {
+    const index = token === "-" ? parent.length : arrayInsertionIndex(token, parent.length);
+    parent.splice(index, 0, cloneJson(value));
+  } else if (isJsonObject(parent)) {
+    setJsonMember(parent, token, cloneJson(value));
+  } else {
+    throw new Error("Patch path parent is not a container");
+  }
+  return document as JsonValue;
+}
+
+function removeValue(document: JsonValue | undefined, exists: boolean, path: string[]): { value: JsonValue | undefined; exists: boolean } {
+  if (path.length === 0) {
+    if (!exists) throw new Error("Patch path does not identify a value");
+    return { value: undefined, exists: false };
+  }
+  const parent = getValue(document, exists, path.slice(0, -1));
+  const token = path[path.length - 1]!;
+  if (Array.isArray(parent)) {
+    if (!isArrayIndex(token) || Number(token) >= parent.length) throw new Error("Patch path does not identify a value");
+    parent.splice(Number(token), 1);
+  } else if (isJsonObject(parent) && Object.hasOwn(parent, token)) {
+    delete parent[token];
+  } else {
+    throw new Error("Patch path does not identify a value");
+  }
+  return { value: document, exists };
+}
+
+function arrayInsertionIndex(token: string, length: number): number {
+  if (!isArrayIndex(token) || Number(token) > length) throw new Error("Patch path is not a valid array insertion point");
+  return Number(token);
+}
+
+function isDescendantPath(from: string[], path: string[]): boolean {
+  return path.length > from.length && from.every((token, index) => path[index] === token);
+}
+
+function cloneJson(value: unknown, ancestors = new Set<object>()): JsonValue {
+  if (value === null || typeof value === "string" || typeof value === "boolean") return value;
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) throw new TypeError("JSON values must contain finite numbers");
+    return value;
+  }
+  if (!isJsonObject(value)) throw new TypeError("Value is not valid JSON data");
+  if (ancestors.has(value)) throw new TypeError("JSON values cannot contain cycles");
+  ancestors.add(value);
+  const clone: JsonValue = Array.isArray(value) ? value.map((item) => cloneJson(item, ancestors)) : {};
+  if (!Array.isArray(value)) {
+    for (const key of Object.keys(value)) setJsonMember(clone as { [key: string]: JsonValue }, key, cloneJson(value[key], ancestors));
+  }
+  ancestors.delete(value);
+  return clone;
+}
+
+function isJsonObject(value: unknown): value is { [key: string]: unknown } {
+  if (value === null || typeof value !== "object") return false;
+  const prototype = Object.getPrototypeOf(value);
+  return Array.isArray(value) || prototype === Object.prototype || prototype === null;
+}
+
+function setJsonMember(object: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function jsonEqual(left: JsonValue, right: JsonValue): boolean {
+  if (typeof left !== "object" || left === null || typeof right !== "object" || right === null) return left === right;
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return Array.isArray(left) && Array.isArray(right) && left.length === right.length && left.every((value, index) => jsonEqual(value, right[index]!));
+  }
+  const leftKeys = Object.keys(left);
+  const rightKeys = Object.keys(right);
+  return leftKeys.length === rightKeys.length && leftKeys.every((key) => Object.hasOwn(right, key) && jsonEqual(left[key]!, right[key]!));
+}
+
 function decodeReferenceToken(token: string): string {
   if (/~(?:[^01]|$)/.test(token)) {
     throw new TypeError("Pointer is not a valid JSON Pointer");
diff --git a/test/json-patch.test.ts b/test/json-patch.test.ts
