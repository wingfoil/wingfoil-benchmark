--- a/README.md
+++ b/README.md
@@ -17,3 +17,20 @@ import { resolvePointer } from "json-toolkit";
 const document = { services: [{ name: "api" }] };
 const name = resolvePointer(document, "/services/0/name"); // "api"
 ```
+
+## JSON Patch
+
+`applyPatch(document, patch)` applies an [RFC 6902 JSON Patch](https://www.rfc-editor.org/rfc/rfc6902)
+and returns a new document. It supports `add`, `remove`, `replace`, `move`, `copy`, and `test` operations.
+Neither the source document nor patch values are mutated.
+
+```ts
+import { applyPatch } from "json-toolkit";
+
+const updated = applyPatch(
+  { services: ["web"] },
+  [{ op: "add", path: "/services/-", value: "worker" }],
+); // { services: ["web", "worker"] }
+```
+
+Invalid operation objects, invalid JSON Pointers, unresolvable paths, and failed `test` operations throw an error.
