+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** The cost of one rental day, in integer euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  /** UTC midnight in ISO-8601 form. */
+  start: string;
+  /** UTC midnight after the final rental day, in ISO-8601 form. */
+  end: string;
+}
+
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+export interface RentalBooking extends RentalQuote {
+  id: string;
+}
+
+export interface RentalService {
+  /** Adds a board or sail. Prices are integer euro cents per day. */
+  addEquipment(item: Equipment): void;
+  /** Returns the price for a valid whole-day UTC rental period. */
+  quote(request: RentalRequest): RentalQuote;
+  /** Books a free item for a valid whole-day UTC rental period. */
+  book(request: RentalRequest): RentalBooking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+function parseUtcMidnight(value: string, field: string): number {
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}T00:00(?::00(?:\.\d{1,3})?)?(?:Z|\+00:00)$/.test(value)) {
+    throw new Error(`${field} must be a UTC midnight ISO-8601 timestamp`);
+  }
+
+  const timestamp = Date.parse(value);
+  if (!Number.isFinite(timestamp)) {
+    throw new Error(`${field} must be a valid timestamp`);
+  }
+
+  const date = new Date(timestamp);
+  if (date.toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${field} must be a valid calendar date`);
+  }
+  if (date.getUTCHours() !== 0 || date.getUTCMinutes() !== 0 || date.getUTCSeconds() !== 0 || date.getUTCMilliseconds() !== 0) {
+    throw new Error(`${field} must be midnight UTC`);
+  }
+  return timestamp;
+}
+
+/** Creates an in-memory service for equipment, quotes, and whole-day bookings. */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: RentalBooking[] = [];
+  let nextBookingId = 1;
+
+  function quote(request: RentalRequest): RentalQuote {
+    if (!request || typeof request.itemId !== 'string') {
+      throw new Error('A valid itemId is required');
+    }
+    const item = equipment.get(request.itemId);
+    if (!item) throw new Error(`Unknown equipment item: ${request.itemId}`);
+
+    const start = parseUtcMidnight(request.start, 'start');
+    const end = parseUtcMidnight(request.end, 'end');
+    if (end <= start) throw new Error('Rental end must be after start');
+
+    const days = (end - start) / DAY_MS;
+    const total = days * item.dailyPrice;
+    if (!Number.isSafeInteger(total)) throw new Error('Rental total exceeds the safe integer range');
+    return { itemId: request.itemId, start: request.start, end: request.end, total };
+  }
+
+  return {
+    addEquipment(item: Equipment): void {
+      if (!item || typeof item.id !== 'string') throw new Error('Equipment id must be a string');
+      if (item.kind !== 'board' && item.kind !== 'sail') throw new Error('Equipment kind must be board or sail');
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('Daily price must be a non-negative integer number of euro cents');
+      }
+      if (equipment.has(item.id)) throw new Error(`Equipment item already exists: ${item.id}`);
+      equipment.set(item.id, { ...item });
+    },
+
+    quote,
+
+    book(request: RentalRequest): RentalBooking {
+      const price = quote(request);
+      const start = Date.parse(price.start);
+      const end = Date.parse(price.end);
+      if (bookings.some((booking) => booking.itemId === price.itemId &&
+        start < Date.parse(booking.end) && Date.parse(booking.start) < end)) {
+        throw new Error(`Equipment item is already booked for part of this period: ${price.itemId}`);
+      }
+      const booking: RentalBooking = { id: String(nextBookingId++), ...price };
+      bookings.push(booking);
+      return { ...booking };
+    },
+  };
+}
