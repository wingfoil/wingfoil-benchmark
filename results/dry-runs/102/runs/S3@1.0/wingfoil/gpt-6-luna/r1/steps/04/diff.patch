+function parseRentalPeriod(startValue: string, endValue: string): { start: number; end: number; hourly: boolean } {
+  const startTimestamp = Date.parse(startValue);
+  const endTimestamp = Date.parse(endValue);
+  if (!Number.isFinite(startTimestamp) || !Number.isFinite(endTimestamp) || endTimestamp <= startTimestamp) {
+    throw new Error('Rental end must be after start');
+  }
+  if (endTimestamp - startTimestamp < DAY_MS) {
+    const start = parseUtcHour(startValue, 'start');
+    const end = parseUtcHour(endValue, 'end');
+    if (end - start >= DAY_MS) throw new Error('Hourly rental must be shorter than one day');
+    return { start, end, hourly: true };
+  }
+  const start = parseUtcMidnight(startValue, 'start');
+  const end = parseUtcMidnight(endValue, 'end');
+  return { start, end, hourly: false };
+}
