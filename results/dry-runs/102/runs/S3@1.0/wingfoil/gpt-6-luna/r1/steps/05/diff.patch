diff --git a/test/cancellation.test.mjs b/test/cancellation.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c9ec8fea11f8503378f77d0aded8e4bfce6a53ef
--- /dev/null
+++ b/test/cancellation.test.mjs
@@ -0,0 +1,50 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+const period = {
+  itemId: 'board-1',
+  start: '2026-06-10T00:00:00Z',
+  end: '2026-06-11T00:00:00Z',
+};
+
+function serviceWithBooking() {
+  const service = createRentalService();
+  service.addEquipment({ id: period.itemId, kind: 'board', dailyPrice: 4200 });
+  const booking = service.book(period);
+  return { service, booking };
+}
+
+test('cancelling at least 24 hours before start gives a full refund and releases equipment', () => {
+  const { service, booking } = serviceWithBooking();
+
+  assert.deepEqual(service.cancel(booking.id, '2026-06-09T00:00:00Z'), {
+    bookingId: booking.id,
+    refund: booking.total,
+  });
+  assert.deepEqual(service.availability(period), [period.itemId]);
+  assert.equal(service.book(period).itemId, period.itemId);
+});
+
+test('cancelling less than 24 hours before start gives no refund', () => {
+  const { service, booking } = serviceWithBooking();
+
+  assert.deepEqual(service.cancel(booking.id, '2026-06-09T00:00:01Z'), {
+    bookingId: booking.id,
+    refund: 0,
+  });
+});
+
+test('a booking cannot be cancelled more than once', () => {
+  const { service, booking } = serviceWithBooking();
+  service.cancel(booking.id, '2026-06-09T00:00:00Z');
+
+  assert.throws(() => service.cancel(booking.id, '2026-06-09T00:00:00Z'), /already been cancelled/);
+});
+
+test('cancelling an unknown booking or with an invalid time fails', () => {
+  const { service } = serviceWithBooking();
+
+  assert.throws(() => service.cancel('missing', '2026-06-09T00:00:00Z'), /Unknown booking/);
+  assert.throws(() => service.cancel('1', 'not-a-time'), /valid timestamp/);
+});
