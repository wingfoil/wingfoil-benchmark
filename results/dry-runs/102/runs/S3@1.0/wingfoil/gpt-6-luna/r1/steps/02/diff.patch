+    availability(query: AvailabilityQuery): string[] {
+      if (!query || typeof query !== 'object') throw new Error('A valid availability query is required');
+      if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+        throw new Error('Equipment kind must be board or sail');
+      }
+
+      const start = parseUtcMidnight(query.start, 'start');
+      const end = parseUtcMidnight(query.end, 'end');
+      if (end <= start) throw new Error('Rental end must be after start');
+
+      return [...equipment.values()]
+        .filter((item) => query.kind === undefined || item.kind === query.kind)
+        .filter((item) => !bookings.some((booking) => booking.itemId === item.id &&
+          start < Date.parse(booking.end) && Date.parse(booking.start) < end))
+        .map((item) => item.id)
+        .sort();
+    },
   };
