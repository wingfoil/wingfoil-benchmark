+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** The least items an order needs for WELCOME5 to apply: 30.00 €. */
+const WELCOME5_MIN_ITEMS_CENTS: Cents = 3000;
+
+/** What WELCOME5 takes off an order: 5.00 €. */
+const WELCOME5_CENTS: Cents = 500;
+
+/** `percent` of an amount in cents, rounded to the nearest cent with a half cent rounding up. */
+function percentOf(cents: Cents, percent: number): Cents {
+  return Math.floor((cents * percent + 50) / 100);
+}
+
+/**
+ * What a discount code takes off an order's items.
+ *
+ * @param code - the code the customer gave
+ * @param itemsCents - the order's items, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  if (code === 'SPRING10') return ok(percentOf(itemsCents, 10));
+  if (code === 'WELCOME5') {
+    if (itemsCents < WELCOME5_MIN_ITEMS_CENTS) {
+      return err(
+        'invalid',
+        `WELCOME5 needs items of ${formatEuros(WELCOME5_MIN_ITEMS_CENTS)} € or more; these come to ${formatEuros(itemsCents)} €`,
+      );
+    }
+    return ok(WELCOME5_CENTS);
+  }
+  return err('not-found', `no discount code ${code}`);
+}
