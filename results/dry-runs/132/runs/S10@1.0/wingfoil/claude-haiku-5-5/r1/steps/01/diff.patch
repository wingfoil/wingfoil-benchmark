+describe('discount codes', () => {
+  function placed(shop: ReturnType<typeof stocked>, sku: string, quantity = 1): number {
+    return valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-04', lines: [{ sku, quantity }] })).number;
+  }
+
+  it('shows no discount without a code', () => {
+    const shop = stocked();
+    const number = placed(shop, 'OIL-1L');
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 1290, discountCents: 0, shippingCents: 490, totalCents: 1780 });
+  });
+
+  it('takes 10 % of the items with SPRING10 and leaves shipping alone', () => {
+    const shop = stocked();
+    const number = placed(shop, 'OIL-1L');
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 1290, discountCents: 129, shippingCents: 490, totalCents: 1651 });
+  });
+
+  it('rounds the SPRING10 discount half a cent upwards', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'PEA-1', name: 'Peas', priceCents: 345 }));
+    const number = placed(shop, 'PEA-1');
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 35);
+  });
+
+  it('applies SPRING10 to the quantities ordered', () => {
+    const shop = stocked();
+    const number = placed(shop, 'APL-1KG', 2);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 70);
+  });
+
+  it('decides free shipping on the items before the discount', () => {
+    const shop = stocked();
+    const number = placed(shop, 'HAM-W');
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 6400, discountCents: 640, shippingCents: 0, totalCents: 5760 });
+  });
+
+  it('takes 5.00 € off with WELCOME5 on an order of 30.00 € or more', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'BOX-30', name: 'Welcome box', priceCents: 3000 }));
+    const number = placed(shop, 'BOX-30');
+    valueOf(shop.orders.applyCode(number, 'WELCOME5'));
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 3000, discountCents: 500, shippingCents: 490, totalCents: 2990 });
+  });
+
+  it('refuses WELCOME5 on a smaller order and leaves the order as it was', () => {
+    const shop = stocked();
+    const number = placed(shop, 'OIL-1L');
+    const refused = shop.orders.applyCode(number, 'WELCOME5');
+    assert.equal(refused.ok, false);
+    if (refused.ok) return;
+    assert.equal(refused.error.code, 'invalid');
+    assert.match(refused.error.message, /30\.00/);
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 0);
+  });
+
+  it('refuses an unknown code and leaves the order as it was', () => {
+    const shop = stocked();
+    const number = placed(shop, 'OIL-1L');
+    const refused = shop.orders.applyCode(number, 'SUMMER');
+    assert.equal(refused.ok, false);
+    if (refused.ok) return;
+    assert.equal(refused.error.code, 'not-found');
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 0);
+  });
+
+  it('refuses a code on an order that does not exist', () => {
+    const shop = stocked();
+    assert.equal(shop.orders.applyCode(7, 'SPRING10').ok, false);
+  });
+
+  it('replaces the code an order has with a second one', () => {
