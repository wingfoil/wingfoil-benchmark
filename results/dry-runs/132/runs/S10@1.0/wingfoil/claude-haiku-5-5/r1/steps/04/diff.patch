+
+# Free shipping at 50.00 euro of items, quantities included
+
+Customers are being charged shipping they should not pay, and this is urgent: every order placed before the fix is
+charged wrongly. Two defects in `src/domain/shipping.ts`:
+
+- An order whose items come to exactly 50.00 € is charged shipping, because the test was `>` rather than `>=`.
+- An order reaches 50.00 € only once quantities count (for example three bottles of oil at 17.00 €) and is still charged
+  shipping, because `shippingFor` summed the unit prices and ignored each line's quantity.
+
+The rule is: an order whose items come to 50.00 € or more, quantities included, ships free.
+
+## What it asks for
+
+- An order whose items come to exactly 5000 cents ships free.
+- An order whose items reach 5000 cents only through quantities (3 × 1700 cents) ships free.
+- An order just under 50.00 € (4999 cents) still pays the flat shipping charge.
+
+## Choices
+
+- The fix is in `shippingFor`, which is the single place shipping is decided. `orders.ts` already passes each line's
+  quantity, so the caller does not change.
+- Shipping stays decided on the items before the discount, as the README states.
+- Tests are added first, to show both defects fail before the fix.
+
+## Acceptance
+
+- The new shipping tests pass, and `npm test` passes in full.
+- README documents the free-shipping threshold.
diff --git a/src/domain/shipping.ts b/src/domain/shipping.ts
index 5c8587fb45c4e5067317ac7db327b8d47df73cd3..205a13d6a27e9c321479d8a6d07b457ba744418b 100644
--- a/src/domain/shipping.ts
+++ b/src/domain/shipping.ts
@@ -15,9 +15,9 @@ export interface PricedLine {
 /**
  * The shipping charge of an order with these lines.
  *
- * @param lines - the order's lines, priced
+ * @param lines - the order's lines, priced; quantities count towards the free-shipping threshold
  */
 export function shippingFor(lines: readonly PricedLine[]): Cents {
-  const value = lines.reduce((sum, line) => sum + line.unitPriceCents, 0);
-  return value > FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
+  const value = lines.reduce((sum, line) => sum + line.unitPriceCents * line.quantity, 0);
+  return value >= FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
 }
