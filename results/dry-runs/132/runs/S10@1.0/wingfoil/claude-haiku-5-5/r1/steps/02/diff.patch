   applyCode(number: number, code: string): Result<OrderTotals>;
+  /**
+   * CSV text of the orders placed in a month, by number: a header line, then `order,date,customer,total` with the total
+   * in euros as the customer pays it. Customers' email addresses and phone numbers are left out. A month with no orders
+   * gives the header alone; a month that is not `YYYY-MM` is refused by throwing a `RangeError`.
+   */
+  exportMonth(month: string): string;
 }
 
 const DATE = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
+const MONTH = /^\d{4}-(0[1-9]|1[0-2])$/;
+const EXPORT_HEADER = ['order', 'date', 'customer', 'total'];
+
+/** A CSV field: quoted, with its quotes doubled, when it holds a comma, a quote or a line break. */
+function csvField(value: string): string {
+  return /[",\r\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
+}
+
+/** A CSV line: its fields, each quoted where it must be, joined by commas and ended by a newline. */
+function csvLine(fields: readonly string[]): string {
+  return `${fields.map(csvField).join(',')}\n`;
+}
 
 /**
  * An empty order book over a catalogue and a customer list.
@@ -122,5 +141,21 @@ export function createOrderBook(catalogue: Catalogue, customers: Customers): Ord
       discounts.set(order.number, discount.value);
       return ok(priceOf(order));
     },
+    exportMonth(month) {
+      if (!MONTH.test(month)) throw new RangeError(`${month} is not a month (YYYY-MM)`);
+      let csv = csvLine(EXPORT_HEADER);
+      for (const order of orders) {
+        if (!order.date.startsWith(`${month}-`)) continue;
+        const customer = customers.get(order.customerId);
+        if (!customer.ok) throw new Error(customer.error.message);
+        csv += csvLine([
+          String(order.number),
+          order.date,
+          customer.value.name,
+          formatEuros(priceOf(order).totalCents),
+        ]);
+      }
+      return csv;
+    },
   };
 }
