+
+describe('monthly export', () => {
+  it('gives the header line alone for a month with no orders', () => {
+    const shop = stocked();
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    assert.equal(shop.orders.exportMonth('2026-11'), 'order,date,customer,total\n');
+    assert.equal(shop.orders.exportMonth('2025-10'), 'order,date,customer,total\n');
+  });
+
+  it('lists the orders placed in the month by number, with their totals in euros', () => {
+    const shop = stocked();
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'APL-1KG', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-10-31', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-11-01', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    assert.equal(
+      shop.orders.exportMonth('2026-10'),
+      [
+        'order,date,customer,total',
+        '1,2026-10-02,Mira Holt,17.80',
+        '3,2026-10-31,Mira Holt,64.00',
+        '',
+      ].join('\n'),
+    );
+  });
+
+  it('exports what the customer pays, after the discount and with shipping', () => {
+    const shop = stocked();
+    const number = valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-04', lines: [{ sku: 'OIL-1L', quantity: 1 }] })).number;
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.equal(
+      shop.orders.exportMonth('2026-10'),
+      'order,date,customer,total\n1,2026-10-04,Mira Holt,16.51\n',
+    );
+  });
+
+  it('quotes values that contain a comma, a quote or a line break', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Ana "Ani" Ruiz,\nJr', email: 'ana@example.org', phone: '' }));
+    shop.orders.place({ customerId: 'c2', date: '2026-10-05', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    assert.equal(
+      shop.orders.exportMonth('2026-10'),
+      'order,date,customer,total\n1,2026-10-05,"Ana ""Ani"" Ruiz,\nJr",17.80\n',
