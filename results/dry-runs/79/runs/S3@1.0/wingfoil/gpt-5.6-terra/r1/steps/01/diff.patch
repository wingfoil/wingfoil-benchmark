diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5a3dc3820bc11567a60d00f1d644460289f98794
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,159 @@
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1_000;
+const UTC_MIDNIGHT_PATTERN = /^\d{4}-\d{2}-\d{2}T00:00:00(?:\.000)?Z$/;
+
+/** A board or sail that can be rented by the day. */
+export interface Equipment {
+  id: string;
+  kind: 'board' | 'sail';
+  dailyPrice: number;
+}
+
+/** A requested half-open rental period, expressed as UTC ISO-8601 timestamps. */
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+/** The calculated cost of renting equipment for a period. */
+export interface RentalQuote extends RentalRequest {
+  total: number;
+}
+
+/** A confirmed in-memory rental booking. */
+export interface RentalBooking extends RentalQuote {
+  id: string;
+}
+
+/** Operations available from an in-memory rental service. */
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): RentalQuote;
+  book(request: RentalRequest): RentalBooking;
+}
+
+interface RentalPeriod {
+  startAt: number;
+  endAt: number;
+  days: number;
+}
+
+interface StoredBooking extends RentalBooking {
+  startAt: number;
+  endAt: number;
+}
+
+/**
+ * Creates an isolated in-memory service for equipment rental quotes and bookings.
+ */
+export function createRentalService(): RentalService {
+  const equipmentById = new Map<string, Equipment>();
+  const bookings: StoredBooking[] = [];
+  let nextBookingNumber = 1;
+
+  return {
+    addEquipment(item: Equipment): void {
+      validateEquipment(item);
+
+      if (equipmentById.has(item.id)) {
+        throw new Error(`Equipment '${item.id}' already exists.`);
+      }
+
+      equipmentById.set(item.id, { ...item });
+    },
+
+    quote(request: RentalRequest): RentalQuote {
+      const equipment = getEquipment(equipmentById, request);
+      const period = validatePeriod(request);
+      const total = calculateTotal(equipment.dailyPrice, period.days);
+
+      return { ...request, total };
+    },
+
+    book(request: RentalRequest): RentalBooking {
+      const equipment = getEquipment(equipmentById, request);
+      const period = validatePeriod(request);
+
+      if (bookings.some((booking) => booking.itemId === request.itemId
+        && periodsOverlap(period, booking))) {
+        throw new Error(`Equipment '${request.itemId}' is not available for the requested period.`);
+      }
+
+      const booking: StoredBooking = {
+        id: `booking-${nextBookingNumber}`,
+        ...request,
+        total: calculateTotal(equipment.dailyPrice, period.days),
+        startAt: period.startAt,
+        endAt: period.endAt,
+      };
+      nextBookingNumber += 1;
+      bookings.push(booking);
+
+      const { startAt: _startAt, endAt: _endAt, ...result } = booking;
+      return result;
+    },
+  };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (typeof item !== 'object' || item === null
+    || typeof item.id !== 'string' || item.id.length === 0
+    || (item.kind !== 'board' && item.kind !== 'sail')
+    || !Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('Equipment must have a non-empty id, a board or sail kind, and a non-negative integer-cent daily price.');
+  }
+}
+
+function getEquipment(equipmentById: Map<string, Equipment>, request: RentalRequest): Equipment {
+  if (typeof request !== 'object' || request === null || typeof request.itemId !== 'string') {
+    throw new Error('Rental request must identify equipment by itemId.');
+  }
+
+  const equipment = equipmentById.get(request.itemId);
+  if (equipment === undefined) {
+    throw new Error(`Unknown equipment '${request.itemId}'.`);
+  }
+
+  return equipment;
+}
+
+function validatePeriod(request: RentalRequest): RentalPeriod {
+  if (typeof request !== 'object' || request === null) {
+    throw new Error('Rental request must include a start and end time.');
+  }
+
+  const startAt = parseUtcMidnight(request.start, 'start');
+  const endAt = parseUtcMidnight(request.end, 'end');
+  if (endAt <= startAt) {
+    throw new Error('Rental period must end after start.');
+  }
+
+  return { startAt, endAt, days: (endAt - startAt) / DAY_IN_MILLISECONDS };
+}
+
+function parseUtcMidnight(value: unknown, field: 'start' | 'end'): number {
+  if (typeof value !== 'string' || !UTC_MIDNIGHT_PATTERN.test(value)) {
+    throw new Error(`Rental ${field} must be an ISO-8601 midnight UTC time.`);
+  }
+
+  const timestamp = Date.parse(value);
+  if (!Number.isFinite(timestamp)
+    || new Date(timestamp).toISOString().replace('.000Z', 'Z') !== value.replace('.000Z', 'Z')) {
+    throw new Error(`Rental ${field} must be a valid ISO-8601 midnight UTC time.`);
+  }
+
+  return timestamp;
+}
+
+function calculateTotal(dailyPrice: number, days: number): number {
+  const total = dailyPrice * days;
+  if (!Number.isSafeInteger(total)) {
+    throw new Error('Rental total exceeds the supported integer-cent range.');
+  }
+
+  return total;
+}
+
+function periodsOverlap(period: RentalPeriod, booking: StoredBooking): boolean {
+  return period.startAt < booking.endAt && booking.startAt < period.endAt;
+}
diff --git a/test/rental-service.test.js b/test/rental-service.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..a0cd3c0ef3c64460e9b91f1908d247587688da15
--- /dev/null
+++ b/test/rental-service.test.js
@@ -0,0 +1,59 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { createRentalService } from '../dist/index.js';
+
+const firstDay = '2026-06-01T00:00:00Z';
+const thirdDay = '2026-06-03T00:00:00Z';
+const fourthDay = '2026-06-04T00:00:00Z';
+
+function createServiceWithBoard() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+  return service;
+}
+
+test('quotes and books whole UTC days at the item daily price', () => {
+  const service = createServiceWithBoard();
+  const request = { itemId: 'board-1', start: firstDay, end: thirdDay };
+
+  assert.deepEqual(service.quote(request), { ...request, total: 5_000 });
+  assert.deepEqual(service.book(request), { id: 'booking-1', ...request, total: 5_000 });
+});
+
+test('allows adjacent bookings but rejects overlapping bookings', () => {
+  const service = createServiceWithBoard();
+  service.book({ itemId: 'board-1', start: firstDay, end: thirdDay });
+
+  assert.deepEqual(
+    service.book({ itemId: 'board-1', start: thirdDay, end: fourthDay }),
+    {
+      id: 'booking-2',
+      itemId: 'board-1',
+      start: thirdDay,
+      end: fourthDay,
+      total: 2_500,
+    },
+  );
+  assert.throws(
+    () => service.book({ itemId: 'board-1', start: firstDay, end: fourthDay }),
+    /not available/,
+  );
+});
+
+test('rejects unknown equipment and periods that are not whole UTC days', () => {
+  const service = createServiceWithBoard();
+
+  assert.throws(
+    () => service.quote({ itemId: 'unknown', start: firstDay, end: thirdDay }),
+    /Unknown equipment/,
+  );
+  assert.throws(
+    () => service.quote({ itemId: 'board-1', start: firstDay, end: firstDay }),
+    /end after start/,
+  );
+  assert.throws(
+    () => service.quote({ itemId: 'board-1', start: '2026-06-01T12:00:00Z', end: thirdDay }),
+    /midnight UTC/,
+  );
+});
