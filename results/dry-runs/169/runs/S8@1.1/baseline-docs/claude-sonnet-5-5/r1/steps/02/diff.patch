+  describe('timestamps', () => {
+    function steppingClock(): () => Date {
+      let minute = 0;
+      return () => new Date(Date.UTC(2026, 0, 1, 0, minute++));
+    }
+
+    it('stamps a new task with the same createdAt and updatedAt, as ISO-8601', () => {
+      const task = valueOf(createTodoList(steppingClock()).add({ title: 'a' }));
+      assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+      assert.equal(task.updatedAt, task.createdAt);
+    });
+
+    it('sets updatedAt on every change and keeps createdAt', () => {
+      const list = createTodoList(steppingClock());
+      const { id, createdAt } = valueOf(list.add({ title: 'a' }));
+      const changes = [
+        list.complete(id),
+        list.reopen(id),
+        list.rename(id, 'b'),
+        list.tag(id, 'x'),
+        list.untag(id, 'x'),
+      ].map(valueOf);
+      assert.deepEqual(
+        changes.map((task) => task.updatedAt),
+        ['00:01', '00:02', '00:03', '00:04', '00:05'].map((time) => `2026-01-01T${time}:00.000Z`),
+      );
+      assert.ok(changes.every((task) => task.createdAt === createdAt));
+      assert.equal(valueOf(list.get(id)).updatedAt, '2026-01-01T00:05:00.000Z');
+    });
+
