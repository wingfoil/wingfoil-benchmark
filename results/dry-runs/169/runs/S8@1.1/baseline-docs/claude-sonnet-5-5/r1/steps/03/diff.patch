index 0f08609c4420158d8688dc0419e4ea02afb8ebcf..ae0cfe1f92cb09ccf0ba504e5cbcb93b236daddd 100644
--- a/test/list.test.ts
+++ b/test/list.test.ts
@@ -162,3 +162,46 @@ describe('task list', () => {
     });
   });
 });
+
+describe('input validation', () => {
+  const rejected = (result: { ok: boolean; error?: { code: string; message: string } }): void => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid');
+    assert.notEqual(result.error?.message, '');
+  };
+
+  it('rejects an empty, blank or too long title when adding, and leaves the list alone', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: '' }));
+    rejected(list.add({ title: '   ' }));
+    rejected(list.add({ title: 'x'.repeat(121) }));
+    assert.equal(list.list().length, 0);
+    assert.equal(list.add({ title: 'x'.repeat(120) }).ok, true);
+  });
+
+  it('rejects an unknown priority and a bad tag when adding', () => {
+    const list = createTodoList();
+    rejected(list.add({ title: 'A', priority: 'urgent' as 'high' }));
+    rejected(list.add({ title: 'A', tags: ['ok', ''] }));
+    rejected(list.add({ title: 'A', tags: ['two words'] }));
+    assert.equal(list.list().length, 0);
+    assert.equal(valueOf(list.add({ title: 'A', priority: 'low', tags: ['home'] })).id, 'task-1');
+  });
+
+  it('rejects a bad new title when renaming, and keeps the task as it was', () => {
+    const list = createTodoList();
+    list.add({ title: 'Old' });
+    rejected(list.rename('Old', ' '));
+    rejected(list.rename('Old', 'y'.repeat(121)));
+    assert.equal(valueOf(list.find('Old')).title, 'Old');
+  });
+
+  it('rejects a bad tag when tagging, and keeps the task as it was', () => {
+    const list = createTodoList();
+    list.add({ title: 'Task' });
+    rejected(list.tag('Task', ''));
+    rejected(list.tag('Task', 'a b'));
+    assert.deepEqual(valueOf(list.find('Task')).tags, []);
+    assert.deepEqual(valueOf(list.tag('Task', 'home')).tags, ['home']);
+  });
+});
