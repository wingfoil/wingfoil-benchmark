diff --git a/src/domain/validate.ts b/src/domain/validate.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9d2f99901544e5272ea4186d951357356acd6996
--- /dev/null
+++ b/src/domain/validate.ts
@@ -0,0 +1,63 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { NewTask } from './task.ts';
+
+/** The longest title a task may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * Checks a title: it must not be empty or only spaces, nor longer than 120 characters once trimmed.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: unknown): Result<string> {
+  if (typeof title !== 'string') return err('invalid', 'the title must be text');
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid', 'the title is empty: give the task a title');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid', `the title is ${trimmed.length} characters long; the limit is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * Checks a priority: it must be `low`, `normal` or `high`.
+ *
+ * @param priority - the priority as given
+ */
+export function validatePriority(priority: unknown): Result<string> {
+  if (typeof priority === 'string' && (PRIORITIES as readonly string[]).includes(priority)) return ok(priority);
+  return err('invalid', `the priority "${String(priority)}" is not one of ${PRIORITIES.join(', ')}`);
+}
+
+/**
+ * Checks a tag: it must not be empty or contain a space.
+ *
+ * @param tag - the tag as given
+ */
+export function validateTag(tag: unknown): Result<string> {
+  if (typeof tag !== 'string') return err('invalid', 'the tag must be text');
+  if (tag === '') return err('invalid', 'the tag is empty: give it a name');
+  if (/\s/.test(tag)) return err('invalid', `the tag "${tag}" contains a space; tags are a single word`);
+  return ok(tag);
+}
+
+/**
+ * Checks everything of a new task: its title, its priority when given, and each of its tags.
+ *
+ * @param input - the new task as typed
+ */
+export function validateNewTask(input: NewTask): Result<NewTask> {
+  const title = validateTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined) {
+    const priority = validatePriority(input.priority);
+    if (!priority.ok) return priority;
+  }
+  for (const tag of input.tags ?? []) {
+    const checked = validateTag(tag);
+    if (!checked.ok) return checked;
+  }
+  return ok(input);
+}
