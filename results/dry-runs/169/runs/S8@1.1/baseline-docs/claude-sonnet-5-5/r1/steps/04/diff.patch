+
+describe('importTasks', () => {
+  it('adds each valid line, skipping blank ones', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\nBuy milk;;\nWalk the dog');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = valueOf(list.find('Renew the insurance'));
+    assert.equal(insurance.priority, 'high');
+    assert.deepEqual(insurance.tags, ['admin', 'money']);
+    assert.equal(valueOf(list.find('Buy milk')).priority, 'normal');
+  });
+
+  it('rejects bad lines with their number and goes on', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Pay rent;urgent;\r\n\r\n;high;x\nPay rent;low;\nPay rent;high;\na;b;c;d');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(
+      report.rejected.map((r) => r.line),
+      [1, 3, 5, 6],
+    );
+    assert.equal(list.list().length, 1);
+  });
+});
