 import { createTaskList } from './domain/list.ts';
 import type { Clock, TaskList } from './domain/list.ts';
 
+export type { ImportReport, RejectedLine } from './domain/import.ts';
 export type { Clock, TaskFilter, TaskList } from './domain/list.ts';
 export type { Result, TodoError, TodoErrorCode } from './domain/result.ts';
 export { summarize } from './domain/summary.ts';
@@ -16,3 +19,17 @@ export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 export function createTodoList(now: Clock = () => new Date()): TaskList {
   return createTaskList(now);
 }
+
+/**
+ * Adds many tasks at once from text with one task per line, as `title;priority;tags`, for example
+ * `Renew the insurance;high;admin money`. The priority may be empty for a normal one; the tags are
+ * separated by spaces. Blank lines are skipped, and a line that cannot be added is reported without
+ * stopping the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ * @returns how many tasks were added, and each rejected line with its number (from 1) and the reason
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  return importTaskLines(list, text);
+}
