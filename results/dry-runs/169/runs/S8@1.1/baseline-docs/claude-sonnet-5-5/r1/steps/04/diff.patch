+++ b/src/domain/import.ts
@@ -0,0 +1,56 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { TaskList } from './list.ts';
+import type { NewTask, Priority } from './task.ts';
+import { validatePriority } from './validate.ts';
+
+/** A line of the text that could not be added, and why. */
+export interface RejectedLine {
+  /** The line's number in the text, counting from 1. */
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What a bulk import did: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Reads one `title;priority;tags` line: the priority may be empty for a normal one, and the tags are
+ * separated by spaces. The priority and the tags may be left out altogether.
+ *
+ * @param text - the line as typed
+ */
+function parseLine(text: string): Result<NewTask> {
+  const fields = text.split(';');
+  if (fields.length > 3) return err('invalid', `expected "title;priority;tags" but found ${fields.length} fields`);
+  const [title = '', rawPriority = '', rawTags = ''] = fields;
+  const wanted = rawPriority.trim().toLowerCase();
+  const tags = rawTags.split(/\s+/).filter((tag) => tag !== '');
+  if (wanted === '') return ok({ title, tags });
+  const priority = validatePriority(wanted);
+  if (!priority.ok) return priority;
+  return ok({ title, priority: priority.value as Priority, tags });
+}
+
+/**
+ * Adds the tasks written in `text`, one per line as `title;priority;tags`, to the list. Blank lines are
+ * skipped; a line that cannot be added is reported and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTaskLines(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r?\n/).forEach((content, index) => {
+    if (content.trim() === '') return;
+    const parsed = parseLine(content);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
