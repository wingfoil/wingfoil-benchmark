 import { test } from "node:test";
 import assert from "node:assert/strict";
-import { resolvePointer, JsonPointerError } from "./index.ts";
+import { resolvePointer, JsonPointerError, applyMergePatch } from "./index.ts";
 
 const throws = (doc: unknown, p: unknown) =>
   assert.throws(() => resolvePointer(doc, p as string), JsonPointerError);
@@ -193,3 +193,76 @@ test("patch: hostile keys", () => {
   bad({}, [{ op: "remove", path: "/toString" }]);
   bad({}, [{ op: "test", path: "/constructor", value: 1 }]);
 });
+
+// ---- applyMergePatch (RFC 7396) ----
+const mp = (target: unknown, patch: unknown) => applyMergePatch(target, patch);
+
+test("merge patch: RFC 7396 Appendix A cases", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, r] of cases) assert.deepEqual(mp(t, p), r);
+});
+
+test("merge patch: scalars and misc", () => {
+  assert.deepEqual(mp({ a: 1 }, { b: null }), { a: 1 });
+  assert.deepEqual(mp({ a: "foo" }, { a: { b: "c" } }), { a: { b: "c" } });
+  assert.deepEqual(mp({}, { a: [1, null] }), { a: [1, null] });
+  for (const t of ["x", null, 5, true]) assert.deepEqual(mp(t, { a: "b" }), { a: "b" });
+  for (const p of [1, true, [1]]) assert.deepEqual(mp({ a: 1 }, p), p);
+  assert.deepEqual(mp({ a: 1 }, {}), { a: 1 });
+  assert.deepEqual(mp(5, {}), {});
+});
+
+test("merge patch: inputs not mutated, no aliasing", () => {
+  const target = { a: { b: 1, c: [1] }, d: { e: 1 } };
+  const patch = { a: { b: null, x: { y: [1] } }, z: [2] };
+  const t0 = structuredClone(target);
+  const p0 = structuredClone(patch);
+  const out = mp(target, patch) as any;
+  assert.deepEqual(target, t0);
+  assert.deepEqual(patch, p0);
+  out.a.x.y.push(9);
+  out.z.push(9);
+  out.d.e = 2;
+  out.a.c.push(9);
+  assert.deepEqual(target, t0);
+  assert.deepEqual(patch, p0);
+  const arr = [{ q: 1 }];
+  (mp({}, arr) as any)[0].q = 2;
+  assert.deepEqual(arr, [{ q: 1 }]);
+});
+
+test("merge patch: __proto__ and inherited keys are safe", () => {
+  const out = mp({}, JSON.parse('{"__proto__":{"polluted":true}}')) as any;
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(out.polluted, undefined);
+  assert.deepEqual(Object.getOwnPropertyDescriptor(out, "__proto__")!.value, { polluted: true });
+
+  const target = JSON.parse('{"__proto__":{"a":1},"k":1}');
+  const removed = mp(target, JSON.parse('{"__proto__":null}')) as any;
+  assert.deepEqual(Object.keys(removed), ["k"]);
+  assert.equal(Object.getPrototypeOf(removed), Object.prototype);
+
+  // inherited members are not target members
+  assert.deepEqual(mp({}, { toString: { a: 1 } }), { toString: { a: 1 } });
+  assert.deepEqual(mp({}, JSON.parse('{"constructor":{"prototype":{"x":1}}}')), {
+    constructor: { prototype: { x: 1 } },
+  });
+  assert.equal(({} as any).x, undefined);
+});
diff --git a/src/index.ts b/src/index.ts
index 8a7ed1ce6557c2bdf8ef530c2c948a5da464756b..9e3f635d990a354fe6af4600d0215703ba10d9cc 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -236,3 +236,24 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+/**
+ * Applies an RFC 7396 JSON Merge Patch to `target` and returns the result as a new value.
+ * Neither argument is modified and the result shares nothing with them. Never throws:
+ * every JSON value is a valid merge patch.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch);
+  const result: Record<string, unknown> = {};
+  const base = isObject(target) ? target : {};
+  for (const key of Object.keys(base)) setMember(result, key, clone(base[key]));
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(hasOwn(base, key) ? base[key] : undefined, value));
+    }
+  }
+  return result;
+}
