+++ b/src/index.ts
@@ -257,3 +257,91 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+// RFC 6901 §3-§4: "~" is escaped before "/".
+const escapeToken = (token: string): string => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+function diffInto(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (hasOwn(to, key)) diffInto(from[key], to[key], child, ops);
+      else ops.push({ op: "remove", path: child });
+    }
+    for (const key of Object.keys(to)) {
+      if (!hasOwn(from, key)) {
+        ops.push({ op: "add", path: `${path}/${escapeToken(key)}`, value: clone(to[key]) });
+      }
+    }
+  } else if (!jsonEqual(from, to)) {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && jsonEqual(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const a = from.slice(start, endFrom);
+  const b = to.slice(start, endTo);
+
+  // Longest common subsequence of equal items: lcs[i][j] for a[i..] and b[j..].
+  const lcs: number[][] = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(a[i], b[j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  // `index` is the position in the array as it is after the operations emitted so far.
+  let index = start;
+  let i = 0;
+  let j = 0;
+  const flushGap = (removed: unknown[], added: unknown[]): void => {
+    const paired = Math.min(removed.length, added.length);
+    for (let k = 0; k < paired; k++) diffInto(removed[k], added[k], `${path}/${index + k}`, ops);
+    index += paired;
+    for (let k = paired; k < removed.length; k++) ops.push({ op: "remove", path: `${path}/${index}` });
+    for (let k = paired; k < added.length; k++) {
+      ops.push({ op: "add", path: `${path}/${index}`, value: clone(added[k]) });
+      index++;
+    }
+  };
+  while (i < a.length || j < b.length) {
+    const gapFrom = i;
+    const gapTo = j;
+    while ((i < a.length || j < b.length) && !(i < a.length && j < b.length && jsonEqual(a[i], b[j]) && lcs[i][j] === lcs[i + 1][j + 1] + 1)) {
+      if (j >= b.length || (i < a.length && lcs[i + 1][j] >= lcs[i][j + 1])) i++;
+      else j++;
+    }
+    flushGap(a.slice(gapFrom, i), b.slice(gapTo, j));
+    if (i < a.length && j < b.length) {
+      i++;
+      j++;
+      index++;
+    }
+  }
+}
+
+/**
+ * Returns an RFC 6902 JSON Patch that turns `from` into `to` when applied with `applyPatch`.
+ * The patch only describes what differs: it descends into objects and arrays, adds and removes
+ * array items individually, and expresses a moved item as a removal plus an addition.
+ * Neither argument is modified and the patch shares nothing with them.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffInto(from, to, "", ops);
+  return ops;
+}
