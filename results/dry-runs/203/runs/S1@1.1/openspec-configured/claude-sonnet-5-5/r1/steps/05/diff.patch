@@ -266,3 +266,106 @@ test("merge patch: __proto__ and inherited keys are safe", () => {
   });
   assert.equal(({} as any).x, undefined);
 });
+
+describe("createPatch", () => {
+  const roundTrip = (from: unknown, to: unknown) => {
+    const f = JSON.stringify(from);
+    const t = JSON.stringify(to);
+    const patch = createPatch(from, to);
+    assert.deepEqual(applyPatch(from, patch), to);
+    assert.equal(JSON.stringify(from), f);
+    assert.equal(JSON.stringify(to), t);
+    return patch;
+  };
+
+  it("round trips nested changes", () => {
+    roundTrip({ a: { b: [1, 2, { c: 1 }], d: 1 }, e: "x" }, { a: { b: [0, 2, { c: 2 }, 5] }, f: null });
+  });
+
+  it("does not alias inputs", () => {
+    const to = { a: { b: 1 } };
+    const patch = createPatch({}, to);
+    (patch[0] as { value: { b: number } }).value.b = 9;
+    assert.deepEqual(to, { a: { b: 1 } });
+  });
+
+  it("returns [] for equal documents regardless of key order", () => {
+    assert.deepEqual(createPatch({ a: 1, b: [1, { c: 2 }] }, { b: [1, { c: 2 }], a: 1 }), []);
+  });
+
+  it("emits one replace for a small change", () => {
+    const from = { a: { b: [1, { c: 1, d: 2 }] }, z: [1, 2, 3] };
+    const to = { a: { b: [1, { c: 1, d: 3 }] }, z: [1, 2, 3] };
+    assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/1/d", value: 3 }]);
+  });
+
+  it("handles add, remove and null", () => {
+    assert.deepEqual(roundTrip({ a: 1, b: 2, c: 3 }, { a: 1, c: null, d: 4 }), [
+      { op: "remove", path: "/b" },
+      { op: "replace", path: "/c", value: null },
+      { op: "add", path: "/d", value: 4 },
+    ]);
+  });
+
+  it("replaces on type change", () => {
+    assert.deepEqual(roundTrip({ a: { x: 1 } }, { a: [1] }), [{ op: "replace", path: "/a", value: [1] }]);
+    assert.deepEqual(roundTrip({ a: [1] }, { a: 1 }), [{ op: "replace", path: "/a", value: 1 }]);
+  });
+
+  it("replaces the root with path empty", () => {
+    assert.deepEqual(roundTrip(1, { a: 1 }), [{ op: "replace", path: "", value: { a: 1 } }]);
+    assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  });
+
+  it("inserts, removes and appends array items individually", () => {
+    const base = [10, 11, 12, 13, 14, 15];
+    assert.deepEqual(roundTrip(base, [10, 11, 99, 12, 13, 14, 15]), [{ op: "add", path: "/2", value: 99 }]);
+    assert.deepEqual(roundTrip(base, [11, 12, 13, 14, 15]), [{ op: "remove", path: "/0" }]);
+    assert.deepEqual(roundTrip(base, [...base, 16, 17]), [
+      { op: "add", path: "/6", value: 16 },
+      { op: "add", path: "/7", value: 17 },
+    ]);
+  });
+
+  it("expresses a move without rewriting the items between", () => {
+    const base = [{ id: 1 }, { id: 2 }, { id: 3 }, { id: 4 }, { id: 5 }];
+    const patch = roundTrip(base, [{ id: 2 }, { id: 3 }, { id: 4 }, { id: 5 }, { id: 1 }]);
+    assert.equal(patch.length, 2);
+    assert.deepEqual(patch.map((p) => p.op), ["remove", "add"]);
+  });
+
+  it("recurses into changed array elements", () => {
+    const patch = roundTrip([{ a: 1, b: 2 }, { a: 3 }], [{ a: 1, b: 5 }, { a: 3 }]);
+    assert.deepEqual(patch, [{ op: "replace", path: "/0/b", value: 5 }]);
+  });
+
+  it("handles emptied and filled arrays", () => {
+    assert.deepEqual(roundTrip({ a: [1, 2] }, { a: [] }), [
+      { op: "remove", path: "/a/0" },
+      { op: "remove", path: "/a/0" },
+    ]);
+    assert.deepEqual(roundTrip({ a: [] }, { a: [1] }), [{ op: "add", path: "/a/0", value: 1 }]);
+  });
+
+  it("round trips randomized arrays", () => {
+    let seed = 7;
+    const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff), seed % n);
+    const gen = () => Array.from({ length: rnd(8) }, () => (rnd(3) === 0 ? { k: rnd(3) } : rnd(4)));
+    for (let n = 0; n < 300; n++) roundTrip(gen(), gen());
+  });
+
+  it("escapes pointer tokens", () => {
+    const patch = roundTrip({ "a/b": 1, "m~n": 1, "": 1, "~1": 1 }, { "a/b": 2, "m~n": 2, "": 2, "~1": 2 });
+    assert.deepEqual(patch.map((p) => p.path), ["/a~1b", "/m~0n", "/", "/~01"]);
+  });
+
+  it("handles __proto__ keys safely", () => {
+    const to = JSON.parse('{"__proto__":{"x":1},"a":1}');
+    const patch = roundTrip({ a: 1 }, to);
+    assert.equal(patch[0].path, "/__proto__");
+    const result = applyPatch({ a: 1 }, patch) as Record<string, unknown>;
+    assert.ok(Object.prototype.hasOwnProperty.call(result, "__proto__"));
+    assert.equal(({} as Record<string, unknown>).x, undefined);
+    roundTrip(JSON.parse('{"__proto__":{"x":1}}'), JSON.parse('{"__proto__":{"x":2}}'));
+  });
+});
