@@ -0,0 +1,76 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer, JsonPointerError } from "./index.ts";
+
+const throws = (doc: unknown, p: unknown) =>
+  assert.throws(() => resolvePointer(doc, p as string), JsonPointerError);
+
+test("empty pointer returns whole document", () => {
+  const doc = { a: 1 };
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.equal(resolvePointer(null, ""), null);
+  assert.equal(resolvePointer(5, ""), 5);
+});
+
+test("syntax errors", () => {
+  throws({ foo: 1 }, "foo");
+  throws({ foo: 1 }, "#/foo");
+  throws({}, undefined);
+  throws({}, null);
+  throws({}, 1);
+  throws({ a: 1 }, "/a~");
+  throws({ a: 1 }, "/a~2");
+});
+
+test("escaping", () => {
+  const doc = { "a/b": 1, "m~n": 2, "~1": 3 };
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/m~0n"), 2);
+  assert.equal(resolvePointer(doc, "/~01"), 3);
+});
+
+test("object lookup", () => {
+  const doc = { "": 0, a: { b: [10, 20] }, "0": "zero" };
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a/b/1"), 20);
+  assert.equal(resolvePointer(doc, "/0"), "zero");
+  throws(doc, "/missing");
+  throws(doc, "//");
+});
+
+test("hostile and inherited names", () => {
+  for (const k of ["__proto__", "constructor", "toString", "hasOwnProperty"]) {
+    throws({}, `/${k}`);
+  }
+  assert.equal(resolvePointer(JSON.parse('{"__proto__": 5}'), "/__proto__"), 5);
+  assert.equal(Object.prototype.hasOwnProperty.call(Object.prototype, "polluted"), false);
+});
+
+test("array lookup", () => {
+  const arr = ["x", "y"];
+  assert.equal(resolvePointer(arr, "/0"), "x");
+  assert.equal(resolvePointer(arr, "/1"), "y");
+  for (const t of ["01", "+1", "-1", "1.0", "1e0", " 1", "", "length"]) throws(arr, `/${t}`);
+  throws(arr, "/2");
+  throws(arr, "/-");
+});
+
+test("falsy values and traversal through non-containers", () => {
+  const doc = { a: null, b: false, c: 0, d: "", e: "str", f: 3 };
+  assert.equal(resolvePointer(doc, "/a"), null);
+  assert.equal(resolvePointer(doc, "/b"), false);
+  assert.equal(resolvePointer(doc, "/c"), 0);
+  assert.equal(resolvePointer(doc, "/d"), "");
+  throws(doc, "/a/b");
+  throws(doc, "/e/length");
+  throws(doc, "/f/x");
+});
+
+test("no mutation, returns reference", () => {
+  const doc = { a: { b: [1, 2] } };
+  const before = structuredClone(doc);
+  assert.equal(resolvePointer(doc, "/a"), doc.a);
+  assert.equal(resolvePointer(doc, "/a/b"), doc.a.b);
+  throws(doc, "/a/x");
+  assert.deepEqual(doc, before);
+});
