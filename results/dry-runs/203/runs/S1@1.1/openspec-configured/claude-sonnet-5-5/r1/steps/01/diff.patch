--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,56 @@
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function decodeToken(token: string): string {
+  // RFC 6901 §3: "~" must be followed by "0" or "1"; §4: decode ~1 before ~0.
+  if (/~(?![01])/.test(token)) {
+    throw new JsonPointerError(`Invalid escape in JSON Pointer token: ${token}`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Invalid JSON Pointer, must be empty or start with "/": ${pointer}`);
+  }
+  return pointer.slice(1).split("/").map(decodeToken);
+}
+
+/**
+ * Returns the value of `document` referred to by an RFC 6901 JSON Pointer.
+ * Throws JsonPointerError if the pointer is invalid or does not resolve.
+ * The document is not modified and the referenced value is returned as is.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current: unknown = document;
+  for (const token of parsePointer(pointer)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token)) {
+        throw new JsonPointerError(`Invalid array index: ${token}`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new JsonPointerError(`Array index out of range: ${token}`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new JsonPointerError(`No such member: ${token}`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Cannot resolve "${token}" in a non-container value`);
+    }
+  }
+  return current;
+}
