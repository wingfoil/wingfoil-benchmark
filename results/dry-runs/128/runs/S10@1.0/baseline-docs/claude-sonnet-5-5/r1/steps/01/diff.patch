@@ -0,0 +1,35 @@
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** `WELCOME5` only applies to an order whose items come to this amount or more. */
+export const WELCOME_MINIMUM_CENTS: Cents = 3000;
+
+const WELCOME_CENTS: Cents = 500;
+
+/**
+ * Checks that a discount code can be used on an order with these items.
+ *
+ * @param code - the code the customer entered
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function checkCode(code: string, itemsCents: Cents): Result<string> {
+  if (code === 'SPRING10') return ok(code);
+  if (code !== 'WELCOME5') return err('invalid', `${code} is not a discount code`);
+  if (itemsCents < WELCOME_MINIMUM_CENTS) {
+    return err('invalid', 'WELCOME5 needs items worth 30.00 or more');
+  }
+  return ok(code);
+}
+
+/**
+ * What a code takes off the items of an order; 0 without a code.
+ *
+ * @param code - the code on the order, if any
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function discountFor(code: string | undefined, itemsCents: Cents): Cents {
+  if (code === 'SPRING10') return Math.floor((itemsCents + 5) / 10);
+  if (code === 'WELCOME5') return WELCOME_CENTS;
+  return 0;
+}
