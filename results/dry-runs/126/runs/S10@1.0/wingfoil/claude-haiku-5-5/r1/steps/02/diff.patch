@@ -125,5 +138,19 @@ export function createOrderBook(catalogue: Catalogue, customers: Customers): Ord
       codes.set(number, code);
       return totals;
     },
+    exportMonth(month) {
+      const lines = [CSV_HEADER];
+      for (const order of orders) {
+        if (!order.date.startsWith(`${month}-`)) continue;
+        // Customers are never removed and an order's code was checked when it was given, so these cannot fail.
+        const customer = customers.get(order.customerId);
+        if (!customer.ok) throw new Error(customer.error.message);
+        const totals = totalsOf(order, codes.get(order.number));
+        if (!totals.ok) throw new Error(totals.error.message);
+        const fields = [order.number, order.date, customer.value.name, formatEuros(totals.value.totalCents)];
+        lines.push(fields.map((field) => csvField(String(field))).join(','));
+      }
+      return lines.map((line) => `${line}\n`).join('');
+    },
   };
 }
