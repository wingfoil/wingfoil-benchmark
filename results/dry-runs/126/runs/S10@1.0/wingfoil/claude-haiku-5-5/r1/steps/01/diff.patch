@@ -0,0 +1,32 @@
+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** Orders whose items come to this amount or more can use WELCOME5. */
+const WELCOME_MINIMUM_CENTS: Cents = 3000;
+
+/** What WELCOME5 takes off the items of an order. */
+const WELCOME_DISCOUNT_CENTS: Cents = 500;
+
+/**
+ * The discount a code gives on an order whose items come to `itemsCents`. Codes are matched without regard to case
+ * or surrounding spaces. An unknown code, or WELCOME5 below its minimum, is refused.
+ *
+ * @param code - the code the customer typed
+ * @param itemsCents - the items of the order, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  switch (code.trim().toUpperCase()) {
+    case 'SPRING10':
+      // 10 % of the items, rounded to the nearest cent with a half cent rounding up.
+      return ok(Math.floor((itemsCents * 10 + 50) / 100));
+    case 'WELCOME5':
+      if (itemsCents < WELCOME_MINIMUM_CENTS) {
+        return err('invalid', `WELCOME5 needs items of ${formatEuros(WELCOME_MINIMUM_CENTS)} € or more`);
+      }
+      return ok(WELCOME_DISCOUNT_CENTS);
+    default:
+      return err('invalid', `${code.trim()} is not a discount code`);
+  }
+}
