index 0000000000000000000000000000000000000000..a2251e27536d2db3c563ecf265eaf1bdae2c40db
--- /dev/null
+++ b/src/domain/validate.ts
@@ -0,0 +1,45 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { Priority } from './task.ts';
+
+/** The most characters a task title may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * The title trimmed, or an `invalid-input` error when it is empty or longer than 120 characters.
+ *
+ * @param title - the title as typed
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed.length === 0) return err('invalid-input', 'the title is empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is longer than ${MAX_TITLE_LENGTH} characters (${trimmed.length})`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority, or an `invalid-input` error when it is not `low`, `normal` or `high`.
+ *
+ * @param priority - the priority as given
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  const found = PRIORITIES.find((known) => known === priority);
+  if (found === undefined) {
+    return err('invalid-input', `the priority "${priority}" is not one of ${PRIORITIES.join(', ')}`);
+  }
+  return ok(found);
+}
+
+/**
+ * The tag, or an `invalid-input` error when it is empty or contains a space.
+ *
+ * @param tag - the tag as given
+ */
+export function validateTag(tag: string): Result<string> {
+  if (tag.length === 0) return err('invalid-input', 'the tag is empty');
+  if (tag.includes(' ')) return err('invalid-input', `the tag "${tag}" contains a space`);
+  return ok(tag);
+}
