index 0000000000000000000000000000000000000000..a1b17df3348b052122a5939f252878951b78a9bc
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,44 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds valid lines with priority and tags, and skips blank lines', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\n  \nBuy milk;;\nWalk\nCall;low');
+    assert.deepEqual(report, { imported: 4, rejected: [] });
+    const tasks = list.list();
+    const insurance = tasks.find((t) => t.title === 'Renew the insurance');
+    assert.equal(insurance?.priority, 'high');
+    assert.deepEqual(insurance?.tags, ['admin', 'money']);
+    const milk = tasks.find((t) => t.title === 'Buy milk');
+    assert.equal(milk?.priority, 'normal');
+    assert.deepEqual(milk?.tags, []);
+    assert.equal(tasks.find((t) => t.title === 'Call')?.priority, 'low');
+  });
+
+  it('reports rejected lines by number, counting blank lines, and keeps the valid ones', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'A;;\r\n\r\n;high;\nPay rent;urgent;home\nB;;to  do\nA;;\nC;high;x;y');
+    assert.equal(report.imported, 2);
+    assert.deepEqual(
+      report.rejected.map((r) => r.line),
+      [3, 4, 6, 7],
+    );
+    assert.match(report.rejected[0]!.reason, /title is empty/);
+    assert.match(report.rejected[1]!.reason, /priority "urgent"/);
+    assert.match(report.rejected[2]!.reason, /already a task "A"/);
+    assert.match(report.rejected[3]!.reason, /4 fields/);
+    assert.deepEqual(list.list().map((t) => t.title).sort(), ['A', 'B']);
+  });
+
+  it('rejects a title already in the list and leaves it unchanged', () => {
+    const list = createTodoList();
+    list.add({ title: 'A', priority: 'high' });
+    const report = importTasks(list, 'A;low;');
+    assert.equal(report.imported, 0);
+    assert.equal(report.rejected.length, 1);
+    assert.equal(list.list()[0]?.priority, 'high');
+  });
+});
