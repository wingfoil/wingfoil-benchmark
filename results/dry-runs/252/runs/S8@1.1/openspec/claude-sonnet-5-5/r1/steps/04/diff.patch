+++ b/src/domain/import.ts
@@ -0,0 +1,49 @@
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of the import text that could not be added. */
+export interface RejectedLine {
+  /** Position of the line in the text, counting from 1 (blank lines included). */
+  readonly line: number;
+  /** What is wrong with the line, for the person importing. */
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds the tasks written in `text` to a list, one per line as `title;priority;tags`. The priority may be
+ * empty (normal) and tags are separated by spaces; blank lines are skipped. Valid lines are added even when
+ * others are rejected.
+ *
+ * @param list - the task list to add to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  text.split(/\r\n|\n|\r/).forEach((raw, index) => {
+    if (raw.trim().length === 0) return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `the line has ${fields.length} fields; expected title;priority;tags` });
+      return;
+    }
+    const [title = '', priority = '', tags = ''] = fields;
+    const wanted = priority.trim();
+    const result = list.add({
+      title,
+      // An invalid priority is left for `add` to reject, with its own message.
+      priority: wanted === '' ? undefined : (wanted as Priority),
+      tags: tags.split(/\s+/).filter((tag) => tag.length > 0),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line, reason: result.error.message });
+  });
+  return { imported, rejected };
+}
