+/** Error thrown for an invalid JSON Pointer or one that does not resolve (RFC 6901). */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new JsonPointerError(`Invalid escape sequence in reference token "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/** Parses a JSON Pointer string into its unescaped reference tokens. */
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("A JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+/**
+ * Returns the value of `document` referred to by the JSON Pointer `pointer` (RFC 6901).
+ * Throws a JsonPointerError if the pointer is invalid or does not resolve to a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const token of parsePointer(pointer)) {
+    if (Array.isArray(current)) {
+      if (token === "-") {
+        throw new JsonPointerError(`"-" refers to the nonexistent element after the end of the array`);
+      }
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new JsonPointerError(`Invalid array index "${token}"`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new JsonPointerError(`Array index ${token} is out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new JsonPointerError(`No member "${token}" in object`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Cannot resolve "${token}" in a non-container value`);
+    }
+  }
+  return current;
+}
