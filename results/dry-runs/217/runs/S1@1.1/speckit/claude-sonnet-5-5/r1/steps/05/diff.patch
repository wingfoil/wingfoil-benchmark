@@ -0,0 +1,44 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (a: unknown, b: unknown) => {
+  const ca = structuredClone(a);
+  const cb = structuredClone(b);
+  const p = createPatch(a, b);
+  assert.deepEqual(applyPatch(a, p), b);
+  assert.deepEqual(a, ca);
+  assert.deepEqual(b, cb);
+  return p;
+};
+
+test("minimal object changes", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: { c: 1, d: 2 } }, { a: 1, b: { c: 1, d: 3 } }), [{ op: "replace", path: "/b/d", value: 3 }]);
+  assert.deepEqual(roundTrip({ a: 1 }, { a: 1 }), []);
+  assert.deepEqual(roundTrip({ "a/b": 1, "~": 1 }, { "~": 2 }), [{ op: "remove", path: "/a~1b" }, { op: "replace", path: "/~0", value: 2 }]);
+  assert.deepEqual(roundTrip(1, { a: 1 }), [{ op: "replace", path: "", value: { a: 1 } }]);
+  roundTrip({ a: [1] }, { a: { b: null } });
+});
+
+test("array insert, delete and move", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([{ a: 1 }, { b: 2 }, { c: 3 }], [{ b: 2 }, { c: 3 }]), [{ op: "remove", path: "/0" }]);
+  assert.equal(roundTrip(["a", "b", "c", "d", "e"], ["b", "c", "d", "e", "a"]).length, 2);
+  assert.equal(roundTrip(["a", "b", "c", "d", "e"], ["e", "a", "b", "c", "d"]).length, 2);
+  assert.deepEqual(roundTrip([{ id: 1, v: 1 }, { id: 2 }], [{ id: 1, v: 2 }, { id: 2 }]), [{ op: "replace", path: "/0/v", value: 2 }]);
+});
+
+test("random round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) % n);
+  const gen = (d: number): unknown => {
+    const t = rnd(d > 2 ? 3 : 5);
+    if (t === 0) return rnd(4);
+    if (t === 1) return ["x", "y", null][rnd(3)];
+    if (t === 2) return rnd(2) === 0;
+    if (t === 3) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => [["a", "b/", "~c", "d"][rnd(4)], gen(d + 1)]));
+  };
+  for (let i = 0; i < 2000; i++) roundTrip(gen(0), gen(0));
+});
