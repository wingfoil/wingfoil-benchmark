+import { equal } from "./patch.ts";
+
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+const isObject = (v: unknown): v is Record<string, unknown> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+const hasOwn = (o: object, k: string) => Object.prototype.hasOwnProperty.call(o, k);
+
+const escapeToken = (token: string) => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+function diffValues(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (equal(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) return diffArrays(from, to, path, ops);
+  if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (hasOwn(from, key)) diffValues(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: structuredClone(to[key]) });
+    }
+    return;
+  }
+  ops.push({ op: "replace", path, value: structuredClone(to) });
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && equal(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && equal(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const a = from.slice(start, endFrom);
+  const b = to.slice(start, endTo);
+
+  // longest common subsequence of the differing middle part
+  const lcs: number[][] = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lcs[i][j] = equal(a[i], b[j]) ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  let index = start; // position in the array as it stands after the operations so far
+  const flush = (removed: unknown[], added: unknown[]) => {
+    const paired = Math.min(removed.length, added.length);
+    for (let k = 0; k < paired; k++) diffValues(removed[k], added[k], `${path}/${index + k}`, ops);
+    index += paired;
+    for (let k = paired; k < removed.length; k++) ops.push({ op: "remove", path: `${path}/${index}` });
+    for (let k = paired; k < added.length; k++) {
+      ops.push({ op: "add", path: `${path}/${index++}`, value: structuredClone(added[k]) });
+    }
+  };
+
+  let i = 0;
+  let j = 0;
+  let removed: unknown[] = [];
+  let added: unknown[] = [];
+  while (i < a.length || j < b.length) {
+    if (i < a.length && j < b.length && equal(a[i], b[j])) {
+      flush(removed, added);
+      removed = [];
+      added = [];
+      index++;
+      i++;
+      j++;
+    } else if (j >= b.length || (i < a.length && lcs[i + 1][j] >= lcs[i][j + 1])) {
+      removed.push(a[i++]);
+    } else {
+      added.push(b[j++]);
+    }
+  }
+  flush(removed, added);
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied. Neither input is
+ * mutated, and the patch does not share structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffValues(from, to, "", ops);
+  return ops;
+}
