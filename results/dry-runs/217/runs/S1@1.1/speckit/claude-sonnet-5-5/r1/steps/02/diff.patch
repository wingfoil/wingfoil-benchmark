index 0000000000000000000000000000000000000000..bf75faf0dccd2e3f24b40d0c6364ddcad9112773
--- /dev/null
+++ b/src/patch.ts
@@ -0,0 +1,144 @@
+import { parsePointer } from "./pointer.ts";
+
+/** Error thrown for an invalid JSON Patch or an operation that fails (RFC 6902). */
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Container = Record<string, unknown> | unknown[];
+
+const isObject = (v: unknown): v is Record<string, unknown> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+const hasOwn = (o: object, k: string) => Object.prototype.hasOwnProperty.call(o, k);
+
+function setMember(obj: Record<string, unknown>, key: string, value: unknown): void {
+  // defineProperty so that a "__proto__" member is an ordinary own property
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function tokens(pointer: unknown, what: string): string[] {
+  if (typeof pointer !== "string") throw new JsonPatchError(`"${what}" must be a string`);
+  try {
+    return parsePointer(pointer);
+  } catch (e) {
+    throw new JsonPatchError((e as Error).message);
+  }
+}
+
+function arrayIndex(token: string, arr: unknown[], allowEnd: boolean): number {
+  if (allowEnd && token === "-") return arr.length;
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) throw new JsonPatchError(`Invalid array index "${token}"`);
+  const index = Number(token);
+  if (index > arr.length || (!allowEnd && index === arr.length)) {
+    throw new JsonPatchError(`Array index ${token} is out of range`);
+  }
+  return index;
+}
+
+/** Returns the container holding the target of `toks` (which must be non-empty). */
+function parentOf(doc: unknown, toks: string[]): Container {
+  let current = doc;
+  for (const token of toks.slice(0, -1)) {
+    if (Array.isArray(current)) current = current[arrayIndex(token, current, false)];
+    else if (isObject(current) && hasOwn(current, token)) current = current[token];
+    else throw new JsonPatchError(`Path does not exist at "${token}"`);
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new JsonPatchError("Parent of the target is not an object or array");
+  }
+  return current;
+}
+
+function get(doc: unknown, toks: string[]): unknown {
+  if (toks.length === 0) return doc;
+  const parent = parentOf(doc, toks);
+  const key = toks[toks.length - 1];
+  if (Array.isArray(parent)) return parent[arrayIndex(key, parent, false)];
+  if (!hasOwn(parent, key)) throw new JsonPatchError(`No member "${key}" in object`);
+  return parent[key];
+}
+
+function add(doc: unknown, toks: string[], value: unknown): unknown {
+  if (toks.length === 0) return value;
+  const parent = parentOf(doc, toks);
+  const key = toks[toks.length - 1];
+  if (Array.isArray(parent)) parent.splice(arrayIndex(key, parent, true), 0, value);
+  else setMember(parent, key, value);
+  return doc;
+}
+
+function remove(doc: unknown, toks: string[]): unknown {
+  if (toks.length === 0) throw new JsonPatchError("Cannot remove the document root");
+  const parent = parentOf(doc, toks);
+  const key = toks[toks.length - 1];
+  if (Array.isArray(parent)) parent.splice(arrayIndex(key, parent, false), 1);
+  else if (hasOwn(parent, key)) delete parent[key];
+  else throw new JsonPatchError(`No member "${key}" in object`);
+  return doc;
+}
+
+function equal(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => equal(v, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const ka = Object.keys(a);
+    return ka.length === Object.keys(b).length && ka.every((k) => hasOwn(b, k) && equal(a[k], b[k]));
+  }
+  return a === b;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the result as a new value; the input
+ * is not mutated. Throws a JsonPatchError if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchError("A JSON Patch must be an array of operations");
+  let doc: unknown = structuredClone(document);
+  for (const operation of patch as unknown[]) {
+    if (!isObject(operation)) throw new JsonPatchError("Each operation must be an object");
+    const { op } = operation;
+    const path = tokens(operation.path, "path");
+    const needValue = op === "add" || op === "replace" || op === "test";
+    if (needValue && !hasOwn(operation, "value")) {
+      throw new JsonPatchError(`Operation "${op}" requires a "value" member`);
+    }
+    switch (op) {
+      case "add":
+        doc = add(doc, path, structuredClone(operation.value));
+        break;
+      case "remove":
+        doc = remove(doc, path);
+        break;
+      case "replace":
+        get(doc, path); // must exist
+        doc = path.length === 0 ? structuredClone(operation.value) : add(remove(doc, path), path, structuredClone(operation.value));
+        break;
+      case "move":
+      case "copy": {
+        const from = tokens(operation.from, "from");
+        const value = get(doc, from);
+        if (op === "copy") {
+          doc = add(doc, path, structuredClone(value));
+          break;
+        }
+        const isPrefix = from.length < path.length && from.every((t, i) => t === path[i]);
+        if (isPrefix) throw new JsonPatchError('"from" must not be a proper prefix of "path"');
+        if (from.length === path.length && from.every((t, i) => t === path[i])) break;
+        doc = add(remove(doc, from), path, value);
+        break;
+      }
+      case "test":
+        if (!equal(get(doc, path), operation.value)) throw new JsonPatchError(`Test failed at "${operation.path}"`);
+        break;
+      default:
+        throw new JsonPatchError(`Unknown operation "${String(op)}"`);
+    }
+  }
+  return doc;
+}
