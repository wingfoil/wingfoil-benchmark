diff --git a/CHANGELOG.md b/CHANGELOG.md
index 25c067bb74b5baf82617250af7082ceb56978c19..f8dc75136a170bd4c549eff3e975557d1b2076b2 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -5,6 +5,8 @@
 - Discount codes: `SPRING10` (10 % off the items) and `WELCOME5` (5.00 € off items of 30.00 € or more), applied with
   `applyCode`.
 - Monthly export: `exportMonth` gives the orders placed in a month (`YYYY-MM`) as CSV for the accountant.
+- Fix: orders of exactly 50.00 € ship free, and item quantities count towards the 50.00 € free-shipping threshold
+  (previously quantities were ignored and an order had to exceed 50.00 €).
 
 ## 1.4.0
 
diff --git a/src/domain/shipping.ts b/src/domain/shipping.ts
index 5c8587fb45c4e5067317ac7db327b8d47df73cd3..96e3d3ec23d29b1b2d46c76758b8a8a7b956f178 100644
--- a/src/domain/shipping.ts
+++ b/src/domain/shipping.ts
@@ -18,6 +18,6 @@ export interface PricedLine {
  * @param lines - the order's lines, priced
  */
 export function shippingFor(lines: readonly PricedLine[]): Cents {
-  const value = lines.reduce((sum, line) => sum + line.unitPriceCents, 0);
-  return value > FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
+  const items = lines.reduce((sum, line) => sum + line.unitPriceCents * line.quantity, 0);
+  return items >= FREE_SHIPPING_FROM_CENTS ? 0 : SHIPPING_CENTS;
 }
