+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** WELCOME5 takes this much off, and only on items that come to at least `WELCOME5_MIN_ITEMS_CENTS`. */
+const WELCOME5_CENTS: Cents = 500;
+const WELCOME5_MIN_ITEMS_CENTS: Cents = 3000;
+
+/**
+ * What a discount code takes off an order's items, given the items' total.
+ *
+ * `SPRING10` is 10 % of the items, rounded to the nearest cent with a half cent going up; the integer form
+ * avoids floating-point error. `WELCOME5` is 5.00 € and is refused on smaller orders.
+ *
+ * @param code - the code the customer entered
+ * @param itemsCents - the total of the order's items, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  switch (code) {
+    case 'SPRING10':
+      return ok(Math.floor((itemsCents * 10 + 50) / 100));
+    case 'WELCOME5':
+      if (itemsCents < WELCOME5_MIN_ITEMS_CENTS) {
+        return err('invalid', `WELCOME5 needs items of ${formatEuros(WELCOME5_MIN_ITEMS_CENTS)} € or more`);
+      }
+      return ok(WELCOME5_CENTS);
+    default:
+      return err('not-found', `${code} is not a discount code`);
+  }
+}
