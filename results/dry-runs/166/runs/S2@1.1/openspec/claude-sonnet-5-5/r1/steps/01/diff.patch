@@ -0,0 +1,62 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createShop } from '../src/index.ts';
+import { shippingCost } from '../src/shipping.ts';
+import { lineVat } from '../src/tax.ts';
+
+function shop() {
+  const s = createShop();
+  s.catalog.add({ sku: 'LB-220', name: 'Lamp', priceCents: 1999, vatClass: 'standard', weightGrams: 300 });
+  s.catalog.add({ sku: 'BX-1', name: 'Box', priceCents: 2500, vatClass: 'standard', weightGrams: 300 });
+  s.catalog.add({ sku: 'CD-1', name: 'Card', priceCents: 500, vatClass: 'standard', weightGrams: 10 });
+  s.inventory.restock('CD-1', 40);
+  s.inventory.restock('LB-220', 40);
+  s.inventory.restock('BX-1', 40);
+  return s;
+}
+
+describe('SKU lookup', () => {
+  it('finds a product in lower case and with spaces', () => {
+    const { catalog } = shop();
+    assert.equal(catalog.get('lb-220').sku, 'LB-220');
+    assert.equal(catalog.get(' Lb-220 ').sku, 'LB-220');
+  });
+
+  it('accepts an order keyed in lower case', () => {
+    const { orders } = shop();
+    const order = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'lb-220', quantity: 1 }] });
+    assert.equal(order.lines[0]?.sku, 'LB-220');
+  });
+});
+
+describe('free shipping', () => {
+  it('is free at exactly €50.00 and charged just below', () => {
+    assert.equal(shippingCost(5000, 500), 0);
+    assert.equal(shippingCost(4999, 500), 490);
+  });
+
+  it('is free at €50.00 goods, charged when a coupon takes goods below it', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'FIVE', kind: 'fixed', value: 500, validFrom: '2026-01-01', validUntil: '2026-12-31' });
+    const order = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'BX-1', quantity: 2 }], coupon: 'five' });
+    assert.equal(order.totals.goodsCents, 4500);
+    assert.equal(order.totals.shippingCents, 490);
+    coupons.add({ code: 'TEN', kind: 'fixed', value: 500, validFrom: '2026-01-01', validUntil: '2026-12-31' });
+    const discounted = orders.place({ customer: 'c-3', date: '2026-03-02', lines: [{ sku: 'BX-1', quantity: 2 }, { sku: 'CD-1', quantity: 1 }], coupon: 'ten' });
+    assert.equal(discounted.totals.goodsCents, 5000);
+    assert.equal(discounted.totals.shippingCents, 0);
+    const exact = orders.place({ customer: 'c-2', date: '2026-03-02', lines: [{ sku: 'BX-1', quantity: 2 }] });
+    assert.equal(exact.totals.goodsCents, 5000);
+    assert.equal(exact.totals.shippingCents, 0);
+  });
+});
+
+describe('line VAT', () => {
+  it('rounds half up', () => {
+    assert.equal(lineVat(199, 'standard'), 44);
+    assert.equal(lineVat(100, 'super-reduced'), 4);
+    assert.equal(lineVat(111, 'exempt'), 0);
+    assert.equal(lineVat(102, 'reduced'), 10);
+  });
+});
