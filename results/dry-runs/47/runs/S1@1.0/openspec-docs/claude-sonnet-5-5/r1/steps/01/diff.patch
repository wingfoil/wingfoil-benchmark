+++ b/src/index.ts
@@ -0,0 +1,54 @@
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/** Splits a JSON Pointer into its unescaped reference tokens (RFC 6901 section 3 and 4). */
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new TypeError("A JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new Error(`Invalid JSON Pointer ${JSON.stringify(pointer)}: must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new Error(`Invalid JSON Pointer ${JSON.stringify(pointer)}: "~" must be followed by 0 or 1`);
+      }
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/**
+ * Returns the value of `document` referred to by the JSON Pointer `pointer` (RFC 6901).
+ * Throws if the pointer is not a valid JSON Pointer or does not resolve to a value of the document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const token of parsePointer(pointer)) {
+    if (Array.isArray(current)) {
+      // "-" refers to the nonexistent element after the last one, so it never resolves.
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`Pointer ${JSON.stringify(pointer)} does not resolve: no array element ${JSON.stringify(token)}`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(`Pointer ${JSON.stringify(pointer)} does not resolve: no member ${JSON.stringify(token)}`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`Pointer ${JSON.stringify(pointer)} does not resolve: cannot descend into a scalar`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..91ca8c6acb04cd6f7fba1814682820d2658e1c74
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,50 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+  nul: null,
+};
+
+test("RFC 6901 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+  assert.equal(resolvePointer(doc, "/nul"), null);
+});
+
+test("~01 unescapes to ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["foo", "/a~", "/a~2", "#/foo"]) assert.throws(() => resolvePointer(doc, p));
+});
+
+test("unresolvable pointers throw", () => {
+  for (const p of ["/missing", "/foo/2", "/foo/-", "/foo/01", "/foo/+1", "/foo/1.0", "/foo/x", "/foo/0/0", "/nul/x"]) {
+    assert.throws(() => resolvePointer(doc, p), p);
+  }
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer({}, "/constructor"));
+  assert.throws(() => resolvePointer([], "/length"));
+});
