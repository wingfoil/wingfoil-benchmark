--- a/src/index.ts
+++ b/src/index.ts
@@ -22,10 +22,18 @@ export interface Booking extends Quote {
   id: string;
 }
 
+export interface AvailabilityQuery {
+  start: string;
+  end: string;
+  kind?: EquipmentKind;
+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  /** Ids of the equipment (of `kind`, if given) free for the whole period, sorted. */
+  availability(query: AvailabilityQuery): string[];
 }
 
 const MS_PER_DAY = 24 * 60 * 60 * 1000;
@@ -111,5 +119,17 @@ export function createRentalService(): RentalService {
       bookings.push({ ...booking, startMs: period.startMs, endMs: period.endMs });
       return booking;
     },
+
+    availability(query) {
+      const { startMs, endMs } = parsePeriod(query.start, query.end);
+      if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+        throw new Error("kind must be 'board' or 'sail'");
+      }
+      return [...items.values()]
+        .filter((item) => query.kind === undefined || item.kind === query.kind)
+        .filter((item) => !bookings.some((b) => b.itemId === item.id && b.startMs < endMs && startMs < b.endMs))
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
