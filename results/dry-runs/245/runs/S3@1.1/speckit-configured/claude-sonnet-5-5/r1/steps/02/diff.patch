   a.book({ itemId: 'b1', start: D(1), end: D(2) });
 });
+
+test('availability lists free items of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 1000 });
+  s.book({ itemId: 'b1', start: D(1), end: D(4) });
+  assert.deepEqual(s.availability({ start: D(3), end: D(5), kind: 'board' }), ['a0']);
+  assert.deepEqual(s.availability({ start: D(3), end: D(5) }), ['a0', 's1']);
+  assert.deepEqual(s.availability({ start: D(4), end: D(6), kind: 'board' }), ['a0', 'b1']);
+  assert.deepEqual(s.availability({ start: D(1), end: D(2), kind: 'sail' }), ['s1']);
+});
+
+test('availability is empty when nothing is free or registered, and rejects bad input', () => {
+  const s = setup();
+  s.book({ itemId: 's1', start: D(2), end: D(3) });
+  assert.deepEqual(s.availability({ start: D(1), end: D(5), kind: 'sail' }), []);
+  assert.deepEqual(createRentalService().availability({ start: D(1), end: D(2) }), []);
+  assert.throws(() => s.availability({ start: D(2), end: D(2) }));
+  assert.throws(() => s.availability({ start: '2026-06-01T12:00:00Z', end: D(3) }));
+  assert.throws(() => s.availability({ start: D(1), end: D(2), kind: 'kite' as never }));
+});
