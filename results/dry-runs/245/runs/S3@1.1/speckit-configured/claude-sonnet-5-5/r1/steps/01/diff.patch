+++ b/test/rental.test.ts
@@ -0,0 +1,86 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+const D = (d: number) => `2026-06-${String(d).padStart(2, '0')}T00:00:00Z`;
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  return s;
+}
+
+test('quote is days times daily price', () => {
+  const s = setup();
+  assert.deepEqual(s.quote({ itemId: 'b1', start: D(1), end: D(4) }), {
+    itemId: 'b1', start: D(1), end: D(4), total: 7500,
+  });
+  assert.equal(s.quote({ itemId: 'b1', start: D(1), end: D(2) }).total, 2500);
+});
+
+test('unknown item throws', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'x', start: D(1), end: D(2) }));
+  assert.throws(() => s.book({ itemId: 'x', start: D(1), end: D(2) }));
+});
+
+test('invalid periods throw', () => {
+  const s = setup();
+  const bad = [
+    [D(1), D(1)],
+    [D(2), D(1)],
+    ['2026-06-01T12:00:00Z', D(3)],
+    [D(1), '2026-06-03T00:00:00+02:00'],
+    [D(1), '2026-06-03T00:00:00'],
+    ['nonsense', D(3)],
+    ['2026-02-30T00:00:00Z', '2026-03-02T00:00:00Z'],
+  ];
+  for (const [start, end] of bad) {
+    assert.throws(() => s.quote({ itemId: 'b1', start, end }), `${start} ${end}`);
+    assert.throws(() => s.book({ itemId: 'b1', start, end }), `${start} ${end}`);
+  }
+});
+
+test('book returns a booking with unique ids', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: D(1), end: D(3) });
+  const b = s.book({ itemId: 's1', start: D(1), end: D(3) });
+  assert.equal(a.total, 5000);
+  assert.equal(b.total, 3000);
+  assert.notEqual(a.id, b.id);
+});
+
+test('overlapping bookings of one item are rejected', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: D(1), end: D(4) });
+  for (const [st, en] of [[3, 5], [1, 4], [2, 3], [1, 2], [3, 4], [0 + 1, 10]]) {
+    assert.throws(() => s.book({ itemId: 'b1', start: D(st), end: D(en) }));
+  }
+  s.book({ itemId: 's1', start: D(1), end: D(4) });
+});
+
+test('adjacent bookings are allowed and quote ignores bookings', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: D(1), end: D(4) });
+  s.book({ itemId: 'b1', start: D(4), end: D(6) });
+  s.book({ itemId: 'b1', start: D(9), end: D(10) });
+  assert.doesNotThrow(() => s.quote({ itemId: 'b1', start: D(1), end: D(4) }));
+});
+
+test('addEquipment validates input', () => {
+  const s = createRentalService();
+  assert.throws(() => s.addEquipment({ id: '', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'boat' as never, dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'board', dailyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'board', dailyPrice: -1 }));
+  s.addEquipment({ id: 'a', kind: 'board', dailyPrice: 1 });
+  assert.throws(() => s.addEquipment({ id: 'a', kind: 'sail', dailyPrice: 1 }));
+});
+
+test('services are independent', () => {
+  const a = setup();
+  const b = createRentalService();
+  assert.throws(() => b.quote({ itemId: 'b1', start: D(1), end: D(2) }));
+  a.book({ itemId: 'b1', start: D(1), end: D(2) });
+});
