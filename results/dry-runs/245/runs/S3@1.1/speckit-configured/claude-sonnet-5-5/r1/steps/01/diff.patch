+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Euro cents for one day. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+export interface Quote extends RentalRequest {
+  /** Euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00(:00(\.0+)?)?Z$/;
+
+function parseMidnightUtc(value: string, label: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${label} must be an ISO-8601 UTC time at midnight, like 2026-06-01T00:00:00Z`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms)) {
+    throw new Error(`${label} is not a valid date`);
+  }
+  return ms;
+}
+
+/** Rule 3: whole days only, ending at the start of the day after the last day. */
+export function parsePeriod(start: string, end: string): { startMs: number; endMs: number; days: number } {
+  const startMs = parseMidnightUtc(start, 'start');
+  const endMs = parseMidnightUtc(end, 'end');
+  if (endMs <= startMs) {
+    throw new Error('end must be after start');
+  }
+  return { startMs, endMs, days: (endMs - startMs) / MS_PER_DAY };
+}
+
+interface StoredBooking extends Booking {
+  startMs: number;
+  endMs: number;
+}
+
+export function createRentalService(): RentalService {
+  const items = new Map<string, Equipment>();
+  const bookings: StoredBooking[] = [];
+  let counter = 0;
+
+  function price(request: RentalRequest) {
+    const item = items.get(request.itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${request.itemId}`);
+    }
+    const period = parsePeriod(request.start, request.end);
+    const quote: Quote = {
+      itemId: item.id,
+      start: request.start,
+      end: request.end,
+      total: period.days * item.dailyPrice,
+    };
+    return { quote, period };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item.id !== 'string' || item.id === '') {
+        throw new Error('id must be a non-empty string');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error("kind must be 'board' or 'sail'");
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of cents');
+      }
+      if (items.has(item.id)) {
+        throw new Error(`item already exists: ${item.id}`);
+      }
+      items.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, period } = price(request);
+      const clash = bookings.some(
+        (b) => b.itemId === quote.itemId && b.startMs < period.endMs && period.startMs < b.endMs,
+      );
+      if (clash) {
+        throw new Error(`item ${quote.itemId} is not free for that period`);
+      }
+      counter += 1;
+      const booking: Booking = { id: `booking-${counter}`, ...quote };
+      bookings.push({ ...booking, startMs: period.startMs, endMs: period.endMs });
+      return booking;
+    },
+  };
+}
