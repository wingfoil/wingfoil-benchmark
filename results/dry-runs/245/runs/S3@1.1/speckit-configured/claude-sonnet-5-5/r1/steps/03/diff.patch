   return { startMs, endMs, days: (endMs - startMs) / MS_PER_DAY };
 }
 
+/** Long-stay rule: from this many days on, the total is 10% below full price. */
+const LONG_STAY_MIN_DAYS = 3;
+
+/** Euro cents; the discounted total is rounded to the nearest cent, halves up. */
+export function rentalTotal(days: number, dailyPrice: number): number {
+  const full = days * dailyPrice;
+  return days >= LONG_STAY_MIN_DAYS ? Math.floor((full * 9 + 5) / 10) : full;
+}
+
 interface StoredBooking extends Booking {
   startMs: number;
   endMs: number;
