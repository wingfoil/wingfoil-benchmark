@@ -178,3 +178,41 @@ test('hourlyPrice must be a non-negative integer when given', () => {
     assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice }));
   }
 });
+
+test('cancel refunds by time before start', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: D(10), end: D(12) }); // 5000
+  const full = s.book({ itemId: 's1', start: D(10), end: D(12) }); // 3000
+  const none = s.book({ itemId: 's1', start: D(20), end: D(21) }); // 1500
+  assert.deepEqual(s.cancel(b.id, '2026-06-09T00:00:00Z'), { bookingId: b.id, refund: 5000 });
+  assert.equal(s.cancel(full.id, '2026-06-08T00:00:00Z').refund, 3000);
+  const half = s.book({ itemId: 's1', start: D(15), end: D(16) }); // 1500
+  assert.equal(s.cancel(half.id, '2026-06-14T01:00:00Z').refund, 750);
+  assert.equal(s.cancel(none.id, D(20)).refund, 0);
+});
+
+test('half refund rounds halves up', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 1001 });
+  const b = s.book({ itemId: 'h', start: D(5), end: D(6) });
+  assert.equal(s.cancel(b.id, '2026-06-04T12:00:00Z').refund, 501);
+});
+
+test('cancelled booking frees the equipment', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: D(1), end: D(3) });
+  assert.deepEqual(s.availability({ start: D(1), end: D(3), kind: 'board' }), []);
+  s.cancel(b.id, D(1));
+  assert.deepEqual(s.availability({ start: D(1), end: D(3), kind: 'board' }), ['b1']);
+  s.book({ itemId: 'b1', start: D(1), end: D(3) });
+});
+
+test('cancel errors: twice, unknown, bad time', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: D(1), end: D(3) });
+  assert.throws(() => s.cancel('nope', D(1)));
+  assert.throws(() => s.cancel(b.id, 'garbage'));
+  assert.throws(() => s.cancel(b.id, '2026-05-30T12:30:00Z'));
+  s.cancel(b.id, D(1));
+  assert.throws(() => s.cancel(b.id, D(1)));
+});
