+/** Cancellation rule: full refund this long before the start, half after that, none from the start on. */
+const REFUND_FULL_BEFORE_MS = MS_PER_DAY;
+
+/** Euro cents; the half refund is rounded to the nearest cent, halves up. */
+export function refundAmount(total: number, startMs: number, atMs: number): number {
+  if (atMs >= startMs) return 0;
+  if (startMs - atMs >= REFUND_FULL_BEFORE_MS) return total;
+  return Math.floor((total + 1) / 2);
+}
