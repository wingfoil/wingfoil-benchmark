diff --git a/test/rental.test.ts b/test/rental.test.ts
index f306650fb3668b95959501dfa371f63ec936abc0..fa660908e4d121da819186c5fd39144208f548ed 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -122,3 +122,59 @@ test('discounted total is rounded to the nearest cent, halves up', () => {
   assert.equal(s.quote({ itemId: 'y', start: D(1), end: D(4) }).total, 14);
   assert.equal(s.quote({ itemId: 'z', start: D(1), end: D(4) }).total, 0);
 });
+
+const H = (d: number, h: number) => `2026-06-${String(d).padStart(2, '0')}T${String(h).padStart(2, '0')}:00:00Z`;
+
+function hourly() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 2500 });
+  return s;
+}
+
+test('hourly rental costs the hourly price for each hour', () => {
+  const s = hourly();
+  assert.equal(s.quote({ itemId: 'b1', start: H(1, 13), end: H(1, 14) }).total, 600);
+  assert.equal(s.quote({ itemId: 'b1', start: H(1, 13), end: H(1, 17) }).total, 2400);
+  assert.equal(s.quote({ itemId: 'b1', start: H(1, 22), end: H(2, 2) }).total, 2400);
+  assert.equal(s.quote({ itemId: 'b1', start: H(1, 0), end: H(1, 23) }).total, 13800);
+  assert.equal(s.book({ itemId: 'b1', start: H(1, 9), end: H(1, 12) }).total, 1800);
+});
+
+test('item without hourly price cannot be rented by the hour', () => {
+  const s = hourly();
+  assert.throws(() => s.quote({ itemId: 'b2', start: H(1, 9), end: H(1, 12) }));
+  assert.throws(() => s.book({ itemId: 'b2', start: H(1, 9), end: H(1, 12) }));
+  assert.equal(s.quote({ itemId: 'b2', start: D(1), end: D(2) }).total, 2500);
+});
+
+test('hourly periods must be on the hour and under a day; longer ones stay whole days', () => {
+  const s = hourly();
+  for (const [start, end] of [
+    ['2026-06-01T09:30:00Z', H(1, 12)],
+    [H(1, 9), '2026-06-01T12:15:00Z'],
+    [H(1, 9), H(2, 9)],
+    [H(1, 9), D(3)],
+    [H(1, 12), H(1, 12)],
+    [H(1, 12), H(1, 9)],
+    [H(1, 9), '2026-06-01T24:00:00Z'],
+  ]) {
+    assert.throws(() => s.quote({ itemId: 'b1', start, end }), `${start} ${end}`);
+  }
+});
+
+test('hourly bookings clash like any other and show in availability', () => {
+  const s = hourly();
+  s.book({ itemId: 'b1', start: H(1, 9), end: H(1, 12) });
+  assert.throws(() => s.book({ itemId: 'b1', start: H(1, 11), end: H(1, 13) }));
+  s.book({ itemId: 'b1', start: H(1, 12), end: H(1, 13) });
+  assert.deepEqual(s.availability({ start: H(1, 10), end: H(1, 11) }), ['b2']);
+  assert.deepEqual(s.availability({ start: H(1, 13), end: H(1, 14) }), ['b1', 'b2']);
+});
+
+test('hourlyPrice must be a non-negative integer when given', () => {
+  const s = createRentalService();
+  for (const hourlyPrice of [-1, 1.5, NaN]) {
+    assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice }));
+  }
+});
