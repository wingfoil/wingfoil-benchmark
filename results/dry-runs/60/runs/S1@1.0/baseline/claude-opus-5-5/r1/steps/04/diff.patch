@@ -51,3 +51,15 @@ other projects of the team, so its behaviour must follow the published standards
   properties, so `/__proto__` is an ordinary member and cannot change prototypes.
 - Choices where the RFC is silent: `remove` of the root (`""`) fails; `move` with `from` equal to
   `path` is a no-op (the target must still exist), including `from: ""` to `path: ""`.
+
+### JSON Merge Patch (RFC 7386)
+
+- `applyMergePatch(target, patch)` applies a merge patch and returns the merged document as a new
+  value, following the `MergePatch` algorithm of RFC 7386 section 2: an object patch is merged member
+  by member, recursively (a `null` member removes that member from the target; a target that is not an
+  object is first replaced by `{}`); any other patch (array, scalar, `null`) replaces the target
+  entirely. Arrays are never merged, and `null`s inside arrays or inside a non-object value are kept.
+- It never mutates `target` or `patch`, and the result shares no object or array with either.
+- `TypeError` if `target` or `patch` contains non-JSON values (including array holes and cycles).
+- Object members are always set as own properties, so `__proto__` is an ordinary member and cannot
+  change prototypes; inherited names such as `toString` are not taken as existing members.
diff --git a/src/index.ts b/src/index.ts
index 0f8d9d6f719a09938029ba9259fed3207f73fbf8..0f3254544c2a4e4b2c56dda24abe1b23378a2469 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -395,3 +395,37 @@ export function applyPatch(document: unknown, patch: readonly PatchOperation[] |
 
   return root;
 }
+
+/**
+ * JSON Merge Patch (RFC 7386): https://www.rfc-editor.org/rfc/rfc7386
+ *
+ * A merge patch is a JSON document describing changes by example. If the patch is an object, each
+ * of its members is merged recursively into the target (which is replaced by {} if it is not an
+ * object), and a member whose value is null removes that member from the target. Any other patch
+ * (array, string, number, boolean, null) replaces the target as a whole.
+ */
+
+/** The MergePatch function of RFC 7386 section 2, on values already copied, so it may reuse and modify them. */
+function mergePatch(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isObject(patch)) return patch;
+  const result: Record<string, JsonValue> = isObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, mergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies a JSON Merge Patch to a JSON document and returns the merged document as a new value;
+ * neither argument is modified, and the result shares no object or array with them.
+ * Throws a TypeError if `target` or `patch` is not JSON (including array holes and cycles).
+ */
+export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
+  const patchCopy = cloneJson(patch, "patch");
+  return mergePatch(cloneJson(target, "target"), patchCopy);
+}
diff --git a/test/merge-patch.test.ts b/test/merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c84133093f12e1dd0b9a4daebe1c5405d7096345
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,94 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+// RFC 7386 section 1 and appendix A examples.
+const rfcExamples: { name: string; target: unknown; patch: unknown; expected: unknown }[] = [
+  {
+    name: "section 1 example",
+    target: { a: "b", c: { d: "e", f: "g" } },
+    patch: { a: "z", c: { f: null } },
+    expected: { a: "z", c: { d: "e" } },
+  },
+  {
+    name: "section 3 example",
+    target: { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["example", "sample"], content: "This will be unchanged" },
+    patch: { title: "Hello!", phoneNumber: "+01-123-456-7890", author: { familyName: null }, tags: ["example"] },
+    expected: { title: "Hello!", author: { givenName: "John" }, tags: ["example"], content: "This will be unchanged", phoneNumber: "+01-123-456-7890" },
+  },
+  { name: "A.1", target: { a: "b" }, patch: { a: "c" }, expected: { a: "c" } },
+  { name: "A.2", target: { a: "b" }, patch: { b: "c" }, expected: { a: "b", b: "c" } },
+  { name: "A.3", target: { a: "b" }, patch: { a: null }, expected: {} },
+  { name: "A.4", target: { a: "b", b: "c" }, patch: { a: null }, expected: { b: "c" } },
+  { name: "A.5", target: { a: ["b"] }, patch: { a: "c" }, expected: { a: "c" } },
+  { name: "A.6", target: { a: "c" }, patch: { a: ["b"] }, expected: { a: ["b"] } },
+  { name: "A.7", target: { a: { b: "c" } }, patch: { a: { b: "d", c: null } }, expected: { a: { b: "d" } } },
+  { name: "A.8", target: { a: [{ b: "c" }] }, patch: { a: [1] }, expected: { a: [1] } },
+  { name: "A.9", target: ["a", "b"], patch: ["c", "d"], expected: ["c", "d"] },
+  { name: "A.10", target: { a: "b" }, patch: ["c"], expected: ["c"] },
+  { name: "A.11", target: { a: "foo" }, patch: null, expected: null },
+  { name: "A.12", target: { a: "foo" }, patch: "bar", expected: "bar" },
+  { name: "A.13", target: { e: null }, patch: { a: 1 }, expected: { e: null, a: 1 } },
+  { name: "A.14", target: [1, 2], patch: { a: "b", c: null }, expected: { a: "b" } },
+  { name: "A.15", target: {}, patch: { a: { bb: { ccc: null } } }, expected: { a: { bb: {} } } },
+];
+
+for (const { name, target, patch, expected } of rfcExamples) {
+  test(`RFC 7386 ${name}`, () => {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  });
+}
+
+test("nulls inside arrays or replaced values are kept", () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, { a: [null, { b: null }] }), { a: [null, { b: null }] });
+  assert.deepEqual(applyMergePatch([1], [null]), [null]);
+});
+
+test("a non-object target is replaced by an object when the patch is one", () => {
+  for (const target of [null, 1, "s", true, [1]]) {
+    assert.deepEqual(applyMergePatch(target, { a: 1, b: null }), { a: 1 });
+  }
+  assert.deepEqual(applyMergePatch({ a: "x" }, { a: { b: 1 } }), { a: { b: 1 } });
+});
+
+test("neither argument is modified and the result shares nothing with them", () => {
+  const target = { a: { b: [1] }, c: { d: 1 } };
+  const patch = { a: { e: [2] }, c: null, f: { g: {} } };
+  const targetCopy = structuredClone(target);
+  const patchCopy = structuredClone(patch);
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(result, { a: { b: [1], e: [2] }, f: { g: {} } });
+  assert.deepEqual(target, targetCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.notEqual(result.a, target.a);
+  assert.notEqual(result.a.b, target.a.b);
+  assert.notEqual(result.a.e, patch.a.e);
+  assert.notEqual(result.f, patch.f);
+  assert.notEqual(result.f.g, patch.f.g);
+  // A patch that is not an object is copied too.
+  const array = [{ x: 1 }];
+  const replaced = applyMergePatch({}, array) as any;
+  assert.notEqual(replaced, array);
+  assert.notEqual(replaced[0], array[0]);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}, "a": {"__proto__": null}}');
+  const result = applyMergePatch(JSON.parse('{"a": {"__proto__": 1, "b": 2}}'), patch) as any;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as any).polluted, undefined);
+  assert.deepEqual(Object.getOwnPropertyDescriptor(result, "__proto__")?.value, { polluted: true });
+  assert.deepEqual(Object.keys(result.a), ["b"]);
+  // Inherited names are not mistaken for existing members.
+  assert.deepEqual(applyMergePatch({}, { toString: { a: 1 } }), JSON.parse('{"toString": {"a": 1}}'));
+});
+
+test("non-JSON arguments are rejected with a TypeError", () => {
+  const cyclic: Record<string, unknown> = {};
+  cyclic.self = cyclic;
+  for (const bad of [undefined, NaN, [1, , 3], { a: () => 1 }, new Date(0), cyclic]) {
+    assert.throws(() => applyMergePatch(bad, {}), TypeError);
+    assert.throws(() => applyMergePatch({}, bad), TypeError);
+    assert.throws(() => applyMergePatch({}, { a: bad }), TypeError);
+  }
+});
