--- a/src/index.ts
+++ b/src/index.ts
@@ -54,3 +54,189 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; path: string; from: string };
+
+function isObject(value: unknown): value is { [key: string]: JsonValue } {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+// Defines an own data property, so that a "__proto__" member stays a plain member.
+function setMember(target: { [key: string]: unknown }, key: string, value: unknown): void {
+  Object.defineProperty(target, key, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
+
+function clone<T>(value: T): T {
+  if (Array.isArray(value)) return value.map(clone) as T;
+  if (isObject(value)) {
+    const copy: { [key: string]: unknown } = {};
+    for (const key of Object.keys(value)) setMember(copy, key, clone(value[key]));
+    return copy as T;
+  }
+  return value;
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => deepEqual(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.prototype.hasOwnProperty.call(b, key) && deepEqual(a[key], b[key]))
+    );
+  }
+  return a === b;
+}
+
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  return pointer.slice(1).split("/").map(unescapeToken);
+}
+
+function arrayIndex(token: string, length: number, max: number): number {
+  if (!ARRAY_INDEX.test(token)) {
+    throw new Error(`Invalid array index "${token}"`);
+  }
+  const index = Number(token);
+  if (index > max) {
+    throw new Error(`Array index ${token} is out of range (length ${length})`);
+  }
+  return index;
+}
+
+function parentOf(document: unknown, tokens: string[]): unknown {
+  let current = document;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      current = current[arrayIndex(token, current.length, current.length - 1)];
+    } else if (isObject(current) && Object.prototype.hasOwnProperty.call(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path does not resolve at "${token}"`);
+    }
+  }
+  return current;
+}
+
+function getValue(document: unknown, pointer: string): unknown {
+  return resolvePointer(document, pointer);
+}
+
+function addValue(document: JsonValue, pointer: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(document, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (last === "-") parent.push(value);
+    else parent.splice(arrayIndex(last, parent.length, parent.length), 0, value);
+  } else if (isObject(parent)) {
+    setMember(parent, last, value);
+  } else {
+    throw new Error(`Cannot add at "${pointer}": parent is not a container`);
+  }
+  return document;
+}
+
+function removeValue(document: JsonValue, pointer: string): JsonValue {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) throw new Error("Cannot remove the document root");
+  getValue(document, pointer); // the target must exist
+  const parent = parentOf(document, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete (parent as { [key: string]: JsonValue })[last];
+  return document;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result.
+ *
+ * The input document and patch are never mutated. Throws if the patch is
+ * invalid or if any operation fails; in that case no result is returned.
+ */
+export function applyPatch(document: JsonValue, patch: readonly PatchOperation[]): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: must be an array of operations");
+  }
+  let result = clone(document);
+  for (const operation of patch as unknown[]) {
+    if (!isObject(operation)) {
+      throw new Error("Invalid JSON Patch: each operation must be an object");
+    }
+    const { op, path } = operation;
+    if (typeof path !== "string") {
+      throw new Error("Invalid JSON Patch: operation requires a string \"path\"");
+    }
+    const has = (name: string) => Object.prototype.hasOwnProperty.call(operation, name);
+    const needValue = () => {
+      if (!has("value")) throw new Error(`Invalid JSON Patch: "${op}" requires "value"`);
+      return clone(operation.value);
+    };
+    const needFrom = () => {
+      if (typeof operation.from !== "string") {
+        throw new Error(`Invalid JSON Patch: "${op}" requires a string "from"`);
+      }
+      return operation.from;
+    };
+
+    switch (op) {
+      case "add":
+        result = addValue(result, path, needValue());
+        break;
+      case "remove":
+        result = removeValue(result, path);
+        break;
+      case "replace": {
+        const value = needValue();
+        getValue(result, path); // the target must exist
+        if (path === "") result = value;
+        else result = addValue(removeValue(result, path), path, value);
+        break;
+      }
+      case "move": {
+        const from = needFrom();
+        parsePointer(path);
+        const value = clone(getValue(result, from)) as JsonValue;
+        if (from === path) break;
+        if (path.startsWith(from + "/")) {
+          throw new Error('Invalid "move": "from" must not be a proper prefix of "path"');
+        }
+        result = addValue(removeValue(result, from), path, value);
+        break;
+      }
+      case "copy": {
+        const from = needFrom();
+        result = addValue(result, path, clone(getValue(result, from)) as JsonValue);
+        break;
+      }
+      case "test": {
+        const value = needValue();
+        if (!deepEqual(getValue(result, path), value)) {
+          throw new Error(`Test failed at "${path}"`);
+        }
+        break;
+      }
+      default:
+        throw new Error(`Invalid JSON Patch: unknown operation "${String(op)}"`);
+    }
+  }
+  return result;
+}
diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..283387134fbd080bd6fc3e481fad4d6cb260b043
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,55 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("RFC 6902 operations", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(applyPatch({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "/a", value: 2 }]), { a: 2 });
+  assert.deepEqual(applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]),
+    { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(applyPatch({ a: [1] }, [{ op: "copy", from: "/a", path: "/b" }]), { a: [1], b: [1] });
+  assert.deepEqual(applyPatch({ a: { x: 1, y: 2 } }, [{ op: "test", path: "/a", value: { y: 2, x: 1 } }]), { a: { x: 1, y: 2 } });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+});
+
+test("errors", () => {
+  const bad = (doc: any, patch: any) => assert.throws(() => applyPatch(doc, patch));
+  bad({}, [{ op: "test", path: "/a", value: 1 }]);
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+  bad({}, [{ op: "remove", path: "/a" }]);
+  bad({}, [{ op: "replace", path: "/a", value: 1 }]);
+  bad({}, [{ op: "add", path: "/a/b", value: 1 }]);
+  bad([1], [{ op: "add", path: "/3", value: 1 }]);
+  bad([1], [{ op: "add", path: "/01", value: 1 }]);
+  bad({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  bad({}, [{ op: "add", path: "/a" }]);
+  bad({}, [{ op: "nope", path: "/a" }]);
+  bad({}, { op: "add" });
+  bad({}, [{ op: "move", path: "/a" }]);
+});
+
+test("does not mutate input, nor alias patch values", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const value = { z: 1 };
+  const out: any = applyPatch(doc, [
+    { op: "add", path: "/a/0", value: 0 },
+    { op: "add", path: "/v", value },
+    { op: "remove", path: "/b/c" },
+  ]);
+  assert.deepEqual(doc, { a: [1, 2], b: { c: 1 } });
+  out.v.z = 2;
+  assert.equal(value.z, 1);
+});
+
+test("__proto__ member is plain data", () => {
+  const out: any = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(({} as any).x, undefined);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+});
