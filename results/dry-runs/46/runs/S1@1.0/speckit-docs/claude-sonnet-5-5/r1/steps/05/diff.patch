diff --git a/src/index.ts b/src/index.ts
index 94d6eb6be98b3a51ba2e0f8aa842908a64c314c5..6f38a5946a453787df714bc9d5b1e32fb8538b9b 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -271,3 +271,59 @@ export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue
   }
   return result;
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffInto(from: JsonValue, to: JsonValue, path: string, out: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    let prefix = 0;
+    const shortest = Math.min(from.length, to.length);
+    while (prefix < shortest && deepEqual(from[prefix], to[prefix])) prefix++;
+    let suffix = 0;
+    while (
+      suffix < shortest - prefix &&
+      deepEqual(from[from.length - 1 - suffix], to[to.length - 1 - suffix])
+    ) {
+      suffix++;
+    }
+    const fromEnd = from.length - suffix;
+    const toEnd = to.length - suffix;
+    const common = Math.min(fromEnd, toEnd) - prefix;
+    for (let i = 0; i < common; i++) {
+      diffInto(from[prefix + i], to[prefix + i], `${path}/${prefix + i}`, out);
+    }
+    // surplus old items are removed from the end so earlier indices stay valid
+    for (let i = fromEnd - 1; i >= prefix + common; i--) {
+      out.push({ op: "remove", path: `${path}/${i}` });
+    }
+    for (let i = prefix + common; i < toEnd; i++) {
+      out.push({ op: "add", path: `${path}/${i}`, value: clone(to[i]) });
+    }
+  } else if (isObject(from) && isObject(to)) {
+    const has = (o: object, k: string) => Object.prototype.hasOwnProperty.call(o, k);
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (!has(from, key)) out.push({ op: "add", path: child, value: clone(to[key]) });
+      else diffInto(from[key], to[key], child, out);
+    }
+  } else if (!deepEqual(from, to)) {
+    out.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Computes a JSON Patch (RFC 6902) that turns `from` into `to` when applied.
+ *
+ * Only the parts that differ are described. Neither input is mutated, and the
+ * patch shares no structure with them.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  const out: PatchOperation[] = [];
+  diffInto(from, to, "", out);
+  return out;
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2b3ad0b5d477869042c39c4ce3b4dfc438d77a31
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,52 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch, type JsonValue } from "../src/index.ts";
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(createPatch({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small change yields a small patch", () => {
+  const patch = createPatch({ a: { b: 1, c: [1, 2, 3] }, d: "x" }, { a: { b: 1, c: [1, 2, 3] }, d: "y" });
+  assert.deepEqual(patch, [{ op: "replace", path: "/d", value: "y" }]);
+});
+
+test("array insertion at the front is a single add", () => {
+  assert.deepEqual(createPatch([1, 2, 3], [0, 1, 2, 3]), [{ op: "add", path: "/0", value: 0 }]);
+});
+
+test("keys are escaped", () => {
+  assert.deepEqual(createPatch({ "a/b": 1, "~": 1 }, { "a/b": 2, "~": 1 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+  ]);
+});
+
+test("does not mutate inputs or alias them", () => {
+  const from = { a: 1 } as JsonValue;
+  const to = { a: 1, b: { c: [1] } } as JsonValue;
+  const patch = createPatch(from, to);
+  assert.deepEqual(from, { a: 1 });
+  (patch[0] as { value: any }).value.c.push(2);
+  assert.deepEqual(to, { a: 1, b: { c: [1] } });
+});
+
+test("random round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff), seed % n);
+  const gen = (d: number): JsonValue => {
+    const k = rnd(d > 2 ? 4 : 6);
+    if (k === 0) return rnd(3);
+    if (k === 1) return ["a", "b/c", "~"][rnd(3)];
+    if (k === 2) return null;
+    if (k === 3) return rnd(2) === 0;
+    if (k === 4) return Array.from({ length: rnd(5) }, () => gen(d + 1));
+    const o: { [k: string]: JsonValue } = {};
+    for (let i = rnd(4); i > 0; i--) o[["a", "b", "a/b", "~0", "__proto__"][rnd(5)]] = gen(d + 1);
+    return o;
+  };
+  for (let i = 0; i < 3000; i++) {
+    const a = gen(0);
+    const b = gen(0);
+    assert.deepEqual(applyPatch(a, createPatch(a, b)), b);
+  }
+});
