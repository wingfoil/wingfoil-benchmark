index 7f134c95fa57c027a8ac56e9935380a1c73f5fc3..94d6eb6be98b3a51ba2e0f8aa842908a64c314c5 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -250,3 +250,24 @@ export function applyPatch(document: JsonValue, patch: readonly PatchOperation[]
   }
   return result;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the result.
+ *
+ * The input target and patch are never mutated. A non-object patch replaces the
+ * target; in an object patch, a null member removes the member from the target.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isObject(patch)) return clone(patch);
+  const result: { [key: string]: JsonValue } = isObject(target) ? clone(target) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = Object.prototype.hasOwnProperty.call(result, key) ? result[key] : undefined;
+      setMember(result, key, applyMergePatch(current as JsonValue, value));
+    }
+  }
+  return result;
+}
diff --git a/test/merge.test.ts b/test/merge.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e19d67cff62b7244f74ccf85a5b0f17bd23a9703
--- /dev/null
+++ b/test/merge.test.ts
@@ -0,0 +1,35 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("applyMergePatch follows RFC 7386 examples", () => {
+  const cases: [any, any, any][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("applyMergePatch does not mutate its inputs", () => {
+  const t = { a: { b: 1 } };
+  const p = { a: { b: null, c: { d: 1 } } };
+  const r = applyMergePatch(t, p) as any;
+  assert.deepEqual(t, { a: { b: 1 } });
+  r.a.c.d = 2;
+  assert.equal(p.a.c.d, 1);
+});
