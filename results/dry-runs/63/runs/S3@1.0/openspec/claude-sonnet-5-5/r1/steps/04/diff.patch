diff --git a/test/rental.test.ts b/test/rental.test.ts
index 1b666c7e93f5c9c5ba6d523403bc250907d77750..30b61bd21391099d805210bb54a670000362d4bd 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -132,3 +132,48 @@ test('booking shows the discounted total', () => {
   const s = setup();
   assert.equal(s.book({ itemId: 's1', start: d(1), end: d(4) }).total, 6750);
 });
+
+const h = (hour: number, day = 1) => `2026-07-${String(day).padStart(2, '0')}T${String(hour).padStart(2, '0')}:00:00Z`;
+
+function hourly() {
+  const s = setup();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 4000, hourlyPrice: 800 });
+  return s;
+}
+
+test('hourly rental is priced per hour without discount', () => {
+  const s = hourly();
+  assert.equal(s.quote({ itemId: 'h1', start: h(13), end: h(16) }).total, 2400);
+  assert.equal(s.quote({ itemId: 'h1', start: h(0), end: h(23) }).total, 18400);
+  assert.equal(s.book({ itemId: 'h1', start: h(13), end: h(16) }).total, 2400);
+});
+
+test('hourly rental needs an hourly price', () => {
+  const s = hourly();
+  assert.throws(() => s.quote({ itemId: 'b1', start: h(13), end: h(16) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: h(13), end: h(16) }));
+  s.book({ itemId: 'b1', start: d(1), end: d(2) });
+});
+
+test('hourly periods must be on the hour and short rentals only', () => {
+  const s = hourly();
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-07-01T13:30:00Z', end: h(16) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: h(10), end: d(3) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: h(10), end: h(10, 2) }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: h(13), end: h(13) }));
+});
+
+test('invalid hourlyPrice is rejected', () => {
+  const s = createRentalService();
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+});
+
+test('hourly bookings overlap by instant and show in availability', () => {
+  const s = hourly();
+  s.book({ itemId: 'h1', start: h(13), end: h(16) });
+  assert.throws(() => s.book({ itemId: 'h1', start: h(15), end: h(17) }));
+  s.book({ itemId: 'h1', start: h(16), end: h(18) });
+  assert.ok(!s.availability({ start: h(15), end: h(17), kind: 'board' }).includes('h1'));
+  assert.ok(s.availability({ start: h(18), end: h(19), kind: 'board' }).includes('h1'));
+});
