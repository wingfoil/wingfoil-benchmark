diff --git a/src/index.ts b/src/index.ts
index dcfe8576d2fe0643bacdb113c18f497421aa25f3..f2908f62d98e7c1d49f294d2128ca0cd55e18208 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -23,10 +23,17 @@ export interface Booking extends Quote {
   id: string;
 }
 
+export interface AvailabilityQuery {
+  start: string;
+  end: string;
+  kind?: EquipmentKind;
+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  availability(query: AvailabilityQuery): string[];
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
@@ -42,16 +49,25 @@ function parseInstant(value: unknown, name: string): number {
   return ms;
 }
 
+function parsePeriod(start: unknown, end: unknown) {
+  const startMs = parseInstant(start, 'start');
+  const endMs = parseInstant(end, 'end');
+  if (endMs <= startMs) throw new Error('end must be after start');
+  return { startMs, endMs };
+}
+
 export function createRentalService(): RentalService {
   const items = new Map<string, Equipment>();
   const bookings: (Booking & { startMs: number; endMs: number })[] = [];
 
+  function isFree(itemId: string, startMs: number, endMs: number) {
+    return !bookings.some((b) => b.itemId === itemId && b.startMs < endMs && startMs < b.endMs);
+  }
+
   function price(request: RentalRequest) {
     const item = items.get(request?.itemId);
     if (!item) throw new Error(`unknown item: ${request?.itemId}`);
-    const startMs = parseInstant(request.start, 'start');
-    const endMs = parseInstant(request.end, 'end');
-    if (endMs <= startMs) throw new Error('end must be after start');
+    const { startMs, endMs } = parsePeriod(request.start, request.end);
     const total = item.dailyPrice * ((endMs - startMs) / DAY_MS);
     return { startMs, endMs, quote: { itemId: item.id, start: request.start, end: request.end, total } };
   }
@@ -73,13 +89,20 @@ export function createRentalService(): RentalService {
 
     book(request) {
       const { startMs, endMs, quote } = price(request);
-      const clash = bookings.some(
-        (b) => b.itemId === quote.itemId && b.startMs < endMs && startMs < b.endMs,
-      );
-      if (clash) throw new Error(`item ${quote.itemId} is not free for that period`);
+      if (!isFree(quote.itemId, startMs, endMs)) throw new Error(`item ${quote.itemId} is not free for that period`);
       const booking = { id: `booking-${bookings.length + 1}`, ...quote };
       bookings.push({ ...booking, startMs, endMs });
       return booking;
     },
+
+    availability(query) {
+      const { start, end, kind } = query ?? ({} as AvailabilityQuery);
+      const { startMs, endMs } = parsePeriod(start, end);
+      if (kind !== undefined && kind !== 'board' && kind !== 'sail') throw new Error('invalid kind');
+      return [...items.values()]
+        .filter((item) => (kind === undefined || item.kind === kind) && isFree(item.id, startMs, endMs))
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
diff --git a/test/rental.test.ts b/test/rental.test.ts
index 217bf7754fa10dda84ae988fdd0e1cc88926374e..9a50fa7a49bc073dbe2db5595f046719b3d44948 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -68,3 +68,46 @@ test('overlaps are rejected, adjacent and other items are fine', () => {
   s.book({ itemId: 'b1', start: '2026-06-29T00:00:00Z', end: d(1) });
   s.book({ itemId: 's1', start: d(1), end: d(4) });
 });
+
+function stock() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 4000 });
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 4000 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 2500 });
+  return s;
+}
+
+test('availability lists all kinds sorted, or filters by kind', () => {
+  const s = stock();
+  assert.deepEqual(s.availability({ start: d(1), end: d(3) }), ['b1', 'b2', 's1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3), kind: 'sail' }), ['s1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3), kind: 'board' }), ['b1', 'b2']);
+});
+
+test('availability excludes items booked for any part of the period', () => {
+  const s = stock();
+  s.book({ itemId: 'b1', start: d(2), end: d(4) });
+  s.book({ itemId: 'b2', start: d(3), end: d(5) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(3) }), ['b2', 's1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(4) }), ['s1']);
+});
+
+test('availability treats back to back bookings as free', () => {
+  const s = stock();
+  s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.deepEqual(s.availability({ start: d(3), end: d(5), kind: 'board' }), ['b1', 'b2']);
+});
+
+test('availability can be empty and does not reserve', () => {
+  const s = stock();
+  assert.deepEqual(createRentalService().availability({ start: d(1), end: d(2) }), []);
+  s.availability({ start: d(1), end: d(3) });
+  s.book({ itemId: 'b1', start: d(1), end: d(3) });
+});
+
+test('availability rejects invalid queries', () => {
+  const s = stock();
+  assert.throws(() => s.availability({ start: '2026-07-01T10:00:00Z', end: d(3) }));
+  assert.throws(() => s.availability({ start: d(3), end: d(3) }));
+  assert.throws(() => s.availability({ start: d(1), end: d(3), kind: 'kayak' as any }));
+});
