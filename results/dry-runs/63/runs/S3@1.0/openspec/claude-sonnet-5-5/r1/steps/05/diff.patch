@@ -177,3 +177,66 @@ test('hourly bookings overlap by instant and show in availability', () => {
   assert.ok(!s.availability({ start: h(15), end: h(17), kind: 'board' }).includes('h1'));
   assert.ok(s.availability({ start: h(18), end: h(19), kind: 'board' }).includes('h1'));
 });
+
+const at = (day: number, hh = 0, mm = 0) =>
+  `2026-06-${String(day).padStart(2, '0')}T${String(hh).padStart(2, '0')}:${String(mm).padStart(2, '0')}:00Z`;
+
+test('cancel refunds in full well in advance', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.deepEqual(s.cancel(b.id, at(29)), { bookingId: b.id, refund: 8000 });
+});
+
+test('cancel refunds the discounted total', () => {
+  const s = setup();
+  const b = s.book({ itemId: 's1', start: d(1), end: d(4) });
+  assert.equal(s.cancel(b.id, at(20)).refund, 6750);
+});
+
+test('cancel exactly 24 hours before is fully refunded, a minute later is not', () => {
+  const s = setup();
+  const b1 = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  const b2 = s.book({ itemId: 's1', start: d(1), end: d(3) });
+  assert.equal(s.cancel(b1.id, at(30)).refund, 8000);
+  assert.equal(s.cancel(b2.id, at(30, 0, 1)).refund, 0);
+});
+
+test('cancel after the start gives no refund', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.equal(s.cancel(b.id, d(2)).refund, 0);
+});
+
+test('cancel works on hourly bookings', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 4000, hourlyPrice: 800 });
+  const b = s.book({ itemId: 'b2', start: '2026-07-01T13:00:00Z', end: '2026-07-01T16:00:00Z' });
+  assert.equal(s.cancel(b.id, '2026-06-30T13:00:00Z').refund, 2400);
+});
+
+test('a booking can only be cancelled once', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  s.cancel(b.id, at(20));
+  assert.throws(() => s.cancel(b.id, at(21)));
+});
+
+test('cancel rejects unknown bookings and invalid times without changing anything', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.throws(() => s.cancel('nope', at(20)));
+  assert.throws(() => s.cancel(b.id, 'yesterday'));
+  assert.throws(() => s.cancel(b.id, '2026-06-20T00:00:00+02:00'));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(1), end: d(3) }));
+  assert.equal(s.cancel(b.id, at(20)).refund, 8000);
+});
+
+test('a cancelled booking frees its item and ids are not reused', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.ok(!s.availability({ start: d(1), end: d(3) }).includes('b1'));
+  s.cancel(b.id, at(20));
+  assert.ok(s.availability({ start: d(1), end: d(3) }).includes('b1'));
+  const b2 = s.book({ itemId: 'b1', start: d(3), end: d(5) });
+  assert.notEqual(b2.id, b.id);
+});
