index 0000000000000000000000000000000000000000..217bf7754fa10dda84ae988fdd0e1cc88926374e
--- /dev/null
+++ b/test/rental.test.ts
@@ -0,0 +1,70 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+const d = (day: number) => `2026-07-${String(day).padStart(2, '0')}T00:00:00Z`;
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 4000 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 2500 });
+  return s;
+}
+
+test('quote multiplies the daily price by days', () => {
+  const s = setup();
+  assert.deepEqual(s.quote({ itemId: 's1', start: d(1), end: d(4) }), {
+    itemId: 's1', start: d(1), end: d(4), total: 7500,
+  });
+});
+
+test('quote does not reserve', () => {
+  const s = setup();
+  s.quote({ itemId: 'b1', start: d(1), end: d(3) });
+  s.book({ itemId: 'b1', start: d(1), end: d(3) });
+});
+
+test('unknown item and bad equipment throw', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'x', start: d(1), end: d(2) }));
+  assert.throws(() => s.book({ itemId: 'x', start: d(1), end: d(2) }));
+  assert.throws(() => s.addEquipment({ id: 'k', kind: 'kayak' as any, dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'k', kind: 'board', dailyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+});
+
+test('invalid periods throw', () => {
+  const s = setup();
+  for (const [start, end] of [
+    ['2026-07-01T10:00:00Z', d(3)],
+    [d(1), '2026-07-03T00:00:01Z'],
+    [d(3), d(3)],
+    [d(3), d(1)],
+    ['2026-07-01', d(3)],
+    ['nonsense', d(3)],
+    ['2026-07-01T00:00:00+02:00', d(3)],
+  ]) {
+    assert.throws(() => s.quote({ itemId: 'b1', start, end }), `${start}..${end}`);
+    assert.throws(() => s.book({ itemId: 'b1', start, end }));
+  }
+});
+
+test('book returns a booking with distinct ids', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  const b = s.book({ itemId: 's1', start: d(1), end: d(3) });
+  assert.equal(a.total, 8000);
+  assert.equal(a.itemId, 'b1');
+  assert.notEqual(a.id, b.id);
+});
+
+test('overlaps are rejected, adjacent and other items are fine', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.throws(() => s.book({ itemId: 'b1', start: d(3), end: d(5) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(2), end: d(3) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(1), end: d(2) }));
+  s.book({ itemId: 'b1', start: d(4), end: d(6) });
+  s.book({ itemId: 'b1', start: '2026-06-29T00:00:00Z', end: d(1) });
+  s.book({ itemId: 's1', start: d(1), end: d(4) });
+});
