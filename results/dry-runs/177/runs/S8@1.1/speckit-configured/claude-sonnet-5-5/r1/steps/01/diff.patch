diff --git a/test/list.test.ts b/test/list.test.ts
index ebc295e05b49efd10dcbc4231db28ee3c2593787..bc15b5cf7898f04499692c5a4ea9668f0ee203f9 100644
--- a/test/list.test.ts
+++ b/test/list.test.ts
@@ -9,10 +9,44 @@ function valueOf<T>(result: { ok: true; value: T } | { ok: false; error: unknown
 }
 
 describe('task list', () => {
+  it('gives each task a unique id that survives a rename', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    const b = valueOf(list.add({ title: 'b' }));
+    assert.equal(typeof a.id, 'string');
+    assert.notEqual(a.id, b.id);
+    valueOf(list.rename('a', 'renamed'));
+    assert.equal(valueOf(list.get(a.id)).title, 'renamed');
+    assert.equal(valueOf(list.find(a.id)).title, 'renamed');
+  });
+
+  it('does not reuse the id of a removed task', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    list.remove(a.id);
+    const b = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(a.id, b.id);
+    const missing = list.get(a.id);
+    assert.equal(missing.ok, false);
+    if (!missing.ok) assert.equal(missing.error.code, 'not-found');
+  });
+
+  it('accepts an id wherever a title is accepted', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'a' }));
+    assert.equal(valueOf(list.complete(id)).status, 'done');
+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.deepEqual(valueOf(list.tag(id, 'x')).tags, ['x']);
+    assert.deepEqual(valueOf(list.untag(id, 'x')).tags, []);
+    assert.equal(valueOf(list.rename(id, 'b')).title, 'b');
+    assert.equal(valueOf(list.remove(id)).title, 'b');
+    assert.equal(list.find(id).ok, false);
+  });
+
   it('adds an open task with a normal priority by default', () => {
     const list = createTodoList();
     const task = valueOf(list.add({ title: '  Buy milk ' }));
-    assert.deepEqual(task, { title: 'Buy milk', priority: 'normal', tags: [], status: 'open' });
+    assert.deepEqual(task, { id: task.id, title: 'Buy milk', priority: 'normal', tags: [], status: 'open' });
     assert.equal(list.openCount(), 1);
   });
 
