@@ -0,0 +1,64 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList } from '../src/index.ts';
+import type { NewTask, Result } from '../src/index.ts';
+
+function rejected(result: Result<unknown>): string {
+  assert.equal(result.ok, false);
+  if (result.ok) return '';
+  assert.equal(result.error.code, 'invalid-input');
+  return result.error.message;
+}
+
+describe('input validation', () => {
+  it('rejects empty and blank titles on add', () => {
+    const list = createTodoList();
+    assert.match(rejected(list.add({ title: '' })), /empty/);
+    assert.match(rejected(list.add({ title: '   ' })), /empty/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects titles over 120 characters but accepts 120', () => {
+    const list = createTodoList();
+    assert.match(rejected(list.add({ title: 'x'.repeat(121) })), /120/);
+    assert.equal(list.add({ title: ` ${'x'.repeat(120)} ` }).ok, true);
+    assert.equal(list.list().length, 1);
+  });
+
+  it('rejects an unknown priority', () => {
+    const list = createTodoList();
+    const input = { title: 'a', priority: 'urgent' } as unknown as NewTask;
+    assert.match(rejected(list.add(input)), /urgent/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects bad tags on add without changing the list or ids', () => {
+    const list = createTodoList();
+    assert.match(rejected(list.add({ title: 'a', tags: ['ok', ''] })), /empty/);
+    assert.match(rejected(list.add({ title: 'a', tags: ['two words'] })), /space/);
+    assert.equal(list.list().length, 0);
+    const added = list.add({ title: 'a' });
+    assert.equal(added.ok && added.value.id, 'task-1');
+  });
+
+  it('rejects an invalid rename and leaves the task as it was', () => {
+    const list = createTodoList(() => '2026-01-01T00:00:00.000Z');
+    list.add({ title: 'a' });
+    const before = list.list();
+    rejected(list.rename('a', '  '));
+    rejected(list.rename('a', 'y'.repeat(121)));
+    assert.deepEqual(list.list(), before);
+  });
+
+  it('rejects an invalid tag and leaves the task as it was', () => {
+    const list = createTodoList();
+    list.add({ title: 'a' });
+    const before = list.list();
+    rejected(list.tag('a', ''));
+    rejected(list.tag('a', 'has space'));
+    assert.deepEqual(list.list(), before);
+    const ok = list.tag('a', 'fine');
+    assert.equal(ok.ok, true);
+  });
+});
