+
+describe('timestamps', () => {
+  function clocked() {
+    let tick = 0;
+    const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, ++tick)).toISOString());
+    return list;
+  }
+
+  it('gives a new task equal createdAt and updatedAt as ISO-8601 strings', () => {
+    const task = valueOf(clocked().add({ title: 'a' }));
+    assert.equal(task.createdAt, task.updatedAt);
+    assert.equal(task.createdAt, new Date(task.createdAt).toISOString());
+  });
+
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    const list = clocked();
+    const created = valueOf(list.add({ title: 'a' }));
+    let previous = created.updatedAt;
+    const changes = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.rename('a', 'b'),
+      () => list.tag('b', 'x'),
+      () => list.untag('b', 'x'),
+    ];
+    for (const change of changes) {
+      const task = valueOf(change());
+      assert.equal(task.createdAt, created.createdAt);
+      assert.ok(task.updatedAt > previous);
+      previous = task.updatedAt;
+    }
+  });
+
+  it('uses the system clock by default', () => {
+    const task = valueOf(createTodoList().add({ title: 'a' }));
+    assert.ok(Math.abs(Date.now() - Date.parse(task.createdAt)) < 5000);
+  });
+});
