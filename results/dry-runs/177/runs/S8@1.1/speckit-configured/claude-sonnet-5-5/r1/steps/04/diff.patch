+import type { TaskList } from './list.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** A line of the import text that could not be added: its number, from 1, and why. */
+export interface ImportRejection {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
+/**
+ * Adds tasks to a list from text with one task per line, as `title;priority;tags`. The priority may be
+ * empty for a normal one, and tags are separated by spaces. Blank lines are skipped; every other line
+ * that is valid is added, and each one that is not is reported with its line number, counting from 1.
+ *
+ * @param list - the task list to add to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: ImportRejection[] = [];
+  let imported = 0;
+  text.split(/\r?\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const line = index + 1;
+    const fields = raw.split(';');
+    if (fields.length > 3) {
+      rejected.push({ line, reason: `the line has ${fields.length} parts; use title;priority;tags` });
+      return;
+    }
+    const [title = '', priority = '', tags = ''] = fields.map((field) => field.trim());
+    const input: NewTask = {
+      title,
+      ...(priority === '' ? {} : { priority: priority as Priority }),
+      tags: tags === '' ? [] : tags.split(/\s+/),
+    };
+    const added = list.add(input);
+    if (added.ok) imported += 1;
+    else rejected.push({ line, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
