+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds tasks with priority and tags', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\nWater plants;;home\nCall mum');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const task = list.find('Renew the insurance');
+    assert.ok(task.ok);
+    assert.equal(task.value.priority, 'high');
+    assert.deepEqual(task.value.tags, ['admin', 'money']);
+    const plants = list.find('Water plants');
+    assert.ok(plants.ok);
+    assert.equal(plants.value.priority, 'normal');
+    assert.deepEqual(plants.value.tags, ['home']);
+  });
+
+  it('skips blank lines but counts them in line numbers', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'a\r\n\r\n   \r\n;high;x\nb;urgent\nc;;bad;extra\na');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(report.rejected.map((r) => r.line), [4, 5, 6, 7]);
+    assert.match(report.rejected[0]!.reason, /empty/);
+    assert.match(report.rejected[1]!.reason, /urgent/);
+    assert.match(report.rejected[3]!.reason, /already/);
+    assert.equal(list.list().length, 1);
+  });
+
+  it('rejects bad tags and long titles without stopping', () => {
+    const list = createTodoList();
+    const report = importTasks(list, `${'x'.repeat(121)};;t\nok;low;t1 t1`);
+    assert.equal(report.imported, 1);
+    assert.equal(report.rejected.length, 1);
+    assert.match(report.rejected[0]!.reason, /120/);
+  });
+
+  it('handles empty text', () => {
+    assert.deepEqual(importTasks(createTodoList(), ''), { imported: 0, rejected: [] });
+  });
+});
