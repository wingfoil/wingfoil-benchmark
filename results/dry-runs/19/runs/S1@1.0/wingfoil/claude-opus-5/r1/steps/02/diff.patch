+function failed(
+  operation: CheckedOperation,
+  reason: string,
+  options?: ErrorOptions,
+): PatchOperationError {
+  return new PatchOperationError(`${describe(operation)} failed: ${reason}`, options);
+}
+
+function quote(text: string): string {
+  return JSON.stringify(text);
+}
