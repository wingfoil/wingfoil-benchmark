+
+      assert.deepEqual(result, {
+        items: [{ id: 'b' }],
+        first: { id: 'a' },
+        total: 2,
+      });
+      assert.deepEqual(document, { items: [], count: 0 });
+    });
+
+    it('applies an operation that undoes the one before it', () => {
+      const document: JsonValue = { a: 1 };
+      assert.deepEqual(
+        applyPatch(document, [
