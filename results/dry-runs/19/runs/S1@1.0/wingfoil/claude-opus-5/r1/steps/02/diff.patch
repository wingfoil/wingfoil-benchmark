diff --git a/src/json-document.ts b/src/json-document.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9228486f48a964bb16ff17e4f6e06e056ac9251d
--- /dev/null
+++ b/src/json-document.ts
@@ -0,0 +1,141 @@
+/**
+ * Operations on a JSON document as a whole: copying it, and writing a member of
+ * one of its objects.
+ *
+ * Both are what an operation that updates a document needs and a JavaScript
+ * object does not give for free: a copy that shares nothing with the original,
+ * and a member whose name cannot reach JavaScript's own machinery.
+ */
+
+import { formatPointer } from './json-pointer.ts';
+import { describeJson } from './json-value.ts';
+import type { JsonArray, JsonObject, JsonValue } from './json-value.ts';
+
+/**
+ * Returns a deep copy of a JSON value: no object and no array is shared with
+ * the original, so one can be changed without the other noticing.
+ *
+ * It is also where the JSON data model is checked. The types say a document is
+ * a `JsonValue`, but a document reaching the toolkit from untyped code may hold
+ * anything; a value JavaScript admits and JSON does not — `undefined`, a
+ * function, `NaN`, a `Date`, a cycle — would otherwise be copied into a
+ * document that no longer serialises, or make the copy run forever.
+ *
+ * @param value - The value to copy.
+ * @returns A copy of `value`, sharing nothing with it.
+ * @throws {TypeError} If `value`, or anything inside it, is not a JSON value.
+ */
+export function cloneJson(value: JsonValue): JsonValue {
+  return clone(value, [], new Set());
+}
+
+/**
+ * Writes an own member of a JSON object.
+ *
+ * Plain assignment would let a member name reach the machinery JavaScript keeps
+ * on `Object.prototype`: `__proto__` has a setter there, so `object.__proto__ =
+ * value` changes the object's prototype instead of giving it a member. JSON has
+ * no such name — `{"__proto__": 1}` is an ordinary member — so the write goes
+ * through `Object.defineProperty`, which gives every name the member it
+ * deserves: own, enumerable and writable.
+ */
+export function setMember(object: JsonObject, name: string, value: JsonValue): void {
+  Object.defineProperty(object, name, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
+
+/**
+ * Copies one value.
+ *
+ * @param value - The value to copy, not trusted to be a JSON value.
+ * @param at - The reference tokens leading to `value`, for error messages.
+ * @param ancestors - The objects and arrays being copied above `value`, which
+ * `value` cannot be one of without the document holding a cycle.
+ */
+function clone(value: unknown, at: string[], ancestors: Set<object>): JsonValue {
+  if (value === null) {
+    return null;
+  }
+  if (typeof value === 'boolean' || typeof value === 'string') {
+    return value;
+  }
+  if (typeof value === 'number') {
+    // JSON has no NaN and no infinities.
+    if (!Number.isFinite(value)) {
+      throw notJson(at, `the number ${value}`);
+    }
+    return value;
+  }
+  if (typeof value !== 'object') {
+    throw notJson(at, describeForeign(value));
+  }
+
+  if (ancestors.has(value)) {
+    throw notJson(at, 'a reference back to a value that contains it');
+  }
+  ancestors.add(value);
+  try {
+    return Array.isArray(value)
+      ? cloneArray(value, at, ancestors)
+      : cloneObject(value, at, ancestors);
+  } finally {
+    ancestors.delete(value);
+  }
+}
+
+function cloneArray(value: readonly unknown[], at: string[], ancestors: Set<object>): JsonArray {
+  const copy: JsonArray = [];
+  value.forEach((element, index) => {
+    at.push(String(index));
+    copy.push(clone(element, at, ancestors));
+    at.pop();
+  });
+  return copy;
+}
+
+function cloneObject(value: object, at: string[], ancestors: Set<object>): JsonObject {
+  if (!isPlainObject(value)) {
+    throw notJson(at, describeForeign(value));
+  }
+
+  const copy: JsonObject = {};
+  // Own enumerable string-named members only, which is what JSON has and what
+  // `JSON.stringify` would keep.
+  for (const [name, member] of Object.entries(value)) {
+    at.push(name);
+    setMember(copy, name, clone(member, at, ancestors));
+    at.pop();
+  }
+  return copy;
+}
+
+/**
+ * An object is part of the JSON data model when it carries nothing but its
+ * members: a class instance has behaviour that a copy would silently drop.
+ */
+function isPlainObject(value: object): boolean {
+  const prototype: unknown = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
+
+function notJson(at: string[], what: string): TypeError {
+  const where = at.length === 0 ? 'the value' : `the value at ${JSON.stringify(formatPointer(at))}`;
+  return new TypeError(`${where} is ${what}, which a JSON document cannot hold`);
+}
+
+/** Names a value the JSON data model has no room for. */
+function describeForeign(value: unknown): string {
+  if (typeof value === 'object' && value !== null) {
+    const prototype: unknown = Object.getPrototypeOf(value);
+    const name: unknown = (prototype as { constructor?: { name?: unknown } } | null)?.constructor
+      ?.name;
+    return typeof name === 'string' && name !== ''
+      ? `an instance of ${name}`
+      : 'an object with a prototype of its own';
+  }
+  return describeJson(value);
+}
diff --git a/src/json-patch-errors.ts b/src/json-patch-errors.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dfb2024cfd086d2425d3f140b382a28ad714691e
--- /dev/null
+++ b/src/json-patch-errors.ts
@@ -0,0 +1,52 @@
+/**
+ * The errors `applyPatch` throws, in the shape RFC 6902 gives its failures: a
+ * patch that is not a JSON Patch at all, and an operation that cannot be
+ * carried out against the document it is given.
+ */
+
+/** Base class of every error a patch raises, so one `catch` covers them all. */
+export class JsonPatchError extends Error {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = 'JsonPatchError';
+  }
+}
+
+/**
+ * The patch is not a valid JSON Patch document: it is not an array of
+ * operations, an operation has no known `op`, a member it needs is missing or
+ * of the wrong kind, or an operation could not succeed against any document.
+ *
+ * It depends on the patch alone, so it is raised before the document is read.
+ */
+export class InvalidPatchError extends JsonPatchError {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = 'InvalidPatchError';
+  }
+}
+
+/**
+ * The patch is valid, but one of its operations failed against this document:
+ * the location it names does not exist, or cannot hold what it would write.
+ */
+export class PatchOperationError extends JsonPatchError {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = 'PatchOperationError';
+  }
+}
+
+/**
+ * A `test` operation found a value different from the one it was given.
+ *
+ * It is the one failure a patch is written to produce: a `test` guards the
+ * operations that follow it, so a caller using a patch as a conditional update
+ * can catch this alone and retry, and still hear about every other failure.
+ */
+export class TestFailedError extends PatchOperationError {
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, options);
+    this.name = 'TestFailedError';
+  }
+}
diff --git a/src/json-patch-operation.ts b/src/json-patch-operation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dbd366d951bfc41c1a67f6987e2ecb3da174f556
--- /dev/null
+++ b/src/json-patch-operation.ts
@@ -0,0 +1,246 @@
+/**
+ * The operations of a JSON Patch (RFC 6902, sections 3 and 4): the shape a
+ * caller writes them in, and the check that turns a patch handed in at run time
+ * into operations the rest of the module can trust.
+ */
+
+import { cloneJson } from './json-document.ts';
+import { InvalidPatchError } from './json-patch-errors.ts';
+import { formatPointer, JsonPointerError, parsePointer } from './json-pointer.ts';
+import { describeJson } from './json-value.ts';
+import type { JsonValue } from './json-value.ts';
+
+/** Adds `value` at `path`, or replaces what is already there. */
+export interface AddOperation {
+  readonly op: 'add';
+  readonly path: string;
+  readonly value: JsonValue;
+}
+
+/** Removes the value at `path`, which must exist. */
+export interface RemoveOperation {
+  readonly op: 'remove';
+  readonly path: string;
+}
+
+/** Replaces the value at `path`, which must exist, by `value`. */
+export interface ReplaceOperation {
+  readonly op: 'replace';
+  readonly path: string;
+  readonly value: JsonValue;
+}
+
+/** Moves the value at `from`, which must exist, to `path`. */
+export interface MoveOperation {
+  readonly op: 'move';
+  readonly from: string;
+  readonly path: string;
+}
+
+/** Copies the value at `from`, which must exist, to `path`. */
+export interface CopyOperation {
+  readonly op: 'copy';
+  readonly from: string;
+  readonly path: string;
+}
+
+/** Succeeds when the value at `path` is equal to `value`, and fails otherwise. */
+export interface TestOperation {
+  readonly op: 'test';
+  readonly path: string;
+  readonly value: JsonValue;
+}
+
+/** One operation of a JSON Patch: the six of RFC 6902, section 4. */
+export type PatchOperation =
+  | AddOperation
+  | RemoveOperation
+  | ReplaceOperation
+  | MoveOperation
+  | CopyOperation
+  | TestOperation;
+
+/** A JSON Patch: the operations to apply to a document, in order. */
+export type JsonPatch = readonly PatchOperation[];
+
+/** A location an operation works on: the pointer as written, and its tokens. */
+export interface Location {
+  readonly pointer: string;
+  readonly tokens: readonly string[];
+}
+
+/**
+ * An operation that has passed {@link checkPatch}: its pointers are parsed, its
+ * value is a copy of the one the patch carries, and it knows its own position
+ * in the patch so that an error can name it.
+ */
+export type CheckedOperation = { readonly index: number } & (
+  | { readonly op: 'add'; readonly target: Location; readonly value: JsonValue }
+  | { readonly op: 'remove'; readonly target: Location }
+  | { readonly op: 'replace'; readonly target: Location; readonly value: JsonValue }
+  | { readonly op: 'move'; readonly target: Location; readonly source: Location }
+  | { readonly op: 'copy'; readonly target: Location; readonly source: Location }
+  | { readonly op: 'test'; readonly target: Location; readonly value: JsonValue }
+);
+
+const OPERATION_NAMES = ['add', 'remove', 'replace', 'move', 'copy', 'test'] as const;
+
+/**
+ * Checks a patch against the JSON Patch format, and returns its operations
+ * ready to be applied.
+ *
+ * Everything that can be decided without the document is decided here, for the
+ * whole patch, before any of it is applied: a mistyped `op` in the last
+ * operation is reported as such, rather than hidden behind the failure of an
+ * earlier one.
+ *
+ * @param patch - The patch to check, as handed to `applyPatch`.
+ * @returns One checked operation per operation of the patch, in order.
+ * @throws {InvalidPatchError} If the patch is not a valid JSON Patch document.
+ */
+export function checkPatch(patch: JsonPatch): CheckedOperation[] {
+  if (!Array.isArray(patch)) {
+    throw new InvalidPatchError(
+      `a JSON Patch must be an array of operations, not ${describeJson(patch)}`,
+    );
+  }
+  return (patch as readonly unknown[]).map((operation, index) => checkOperation(operation, index));
+}
+
+function checkOperation(operation: unknown, index: number): CheckedOperation {
+  if (typeof operation !== 'object' || operation === null || Array.isArray(operation)) {
+    throw invalid(`operation ${index} is not an object, but ${describeJson(operation)}`);
+  }
+
+  const op = checkOperationName(operation, index);
+  const target = checkLocation(operation, 'path', op, index);
+
+  switch (op) {
+    case 'add':
+      return { index, op, target, value: checkValue(operation, op, index) };
+    case 'replace':
+      return { index, op, target, value: checkValue(operation, op, index) };
+    case 'test':
+      return { index, op, target, value: checkValue(operation, op, index) };
+    case 'remove':
+      if (target.tokens.length === 0) {
+        throw invalid(
+          `${describe(op, index)} cannot remove the whole document, which would leave no result`,
+        );
+      }
+      return { index, op, target };
+    case 'copy':
+      return { index, op, target, source: checkLocation(operation, 'from', op, index) };
+    case 'move': {
+      const source = checkLocation(operation, 'from', op, index);
+      if (source.tokens.length === 0) {
+        throw invalid(
+          `${describe(op, index)} cannot move the whole document away from its own location`,
+        );
+      }
+      // Section 4.4: a location cannot be moved into one of its children, which
+      // would leave the value nowhere. The comparison is on reference tokens:
+      // "/a" is a prefix of "/a/b", but not of "/ab".
+      if (isProperPrefix(source.tokens, target.tokens)) {
+        throw invalid(
+          `${describe(op, index)} cannot move ${quote(source.pointer)} into ` +
+            `${quote(target.pointer)}, one of its own children`,
+        );
+      }
+      return { index, op, target, source };
+    }
+  }
+}
+
+/** Reads the `op` member: the operation to perform, and which members it needs. */
+function checkOperationName(operation: object, index: number): PatchOperation['op'] {
+  if (!Object.hasOwn(operation, 'op')) {
+    throw invalid(`operation ${index} has no "op" member`);
+  }
+
+  const op: unknown = (operation as Record<string, unknown>)['op'];
+  if (typeof op !== 'string') {
+    throw invalid(`operation ${index} has an "op" that is not a string, but ${describeJson(op)}`);
+  }
+  if (!isOperationName(op)) {
+    throw invalid(
+      `operation ${index} has an "op" that is not a JSON Patch operation: ${quote(op)}; ` +
+        `it must be one of ${OPERATION_NAMES.map(quote).join(', ')}`,
+    );
+  }
+  return op;
+}
+
+function isOperationName(op: string): op is PatchOperation['op'] {
+  return (OPERATION_NAMES as readonly string[]).includes(op);
+}
+
+/** Reads the `path` or `from` member: a JSON Pointer to a location. */
+function checkLocation(
+  operation: object,
+  member: 'path' | 'from',
+  op: PatchOperation['op'],
+  index: number,
+): Location {
+  if (!Object.hasOwn(operation, member)) {
+    throw invalid(`${describe(op, index)} has no ${quote(member)} member`);
+  }
+
+  const pointer: unknown = (operation as Record<string, unknown>)[member];
+  try {
+    // The pointer syntax is RFC 6901's, down to the rejection of a non-string.
+    const tokens = parsePointer(pointer as string);
+    return { pointer: formatPointer(tokens), tokens };
+  } catch (cause) {
+    if (cause instanceof JsonPointerError) {
+      throw invalid(
+        `${describe(op, index)} has a ${quote(member)} that is not a JSON Pointer: ${cause.message}`,
+        { cause },
+      );
+    }
+    throw cause;
+  }
+}
+
+/**
+ * Reads the `value` member: the JSON value the operation writes or compares.
+ *
+ * The value is copied out of the patch here, so that the patch and the document
+ * it is applied to never share a value: a caller that keeps a patch around and
+ * changes it would otherwise change a document patched with it.
+ */
+function checkValue(operation: object, op: PatchOperation['op'], index: number): JsonValue {
+  if (!Object.hasOwn(operation, 'value')) {
+    throw invalid(`${describe(op, index)} has no "value" member`);
+  }
+
+  const value = (operation as Record<string, JsonValue>)['value'];
+  try {
+    return cloneJson(value);
+  } catch (cause) {
+    if (cause instanceof TypeError) {
+      throw invalid(
+        `${describe(op, index)} has a "value" that is not a JSON value: ${cause.message}`,
+        { cause },
+      );
+    }
+    throw cause;
+  }
+}
+
+function isProperPrefix(prefix: readonly string[], tokens: readonly string[]): boolean {
+  return prefix.length < tokens.length && prefix.every((token, index) => token === tokens[index]);
+}
+
+/** `operation 2 ("move")`, naming an operation whose `op` is known. */
+function describe(op: PatchOperation['op'], index: number): string {
+  return `operation ${index} (${quote(op)})`;
+}
+
+function invalid(reason: string, options?: ErrorOptions): InvalidPatchError {
+  return new InvalidPatchError(`the patch is not valid: ${reason}`, options);
+}
+
+function quote(text: string): string {
+  return JSON.stringify(text);
+}
diff --git a/src/json-patch.ts b/src/json-patch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cad6b902959d0a889e43b4d559696a99e8106a6c
--- /dev/null
+++ b/src/json-patch.ts
@@ -0,0 +1,356 @@
+/**
+ * JSON Patch, as specified in RFC 6902 (https://www.rfc-editor.org/rfc/rfc6902).
+ *
+ * A patch is a sequence of operations — `add`, `remove`, `replace`, `move`,
+ * `copy` and `test` — each naming the location it works on with a JSON Pointer.
+ */
+
+import { cloneJson, setMember } from './json-document.ts';
+import { PatchOperationError, TestFailedError } from './json-patch-errors.ts';
+import { checkPatch } from './json-patch-operation.ts';
+import type { CheckedOperation, JsonPatch, Location } from './json-patch-operation.ts';
+import { formatPointer, JsonPointerError, parseArrayIndex, resolveTokens } from './json-pointer.ts';
+import { describeJson, isJsonObject } from './json-value.ts';
+import type { JsonArray, JsonObject, JsonValue } from './json-value.ts';
+
+/**
+ * Applies a JSON Patch to a JSON document and returns the result.
+ *
+ * The document handed in is left alone: the patch is applied to a copy of it,
+ * which is what comes back. A patch is all-or-nothing, as RFC 6902, section 5
+ * requires — the first operation that fails throws, and the document is as it
+ * was, since nothing was ever written to it.
+ *
+ * ```ts
+ * applyPatch({ a: 1 }, [{ op: 'add', path: '/b', value: 2 }]); // { a: 1, b: 2 }
+ * ```
+ *
+ * @param document - The JSON document to patch.
+ * @param patch - The operations to apply, in order.
+ * @returns A new document, the result of applying every operation.
+ * @throws {InvalidPatchError} If `patch` is not a valid JSON Patch document.
+ * @throws {PatchOperationError} If an operation fails against `document`.
+ * @throws {TestFailedError} If a `test` operation finds a different value.
+ * @throws {TypeError} If `document` is not a JSON value. The types rule that
+ * out; it is a programming error, not a failure of the patch.
+ */
+export function applyPatch(document: JsonValue, patch: JsonPatch): JsonValue {
+  // The whole patch is checked first: a malformed patch is reported as such
+  // without the document being read, let alone copied.
+  const operations = checkPatch(patch);
+
+  let result = cloneJson(document);
+  for (const operation of operations) {
+    result = apply(result, operation);
+  }
+  return result;
+}
+
+/**
+ * Applies one operation to the document being built, and returns the document
+ * it leaves behind — the same one, unless the operation wrote to the root.
+ */
+function apply(document: JsonValue, operation: CheckedOperation): JsonValue {
+  switch (operation.op) {
+    case 'add':
+      return add(document, operation.target, operation.value, operation);
+
+    case 'remove':
+      remove(document, operation.target, operation);
+      return document;
+
+    case 'replace':
+      return replace(document, operation.target, operation.value, operation);
+
+    case 'move': {
+      // Section 4.4: a remove at the source, then an add of what was removed.
+      const value = remove(document, operation.source, operation);
+      return add(document, operation.target, value, operation);
+    }
+
+    case 'copy': {
+      // The value is copied, not shared: the document would otherwise hold the
+      // same object twice, and a later operation on one would change both.
+      const value = cloneJson(read(document, operation.source, operation));
+      return add(document, operation.target, value, operation);
+    }
+
+    case 'test':
+      if (!jsonEquals(read(document, operation.target, operation), operation.value)) {
+        throw new TestFailedError(
+          `${describe(operation)} failed: ${describeLocation(operation.target.tokens)} is not ` +
+            `equal to the operation's "value"`,
+        );
+      }
+      return document;
+  }
+}
+
+/**
+ * Adds a value at a location: a new member of an object, a new element of an
+ * array, or the whole document.
+ */
+function add(
+  document: JsonValue,
+  target: Location,
+  value: JsonValue,
+  operation: CheckedOperation,
+): JsonValue {
+  // Section 4.1: the root as a target means the value replaces the document.
+  if (target.tokens.length === 0) {
+    return value;
+  }
+
+  const container = reachContainer(document, target, operation);
+  const token = lastToken(target);
+  if (container.kind === 'object') {
+    setMember(container.object, token, value);
+    return document;
+  }
+
+  // "-" is the position after the last element, which is where an add appends;
+  // an index may also be that position, but not one beyond it.
+  const index = token === '-' ? container.array.length : parseArrayIndex(token);
+  if (index === undefined) {
+    throw failed(
+      operation,
+      `nothing can be added at ${quote(target.pointer)}: ${describeParent(target)} is an array, ` +
+        `and ${quote(token)} is not an array index`,
+    );
+  }
+  if (index > container.array.length) {
+    throw failed(
+      operation,
+      `nothing can be added at ${quote(target.pointer)}: ${describeParent(target)} has ` +
+        `${container.array.length} element(s), so there is no index ${index} to add before`,
+    );
+  }
+  container.array.splice(index, 0, value);
+  return document;
+}
+
+/**
+ * Removes the value at a location, which must exist, and returns it.
+ *
+ * The root is never a target: a patch that removed the whole document would
+ * have no result, and {@link checkPatch} rejects it.
+ */
+function remove(document: JsonValue, target: Location, operation: CheckedOperation): JsonValue {
+  const container = reachContainer(document, target, operation);
+  const token = lastToken(target);
+  if (container.kind === 'object') {
+    const value = requireMember(container.object, token, target, operation);
+    delete container.object[token];
+    return value;
+  }
+
+  const index = requireIndex(container.array, token, target, operation);
+  return container.array.splice(index, 1)[0];
+}
+
+/** Replaces the value at a location, which must exist. */
+function replace(
+  document: JsonValue,
