+/**
+ * JSON Merge Patch, as specified in RFC 7386
+ * (https://www.rfc-editor.org/rfc/rfc7386).
+ *
+ * A merge patch is not a list of operations but a document shaped like the one
+ * it patches: a member of an object patch replaces the member of that name, and
+ * a member whose value is `null` removes it. RFC 7396 obsoletes RFC 7386 to
+ * restore the indentation its pseudocode and examples lost in publication; the
+ * two specify the same algorithm, and it is the one implemented here.
+ */
+
+import { cloneJson, setMember } from './json-document.ts';
+import { isJsonObject } from './json-value.ts';
+import type { JsonObject, JsonValue } from './json-value.ts';
+
+/**
+ * Applies a JSON Merge Patch to a JSON document and returns the result.
+ *
+ * Both arguments are left alone: the patch is merged into a copy of the target,
+ * which is what comes back, and the values the patch carries are copied into it.
+ * A merge patch cannot fail — every JSON value is a valid patch, and an object
+ * patch applies to any target — so there is nothing to catch.
+ *
+ * ```ts
+ * applyMergePatch({ a: 'b', c: { d: 'e', f: 'g' } }, { a: 'z', c: { f: null } });
+ * // { a: 'z', c: { d: 'e' } }
+ * ```
+ *
+ * @param target - The JSON document to patch.
+ * @param patch - The merge patch to apply.
+ * @returns A new document, the result of merging `patch` into `target`.
+ * @throws {TypeError} If `target` or `patch` is not a JSON value. The types rule
+ * that out; it is a programming error, not a patch that failed.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  // Both are copied up front, so the result shares nothing with either and the
+  // merge itself has nothing left to check: the copy is where the JSON data
+  // model is enforced.
+  return merge(copy(target, 'target'), copy(patch, 'patch'));
+}
+
+/**
+ * Merges a patch into a target, in place, and returns the result — the target
+ * itself when both are objects, and the patch otherwise.
+ *
+ * This is the `MergePatch` function of RFC 7386, section 2. The target may be
+ * absent, which is what the section means by "any JSON value or undefined": a
+ * member the patch names and the target has not got.
+ */
+function merge(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  // Anything but an object replaces the target whole, `null` included: a `null`
+  // removes only where it is the value of a member of an object patch.
+  if (!isJsonObject(patch)) {
+    return patch;
+  }
+
+  // A target that is not an object is ignored, not merged into: there is no
+  // member of an array or of a string for a patch to name.
+  const merged: JsonObject = isJsonObject(target) ? target : {};
+  for (const [name, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete merged[name];
+    } else {
+      setMember(merged, name, merge(member(merged, name), value));
+    }
+  }
+  return merged;
+}
+
+/**
+ * The value of a member, or `undefined` if the object has not got it.
+ *
+ * Own members only, as everywhere in the toolkit: reading `__proto__` or
+ * `toString` off an object that has no such member would hand the merge
+ * JavaScript's own machinery to patch.
+ */
+function member(object: JsonObject, name: string): JsonValue | undefined {
+  return Object.hasOwn(object, name) ? object[name] : undefined;
+}
+
+/**
+ * Copies one of the two arguments, naming it if it is not a JSON value.
+ *
+ * Both are documents, so {@link cloneJson}'s message — which locates the value
+ * it refused within the one it was given — would not say which of the two the
+ * caller has to fix.
+ */
+function copy(value: JsonValue, argument: 'target' | 'patch'): JsonValue {
+  try {
+    return cloneJson(value);
+  } catch (cause) {
+    if (cause instanceof TypeError) {
+      throw new TypeError(`the ${argument} is not a JSON value: ${cause.message}`, { cause });
+    }
+    throw cause;
+  }
+}
