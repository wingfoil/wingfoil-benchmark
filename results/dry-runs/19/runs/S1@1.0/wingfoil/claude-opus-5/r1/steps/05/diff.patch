--- /dev/null
+++ b/test/json-patch-diff.test.ts
@@ -0,0 +1,475 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { applyPatch, createPatch } from '../src/index.ts';
+import type { JsonArray, JsonObject, JsonPatch, JsonValue, PatchOperation } from '../src/index.ts';
+
+/** Diffs documents the types reject, to check they are refused at run time. */
+function createUntyped(from: unknown, to: unknown): JsonPatch {
+  return createPatch(from as JsonValue, to as JsonValue);
+}
+
+/**
+ * Checks the one thing a patch must always do — turn `from` into `to` — and
+ * returns it, so that a test can go on to say what it contains.
+ */
+function patchTurning(from: JsonValue, to: JsonValue): JsonPatch {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to, `the patch does not turn the one document into the other`);
+  return patch;
+}
+
+/** The `value` an operation carries, for the tests that change it afterwards. */
+function operationValue(operation: PatchOperation): JsonObject {
+  return (operation as { value: JsonValue }).value as JsonObject;
+}
+
+/** A separate document equal to the one given, as a service would receive it. */
+function copyOf(document: JsonValue): JsonValue {
+  return JSON.parse(JSON.stringify(document)) as JsonValue;
+}
+
+describe('createPatch', () => {
+  describe('two documents that are equal as JSON', () => {
