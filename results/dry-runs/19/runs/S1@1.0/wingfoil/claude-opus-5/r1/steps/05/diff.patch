index 0000000000000000000000000000000000000000..390aff4de781d82d1791d9e55f5527d71a8cfa07
--- /dev/null
+++ b/src/json-patch-diff.ts
@@ -0,0 +1,317 @@
+/**
+ * The JSON Patch of RFC 6902 (https://www.rfc-editor.org/rfc/rfc6902) read the
+ * other way round: given two versions of a document, the operations that turn
+ * the first into the second.
+ *
+ * The patch describes what changed and nothing more. A value the two versions
+ * have in common is never carried by an operation, however deep it sits: an
+ * object is compared member by member, an array element by element, and only a
+ * location the two versions disagree about appears in the patch.
+ */
+
+import { cloneJson } from './json-document.ts';
+import type { PatchOperation } from './json-patch-operation.ts';
+import { formatPointer } from './json-pointer.ts';
+import { isJsonObject, jsonEquals } from './json-value.ts';
+import type { JsonArray, JsonObject, JsonValue } from './json-value.ts';
+
+/**
+ * Produces a JSON Patch that turns one JSON document into another.
+ *
+ * ```ts
+ * const from = { name: 'config', tags: ['a', 'b'], retries: 1 };
+ * const to = { name: 'config', tags: ['a', 'b'], retries: 3 };
+ *
+ * createPatch(from, to); // [{ op: 'replace', path: '/retries', value: 3 }]
+ * applyPatch(from, createPatch(from, to)); // equal to `to`
+ * ```
+ *
+ * The patch holds `add`, `remove` and `replace` operations only, in the order
+ * they must be applied, and carries no part of the documents the two versions
+ * agree on. Two documents that are equal as JSON give an empty patch.
+ *
+ * Both documents are left alone, and the patch shares nothing with either: it
+ * is built out of copies, so changing one afterwards leaves the others as they
+ * were.
+ *
+ * @param from - The document the patch is to be applied to.
+ * @param to - The document it is to produce.
+ * @returns A patch that turns `from` into `to`, as a fresh array.
+ * @throws {TypeError} If `from` or `to` is not a JSON value. The types rule that
+ * out; it is a programming error, not a patch that could not be produced.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  // Both are copied up front: the values the patch carries are taken out of the
+  // copy of `to`, so they are nobody else's, and the copy is where the JSON data
+  // model is enforced — for `from` as well, whose copy is only read, because a
+  // document the toolkit cannot hold is a mistake a caller should hear about
+  // whichever side of the comparison it is on.
+  const before = copy(from, 'from');
+  const after = copy(to, 'to');
+
+  const patch: PatchOperation[] = [];
+  diff(before, after, [], patch);
+  return patch;
+}
+
+/**
+ * Appends to `patch` the operations that turn `from` into `to` at the location
+ * `at` leads to, which both documents have.
+ *
+ * @param at - The reference tokens leading to the two values, as a stack the
+ * walk pushes to and pops from.
+ */
+function diff(from: JsonValue, to: JsonValue, at: string[], patch: PatchOperation[]): void {
+  if (jsonEquals(from, to)) {
+    // Nothing changed here, so nothing is said about it. This is the one test
+    // that keeps the patch to what changed: every unchanged subtree, however
+    // large, stops the walk where it starts.
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    diffObject(from, to, at, patch);
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(from, to, at, patch);
+  } else {
+    // Two values of different kinds, or two scalars: there is nothing inside
+    // them to tell apart, so the location takes the new value whole.
+    patch.push({ op: 'replace', path: formatPointer(at), value: to });
+  }
+}
+
+/**
+ * Compares two objects member by member: a member only the first has is
+ * removed, a member only the second has is added, and a member both have is
+ * itself compared.
+ */
+function diffObject(from: JsonObject, to: JsonObject, at: string[], patch: PatchOperation[]): void {
+  for (const name of memberNames(from, to)) {
+    at.push(name);
+    if (!Object.hasOwn(to, name)) {
+      patch.push({ op: 'remove', path: formatPointer(at) });
+    } else if (!Object.hasOwn(from, name)) {
+      patch.push({ op: 'add', path: formatPointer(at), value: to[name] });
+    } else {
+      diff(from[name], to[name], at, patch);
+    }
+    at.pop();
+  }
+}
+
+/**
+ * The names of every member of either object, each once, in a fixed order.
+ *
+ * Own members only, as everywhere in the toolkit, which is what `Object.keys`
+ * gives: a name JavaScript keeps on `Object.prototype` is a member of a
+ * document only when the document has it of its own.
+ *
+ * The order is sorted rather than the order the members were written in, so
+ * that the patch is a function of the two documents and of nothing else.
+ * Operations on distinct members of one object do not depend on each other, so
+ * any order would apply; this one is the same for any two documents that are
+ * equal as JSON.
+ */
+function memberNames(from: JsonObject, to: JsonObject): string[] {
+  return [...new Set([...Object.keys(from), ...Object.keys(to)])].sort();
+}
+
+/**
+ * Compares two arrays element by element, as an edit script: the elements they
+ * share are left alone, wherever they have moved to, and only the elements
+ * added, removed and changed are named.
+ *
+ * Indices are those of the array *being patched*, which the operations
+ * themselves shift, so they are counted as the patch grows rather than taken
+ * from either version.
+ */
+function diffArray(from: JsonArray, to: JsonArray, at: string[], patch: PatchOperation[]): void {
+  const prefix = commonPrefix(from, to);
+  const suffix = commonSuffix(from, to, prefix);
+
+  // `cursor` is where the element the next step is about sits once the
+  // operations so far have been applied, and `length` is the length they have
+  // left the array with. Everything below `cursor` is already what `to` has;
+  // everything from it on is still the tail of `from`. The steps come in order,
+  // and a step at `cursor` moves nothing below it, so an element the walk has
+  // passed is settled for good.
+  let cursor = prefix;
+  let length = from.length;
+
+  const steps = alignment(
+    from.slice(prefix, from.length - suffix),
+    to.slice(prefix, to.length - suffix),
+  );
+  for (const step of steps) {
+    switch (step.kind) {
+      case 'keep':
+        cursor++;
+        break;
+
+      case 'change':
+        at.push(String(cursor));
+        diff(step.from, step.to, at, patch);
+        at.pop();
+        cursor++;
+        break;
+
+      case 'add':
+        // An element added at the end of the array is added at "-", the
+        // position after the last one of RFC 6902, section 4.1.
+        at.push(cursor === length ? '-' : String(cursor));
+        patch.push({ op: 'add', path: formatPointer(at), value: step.value });
+        at.pop();
+        cursor++;
+        length++;
+        break;
+
+      case 'remove':
+        at.push(String(cursor));
+        patch.push({ op: 'remove', path: formatPointer(at) });
+        at.pop();
+        // The elements after the one removed have moved down by one, so the
+        // next element to consider is at the index just used.
+        length--;
+        break;
+    }
+  }
+}
+
+/** One element of an edit script, aligning an array with another. */
+type EditStep =
+  /** The element is in both arrays, and needs no operation. */
+  | { readonly kind: 'keep' }
+  /** The element is in both, with a value to compare in its turn. */
+  | { readonly kind: 'change'; readonly from: JsonValue; readonly to: JsonValue }
+  /** The element is only in the second array, and is added. */
+  | { readonly kind: 'add'; readonly value: JsonValue }
+  /** The element is only in the first array, and is removed. */
+  | { readonly kind: 'remove' };
+
+/** How many elements the two arrays begin with in common. */
+function commonPrefix(from: JsonArray, to: JsonArray): number {
+  const shorter = Math.min(from.length, to.length);
+  let count = 0;
+  while (count < shorter && jsonEquals(from[count], to[count])) {
+    count++;
+  }
+  return count;
+}
+
+/** How many they end with in common, of those the prefix has not claimed. */
+function commonSuffix(from: JsonArray, to: JsonArray, prefix: number): number {
+  const left = Math.min(from.length, to.length) - prefix;
+  let count = 0;
+  while (
+    count < left &&
+    jsonEquals(from[from.length - 1 - count], to[to.length - 1 - count])
+  ) {
+    count++;
+  }
+  return count;
+}
+
+/**
+ * Aligns two sequences of elements with as few steps as possible, counting a
+ * removal, an addition and a changed element as one step each and a shared
+ * element as none.
+ *
+ * So an element the two sequences share is kept wherever it has moved to, and a
+ * single insertion in a long array is one step rather than a rewrite of
+ * everything after it. Only the elements the two ends do not already match are
+ * aligned here, which is what keeps a table out of the common cases — an
+ * append, or one element changed in place.
+ */
+function alignment(from: JsonArray, to: JsonArray): EditStep[] {
+  const width = to.length + 1;
+  // `cost[i * width + j]` is the least number of steps that turns the first `i`
+  // elements of `from` into the first `j` of `to`. One 4-byte cell per pair of
+  // elements is what the alignment costs in memory, and the only reason the two
+  // ends are matched first.
+  const cost = new Int32Array((from.length + 1) * width);
+  for (let i = 1; i <= from.length; i++) {
+    cost[i * width] = i;
+  }
+  for (let j = 1; j <= to.length; j++) {
+    cost[j] = j;
+  }
+
+  for (let i = 1; i <= from.length; i++) {
+    for (let j = 1; j <= to.length; j++) {
+      const aligned =
+        cost[(i - 1) * width + (j - 1)] + (jsonEquals(from[i - 1], to[j - 1]) ? 0 : 1);
+      cost[i * width + j] = Math.min(
+        aligned,
+        cost[(i - 1) * width + j] + 1,
+        cost[i * width + (j - 1)] + 1,
+      );
+    }
+  }
+
+  return trace(from, to, cost, width);
+}
+
+/**
+ * Reads the steps back out of the table, from the end of both sequences to
+ * their start, and returns them in the order they are to be applied.
+ *
+ * Several alignments usually cost the same, and the one taken is fixed: an
+ * element equal on both sides is kept, then a removal, then an addition, and a
+ * changed element last. Two documents therefore always give the same patch.
+ */
+function trace(from: JsonArray, to: JsonArray, cost: Int32Array, width: number): EditStep[] {
+  const steps: EditStep[] = [];
+  let i = from.length;
+  let j = to.length;
+
+  while (i > 0 || j > 0) {
+    const here = cost[i * width + j];
+    if (
+      i > 0 &&
+      j > 0 &&
+      cost[(i - 1) * width + (j - 1)] === here &&
+      jsonEquals(from[i - 1], to[j - 1])
+    ) {
+      steps.push({ kind: 'keep' });
+      i--;
+      j--;
+    } else if (i > 0 && cost[(i - 1) * width + j] + 1 === here) {
+      steps.push({ kind: 'remove' });
+      i--;
+    } else if (j > 0 && cost[i * width + (j - 1)] + 1 === here) {
+      steps.push({ kind: 'add', value: to[j - 1] });
+      j--;
+    } else {
+      // What is left is a changed element, which has one on each side: a cell
+      // of the first row is only ever reached by an addition, and one of the
+      // first column only by a removal, so both branches above have already
+      // answered for them.
+      steps.push({ kind: 'change', from: from[i - 1], to: to[j - 1] });
+      i--;
+      j--;
+    }
+  }
+
+  return steps.reverse();
+}
+
+/**
+ * Copies one of the two documents, naming it if it is not a JSON value.
+ *
+ * Both arguments are documents, so {@link cloneJson}'s message — which locates
+ * the value it refused within the one it was given — would not say which of the
+ * two the caller has to fix.
+ */
+function copy(document: JsonValue, argument: 'from' | 'to'): JsonValue {
+  try {
+    return cloneJson(document);
+  } catch (cause) {
+    if (cause instanceof TypeError) {
+      throw new TypeError(
+        `the ${JSON.stringify(argument)} document is not a JSON value: ${cause.message}`,
+        { cause },
+      );
+    }
+    throw cause;
+  }
+}
