diff --git a/src/json-pointer.ts b/src/json-pointer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a7d53afd9224dc9b53e1f307b2fe98b44186411c
--- /dev/null
+++ b/src/json-pointer.ts
@@ -0,0 +1,181 @@
+/**
+ * JSON Pointer, as specified in RFC 6901 (https://www.rfc-editor.org/rfc/rfc6901).
+ *
+ * A pointer is a string of `/`-separated reference tokens that identifies one
+ * value inside a JSON document; the empty string identifies the whole document.
+ */
+
+import type { JsonObject, JsonValue } from './json-value.ts';
+
+/** Base class of every error this module throws, so one `catch` covers both. */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'JsonPointerError';
+  }
+}
+
+/** The string is not a JSON Pointer: it does not match the RFC 6901 grammar. */
+export class InvalidPointerError extends JsonPointerError {
+  constructor(message: string) {
+    super(message);
+    this.name = 'InvalidPointerError';
+  }
+}
+
+/**
+ * The pointer is a valid JSON Pointer, but the document has no value at the
+ * location it identifies.
+ */
+export class PointerResolutionError extends JsonPointerError {
+  constructor(message: string) {
+    super(message);
+    this.name = 'PointerResolutionError';
+  }
+}
+
+/** `~` is only allowed as part of the escape sequences `~0` and `~1`. */
+const INVALID_ESCAPE = /~(?![01])/;
+
+/** The `array-index` production: `0`, or digits with no leading zero. */
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/**
+ * Resolves a JSON Pointer against a JSON document and returns the value it
+ * refers to. The value is returned by reference; the document is not modified.
+ *
+ * ```ts
+ * resolvePointer({ foo: ['bar', 'baz'] }, '/foo/1'); // 'baz'
+ * resolvePointer({ foo: 'bar' }, ''); // { foo: 'bar' }
+ * ```
+ *
+ * Only the pointer syntax of RFC 6901, section 3 is accepted; the URI fragment
+ * form of section 6 (`#/foo`) is a different representation and is rejected.
+ *
+ * @param document - The JSON document to resolve against.
+ * @param pointer - The JSON Pointer string.
+ * @returns The value the pointer refers to.
+ * @throws {InvalidPointerError} If `pointer` is not a valid JSON Pointer.
+ * @throws {PointerResolutionError} If the document has no value at that location.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  const tokens = parsePointer(pointer);
+
+  let value = document;
+  // The pointer to `value`, grown one token at a time so that an error can say
+  // how far the walk got.
+  let reached = '';
+  for (const token of tokens) {
+    value = resolveToken(value, token, reached, pointer);
+    reached += `/${escapeToken(token)}`;
+  }
+  return value;
+}
+
+/**
+ * Splits a pointer into its reference tokens, with the escape sequences
+ * resolved. Rejects anything the RFC 6901 grammar does not accept.
+ */
+function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== 'string') {
+    throw new InvalidPointerError(`a JSON Pointer must be a string, not ${describeType(pointer)}`);
+  }
+  if (pointer === '') {
+    return [];
+  }
+  if (!pointer.startsWith('/')) {
+    throw new InvalidPointerError(
+      `JSON Pointer ${quote(pointer)} is not valid: a non-empty pointer must start with "/"`,
+    );
+  }
+
+  // Dropping the leading "/" before splitting keeps the pointer "/" a single
+  // empty token, which refers to the member named "".
+  return pointer
+    .slice(1)
+    .split('/')
+    .map((token) => unescapeToken(token, pointer));
+}
+
+/**
+ * Replaces the escape sequences of a single reference token: `~1` by `/` and
+ * `~0` by `~`.
+ *
+ * One left-to-right pass gives the order RFC 6901, section 4 requires: `~01`
+ * becomes `~1` rather than `/`, because the `~0` just consumed is not rescanned.
+ */
+function unescapeToken(token: string, pointer: string): string {
+  if (INVALID_ESCAPE.test(token)) {
+    throw new InvalidPointerError(
+      `JSON Pointer ${quote(pointer)} is not valid: "~" must be followed by "0" or "1"`,
+    );
+  }
+  return token.replace(/~[01]/g, (sequence) => (sequence === '~0' ? '~' : '/'));
+}
+
+/** Turns a member name back into a reference token. Escapes `~` before `/`. */
+function escapeToken(name: string): string {
+  return name.replace(/~/g, '~0').replace(/\//g, '~1');
+}
+
+/**
+ * Takes one step down the document.
+ *
+ * @param value - The value the walk has reached so far.
+ * @param token - The reference token to apply to it.
+ * @param reached - The pointer to `value`, for error messages.
+ * @param pointer - The whole pointer being resolved, for error messages.
+ */
+function resolveToken(
+  value: JsonValue,
+  token: string,
+  reached: string,
+  pointer: string,
+): JsonValue {
+  const here = reached === '' ? 'the document' : `the value at ${quote(reached)}`;
+  const unresolved = (reason: string): PointerResolutionError =>
+    new PointerResolutionError(`JSON Pointer ${quote(pointer)} does not resolve: ${reason}`);
+
+  if (Array.isArray(value)) {
+    if (token === '-') {
+      // Section 4: "-" names the element after the last one of the array, which
+      // by definition does not exist.
+      throw unresolved(`${here} is an array, and "-" refers to the element after its last one`);
+    }
+    if (!ARRAY_INDEX.test(token)) {
+      throw unresolved(`${here} is an array, and ${quote(token)} is not an array index`);
+    }
+    const index = Number(token);
+    if (index >= value.length) {
+      throw unresolved(`${here} has ${value.length} element(s), so it has no index ${index}`);
+    }
+    return value[index];
+  }
+
+  if (isJsonObject(value)) {
+    // Own members only: a document inherits nothing, so names such as
+    // "toString" or "__proto__" must not resolve to anything.
+    if (!Object.hasOwn(value, token)) {
+      throw unresolved(`${here} has no member ${quote(token)}`);
+    }
+    return value[token];
+  }
+
+  throw unresolved(`${here} is ${describeType(value)}, so it has no member ${quote(token)}`);
+}
+
+function isJsonObject(value: JsonValue): value is JsonObject {
+  return typeof value === 'object' && value !== null;
+}
+
+/** Names a value's kind, for use in a message: "null", "a string", "an array". */
+function describeType(value: unknown): string {
+  if (value === null) {
+    return 'null';
+  }
+  return Array.isArray(value) ? 'an array' : `a ${typeof value}`;
+}
+
+function quote(text: string): string {
+  return JSON.stringify(text);
+}
diff --git a/src/json-value.ts b/src/json-value.ts
new file mode 100644
index 0000000000000000000000000000000000000000..19c119ff3dac8710f1860e3fd0bb67c6b6303c3f
--- /dev/null
+++ b/src/json-value.ts
@@ -0,0 +1,16 @@
+/**
+ * The JSON data model of RFC 8259, as `JSON.parse` produces it.
+ *
+ * The toolkit speaks in terms of these types rather than `unknown` so that the
+ * building blocks compose: the value a pointer resolves to is itself a document
+ * another operation can be applied to.
+ */
+export type JsonValue = null | boolean | number | string | JsonArray | JsonObject;
+
+/** A JSON array: an ordered sequence of JSON values. */
+export type JsonArray = JsonValue[];
+
+/** A JSON object: an unordered collection of name/value pairs. */
+export interface JsonObject {
+  [name: string]: JsonValue;
+}
diff --git a/test/json-pointer.test.ts b/test/json-pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8fa0de32b55c4f35d8c3070949f8e4b0047406d7
--- /dev/null
+++ b/test/json-pointer.test.ts
@@ -0,0 +1,253 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import {
+  InvalidPointerError,
+  JsonPointerError,
+  PointerResolutionError,
+  resolvePointer,
+} from '../src/index.ts';
+import type { JsonValue } from '../src/index.ts';
+
+/**
+ * The example document of RFC 6901, section 5. Its member names exercise every
+ * character the grammar singles out, including the empty name and the two
+ * characters that have to be escaped.
+ */
+const rfcExample: JsonValue = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+describe('resolvePointer', () => {
+  describe('the whole document', () => {
+    it('resolves the empty pointer to the document itself', () => {
+      assert.equal(resolvePointer(rfcExample, ''), rfcExample);
+    });
+
+    it('resolves the empty pointer to documents that are not composite', () => {
+      assert.equal(resolvePointer(null, ''), null);
+      assert.equal(resolvePointer(42, ''), 42);
+      assert.equal(resolvePointer('a string', ''), 'a string');
+      assert.equal(resolvePointer(false, ''), false);
+    });
+  });
+
+  describe('the examples of RFC 6901, section 5', () => {
+    const expectations: ReadonlyArray<readonly [string, JsonValue]> = [
+      ['/foo', ['bar', 'baz']],
+      ['/foo/0', 'bar'],
+      ['/foo/1', 'baz'],
+      ['/', 0],
+      ['/a~1b', 1],
+      ['/c%d', 2],
+      ['/e^f', 3],
+      ['/g|h', 4],
+      ['/i\\j', 5],
+      ['/k"l', 6],
+      ['/ ', 7],
+      ['/m~0n', 8],
+    ];
+
+    for (const [pointer, expected] of expectations) {
+      it(`resolves ${JSON.stringify(pointer)}`, () => {
+        assert.deepEqual(resolvePointer(rfcExample, pointer), expected);
+      });
+    }
+  });
+
+  describe('object members', () => {
+    it('walks nested objects', () => {
+      const document: JsonValue = { a: { b: { c: 'deep' } } };
+      assert.equal(resolvePointer(document, '/a/b/c'), 'deep');
+    });
+
+    it('resolves a member whose name is empty', () => {
+      assert.equal(resolvePointer({ '': { '': 'twice' } }, '//'), 'twice');
+    });
+
+    it('resolves a member whose name looks like an array index', () => {
+      assert.equal(resolvePointer({ '0': 'zero', '-': 'dash' }, '/0'), 'zero');
+      assert.equal(resolvePointer({ '0': 'zero', '-': 'dash' }, '/-'), 'dash');
+    });
+
+    it('resolves a member whose value is null or false', () => {
+      assert.equal(resolvePointer({ a: null }, '/a'), null);
+      assert.equal(resolvePointer({ a: false }, '/a'), false);
+    });
+
+    it('rejects a name that is not an own member', () => {
+      assert.throws(() => resolvePointer({ foo: 1 }, '/bar'), PointerResolutionError);
+    });
+
+    it('rejects inherited and prototype member names', () => {
+      for (const pointer of ['/toString', '/constructor', '/hasOwnProperty', '/__proto__']) {
+        assert.throws(() => resolvePointer({}, pointer), PointerResolutionError);
+      }
+    });
+
+    it('rejects a member inherited from a custom prototype', () => {
+      const document = Object.create({ inherited: 'nope' }) as JsonValue;
+      assert.throws(() => resolvePointer(document, '/inherited'), PointerResolutionError);
+    });
+  });
+
+  describe('array elements', () => {
+    it('resolves elements by zero-based index', () => {
+      const document: JsonValue = ['a', 'b', 'c'];
+      assert.equal(resolvePointer(document, '/0'), 'a');
+      assert.equal(resolvePointer(document, '/2'), 'c');
+    });
+
+    it('walks arrays nested in objects and objects nested in arrays', () => {
+      const document: JsonValue = { items: [{ name: 'first' }, { name: 'second' }] };
+      assert.equal(resolvePointer(document, '/items/1/name'), 'second');
+    });
+
+    it('rejects an index past the last element', () => {
+      assert.throws(() => resolvePointer(['a', 'b'], '/2'), PointerResolutionError);
+      assert.throws(() => resolvePointer([], '/0'), PointerResolutionError);
+    });
+
+    it('rejects "-", which refers to the element after the last one', () => {
+      assert.throws(() => resolvePointer(['a'], '/-'), PointerResolutionError);
+      assert.throws(() => resolvePointer([], '/-'), PointerResolutionError);
+    });
+
+    it('rejects tokens that are not array indices', () => {
+      for (const pointer of ['/01', '/1.0', '/+1', '/-1', '/ 1', '/1 ', '/0x1', '/']) {
+        assert.throws(() => resolvePointer(['a', 'b'], pointer), PointerResolutionError);
+      }
+    });
+
+    it('rejects array properties and prototype member names', () => {
+      for (const pointer of ['/length', '/toString', '/concat', '/__proto__']) {
+        assert.throws(() => resolvePointer(['a'], pointer), PointerResolutionError);
+      }
+    });
+  });
+
+  describe('escape sequences', () => {
+    it('unescapes "~1" to "/" and "~0" to "~"', () => {
+      assert.equal(resolvePointer({ 'a/b': 'slash' }, '/a~1b'), 'slash');
+      assert.equal(resolvePointer({ 'a~b': 'tilde' }, '/a~0b'), 'tilde');
+    });
+
+    it('turns "~01" into "~1", not into "/"', () => {
+      assert.equal(resolvePointer({ '~1': 'tilde-one' }, '/~01'), 'tilde-one');
+      assert.throws(() => resolvePointer({ '/': 'slash' }, '/~01'), PointerResolutionError);
+    });
+
+    it('unescapes several sequences in one token', () => {
+      assert.equal(resolvePointer({ '/~': 'both' }, '/~1~0'), 'both');
+      assert.equal(resolvePointer({ '~/': 'both' }, '/~0~1'), 'both');
+      assert.equal(resolvePointer({ '~~//': 'many' }, '/~0~0~1~1'), 'many');
+    });
+
+    it('unescapes a token that is only an escape sequence', () => {
+      assert.equal(resolvePointer({ '/': 'slash' }, '/~1'), 'slash');
+      assert.equal(resolvePointer({ '~': 'tilde' }, '/~0'), 'tilde');
+    });
+  });
+
+  describe('pointers that do not resolve', () => {
+    it('rejects descending into a value that is neither object nor array', () => {
+      assert.throws(() => resolvePointer({ foo: 'bar' }, '/foo/baz'), PointerResolutionError);
+      assert.throws(() => resolvePointer({ foo: 42 }, '/foo/baz'), PointerResolutionError);
+      assert.throws(() => resolvePointer({ foo: true }, '/foo/baz'), PointerResolutionError);
+      assert.throws(() => resolvePointer({ foo: null }, '/foo/baz'), PointerResolutionError);
+    });
+
+    it('rejects descending into a document that is not composite', () => {
+      assert.throws(() => resolvePointer(null, '/a'), PointerResolutionError);
+      assert.throws(() => resolvePointer('a string', '/0'), PointerResolutionError);
+      assert.throws(() => resolvePointer(7, '/a'), PointerResolutionError);
+    });
+
+    it('names the pointer and the location that failed', () => {
+      assert.throws(
+        () => resolvePointer({ a: { b: 1 } }, '/a/c/d'),
+        (error: unknown) => {
+          assert.ok(error instanceof PointerResolutionError);
+          assert.match(error.message, /\/a\/c\/d/);
+          assert.match(error.message, /"\/a"/);
+          assert.match(error.message, /"c"/);
+          return true;
+        },
+      );
+    });
+  });
+
+  describe('pointers that are not valid', () => {
+    it('rejects a non-empty pointer that does not start with "/"', () => {
+      for (const pointer of ['foo', 'foo/bar', ' /foo', '0', 'a~1b']) {
+        assert.throws(() => resolvePointer(rfcExample, pointer), InvalidPointerError);
+      }
+    });
+
+    it('rejects the URI fragment form, which is a different representation', () => {
+      assert.throws(() => resolvePointer(rfcExample, '#'), InvalidPointerError);
+      assert.throws(() => resolvePointer(rfcExample, '#/foo'), InvalidPointerError);
+    });
+
+    it('rejects "~" that is not followed by "0" or "1"', () => {
+      for (const pointer of ['/~', '/~2', '/~x', '/a~', '/a~b', '/~/foo', '/foo/~0~']) {
+        assert.throws(() => resolvePointer(rfcExample, pointer), InvalidPointerError);
+      }
+    });
+
+    it('rejects a pointer that is not a string', () => {
+      for (const pointer of [undefined, null, 0, ['/foo'], { pointer: '/foo' }]) {
+        assert.throws(
+          () => resolvePointer(rfcExample, pointer as unknown as string),
+          InvalidPointerError,
+        );
+      }
+    });
+
+    it('reports an invalid pointer before trying to resolve it', () => {
+      // '/~' is invalid, so the error must be about the syntax even though the
+      // document would not have that member either.
+      assert.throws(() => resolvePointer({}, '/~'), InvalidPointerError);
+    });
+  });
+
+  describe('errors', () => {
+    it('shares one base class, so callers can catch either kind', () => {
+      assert.ok(Object.getPrototypeOf(InvalidPointerError) === JsonPointerError);
+      assert.ok(Object.getPrototypeOf(PointerResolutionError) === JsonPointerError);
+
+      for (const thrower of [() => resolvePointer({}, 'nope'), () => resolvePointer({}, '/nope')]) {
+        assert.throws(thrower, JsonPointerError);
+        assert.throws(thrower, Error);
+      }
+    });
+
+    it('carries the name of its class', () => {
+      assert.throws(() => resolvePointer({}, 'nope'), { name: 'InvalidPointerError' });
+      assert.throws(() => resolvePointer({}, '/nope'), { name: 'PointerResolutionError' });
+    });
+  });
+
+  describe('the document', () => {
+    it('is not modified by resolving a pointer', () => {
+      const document: JsonValue = { a: [{ b: 1 }] };
+      const snapshot = JSON.stringify(document);
+      resolvePointer(document, '/a/0/b');
+      assert.equal(JSON.stringify(document), snapshot);
+    });
+
+    it('is returned by reference, not copied', () => {
+      const nested = { b: 1 };
+      assert.equal(resolvePointer({ a: nested }, '/a'), nested);
+    });
+  });
+});
