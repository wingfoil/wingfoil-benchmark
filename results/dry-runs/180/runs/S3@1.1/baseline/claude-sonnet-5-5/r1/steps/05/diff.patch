+test('cancel refunds before the start, frees the equipment, and works only once', () => {
+  const s = setup();
+  const r = { itemId: 'b1', start: '2026-05-01T00:00:00Z', end: '2026-05-03T00:00:00Z' };
+  const b = s.book(r);
+  assert.deepEqual(s.cancel(b.id, '2026-04-30T12:00:00Z'), { bookingId: b.id, refund: 5100 });
+  assert.throws(() => s.cancel(b.id, '2026-04-30T13:00:00Z'), /already cancelled/);
+  assert.throws(() => s.cancel('nope', '2026-04-30T13:00:00Z'), /unknown booking/);
+  assert.doesNotThrow(() => s.book(r));
+});
