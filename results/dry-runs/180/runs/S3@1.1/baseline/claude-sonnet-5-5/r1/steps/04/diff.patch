+
+test('rentals shorter than a day on the hour are priced per hour', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2550, hourlyPrice: 700 });
+  s.addEquipment({ id: 'd1', kind: 'board', dailyPrice: 2550 });
+  const r = { itemId: 'h1', start: '2026-05-01T13:00:00Z', end: '2026-05-01T17:00:00Z' };
+  assert.equal(s.quote(r).total, 2800);
+  assert.equal(s.book(r).total, 2800);
+  assert.throws(() => s.book({ ...r, end: '2026-05-01T14:00:00Z' }));
+  assert.equal(s.quote({ ...r, start: '2026-05-01T22:00:00Z', end: '2026-05-02T02:00:00Z' }).total, 2800);
+  assert.throws(() => s.quote({ ...r, itemId: 'd1' }));
+  assert.throws(() => s.quote({ ...r, end: '2026-05-01T17:30:00Z' }));
+  assert.throws(() => s.quote({ ...r, end: '2026-05-02T13:00:00Z' }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+});
