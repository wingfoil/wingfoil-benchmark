+
+test('availability lists free items of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a1', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'b0', kind: 'board', dailyPrice: 1000 });
+  s.book({ itemId: 'b1', start: '2026-05-01T00:00:00Z', end: '2026-05-03T00:00:00Z' });
+  const q = { start: '2026-05-02T00:00:00Z', end: '2026-05-04T00:00:00Z' };
+  assert.deepEqual(s.availability(q), ['a1', 'b0']);
+  assert.deepEqual(s.availability({ ...q, kind: 'board' }), ['b0']);
+  assert.deepEqual(s.availability({ start: '2026-05-03T00:00:00Z', end: '2026-05-04T00:00:00Z' }), ['a1', 'b0', 'b1']);
+  assert.throws(() => s.availability({ ...q, start: q.end, end: q.start }));
+});
