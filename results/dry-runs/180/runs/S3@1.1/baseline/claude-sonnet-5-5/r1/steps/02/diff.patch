diff --git a/src/index.ts b/src/index.ts
index 32f84b692f44097d671deca32d1953d35596f235..c35f9bbd8317ff54c368c9412478b9cf1eb10a70 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -24,10 +24,20 @@ export interface Booking extends Quote {
   id: string;
 }
 
+export interface AvailabilityQuery {
+  /** Midnight UTC, ISO-8601. */
+  start: string;
+  /** Midnight UTC, ISO-8601: the start of the day after the last day of the period. */
+  end: string;
+  kind?: EquipmentKind;
+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  /** Ids of the equipment (of the given kind, if any) free for the whole period, sorted. */
+  availability(query: AvailabilityQuery): string[];
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
@@ -93,5 +103,20 @@ export function createRentalService(): RentalService {
       bookings.push({ ...booking, startMs, endMs });
       return booking;
     },
+
+    availability(query) {
+      if (query === null || typeof query !== 'object') throw new Error('query is required');
+      const startMs = parseDay(query.start, 'start');
+      const endMs = parseDay(query.end, 'end');
+      if (endMs <= startMs) throw new Error('end must be after start');
+      if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+        throw new Error(`unknown kind: ${String(query.kind)}`);
+      }
+      return [...equipment.values()]
+        .filter((item) => query.kind === undefined || item.kind === query.kind)
+        .filter((item) => !bookings.some((b) => b.itemId === item.id && startMs < b.endMs && b.startMs < endMs))
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
