@@ -0,0 +1,34 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2550 });
+  return s;
+}
+
+test('quote multiplies days by daily price', () => {
+  const q = setup().quote({ itemId: 'b1', start: '2026-05-01T00:00:00Z', end: '2026-05-04T00:00:00Z' });
+  assert.equal(q.total, 7650);
+});
+
+test('rejects unknown item and bad periods', () => {
+  const s = setup();
+  const ok = { start: '2026-05-01T00:00:00Z', end: '2026-05-02T00:00:00Z' };
+  assert.throws(() => s.quote({ itemId: 'x', ...ok }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-05-01T10:00:00Z', end: ok.end }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-05-01T00:00:00+02:00', end: ok.end }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: ok.end, end: ok.start }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: ok.start, end: ok.start }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-02-30T00:00:00Z', end: '2026-03-02T00:00:00Z' }));
+});
+
+test('book prevents overlaps but allows back-to-back', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: '2026-05-01T00:00:00Z', end: '2026-05-03T00:00:00Z' });
+  assert.equal(a.total, 5100);
+  assert.throws(() => s.book({ itemId: 'b1', start: '2026-05-02T00:00:00Z', end: '2026-05-04T00:00:00Z' }));
+  const b = s.book({ itemId: 'b1', start: '2026-05-03T00:00:00Z', end: '2026-05-04T00:00:00Z' });
+  assert.notEqual(a.id, b.id);
+});
