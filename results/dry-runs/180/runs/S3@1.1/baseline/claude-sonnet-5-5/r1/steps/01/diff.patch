+++ b/src/index.ts
@@ -0,0 +1,97 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one day of rental, in euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  /** Midnight UTC, ISO-8601. */
+  start: string;
+  /** Midnight UTC, ISO-8601: the start of the day after the last rented day. */
+  end: string;
+}
+
+export interface Quote extends RentalRequest {
+  /** Total price, in euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00(?::00(?:\.0+)?)?Z$/;
+
+/** Parses a midnight-UTC ISO-8601 string to epoch milliseconds. */
+function parseDay(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !UTC_MIDNIGHT.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC string at midnight, e.g. 2026-05-01T00:00:00Z`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a valid date: ${value}`);
+  }
+  return ms;
+}
+
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: (Booking & { startMs: number; endMs: number })[] = [];
+  let nextBookingId = 1;
+
+  function price(request: RentalRequest) {
+    if (request === null || typeof request !== 'object') throw new Error('request is required');
+    const item = equipment.get(request.itemId);
+    if (!item) throw new Error(`unknown item: ${request.itemId}`);
+    const startMs = parseDay(request.start, 'start');
+    const endMs = parseDay(request.end, 'end');
+    if (endMs <= startMs) throw new Error('end must be after start');
+    const days = Math.round((endMs - startMs) / DAY_MS);
+    const quote: Quote = {
+      itemId: item.id,
+      start: request.start,
+      end: request.end,
+      total: days * item.dailyPrice,
+    };
+    return { quote, startMs, endMs };
+  }
+
+  return {
+    addEquipment(item) {
+      if (item === null || typeof item !== 'object') throw new Error('item is required');
+      if (typeof item.id !== 'string' || item.id === '') throw new Error('id must be a non-empty string');
+      if (item.kind !== 'board' && item.kind !== 'sail') throw new Error(`unknown kind: ${String(item.kind)}`);
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+      }
+      if (equipment.has(item.id)) throw new Error(`item already exists: ${item.id}`);
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, startMs, endMs } = price(request);
+      const clash = bookings.some(
+        (b) => b.itemId === quote.itemId && startMs < b.endMs && b.startMs < endMs,
+      );
+      if (clash) throw new Error(`item ${quote.itemId} is not free for the whole period`);
+      const booking = { id: String(nextBookingId++), ...quote };
+      bookings.push({ ...booking, startMs, endMs });
+      return booking;
+    },
+  };
+}
diff --git a/test/rental.test.ts b/test/rental.test.ts
