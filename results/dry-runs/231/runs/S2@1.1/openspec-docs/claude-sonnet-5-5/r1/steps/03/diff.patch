+describe('coupon given back on cancellation', () => {
+  it('lets a cancelled order\'s single-use coupon be used again', () => {
+    const { catalog, inventory, coupons, orders } = createShop();
+    catalog.add({ sku: 'LB-220', name: 'Lamp', priceCents: 1000, vatClass: 'standard', weightGrams: 100 });
+    inventory.restock('LB-220', 10);
+    coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = orders.place({ customer: 'paolo', date: '2026-03-02', lines: [{ sku: 'LB-220', quantity: 1 }], coupon: 'WELCOME' });
+    orders.cancel(first.id, '2026-03-02');
+    const second = orders.place({ customer: 'paolo', date: '2026-03-02', lines: [{ sku: 'LB-220', quantity: 2 }], coupon: 'welcome' });
+    assert.equal(second.coupon, 'welcome');
+  });
+});
