+  it('keeps its creation time and updates its changed time for every task edit', () => {
+    const list = createTodoList();
+    const added = valueOf(list.add({ title: 'Water the plants' }));
+
+    let task = valueOf(list.rename(added.id, 'Water all the plants'));
+    assert.equal(task.createdAt, added.createdAt);
+    assert.ok(task.updatedAt >= added.updatedAt);
+
+    task = valueOf(list.tag(task.id, 'garden'));
+    assert.equal(task.createdAt, added.createdAt);
+    assert.ok(task.updatedAt >= added.updatedAt);
+
+    task = valueOf(list.untag(task.id, 'garden'));
+    assert.equal(task.createdAt, added.createdAt);
+    assert.ok(task.updatedAt >= added.updatedAt);
+
+    task = valueOf(list.complete(task.id));
+    assert.equal(task.createdAt, added.createdAt);
+    assert.ok(task.updatedAt >= added.updatedAt);
+
+    task = valueOf(list.reopen(task.id));
+    assert.equal(task.createdAt, added.createdAt);
