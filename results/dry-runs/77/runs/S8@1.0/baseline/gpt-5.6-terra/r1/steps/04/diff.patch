 export type { TaskFilter, TaskList } from './domain/list.ts';
 export type { Result, TodoError, TodoErrorCode } from './domain/result.ts';
@@ -14,3 +15,52 @@ export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 export function createTodoList(): TaskList {
   return createTaskList();
 }
+
+/** A line that could not be imported, and why. */
+export interface RejectedTaskImport {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of importing tasks from spreadsheet-style text. */
+export interface TaskImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedTaskImport[];
+}
+
+/**
+ * Adds the valid `title;priority;tags` lines in `text` to a task list.
+ * Empty priorities use the list's normal priority; tags are space-separated.
+ */
+export function importTasks(list: TaskList, text: string): TaskImportResult {
+  let imported = 0;
+  const rejected: RejectedTaskImport[] = [];
+
+  for (const [index, line] of text.split(/\r?\n/).entries()) {
+    if (line.trim() === '') continue;
+
+    const input = parseImportLine(line);
+    if (typeof input === 'string') {
+      rejected.push({ line: index + 1, reason: input });
+      continue;
+    }
+
+    const added = list.add(input);
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  }
+
+  return { imported, rejected };
+}
+
+function parseImportLine(line: string): NewTask | string {
+  const fields = line.split(';');
+  if (fields.length !== 3) return 'line must contain title, priority, and tags separated by semicolons';
+
+  const [title, priority, tags] = fields.map((field) => field.trim());
+  return {
+    title,
+    ...(priority === '' ? {} : { priority: priority as NewTask['priority'] }),
+    ...(tags === '' ? {} : { tags: tags.split(/\s+/) }),
+  };
+}
