+
+function validateNewTask(input: NewTask, title: string): Result<never> | undefined {
+  return (
+    validateTitle(title) ??
+    validatePriority(input.priority) ??
+    input.tags?.map(validateTag).find((error) => error !== undefined)
+  );
+}
+
+function validateTitle(title: string): Result<never> | undefined {
+  if (title.length === 0) return err('invalid-input', 'title cannot be empty');
+  if (title.length > 120) return err('invalid-input', 'title cannot be longer than 120 characters');
+}
+
+function validatePriority(priority: unknown): Result<never> | undefined {
+  if (priority !== undefined && priority !== 'low' && priority !== 'normal' && priority !== 'high') {
+    return err('invalid-input', 'priority must be low, normal, or high');
+  }
+}
+
+function validateTag(tag: string): Result<never> | undefined {
+  if (tag.length === 0) return err('invalid-input', 'tag cannot be empty');
+  if (tag.includes(' ')) return err('invalid-input', 'tag cannot contain spaces');
+}
