+  it('gives a single-use coupon back when its order is cancelled', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'ONCE', kind: 'fixed', value: 100, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = orders.place({ customer: 'Paolo', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'once' });
+    orders.cancel(first.id, '2026-05-05');
+    assert.equal(coupons.usedBy('ONCE'), undefined);
+    const second = orders.place({ customer: 'Paolo', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'ONCE' });
+    assert.equal(coupons.usedBy('ONCE'), second.id);
+  });
