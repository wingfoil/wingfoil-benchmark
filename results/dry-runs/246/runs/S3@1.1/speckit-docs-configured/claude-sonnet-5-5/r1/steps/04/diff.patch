@@ -118,3 +118,62 @@ test('discounted totals are rounded to whole euro cents', () => {
   // 3003 * 0.9 = 2702.7
   assert.equal(s.quote({ itemId: 'x', start: d(1), end: d(4) }).total, 2703);
 });
+
+const h = (day: number, hour: number) =>
+  `2026-07-${String(day).padStart(2, '0')}T${String(hour).padStart(2, '0')}:00:00Z`;
+
+function hourlySetup() {
+  const s = setup();
+  s.addEquipment({ id: 'board-h', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  return s;
+}
+
+test('a rental shorter than a day is priced per hour, without discount', () => {
+  const s = hourlySetup();
+  assert.equal(s.quote({ itemId: 'board-h', start: h(1, 13), end: h(1, 14) }).total, 600);
+  assert.equal(s.quote({ itemId: 'board-h', start: h(1, 13), end: h(1, 17) }).total, 2400);
+  assert.equal(s.quote({ itemId: 'board-h', start: h(1, 0), end: h(1, 23) }).total, 13800);
+  // Shorter than a day across midnight; the hourly price may exceed the daily price.
+  assert.equal(s.quote({ itemId: 'board-h', start: h(1, 22), end: h(2, 2) }).total, 2400);
+  assert.equal(s.quote({ itemId: 'board-h', start: h(1, 10), end: h(2, 0) }).total, 8400);
+});
+
+test('a full day or more is still priced per day', () => {
+  const s = hourlySetup();
+  assert.equal(s.quote({ itemId: 'board-h', start: d(1), end: d(2) }).total, 2500);
+  assert.equal(s.quote({ itemId: 'board-h', start: d(1), end: d(4) }).total, 6750);
+  assert.throws(() => s.quote({ itemId: 'board-h', start: h(1, 10), end: h(2, 10) }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: h(1, 10), end: d(3) }));
+});
+
+test('hourly rentals must start and end on the hour', () => {
+  const s = hourlySetup();
+  assert.throws(() => s.quote({ itemId: 'board-h', start: '2026-07-01T13:30:00Z', end: h(1, 15) }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: h(1, 13), end: '2026-07-01T15:00:30Z' }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: h(1, 13), end: h(1, 13) }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: h(1, 14), end: h(1, 13) }));
+  assert.throws(() => s.quote({ itemId: 'board-h', start: '2026-07-01T13:00:00+02:00', end: h(1, 15) }));
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  const s = hourlySetup();
+  assert.throws(() => s.quote({ itemId: 'board-1', start: h(1, 13), end: h(1, 15) }));
+  assert.throws(() => s.book({ itemId: 'board-1', start: h(1, 13), end: h(1, 15) }));
+});
+
+test('hourly bookings block overlapping periods, not back-to-back ones', () => {
+  const s = hourlySetup();
+  assert.equal(s.book({ itemId: 'board-h', start: h(1, 13), end: h(1, 15) }).total, 1200);
+  assert.throws(() => s.book({ itemId: 'board-h', start: h(1, 14), end: h(1, 16) }));
+  assert.throws(() => s.book({ itemId: 'board-h', start: d(1), end: d(2) }));
+  s.book({ itemId: 'board-h', start: h(1, 15), end: h(1, 16) });
+  s.book({ itemId: 'board-h', start: h(1, 12), end: h(1, 13) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(2), kind: 'board' }), ['board-1']);
+});
+
+test('addEquipment validates the hourly price', () => {
+  const s = createRentalService();
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: -1 }));
+  s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 0 });
+});
