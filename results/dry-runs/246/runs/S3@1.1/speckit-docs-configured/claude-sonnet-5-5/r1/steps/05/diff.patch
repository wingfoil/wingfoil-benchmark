   s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 0 });
 });
+
+test('cancel refunds the booking total and frees the equipment', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'board-1', start: d(1), end: d(4) });
+  assert.deepEqual(s.cancel(a.id, '2026-06-20T09:30:00Z'), { bookingId: a.id, refund: 6750 });
+  assert.deepEqual(s.availability({ start: d(1), end: d(4) }), ['board-1', 'sail-1']);
+  const b = s.book({ itemId: 'board-1', start: d(2), end: d(3) });
+  assert.notEqual(b.id, a.id);
+});
+
+test('a booking can only be cancelled once; unknown ids and bad times are rejected', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'board-1', start: d(1), end: d(2) });
+  assert.throws(() => s.cancel('nope', '2026-06-20T09:00:00Z'));
+  assert.throws(() => s.cancel(a.id, 'garbage'));
+  assert.throws(() => s.cancel(a.id, '2026-06-20T09:00:00+02:00'));
+  s.cancel(a.id, '2026-06-20T09:00:00Z');
+  assert.throws(() => s.cancel(a.id, '2026-06-21T09:00:00Z'));
+});
