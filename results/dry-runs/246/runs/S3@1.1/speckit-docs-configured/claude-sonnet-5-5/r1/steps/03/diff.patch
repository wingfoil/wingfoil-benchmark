+
+test('rentals of 3 days or more cost 10% less, in quotes and bookings', () => {
+  const s = setup();
+  assert.equal(s.quote({ itemId: 'board-1', start: d(1), end: d(3) }).total, 5000);
+  assert.equal(s.quote({ itemId: 'board-1', start: d(1), end: d(4) }).total, 6750);
+  assert.equal(s.quote({ itemId: 'board-1', start: d(1), end: d(11) }).total, 22500);
+  assert.equal(s.book({ itemId: 'board-1', start: d(1), end: d(4) }).total, 6750);
+});
+
+test('discounted totals are rounded to whole euro cents', () => {
+  const s = createRentalService();
