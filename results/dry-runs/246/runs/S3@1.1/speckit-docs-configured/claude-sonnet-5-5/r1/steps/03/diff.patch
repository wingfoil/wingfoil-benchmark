+/** A rental of at least this many days gets the long-rental discount. */
+const LONG_RENTAL_MIN_DAYS = 3;
+/** Long-rental price as a percentage of the full price (10% off). */
+const LONG_RENTAL_PERCENT = 90;
+
 const DAY_MS = 24 * 60 * 60 * 1000;
 const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?Z$/;
 
@@ -58,6 +63,12 @@ function parseMidnightUtc(value: string, name: string): number {
   return ms;
 }
 
+/** Full price, reduced by 10% from 3 days; rounded to the nearest euro cent. */
+function rentalTotal(days: number, dailyPrice: number): number {
+  const full = days * dailyPrice;
+  return days >= LONG_RENTAL_MIN_DAYS ? Math.round((full * LONG_RENTAL_PERCENT) / 100) : full;
+}
