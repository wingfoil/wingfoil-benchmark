new file mode 100644
index 0000000000000000000000000000000000000000..d0914fe1a5f58912dea92d2b6be6eec3f5cb610a
--- /dev/null
+++ b/src/index.test.ts
@@ -0,0 +1,78 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.js';
+
+function setup() {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  return service;
+}
+
+const d = (day: number) => `2026-07-${String(day).padStart(2, '0')}T00:00:00Z`;
+
+test('quote multiplies the daily price by the number of days', () => {
+  const s = setup();
+  assert.deepEqual(s.quote({ itemId: 'board-1', start: d(1), end: d(4) }), {
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00.000Z',
+    end: '2026-07-04T00:00:00.000Z',
+    total: 7500,
+  });
+  assert.equal(s.quote({ itemId: 'board-1', start: d(1), end: d(2) }).total, 2500);
+});
+
+test('quote rejects unknown items and invalid periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'nope', start: d(1), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: d(2), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: d(3), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: '2026-07-01T10:00:00Z', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: d(1), end: '2026-07-02T00:00:00+02:00' }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: '2026-02-30T00:00:00Z', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'board-1', start: 'garbage', end: d(2) }));
+});
+
+test('book returns a booking with an id and the quoted total', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'board-1', start: d(1), end: d(3) });
+  const b = s.book({ itemId: 'sail-1', start: d(1), end: d(3) });
+  assert.equal(a.total, 5000);
+  assert.equal(a.itemId, 'board-1');
+  assert.notEqual(a.id, b.id);
+});
+
+test('book refuses overlapping periods for the same item only', () => {
+  const s = setup();
+  s.book({ itemId: 'board-1', start: d(5), end: d(8) });
+  assert.throws(() => s.book({ itemId: 'board-1', start: d(5), end: d(8) }));
+  assert.throws(() => s.book({ itemId: 'board-1', start: d(7), end: d(10) }));
+  assert.throws(() => s.book({ itemId: 'board-1', start: d(3), end: d(6) }));
+  assert.throws(() => s.book({ itemId: 'board-1', start: d(6), end: d(7) }));
+  assert.throws(() => s.book({ itemId: 'board-1', start: d(1), end: d(20) }));
+  s.book({ itemId: 'sail-1', start: d(5), end: d(8) });
+  // Back-to-back periods do not overlap.
+  s.book({ itemId: 'board-1', start: d(8), end: d(9) });
+  s.book({ itemId: 'board-1', start: d(4), end: d(5) });
+});
+
+test('a failed book does not block the item; quote does not book', () => {
+  const s = setup();
+  s.quote({ itemId: 'board-1', start: d(1), end: d(3) });
+  s.book({ itemId: 'board-1', start: d(1), end: d(3) });
+});
+
+test('book throws for unknown items and invalid periods', () => {
+  const s = setup();
+  assert.throws(() => s.book({ itemId: 'nope', start: d(1), end: d(2) }));
+  assert.throws(() => s.book({ itemId: 'board-1', start: d(2), end: d(1) }));
+});
+
+test('addEquipment validates its input', () => {
+  const s = createRentalService();
+  assert.throws(() => s.addEquipment({ id: '', kind: 'board', dailyPrice: 100 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 10.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
+  s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100 });
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100 }));
+});
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..471d44d53e873e497616dacf6001004fd0ae6469
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,110 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  /** Price of one day of rental, in euro cents. */
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  /** ISO-8601 UTC, midnight. */
+  start: string;
+  /** ISO-8601 UTC, midnight: the start of the day after the last rented day. */
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  /** Euro cents. */
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00:00(\.0+)?Z$/;
+
+function parseMidnightUtc(value: string, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC time at midnight, like 2026-07-01T00:00:00Z`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} is not a valid date`);
+  }
+  return ms;
+}
+
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Array<Booking & { startMs: number; endMs: number }> = [];
+
+  function price(request: RentalRequest): Quote & { startMs: number; endMs: number } {
+    const item = equipment.get(request.itemId);
+    if (!item) {
+      throw new Error(`Unknown item: ${request.itemId}`);
+    }
+    const startMs = parseMidnightUtc(request.start, 'start');
+    const endMs = parseMidnightUtc(request.end, 'end');
+    if (endMs <= startMs) {
+      throw new Error('end must be after start');
+    }
+    const days = (endMs - startMs) / DAY_MS;
+    return {
+      itemId: item.id,
+      start: new Date(startMs).toISOString(),
+      end: new Date(endMs).toISOString(),
+      total: days * item.dailyPrice,
+      startMs,
+      endMs,
+    };
+  }
+
+  return {
+    addEquipment(item) {
+      if (typeof item.id !== 'string' || item.id === '') {
+        throw new Error('Equipment id must be a non-empty string');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error(`Unknown equipment kind: ${String(item.kind)}`);
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of euro cents');
+      }
+      if (equipment.has(item.id)) {
+        throw new Error(`Equipment already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      const { itemId, start, end, total } = price(request);
+      return { itemId, start, end, total };
+    },
+
+    book(request) {
+      const { itemId, start, end, total, startMs, endMs } = price(request);
+      const clash = bookings.some(
+        (b) => b.itemId === itemId && startMs < b.endMs && b.startMs < endMs,
+      );
+      if (clash) {
+        throw new Error(`Item ${itemId} is not free from ${start} to ${end}`);
+      }
+      const booking = { id: `booking-${bookings.length + 1}`, itemId, start, end, total, startMs, endMs };
+      bookings.push(booking);
+      return { id: booking.id, itemId, start, end, total };
+    },
+  };
+}
