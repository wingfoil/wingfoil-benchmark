@@ -27,10 +27,21 @@ export interface Booking extends Quote {
   id: string;
 }
 
+export interface AvailabilityQuery {
+  /** ISO-8601 UTC, midnight. */
+  start: string;
+  /** ISO-8601 UTC, midnight: the start of the day after the last day. */
+  end: string;
+  /** Only equipment of this kind; any kind when omitted. */
+  kind?: EquipmentKind;
+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  /** Sorted ids of the equipment that is free for the whole period. */
+  availability(query: AvailabilityQuery): string[];
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
@@ -106,5 +117,24 @@ export function createRentalService(): RentalService {
       bookings.push(booking);
       return { id: booking.id, itemId, start, end, total };
     },
+
+    availability(query) {
+      const startMs = parseMidnightUtc(query.start, 'start');
+      const endMs = parseMidnightUtc(query.end, 'end');
+      if (endMs <= startMs) {
+        throw new Error('end must be after start');
+      }
+      if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+        throw new Error(`Unknown equipment kind: ${String(query.kind)}`);
+      }
+      return [...equipment.values()]
+        .filter((item) => query.kind === undefined || item.kind === query.kind)
+        .filter(
+          (item) =>
+            !bookings.some((b) => b.itemId === item.id && startMs < b.endMs && b.startMs < endMs),
+        )
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
