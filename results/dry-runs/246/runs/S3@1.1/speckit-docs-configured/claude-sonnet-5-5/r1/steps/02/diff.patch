diff --git a/src/index.test.ts b/src/index.test.ts
index d0914fe1a5f58912dea92d2b6be6eec3f5cb610a..21325fcb26a76b7aa274ad8ac4b6e95098539c1b 100644
--- a/src/index.test.ts
+++ b/src/index.test.ts
@@ -76,3 +76,30 @@ test('addEquipment validates its input', () => {
   s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100 });
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 100 }));
 });
+
+test('availability lists the free equipment of a kind or of any kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'board-0', kind: 'board', dailyPrice: 2000 });
+  assert.deepEqual(s.availability({ start: d(1), end: d(3) }), ['board-0', 'board-1', 'sail-1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3), kind: 'board' }), ['board-0', 'board-1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3), kind: 'sail' }), ['sail-1']);
+});
+
+test('availability excludes equipment booked during any part of the period', () => {
+  const s = setup();
+  s.book({ itemId: 'board-1', start: d(5), end: d(8) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(6) }), ['sail-1']);
+  assert.deepEqual(s.availability({ start: d(7), end: d(10) }), ['sail-1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(20), kind: 'board' }), []);
+  // Back-to-back periods do not overlap.
+  assert.deepEqual(s.availability({ start: d(8), end: d(9) }), ['board-1', 'sail-1']);
+  assert.deepEqual(s.availability({ start: d(4), end: d(5) }), ['board-1', 'sail-1']);
+});
+
+test('availability rejects invalid periods and kinds', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: d(2), end: d(2) }));
+  assert.throws(() => s.availability({ start: 'garbage', end: d(2) }));
+  assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'boat' as never }));
+  assert.deepEqual(createRentalService().availability({ start: d(1), end: d(2) }), []);
+});
diff --git a/src/index.ts b/src/index.ts
