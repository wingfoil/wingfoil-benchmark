+    assert.equal(coupons.usedBy('WELCOME'), first.id);
+    assert.throws(() => orders.place(request), CouponError);
+
+    assert.equal(orders.cancel(first.id, request.date).status, 'cancelled');
+    assert.equal(coupons.usedBy('WELCOME'), undefined);
+    assert.equal(inventory.available('PEN-4'), 20);
+
+    const corrected = orders.place({ ...request, coupon: 'Welcome', lines: [{ sku: 'PEN-4', quantity: 2 }] });
+    assert.equal(corrected.totals.couponDiscountCents, 100);
+    assert.equal(coupons.usedBy('WELCOME'), corrected.id);
+    assert.throws(() => orders.cancel(first.id, request.date), OrderStateError);
+    assert.equal(coupons.usedBy('WELCOME'), corrected.id);
+    assert.throws(() => orders.place(request), CouponError);
+  });
 });
