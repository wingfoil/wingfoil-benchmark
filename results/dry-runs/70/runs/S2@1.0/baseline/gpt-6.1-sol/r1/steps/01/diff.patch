diff --git a/test/regressions.test.ts b/test/regressions.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..586c69998ebd92820b3eefa59dc16c37db92ba80
--- /dev/null
+++ b/test/regressions.test.ts
@@ -0,0 +1,66 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createShop } from '../src/index.ts';
+import { lineVat } from '../src/tax.ts';
+
+describe('reported order regressions', () => {
+  it('accepts lower-case and padded SKUs, merges them and reserves canonical stock', () => {
+    const { catalog, inventory, orders } = createShop();
+    const product = catalog.add({ sku: 'LB-220', name: 'Lamp', priceCents: 1000, vatClass: 'standard', weightGrams: 100 });
+    inventory.restock('LB-220', 5);
+    assert.equal(catalog.find(' lb-220 '), product);
+    assert.equal(catalog.get('lB-220'), product);
+    const request = { customer: 'c-1', date: '2026-03-02', lines: [{ sku: ' lb-220 ', quantity: 1 }, { sku: 'LB-220', quantity: 2 }] };
+    const quote = orders.quote(request);
+    assert.equal(inventory.reserved('LB-220'), 0);
+    const order = orders.place(request);
+    assert.deepEqual(order.lines, quote.lines);
+    assert.equal(order.lines.length, 1);
+    assert.equal(order.lines[0]?.sku, 'LB-220');
+    assert.equal(order.lines[0]?.quantity, 3);
+    assert.equal(inventory.available('LB-220'), 2);
+  });
+
+  for (const [goods, shipping] of [[4999, 490], [5000, 0], [5001, 0]]) {
+    it(`charges ${shipping} cents shipping for ${goods} cents of goods after a coupon`, () => {
+      const { catalog, inventory, coupons, orders } = createShop();
+      catalog.add({ sku: 'LB-220', name: 'Lamp', priceCents: 6000, vatClass: 'standard', weightGrams: 100 });
+      inventory.restock('LB-220', 1);
+      coupons.add({ code: 'DISCOUNT', kind: 'fixed', value: 6000 - goods, validFrom: '2026-01-01', validUntil: '2026-12-31' });
+      const request = { customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'LB-220', quantity: 1 }], coupon: 'DISCOUNT' };
+      const quote = orders.quote(request);
+      const order = orders.place(request);
+      assert.deepEqual(order.totals, quote.totals);
+      assert.equal(order.totals.goodsCents, goods);
+      assert.equal(order.totals.shippingCents, shipping);
+      assert.equal(order.totals.shippingVatCents, shipping === 0 ? 0 : 108);
+    });
+  }
+
+  it('rounds VAT half up on each discounted line and carries it into totals and invoices', () => {
+    const { catalog, inventory, coupons, orders, invoices } = createShop();
+    for (const sku of ['ITEM-A', 'ITEM-B']) {
+      catalog.add({ sku, name: sku, priceCents: 200, vatClass: 'standard', weightGrams: 100 });
+      inventory.restock(sku, 1);
+    }
+    coupons.add({ code: 'TWOOFF', kind: 'fixed', value: 2, validFrom: '2026-01-01', validUntil: '2026-12-31' });
+    const order = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'ITEM-A', quantity: 1 }, { sku: 'ITEM-B', quantity: 1 }], coupon: 'TWOOFF' });
+    assert.deepEqual(order.lines.map((line) => [line.netCents, line.vatCents]), [[199, 44], [199, 44]]);
+    assert.equal(order.totals.vatCents, 88);
+    assert.equal(order.totals.totalCents, 1084);
+    const invoice = invoices.issue(orders.ship(order.id, '2026-03-03'));
+    assert.deepEqual(invoice.vat, [{ rate: 22, netCents: 888, vatCents: 196 }]);
+    assert.equal(invoice.totalCents, order.totals.totalCents);
+  });
+
+  it('rounds VAT below, at and above half a cent and supports every VAT class', () => {
+    assert.equal(lineVat(201, 'standard'), 44);
+    assert.equal(lineVat(175, 'standard'), 39);
+    assert.equal(lineVat(199, 'standard'), 44);
+    assert.equal(lineVat(5, 'reduced'), 1);
+    assert.equal(lineVat(13, 'super-reduced'), 1);
+    assert.equal(lineVat(199, 'exempt'), 0);
+    assert.equal(lineVat(0, 'standard'), 0);
+  });
+});
