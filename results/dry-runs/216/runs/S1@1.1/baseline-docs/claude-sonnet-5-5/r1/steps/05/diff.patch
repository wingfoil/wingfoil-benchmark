index 0000000000000000000000000000000000000000..265de3d114e8977c304559b90f3c8d6aaffd0762
--- /dev/null
+++ b/src/diff.ts
@@ -0,0 +1,122 @@
+import { equal, isJsonValue, isObject } from "./patch.ts";
+import type { PatchOperation } from "./patch.ts";
+import { hasOwn } from "./pointer.ts";
+import type { JsonValue } from "./pointer.ts";
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function child(path: string, token: string | number): string {
+  return `${path}/${escapeToken(String(token))}`;
+}
+
+/** Lengths of the longest common subsequence of every pair of suffixes of `a` and `b`. */
+function lcsTable(a: JsonValue[], b: JsonValue[]): number[][] {
+  const table = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      table[i]![j] = equal(a[i]!, b[j]!) ? table[i + 1]![j + 1]! + 1 : Math.max(table[i + 1]![j]!, table[i]![j + 1]!);
+    }
+  }
+  return table;
+}
+
+/** Index pairs `[i, j]` such that `a[i]` equals `b[j]`, in order, as many as possible. */
+function commonItems(a: JsonValue[], b: JsonValue[]): Array<[number, number]> {
+  const table = lcsTable(a, b);
+  const pairs: Array<[number, number]> = [];
+  let i = 0;
+  let j = 0;
+  while (i < a.length && j < b.length) {
+    if (equal(a[i]!, b[j]!)) {
+      pairs.push([i++, j++]);
+    } else if (table[i + 1]![j]! >= table[i]![j + 1]!) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
+
+function diffObjects(
+  from: Record<string, JsonValue>,
+  to: Record<string, JsonValue>,
+  path: string,
+  operations: PatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!hasOwn(to, key)) {
+      operations.push({ op: "remove", path: child(path, key) });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    if (hasOwn(from, key)) {
+      diff(from[key]!, to[key]!, child(path, key), operations);
+    } else {
+      operations.push({ op: "add", path: child(path, key), value: structuredClone(to[key]!) });
+    }
+  }
+}
+
+/**
+ * Diffs the items between two common items: the items they have in common are paired up and diffed
+ * in place, the surplus of either side is removed or added. `index` is the position of the gap in
+ * the array being patched.
+ */
+function diffGap(from: JsonValue[], to: JsonValue[], index: number, path: string, operations: PatchOperation[]): void {
+  const paired = Math.min(from.length, to.length);
+  for (let k = 0; k < paired; k++) {
+    diff(from[k]!, to[k]!, child(path, index + k), operations);
+  }
+  for (let k = paired; k < from.length; k++) {
+    operations.push({ op: "remove", path: child(path, index + paired) });
+  }
+  for (let k = paired; k < to.length; k++) {
+    operations.push({ op: "add", path: child(path, index + k), value: structuredClone(to[k]!) });
+  }
+}
+
+function diffArrays(from: JsonValue[], to: JsonValue[], path: string, operations: PatchOperation[]): void {
+  const anchors: Array<[number, number]> = [...commonItems(from, to), [from.length, to.length]];
+  let fromStart = 0;
+  let toStart = 0;
+  for (const [i, j] of anchors) {
+    diffGap(from.slice(fromStart, i), to.slice(toStart, j), toStart, path, operations);
+    fromStart = i + 1;
+    toStart = j + 1;
+  }
+}
+
+function diff(from: JsonValue, to: JsonValue, path: string, operations: PatchOperation[]): void {
+  if (equal(from, to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, operations);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from as Record<string, JsonValue>, to as Record<string, JsonValue>, path, operations);
+  } else {
+    operations.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ *
+ * The patch holds only what changed: unchanged members and items are not mentioned, an array that
+ * gains or loses an item gets an `add` or a `remove` for that item, and an item that moves is
+ * removed and added back. Equal documents give an empty patch. Neither argument is mutated, and
+ * the patch shares no structure with them.
+ *
+ * @throws Error if `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new Error("createPatch: both documents must be JSON values");
+  }
+  const operations: PatchOperation[] = [];
+  diff(from, to, "", operations);
+  return operations;
+}
