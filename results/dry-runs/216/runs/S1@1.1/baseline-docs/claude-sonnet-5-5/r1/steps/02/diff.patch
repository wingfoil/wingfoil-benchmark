index 0000000000000000000000000000000000000000..9d90e2a9bd8541d176442debb2f88e2392623dc1
--- /dev/null
+++ b/src/patch.ts
@@ -0,0 +1,190 @@
+import { hasOwn, parsePointer, step } from "./pointer.ts";
+import type { JsonValue } from "./pointer.ts";
+
+/** One operation of a JSON Patch document (RFC 6902 section 4). */
+export type PatchOperation =
+  | { op: "add" | "replace" | "test"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "move" | "copy"; path: string; from: string };
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function requirePointer(operation: Record<string, unknown>, member: string): string[] {
+  const pointer = operation[member];
+  if (typeof pointer !== "string") {
+    throw new Error(`Invalid JSON Patch: "${member}" of "${String(operation.op)}" must be a string`);
+  }
+  return parsePointer(pointer);
+}
+
+function validate(operation: unknown): PatchOperation {
+  if (!isObject(operation)) {
+    throw new Error("Invalid JSON Patch: an operation must be an object");
+  }
+  switch (operation.op) {
+    case "add":
+    case "replace":
+    case "test":
+      if (!hasOwn(operation, "value")) {
+        throw new Error(`Invalid JSON Patch: "${operation.op}" requires a "value"`);
+      }
+      break;
+    case "move":
+    case "copy":
+      requirePointer(operation, "from");
+      break;
+    case "remove":
+      break;
+    default:
+      throw new Error(`Invalid JSON Patch: unknown operation "${String(operation.op)}"`);
+  }
+  requirePointer(operation, "path");
+  return operation as PatchOperation;
+}
+
+function clone(value: JsonValue): JsonValue {
+  return structuredClone(value);
+}
+
+function equal(a: JsonValue, b: JsonValue): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return (
+      Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => equal(v, b[i]))
+    );
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((k) => hasOwn(b, k) && equal(a[k] as JsonValue, b[k] as JsonValue))
+    );
+  }
+  return a === b;
+}
+
+function setMember(target: Record<string, unknown>, key: string, value: JsonValue): void {
+  // defineProperty, so that a member named "__proto__" stays an own member.
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function parentOf(document: JsonValue, tokens: string[], path: string): JsonValue {
+  return tokens.slice(0, -1).reduce<unknown>((current, token) => step(current, token, path), document) as JsonValue;
+}
+
+function arrayIndex(token: string, limit: number, path: string): number {
+  if (!ARRAY_INDEX.test(token) || Number(token) > limit) {
+    throw new Error(`JSON Patch: "${path}" is not a valid array position`);
+  }
+  return Number(token);
+}
+
+function get(document: JsonValue, tokens: string[], path: string): JsonValue {
+  return tokens.reduce<unknown>((current, token) => step(current, token, path), document) as JsonValue;
+}
+
+function add(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = parentOf(document, tokens, path);
+  const token = tokens[tokens.length - 1] as string;
+  if (Array.isArray(parent)) {
+    const index = token === "-" ? parent.length : arrayIndex(token, parent.length, path);
+    parent.splice(index, 0, value);
+  } else if (isObject(parent)) {
+    setMember(parent, token, value);
+  } else {
+    throw new Error(`JSON Patch: cannot add to "${path}": parent is not an object or array`);
+  }
+  return document;
+}
+
+function remove(document: JsonValue, path: string): JsonValue {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    throw new Error("JSON Patch: the whole document cannot be removed");
+  }
+  get(document, tokens, path);
+  const parent = parentOf(document, tokens, path);
+  const token = tokens[tokens.length - 1] as string;
+  if (Array.isArray(parent)) {
+    parent.splice(Number(token), 1);
+  } else {
+    delete (parent as Record<string, unknown>)[token];
+  }
+  return document;
+}
+
+function replace(document: JsonValue, path: string, value: JsonValue): JsonValue {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) {
+    return value;
+  }
+  get(document, tokens, path);
+  const parent = parentOf(document, tokens, path);
+  const token = tokens[tokens.length - 1] as string;
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else {
+    setMember(parent as Record<string, unknown>, token, value);
+  }
+  return document;
+}
+
+function move(document: JsonValue, from: string, path: string): JsonValue {
+  const source = parsePointer(from);
+  const target = parsePointer(path);
+  const value = get(document, source, from);
+  const isSameOrInside = source.length <= target.length && source.every((token, i) => token === target[i]);
+  if (isSameOrInside) {
+    if (source.length === target.length) {
+      return document;
+    }
+    throw new Error(`JSON Patch: cannot move "${from}" into its own child "${path}"`);
+  }
+  return add(remove(document, from), path, value);
+}
+
+function applyOperation(document: JsonValue, operation: PatchOperation): JsonValue {
+  switch (operation.op) {
+    case "add":
+      return add(document, operation.path, clone(operation.value));
+    case "remove":
+      return remove(document, operation.path);
+    case "replace":
+      return replace(document, operation.path, clone(operation.value));
+    case "move":
+      return move(document, operation.from, operation.path);
+    case "copy":
+      return add(document, operation.path, clone(get(document, parsePointer(operation.from), operation.from)));
+    case "test":
+      if (!equal(get(document, parsePointer(operation.path), operation.path), operation.value)) {
+        throw new Error(`JSON Patch: test failed at "${operation.path}"`);
+      }
+      return document;
+  }
+}
+
+/**
+ * Applies the JSON Patch `patch` (RFC 6902) to `document` and returns the resulting document.
+ *
+ * Neither argument is mutated. The patch is applied atomically: if any operation fails, nothing is
+ * returned. Removing the whole document (`remove` with the empty path) is rejected, since the
+ * result would not be a JSON value.
+ *
+ * @throws Error if `patch` is not a valid JSON Patch (not an array, unknown `op`, missing or
+ * mistyped member, invalid pointer), or if an operation fails (target does not resolve, array
+ * position out of range, `move` into its own child, `test` mismatch).
+ */
+export function applyPatch(document: JsonValue, patch: PatchOperation[]): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new Error("Invalid JSON Patch: a patch must be an array of operations");
+  }
+  const operations = patch.map(validate);
+  return operations.reduce(applyOperation, clone(document));
+}
