diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ce937178c32a7e39cf6ba83ebf1d6bd29591d172
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,103 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+import type { JsonValue, PatchOperation } from "../src/index.ts";
+
+const patch = (document: JsonValue, ...operations: unknown[]): JsonValue =>
+  applyPatch(document, operations as PatchOperation[]);
+
+// Examples of RFC 6902 appendix A.
+test("add: member, array element, replacing an existing member", () => {
+  assert.deepEqual(patch({ foo: "bar" }, { op: "add", path: "/baz", value: "qux" }), { foo: "bar", baz: "qux" });
+  assert.deepEqual(patch({ foo: ["bar", "baz"] }, { op: "add", path: "/foo/1", value: "qux" }), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(patch({ foo: ["a"] }, { op: "add", path: "/foo/-", value: "b" }), { foo: ["a", "b"] });
+  assert.deepEqual(patch({ foo: 1 }, { op: "add", path: "/foo", value: 2 }), { foo: 2 });
+  assert.deepEqual(patch({ a: 1 }, { op: "add", path: "", value: [1] }), [1]);
+});
+
+test("add: errors", () => {
+  assert.throws(() => patch({ foo: "bar" }, { op: "add", path: "/baz/bat", value: "qux" }));
+  assert.throws(() => patch({ foo: ["a"] }, { op: "add", path: "/foo/2", value: "x" }));
+  assert.throws(() => patch({ foo: ["a"] }, { op: "add", path: "/foo/01", value: "x" }));
+  assert.throws(() => patch({ foo: 1 }, { op: "add", path: "/foo/bar", value: "x" }));
+});
+
+test("remove", () => {
+  assert.deepEqual(patch({ baz: "qux", foo: "bar" }, { op: "remove", path: "/baz" }), { foo: "bar" });
+  assert.deepEqual(patch({ foo: ["bar", "qux", "baz"] }, { op: "remove", path: "/foo/1" }), { foo: ["bar", "baz"] });
+  assert.throws(() => patch({}, { op: "remove", path: "/a" }));
+  assert.throws(() => patch({ a: [] }, { op: "remove", path: "/a/-" }));
+  assert.throws(() => patch({}, { op: "remove", path: "" }));
+});
+
+test("replace", () => {
+  assert.deepEqual(patch({ baz: "qux" }, { op: "replace", path: "/baz", value: "boo" }), { baz: "boo" });
+  assert.deepEqual(patch([1, 2], { op: "replace", path: "/1", value: 3 }), [1, 3]);
+  assert.deepEqual(patch({ a: 1 }, { op: "replace", path: "", value: 5 }), 5);
+  assert.throws(() => patch({}, { op: "replace", path: "/a", value: 1 }));
+  assert.throws(() => patch([1], { op: "replace", path: "/1", value: 1 }));
+});
+
+test("move", () => {
+  assert.deepEqual(
+    patch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, { op: "move", from: "/foo/waldo", path: "/qux/thud" }),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(patch({ foo: ["all", "grass", "cows", "eat"] }, { op: "move", from: "/foo/1", path: "/foo/3" }), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  assert.deepEqual(patch({ a: 1 }, { op: "move", from: "/a", path: "/a" }), { a: 1 });
+  assert.throws(() => patch({ a: {} }, { op: "move", from: "/a", path: "/a/b" }));
+  assert.throws(() => patch({}, { op: "move", from: "/a", path: "/b" }));
+});
+
+test("copy", () => {
+  const result = patch({ foo: { bar: [1] } }, { op: "copy", from: "/foo", path: "/baz" }) as any;
+  assert.deepEqual(result, { foo: { bar: [1] }, baz: { bar: [1] } });
+  assert.notEqual(result.foo, result.baz);
+  assert.throws(() => patch({}, { op: "copy", from: "/a", path: "/b" }));
+});
+
+test("test", () => {
+  assert.deepEqual(patch({ a: { x: 1, y: [1, 2] } }, { op: "test", path: "/a", value: { y: [1, 2], x: 1 } }), { a: { x: 1, y: [1, 2] } });
+  assert.deepEqual(patch({ a: null }, { op: "test", path: "/a", value: null }), { a: null });
+  assert.throws(() => patch({ a: 1 }, { op: "test", path: "/a", value: "1" }));
+  assert.throws(() => patch({ a: [1, 2] }, { op: "test", path: "/a", value: [1] }));
+  assert.throws(() => patch({ a: {} }, { op: "test", path: "/a", value: [] }));
+  assert.throws(() => patch({ a: 1 }, { op: "test", path: "/b", value: 1 }));
+});
+
+test("does not mutate its input, and is atomic", () => {
+  const document = { a: [1, { b: 2 }] };
+  const operations = [{ op: "add", path: "/a/0", value: { c: 3 } }] as PatchOperation[];
+  const result = applyPatch(document, operations) as any;
+  assert.deepEqual(document, { a: [1, { b: 2 }] });
+  assert.deepEqual(operations, [{ op: "add", path: "/a/0", value: { c: 3 } }]);
+  result.a[0].c = 4;
+  assert.equal((operations[0] as any).value.c, 3);
+  assert.throws(() => patch(document, { op: "remove", path: "/a/0" }, { op: "test", path: "/a", value: 0 }));
+  assert.deepEqual(document, { a: [1, { b: 2 }] });
+});
+
+test("operations apply in order", () => {
+  assert.deepEqual(patch({}, { op: "add", path: "/a", value: 1 }, { op: "copy", from: "/a", path: "/b" }), { a: 1, b: 1 });
+});
+
+test("__proto__ is an ordinary member", () => {
+  const result = patch({}, { op: "add", path: "/__proto__", value: { x: 1 } }) as object;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+});
+
+test("invalid patches", () => {
+  assert.throws(() => applyPatch({}, {} as any));
+  assert.throws(() => patch({}, null));
+  assert.throws(() => patch({}, { path: "/a" }));
+  assert.throws(() => patch({}, { op: "bogus", path: "/a" }));
+  assert.throws(() => patch({}, { op: "add", path: "/a" }));
+  assert.throws(() => patch({}, { op: "add", value: 1 }));
+  assert.throws(() => patch({}, { op: "add", path: "a", value: 1 }));
+  assert.throws(() => patch({}, { op: "move", path: "/a" }));
+  assert.throws(() => patch({}, { op: "copy", from: 1, path: "/a" }));
+  assert.deepEqual(patch({ a: 1 }), { a: 1 });
+});
