diff --git a/src/mergePatch.ts b/src/mergePatch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..33cf93d1d8e6782f31fd0d802de3c86333115043
--- /dev/null
+++ b/src/mergePatch.ts
@@ -0,0 +1,44 @@
+import { hasOwn } from "./pointer.ts";
+import type { JsonValue } from "./pointer.ts";
+import { isJsonValue, isObject, setMember } from "./patch.ts";
+
+function merge(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result: Record<string, JsonValue> = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) {
+      setMember(result, key, target[key] as JsonValue);
+    }
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key] as JsonValue;
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, merge(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies the JSON Merge Patch `patch` (RFC 7386) to `target` and returns the merged document.
+ *
+ * A patch that is not an object replaces the target as a whole (arrays included, they are never
+ * merged). An object patch is merged member by member: `null` removes the member, any other value
+ * is merged recursively, and a target that is not an object is treated as an empty one. Neither
+ * argument is mutated. Since `null` means "remove", a member cannot be set to `null`.
+ *
+ * @throws Error if `target` or `patch` is not a JSON value.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonValue(target)) {
+    throw new Error("Invalid JSON Merge Patch: the target is not a JSON value");
+  }
+  if (!isJsonValue(patch)) {
+    throw new Error("Invalid JSON Merge Patch: the patch is not a JSON value");
+  }
+  return merge(target, patch);
+}
