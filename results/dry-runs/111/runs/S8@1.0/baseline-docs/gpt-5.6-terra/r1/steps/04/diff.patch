 export function createTodoList(now: () => string = () => new Date().toISOString()): TaskList {
   return createTaskList(now);
 }
+
+/** A source line that could not be imported into a task list. */
+export interface ImportRejection {
+  /** The one-based line number in the imported text. */
+  readonly line: number;
+  /** Why the line was not added. */
+  readonly reason: string;
+}
+
+/** The counts and failures from a bulk task import. */
+export interface ImportTasksResult {
+  /** How many tasks were added. */
+  readonly imported: number;
+  /** Every non-blank line that could not be added. */
+  readonly rejected: readonly ImportRejection[];
+}
+
+/**
+ * Imports non-blank `title;priority;tags` rows into a task list. An empty priority uses `normal`,
+ * and tags are separated by whitespace. Invalid rows are reported and do not stop later rows.
+ *
+ * @param list - the list that receives the imported tasks
+ * @param text - one spreadsheet-style task row per line
+ */
+export function importTasks(list: TaskList, text: string): ImportTasksResult {
+  const rejected: ImportRejection[] = [];
+  let imported = 0;
+
+  for (const [index, line] of text.split('\n').entries()) {
+    if (line.trim() === '') continue;
+    const fields = line.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'line must have title;priority;tags format' });
+      continue;
+    }
+
+    const [title, rawPriority, rawTags] = fields;
+    const priority = rawPriority.trim();
+    const tags = rawTags.trim() === '' ? [] : rawTags.trim().split(/\s+/);
+    const result = list.add({ title, priority: priority === '' ? undefined : (priority as Priority), tags });
+    if (result.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  }
+
+  return { imported, rejected };
+}
