 describe('task list', () => {
+  it('records creation and each task change time', () => {
+    const timestamps = [
+      '2026-10-28T09:00:00.000Z',
+      '2026-10-28T09:01:00.000Z',
+      '2026-10-28T09:02:00.000Z',
+      '2026-10-28T09:03:00.000Z',
+      '2026-10-28T09:04:00.000Z',
+      '2026-10-28T09:05:00.000Z',
+    ];
+    const list = createTodoList(() => timestamps.shift()!);
+
+    const added = valueOf(list.add({ title: 'Buy milk' }));
+    assert.equal(added.createdAt, '2026-10-28T09:00:00.000Z');
+    assert.equal(added.updatedAt, added.createdAt);
+
+    const completed = valueOf(list.complete(added.id));
+    const reopened = valueOf(list.reopen(added.id));
+    const renamed = valueOf(list.rename(added.id, 'Get milk'));
+    const tagged = valueOf(list.tag(added.id, 'shopping'));
+    const untagged = valueOf(list.untag(added.id, 'shopping'));
+
+    assert.deepEqual(
+      [completed, reopened, renamed, tagged, untagged].map((task) => task.updatedAt),
+      [
+        '2026-10-28T09:01:00.000Z',
+        '2026-10-28T09:02:00.000Z',
+        '2026-10-28T09:03:00.000Z',
+        '2026-10-28T09:04:00.000Z',
+        '2026-10-28T09:05:00.000Z',
+      ],
+    );
+    assert.ok([completed, reopened, renamed, tagged, untagged].every((task) => task.createdAt === added.createdAt));
+  });
+
   it('adds an open task with a normal priority by default', () => {
