@@ -0,0 +1,57 @@
+import type { TaskList } from './list.ts';
+import type { Priority } from './task.ts';
+
+/** A line of the import text that could not be added, and why. */
+export interface RejectedLine {
+  /** The line's number in the text, counting from 1. */
+  readonly line: number;
+  /** What was wrong with the line, for the person importing it. */
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks were added, and every line that could not be added. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Adds one task per line of `text`, each line written as `title;priority;tags`. The priority may be left
+ * empty for a normal one, and the tags are separated by spaces. Blank lines are skipped. Each line is
+ * added on its own: a line that cannot be added is reported and does not stop the others.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import, one task per line
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  const lines = text.split(/\r?\n/);
+
+  for (let index = 0; index < lines.length; index += 1) {
+    const raw = lines[index];
+    if (raw.trim() === '') continue;
+    const line = index + 1;
+
+    const fields = raw.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line, reason: 'the line must have three fields: title;priority;tags' });
+      continue;
+    }
+    const [title, priority, tags] = fields.map((field) => field.trim());
+
+    // The list checks the priority when it is given, so an unknown one is reported by `add`.
+    const result = list.add({
+      title,
+      ...(priority === '' ? {} : { priority: priority as Priority }),
+      tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+    });
+    if (result.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line, reason: result.error.message });
+    }
+  }
+
+  return { imported, rejected };
+}
