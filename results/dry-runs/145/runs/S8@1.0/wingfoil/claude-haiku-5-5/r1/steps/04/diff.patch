diff --git a/test/bulk-import.test.ts b/test/bulk-import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0425834f2f490205840ea8307a62e73adbe72040
--- /dev/null
+++ b/test/bulk-import.test.ts
@@ -0,0 +1,74 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+const fixedClock = () => '2026-03-01T09:00:00.000Z';
+
+describe('importTasks', () => {
+  it('adds a task per line, with its priority and tags', () => {
+    const list = createTodoList(fixedClock);
+    const result = importTasks(list, 'Renew the insurance;high;admin money\nBuy milk;;');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+    const [insurance, milk] = list.list();
+    assert.equal(insurance.title, 'Renew the insurance');
+    assert.equal(insurance.priority, 'high');
+    assert.deepEqual(insurance.tags, ['admin', 'money']);
+    assert.equal(milk.priority, 'normal');
+    assert.deepEqual(milk.tags, []);
+  });
+
+  it('skips blank lines but counts them in the line numbers', () => {
+    const list = createTodoList(fixedClock);
+    const result = importTasks(list, 'Water the plants;;\n\n   \nBad;urgent;\n');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(result.rejected, [
+      { line: 4, reason: 'the priority "urgent" is not low, normal or high' },
+    ]);
+  });
+
+  it('reports a rejected line and still adds the others', () => {
+    const list = createTodoList(fixedClock);
+    const text = ['Call the plumber;;', ';high;', 'Call the plumber;low;', 'Pay rent;normal;home'].join('\n');
+    const result = importTasks(list, text);
+    assert.equal(result.imported, 2);
+    assert.deepEqual(result.rejected, [
+      { line: 2, reason: 'the title is empty' },
+      { line: 3, reason: 'there is already a task "Call the plumber"' },
+    ]);
+    assert.equal(list.list().length, 2);
+  });
+
+  it('rejects a line that does not have three fields', () => {
+    const list = createTodoList(fixedClock);
+    const result = importTasks(list, 'Just a title\nTitle;high;a;b');
+    assert.equal(result.imported, 0);
+    assert.deepEqual(result.rejected, [
+      { line: 1, reason: 'the line must have three fields: title;priority;tags' },
+      { line: 2, reason: 'the line must have three fields: title;priority;tags' },
+    ]);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a title that is too long', () => {
+    const list = createTodoList(fixedClock);
+    const result = importTasks(list, `${'x'.repeat(121)};;`);
+    assert.deepEqual(result.rejected, [
+      { line: 1, reason: 'the title is longer than 120 characters' },
+    ]);
+  });
+
+  it('accepts Windows line endings and splits tags on any run of spaces', () => {
+    const list = createTodoList(fixedClock);
+    const result = importTasks(list, 'One;;a   b\r\nTwo;low;c');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+    assert.deepEqual(list.list({ tag: 'b' }).map((task) => task.title), ['One']);
+    assert.deepEqual(list.list({ tag: 'c' }).map((task) => task.title), ['Two']);
+  });
+
+  it('imports nothing from an empty text', () => {
+    const list = createTodoList(fixedClock);
+    assert.deepEqual(importTasks(list, ''), { imported: 0, rejected: [] });
+    assert.equal(list.list().length, 0);
+  });
+});
