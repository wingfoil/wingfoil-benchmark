+
+describe('task input', () => {
+  const invalid = (result: { ok: boolean; error?: { code: string; message: string } }, words: string) => {
+    assert.equal(result.ok, false);
+    if (result.ok) return;
+    assert.equal(result.error?.code, 'invalid-input');
+    assert.match(result.error?.message ?? '', new RegExp(words));
+  };
+
+  it('refuses a title that is empty or only spaces, and adds nothing', () => {
+    const list = createTodoList(fixedClock);
+    invalid(list.add({ title: '' }), 'empty');
+    invalid(list.add({ title: '   ' }), 'empty');
+    assert.equal(list.list().length, 0);
+  });
+
+  it('refuses a title longer than 120 characters, counted after trimming', () => {
+    const list = createTodoList(fixedClock);
+    invalid(list.add({ title: 'x'.repeat(121) }), '120');
+    invalid(list.add({ title: `  ${'x'.repeat(121)}  ` }), '120');
+    assert.equal(list.list().length, 0);
+  });
+
+  it('accepts a title of exactly 120 characters', () => {
+    const list = createTodoList(fixedClock);
+    assert.equal(valueOf(list.add({ title: 'x'.repeat(120) })).title.length, 120);
+  });
+
+  it('refuses a priority other than low, normal and high', () => {
+    const list = createTodoList(fixedClock);
+    invalid(list.add({ title: 'Buy milk', priority: 'urgent' as never }), 'priority');
+    assert.equal(list.list().length, 0);
+  });
+
+  it('refuses a tag that is empty or contains a space, on add', () => {
+    const list = createTodoList(fixedClock);
+    invalid(list.add({ title: 'Buy milk', tags: [''] }), 'tag');
+    invalid(list.add({ title: 'Buy milk', tags: ['part time'] }), 'tag');
+    assert.equal(list.list().length, 0);
+  });
+
+  it('refuses a tag that is empty or contains a space, on tag', () => {
+    const list = createTodoList(fixedClock);
+    const task = valueOf(list.add({ title: 'Buy milk' }));
+    invalid(list.tag(task.id, ''), 'tag');
+    invalid(list.tag(task.id, ' '), 'tag');
+    invalid(list.tag(task.id, 'part time'), 'tag');
+    assert.deepEqual(valueOf(list.get(task.id)).tags, []);
+  });
+
+  it('refuses a rename to an invalid title, and keeps the title and updatedAt', () => {
+    let now = '2026-02-14T18:30:00.000Z';
+    const list = createTodoList(() => now);
+    const task = valueOf(list.add({ title: 'Buy milk' }));
+    now = '2026-02-15T08:00:00.000Z';
+    invalid(list.rename(task.id, '  '), 'empty');
+    invalid(list.rename(task.id, 'x'.repeat(121)), '120');
+    const kept = valueOf(list.get(task.id));
+    assert.equal(kept.title, 'Buy milk');
+    assert.equal(kept.updatedAt, '2026-02-14T18:30:00.000Z');
+  });
+
+  it('refuses a tag on an invalid tag, and keeps the tags it had', () => {
+    const list = createTodoList(fixedClock);
+    const task = valueOf(list.add({ title: 'Buy milk', tags: ['shop'] }));
+    invalid(list.tag(task.id, 'two words'), 'tag');
+    assert.deepEqual(valueOf(list.get(task.id)).tags, ['shop']);
+  });
+
+  it('still untags a tag by name', () => {
+    const list = createTodoList(fixedClock);
+    const task = valueOf(list.add({ title: 'Buy milk', tags: ['shop'] }));
+    assert.deepEqual(valueOf(list.untag(task.id, 'shop')).tags, []);
+  });
+});
