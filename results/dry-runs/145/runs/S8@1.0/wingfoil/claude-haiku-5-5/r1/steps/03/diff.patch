@@ -0,0 +1,44 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import { PRIORITIES } from './task.ts';
+import type { Priority } from './task.ts';
+
+/** The longest title a task may have, in characters, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * A title as it is stored: trimmed, not empty, and at most `MAX_TITLE_LENGTH` characters long.
+ *
+ * @param title - the title as the person typed it
+ */
+export function checkTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed === '') return err('invalid-input', 'the title is empty');
+  if ([...trimmed].length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is longer than ${MAX_TITLE_LENGTH} characters`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * A tag that can be stored: not empty, and without any whitespace, so that it is one word.
+ *
+ * @param tag - the tag as it was given
+ */
+export function checkTag(tag: string): Result<string> {
+  if (tag === '') return err('invalid-input', 'the tag is empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" contains a space or other whitespace`);
+  return ok(tag);
+}
+
+/**
+ * A priority that exists: one of `low`, `normal` or `high`.
+ *
+ * @param priority - the priority as it was given
+ */
+export function checkPriority(priority: Priority): Result<Priority> {
+  if (!(PRIORITIES as readonly string[]).includes(priority)) {
+    return err('invalid-input', `the priority "${priority}" is not low, normal or high`);
+  }
+  return ok(priority);
+}
