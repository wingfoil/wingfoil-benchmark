+
+describe('task ids', () => {
+  it('gives each added task its own id, which renaming and changing keep', () => {
+    const list = createTodoList();
+    const first = valueOf(list.add({ title: 'Buy milk' }));
+    const second = valueOf(list.add({ title: 'Call the plumber' }));
+    assert.notEqual(first.id, second.id);
+    assert.equal(valueOf(list.rename(first.id, 'Buy oat milk')).id, first.id);
+    assert.equal(valueOf(list.complete(first.id)).id, first.id);
+    assert.equal(valueOf(list.reopen(first.id)).id, first.id);
+    assert.equal(valueOf(list.tag(first.id, 'shop')).id, first.id);
+    assert.equal(valueOf(list.untag(first.id, 'shop')).id, first.id);
+  });
+
+  it('gets a task by its id', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'Water the plants' }));
+    assert.deepEqual(valueOf(list.get(task.id)), task);
+  });
+
+  it('fails to get an id no task has', () => {
+    const list = createTodoList();
+    const missing = list.get('task-9');
+    assert.equal(missing.ok, false);
+    if (!missing.ok) assert.equal(missing.error.code, 'not-found');
+  });
+
+  it('never reuses the id of a removed task', () => {
+    const list = createTodoList();
+    const old = valueOf(list.add({ title: 'Old' }));
+    valueOf(list.remove(old.id));
+    assert.equal(list.get(old.id).ok, false);
+    assert.notEqual(valueOf(list.add({ title: 'New' })).id, old.id);
+  });
+
+  it('accepts an id wherever a title is accepted', () => {
+    const list = createTodoList();
+    const task = valueOf(list.add({ title: 'Fix the tap' }));
+    assert.equal(valueOf(list.find(task.id)).title, 'Fix the tap');
+    assert.equal(valueOf(list.complete(task.id)).status, 'done');
+    assert.equal(valueOf(list.reopen(task.id)).status, 'open');
+    assert.equal(valueOf(list.rename(task.id, 'Fix the kitchen tap')).title, 'Fix the kitchen tap');
+    assert.deepEqual(valueOf(list.tag(task.id, 'house')).tags, ['house']);
+    assert.deepEqual(valueOf(list.untag(task.id, 'house')).tags, []);
+    assert.equal(valueOf(list.remove(task.id)).title, 'Fix the kitchen tap');
+    assert.equal(list.list().length, 0);
+  });
+
+  it('looks a reference up as an id before a title', () => {
+    const list = createTodoList();
+    const first = valueOf(list.add({ title: 'Buy milk' }));
+    const second = valueOf(list.add({ title: 'task-1' }));
+    assert.equal(valueOf(list.find('task-1')).id, first.id);
+    assert.equal(valueOf(list.find(second.id)).title, 'task-1');
+  });
+
+  it('refuses to rename a task to the title of another task, by id too', () => {
+    const list = createTodoList();
+    const milk = valueOf(list.add({ title: 'Buy milk' }));
+    list.add({ title: 'Call the plumber' });
+    const clash = list.rename(milk.id, 'Call the plumber');
+    assert.equal(clash.ok, false);
+    if (!clash.ok) assert.equal(clash.error.code, 'duplicate');
+    assert.equal(valueOf(list.rename(milk.id, 'Buy milk')).title, 'Buy milk');
+  });
+});
