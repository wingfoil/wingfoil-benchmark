diff --git a/test/index.test.mjs b/test/index.test.mjs
index 5aab6106cb947dcc97ce322f6548429865c57bf7..09be326ef3ce7998efee9bf1cf49a6ddde603716 100644
--- a/test/index.test.mjs
+++ b/test/index.test.mjs
@@ -96,3 +96,43 @@ test("rejects invalid patches and operations that cannot be applied", () => {
     assert.throws(() => applyPatch({ a: { child: 1 }, list: [] }, patch));
   }
 });
+
+test("rejects JavaScript values that cannot represent JSON", () => {
+  const sparseDocument = [];
+  sparseDocument.length = 1;
+  const sparseValue = [];
+  sparseValue.length = 1;
+  const hiddenOperation = { path: "/value", value: 2 };
+  Object.defineProperty(hiddenOperation, "op", { value: "replace" });
+
+  for (const [document, patch] of [
+    [sparseDocument, []],
+    [{ values: [] }, [{ op: "add", path: "/values/-", value: sparseValue }]],
+    [{ value: 1 }, [{ op: "replace", path: "/value", value: Number.NaN }]],
+    [{ value: 1 }, [hiddenOperation]],
+  ]) {
+    assert.throws(() => applyPatch(document, patch));
+  }
+});
+
+test("terminates a failed patch without mutating its input document", () => {
+  const original = { value: 1 };
+
+  assert.throws(() => applyPatch(original, [
+    { op: "replace", path: "/value", value: 2 },
+    { op: "test", path: "/value", value: 3 },
+    { op: "replace", path: "/value", value: 4 },
+  ]));
+
+  assert.deepEqual(original, { value: 1 });
+});
+
+test("compares JSON primitive values by value and type", () => {
+  for (const value of [2, true, false, "two"]) {
+    assert.throws(() => applyPatch({ value }, [{ op: "test", path: "/value", value: null }]));
+  }
+
+  assert.throws(() => applyPatch({ value: true }, [{ op: "test", path: "/value", value: false }]));
+  assert.throws(() => applyPatch({ value: 2 }, [{ op: "test", path: "/value", value: 3 }]));
+  assert.throws(() => applyPatch({ value: "two" }, [{ op: "test", path: "/value", value: "one" }]));
+});
