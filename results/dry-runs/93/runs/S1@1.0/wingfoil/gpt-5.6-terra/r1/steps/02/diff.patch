index 3dd3b5c28f03c7b0f834dc6c573f7ec378d4b68d..9331a6335f32c25ea70fc84ec51ce11f1fcb8d77 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -38,6 +38,246 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   return value;
 }
 
+type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
+
+/**
+ * Applies an RFC 6902 JSON Patch to a JSON document.
+ *
+ * @param document The JSON document to transform.
+ * @param patch An array of JSON Patch operation objects.
+ * @returns A new JSON document with every operation applied in order.
+ * @throws {Error} If the document or patch is invalid, or an operation cannot be applied.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!isJsonValue(document) || !Array.isArray(patch) || !isJsonValue(patch)) {
+    throw new Error("Invalid JSON Patch document or patch");
+  }
+
+  let result = cloneJson(document);
+
+  for (const operation of patch) {
+    result = applyOperation(result, operation);
+  }
+
+  return result;
+}
+
+function applyOperation(document: JsonValue, operation: unknown): JsonValue {
+  if (operation === null || typeof operation !== "object" || Array.isArray(operation)) {
+    throw new Error("Invalid JSON Patch operation");
+  }
+
+  const patch = operation as Record<string, unknown>;
+  if (!Object.hasOwn(patch, "op") || typeof patch.op !== "string" ||
+      !Object.hasOwn(patch, "path") || typeof patch.path !== "string") {
+    throw new Error("JSON Patch operation requires string op and path members");
+  }
+
+  const path = parsePointer(patch.path);
+
+  switch (patch.op) {
+    case "add":
+      return addValue(document, path, requiredJsonValue(patch, "value"));
+    case "remove":
+      return removeValue(document, path);
+    case "replace":
+      return replaceValue(document, path, requiredJsonValue(patch, "value"));
+    case "move": {
+      const from = requiredPointer(patch, "from");
+      if (isProperPrefix(from, path)) {
+        throw new Error("Cannot move a value into one of its children");
+      }
+      const value = getValue(document, from);
+      return addValue(removeValue(document, from), path, value);
+    }
+    case "copy":
+      return addValue(document, path, cloneJson(getValue(document, requiredPointer(patch, "from"))));
+    case "test":
+      if (!jsonEqual(getValue(document, path), requiredJsonValue(patch, "value"))) {
+        throw new Error("JSON Patch test operation failed");
+      }
+      return document;
+    default:
+      throw new Error(`Unsupported JSON Patch operation: ${patch.op}`);
+  }
+}
+
+function addValue(document: JsonValue, path: string[], value: JsonValue): JsonValue {
+  if (path.length === 0) {
+    return cloneJson(value);
+  }
+
+  const { parent, token } = getParent(document, path);
+  const copy = cloneJson(value);
+  if (Array.isArray(parent)) {
+    if (token === "-") {
+      parent.push(copy);
+      return document;
+    }
+    const index = arrayIndex(token, parent.length, true);
+    parent.splice(index, 0, copy);
+    return document;
+  }
+  defineJsonMember(parent, token, copy);
+  return document;
+}
+
+function removeValue(document: JsonValue, path: string[]): JsonValue {
+  if (path.length === 0) {
+    throw new Error("Cannot remove the whole JSON document");
+  }
+
+  const { parent, token } = getParent(document, path);
+  if (Array.isArray(parent)) {
+    parent.splice(arrayIndex(token, parent.length, false), 1);
+  } else {
+    if (!Object.hasOwn(parent, token)) {
+      throw new Error("JSON Patch path does not exist");
+    }
+    delete parent[token];
+  }
+  return document;
+}
+
+function replaceValue(document: JsonValue, path: string[], value: JsonValue): JsonValue {
+  if (path.length === 0) {
+    return cloneJson(value);
+  }
+
+  const { parent, token } = getParent(document, path);
+  if (Array.isArray(parent)) {
+    parent[arrayIndex(token, parent.length, false)] = cloneJson(value);
+  } else {
+    if (!Object.hasOwn(parent, token)) {
+      throw new Error("JSON Patch path does not exist");
+    }
+    defineJsonMember(parent, token, cloneJson(value));
+  }
+  return document;
+}
+
+function getValue(document: JsonValue, path: string[]): JsonValue {
+  let value = document;
+  for (const token of path) {
+    if (Array.isArray(value)) {
+      value = value[arrayIndex(token, value.length, false)];
+    } else if (value !== null && typeof value === "object" && Object.hasOwn(value, token)) {
+      value = value[token];
+    } else {
+      throw new Error("JSON Patch path does not exist");
+    }
+  }
+  return value;
+}
+
+function getParent(document: JsonValue, path: string[]): { parent: JsonValue[] | { [key: string]: JsonValue }; token: string } {
+  const token = path[path.length - 1];
+  const parent = getValue(document, path.slice(0, -1));
+  if (parent === null || typeof parent !== "object") {
+    throw new Error("JSON Patch path parent is not a container");
+  }
+  return { parent, token };
+}
+
+function requiredPointer(operation: Record<string, unknown>, member: string): string[] {
+  if (!Object.hasOwn(operation, member) || typeof operation[member] !== "string") {
+    throw new Error(`JSON Patch operation requires a string ${member} member`);
+  }
+  return parsePointer(operation[member]);
+}
+
+function requiredJsonValue(operation: Record<string, unknown>, member: string): JsonValue {
+  if (!Object.hasOwn(operation, member) || !isJsonValue(operation[member])) {
+    throw new Error(`JSON Patch operation requires a JSON ${member} member`);
+  }
+  return operation[member];
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error("Invalid JSON Pointer");
+  }
+  return pointer.slice(1).split("/").map(decodeReferenceToken);
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (!isArrayIndex(token)) {
+    throw new Error("Invalid JSON Patch array index");
+  }
+  const index = Number(token);
+  if (!Number.isSafeInteger(index) || index > length || (!allowEnd && index === length)) {
+    throw new Error("JSON Patch array index is out of bounds");
+  }
+  return index;
+}
+
+function isProperPrefix(prefix: string[], value: string[]): boolean {
+  return prefix.length < value.length && prefix.every((token, index) => token === value[index]);
+}
+
+function defineJsonMember(object: { [key: string]: JsonValue }, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { configurable: true, enumerable: true, value, writable: true });
+}
+
+function cloneJson(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(cloneJson);
+  }
+  if (value !== null && typeof value === "object") {
+    const copy: { [key: string]: JsonValue } = {};
+    for (const key of Object.keys(value)) {
+      defineJsonMember(copy, key, cloneJson(value[key]));
+    }
+    return copy;
+  }
+  return value;
+}
+
+function isJsonValue(value: unknown, seen = new Set<object>()): value is JsonValue {
+  if (value === null || typeof value === "string" || typeof value === "boolean") {
+    return true;
+  }
+  if (typeof value === "number") {
+    return Number.isFinite(value);
+  }
+  if (typeof value !== "object" || seen.has(value)) {
+    return false;
+  }
+  if (Array.isArray(value)) {
+    seen.add(value);
+    const valid = value.every((item) => isJsonValue(item, seen));
+    seen.delete(value);
+    return valid;
+  }
+  if (Object.getPrototypeOf(value) !== Object.prototype && Object.getPrototypeOf(value) !== null) {
+    return false;
+  }
+  seen.add(value);
+  const valid = Object.keys(value).every((key) => isJsonValue((value as Record<string, unknown>)[key], seen));
+  seen.delete(value);
+  return valid;
+}
+
+function jsonEqual(left: JsonValue, right: JsonValue): boolean {
+  if (left === right) {
+    return true;
+  }
+  if (typeof left !== typeof right || left === null || right === null) {
+    return false;
+  }
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return Array.isArray(left) && Array.isArray(right) && left.length === right.length &&
+      left.every((value, index) => jsonEqual(value, right[index]));
+  }
+  const leftKeys = Object.keys(left);
+  const rightKeys = Object.keys(right);
+  return leftKeys.length === rightKeys.length && leftKeys.every((key) =>
+    Object.hasOwn(right, key) && jsonEqual(left[key], right[key]));
+}
+
 function decodeReferenceToken(token: string): string {
   if (/~(?:[^01]|$)/.test(token)) {
     throw new Error("Invalid JSON Pointer escape sequence");
