+
+test("applies every RFC 6902 operation without mutating its inputs", () => {
+  const original = {
+    title: "Goodbye!",
+    author: { name: "Nigel" },
+    tags: ["example", "sample"],
+    "a/b": 1,
+  };
+  const patch = [
+    { op: "add", path: "/author/email", value: "nigel@example.com" },
+    { op: "add", path: "/tags/1", value: "new" },
+    { op: "replace", path: "/title", value: "Hello!" },
+    { op: "copy", from: "/author", path: "/editor" },
+    { op: "move", from: "/tags/0", path: "/tags/-" },
+    { op: "test", path: "/a~1b", value: 1 },
+    { op: "remove", path: "/author/name" },
+  ];
+
+  const result = applyPatch(original, patch);
+
+  assert.deepEqual(result, {
+    title: "Hello!",
+    author: { email: "nigel@example.com" },
+    editor: { name: "Nigel", email: "nigel@example.com" },
+    tags: ["new", "sample", "example"],
+    "a/b": 1,
+  });
+  assert.deepEqual(original, {
+    title: "Goodbye!",
+    author: { name: "Nigel" },
+    tags: ["example", "sample"],
+    "a/b": 1,
+  });
+  assert.notEqual(result, original);
+});
+
+test("supports root replacement and independent copy values", () => {
+  const copied = applyPatch({ source: { value: 1 } }, [
+    { op: "copy", from: "/source", path: "/copy" },
+    { op: "add", path: "/copy/value", value: 2 },
+  ]);
+  assert.deepEqual(copied, { source: { value: 1 }, copy: { value: 2 } });
+
+  const result = applyPatch({ source: { value: 1 } }, [
+    { op: "replace", path: "", value: ["root"] },
+  ]);
+
+  assert.deepEqual(result, ["root"]);
+  assert.notEqual(applyPatch({ nested: true }, []), applyPatch({ nested: true }, []));
+});
+
+test("rejects invalid patches and operations that cannot be applied", () => {
+  for (const patch of [
+    {},
+    [{ path: "/a", value: 1 }],
+    [{ op: "unknown", path: "/a" }],
+    [{ op: "add", path: "a", value: 1 }],
+    [{ op: "add", path: "/list/01", value: 1 }],
+    [{ op: "remove", path: "/missing" }],
+    [{ op: "replace", path: "/missing", value: 1 }],
+    [{ op: "test", path: "/a", value: 2 }],
+    [{ op: "move", from: "/a", path: "/a/child" }],
+  ]) {
+    assert.throws(() => applyPatch({ a: { child: 1 }, list: [] }, patch));
+  }
+});
