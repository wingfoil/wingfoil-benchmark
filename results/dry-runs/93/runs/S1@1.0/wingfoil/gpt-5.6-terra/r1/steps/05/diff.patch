+type JsonPatchOperation =
+  | { op: "add"; path: string; value: JsonValue }
+  | { op: "remove"; path: string }
+  | { op: "replace"; path: string; value: JsonValue };
+
+/**
+ * Creates an RFC 6902 JSON Patch that transforms `from` into `to`.
+ *
+ * Object members and array elements are compared recursively, so a local change produces a local
+ * operation rather than replacing the containing document. The returned patch and both inputs are
+ * independent: changing any of them cannot mutate either input.
+ *
+ * @param from The source JSON document.
+ * @param to The target JSON document.
+ * @returns JSON Patch operations which turn `from` into `to` when applied in order.
+ * @throws {Error} If either value cannot be represented as JSON.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new Error("Invalid JSON Patch source or target");
+  }
+
+  const patch: JsonPatchOperation[] = [];
+  createPatchOperations(from, to, "", patch);
+  return patch;
+}
