+function createPatchOperations(from: JsonValue, to: JsonValue, path: string, patch: JsonPatchOperation[]): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) {
+        patch.push({ op: "remove", path: appendPointer(path, key) });
+      }
+    }
+    for (const key of Object.keys(from)) {
+      if (Object.hasOwn(to, key)) {
+        createPatchOperations(from[key], to[key], appendPointer(path, key), patch);
+      }
+    }
+    for (const key of Object.keys(to)) {
+      if (!Object.hasOwn(from, key)) {
+        patch.push({ op: "add", path: appendPointer(path, key), value: cloneJson(to[key]) });
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatch(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: "replace", path, value: cloneJson(to) });
+}
+
+function createArrayPatch(from: JsonValue[], to: JsonValue[], path: string, patch: JsonPatchOperation[]): void {
+  const matches = longestCommonSubsequence(from, to);
+  let fromIndex = 0;
+  let toIndex = 0;
+  let resultIndex = 0;
+
+  for (const [matchedFrom, matchedTo] of matches) {
+    resultIndex = createArraySegmentPatch(
+      from.slice(fromIndex, matchedFrom), to.slice(toIndex, matchedTo), path, resultIndex, patch,
+    );
+    fromIndex = matchedFrom + 1;
+    toIndex = matchedTo + 1;
+    resultIndex += 1;
+  }
+
+  createArraySegmentPatch(from.slice(fromIndex), to.slice(toIndex), path, resultIndex, patch);
+}
+
+function createArraySegmentPatch(
+  from: JsonValue[], to: JsonValue[], path: string, resultIndex: number, patch: JsonPatchOperation[],
+): number {
+  const sharedLength = Math.min(from.length, to.length);
+  for (let index = 0; index < sharedLength; index += 1) {
+    createPatchOperations(from[index], to[index], appendPointer(path, String(resultIndex)), patch);
+    resultIndex += 1;
+  }
+  for (let index = sharedLength; index < from.length; index += 1) {
+    patch.push({ op: "remove", path: appendPointer(path, String(resultIndex)) });
+  }
+  for (let index = sharedLength; index < to.length; index += 1) {
+    patch.push({ op: "add", path: appendPointer(path, String(resultIndex)), value: cloneJson(to[index]) });
+    resultIndex += 1;
+  }
+  return resultIndex;
+}
+
+function longestCommonSubsequence(from: JsonValue[], to: JsonValue[]): Array<[number, number]> {
+  const lengths = Array.from({ length: from.length + 1 }, () => Array<number>(to.length + 1).fill(0));
+
+  for (let fromIndex = from.length - 1; fromIndex >= 0; fromIndex -= 1) {
+    for (let toIndex = to.length - 1; toIndex >= 0; toIndex -= 1) {
+      lengths[fromIndex][toIndex] = jsonEqual(from[fromIndex], to[toIndex])
+        ? lengths[fromIndex + 1][toIndex + 1] + 1
+        : Math.max(lengths[fromIndex + 1][toIndex], lengths[fromIndex][toIndex + 1]);
+    }
+  }
+
+  const matches: Array<[number, number]> = [];
+  let fromIndex = 0;
+  let toIndex = 0;
+  while (fromIndex < from.length && toIndex < to.length) {
+    if (jsonEqual(from[fromIndex], to[toIndex])) {
+      matches.push([fromIndex, toIndex]);
+      fromIndex += 1;
+      toIndex += 1;
+    } else if (lengths[fromIndex][toIndex + 1] >= lengths[fromIndex + 1][toIndex]) {
+      toIndex += 1;
+    } else {
+      fromIndex += 1;
+    }
+  }
+  return matches;
+}
+
+function appendPointer(path: string, token: string): string {
+  return `${path}/${token.replaceAll("~", "~0").replaceAll("/", "~1")}`;
