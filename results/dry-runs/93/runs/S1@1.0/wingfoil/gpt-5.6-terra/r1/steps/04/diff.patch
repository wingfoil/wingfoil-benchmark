+/**
+ * Applies an RFC 7386 JSON Merge Patch to a JSON document.
+ *
+ * Object-valued patches merge recursively. A `null` member removes that member from the target;
+ * every other non-object patch replaces the target wholesale. Neither input is mutated.
+ *
+ * @param target The JSON document to transform.
+ * @param patch The JSON Merge Patch document.
+ * @returns A new JSON document containing the merged result.
+ * @throws {Error} If either input cannot be represented as JSON.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonValue(target) || !isJsonValue(patch)) {
+    throw new Error("Invalid JSON Merge Patch target or patch");
+  }
+
+  return mergePatch(target, patch);
+}
+
+function mergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return cloneJson(patch);
+  }
+
+  const result: { [key: string]: JsonValue } = isJsonObject(target)
+    ? cloneJson(target) as { [key: string]: JsonValue }
+    : {};
+
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = Object.hasOwn(result, key) ? result[key] : null;
+      defineJsonMember(result, key, mergePatch(current, value));
+    }
+  }
+
+  return result;
+}
