+
+test("applies RFC 7386 object merge and removal semantics without mutating inputs", () => {
+  const target = {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  };
+
+  const result = applyMergePatch(target, patch);
+
+  assert.deepEqual(result, {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+  assert.deepEqual(target, {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  });
+  assert.deepEqual(patch, {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  });
+  assert.notEqual(result, target);
+});
+
+test("replaces non-object targets and patches, and treats object patches on scalars as empty objects", () => {
+  assert.deepEqual(applyMergePatch({ value: 1 }, ["replacement"]), ["replacement"]);
+  assert.deepEqual(applyMergePatch({ value: 1 }, null), null);
+  assert.deepEqual(applyMergePatch([1, 2], { value: 3 }), { value: 3 });
+  assert.deepEqual(applyMergePatch("target", { nested: { value: true } }), {
+    nested: { value: true },
+  });
+});
+
+test("does not share mutable values with the merge patch and safely supports JSON member names", () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true},"nested":{"value":1}}');
+  const result = applyMergePatch({}, patch);
+
+  patch.nested.value = 2;
+  assert.deepEqual(result, JSON.parse('{"__proto__":{"polluted":true},"nested":{"value":1}}'));
+  assert.equal({}.polluted, undefined);
+});
+
+test("rejects merge patch inputs that cannot represent JSON", () => {
+  const sparse = [];
+  sparse.length = 1;
+
+  assert.throws(() => applyMergePatch({ value: 1 }, { value: Number.NaN }));
+  assert.throws(() => applyMergePatch(sparse, {}));
