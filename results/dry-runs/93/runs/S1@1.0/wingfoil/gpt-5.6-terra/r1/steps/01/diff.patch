diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3dd3b5c28f03c7b0f834dc6c573f7ec378d4b68d
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,51 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @param document The JSON value to traverse.
+ * @param pointer A JSON Pointer string. An empty pointer selects `document`.
+ * @returns The value selected by `pointer`.
+ * @throws {Error} If `pointer` is malformed or does not identify a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string" || (pointer !== "" && !pointer.startsWith("/"))) {
+    throw new Error("Invalid JSON Pointer");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+
+  let value = document;
+
+  for (const referenceToken of pointer.slice(1).split("/")) {
+    const token = decodeReferenceToken(referenceToken);
+
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(token) || Number(token) >= value.length) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+      value = value[Number(token)];
+      continue;
+    }
+
+    if (value === null || typeof value !== "object" || !Object.hasOwn(value, token)) {
+      throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+    }
+
+    value = (value as Record<string, unknown>)[token];
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  if (/~(?:[^01]|$)/.test(token)) {
+    throw new Error("Invalid JSON Pointer escape sequence");
+  }
+
+  return token.replaceAll("~1", "/").replaceAll("~0", "~");
+}
+
+function isArrayIndex(token: string): boolean {
+  return /^(?:0|[1-9][0-9]*)$/.test(token);
+}
diff --git a/test/index.test.mjs b/test/index.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..92dce4b30649969ce892ae5f133088f316a8af5c
--- /dev/null
+++ b/test/index.test.mjs
@@ -0,0 +1,32 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { resolvePointer } from "../src/index.ts";
+
+const document = {
+  "": "empty key",
+  "a/b": "slash",
+  "m~n": "tilde",
+  nested: {
+    values: ["first", null, { answer: 42 }],
+  },
+};
+
+test("resolves the whole document and RFC 6901 escaped member names", () => {
+  assert.equal(resolvePointer(document, ""), document);
+  assert.equal(resolvePointer(document, "/"), "empty key");
+  assert.equal(resolvePointer(document, "/a~1b"), "slash");
+  assert.equal(resolvePointer(document, "/m~0n"), "tilde");
+});
+
+test("resolves object members and array elements", () => {
+  assert.equal(resolvePointer(document, "/nested/values/0"), "first");
+  assert.equal(resolvePointer(document, "/nested/values/1"), null);
+  assert.equal(resolvePointer(document, "/nested/values/2/answer"), 42);
+});
+
+test("rejects malformed pointers and references that do not resolve", () => {
+  for (const pointer of ["nested", "/m~2n", "/m~", "/nested/values/-", "/nested/values/01", "/nested/values/3", "/nested/values/name"]) {
+    assert.throws(() => resolvePointer(document, pointer));
+  }
+});
