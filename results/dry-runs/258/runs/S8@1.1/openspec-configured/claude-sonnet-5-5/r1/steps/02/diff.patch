+describe('task timestamps', () => {
+  function clocked() {
+    let minute = 0;
+    const tick = () => `2026-01-01T00:${String(minute++).padStart(2, '0')}:00.000Z`;
+    return createTodoList(tick);
+  }
+
+  it('gives a new task equal createdAt and updatedAt', () => {
+    const task = valueOf(clocked().add({ title: 'A' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every change, by title and by id, and keeps createdAt', () => {
+    const list = clocked();
+    const task = valueOf(list.add({ title: 'A' }));
+    const steps = [
+      valueOf(list.complete('A')),
+      valueOf(list.reopen(task.id)),
+      valueOf(list.rename('A', 'B')),
+      valueOf(list.tag('B', 'home')),
+      valueOf(list.untag(task.id, 'home')),
+    ];
+    steps.forEach((changed, index) => {
+      assert.equal(changed.updatedAt, `2026-01-01T00:0${index + 1}:00.000Z`);
+      assert.equal(changed.createdAt, task.createdAt);
+    });
+    assert.equal(valueOf(list.get(task.id)).updatedAt, '2026-01-01T00:05:00.000Z');
+    assert.equal(list.list()[0]?.updatedAt, '2026-01-01T00:05:00.000Z');
+  });
