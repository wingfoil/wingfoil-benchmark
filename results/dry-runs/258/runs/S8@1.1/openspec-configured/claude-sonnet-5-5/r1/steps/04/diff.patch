index 0000000000000000000000000000000000000000..5a29a29b10fce13f518e8c72498989b44f1cbed0
--- /dev/null
+++ b/src/domain/import.ts
@@ -0,0 +1,56 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { TaskList } from './list.ts';
+import { validatePriority } from './task.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** A line of the imported text that could not be added: its number, from 1, and why. */
+export interface ImportRejection {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks it added, and the lines it could not add. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
+/**
+ * Adds tasks to a list from text, one task per line, as `title;priority;tags`. The priority may be empty
+ * for a normal one, the tags are separated by spaces, and blank lines are skipped. A line that cannot be
+ * added is reported and does not stop the others.
+ *
+ * @param list - the task list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  const rejected: ImportRejection[] = [];
+  let imported = 0;
+  text.split(/\r?\n/).forEach((line, index) => {
+    if (line.trim() === '') return;
+    const input = parseLine(line);
+    const added = input.ok ? list.add(input.value) : input;
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
+
+function parseLine(line: string): Result<NewTask> {
+  const parts = line.split(';');
+  if (parts.length > 3) {
+    return err('invalid-input', `the line has ${parts.length} parts: use title;priority;tags, without other ";"`);
+  }
+  const [title, priority = '', tags = ''] = parts;
+  const task: { title: string; priority?: Priority; tags: string[] } = {
+    title,
+    tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+  };
+  if (priority.trim() !== '') {
+    const checked = validatePriority(priority.trim());
+    if (!checked.ok) return checked;
+    task.priority = checked.value;
+  }
+  return ok(task);
+}
