index 0000000000000000000000000000000000000000..3d7b921925280ed715aa0cab32f6731706d85e2b
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,61 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+function reasons(rejected: readonly { line: number; reason: string }[]): number[] {
+  return rejected.map((entry) => entry.line);
+}
+
+describe('importTasks', () => {
+  it('imports a full line', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin money');
+    assert.deepEqual(result, { imported: 1, rejected: [] });
+    const task = list.list()[0];
+    assert.equal(task.title, 'Renew the insurance');
+    assert.equal(task.priority, 'high');
+    assert.deepEqual(task.tags, ['admin', 'money']);
+  });
+
+  it('defaults priority and tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;\r\nCall mum\r\n Walk ; low ;  ');
+    assert.deepEqual(result, { imported: 3, rejected: [] });
+    assert.equal(list.find('Buy milk').ok && list.list({ priority: 'normal' }).length, 2);
+    assert.equal(list.list({ priority: 'low' })[0].title, 'Walk');
+  });
+
+  it('skips blank lines and counts them in line numbers', () => {
+    const list = createTodoList();
+    assert.deepEqual(importTasks(list, ''), { imported: 0, rejected: [] });
+    const result = importTasks(list, 'Good task\n\nBad;nope');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(reasons(result.rejected), [3]);
+    assert.match(result.rejected[0].reason, /nope/);
+  });
+
+  it('rejects each kind of bad line and keeps the good ones', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const text = [
+      ';high;admin',
+      `${'x'.repeat(121)};low`,
+      'Call; then email;high;admin',
+      'Existing;low',
+      'Fresh;low',
+      'Fresh;high',
+      'Pay rent;urgent;money',
+    ].join('\n');
+    const result = importTasks(list, text);
+    assert.equal(result.imported, 1);
+    assert.deepEqual(reasons(result.rejected), [1, 2, 3, 4, 6, 7]);
+    assert.match(result.rejected[0].reason, /empty/);
+    assert.match(result.rejected[1].reason, /too long/);
+    assert.match(result.rejected[2].reason, /parts/);
+    assert.match(result.rejected[3].reason, /already/);
+    assert.match(result.rejected[4].reason, /already/);
+    assert.match(result.rejected[5].reason, /urgent/);
+    assert.equal(list.list().length, 2);
+  });
+});
