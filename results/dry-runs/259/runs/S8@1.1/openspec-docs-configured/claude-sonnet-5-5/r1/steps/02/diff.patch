+
+describe('task times', () => {
+  function clockList() {
+    let tick = 0;
+    return createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, (tick += 1))).toISOString());
+  }
+
+  it('gives a new task the same createdAt and updatedAt', () => {
+    const task = valueOf(clockList().add({ title: 'a' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:01.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on every change and keeps createdAt', () => {
+    const list = clockList();
+    const created = valueOf(list.add({ title: 'a' }));
+    const steps = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.rename('a', 'b'),
+      () => list.tag('b', 'home'),
+      () => list.untag('b', 'home'),
+    ];
+    let previous = created.updatedAt;
+    for (const step of steps) {
+      const task = valueOf(step());
+      assert.equal(task.createdAt, created.createdAt);
+      assert.ok(task.updatedAt > previous);
+      previous = task.updatedAt;
+    }
+  });
+
+  it('leaves updatedAt alone when a change fails', () => {
+    const list = clockList();
+    const created = valueOf(list.add({ title: 'a' }));
+    assert.equal(list.reopen('a').ok, false);
+    assert.equal(valueOf(list.find('a')).updatedAt, created.updatedAt);
+  });
+});
