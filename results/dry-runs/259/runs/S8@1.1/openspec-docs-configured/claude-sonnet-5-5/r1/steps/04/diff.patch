--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,56 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds valid lines, with priority and tags, and skips blank lines', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\n  \nBuy milk;;\nWalk dog');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok);
+    assert.equal(milk.value.priority, 'normal');
+  });
+
+  it('rejects an empty title, with the line number counting blank lines', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'A\n\n ;high;x');
+    assert.equal(report.imported, 1);
+    assert.equal(report.rejected.length, 1);
+    assert.equal(report.rejected[0].line, 3);
+    assert.match(report.rejected[0].reason, /title/);
+  });
+
+  it('rejects an unknown priority and adds nothing for that line', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'A;urgent;x');
+    assert.equal(report.imported, 0);
+    assert.equal(report.rejected[0].line, 1);
+    assert.match(report.rejected[0].reason, /urgent/);
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects a duplicate title, in the list or in the text', () => {
+    const list = createTodoList();
+    list.add({ title: 'A' });
+    const report = importTasks(list, 'A\nB\nB;high');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(report.rejected.map((r) => r.line), [1, 3]);
+  });
+
+  it('rejects a line with too many fields and a too long title', () => {
+    const list = createTodoList();
+    const report = importTasks(list, `A;low;x;y\n${'t'.repeat(121)}\r\nok`);
+    assert.equal(report.imported, 1);
+    assert.deepEqual(report.rejected.map((r) => r.line), [1, 2]);
+  });
+
+  it('handles empty text', () => {
+    assert.deepEqual(importTasks(createTodoList(), ''), { imported: 0, rejected: [] });
+  });
+});
