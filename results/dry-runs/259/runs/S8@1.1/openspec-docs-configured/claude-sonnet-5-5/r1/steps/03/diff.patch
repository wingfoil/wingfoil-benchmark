+/** The most characters a title may have, once trimmed. */
+export const MAX_TITLE_LENGTH = 120;
+
+/**
+ * The title, trimmed, when it is fit for a task: not empty and at most `MAX_TITLE_LENGTH` characters.
+ *
+ * @param title - the title to check
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = typeof title === 'string' ? title.trim() : '';
+  if (trimmed === '') return err('invalid-input', 'the title cannot be empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `the title is ${trimmed.length} characters long; the most allowed is ${MAX_TITLE_LENGTH}`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * The priority, when it is one of `low`, `normal` and `high`.
+ *
+ * @param priority - the priority to check
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  const known = PRIORITIES.find((candidate) => candidate === priority);
+  if (known === undefined) return err('invalid-input', `the priority "${priority}" is not one of low, normal or high`);
+  return ok(known);
+}
+
+/**
+ * The tag, when it is fit for a task: not empty and without spaces.
+ *
+ * @param tag - the tag to check
+ */
+export function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag === '') return err('invalid-input', 'a tag cannot be empty');
+  if (/\s/.test(tag)) return err('invalid-input', `the tag "${tag}" cannot contain a space`);
+  return ok(tag);
+}
