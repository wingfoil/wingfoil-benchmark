+describe('input validation', () => {
+  const code = (result: { ok: boolean; error?: { code: string } }) => (result.ok ? 'ok' : result.error?.code);
+
+  it('rejects bad titles on add and rename, changing nothing', () => {
+    const list = createTodoList();
+    list.add({ title: 'Keep me' });
+    for (const title of ['', '   ', 'x'.repeat(121)]) {
+      assert.equal(code(list.add({ title })), 'invalid-input');
+      assert.equal(code(list.rename('Keep me', title)), 'invalid-input');
+    }
+    assert.equal(list.list().length, 1);
+    assert.equal(list.list()[0]?.title, 'Keep me');
+    assert.equal(code(list.add({ title: 'x'.repeat(120) })), 'ok');
+    assert.equal(code(list.add({ title: 'Next' })), 'ok');
+    assert.equal(valueOf(list.find('Next')).id, 'task-3');
+  });
+
+  it('rejects a bad priority', () => {
+    const list = createTodoList();
+    assert.equal(code(list.add({ title: 'A', priority: 'urgent' as 'high' })), 'invalid-input');
+    assert.equal(list.list().length, 0);
+  });
+
+  it('rejects bad tags on add and tag, changing nothing', () => {
+    const list = createTodoList();
+    assert.equal(code(list.add({ title: 'A', tags: ['ok', 'two words'] })), 'invalid-input');
+    assert.equal(code(list.add({ title: 'A', tags: [''] })), 'invalid-input');
+    assert.equal(list.list().length, 0);
+    list.add({ title: 'B', tags: ['home'] });
+    assert.equal(code(list.tag('B', '')), 'invalid-input');
+    assert.equal(code(list.tag('B', 'a b')), 'invalid-input');
+    assert.deepEqual(valueOf(list.find('B')).tags, ['home']);
+  });
+});
