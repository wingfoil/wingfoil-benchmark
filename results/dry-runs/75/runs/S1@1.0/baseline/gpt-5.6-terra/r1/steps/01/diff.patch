+/**
+ * Resolve a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @throws {Error} if the pointer is malformed or cannot be resolved.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("A JSON Pointer must be a string");
+  }
+
+  // The empty pointer denotes the whole document.
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error("Invalid JSON Pointer: it must be empty or start with '/'");
+  }
+
+  let value: unknown = document;
+  for (const rawToken of pointer.slice(1).split("/")) {
+    const token = unescapeReferenceToken(rawToken);
+
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(token) || Number(token) >= value.length) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+      value = value[Number(token)];
+      continue;
+    }
+
+    if (value !== null && typeof value === "object") {
+      if (!Object.prototype.hasOwnProperty.call(value, token)) {
+        throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+      }
+      value = (value as Record<string, unknown>)[token];
+      continue;
+    }
+
+    throw new Error(`JSON Pointer does not resolve: ${pointer}`);
+  }
+
+  return value;
+}
+
+function unescapeReferenceToken(token: string): string {
+  let result = "";
+
+  for (let index = 0; index < token.length; index += 1) {
+    const character = token[index];
+    if (character !== "~") {
+      result += character;
+      continue;
+    }
+
+    const escape = token[index + 1];
+    if (escape === "0") {
+      result += "~";
+    } else if (escape === "1") {
+      result += "/";
+    } else {
+      throw new Error(`Invalid JSON Pointer escape in token: ${token}`);
+    }
+    index += 1;
+  }
+
+  return result;
+}
+
+function isArrayIndex(token: string): boolean {
+  // RFC 6901 permits "0" or a non-zero digit followed by decimal digits.
+  return /^(?:0|[1-9][0-9]*)$/.test(token);
+}
