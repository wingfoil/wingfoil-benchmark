+/**
+ * Create an RFC 6902 JSON Patch that transforms `from` into `to` without
+ * modifying either document.
+ *
+ * Object members are compared recursively. Arrays use a shortest edit script
+ * for insertions, removals, and replacements, so a change near one end does
+ * not cause the whole array (or enclosing document) to be sent again.
+ */
+export function createPatch(from: unknown, to: unknown): unknown[] {
+  assertJsonValue(from, "The source document");
+  assertJsonValue(to, "The target document");
+
+  const patch: Operation[] = [];
+  createPatchAt(from, to, [], patch);
+  return patch;
+}
+
+function createPatchAt(from: unknown, to: unknown, path: readonly string[], patch: Operation[]): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatch(from, to, path, patch);
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    const fromObject = from as Record<string, unknown>;
+    const toObject = to as Record<string, unknown>;
+
+    // Delete before adding. This is particularly important when a property
+    // name is special in JavaScript (for example, __proto__).
+    for (const key of Object.keys(fromObject)) {
+      if (!Object.prototype.hasOwnProperty.call(toObject, key)) {
+        patch.push({ op: "remove", path: formatPointer([...path, key]) });
+      }
+    }
+    for (const key of Object.keys(fromObject)) {
+      if (Object.prototype.hasOwnProperty.call(toObject, key)) {
+        createPatchAt(fromObject[key], toObject[key], [...path, key], patch);
+      }
+    }
+    for (const key of Object.keys(toObject)) {
+      if (!Object.prototype.hasOwnProperty.call(fromObject, key)) {
+        patch.push({ op: "add", path: formatPointer([...path, key]), value: cloneJsonValue(toObject[key]) });
+      }
+    }
+    return;
+  }
+
+  patch.push({ op: "replace", path: formatPointer(path), value: cloneJsonValue(to) });
+}
+
+/**
+ * Emit a Levenshtein edit script while tracking the index in the array as it
+ * is changed. Paired substitutions are visited recursively so an object or
+ * array change can remain granular.
+ */
+function createArrayPatch(
+  from: unknown[],
+  to: unknown[],
+  path: readonly string[],
+  patch: Operation[],
+): void {
+  const costs: number[][] = Array.from(
+    { length: from.length + 1 },
+    () => Array<number>(to.length + 1).fill(0),
+  );
+
+  for (let fromIndex = from.length; fromIndex >= 0; fromIndex -= 1) {
+    for (let toIndex = to.length; toIndex >= 0; toIndex -= 1) {
+      if (fromIndex === from.length) {
+        costs[fromIndex][toIndex] = to.length - toIndex;
+      } else if (toIndex === to.length) {
+        costs[fromIndex][toIndex] = from.length - fromIndex;
+      } else if (jsonEqual(from[fromIndex], to[toIndex])) {
+        costs[fromIndex][toIndex] = costs[fromIndex + 1][toIndex + 1];
+      } else {
+        costs[fromIndex][toIndex] = 1 + Math.min(
+          costs[fromIndex + 1][toIndex],
+          costs[fromIndex][toIndex + 1],
+          costs[fromIndex + 1][toIndex + 1],
+        );
+      }
+    }
+  }
+
+  let fromIndex = 0;
+  let toIndex = 0;
+  let currentIndex = 0;
+  while (fromIndex < from.length || toIndex < to.length) {
+    if (fromIndex === from.length) {
+      patch.push({ op: "add", path: formatPointer([...path, String(currentIndex)]), value: cloneJsonValue(to[toIndex]) });
+      toIndex += 1;
+      currentIndex += 1;
+    } else if (toIndex === to.length) {
+      patch.push({ op: "remove", path: formatPointer([...path, String(currentIndex)]) });
+      fromIndex += 1;
+    } else if (jsonEqual(from[fromIndex], to[toIndex])) {
+      fromIndex += 1;
+      toIndex += 1;
+      currentIndex += 1;
+    } else {
+      const removeCost = costs[fromIndex + 1][toIndex];
+      const addCost = costs[fromIndex][toIndex + 1];
+      const replaceCost = costs[fromIndex + 1][toIndex + 1];
+      const bestCost = Math.min(removeCost, addCost, replaceCost);
+
+      // Prefer replacement on a tie. It permits recursive diffs in matching
+      // positions and avoids describing a simple edit as a deletion and add.
+      if (replaceCost === bestCost) {
+        createPatchAt(from[fromIndex], to[toIndex], [...path, String(currentIndex)], patch);
+        fromIndex += 1;
+        toIndex += 1;
+        currentIndex += 1;
+      } else if (removeCost === bestCost) {
+        patch.push({ op: "remove", path: formatPointer([...path, String(currentIndex)]) });
+        fromIndex += 1;
+      } else {
+        patch.push({ op: "add", path: formatPointer([...path, String(currentIndex)]), value: cloneJsonValue(to[toIndex]) });
+        toIndex += 1;
+        currentIndex += 1;
+      }
+    }
+  }
+}
