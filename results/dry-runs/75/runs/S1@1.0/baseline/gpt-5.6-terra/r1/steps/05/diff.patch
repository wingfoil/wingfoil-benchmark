+import { applyMergePatch, applyPatch, createPatch } from "../src/index.ts";
+
+test("creates a small patch for nested changes without modifying either input", () => {
+  const from = {
+    profile: { name: "Ada", settings: { alerts: true, theme: "light" } },
+    untouched: [1, 2, 3],
+  };
+  const to = {
+    profile: { name: "Ada", settings: { alerts: false, theme: "light" } },
+    untouched: [1, 2, 3],
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: "replace", path: "/profile/settings/alerts", value: false }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    profile: { name: "Ada", settings: { alerts: true, theme: "light" } },
+    untouched: [1, 2, 3],
+  });
+  assert.deepEqual(to, {
+    profile: { name: "Ada", settings: { alerts: false, theme: "light" } },
+    untouched: [1, 2, 3],
+  });
+});
+
+test("creates array insertions and removals at the affected position", () => {
+  const from = { values: ["one", "three"] };
+  const to = { values: ["one", "two", "three"] };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [{ op: "add", path: "/values/1", value: "two" }]);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("escapes object member names and clones patch values", () => {
+  const from = { "a/b": { value: 1 } };
+  const to = { "a/b": { value: 2 }, "~name": { nested: true } };
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "replace", path: "/a~1b/value", value: 2 },
+    { op: "add", path: "/~0name", value: { nested: true } },
+  ]);
+  (patch[1]).value.nested = false;
+  assert.deepEqual(to, { "a/b": { value: 2 }, "~name": { nested: true } });
+});
+
+test("validates documents passed to createPatch", () => {
+  assert.throws(() => createPatch({ value: undefined }, {}), /JSON values/);
+  assert.throws(() => createPatch({}, { value: Number.NaN }), /JSON values/);
+});
 
