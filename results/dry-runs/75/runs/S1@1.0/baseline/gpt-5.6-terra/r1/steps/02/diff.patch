diff --git a/src/index.ts b/src/index.ts
index f1aa10309fd91f2d38d97e53990e44df7f5e295e..11a4b01726425ecda78fcd32c0e8cf44e054d17b 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -71,3 +71,241 @@ function isArrayIndex(token: string): boolean {
   // RFC 6901 permits "0" or a non-zero digit followed by decimal digits.
   return /^(?:0|[1-9][0-9]*)$/.test(token);
 }
+
+/**
+ * Apply an RFC 6902 JSON Patch without modifying either input.
+ *
+ * @throws {Error} if the patch is malformed or an operation cannot be applied.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error("A JSON Patch must be an array of operations");
+  }
+
+  let result = cloneJsonValue(document);
+
+  for (const operation of patch) {
+    const record = requireOperation(operation);
+    const op = record.op;
+    const path = parsePointer(requireStringMember(record, "path"));
+
+    switch (op) {
+      case "add":
+        result = addValue(result, path, cloneJsonValue(requireValueMember(record)));
+        break;
+      case "remove":
+        result = removeValue(result, path);
+        break;
+      case "replace":
+        // Unlike add, replace requires that the target already exists.
+        getValue(result, path);
+        result = replaceValue(result, path, cloneJsonValue(requireValueMember(record)));
+        break;
+      case "move": {
+        const from = parsePointer(requireStringMember(record, "from"));
+        if (isProperPrefix(from, path)) {
+          throw new Error("Cannot move a value into one of its children");
+        }
+        const value = getValue(result, from);
+        if (samePointer(from, path)) {
+          break;
+        }
+        result = removeValue(result, from);
+        result = addValue(result, path, value);
+        break;
+      }
+      case "copy": {
+        const from = parsePointer(requireStringMember(record, "from"));
+        result = addValue(result, path, cloneJsonValue(getValue(result, from)));
+        break;
+      }
+      case "test": {
+        const actual = getValue(result, path);
+        if (!jsonEqual(actual, requireValueMember(record))) {
+          throw new Error(`JSON Patch test operation failed at ${formatPointer(path)}`);
+        }
+        break;
+      }
+      default:
+        throw new Error(`Unsupported JSON Patch operation: ${String(op)}`);
+    }
+  }
+
+  return result;
+}
+
+type Operation = Record<string, unknown>;
+
+function requireOperation(value: unknown): Operation {
+  if (value === null || typeof value !== "object" || Array.isArray(value)) {
+    throw new Error("A JSON Patch operation must be an object");
+  }
+  const operation = value as Operation;
+  if (!Object.prototype.hasOwnProperty.call(operation, "op") || typeof operation.op !== "string") {
+    throw new Error("A JSON Patch operation must have a string 'op' member");
+  }
+  return operation;
+}
+
+function requireStringMember(operation: Operation, member: string): string {
+  if (!Object.prototype.hasOwnProperty.call(operation, member) || typeof operation[member] !== "string") {
+    throw new Error(`A JSON Patch operation must have a string '${member}' member`);
+  }
+  return operation[member] as string;
+}
+
+function requireValueMember(operation: Operation): unknown {
+  if (!Object.prototype.hasOwnProperty.call(operation, "value")) {
+    throw new Error("A JSON Patch operation must have a 'value' member");
+  }
+  return operation.value;
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error("Invalid JSON Pointer: it must be empty or start with '/'");
+  }
+  return pointer.slice(1).split("/").map(unescapeReferenceToken);
+}
+
+function getValue(document: unknown, tokens: readonly string[]): unknown {
+  let value = document;
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(token) || Number(token) >= value.length) {
+        throw new Error(`JSON Pointer does not resolve: ${formatPointer(tokens)}`);
+      }
+      value = value[Number(token)];
+    } else if (value !== null && typeof value === "object" &&
+               Object.prototype.hasOwnProperty.call(value, token)) {
+      value = (value as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer does not resolve: ${formatPointer(tokens)}`);
+    }
+  }
+  return value;
+}
+
+function addValue(document: unknown, tokens: readonly string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return value;
+  }
+
+  const parent = getValue(document, tokens.slice(0, -1));
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (token === "-") {
+      parent.push(value);
+    } else if (isArrayIndex(token) && Number(token) <= parent.length) {
+      parent.splice(Number(token), 0, value);
+    } else {
+      throw new Error(`Cannot add at ${formatPointer(tokens)}`);
+    }
+  } else if (parent !== null && typeof parent === "object") {
+    // defineProperty avoids the special __proto__ setter on ordinary objects.
+    Object.defineProperty(parent, token, {
+      value,
+      writable: true,
+      enumerable: true,
+      configurable: true,
+    });
+  } else {
+    throw new Error(`Cannot add at ${formatPointer(tokens)}`);
+  }
+  return document;
+}
+
+function removeValue(document: unknown, tokens: readonly string[]): unknown {
+  if (tokens.length === 0) {
+    throw new Error("Cannot remove the root JSON document");
+  }
+
+  const parent = getValue(document, tokens.slice(0, -1));
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!isArrayIndex(token) || Number(token) >= parent.length) {
+      throw new Error(`Cannot remove at ${formatPointer(tokens)}`);
+    }
+    parent.splice(Number(token), 1);
+  } else if (parent !== null && typeof parent === "object" &&
+             Object.prototype.hasOwnProperty.call(parent, token)) {
+    delete (parent as Record<string, unknown>)[token];
+  } else {
+    throw new Error(`Cannot remove at ${formatPointer(tokens)}`);
+  }
+  return document;
+}
+
+function replaceValue(document: unknown, tokens: readonly string[], value: unknown): unknown {
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = getValue(document, tokens.slice(0, -1));
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent[Number(token)] = value;
+  } else {
+    Object.defineProperty(parent as object, token, {
+      value,
+      writable: true,
+      enumerable: true,
+      configurable: true,
+    });
+  }
+  return document;
+}
+
+function cloneJsonValue(value: unknown): unknown {
+  if (Array.isArray(value)) {
+    return value.map(cloneJsonValue);
+  }
+  if (value !== null && typeof value === "object") {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) {
+      Object.defineProperty(copy, key, {
+        value: cloneJsonValue((value as Record<string, unknown>)[key]),
+        writable: true,
+        enumerable: true,
+        configurable: true,
+      });
+    }
+    return copy;
+  }
+  return value;
+}
+
+function jsonEqual(left: unknown, right: unknown): boolean {
+  if (left === right) {
+    return true;
+  }
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return Array.isArray(left) && Array.isArray(right) &&
+      left.length === right.length && left.every((value, index) => jsonEqual(value, right[index]));
+  }
+  if (left !== null && right !== null && typeof left === "object" && typeof right === "object") {
+    const leftObject = left as Record<string, unknown>;
+    const rightObject = right as Record<string, unknown>;
+    const leftKeys = Object.keys(leftObject);
+    const rightKeys = Object.keys(rightObject);
+    return leftKeys.length === rightKeys.length && leftKeys.every(
+      (key) => Object.prototype.hasOwnProperty.call(rightObject, key) &&
+        jsonEqual(leftObject[key], rightObject[key]),
+    );
+  }
+  return false;
+}
+
+function isProperPrefix(prefix: readonly string[], value: readonly string[]): boolean {
+  return prefix.length < value.length && prefix.every((token, index) => token === value[index]);
+}
+
+function samePointer(left: readonly string[], right: readonly string[]): boolean {
+  return left.length === right.length && left.every((token, index) => token === right[index]);
+}
+
+function formatPointer(tokens: readonly string[]): string {
+  return tokens.length === 0 ? "" : `/${tokens.map((token) => token.replace(/~/g, "~0").replace(/\//g, "~1")).join("/")}`;
+}
