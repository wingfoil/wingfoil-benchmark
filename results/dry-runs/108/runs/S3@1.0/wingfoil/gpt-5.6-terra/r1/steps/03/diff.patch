+
+/** Applies the long-rental price reduction, rounding the resulting total to the nearest cent. */
+function applyLongRentalDiscount(total: number, days: number): number {
+  if (days < LONG_RENTAL_MINIMUM_DAYS) {
+    return total;
+  }
+
+  const retainedPercent = 100 - LONG_RENTAL_DISCOUNT_PERCENT;
+  const discountedWholeEuros = Math.floor(total / 100) * retainedPercent;
+  const discountedCents = Math.round((total % 100) * retainedPercent / 100);
+  return discountedWholeEuros + discountedCents;
 }
 
