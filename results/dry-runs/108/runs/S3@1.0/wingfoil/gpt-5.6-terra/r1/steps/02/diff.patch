+    availability(query: AvailabilityQuery): string[] {
+      const period = validateAvailabilityQuery(query);
+      return [...equipment.values()]
+        .filter((item) => query.kind === undefined || item.kind === query.kind)
+        .filter((item) => !bookings.some((booking) => booking.itemId === item.id
+          && periodsOverlap(period, validatePeriod(booking))))
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
 
