@@ -38,3 +38,37 @@ test('rejects unknown items, non-whole-day periods, and overlapping bookings', (
     itemId: 'sail-1', start: '2026-06-03T00:00:00Z', end: '2026-06-04T00:00:00Z',
   }));
 });
+
+test('lists sorted equipment that is available for a whole period', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-z', kind: 'board', dailyPrice: 2_500 });
+  rentals.addEquipment({ id: 'board-a', kind: 'board', dailyPrice: 2_000 });
+  rentals.addEquipment({ id: 'sail-b', kind: 'sail', dailyPrice: 1_500 });
+  rentals.addEquipment({ id: 'sail-a', kind: 'sail', dailyPrice: 1_300 });
+
+  rentals.book({
+    itemId: 'board-z', start: '2026-06-01T00:00:00Z', end: '2026-06-03T00:00:00Z',
+  });
+  rentals.book({
+    itemId: 'sail-b', start: '2026-06-03T00:00:00Z', end: '2026-06-05T00:00:00Z',
+  });
+
+  const period = { start: '2026-06-02T00:00:00Z', end: '2026-06-04T00:00:00Z' };
+  assert.deepEqual(rentals.availability(period), ['board-a', 'sail-a']);
+  assert.deepEqual(rentals.availability({ ...period, kind: 'board' }), ['board-a']);
+  assert.deepEqual(rentals.availability({ ...period, kind: 'sail' }), ['sail-a']);
+  assert.deepEqual(rentals.availability({
+    start: '2026-06-05T00:00:00Z', end: '2026-06-06T00:00:00Z',
+  }), ['board-a', 'board-z', 'sail-a', 'sail-b']);
+});
+
+test('rejects availability queries with invalid periods or equipment kinds', () => {
+  const rentals = createRentalService();
+
+  assert.throws(() => rentals.availability({
+    start: '2026-06-01T12:00:00Z', end: '2026-06-02T00:00:00Z',
+  }));
+  assert.throws(() => rentals.availability({
+    start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z', kind: 'kite',
+  }));
+});
