+/** Returns the rounded value of the booked total for time remaining at cancellation. */
+function calculateRefund(total: number, period: ValidatedPeriod, cancellationTime: number): number {
+  if (cancellationTime <= period.startTime) {
+    return total;
+  }
+  if (cancellationTime >= period.endTime) {
+    return 0;
+  }
+
+  const remaining = BigInt(period.endTime - cancellationTime);
+  const duration = BigInt(period.endTime - period.startTime);
+  const roundedRefund = (BigInt(total) * remaining + duration / 2n) / duration;
+  return Number(roundedRefund);
+}
+
 function periodsOverlap(first: ValidatedPeriod, second: ValidatedPeriod): boolean {
   return first.startTime < second.endTime && second.startTime < first.endTime;
 }
