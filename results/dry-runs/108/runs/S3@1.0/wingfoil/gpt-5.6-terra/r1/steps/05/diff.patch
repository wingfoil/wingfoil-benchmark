+
+test('cancels a booking, refunds its unused discounted value, and releases its equipment', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1_000 });
+  const booking = rentals.book({
+    itemId: 'board-1',
+    start: '2026-06-01T00:00:00Z',
+    end: '2026-06-05T00:00:00Z',
+  });
+
+  assert.deepEqual(rentals.cancel(booking.id, '2026-06-03T00:00:00Z'), {
+    bookingId: booking.id,
+    refund: 1_800,
+  });
+  assert.deepEqual(rentals.availability({
+    start: '2026-06-01T00:00:00Z',
+    end: '2026-06-05T00:00:00Z',
+  }), ['board-1']);
+  assert.doesNotThrow(() => rentals.book({
+    itemId: 'board-1',
+    start: '2026-06-01T00:00:00Z',
+    end: '2026-06-05T00:00:00Z',
+  }));
+  assert.throws(() => rentals.cancel(booking.id, '2026-06-03T00:00:00Z'), /already cancelled/);
+});
+
+test('validates cancellation identifiers and timestamps', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1_000 });
+  const booking = rentals.book({
+    itemId: 'board-1',
