+      throw new Error(`Period must start and end at UTC midnight: ${start} - ${end}`);
+    }
+    const days = hours / 24;
     const fullPrice = days * item.dailyPrice;
     return days >= 3 ? fullPrice * 0.9 : fullPrice;
