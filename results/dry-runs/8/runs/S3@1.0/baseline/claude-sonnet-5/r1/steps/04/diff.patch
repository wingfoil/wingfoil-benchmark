+function parseOnHour(iso: string): number {
+  const ms = Date.parse(iso);
+  if (Number.isNaN(ms)) {
+    throw new Error(`Invalid date: ${iso}`);
+  }
+  if (ms % MS_PER_HOUR !== 0) {
+    throw new Error(`Period must start and end on the hour: ${iso}`);
+  }
+  return ms;
+}
+
+function hoursBetween(start: string, end: string): { startMs: number; hours: number } {
+  const startMs = parseOnHour(start);
+  const endMs = parseOnHour(end);
+  if (endMs <= startMs) {
+    throw new Error(`Period end must be after its start: ${start} - ${end}`);
+  }
+  return { startMs, hours: (endMs - startMs) / MS_PER_HOUR };
+}
+
 function overlaps(aStart: string, aEnd: string, bStart: string, bEnd: string): boolean {
   return Date.parse(aStart) < Date.parse(bEnd) && Date.parse(aEnd) > Date.parse(bStart);
 }
