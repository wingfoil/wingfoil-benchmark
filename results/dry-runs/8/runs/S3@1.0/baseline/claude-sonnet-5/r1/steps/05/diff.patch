+test('cancel before the booking starts gives a full refund', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1', 1000));
+  const booking = service.book({ itemId: 'b1', start: '2024-06-02T00:00:00Z', end: '2024-06-04T00:00:00Z' });
+
+  const cancellation = service.cancel(booking.id, '2024-06-01T00:00:00Z');
+
+  assert.deepEqual(cancellation, { bookingId: booking.id, refund: 2000 });
+});
+
+test('cancel after the booking has started gives no refund', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1', 1000));
+  const booking = service.book({ itemId: 'b1', start: '2024-06-01T00:00:00Z', end: '2024-06-03T00:00:00Z' });
+
+  const cancellation = service.cancel(booking.id, '2024-06-02T00:00:00Z');
+
+  assert.deepEqual(cancellation, { bookingId: booking.id, refund: 0 });
+});
+
+test('cancel frees the equipment so the period can be rebooked', () => {
+  const service = createRentalService();
+  service.addEquipment(board('b1'));
+  const booking = service.book({ itemId: 'b1', start: '2024-06-01T00:00:00Z', end: '2024-06-05T00:00:00Z' });
+
+  service.cancel(booking.id, '2024-05-30T00:00:00Z');
+
+  const ids = service.availability({ start: '2024-06-01T00:00:00Z', end: '2024-06-05T00:00:00Z' });
+  assert.deepEqual(ids, ['b1']);
+  assert.doesNotThrow(() => service.book({ itemId: 'b1', start: '2024-06-01T00:00:00Z', end: '2024-06-05T00:00:00Z' }));
+});
+
+test('cancel throws for an unknown booking', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.cancel('missing', '2024-06-01T00:00:00Z'));
+});
+
+test('cancel throws when the booking is already cancelled', () => {
