 const rfc = {
   foo: ["bar", "baz"],
@@ -140,3 +140,45 @@ test("edge cases pinned", () => {
   assert.throws(() => ap(doc, { op: "add", path: "/a/0", value: 0 }, { op: "remove", path: "/zzz" }));
   assert.deepEqual(doc, { a: [1] });
 });
+
+test("applyMergePatch: RFC 7386 Appendix A examples", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected, JSON.stringify([target, patch]));
+  }
+});
+
+test("applyMergePatch: no mutation and no shared structure", () => {
+  const target = { a: { b: 1 }, keep: { x: [1] } };
+  const patch = { a: { b: 2 }, n: { m: [1] } };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 }, keep: { x: [1] } });
+  assert.deepEqual(patch, { a: { b: 2 }, n: { m: [1] } });
+  result.keep.x.push(2);
+  result.n.m.push(2);
+  assert.deepEqual(target.keep.x, [1]);
+  assert.deepEqual(patch.n.m, [1]);
+});
+
+test("applyMergePatch: __proto__ is an ordinary member", () => {
+  const result = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as any;
+  assert.equal(({} as any).x, undefined);
+  assert.equal(result.x, undefined);
+  assert.ok(Object.hasOwn(result, "__proto__"));
+});
