+++ b/src/index.test.ts
@@ -0,0 +1,58 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "./index.ts";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/foo/1"), "baz");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("escape order and null/falsy values", () => {
+  assert.equal(resolvePointer({ "~1": 3 }, "/~01"), 3);
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer({ a: false }, "/a"), false);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["foo", "a/b", "/a~2b", "/a~", "/~"]) {
+    assert.throws(() => resolvePointer({}, p), p);
+  }
+  assert.throws(() => resolvePointer({}, undefined as unknown as string));
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+  for (const p of ["/2", "/-", "/01", "/x", "/+1", "/1.0", "/ 1", "/"]) {
+    assert.throws(() => resolvePointer([1, 2], p), p);
+  }
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer({}, "/constructor"));
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer([], "/length"));
+});
