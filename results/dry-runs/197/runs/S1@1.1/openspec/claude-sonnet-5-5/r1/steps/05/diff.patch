@@ -182,3 +182,52 @@ test("applyMergePatch: __proto__ is an ordinary member", () => {
   assert.equal(result.x, undefined);
   assert.ok(Object.hasOwn(result, "__proto__"));
 });
+
+test("createPatch describes only what changed", () => {
+  assert.deepEqual(createPatch({ a: 1 }, { a: 1 }), []);
+  assert.deepEqual(createPatch(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepEqual(createPatch({ a: { b: { c: 1, d: 2 } } }, { a: { b: { c: 3, d: 2 } } }), [
+    { op: "replace", path: "/a/b/c", value: 3 },
+  ]);
+  assert.deepEqual(createPatch({ x: 1, y: 2 }, { y: 2, z: 3 }), [
+    { op: "remove", path: "/x" },
+    { op: "add", path: "/z", value: 3 },
+  ]);
+  assert.deepEqual(createPatch({ "a/b~c": 1 }, { "a/b~c": 2 }), [
+    { op: "replace", path: "/a~1b~0c", value: 2 },
+  ]);
+});
+
+test("createPatch adds, removes and moves array items individually", () => {
+  assert.deepEqual(createPatch([1, 2, 4], [1, 2, 3, 4]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepEqual(createPatch([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  const moved = createPatch(["a", "b", "c", "d"], ["b", "c", "d", "a"]);
+  assert.ok(moved.length <= 2);
+  assert.deepEqual(createPatch([{ id: 1, v: 1 }, { id: 2, v: 1 }], [{ id: 1, v: 1 }, { id: 2, v: 2 }]), [
+    { op: "replace", path: "/1/v", value: 2 },
+  ]);
+});
+
+test("createPatch round-trips and does not mutate", () => {
+  const cases: Array<[unknown, unknown]> = [
+    [[1, 2, 3, 4, 5], [5, 1, 9, 3, 2]],
+    [[], [1, 2]],
+    [[[1], [2]], [[2], [1, 1]]],
+    [{ a: [1, { b: 2 }], c: null }, { a: [{ b: 3 }, 1], c: [] }],
+    [{ a: 1 }, [1]],
+    [null, { a: null }],
+    [{ "": 1, "~": [1] }, { "": 2, "~": [] }],
+  ];
+  for (const [from, to] of cases) {
+    const f = structuredClone(from);
+    const t = structuredClone(to);
+    const patch = createPatch(from, to);
+    assert.deepEqual(from, f);
+    assert.deepEqual(to, t);
+    assert.deepEqual(applyPatch(from, patch), to);
+  }
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0].value as { b: number }).b = 9;
+  assert.equal(to.a.b, 1);
+});
