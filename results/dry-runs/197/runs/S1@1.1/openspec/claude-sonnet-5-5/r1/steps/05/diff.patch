index 4fb27f942d0f012cef60f7f83c00793e65667474..df5a9f3b50a8fa3ed4077a7dd8ba4e039b85d908 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -223,3 +223,90 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+/** Pairs up items of `a` and `b` that are equal and keep their relative order (longest common subsequence). */
+function alignArrays(a: unknown[], b: unknown[]): Array<[number, number]> {
+  let start = 0;
+  while (start < a.length && start < b.length && deepEqual(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && deepEqual(a[endA - 1], b[endB - 1])) {
+    endA--;
+    endB--;
+  }
+  const n = endA - start;
+  const m = endB - start;
+  // lcs[i][j]: length of the LCS of a[start+i..endA) and b[start+j..endB)
+  const lcs = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = deepEqual(a[start + i], b[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  const pairs: Array<[number, number]> = [];
+  for (let i = 0; i < start; i++) pairs.push([i, i]);
+  let i = 0;
+  let j = 0;
+  while (i < n && j < m) {
+    if (deepEqual(a[start + i], b[start + j])) {
+      pairs.push([start + i, start + j]);
+      i++;
+      j++;
+    } else if (lcs[i + 1][j] >= lcs[i][j + 1]) i++;
+    else j++;
+  }
+  for (let k = 0; endA + k < a.length; k++) pairs.push([endA + k, endB + k]);
+  return pairs;
+}
+
+function diffInto(from: unknown, to: unknown, path: string, ops: Record<string, unknown>[]): void {
+  if (deepEqual(from, to)) return;
+  if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(from, key)) diffInto(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: structuredClone(to[key]) });
+    }
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    // `cur` is the index in the partially patched array of the next unmatched position.
+    let cur = 0;
+    let i = 0;
+    let j = 0;
+    const pairs = alignArrays(from, to);
+    pairs.push([from.length, to.length]);
+    for (const [matchI, matchJ] of pairs) {
+      const removed = matchI - i;
+      const added = matchJ - j;
+      const paired = Math.min(removed, added);
+      for (let k = 0; k < paired; k++) diffInto(from[i + k], to[j + k], `${path}/${cur + k}`, ops);
+      for (let k = paired; k < removed; k++) ops.push({ op: "remove", path: `${path}/${cur + paired}` });
+      for (let k = paired; k < added; k++) {
+        ops.push({ op: "add", path: `${path}/${cur + k}`, value: structuredClone(to[j + k]) });
+      }
+      cur += added + 1;
+      i = matchI + 1;
+      j = matchJ + 1;
+    }
+  } else {
+    ops.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Returns an RFC 6902 JSON Patch that turns `from` into `to` when applied, describing only what differs.
+ * Neither `from` nor `to` is mutated, and the patch shares no structure with them.
+ */
+export function createPatch(from: unknown, to: unknown): Record<string, unknown>[] {
+  const ops: Record<string, unknown>[] = [];
+  diffInto(from, to, "", ops);
+  return ops;
+}
