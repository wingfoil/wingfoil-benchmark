index e638574945ebe5ae9f9d679f423db2120494cba1..9673e6c73d2faaa6afa6d3431951c31d08a3a352 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -42,3 +42,166 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+type Container = unknown[] | Record<string, unknown>;
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function deepEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => deepEqual(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return (
+      keys.length === Object.keys(b).length &&
+      keys.every((key) => Object.hasOwn(b, key) && deepEqual(a[key], b[key]))
+    );
+  }
+  return a === b;
+}
+
+/** Finds the container holding the target of `tokens` (which must be non-empty). */
+function parentOf(document: unknown, tokens: string[], path: string): Container {
+  let current = document;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`Path "${path}" does not exist: no array element "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (isObject(current) && Object.hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`Path "${path}" does not exist: cannot select "${token}"`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new Error(`Path "${path}" does not exist: parent is not an object or array`);
+  }
+  return current;
+}
+
+function existingIndex(parent: unknown[], token: string, path: string): number {
+  if (!ARRAY_INDEX.test(token) || Number(token) >= parent.length) {
+    throw new Error(`Path "${path}" does not exist: no array element "${token}"`);
+  }
+  return Number(token);
+}
+
+function getAt(document: unknown, path: string): unknown {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return document;
+  const parent = parentOf(document, tokens, path);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) return parent[existingIndex(parent, token, path)];
+  if (!Object.hasOwn(parent, token)) throw new Error(`Path "${path}" does not exist: no member "${token}"`);
+  return parent[token];
+}
+
+function addAt(document: unknown, path: string, value: unknown): unknown {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(document, tokens, path);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (token === "-") {
+      parent.push(value);
+    } else {
+      if (!ARRAY_INDEX.test(token) || Number(token) > parent.length) {
+        throw new Error(`Cannot add at "${path}": invalid array index "${token}"`);
+      }
+      parent.splice(Number(token), 0, value);
+    }
+  } else {
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+function removeAt(document: unknown, path: string): unknown {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) throw new Error("Cannot remove the whole document");
+  const parent = parentOf(document, tokens, path);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent.splice(existingIndex(parent, token, path), 1);
+  } else {
+    if (!Object.hasOwn(parent, token)) throw new Error(`Path "${path}" does not exist: no member "${token}"`);
+    delete parent[token];
+  }
+  return document;
+}
+
+function replaceAt(document: unknown, path: string, value: unknown): unknown {
+  const tokens = parsePointer(path);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(document, tokens, path);
+  const token = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    parent[existingIndex(parent, token, path)] = value;
+  } else {
+    if (!Object.hasOwn(parent, token)) throw new Error(`Path "${path}" does not exist: no member "${token}"`);
+    setMember(parent, token, value);
+  }
+  return document;
+}
+
+/**
+ * Applies an RFC 6902 JSON Patch to `document` and returns the resulting document.
+ * Neither `document` nor `patch` is mutated. Throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new Error("Invalid JSON Patch: not an array");
+  let result = structuredClone(document);
+  for (const [i, operation] of patch.entries()) {
+    if (!isObject(operation)) throw new Error(`Invalid JSON Patch: operation ${i} is not an object`);
+    const { op, path, from } = operation;
+    parsePointer(path);
+    const p = path as string;
+    const hasValue = Object.hasOwn(operation, "value");
+    const value = () => structuredClone(operation.value);
+    switch (op) {
+      case "add":
+      case "replace":
+      case "test":
+        if (!hasValue) throw new Error(`Invalid JSON Patch: operation ${i} (${op}) has no "value"`);
+        if (op === "add") result = addAt(result, p, value());
+        else if (op === "replace") result = replaceAt(result, p, value());
+        else if (!deepEqual(getAt(result, p), operation.value)) {
+          throw new Error(`Test failed: value at "${p}" is not equal to the expected value`);
+        }
+        break;
+      case "remove":
+        result = removeAt(result, p);
+        break;
+      case "move":
+      case "copy": {
+        const fromTokens = parsePointer(from);
+        const f = from as string;
+        const moved = getAt(result, f);
+        if (op === "copy") {
+          result = addAt(result, p, structuredClone(moved));
+          break;
+        }
+        const pathTokens = parsePointer(p);
+        if (f === p) break;
+        if (fromTokens.length < pathTokens.length && fromTokens.every((t, k) => t === pathTokens[k])) {
+          throw new Error(`Cannot move "${f}" into its own child "${p}"`);
+        }
+        result = addAt(removeAt(result, f), p, moved);
+        break;
+      }
+      default:
+        throw new Error(`Invalid JSON Patch: operation ${i} has unknown op ${JSON.stringify(op)}`);
+    }
+  }
+  return result;
+}
