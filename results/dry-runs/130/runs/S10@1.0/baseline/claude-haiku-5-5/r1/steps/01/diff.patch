+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** Orders whose items come to this amount or more can use `WELCOME5`. */
+export const WELCOME5_MIN_ITEMS_CENTS: Cents = 3000;
+
+/** What `WELCOME5` takes off an order. */
+export const WELCOME5_CENTS: Cents = 500;
+
+/**
+ * What a discount code takes off an order whose items come to `itemsCents`. Shipping is never discounted.
+ *
+ * @param code - the discount code, already in capitals
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  switch (code) {
+    case 'SPRING10':
+      // 10 % of the items, rounded to the nearest cent with a half cent going up.
+      return ok(Math.floor((itemsCents * 10 + 50) / 100));
+    case 'WELCOME5':
+      if (itemsCents < WELCOME5_MIN_ITEMS_CENTS) {
+        return err(
+          'invalid',
+          `WELCOME5 needs items of ${formatEuros(WELCOME5_MIN_ITEMS_CENTS)} € or more; these come to ${formatEuros(itemsCents)} €`,
+        );
+      }
+      return ok(WELCOME5_CENTS);
+    default:
+      return err('invalid', `${code} is not a discount code`);
+  }
+}
