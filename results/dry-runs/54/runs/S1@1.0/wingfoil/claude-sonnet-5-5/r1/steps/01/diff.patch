@@ -0,0 +1,45 @@
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in reference token "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function step(current: unknown, token: string): unknown {
+  if (Array.isArray(current)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+      throw new Error(`JSON Pointer does not resolve: no array element "${token}"`);
+    }
+    return current[Number(token)];
+  }
+  if (typeof current === "object" && current !== null) {
+    if (!Object.hasOwn(current, token)) {
+      throw new Error(`JSON Pointer does not resolve: no member "${token}"`);
+    }
+    return (current as Record<string, unknown>)[token];
+  }
+  throw new Error(`JSON Pointer does not resolve: cannot descend into a scalar at "${token}"`);
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer (RFC 6901) `pointer` refers to.
+ * The pointer is the string form ("/a/0/b"), not the URI fragment form ("#/a/0/b").
+ *
+ * @throws Error if `pointer` is not a valid JSON Pointer, or if it does not resolve to a value of
+ * `document` (missing member, out-of-range index, the "-" past-the-end index, or a scalar traversed).
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new TypeError("Invalid JSON Pointer: must be a string");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  const tokens = pointer.slice(1).split("/").map(unescapeToken);
+  return tokens.reduce(step, document);
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..69d5501df84dad0d561e3863bb1ddb8b509173d2
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,68 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("unescapes ~01 as ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "x" }, "/~01"), "x");
+});
+
+test("resolves falsy values and null", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer({ a: false }, "/a"), false);
+  assert.equal(resolvePointer([0], "/0"), 0);
+});
+
+test("rejects invalid pointers", () => {
+  assert.throws(() => resolvePointer(doc, "foo"));
+  assert.throws(() => resolvePointer(doc, "/a~"));
+  assert.throws(() => resolvePointer(doc, "/a~2"));
+  assert.throws(() => resolvePointer(doc, "#/foo"));
+  assert.throws(() => resolvePointer(doc, undefined as unknown as string));
+});
+
+test("throws when the pointer does not resolve", () => {
+  assert.throws(() => resolvePointer(doc, "/missing"));
+  assert.throws(() => resolvePointer(doc, "/foo/2"));
+  assert.throws(() => resolvePointer(doc, "/foo/-"));
+  assert.throws(() => resolvePointer(doc, "/foo/bar"));
+  assert.throws(() => resolvePointer(doc, "/foo/00"));
+  assert.throws(() => resolvePointer(doc, "/foo/+1"));
+  assert.throws(() => resolvePointer(doc, "/foo/length"));
+  assert.throws(() => resolvePointer(doc, "/foo/0/x"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer(5, "/a"));
+});
+
+test("does not reach inherited properties", () => {
+  assert.throws(() => resolvePointer({}, "/toString"));
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer({}, "/constructor/prototype"));
+});
