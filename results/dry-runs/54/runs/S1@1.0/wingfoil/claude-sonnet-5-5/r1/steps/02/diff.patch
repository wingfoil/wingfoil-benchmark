index 0000000000000000000000000000000000000000..7a354cb7f0aa7933f00325fd7d60a69616242656
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,150 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const apply = (document: unknown, ...patch: unknown[]) => applyPatch(document, patch as never);
+
+test("RFC 6902 appendix A examples", () => {
+  assert.deepEqual(apply({ foo: "bar" }, { op: "add", path: "/baz", value: "qux" }), { foo: "bar", baz: "qux" });
+  assert.deepEqual(apply({ foo: ["bar", "baz"] }, { op: "add", path: "/foo/1", value: "qux" }), {
+    foo: ["bar", "qux", "baz"],
+  });
+  assert.deepEqual(apply({ baz: "qux", foo: "bar" }, { op: "remove", path: "/baz" }), { foo: "bar" });
+  assert.deepEqual(apply({ foo: ["bar", "qux", "baz"] }, { op: "remove", path: "/foo/1" }), {
+    foo: ["bar", "baz"],
+  });
+  assert.deepEqual(apply({ baz: "qux", foo: "bar" }, { op: "replace", path: "/baz", value: "boo" }), {
+    baz: "boo",
+    foo: "bar",
+  });
+  assert.deepEqual(
+    apply({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, { op: "move", from: "/foo/waldo", path: "/qux/thud" }),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(apply({ foo: ["all", "grass", "cows", "eat"] }, { op: "move", from: "/foo/1", path: "/foo/3" }), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  assert.deepEqual(apply({ baz: "qux", foo: ["a", 2, "c"] }, { op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }), {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  });
+  assert.deepEqual(apply({ foo: "bar" }, { op: "add", path: "/child", value: { grandchild: {} } }), {
+    foo: "bar",
+    child: { grandchild: {} },
+  });
+  assert.deepEqual(apply({ foo: "bar" }, { op: "add", path: "/baz", value: "qux", xyz: 123 }), { foo: "bar", baz: "qux" });
+  assert.deepEqual(apply({ foo: ["bar"] }, { op: "add", path: "/foo/-", value: ["abc", "def"] }), {
+    foo: ["bar", ["abc", "def"]],
+  });
+});
+
+test("RFC 6902 appendix A error examples", () => {
+  assert.throws(() => apply({ baz: "qux" }, { op: "test", path: "/baz", value: "bar" }));
+  assert.throws(() => apply({ foo: "bar" }, { op: "add", path: "/baz/bat", value: "qux" }));
+  assert.throws(() => apply({ foo: "bar" }, { op: "remove", path: "/baz" }));
+  assert.throws(() => apply({ foo: "bar" }, { op: "replace", path: "/baz", value: 1 }));
+});
+
+test("copy duplicates a value that is independent of the original", () => {
+  const result = apply({ a: { x: 1 } }, { op: "copy", from: "/a", path: "/b" }, { op: "add", path: "/b/y", value: 2 }) as any;
+  assert.deepEqual(result, { a: { x: 1 }, b: { x: 1, y: 2 } });
+});
+
+test("whole-document operations on the root pointer", () => {
+  assert.deepEqual(apply({ a: 1 }, { op: "add", path: "", value: [1] }), [1]);
+  assert.deepEqual(apply({ a: 1 }, { op: "replace", path: "", value: null }), null);
+  assert.deepEqual(apply({ a: 1 }, { op: "test", path: "", value: { a: 1 } }), { a: 1 });
+  assert.throws(() => apply({ a: 1 }, { op: "remove", path: "" }));
+});
+
+test("empty patch returns an equal, distinct document", () => {
+  const doc = { a: [1] };
+  const result = applyPatch(doc, []);
+  assert.deepEqual(result, doc);
+  assert.notEqual(result, doc);
+});
+
+test("inputs are never mutated, even when a later operation fails", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const value = { n: [1] };
+  const patch = [
+    { op: "add", path: "/a/-", value },
+    { op: "remove", path: "/b/c" },
+    { op: "test", path: "/a/0", value: 99 },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  assert.throws(() => applyPatch(doc, patch as never));
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  const result = applyPatch(doc, patch.slice(0, 2) as never) as any;
+  result.a[2].n.push(2);
+  assert.deepEqual(value, { n: [1] });
+});
+
+test("add on arrays: index bounds and format", () => {
+  assert.deepEqual(apply([1], { op: "add", path: "/1", value: 2 }), [1, 2]);
+  assert.deepEqual(apply([], { op: "add", path: "/0", value: 1 }), [1]);
+  assert.throws(() => apply([1], { op: "add", path: "/2", value: 2 }));
+  assert.throws(() => apply([1], { op: "add", path: "/01", value: 2 }));
+  assert.throws(() => apply([1], { op: "add", path: "/-1", value: 2 }));
+  assert.throws(() => apply([1], { op: "add", path: "/x", value: 2 }));
+  assert.throws(() => apply([1], { op: "add", path: "/-/0", value: 2 }));
+});
+
+test("remove, replace and move on arrays", () => {
+  assert.throws(() => apply([1], { op: "remove", path: "/1" }));
+  assert.throws(() => apply([1], { op: "remove", path: "/-" }));
+  assert.throws(() => apply([1], { op: "replace", path: "/-", value: 2 }));
+  assert.deepEqual(apply([1, 2], { op: "replace", path: "/1", value: 3 }), [1, 3]);
+  assert.throws(() => apply([1], { op: "move", from: "/3", path: "/0" }));
+});
+
+test("move to a location inside its own source fails; to itself is a no-op", () => {
+  assert.throws(() => apply({ a: { b: 1 } }, { op: "move", from: "/a", path: "/a/c" }));
+  assert.deepEqual(apply({ a: 1 }, { op: "move", from: "/a", path: "/a" }), { a: 1 });
+  assert.throws(() => apply({ a: 1 }, { op: "move", from: "/b", path: "/b" }));
+});
+
+test("test operation compares by JSON value equality", () => {
+  const doc = { a: { x: 1, y: [1, { z: null }] }, n: 1 };
+  assert.doesNotThrow(() => apply(doc, { op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }));
+  assert.throws(() => apply(doc, { op: "test", path: "/a", value: { x: 1, y: [{ z: null }, 1] } }));
+  assert.throws(() => apply(doc, { op: "test", path: "/n", value: "1" }));
+  assert.throws(() => apply(doc, { op: "test", path: "/a", value: { x: 1 } }));
+  assert.throws(() => apply(doc, { op: "test", path: "/missing", value: null }));
+  assert.throws(() => apply([1], { op: "test", path: "/0", value: [1] }));
+  assert.doesNotThrow(() => apply({ a: null }, { op: "test", path: "/a", value: null }));
+});
+
+test("escaped pointers and special member names", () => {
+  assert.deepEqual(apply({}, { op: "add", path: "/a~1b", value: 1 }, { op: "add", path: "/m~0n", value: 2 }), {
+    "a/b": 1,
+    "m~n": 2,
+  });
+  const result = apply({}, { op: "add", path: "/__proto__", value: { polluted: true } }) as any;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as any).polluted, undefined);
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.throws(() => apply({}, { op: "remove", path: "/toString" }));
+  assert.throws(() => apply({}, { op: "add", path: "/toString/x", value: 1 }));
+});
+
+test("invalid patches are rejected", () => {
+  assert.throws(() => applyPatch({}, {} as never));
+  assert.throws(() => applyPatch({}, null as never));
+  assert.throws(() => apply({}, null));
+  assert.throws(() => apply({}, []));
+  assert.throws(() => apply({}, { path: "/a", value: 1 }));
+  assert.throws(() => apply({}, { op: "bogus", path: "/a" }));
+  assert.throws(() => apply({}, { op: "add", value: 1 }));
+  assert.throws(() => apply({}, { op: "add", path: 1, value: 1 }));
+  assert.throws(() => apply({}, { op: "add", path: "a", value: 1 }));
+  assert.throws(() => apply({}, { op: "add", path: "/a" }));
+  assert.throws(() => apply({}, { op: "replace", path: "/a" }));
+  assert.throws(() => apply({ a: 1 }, { op: "test", path: "/a" }));
+  assert.throws(() => apply({ a: 1 }, { op: "move", path: "/b" }));
+  assert.throws(() => apply({ a: 1 }, { op: "copy", path: "/b" }));
+  assert.throws(() => apply({ a: 1 }, { op: "copy", from: 1, path: "/b" }));
+  assert.throws(() => apply({ a: 1 }, { op: "remove", path: "/a~2" }));
+});
