+
+<!-- task body. `wingfoil memory add` copies this scaffold verbatim; `memory submit` replaces
+     these placeholder comments with real content and fills the required frontmatter fields. -->
+
+Added `createPatch(from, to)` to `src/index.ts`: returns an RFC 6902 patch that `applyPatch` applies to turn `from` into `to`. Tests in `test/create-patch.test.ts` cover equal documents, a single small change in a nested document, member add/remove, root replacement, pointer escaping, array insert/remove/append/replace, arrays of objects, `null` and `__proto__` data, non-mutation / no shared structure, and round trips through `applyPatch` for every pair of sample documents. All tests pass.
+
+Decision recorded in dl-005-createpatch-minimal-diff-semantics.
diff --git a/src/index.ts b/src/index.ts
index 69ac9a7e60c99ef25e3947b96693608e22d07e5d..c32a5ff3180b984c1fb09eb847c7a9936097e6d6 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -234,3 +234,70 @@ function mergeInto(target: unknown, patch: unknown): unknown {
 export function applyMergePatch(target: unknown, patch: unknown): unknown {
   return mergeInto(target, patch);
 }
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffObjects(from: Record<string, unknown>, to: Record<string, unknown>, path: string, out: PatchOperation[]): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+  for (const key of Object.keys(to)) {
+    const child = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(from, key)) {
+      diffInto(from[key], to[key], child, out);
+    } else {
+      out.push({ op: "add", path: child, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, out: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) {
+    start++;
+  }
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && jsonEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+  const common = Math.min(fromEnd, toEnd) - start;
+  for (let i = start; i < start + common; i++) {
+    diffInto(from[i], to[i], `${path}/${i}`, out);
+  }
+  for (let i = fromEnd - 1; i >= start + common; i--) {
+    out.push({ op: "remove", path: `${path}/${i}` });
+  }
+  for (let i = start + common; i < toEnd; i++) {
+    out.push({ op: "add", path: `${path}/${i}`, value: structuredClone(to[i]) });
+  }
+}
+
+function diffInto(from: unknown, to: unknown, path: string, out: PatchOperation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isObject(from) && isObject(to)) {
+    diffObjects(from, to, path, out);
+  } else if (!jsonEqual(from, to)) {
+    out.push({ op: "replace", path, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied with `applyPatch`.
+ * The patch describes only the differences: objects are compared member by member and arrays
+ * element by element (an unchanged head and tail are skipped), so a small change gives a small
+ * patch. Only `add`, `remove` and `replace` operations are produced; equal documents give an empty
+ * patch. Neither argument is mutated; the patch shares no structure with them. Array operations are
+ * ordered so that every index is valid when its operation is applied.
+ */
+export function createPatch(from: unknown, to: unknown): Patch {
+  const out: PatchOperation[] = [];
+  diffInto(from, to, "", out);
+  return out;
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9eb3466a5c76e27d48f6b493e687e61967debe4d
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,80 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown) {
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+  assert.deepEqual(roundTrip(null, null), []);
+});
+
+test("one small change in a large document gives one operation", () => {
+  const from = { a: { b: { c: 1, d: [1, 2, 3] } }, big: { x: "y" } };
+  const to = { a: { b: { c: 2, d: [1, 2, 3] } }, big: { x: "y" } };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/c", value: 2 }]);
+});
+
+test("object members are added and removed", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { b: 2, c: 3 }), [
+    { op: "remove", path: "/a" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("root replacement when types differ or scalars change", () => {
+  assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  roundTrip([], {});
+  roundTrip(null, {});
+});
+
+test("pointer tokens are escaped", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "~": 1 }, { "a/b": 2, "~": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/~0", value: 2 },
+  ]);
+});
+
+test("array insertion, removal and append touch only the difference", () => {
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 2, 3, 4]), [{ op: "add", path: "/3", value: 4 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 4]), [
+    { op: "remove", path: "/2" },
+    { op: "remove", path: "/1" },
+  ]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 9, 2, 3]), [{ op: "add", path: "/1", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3], [1, 5, 3]), [{ op: "replace", path: "/1", value: 5 }]);
+});
+
+test("arrays of objects recurse into elements", () => {
+  assert.deepEqual(roundTrip([{ a: 1 }, { a: 2 }], [{ a: 1 }, { a: 3 }]), [{ op: "replace", path: "/1/a", value: 3 }]);
+});
+
+test("null values and __proto__ members are handled as data", () => {
+  roundTrip({ a: null }, { a: 1 });
+  roundTrip({ a: 1 }, { a: null });
+  const to = JSON.parse('{"__proto__": {"x": 1}}');
+  const patch = roundTrip({}, to);
+  assert.deepEqual(patch, [{ op: "add", path: "/__proto__", value: { x: 1 } }]);
+  roundTrip(to, {});
+});
+
+test("the patch shares no structure with its inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to) as { value: { b: number } }[];
+  patch[0].value.b = 2;
+  assert.equal(to.a.b, 1);
+});
+
+test("round trips between every pair of sample documents", () => {
+  const values: unknown[] = [null, 1, "a", [], {}, [1, 2], [2, 1], [1, [2]], { a: 1 }, { a: [1, 2, 3] }, { a: [1, 3], b: {} }, [{ a: 1 }, 2, 3]];
+  for (const from of values) for (const to of values) roundTrip(from, to);
+});
