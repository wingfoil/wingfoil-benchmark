index 3c33f4f082b1d0d40d744f99127a391c35aa1b3a..69ac9a7e60c99ef25e3947b96693608e22d07e5d 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -203,3 +203,34 @@ export function applyPatch(document: unknown, patch: Patch): unknown {
   }
   return result;
 }
+
+function mergeInto(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return structuredClone(patch);
+  }
+  const result: Record<string, unknown> = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) {
+      setMember(result, key, structuredClone(target[key]));
+    }
+  }
+  for (const key of Object.keys(patch)) {
+    if (patch[key] === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, mergeInto(Object.hasOwn(result, key) ? result[key] : undefined, patch[key]));
+    }
+  }
+  return result;
+}
+
+/**
+ * Applies the JSON Merge Patch (RFC 7386) `patch` to `target` and returns the merged document.
+ * A non-object `patch` replaces `target`; an object `patch` is merged member by member, a `null`
+ * member removing the member of that name. A non-object `target` is treated as an empty object when
+ * `patch` is an object. Arrays are replaced, never merged. Neither argument is mutated; the result
+ * shares no structure with them.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return mergeInto(target, patch);
+}
diff --git a/test/merge-patch.test.ts b/test/merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6e90c637c2543eac8da2e92ccaafbc19f33b17c7
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,67 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 section 3 example", () => {
+  const target = { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["example", "sample"], content: "This will be unchanged" };
+  const patch = { title: "Hello!", phoneNumber: "+01-123-456-7890", author: { familyName: null }, tags: ["example"] };
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+});
+
+test("RFC 7386 appendix A test cases", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test("a non-object target is treated as an empty object", () => {
+  assert.deepEqual(applyMergePatch(undefined, { a: 1 }), { a: 1 });
+  assert.deepEqual(applyMergePatch(5, { a: null, b: { c: null } }), { b: {} });
+});
+
+test("member order of the target is kept, new members are appended", () => {
+  assert.deepEqual(Object.keys(applyMergePatch({ a: 1, b: 2 }, { a: 3, c: 4 }) as object), ["a", "b", "c"]);
+});
+
+test("arguments are not mutated and the result shares no structure", () => {
+  const target = { a: { b: 1 }, arr: [1] };
+  const patch = { c: { d: [1] }, arr: [2] };
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, { a: { b: 1 }, arr: [1] });
+  assert.deepEqual(patch, { c: { d: [1] }, arr: [2] });
+  assert.notEqual(result.a, target.a);
+  assert.notEqual(result.c, patch.c);
+  assert.notEqual(result.arr, patch.arr);
+});
+
+test("__proto__ is an ordinary member name", () => {
+  const patch = JSON.parse('{"__proto__": {"polluted": true}}');
+  const result = applyMergePatch({}, patch) as any;
+  assert.equal(Object.hasOwn(result, "__proto__"), true);
+  assert.equal(({} as any).polluted, undefined);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepEqual(applyMergePatch(result, JSON.parse('{"__proto__": null}')), {});
+});
