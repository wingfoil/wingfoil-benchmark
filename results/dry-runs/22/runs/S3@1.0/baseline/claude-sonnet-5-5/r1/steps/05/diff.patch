+
+test('cancel frees the equipment and refunds in full before the start only', () => {
+  const s = setup();
+  const b = s.book(r('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.deepEqual(s.cancel(b.id, '2026-06-30T12:00:00Z'), { bookingId: b.id, refund: 5000 });
+  assert.deepEqual(s.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' }), ['b1']);
+  assert.throws(() => s.cancel(b.id, '2026-06-30T13:00:00Z'));
+  const c = s.book(r('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.equal(s.cancel(c.id, '2026-07-02T00:00:00Z').refund, 0);
+  const d = s.book(r('2026-07-05T00:00:00Z', '2026-07-06T00:00:00Z'));
+  assert.throws(() => s.cancel(d.id, '2026-07-06T00:00:00Z'));
