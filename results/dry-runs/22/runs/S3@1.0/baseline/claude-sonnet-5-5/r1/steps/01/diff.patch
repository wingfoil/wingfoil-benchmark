@@ -0,0 +1,34 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  return s;
+}
+const r = (start: string, end: string, itemId = 'b1') => ({ itemId, start, end });
+
+test('quotes whole days in cents', () => {
+  const q = setup().quote(r('2026-07-01T00:00:00Z', '2026-07-04T00:00:00.000Z'));
+  assert.equal(q.total, 7500);
+});
+
+test('rejects bad requests', () => {
+  const s = setup();
+  assert.throws(() => s.quote(r('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z', 'x')));
+  assert.throws(() => s.quote(r('2026-07-01T10:00:00Z', '2026-07-02T00:00:00Z')));
+  assert.throws(() => s.quote(r('2026-07-01T00:00:00+02:00', '2026-07-02T00:00:00Z')));
+  assert.throws(() => s.quote(r('2026-07-02T00:00:00Z', '2026-07-02T00:00:00Z')));
+  assert.throws(() => s.quote(r('2026-07-01', '2026-07-02T00:00:00Z')));
+});
+
+test('book prevents overlaps but allows back-to-back', () => {
+  const s = setup();
+  const b = s.book(r('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.equal(b.total, 5000);
+  assert.throws(() => s.book(r('2026-07-02T00:00:00Z', '2026-07-04T00:00:00Z')));
+  s.book(r('2026-07-03T00:00:00Z', '2026-07-04T00:00:00Z'));
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  s.book(r('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z', 's1'));
+});
