@@ -51,3 +51,16 @@ test('rentals of 3 days or more get 10% off, in quotes and bookings', () => {
   assert.equal(s.quote(r('2026-07-01T00:00:00Z', '2026-07-04T00:00:00Z')).total, 6750);
   assert.equal(s.book(r('2026-07-10T00:00:00Z', '2026-07-14T00:00:00Z')).total, 9000);
