+
+test('rentals shorter than a day are priced per hour', () => {
+  const s = setup();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  assert.equal(s.quote(r('2026-07-01T13:00:00Z', '2026-07-01T17:00:00Z', 'h1')).total, 2400);
+  assert.equal(s.book(r('2026-07-01T22:00:00Z', '2026-07-02T02:00:00Z', 'h1')).total, 2400);
+  assert.throws(() => s.book(r('2026-07-02T01:00:00Z', '2026-07-02T03:00:00Z', 'h1')));
+  assert.equal(s.quote(r('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z', 'h1')).total, 2500);
+  assert.throws(() => s.quote(r('2026-07-01T13:00:00Z', '2026-07-01T17:00:00Z')));
+  assert.throws(() => s.quote(r('2026-07-01T13:30:00Z', '2026-07-01T17:00:00Z', 'h1')));
+  assert.throws(() => s.quote(r('2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z', 'h1')));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+});
