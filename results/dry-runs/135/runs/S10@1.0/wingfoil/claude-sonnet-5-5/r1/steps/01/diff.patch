+  /**
+   * Gives the order a discount code, replacing any earlier one. An unknown code, or `WELCOME5` on
+   * an order whose items come to less than 30.00 €, is refused and the order is left as it was.
+   */
+  applyCode(number: number, code: string): Result<Order>;
+}
+
+/** The items total from which `WELCOME5` is accepted. */
+const WELCOME5_MIN_CENTS: Cents = 3000;
+
+/** The discount a known code gives on these items, or why it is refused. */
+function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  switch (code) {
+    case 'SPRING10':
+      // Integer arithmetic: items * 10 / 100, half a cent rounding up.
+      return ok(Math.floor((itemsCents + 5) / 10));
+    case 'WELCOME5':
+      return itemsCents >= WELCOME5_MIN_CENTS
+        ? ok(500)
+        : err('invalid', 'WELCOME5 needs items of 30.00 or more');
+    default:
+      return err('invalid', `${code} is not a discount code`);
+  }
 }
 
