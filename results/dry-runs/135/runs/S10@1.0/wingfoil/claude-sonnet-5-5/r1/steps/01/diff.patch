+
+describe('discount codes', () => {
+  function withOrder(sku: string, quantity: number) {
+    const shop = stocked();
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku, quantity }] });
+    return shop;
+  }
+
+  it('takes 10 % off the items with SPRING10, rounding half a cent up', () => {
+    const shop = withOrder('OIL-1L', 1); // 12.90 -> 1.29
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 1290, discountCents: 129, shippingCents: 490, totalCents: 1651 });
+    const apples = withOrder('APL-1KG', 1); // 3.49 -> 0.349 -> 0.35
+    valueOf(apples.orders.applyCode(1, 'SPRING10'));
+    assert.equal(valueOf(apples.orders.totals(1)).discountCents, 35);
+  });
+
+  it('takes 5.00 off with WELCOME5 from 30.00, and refuses it below', () => {
+    const shop = withOrder('OIL-1L', 3); // 38.70
+    valueOf(shop.orders.applyCode(1, 'WELCOME5'));
+    assert.equal(valueOf(shop.orders.totals(1)).totalCents, 3870 - 500 + 490);
+    const small = withOrder('OIL-1L', 1);
+    const refused = small.orders.applyCode(1, 'WELCOME5');
+    assert.equal(refused.ok, false);
+    assert.equal(valueOf(small.orders.totals(1)).discountCents, 0);
+  });
+
+  it('refuses an unknown code and keeps the earlier one; a second code replaces the first', () => {
+    const shop = withOrder('OIL-1L', 3);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.equal(shop.orders.applyCode(1, 'NOPE').ok, false);
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 387);
+    valueOf(shop.orders.applyCode(1, 'WELCOME5'));
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 500);
+    assert.equal(shop.orders.applyCode(9, 'SPRING10').ok, false);
+  });
+
+  it('decides free shipping on the items before the discount', () => {
+    const shop = withOrder('HAM-W', 1); // 64.00
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 6400, discountCents: 640, shippingCents: 0, totalCents: 5760 });
+    const edge = withOrder('OIL-1L', 4); // 51.60 -> 46.44 after discount, still free
+    valueOf(edge.orders.applyCode(1, 'SPRING10'));
+    assert.equal(valueOf(edge.orders.totals(1)).shippingCents, 0);
+  });
+});
