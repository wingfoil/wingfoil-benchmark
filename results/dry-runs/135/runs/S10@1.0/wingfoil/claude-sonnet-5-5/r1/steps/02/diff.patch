+
+describe('monthly export', () => {
+  it('lists the orders of a month as CSV, with totals as paid', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, "Al"', email: 'al@example.org', phone: '' }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'APL-1KG', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c2', date: '2026-10-31', lines: [{ sku: 'HAM-W', quantity: 1 }] }));
+    valueOf(shop.orders.applyCode(3, 'SPRING10'));
+    const csv = shop.orders.exportMonth('2026-10');
+    assert.ok(!csv.includes('@') && !csv.includes('555-0101'));
+    assert.equal(
+      csv,
+      'order,date,customer,total\n' +
+        '2,2026-10-02,Mira Holt,17.80\n' +
+        '3,2026-10-31,"Holt, ""Al""",57.60\n',
+    );
+  });
+
+  it('gives the header alone for an empty month and refuses a malformed one', () => {
+    const shop = stocked();
+    assert.equal(shop.orders.exportMonth('2026-11'), 'order,date,customer,total\n');
+    assert.throws(() => shop.orders.exportMonth('2026-13'), RangeError);
+  });
+});
