@@ -0,0 +1,34 @@
+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** WELCOME5 takes this much off an order whose items come to at least `WELCOME_MINIMUM_CENTS`. */
+const WELCOME_DISCOUNT_CENTS: Cents = 500;
+
+/** The smallest items amount that WELCOME5 applies to. */
+export const WELCOME_MINIMUM_CENTS: Cents = 3000;
+
+/**
+ * What a discount code takes off an order's items, in cents.
+ *
+ * @param code - the code, trimmed and upper-cased
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  switch (code) {
+    case 'SPRING10':
+      // 10 % of the items, rounded to the nearest cent with a half cent rounding up.
+      return ok(Math.floor((itemsCents * 10 + 50) / 100));
+    case 'WELCOME5':
+      if (itemsCents < WELCOME_MINIMUM_CENTS) {
+        return err(
+          'invalid',
+          `WELCOME5 needs items of ${formatEuros(WELCOME_MINIMUM_CENTS)} € or more; these come to ${formatEuros(itemsCents)} €`,
+        );
+      }
+      return ok(WELCOME_DISCOUNT_CENTS);
+    default:
+      return err('invalid', `${code} is not a discount code`);
+  }
+}
