 }
 
 const DATE = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
+const MONTH = /^\d{4}-(0[1-9]|1[0-2])$/;
+const EXPORT_HEADER = 'order,date,customer,total';
+
+/** A CSV field: quoted, with its quotes doubled, when it holds a comma, a quote or a line break. */
+function csvField(value: string): string {
+  return /[",\r\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
+}
 
 /**
  * An empty order book over a catalogue and a customer list.
@@ -110,6 +124,20 @@ export function createOrderBook(catalogue: Catalogue, customers: Customers): Ord
       codes.set(number, name);
       return totals;
     },
+    exportMonth(month) {
+      if (!MONTH.test(month)) return err('invalid', `${month} is not a month (YYYY-MM)`);
+      const rows = [EXPORT_HEADER];
+      for (const order of orders) {
+        if (!order.date.startsWith(`${month}-`)) continue;
+        const customer = customers.get(order.customerId);
+        if (!customer.ok) return customer;
+        const totals = totalsOf(order, codes.get(order.number));
+        if (!totals.ok) return totals;
+        const fields = [order.number, order.date, customer.value.name];
+        rows.push([...fields.map((field) => csvField(String(field))), formatEuros(totals.value.totalCents)].join(','));
+      }
+      return ok(rows.join('\n'));
+    },
   };
 
