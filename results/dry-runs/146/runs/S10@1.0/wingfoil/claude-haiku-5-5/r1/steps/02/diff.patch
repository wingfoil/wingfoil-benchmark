+
+describe('monthly export', () => {
+  const HEADER = 'order,date,customer,total';
+
+  it('gives the header line alone for a month with no orders', () => {
+    const shop = stocked();
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    assert.equal(valueOf(shop.orders.exportMonth('2026-09')), HEADER);
+  });
+
+  it('gives one line per order of the month, by order number, and leaves out other months', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Tomas Reyes', email: 'tomas@example.org', phone: '555-0202' }));
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c2', date: '2026-09-28', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c2', date: '2026-10-30', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    assert.equal(
+      valueOf(shop.orders.exportMonth('2026-10')),
+      [HEADER, '1,2026-10-02,Mira Holt,17.80', '3,2026-10-30,Tomas Reyes,64.00'].join('\n'),
+    );
+  });
+
+  it('writes the total the customer pays, with any discount code and its shipping', () => {
+    const shop = stocked();
+    const number = valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] })).number;
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.exportMonth('2026-10')).split('\n')[1], '1,2026-10-02,Mira Holt,16.51');
+  });
+
+  it('quotes a value that contains a comma or a quote, doubling the quotes', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, "Mira" & Co', email: 'co@example.org', phone: '555-0303' }));
+    shop.orders.place({ customerId: 'c2', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    assert.equal(valueOf(shop.orders.exportMonth('2026-10')).split('\n')[1], '1,2026-10-02,"Holt, ""Mira"" & Co",17.80');
+  });
+
+  it('leaves customers\' email addresses and phone numbers out', () => {
+    const shop = stocked();
