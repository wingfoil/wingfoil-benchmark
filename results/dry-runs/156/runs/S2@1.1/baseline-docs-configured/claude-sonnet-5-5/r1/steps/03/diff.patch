diff --git a/test/coupons.test.ts b/test/coupons.test.ts
index a274ac451bb19a9ff1b7e2100a4367e3ce0218d0..afc61f926082565fb8f0513f1b3e34077686d5a8 100644
--- a/test/coupons.test.ts
+++ b/test/coupons.test.ts
@@ -56,4 +56,28 @@ describe('coupons', () => {
     assert.equal(coupons.usedBy('ONCE'), 'ORD-0001');
     assert.throws(() => orders.place({ customer: 'c-2', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'ONCE' }), CouponError);
   });
+
+  it('gives a single-use coupon back when its order is cancelled, so a new order can use it', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'WELCOME', kind: 'fixed', value: 100, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = orders.place({ customer: 'paolo', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'WELCOME' });
+    orders.cancel(first.id, '2026-05-05');
+    assert.equal(coupons.usedBy('WELCOME'), undefined);
+    const second = orders.place({ customer: 'paolo', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'WELCOME' });
+    assert.equal(coupons.usedBy('WELCOME'), second.id);
+  });
+
+  it('ships free when the goods come to exactly 50.00 after a coupon, not at 49.99', () => {
+    const { orders, catalog, inventory } = shop();
+    catalog.add({ sku: 'BAG-55', name: 'Bag', priceCents: 5500, vatClass: 'standard', weightGrams: 100 });
+    catalog.add({ sku: 'BAG-54', name: 'Bag', priceCents: 5499, vatClass: 'standard', weightGrams: 100 });
+    inventory.restock('BAG-55', 5);
+    inventory.restock('BAG-54', 5);
+    const exact = orders.place({ customer: 'c-1', date: '2026-03-15', lines: [{ sku: 'BAG-55', quantity: 1 }], coupon: 'FIVEOFF' });
+    const below = orders.place({ customer: 'c-1', date: '2026-03-15', lines: [{ sku: 'BAG-54', quantity: 1 }], coupon: 'FIVEOFF' });
+    assert.equal(exact.totals.goodsCents, 5000);
+    assert.equal(exact.totals.shippingCents, 0);
+    assert.equal(below.totals.goodsCents, 4999);
+    assert.equal(below.totals.shippingCents, 490);
+  });
 });
