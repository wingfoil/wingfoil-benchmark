diff --git a/test/orders.test.ts b/test/orders.test.ts
index d07f06bd09b3489b674e3119a14ea7d2ced148a7..1c4e494303b222650b3e92127b6c894d79231586 100644
--- a/test/orders.test.ts
+++ b/test/orders.test.ts
@@ -79,4 +79,30 @@ describe('orders', () => {
     assert.match(text, /1 × Enamel mug \(MUG-01\)\s+€10\.00/);
     assert.match(text, /Total\s+€/);
   });
+
+  it('places an order keyed in with a lower-case SKU', () => {
+    const { orders } = shop();
+    const order = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'mug-01', quantity: 1 }] });
+    assert.equal(order.lines[0]?.sku, 'MUG-01');
+  });
+
+  it('ships free when the goods come to exactly 50.00, not at 49.99', () => {
+    const s = shop();
+    s.catalog.add({ sku: 'BOX-50', name: 'Box', priceCents: 5000, vatClass: 'standard', weightGrams: 100 });
+    s.catalog.add({ sku: 'BOX-49', name: 'Box', priceCents: 4999, vatClass: 'standard', weightGrams: 100 });
+    s.inventory.restock('BOX-50', 5);
+    s.inventory.restock('BOX-49', 5);
+    const exact = s.orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'BOX-50', quantity: 1 }] });
+    const below = s.orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'BOX-49', quantity: 1 }] });
+    assert.equal(exact.totals.shippingCents, 0);
+    assert.equal(below.totals.shippingCents, 490);
+  });
+
+  it('rounds the VAT of a line half up: 1.99 at 22% is 0.44', () => {
+    const s = shop();
+    s.catalog.add({ sku: 'LB-220', name: 'Lamp bulb', priceCents: 199, vatClass: 'standard', weightGrams: 50 });
+    s.inventory.restock('LB-220', 5);
+    const order = s.orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'LB-220', quantity: 1 }] });
+    assert.equal(order.lines[0]?.vatCents, 44);
+  });
 });
