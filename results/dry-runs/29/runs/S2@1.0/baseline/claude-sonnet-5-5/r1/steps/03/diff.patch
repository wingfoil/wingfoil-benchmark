+
+describe('regressions', () => {
+  it('gives a single-use coupon back when its order is cancelled', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = orders.place({ customer: 'paolo', date: '2026-03-02', coupon: 'welcome', lines: [{ sku: 'MUG-01', quantity: 1 }] });
+    orders.cancel(first.id, '2026-03-02');
+    const second = orders.place({ customer: 'paolo', date: '2026-03-02', coupon: 'WELCOME', lines: [{ sku: 'MUG-01', quantity: 2 }] });
+    assert.equal(second.status, 'confirmed');
+  });
+
+  it('ships free when the goods after discounts come to exactly €50.00', () => {
+    const { orders } = shop();
+    const order = orders.place({ customer: 'c-1', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 5 }] });
+    assert.equal(order.totals.goodsCents, 5000);
+    assert.equal(order.totals.shippingCents, 0);
+  });
+});
