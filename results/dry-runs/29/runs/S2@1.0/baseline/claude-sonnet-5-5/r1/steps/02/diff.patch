+
+describe('reported coupon bugs', () => {
+  it('takes a percentage off the subtotal after volume discounts', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'NB-1', name: 'Notebook', priceCents: 500, vatClass: 'standard', weightGrams: 100 });
+    s.inventory.restock('NB-1', 20);
+    s.coupons.add({ code: 'TEN', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31' });
+    const order = s.orders.place({ customer: 'c-1', date: '2026-03-15', lines: [{ sku: 'NB-1', quantity: 12 }], coupon: 'TEN' });
+    assert.equal(order.totals.goodsCents, 4860);
+  });
+
+  it('accepts a coupon on its last day', () => {
+    const { orders } = shop();
+    const order = orders.place({ customer: 'c-1', date: '2026-03-31', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'SPRING' });
+    assert.equal(order.totals.couponDiscountCents, 200);
+    assert.throws(() => orders.place({ customer: 'c-1', date: '2026-04-01', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'SPRING' }), CouponError);
+  });
+});
