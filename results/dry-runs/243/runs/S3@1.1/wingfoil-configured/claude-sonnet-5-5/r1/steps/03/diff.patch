 const DAY_MS = 24 * 60 * 60 * 1000;
+const LONG_RENTAL_DAYS = 3;
+
+/** Full price, less 10% from 3 days; integer euro cents, rounded half up. */
+function rentalTotal(dailyPrice: number, days: number): number {
+  const full = dailyPrice * days;
+  return days >= LONG_RENTAL_DAYS ? Math.floor((full * 90 + 50) / 100) : full;
+}
