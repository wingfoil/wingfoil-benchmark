+
+<!-- task body. `wingfoil memory add` copies this scaffold, setting only `id`, `title` and
+     `status` (and any `--tags` or `--set` value). Fill the required frontmatter fields and replace
+     these placeholder comments yourself; `wingfoil memory submit` then checks the required fields,
+     moves `status` forward and commits the document as you left it, naming in the commit body the
+     content it carries. -->
+
+Add `availability(query)` to the rental service, with `query = { start, end, kind? }`. It returns the sorted
+ids of the equipment of that kind (any kind when omitted) that is free for the whole period, using the same
+period rules and overlap test as `book` (end exclusive). Invalid periods or kinds throw. Tested in
+`test/rental.test.ts`.
diff --git a/src/index.ts b/src/index.ts
index 3dcb253cb90ffae8274dabd465d74f6959d4f4e7..8d3b84546dd829398f6d3cb47177a3aef505b7f0 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -23,10 +23,17 @@ export interface Booking extends Quote {
   id: string;
 }
 
+export interface AvailabilityQuery {
+  start: string;
+  end: string;
+  kind?: EquipmentKind;
+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  availability(query: AvailabilityQuery): string[];
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
@@ -93,5 +100,16 @@ export function createRentalService(): RentalService {
       bookings.push({ ...booking, startMs: start, endMs: end });
       return booking;
     },
+
+    availability(query) {
+      const { start, end } = parsePeriod({ itemId: '', start: query?.start, end: query?.end });
+      const kind = query.kind;
+      if (kind !== undefined && kind !== 'board' && kind !== 'sail') throw new Error("kind must be 'board' or 'sail'");
+      return [...items.values()]
+        .filter((item) => kind === undefined || item.kind === kind)
+        .filter((item) => !bookings.some((b) => b.itemId === item.id && start < b.endMs && b.startMs < end))
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
