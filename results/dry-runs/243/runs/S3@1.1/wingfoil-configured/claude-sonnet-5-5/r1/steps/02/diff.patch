   s.book(req('2026-06-01T00:00:00Z', '2026-06-03T00:00:00Z', 's1'));
   assert.notStrictEqual(a.id, b.id);
 });
+
+test('availability lists free equipment of a kind or of any kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 1000 });
+  s.book(req('2026-06-02T00:00:00Z', '2026-06-04T00:00:00Z'));
+  const q = (start: string, end: string, kind?: 'board' | 'sail') => s.availability({ start, end, kind });
+  assert.deepStrictEqual(q('2026-06-01T00:00:00Z', '2026-06-05T00:00:00Z'), ['a0', 's1']);
+  assert.deepStrictEqual(q('2026-06-01T00:00:00Z', '2026-06-05T00:00:00Z', 'board'), ['a0']);
+  assert.deepStrictEqual(q('2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z'), ['a0', 'b1', 's1']);
+  assert.deepStrictEqual(q('2026-06-04T00:00:00Z', '2026-06-05T00:00:00Z', 'board'), ['a0', 'b1']);
+  assert.deepStrictEqual(q('2026-06-03T00:00:00Z', '2026-06-04T00:00:00Z', 'sail'), ['s1']);
+  assert.throws(() => q('2026-06-02T00:00:00Z', '2026-06-02T00:00:00Z'));
+  assert.throws(() => s.availability({ start: '2026-06-01T00:00:00Z', end: '2026-06-02T00:00:00Z', kind: 'x' as never }));
+});
