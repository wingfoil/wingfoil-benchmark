@@ -0,0 +1,40 @@
+import { test } from 'node:test';
+import assert from 'node:assert';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2550 });
+  return s;
+}
+const req = (start: string, end: string, itemId = 'b1') => ({ itemId, start, end });
+
+test('quote multiplies the daily price by the number of days', () => {
+  const q = setup().quote(req('2026-06-01T00:00:00Z', '2026-06-04T00:00:00Z'));
+  assert.deepStrictEqual(q, { itemId: 'b1', start: '2026-06-01T00:00:00Z', end: '2026-06-04T00:00:00Z', total: 7650 });
+});
+
+test('quote and book reject unknown items and invalid periods', () => {
+  const s = setup();
+  for (const f of [s.quote.bind(s), s.book.bind(s)]) {
+    assert.throws(() => f(req('2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z', 'nope')));
+    assert.throws(() => f(req('2026-06-01T10:00:00Z', '2026-06-02T00:00:00Z')));
+    assert.throws(() => f(req('2026-06-01T00:00:00Z', '2026-06-02T12:00:00Z')));
+    assert.throws(() => f(req('2026-06-02T00:00:00Z', '2026-06-02T00:00:00Z')));
+    assert.throws(() => f(req('2026-06-03T00:00:00Z', '2026-06-02T00:00:00Z')));
+    assert.throws(() => f(req('2026-06-01T00:00:00+02:00', '2026-06-02T00:00:00Z')));
+    assert.throws(() => f(req('garbage', '2026-06-02T00:00:00Z')));
+  }
+});
+
+test('book returns an identified booking and blocks overlaps only', () => {
+  const s = setup();
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  const a = s.book(req('2026-06-01T00:00:00Z', '2026-06-03T00:00:00Z'));
+  assert.strictEqual(a.total, 5100);
+  assert.throws(() => s.book(req('2026-06-02T00:00:00Z', '2026-06-04T00:00:00Z')));
+  assert.throws(() => s.book(req('2026-05-30T00:00:00Z', '2026-06-02T00:00:00Z')));
+  const b = s.book(req('2026-06-03T00:00:00Z', '2026-06-04T00:00:00Z'));
+  s.book(req('2026-06-01T00:00:00Z', '2026-06-03T00:00:00Z', 's1'));
+  assert.notStrictEqual(a.id, b.id);
+});
