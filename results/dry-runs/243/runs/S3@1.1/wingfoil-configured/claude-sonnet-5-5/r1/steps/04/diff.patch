+
+test('a rental under a day on the hour costs the hourly price per hour, without discount', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2550, hourlyPrice: 700 });
+  const q = s.quote(req('2026-06-01T13:00:00Z', '2026-06-01T17:00:00Z', 'h'));
+  assert.strictEqual(q.total, 2800);
+  assert.strictEqual(s.book(req('2026-06-01T13:00:00Z', '2026-06-01T17:00:00Z', 'h')).total, 2800);
+  assert.strictEqual(s.quote(req('2026-06-01T22:00:00Z', '2026-06-02T09:00:00Z', 'h')).total, 7700);
+  assert.strictEqual(s.quote(req('2026-06-01T10:00:00Z', '2026-06-01T11:00:00Z', 'h')).total, 700);
+  assert.strictEqual(s.quote(req('2026-06-01T10:00:00Z', '2026-06-02T09:00:00Z', 'h')).total, 16100);
+});
+
+test('hourly rentals need an hourly price, whole hours, and stay under a day', () => {
+  const s = setup();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2550, hourlyPrice: 700 });
+  for (const f of [s.quote.bind(s), s.book.bind(s)]) {
+    assert.throws(() => f(req('2026-06-01T13:00:00Z', '2026-06-01T17:00:00Z', 'b1')));
+    assert.throws(() => f(req('2026-06-01T13:30:00Z', '2026-06-01T17:00:00Z', 'h')));
+    assert.throws(() => f(req('2026-06-01T13:00:00Z', '2026-06-01T17:00:30Z', 'h')));
+    assert.throws(() => f(req('2026-06-01T13:00:00Z', '2026-06-02T13:00:00Z', 'h')));
+    assert.throws(() => f(req('2026-06-01T13:00:00Z', '2026-06-01T13:00:00Z', 'h')));
+  }
+  assert.throws(() => s.addEquipment({ id: 'bad', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: 'bad', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+});
+
+test('hourly bookings block overlapping periods only', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h', kind: 'board', dailyPrice: 2550, hourlyPrice: 700 });
+  s.book(req('2026-06-01T13:00:00Z', '2026-06-01T15:00:00Z', 'h'));
+  assert.throws(() => s.book(req('2026-06-01T14:00:00Z', '2026-06-01T16:00:00Z', 'h')));
+  assert.throws(() => s.book(req('2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z', 'h')));
+  s.book(req('2026-06-01T15:00:00Z', '2026-06-01T16:00:00Z', 'h'));
+  assert.deepStrictEqual(s.availability({ start: '2026-06-01T14:00:00Z', end: '2026-06-01T15:00:00Z' }), []);
+  assert.deepStrictEqual(s.availability({ start: '2026-06-01T16:00:00Z', end: '2026-06-01T17:00:00Z' }), ['h']);
+});
