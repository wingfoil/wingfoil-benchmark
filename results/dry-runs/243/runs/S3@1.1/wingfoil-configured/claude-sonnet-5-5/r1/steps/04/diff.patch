-function parsePeriod(request: RentalRequest): { start: number; end: number; days: number } {
+type Period = { start: number; end: number } & ({ days: number; hours?: undefined } | { hours: number; days?: undefined });
+
+function parsePeriod(request: RentalRequest): Period {
   const start = parseInstant(request?.start, 'start');
   const end = parseInstant(request?.end, 'end');
+  if (end <= start) throw new Error('end must be after start');
+  if (end - start < DAY_MS) {
+    if (start % HOUR_MS !== 0) throw new Error('start must be on the hour');
+    if (end % HOUR_MS !== 0) throw new Error('end must be on the hour');
+    return { start, end, hours: (end - start) / HOUR_MS };
+  }
   if (start % DAY_MS !== 0) throw new Error('start must be midnight UTC');
   if (end % DAY_MS !== 0) throw new Error('end must be midnight UTC');
-  if (end <= start) throw new Error('end must be after start');
   return { start, end, days: (end - start) / DAY_MS };
 }
 
