+
+test('cancel refunds the total before the start, nothing once started, and frees the equipment', () => {
+  const s = setup();
+  const a = s.book(req('2026-06-02T00:00:00Z', '2026-06-04T00:00:00Z'));
+  assert.deepStrictEqual(s.cancel(a.id, '2026-06-01T23:59:59Z'), { bookingId: a.id, refund: 5100 });
+  assert.deepStrictEqual(s.availability({ start: '2026-06-02T00:00:00Z', end: '2026-06-04T00:00:00Z' }), ['b1']);
+  const b = s.book(req('2026-06-02T00:00:00Z', '2026-06-04T00:00:00Z'));
+  assert.notStrictEqual(b.id, a.id);
+  assert.deepStrictEqual(s.cancel(b.id, '2026-06-02T00:00:00Z'), { bookingId: b.id, refund: 0 });
+  const c = s.book(req('2026-06-05T00:00:00Z', '2026-06-06T00:00:00Z'));
+  assert.deepStrictEqual(s.cancel(c.id, '2026-06-05T12:00:00Z'), { bookingId: c.id, refund: 0 });
+});
+
+test('cancel rejects a second cancellation, unknown ids, finished bookings and bad instants', () => {
+  const s = setup();
+  const a = s.book(req('2026-06-02T00:00:00Z', '2026-06-03T00:00:00Z'));
+  assert.throws(() => s.cancel('nope', '2026-06-01T00:00:00Z'));
+  assert.throws(() => s.cancel(a.id, 'yesterday'));
+  assert.throws(() => s.cancel(a.id, '2026-06-03T00:00:00Z'));
+  s.cancel(a.id, '2026-06-01T00:00:00Z');
+  assert.throws(() => s.cancel(a.id, '2026-06-01T00:00:00Z'));
+});
