+    cancel(bookingId, at) {
+      const atMs = parseInstant(at, 'at');
+      const index = bookings.findIndex((b) => b.id === bookingId);
+      if (index < 0) throw new Error(`unknown booking or already cancelled: ${String(bookingId)}`);
+      const booking = bookings[index];
+      if (atMs >= booking.endMs) throw new Error(`booking ${bookingId} is over and cannot be cancelled`);
+      bookings.splice(index, 1);
+      return { bookingId, refund: atMs < booking.startMs ? booking.total : 0 };
