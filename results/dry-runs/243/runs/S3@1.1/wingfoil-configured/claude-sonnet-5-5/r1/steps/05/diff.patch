@@ -103,3 +103,25 @@ test('hourly bookings block overlapping periods only', () => {
   assert.deepStrictEqual(s.availability({ start: '2026-06-01T14:00:00Z', end: '2026-06-01T15:00:00Z' }), []);
   assert.deepStrictEqual(s.availability({ start: '2026-06-01T16:00:00Z', end: '2026-06-01T17:00:00Z' }), ['h']);
