+describe('input validation', () => {
+  const invalid = (result: { ok: boolean; error?: { code: string } }) => {
+    assert.equal(result.ok, false);
+    assert.equal(result.error?.code, 'invalid-input');
+  };
+
+  it('rejects bad titles, priorities and tags without changing the list', () => {
+    const list = createTodoList();
+    list.add({ title: 'a' });
+    invalid(list.add({ title: '   ' }));
+    invalid(list.add({ title: 'x'.repeat(121) }));
+    assert.equal(list.add({ title: 'x'.repeat(120) }).ok, true);
+    invalid(list.add({ title: 'b', priority: 'urgent' as never }));
+    invalid(list.add({ title: 'c', tags: ['ok', 'not ok'] }));
+    invalid(list.add({ title: 'd', tags: [''] }));
+    invalid(list.rename('a', ' '));
+    invalid(list.rename('a', 'x'.repeat(121)));
+    invalid(list.tag('a', ''));
+    invalid(list.tag('a', 'two words'));
+    assert.deepEqual(
+      list.list().map((task) => [task.title.length, task.tags]),
+      [[1, []], [120, []]],
+    );
+  });
+});
