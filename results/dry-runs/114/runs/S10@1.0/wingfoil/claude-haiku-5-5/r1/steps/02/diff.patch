+
+describe('monthly export', () => {
+  const HEADER = 'order,date,customer,total';
+
+  it('lists the orders placed in the month, by number, under a header', () => {
+    const shop = stocked();
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'APL-1KG', quantity: 1 }] }));
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-31', lines: [{ sku: 'HAM-W', quantity: 1 }] }));
+    assert.equal(
+      shop.orders.exportMonth('2026-10'),
+      [
+        HEADER,
+        '1,2026-10-02,Mira Holt,17.80',
+        '3,2026-10-31,Mira Holt,64.00',
+        '',
+      ].join('\n'),
+    );
+  });
+
+  it('gives the header alone for a month with no orders', () => {
+    const shop = stocked();
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    assert.equal(shop.orders.exportMonth('2026-11'), `${HEADER}\n`);
+  });
+
+  it('quotes a value that contains a comma or a quote', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, "Mimi" Mira', email: 'mimi@example.org', phone: '' }));
+    valueOf(shop.orders.place({ customerId: 'c2', date: '2026-10-04', lines: [{ sku: 'OIL-1L', quantity: 1 }] }));
+    assert.equal(
+      shop.orders.exportMonth('2026-10'),
+      `${HEADER}\n1,2026-10-04,"Holt, ""Mimi"" Mira",17.80\n`,
+    );
+  });
+
+  it('gives the total the customer pays, after a discount and with shipping', () => {
+    const shop = stocked();
+    const number = valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-05', lines: [{ sku: 'OIL-1L', quantity: 1 }] })).number;
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.equal(shop.orders.exportMonth('2026-10'), `${HEADER}\n1,2026-10-05,Mira Holt,16.51\n`);
+  });
+
+  it('refuses a month that is not YYYY-MM', () => {
+    const shop = stocked();
+    for (const month of ['2026-13', '2026-00', '26-10', '2026-1', '2026-10-01', '']) {
+      assert.throws(() => shop.orders.exportMonth(month), RangeError, month);
+    }
+  });
+});
