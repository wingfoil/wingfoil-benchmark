+
+function errorOf<T>(result: { ok: true; value: T } | { ok: false; error: { message: string } }): string {
+  if (result.ok) assert.fail('expected the operation to be refused');
+  return result.error.message;
+}
+
+function withOrder(shop: ReturnType<typeof stocked>, lines: { sku: string; quantity: number }[]): number {
+  return valueOf(shop.orders.place({ customerId: 'c1', date: '2026-03-02', lines })).number;
+}
+
+describe('discount codes', () => {
+  it('takes 10 % off the items with SPRING10 and charges shipping on the discounted items', () => {
+    const shop = stocked();
+    const number = withOrder(shop, [{ sku: 'OIL-1L', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 1290, discountCents: 129, shippingCents: 490, totalCents: 1651 });
+  });
+
+  it('rounds the SPRING10 discount half a cent up', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'JAM-1', name: 'Jam', priceCents: 105 }));
+    const number = withOrder(shop, [{ sku: 'JAM-1', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 11);
+  });
+
+  it('decides free shipping before the discount: a discounted order still ships free', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'PAR-5', name: 'Party pack', priceCents: 5100 }));
+    const number = withOrder(shop, [{ sku: 'PAR-5', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 5100, discountCents: 510, shippingCents: 0, totalCents: 4590 });
+  });
+
+  it('takes 5.00 € off with WELCOME5 on items of exactly 30.00 €', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'GFT-30', name: 'Gift box', priceCents: 3000 }));
+    const number = withOrder(shop, [{ sku: 'GFT-30', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(number, 'WELCOME5'));
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 3000, discountCents: 500, shippingCents: 490, totalCents: 2990 });
+  });
+
+  it('refuses WELCOME5 on items under 30.00 € and leaves the order as it was', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'GFT-29', name: 'Small gift', priceCents: 2999 }));
+    const number = withOrder(shop, [{ sku: 'GFT-29', quantity: 1 }]);
+    assert.match(errorOf(shop.orders.applyCode(number, 'WELCOME5')), /30\.00/);
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 0);
+  });
+
+  it('refuses an unknown code and leaves the order as it was', () => {
+    const shop = stocked();
+    const number = withOrder(shop, [{ sku: 'OIL-1L', quantity: 1 }]);
+    assert.match(errorOf(shop.orders.applyCode(number, 'SUMMER20')), /SUMMER20/);
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 0);
+  });
+
+  it('refuses a code that only names an object property', () => {
+    const shop = stocked();
+    const number = withOrder(shop, [{ sku: 'OIL-1L', quantity: 1 }]);
+    assert.equal(shop.orders.applyCode(number, 'constructor').ok, false);
+  });
+
+  it('replaces the code on an order when a second one is applied', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'GFT-30', name: 'Gift box', priceCents: 3000 }));
+    const number = withOrder(shop, [{ sku: 'GFT-30', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    valueOf(shop.orders.applyCode(number, 'WELCOME5'));
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 500);
+  });
+
+  it('keeps the previous code when a second code is refused', () => {
+    const shop = stocked();
+    const number = withOrder(shop, [{ sku: 'OIL-1L', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    shop.orders.applyCode(number, 'WELCOME5');
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 129);
+  });
+
+  it('accepts a code written in another case, with spaces around it', () => {
+    const shop = stocked();
+    const number = withOrder(shop, [{ sku: 'OIL-1L', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(number, ' spring10 '));
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 129);
+  });
+
+  it('refuses a code on an order that does not exist', () => {
+    const shop = stocked();
+    assert.equal(shop.orders.applyCode(7, 'SPRING10').ok, false);
+  });
+});
