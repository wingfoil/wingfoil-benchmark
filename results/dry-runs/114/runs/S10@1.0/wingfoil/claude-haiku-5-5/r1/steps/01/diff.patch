@@ -0,0 +1,38 @@
+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** The discount of `WELCOME5`, in cents. */
+export const WELCOME_DISCOUNT_CENTS: Cents = 500;
+
+/** `WELCOME5` applies only to items that come to this amount or more. */
+export const WELCOME_MINIMUM_ITEMS_CENTS: Cents = 3000;
+
+/** The discount a code gives on an order's items: the amount, or why the code is refused for these items. */
+type Discount = (itemsCents: Cents) => Result<Cents>;
+
+/** The codes the shop accepts, by their upper-case form. A map, so that no name in the prototype is a code. */
+const CODES = new Map<string, Discount>([
+  // 10 % of the items, rounded to the nearest cent with a half cent going up: (items * 10 + 50) / 100, floored.
+  ['SPRING10', (itemsCents) => ok(Math.floor((itemsCents * 10 + 50) / 100))],
+  [
+    'WELCOME5',
+    (itemsCents) =>
+      itemsCents >= WELCOME_MINIMUM_ITEMS_CENTS
+        ? ok(WELCOME_DISCOUNT_CENTS)
+        : err('invalid', `WELCOME5 needs items of 30.00 € or more; these items come to ${formatEuros(itemsCents)} €`),
+  ],
+]);
+
+/**
+ * The discount a code gives on an order's items. Codes are matched without regard to case or surrounding spaces.
+ *
+ * @param code - the code the customer gave
+ * @param itemsCents - the order's items, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  const discount = CODES.get(code.trim().toUpperCase());
+  if (discount === undefined) return err('invalid', `${code.trim()} is not a discount code we accept`);
+  return discount(itemsCents);
+}
