 export function createTodoList(now: () => string = () => new Date().toISOString()): TaskList {
   return createTaskList(now);
 }
+
+/**
+ * Imports tasks from semicolon-delimited text into a list. Blank lines are skipped; each other line
+ * must contain a title, priority, and space-separated tags as `title;priority;tags`.
+ *
+ * @param list - the task list that receives every valid task
+ * @param text - one semicolon-delimited task per line
+ */
+export function importTasks(list: TaskList, text: string): ImportTasksResult {
+  const rejected: RejectedImport[] = [];
+  let imported = 0;
+
+  for (const [index, source] of text.split(/\r?\n/).entries()) {
+    if (source.trim().length === 0) continue;
+
+    const fields = source.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'expected title;priority;tags' });
+      continue;
+    }
+
+    const [title, rawPriority, rawTags] = fields;
+    const priority = rawPriority.trim();
+    const tags = rawTags.trim() === '' ? [] : rawTags.trim().split(/\s+/);
+    const input: NewTask = {
+      title,
+      priority: priority === '' ? undefined : priority as Priority,
+      tags,
+    };
+    const added = list.add(input);
+    if (added.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line: index + 1, reason: added.error.message });
+    }
+  }
+
+  return { imported, rejected };
+}
