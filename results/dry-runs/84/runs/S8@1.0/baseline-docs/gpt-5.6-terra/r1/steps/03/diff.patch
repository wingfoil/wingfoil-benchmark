@@ -31,6 +31,47 @@ export interface NewTask {
   readonly tags?: readonly string[];
 }
 
+/**
+ * Checks whether a task's externally supplied details can be stored.
+ *
+ * @param input - the task details to validate
+ */
+export function validateNewTask(input: NewTask): Result<void> {
+  const title = validateTitle(input.title);
+  if (!title.ok) return title;
+  if (input.priority !== undefined && !PRIORITIES.includes(input.priority)) {
+    return err('invalid-input', 'priority must be low, normal, or high');
+  }
+  for (const tag of input.tags ?? []) {
+    const validTag = validateTag(tag);
+    if (!validTag.ok) return validTag;
+  }
+  return ok(undefined);
+}
+
+/**
+ * Checks whether an externally supplied task title can be stored.
+ *
+ * @param title - the title to validate
+ */
+export function validateTitle(title: string): Result<void> {
+  const trimmed = title.trim();
+  if (trimmed.length === 0) return err('invalid-input', 'title must not be empty');
+  if (trimmed.length > 120) return err('invalid-input', 'title must be at most 120 characters');
+  return ok(undefined);
+}
+
+/**
+ * Checks whether an externally supplied task tag can be stored.
+ *
+ * @param tag - the tag to validate
+ */
+export function validateTag(tag: string): Result<void> {
+  if (tag.length === 0) return err('invalid-input', 'tag must not be empty');
+  if (tag.includes(' ')) return err('invalid-input', 'tag must not contain a space');
+  return ok(undefined);
+}
