 describe('task list', () => {
+  it('records creation and each effective change time', () => {
+    const times = [
+      '2026-10-26T09:00:00.000Z',
+      '2026-10-26T09:01:00.000Z',
+      '2026-10-26T09:02:00.000Z',
+      '2026-10-26T09:03:00.000Z',
+      '2026-10-26T09:04:00.000Z',
+      '2026-10-26T09:05:00.000Z',
+    ];
+    const list = createTodoList(() => times.shift()!);
+
+    const added = valueOf(list.add({ title: 'Prepare report' }));
