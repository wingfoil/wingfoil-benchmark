+    assert.equal(valueOf(list.rename(added.id, 'Send report')).updatedAt, '2026-10-26T09:03:00.000Z');
+    assert.equal(valueOf(list.tag(added.id, 'work')).updatedAt, '2026-10-26T09:04:00.000Z');
+    assert.equal(valueOf(list.untag(added.id, 'work')).updatedAt, '2026-10-26T09:05:00.000Z');
+  });
