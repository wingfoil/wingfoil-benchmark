+
+/** A line of a bulk import that could not be added, with why. */
+export interface ImportRejection {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of a bulk import: how many tasks were added, and every line that was not. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
+/**
+ * Bulk-adds tasks to `list` from `text`, one task per line, formatted as `title;priority;tags`: the
+ * priority may be left empty for a normal one, and tags are separated by spaces. Blank lines are
+ * skipped. A line that is not added - because it is malformed, or its title, priority or a tag is not
+ * usable, or it duplicates a task already in `list` - is reported in `rejected` instead, with `line`
+ * counting from 1.
+ *
+ * @param list - the task list to add to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: ImportRejection[] = [];
+
+  text.split('\n').forEach((rawLine, index) => {
+    const line = rawLine.replace(/\r$/, '');
+    if (line.trim().length === 0) return;
+    const lineNumber = index + 1;
+
+    const parts = line.split(';');
+    if (parts.length !== 3) {
+      rejected.push({ line: lineNumber, reason: `expected "title;priority;tags", got "${line}"` });
+      return;
+    }
+
+    const [title, rawPriority, rawTags] = parts;
+    const priority = rawPriority.trim();
+    const tags = rawTags.trim().length === 0 ? [] : rawTags.trim().split(/\s+/);
+
+    const result = list.add({
+      title,
+      ...(priority.length > 0 ? { priority: priority as Priority } : {}),
+      tags,
+    });
+    if (result.ok) {
+      imported += 1;
+    } else {
+      rejected.push({ line: lineNumber, reason: result.error.message });
+    }
+  });
+
+  return { imported, rejected };
+}
diff --git a/test/import.test.ts b/test/import.test.ts
