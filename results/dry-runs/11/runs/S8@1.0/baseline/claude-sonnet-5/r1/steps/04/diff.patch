+++ b/test/import.test.ts
@@ -0,0 +1,80 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('imports a well-formed line, with a priority and tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Renew the insurance;high;admin money');
+    assert.deepEqual(result, { imported: 1, rejected: [] });
+    const [task] = list.list();
+    assert.equal(task.title, 'Renew the insurance');
+    assert.equal(task.priority, 'high');
+    assert.deepEqual(task.tags, ['admin', 'money']);
+  });
+
+  it('defaults to a normal priority when it is left empty', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;');
+    assert.deepEqual(result, { imported: 1, rejected: [] });
+    assert.equal(list.list()[0].priority, 'normal');
+  });
+
+  it('imports a line with no tags', () => {
+    const list = createTodoList();
+    importTasks(list, 'Buy milk;low;');
+    assert.deepEqual(list.list()[0].tags, []);
+  });
+
+  it('skips blank lines without counting them', () => {
+    const list = createTodoList();
+    const result = importTasks(list, '\nBuy milk;;\n   \n\nWater the plants;;\n');
+    assert.deepEqual(result, { imported: 2, rejected: [] });
+  });
+
+  it('imports several tasks, counting lines from 1', () => {
+    const list = createTodoList();
+    const text = ['Buy milk;;', 'Water the plants;low;garden', 'Renew the insurance;high;admin money'].join(
+      '\n',
+    );
+    const result = importTasks(list, text);
+    assert.deepEqual(result, { imported: 3, rejected: [] });
+    assert.equal(list.openCount(), 3);
+  });
+
+  it('rejects a line with the wrong number of fields, reporting its line number', () => {
+    const list = createTodoList();
+    const result = importTasks(list, 'Buy milk;;\ntoo;many;fields;here\nWater the plants;;');
+    assert.equal(result.imported, 2);
+    assert.equal(result.rejected.length, 1);
+    assert.equal(result.rejected[0].line, 2);
+  });
+
+  it('rejects a line with an unusable title or priority', () => {
+    const list = createTodoList();
+    const result = importTasks(list, [';;', 'Buy milk;urgent;', `${'x'.repeat(121)};;`].join('\n'));
+    assert.equal(result.imported, 0);
+    assert.deepEqual(
+      result.rejected.map((r) => r.line),
+      [1, 2, 3],
+    );
+  });
+
+  it('rejects a duplicate title, whether against the list or another imported line', () => {
+    const list = createTodoList();
+    list.add({ title: 'Buy milk' });
+    const result = importTasks(list, 'Buy milk;;\nWater the plants;;\nWater the plants;;');
+    assert.equal(result.imported, 1);
+    assert.deepEqual(
+      result.rejected.map((r) => r.line),
+      [1, 3],
+    );
+  });
+
+  it('returns no imports and no rejections for empty or all-blank text', () => {
+    const list = createTodoList();
+    assert.deepEqual(importTasks(list, ''), { imported: 0, rejected: [] });
+    assert.deepEqual(importTasks(list, '\n\n   \n'), { imported: 0, rejected: [] });
+  });
+});
