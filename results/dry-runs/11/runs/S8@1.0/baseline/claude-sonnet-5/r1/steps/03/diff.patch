+/**
+ * `title`, trimmed, if it is usable: not empty (nor only spaces) and not longer than 120 characters.
+ *
+ * @param title - the title to check
+ */
+export function validateTitle(title: string): Result<string> {
+  const trimmed = title.trim();
+  if (trimmed.length === 0) return err('invalid-input', 'a title cannot be empty');
+  if (trimmed.length > MAX_TITLE_LENGTH) {
+    return err('invalid-input', `a title cannot be longer than ${MAX_TITLE_LENGTH} characters`);
+  }
+  return ok(trimmed);
+}
+
+/**
+ * `priority`, if it is one of `low`, `normal` or `high`.
+ *
+ * @param priority - the priority to check
+ */
+export function validatePriority(priority: string): Result<Priority> {
+  if (!PRIORITIES.includes(priority as Priority)) {
+    return err('invalid-input', `"${priority}" is not a priority; use low, normal or high`);
+  }
+  return ok(priority as Priority);
+}
