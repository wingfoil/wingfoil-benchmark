   s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
   assert.deepEqual(s.availability({ start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' }), ['h1']);
 });
+
+test('cancel refunds before the start, frees the equipment, and works only once', () => {
+  const s = setup();
+  const b = s.book(r('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.deepEqual(s.cancel(b.id, '2026-06-30T12:00:00Z'), { bookingId: b.id, refund: 5000 });
+  assert.deepEqual(s.availability({ start: b.start, end: b.end }), ['b1']);
+  assert.throws(() => s.cancel(b.id, '2026-06-30T12:00:00Z'), /already cancelled/);
+  assert.doesNotThrow(() => s.book(r('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z')));
+});
+
+test('cancel after the start refunds nothing; rejects unknown booking and bad time', () => {
+  const s = setup();
+  const b = s.book(r('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.throws(() => s.cancel('nope', '2026-06-30T00:00:00Z'), /Unknown booking/);
+  assert.throws(() => s.cancel(b.id, 'yesterday'));
+  assert.equal(s.cancel(b.id, '2026-07-02T00:00:00Z').refund, 0);
+});
