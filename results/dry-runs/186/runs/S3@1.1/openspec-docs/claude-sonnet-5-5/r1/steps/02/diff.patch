@@ -29,3 +29,15 @@ test('book rejects overlaps but allows adjacent periods', () => {
   const b = s.book(r('2026-07-03T00:00:00Z', '2026-07-04T00:00:00Z'));
   assert.notEqual(a.id, b.id);
 });
+
+test('availability lists free items of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a1', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'b0', kind: 'board', dailyPrice: 2000 });
+  s.book(r('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  const q = { start: '2026-07-02T00:00:00Z', end: '2026-07-04T00:00:00Z' };
+  assert.deepEqual(s.availability(q), ['a1', 'b0']);
+  assert.deepEqual(s.availability({ ...q, kind: 'board' }), ['b0']);
+  assert.deepEqual(s.availability({ start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z', kind: 'board' }), ['b0', 'b1']);
+  assert.throws(() => s.availability({ start: q.end, end: q.start }));
+});
