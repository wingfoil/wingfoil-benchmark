+}
+
+export interface AvailabilityQuery {
+  /** ISO-8601 UTC, midnight. */
+  start: string;
+  /** ISO-8601 UTC, midnight; the start of the day after the last day. */
+  end: string;
+  kind?: EquipmentKind;
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
@@ -93,5 +103,23 @@ export function createRentalService(): RentalService {
       bookings.push({ ...booking, startMs, endMs });
       return booking;
     },
+
+    availability(query) {
+      const startMs = parseMidnightUtc(query?.start, 'start');
+      const endMs = parseMidnightUtc(query?.end, 'end');
+      if (endMs <= startMs) throw new Error('end must be after start');
+      const { kind } = query;
+      if (kind !== undefined && kind !== 'board' && kind !== 'sail') {
+        throw new Error("kind must be 'board' or 'sail'");
+      }
+      return [...equipment.values()]
+        .filter((item) => kind === undefined || item.kind === kind)
+        .filter(
+          (item) =>
+            !bookings.some((b) => b.itemId === item.id && startMs < b.endMs && b.startMs < endMs),
+        )
+        .map((item) => item.id)
+        .sort();
+    },
   };
 }
