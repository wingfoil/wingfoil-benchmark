+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  return s;
+}
+const r = (start: string, end: string) => ({ itemId: 'b1', start, end });
+
+test('quote multiplies days by daily price', () => {
+  const q = setup().quote(r('2026-07-01T00:00:00Z', '2026-07-04T00:00:00Z'));
+  assert.equal(q.total, 7500);
+});
+
+test('rejects unknown item and non-whole-day periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'x', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.throws(() => s.quote(r('2026-07-01T10:00:00Z', '2026-07-02T00:00:00Z')));
+  assert.throws(() => s.quote(r('2026-07-01T00:00:00+02:00', '2026-07-02T00:00:00Z')));
+  assert.throws(() => s.quote(r('2026-07-02T00:00:00Z', '2026-07-02T00:00:00Z')));
+});
+
+test('book rejects overlaps but allows adjacent periods', () => {
+  const s = setup();
+  const a = s.book(r('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.throws(() => s.book(r('2026-07-02T00:00:00Z', '2026-07-04T00:00:00Z')));
+  const b = s.book(r('2026-07-03T00:00:00Z', '2026-07-04T00:00:00Z'));
+  assert.notEqual(a.id, b.id);
+});
