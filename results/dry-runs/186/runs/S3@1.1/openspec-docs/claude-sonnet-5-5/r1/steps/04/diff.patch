@@ -48,3 +48,24 @@ test('availability lists free items of a kind, sorted', () => {
   assert.deepEqual(s.availability({ start: '2026-07-03T00:00:00Z', end: '2026-07-04T00:00:00Z', kind: 'board' }), ['b0', 'b1']);
   assert.throws(() => s.availability({ start: q.end, end: q.start }));
 });
+
+test('rentals shorter than a day are priced per hour, without long-stay discount', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  const req = { itemId: 'h1', start: '2026-07-01T10:00:00Z', end: '2026-07-01T14:00:00Z' };
+  assert.equal(s.quote(req).total, 2400);
+  assert.equal(s.book(req).total, 2400);
+  assert.throws(() => s.book({ ...req, start: '2026-07-01T13:00:00Z' }));
+  assert.throws(() => s.quote({ ...req, end: '2026-07-01T14:30:00Z' }));
+  // a day or more still needs midnights
+  assert.throws(() => s.quote({ ...req, end: '2026-07-02T10:00:00Z' }));
+  assert.equal(s.quote({ ...req, start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }).total, 2500);
+});
+
+test('items without hourly price cannot be rented by the hour', () => {
+  const s = setup();
+  assert.throws(() => s.quote(r('2026-07-01T10:00:00Z', '2026-07-01T12:00:00Z')));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  assert.deepEqual(s.availability({ start: '2026-07-01T10:00:00Z', end: '2026-07-01T12:00:00Z' }), ['h1']);
+});
