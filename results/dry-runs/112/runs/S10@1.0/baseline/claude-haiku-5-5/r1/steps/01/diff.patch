@@ -0,0 +1,36 @@
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** Items must come to this amount or more for WELCOME5 to apply. */
+export const WELCOME5_FROM_CENTS: Cents = 3000;
+
+/** The fixed amount WELCOME5 takes off. */
+export const WELCOME5_OFF_CENTS: Cents = 500;
+
+/**
+ * A code as the shop writes it: without surrounding spaces, in capitals, so `spring10 ` is `SPRING10`.
+ *
+ * @param code - the code the customer gave
+ */
+export function normaliseCode(code: string): string {
+  return code.trim().toUpperCase();
+}
+
+/**
+ * The discount a code gives on an order's items.
+ *
+ * @param code - the code the customer gave
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  const name = normaliseCode(code);
+  if (name === 'SPRING10') return ok(Math.floor((itemsCents * 10 + 50) / 100));
+  if (name === 'WELCOME5') {
+    if (itemsCents < WELCOME5_FROM_CENTS) {
+      return err('invalid', 'WELCOME5 needs items that come to 30.00 € or more');
+    }
+    return ok(WELCOME5_OFF_CENTS);
+  }
+  return err('invalid', `${code.trim()} is not a discount code`);
+}
