+import type { Cents } from './money.ts';
+import { formatEuros } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** `WELCOME5` only applies to orders whose items come to this amount or more. */
+export const WELCOME5_MINIMUM_CENTS: Cents = 3000;
+
+const WELCOME5_CENTS: Cents = 500;
+
+/**
+ * The canonical form of a discount code if the shop knows it, checked against an order's items.
+ *
+ * @param code - the code as the customer typed it
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function checkCode(code: string, itemsCents: Cents): Result<string> {
+  const known = code.trim().toUpperCase();
+  if (known === 'SPRING10') return ok(known);
+  if (known === 'WELCOME5') {
+    if (itemsCents < WELCOME5_MINIMUM_CENTS) {
+      return err('invalid', `WELCOME5 needs items of ${formatEuros(WELCOME5_MINIMUM_CENTS)} € or more`);
+    }
+    return ok(known);
+  }
+  return err('invalid', `${code} is not a discount code we know`);
+}
+
+/**
+ * What a code takes off an order's items.
+ *
+ * @param code - a canonical code from `checkCode`, if any
+ * @param itemsCents - what the order's items come to
+ */
+export function discountFor(code: string | undefined, itemsCents: Cents): Cents {
+  if (code === 'SPRING10') return Math.floor((itemsCents + 5) / 10);
+  if (code === 'WELCOME5') return Math.min(WELCOME5_CENTS, itemsCents);
+  return 0;
+}
