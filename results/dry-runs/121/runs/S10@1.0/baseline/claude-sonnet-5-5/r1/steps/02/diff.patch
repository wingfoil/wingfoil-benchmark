+  /**
+   * CSV text of the orders placed in a month (`YYYY-MM`), by number: a header line, then one line per
+   * order with `order,date,customer,email,phone,total`. A month without orders gives the header alone.
+   * Throws a `RangeError` if the month is not `YYYY-MM`.
+   */
+  exportMonth(month: string): string;
+}
+
+const MONTH = /^\d{4}-(0[1-9]|1[0-2])$/;
+
+function csvField(value: string): string {
+  return /[",\r\n]/.test(value) ? `"${value.replaceAll('"', '""')}"` : value;
 }
 
 const DATE = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
@@ -123,5 +136,17 @@ export function createOrderBook(catalogue: Catalogue, customers: Customers): Ord
       codes.set(orderNumber, checked.value);
       return ok(totalsOf(order));
     },
+    exportMonth(month) {
+      if (!MONTH.test(month)) throw new RangeError(`${month} is not a month (YYYY-MM)`);
+      const lines = ['order,date,customer,email,phone,total'];
+      for (const order of orders) {
+        if (!order.date.startsWith(`${month}-`)) continue;
+        const customer = customers.get(order.customerId);
+        const { name, email, phone } = customer.ok ? customer.value : { name: '', email: '', phone: '' };
+        const fields = [String(order.number), order.date, name, email, phone, formatEuros(totalsOf(order).totalCents)];
+        lines.push(fields.map(csvField).join(','));
+      }
+      return lines.map((line) => `${line}\n`).join('');
+    },
   };
 }
