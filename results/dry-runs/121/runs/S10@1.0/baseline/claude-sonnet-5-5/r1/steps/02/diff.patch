+  it('lists the month\'s orders as CSV with totals', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, "Al"', email: 'al@example.org', phone: '555-0102' }));
+    shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'APL-1KG', quantity: 1 }] });
