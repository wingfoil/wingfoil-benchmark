@@ -224,3 +224,70 @@ test('rejects non-JSON values instead of silently coercing them', () => {
     assert.throws(() => applyPatch({}, [{ op: 'add', path: '/a', value }]));
   }
 });
+
+test('requires every operation and extension member to be JSON', () => {
+  const cycle = {}; cycle.self = cycle;
+  for (const extra of [undefined, NaN, Infinity, -Infinity, 1n, () => {}, Symbol(),
+    new Date(), new Map(), new Set(), cycle, [undefined], new Array(1)]) {
+    for (const operation of [
+      { op: 'add', path: '/a', value: 1, extra },
+      { op: 'remove', path: '/a', value: extra },
+      { op: 'test', path: '/a', value: 1, from: extra },
+    ]) {
+      assert.throws(() => applyPatch({ a: 1 }, [operation]));
+    }
+  }
+  class Operation {
+    op = 'add'; path = '/a'; value = 1;
+  }
+  for (const operation of [new Operation(), Object.assign(new Date(), {
+    op: 'add', path: '/a', value: 1,
+  })]) {
+    assert.throws(() => applyPatch({}, [operation]));
+  }
+  const operation = Object.assign(Object.create(null), {
+    op: 'add', path: '/a', value: null, extra: { arbitrary: ['JSON'] },
+  });
+  assert.deepEqual(applyPatch({}, [operation]), { a: null });
+});
+
+test('evaluates array entries rather than custom iterators or inherited entries', () => {
+  const patch = [{ op: 'add', path: '/a', value: 1 }];
+  patch[Symbol.iterator] = function* () {
+    yield { op: 'add', path: '/unexpected', value: true };
+  };
+  assert.deepEqual(applyPatch({}, patch), { a: 1 });
+
+  const sparse = new Array(1);
+  const prototype = Object.create(Array.prototype);
+  prototype[0] = { op: 'add', path: '/a', value: 1 };
+  Object.setPrototypeOf(sparse, prototype);
+  assert.throws(() => applyPatch({}, sparse));
+});
+
+test('stops on the first error and leaves both inputs unchanged', () => {
+  const failures = [
+    { op: 'test', path: '/items', value: [] },
+    { op: 'remove', path: '/missing' },
+    // The removal succeeds internally before the destination fails.
+    { op: 'move', from: '/items/0', path: '/missing/child' },
+    { op: 'unknown', path: '' },
+    { op: 'add', path: '/a', value: undefined },
+  ];
+  for (const failure of failures) {
+    const document = { items: [{ nested: 1 }, 2] };
+    const patch = [
+      { op: 'replace', path: '/items/0/nested', value: 9 }, failure,
+    ];
+    const before = structuredClone(patch);
+    Object.defineProperty(patch, '2', {
+      get() { assert.fail('evaluated an operation after an error'); },
+    });
+    assert.throws(() => applyPatch(document, patch), error => {
+      assert.doesNotMatch(error.message, /evaluated an operation/);
+      return true;
+    });
+    assert.deepEqual(document, { items: [{ nested: 1 }, 2] });
+    assert.deepEqual(patch.slice(0, 2), before);
+  }
+});
