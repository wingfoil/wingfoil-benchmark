+export type CreatedPatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+/**
+ * Create an RFC 6902 JSON Patch between two JSON values.
+ * Inputs are validated and copied; the patch retains no input references.
+ * Objects are compared by member and arrays are aligned by unchanged elements.
+ */
+export function createPatch(from: unknown, to: unknown): CreatedPatchOperation[] {
+  const source = cloneJson(from);
+  const target = cloneJson(to);
+  const patch: CreatedPatchOperation[] = [];
+  diffJson(source, target, "", patch);
+  return patch;
+}
+
+function memberPath(path: string, key: string): string {
+  return path + "/" + key.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffJson(
+  from: unknown, to: unknown, path: string, patch: CreatedPatchOperation[],
+): void {
+  if (equalJson(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    let startFrom = 0;
+    let startTo = 0;
+    // The sentinel flushes the final changed range. Earlier edits make each
+    // range start at its target index, regardless of its original source index.
+    for (const [endFrom, endTo] of [...arrayMatches(from, to), [from.length, to.length]]) {
+      const shared = Math.min(endFrom - startFrom, endTo - startTo);
+      for (let offset = 0; offset < shared; offset++) {
+        diffJson(from[startFrom + offset], to[startTo + offset],
+          path + "/" + (startTo + offset), patch);
+      }
+      for (let index = endFrom - startFrom - 1; index >= shared; index--) {
+        patch.push({ op: "remove", path: path + "/" + (startTo + index) });
+      }
+      for (let index = startTo + shared; index < endTo; index++) {
+        patch.push({ op: "add", path: path + "/" + index, value: to[index] });
+      }
+      startFrom = endFrom + 1;
+      startTo = endTo + 1;
+    }
+  } else if (from !== null && to !== null &&
+      typeof from === "object" && typeof to === "object" &&
+      !Array.isArray(from) && !Array.isArray(to)) {
+    const source = from as Record<string, unknown>;
+    const target = to as Record<string, unknown>;
+    for (const key of Object.keys(source)) {
+      if (!hasOwn(target, key)) patch.push({ op: "remove", path: memberPath(path, key) });
+    }
+    for (const key of Object.keys(target)) {
+      const childPath = memberPath(path, key);
+      if (hasOwn(source, key)) diffJson(source[key], target[key], childPath, patch);
+      else patch.push({ op: "add", path: childPath, value: target[key] });
+    }
+  } else {
+    patch.push({ op: "replace", path, value: to });
+  }
+}
+
+// Myers' shortest edit search aligns equal array elements without a full
+// length-by-length table. A few edits in a large array need only a few diagonals.
+// Unmatched ranges are then compared recursively, preserving small nested edits.
+function arrayMatches(from: unknown[], to: unknown[]): [number, number][] {
+  const trace: Map<number, number>[] = [];
+  let frontier = new Map<number, number>([[1, 0]]);
+  for (let distance = 0; distance <= from.length + to.length; distance++) {
+    trace.push(frontier);
+    const next = new Map<number, number>();
+    for (let diagonal = -distance; diagonal <= distance; diagonal += 2) {
+      const down = diagonal === -distance || (diagonal !== distance &&
+        (frontier.get(diagonal - 1) ?? -Infinity) <
+        (frontier.get(diagonal + 1) ?? -Infinity));
+      let x = down ? frontier.get(diagonal + 1)! : frontier.get(diagonal - 1)! + 1;
+      let y = x - diagonal;
+      while (x < from.length && y < to.length && equalJson(from[x], to[y])) {
+        x++;
+        y++;
+      }
+      next.set(diagonal, x);
+      if (x >= from.length && y >= to.length) {
+        const matches: [number, number][] = [];
+        for (let step = distance; step >= 0; step--) {
+          const previous = trace[step];
+          const k = x - y;
+          const previousK = k === -step || (k !== step &&
+            (previous.get(k - 1) ?? -Infinity) < (previous.get(k + 1) ?? -Infinity))
+            ? k + 1 : k - 1;
+          const previousX = previous.get(previousK)!;
+          const previousY = previousX - previousK;
+          while (x > previousX && y > previousY) matches.push([--x, --y]);
+          x = previousX;
+          y = previousY;
+        }
+        return matches.reverse();
+      }
+    }
+    frontier = next;
+  }
+  return [];
+}
+
 function readPatchValue(document: unknown, tokens: string[]): unknown {
   if (document === undefined) throw new Error("The document has been removed");
   return resolveTokens(document, tokens);
