+/**
+ * Apply an RFC 7386 JSON Merge Patch without mutating or retaining input values.
+ * Object members merge recursively; null members delete keys. Other patches
+ * replace the entire target. An undefined target represents an absent document.
+ * Throws if either input is not JSON (except an undefined target).
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  const document = target === undefined ? undefined : cloneJson(target);
+  return mergePatch(document, cloneJson(patch));
+}
+
+// Both arguments are private, validated copies, so merging can update them.
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (patch === null || typeof patch !== "object" || Array.isArray(patch)) {
+    return patch;
+  }
+  const result: Record<string, unknown> =
+    target !== null && typeof target === "object" && !Array.isArray(target)
+      ? target as Record<string, unknown>
+      : {};
+  for (const key of Object.keys(patch)) {
+    const value = (patch as Record<string, unknown>)[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, mergePatch(hasOwn(result, key) ? result[key] : undefined, value));
+    }
+  }
+  return result;
+}
