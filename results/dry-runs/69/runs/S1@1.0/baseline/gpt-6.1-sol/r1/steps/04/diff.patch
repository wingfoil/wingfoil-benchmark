diff --git a/test/merge-patch.test.js b/test/merge-patch.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..0e54ac16862dda39395ec4267dca53f48755ab20
--- /dev/null
+++ b/test/merge-patch.test.js
@@ -0,0 +1,95 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { applyMergePatch } from '../src/index.ts';
+
+test('matches RFC 7386 Appendix A', () => {
+  const cases = [
+    [{ a: 'b' }, { a: 'c' }, { a: 'c' }],
+    [{ a: 'b' }, { b: 'c' }, { a: 'b', b: 'c' }],
+    [{ a: 'b' }, { a: null }, {}],
+    [{ a: 'b', b: 'c' }, { a: null }, { b: 'c' }],
+    [{ a: ['b'] }, { a: 'c' }, { a: 'c' }],
+    [{ a: 'c' }, { a: ['b'] }, { a: ['b'] }],
+    [{ a: { b: 'c' } }, { a: { b: 'd', c: null } }, { a: { b: 'd' } }],
+    [{ a: [{ b: 'c' }] }, { a: [1] }, { a: [1] }],
+    [['a', 'b'], ['c', 'd'], ['c', 'd']],
+    [{ a: 'b' }, ['c'], ['c']],
+    [{ a: 'foo' }, null, null],
+    [{ a: 'foo' }, 'bar', 'bar'],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: 'b', c: null }, { a: 'b' }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [target, patch, expected] of cases) {
+    assert.deepEqual(applyMergePatch(target, patch), expected);
+  }
+});
+
+test('handles all root types and absent documents', () => {
+  for (const target of [undefined, null, false, true, 0, 42, '', 'text', [], [1], {}]) {
+    for (const patch of [null, false, true, 0, 42, '', 'text', [], [null, { a: null }]]) {
+      assert.deepEqual(applyMergePatch(target, patch), patch);
+    }
+    assert.deepEqual(applyMergePatch(target, { a: { b: null }, missing: null }), { a: {} });
+  }
+  assert.deepEqual(applyMergePatch({ a: null, b: [1] }, {}), { a: null, b: [1] });
+});
+
+test('preserves untouched members and treats keys literally', () => {
+  assert.deepEqual(applyMergePatch({ a: { keep: 1, remove: 2 }, b: null }, {
+    a: { remove: null, add: false }, 'a/b': { '~': 0 }, '': '',
+  }), { a: { keep: 1, add: false }, b: null, 'a/b': { '~': 0 }, '': '' });
+});
+
+test('does not mutate or retain references to either input', () => {
+  const target = Object.freeze({
+    keep: Object.freeze({ list: Object.freeze([1]) }),
+    update: Object.freeze({ old: true }),
+  });
+  const patch = Object.freeze({
+    update: Object.freeze({ old: null, added: true }),
+    list: Object.freeze([Object.freeze({ value: null })]),
+  });
+  const result = applyMergePatch(target, patch);
+  assert.deepEqual(result, { keep: { list: [1] }, update: { added: true }, list: [{ value: null }] });
+  result.keep.list.push(2);
+  result.list[0].value = 3;
+  assert.deepEqual(target.keep.list, [1]);
+  assert.equal(patch.list[0].value, null);
+  assert.notStrictEqual(applyMergePatch(target, {}).keep, target.keep);
+  const replacement = applyMergePatch(target, patch.list);
+  replacement[0].value = 4;
+  assert.equal(patch.list[0].value, null);
+});
+
+test('handles prototype-related names as own members', () => {
+  const patch = JSON.parse('{"__proto__":{"polluted":true},"constructor":{"prototype":{"polluted":true}},"toString":{"value":1}}');
+  const result = applyMergePatch({}, patch);
+  assert.deepEqual(result, patch);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(Object.hasOwn(result, '__proto__'), true);
+  assert.equal(Object.hasOwn(result.toString, 'value'), true);
+  assert.equal({}.polluted, undefined);
+  const removed = applyMergePatch(result, JSON.parse('{"__proto__":null,"constructor":null,"toString":null}'));
+  assert.deepEqual(removed, {});
+  assert.equal(result.__proto__.polluted, true);
+  const target = Object.assign(Object.create(null), { a: { old: true } });
+  const nullPrototypePatch = Object.assign(Object.create(null), { a: { old: null, new: true } });
+  assert.deepEqual(applyMergePatch(target, nullPrototypePatch), { a: { new: true } });
+});
+
+test('rejects non-JSON input and leaves inputs unchanged on failure', () => {
+  const cycle = {}; cycle.self = cycle;
+  for (const value of [undefined, NaN, Infinity, -Infinity, 1n, () => {}, Symbol(),
+    new Date(), new Map(), cycle, [undefined], new Array(1), { a: undefined }]) {
+    const target = { keep: { value: 1 } };
+    assert.throws(() => applyMergePatch(target, value));
+    assert.deepEqual(target, { keep: { value: 1 } });
+    if (value !== undefined) assert.throws(() => applyMergePatch(value, {}));
+  }
+  const target = { nested: { value: 1 } };
+  const patch = { nested: { value: 2 }, invalid: cycle };
+  assert.throws(() => applyMergePatch(target, patch));
+  assert.deepEqual(target, { nested: { value: 1 } });
+  assert.equal(patch.nested.value, 2);
+});
