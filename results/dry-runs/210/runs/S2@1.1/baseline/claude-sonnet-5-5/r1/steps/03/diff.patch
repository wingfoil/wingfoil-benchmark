+
+describe('cancelled orders and coupons', () => {
+  it('gives a single-use coupon back when its order is cancelled', () => {
+    const { catalog, inventory, coupons, orders } = createShop();
+    catalog.add({ sku: 'LB-220', name: 'Lamp', priceCents: 1000, vatClass: 'standard', weightGrams: 100 });
+    inventory.restock('LB-220', 10);
+    coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = orders.place({ customer: 'Paolo', date: '2026-11-01', lines: [{ sku: 'LB-220', quantity: 1 }], coupon: 'welcome' });
+    orders.cancel(first.id, '2026-11-01');
+    assert.equal(coupons.usedBy('WELCOME'), undefined);
+    orders.place({ customer: 'Paolo', date: '2026-11-01', lines: [{ sku: 'LB-220', quantity: 1 }], coupon: 'welcome' });
+  });
+});
