@@ -200,3 +200,43 @@ test('availability supports hourly periods', () => {
   assert.throws(() => s.availability({ start: '2026-07-01T14:30:00.000Z', end: h(16) }));
   assert.throws(() => s.availability({ start: h(10), end: h(10, 2) }));
 });
+
+test('cancel refunds in full at least 24 hours before the start, else nothing', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(10), end: d(13) });
+  assert.deepEqual(s.cancel(b.id, '2026-07-09T00:00:00.000Z'), { bookingId: b.id, refund: 6750 });
+  const c = s.book({ itemId: 'b1', start: d(10), end: d(13) });
+  assert.equal(s.cancel(c.id, '2026-07-09T00:00:00.001Z').refund, 0);
+  const e = s.book({ itemId: 'b1', start: d(10), end: d(13) });
+  assert.equal(s.cancel(e.id, '2026-07-09T01:00:00Z').refund, 0);
+  const f = s.book({ itemId: 'b1', start: d(10), end: d(13) });
+  assert.equal(s.cancel(f.id, '2026-07-20T00:00:00Z').refund, 0);
+});
+
+test('cancel refunds an hourly booking by the same policy', () => {
+  const s = hourlySetup();
+  const b = s.book({ itemId: 'b1', start: h(13), end: h(17) });
+  assert.equal(s.cancel(b.id, '2026-06-30T13:00:00Z').refund, 2400);
+  const c = s.book({ itemId: 'b1', start: h(13), end: h(17) });
+  assert.equal(s.cancel(c.id, '2026-06-30T14:00:00Z').refund, 0);
+});
+
+test('a cancelled booking frees its equipment', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(4), kind: 'board' }), []);
+  s.cancel(b.id, '2026-06-01T00:00:00Z');
+  assert.deepEqual(s.availability({ start: d(1), end: d(4), kind: 'board' }), ['b1']);
+  s.book({ itemId: 'b1', start: d(2), end: d(3) });
+});
+
+test('cancel throws for repeated, unknown and invalid requests, changing nothing', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.throws(() => s.cancel('nope', '2026-06-01T00:00:00Z'));
+  assert.throws(() => s.cancel(b.id, 'tomorrow'));
+  assert.throws(() => s.cancel(b.id, '2026-06-01T00:00:00+02:00'));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(2), end: d(3) }));
+  s.cancel(b.id, '2026-06-01T00:00:00Z');
+  assert.throws(() => s.cancel(b.id, '2026-06-01T00:00:00Z'));
+});
