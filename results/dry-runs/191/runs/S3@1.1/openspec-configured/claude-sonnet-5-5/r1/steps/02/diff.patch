diff --git a/test/rental.test.ts b/test/rental.test.ts
index 141ae48370f56a7fee5b1b9a4ff661e0826bf0f6..b35aa5e73d3415ebf1317abd2b27f0c81af1b1b7 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -68,3 +68,37 @@ test('book throws for unknown item or bad period and leaves state intact', () =>
   assert.throws(() => s.book({ itemId: 'b1', start: '2026-07-01T12:00:00.000Z', end: d(2) }));
   s.book({ itemId: 'b1', start: d(1), end: d(2) });
 });
+
+test('availability lists free items, filtered by kind, sorted', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b2', kind: 'board', dailyPrice: 1 });
+  s.addEquipment({ id: 'b10', kind: 'board', dailyPrice: 1 });
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1 });
+  assert.deepEqual(s.availability({ start: d(1), end: d(4) }), ['b1', 'b10', 'b2', 's1']);
+  s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.deepEqual(s.availability({ start: d(2), end: d(3), kind: 'board' }), ['b10', 'b2']);
+  assert.deepEqual(s.availability({ start: d(2), end: d(3) }), ['b10', 'b2', 's1']);
+  assert.deepEqual(s.availability({ start: d(2), end: d(3), kind: 'sail' }), ['s1']);
+});
+
+test('availability honours partial overlap and back-to-back periods', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.deepEqual(s.availability({ start: d(3), end: d(6), kind: 'board' }), []);
+  assert.deepEqual(s.availability({ start: d(4), end: d(6), kind: 'board' }), ['b1']);
+  assert.deepEqual(s.availability({ start: '2026-06-28T00:00:00.000Z', end: d(1), kind: 'board' }), ['b1']);
+  assert.deepEqual(createRentalService().availability({ start: d(1), end: d(2) }), []);
+});
+
+test('availability rejects invalid queries and changes no state', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: '2026-07-01T10:00:00.000Z', end: d(2) }));
+  assert.throws(() => s.availability({ start: d(2), end: d(2) }));
+  assert.throws(() => s.availability({ start: d(3), end: d(2) }));
+  assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'boat' as never }));
+  const result = s.availability({ start: d(1), end: d(2) });
+  result.push('x');
+  assert.deepEqual(s.availability({ start: d(1), end: d(2) }), ['b1', 's1']);
+  s.book({ itemId: 'b1', start: d(1), end: d(2) });
+});
