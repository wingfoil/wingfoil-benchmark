index 0000000000000000000000000000000000000000..141ae48370f56a7fee5b1b9a4ff661e0826bf0f6
--- /dev/null
+++ b/test/rental.test.ts
@@ -0,0 +1,70 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+const d = (day: number) => `2026-07-${String(day).padStart(2, '0')}T00:00:00.000Z`;
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1500 });
+  return s;
+}
+
+test('addEquipment rejects invalid items', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'boat' as never, dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+});
+
+test('quote totals whole days in integer cents', () => {
+  const s = setup();
+  assert.deepEqual(s.quote({ itemId: 'b1', start: d(1), end: d(4) }), {
+    itemId: 'b1',
+    start: d(1),
+    end: d(4),
+    total: 7500,
+  });
+  assert.equal(s.quote({ itemId: 's1', start: '2026-07-01T00:00:00Z', end: d(2) }).total, 1500);
+});
+
+test('quote rejects unknown items and invalid periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'nope', start: d(1), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-07-01T10:00:00.000Z', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(1), end: '2026-07-02T00:00:00.000+02:00' }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(2), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(3), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: 'garbage', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-02-30T00:00:00.000Z', end: d(2) }));
+});
+
+test('book returns a booking with a unique id', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  const b = s.book({ itemId: 's1', start: d(1), end: d(4) });
+  assert.equal(a.total, 7500);
+  assert.equal(a.itemId, 'b1');
+  assert.notEqual(a.id, b.id);
+});
+
+test('book rejects overlaps but allows back-to-back and other items', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: d(1), end: d(4) });
+  assert.throws(() => s.book({ itemId: 'b1', start: d(3), end: d(5) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(1), end: d(2) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(2), end: d(3) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: d(1), end: d(10) }));
+  s.book({ itemId: 'b1', start: d(4), end: d(6) });
+  s.book({ itemId: 'b1', start: d(30), end: '2026-07-31T00:00:00.000Z' });
+  s.book({ itemId: 's1', start: d(1), end: d(4) });
+});
+
+test('book throws for unknown item or bad period and leaves state intact', () => {
+  const s = setup();
+  assert.throws(() => s.book({ itemId: 'nope', start: d(1), end: d(2) }));
+  assert.throws(() => s.book({ itemId: 'b1', start: '2026-07-01T12:00:00.000Z', end: d(2) }));
+  s.book({ itemId: 'b1', start: d(1), end: d(2) });
+});
