--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,112 @@
+export type EquipmentKind = 'board' | 'sail';
+
+export interface Equipment {
+  id: string;
+  kind: EquipmentKind;
+  dailyPrice: number;
+}
+
+export interface RentalRequest {
+  itemId: string;
+  start: string;
+  end: string;
+}
+
+export interface Quote {
+  itemId: string;
+  start: string;
+  end: string;
+  total: number;
+}
+
+export interface Booking extends Quote {
+  id: string;
+}
+
+export interface RentalService {
+  addEquipment(item: Equipment): void;
+  quote(request: RentalRequest): Quote;
+  book(request: RentalRequest): Booking;
+}
+
+const DAY_MS = 86_400_000;
+const MIDNIGHT_UTC = /^\d{4}-\d{2}-\d{2}T00:00(:00(\.0+)?)?(Z|[+-]00:?00)$/;
+
+function parseMidnight(value: unknown, name: string): number {
+  if (typeof value !== 'string' || !MIDNIGHT_UTC.test(value)) {
+    throw new Error(`${name} must be an ISO-8601 UTC string at midnight`);
+  }
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms) || ms % DAY_MS !== 0 || new Date(ms).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`${name} must be an ISO-8601 UTC string at midnight`);
+  }
+  return ms;
+}
+
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Booking[] = [];
+  let counter = 0;
+
+  function price(request: RentalRequest): { quote: Quote; startMs: number; endMs: number } {
+    const item = equipment.get(request.itemId);
+    if (!item) {
+      throw new Error(`unknown item: ${request.itemId}`);
+    }
+    const startMs = parseMidnight(request.start, 'start');
+    const endMs = parseMidnight(request.end, 'end');
+    if (endMs <= startMs) {
+      throw new Error('end must be after start');
+    }
+    const total = item.dailyPrice * ((endMs - startMs) / DAY_MS);
+    if (!Number.isSafeInteger(total)) {
+      throw new Error('total is too large');
+    }
+    return {
+      quote: {
+        itemId: item.id,
+        start: new Date(startMs).toISOString(),
+        end: new Date(endMs).toISOString(),
+        total,
+      },
+      startMs,
+      endMs,
+    };
+  }
+
+  return {
+    addEquipment(item) {
+      if (!item || typeof item.id !== 'string' || item.id === '') {
+        throw new Error('id must be a non-empty string');
+      }
+      if (item.kind !== 'board' && item.kind !== 'sail') {
+        throw new Error("kind must be 'board' or 'sail'");
+      }
+      if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+        throw new Error('dailyPrice must be a non-negative integer number of cents');
+      }
+      if (equipment.has(item.id)) {
+        throw new Error(`item already exists: ${item.id}`);
+      }
+      equipment.set(item.id, { id: item.id, kind: item.kind, dailyPrice: item.dailyPrice });
+    },
+
+    quote(request) {
+      return price(request).quote;
+    },
+
+    book(request) {
+      const { quote, startMs, endMs } = price(request);
+      const clash = bookings.some(
+        (b) => b.itemId === quote.itemId && startMs < Date.parse(b.end) && Date.parse(b.start) < endMs,
+      );
+      if (clash) {
+        throw new Error(`item ${quote.itemId} is not free for the whole period`);
+      }
+      counter += 1;
+      const booking: Booking = { id: `booking-${counter}`, ...quote };
+      bookings.push(booking);
+      return { ...booking };
+    },
+  };
+}
