diff --git a/test/rental.test.ts b/test/rental.test.ts
index 6415135b4f757feb3d240ceb220ae383071f207d..57fedb363758a389ba7d8060498aa3a909a0a646 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -50,3 +50,21 @@ test('availability lists free items of a kind, sorted', () => {
   assert.deepEqual(q('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z', 'sail'), ['a-sail']);
   assert.throws(() => q('2026-07-02T00:00:00Z', '2026-07-02T00:00:00Z'));
 });
+
+test('rentals shorter than a day are priced by the hour', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 700 });
+  const h = (start: string, end: string) => ({ itemId: 'h1', start, end });
+  assert.equal(s.quote(h('2026-07-01T13:00:00Z', '2026-07-01T17:00:00Z')).total, 2800);
+  assert.equal(s.book(h('2026-07-01T22:00:00Z', '2026-07-02T02:00:00Z')).total, 2800);
+  assert.throws(() => s.book(h('2026-07-02T01:00:00Z', '2026-07-02T03:00:00Z')));
+  assert.throws(() => s.quote(h('2026-07-01T13:30:00Z', '2026-07-01T17:00:00Z')));
+  assert.throws(() => s.quote(h('2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z')));
+  assert.deepEqual(s.availability({ start: '2026-07-02T02:00:00Z', end: '2026-07-02T05:00:00Z' }), ['h1']);
+});
+
+test('items without an hourly price cannot be rented by the hour', () => {
+  const s = setup();
+  assert.throws(() => s.quote(r('2026-07-01T13:00:00Z', '2026-07-01T17:00:00Z')));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+});
