index 2b9124d1703e9785b35ddf52f97fc8fe64499b1b..d4a083dc352140c5d8931e19e182d28ab3c478e2 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -31,6 +31,16 @@ export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  /** Sorted ids of the equipment (of `kind`, if given) free for the whole period. */
+  availability(query: AvailabilityQuery): string[];
+}
+
+export interface AvailabilityQuery {
+  /** ISO-8601, UTC, midnight. */
+  start: string;
+  /** ISO-8601, UTC, midnight; the start of the day after the last day. */
+  end: string;
+  kind?: EquipmentKind;
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
@@ -97,5 +107,18 @@ export function createRentalService(): RentalService {
       bookings.push({ ...booking, startMs, endMs });
       return booking;
     },
+
+    availability(query) {
+      const startMs = parseMidnightUtc(query?.start, 'start');
+      const endMs = parseMidnightUtc(query.end, 'end');
+      if (endMs <= startMs) throw new Error('end must be after start');
+      const { kind } = query;
+      if (kind !== undefined && kind !== 'board' && kind !== 'sail') throw new Error("kind must be 'board' or 'sail'");
+      return [...items.values()]
+        .filter((i) => kind === undefined || i.kind === kind)
+        .filter((i) => !bookings.some((b) => b.itemId === i.id && startMs < b.endMs && b.startMs < endMs))
+        .map((i) => i.id)
+        .sort();
+    },
   };
 }
diff --git a/test/rental.test.ts b/test/rental.test.ts
index 79a14fa5dc1bbb50c0fab3b66d61bf56c50eebd5..a794d773d2921ac271b65c62da9b704a04c50298 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -31,3 +31,15 @@ test('bookings cannot overlap but may touch', () => {
   assert.notEqual(a.id, b.id);
   assert.equal(b.total, 2500);
 });
+
+test('availability lists free items of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a-sail', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'b0', kind: 'board', dailyPrice: 2000 });
+  s.book(r('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  const q = (start: string, end: string, kind?: 'board' | 'sail') => s.availability({ start, end, kind });
+  assert.deepEqual(q('2026-07-02T00:00:00Z', '2026-07-04T00:00:00Z'), ['a-sail', 'b0']);
+  assert.deepEqual(q('2026-07-03T00:00:00Z', '2026-07-04T00:00:00Z', 'board'), ['b0', 'b1']);
+  assert.deepEqual(q('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z', 'sail'), ['a-sail']);
+  assert.throws(() => q('2026-07-02T00:00:00Z', '2026-07-02T00:00:00Z'));
+});
