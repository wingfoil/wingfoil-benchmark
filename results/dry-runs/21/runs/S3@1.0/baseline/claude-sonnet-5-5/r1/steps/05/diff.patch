+test('cancelling frees the equipment, refunds before start, and works only once', () => {
+  const s = setup();
+  const a = s.book(r('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.deepEqual(s.cancel(a.id, '2026-06-30T12:00:00Z'), { bookingId: a.id, refund: 5000 });
+  assert.deepEqual(s.availability({ start: '2026-07-01T00:00:00Z', end: '2026-07-03T00:00:00Z' }), ['b1']);
+  assert.throws(() => s.cancel(a.id, '2026-06-30T13:00:00Z'), /already cancelled/);
+  assert.throws(() => s.cancel('nope', '2026-06-30T13:00:00Z'), /Unknown booking/);
+  const b = s.book(r('2026-07-01T00:00:00Z', '2026-07-03T00:00:00Z'));
