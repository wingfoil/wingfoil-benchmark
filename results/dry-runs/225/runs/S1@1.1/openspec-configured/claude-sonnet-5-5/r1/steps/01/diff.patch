@@ -0,0 +1,53 @@
+/**
+ * JSON Pointer, RFC 6901.
+ */
+
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Decodes one reference token (RFC 6901 §4): `~1` first, then `~0`. */
+function decodeToken(token: string, pointer: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new JsonPointerError(`Invalid escape sequence in JSON Pointer ${JSON.stringify(pointer)}`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function parsePointer(pointer: unknown): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Invalid JSON Pointer ${JSON.stringify(pointer)}: must be empty or start with "/"`);
+  }
+  return pointer.slice(1).split("/").map((token) => decodeToken(token, pointer));
+}
+
+/**
+ * Returns the value of `document` that `pointer` refers to (the value itself, not a copy).
+ * Throws `JsonPointerError` if the pointer is invalid or does not resolve to a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  let current: unknown = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token) || Number(token) >= current.length) {
+        throw new JsonPointerError(`JSON Pointer ${JSON.stringify(pointer)} does not resolve: no array element ${JSON.stringify(token)}`);
+      }
+      current = current[Number(token)];
+    } else if (typeof current === "object" && current !== null && Object.hasOwn(current, token)) {
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`JSON Pointer ${JSON.stringify(pointer)} does not resolve: nothing at ${JSON.stringify(token)}`);
+    }
+  }
+  return current;
+}
