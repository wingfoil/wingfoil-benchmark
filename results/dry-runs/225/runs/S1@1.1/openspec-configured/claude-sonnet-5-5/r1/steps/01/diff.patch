@@ -0,0 +1,133 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer, JsonPointerError } from "../src/index.ts";
+
+const rfc = JSON.parse(`{
+  "foo": ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\\\j": 5,
+  "k\\"l": 6,
+  " ": 7,
+  "m~n": 8
+}`);
+
+const throwsPointer = (doc: unknown, ptr: unknown) =>
+  assert.throws(() => resolvePointer(doc, ptr as string), JsonPointerError);
+
+test("whole document", () => {
+  for (const doc of [{ a: 1 }, [1], "s", 1, true, null]) {
+    assert.equal(resolvePointer(doc, ""), doc);
+  }
+});
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("syntax errors", () => {
+  for (const p of ["a", "a/b", "#/a", " /a"]) throwsPointer(rfc, p);
+  for (const p of [undefined, null, 1, {}, ["/a"]]) throwsPointer(rfc, p);
+  // invalid even when the document could not be traversed anyway
+  throwsPointer(1, "a");
+});
+
+test("escapes", () => {
+  assert.equal(resolvePointer({ "a/b": 1 }, "/a~1b"), 1);
+  assert.equal(resolvePointer({ "m~n": 8 }, "/m~0n"), 8);
+  assert.equal(resolvePointer({ "~1": 5, "/": 6 }, "/~01"), 5);
+  assert.equal(resolvePointer({ "~1": 5, "/": 6 }, "/~1"), 6);
+  for (const p of ["/a~", "/a~2", "/~x", "/~"]) throwsPointer({ a: 1 }, p);
+  // invalid escape is reported even if an earlier token would fail
+  throwsPointer({}, "/missing/~2");
+});
+
+test("object members", () => {
+  assert.equal(resolvePointer({ foo: { bar: 1 } }, "/foo/bar"), 1);
+  assert.equal(resolvePointer({ "": 0 }, "/"), 0);
+  assert.equal(resolvePointer({ "": { "": 9 } }, "//"), 9);
+  const d = { "a b": 1, " ": 2, "%25": 3, A: 4 };
+  assert.deepEqual(["/a b", "/ ", "/%25", "/A"].map((p) => resolvePointer(d, p)), [1, 2, 3, 4]);
+  throwsPointer(d, "/a");
+  throwsPointer({ a: 1 }, "/b");
+});
+
+test("inherited property names are not members", () => {
+  for (const p of ["/__proto__", "/constructor", "/toString", "/constructor/prototype", "/hasOwnProperty"]) {
+    throwsPointer({}, p);
+  }
+  throwsPointer([], "/constructor");
+});
+
+test("own __proto__ member from JSON.parse", () => {
+  const doc = JSON.parse('{"__proto__": {"x": 1}}');
+  assert.equal(resolvePointer(doc, "/__proto__/x"), 1);
+  assert.equal(({} as any).x, undefined);
+});
+
+test("array elements", () => {
+  assert.equal(resolvePointer({ foo: ["bar", "baz"] }, "/foo/1"), "baz");
+  assert.equal(resolvePointer(["a"], "/0"), "a");
+  assert.equal(resolvePointer([[1, [2]]], "/0/1/0"), 2);
+  assert.equal(resolvePointer(Array.from({ length: 11 }, (_, i) => i), "/10"), 10);
+});
+
+test("array errors", () => {
+  throwsPointer(["a"], "/1");
+  throwsPointer(["a"], "/99999999999999999999");
+  throwsPointer(["a"], "/-");
+  for (const p of ["/01", "/+1", "/-1", "/1.0", "/1e0", "/ 1", "/length", "/", "/0x1", "/00"]) {
+    throwsPointer(["a", "b"], p);
+  }
+  throwsPointer([], "/0");
+});
+
+test("cannot traverse primitives or null", () => {
+  const d = { a: 1, n: null, s: "str", t: true };
+  for (const p of ["/a/b", "/n/x", "/s/0", "/s/length", "/t/x", "/a/0"]) throwsPointer(d, p);
+  throwsPointer(null, "/a");
+  throwsPointer("str", "/0");
+});
+
+test("null and falsy values are valid results", () => {
+  const d = { a: null, b: [false, 0, ""] };
+  assert.equal(resolvePointer(d, "/a"), null);
+  assert.equal(resolvePointer(d, "/b/0"), false);
+  assert.equal(resolvePointer(d, "/b/1"), 0);
+  assert.equal(resolvePointer(d, "/b/2"), "");
+});
+
+test("no mutation, returns same reference", () => {
+  const doc = { a: { b: [1, { c: 2 }] } };
+  const copy = structuredClone(doc);
+  assert.equal(resolvePointer(doc, "/a"), doc.a);
+  assert.equal(resolvePointer(doc, "/a/b/1"), doc.a.b[1]);
+  assert.deepEqual(doc, copy);
+});
+
+test("errors are JsonPointerError and Error", () => {
+  for (const [d, p] of [[{}, "a"], [{}, "/a~2"], [{}, "/a"], [[], "/-"]] as const) {
+    try {
+      resolvePointer(d, p);
+      assert.fail("should throw");
+    } catch (e) {
+      assert.ok(e instanceof JsonPointerError);
+      assert.ok(e instanceof Error);
+      assert.equal((e as Error).name, "JsonPointerError");
+    }
+  }
+});
