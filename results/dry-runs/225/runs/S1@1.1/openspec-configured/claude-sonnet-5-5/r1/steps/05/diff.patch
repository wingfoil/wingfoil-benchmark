@@ -0,0 +1,102 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const json = (text: string): unknown => JSON.parse(text);
+
+function check(from: unknown, to: unknown): ReturnType<typeof createPatch> {
+  const before = structuredClone([from, to]);
+  const patch = createPatch(from, to);
+  assert.deepEqual([from, to], before);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch, whatever the key order", () => {
+  assert.deepEqual(check({ a: 1, b: [1, { c: 2 }] }, { b: [1, { c: 2 }], a: 1 }), []);
+});
+
+test("root replacement", () => {
+  assert.deepEqual(check({}, []), [{ op: "replace", path: "", value: [] }]);
+  assert.deepEqual(check(null, 1), [{ op: "replace", path: "", value: 1 }]);
+  assert.deepEqual(check(1, 2), [{ op: "replace", path: "", value: 2 }]);
+});
+
+test("one nested change is one operation", () => {
+  assert.deepEqual(check({ a: { b: { c: 1, d: 2 } }, e: [1] }, { a: { b: { c: 3, d: 2 } }, e: [1] }), [
+    { op: "replace", path: "/a/b/c", value: 3 },
+  ]);
+});
+
+test("members added and removed", () => {
+  const patch = check({ y: 1, k: 1 }, { x: 2, k: 1 });
+  assert.deepEqual(patch, [{ op: "remove", path: "/y" }, { op: "add", path: "/x", value: 2 }]);
+});
+
+test("null is a value; object vs array is replaced", () => {
+  assert.deepEqual(check({ a: null }, { a: 1 }), [{ op: "replace", path: "/a", value: 1 }]);
+  assert.deepEqual(check({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+  assert.deepEqual(check({ a: {} }, { a: [] }), [{ op: "replace", path: "/a", value: [] }]);
+});
+
+test("array insert, remove, append", () => {
+  assert.deepEqual(check([1, 2, 3], [1, 9, 2, 3]), [{ op: "add", path: "/1", value: 9 }]);
+  assert.deepEqual(check([1, 2, 3], [2, 3]), [{ op: "remove", path: "/0" }]);
+  assert.deepEqual(check([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+});
+
+test("array move does not touch the items in between", () => {
+  for (const [from, to] of [[[1, 2, 3, 4, 5], [1, 5, 2, 3, 4]], [[1, 2, 3, 4, 5], [2, 3, 4, 1, 5]]]) {
+    const patch = check(from, to);
+    assert.equal(patch.length, 2);
+  }
+});
+
+test("array item changed in place", () => {
+  const patch = check([{ id: 1, n: 1 }, { id: 2, n: 1 }, { id: 3, n: 1 }], [{ id: 1, n: 1 }, { id: 2, n: 5 }, { id: 3, n: 1 }]);
+  assert.deepEqual(patch, [{ op: "replace", path: "/1/n", value: 5 }]);
+});
+
+test("duplicates and empty arrays", () => {
+  for (const [from, to] of [[[], [1, 1]], [[1, 1, 1], [1, 1]], [[1, 1], []], [[[]], [[], []]]]) check(from, to);
+});
+
+test("pointers are escaped", () => {
+  const patch = check({ "a/b": 1, "m~n": 1, "": 1 }, { "a/b": 2, "m~n": 2, "": 2 });
+  assert.deepEqual(patch.map((op) => op.path), ["/a~1b", "/m~0n", "/"]);
+});
+
+test("__proto__ is plain data", () => {
+  const from = json('{"__proto__":{"x":1}}');
+  const to = json('{"__proto__":{"x":2}}');
+  assert.deepEqual(check(from, to), [{ op: "replace", path: "/__proto__/x", value: 2 }]);
+  assert.deepEqual(check({}, to), [{ op: "add", path: "/__proto__", value: json('{"x":2}') }]);
+  assert.deepEqual(check(from, {}), [{ op: "remove", path: "/__proto__" }]);
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+});
+
+test("only own members count", () => {
+  const inherited = Object.create({ a: 1 });
+  assert.deepEqual(createPatch(inherited, {}), []);
+});
+
+test("patch values do not alias the inputs", () => {
+  const to = { a: { b: [1] } };
+  const patch = createPatch({}, to);
+  (patch[0] as { value: { b: number[] } }).value.b.push(2);
+  assert.deepEqual(to, { a: { b: [1] } });
+});
+
+test("randomized round trip", () => {
+  let seed = 7;
+  const rand = (n: number): number => (seed = (seed * 1103515245 + 12345) & 0x7fffffff) % n;
+  const gen = (depth: number): unknown => {
+    const kind = rand(depth > 2 ? 3 : 6);
+    if (kind === 0) return rand(3);
+    if (kind === 1) return null;
+    if (kind === 2) return ["a", "b/c", "~"][rand(3)];
+    if (kind === 3 || kind === 4) return Array.from({ length: rand(6) }, () => gen(depth + 1));
+    return Object.fromEntries(Array.from({ length: rand(4) }, () => [["a", "b", "/", "~"][rand(4)], gen(depth + 1)]));
+  };
+  for (let n = 0; n < 2000; n++) check(gen(0), gen(0));
+});
