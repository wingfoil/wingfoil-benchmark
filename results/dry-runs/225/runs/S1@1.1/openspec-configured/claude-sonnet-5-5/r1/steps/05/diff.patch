index 6b215ad6e029f4a4825857872f4c742f74859223..b8f625c7f6b830f0b5a990c3d58ed794343aa6cf 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -280,3 +280,98 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   assertJson(patch, "patch");
   return mergePatch(clone(target), patch);
 }
+
+/**
+ * Creating JSON Patches (RFC 6902 operations; locations are RFC 6901 pointers).
+ */
+
+export type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+/** Encodes one reference token (RFC 6901 §3): `~` first, then `/`. */
+const encodeToken = (token: string): string => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+/** Matched index pairs of a longest common subsequence of `a` and `b`. */
+function commonSubsequence(a: unknown[], b: unknown[]): Array<[number, number]> {
+  const lengths: number[][] = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      lengths[i][j] = jsonEqual(a[i], b[j]) ? lengths[i + 1][j + 1] + 1 : Math.max(lengths[i + 1][j], lengths[i][j + 1]);
+    }
+  }
+  const pairs: Array<[number, number]> = [];
+  let i = 0;
+  let j = 0;
+  while (i < a.length && j < b.length) {
+    if (jsonEqual(a[i], b[j])) pairs.push([i++, j++]);
+    else if (lengths[i + 1][j] >= lengths[i][j + 1]) i++;
+    else j++;
+  }
+  return pairs;
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, operations: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && jsonEqual(from[start], to[start])) start++;
+  let fromEnd = from.length;
+  let toEnd = to.length;
+  while (fromEnd > start && toEnd > start && jsonEqual(from[fromEnd - 1], to[toEnd - 1])) {
+    fromEnd--;
+    toEnd--;
+  }
+  const a = from.slice(start, fromEnd);
+  const b = to.slice(start, toEnd);
+  // `index` is the position in the array being edited, which already holds the final items before it.
+  let index = start;
+  let i = 0;
+  let j = 0;
+  const gap = (fromStop: number, toStop: number): void => {
+    const paired = Math.min(fromStop - i, toStop - j);
+    for (let k = 0; k < paired; k++) diff(a[i + k], b[j + k], `${path}/${index + k}`, operations);
+    for (let k = paired; k < fromStop - i; k++) operations.push({ op: "remove", path: `${path}/${index + paired}` });
+    for (let k = paired; k < toStop - j; k++) {
+      operations.push({ op: "add", path: `${path}/${index + k}`, value: clone(b[j + k]) });
+    }
+    index += toStop - j;
+    i = fromStop;
+    j = toStop;
+  };
+  for (const [matchA, matchB] of commonSubsequence(a, b)) {
+    gap(matchA, matchB);
+    index++;
+    i++;
+    j++;
+  }
+  gap(a.length, b.length);
+}
+
+function diff(from: unknown, to: unknown, path: string, operations: PatchOperation[]): void {
+  if (jsonEqual(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, operations);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) operations.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${encodeToken(key)}`;
+      if (Object.hasOwn(from, key)) diff(from[key], to[key], child, operations);
+      else operations.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+  } else {
+    operations.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only the
+ * places that differ. Neither argument is mutated and the patch shares no structure with them.
+ * Array items that are inserted, removed or moved are added/removed individually (a move is a
+ * `remove` followed by an `add`); the items around them are left alone.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const operations: PatchOperation[] = [];
+  diff(from, to, "", operations);
+  return operations;
+}
