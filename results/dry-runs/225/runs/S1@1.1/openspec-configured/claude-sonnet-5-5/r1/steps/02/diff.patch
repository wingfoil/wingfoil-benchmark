+  assert.deepEqual(apply({ a: null }, { op: "test", path: "/a", value: null }), { a: null });
+  assert.deepEqual(apply(doc, { op: "test", path: "", value: doc }), doc);
+  const bad: [unknown, unknown][] = [
+    [[1, 2], [2, 1]], [{ a: 1 }, { a: 1, b: 2 }], [{ a: 1, b: 2 }, { a: 1 }], ["1", 1], [1, true], [0, false],
+    [null, 0], [null, {}], [[], {}], [{}, []], [{ a: 1 }, { b: 1 }], [[1], [1, 2]], ["a", "b"], [{ a: [1] }, { a: [2] }],
+  ];
+  for (const [actual, expected] of bad) fails({ a: actual }, { op: "test", path: "/a", value: expected });
+  fails({}, { op: "test", path: "/a", value: null });
+  fails({ a: 1 }, { op: "test", path: "", value: 1 });
+  fails({ a: 1 }, { op: "test", path: "/a", value: 2 }, { op: "add", path: "/b", value: 1 });
+});
+
+test("hostile keys", () => {
+  fails({}, { op: "add", path: "/__proto__/polluted", value: true });
+  assert.equal(({} as any).polluted, undefined);
+  const out = applyPatch({}, j('[{"op":"add","path":"/__proto__","value":{"x":1}}]')) as any;
+  assert.ok(Object.hasOwn(out, "__proto__"));
+  assert.deepEqual(Object.getOwnPropertyDescriptor(out, "__proto__")!.value, { x: 1 });
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  for (const op of ["remove", "replace", "test"]) {
+    for (const p of ["/toString", "/constructor", "/__proto__"]) fails({}, { op, path: p, value: 1 });
+  }
+  fails({}, { op: "copy", from: "/constructor", path: "/a" });
+  const doc = j('{"__proto__":{"a":1},"b":{"__proto__":[1]}}');
+  const res = applyPatch(doc, [{ op: "add", path: "/c", value: j('{"__proto__":{"z":1}}') }]) as any;
+  assert.equal(Object.getPrototypeOf(res), Object.prototype);
+  assert.deepEqual(Object.getOwnPropertyDescriptor(res, "__proto__")!.value, { a: 1 });
+  assert.deepEqual(Object.getOwnPropertyDescriptor(res.c, "__proto__")!.value, { z: 1 });
+  assert.equal(Object.getPrototypeOf(res.b), Object.prototype);
+  assert.equal(res.c.z, undefined);
+  const moved = apply(doc, { op: "move", from: "/__proto__", path: "/q" }) as any;
+  assert.deepEqual(moved.q, { a: 1 });
+  assert.ok(!Object.hasOwn(moved, "__proto__"));
+});
+
+test("RFC 6902 Appendix A examples", () => {
+  const A = (doc: string, patch: string) => applyPatch(j(doc), j(patch));
+  assert.deepEqual(A('{"foo":"bar"}', '[{"op":"add","path":"/baz","value":"qux"}]'), { foo: "bar", baz: "qux" });
+  assert.deepEqual(A('{"foo":["bar","baz"]}', '[{"op":"add","path":"/foo/1","value":"qux"}]'), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(A('{"baz":"qux","foo":"bar"}', '[{"op":"remove","path":"/baz"}]'), { foo: "bar" });
+  assert.deepEqual(A('{"foo":["bar","qux","baz"]}', '[{"op":"remove","path":"/foo/1"}]'), { foo: ["bar", "baz"] });
+  assert.deepEqual(A('{"baz":"qux","foo":"bar"}', '[{"op":"replace","path":"/baz","value":"boo"}]'), { baz: "boo", foo: "bar" });
+  assert.deepEqual(
+    A('{"foo":{"bar":"baz","waldo":"fred"},"qux":{"corge":"grault"}}', '[{"op":"move","from":"/foo/waldo","path":"/qux/thud"}]'),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(A('{"foo":["all","grass","cows","eat"]}', '[{"op":"move","from":"/foo/1","path":"/foo/3"}]'), { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(A('{"baz":"qux","foo":["a",2,"c"]}', '[{"op":"test","path":"/baz","value":"qux"},{"op":"test","path":"/foo/1","value":2}]'), { baz: "qux", foo: ["a", 2, "c"] });
+  assert.throws(() => A('{"baz":"qux"}', '[{"op":"test","path":"/baz","value":"bar"}]'), JsonPatchError);
+  assert.deepEqual(A('{"foo":"bar"}', '[{"op":"add","path":"/child","value":{"grandchild":{}}}]'), { foo: "bar", child: { grandchild: {} } });
+  assert.deepEqual(A('{"foo":"bar"}', '[{"op":"add","path":"/baz","value":"qux","xyz":123}]'), { foo: "bar", baz: "qux" });
+  assert.throws(() => A('{"foo":"bar"}', '[{"op":"add","path":"/baz/bat","value":"qux"}]'), JsonPatchError);
+  assert.throws(() => A('{"baz":"qux"}', '[{"op":"test","path":"/baz","value":"bar"},{"op":"add","path":"/a","value":1}]'), JsonPatchError);
+  assert.deepEqual(A('{"/":9,"~1":10}', '[{"op":"test","path":"/~01","value":10}]'), { "/": 9, "~1": 10 });
+  assert.deepEqual(A('{"foo":["bar"]}', '[{"op":"add","path":"/foo/-","value":["abc","def"]}]'), { foo: ["bar", ["abc", "def"]] });
+});
