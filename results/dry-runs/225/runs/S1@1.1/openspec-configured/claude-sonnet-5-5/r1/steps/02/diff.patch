@@ -51,3 +51,180 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+/**
+ * JSON Patch, RFC 6902 (locations are JSON Pointers, RFC 6901).
+ */
+
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Container = unknown[] | Record<string, unknown>;
+
+const isObject = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value);
+
+/** Sets an own data member without ever invoking the `__proto__` setter. */
+function setMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Deep copy of a JSON value; own `__proto__` members stay plain data. */
+function clone<T>(value: T): T {
+  if (Array.isArray(value)) return value.map(clone) as T;
+  if (isObject(value)) {
+    const copy: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(copy, key, clone(value[key]));
+    return copy as T;
+  }
+  return value;
+}
+
+/** Equality of JSON values, RFC 6902 §4.6. */
+function jsonEqual(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((item, i) => jsonEqual(item, b[i]));
+  }
+  if (isObject(a) && isObject(b)) {
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((key) => Object.hasOwn(b, key) && jsonEqual(a[key], b[key]));
+  }
+  return a === b;
+}
+
+function parseLocation(pointer: string, what: string, index: number): string[] {
+  try {
+    return parsePointer(pointer);
+  } catch (error) {
+    throw new JsonPatchError(`Operation ${index}: invalid "${what}": ${(error as Error).message}`);
+  }
+}
+
+/** Index of `token` in `array`; `max` is the largest acceptable index. Throws if not a valid index. */
+function arrayIndex(array: unknown[], token: string, max: number, where: string): number {
+  if (!ARRAY_INDEX.test(token) || Number(token) > max) {
+    throw new JsonPatchError(`${where}: invalid array index ${JSON.stringify(token)}`);
+  }
+  return Number(token);
+}
+
+/** Walks `tokens` from `root`; every step must exist. */
+function walk(root: unknown, tokens: string[], where: string): unknown {
+  let current = root;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      current = current[arrayIndex(current, token, current.length - 1, where)];
+    } else if (isObject(current) && Object.hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new JsonPatchError(`${where}: nothing at ${JSON.stringify(token)}`);
+    }
+  }
+  return current;
+}
+
+function parentOf(root: unknown, tokens: string[], where: string): Container {
+  const parent = walk(root, tokens.slice(0, -1), where);
+  if (Array.isArray(parent) || isObject(parent)) return parent;
+  throw new JsonPatchError(`${where}: parent is not an object or array`);
+}
+
+/** `add` semantics (§4.1); returns the new root. */
+function addAt(root: unknown, tokens: string[], value: unknown, where: string): unknown {
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens, where);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (last === "-") parent.push(value);
+    else parent.splice(arrayIndex(parent, last, parent.length, where), 0, value);
+  } else {
+    setMember(parent, last, value);
+  }
+  return root;
+}
+
+/** `remove` semantics (§4.2); returns the new root. */
+function removeAt(root: unknown, tokens: string[], where: string): unknown {
+  if (tokens.length === 0) throw new JsonPatchError(`${where}: cannot remove the whole document`);
+  walk(root, tokens, where);
+  const parent = parentOf(root, tokens, where);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete parent[last];
+  return root;
+}
+
+const OPERATIONS = ["add", "remove", "replace", "move", "copy", "test"];
+
+interface Operation {
+  op: string;
+  path: string[];
+  from: string[];
+  value: unknown;
+}
+
+function validate(patch: unknown): Operation[] {
+  if (!Array.isArray(patch)) throw new JsonPatchError("JSON Patch must be an array of operations");
+  return patch.map((raw: unknown, index): Operation => {
+    if (!isObject(raw)) throw new JsonPatchError(`Operation ${index}: must be an object`);
+    const { op, path, from } = raw as Record<string, unknown>;
+    if (typeof op !== "string" || !OPERATIONS.includes(op)) {
+      throw new JsonPatchError(`Operation ${index}: invalid "op" ${JSON.stringify(op)}`);
+    }
+    if (typeof path !== "string") throw new JsonPatchError(`Operation ${index}: "path" must be a string`);
+    const operation: Operation = { op, path: parseLocation(path, "path", index), from: [], value: undefined };
+    if (op === "add" || op === "replace" || op === "test") {
+      if (!Object.hasOwn(raw, "value")) throw new JsonPatchError(`Operation ${index}: "${op}" requires "value"`);
+      operation.value = raw.value;
+    }
+    if (op === "move" || op === "copy") {
+      if (typeof from !== "string") throw new JsonPatchError(`Operation ${index}: "${op}" requires a string "from"`);
+      operation.from = parseLocation(from, "from", index);
+    }
+    return operation;
+  });
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the result as a new value.
+ * Neither argument is mutated. Throws `JsonPatchError` if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  const operations = validate(patch);
+  let root = clone(document);
+  operations.forEach(({ op, path, from, value }, index) => {
+    const where = `Operation ${index} (${op})`;
+    switch (op) {
+      case "add":
+        root = addAt(root, path, clone(value), where);
+        break;
+      case "remove":
+        root = removeAt(root, path, where);
+        break;
+      case "replace":
+        walk(root, path, where);
+        root = path.length === 0 ? clone(value) : addAt(removeAt(root, path, where), path, clone(value), where);
+        break;
+      case "move": {
+        const moved = walk(root, from, where);
+        if (from.length < path.length && from.every((token, i) => token === path[i])) {
+          throw new JsonPatchError(`${where}: cannot move a location into one of its children`);
+        }
+        if (from.length === path.length && from.every((token, i) => token === path[i])) break;
+        root = addAt(removeAt(root, from, where), path, moved, where);
+        break;
+      }
+      case "copy":
+        root = addAt(root, path, clone(walk(root, from, where)), where);
+        break;
+      case "test":
+        if (!jsonEqual(walk(root, path, where), value)) throw new JsonPatchError(`${where}: value at path differs`);
+        break;
+    }
+  });
+  return root;
+}
