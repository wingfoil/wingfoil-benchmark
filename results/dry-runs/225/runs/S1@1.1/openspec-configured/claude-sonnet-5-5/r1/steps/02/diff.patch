+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, JsonPatchError } from "../src/index.ts";
+
+const apply = (doc: unknown, ...ops: unknown[]) => applyPatch(doc, ops);
+const fails = (doc: unknown, ...ops: unknown[]) => assert.throws(() => applyPatch(doc, ops), JsonPatchError);
+const j = JSON.parse;
+
+test("operations apply in order; empty patch; purity", () => {
+  assert.deepEqual(apply({}, { op: "add", path: "/a", value: 1 }, { op: "replace", path: "/a", value: 2 }), { a: 2 });
+  assert.deepEqual(apply({ a: [1] }), { a: [1] });
+  const doc = { a: { b: [1, 2] }, c: 1 };
+  const patch = [
+    { op: "add", path: "/a/b/-", value: { x: 1 } },
+    { op: "move", path: "/d", from: "/c" },
+    { op: "copy", path: "/e", from: "/a" },
+    { op: "remove", path: "/a/b/0" },
+  ];
+  const docBefore = structuredClone(doc);
+  const patchBefore = structuredClone(patch);
+  applyPatch(doc, patch);
+  assert.deepEqual(doc, docBefore);
+  assert.deepEqual(patch, patchBefore);
+});
+
+test("result does not alias inputs", () => {
+  const value = { x: [1] };
+  const doc = { a: { y: 1 } };
+  const out = applyPatch(doc, [{ op: "add", path: "/b", value }]) as any;
+  out.b.x.push(2);
+  assert.deepEqual(value, { x: [1] });
+  const same = applyPatch(doc, []) as any;
+  same.a.y = 9;
+  assert.equal(doc.a.y, 1);
+});
+
