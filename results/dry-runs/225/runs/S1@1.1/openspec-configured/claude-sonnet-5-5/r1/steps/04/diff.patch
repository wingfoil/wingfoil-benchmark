@@ -231,3 +231,52 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   });
   return root;
 }
+
+/**
+ * JSON Merge Patch, RFC 7396 (obsoletes RFC 7386; same algorithm).
+ */
+
+export class JsonMergePatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonMergePatchError";
+  }
+}
+
+/** Throws unless `value` is a JSON value (RFC 8259) at every depth. */
+function assertJson(value: unknown, what: string): void {
+  if (value === null || typeof value === "string" || typeof value === "boolean") return;
+  if (typeof value === "number") {
+    if (Number.isFinite(value)) return;
+  } else if (Array.isArray(value)) {
+    value.forEach((item) => assertJson(item, what));
+    return;
+  } else if (isObject(value)) {
+    Object.keys(value).forEach((key) => assertJson(value[key], what));
+    return;
+  }
+  throw new JsonMergePatchError(`${what} contains a value that is not JSON`);
+}
+
+/** MergePatch(Target, Patch) of RFC 7396 §2; `target` is already a private copy and is modified in place. */
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch);
+  const result: Record<string, unknown> = isObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) delete result[key];
+    else setMember(result, key, mergePatch(Object.hasOwn(result, key) ? result[key] : undefined, value));
+  }
+  return result;
+}
+
+/**
+ * Applies a JSON Merge Patch (RFC 7396) to `target` and returns the merged document as a new value.
+ * Neither argument is mutated. A non-object patch (including `null`) replaces the target.
+ * Throws `JsonMergePatchError` if either argument is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  assertJson(target, "target");
+  assertJson(patch, "patch");
+  return mergePatch(clone(target), patch);
+}
