index 0000000000000000000000000000000000000000..fe82ce5d41befb4725337f296bcd01f38447013a
--- /dev/null
+++ b/test/merge-patch.test.ts
@@ -0,0 +1,68 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch, JsonMergePatchError } from "../src/index.ts";
+
+const j = JSON.parse;
+const merge = (target: string, patch: string) => applyMergePatch(j(target), j(patch));
+
+test("object patches merge recursively", () => {
+  assert.deepEqual(merge('{"a":"b","c":{"d":"e","f":"g"}}', '{"a":"z","c":{"f":null}}'), { a: "z", c: { d: "e" } });
+  assert.deepEqual(merge('{"a":1,"b":2}', '{"a":null}'), { b: 2 });
+  assert.deepEqual(merge('{"a":1}', '{"x":null}'), { a: 1 });
+  assert.deepEqual(merge('{"a":{"b":1,"c":3},"d":4}', '{"a":{"b":2}}'), { a: { b: 2, c: 3 }, d: 4 });
+  assert.deepEqual(merge("{}", '{"a":{"b":null,"c":1}}'), { a: { c: 1 } });
+  for (const t of ["[1,2]", '"text"', "null", "5"]) assert.deepEqual(merge(t, '{"a":1}'), { a: 1 });
+  assert.deepEqual(merge('{"a":"x"}', '{"a":{"b":1}}'), { a: { b: 1 } });
+  assert.deepEqual(merge('{"a":[1]}', '{"a":{"b":1}}'), { a: { b: 1 } });
+  assert.deepEqual(merge('{"a":1}', "{}"), { a: 1 });
+  assert.deepEqual(merge("[1]", "{}"), {});
+});
+
+test("non-object patches replace the target", () => {
+  assert.deepEqual(merge('{"a":["x","y"]}', '{"a":[1]}'), { a: [1] });
+  assert.deepEqual(merge("{}", '{"a":[1,null,{"b":null}]}'), { a: [1, null, { b: null }] });
+  for (const p of ['"x"', "3", "true", "[1]"]) assert.deepEqual(merge('{"a":1}', p), j(p));
+  assert.equal(merge('{"a":1}', "null"), null);
+  assert.deepEqual(merge('{"a":["b"]}', '{"a":"c"}'), { a: "c" });
+});
+
+test("application is pure", () => {
+  const target = { a: { b: [1, { c: 1 }], d: 1 }, e: 2 };
+  const patch = { a: { b: [2, { x: null }], d: null, n: { m: [1] } }, e: null };
+  const targetBefore = structuredClone(target);
+  const patchBefore = structuredClone(patch);
+  const result = applyMergePatch(target, patch) as any;
+  assert.deepEqual(target, targetBefore);
+  assert.deepEqual(patch, patchBefore);
+  result.a.b.push(9);
+  result.a.n.m.push(9);
+  assert.deepEqual(patch, patchBefore);
+
+  const same = applyMergePatch(target, {}) as any;
+  same.a.b.push(9);
+  assert.deepEqual(target, targetBefore);
+});
+
+test("hostile keys are plain data", () => {
+  const result = merge("{}", '{"__proto__":{"polluted":true}}') as any;
+  assert.ok(Object.hasOwn(result, "__proto__"));
+  assert.deepEqual(result["__proto__"], { polluted: true });
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as any).polluted, undefined);
+  assert.deepEqual(merge('{"a":1}', '{"__proto__":null}'), { a: 1 });
+  assert.equal(({} as any).polluted, undefined);
+  assert.deepEqual(merge("{}", '{"toString":{"a":1}}'), { toString: { a: 1 } });
+  const own = merge('{"__proto__":{"x":1}}', '{"__proto__":{"y":2}}') as any;
+  assert.deepEqual(own["__proto__"], { x: 1, y: 2 });
+});
+
+test("invalid input is rejected", () => {
+  const bad = (target: unknown, patch: unknown) => assert.throws(() => applyMergePatch(target, patch), JsonMergePatchError);
+  bad({}, undefined);
+  bad({}, { a: { b: undefined } });
+  bad({}, { a: NaN });
+  bad({}, { a: () => 1 });
+  bad({}, { a: 1n });
+  bad(undefined, {});
+  bad({ f() {} }, {});
+});
