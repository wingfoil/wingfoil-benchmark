diff --git a/test/rental.test.ts b/test/rental.test.ts
index 9f8669cf8312f83b0e77150a5467cf299f70dae9..bb1cafe6ea61f91c0e4d63c1669141c536047249 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -47,4 +47,41 @@ describe('rental service', () => {
     assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
     assert.throws(() => service.addEquipment({ id: 'x', kind: 'kite' as 'board', dailyPrice: 100 }));
   });
+
+  describe('availability', () => {
+    beforeEach(() => {
+      service.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+      service.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 2000 });
+    });
+
+    it('lists the free items of every kind, sorted', () => {
+      assert.deepEqual(service.availability({ start: D(1), end: D(3) }), ['a0', 'b1', 's1']);
+    });
+
+    it('filters by kind', () => {
+      assert.deepEqual(service.availability({ start: D(1), end: D(3), kind: 'board' }), ['a0', 'b1']);
+      assert.deepEqual(service.availability({ start: D(1), end: D(3), kind: 'sail' }), ['s1']);
+    });
+
+    it('leaves out items booked for any part of the period only', () => {
+      service.book({ itemId: 'b1', start: D(2), end: D(4) });
+      assert.deepEqual(service.availability({ start: D(1), end: D(3) }), ['a0', 's1']);
+      assert.deepEqual(service.availability({ start: D(3), end: D(6) }), ['a0', 's1']);
+      assert.deepEqual(service.availability({ start: D(1), end: D(6) }), ['a0', 's1']);
+      assert.deepEqual(service.availability({ start: D(1), end: D(2) }), ['a0', 'b1', 's1']);
+      assert.deepEqual(service.availability({ start: D(4), end: D(5) }), ['a0', 'b1', 's1']);
+    });
+
+    it('returns an empty list when nothing is free', () => {
+      service.book({ itemId: 's1', start: D(1), end: D(3) });
+      assert.deepEqual(service.availability({ start: D(1), end: D(3), kind: 'sail' }), []);
+    });
+
+    it('rejects invalid periods and kinds', () => {
+      assert.throws(() => service.availability({ start: D(3), end: D(1) }));
+      assert.throws(() => service.availability({ start: D(1), end: D(1) }));
+      assert.throws(() => service.availability({ start: '2026-06-01T10:00:00Z', end: D(2) }));
+      assert.throws(() => service.availability({ start: D(1), end: D(2), kind: 'kite' as 'board' }));
+    });
+  });
 });
