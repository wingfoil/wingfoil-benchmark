@@ -0,0 +1,50 @@
+import assert from 'node:assert/strict';
+import { beforeEach, describe, it } from 'node:test';
+import { createRentalService, type RentalService } from '../src/index.ts';
+
+const D = (day: number) => `2026-06-${String(day).padStart(2, '0')}T00:00:00.000Z`;
+
+describe('rental service', () => {
+  let service: RentalService;
+  beforeEach(() => {
+    service = createRentalService();
+    service.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  });
+
+  it('quotes whole days in euro cents', () => {
+    assert.deepEqual(service.quote({ itemId: 'b1', start: D(1), end: D(4) }), {
+      itemId: 'b1', start: D(1), end: D(4), total: 7500,
+    });
+  });
+
+  it('rejects unknown items, partial days and empty or reversed periods', () => {
+    assert.throws(() => service.quote({ itemId: 'zz', start: D(1), end: D(2) }));
+    assert.throws(() => service.quote({ itemId: 'b1', start: '2026-06-01T10:00:00Z', end: D(2) }));
+    assert.throws(() => service.quote({ itemId: 'b1', start: '2026-06-01T00:00:00+02:00', end: D(2) }));
+    assert.throws(() => service.quote({ itemId: 'b1', start: D(1), end: D(1) }));
+    assert.throws(() => service.quote({ itemId: 'b1', start: D(3), end: D(1) }));
+  });
+
+  it('books and gives each booking its own id', () => {
+    const a = service.book({ itemId: 'b1', start: D(1), end: D(2) });
+    const b = service.book({ itemId: 'b1', start: D(2), end: D(3) });
+    assert.equal(a.total, 2500);
+    assert.notEqual(a.id, b.id);
+  });
+
+  it('refuses overlapping bookings of the same item only', () => {
+    service.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+    service.book({ itemId: 'b1', start: D(2), end: D(5) });
+    assert.throws(() => service.book({ itemId: 'b1', start: D(4), end: D(6) }));
+    assert.throws(() => service.book({ itemId: 'b1', start: D(1), end: D(3) }));
+    assert.throws(() => service.book({ itemId: 'b1', start: D(3), end: D(4) }));
+    service.book({ itemId: 's1', start: D(2), end: D(5) });
+    service.book({ itemId: 'b1', start: D(5), end: D(6) });
+  });
+
+  it('validates equipment', () => {
+    assert.throws(() => service.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+    assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
+    assert.throws(() => service.addEquipment({ id: 'x', kind: 'kite' as 'board', dailyPrice: 100 }));
+  });
+});
