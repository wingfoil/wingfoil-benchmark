+// RFC 6902, section 4 and RFC 8259: a "value" is a JSON value. Rejects what JSON cannot hold, such as
+// undefined, non-finite numbers, functions, class instances, holes in arrays and cyclic structures.
+function assertJsonValue(value: unknown, at: string, ancestors: object[] = []): asserts value is JsonValue {
+  if (value === null || typeof value === 'string' || typeof value === 'boolean') {
+    return;
+  }
+  if (typeof value === 'number') {
+    if (!Number.isFinite(value)) {
+      throw new Error(`${at}: "value" must be a finite number`);
+    }
+    return;
+  }
+  if (typeof value !== 'object' || ancestors.includes(value)) {
+    throw new Error(`${at}: "value" must be a JSON value, without cycles`);
+  }
+  if (Array.isArray(value)) {
+    for (let i = 0; i < value.length; i++) {
+      if (!Object.hasOwn(value, i)) {
+        throw new Error(`${at}: "value" must be a JSON value, without holes in arrays`);
+      }
+      assertJsonValue(value[i], at, [...ancestors, value]);
+    }
+    return;
+  }
+  const prototype = Object.getPrototypeOf(value);
+  if (prototype !== Object.prototype && prototype !== null) {
+    throw new Error(`${at}: "value" must be a JSON value, not an instance of a class`);
+  }
+  for (const key of Object.keys(value)) {
+    assertJsonValue((value as { [key: string]: unknown })[key], at, [...ancestors, value]);
+  }
+}
