   return merged;
 }
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns the JSON document `from` into `to`: applying it to `from`
+ * with `applyPatch` yields a document equal to `to`.
+ *
+ * The patch describes only what changed. Members are added, removed or patched recursively, and an array
+ * item is added or removed without rewriting the items around it; an item that moved is removed and added
+ * back. The inputs are not modified: the patch shares no mutable structure with either.
+ *
+ * @throws {Error} when `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): JsonPatch {
+  assertJsonValue(from, 'invalid JSON document "from"');
+  assertJsonValue(to, 'invalid JSON document "to"');
+  const patch: JsonPatch = [];
+  diffValue('', from, to, patch);
+  return patch;
+}
+
+// Appends the operations that turn `from`, the value at `path`, into `to`.
+function diffValue(path: string, from: JsonValue, to: JsonValue, patch: JsonPatch): void {
+  if (jsonEquals(from, to)) {
+    return;
+  }
+  if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!Object.hasOwn(to, key)) {
+        patch.push({ op: 'remove', path: `${path}/${escapeToken(key)}` });
+      }
+    }
+    for (const key of Object.keys(to)) {
+      const member = `${path}/${escapeToken(key)}`;
+      if (Object.hasOwn(from, key)) {
+        diffValue(member, from[key], to[key], patch);
+      } else {
+        patch.push({ op: 'add', path: member, value: structuredClone(to[key]) });
+      }
+    }
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(path, from, to, patch);
+  } else {
+    patch.push({ op: 'replace', path, value: structuredClone(to) });
+  }
+}
+
+// The items that both arrays share, in order, are kept in place. Between two shared items, the items of
+// `from` are paired in order with those of `to`: each pair is patched within the item, and the leftovers
+// are removed or added. Every operation then works on the array as the previous ones left it.
+function diffArray(path: string, from: JsonValue[], to: JsonValue[], patch: JsonPatch): void {
+  const shared = alignItems(from, to);
+  shared.push([from.length, to.length]);
+  let position = 0;
+  let i = 0;
+  let j = 0;
+  for (const [fromIndex, toIndex] of shared) {
+    const removed = fromIndex - i;
+    const added = toIndex - j;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) {
+      diffItem(`${path}/${position + k}`, from[i + k], to[j + k], patch);
+    }
+    for (let k = paired; k < removed; k++) {
+      patch.push({ op: 'remove', path: `${path}/${position + added}` });
+    }
+    for (let k = paired; k < added; k++) {
+      patch.push({ op: 'add', path: `${path}/${position + k}`, value: structuredClone(to[j + k]) });
+    }
+    position += added;
+    if (fromIndex < from.length) {
+      position += 1;
+    }
+    i = fromIndex + 1;
+    j = toIndex + 1;
+  }
+}
+
+// Patches an array item in place, unless replacing the whole item is the smaller patch.
+function diffItem(path: string, from: JsonValue, to: JsonValue, patch: JsonPatch): void {
+  const inner: JsonPatch = [];
+  diffValue(path, from, to, inner);
+  const replacement: JsonPatch = [{ op: 'replace', path, value: structuredClone(to) }];
+  patch.push(...(JSON.stringify(inner).length < JSON.stringify(replacement).length ? inner : replacement));
+}
+
+// The pairs of indices (in `from`, in `to`) of the items that both arrays share, in order: the common
+// prefix and suffix, then a longest common subsequence of the items in between.
+function alignItems(from: JsonValue[], to: JsonValue[]): Array<[number, number]> {
+  const ids = new Map<string, number>();
+  const idOf = (item: JsonValue): number => {
+    const key = canonical(item);
+    let id = ids.get(key);
+    if (id === undefined) {
+      id = ids.size;
+      ids.set(key, id);
+    }
+    return id;
+  };
+  const fromIds = from.map(idOf);
+  const toIds = to.map(idOf);
+
+  let prefix = 0;
+  while (prefix < fromIds.length && prefix < toIds.length && fromIds[prefix] === toIds[prefix]) {
+    prefix++;
+  }
+  let suffix = 0;
+  while (
+    suffix < fromIds.length - prefix &&
+    suffix < toIds.length - prefix &&
+    fromIds[fromIds.length - 1 - suffix] === toIds[toIds.length - 1 - suffix]
+  ) {
+    suffix++;
+  }
+
+  const pairs: Array<[number, number]> = [];
+  for (let k = 0; k < prefix; k++) {
+    pairs.push([k, k]);
+  }
+  const middle = longestCommonSubsequence(
+    fromIds.slice(prefix, fromIds.length - suffix),
+    toIds.slice(prefix, toIds.length - suffix),
+  );
+  for (const [x, y] of middle) {
+    pairs.push([x + prefix, y + prefix]);
+  }
+  for (let k = suffix; k > 0; k--) {
+    pairs.push([fromIds.length - k, toIds.length - k]);
+  }
+  return pairs;
+}
+
+// The pairs of positions of a longest common subsequence of two sequences of ids.
+function longestCommonSubsequence(a: number[], b: number[]): Array<[number, number]> {
+  const width = b.length + 1;
+  // table[i * width + j] is the length of a longest common subsequence of a[i..] and b[j..].
+  const table = new Uint32Array((a.length + 1) * width);
+  for (let i = a.length - 1; i >= 0; i--) {
+    for (let j = b.length - 1; j >= 0; j--) {
+      table[i * width + j] =
+        a[i] === b[j] ? table[(i + 1) * width + j + 1] + 1 : Math.max(table[(i + 1) * width + j], table[i * width + j + 1]);
+    }
+  }
+  const pairs: Array<[number, number]> = [];
+  let i = 0;
+  let j = 0;
+  while (i < a.length && j < b.length) {
+    if (a[i] === b[j]) {
+      pairs.push([i, j]);
+      i++;
+      j++;
+    } else if (table[(i + 1) * width + j] >= table[i * width + j + 1]) {
+      i++;
+    } else {
+      j++;
+    }
+  }
+  return pairs;
+}
+
+// A text for a JSON value that is the same for equal values, whatever the order of their object keys.
+function canonical(value: JsonValue): string {
+  if (Array.isArray(value)) {
+    return `[${value.map(canonical).join(',')}]`;
+  }
+  if (isObject(value)) {
+    const members = Object.keys(value)
+      .sort()
+      .map((key) => `${JSON.stringify(key)}:${canonical(value[key])}`);
+    return `{${members.join(',')}}`;
+  }
+  return JSON.stringify(value);
+}
+
+// RFC 6901, section 3: "~" and "/" are escaped in a reference token.
+function escapeToken(token: string): string {
+  return token.replace(/~/g, '~0').replace(/\//g, '~1');
+}
