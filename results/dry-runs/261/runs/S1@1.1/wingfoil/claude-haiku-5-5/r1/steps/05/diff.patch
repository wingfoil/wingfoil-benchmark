index 0000000000000000000000000000000000000000..e6b623cc8bdfa53a65f47d0cf9b62f0b9f9359ec
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,156 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch, createPatch } from '../src/index.ts';
+
+// Each test below freezes the inputs it passes, so that any mutation shows up as a failure.
+function deepFreeze<T>(value: T): T {
+  if (value !== null && typeof value === 'object') {
+    for (const child of Object.values(value)) deepFreeze(child);
+    Object.freeze(value);
+  }
+  return value;
+}
+
+// The patch must turn `from` into `to`, and must not touch either input.
+function assertRoundTrip(from: unknown, to: unknown) {
+  const patch = createPatch(deepFreeze(structuredClone(from)), deepFreeze(structuredClone(to)));
+  assert.deepEqual(applyPatch(from as never, patch), to);
+  return patch;
+}
+
+test('equal documents give an empty patch', () => {
+  assert.deepEqual(createPatch({ a: [1, { b: 'c' }] }, { a: [1, { b: 'c' }] }), []);
+});
+
+test('a member only in the target is added', () => {
+  assert.deepEqual(createPatch({ a: 1 }, { a: 1, b: 2 }), [{ op: 'add', path: '/b', value: 2 }]);
+});
+
+test('a member only in the source is removed', () => {
+  assert.deepEqual(createPatch({ a: 1, b: 2 }, { a: 1 }), [{ op: 'remove', path: '/b' }]);
+});
+
+test('a changed scalar member is replaced, and only that member', () => {
+  const from = { a: 1, big: 'x'.repeat(1000) };
+  const patch = assertRoundTrip(from, { a: 2, big: from.big });
+  assert.deepEqual(patch, [{ op: 'replace', path: '/a', value: 2 }]);
+});
+
+test('members in both documents are compared recursively', () => {
+  const patch = assertRoundTrip({ user: { name: 'Ada', age: 36 } }, { user: { name: 'Ada', age: 37 } });
+  assert.deepEqual(patch, [{ op: 'replace', path: '/user/age', value: 37 }]);
+});
+
+test('a value whose type changes is replaced', () => {
+  assertRoundTrip({ a: 1 }, { a: { b: 1 } });
+  assertRoundTrip({ a: [1] }, { a: { b: 1 } });
+  assertRoundTrip({ a: null }, { a: 'x' });
+});
+
+test('the whole document can be replaced at the root', () => {
+  assert.deepEqual(assertRoundTrip([1, 2], { a: 1 }), [{ op: 'replace', path: '', value: { a: 1 } }]);
+});
+
+test('an item added to an array adds only that item', () => {
+  const from = { list: Array.from({ length: 100 }, (_, i) => ({ id: i })) };
+  const to = { list: [...from.list.slice(0, 50), { id: 'new' }, ...from.list.slice(50)] };
+  assert.deepEqual(assertRoundTrip(from, to), [{ op: 'add', path: '/list/50', value: { id: 'new' } }]);
+});
+
+test('an item added at the end of an array appends only that item', () => {
+  const patch = assertRoundTrip({ list: ['a', 'b'] }, { list: ['a', 'b', 'c'] });
+  assert.deepEqual(patch, [{ op: 'add', path: '/list/2', value: 'c' }]);
+});
+
+test('an item removed from an array removes only that item', () => {
+  const from = { list: Array.from({ length: 100 }, (_, i) => ({ id: i })) };
+  const to = { list: from.list.filter((item) => item.id !== 10) };
+  assert.deepEqual(assertRoundTrip(from, to), [{ op: 'remove', path: '/list/10' }]);
+});
+
+test('an item moved within an array is removed and added back, without rewriting the items in between', () => {
+  const from = { list: ['a', 'b', 'c', 'd', 'e'] };
+  const to = { list: ['e', 'a', 'b', 'c', 'd'] };
+  const patch = assertRoundTrip(from, to);
+  assert.equal(patch.length, 2);
+  assert.ok(patch.every((operation) => operation.op === 'add' || operation.op === 'remove' || operation.op === 'move'));
+  assert.ok(patch.every((operation) => !('value' in operation) || operation.value === 'e'));
+});
+
+test('an item moved to the front of a long array does not rewrite the items around it', () => {
+  const items = Array.from({ length: 200 }, (_, i) => `item-${i}`);
+  const to = ['item-150', ...items.filter((item) => item !== 'item-150')];
+  const patch = assertRoundTrip({ list: items }, { list: to });
+  assert.ok(JSON.stringify(patch).length < 100);
+});
+
+test('an array item changed in place is patched within the item', () => {
+  const from = { users: [{ id: 1, name: 'Ada', tags: ['x'] }, { id: 2, name: 'Grace' }] };
+  const to = { users: [{ id: 1, name: 'Ada', tags: ['x'] }, { id: 2, name: 'Grace Hopper' }] };
+  assert.deepEqual(assertRoundTrip(from, to), [{ op: 'replace', path: '/users/1/name', value: 'Grace Hopper' }]);
+});
+
+test('an array of objects with one field changed in a long array is a small patch', () => {
+  const from = { rows: Array.from({ length: 300 }, (_, i) => ({ id: i, label: `row ${i}`, done: false })) };
+  const to = structuredClone(from);
+  to.rows[120].done = true;
+  const patch = assertRoundTrip(from, to);
+  assert.deepEqual(patch, [{ op: 'replace', path: '/rows/120/done', value: true }]);
+});
+
+test('an array item replaced by an unrelated value is replaced whole', () => {
+  assertRoundTrip({ list: [{ a: 1 }, 'x'] }, { list: [{ a: 1 }, 42] });
+  assertRoundTrip({ list: [[1, 2]] }, { list: [{ 0: 1 }] });
+});
+
+test('replacing an array with another array', () => {
+  assertRoundTrip({ list: [1, 2, 3] }, { list: [3, 2, 1] });
+  assertRoundTrip({ list: [] }, { list: [1, [2, 3]] });
+  assertRoundTrip({ list: [1, [2, 3]] }, { list: [] });
+});
+
+test('nested arrays and objects round-trip', () => {
+  assertRoundTrip(
+    { a: [[1, 2], { b: [3, { c: 4 }] }], d: null },
+    { a: [[1, 9], { b: [{ c: 4 }, 3] }, 'new'], d: { e: true } },
+  );
+});
+
+test('a member named __proto__ is an ordinary member', () => {
+  const from = JSON.parse('{"__proto__": {"x": 1}, "a": 1}');
+  const to = JSON.parse('{"__proto__": {"x": 2}}');
+  const patch = assertRoundTrip(from, to);
+  assert.deepEqual(patch, [
+    { op: 'remove', path: '/a' },
+    { op: 'replace', path: '/__proto__/x', value: 2 },
+  ]);
+  assert.equal(Object.getPrototypeOf(applyPatch(from, patch)), Object.prototype);
+});
+
+test('the patch shares no mutable structure with the inputs', () => {
+  const from = { a: { b: [1] } };
+  const to = { a: { b: [2] }, c: { d: 'new' } };
+  const patch = createPatch(from, to);
+  const added = patch.find((operation) => operation.path === '/c');
+  assert.ok(added && added.op === 'add');
+  (added.value as { d: string }).d = 'changed';
+  assert.deepEqual(to.c, { d: 'new' });
+});
+
+test('the inputs are not mutated', () => {
+  const from = { list: [1, 2, { a: 'x' }], gone: true };
+  const to = { list: [2, { a: 'y' }, 3], fresh: { deep: [1] } };
+  const before = structuredClone({ from, to });
+  createPatch(deepFreeze(from), deepFreeze(to));
+  assert.deepEqual({ from, to }, before);
+});
+
+test('an input that is not a JSON value throws', () => {
+  assert.throws(() => createPatch({ a: undefined } as never, { a: 1 }));
+  assert.throws(() => createPatch({ a: 1 }, { a: Number.NaN }));
+  assert.throws(() => createPatch({ a: 1 }, { a: new Date(0) } as never));
+  assert.throws(() => createPatch([1, , 3] as never, [1]));
+  const cyclic: { self?: unknown } = {};
+  cyclic.self = cyclic;
+  assert.throws(() => createPatch({ a: 1 }, cyclic as never));
+});
