@@ -0,0 +1,292 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch } from '../src/index.ts';
+
+// Each test below freezes the input and patch it applies, so that any mutation shows up as a failure.
+function deepFreeze<T>(value: T): T {
+  if (value !== null && typeof value === 'object') {
+    for (const child of Object.values(value)) deepFreeze(child);
+    Object.freeze(value);
+  }
+  return value;
+}
+
+test('add sets a new object member', () => {
+  const result = applyPatch({ a: 1 }, [{ op: 'add', path: '/b', value: 2 }]);
+  assert.deepEqual(result, { a: 1, b: 2 });
+});
+
+test('add replaces an existing object member', () => {
+  const result = applyPatch({ a: 1 }, [{ op: 'add', path: '/a', value: 'new' }]);
+  assert.deepEqual(result, { a: 'new' });
+});
+
+test('add inserts into an array at the index, shifting later elements', () => {
+  const result = applyPatch({ list: ['a', 'c'] }, [{ op: 'add', path: '/list/1', value: 'b' }]);
+  assert.deepEqual(result, { list: ['a', 'b', 'c'] });
+});
+
+test('add with "-" appends to an array', () => {
+  const result = applyPatch({ list: ['a'] }, [{ op: 'add', path: '/list/-', value: 'b' }]);
+  assert.deepEqual(result, { list: ['a', 'b'] });
+});
+
+test('add at an index equal to the length of an array appends', () => {
+  const result = applyPatch({ list: ['a'] }, [{ op: 'add', path: '/list/1', value: 'b' }]);
+  assert.deepEqual(result, { list: ['a', 'b'] });
+});
+
+test('add with the empty path replaces the whole document', () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: 'add', path: '', value: [1] }]), [1]);
+});
+
+test('add accepts "-" as an ordinary object member name', () => {
+  assert.deepEqual(applyPatch({}, [{ op: 'add', path: '/-', value: 1 }]), { '-': 1 });
+});
+
+test('add sets an own "__proto__" member without changing the prototype', () => {
+  const result = applyPatch({}, [{ op: 'add', path: '/__proto__', value: { polluted: true } }]) as object;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(Object.hasOwn(result, '__proto__'), true);
+  assert.equal(({} as { polluted?: boolean }).polluted, undefined);
+});
+
+test('add fails when the parent does not exist', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'add', path: '/missing/x', value: 1 }]));
+});
+
+test('add fails past the end of an array', () => {
+  assert.throws(() => applyPatch({ list: ['a'] }, [{ op: 'add', path: '/list/2', value: 'b' }]));
+});
+
+test('add fails when the index is not an array index', () => {
+  assert.throws(() => applyPatch({ list: ['a'] }, [{ op: 'add', path: '/list/01', value: 'b' }]));
+  assert.throws(() => applyPatch({ list: ['a'] }, [{ op: 'add', path: '/list/x', value: 'b' }]));
+});
+
+test('add fails when the parent is a primitive', () => {
+  assert.throws(() => applyPatch({ a: 'text' }, [{ op: 'add', path: '/a/b', value: 1 }]));
+});
+
+test('remove deletes an object member', () => {
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: 'remove', path: '/a' }]), { b: 2 });
+});
+
+test('remove deletes an array element', () => {
+  assert.deepEqual(applyPatch({ list: ['a', 'b', 'c'] }, [{ op: 'remove', path: '/list/1' }]), {
+    list: ['a', 'c'],
+  });
+});
+
+test('remove fails when the target does not exist', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'remove', path: '/b' }]));
+  assert.throws(() => applyPatch({ list: ['a'] }, [{ op: 'remove', path: '/list/1' }]));
+});
+
+test('remove fails with "-" as the target', () => {
+  assert.throws(() => applyPatch({ list: ['a'] }, [{ op: 'remove', path: '/list/-' }]));
+});
+
+test('remove fails with the empty path', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'remove', path: '' }]));
+});
+
+test('replace overwrites an existing value', () => {
+  assert.deepEqual(applyPatch({ a: 1, list: ['x'] }, [{ op: 'replace', path: '/a', value: null }]), {
+    a: null,
+    list: ['x'],
+  });
+  assert.deepEqual(applyPatch({ list: ['x', 'y'] }, [{ op: 'replace', path: '/list/0', value: 'z' }]), {
+    list: ['z', 'y'],
+  });
+});
+
+test('replace with the empty path replaces the whole document', () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: 'replace', path: '', value: 'text' }]), 'text');
+});
+
+test('replace fails when the target does not exist', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'replace', path: '/b', value: 2 }]));
+  assert.throws(() => applyPatch({ list: ['x'] }, [{ op: 'replace', path: '/list/1', value: 'y' }]));
+});
+
+test('move relocates an object member', () => {
+  const result = applyPatch({ a: { x: 1 }, b: 2 }, [{ op: 'move', from: '/a', path: '/c' }]);
+  assert.deepEqual(result, { b: 2, c: { x: 1 } });
+});
+
+test('move from an array element to another position', () => {
+  const result = applyPatch({ list: ['a', 'b', 'c'] }, [{ op: 'move', from: '/list/0', path: '/list/2' }]);
+  assert.deepEqual(result, { list: ['b', 'c', 'a'] });
+});
+
+test('move onto its own location leaves the document unchanged', () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: 'move', from: '/a', path: '/a' }]), { a: 1 });
+});
+
+test('move fails when the source does not exist', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'move', from: '/b', path: '/c' }]));
+});
+
+test('move fails when the target is inside the source', () => {
+  assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: 'move', from: '/a', path: '/a/b/c' }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'move', from: '', path: '/x' }]));
+});
+
+test('copy duplicates a value at a new location', () => {
+  const result = applyPatch({ a: { x: [1] } }, [{ op: 'copy', from: '/a', path: '/b' }]);
+  assert.deepEqual(result, { a: { x: [1] }, b: { x: [1] } });
+});
+
+test('copy yields a value that shares no structure with its source', () => {
+  const result = applyPatch({ a: { x: [1] } }, [
+    { op: 'copy', from: '/a', path: '/b' },
+    { op: 'add', path: '/b/x/-', value: 2 },
+  ]) as { a: { x: number[] }; b: { x: number[] } };
+  assert.deepEqual(result.a, { x: [1] });
+  assert.deepEqual(result.b, { x: [1, 2] });
+});
+
+test('copy fails when the source does not exist', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'copy', from: '/b', path: '/c' }]));
+});
+
+test('test succeeds when the value is deeply equal', () => {
+  const document = { a: { list: [1, { k: null }], s: 'x' } };
+  const patch = [
+    { op: 'test', path: '/a', value: { list: [1, { k: null }], s: 'x' } },
+    { op: 'test', path: '/a/list/1/k', value: null },
+  ] as const;
+  assert.deepEqual(applyPatch(document, patch as never), document);
+});
+
+test('test fails when the value differs', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'test', path: '/a', value: 2 }]));
+  assert.throws(() => applyPatch({ a: 0 }, [{ op: 'test', path: '/a', value: false }]));
+  assert.throws(() => applyPatch({ a: [1, 2] }, [{ op: 'test', path: '/a', value: [2, 1] }]));
+  assert.throws(() => applyPatch({ a: { x: 1 } }, [{ op: 'test', path: '/a', value: { x: 1, y: 2 } }]));
+});
+
+test('test fails when the target does not exist', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'test', path: '/b', value: null }]));
+});
+
+test('operations apply in order, each seeing the result of the previous ones', () => {
+  const result = applyPatch({ list: [] as number[] }, [
+    { op: 'add', path: '/list/-', value: 1 },
+    { op: 'add', path: '/list/-', value: 2 },
+    { op: 'move', from: '/list/0', path: '/first' },
+    { op: 'test', path: '/first', value: 1 },
+  ]);
+  assert.deepEqual(result, { list: [2], first: 1 });
+});
+
+test('a failing operation makes the whole patch fail', () => {
+  assert.throws(() =>
+    applyPatch({ a: 1 }, [
+      { op: 'replace', path: '/a', value: 2 },
+      { op: 'remove', path: '/missing' },
+    ]),
+  );
+});
+
+test('the input document and the patch are never mutated', () => {
+  const document = deepFreeze({ a: [1, { b: 2 }], c: 'x' });
+  const patch = deepFreeze([
+    { op: 'add', path: '/a/-', value: { new: true } },
+    { op: 'move', from: '/a/0', path: '/d' },
+    { op: 'copy', from: '/a/0', path: '/e' },
+    { op: 'replace', path: '/c', value: 'y' },
+    { op: 'remove', path: '/d' },
+  ]);
+  const snapshot = JSON.stringify(document);
+  const patchSnapshot = JSON.stringify(patch);
+
+  const result = applyPatch(document, patch);
+
+  assert.deepEqual(result, { a: [{ b: 2 }, { new: true }], c: 'y', e: { b: 2 } });
+  assert.equal(JSON.stringify(document), snapshot);
+  assert.equal(JSON.stringify(patch), patchSnapshot);
+});
+
+test('the result shares no mutable structure with the input or the patch', () => {
+  const document = { a: { x: 1 } };
+  const patch = [{ op: 'add', path: '/b', value: { y: [1] } }] as const;
+  const result = applyPatch(document, patch as never) as { a: { x: number }; b: { y: number[] } };
+
+  result.a.x = 2;
+  result.b.y.push(2);
+
+  assert.deepEqual(document, { a: { x: 1 } });
+  assert.deepEqual(patch[0].value, { y: [1] });
+});
+
+test('a patch that changes nothing returns an equal new value', () => {
+  const document = { a: 1 };
+  const result = applyPatch(document, []);
+  assert.deepEqual(result, document);
+  assert.notEqual(result, document);
+});
+
+test('a patch that is not an array is invalid', () => {
+  assert.throws(() => applyPatch({ a: 1 }, { op: 'remove', path: '/a' } as never));
+  assert.throws(() => applyPatch({ a: 1 }, undefined as never));
+});
+
+test('an operation that is not an object is invalid', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [null] as never));
+  assert.throws(() => applyPatch({ a: 1 }, [['remove', '/a']] as never));
+});
+
+test('an unknown "op" is invalid', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'rename', path: '/a' }] as never));
+  assert.throws(() => applyPatch({ a: 1 }, [{ path: '/a' }] as never));
+});
+
+test('a missing or non-string "path" is invalid', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'remove' }] as never));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'remove', path: 1 }] as never));
+});
+
+test('a "path" that is not a valid JSON Pointer is invalid', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'remove', path: 'a' }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'remove', path: '/a~2' }]));
+});
+
+test('add, replace and test without "value" are invalid', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'add', path: '/b' }] as never));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'replace', path: '/a' }] as never));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'test', path: '/a' }] as never));
+});
+
+test('move and copy without a valid "from" are invalid', () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'move', path: '/b' }] as never));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: 'copy', from: 'a', path: '/b' }]));
+});
+
+test('an invalid patch changes nothing, even when its first operations are valid', () => {
+  const document = { a: 1 };
+  assert.throws(() =>
+    applyPatch(document, [
+      { op: 'replace', path: '/a', value: 2 },
+      { op: 'bogus', path: '/a' },
+    ] as never),
+  );
+  assert.deepEqual(document, { a: 1 });
+});
+
+test('null, false, 0 and the empty string are values, not missing', () => {
+  const document = { n: null, f: false, z: 0, s: '' };
+  assert.deepEqual(applyPatch(document, [{ op: 'copy', from: '/n', path: '/n2' }]), {
+    ...document,
+    n2: null,
+  });
+  assert.deepEqual(applyPatch(document, [{ op: 'test', path: '/f', value: false }]), document);
+  assert.deepEqual(applyPatch(document, [{ op: 'remove', path: '/z' }]), { n: null, f: false, s: '' });
+  assert.deepEqual(applyPatch(document, [{ op: 'move', from: '/s', path: '/t' }]), {
+    n: null,
+    f: false,
+    z: 0,
+    t: '',
+  });
+});
