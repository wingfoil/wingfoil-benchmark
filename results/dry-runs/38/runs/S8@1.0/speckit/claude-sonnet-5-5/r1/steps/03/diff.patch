+
+describe('input validation', () => {
+  const invalid = (r: { ok: boolean; error?: { code: string } }) => {
+    assert.equal(r.ok, false);
+    assert.equal(r.error?.code, 'invalid-input');
+  };
+
+  it('rejects bad input and leaves the list unchanged', () => {
+    const list = createTodoList();
+    invalid(list.add({ title: '   ' }));
+    invalid(list.add({ title: 'x'.repeat(121) }));
+    invalid(list.add({ title: 'ok', priority: 'urgent' as never }));
+    invalid(list.add({ title: 'ok', tags: ['a b'] }));
+    invalid(list.add({ title: 'ok', tags: [''] }));
+    assert.equal(list.list().length, 0);
+    valueOf(list.add({ title: 'x'.repeat(120) }));
+    const task = valueOf(list.add({ title: 'Real' }));
+    assert.equal(task.id, 'task-2');
+    invalid(list.rename('Real', ' '));
+    invalid(list.rename('Real', 'y'.repeat(121)));
+    invalid(list.tag('Real', 'two words'));
+    invalid(list.tag('Real', ''));
+    assert.deepEqual(valueOf(list.find('Real')), task);
+  });
+});
