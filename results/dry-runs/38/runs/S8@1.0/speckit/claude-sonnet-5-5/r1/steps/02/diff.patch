+
+describe('task timestamps', () => {
+  it('sets createdAt and updatedAt together, and updatedAt on every change', () => {
+    let tick = 0;
+    const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)).toISOString());
+    const added = valueOf(list.add({ title: 'a' }));
+    assert.equal(added.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(added.updatedAt, added.createdAt);
+    const steps = [
+      () => list.complete('a'),
+      () => list.reopen('a'),
+      () => list.rename('a', 'b'),
+      () => list.tag('b', 't'),
+      () => list.untag('b', 't'),
+    ];
+    let last = added.updatedAt;
+    for (const step of steps) {
+      const task = valueOf(step());
+      assert.equal(task.createdAt, added.createdAt);
+      assert.ok(task.updatedAt > last);
+      last = task.updatedAt;
+    }
+  });
+
+  it('leaves updatedAt alone when a change fails', () => {
+    const list = createTodoList();
+    const added = valueOf(list.add({ title: 'a' }));
+    assert.equal(list.reopen('a').ok, false);
+    assert.equal(valueOf(list.get(added.id)).updatedAt, added.updatedAt);
+  });
+});
