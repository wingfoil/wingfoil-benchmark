+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('imports valid lines, skips blank ones and reports rejected ones by line number', () => {
+    const list = createTodoList();
+    const report = importTasks(
+      list,
+      'Renew the insurance;high;admin money\n\nBuy milk\r\nCall;urgent;x\n;;\nBuy milk;;\na;b;c;d',
+    );
+    assert.equal(report.imported, 2);
+    assert.deepEqual(
+      report.rejected.map((r) => r.line),
+      [4, 5, 6, 7],
+    );
+    const insurance = list.list({ tag: 'money' });
+    assert.equal(insurance[0]?.priority, 'high');
+    assert.deepEqual(insurance[0]?.tags, ['admin', 'money']);
+    assert.equal(list.find('Buy milk').ok, true);
+  });
+});
