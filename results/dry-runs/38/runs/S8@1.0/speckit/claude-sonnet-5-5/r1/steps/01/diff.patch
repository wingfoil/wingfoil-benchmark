+
+describe('task ids', () => {
+  it('gives each task a distinct id that survives rename and is never reused', () => {
+    const list = createTodoList();
+    const a = valueOf(list.add({ title: 'a' }));
+    const b = valueOf(list.add({ title: 'b' }));
+    assert.notEqual(a.id, b.id);
+    valueOf(list.rename(a.id, 'a2'));
+    assert.equal(valueOf(list.get(a.id)).title, 'a2');
+    valueOf(list.remove(b.id));
+    assert.equal(list.get(b.id).ok, false);
+    const c = valueOf(list.add({ title: 'c' }));
+    assert.notEqual(c.id, b.id);
+  });
+
+  it('accepts an id wherever a title is taken', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'a' }));
+    assert.equal(valueOf(list.tag(id, 't')).tags[0], 't');
+    assert.equal(valueOf(list.untag(id, 't')).tags.length, 0);
+    assert.equal(valueOf(list.complete(id)).status, 'done');
+    assert.equal(valueOf(list.reopen(id)).status, 'open');
+    assert.equal(valueOf(list.find(id)).title, 'a');
+    assert.equal(valueOf(list.remove(id)).title, 'a');
+    assert.equal(list.find(id).ok, false);
+  });
+
+  it('refuses a rename by id onto another title', () => {
+    const list = createTodoList();
+    const { id } = valueOf(list.add({ title: 'a' }));
+    list.add({ title: 'b' });
+    const r = list.rename(id, 'b');
+    assert.equal(r.ok === false && r.error.code, 'duplicate');
+  });
+});
