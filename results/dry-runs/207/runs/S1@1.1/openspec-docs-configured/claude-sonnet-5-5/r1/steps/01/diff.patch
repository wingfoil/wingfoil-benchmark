+/**
+ * JSON Pointer, RFC 6901.
+ */
+
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/** RFC 6901 section 4: "~1" is decoded before "~0"; any other use of "~" is invalid. */
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/**
+ * Returns the value that `pointer` (RFC 6901 string representation) refers to in `document`.
+ * Throws if the pointer is syntactically invalid or does not resolve to a value of the document.
+ * The document is never modified; the returned value is the referenced part itself, not a copy.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: not a string");
+  }
+  if (pointer === "") return document; // section 5: whole document
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+
+  // Validate every token before resolving, so syntax errors are reported consistently.
+  const tokens = pointer.slice(1).split("/").map(unescapeToken);
+
+  let current: unknown = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      // section 4: index is "0" or digits without leading zeros; "-" is past the end (nonexistent)
+      if (!ARRAY_INDEX.test(token)) {
+        throw new Error(`JSON Pointer does not resolve: "${token}" is not a valid array index`);
+      }
+      const index = Number(token);
+      if (!Number.isSafeInteger(index) || index >= current.length) {
+        throw new Error(`JSON Pointer does not resolve: index ${token} out of range`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      // Own properties only: "__proto__", "constructor", etc. must not reach the prototype chain.
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(`JSON Pointer does not resolve: no member "${token}"`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer does not resolve: cannot descend into a scalar at "${token}"`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7dd7bb4cd7fe56e302c8874b346d5c7eb54d7681
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,110 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// The RFC 6901 section 5 example document.
+const doc = JSON.parse(`{
+  "foo": ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\\\j": 5,
+  "k\\"l": 6,
+  " ": 7,
+  "m~n": 8
+}`);
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("escape order: ~01 decodes to ~1, not /", () => {
+  assert.equal(resolvePointer({ "~1": "a", "/": "b" }, "/~01"), "a");
+});
+
+test("null, false, 0 and empty string values are returned", () => {
+  const d = { n: null, f: false, z: 0, s: "" };
+  assert.equal(resolvePointer(d, "/n"), null);
+  assert.equal(resolvePointer(d, "/f"), false);
+  assert.equal(resolvePointer(d, "/z"), 0);
+  assert.equal(resolvePointer(d, "/s"), "");
+});
+
+test("scalar and null documents", () => {
+  assert.equal(resolvePointer(null, ""), null);
+  assert.equal(resolvePointer(5, ""), 5);
+  assert.throws(() => resolvePointer(5, "/a"));
+  assert.throws(() => resolvePointer(null, "/a"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer({ a: "str" }, "/a/0"));
+  assert.throws(() => resolvePointer({ a: "str" }, "/a/length"));
+});
+
+test("arrays: indices", () => {
+  const d = [10, [20, 30]];
+  assert.equal(resolvePointer(d, "/0"), 10);
+  assert.equal(resolvePointer(d, "/1/1"), 30);
+  assert.throws(() => resolvePointer(d, "/2"), /out of range/);
+  assert.throws(() => resolvePointer(d, "/-"));
+  assert.throws(() => resolvePointer(d, "/01"));
+  assert.throws(() => resolvePointer(d, "/+1"));
+  assert.throws(() => resolvePointer(d, "/-1"));
+  assert.throws(() => resolvePointer(d, "/1.0"));
+  assert.throws(() => resolvePointer(d, "/"));
+  assert.throws(() => resolvePointer(d, "/length"));
+  assert.throws(() => resolvePointer(d, "/99999999999999999999"));
+});
+
+test("objects: '-' and numeric tokens are plain member names", () => {
+  assert.equal(resolvePointer({ "-": 1, "0": 2, "01": 3 }, "/-"), 1);
+  assert.equal(resolvePointer({ "0": 2, "01": 3 }, "/01"), 3);
+});
+
+test("missing members throw", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+  assert.throws(() => resolvePointer({ a: { b: 1 } }, "/a/c"));
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/"));
+});
+
+test("invalid pointer syntax throws", () => {
+  assert.throws(() => resolvePointer(doc, "foo"), /Invalid JSON Pointer/);
+  assert.throws(() => resolvePointer(doc, "#/foo"), /Invalid JSON Pointer/);
+  assert.throws(() => resolvePointer({ "~": 1 }, "/~"), /Invalid JSON Pointer/);
+  assert.throws(() => resolvePointer({ "~2": 1 }, "/~2"), /Invalid JSON Pointer/);
+  assert.throws(() => resolvePointer({ a: 1 }, "/a~"), /Invalid JSON Pointer/);
+  // Syntax is validated even if resolution would fail earlier.
+  assert.throws(() => resolvePointer({}, "/x/~"), /Invalid JSON Pointer/);
+  assert.throws(() => resolvePointer(doc, undefined as unknown as string), /Invalid JSON Pointer/);
+});
+
+test("hostile keys: prototype chain is never reached", () => {
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer({}, "/constructor"));
+  assert.throws(() => resolvePointer({}, "/constructor/prototype"));
+  assert.throws(() => resolvePointer({ a: {} }, "/a/toString"));
+  assert.throws(() => resolvePointer({}, "/__proto__/polluted"));
+  // A genuine own "__proto__" member (as produced by JSON.parse) resolves.
+  const parsed = JSON.parse('{"__proto__": {"x": 1}}');
+  assert.equal(resolvePointer(parsed, "/__proto__/x"), 1);
+  assert.equal(({} as Record<string, unknown>).x, undefined);
+});
+
+test("document is not mutated", () => {
+  const d = JSON.parse('{"a":[1,{"b":2}]}');
+  const copy = structuredClone(d);
+  resolvePointer(d, "/a/1/b");
+  assert.deepEqual(d, copy);
+});
