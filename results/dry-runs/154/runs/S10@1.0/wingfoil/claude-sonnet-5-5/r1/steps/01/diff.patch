@@ -0,0 +1,35 @@
+import { formatEuros } from './money.ts';
+import type { Cents } from './money.ts';
+
+/** `WELCOME5` takes this much off the items. */
+const WELCOME_OFF_CENTS: Cents = 500;
+
+/** `WELCOME5` needs items of at least this amount. */
+const WELCOME_FROM_CENTS: Cents = 3000;
+
+/**
+ * Why a code cannot be used on an order whose items come to this amount, or `undefined` if it can.
+ *
+ * @param code - the discount code as the customer entered it
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function qualifyCode(code: string, itemsCents: Cents): string | undefined {
+  if (code === 'SPRING10') return undefined;
+  if (code === 'WELCOME5') {
+    return itemsCents >= WELCOME_FROM_CENTS
+      ? undefined
+      : `WELCOME5 needs items of at least ${formatEuros(WELCOME_FROM_CENTS)} €`;
+  }
+  return `${code} is not a discount code`;
+}
+
+/**
+ * What a valid code takes off an order whose items come to this amount; shipping is never discounted.
+ *
+ * @param code - a code that `qualifyCode` accepted
+ * @param itemsCents - what the order's items come to, before any discount
+ */
+export function discountFor(code: string, itemsCents: Cents): Cents {
+  // 10 % of a whole number of cents, a half cent rounded up
+  return code === 'SPRING10' ? Math.floor((itemsCents + 5) / 10) : WELCOME_OFF_CENTS;
+}
