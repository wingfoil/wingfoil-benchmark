+
+describe('discount codes', () => {
+  function ordered(lines: { sku: string; quantity: number }[]) {
+    const shop = stocked();
+    valueOf(shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines }));
+    return shop;
+  }
+
+  it('shows no discount without a code', () => {
+    const shop = ordered([{ sku: 'OIL-1L', quantity: 1 }]);
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 1290, discountCents: 0, shippingCents: 490, totalCents: 1780 });
+  });
+
+  it('takes 10 % off the items with SPRING10, leaving shipping alone', () => {
+    const shop = ordered([{ sku: 'OIL-1L', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 1290, discountCents: 129, shippingCents: 490, totalCents: 1651 });
+  });
+
+  it('rounds a half cent up', () => {
+    const shop = ordered([{ sku: 'APL-1KG', quantity: 1 }, { sku: 'OIL-1L', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 164);
+    const other = ordered([{ sku: 'APL-1KG', quantity: 1 }]);
+    valueOf(other.orders.applyCode(1, 'SPRING10'));
+    assert.equal(valueOf(other.orders.totals(1)).discountCents, 35);
+  });
+
+  it('takes 5.00 off with WELCOME5 from 30.00 of items', () => {
+    const shop = ordered([{ sku: 'OIL-1L', quantity: 3 }]);
+    valueOf(shop.orders.applyCode(1, 'WELCOME5'));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 3870, discountCents: 500, shippingCents: 490, totalCents: 3860 });
+  });
+
+  it('accepts WELCOME5 at exactly 30.00 and refuses it below', () => {
+    const exact = stocked();
+    valueOf(exact.catalogue.add({ sku: 'BOX', name: 'Box', priceCents: 3000 }));
+    valueOf(exact.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'BOX', quantity: 1 }] }));
+    valueOf(exact.orders.applyCode(1, 'WELCOME5'));
+    assert.equal(valueOf(exact.orders.totals(1)).discountCents, 500);
+
+    const small = ordered([{ sku: 'OIL-1L', quantity: 2 }]);
+    valueOf(small.orders.applyCode(1, 'SPRING10'));
+    const refused = small.orders.applyCode(1, 'WELCOME5');
+    assert.equal(refused.ok, false);
+    if (!refused.ok) assert.match(refused.error.message, /30\.00/);
+    assert.equal(valueOf(small.orders.totals(1)).discountCents, 258);
+  });
+
+  it('refuses an unknown code or order and leaves the order as it was', () => {
+    const shop = ordered([{ sku: 'OIL-1L', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    const unknown = shop.orders.applyCode(1, 'SUMMER');
+    assert.equal(unknown.ok, false);
+    if (!unknown.ok) assert.match(unknown.error.message, /SUMMER/);
+    assert.equal(shop.orders.applyCode(9, 'SPRING10').ok, false);
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 129);
+  });
+
+  it('lets a second code replace the first', () => {
+    const shop = ordered([{ sku: 'OIL-1L', quantity: 3 }]);
+    valueOf(shop.orders.applyCode(1, 'WELCOME5'));
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.totals(1)).discountCents, 387);
+  });
+
+  it('decides free shipping on the items before the discount', () => {
+    const shop = ordered([{ sku: 'HAM-W', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(1, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(1)), { itemsCents: 6400, discountCents: 640, shippingCents: 0, totalCents: 5760 });
+  });
+
+  it('counts quantities and the 50.00 boundary when deciding free shipping', () => {
+    const many = ordered([{ sku: 'OIL-1L', quantity: 4 }]);
+    assert.equal(valueOf(many.orders.totals(1)).shippingCents, 0);
+    const exact = stocked();
+    valueOf(exact.catalogue.add({ sku: 'BOX', name: 'Box', priceCents: 5000 }));
+    valueOf(exact.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'BOX', quantity: 1 }] }));
+    assert.equal(valueOf(exact.orders.totals(1)).shippingCents, 0);
+  });
+});
