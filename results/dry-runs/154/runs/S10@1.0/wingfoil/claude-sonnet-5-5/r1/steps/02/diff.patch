@@ -123,5 +141,17 @@ export function createOrderBook(catalogue: Catalogue, customers: Customers): Ord
       codes.set(number, code);
       return ok(order);
     },
+    exportMonth(month) {
+      if (!MONTH.test(month)) throw new RangeError(`${month} is not a month (YYYY-MM)`);
+      const rows = orders
+        .filter((order) => order.date.startsWith(`${month}-`))
+        .map((order) => {
+          const customer = customers.get(order.customerId);
+          const name = customer.ok ? customer.value.name : '';
+          const total = totalsOf(order.number);
+          return [String(order.number), order.date, name, total.ok ? formatEuros(total.value.totalCents) : ''];
