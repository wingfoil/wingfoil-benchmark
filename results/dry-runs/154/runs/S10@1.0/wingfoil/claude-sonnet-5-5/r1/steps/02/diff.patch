+
+describe('monthly export', () => {
+  const HEADER = 'order,date,customer,total';
+
+  it('lists the orders of the month by number, with what the customer pays', () => {
+    const shop = stocked();
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-09-30', lines: [{ sku: 'APL-1KG', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c1', date: '2026-10-31', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    valueOf(shop.orders.applyCode(3, 'SPRING10'));
+    assert.equal(
+      shop.orders.exportMonth('2026-10'),
+      [HEADER, '1,2026-10-02,Mira Holt,17.80', '3,2026-10-31,Mira Holt,57.60'].join('\n'),
+    );
+  });
+
+  it('gives the header alone for a month without orders', () => {
+    assert.equal(stocked().orders.exportMonth('2026-10'), HEADER);
+  });
+
+  it('quotes values with a comma, a quote or a line break', () => {
+    const shop = createShop();
+    valueOf(shop.catalogue.add({ sku: 'A', name: 'A', priceCents: 5000 }));
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, Mira "M"\nX', email: 'm@example.org', phone: '555-0102' }));
+    shop.orders.place({ customerId: 'c2', date: '2026-10-02', lines: [{ sku: 'A', quantity: 1 }] });
+    assert.equal(shop.orders.exportMonth('2026-10'), `${HEADER}\n1,2026-10-02,"Holt, Mira ""M""\nX",50.00`);
+  });
+
+  it('refuses a month that is not YYYY-MM', () => {
+    const shop = stocked();
+    for (const bad of ['2026-13', '2026-1', '10-2026', '2026-10-02', '']) assert.throws(() => shop.orders.exportMonth(bad), RangeError);
+  });
+});
