diff --git a/test/rental.test.ts b/test/rental.test.ts
index f95e5fcb7fa01ed7ccfa34299515de3622941ba8..08e9130f349ed3e6dc79fa121068d5e10fc514cc 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -74,4 +74,45 @@ describe('rental service', () => {
     service.quote(week);
     assert.doesNotThrow(() => service.book(week));
   });
+
+  describe('availability', () => {
+    const query = { start: week.start, end: week.end };
+
+    beforeEach(() => {
+      service.addEquipment({ id: 's2', kind: 'sail', dailyPrice: 1000 });
+      service.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 2000 });
+    });
+
+    it('lists the free items of every kind, sorted', () => {
+      assert.deepEqual(service.availability(query), ['a0', 'b1', 's2']);
+    });
+
+    it('filters by kind', () => {
+      assert.deepEqual(service.availability({ ...query, kind: 'board' }), ['a0', 'b1']);
+      assert.deepEqual(service.availability({ ...query, kind: 'sail' }), ['s2']);
+    });
+
+    it('leaves out items booked during any part of the period', () => {
+      service.book({ ...week, start: '2026-07-03T00:00:00Z', end: '2026-07-10T00:00:00Z' });
+      assert.deepEqual(service.availability(query), ['a0', 's2']);
+    });
+
+    it('keeps items whose bookings only touch the period', () => {
+      service.book({ ...week, start: '2026-06-28T00:00:00Z', end: week.start });
+      service.book({ ...week, itemId: 'a0', start: week.end, end: '2026-07-06T00:00:00Z' });
+      assert.deepEqual(service.availability(query), ['a0', 'b1', 's2']);
+    });
+
+    it('returns nothing when no item is free or of that kind', () => {
+      service.book(week);
+      assert.deepEqual(service.availability({ ...query, kind: 'board' }), ['a0']);
+      assert.deepEqual(createRentalService().availability(query), []);
+    });
+
+    it('rejects an invalid period or kind', () => {
+      assert.throws(() => service.availability({ ...query, start: '2026-07-01T10:00:00Z' }), /midnight/);
+      assert.throws(() => service.availability({ ...query, end: query.start }), /after start/);
+      assert.throws(() => service.availability({ ...query, kind: 'kayak' as 'board' }), /kind/);
+    });
+  });
 });
