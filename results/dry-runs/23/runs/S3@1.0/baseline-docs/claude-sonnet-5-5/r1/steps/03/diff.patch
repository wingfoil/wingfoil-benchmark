+/** Applies the long-stay discount: 10% off from 3 days, in integer cents rounded half up. */
+function longStayTotal(days: number, fullPrice: number): number {
+  return days >= LONG_STAY_DAYS ? Math.floor((fullPrice * 9 + 5) / 10) : fullPrice;
+}
