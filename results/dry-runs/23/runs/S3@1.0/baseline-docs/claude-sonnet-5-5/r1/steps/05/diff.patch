+
+  describe('cancellation', () => {
+    it('refunds the full total at least 24 hours before the start', () => {
+      const booking = service.book(week);
+      assert.deepEqual(service.cancel(booking.id, '2026-06-30T00:00:00Z'), { bookingId: booking.id, refund: 6885 });
+    });
+
+    it('refunds nothing less than 24 hours before the start or after it', () => {
+      const first = service.book(week);
+      assert.equal(service.cancel(first.id, '2026-06-30T00:00:01Z').refund, 0);
+      const second = service.book(week);
+      assert.equal(service.cancel(second.id, '2026-07-02T00:00:00Z').refund, 0);
+    });
+
+    it('frees the equipment', () => {
+      const booking = service.book(week);
+      service.cancel(booking.id, '2026-06-01T00:00:00Z');
+      assert.deepEqual(service.availability(week), ['b1']);
+      assert.doesNotThrow(() => service.book(week));
+    });
+
+    it('only cancels a booking once', () => {
+      const booking = service.book(week);
+      service.cancel(booking.id, '2026-06-01T00:00:00Z');
+      assert.throws(() => service.cancel(booking.id, '2026-06-01T00:00:00Z'), /Unknown booking/);
+    });
+
+    it('rejects an unknown booking and an invalid time', () => {
+      assert.throws(() => service.cancel('booking-9', '2026-06-01T00:00:00Z'), /Unknown booking/);
+      const booking = service.book(week);
+      assert.throws(() => service.cancel(booking.id, 'yesterday'), /ISO-8601/);
+    });
+  });
