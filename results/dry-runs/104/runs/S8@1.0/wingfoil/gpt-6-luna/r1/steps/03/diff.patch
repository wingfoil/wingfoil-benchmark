 import { err, ok } from './result.ts';
 import type { Result } from './result.ts';
 import { addTag, compareTasks, completeTask, createTask, removeTag, renameTask, reopenTask } from './task.ts';
+import { PRIORITIES } from './task.ts';
 import type { NewTask, Priority, Status, Task } from './task.ts';
 
+function validateTitle(title: string): Result<string> {
+  const normalized = title.trim();
+  if (normalized.length === 0) return err('invalid-input', 'a task title must not be empty');
+  if (normalized.length > 120) return err('invalid-input', 'a task title must be 120 characters or fewer');
+  return ok(normalized);
+}
+
+function validateTag(tag: string): Result<string> {
+  if (tag.length === 0) return err('invalid-input', 'a tag must not be empty');
+  if (/\s/.test(tag)) return err('invalid-input', 'a tag must not contain spaces');
+  return ok(tag);
+}
+
