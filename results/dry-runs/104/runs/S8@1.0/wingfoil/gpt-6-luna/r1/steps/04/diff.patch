 export type { TaskFilter, TaskList } from './domain/list.ts';
 export type { Result, TodoError, TodoErrorCode } from './domain/result.ts';
@@ -14,3 +15,52 @@ export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 export function createTodoList(): TaskList {
   return createTaskList();
 }
+
+/** A source line that could not be imported into a task list. */
+export interface ImportRejection {
+  /** The 1-based line number in the supplied text. */
+  readonly line: number;
+  /** Why the line could not be added. */
+  readonly reason: string;
+}
+
+/** The counts and line-level failures from importing tasks. */
+export interface ImportTasksResult {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
+/**
+ * Imports tasks from semicolon-separated lines, skipping blank lines and reporting invalid rows.
+ * Each nonblank row has the form `title;priority;tags`; priority may be empty and tags are
+ * separated by spaces.
+ *
+ * @param list - the list to add tasks to
+ * @param text - task rows to parse, one per line
+ */
+export function importTasks(list: TaskList, text: string): ImportTasksResult {
+  let imported = 0;
+  const rejected: ImportRejection[] = [];
+
+  text.split(/\r?\n/).forEach((sourceLine, index) => {
+    if (sourceLine.trim().length === 0) return;
+
+    const fields = sourceLine.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'expected title;priority;tags' });
+      return;
+    }
+
+    const [title, rawPriority, rawTags] = fields;
+    const priority = rawPriority.trim();
+    const result = list.add({
+      title,
+      ...(priority.length === 0 ? {} : { priority: priority as Priority }),
+      tags: rawTags.trim().length === 0 ? [] : rawTags.trim().split(/\s+/),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  });
+
+  return { imported, rejected };
+}
