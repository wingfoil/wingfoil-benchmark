index 0000000000000000000000000000000000000000..2244b8efc38bec3fbf4599115716fd14857f7b8a
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,67 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @param document The JSON document to navigate.
+ * @param pointer A JSON Pointer string.
+ * @returns The value identified by the pointer.
+ * @throws {TypeError} If the pointer is not valid or cannot be resolved.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== 'string') {
+    throw new TypeError('A JSON Pointer must be a string.');
+  }
+
+  if (pointer === '') {
+    return document;
+  }
+
+  if (!pointer.startsWith('/')) {
+    throw new TypeError('A non-empty JSON Pointer must start with a slash.');
+  }
+
+  let value = document;
+
+  for (const encodedToken of pointer.slice(1).split('/')) {
+    const token = decodeReferenceToken(encodedToken);
+    value = resolveReferenceToken(value, token);
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  return token.replace(/~./g, (escapeSequence) => {
+    if (escapeSequence === '~0') {
+      return '~';
+    }
+
+    if (escapeSequence === '~1') {
+      return '/';
+    }
+
+    throw new TypeError(`Invalid JSON Pointer escape sequence: ${escapeSequence}`);
+  }).replace(/~$/, () => {
+    throw new TypeError('Invalid JSON Pointer escape sequence: ~');
+  });
+}
+
+function resolveReferenceToken(value: unknown, token: string): unknown {
+  if (Array.isArray(value)) {
+    if (!/^(?:0|[1-9][0-9]*)$/.test(token)) {
+      throw new TypeError(`Invalid JSON Pointer array index: ${token}`);
+    }
+
+    const index = Number(token);
+    if (!Number.isSafeInteger(index) || index >= value.length || !Object.hasOwn(value, index)) {
+      throw new TypeError(`JSON Pointer does not resolve: array index ${token}`);
+    }
+
+    return value[index];
+  }
+
+  if (value === null || typeof value !== 'object' || !Object.hasOwn(value, token)) {
+    throw new TypeError(`JSON Pointer does not resolve: ${token}`);
+  }
+
+  return (value as Record<string, unknown>)[token];
+}
diff --git a/test/index.test.mjs b/test/index.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..32dd0f07847274edff22a28630d52097a6d8cd66
--- /dev/null
+++ b/test/index.test.mjs
@@ -0,0 +1,41 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { resolvePointer } from '../dist/index.js';
+
+const document = {
+  foo: ['bar', 'baz'],
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k\"l': 6,
+  ' ': 7,
+  'm~n': 8,
+  '': 9,
+};
+
+test('resolves JSON Pointer values, including escaped reference tokens', () => {
+  assert.equal(resolvePointer(document, ''), document);
+  assert.equal(resolvePointer(document, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(document, '/a~1b'), 1);
+  assert.equal(resolvePointer(document, '/m~0n'), 8);
+  assert.equal(resolvePointer(document, '/'), 9);
+});
+
+test('resolves array indices as RFC 6901 decimal tokens', () => {
+  assert.equal(resolvePointer(document, '/foo/1'), 'baz');
+  assert.equal(resolvePointer({ '01': 'object key' }, '/01'), 'object key');
+  assert.throws(() => resolvePointer(document, '/foo/01'));
+  assert.throws(() => resolvePointer(document, '/foo/-'));
+  assert.throws(() => resolvePointer(document, '/foo/2'));
+});
+
+test('rejects invalid pointers and unresolved reference tokens', () => {
+  assert.throws(() => resolvePointer(document, 'foo'));
+  assert.throws(() => resolvePointer(document, '/m~'));
+  assert.throws(() => resolvePointer(document, '/m~2n'));
