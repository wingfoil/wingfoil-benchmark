diff --git a/test/index.test.mjs b/test/index.test.mjs
index f71e0378237922097ee212a1bf93bbc7a25f06ac..ea83fad234552fc65ce5eeac34598babdaeb8ecc 100644
--- a/test/index.test.mjs
+++ b/test/index.test.mjs
@@ -93,3 +93,31 @@ test('rejects malformed patches and failed JSON Patch operations', () => {
   assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: 'move', from: '/a', path: '/a/b/c' }]));
   assert.throws(() => applyPatch({ value: 1 }, [{ op: 'test', path: '/value', value: 2 }]));
 });
+
+test('requires the entire patch document to consist of JSON values', () => {
+  assert.throws(() => applyPatch(
+    { value: 1 },
+    [{ op: 'test', path: '/value', value: 1, extension: () => true }],
+  ));
+  assert.throws(() => applyPatch(
+    { value: 1 },
+    [Object.assign(Object.create({}), { op: 'test', path: '/value', value: 1 })],
+  ));
+
+  assert.deepEqual(
+    applyPatch({ value: 1 }, [{ op: 'test', path: '/value', value: 1, extension: null }]),
+    { value: 1 },
+  );
+});
+
+test('stops at the first failed operation without mutating the input document', () => {
+  const source = { values: [1] };
+
+  assert.throws(() => applyPatch(source, [
+    { op: 'add', path: '/values/-', value: 2 },
+    { op: 'test', path: '/values/0', value: 0 },
+    { op: 'add', path: '/values/-', value: 3 },
+  ]));
+
+  assert.deepEqual(source, { values: [1] });
+});
