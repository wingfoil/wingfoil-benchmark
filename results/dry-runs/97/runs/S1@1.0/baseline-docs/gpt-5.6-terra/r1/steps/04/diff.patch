@@ -1,7 +1,7 @@
 import assert from 'node:assert/strict';
 import test from 'node:test';
 
-import { applyPatch, resolvePointer } from '../dist/index.js';
+import { applyMergePatch, applyPatch, resolvePointer } from '../dist/index.js';
 
 const document = {
   foo: ['bar', 'baz'],
@@ -121,3 +121,62 @@ test('stops at the first failed operation without mutating the input document',
 
   assert.deepEqual(source, { values: [1] });
 });
+
+test('applies RFC 7386 JSON Merge Patch without mutating either input', () => {
+  const target = {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  };
+  const patch = {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  };
+
+  const result = applyMergePatch(target, patch);
+
+  assert.deepEqual(result, {
+    title: 'Hello!',
+    author: { givenName: 'John' },
+    tags: ['example'],
+    content: 'This will be unchanged',
+    phoneNumber: '+01-123-456-7890',
+  });
+  assert.deepEqual(target, {
+    title: 'Goodbye!',
+    author: { givenName: 'John', familyName: 'Doe' },
+    tags: ['example', 'sample'],
+    content: 'This will be unchanged',
+  });
+  assert.deepEqual(patch, {
+    title: 'Hello!',
+    phoneNumber: '+01-123-456-7890',
+    author: { familyName: null },
+    tags: ['example'],
+  });
+  assert.notEqual(result, target);
+  assert.notEqual(result.author, target.author);
+  assert.notEqual(result.tags, patch.tags);
+});
+
+test('uses non-object patches as whole-document replacements', () => {
+  assert.deepEqual(applyMergePatch({ value: true }, ['replacement']), ['replacement']);
+  assert.equal(applyMergePatch(['target'], null), null);
+  assert.deepEqual(applyMergePatch(null, { value: 1 }), { value: 1 });
+  assert.deepEqual(applyMergePatch('target', { value: { nested: true } }), {
+    value: { nested: true },
+  });
+});
+
+test('validates merge-patch documents and safely handles special object keys', () => {
+  assert.throws(() => applyMergePatch({ value: 1 }, { value: Number.NaN }));
+  assert.throws(() => applyMergePatch({ value: 1 }, { value: () => true }));
+
+  assert.deepEqual(
+    applyMergePatch({}, { ['__proto__']: { safe: true } }),
+    { ['__proto__']: { safe: true } },
+  );
+});
