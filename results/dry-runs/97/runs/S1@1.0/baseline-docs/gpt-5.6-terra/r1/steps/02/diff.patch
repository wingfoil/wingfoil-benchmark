+
+test('applies the RFC 6902 operations without mutating the source document', () => {
+  const source = {
+    baz: 'qux',
+    foo: ['bar', 'baz'],
+    object: { copied: false },
+  };
+
+  const result = applyPatch(source, [
+    { op: 'add', path: '/foo/1', value: 'inserted' },
+    { op: 'add', path: '/foo/-', value: 'last' },
+    { op: 'remove', path: '/baz' },
+    { op: 'replace', path: '/object/copied', value: true },
+    { op: 'copy', from: '/foo/0', path: '/object/first' },
+    { op: 'move', from: '/foo/2', path: '/foo/0' },
+    { op: 'test', path: '/object', value: { copied: true, first: 'bar' } },
+  ]);
+
+  assert.deepEqual(result, {
+    foo: ['baz', 'bar', 'inserted', 'last'],
+    object: { copied: true, first: 'bar' },
+  });
+  assert.deepEqual(source, {
+    baz: 'qux',
+    foo: ['bar', 'baz'],
+    object: { copied: false },
+  });
+  assert.notEqual(result, source);
+  assert.notEqual(result.object, source.object);
+});
+
