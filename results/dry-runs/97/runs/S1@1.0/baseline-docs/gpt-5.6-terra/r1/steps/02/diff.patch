+type JsonValue = JsonPrimitive | JsonValue[] | { [key: string]: JsonValue };
+
+type PatchOperationName = 'add' | 'remove' | 'replace' | 'move' | 'copy' | 'test';
+
+interface PatchOperation {
+  op: PatchOperationName;
+  path: string;
+  from?: string;
+  value?: JsonValue;
+}
+
+/**
+ * Applies an RFC 6902 JSON Patch and returns a new JSON document.
+ *
+ * @param document The JSON document to patch.
+ * @param patch The array of JSON Patch operations.
+ * @returns The patched document, with no shared mutable values from `document`.
+ * @throws {TypeError} If the document or patch is invalid, or an operation cannot be applied.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  assertJsonValue(document, 'document');
+
+  if (!Array.isArray(patch)) {
+    throw new TypeError('A JSON Patch must be an array of operations.');
+  }
+
+  let result = cloneJsonValue(document as JsonValue);
+
+  for (const candidate of patch) {
+    const operation = parsePatchOperation(candidate);
+    result = applyOperation(result, operation);
+  }
+
+  return result;
+}
+
+function parsePatchOperation(candidate: unknown): PatchOperation {
+  if (candidate === null || typeof candidate !== 'object' || Array.isArray(candidate)) {
+    throw new TypeError('A JSON Patch operation must be an object.');
+  }
+
+  const record = candidate as Record<string, unknown>;
+  const op = readStringMember(record, 'op');
+  const path = readStringMember(record, 'path');
+
+  if (!isPatchOperationName(op)) {
+    throw new TypeError(`Unsupported JSON Patch operation: ${op}`);
+  }
+
+  parsePointer(path);
+
+  if (op === 'add' || op === 'replace' || op === 'test') {
+    if (!Object.hasOwn(record, 'value')) {
+      throw new TypeError(`JSON Patch ${op} operations require a value.`);
+    }
+    assertJsonValue(record.value, 'JSON Patch value');
+  }
+
+  if (op === 'move' || op === 'copy') {
+    const from = readStringMember(record, 'from');
+    parsePointer(from);
+    return { op, path, from };
+  }
+
+  return { op, path, value: record.value as JsonValue };
