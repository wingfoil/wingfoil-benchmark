+
+function applyOperation(document: JsonValue, operation: PatchOperation): JsonValue {
+  switch (operation.op) {
+    case 'add':
+      return addValue(document, operation.path, cloneJsonValue(operation.value as JsonValue));
+    case 'remove':
+      return removeValue(document, operation.path).document;
+    case 'replace':
+      return replaceValue(document, operation.path, cloneJsonValue(operation.value as JsonValue));
+    case 'copy': {
