+test('creates a compact JSON Patch for nested document changes', () => {
+  const from = {
+    title: 'Draft',
+    settings: { theme: 'light', notifications: true },
+    tags: ['one', 'three'],
+  };
+  const to = {
+    title: 'Draft',
+    settings: { theme: 'dark', notifications: true },
+    tags: ['one', 'two', 'three'],
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'replace', path: '/settings/theme', value: 'dark' },
+    { op: 'add', path: '/tags/1', value: 'two' },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    title: 'Draft',
+    settings: { theme: 'light', notifications: true },
+    tags: ['one', 'three'],
+  });
+  assert.deepEqual(to, {
+    title: 'Draft',
+    settings: { theme: 'dark', notifications: true },
+    tags: ['one', 'two', 'three'],
+  });
+});
+
+test('creates empty, escaped, and root-replacement patches without retaining input values', () => {
+  assert.deepEqual(createPatch({ 'a/b': { 'm~n': 1 } }, { 'a/b': { 'm~n': 2 } }), [
+    { op: 'replace', path: '/a~1b/m~0n', value: 2 },
+  ]);
+  assert.deepEqual(createPatch({ unchanged: true }, { unchanged: true }), []);
+
+  const replacement = { nested: { value: 1 } };
+  const patch = createPatch(null, replacement);
+  replacement.nested.value = 2;
+
+  assert.deepEqual(patch, [{ op: 'replace', path: '', value: { nested: { value: 1 } } }]);
+  assert.deepEqual(applyPatch(null, patch), { nested: { value: 1 } });
+  assert.throws(() => createPatch({ valid: true }, { invalid: Number.NaN }));
+});
