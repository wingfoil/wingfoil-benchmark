+/**
+ * Creates an RFC 6902 JSON Patch that transforms one JSON document into another.
+ *
+ * The generated patch uses the narrowest paths available for object members and
+ * array elements. Its operation values are independent copies, so neither input
+ * is mutated or retained by the result.
+ *
+ * @param from The JSON document to transform.
+ * @param to The desired JSON document.
+ * @returns An RFC 6902 JSON Patch that transforms `from` into `to`.
+ * @throws {TypeError} If either document is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  assertJsonValue(from, 'from document');
+  assertJsonValue(to, 'to document');
+
+  const patch: PatchOperation[] = [];
+  createValuePatch(from, to, '', patch);
+  return patch;
+}
