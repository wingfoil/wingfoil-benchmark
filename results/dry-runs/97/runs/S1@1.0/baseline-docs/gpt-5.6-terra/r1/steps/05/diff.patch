+function findArrayMatches(from: JsonValue[], to: JsonValue[]): Array<readonly [number, number]> {
+  const lengths = Array.from({ length: from.length + 1 }, () => Array<number>(to.length + 1).fill(0));
+
+  for (let fromIndex = from.length - 1; fromIndex >= 0; fromIndex -= 1) {
+    for (let toIndex = to.length - 1; toIndex >= 0; toIndex -= 1) {
+      lengths[fromIndex][toIndex] = jsonEquals(from[fromIndex] as JsonValue, to[toIndex] as JsonValue)
+        ? (lengths[fromIndex + 1][toIndex + 1] as number) + 1
+        : Math.max(lengths[fromIndex + 1][toIndex] as number, lengths[fromIndex][toIndex + 1] as number);
