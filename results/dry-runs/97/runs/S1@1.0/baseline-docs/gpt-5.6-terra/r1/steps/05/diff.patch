+function createValuePatch(from: JsonValue, to: JsonValue, path: string, patch: PatchOperation[]): void {
+  if (jsonEquals(from, to)) {
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    createObjectPatch(from, to, path, patch);
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatch(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: 'replace', path, value: cloneJsonValue(to) });
+}
+
+function createObjectPatch(
+  from: { [key: string]: JsonValue },
+  to: { [key: string]: JsonValue },
+  path: string,
+  patch: PatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      patch.push({ op: 'remove', path: appendPointer(path, key) });
+    }
+  }
+
+  for (const key of Object.keys(to)) {
+    const memberPath = appendPointer(path, key);
+    if (Object.hasOwn(from, key)) {
+      createValuePatch(from[key] as JsonValue, to[key] as JsonValue, memberPath, patch);
+    } else {
+      patch.push({ op: 'add', path: memberPath, value: cloneJsonValue(to[key] as JsonValue) });
+    }
+  }
+}
+
+function createArrayPatch(from: JsonValue[], to: JsonValue[], path: string, patch: PatchOperation[]): void {
+  const matches = findArrayMatches(from, to);
+  let fromIndex = 0;
+  let toIndex = 0;
+  let resultIndex = 0;
+
+  for (const match of [...matches, [from.length, to.length] as const]) {
+    const [matchedFromIndex, matchedToIndex] = match;
+    const pairedLength = Math.min(matchedFromIndex - fromIndex, matchedToIndex - toIndex);
+
+    for (let index = 0; index < pairedLength; index += 1) {
+      createValuePatch(
+        from[fromIndex + index] as JsonValue,
+        to[toIndex + index] as JsonValue,
+        appendPointer(path, String(resultIndex)),
+        patch,
+      );
+      resultIndex += 1;
+    }
+
+    for (let index = fromIndex + pairedLength; index < matchedFromIndex; index += 1) {
+      patch.push({ op: 'remove', path: appendPointer(path, String(resultIndex)) });
+    }
+    for (let index = toIndex + pairedLength; index < matchedToIndex; index += 1) {
+      patch.push({
+        op: 'add',
+        path: appendPointer(path, String(resultIndex)),
+        value: cloneJsonValue(to[index] as JsonValue),
+      });
+      resultIndex += 1;
+    }
