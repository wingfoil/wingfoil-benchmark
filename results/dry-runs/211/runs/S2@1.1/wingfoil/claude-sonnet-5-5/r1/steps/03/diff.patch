+
+describe('cancelling an order with a single-use coupon', () => {
+  it('gives the coupon back so the customer can use it again', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'MUG-01', name: 'Mug', priceCents: 1000, vatClass: 'standard', weightGrams: 300 });
+    s.inventory.restock('MUG-01', 10);
+    s.coupons.add({ code: 'WELCOME', kind: 'percent', value: 10, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = s.orders.place({ customer: 'paolo', date: '2026-03-02', coupon: 'welcome', lines: [{ sku: 'MUG-01', quantity: 1 }] });
+    s.orders.cancel(first.id, '2026-03-02');
+    const second = s.orders.place({ customer: 'paolo', date: '2026-03-02', coupon: 'WELCOME', lines: [{ sku: 'MUG-01', quantity: 1 }] });
+    assert.equal(second.totals.couponDiscountCents, 100);
+  });
+});
+
+describe('free shipping at exactly fifty euros', () => {
+  it('ships an order whose goods come to €50.00 free', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'MUG-01', name: 'Mug', priceCents: 2500, vatClass: 'standard', weightGrams: 300 });
+    s.inventory.restock('MUG-01', 10);
+    const order = s.orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'MUG-01', quantity: 2 }] });
+    assert.equal(order.totals.goodsCents, 5000);
+    assert.equal(order.totals.shippingCents, 0);
+  });
+});
