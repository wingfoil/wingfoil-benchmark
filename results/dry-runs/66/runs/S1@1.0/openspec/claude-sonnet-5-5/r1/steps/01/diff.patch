+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "./index.ts";
+
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("escape ordering", () => {
+  assert.equal(resolvePointer({ "~1": 3 }, "/~01"), 3);
+});
+
+test("falsy values are returned", () => {
+  const d = { a: null, b: false, c: 0, d: "" };
+  for (const [k, v] of Object.entries(d)) assert.equal(resolvePointer(d, "/" + k), v);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("invalid syntax throws", () => {
+  for (const p of ["a/b", "a", "/a~2", "/a~", "/~", "/a/~x"]) {
+    assert.throws(() => resolvePointer({ a: { b: 1 } }, p), p);
+  }
+  assert.throws(() => resolvePointer({}, undefined as any));
+  assert.throws(() => resolvePointer({}, 1 as any));
+});
+
+test("syntax errors win over resolution errors", () => {
+  assert.throws(() => resolvePointer({}, "/missing/~2"), /~/);
+});
+
+test("array indices", () => {
+  const d = { foo: ["a", "b"] };
+  assert.equal(resolvePointer(d, "/foo/1"), "b");
+  for (const p of ["/foo/01", "/foo/+1", "/foo/-1", "/foo/-", "/foo/2", "/foo/x", "/foo/", "/foo/1.0", "/foo/length"]) {
+    assert.throws(() => resolvePointer(d, p), p);
+  }
+});
+
+test("unresolvable pointers throw", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/missing"));
+  assert.throws(() => resolvePointer({}, "/constructor"));
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer({}, "/toString"));
+  for (const v of [1, null, "str", true]) {
+    assert.throws(() => resolvePointer({ a: v }, "/a/b"));
+  }
+});
