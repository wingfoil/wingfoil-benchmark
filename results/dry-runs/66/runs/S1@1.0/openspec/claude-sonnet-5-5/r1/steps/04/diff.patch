--- /dev/null
+++ b/src/merge-patch.ts
@@ -0,0 +1,34 @@
+type Json = unknown;
+
+function isObject(value: unknown): value is Record<string, Json> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function setMember(object: Record<string, Json>, key: string, value: Json): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+// RFC 7386 MergePatch; never mutates or shares structure with its inputs.
+export function applyMergePatch(target: Json, patch: Json): Json {
+  if (!isObject(patch)) return copy(patch);
+  const result: Record<string, Json> = {};
+  if (isObject(target)) {
+    for (const key of Object.keys(target)) setMember(result, key, copy(target[key]));
+  }
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) delete result[key];
+    else setMember(result, key, applyMergePatch(Object.prototype.hasOwnProperty.call(result, key) ? result[key] : undefined, value));
+  }
+  return result;
+}
+
+function copy(value: Json): Json {
+  if (Array.isArray(value)) return value.map(copy);
+  if (isObject(value)) {
+    const out: Record<string, Json> = {};
+    for (const key of Object.keys(value)) setMember(out, key, copy(value[key]));
+    return out;
+  }
+  return value;
+}
