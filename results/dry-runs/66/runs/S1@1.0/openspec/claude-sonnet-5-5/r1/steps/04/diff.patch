+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "./index.ts";
+
+const ok = (t: unknown, p: unknown, e: unknown) => assert.deepEqual(applyMergePatch(t, p), e);
+
+test("RFC 7386 Appendix A examples", () => {
+  ok({ a: "b" }, { a: "c" }, { a: "c" });
+  ok({ a: "b" }, { b: "c" }, { a: "b", b: "c" });
+  ok({ a: "b" }, { a: null }, {});
+  ok({ a: "b", b: "c" }, { a: null }, { b: "c" });
+  ok({ a: ["b"] }, { a: "c" }, { a: "c" });
+  ok({ a: "c" }, { a: ["b"] }, { a: ["b"] });
+  ok({ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } });
+  ok({ a: [{ b: "c" }] }, { a: [1] }, { a: [1] });
+  ok(["a", "b"], ["c", "d"], ["c", "d"]);
+  ok({ a: "b" }, ["c"], ["c"]);
+  ok({ a: "foo" }, null, null);
+  ok({ a: "foo" }, "bar", "bar");
+  ok({ e: null }, { a: 1 }, { e: null, a: 1 });
+  ok([1, 2], { a: "b", c: null }, { a: "b" });
+  ok({}, { a: { bb: { ccc: null } } }, { a: { bb: {} } });
+});
+
+test("does not mutate inputs or share structure", () => {
+  const t = { a: { b: 1 } };
+  const p = { a: { c: [1] }, d: { e: 1 } };
+  const r = applyMergePatch(t, p) as any;
+  assert.deepEqual(t, { a: { b: 1 } });
+  assert.notEqual(r.d, p.d);
+  assert.notEqual(r.a.c, p.a.c);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const r = applyMergePatch({}, JSON.parse('{"__proto__":{"x":1}}')) as any;
+  assert.equal(({} as any).x, undefined);
+  assert.equal(Object.getPrototypeOf(r), Object.prototype);
+  assert.deepEqual(Object.keys(r), ["__proto__"]);
+});
