+++ b/src/patch.ts
@@ -0,0 +1,190 @@
+import { parsePointer } from "./pointer.ts";
+
+export class JsonPatchError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPatchError";
+  }
+}
+
+type Json = unknown;
+type Container = Json[] | Record<string, Json>;
+
+const ARRAY_INDEX = /^(0|[1-9][0-9]*)$/;
+const OPERATIONS = new Set(["add", "remove", "replace", "move", "copy", "test"]);
+
+function isObject(value: unknown): value is Record<string, Json> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function has(object: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(object, key);
+}
+
+function setMember(object: Record<string, Json>, key: string, value: Json): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+function clone(value: Json): Json {
+  if (Array.isArray(value)) return value.map(clone);
+  if (isObject(value)) {
+    const copy: Record<string, Json> = {};
+    for (const key of Object.keys(value)) setMember(copy, key, clone(value[key]));
+    return copy;
+  }
+  return value;
+}
+
+function equal(a: Json, b: Json): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((item, i) => equal(item, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((key) => has(b, key) && equal(a[key], b[key]));
+  }
+  return a === b;
+}
+
+/** Walks to the container holding the last token of `tokens`. */
+function parentOf(root: Json, tokens: string[], pointer: string): Container {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current) && ARRAY_INDEX.test(token) && Number(token) < current.length) {
+      current = current[Number(token)];
+    } else if (isObject(current) && has(current, token)) {
+      current = current[token];
+    } else {
+      throw new JsonPatchError(`Path "${pointer}" does not exist`);
+    }
+  }
+  if (!Array.isArray(current) && !isObject(current)) {
+    throw new JsonPatchError(`Path "${pointer}" does not exist: parent is not an object or array`);
+  }
+  return current;
+}
+
+function getAt(root: Json, pointer: string): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return root;
+  const parent = parentOf(root, tokens, pointer);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (!ARRAY_INDEX.test(last) || Number(last) >= parent.length) {
+      throw new JsonPatchError(`Path "${pointer}" does not exist`);
+    }
+    return parent[Number(last)];
+  }
+  if (!has(parent, last)) throw new JsonPatchError(`Path "${pointer}" does not exist`);
+  return parent[last];
+}
+
+function addAt(root: Json, pointer: string, value: Json): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens, pointer);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (last === "-") {
+      parent.push(value);
+    } else if (ARRAY_INDEX.test(last) && Number(last) <= parent.length) {
+      parent.splice(Number(last), 0, value);
+    } else {
+      throw new JsonPatchError(`Invalid array index "${last}" in path "${pointer}"`);
+    }
+  } else {
+    setMember(parent, last, value);
+  }
+  return root;
+}
+
+/** Removes the value at `pointer`; the target must exist. */
+function removeAt(root: Json, pointer: string): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) throw new JsonPatchError("Cannot remove the whole document");
+  getAt(root, pointer);
+  const parent = parentOf(root, tokens, pointer);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete parent[last];
+  return root;
+}
+
+/** Replaces the value at `pointer`; the target must exist. */
+function replaceAt(root: Json, pointer: string, value: Json): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  getAt(root, pointer);
+  const parent = parentOf(root, tokens, pointer);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(last)] = value;
+  else setMember(parent, last, value);
+  return root;
+}
+
+function isProperPrefix(from: string[], path: string[]): boolean {
+  return from.length < path.length && from.every((token, i) => token === path[i]);
+}
+
+function pointerString(operation: Record<string, Json>, member: "path" | "from", index: number): string {
+  const pointer = operation[member];
+  if (typeof pointer !== "string") {
+    throw new JsonPatchError(`Operation ${index}: "${member}" must be a string JSON Pointer`);
+  }
+  parsePointer(pointer);
+  return pointer;
+}
+
+/**
+ * Applies the RFC 6902 JSON Patch `patch` to `document` and returns the result as a new value.
+ * Neither argument is mutated. Throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new JsonPatchError("A JSON Patch must be an array of operations");
+  let result = clone(document);
+  patch.forEach((operation: unknown, index) => {
+    if (!isObject(operation)) throw new JsonPatchError(`Operation ${index} must be an object`);
+    const op = operation.op;
+    if (typeof op !== "string" || !OPERATIONS.has(op)) {
+      throw new JsonPatchError(`Operation ${index}: unknown or missing "op"`);
+    }
+    const path = pointerString(operation, "path", index);
+    const from = op === "move" || op === "copy" ? pointerString(operation, "from", index) : "";
+    if ((op === "add" || op === "replace" || op === "test") && !has(operation, "value")) {
+      throw new JsonPatchError(`Operation ${index}: "${op}" requires "value"`);
+    }
+    switch (op) {
+      case "add":
+        result = addAt(result, path, clone(operation.value));
+        break;
+      case "remove":
+        result = removeAt(result, path);
+        break;
+      case "replace":
+        result = replaceAt(result, path, clone(operation.value));
+        break;
+      case "move": {
+        const fromTokens = parsePointer(from);
+        if (isProperPrefix(fromTokens, parsePointer(path))) {
+          throw new JsonPatchError(`Operation ${index}: cannot move "${from}" into its own child`);
+        }
+        const value = getAt(result, from);
+        if (from !== path) {
+          result = removeAt(result, from);
+          result = addAt(result, path, value);
+        }
+        break;
+      }
+      case "copy":
+        result = addAt(result, path, clone(getAt(result, from)));
+        break;
+      case "test":
+        if (!equal(getAt(result, path), operation.value)) {
+          throw new JsonPatchError(`Operation ${index}: test failed at "${path}"`);
+        }
+        break;
+    }
+  });
+  return result;
+}
