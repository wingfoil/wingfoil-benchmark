@@ -0,0 +1,130 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "./index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) => assert.deepEqual(applyPatch(doc, patch), expected);
+const bad = (doc: unknown, patch: unknown) => assert.throws(() => applyPatch(doc, patch));
+
+test("RFC 6902 Appendix A examples", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ foo: "bar", baz: "qux" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok(
+    { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }], {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  ok({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }], {
+    baz: "qux",
+    foo: ["a", 2, "c"],
+  });
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" });
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] });
+  ok({ foo: "bar" }, [{ op: "copy", from: "/foo", path: "/baz" }], { foo: "bar", baz: "bar" });
+});
+
+test("does not mutate input and shares no structure", () => {
+  const doc = { a: { x: 1 }, l: [1, 2] };
+  const patch = [
+    { op: "copy", from: "/a", path: "/b" },
+    { op: "replace", path: "/b/x", value: 2 },
+    { op: "add", path: "/l/-", value: { n: 1 } },
+    { op: "remove", path: "/a" },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const result = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.deepEqual(result, { b: { x: 2 }, l: [1, 2, { n: 1 }] });
+  result.l[2].n = 9;
+  assert.equal((patch[2] as any).value.n, 1);
+  ok(doc, [], doc);
+  assert.notEqual(applyPatch(doc, []), doc);
+});
+
+test("whole-document operations", () => {
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: null }], null);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "" }], 1);
+  bad({ a: 1 }, [{ op: "remove", path: "" }]);
+});
+
+test("add edge cases", () => {
+  ok({ a: 0 }, [{ op: "add", path: "/a", value: 1 }], { a: 1 });
+  ok(["a", "b"], [{ op: "add", path: "/2", value: "x" }], ["a", "b", "x"]);
+  ok({}, [{ op: "add", path: "/a", value: null }], { a: null });
+  bad(["a", "b"], [{ op: "add", path: "/3", value: "x" }]);
+  bad(["a", "b"], [{ op: "add", path: "/01", value: "x" }]);
+  bad(["a", "b"], [{ op: "add", path: "/-1", value: "x" }]);
+  bad({}, [{ op: "add", path: "/a/b", value: 1 }]);
+  bad(5, [{ op: "add", path: "/a", value: 1 }]);
+});
+
+test("__proto__ is an ordinary member name", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as any;
+  assert.deepEqual(Object.keys(result), ["__proto__"]);
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(({} as any).x, undefined);
+});
+
+test("remove and replace require an existing target", () => {
+  bad({ a: 1 }, [{ op: "remove", path: "/c" }]);
+  bad([1, 2], [{ op: "remove", path: "/-" }]);
+  bad([1, 2], [{ op: "remove", path: "/2" }]);
+  bad({ a: 1 }, [{ op: "replace", path: "/b", value: 1 }]);
+  bad([1, 2], [{ op: "replace", path: "/-", value: 1 }]);
+  bad([1, 2], [{ op: "replace", path: "/5", value: 1 }]);
+  ok({ a: 1, b: 2 }, [{ op: "replace", path: "/a", value: 3 }], { a: 3, b: 2 });
+  assert.deepEqual(Object.keys(applyPatch({ a: 1, b: 2 }, [{ op: "replace", path: "/a", value: 3 }]) as object), ["a", "b"]);
+});
+
+test("move and copy", () => {
+  ok({ a: 1, b: {} }, [{ op: "move", from: "/a", path: "/b/c" }], { b: { c: 1 } });
+  ok(["a", "b", "c"], [{ op: "move", from: "/0", path: "/2" }], ["b", "c", "a"]);
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  bad({ a: 1 }, [{ op: "move", from: "/x", path: "/a" }]);
+  bad({ a: 1 }, [{ op: "move", from: "/x", path: "/x" }]);
+  bad({ a: 1 }, [{ op: "copy", from: "/x", path: "/y" }]);
+  const r = applyPatch({ a: { x: 1 } }, [{ op: "copy", from: "/a", path: "/b" }, { op: "replace", path: "/b/x", value: 2 }]);
+  assert.deepEqual(r, { a: { x: 1 }, b: { x: 2 } });
+});
+
+test("test operation equality", () => {
+  const doc = { a: { x: 1, y: [1, { z: null }] }, n: 1, s: "1" };
+  ok(doc, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }], doc);
+  ok(doc, [{ op: "test", path: "", value: doc }], doc);
+  bad(doc, [{ op: "test", path: "/n", value: "1" }]);
+  bad(doc, [{ op: "test", path: "/s", value: 1 }]);
