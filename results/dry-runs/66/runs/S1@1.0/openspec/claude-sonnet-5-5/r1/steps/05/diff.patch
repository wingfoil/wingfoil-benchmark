index 0000000000000000000000000000000000000000..6af9b7de9bf23ba61a1ad6b2f4dbef2d807f81bb
--- /dev/null
+++ b/src/diff.ts
@@ -0,0 +1,50 @@
+import { clone, equal, has, isObject } from "./patch.ts";
+
+type Operation = { op: "add" | "remove" | "replace"; path: string; value?: unknown };
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, out: Operation[]): void {
+  const max = Math.min(from.length, to.length);
+  let start = 0;
+  while (start < max && equal(from[start], to[start])) start++;
+  let end = 0;
+  while (end < max - start && equal(from[from.length - 1 - end], to[to.length - 1 - end])) end++;
+  const oldMiddle = from.length - end - start;
+  const newMiddle = to.length - end - start;
+  const paired = Math.min(oldMiddle, newMiddle);
+  for (let i = 0; i < paired; i++) diff(from[start + i], to[start + i], `${path}/${start + i}`, out);
+  for (let i = start + oldMiddle - 1; i >= start + paired; i--) out.push({ op: "remove", path: `${path}/${i}` });
+  for (let i = start + paired; i < start + newMiddle; i++) {
+    out.push({ op: "add", path: `${path}/${i}`, value: clone(to[i]) });
+  }
+}
+
+function diff(from: unknown, to: unknown, path: string, out: Operation[]): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, out);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) out.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (has(from, key)) diff(from[key], to[key], child, out);
+      else out.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+  } else if (!equal(from, to)) {
+    out.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Returns an RFC 6902 JSON Patch that turns `from` into `to` when applied, describing only what differs.
+ * Neither argument is mutated.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const out: Operation[] = [];
+  diff(from, to, "", out);
+  return out;
+}
