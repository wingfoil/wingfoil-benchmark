@@ -0,0 +1,67 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createPatch, applyPatch } from "./index.ts";
+
+const rt = (from: unknown, to: unknown) => {
+  const f = JSON.stringify(from), t = JSON.stringify(to);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.equal(JSON.stringify(from), f);
+  assert.equal(JSON.stringify(to), t);
+  return patch;
+};
+
+test("identical and reordered", () => {
+  assert.deepEqual(rt({ a: 1, b: [1] }, { b: [1], a: 1 }), []);
+});
+
+test("minimal deep change", () => {
+  assert.deepEqual(rt({ a: { b: { c: 1, d: 2 } }, e: 1 }, { a: { b: { c: 2, d: 2 } }, e: 1 }), [
+    { op: "replace", path: "/a/b/c", value: 2 },
+  ]);
+});
+
+test("add and remove members", () => {
+  assert.deepEqual(rt({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("arrays", () => {
+  assert.deepEqual(rt(["a", "b"], ["a", "b", "c"]), [{ op: "add", path: "/2", value: "c" }]);
+  assert.deepEqual(rt(["a", "b", "c"], ["a", "b"]), [{ op: "remove", path: "/2" }]);
+  assert.deepEqual(rt([1, 2, 3], [0, 1, 2, 3]), [{ op: "add", path: "/0", value: 0 }]);
+  assert.deepEqual(rt([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+  rt([1, 2, 3, 4, 5], [1, 9, 8, 7, 5, 6]);
+  rt([1, 2, 3, 4, 5], [5, 1]);
+  rt([{ a: 1 }, { b: 2 }], [{ a: 1, c: 3 }, { b: 2 }, []]);
+  rt([[1, 2], [3]], [[1], [3, 4]]);
+});
+
+test("type changes and root", () => {
+  assert.deepEqual(rt({ a: {} }, { a: [] }), [{ op: "replace", path: "/a", value: [] }]);
+  assert.deepEqual(rt(1, "1"), [{ op: "replace", path: "", value: "1" }]);
+  assert.deepEqual(rt(null, { a: 1 }), [{ op: "replace", path: "", value: { a: 1 } }]);
+  rt({ a: 1 }, [1]);
+});
+
+test("escaping and awkward keys", () => {
+  assert.deepEqual(rt({ "a/b": 1, "m~n": 1 }, { "a/b": 2, "m~n": 2 }), [
+    { op: "replace", path: "/a~1b", value: 2 },
+    { op: "replace", path: "/m~0n", value: 2 },
+  ]);
+  rt({ "": 1, "-": 1, "0": 1 }, { "": 2, "-": 2, "0": 2 });
+  const from = JSON.parse('{"__proto__":{"x":1},"k":1}');
+  const to = JSON.parse('{"__proto__":{"x":2},"k":1}');
+  const patch = rt(from, to);
+  assert.deepEqual(patch, [{ op: "replace", path: "/__proto__/x", value: 2 }]);
+  assert.equal(({} as any).x, undefined);
+});
+
+test("patch shares no structure", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0].value as any).b = 9;
+  assert.equal(to.a.b, 1);
+});
