+++ b/specs/003-create-patch/spec.md
@@ -0,0 +1,13 @@
+# Feature: createPatch(from, to)
+
+Export `createPatch(from, to)` from `src/index.ts`, returning an RFC 6902 JSON Patch that turns `from`
+into `to` when applied with `applyPatch`.
+
+- Neither input is mutated; patch values are copies, not shared references.
+- Minimal: objects are diffed member by member, recursively; only changed places appear in the patch.
+- Arrays: an added/removed item yields one `add`/`remove` (LCS alignment); a moved item is removed and
+  added back; items changed in place are patched recursively. Items in between are never rewritten.
+- Differing types, or scalars, yield `replace`; equal documents yield `[]`. Root replacement uses path "".
+- Pointer tokens are escaped (`~0`, `~1`). Non-JSON inputs throw `TypeError`.
+
+Tests: `test/createpatch.test.ts` (round trips, minimality, randomised).
diff --git a/src/index.ts b/src/index.ts
index deed4a35798dd6e7850132430d766f12427b7f64..16ffe51db785d85f503b0a7bf8681a1111990449 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -229,3 +229,89 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+type PatchOperation =
+  | { op: "add" | "replace"; path: string; value: unknown }
+  | { op: "remove"; path: string };
+
+const escapeToken = (token: string) => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+/**
+ * Returns a JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only what
+ * changed. Neither argument is mutated. Array items that are added or removed are added or removed
+ * individually; an item that moves is removed and added back.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  assertJson(from, "createPatch");
+  assertJson(to, "createPatch");
+  const ops: PatchOperation[] = [];
+  diffValue(from, to, "", ops);
+  return ops;
+}
+
+function diffValue(a: Json, b: Json, path: string, ops: PatchOperation[]): void {
+  if (jsonEqual(a, b)) return;
+  if (Array.isArray(a) && Array.isArray(b)) return diffArray(a, b, path, ops);
+  if (isObject(a) && isObject(b)) {
+    for (const k of Object.keys(a)) {
+      if (!hasOwn(b, k)) ops.push({ op: "remove", path: `${path}/${escapeToken(k)}` });
+    }
+    for (const k of Object.keys(b)) {
+      const child = `${path}/${escapeToken(k)}`;
+      if (!hasOwn(a, k)) ops.push({ op: "add", path: child, value: clone(b[k]) });
+      else diffValue(a[k], b[k], child, ops);
+    }
+    return;
+  }
+  ops.push({ op: "replace", path, value: clone(b) });
+}
+
+function diffArray(a: Json[], b: Json[], path: string, ops: PatchOperation[]): void {
+  let start = 0;
+  while (start < a.length && start < b.length && jsonEqual(a[start], b[start])) start++;
+  let endA = a.length;
+  let endB = b.length;
+  while (endA > start && endB > start && jsonEqual(a[endA - 1], b[endB - 1])) { endA--; endB--; }
+
+  // Longest common subsequence of the differing middle part.
+  const n = endA - start;
+  const m = endB - start;
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = jsonEqual(a[start + i], b[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+
+  let index = start; // position in the array as patched so far
+  let i = 0;
+  let j = 0;
+  while (i < n || j < m) {
+    if (i < n && j < m && jsonEqual(a[start + i], b[start + j])) {
+      index++; i++; j++;
+      continue;
+    }
+    // A run of unmatched items on both sides: pair them up as in-place changes.
+    let di = i;
+    let dj = j;
+    while (di < n && (dj >= m || lcs[di + 1][dj] >= lcs[di][dj + 1]) && !(dj < m && jsonEqual(a[start + di], b[start + dj]))) di++;
+    while (dj < m && !(di < n && jsonEqual(a[start + di], b[start + dj])) && !(di < n && lcs[di][dj + 1] < lcs[di + 1][dj])) dj++;
+    if (di === i && dj === j) { // safety: always progress
+      if (i < n) di++; else dj++;
+    }
+    const removes = di - i;
+    const adds = dj - j;
+    const paired = Math.min(removes, adds);
+    for (let k = 0; k < paired; k++) diffValue(a[start + i + k], b[start + j + k], `${path}/${index + k}`, ops);
+    index += paired;
+    for (let k = paired; k < removes; k++) ops.push({ op: "remove", path: `${path}/${index}` });
+    for (let k = paired; k < adds; k++) {
+      ops.push({ op: "add", path: `${path}/${index}`, value: clone(b[start + j + k]) });
+      index++;
+    }
+    i = di;
+    j = dj;
+  }
+}
diff --git a/test/createpatch.test.ts b/test/createpatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..50d9d951bfdfaafaaf28cc840b508b5fd59048c3
--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,64 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const f = JSON.stringify(from), t = JSON.stringify(to);
+  const patch = createPatch(from, to);
+  assert.equal(JSON.stringify(from), f);
+  assert.equal(JSON.stringify(to), t);
+  assert.deepEqual(applyPatch(from, patch), to, JSON.stringify(patch));
+  return patch;
+};
+
+test("identical documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small change deep in a document", () => {
+  const p = roundTrip({ a: { b: { c: 1, d: 2 } }, e: [1, 2] }, { a: { b: { c: 1, d: 3 } }, e: [1, 2] });
+  assert.deepEqual(p, [{ op: "replace", path: "/a/b/d", value: 3 }]);
+});
+
+test("object members, escaping, type changes, root", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "~": 2 }, { "a/b": 1, "~": 3, n: null }),
+    [{ op: "replace", path: "/~0", value: 3 }, { op: "add", path: "/n", value: null }]);
+  roundTrip({ a: 1 }, { a: [1] });
+  roundTrip(1, "x");
+  roundTrip([1], { a: 1 });
+  roundTrip({ a: 1 }, null);
+  roundTrip(JSON.parse('{"__proto__":1}'), JSON.parse('{"__proto__":2,"x":1}'));
+});
+
+test("array insert and remove touch only that item", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([{ a: 1 }, { a: 2 }], [{ a: 0 }, { a: 1 }, { a: 2 }]), [{ op: "add", path: "/0", value: { a: 0 } }]);
+  assert.deepEqual(roundTrip([], [1]), [{ op: "add", path: "/0", value: 1 }]);
+});
+
+test("array move does not rewrite items in between", () => {
+  const p = roundTrip(["a", "b", "c", "d", "e"], ["a", "c", "d", "e", "b"]);
+  assert.ok(p.length <= 2);
+  const q = roundTrip([{ x: 1 }, { x: 2 }, { x: 3 }, { x: 4 }], [{ x: 4 }, { x: 1 }, { x: 2 }, { x: 3 }]);
+  assert.ok(q.length <= 2);
+});
+
+test("changed item inside array is patched in place", () => {
+  assert.deepEqual(roundTrip([{ a: 1, b: 1 }, { a: 2 }], [{ a: 1, b: 5 }, { a: 2 }]),
+    [{ op: "replace", path: "/0/b", value: 5 }]);
+});
+
+test("randomised round trips", () => {
+  let s = 7;
+  const rnd = (n: number) => (s = (s * 1103515245 + 12345) % 2147483648) % n;
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 3 : 5);
+    if (k === 0) return rnd(4);
+    if (k === 1) return ["x", "y", null][rnd(3)];
+    if (k === 2) return rnd(2) === 0;
+    if (k === 3) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let n = 0; n < 2000; n++) roundTrip(gen(0), gen(0));
+});
