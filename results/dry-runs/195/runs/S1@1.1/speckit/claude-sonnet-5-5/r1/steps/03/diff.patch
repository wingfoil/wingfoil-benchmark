@@ -60,6 +60,25 @@ function clone(value: Json): Json {
   return value;
 }
 
+/** Throws unless `value` is a JSON value (RFC 8259): no undefined, functions, NaN/Infinity, etc. */
+function assertJson(value: Json, op: string): void {
+  const ok = (v: Json): boolean => {
+    if (v === null || typeof v === "string" || typeof v === "boolean") return true;
+    if (typeof v === "number") return Number.isFinite(v);
+    if (Array.isArray(v)) {
+      for (let i = 0; i < v.length; i++) if (!(i in v) || !ok(v[i])) return false;
+      return true;
+    }
+    if (typeof v === "object") {
+      const proto = Object.getPrototypeOf(v);
+      return (proto === Object.prototype || proto === null) &&
+        Object.keys(v).every((k) => ok((v as Record<string, Json>)[k]));
+    }
+    return false;
+  };
+  if (!ok(value)) throw new TypeError(`JSON Patch "${op}" needs a JSON "value"`);
+}
+
 function jsonEqual(a: Json, b: Json): boolean {
   if (Array.isArray(a)) {
     return Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
@@ -156,9 +175,7 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
     if (needsValue && !hasOwn(operation, "value")) {
       throw new TypeError(`JSON Patch "${op}" needs a "value"`);
     }
-    if (needsValue && operation.value === undefined) {
