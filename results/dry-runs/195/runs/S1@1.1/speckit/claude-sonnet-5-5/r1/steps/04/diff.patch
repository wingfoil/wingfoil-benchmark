@@ -214,3 +214,18 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   }
   return result;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to `target` and returns the result as a new value.
+ * Neither argument is mutated. A non-object `patch` replaces the target; `null` members delete.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) return clone(patch);
+  const result: Record<string, Json> = isObject(target) ? (clone(target) as Record<string, Json>) : {};
+  for (const k of Object.keys(patch)) {
+    const v = patch[k];
+    if (v === null) delete result[k];
+    else setMember(result, k, applyMergePatch(hasOwn(result, k) ? result[k] : undefined, v));
+  }
+  return result;
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1583d15fddfb55a979ee76a01348680b2e9092e2
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,32 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("RFC 7386 appendix A", () => {
+  const cases: [unknown, unknown, unknown][] = [
+    [{ a: "b" }, { a: "c" }, { a: "c" }],
+    [{ a: "b" }, { b: "c" }, { a: "b", b: "c" }],
+    [{ a: "b" }, { a: null }, {}],
+    [{ a: "b", b: "c" }, { a: null }, { b: "c" }],
+    [{ a: ["b"] }, { a: "c" }, { a: "c" }],
+    [{ a: "c" }, { a: ["b"] }, { a: ["b"] }],
+    [{ a: { b: "c" } }, { a: { b: "d", c: null } }, { a: { b: "d" } }],
+    [{ a: [{ b: "c" }] }, { a: [1] }, { a: [1] }],
+    [["a", "b"], ["c", "d"], ["c", "d"]],
+    [{ a: "b" }, ["c"], ["c"]],
+    [{ a: "foo" }, null, null],
+    [{ a: "foo" }, "bar", "bar"],
+    [{ e: null }, { a: 1 }, { e: null, a: 1 }],
+    [[1, 2], { a: "b", c: null }, { a: "b" }],
+    [{}, { a: { bb: { ccc: null } } }, { a: { bb: {} } }],
+  ];
+  for (const [t, p, e] of cases) assert.deepEqual(applyMergePatch(t, p), e, JSON.stringify(p));
+});
+
+test("does not mutate and handles __proto__", () => {
+  const t = { a: { b: 1 } };
+  const r = applyMergePatch(t, JSON.parse('{"a":{"c":2},"__proto__":{"x":1}}')) as any;
+  assert.deepEqual(t, { a: { b: 1 } });
+  assert.equal(({} as any).x, undefined);
+  assert.deepEqual(Object.keys(r), ["a", "__proto__"]);
+});
