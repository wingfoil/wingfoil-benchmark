+++ b/test/patch.test.ts
@@ -0,0 +1,138 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+const ok = (doc: unknown, patch: unknown, expected: unknown) =>
+  assert.deepEqual(applyPatch(doc, patch as any), expected);
+const bad = (doc: unknown, patch: unknown) =>
+  assert.throws(() => applyPatch(doc, patch as any), JSON.stringify(patch));
+
+test("RFC 6902 appendix A successes", () => {
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }], { foo: "bar", baz: "qux" });
+  ok({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }], { foo: ["bar", "qux", "baz"] });
+  ok({ foo: "bar", baz: "qux" }, [{ op: "remove", path: "/baz" }], { foo: "bar" });
+  ok({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }], { foo: ["bar", "baz"] });
+  ok({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }], { baz: "boo", foo: "bar" });
+  ok({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }],
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+  ok({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }],
+    { foo: ["all", "cows", "eat", "grass"] });
+  ok({ baz: "qux", foo: ["a", 2, "c"] }, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }],
+    { baz: "qux", foo: ["a", 2, "c"] });
+  ok({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }], { foo: "bar", child: { grandchild: {} } });
+  ok({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }], { foo: "bar", baz: "qux" });
+  ok({ foo: "bar" }, [{ op: "add", path: "/foo", value: ["bar", "baz"] }], { foo: ["bar", "baz"] });
+  ok({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }], { foo: ["bar", ["abc", "def"]] });
+  ok({ foo: "bar", baz: [1, 2, 3] }, [{ op: "remove", path: "/baz/1" }], { foo: "bar", baz: [1, 3] });
+  ok({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }], { "/": 9, "~1": 10 });
+  ok({ foo: "bar" }, [{ op: "copy", from: "/foo", path: "/baz" }], { foo: "bar", baz: "bar" });
+});
+
+test("RFC 6902 appendix A errors", () => {
+  bad({ baz: "qux" }, [{ op: "test", path: "/baz", value: "bar" }]);
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]);
+  bad({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", op2: 1 }, { op: "test", path: "/baz", value: "x" }]);
+  bad({ foo: ["bar"] }, [{ op: "add", path: "/foo/3", value: 1 }]);
+  bad({ foo: ["bar"] }, [{ op: "add", path: "/foo/01", value: 1 }]);
+  bad({ foo: 1 }, [{ op: "bogus", path: "/foo" }]);
+});
+
+test("whole-document operations", () => {
+  ok({ a: 1 }, [{ op: "add", path: "", value: [1] }], [1]);
+  ok({ a: 1 }, [{ op: "replace", path: "", value: null }], null);
+  ok({ a: 1 }, [{ op: "test", path: "", value: { a: 1 } }], { a: 1 });
+  ok({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "" }], { b: 1 });
+  bad({ a: 1 }, [{ op: "remove", path: "" }]);
+});
+
+test("empty patch, null values", () => {
+  ok({ a: 1 }, [], { a: 1 });
+  ok({ a: 1 }, [{ op: "add", path: "/b", value: null }], { a: 1, b: null });
+  ok({ a: null }, [{ op: "test", path: "/a", value: null }], { a: null });
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: null }]);
+});
+
+test("test uses JSON equality", () => {
+  ok({ a: { x: 1, y: [1, 2] } }, [{ op: "test", path: "/a", value: { y: [1, 2], x: 1 } }], { a: { x: 1, y: [1, 2] } });
+  bad({ a: 1 }, [{ op: "test", path: "/a", value: "1" }]);
+  bad({ a: [1] }, [{ op: "test", path: "/a", value: { 0: 1 } }]);
+  bad({ a: { x: 1 } }, [{ op: "test", path: "/a", value: { x: 1, y: 2 } }]);
+  bad({ a: [1, 2] }, [{ op: "test", path: "/a", value: [1] }]);
+});
+
+test("remove / replace / move / copy need existing targets", () => {
+  bad({ a: 1 }, [{ op: "remove", path: "/b" }]);
+  bad({ a: [1] }, [{ op: "remove", path: "/a/1" }]);
+  bad({ a: [1] }, [{ op: "remove", path: "/a/-" }]);
+  bad({ a: 1 }, [{ op: "replace", path: "/b", value: 1 }]);
+  bad({ a: [1] }, [{ op: "replace", path: "/a/1", value: 1 }]);
+  bad({ a: 1 }, [{ op: "move", from: "/b", path: "/c" }]);
+  bad({ a: 1 }, [{ op: "copy", from: "/b", path: "/c" }]);
+  bad({ a: [1] }, [{ op: "copy", from: "/a/-", path: "/c" }]);
+});
+
+test("move edge cases", () => {
+  ok({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }], { a: 1 });
+  bad({ a: 1 }, [{ op: "move", from: "/b", path: "/b" }]);
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/b" }]);
+  bad({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/c/d" }]);
+  ok({ ab: 1 }, [{ op: "move", from: "/ab", path: "/a" }], { a: 1 });
+  ok({ a: [1, 2] }, [{ op: "move", from: "/a/0", path: "/a/-" }], { a: [2, 1] });
+});
+
+test("invalid patches", () => {
+  for (const p of [null, {}, "x", 1, [null], [1], [[]], [{}], [{ op: 1, path: "" }],
+    [{ op: "add", value: 1 }], [{ op: "add", path: 1, value: 1 }], [{ op: "add", path: "/a" }],
+    [{ op: "replace", path: "/a" }], [{ op: "test", path: "/a" }],
+    [{ op: "move", path: "/a" }], [{ op: "copy", path: "/a" }],
+    [{ op: "move", from: 1, path: "/a" }], [{ op: "remove" }],
+    [{ op: "add", path: "a", value: 1 }], [{ op: "add", path: "/a~2", value: 1 }]]) {
+    bad({ a: 1 }, p);
+  }
+  bad({ a: 1 }, undefined);
+});
+
+test("does not mutate inputs and shares no structure", () => {
+  const doc = { a: { b: [1, 2] }, c: { d: 1 } };
+  const value = { x: [1] };
+  const patch = [
+    { op: "add", path: "/v", value },
+    { op: "copy", from: "/a", path: "/a2" },
+    { op: "move", from: "/c", path: "/e" },
+    { op: "remove", path: "/a/b/0" },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const out: any = applyPatch(doc, patch as any);
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  out.v.x.push(2);
+  out.a2.b.push(3);
+  assert.deepEqual(value, { x: [1] });
+  assert.deepEqual(out.a, { b: [2] });
+  assert.deepEqual(out.a2, { b: [1, 2, 3] });
+  assert.notEqual(out, doc);
+  assert.notEqual(applyPatch(doc, []), doc);
+});
+
+test("failure leaves input untouched", () => {
+  const doc = { a: 1 };
+  bad(doc, [{ op: "add", path: "/b", value: 2 }, { op: "remove", path: "/zzz" }]);
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("prototype-ish names are ordinary members", () => {
+  const out: any = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]);
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+  assert.equal(({} as any).polluted, undefined);
+  bad({}, [{ op: "remove", path: "/__proto__" }]);
+  bad({}, [{ op: "remove", path: "/toString" }]);
+  bad({ a: [] }, [{ op: "remove", path: "/a/length" }]);
+  bad({}, [{ op: "add", path: "/constructor/x", value: 1 }]);
+  const parsed = JSON.parse('{"__proto__":{"p":1}}');
+  const out2: any = applyPatch(parsed, [{ op: "copy", from: "/__proto__", path: "/q" }]);
+  assert.deepEqual(out2.q, { p: 1 });
+  assert.equal(Object.getPrototypeOf(out2), Object.prototype);
+});
