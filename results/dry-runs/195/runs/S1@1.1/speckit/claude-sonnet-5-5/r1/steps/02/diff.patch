index 16fd4fe99ca9695c80cc3861acbe25d4a73dd861..e2b2007a14886fdc64a1900541c350fe32a4dafb 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -40,3 +40,160 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   }
   return current;
 }
+
+type Json = unknown;
+
+const isObject = (v: unknown): v is Record<string, Json> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+const setMember = (o: Record<string, Json>, k: string, v: Json) =>
+  Object.defineProperty(o, k, { value: v, enumerable: true, writable: true, configurable: true });
+
+/** Deep copy of a JSON value; `__proto__` members are copied as ordinary members. */
+function clone(value: Json): Json {
+  if (Array.isArray(value)) return value.map(clone);
+  if (isObject(value)) {
+    const out: Record<string, Json> = {};
+    for (const k of Object.keys(value)) setMember(out, k, clone(value[k]));
+    return out;
+  }
+  return value;
+}
+
+function jsonEqual(a: Json, b: Json): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((v, i) => jsonEqual(v, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length &&
+      keys.every((k) => hasOwn(b, k) && jsonEqual(a[k], b[k]));
+  }
+  return a === b;
+}
+
+const INDEX = /^(0|[1-9][0-9]*)$/;
+
+/** Walks to the container holding the last token; every step must exist. */
+function parentOf(root: Json, tokens: string[]): Json {
+  let current = root;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) {
+      if (!INDEX.test(token) || Number(token) >= current.length) {
+        throw new Error(`JSON Patch: bad array index "${token}"`);
+      }
+      current = current[Number(token)];
+    } else if (isObject(current) && hasOwn(current, token)) {
+      current = current[token];
+    } else {
+      throw new Error(`JSON Patch: path does not exist at "${token}"`);
+    }
+  }
+  return current;
+}
+
+function getValue(root: Json, pointer: string): Json {
+  return resolvePointer(root, pointer);
+}
+
+function addValue(root: Json, pointer: string, value: Json): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    if (last === "-") parent.push(value);
+    else if (INDEX.test(last) && Number(last) <= parent.length) parent.splice(Number(last), 0, value);
+    else throw new Error(`JSON Patch: bad array index "${last}"`);
+  } else if (isObject(parent)) {
+    setMember(parent, last, value);
+  } else {
+    throw new Error(`JSON Patch: cannot add into a scalar at "${pointer}"`);
+  }
+  return root;
+}
+
+function removeValue(root: Json, pointer: string): Json {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) throw new Error("JSON Patch: cannot remove the whole document");
+  getValue(root, pointer); // target must exist
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(last), 1);
+  else delete (parent as Record<string, Json>)[last];
+  return root;
+}
+
+function replaceValue(root: Json, pointer: string, value: Json): Json {
+  getValue(root, pointer); // target must exist
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(root, tokens);
+  const last = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent[Number(last)] = value;
+  else setMember(parent as Record<string, Json>, last, value);
+  return root;
+}
+
+/**
+ * Applies a JSON Patch (RFC 6902) to `document` and returns the result as a new value.
+ * Neither argument is mutated. Throws if the patch is invalid or an operation fails.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) throw new TypeError("JSON Patch must be an array of operations");
+  let result = clone(document);
+  for (const operation of patch) {
+    if (!isObject(operation)) throw new TypeError("JSON Patch operation must be an object");
+    const { op, path, from } = operation;
+    if (typeof op !== "string") throw new TypeError("JSON Patch operation needs a string \"op\"");
+    if (typeof path !== "string") throw new TypeError("JSON Patch operation needs a string \"path\"");
+    const needsValue = op === "add" || op === "replace" || op === "test";
+    const needsFrom = op === "move" || op === "copy";
+    if (!needsValue && !needsFrom && op !== "remove") {
+      throw new Error(`JSON Patch: unknown operation "${op}"`);
+    }
+    if (needsValue && !hasOwn(operation, "value")) {
+      throw new TypeError(`JSON Patch "${op}" needs a "value"`);
+    }
+    if (needsValue && operation.value === undefined) {
+      throw new TypeError(`JSON Patch "${op}" needs a JSON "value"`);
+    }
+    if (needsFrom && typeof from !== "string") {
+      throw new TypeError(`JSON Patch "${op}" needs a string "from"`);
+    }
+    switch (op) {
+      case "add":
+        result = addValue(result, path, clone(operation.value));
+        break;
+      case "remove":
+        result = removeValue(result, path);
+        break;
+      case "replace":
+        result = replaceValue(result, path, clone(operation.value));
+        break;
+      case "move": {
+        const value = getValue(result, from as string);
+        if (from === path) break;
+        const fromTokens = parsePointer(from as string);
+        const pathTokens = parsePointer(path);
+        if (pathTokens.length > fromTokens.length && fromTokens.every((t, i) => t === pathTokens[i])) {
+          throw new Error(`JSON Patch: cannot move "${from}" into itself`);
+        }
+        const moved = clone(value);
+        result = removeValue(result, from as string);
+        result = addValue(result, path, moved);
+        break;
+      }
+      case "copy":
+        result = addValue(result, path, clone(getValue(result, from as string)));
+        break;
+      case "test":
+        if (!jsonEqual(getValue(result, path), operation.value)) {
+          throw new Error(`JSON Patch: test failed at "${path}"`);
+        }
+        break;
+    }
+  }
+  return result;
+}
