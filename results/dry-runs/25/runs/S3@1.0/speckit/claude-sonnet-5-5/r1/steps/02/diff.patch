   s.book({ itemId: 'b1', start: d(3), end: d(5) });
   s.book({ itemId: 's1', start: d(1), end: d(3) });
 });
+
+test('availability lists free items, sorted, optionally by kind', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 100 });
+  assert.deepEqual(s.availability({ start: d(1), end: d(3) }), ['a0', 'b1', 's1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3), kind: 'board' }), ['a0', 'b1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3), kind: undefined }), ['a0', 'b1', 's1']);
+});
+
+test('availability excludes overlaps but not back-to-back bookings', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: d(3), end: d(5) });
+  assert.deepEqual(s.availability({ start: d(1), end: d(4) }), ['s1']);
+  assert.deepEqual(s.availability({ start: d(4), end: d(6) }), ['s1']);
+  assert.deepEqual(s.availability({ start: d(1), end: d(3) }), ['b1', 's1']);
+  assert.deepEqual(s.availability({ start: d(5), end: d(7) }), ['b1', 's1']);
+  s.book({ itemId: 's1', start: d(1), end: d(10) });
+  assert.deepEqual(s.availability({ start: d(4), end: d(5), kind: 'sail' }), []);
+});
+
+test('availability rejects invalid period and kind', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: d(2), end: d(1) }));
+  assert.throws(() => s.availability({ start: d(1), end: d(1) }));
+  assert.throws(() => s.availability({ start: '2026-06-01T10:00:00Z', end: d(2) }));
+  assert.throws(() => s.availability({ start: d(1), end: d(2), kind: 'kayak' as never }));
