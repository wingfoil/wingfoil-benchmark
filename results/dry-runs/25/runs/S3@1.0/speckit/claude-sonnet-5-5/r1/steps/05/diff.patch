+
+test('cancel before start refunds in full and frees the item', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.deepEqual(s.cancel(b.id, d(2)), { bookingId: b.id, refund: 0 });
+  s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  const c = s.book({ itemId: 'b1', start: d(5), end: d(6) });
+  assert.deepEqual(s.cancel(c.id, d(4)), { bookingId: c.id, refund: c.total });
+  assert.ok(s.availability({ start: d(5), end: d(6) }).includes('b1'));
+});
+
+test('cancel twice, unknown, ended or invalid time is rejected', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.throws(() => s.cancel(b.id, 'soon'));
+  assert.throws(() => s.cancel(b.id, d(3)));
+  assert.throws(() => s.cancel('nope', d(1)));
+  s.cancel(b.id, d(1));
+  assert.throws(() => s.cancel(b.id, d(1)), /already cancelled/);
+});
