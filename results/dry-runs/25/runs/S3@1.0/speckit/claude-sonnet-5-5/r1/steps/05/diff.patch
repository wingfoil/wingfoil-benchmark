+    cancel(bookingId: string, at: string): { bookingId: string; refund: number } {
+      const when = parseInstant(at, 'at');
+      const index = bookings.findIndex((b) => b.id === bookingId);
+      if (index < 0) {
+        throw new Error(cancelled.has(bookingId) ? `Booking already cancelled: ${bookingId}` : `Unknown booking: ${bookingId}`);
+      }
+      const booking = bookings[index];
+      if (when >= Date.parse(booking.end)) throw new Error('Booking has already ended');
+      // Full refund before the rental starts, nothing once it has started.
+      const refund = when < Date.parse(booking.start) ? booking.total : 0;
+      bookings.splice(index, 1);
+      cancelled.add(bookingId);
+      return { bookingId, refund };
