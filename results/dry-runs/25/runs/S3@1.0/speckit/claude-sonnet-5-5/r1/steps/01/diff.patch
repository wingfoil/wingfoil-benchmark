+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+const d = (day: number) => `2026-06-${String(day).padStart(2, '0')}T00:00:00.000Z`;
+const setup = () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  return s;
+};
+
+test('quote multiplies days by price', () => {
+  assert.deepEqual(setup().quote({ itemId: 'b1', start: d(1), end: d(4) }), {
+    itemId: 'b1', start: d(1), end: d(4), total: 7500,
+  });
+});
+
+test('quote rejects unknown item and bad periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote({ itemId: 'x', start: d(1), end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(2), end: d(1) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: d(1), end: d(1) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-06-01T10:00:00Z', end: d(2) }));
+  assert.throws(() => s.quote({ itemId: 'b1', start: '2026-06-01T00:00:00+02:00', end: d(2) }));
+});
+
+test('book returns a booking and blocks overlaps', () => {
+  const s = setup();
+  const b = s.book({ itemId: 'b1', start: d(1), end: d(3) });
+  assert.equal(b.total, 5000);
+  assert.ok(b.id);
+  assert.throws(() => s.book({ itemId: 'b1', start: d(2), end: d(4) }));
+  s.book({ itemId: 'b1', start: d(3), end: d(5) });
+  s.book({ itemId: 's1', start: d(1), end: d(3) });
+});
