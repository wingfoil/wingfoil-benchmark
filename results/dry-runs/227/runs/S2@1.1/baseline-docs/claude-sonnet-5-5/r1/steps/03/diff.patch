diff --git a/test/coupons.test.ts b/test/coupons.test.ts
index 4d75764768501587347a656e70ac38a40f1cbba4..ecc69574917aeb723494085cf1063476241c6978 100644
--- a/test/coupons.test.ts
+++ b/test/coupons.test.ts
@@ -57,4 +57,13 @@ describe('coupons', () => {
     assert.equal(coupons.usedBy('ONCE'), 'ORD-0001');
     assert.throws(() => orders.place({ customer: 'c-2', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'ONCE' }), CouponError);
   });
+
+  it('gives a single-use coupon back when its order is cancelled', () => {
+    const { orders, coupons } = shop();
+    coupons.add({ code: 'ONCE', kind: 'fixed', value: 100, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    orders.place({ customer: 'c-1', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'ONCE' });
+    orders.cancel('ORD-0001', '2026-05-05');
+    assert.equal(coupons.usedBy('ONCE'), undefined);
+    assert.equal(orders.place({ customer: 'c-1', date: '2026-05-05', lines: [{ sku: 'PEN-4', quantity: 1 }], coupon: 'ONCE' }).coupon, 'ONCE');
+  });
 });
