+    exportMonth(month) {
+      if (!MONTH.test(month)) throw new RangeError(`${month} is not a month (YYYY-MM)`);
+      const rows = ['order,date,customer,email,phone,total'];
+      for (const order of orders) {
+        if (!order.date.startsWith(`${month}-`)) continue;
+        const customer = customers.get(order.customerId);
+        const priced = totals(order.number);
+        rows.push(
+          [
+            String(order.number),
+            order.date,
+            customer.ok ? customer.value.name : '',
+            customer.ok ? customer.value.email : '',
+            customer.ok ? customer.value.phone : '',
+            priced.ok ? formatEuros(priced.value.totalCents) : '',
+          ]
+            .map(csvField)
+            .join(','),
+        );
+      }
+      return rows.join('\n');
