@@ -0,0 +1,36 @@
+import type { Cents } from './money.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+
+/** `WELCOME5` only applies to orders whose items come to this amount or more. */
+export const WELCOME5_MINIMUM_CENTS: Cents = 3000;
+
+const WELCOME5_CENTS: Cents = 500;
+
+/**
+ * Checks that a code can be taken by an order whose items come to this amount.
+ *
+ * @param code - the discount code
+ * @param itemsCents - what the order's items come to
+ */
+export function checkCode(code: string, itemsCents: Cents): Result<string> {
+  if (code === 'SPRING10') return ok(code);
+  if (code === 'WELCOME5') {
+    return itemsCents >= WELCOME5_MINIMUM_CENTS
+      ? ok(code)
+      : err('invalid', 'WELCOME5 needs items worth at least 30.00 €');
+  }
+  return err('invalid', `${code} is not a discount code`);
+}
+
+/**
+ * What a code takes off an order's items; 0 for no code.
+ *
+ * @param code - the discount code, if any
+ * @param itemsCents - what the order's items come to
+ */
+export function discountFor(code: string | undefined, itemsCents: Cents): Cents {
+  if (code === 'SPRING10') return Math.floor((itemsCents + 5) / 10);
+  if (code === 'WELCOME5') return Math.min(WELCOME5_CENTS, itemsCents);
+  return 0;
+}
