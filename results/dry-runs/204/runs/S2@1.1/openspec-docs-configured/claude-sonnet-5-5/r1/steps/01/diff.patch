diff --git a/test/pricing.test.ts b/test/pricing.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9e1b859a8460b5934ab471a055432ee8a038c8ae
--- /dev/null
+++ b/test/pricing.test.ts
@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { lineVat } from '../src/tax.ts';
+import { shippingCost } from '../src/shipping.ts';
+
+describe('VAT and shipping boundaries', () => {
+  it('rounds line VAT half up: €1.99 at 22% is €0.44', () => {
+    assert.equal(lineVat(199, 'standard'), 44);
+  });
+  it('ships free from exactly €50.00, not at €49.99', () => {
+    assert.equal(shippingCost(5000, 500), 0);
+    assert.equal(shippingCost(4999, 500), 490);
+  });
+});
