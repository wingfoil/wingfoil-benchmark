+
+describe('exportMonth', () => {
+  it('exports the orders of a month as CSV, discount and shipping included', () => {
+    const shop = stocked();
+    valueOf(shop.customers.add({ id: 'c2', name: 'Holt, "Al"', email: 'al@example.org', phone: '555-0102' }));
+    shop.orders.place({ customerId: 'c1', date: '2026-10-02', lines: [{ sku: 'OIL-1L', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c2', date: '2026-09-30', lines: [{ sku: 'APL-1KG', quantity: 1 }] });
+    shop.orders.place({ customerId: 'c2', date: '2026-10-31', lines: [{ sku: 'HAM-W', quantity: 1 }] });
+    valueOf(shop.orders.applyCode(3, 'SPRING10'));
+    assert.equal(
+      shop.orders.exportMonth('2026-10'),
+      'order,date,customer,total\n' +
+        '1,2026-10-02,Mira Holt,17.80\n' +
+        '3,2026-10-31,"Holt, ""Al""",57.60\n',
+    );
+  });
+
+  it('gives the header alone for a month without orders', () => {
+    assert.equal(stocked().orders.exportMonth('2026-11'), 'order,date,customer,total\n');
+  });
+});
