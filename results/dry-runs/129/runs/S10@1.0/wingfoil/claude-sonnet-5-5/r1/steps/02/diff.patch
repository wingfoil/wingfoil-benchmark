@@ -67,6 +74,13 @@ function discountFor(code: string | undefined, itemsCents: Cents): Result<Cents>
   return err('invalid', `${code} is not a known discount code`);
 }
 
+const CSV_HEADER = 'order,date,customer,total';
+
+/** A CSV field, quoted when it holds a comma, a quote or a line break. */
+function csvField(value: string): string {
+  return /[",\r\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
+}
+
 const DATE = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
 
 /**
@@ -141,5 +155,22 @@ export function createOrderBook(catalogue: Catalogue, customers: Customers): Ord
       const shippingCents = shippingFor(priced);
       return ok({ itemsCents, discountCents, shippingCents, totalCents: itemsCents - discountCents + shippingCents });
     },
+    exportMonth(month) {
+      const lines = [CSV_HEADER];
+      if (/^\d{4}-(0[1-9]|1[0-2])$/.test(month)) {
+        for (const order of orders) {
+          if (order.date.slice(0, 7) !== month) continue;
+          const customer = customers.get(order.customerId);
+          const totals = this.totals(order.number);
+          lines.push([
+            String(order.number),
+            order.date,
+            customer.ok ? customer.value.name : '',
+            totals.ok ? formatEuros(totals.value.totalCents) : '',
+          ].map(csvField).join(','));
+        }
+      }
+      return lines.join('\n') + '\n';
+    },
   };
 }
