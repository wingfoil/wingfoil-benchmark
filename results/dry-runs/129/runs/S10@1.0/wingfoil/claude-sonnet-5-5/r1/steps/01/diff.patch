+/** `WELCOME5` only applies to orders whose items come to this amount or more. */
+const WELCOME5_MIN_CENTS: Cents = 3000;
+const WELCOME5_CENTS: Cents = 500;
+
+/** The discount a code gives on items worth `itemsCents`, or why it is refused. */
+function discountFor(code: string | undefined, itemsCents: Cents): Result<Cents> {
+  if (code === undefined) return ok(0);
+  if (code === 'SPRING10') return ok(Math.floor((itemsCents + 5) / 10));
+  if (code === 'WELCOME5') {
+    return itemsCents >= WELCOME5_MIN_CENTS
+      ? ok(WELCOME5_CENTS)
+      : err('invalid', 'WELCOME5 needs items worth 30.00 € or more');
+  }
+  return err('invalid', `${code} is not a known discount code`);
+}
