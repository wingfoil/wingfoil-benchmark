--- /dev/null
+++ b/src/domain/csv.ts
@@ -0,0 +1,12 @@
+/**
+ * One line of CSV text: the fields joined by commas, each quoted when it holds a comma, a quote or a line break.
+ *
+ * @param fields - the values of the line, in column order
+ */
+export function csvLine(fields: readonly string[]): string {
+  return fields.map(csvField).join(',');
+}
+
+function csvField(text: string): string {
+  return /[",\r\n]/.test(text) ? `"${text.replaceAll('"', '""')}"` : text;
+}
