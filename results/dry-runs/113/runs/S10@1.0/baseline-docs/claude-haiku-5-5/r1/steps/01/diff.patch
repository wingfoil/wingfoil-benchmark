@@ -0,0 +1,37 @@
+import type { Cents } from './money.ts';
+
+/** The discount codes the shop honours, as the newsletter gives them out. */
+export type DiscountCode = 'SPRING10' | 'WELCOME5';
+
+/** What a discount code takes off an order's items. Shipping is never discounted. */
+export interface Discount {
+  /** The items amount an order needs before the code applies, before any discount. */
+  readonly minItemsCents: Cents;
+  /** The discount on an order whose items come to `itemsCents`. */
+  amountCents(itemsCents: Cents): Cents;
+}
+
+const DISCOUNTS: Readonly<Record<DiscountCode, Discount>> = {
+  // 10 % of the items, rounded to the nearest cent with a half cent rounding up: (items * 10 + 50) / 100.
+  SPRING10: { minItemsCents: 0, amountCents: (itemsCents) => Math.floor((itemsCents * 10 + 50) / 100) },
+  WELCOME5: { minItemsCents: 3000, amountCents: () => 500 },
+};
+
+/**
+ * The discount a code stands for, if the shop honours it. Case and surrounding spaces do not matter.
+ *
+ * @param text - the code as the customer typed it
+ */
+export function parseDiscountCode(text: string): DiscountCode | undefined {
+  const code = text.trim().toUpperCase();
+  return Object.hasOwn(DISCOUNTS, code) ? (code as DiscountCode) : undefined;
+}
+
+/**
+ * The discount of a code the shop honours.
+ *
+ * @param code - a code from {@link parseDiscountCode}
+ */
+export function discountOf(code: DiscountCode): Discount {
+  return DISCOUNTS[code];
+}
