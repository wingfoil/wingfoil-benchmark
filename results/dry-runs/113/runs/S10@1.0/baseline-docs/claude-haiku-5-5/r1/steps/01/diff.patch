+
+describe('discount codes', () => {
+  function placed(shop: ReturnType<typeof stocked>, lines: { sku: string; quantity: number }[]) {
+    return valueOf(shop.orders.place({ customerId: 'c1', date: '2026-03-02', lines })).number;
+  }
+
+  it('takes 10 % off the items with SPRING10 and leaves shipping alone', () => {
+    const shop = stocked();
+    const number = placed(shop, [{ sku: 'APL-1KG', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 349, discountCents: 35, shippingCents: 490, totalCents: 804 });
+  });
+
+  it('rounds the SPRING10 discount half a cent up', () => {
+    const shop = stocked();
+    const number = placed(shop, [{ sku: 'APL-1KG', quantity: 5 }]);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 175);
+  });
+
+  it('decides free shipping on the items before the discount', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'CHE-2KG', name: 'Cheese, 2 kg', priceCents: 5100 }));
+    const number = placed(shop, [{ sku: 'CHE-2KG', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 5100, discountCents: 510, shippingCents: 0, totalCents: 4590 });
+  });
+
+  it('takes 5.00 € off with WELCOME5 on items of 30.00 € or more', () => {
+    const shop = stocked();
+    valueOf(shop.catalogue.add({ sku: 'SOAP-6', name: 'Soap, pack of 6', priceCents: 1500 }));
+    const number = placed(shop, [{ sku: 'SOAP-6', quantity: 2 }]);
+    valueOf(shop.orders.applyCode(number, 'WELCOME5'));
+    assert.deepEqual(valueOf(shop.orders.totals(number)), { itemsCents: 3000, discountCents: 500, shippingCents: 490, totalCents: 2990 });
+  });
+
+  it('refuses WELCOME5 on items under 30.00 € and leaves the order as it was', () => {
+    const shop = stocked();
+    const number = placed(shop, [{ sku: 'OIL-1L', quantity: 2 }]);
+    const refused = shop.orders.applyCode(number, 'WELCOME5');
+    assert.equal(refused.ok, false);
+    if (refused.ok) assert.fail('WELCOME5 should be refused');
+    assert.equal(refused.error.code, 'invalid');
+    assert.match(refused.error.message, /WELCOME5.*30\.00/);
+    assert.equal(valueOf(shop.orders.get(number)).discountCode, undefined);
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 0);
+  });
+
+  it('refuses an unknown code with an error that says why', () => {
+    const shop = stocked();
+    const number = placed(shop, [{ sku: 'OIL-1L', quantity: 1 }]);
+    const refused = shop.orders.applyCode(number, 'SUMMER50');
+    assert.equal(refused.ok, false);
+    if (refused.ok) assert.fail('an unknown code should be refused');
+    assert.equal(refused.error.code, 'invalid');
+    assert.match(refused.error.message, /SUMMER50/);
+    assert.equal(valueOf(shop.orders.get(number)).discountCode, undefined);
+  });
+
+  it('accepts a code typed in any case, with spaces around it', () => {
+    const shop = stocked();
+    const number = placed(shop, [{ sku: 'HAM-W', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(number, ' spring10 '));
+    assert.equal(valueOf(shop.orders.get(number)).discountCode, 'SPRING10');
+  });
+
+  it('replaces the code an order has with a new one', () => {
+    const shop = stocked();
+    const number = placed(shop, [{ sku: 'HAM-W', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    valueOf(shop.orders.applyCode(number, 'WELCOME5'));
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 500);
+  });
+
+  it('keeps the first code when a second one is refused', () => {
+    const shop = stocked();
+    const number = placed(shop, [{ sku: 'APL-1KG', quantity: 1 }]);
+    valueOf(shop.orders.applyCode(number, 'SPRING10'));
+    assert.equal(shop.orders.applyCode(number, 'WELCOME5').ok, false);
+    assert.equal(valueOf(shop.orders.get(number)).discountCode, 'SPRING10');
+    assert.equal(valueOf(shop.orders.totals(number)).discountCents, 35);
+  });
+
+  it('refuses a code for an order that does not exist', () => {
+    const shop = stocked();
+    const refused = shop.orders.applyCode(9, 'SPRING10');
+    assert.equal(refused.ok, false);
+    if (refused.ok) assert.fail('an unknown order should be refused');
+    assert.equal(refused.error.code, 'not-found');
+  });
