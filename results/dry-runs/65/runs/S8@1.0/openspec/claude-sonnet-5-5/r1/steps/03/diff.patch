+
+  describe('input validation', () => {
+    const code = (r: { ok: boolean; error?: { code: string } }) => (r.ok ? 'ok' : r.error?.code);
+
+    it('rejects blank and too long titles on add and rename', () => {
+      const list = createTodoList();
+      list.add({ title: 'keep' });
+      assert.equal(code(list.add({ title: '   ' })), 'invalid-input');
+      assert.equal(code(list.add({ title: '' })), 'invalid-input');
+      assert.equal(code(list.add({ title: 'x'.repeat(121) })), 'invalid-input');
+      assert.equal(code(list.rename('keep', '  ')), 'invalid-input');
+      assert.equal(code(list.rename('keep', 'x'.repeat(121))), 'invalid-input');
+      assert.equal(code(list.add({ title: 'x'.repeat(120) })), 'ok');
+      assert.equal(list.list().length, 2);
+    });
+
+    it('rejects an unknown priority', () => {
+      const list = createTodoList();
+      assert.equal(code(list.add({ title: 'a', priority: 'urgent' as never })), 'invalid-input');
+      assert.equal(list.list().length, 0);
+    });
+
+    it('rejects empty tags and tags with a space, on add and tag', () => {
+      const list = createTodoList();
+      assert.equal(code(list.add({ title: 'a', tags: ['ok', 'to do'] })), 'invalid-input');
+      assert.equal(code(list.add({ title: 'a', tags: [''] })), 'invalid-input');
+      list.add({ title: 'b' });
+      assert.equal(code(list.tag('b', '')), 'invalid-input');
+      assert.equal(code(list.tag('b', 'to do')), 'invalid-input');
+    });
+
+    it('changes nothing when input is rejected', () => {
+      let tick = 0;
+      const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)));
+      list.add({ title: 'a' });
+      const before = valueOf(list.find('a'));
+      list.rename('a', '');
+      list.tag('a', 'x y');
+      list.add({ title: ' ' });
+      assert.deepEqual(valueOf(list.find('a')), before);
+      assert.equal(valueOf(list.add({ title: 'b' })).id, '2');
+    });
+  });
 });
