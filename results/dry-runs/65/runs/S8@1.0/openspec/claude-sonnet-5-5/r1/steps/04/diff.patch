index 0000000000000000000000000000000000000000..b66304ce61991d33c7f5377dcc59c4eb94462091
--- /dev/null
+++ b/src/domain/import.ts
@@ -0,0 +1,50 @@
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { TaskList } from './list.ts';
+import type { NewTask, Priority } from './task.ts';
+
+/** A line of the imported text that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** What an import did: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+function parseLine(text: string): Result<NewTask> {
+  const fields = text.split(';');
+  if (fields.length > 3) {
+    return err('invalid-input', `the line has ${fields.length} fields; the limit is 3 (title;priority;tags)`);
+  }
+  const [title = '', priority = '', tags = ''] = fields.map((field) => field.trim());
+  return ok({
+    title,
+    ...(priority === '' ? {} : { priority: priority as Priority }),
+    tags: tags.split(/\s+/).filter((tag) => tag !== ''),
+  });
+}
+
+/**
+ * Adds the tasks written in `text` to `list`. Each non-blank line is `title;priority;tags`: the priority may
+ * be empty for a normal one, the tags are separated by spaces. A line that cannot be added is reported and
+ * the others are still imported.
+ *
+ * @param list - the task list to add to
+ * @param text - one task per line; blank lines are skipped
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  const rejected: RejectedLine[] = [];
+  let imported = 0;
+  String(text ?? '').split(/\r?\n/).forEach((raw, index) => {
+    if (raw.trim() === '') return;
+    const parsed = parseLine(raw);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
