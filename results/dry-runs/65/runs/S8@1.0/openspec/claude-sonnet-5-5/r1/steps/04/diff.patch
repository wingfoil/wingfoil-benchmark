index 0000000000000000000000000000000000000000..8b21af0ebcd12cbe43273cf7b39659a684cce65e
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,56 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('imports a full line', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money');
+    assert.deepEqual(report, { imported: 1, rejected: [] });
+    const [task] = list.list();
+    assert.equal(task?.title, 'Renew the insurance');
+    assert.equal(task?.priority, 'high');
+    assert.deepEqual(task?.tags, ['admin', 'money']);
+  });
+
+  it('defaults an empty priority and accepts a title only', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Buy milk;;home\nCall the plumber');
+    assert.equal(report.imported, 2);
+    assert.equal(list.find('Buy milk').ok && list.list({ tag: 'home' })[0]?.priority, 'normal');
+    assert.deepEqual(list.list().find((t) => t.title === 'Call the plumber')?.tags, []);
+  });
+
+  it('skips blank lines but counts them in line numbers', () => {
+    const list = createTodoList();
+    assert.deepEqual(importTasks(list, 'A;;\n\nB;;'), { imported: 2, rejected: [] });
+    const report = importTasks(createTodoList(), 'A;;\n  \n;high;');
+    assert.equal(report.imported, 1);
+    assert.equal(report.rejected.length, 1);
+    assert.equal(report.rejected[0]?.line, 3);
+  });
+
+  it('handles empty text and CRLF', () => {
+    assert.deepEqual(importTasks(createTodoList(), ''), { imported: 0, rejected: [] });
+    assert.deepEqual(importTasks(createTodoList(), 'A;low;x\r\nB;;\r\n'), { imported: 2, rejected: [] });
+  });
+
+  it('rejects bad priorities, tags and extra fields, and keeps the valid lines', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Pay rent;urgent;money\nOk;;a\nA;high;x;y\nT;;a b');
+    assert.equal(report.imported, 2);
+    assert.deepEqual(report.rejected.map((r) => r.line), [1, 3]);
+    assert.match(report.rejected[0]?.reason ?? '', /priority/);
+    assert.deepEqual(list.list().map((t) => t.title).sort(), ['Ok', 'T']);
+  });
+
+  it('rejects duplicate titles, in the list or in the text', () => {
+    const list = createTodoList();
+    list.add({ title: 'Old' });
+    const report = importTasks(list, 'Old;;\nA;;\nA;high;');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(report.rejected.map((r) => r.line), [1, 3]);
+    assert.equal(list.list().length, 2);
+  });
+});
