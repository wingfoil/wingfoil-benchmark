+describe('task timestamps', () => {
+  function clockList() {
+    let tick = 0;
+    const list = createTodoList(() => new Date(Date.UTC(2026, 0, 1, 0, 0, tick++)));
+    return list;
+  }
+
+  it('sets createdAt and updatedAt equal on add', () => {
+    const task = valueOf(clockList().add({ title: 'A' }));
+    assert.equal(task.createdAt, '2026-01-01T00:00:00.000Z');
+    assert.equal(task.updatedAt, task.createdAt);
+  });
+
+  it('sets updatedAt on each change and keeps createdAt', () => {
+    const list = clockList();
+    const added = valueOf(list.add({ title: 'A' }));
+    const steps = [
+      () => list.complete('A'),
+      () => list.reopen('A'),
+      () => list.rename('A', 'B'),
+      () => list.tag('B', 'x'),
+      () => list.untag('B', 'x'),
+    ];
+    let previous = added.updatedAt;
+    for (const step of steps) {
+      const task = valueOf(step());
+      assert.ok(task.updatedAt > previous);
+      assert.equal(task.createdAt, added.createdAt);
+      previous = task.updatedAt;
+    }
+  });
+
+  it('leaves updatedAt alone when a change fails', () => {
+    const list = clockList();
+    list.add({ title: 'A' });
+    const done = valueOf(list.complete('A'));
+    assert.equal(list.complete('A').ok, false);
+    assert.equal(valueOf(list.get(done.id)).updatedAt, done.updatedAt);
+  });
+});
