diff --git a/src/index.ts b/src/index.ts
index 05e7f077fb47748bcd91c95b26245b3832e5ecef..ae95675a8f75d154a20d3f7625887c1fdd43710c 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -95,7 +95,7 @@ function validateOperation(operation: unknown, index: number): PatchOperation {
   if (typeof operation.path !== "string") {
     throw invalidOperation(index, `"path" must be a string`);
   }
-  if (required === "value" && !Object.hasOwn(operation, "value")) {
+  if (required === "value" && (!Object.hasOwn(operation, "value") || operation.value === undefined)) {
     throw invalidOperation(index, `"${op}" requires a "value" member`);
   }
   if (required === "from" && typeof operation.from !== "string") {
@@ -235,8 +235,8 @@ export function applyPatch(document: JsonValue, patch: PatchOperation[]): JsonVa
   if (!Array.isArray(patch)) {
     throw new TypeError("A JSON Patch document must be an array of operations");
   }
-  return patch.reduce<JsonValue>(
-    (root, operation, index) => applyOperation(root, validateOperation(operation, index)),
-    structuredClone(document),
-  );
+  // Section 4: a malformed operation invalidates the whole patch, whatever earlier operations do.
+  // Array.from visits holes of a sparse array, which reduce would skip.
+  const operations = Array.from(patch, validateOperation);
+  return operations.reduce<JsonValue>(applyOperation, structuredClone(document));
