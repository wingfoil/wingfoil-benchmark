+export interface AvailabilityQuery {
+  /** ISO-8601 instant, midnight UTC: first day of the period. */
+  start: string;
+  /** ISO-8601 instant, midnight UTC: the start of the day after the last day. */
+  end: string;
+  /** Restricts the result to this kind of equipment; any kind when omitted. */
