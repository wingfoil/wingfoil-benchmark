@@ -176,3 +176,50 @@ test('addEquipment validates the hourly price', () => {
   assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 1.5 }));
   assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: -1 }));
 });
+
+const booked = () => {
+  const service = setup();
+  const booking = service.book(period('2026-07-10T00:00:00Z', '2026-07-12T00:00:00Z'));
+  return { service, booking };
+};
+
+test('cancel refunds the full total 48 hours or more before the start', () => {
+  const { service, booking } = booked();
+  assert.deepEqual(service.cancel(booking.id, '2026-07-08T00:00:00Z'), { bookingId: booking.id, refund: 5000 });
+});
+
+test('cancel refunds half, rounded to the cent, less than 48 hours before the start', () => {
+  const { service, booking } = booked();
+  assert.equal(service.cancel(booking.id, '2026-07-08T00:00:01Z').refund, 2500);
+  const odd = setup();
+  odd.addEquipment({ id: 'board-o', kind: 'board', dailyPrice: 2501 });
+  const oddBooking = odd.book({ itemId: 'board-o', start: '2026-07-10T00:00:00Z', end: '2026-07-11T00:00:00Z' });
+  assert.equal(odd.cancel(oddBooking.id, '2026-07-09T12:00:00Z').refund, 1251);
+});
+
+test('cancel refunds nothing at or after the start', () => {
+  const first = booked();
+  assert.equal(first.service.cancel(first.booking.id, '2026-07-10T00:00:00Z').refund, 0);
+  const second = booked();
+  assert.equal(second.service.cancel(second.booking.id, '2026-07-11T00:00:00Z').refund, 0);
+});
+
+test('a cancelled booking frees its equipment', () => {
+  const { service, booking } = booked();
+  assert.throws(() => service.book(period('2026-07-11T00:00:00Z', '2026-07-12T00:00:00Z')));
+  service.cancel(booking.id, '2026-07-01T00:00:00Z');
+  service.book(period('2026-07-11T00:00:00Z', '2026-07-12T00:00:00Z'));
+});
+
+test('a booking can only be cancelled once', () => {
+  const { service, booking } = booked();
+  service.cancel(booking.id, '2026-07-01T00:00:00Z');
+  assert.throws(() => service.cancel(booking.id, '2026-07-01T00:00:00Z'));
+});
+
+test('cancel rejects unknown bookings and invalid times', () => {
+  const { service, booking } = booked();
+  assert.throws(() => service.cancel('booking-99', '2026-07-01T00:00:00Z'));
+  assert.throws(() => service.cancel(booking.id, 'garbage'));
+  service.cancel(booking.id, '2026-07-01T00:00:00Z');
