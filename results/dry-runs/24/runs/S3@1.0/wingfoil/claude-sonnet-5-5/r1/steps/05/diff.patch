+
+/** Refund in euro cents for cancelling a booking of `total` at `at`; half is rounded to the nearest cent. */
+function refundFor(total: number, start: number, at: number): number {
+  if (at >= start) return 0;
+  if (start - at >= FULL_REFUND_NOTICE_MS) return total;
+  return Math.round((total * LATE_REFUND_PERCENT) / 100);
+}
