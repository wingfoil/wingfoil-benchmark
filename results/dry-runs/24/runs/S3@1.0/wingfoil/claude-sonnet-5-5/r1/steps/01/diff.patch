+++ b/test/rental.test.ts
@@ -0,0 +1,84 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+const setup = () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1500 });
+  return service;
+};
+
+const period = (start: string, end: string) => ({ itemId: 'board-1', start, end });
+
+test('quote prices whole days at the daily price', () => {
+  const quote = setup().quote(period('2026-07-01T00:00:00Z', '2026-07-04T00:00:00Z'));
+  assert.deepEqual(quote, {
+    itemId: 'board-1',
+    start: '2026-07-01T00:00:00.000Z',
+    end: '2026-07-04T00:00:00.000Z',
+    total: 7500,
+  });
+});
+
+test('quote rejects unknown items', () => {
+  assert.throws(() => setup().quote({ itemId: 'nope', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+});
+
+test('quote rejects periods that are not whole UTC days', () => {
+  const service = setup();
+  assert.throws(() => service.quote(period('2026-07-01T10:00:00Z', '2026-07-02T10:00:00Z')));
+  assert.throws(() => service.quote(period('2026-07-01T00:00:00+02:00', '2026-07-02T00:00:00+02:00')));
+  assert.throws(() => service.quote(period('garbage', '2026-07-02T00:00:00Z')));
+});
+
+test('quote rejects empty and reversed periods', () => {
+  const service = setup();
+  assert.throws(() => service.quote(period('2026-07-02T00:00:00Z', '2026-07-02T00:00:00Z')));
+  assert.throws(() => service.quote(period('2026-07-03T00:00:00Z', '2026-07-02T00:00:00Z')));
+});
+
+test('book returns a booking with an id and the quoted total', () => {
+  const booking = setup().book(period('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z'));
+  assert.equal(typeof booking.id, 'string');
+  assert.equal(booking.itemId, 'board-1');
+  assert.equal(booking.total, 2500);
+});
+
+test('book gives distinct ids', () => {
+  const service = setup();
+  const a = service.book(period('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z'));
+  const b = service.book(period('2026-07-02T00:00:00Z', '2026-07-03T00:00:00Z'));
+  assert.notEqual(a.id, b.id);
+});
+
+test('book rejects overlapping periods for the same item', () => {
+  const service = setup();
+  service.book(period('2026-07-01T00:00:00Z', '2026-07-04T00:00:00Z'));
+  assert.throws(() => service.book(period('2026-07-03T00:00:00Z', '2026-07-05T00:00:00Z')));
+  assert.throws(() => service.book(period('2026-06-29T00:00:00Z', '2026-07-02T00:00:00Z')));
+  assert.throws(() => service.book(period('2026-07-02T00:00:00Z', '2026-07-03T00:00:00Z')));
+});
+
+test('back-to-back periods and other items do not conflict', () => {
+  const service = setup();
+  service.book(period('2026-07-01T00:00:00Z', '2026-07-04T00:00:00Z'));
+  service.book(period('2026-07-04T00:00:00Z', '2026-07-05T00:00:00Z'));
+  service.book(period('2026-06-30T00:00:00Z', '2026-07-01T00:00:00Z'));
+  service.book({ itemId: 'sail-1', start: '2026-07-01T00:00:00Z', end: '2026-07-04T00:00:00Z' });
+});
+
+test('book rejects unknown items and invalid periods', () => {
+  const service = setup();
+  assert.throws(() => service.book({ itemId: 'nope', start: '2026-07-01T00:00:00Z', end: '2026-07-02T00:00:00Z' }));
+  assert.throws(() => service.book(period('2026-07-01T05:00:00Z', '2026-07-02T00:00:00Z')));
+});
+
+test('addEquipment validates the item and rejects duplicates', () => {
+  const service = setup();
+  assert.throws(() => service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 100 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: -1 }));
+  assert.throws(() => service.addEquipment({ id: '', kind: 'board', dailyPrice: 100 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'mast' as 'board', dailyPrice: 100 }));
+});
