diff --git a/test/rental.test.ts b/test/rental.test.ts
index f93186aef257fe2808e3ff1e814e0acfd459ead6..e2e7a1d3945a53fe24696d0d20641a81506a33dd 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -121,3 +121,58 @@ test('book charges the discounted total', () => {
   const booking = setup().book(period('2026-07-01T00:00:00Z', '2026-07-04T00:00:00Z'));
   assert.equal(booking.total, 6750);
 });
+
+const hourly = () => {
+  const service = setup();
+  service.addEquipment({ id: 'board-h', kind: 'board', dailyPrice: 4000, hourlyPrice: 900 });
+  return service;
+};
+
+const hours = (start: string, end: string) => ({ itemId: 'board-h', start, end });
+
+test('a rental shorter than a day on the hour costs the hourly price for each hour', () => {
+  const quote = hourly().quote(hours('2026-07-01T13:00:00Z', '2026-07-01T17:00:00Z'));
+  assert.deepEqual(quote, {
+    itemId: 'board-h',
+    start: '2026-07-01T13:00:00.000Z',
+    end: '2026-07-01T17:00:00.000Z',
+    total: 3600,
+  });
+});
+
+test('an hourly rental can cross midnight and book charges the hourly total', () => {
+  const booking = hourly().book(hours('2026-07-01T22:00:00Z', '2026-07-02T01:00:00Z'));
+  assert.equal(booking.total, 2700);
+});
+
+test('an item without an hourly price cannot be rented by the hour', () => {
+  assert.throws(() => setup().quote(period('2026-07-01T13:00:00Z', '2026-07-01T17:00:00Z')));
+  assert.throws(() => setup().book(period('2026-07-01T13:00:00Z', '2026-07-01T17:00:00Z')));
+});
+
+test('hourly rentals must start and end on the hour, in UTC', () => {
+  const service = hourly();
+  assert.throws(() => service.quote(hours('2026-07-01T13:30:00Z', '2026-07-01T17:00:00Z')));
+  assert.throws(() => service.quote(hours('2026-07-01T13:00:00Z', '2026-07-01T17:00:30Z')));
+  assert.throws(() => service.quote(hours('2026-07-01T13:00:00+05:30', '2026-07-01T17:00:00+05:30')));
+});
+
+test('a rental of a day or more still needs whole days', () => {
+  const service = hourly();
+  assert.throws(() => service.quote(hours('2026-07-01T13:00:00Z', '2026-07-02T13:00:00Z')));
+  assert.equal(service.quote(hours('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z')).total, 4000);
+});
+
+test('hourly bookings conflict with overlapping periods only', () => {
+  const service = hourly();
+  service.book(hours('2026-07-01T13:00:00Z', '2026-07-01T15:00:00Z'));
+  service.book(hours('2026-07-01T15:00:00Z', '2026-07-01T16:00:00Z'));
+  assert.throws(() => service.book(hours('2026-07-01T14:00:00Z', '2026-07-01T16:00:00Z')));
+  assert.throws(() => service.book(hours('2026-07-01T00:00:00Z', '2026-07-02T00:00:00Z')));
+});
+
+test('addEquipment validates the hourly price', () => {
+  const service = setup();
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: 1.5 }));
+  assert.throws(() => service.addEquipment({ id: 'x', kind: 'board', dailyPrice: 100, hourlyPrice: -1 }));
+});
