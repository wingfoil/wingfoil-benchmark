+/** Parses a rental period: on the hour when shorter than a day, whole days otherwise. */
+function parseRentalPeriod(request: Pick<RentalRequest, 'start' | 'end'>): Period {
+  const start = parseHourBoundary(request.start);
+  const end = parseHourBoundary(request.end);
+  if (end <= start) throw new Error('A rental must not be empty');
+  if (end - start >= MS_PER_DAY) return parsePeriod(request);
+  return { start, end };
+}
