+/** Parses an ISO-8601 instant and requires it to fall on the hour, UTC. */
+function parseHourBoundary(value: string): number {
+  const time = parseInstant(value);
+  if (time % MS_PER_HOUR !== 0) throw new Error(`Not on the hour, UTC: ${value}`);
+  return time;
+}
+
+/** Total in euro cents for renting `item` over `period`; long rentals are discounted, rounded to the nearest cent. */
+function rentalTotal(period: Period, item: Equipment): number {
+  const length = period.end - period.start;
+  if (length < MS_PER_DAY) {
+    if (item.hourlyPrice === undefined) throw new Error(`${item.id} cannot be rented by the hour`);
+    return (length / MS_PER_HOUR) * item.hourlyPrice;
+  }
+  const days = length / MS_PER_DAY;
+  const full = days * item.dailyPrice;
   return days >= LONG_RENTAL_DAYS ? Math.round((full * LONG_RENTAL_PERCENT) / 100) : full;
 }
 
