+
+/** Parses an ISO-8601 instant and requires it to fall on midnight UTC. */
+function parseDayBoundary(value: string): number {
+  const time = parseInstant(value);
   if (time % MS_PER_DAY !== 0) throw new Error(`Not midnight UTC: ${value}`);
   return time;
 }
 
