+
+function validateTitle(title: string): Result<string> {
+  if (typeof title !== 'string' || title.trim().length === 0) {
+    return err('invalid-input', 'title must not be empty or only whitespace');
+  }
+  const trimmed = title.trim();
+  if (trimmed.length > 120) {
+    return err('invalid-input', 'title must be at most 120 characters');
+  }
+  return ok(trimmed);
+}
+
+function validateTag(tag: string): Result<string> {
+  if (typeof tag !== 'string' || tag.length === 0) {
+    return err('invalid-input', 'tag must not be empty');
+  }
+  if (/\s/u.test(tag)) return err('invalid-input', 'tag must not contain whitespace');
+  return ok(tag);
