+++ b/src/domain/import.ts
@@ -0,0 +1,47 @@
+import type { TaskList } from './list.ts';
+import { PRIORITIES } from './task.ts';
+
+/** A rejected input row, with its original, one-based line number. */
+export interface ImportRejection {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The tasks added and the rows that could not be added. */
+export interface ImportResult {
+  readonly imported: number;
+  readonly rejected: readonly ImportRejection[];
+}
+
+/**
+ * Add rows formatted as title;priority;tags, continuing after rejected rows.
+ * Blank lines are skipped; an empty priority means normal. Tags are whitespace-separated.
+ */
+export function importTasks(list: TaskList, text: string): ImportResult {
+  let imported = 0;
+  const rejected: ImportRejection[] = [];
+
+  for (const [index, row] of text.split(/\r\n|\n|\r/u).entries()) {
+    if (row.trim() === '') continue;
+    const line = index + 1;
+    const fields = row.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line, reason: 'expected title;priority;tags (three fields)' });
+      continue;
+    }
+
+    const [title, priorityText, tagsText] = fields;
+    const priority = PRIORITIES.find((value) => value === (priorityText.trim() || 'normal'));
+    if (priority === undefined) {
+      rejected.push({ line, reason: 'priority must be low, normal or high' });
+      continue;
+    }
+
+    const tags = tagsText.trim() === '' ? [] : tagsText.trim().split(/\s+/u);
+    const result = list.add({ title, priority, tags });
+    if (result.ok) imported += 1;
+    else rejected.push({ line, reason: result.error.message });
+  }
+
+  return { imported, rejected };
+}
