@@ -0,0 +1,76 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds tasks with all priorities, trimmed fields, and unique space-separated tags', () => {
+    const list = createTodoList();
+    const result = importTasks(list, [
+      ' Renew the insurance ; high ; admin  money admin ',
+      'Buy milk;;',
+      'Water plants;low;garden',
+      'Clean;normal;home\tweekly',
+    ].join('\n'));
+
+    assert.deepEqual(result, { imported: 4, rejected: [] });
+    assert.deepEqual(
+      list.list().map(({ title, priority, tags, status }) => ({ title, priority, tags, status })),
+      [
+        { title: 'Renew the insurance', priority: 'high', tags: ['admin', 'money'], status: 'open' },
+        { title: 'Buy milk', priority: 'normal', tags: [], status: 'open' },
+        { title: 'Clean', priority: 'normal', tags: ['home', 'weekly'], status: 'open' },
+        { title: 'Water plants', priority: 'low', tags: ['garden'], status: 'open' },
+      ],
+    );
+    for (const task of list.list()) {
+      assert.equal(task.createdAt, task.updatedAt);
+      assert.equal(list.get(task.id).ok, true);
+    }
+  });
+
+  it('reports every rejected row and continues adding valid rows', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing', tags: ['keep'] });
+    const before = structuredClone(list.list());
+    const result = importTasks(list, [
+      'Existing;high;changed',
+      'First;;',
+      ' First ;low;',
+      '',
+      ';normal;',
+      `${'x'.repeat(121)};;`,
+      'Bad priority;urgent;',
+      'Missing fields',
+      'Only two;high',
+      'Extra;low;tag;field',
+      'Last;;good',
+    ].join('\n'));
+
+    assert.equal(result.imported, 2);
+    assert.deepEqual(result.rejected.map(({ line }) => line), [1, 3, 5, 6, 7, 8, 9, 10]);
+    const reasons = [/already.*Existing/, /already.*First/, /title.*empty/, /title.*120/,
+      /priority.*low.*normal.*high/, /three fields/, /three fields/, /three fields/];
+    result.rejected.forEach(({ reason }, index) => assert.match(reason, reasons[index]));
+    assert.equal(list.list().length, 3);
+    assert.deepEqual(list.list().find((task) => task.title === 'Existing'), before[0]);
+    assert.equal(list.find('Last').ok, true);
+  });
+
+  it('skips blank lines and preserves line numbers across common line endings', () => {
+    const list = createTodoList();
+    const result = importTasks(list, '\r\n  \r\nFirst;;\rBroken\n\t\nLast; ;  \r\n');
+    assert.equal(result.imported, 2);
+    assert.deepEqual(result.rejected, [
+      { line: 4, reason: 'expected title;priority;tags (three fields)' },
+    ]);
+  });
+
+  it('does nothing for empty or whitespace-only input', () => {
+    const list = createTodoList();
+    for (const text of ['', ' \n\t\r\n  ']) {
+      assert.deepEqual(importTasks(list, text), { imported: 0, rejected: [] });
+    }
+    assert.deepEqual(list.list(), []);
+  });
+});
