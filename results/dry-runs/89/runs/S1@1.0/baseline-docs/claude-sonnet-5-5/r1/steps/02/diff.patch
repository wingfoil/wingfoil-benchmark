diff --git a/test/patch.test.ts b/test/patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..20bd6ca7e5e559e520a1f00ba80d8345c7662c79
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,148 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+test("add: member, array insertion, append with '-' and whole document (RFC 6902 A.1, A.3, A.4)", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), {
+    foo: "bar",
+    baz: "qux",
+  });
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), {
+    foo: ["bar", "qux", "baz"],
+  });
+  assert.deepEqual(applyPatch({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(applyPatch({ foo: [1] }, [{ op: "add", path: "/foo/1", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [true] }]), [true]);
+});
+
+test("add: replaces an existing member, and rejects a missing parent or a bad index", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "/a", value: 2 }]), { a: 2 });
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/b/c", value: 1 }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/3", value: 1 }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "add", path: "/a/01", value: 1 }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]));
+});
+
+test("remove: member and array element; missing target fails", () => {
+  assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), {
+    foo: ["bar", "baz"],
+  });
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "/b" }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "remove", path: "/a/1" }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "remove", path: "/a/-" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]));
+});
+
+test("replace: value, whole document; missing target fails", () => {
+  assert.deepEqual(applyPatch({ baz: "qux" }, [{ op: "replace", path: "/baz", value: "boo" }]), { baz: "boo" });
+  assert.deepEqual(applyPatch([1, 2], [{ op: "replace", path: "/1", value: 9 }]), [1, 9]);
+  assert.equal(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "replace", path: "/b", value: 1 }]));
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/1", value: 1 }]));
+});
+
+test("move: RFC 6902 A.6 and A.7; same location; into own child fails", () => {
+  assert.deepEqual(
+    applyPatch({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } }, [
+      { op: "move", from: "/foo/waldo", path: "/qux/thud" },
+    ]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } },
+  );
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.throws(() => applyPatch({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "move", from: "/x", path: "/y" }]));
+});
+
+test("copy: duplicates deeply; missing source fails", () => {
+  const result = applyPatch({ a: { b: [1] } }, [{ op: "copy", from: "/a", path: "/c" }]) as any;
+  assert.deepEqual(result, { a: { b: [1] }, c: { b: [1] } });
+  assert.notEqual(result.a, result.c);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "copy", from: "/x", path: "/y" }]));
+});
+
+test("test: equal values pass, any difference fails", () => {
+  const doc = { a: { x: 1, y: [1, { z: null }] }, s: "v" };
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }]), doc);
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "", value: doc }]), doc);
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/s", value: "w" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/s", value: 1 }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/y", value: [1] }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a", value: { x: 1 } }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/missing", value: null }]));
+  assert.deepEqual(applyPatch({ n: null }, [{ op: "test", path: "/n", value: null }]), { n: null });
+});
+
+test("operations apply in order and an error aborts the whole patch", () => {
+  assert.deepEqual(
+    applyPatch({}, [
+      { op: "add", path: "/a", value: 1 },
+      { op: "copy", from: "/a", path: "/b" },
+      { op: "test", path: "/b", value: 1 },
+    ]),
+    { a: 1, b: 1 },
+  );
+  assert.throws(() =>
+    applyPatch({}, [
+      { op: "add", path: "/a", value: 1 },
+      { op: "test", path: "/a", value: 2 },
+    ]),
+  );
+  assert.deepEqual(applyPatch({ a: 1 }, []), { a: 1 });
+});
+
+test("does not mutate the document or the patch, and shares no structure with them", () => {
+  const doc = { a: { b: [1, 2] } };
+  const value = { n: [1] };
+  const patch = [
+    { op: "add", path: "/a/b/-", value: 3 },
+    { op: "add", path: "/v", value },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const result = applyPatch(doc, patch) as any;
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.notEqual(result.v, value);
+  assert.notEqual(result.a, doc.a);
+  (result.v.n as number[]).push(2);
+  assert.deepEqual(value, { n: [1] });
+});
+
+test("pointers use RFC 6901 escapes and never reach inherited members", () => {
+  assert.deepEqual(applyPatch({ "a/b": 1, "m~n": 2 }, [{ op: "replace", path: "/a~1b", value: 3 }]), {
+    "a/b": 3,
+    "m~n": 2,
+  });
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/toString" }]));
+  const polluted = applyPatch({}, [{ op: "add", path: "/__proto__", value: { x: 1 } }]) as any;
+  assert.equal(Object.getPrototypeOf(polluted), Object.prototype);
+  assert.deepEqual(Object.keys(polluted), ["__proto__"]);
+  assert.equal(({} as any).x, undefined);
+});
+
+test("invalid patches are rejected", () => {
+  const bad: unknown[] = [
+    {},
+    null,
+    [null],
+    [[]],
+    [{ path: "/a", value: 1 }],
+    [{ op: "bogus", path: "/a" }],
+    [{ op: "add", value: 1 }],
+    [{ op: "add", path: "a", value: 1 }],
+    [{ op: "add", path: "/a" }],
+    [{ op: "replace", path: "/a" }],
+    [{ op: "test", path: "/a" }],
+    [{ op: "move", path: "/a" }],
+    [{ op: "copy", path: "/a" }],
+    [{ op: "move", from: "x", path: "/a" }],
+    [{ op: "remove", path: 1 }],
+  ];
+  for (const patch of bad) {
+    assert.throws(() => applyPatch({ a: 1 }, patch as never), Error, JSON.stringify(patch));
+  }
+});
