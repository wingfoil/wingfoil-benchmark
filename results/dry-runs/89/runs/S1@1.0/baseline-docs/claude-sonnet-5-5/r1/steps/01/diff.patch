index 0000000000000000000000000000000000000000..c5599ce23d4d5c25750e2e00bbae18433b9c4cd6
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,77 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+// The document of RFC 6901, section 5.
+const rfc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.equal(resolvePointer(rfc, ""), rfc);
+  assert.deepEqual(resolvePointer(rfc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(rfc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(rfc, "/"), 0);
+  assert.equal(resolvePointer(rfc, "/a~1b"), 1);
+  assert.equal(resolvePointer(rfc, "/c%d"), 2);
+  assert.equal(resolvePointer(rfc, "/e^f"), 3);
+  assert.equal(resolvePointer(rfc, "/g|h"), 4);
+  assert.equal(resolvePointer(rfc, "/i\\j"), 5);
+  assert.equal(resolvePointer(rfc, '/k"l'), 6);
+  assert.equal(resolvePointer(rfc, "/ "), 7);
+  assert.equal(resolvePointer(rfc, "/m~0n"), 8);
+});
+
+test("unescapes ~01 as ~1, not as /", () => {
+  assert.equal(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+});
+
+test("resolves falsy and null values", () => {
+  assert.equal(resolvePointer({ a: null }, "/a"), null);
+  assert.equal(resolvePointer({ a: false }, "/a"), false);
+  assert.equal(resolvePointer([0], "/0"), 0);
+  assert.equal(resolvePointer(null, ""), null);
+});
+
+test("rejects pointers that are not valid", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "a"));
+  assert.throws(() => resolvePointer({ "~": 1 }, "/~"));
+  assert.throws(() => resolvePointer({ "~2": 1 }, "/~2"));
+  assert.throws(() => resolvePointer({}, undefined as unknown as string));
+});
+
+test("throws when a member is missing", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"));
+  assert.throws(() => resolvePointer({ a: { b: 1 } }, "/a/c"));
+});
+
+test("does not resolve inherited properties", () => {
+  assert.throws(() => resolvePointer({}, "/toString"));
+  assert.throws(() => resolvePointer({}, "/__proto__"));
+  assert.throws(() => resolvePointer([], "/length"));
+});
+
+test("array indexes", () => {
+  assert.throws(() => resolvePointer(["a"], "/1"));
+  assert.throws(() => resolvePointer(["a"], "/-"));
+  assert.throws(() => resolvePointer(["a", "b"], "/01"));
+  assert.throws(() => resolvePointer(["a"], "/+0"));
+  assert.throws(() => resolvePointer(["a"], "/-0"));
+  assert.throws(() => resolvePointer(["a"], "/0.0"));
+  assert.throws(() => resolvePointer(["a"], "/"));
+});
+
+test("throws when descending into a scalar", () => {
+  assert.throws(() => resolvePointer({ a: "str" }, "/a/0"));
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"));
+  assert.throws(() => resolvePointer(5, "/a"));
+});
