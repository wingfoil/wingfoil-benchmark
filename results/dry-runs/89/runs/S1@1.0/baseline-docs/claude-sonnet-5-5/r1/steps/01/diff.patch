index 0000000000000000000000000000000000000000..16f3751eeed7e7038b4ecdf732333b57322e3be3
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,46 @@
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/** Decodes one reference token (RFC 6901, section 4); `~1` must be decoded before `~0`. */
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in token "${token}"`);
+  }
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+/** Returns the child of `node` named by `token`, or throws when there is none. */
+function step(node: unknown, token: string): unknown {
+  if (Array.isArray(node)) {
+    if (!ARRAY_INDEX.test(token) || Number(token) >= node.length) {
+      throw new Error(`JSON Pointer does not resolve: no array element "${token}"`);
+    }
+    return node[Number(token)];
+  }
+  if (typeof node === "object" && node !== null && Object.hasOwn(node, token)) {
+    return (node as Record<string, unknown>)[token];
+  }
+  throw new Error(`JSON Pointer does not resolve: no member "${token}"`);
+}
+
+/**
+ * Returns the value of `document` that the JSON Pointer `pointer` refers to (RFC 6901).
+ *
+ * @throws Error when `pointer` is not a valid JSON Pointer, or does not resolve to a value of
+ * `document` (missing member, out-of-range or `-` array index, or a scalar traversed).
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new TypeError("Invalid JSON Pointer: must be a string");
+  }
+  if (pointer === "") {
+    return document;
+  }
+  if (!pointer.startsWith("/")) {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map(unescapeToken)
+    .reduce(step, document);
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
