   assert.throws(() => s.addEquipment({ id: 'h3', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
 });
+
+test('cancel refunds in full at least 24h before start, nothing later, and frees the item', () => {
+  const s = setup();
+  s.addEquipment({ id: 'b0', kind: 'board', dailyPrice: 100 });
+  const a = s.book(r('2026-05-10T00:00:00Z', '2026-05-12T00:00:00Z'));
+  assert.deepEqual(s.cancel(a.id, '2026-05-09T00:00:00Z'), { bookingId: a.id, refund: a.total });
+  s.book(r('2026-05-10T00:00:00Z', '2026-05-12T00:00:00Z'));
+  const b = s.book(r('2026-05-20T00:00:00Z', '2026-05-21T00:00:00Z'));
+  assert.deepEqual(s.cancel(b.id, '2026-05-19T00:00:01Z'), { bookingId: b.id, refund: 0 });
+  assert.deepEqual(s.availability({ start: '2026-05-20T00:00:00Z', end: '2026-05-21T00:00:00Z', kind: 'board' }), ['b0', 'b1']);
+  const c = s.book(r('2026-06-01T00:00:00Z', '2026-06-02T00:00:00Z'));
+  assert.equal(s.cancel(c.id, '2026-06-05T10:30:00Z').refund, 0);
+});
+
+test('cancel rejects unknown bookings, repeats and bad times', () => {
+  const s = setup();
+  const a = s.book(r('2026-05-10T00:00:00Z', '2026-05-12T00:00:00Z'));
+  assert.throws(() => s.cancel('nope', '2026-05-01T00:00:00Z'));
+  assert.throws(() => s.cancel(a.id, 'yesterday'));
+  assert.throws(() => s.cancel(a.id, undefined as never));
+  s.cancel(a.id, '2026-05-01T00:00:00Z');
+  assert.throws(() => s.cancel(a.id, '2026-05-01T00:00:00Z'));
+});
