+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from './index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 2500 });
+  return s;
+}
+const r = (start: string, end: string, itemId = 'b1') => ({ itemId, start, end });
+
+test('quote multiplies days by daily price', () => {
+  assert.deepEqual(setup().quote(r('2026-05-01T00:00:00Z', '2026-05-04T00:00:00Z')), {
+    itemId: 'b1', start: '2026-05-01T00:00:00Z', end: '2026-05-04T00:00:00Z', total: 7500,
+  });
+});
+
+test('rejects unknown items and bad periods', () => {
+  const s = setup();
+  assert.throws(() => s.quote(r('2026-05-01T00:00:00Z', '2026-05-02T00:00:00Z', 'x')));
+  assert.throws(() => s.quote(r('2026-05-01T10:00:00Z', '2026-05-02T00:00:00Z')));
+  assert.throws(() => s.quote(r('2026-05-02T00:00:00Z', '2026-05-02T00:00:00Z')));
+  assert.throws(() => s.quote(r('2026-05-03T00:00:00Z', '2026-05-02T00:00:00Z')));
+  assert.throws(() => s.quote(r('2026-05-01T00:00:00+02:00', '2026-05-02T00:00:00Z')));
+  assert.throws(() => s.quote(r('nonsense', '2026-05-02T00:00:00Z')));
+});
+
+test('book rejects overlaps but allows adjacent periods and other items', () => {
+  const s = setup();
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  const first = s.book(r('2026-05-01T00:00:00Z', '2026-05-03T00:00:00Z'));
+  assert.equal(first.total, 5000);
+  assert.throws(() => s.book(r('2026-05-02T00:00:00Z', '2026-05-04T00:00:00Z')));
+  assert.throws(() => s.book(r('2026-04-30T00:00:00Z', '2026-05-02T00:00:00Z')));
+  const next = s.book(r('2026-05-03T00:00:00Z', '2026-05-04T00:00:00Z'));
+  assert.notEqual(next.id, first.id);
+  s.book(r('2026-05-01T00:00:00Z', '2026-05-03T00:00:00Z', 's1'));
+});
