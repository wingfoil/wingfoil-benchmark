@@ -58,3 +58,19 @@ test('availability lists free items of a kind, sorted', () => {
   assert.throws(() => s.availability({ start: q.end, end: q.start }));
   assert.throws(() => s.availability({ ...q, kind: 'car' as never }));
 });
+
+test('rentals shorter than a day are priced by the hour, only for items with an hourly price', () => {
+  const s = setup();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 700 });
+  assert.equal(s.quote(r('2026-05-01T09:00:00Z', '2026-05-01T13:00:00Z', 'h1')).total, 2800);
+  assert.equal(s.book(r('2026-05-01T22:00:00Z', '2026-05-02T02:00:00Z', 'h1')).total, 2800);
+  assert.equal(s.quote(r('2026-05-01T00:00:00Z', '2026-05-01T23:00:00Z', 'h1')).total, 16100);
+  assert.throws(() => s.quote(r('2026-05-01T09:00:00Z', '2026-05-01T13:00:00Z')));
+  assert.throws(() => s.quote(r('2026-05-01T09:30:00Z', '2026-05-01T13:00:00Z', 'h1')));
+  assert.throws(() => s.quote(r('2026-05-01T09:00:00Z', '2026-05-02T09:00:00Z', 'h1')));
+  s.book(r('2026-05-01T09:00:00Z', '2026-05-01T13:00:00Z', 'h1'));
+  assert.throws(() => s.book(r('2026-05-01T11:00:00Z', '2026-05-01T12:00:00Z', 'h1')));
+  s.book(r('2026-05-01T13:00:00Z', '2026-05-01T14:00:00Z', 'h1'));
+  assert.throws(() => s.addEquipment({ id: 'h2', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+  assert.throws(() => s.addEquipment({ id: 'h3', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+});
