+test('rentals under 3 days pay full price; 3 days or more get 10% off, in quotes and bookings', () => {
+  const s = setup();
+  assert.equal(s.quote(r('2026-05-01T00:00:00Z', '2026-05-03T00:00:00Z')).total, 5000);
+  assert.equal(s.quote(r('2026-05-01T00:00:00Z', '2026-05-04T00:00:00Z')).total, 6750);
+  assert.equal(s.book(r('2026-06-01T00:00:00Z', '2026-06-06T00:00:00Z')).total, 11250);
+  s.addEquipment({ id: 'odd', kind: 'sail', dailyPrice: 105 });
+  assert.equal(s.quote(r('2026-05-01T00:00:00Z', '2026-05-04T00:00:00Z', 'odd')).total, 284);
+});
+
