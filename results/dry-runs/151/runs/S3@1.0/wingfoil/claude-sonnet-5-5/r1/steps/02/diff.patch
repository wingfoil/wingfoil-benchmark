@@ -36,3 +36,16 @@ test('book rejects overlaps but allows adjacent periods and other items', () =>
   assert.notEqual(next.id, first.id);
   s.book(r('2026-05-01T00:00:00Z', '2026-05-03T00:00:00Z', 's1'));
 });
+
+test('availability lists free items of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'b0', kind: 'board', dailyPrice: 100 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 1000 });
+  s.book(r('2026-05-01T00:00:00Z', '2026-05-03T00:00:00Z'));
+  const q = { start: '2026-05-02T00:00:00Z', end: '2026-05-04T00:00:00Z' };
+  assert.deepEqual(s.availability(q), ['b0', 's1']);
+  assert.deepEqual(s.availability({ ...q, kind: 'board' }), ['b0']);
+  assert.deepEqual(s.availability({ start: '2026-05-03T00:00:00Z', end: '2026-05-04T00:00:00Z', kind: 'board' }), ['b0', 'b1']);
+  assert.throws(() => s.availability({ start: q.end, end: q.start }));
+  assert.throws(() => s.availability({ ...q, kind: 'car' as never }));
+});
