-const OPERATION_NAMES = ['add', 'remove', 'replace', 'move', 'copy', 'test'] as const;
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a JSON document and returns the merged document.
+ *
+ * A member of the patch whose value is null removes that member from the target. A patch that is not an
+ * object replaces the target entirely, and arrays are replaced rather than merged. The input target and
+ * patch are not mutated. Throws when the patch is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonValue(patch)) {
+    throw new Error('invalid JSON Merge Patch: the patch is not a JSON value');
+  }
+  return mergeValue(structuredClone(target), structuredClone(patch));
+}
+
+/**
+ * Merges a patch into a target, in place where the target is an object. The target and patch are owned
+ * by the caller: the result is built from them, without copying again.
+ */
+function mergeValue(target: unknown, patch: unknown): unknown {
+  if (!isObject(patch)) {
+    return patch;
+  }
+  const result = isObject(target) ? target : {};
+  for (const [name, value] of Object.entries(patch)) {
+    if (value === null) {
+      delete result[name];
+    } else {
+      // Only an own member is merged into: an inherited one (Object.prototype for "__proto__") must not be.
+      const current = Object.hasOwn(result, name) ? result[name] : undefined;
+      // defineProperty, not assignment: a member named "__proto__" must stay an ordinary member.
+      Object.defineProperty(result, name, {
+        value: mergeValue(current, value),
+        enumerable: true,
+        writable: true,
+        configurable: true,
+      });
+    }
+  }
+  return result;
+}
+
+const OPERATION_NAMES =['add', 'remove', 'replace', 'move', 'copy', 'test'] as const;
 
 function isOperationName(value: unknown): value is (typeof OPERATION_NAMES)[number] {
   return (OPERATION_NAMES as readonly unknown[]).includes(value);
diff --git a/test/json-merge-patch.test.ts b/test/json-merge-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3d36740d51abb3dab871314d02f8fcfa18a70764
--- /dev/null
+++ b/test/json-merge-patch.test.ts
@@ -0,0 +1,139 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyMergePatch } from '../src/index.ts';
+
+// The examples of RFC 7386, appendix A.
+describe('applyMergePatch', () => {
+  describe('applies the examples of RFC 7386, appendix A', () => {
+    it('replaces a member', () => {
+      assert.deepEqual(applyMergePatch({ a: 'b' }, { a: 'c' }), { a: 'c' });
+    });
+
+    it('adds a member', () => {
+      assert.deepEqual(applyMergePatch({ a: 'b' }, { b: 'c' }), { a: 'b', b: 'c' });
+    });
+
+    it('removes a member whose patch value is null', () => {
+      assert.deepEqual(applyMergePatch({ a: 'b' }, { a: null }), {});
+      assert.deepEqual(applyMergePatch({ a: 'b', b: 'c' }, { a: null }), { b: 'c' });
+    });
+
+    it('replaces an array with a value', () => {
+      assert.deepEqual(applyMergePatch({ a: ['b'] }, { a: 'c' }), { a: 'c' });
+    });
+
+    it('replaces a value with an array', () => {
+      assert.deepEqual(applyMergePatch({ a: 'c' }, { a: ['b'] }), { a: ['b'] });
+    });
+
+    it('merges a nested object, removing its null members', () => {
+      assert.deepEqual(applyMergePatch({ a: { b: 'c' } }, { a: { b: 'd', c: null } }), { a: { b: 'd' } });
+    });
+
+    it('replaces an array of objects as a whole', () => {
+      assert.deepEqual(applyMergePatch({ a: [{ b: 'c' }] }, { a: [1] }), { a: [1] });
+    });
+
+    it('replaces an array target as a whole', () => {
+      assert.deepEqual(applyMergePatch(['a', 'b'], ['c', 'd']), ['c', 'd']);
+    });
+
+    it('replaces an object target with an array patch', () => {
+      assert.deepEqual(applyMergePatch({ a: 'b' }, ['c']), ['c']);
+    });
+
+    it('replaces the document with null', () => {
+      assert.equal(applyMergePatch({ a: 'foo' }, null), null);
+    });
+
+    it('replaces the document with a string', () => {
+      assert.equal(applyMergePatch({ a: 'foo' }, 'bar'), 'bar');
+    });
+
+    it('keeps a member whose target value is null', () => {
+      assert.deepEqual(applyMergePatch({ e: null }, { a: 1 }), { e: null, a: 1 });
+    });
+
+    it('merges into a target that is not an object, after treating it as an empty object', () => {
+      assert.deepEqual(applyMergePatch([1, 2], { a: 'b', c: null }), { a: 'b' });
+    });
+
+    it('creates the nested objects of the patch, without their null members', () => {
+      assert.deepEqual(applyMergePatch({}, { a: { bb: { ccc: null } } }), { a: { bb: {} } });
+    });
+  });
+
+  describe('merges objects and arrays', () => {
+    it('keeps the members of the target that the patch does not name', () => {
+      assert.deepEqual(applyMergePatch({ a: 1, b: { c: 2, d: 3 } }, { b: { c: 4 } }), { a: 1, b: { c: 4, d: 3 } });
+    });
+
+    it('keeps null elements of an array in the patch', () => {
+      assert.deepEqual(applyMergePatch({}, { a: [null, { b: null }] }), { a: [null, { b: null }] });
+    });
+
+    it('replaces a non-object member with an object, without its null members', () => {
+      assert.deepEqual(applyMergePatch({ a: 1 }, { a: { b: null, c: 2 } }), { a: { c: 2 } });
+    });
+
+    it('is not an error to remove a member that does not exist', () => {
+      assert.deepEqual(applyMergePatch({ a: 1 }, { b: null }), { a: 1 });
+      assert.deepEqual(applyMergePatch({ a: 1 }, { b: { c: null } }), { a: 1, b: {} });
+    });
+
+    it('returns an empty object for an empty patch on a target that is not an object', () => {
+      assert.deepEqual(applyMergePatch(5, {}), {});
+    });
+
+    it('returns the target unchanged for an empty patch', () => {
+      assert.deepEqual(applyMergePatch({ a: { b: 1 } }, {}), { a: { b: 1 } });
+    });
+  });
+
+  describe('keeps the input unchanged', () => {
+    it('does not mutate the target or the patch', () => {
+      const target = { a: { b: 'c' }, d: 1 };
+      const patch = { a: { b: 'e', f: null }, g: [1] };
+      applyMergePatch(target, patch);
+      assert.deepEqual(target, { a: { b: 'c' }, d: 1 });
+      assert.deepEqual(patch, { a: { b: 'e', f: null }, g: [1] });
+    });
+
+    it('shares no mutable state with the patch', () => {
+      const patch = { a: { b: 1 }, c: [1] };
+      const result = applyMergePatch({}, patch) as { a: { b: number }; c: number[] };
+      result.a.b = 2;
+      result.c.push(2);
+      assert.deepEqual(patch, { a: { b: 1 }, c: [1] });
+    });
+
+    it('shares no mutable state with the target', () => {
+      const target = { a: { b: 1 } };
+      const result = applyMergePatch(target, { c: 2 }) as { a: { b: number } };
+      result.a.b = 3;
+      assert.deepEqual(target, { a: { b: 1 } });
+    });
+  });
+
+  describe('handles member names with care', () => {
+    it('treats a member named "__proto__" as an ordinary member', () => {
+      const patch = JSON.parse('{"__proto__": {"polluted": true}}');
+      const result = applyMergePatch({}, patch) as object;
+      assert.ok(Object.hasOwn(result, '__proto__'));
+      assert.equal(({} as Record<string, unknown>).polluted, undefined);
+    });
+  });
+
+  describe('throws when the patch is not a JSON value', () => {
+    it('throws for undefined, NaN and an infinity', () => {
+      assert.throws(() => applyMergePatch({}, undefined), Error);
+      assert.throws(() => applyMergePatch({}, { a: undefined }), Error);
+      assert.throws(() => applyMergePatch({}, { a: NaN }), Error);
+      assert.throws(() => applyMergePatch({}, { a: [Infinity] }), Error);
+    });
+
+    it('throws for a value that is not a plain JSON value', () => {
+      assert.throws(() => applyMergePatch({}, { a: new Date(0) }), Error);
+    });
+  });
+});
