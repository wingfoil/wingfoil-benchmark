+/**
+ * Creates a JSON Patch (RFC 6902) that turns one JSON document into another when applied to the first.
+ *
+ * The patch describes only what changed: equal members and elements produce no operation, and the common
+ * prefix and suffix of an array are skipped, so that one changed, inserted or removed element is one
+ * operation. The inputs are not mutated, and the patch shares no mutable state with them. Throws when a
+ * document is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new Error('cannot create a JSON Patch: a document is not a JSON value');
+  }
+  const operations: PatchOperation[] = [];
+  diffValue(from, to, '', operations);
+  return operations;
+}
+
+/**
+ * Appends the operations that turn a value at a pointer into another. Equal values give none, containers
+ * of the same kind are diffed member by member, and any other difference replaces the value.
+ */
+function diffValue(from: unknown, to: unknown, pointer: string, operations: PatchOperation[]): void {
+  if (deepEqual(from, to)) {
+    return;
+  }
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(from, to, pointer, operations);
+  } else if (isObject(from) && isObject(to)) {
+    diffObject(from, to, pointer, operations);
+  } else {
+    operations.push({ op: 'replace', path: pointer, value: structuredClone(to) });
+  }
+}
+
+/**
+ * Appends the operations that turn one object into another: the members only in the old object are
+ * removed, and the members of the new object are added, or diffed when both objects have them.
+ */
+function diffObject(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  pointer: string,
+  operations: PatchOperation[],
+): void {
+  for (const name of Object.keys(from)) {
+    if (!Object.hasOwn(to, name)) {
+      operations.push({ op: 'remove', path: `${pointer}/${escapeToken(name)}` });
+    }
+  }
+  for (const name of Object.keys(to)) {
+    const path = `${pointer}/${escapeToken(name)}`;
+    if (Object.hasOwn(from, name)) {
+      diffValue(from[name], to[name], path, operations);
+    } else {
+      operations.push({ op: 'add', path, value: structuredClone(to[name]) });
+    }
+  }
+}
+
+/**
+ * Appends the operations that turn one array into another. The common prefix and suffix are kept; the
+ * elements between them are paired by position and diffed, and the surplus of either side is removed or
+ * inserted. Each operation is valid in the order given, as it sees the array the previous ones have made.
+ */
+function diffArray(from: unknown[], to: unknown[], pointer: string, operations: PatchOperation[]): void {
+  let prefix = 0;
+  while (prefix < from.length && prefix < to.length && deepEqual(from[prefix], to[prefix])) {
+    prefix++;
+  }
+  let suffix = 0;
+  while (
+    suffix < from.length - prefix &&
+    suffix < to.length - prefix &&
+    deepEqual(from[from.length - 1 - suffix], to[to.length - 1 - suffix])
+  ) {
+    suffix++;
+  }
+  const removed = from.length - prefix - suffix;
+  const inserted = to.length - prefix - suffix;
+  const paired = Math.min(removed, inserted);
+  for (let i = 0; i < paired; i++) {
+    diffValue(from[prefix + i], to[prefix + i], `${pointer}/${prefix + i}`, operations);
+  }
+  // Each removal takes the next surplus element, which then sits at the same index.
+  for (let i = paired; i < removed; i++) {
+    operations.push({ op: 'remove', path: `${pointer}/${prefix + paired}` });
+  }
+  // Ascending insertions place each new element at its final index.
+  for (let i = paired; i < inserted; i++) {
+    operations.push({ op: 'add', path: `${pointer}/${prefix + i}`, value: structuredClone(to[prefix + i]) });
+  }
+}
+
+/**
+ * Escapes a member name as a JSON Pointer reference token (RFC 6901, section 3).
+ */
+function escapeToken(name: string): string {
+  return name.replace(/~/g, '~0').replace(/\//g, '~1');
+}
