+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch, createPatch } from '../src/index.ts';
+
+describe('createPatch', () => {
+  describe('describes what changed', () => {
+    it('gives an empty patch for identical documents', () => {
+      const document = { a: { b: [1, { c: 'd' }] }, e: null };
+      assert.deepEqual(createPatch(document, structuredClone(document)), []);
+      assert.deepEqual(createPatch(1, 1), []);
+    });
+
+    it('gives one operation for one changed member, at its path', () => {
+      const from = { a: { b: { c: 1, d: 2 }, e: [1, 2] } };
+      const to = { a: { b: { c: 1, d: 3 }, e: [1, 2] } };
+      assert.deepEqual(createPatch(from, to), [{ op: 'replace', path: '/a/b/d', value: 3 }]);
+    });
+
+    it('adds a member that is only in the new version', () => {
+      assert.deepEqual(createPatch({ a: 1 }, { a: 1, b: { c: true } }), [{ op: 'add', path: '/b', value: { c: true } }]);
+    });
+
+    it('removes a member that is only in the old version', () => {
+      assert.deepEqual(createPatch({ a: 1, b: 2 }, { a: 1 }), [{ op: 'remove', path: '/b' }]);
+    });
+
+    it('replaces a value whose kind changes', () => {
+      assert.deepEqual(createPatch({ a: { b: 1 } }, { a: [1] }), [{ op: 'replace', path: '/a', value: [1] }]);
+      assert.deepEqual(createPatch({ a: 'x' }, { a: null }), [{ op: 'replace', path: '/a', value: null }]);
+    });
+
+    it('replaces the whole document at the root path', () => {
+      assert.deepEqual(createPatch({ a: 1 }, [1]), [{ op: 'replace', path: '', value: [1] }]);
+      assert.deepEqual(createPatch('a', 'b'), [{ op: 'replace', path: '', value: 'b' }]);
+    });
+  });
+
+  describe('arrays', () => {
+    it('adds one inserted element as one operation', () => {
+      assert.deepEqual(createPatch([1, 2, 3], [1, 9, 2, 3]), [{ op: 'add', path: '/1', value: 9 }]);
+    });
+
+    it('adds an element appended at the end', () => {
+      assert.deepEqual(createPatch([1, 2], [1, 2, 3]), [{ op: 'add', path: '/2', value: 3 }]);
+    });
+
+    it('removes one deleted element as one operation', () => {
+      assert.deepEqual(createPatch([1, 2, 3], [1, 3]), [{ op: 'remove', path: '/1' }]);
+    });
+
+    it('removes elements at the end', () => {
+      assert.deepEqual(createPatch([1, 2, 3], [1]), [
+        { op: 'remove', path: '/1' },
+        { op: 'remove', path: '/1' },
+      ]);
+    });
+
+    it('replaces one changed element, and recurses into it', () => {
+      assert.deepEqual(createPatch([1, 2, 3], [1, 5, 3]), [{ op: 'replace', path: '/1', value: 5 }]);
+      assert.deepEqual(createPatch([{ a: 1 }, { a: 2 }], [{ a: 1 }, { a: 3 }]), [{ op: 'replace', path: '/1/a', value: 3 }]);
+    });
+
+    it('gives one operation when one element of a large array changes', () => {
+      const items = Array.from({ length: 1000 }, (_, i) => ({ id: i, name: `item ${i}` }));
+      const changed = structuredClone(items);
+      changed[500].name = 'renamed';
+      assert.deepEqual(createPatch(items, changed), [{ op: 'replace', path: '/500/name', value: 'renamed' }]);
+    });
+
+    it('gives one operation when one element is inserted into a large array', () => {
+      const items = Array.from({ length: 1000 }, (_, i) => ({ id: i }));
+      const changed = [...items.slice(0, 10), { id: 'new' }, ...items.slice(10)];
+      assert.deepEqual(createPatch(items, changed), [{ op: 'add', path: '/10', value: { id: 'new' } }]);
+    });
+  });
+
+  describe('keys', () => {
+    it('escapes "/" and "~" in member names as JSON Pointers', () => {
+      assert.deepEqual(createPatch({ 'a/b': 1, 'c~d': 1 }, { 'a/b': 2, 'c~d': 1 }), [
+        { op: 'replace', path: '/a~1b', value: 2 },
+      ]);
+      assert.deepEqual(createPatch({}, { 'x/~y': true }), [{ op: 'add', path: '/x~1~0y', value: true }]);
+    });
+
+    it('treats a member named "__proto__" as an ordinary member', () => {
+      const from = JSON.parse('{"__proto__": {"a": 1}}');
+      const to = JSON.parse('{"__proto__": {"a": 2}}');
+      const patch = createPatch(from, to);
+      assert.deepEqual(patch, [{ op: 'replace', path: '/__proto__/a', value: 2 }]);
+
+      const result = applyPatch(from, patch) as object;
+      assert.ok(Object.hasOwn(result, '__proto__'));
+      assert.equal(Object.getPrototypeOf(result), Object.prototype);
+    });
+  });
+
+  describe('round trip', () => {
+    const fixtures: [unknown, unknown][] = [
+      [{}, { a: 1 }],
+      [{ a: 1 }, {}],
+      [[], [1, 2]],
+      [[1, 2, 3], []],
+      [[1, [2, { a: 3 }]], [0, [2, { a: 4, b: [] }], 5]],
+      [{ a: [1, 2, 3, 4] }, { a: [4, 3, 2, 1] }],
+      [{ a: { b: null } }, { a: null }],
+      [null, { a: 1 }],
+      [{ 'k/1': [true, false], '~': 'x' }, { 'k/1': [false], '~': 'y', z: 0 }],
+      [{ list: [{ id: 1 }, { id: 2 }, { id: 3 }] }, { list: [{ id: 2 }, { id: 3 }, { id: 4 }] }],
+    ];
+
+    for (const [from, to] of fixtures) {
+      it(`turns ${JSON.stringify(from)} into ${JSON.stringify(to)}`, () => {
+        assert.deepEqual(applyPatch(from, createPatch(from, to)), to);
+      });
+    }
+  });
+
+  describe('inputs', () => {
+    it('does not mutate either input', () => {
+      const from = { a: [1, { b: 2 }], c: 'd' };
+      const to = { a: [1, { b: 3 }, 4], e: { f: [] } };
+      const fromCopy = structuredClone(from);
+      const toCopy = structuredClone(to);
+      createPatch(from, to);
+      assert.deepEqual(from, fromCopy);
+      assert.deepEqual(to, toCopy);
+    });
+
+    it('shares no mutable state with the inputs', () => {
+      const from = { a: {} as Record<string, unknown> };
+      const to = { a: { b: { c: [1] } } };
+      const patch = createPatch(from, to) as { value: { c: number[] } }[];
+      patch[0].value.c.push(2);
+      assert.deepEqual(to, { a: { b: { c: [1] } } });
+      assert.deepEqual(from, { a: {} });
+    });
+  });
+
+  describe('errors', () => {
+    it('throws when a document is not a JSON value', () => {
+      assert.throws(() => createPatch({ a: undefined }, {}));
+      assert.throws(() => createPatch(NaN, 1));
+      assert.throws(() => createPatch({}, Infinity));
+      assert.throws(() => createPatch([1, , 3], []));
+    });
+  });
+});
