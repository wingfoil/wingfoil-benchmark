+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyPatch } from '../src/index.ts';
+
+// The examples of RFC 6902, appendix A.
+describe('applyPatch', () => {
+  describe('applies the operations of RFC 6902, appendix A', () => {
+    it('adds an object member', () => {
+      assert.deepEqual(applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/baz', value: 'qux' }]), {
+        baz: 'qux',
+        foo: 'bar',
+      });
+    });
+
+    it('adds an array element before the index', () => {
+      assert.deepEqual(applyPatch({ foo: ['bar', 'baz'] }, [{ op: 'add', path: '/foo/1', value: 'qux' }]), {
+        foo: ['bar', 'qux', 'baz'],
+      });
+    });
+
+    it('adds a nested member object', () => {
+      assert.deepEqual(applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/child', value: { grandchild: {} } }]), {
+        foo: 'bar',
+        child: { grandchild: {} },
+      });
+    });
+
+    it('adds an array value', () => {
+      assert.deepEqual(applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/baz', value: ['qux', 'baz'] }]), {
+        foo: 'bar',
+        baz: ['qux', 'baz'],
+      });
+    });
+
+    it('removes an object member', () => {
+      assert.deepEqual(applyPatch({ baz: 'qux', foo: 'bar' }, [{ op: 'remove', path: '/baz' }]), { foo: 'bar' });
+    });
+
+    it('removes an array element', () => {
+      assert.deepEqual(applyPatch({ foo: ['bar', 'qux', 'baz'] }, [{ op: 'remove', path: '/foo/1' }]), {
+        foo: ['bar', 'baz'],
+      });
+    });
+
+    it('replaces a value', () => {
+      assert.deepEqual(applyPatch({ baz: 'qux', foo: 'bar' }, [{ op: 'replace', path: '/baz', value: 'boo' }]), {
+        baz: 'boo',
+        foo: 'bar',
+      });
+    });
+
+    it('moves a value', () => {
+      const document = { foo: { bar: 'baz', waldo: 'fred' }, qux: { corge: 'grault' } };
+      assert.deepEqual(applyPatch(document, [{ op: 'move', from: '/foo/waldo', path: '/qux/thud' }]), {
+        foo: { bar: 'baz' },
+        qux: { corge: 'grault', thud: 'fred' },
+      });
+    });
+
+    it('moves an array element', () => {
+      assert.deepEqual(applyPatch({ foo: ['all', 'grass', 'cows', 'eat'] }, [{ op: 'move', from: '/foo/1', path: '/foo/3' }]), {
+        foo: ['all', 'cows', 'eat', 'grass'],
+      });
+    });
+
+    it('copies a value', () => {
+      assert.deepEqual(applyPatch({ foo: 'all', bar: [] }, [{ op: 'copy', from: '/foo', path: '/bar/0' }]), {
+        foo: 'all',
+        bar: ['all'],
+      });
+    });
+
+    it('succeeds when the tested values are equal', () => {
+      const document = { baz: 'qux', foo: ['a', 2, 'c'] };
+      assert.deepEqual(
+        applyPatch(document, [
+          { op: 'test', path: '/baz', value: 'qux' },
+          { op: 'test', path: '/foo/1', value: 2 },
+        ]),
+        document,
+      );
+    });
+
+    it('fails when the tested value is different', () => {
+      assert.throws(() => applyPatch({ baz: 'qux' }, [{ op: 'test', path: '/baz', value: 'bar' }]), Error);
+    });
+
+    it('ignores unrecognized members of an operation', () => {
+      assert.deepEqual(applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/baz', value: 'qux', xyz: 123 }]), {
+        foo: 'bar',
+        baz: 'qux',
+      });
+    });
+
+    it('escapes "/" and "~" in pointers, applying the escapes in order', () => {
+      assert.doesNotThrow(() => applyPatch({ '/': 9, '~1': 10 }, [{ op: 'test', path: '/~01', value: 10 }]));
+      assert.deepEqual(applyPatch({ 'a/b': 1 }, [{ op: 'replace', path: '/a~1b', value: 2 }]), { 'a/b': 2 });
+    });
+
+    it('fails when adding to a missing target', () => {
+      assert.throws(() => applyPatch({ foo: 'bar' }, [{ op: 'add', path: '/baz/bat', value: 'qux' }]), Error);
+    });
+  });
+
+  describe('applies each operation', () => {
+    it('appends to an array with "-"', () => {
+      assert.deepEqual(applyPatch({ a: [1] }, [{ op: 'add', path: '/a/-', value: 2 }]), { a: [1, 2] });
+    });
+
+    it('adds an array element at the end, at index equal to the length', () => {
+      assert.deepEqual(applyPatch({ a: [1] }, [{ op: 'add', path: '/a/1', value: 2 }]), { a: [1, 2] });
+    });
+
+    it('adds an object member, replacing an existing one', () => {
+      assert.deepEqual(applyPatch({ a: 1 }, [{ op: 'add', path: '/a', value: 2 }]), { a: 2 });
+    });
+
+    it('replaces the whole document at the empty pointer', () => {
+      assert.deepEqual(applyPatch({ a: 1 }, [{ op: 'replace', path: '', value: [2] }]), [2]);
+      assert.deepEqual(applyPatch({ a: 1 }, [{ op: 'add', path: '', value: 'x' }]), 'x');
+    });
+
+    it('replaces an array element', () => {
+      assert.deepEqual(applyPatch({ a: [1, 2] }, [{ op: 'replace', path: '/a/0', value: 9 }]), { a: [9, 2] });
+    });
+
+    it('fails to replace a missing target', () => {
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: 'replace', path: '/b', value: 2 }]), Error);
+      assert.throws(() => applyPatch({ a: [1] }, [{ op: 'replace', path: '/a/1', value: 2 }]), Error);
+      assert.throws(() => applyPatch({ a: [1] }, [{ op: 'replace', path: '/a/-', value: 2 }]), Error);
+    });
+
+    it('removes an existing member, and fails on a missing one', () => {
+      assert.deepEqual(applyPatch({ a: 1, b: 2 }, [{ op: 'remove', path: '/a' }]), { b: 2 });
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: 'remove', path: '/b' }]), Error);
+      assert.throws(() => applyPatch({ a: [1] }, [{ op: 'remove', path: '/a/-' }]), Error);
+    });
+
+    it('refuses to remove the whole document', () => {
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: 'remove', path: '' }]), Error);
+    });
+
+    it('moves a value to the root', () => {
+      assert.deepEqual(applyPatch({ a: { b: 1 } }, [{ op: 'move', from: '/a', path: '' }]), { b: 1 });
+    });
+
+    it('refuses to move a value into one of its own children', () => {
+      assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: 'move', from: '/a', path: '/a/b' }]), Error);
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: 'move', from: '', path: '/a' }]), Error);
+    });
+
+    it('moves a value onto itself without changing the document', () => {
+      assert.deepEqual(applyPatch({ a: 1 }, [{ op: 'move', from: '/a', path: '/a' }]), { a: 1 });
+    });
+
+    it('fails to move from a missing source', () => {
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: 'move', from: '/b', path: '/c' }]), Error);
+    });
+
+    it('copies a value so that the copy does not share state with the source', () => {
+      const result = applyPatch({ a: { b: [1] } }, [{ op: 'copy', from: '/a', path: '/c' }]) as { a: { b: number[] }; c: { b: number[] } };
+      result.c.b.push(2);
+      assert.deepEqual(result.a, { b: [1] });
+    });
+
+    it('fails to copy from a missing source', () => {
+      assert.throws(() => applyPatch({ a: 1 }, [{ op: 'copy', from: '/b', path: '/c' }]), Error);
+    });
+
+    it('tests deep equality of objects and arrays', () => {
+      const document = { a: { b: [1, { c: null }] } };
+      assert.doesNotThrow(() => applyPatch(document, [{ op: 'test', path: '/a', value: { b: [1, { c: null }] } }]));
+      assert.throws(() => applyPatch(document, [{ op: 'test', path: '/a', value: { b: [1] } }]), Error);
+      assert.throws(() => applyPatch(document, [{ op: 'test', path: '/a/b/1/c', value: 0 }]), Error);
+    });
+
+    it('applies the operations in order, each to the result of the previous one', () => {
+      assert.deepEqual(
+        applyPatch({}, [
+          { op: 'add', path: '/a', value: [] },
+          { op: 'add', path: '/a/-', value: 1 },
+          { op: 'replace', path: '/a/0', value: 2 },
+        ]),
+        { a: [2] },
+      );
+    });
+
+    it('fails the whole patch when one operation fails', () => {
+      assert.throws(
+        () =>
+          applyPatch({ foo: 'bar' }, [
+            { op: 'add', path: '/baz', value: 'qux' },
+            { op: 'test', path: '/foo', value: 'x' },
+          ]),
+        Error,
+      );
+    });
+
+    it('returns an empty patch as the document itself', () => {
+      assert.deepEqual(applyPatch({ a: [1] }, []), { a: [1] });
