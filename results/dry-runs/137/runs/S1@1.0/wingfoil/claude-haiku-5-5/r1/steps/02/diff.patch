+    return raw.replace(/~1/g, '/').replace(/~0/g, '~');
+  });
+}
+
+function navigate(document: unknown, tokens: string[], pointer: string): unknown {
+  return tokens.reduce((current, token) => step(current, token, pointer), document);
 }
 
 function step(current: unknown, token: string, pointer: string): unknown {
   if (Array.isArray(current)) {
-    if (!/^(0|[1-9][0-9]*)$/.test(token) || Number(token) >= current.length) {
-      throw new Error(`JSON Pointer "${pointer}" does not resolve: no array element "${token}"`);
-    }
