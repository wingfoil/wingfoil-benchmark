+
+/**
+ * The operations of a JSON Patch (RFC 6902), after validation.
+ */
+export type PatchOperation =
+  | { op: 'add' | 'replace' | 'test'; path: string; value: unknown }
+  | { op: 'remove'; path: string }
+  | { op: 'move' | 'copy'; from: string; path: string };
+
+/**
+ * Applies a JSON Patch (RFC 6902) to a JSON document and returns the result.
+ *
+ * The input document and patch are not mutated. Throws when the patch is
+ * invalid, or when one of its operations fails; in that case no result is
+ * returned.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!Array.isArray(patch)) {
+    throw new Error('invalid JSON Patch: must be an array of operations');
+  }
+  const operations = patch.map(parseOperation);
+
+  let result = structuredClone(document);
+  operations.forEach((operation, index) => {
+    try {
+      result = applyOperation(result, operation);
+    } catch (error) {
+      throw new Error(`JSON Patch operation ${index} ("${operation.op}") failed: ${(error as Error).message}`);
+    }
+  });
+  return result;
+}
+
+const OPERATION_NAMES = ['add', 'remove', 'replace', 'move', 'copy', 'test'] as const;
+
+function isOperationName(value: unknown): value is (typeof OPERATION_NAMES)[number] {
+  return (OPERATION_NAMES as readonly unknown[]).includes(value);
+}
+
+function parseOperation(raw: unknown, index: number): PatchOperation {
+  const invalid = (reason: string) => new Error(`invalid JSON Patch operation ${index}: ${reason}`);
+  if (!isObject(raw)) {
+    throw invalid('must be an object');
+  }
+  const { op, path } = raw;
+  if (!isOperationName(op)) {
+    throw invalid(`unknown "op" ${JSON.stringify(op)}`);
+  }
+  if (typeof path !== 'string') {
+    throw invalid('"path" must be a string');
+  }
+  parsePointer(path);
+
+  switch (op) {
+    case 'add':
+    case 'replace':
+    case 'test':
+      if (!Object.hasOwn(raw, 'value')) {
+        throw invalid(`"${op}" must have a "value"`);
+      }
+      return { op, path, value: raw.value };
+    case 'remove':
+      return { op, path };
+    case 'move':
+    case 'copy': {
+      const from = raw.from;
+      if (typeof from !== 'string') {
+        throw invalid(`"${op}" must have a string "from"`);
+      }
+      const fromTokens = parsePointer(from);
+      if (op === 'move' && isProperPrefix(fromTokens, parsePointer(path))) {
+        throw invalid('"from" must not be a proper prefix of "path"');
+      }
+      return { op, from, path };
+    }
+  }
+}
+
+function applyOperation(document: unknown, operation: PatchOperation): unknown {
+  switch (operation.op) {
+    case 'add':
+      return addAt(document, operation.path, structuredClone(operation.value));
+    case 'remove':
+      removeAt(document, operation.path);
+      return document;
+    case 'replace':
+      // Functionally a remove followed by an add at the same location (RFC 6902, section 4.3).
+      if (parsePointer(operation.path).length === 0) {
+        return structuredClone(operation.value);
+      }
+      removeAt(document, operation.path);
+      return addAt(document, operation.path, structuredClone(operation.value));
+    case 'move':
+      return addAt(document, operation.path, removeAt(document, operation.from));
+    case 'copy': {
+      const value = navigate(document, parsePointer(operation.from), operation.from);
+      return addAt(document, operation.path, structuredClone(value));
+    }
+    case 'test': {
+      const actual = navigate(document, parsePointer(operation.path), operation.path);
+      if (!deepEqual(actual, operation.value)) {
+        throw new Error(`value at "${operation.path}" does not match the tested value`);
+      }
+      return document;
+    }
+  }
+}
+
+/**
+ * Adds a value at a pointer, in place, and returns the resulting document. In an array, a value is
+ * inserted before the index, and "-" appends it.
+ */
+function addAt(document: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    return value;
+  }
+  const parent = navigate(document, tokens.slice(0, -1), pointer);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    const index = key === '-' ? parent.length : arrayIndex(key, parent.length, true, pointer);
+    parent.splice(index, 0, value);
+  } else if (isObject(parent)) {
+    // defineProperty, not assignment: a member named "__proto__" must stay an ordinary member.
+    Object.defineProperty(parent, key, { value, enumerable: true, writable: true, configurable: true });
+  } else {
+    throw new Error(`JSON Pointer "${pointer}" does not resolve: cannot add into a primitive value`);
+  }
+  return document;
+}
+
+/**
+ * Removes the value at a pointer, in place, and returns the removed value. The whole document cannot
+ * be removed.
+ */
+function removeAt(document: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) {
+    throw new Error('cannot remove the whole document');
+  }
+  const parent = navigate(document, tokens.slice(0, -1), pointer);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) {
+    return parent.splice(arrayIndex(key, parent.length, false, pointer), 1)[0];
+  }
