+
+```ts
+import { applyPatch } from 'json-toolkit';
+
+applyPatch({ a: [1, 2] }, [
+  { op: 'add', path: '/a/-', value: 3 },
+  { op: 'test', path: '/a/0', value: 1 },
+]); // { a: [1, 2, 3] }
+applyPatch({ a: 1 }, [{ op: 'remove', path: '/b' }]); // throws
+```
