+/**
+ * Applies an RFC 7386 JSON Merge Patch and returns the resulting JSON value.
+ *
+ * Object members set to `null` in the patch are removed. A non-object patch
+ * replaces the complete target, including when the target itself is an array
+ * or scalar. Neither input is mutated.
+ *
+ * @param target - The JSON document to update.
+ * @param patch - An RFC 7386 JSON Merge Patch document.
+ * @returns A new JSON value containing the merged result.
+ * @throws {TypeError} If either input contains a value outside JSON.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  return mergePatch(
+    cloneJson(target, 'The target'),
+    cloneJson(patch, 'The merge patch'),
+  );
+}
+
+function mergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonObject(patch)) {
+    return patch;
+  }
+
+  const result: Record<string, unknown> = isJsonObject(target) ? target : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      defineJsonMember(result, key, mergePatch(result[key], value));
+    }
+  }
+  return result;
+}
+
 function applyOperation(document: unknown, operation: unknown): unknown {
   if (!isJsonObject(operation)) {
     throw new TypeError('An operation must be an object.');
