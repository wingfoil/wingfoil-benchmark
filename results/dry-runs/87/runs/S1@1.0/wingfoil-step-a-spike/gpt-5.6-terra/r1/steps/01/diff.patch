+++ b/src/index.ts
@@ -0,0 +1,57 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @param document - The JSON document to traverse.
+ * @param pointer - An RFC 6901 JSON Pointer.
+ * @returns The JSON value identified by the pointer.
+ * @throws {TypeError} If the pointer is malformed or does not resolve in the document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== 'string') {
+    throw new TypeError('A JSON Pointer must be a string.');
+  }
+
+  if (pointer === '') {
+    return document;
+  }
+
+  if (!pointer.startsWith('/')) {
+    throw new TypeError('A non-empty JSON Pointer must begin with "/".');
+  }
+
+  let value = document;
+  for (const token of pointer.slice(1).split('/')) {
+    value = resolveToken(value, decodeToken(token));
+  }
+
+  return value;
+}
+
+function decodeToken(token: string): string {
+  if (/~(?:[^01]|$)/.test(token)) {
+    throw new TypeError('A JSON Pointer escape must be "~0" or "~1".');
+  }
+
+  return token.replace(/~1/g, '/').replace(/~0/g, '~');
+}
+
+function resolveToken(value: unknown, token: string): unknown {
+  if (Array.isArray(value)) {
+    if (!/^(?:0|[1-9][0-9]*)$/.test(token)) {
+      throw new TypeError(`"${token}" is not a valid JSON Pointer array index.`);
+    }
+
+    const index = Number(token);
+    if (!Number.isSafeInteger(index) || index >= value.length) {
+      throw new TypeError(`JSON Pointer array index "${token}" does not exist.`);
+    }
+
+    return value[index];
+  }
+
+  if (value !== null && typeof value === 'object' && Object.hasOwn(value, token)) {
+    return (value as Record<string, unknown>)[token];
+  }
+
+  throw new TypeError(`JSON Pointer token "${token}" does not resolve to a value.`);
+}
diff --git a/test/index.test.mjs b/test/index.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c802a8206e6b3611b5d199b49751d36e82fadd9a
--- /dev/null
+++ b/test/index.test.mjs
@@ -0,0 +1,36 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { resolvePointer } from '../src/index.ts';
+
+const document = {
+  foo: ['bar', 'baz'],
+  '': 0,
+  'a/b': 1,
+  'c%d': 2,
+  'e^f': 3,
+  'g|h': 4,
+  'i\\j': 5,
+  'k\"l': 6,
+  ' ': 7,
+  'm~n': 8,
+};
+
+test('resolves the document root and object and array members', () => {
+  assert.equal(resolvePointer(document, ''), document);
+  assert.equal(resolvePointer(document, '/foo/0'), 'bar');
+  assert.equal(resolvePointer(document, '/foo/1'), 'baz');
+  assert.equal(resolvePointer(document, '/'), 0);
+});
+
+test('decodes RFC 6901 escape sequences in reference tokens', () => {
+  assert.equal(resolvePointer(document, '/a~1b'), 1);
+  assert.equal(resolvePointer(document, '/m~0n'), 8);
+  assert.equal(resolvePointer({ '~1': 'literal' }, '/~01'), 'literal');
+});
+
+test('throws for invalid pointers and unresolved references', () => {
+  for (const pointer of ['foo', '/m~2n', '/m~', '/foo/01', '/foo/-', '/foo/2', '/missing']) {
+    assert.throws(() => resolvePointer(document, pointer));
+  }
+});
