+type JsonPatchOperation = {
+  op: 'add' | 'remove' | 'replace';
+  path: string;
+  value?: unknown;
+};
+
+function diffJson(
+  from: unknown,
+  to: unknown,
+  tokens: string[],
+  patch: JsonPatchOperation[],
+): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    diffObject(from, to, tokens, patch);
+  } else if (Array.isArray(from) && Array.isArray(to)) {
+    diffArray(from, to, tokens, patch);
+  } else {
+    patch.push({ op: 'replace', path: formatPointer(tokens), value: to });
+  }
+}
+
+function diffObject(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  tokens: string[],
+  patch: JsonPatchOperation[],
+): void {
+  for (const key of Object.keys(from)) {
+    if (!Object.hasOwn(to, key)) {
+      patch.push({ op: 'remove', path: formatPointer([...tokens, key]) });
+    }
+  }
+
+  for (const key of Object.keys(to)) {
+    const path = [...tokens, key];
+    if (Object.hasOwn(from, key)) {
+      diffJson(from[key], to[key], path, patch);
+    } else {
+      patch.push({ op: 'add', path: formatPointer(path), value: to[key] });
+    }
+  }
+}
+
+function diffArray(
+  from: unknown[],
+  to: unknown[],
+  tokens: string[],
+  patch: JsonPatchOperation[],
+): void {
+  let prefix = 0;
+  while (prefix < from.length && prefix < to.length && jsonEqual(from[prefix], to[prefix])) {
+    prefix += 1;
+  }
+
+  let suffix = 0;
+  while (
+    suffix < from.length - prefix
+    && suffix < to.length - prefix
+    && jsonEqual(from[from.length - suffix - 1], to[to.length - suffix - 1])
+  ) {
+    suffix += 1;
+  }
+
+  const fromMiddleLength = from.length - prefix - suffix;
+  const toMiddleLength = to.length - prefix - suffix;
+  if (fromMiddleLength === toMiddleLength) {
+    for (let index = 0; index < fromMiddleLength; index += 1) {
+      diffJson(from[prefix + index], to[prefix + index], [...tokens, String(prefix + index)], patch);
+    }
+    return;
+  }
+
+  const indexPath = [...tokens, String(prefix)];
+  for (let index = 0; index < fromMiddleLength; index += 1) {
+    patch.push({ op: 'remove', path: formatPointer(indexPath) });
+  }
+  for (let index = 0; index < toMiddleLength; index += 1) {
+    patch.push({
+      op: 'add',
+      path: formatPointer([...tokens, String(prefix + index)]),
+      value: to[prefix + index],
+    });
+  }
+}
+
+function formatPointer(tokens: string[]): string {
+  return tokens.length === 0 ? '' : `/${tokens.map(encodeToken).join('/')}`;
+}
+
+function encodeToken(token: string): string {
+  return token.replace(/~/g, '~0').replace(/\//g, '~1');
+}
