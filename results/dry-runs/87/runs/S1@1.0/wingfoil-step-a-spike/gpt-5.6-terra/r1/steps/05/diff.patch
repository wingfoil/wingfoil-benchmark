+test('creates a compact RFC 6902 patch for nested object changes', () => {
+  const from = {
+    unchanged: { deeply: ['preserved'] },
+    account: { name: 'Ada', enabled: false },
+    removed: true,
+  };
+  const to = {
+    unchanged: { deeply: ['preserved'] },
+    account: { name: 'Ada', enabled: true, role: 'admin' },
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: 'remove', path: '/removed' },
+    { op: 'replace', path: '/account/enabled', value: true },
+    { op: 'add', path: '/account/role', value: 'admin' },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    unchanged: { deeply: ['preserved'] },
+    account: { name: 'Ada', enabled: false },
+    removed: true,
+  });
+  assert.deepEqual(to, {
+    unchanged: { deeply: ['preserved'] },
+    account: { name: 'Ada', enabled: true, role: 'admin' },
+  });
+});
+
+test('creates patches for escaped object keys, array insertions, and root replacement', () => {
+  const from = { 'a/b~c': ['before', 'after'] };
+  const to = { 'a/b~c': ['before', 'new', 'after'] };
+
+  assert.deepEqual(createPatch(from, to), [
+    { op: 'add', path: '/a~1b~0c/1', value: 'new' },
+  ]);
+  assert.deepEqual(applyPatch(from, createPatch(from, to)), to);
+  assert.deepEqual(createPatch({ value: 1 }, ['replacement']), [
+    { op: 'replace', path: '', value: ['replacement'] },
+  ]);
+  assert.deepEqual(createPatch({ stable: true }, { stable: true }), []);
+});
+
+test('rejects non-JSON values when creating a patch', () => {
+  assert.throws(() => createPatch({ value: undefined }, {}));
+  assert.throws(() => createPatch({}, Number.NaN));
+});
