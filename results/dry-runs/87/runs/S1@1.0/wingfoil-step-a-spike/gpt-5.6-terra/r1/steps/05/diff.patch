+/**
+ * Creates an RFC 6902 JSON Patch that transforms one JSON value into another.
+ *
+ * The generated patch is deterministic and makes changes at the lowest
+ * differing object or array locations where practical. Neither input is
+ * mutated, and operation values are independent copies of values in `to`.
+ *
+ * @param from - The JSON value to transform.
+ * @param to - The desired JSON value.
+ * @returns An RFC 6902 JSON Patch document.
+ * @throws {TypeError} If either input contains a value outside JSON.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatchOperation[] {
+  const source = cloneJson(from, 'The source document');
+  const target = cloneJson(to, 'The target document');
+  const patch: JsonPatchOperation[] = [];
+
+  diffJson(source, target, [], patch);
+  return patch;
+}
