+/**
+ * Applies an RFC 6902 JSON Patch document and returns the resulting JSON value.
+ *
+ * The source document and patch values are never mutated.  Consequently, when
+ * an operation fails, callers retain the unmodified source document; this is
+ * also the atomic outcome required when JSON Patch is used with HTTP PATCH.
+ *
+ * @param document - The JSON document to patch.
+ * @param patch - An RFC 6902 JSON Patch document (an array of operation objects).
+ * @returns A new JSON value containing the successful result.
+ * @throws {TypeError} If either input is not JSON, an operation is malformed,
+ * or an operation cannot be applied.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  let result = cloneJson(document, 'The document');
+
+  if (!Array.isArray(patch)) {
+    throw new TypeError('A JSON Patch document must be an array of operation objects.');
+  }
+
+  for (let index = 0; index < patch.length; index += 1) {
+    try {
+      result = applyOperation(result, patch[index]);
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      throw new TypeError(`JSON Patch operation ${index} failed: ${message}`);
+    }
+  }
+
+  return result;
+}
+
+function applyOperation(document: unknown, operation: unknown): unknown {
+  if (!isJsonObject(operation)) {
+    throw new TypeError('An operation must be an object.');
+  }
+
+  const op = requiredStringMember(operation, 'op');
+  const path = requiredStringMember(operation, 'path');
+  const tokens = parsePointer(path);
+
+  switch (op) {
+    case 'add':
+      return add(document, tokens, requiredMember(operation, 'value'));
+    case 'remove':
+      return remove(document, tokens).document;
+    case 'replace':
+      return replace(document, tokens, requiredMember(operation, 'value'));
+    case 'move': {
+      const from = parsePointer(requiredStringMember(operation, 'from'));
+      if (isProperPrefix(from, tokens)) {
+        throw new TypeError('A move destination must not be a child of its source.');
+      }
+      const removed = remove(document, from);
+      return add(removed.document, tokens, removed.value);
+    }
+    case 'copy': {
+      const value = get(document, parsePointer(requiredStringMember(operation, 'from')));
+      return add(document, tokens, value);
+    }
+    case 'test':
+      if (!jsonEqual(get(document, tokens), requiredMember(operation, 'value'))) {
+        throw new TypeError('The test value does not match the target value.');
+      }
+      return document;
+    default:
+      throw new TypeError(`"${op}" is not a supported JSON Patch operation.`);
+  }
+}
+
+function add(document: unknown, tokens: string[], value: unknown): unknown {
+  const addition = cloneJson(value, 'An operation value');
+  if (tokens.length === 0) {
+    return addition;
+  }
+
+  const { parent, token } = parentAt(document, tokens);
+  if (Array.isArray(parent)) {
+    const index = token === '-' ? parent.length : arrayIndex(token, parent.length, true);
+    parent.splice(index, 0, addition);
+  } else if (isJsonObject(parent)) {
+    defineJsonMember(parent, token, addition);
+  } else {
+    throw new TypeError('The target parent is not an object or array.');
+  }
+  return document;
+}
+
+function remove(document: unknown, tokens: string[]): { document: unknown; value: unknown } {
+  if (tokens.length === 0) {
+    return { document: null, value: document };
+  }
+
+  const { parent, token } = parentAt(document, tokens);
+  if (Array.isArray(parent)) {
+    const index = arrayIndex(token, parent.length, false);
+    return { document, value: parent.splice(index, 1)[0] };
+  }
+  if (isJsonObject(parent) && Object.hasOwn(parent, token)) {
+    const value = parent[token];
+    delete parent[token];
+    return { document, value };
+  }
+  throw new TypeError('The target location does not exist.');
+}
+
+function replace(document: unknown, tokens: string[], value: unknown): unknown {
+  const replacement = cloneJson(value, 'An operation value');
+  if (tokens.length === 0) {
+    return replacement;
+  }
+
+  const { parent, token } = parentAt(document, tokens);
+  if (Array.isArray(parent)) {
+    parent[arrayIndex(token, parent.length, false)] = replacement;
+  } else if (isJsonObject(parent) && Object.hasOwn(parent, token)) {
+    defineJsonMember(parent, token, replacement);
+  } else {
+    throw new TypeError('The target location does not exist.');
+  }
+  return document;
+}
+
+function get(document: unknown, tokens: string[]): unknown {
+  let value = document;
+  for (const token of tokens) {
+    if (Array.isArray(value)) {
+      value = value[arrayIndex(token, value.length, false)];
+    } else if (isJsonObject(value) && Object.hasOwn(value, token)) {
+      value = value[token];
+    } else {
+      throw new TypeError('The target location does not exist.');
+    }
+  }
+  return value;
+}
+
+function parentAt(document: unknown, tokens: string[]): { parent: unknown; token: string } {
+  return { parent: get(document, tokens.slice(0, -1)), token: tokens[tokens.length - 1] };
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (!/^(?:0|[1-9][0-9]*)$/.test(token)) {
+    throw new TypeError(`"${token}" is not a valid array index.`);
+  }
+  const index = Number(token);
+  if (!Number.isSafeInteger(index) || index > length || (!allowEnd && index === length)) {
+    throw new TypeError(`Array index "${token}" does not exist.`);
+  }
+  return index;
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === '') {
+    return [];
+  }
+  if (!pointer.startsWith('/')) {
+    throw new TypeError('A non-empty JSON Pointer must begin with "/".');
+  }
+  return pointer.slice(1).split('/').map(decodeToken);
+}
+
+function requiredMember(object: Record<string, unknown>, name: string): unknown {
+  if (!Object.hasOwn(object, name)) {
+    throw new TypeError(`The "${name}" member is required.`);
+  }
+  return object[name];
+}
+
+function requiredStringMember(object: Record<string, unknown>, name: string): string {
+  const value = requiredMember(object, name);
+  if (typeof value !== 'string') {
+    throw new TypeError(`The "${name}" member must be a string.`);
+  }
+  return value;
+}
+
+function isProperPrefix(prefix: string[], value: string[]): boolean {
+  return prefix.length < value.length && prefix.every((token, index) => token === value[index]);
+}
+
+function jsonEqual(left: unknown, right: unknown): boolean {
+  if (typeof left !== typeof right || left === null || right === null) {
+    return left === right;
+  }
+  if (typeof left === 'number' || typeof left === 'string' || typeof left === 'boolean') {
+    return left === right;
+  }
+  if (Array.isArray(left) || Array.isArray(right)) {
+    return Array.isArray(left) && Array.isArray(right)
+      && left.length === right.length
+      && left.every((value, index) => jsonEqual(value, right[index]));
+  }
+  if (isJsonObject(left) && isJsonObject(right)) {
+    const leftKeys = Object.keys(left);
+    const rightKeys = Object.keys(right);
+    return leftKeys.length === rightKeys.length
+      && leftKeys.every((key) => Object.hasOwn(right, key) && jsonEqual(left[key], right[key]));
+  }
+  return false;
+}
+
+function cloneJson(value: unknown, subject: string, ancestors = new Set<object>()): unknown {
+  if (value === null || typeof value === 'string' || typeof value === 'boolean') {
+    return value;
+  }
+  if (typeof value === 'number') {
+    if (!Number.isFinite(value)) {
+      throw new TypeError(`${subject} must contain only JSON values.`);
+    }
+    return value;
+  }
+  if (Array.isArray(value)) {
+    if (ancestors.has(value) || Object.keys(value).length !== value.length) {
+      throw new TypeError(`${subject} must contain only JSON values.`);
+    }
+    ancestors.add(value);
+    const clone = value.map((entry) => cloneJson(entry, subject, ancestors));
+    ancestors.delete(value);
+    return clone;
+  }
+  if (isJsonObject(value)) {
+    if (ancestors.has(value)) {
+      throw new TypeError(`${subject} must contain only JSON values.`);
+    }
+    ancestors.add(value);
+    const clone: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) {
+      defineJsonMember(clone, key, cloneJson(value[key], subject, ancestors));
+    }
+    ancestors.delete(value);
+    return clone;
+  }
+  throw new TypeError(`${subject} must contain only JSON values.`);
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+    return false;
+  }
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
+
+function defineJsonMember(object: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(object, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
 function decodeToken(token: string): string {
   if (/~(?:[^01]|$)/.test(token)) {
     throw new TypeError('A JSON Pointer escape must be "~0" or "~1".');
