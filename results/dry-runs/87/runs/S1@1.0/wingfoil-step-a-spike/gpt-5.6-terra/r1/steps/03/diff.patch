+
+test('applies every RFC 6902 operation in sequence without changing its inputs', () => {
+  const source = { foo: ['bar', 'baz'], object: { copied: false } };
+  const patch = [
+    { op: 'add', path: '/foo/1', value: 'qux' },
+    { op: 'replace', path: '/foo/0', value: 'boo' },
+    { op: 'copy', from: '/object', path: '/copy' },
+    { op: 'move', from: '/foo/1', path: '/foo/-' },
+    { op: 'remove', path: '/object/copied' },
+    { op: 'test', path: '/copy', value: { copied: false } },
+  ];
+
+  assert.deepEqual(applyPatch(source, patch), {
+    foo: ['boo', 'baz', 'qux'],
+    object: {},
+    copy: { copied: false },
+  });
+  assert.deepEqual(source, { foo: ['bar', 'baz'], object: { copied: false } });
+  assert.deepEqual(patch, [
+    { op: 'add', path: '/foo/1', value: 'qux' },
+    { op: 'replace', path: '/foo/0', value: 'boo' },
+    { op: 'copy', from: '/object', path: '/copy' },
+    { op: 'move', from: '/foo/1', path: '/foo/-' },
+    { op: 'remove', path: '/object/copied' },
+    { op: 'test', path: '/copy', value: { copied: false } },
+  ]);
+});
+
+test('supports root replacement, object addition, array append, and escaped tokens', () => {
+  assert.deepEqual(applyPatch({ a: {} }, [{ op: 'add', path: '/a/a~1b', value: 1 }]), {
+    a: { 'a/b': 1 },
+  });
+  assert.deepEqual(applyPatch(['a'], [{ op: 'add', path: '/-', value: 'b' }]), ['a', 'b']);
+  assert.deepEqual(applyPatch({ old: true }, [{ op: 'replace', path: '', value: ['new'] }]), ['new']);
+});
+
+test('rejects malformed operations and unsuccessful operations without mutating the document', () => {
+  const source = { a: [1], nested: { value: 1 } };
+  const cases = [
+    [{ op: 'add', path: '/a/2', value: 2 }],
+    [{ op: 'remove', path: '/missing' }],
+    [{ op: 'replace', path: '/missing', value: 1 }],
+    [{ op: 'copy', from: '/missing', path: '/copy' }],
+    [{ op: 'move', from: '/nested', path: '/nested/child' }],
+    [{ op: 'test', path: '/nested/value', value: '1' }],
+    [{ op: 'add', path: '/a/-', value: 2 }, { op: 'test', path: '/a/0', value: 2 }],
+    [{ op: 'wat', path: '/a' }],
+    [{ op: 'add', path: '/a' }],
+    [{ op: 'move', path: '/a' }],
+    [{ op: 'add', path: 'a', value: 1 }],
+  ];
+
+  for (const patch of cases) {
+    assert.throws(() => applyPatch(source, patch));
+    assert.deepEqual(source, { a: [1], nested: { value: 1 } });
+  }
+  assert.throws(() => applyPatch({}, {}));
+});
+
+test('uses JSON equality for test and ignores members unknown to an operation', () => {
+  assert.doesNotThrow(() => applyPatch(
