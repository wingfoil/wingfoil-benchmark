+describe('input validation', () => {
+  it('rejects invalid input and leaves the list unchanged', () => {
+    const list = createTodoList();
+    list.add({ title: 'Keep', tags: ['a'] });
+    const before = JSON.stringify(list.list());
+    const results = [
+      list.add({ title: '   ' }),
+      list.add({ title: 'x'.repeat(121) }),
+      list.add({ title: 'ok', priority: 'urgent' as never }),
+      list.add({ title: 'ok', tags: ['a b'] }),
+      list.add({ title: 'ok', tags: [''] }),
+      list.rename('Keep', ' '),
+      list.rename('Keep', 'x'.repeat(121)),
+      list.tag('Keep', ''),
+      list.tag('Keep', 'two words'),
+    ];
+    for (const r of results) {
+      assert.equal(r.ok, false);
+      if (!r.ok) assert.equal(r.error.code, 'invalid-input');
+    }
+    assert.equal(JSON.stringify(list.list()), before);
+    assert.equal(list.add({ title: 'x'.repeat(120) }).ok, true);
+  });
+});
