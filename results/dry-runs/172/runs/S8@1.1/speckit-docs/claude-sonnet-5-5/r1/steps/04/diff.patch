+describe('importTasks', () => {
+  it('imports valid lines and reports the others by line number', async () => {
+    const { importTasks } = await import('../src/index.ts');
+    const list = createTodoList();
+    const report = importTasks(
+      list,
+      'Renew the insurance;high;admin money\n\nBuy milk\nPay rent;urgent;x\nBuy milk;;\nA;low;b;c\r\nWater plants;;home',
+    );
+    assert.equal(report.imported, 3);
+    assert.deepEqual(report.rejected.map((r) => r.line), [4, 5, 6]);
+    assert.deepEqual(list.find('Renew the insurance').ok && valueOf(list.find('Renew the insurance')).tags, ['admin', 'money']);
+  });
