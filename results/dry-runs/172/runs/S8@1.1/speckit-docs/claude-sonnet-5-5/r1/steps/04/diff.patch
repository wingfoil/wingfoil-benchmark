@@ -0,0 +1,57 @@
+import type { TaskList } from './list.ts';
+import { err, ok } from './result.ts';
+import type { Result } from './result.ts';
+import type { NewTask } from './task.ts';
+import { validatePriority } from './task.ts';
+
+/** A line of an import that could not be added: its number, counting from 1, and why. */
+export interface RejectedLine {
+  readonly line: number;
+  readonly reason: string;
+}
+
+/** The outcome of an import: how many tasks were added, and the lines that were not. */
+export interface ImportReport {
+  readonly imported: number;
+  readonly rejected: readonly RejectedLine[];
+}
+
+/**
+ * Reads one `title;priority;tags` line: the priority may be empty for a normal one, the tags are
+ * separated by spaces, and both may be left out.
+ *
+ * @param line - the line to read
+ */
+export function parseTaskLine(line: string): Result<NewTask> {
+  const fields = line.split(';');
+  if (fields.length > 3) {
+    return err('invalid-input', 'the line has more than 3 fields: use title;priority;tags');
+  }
+  const [title = '', priorityText = '', tagsText = ''] = fields;
+  const priorityName = priorityText.trim().toLowerCase();
+  const tags = tagsText.split(/\s+/).filter((tag) => tag !== '');
+  if (priorityName === '') return ok({ title, tags });
+  const priority = validatePriority(priorityName);
+  if (!priority.ok) return priority;
+  return ok({ title, priority: priority.value, tags });
+}
+
+/**
+ * Adds the tasks written in `text`, one per line as `title;priority;tags`, to a list. Blank lines are
+ * skipped; a line that cannot be added is reported and does not stop the others.
+ *
+ * @param list - the list to add the tasks to
+ * @param text - the lines to import
+ */
+export function importTasks(list: TaskList, text: string): ImportReport {
+  let imported = 0;
+  const rejected: RejectedLine[] = [];
+  text.split(/\r\n|\r|\n/).forEach((content, index) => {
+    if (content.trim() === '') return;
+    const parsed = parseTaskLine(content);
+    const added = parsed.ok ? list.add(parsed.value) : parsed;
+    if (added.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: added.error.message });
+  });
+  return { imported, rejected };
+}
