diff --git a/src/index.ts b/src/index.ts
index 1b59b6b26303d419da8cfa2cd1dd922b15f7a5b1..12dc24bf2157c3251670486f074919600660308b 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -293,3 +293,95 @@ export function applyMergePatch(target: unknown, patch: unknown): unknown {
   assertJson(patch);
   return mergePatch(target, patch);
 }
+
+/** Encodes a reference token for use in a JSON Pointer (RFC 6901, section 3 and 4: "~" then "/"). */
+const encodeToken = (token: string): string => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+/** Appends the operations turning `from` into `to` at `path`; `path` is an encoded pointer. */
+function diff(from: unknown, to: unknown, path: string, ops: PatchOperation[]): void {
+  if (equal(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, path, ops);
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!hasOwn(to, key)) ops.push({ op: "remove", path: `${path}/${encodeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${encodeToken(key)}`;
+      if (hasOwn(from, key)) diff(from[key], to[key], child, ops);
+      else ops.push({ op: "add", path: child, value: clone(to[key]) });
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Array diff from a longest common subsequence of equal items: items outside it
+ * are removed or added individually, and a removed item facing an added one at
+ * the same position is diffed in place. A moved item is a remove plus an add.
+ */
+function diffArrays(from: unknown[], to: unknown[], path: string, ops: PatchOperation[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && equal(from[start], to[start])) start++;
+  let endFrom = from.length;
+  let endTo = to.length;
+  while (endFrom > start && endTo > start && equal(from[endFrom - 1], to[endTo - 1])) {
+    endFrom--;
+    endTo--;
+  }
+  const n = endFrom - start;
+  const m = endTo - start;
+  // lcs[i][j]: length of the LCS of from[start+i..endFrom) and to[start+j..endTo).
+  const lcs = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = equal(from[start + i], to[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  let i = 0;
+  let j = 0;
+  while (i < n || j < m) {
+    if (i < n && j < m && equal(from[start + i], to[start + j])) {
+      i++;
+      j++;
+      continue;
+    }
+    // A hunk: items removed from `from` and added to `to` up to the next common item.
+    const hunkFrom = i;
+    const hunkTo = j;
+    while ((i < n || j < m) && !(i < n && j < m && equal(from[start + i], to[start + j]) && lcs[i][j] === lcs[i + 1][j + 1] + 1)) {
+      if (j < m && (i === n || lcs[i][j + 1] >= lcs[i + 1][j])) j++;
+      else i++;
+    }
+    const removed = i - hunkFrom;
+    const added = j - hunkTo;
+    const paired = Math.min(removed, added);
+    const base = start + hunkTo;
+    for (let k = 0; k < paired; k++) {
+      diff(from[start + hunkFrom + k], to[start + hunkTo + k], `${path}/${base + k}`, ops);
+    }
+    for (let k = paired; k < removed; k++) ops.push({ op: "remove", path: `${path}/${base + paired}` });
+    for (let k = paired; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${base + k}`, value: clone(to[start + hunkTo + k]) });
+    }
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902, section 4; paths are RFC 6901 pointers) that
+ * turns `from` into `to` when applied with `applyPatch`. The patch holds only
+ * what changed: object members are compared recursively, and array items that
+ * were inserted or removed are added or removed individually (a moved item is
+ * removed and added back). Neither argument is modified, and the patch shares
+ * no structure with them. Equal documents (object member order ignored, as in
+ * section 4.6) give an empty patch; documents of different types give a single
+ * root `replace`. `__proto__` is handled as an ordinary member.
+ */
+export function createPatch(from: unknown, to: unknown): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diff(from, to, "", ops);
+  return ops;
+}
diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..033a7ab20830f4a06d3ded1439398a4e84f2670c
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,105 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const before = JSON.stringify(from);
+  const beforeTo = JSON.stringify(to);
+  const patch = createPatch(from, to);
+  assert.deepStrictEqual(applyPatch(from, patch), to);
+  assert.strictEqual(JSON.stringify(from), before);
+  assert.strictEqual(JSON.stringify(to), beforeTo);
+  return patch;
+};
+
+test("identical documents give an empty patch", () => {
+  assert.deepStrictEqual(roundTrip({ a: [1, { b: 2 }], c: null }, { c: null, a: [1, { b: 2 }] }), []);
+  assert.deepStrictEqual(roundTrip(1, 1), []);
+  assert.deepStrictEqual(roundTrip([], []), []);
+});
+
+test("one small change in a large document", () => {
+  const patch = roundTrip({ a: { b: { c: 1, d: 2 } }, e: [1, 2] }, { a: { b: { c: 1, d: 3 } }, e: [1, 2] });
+  assert.deepStrictEqual(patch, [{ op: "replace", path: "/a/b/d", value: 3 }]);
+});
+
+test("object member added and removed", () => {
+  const patch = roundTrip({ a: 1, b: 2 }, { a: 1, c: 3 });
+  assert.deepStrictEqual(patch, [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("null versus missing", () => {
+  assert.deepStrictEqual(roundTrip({ a: 1 }, { a: null }), [{ op: "replace", path: "/a", value: null }]);
+  assert.deepStrictEqual(roundTrip({ a: null }, {}), [{ op: "remove", path: "/a" }]);
+  assert.deepStrictEqual(roundTrip({}, { a: null }), [{ op: "add", path: "/a", value: null }]);
+});
+
+test("root replacement and type changes", () => {
+  assert.deepStrictEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  assert.deepStrictEqual(roundTrip({ a: 1 }, [1]), [{ op: "replace", path: "", value: [1] }]);
+  assert.deepStrictEqual(roundTrip(null, {}), [{ op: "replace", path: "", value: {} }]);
+  roundTrip({ a: [1] }, { a: { 0: 1 } });
+});
+
+test("keys are escaped in pointers", () => {
+  const patch = roundTrip({ "a/b": 1, "m~n": 1, "": 1 }, { "a/b": 2, "m~n": 2, "": 2 });
+  assert.deepStrictEqual(patch.map((o) => o.path).sort(), ["/", "/a~1b", "/m~0n"]);
+});
+
+test("__proto__ is an ordinary member", () => {
+  const from = JSON.parse('{"__proto__": {"x": 1}}');
+  const to = JSON.parse('{"__proto__": {"x": 2}}');
+  roundTrip(from, to);
+  roundTrip({}, to);
+  assert.strictEqual(({} as Record<string, unknown>).x, undefined);
+});
+
+test("array item inserted or removed touches only that item", () => {
+  assert.deepStrictEqual(roundTrip([1, 2, 3], [1, 9, 2, 3]), [{ op: "add", path: "/1", value: 9 }]);
+  assert.deepStrictEqual(roundTrip([1, 2, 3], [1, 3]), [{ op: "remove", path: "/1" }]);
+  assert.deepStrictEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: "add", path: "/2", value: 3 }]);
+  assert.deepStrictEqual(roundTrip([1, 2], []), [
+    { op: "remove", path: "/0" },
+    { op: "remove", path: "/0" },
+  ]);
+  const objs = [{ id: 1 }, { id: 2 }, { id: 3 }];
+  assert.deepStrictEqual(roundTrip(objs, [{ id: 0 }, ...objs]), [{ op: "add", path: "/0", value: { id: 0 } }]);
+});
+
+test("array item moved does not rewrite the items between", () => {
+  const patch = roundTrip(["a", "b", "c", "d", "e"], ["a", "e", "b", "c", "d"]);
+  assert.ok(patch.length <= 2);
+  assert.ok(patch.every((o) => o.op !== "replace"));
+  const patch2 = roundTrip([{ id: 1 }, { id: 2 }, { id: 3 }, { id: 4 }], [{ id: 2 }, { id: 3 }, { id: 4 }, { id: 1 }]);
+  assert.ok(patch2.length <= 2 && patch2.every((o) => o.op !== "replace"));
+});
+
+test("changed array item is patched in place", () => {
+  const patch = roundTrip([{ id: 1, v: 1 }, { id: 2, v: 2 }], [{ id: 1, v: 1 }, { id: 2, v: 5 }]);
+  assert.deepStrictEqual(patch, [{ op: "replace", path: "/1/v", value: 5 }]);
+});
+
+test("patch shares no structure with the inputs", () => {
+  const to = { a: { b: [1] } };
+  const patch = createPatch({}, to);
+  (patch[0].value as { b: number[] }).b.push(2);
+  assert.deepStrictEqual(to, { a: { b: [1] } });
+});
+
+test("randomised round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff), seed % n);
+  const gen = (d: number): unknown => {
+    const k = rnd(d > 2 ? 4 : 6);
+    if (k === 0) return rnd(3);
+    if (k === 1) return ["x", "y", "z"][rnd(3)];
+    if (k === 2) return null;
+    if (k === 3) return rnd(2) === 0;
+    if (k === 4) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => [["a", "b", "c/", "~"][rnd(4)], gen(d + 1)]));
+  };
+  for (let i = 0; i < 2000; i++) roundTrip(gen(0), gen(0));
+});
