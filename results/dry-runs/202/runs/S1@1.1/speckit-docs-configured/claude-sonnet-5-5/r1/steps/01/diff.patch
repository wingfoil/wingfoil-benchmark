index 0000000000000000000000000000000000000000..ee8f5e4c42efe9ec7b5efaab96fae2f36973ac58
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,93 @@
+import { test } from "node:test";
+import assert from "node:assert";
+import { resolvePointer, JsonPointerError } from "../src/index.ts";
+
+// RFC 6901 section 5 document and section 5/6 examples.
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("RFC 6901 section 5 examples", () => {
+  assert.strictEqual(resolvePointer(doc, ""), doc);
+  assert.deepStrictEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.strictEqual(resolvePointer(doc, "/foo/0"), "bar");
+  assert.strictEqual(resolvePointer(doc, "/"), 0);
+  assert.strictEqual(resolvePointer(doc, "/a~1b"), 1);
+  assert.strictEqual(resolvePointer(doc, "/c%d"), 2);
+  assert.strictEqual(resolvePointer(doc, "/e^f"), 3);
+  assert.strictEqual(resolvePointer(doc, "/g|h"), 4);
+  assert.strictEqual(resolvePointer(doc, "/i\\j"), 5);
+  assert.strictEqual(resolvePointer(doc, '/k"l'), 6);
+  assert.strictEqual(resolvePointer(doc, "/ "), 7);
+  assert.strictEqual(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("RFC 6901 section 6 URI fragment strings are not pointers", () => {
+  assert.throws(() => resolvePointer(doc, "#/foo"), JsonPointerError);
+});
+
+test("unescaping order: ~01 is the key ~1", () => {
+  assert.strictEqual(resolvePointer({ "~1": "x", "/": "y" }, "/~01"), "x");
+  assert.strictEqual(resolvePointer({ "~1": "x", "/": "y" }, "/~1"), "y");
+});
+
+test("invalid pointers", () => {
+  for (const p of ["foo", "a/b", " ", "/~", "/~2", "/a~", "/a~x/b"]) {
+    assert.throws(() => resolvePointer({ a: {} }, p), JsonPointerError, p);
+  }
+  assert.throws(() => resolvePointer({}, undefined as unknown as string), JsonPointerError);
+});
+
+test("whole-document pointer returns falsy and null documents", () => {
+  assert.strictEqual(resolvePointer(null, ""), null);
+  assert.strictEqual(resolvePointer(0, ""), 0);
+});
+
+test("null versus missing", () => {
+  assert.strictEqual(resolvePointer({ a: null }, "/a"), null);
+  assert.throws(() => resolvePointer({ a: null }, "/b"), JsonPointerError);
+  assert.throws(() => resolvePointer({ a: null }, "/a/b"), JsonPointerError);
+});
+
+test("array indices", () => {
+  const d = { a: ["x", "y", "z"] };
+  assert.strictEqual(resolvePointer(d, "/a/2"), "z");
+  assert.throws(() => resolvePointer(d, "/a/3"), JsonPointerError); // out of range
+  assert.throws(() => resolvePointer(d, "/a/-"), JsonPointerError); // nonexistent element
+  assert.throws(() => resolvePointer(d, "/a/01"), JsonPointerError); // leading zero
+  assert.throws(() => resolvePointer(d, "/a/+1"), JsonPointerError);
+  assert.throws(() => resolvePointer(d, "/a/-1"), JsonPointerError);
+  assert.throws(() => resolvePointer(d, "/a/1.0"), JsonPointerError);
+  assert.throws(() => resolvePointer(d, "/a/"), JsonPointerError);
+  assert.throws(() => resolvePointer(d, "/a/length"), JsonPointerError);
+  assert.throws(() => resolvePointer([], "/0"), JsonPointerError);
+});
+
+test("scalars cannot be traversed", () => {
+  assert.throws(() => resolvePointer({ a: "str" }, "/a/0"), JsonPointerError);
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"), JsonPointerError);
+});
+
+test("only own properties resolve (prototype safety)", () => {
+  for (const p of ["/__proto__", "/constructor", "/toString", "/a/prototype", "/constructor/prototype"]) {
+    assert.throws(() => resolvePointer({ a: {} }, p), JsonPointerError, p);
+  }
+  const parsed = JSON.parse('{"__proto__": 5}');
+  assert.strictEqual(resolvePointer(parsed, "/__proto__"), 5);
+});
+
+test("does not mutate the document", () => {
+  const d = { a: [1, { b: 2 }] };
+  const copy = structuredClone(d);
+  resolvePointer(d, "/a/1/b");
+  assert.deepStrictEqual(d, copy);
+});
