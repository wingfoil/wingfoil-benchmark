+/** Error thrown for an invalid JSON Pointer or one that does not resolve (RFC 6901). */
+export class JsonPointerError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "JsonPointerError";
+  }
+}
+
+/** Parses a JSON Pointer into reference tokens (RFC 6901, sections 3 and 4). */
+function parse(pointer: string): string[] {
+  if (typeof pointer !== "string") {
+    throw new JsonPointerError("JSON Pointer must be a string");
+  }
+  if (pointer === "") return [];
+  if (pointer[0] !== "/") {
+    throw new JsonPointerError(`Invalid JSON Pointer "${pointer}": must be empty or start with "/"`);
+  }
+  return pointer
+    .slice(1)
+    .split("/")
+    .map((token) => {
+      if (/~(?![01])/.test(token)) {
+        throw new JsonPointerError(`Invalid JSON Pointer "${pointer}": "~" must be followed by 0 or 1`);
+      }
+      // Section 4: ~1 first, then ~0, so that "~01" becomes "~1".
+      return token.replace(/~1/g, "/").replace(/~0/g, "~");
+    });
+}
+
+/**
+ * Resolves a JSON Pointer against a JSON document, as specified by RFC 6901
+ * (syntax in section 3, evaluation in section 4; the URI fragment form of
+ * section 6 is not accepted). Does not modify the document.
+ *
+ * @throws {JsonPointerError} if the pointer is invalid, or does not refer to
+ * a value of the document (missing member, out-of-range index, the "-"
+ * array token, or traversal through a scalar or null).
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  let current = document;
+  for (const token of parse(pointer)) {
+    if (Array.isArray(current)) {
+      // Section 4: index is "0" or digits without a leading zero.
+      if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+        throw new JsonPointerError(`Pointer "${pointer}": "${token}" is not a valid array index`);
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new JsonPointerError(`Pointer "${pointer}": index ${token} does not exist`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new JsonPointerError(`Pointer "${pointer}": member "${token}" does not exist`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new JsonPointerError(`Pointer "${pointer}": cannot traverse a non-container value at "${token}"`);
+    }
+  }
+  return current;
+}
