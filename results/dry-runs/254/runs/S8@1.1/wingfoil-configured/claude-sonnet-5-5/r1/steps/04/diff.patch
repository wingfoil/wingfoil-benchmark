diff --git a/test/import.test.ts b/test/import.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..528d858b052261e3cebdda86dd0c33b1303e9fe6
--- /dev/null
+++ b/test/import.test.ts
@@ -0,0 +1,40 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { createTodoList, importTasks } from '../src/index.ts';
+
+describe('importTasks', () => {
+  it('adds every valid line, with priority and tags, skipping blank lines', () => {
+    const list = createTodoList();
+    const report = importTasks(list, 'Renew the insurance;high;admin money\n\nBuy milk;;\r\nWater plants\n');
+    assert.deepEqual(report, { imported: 3, rejected: [] });
+    const insurance = list.find('Renew the insurance');
+    assert.ok(insurance.ok);
+    assert.equal(insurance.value.priority, 'high');
+    assert.deepEqual(insurance.value.tags, ['admin', 'money']);
+    const milk = list.find('Buy milk');
+    assert.ok(milk.ok);
+    assert.equal(milk.value.priority, 'normal');
+  });
+
+  it('rejects bad lines with their number and keeps importing the rest', () => {
+    const list = createTodoList();
+    list.add({ title: 'Existing' });
+    const report = importTasks(list, ';high;\n\nGood;low;a\nBad;urgent;\nExisting;;\nGood;;\nToo;high;a;b');
+    assert.equal(report.imported, 1);
+    assert.deepEqual(
+      report.rejected.map((r) => r.line),
+      [1, 4, 5, 6, 7],
+    );
+    assert.match(report.rejected[0]!.reason, /title is empty/);
+    assert.match(report.rejected[1]!.reason, /urgent/);
+    assert.match(report.rejected[2]!.reason, /already/);
+    assert.match(report.rejected[3]!.reason, /already/);
+    assert.match(report.rejected[4]!.reason, /fields/);
+    assert.equal(list.list().length, 2);
+  });
+
+  it('imports nothing from empty text', () => {
+    assert.deepEqual(importTasks(createTodoList(), ''), { imported: 0, rejected: [] });
+  });
+});
