--- a/src/index.ts
+++ b/src/index.ts
@@ -29,10 +29,21 @@ export interface Booking extends Quote {
   id: string;
 }
 
+export interface AvailabilityQuery {
+  /** ISO-8601 UTC timestamp at midnight UTC. */
+  start: string;
+  /** ISO-8601 UTC timestamp at midnight UTC; the start of the day after the last rented day. */
+  end: string;
+  /** Only report equipment of this kind; any kind when omitted. */
+  kind?: EquipmentKind;
+}
+
 export interface RentalService {
   addEquipment(item: Equipment): void;
   quote(request: RentalRequest): Quote;
   book(request: RentalRequest): Booking;
+  /** Ids of the matching equipment that is free for the whole period, sorted. */
+  availability(query: AvailabilityQuery): string[];
 }
 
 const DAY_MS = 24 * 60 * 60 * 1000;
@@ -63,6 +74,15 @@ function parseMidnightUtc(value: unknown, name: string): number {
   return ms;
 }
 
+function parsePeriod(start: unknown, end: unknown): { startMs: number; endMs: number } {
+  const startMs = parseMidnightUtc(start, 'start');
+  const endMs = parseMidnightUtc(end, 'end');
+  if (endMs <= startMs) {
+    throw new Error('end must be after start');
+  }
+  return { startMs, endMs };
+}
+
 function validateEquipment(item: Equipment): void {
   if (typeof item.id !== 'string' || item.id === '') {
     throw new Error('equipment id must be a non-empty string');
@@ -84,11 +104,7 @@ export function createRentalService(): RentalService {
     if (item === undefined) {
       throw new Error(`unknown item: ${request.itemId}`);
     }
-    const startMs = parseMidnightUtc(request.start, 'start');
-    const endMs = parseMidnightUtc(request.end, 'end');
-    if (endMs <= startMs) {
-      throw new Error('end must be after start');
-    }
+    const { startMs, endMs } = parsePeriod(request.start, request.end);
     const days = (endMs - startMs) / DAY_MS;
     return {
       itemId: request.itemId,
@@ -126,5 +142,26 @@ export function createRentalService(): RentalService {
       bookings.push({ id, itemId: request.itemId, startMs, endMs });
       return { id, ...quote };
     },
+
+    availability(query) {
+      const { startMs, endMs } = parsePeriod(query.start, query.end);
+      if (query.kind !== undefined && !KINDS.includes(query.kind)) {
+        throw new Error(`equipment kind must be 'board' or 'sail'`);
+      }
+      const free: string[] = [];
+      for (const item of equipment.values()) {
+        if (query.kind !== undefined && item.kind !== query.kind) {
+          continue;
+        }
+        // Same half-open rule as book, so a period ending at midnight does not block one starting then.
+        const clash = bookings.some(
+          (b) => b.itemId === item.id && startMs < b.endMs && b.startMs < endMs,
+        );
+        if (!clash) {
+          free.push(item.id);
+        }
+      }
+      return free.sort();
