   };
 }
diff --git a/test/rental.test.ts b/test/rental.test.ts
index e1dbd89dcb1e3c736d88572d0b1e85ab7e7fa59e..e087b8825fa9eb0db2786c141addcf7987fb6851 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -142,3 +142,53 @@ describe('book', () => {
     assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-02' }));
   });
 });
+
+describe('availability', () => {
+  test('lists every item when no kind is given, sorted', () => {
+    const service = setup();
+    service.addEquipment({ id: 'a-board', kind: 'board', dailyPrice: 100 });
+    assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-02' }), [
+      'a-board',
+      'board-1',
+      'sail-1',
+    ]);
+  });
+
+  test('filters by kind', () => {
+    const service = setup();
+    assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-02', kind: 'sail' }), ['sail-1']);
+    assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-02', kind: 'board' }), ['board-1']);
+  });
+
+  test('leaves out equipment booked for any part of the period', () => {
+    const service = setup();
+    service.book({ itemId: 'board-1', start: '2026-07-03', end: '2026-07-05' });
+    assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-04', kind: 'board' }), []);
+    assert.deepEqual(service.availability({ start: '2026-07-04', end: '2026-07-06', kind: 'board' }), []);
+    assert.deepEqual(service.availability({ start: '2026-06-01', end: '2026-07-03', kind: 'board' }), ['board-1']);
+    assert.deepEqual(service.availability({ start: '2026-07-05', end: '2026-07-06', kind: 'board' }), ['board-1']);
+  });
+
+  test('ignores bookings of other items', () => {
+    const service = setup();
+    service.book({ itemId: 'sail-1', start: '2026-07-01', end: '2026-07-04' });
+    assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-04' }), ['board-1']);
+  });
+
+  test('returns an empty list when nothing is free', () => {
+    const service = createRentalService();
+    assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-02' }), []);
+  });
+
+  test('throws for an invalid period', () => {
+    const service = setup();
+    assert.throws(() => service.availability({ start: '2026-07-02', end: '2026-07-02' }), /end must be after start/);
+    assert.throws(() => service.availability({ start: '2026-07-01T06:00:00Z', end: '2026-07-02' }));
+    assert.throws(() => service.availability({ start: '2026-02-30', end: '2026-03-01' }));
+  });
+
+  test('throws for an unknown kind', () => {
+    const service = setup();
+    assert.throws(() => service.availability({ start: '2026-07-01', end: '2026-07-02', kind: 'kite' as never }));
+  });
+});
