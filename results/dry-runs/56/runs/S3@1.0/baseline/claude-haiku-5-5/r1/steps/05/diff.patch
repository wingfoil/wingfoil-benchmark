+describe('cancel', () => {
+  test('refunds the full total when cancelled before the rental starts', () => {
+    const service = setup();
+    const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+    assert.deepEqual(service.cancel(booking.id, '2026-06-20T09:00:00Z'), { bookingId: booking.id, refund: 6750 });
+  });
+
+  test('refunds nothing when cancelled after the rental has started', () => {
+    const service = setup();
+    const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+    assert.deepEqual(service.cancel(booking.id, '2026-07-02T00:00:00Z'), { bookingId: booking.id, refund: 0 });
+  });
+
+  test('frees the equipment for other bookings', () => {
+    const service = setup();
+    const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+    service.cancel(booking.id, '2026-06-20T09:00:00Z');
+    assert.deepEqual(service.availability({ start: '2026-07-01', end: '2026-07-04', kind: 'board' }), ['board-1']);
+    assert.doesNotThrow(() => service.book({ itemId: 'board-1', start: '2026-07-02', end: '2026-07-03' }));
+  });
+
+  test('can be cancelled only once', () => {
+    const service = setup();
+    const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-04' });
+    service.cancel(booking.id, '2026-06-20T09:00:00Z');
+    assert.throws(() => service.cancel(booking.id, '2026-06-21T09:00:00Z'), /already cancelled/);
+  });
+
+  test('throws for an unknown booking', () => {
+    const service = setup();
+    assert.throws(() => service.cancel('nope', '2026-06-20T09:00:00Z'), /unknown booking/);
+  });
+
+  test('throws for a booking that has already ended', () => {
+    const service = setup();
+    const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-02' });
+    assert.throws(() => service.cancel(booking.id, '2026-07-02T00:00:00Z'), /already ended/);
+  });
+
+  test('throws for an invalid time without cancelling', () => {
+    const service = setup();
+    const booking = service.book({ itemId: 'board-1', start: '2026-07-01', end: '2026-07-02' });
+    assert.throws(() => service.cancel(booking.id, '2026-06-20T09:00:00'));
+    assert.doesNotThrow(() => service.cancel(booking.id, '2026-06-20T09:00:00Z'));
+  });
+});
