diff --git a/test/rental.test.ts b/test/rental.test.ts
index 9dc8e00b93e44e69a9e3935f456865f4d6d59694..d303b62befd07edda697e63fabaa43c3428691ea 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -125,3 +125,33 @@ test('hourly rentals need an hourly price and whole hours', () => {
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
   assert.throws(() => s.addEquipment({ id: 'y', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
 });
+
+test('cancel refunds in full with a day of notice, nothing later', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d('05-03'), end: d('05-05') });
+  assert.deepEqual(s.cancel(a.id, '2026-05-02T00:00:00Z'), { bookingId: a.id, refund: 9000 });
+  const b = s.book({ itemId: 'b1', start: d('05-03'), end: d('05-05') });
+  assert.deepEqual(s.cancel(b.id, '2026-05-02T00:00:01Z'), { bookingId: b.id, refund: 0 });
+  const c = s.book({ itemId: 'b1', start: d('05-03'), end: d('05-05') });
+  assert.equal(s.cancel(c.id, '2026-05-04T10:00:00Z').refund, 0);
+});
+
+test('a cancelled booking frees its item and cannot be cancelled again', () => {
+  const s = setup();
+  const r = { itemId: 'b1', start: d('05-03'), end: d('05-05') };
+  const a = s.book(r);
+  assert.deepEqual(s.availability({ start: d('05-03'), end: d('05-05'), kind: 'board' }), []);
+  s.cancel(a.id, d('05-01'));
+  assert.deepEqual(s.availability({ start: d('05-03'), end: d('05-05'), kind: 'board' }), ['b1']);
+  s.book(r);
+  assert.throws(() => s.cancel(a.id, d('05-01')));
+});
+
+test('cancel rejects unknown bookings, bad times and ended rentals', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d('05-03'), end: d('05-05') });
+  assert.throws(() => s.cancel('nope', d('05-01')));
+  assert.throws(() => s.cancel(a.id, '2026-05-01'));
+  assert.throws(() => s.cancel(a.id, d('05-05')));
+  s.cancel(a.id, d('05-01'));
+});
