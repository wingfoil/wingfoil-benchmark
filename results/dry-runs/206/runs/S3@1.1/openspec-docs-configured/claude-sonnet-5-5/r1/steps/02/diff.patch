+test('availability lists sorted free items, optionally by kind', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a0', kind: 'board', dailyPrice: 1000 });
+  s.book({ itemId: 'b1', start: d('05-02'), end: d('05-05') });
+  assert.deepEqual(s.availability({ start: d('05-01'), end: d('05-03') }), ['a0', 's1']);
+  assert.deepEqual(s.availability({ start: d('05-01'), end: d('05-03'), kind: 'board' }), ['a0']);
+  assert.deepEqual(s.availability({ start: d('05-01'), end: d('05-03'), kind: 'sail' }), ['s1']);
+  // adjacent periods leave the item free
+  assert.deepEqual(s.availability({ start: d('05-05'), end: d('05-06'), kind: 'board' }), ['a0', 'b1']);
+  assert.deepEqual(s.availability({ start: d('05-01'), end: d('05-02'), kind: 'board' }), ['a0', 'b1']);
+  // a booking inside the period makes the item unavailable
+  assert.deepEqual(s.availability({ start: d('05-01'), end: d('05-09'), kind: 'board' }), ['a0']);
+});
+
+test('availability rejects bad queries', () => {
+  const s = setup();
+  assert.throws(() => s.availability({ start: d('05-02'), end: d('05-02') }));
+  assert.throws(() => s.availability({ start: '2026-05-01', end: d('05-02') }));
+  assert.throws(() => s.availability({ start: d('05-01'), end: d('05-02'), kind: 'kayak' as 'board' }));
+});
+
