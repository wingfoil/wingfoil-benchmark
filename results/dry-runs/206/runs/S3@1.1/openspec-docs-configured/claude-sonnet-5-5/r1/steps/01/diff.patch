--- /dev/null
+++ b/test/rental.test.ts
@@ -0,0 +1,66 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRentalService } from '../src/index.ts';
+
+function setup() {
+  const s = createRentalService();
+  s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 4500 });
+  s.addEquipment({ id: 's1', kind: 'sail', dailyPrice: 2000 });
+  return s;
+}
+const d = (day: string) => `2026-${day}T00:00:00Z`;
+
+test('quote prices whole days in cents', () => {
+  const q = setup().quote({ itemId: 'b1', start: d('05-01'), end: d('05-04') });
+  assert.deepEqual(q, {
+    itemId: 'b1',
+    start: '2026-05-01T00:00:00.000Z',
+    end: '2026-05-04T00:00:00.000Z',
+    total: 13500,
+  });
+});
+
+test('quote and book reject unknown items and bad periods', () => {
+  const s = setup();
+  const bad = [
+    { itemId: 'nope', start: d('05-01'), end: d('05-02') },
+    { itemId: 'b1', start: d('05-02'), end: d('05-02') },
+    { itemId: 'b1', start: d('05-03'), end: d('05-02') },
+    { itemId: 'b1', start: '2026-05-01T10:00:00Z', end: d('05-02') },
+    { itemId: 'b1', start: '2026-05-01T00:00:00+02:00', end: d('05-02') },
+    { itemId: 'b1', start: '2026-05-01', end: d('05-02') },
+    { itemId: 'b1', start: d('02-30'), end: d('03-02') },
+  ];
+  for (const r of bad) {
+    assert.throws(() => s.quote(r));
+    assert.throws(() => s.book(r));
+  }
+});
+
+test('book returns an identified booking', () => {
+  const s = setup();
+  const a = s.book({ itemId: 'b1', start: d('05-01'), end: d('05-03') });
+  const b = s.book({ itemId: 's1', start: d('05-01'), end: d('05-03') });
+  assert.equal(a.total, 9000);
+  assert.equal(a.itemId, 'b1');
+  assert.notEqual(a.id, b.id);
+});
+
+test('same item cannot be booked for overlapping periods', () => {
+  const s = setup();
+  s.book({ itemId: 'b1', start: d('05-02'), end: d('05-05') });
+  for (const [start, end] of [['05-01', '05-03'], ['05-04', '05-06'], ['05-03', '05-04'], ['05-01', '05-09']]) {
+    assert.throws(() => s.book({ itemId: 'b1', start: d(start), end: d(end) }));
+  }
+  // adjacent periods and other items are fine
+  s.book({ itemId: 'b1', start: d('05-05'), end: d('05-06') });
+  s.book({ itemId: 'b1', start: d('05-01'), end: d('05-02') });
+  s.book({ itemId: 's1', start: d('05-02'), end: d('05-05') });
+});
+
+test('addEquipment validates input', () => {
+  const s = setup();
+  assert.throws(() => s.addEquipment({ id: 'b1', kind: 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'kayak' as 'board', dailyPrice: 1 }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
+});
