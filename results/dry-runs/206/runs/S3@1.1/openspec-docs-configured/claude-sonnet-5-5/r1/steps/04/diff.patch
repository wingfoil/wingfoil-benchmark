diff --git a/test/rental.test.ts b/test/rental.test.ts
index 72262a707c063bbb92fa8a35e091d5610418242d..9dc8e00b93e44e69a9e3935f456865f4d6d59694 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -97,3 +97,31 @@ test('addEquipment validates input', () => {
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'kayak' as 'board', dailyPrice: 1 }));
   assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 12.5 }));
 });
+
+test('rentals shorter than a day are priced per hour', () => {
+  const s = setup();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 4500, hourlyPrice: 900 });
+  const r = { itemId: 'h1', start: '2026-05-01T13:00:00Z', end: '2026-05-01T17:00:00Z' };
+  assert.equal(s.quote(r).total, 3600);
+  assert.equal(s.book(r).total, 3600);
+  // Overlapping hours clash, adjacent hours do not.
+  assert.throws(() => s.book({ ...r, start: '2026-05-01T16:00:00Z', end: '2026-05-01T18:00:00Z' }));
+  s.book({ ...r, start: '2026-05-01T17:00:00Z', end: '2026-05-01T18:00:00Z' });
+  // Longest hourly rental: 23 hours, across midnight.
+  assert.equal(
+    s.quote({ itemId: 'h1', start: '2026-05-01T00:00:00Z', end: '2026-05-01T23:00:00Z' }).total,
+    23 * 900,
+  );
+});
+
+test('hourly rentals need an hourly price and whole hours', () => {
+  const s = setup();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 4500, hourlyPrice: 900 });
+  const short = { start: '2026-05-01T13:00:00Z', end: '2026-05-01T15:00:00Z' };
+  assert.throws(() => s.quote({ itemId: 'b1', ...short }));
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-05-01T13:30:00Z', end: '2026-05-01T15:00:00Z' }));
+  // A day or more still has to start and end at midnight.
+  assert.throws(() => s.quote({ itemId: 'h1', start: '2026-05-01T13:00:00Z', end: '2026-05-02T13:00:00Z' }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'board', dailyPrice: 1, hourlyPrice: -1 }));
+  assert.throws(() => s.addEquipment({ id: 'y', kind: 'board', dailyPrice: 1, hourlyPrice: 1.5 }));
+});
