+describe('single-use coupon and cancellation', () => {
+  it('gives the coupon back when its order is cancelled, so the customer can reuse it', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'A-1', name: 'A', priceCents: 3000, vatClass: 'standard', weightGrams: 100 });
+    s.inventory.restock('A-1', 5);
+    s.coupons.add({ code: 'WELCOME', kind: 'fixed', value: 500, validFrom: '2026-01-01', validUntil: '2026-12-31', singleUse: true });
+    const first = s.orders.place({ customer: 'paolo', date: '2026-03-02', coupon: 'welcome', lines: [{ sku: 'A-1', quantity: 1 }] });
+    s.orders.cancel(first.id, '2026-03-02');
+    assert.equal(s.coupons.usedBy('WELCOME'), undefined);
+    const second = s.orders.place({ customer: 'paolo', date: '2026-03-02', coupon: 'welcome', lines: [{ sku: 'A-1', quantity: 1 }] });
+    assert.equal(second.totals.couponDiscountCents, 500);
