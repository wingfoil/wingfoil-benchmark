+
+describe('reported fixes', () => {
+  it('finds products by SKU in any case', () => {
+    const { catalog } = shop();
+    assert.equal(catalog.get(' mug-01 ').sku, 'MUG-01');
+  });
+
+  it('ships free from exactly 50.00 and not below', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'A-1', name: 'A', priceCents: 5000, vatClass: 'standard', weightGrams: 100 });
+    s.catalog.add({ sku: 'B-1', name: 'B', priceCents: 4999, vatClass: 'standard', weightGrams: 100 });
+    s.inventory.restock('A-1', 5);
+    s.inventory.restock('B-1', 5);
+    const at = s.orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'A-1', quantity: 1 }] });
+    const below = s.orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'B-1', quantity: 1 }] });
+    assert.equal(at.totals.shippingCents, 0);
+    assert.equal(below.totals.shippingCents, 490);
+  });
+
+  it('rounds line VAT half up: 1.99 at 22% is 0.44, 1.00 at 22% is 0.22', () => {
+    const s = createShop();
+    s.catalog.add({ sku: 'C-1', name: 'C', priceCents: 199, vatClass: 'standard', weightGrams: 10 });
+    s.catalog.add({ sku: 'D-1', name: 'D', priceCents: 100, vatClass: 'standard', weightGrams: 10 });
+    s.inventory.restock('C-1', 5);
+    s.inventory.restock('D-1', 5);
+    const c = s.orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'C-1', quantity: 1 }] });
+    const d = s.orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'D-1', quantity: 1 }] });
+    assert.equal(c.lines[0]?.vatCents, 44);
+    assert.equal(d.lines[0]?.vatCents, 22);
+  });
+});
