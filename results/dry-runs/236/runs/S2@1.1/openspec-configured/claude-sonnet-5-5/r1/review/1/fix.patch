+
+describe('inventory SKUs', () => {
+  it('keys stock by canonical SKU', () => {
+    const { orders, catalog, inventory } = shop();
+    catalog.add({ sku: 'LB-220', name: 'Lamp', priceCents: 1000, vatClass: 'standard', weightGrams: 100 });
+    inventory.restock('lb-220', 5);
+    assert.equal(inventory.available(' LB-220 '), 5);
+    assert.equal(inventory.movements('lb-220')[0]?.sku, 'LB-220');
+    orders.place({ customer: 'c', date: '2026-03-02', lines: [{ sku: 'LB-220', quantity: 5 }] });
+    assert.equal(inventory.available('lb-220'), 0);
+  });
+
+  it('lists low stock under the canonical SKU', () => {
+    const { inventory } = shop();
+    inventory.restock('lb-220', 5);
+    assert.deepEqual(inventory.lowStock(['lb-220']), []);
+    inventory.adjust('lb-220', 4);
+    assert.deepEqual(inventory.lowStock(['lb-220']), [{ sku: 'LB-220', available: 4 }]);
+  });
+});
