diff --git a/test/rental.test.mjs b/test/rental.test.mjs
index 4d4242bf696141e55d5db74dde4d9e743dbbb94f..520bfbcf6ec2b8cec8991303f498bf4e18a39e08 100644
--- a/test/rental.test.mjs
+++ b/test/rental.test.mjs
@@ -12,6 +12,92 @@ function setup() {
   return service;
 }
 
+const hourlyRequest = (start = '2026-06-10T13:00:00Z', end = '2026-06-10T16:00:00Z') => ({
+  itemId: 'board', start, end,
+});
+
+test('hourly quotes and bookings charge each hour, including across midnight', () => {
+  for (const operation of ['quote', 'book']) {
+    for (const [start, end, hours] of [
+      ['2026-06-10T13:00Z', '2026-06-10T14:00:00+00:00', 1],
+      ['2026-06-10T13:00:00Z', '2026-06-10T16:00:00Z', 3],
+      ['2026-12-31T23:00:00Z', '2027-01-01T02:00:00Z', 3],
+      ['2026-06-10T01:00:00Z', '2026-06-11T00:00:00Z', 23],
+    ]) {
+      const service = createRentalService();
+      service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 1000, hourlyPrice: 501 });
+      const rental = hourlyRequest(start, end);
+      const result = service[operation](rental);
+      assert.equal(result.total, hours * 501);
+      assert.equal(result.start, start);
+      assert.equal(result.end, end);
+    }
+  }
+});
+
+test('hourly prices are optional, validated, copied, and can be zero', () => {
+  const service = setup();
+  for (const hourlyPrice of [-1, 1.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 1, null, '100']) {
+    assert.throws(() => service.addEquipment({ id: 'new', kind: 'board', dailyPrice: 1, hourlyPrice }));
+  }
+  for (const operation of ['quote', 'book']) {
+    assert.throws(() => service[operation](hourlyRequest()));
+  }
+  const item = { id: 'free', kind: 'sail', dailyPrice: 1000, hourlyPrice: 0 };
+  service.addEquipment(item);
+  item.hourlyPrice = 500;
+  assert.equal(service.book({ ...hourlyRequest(), itemId: 'free' }).total, 0);
+  service.addEquipment({ id: 'new', kind: 'board', dailyPrice: 1, hourlyPrice: Number.MAX_SAFE_INTEGER });
+  for (const operation of ['quote', 'book']) {
+    assert.throws(() => service[operation]({ ...hourlyRequest(), itemId: 'new' }));
+  }
+});
+
+test('hourly periods reject partial hours and preserve daily period rules', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 1000, hourlyPrice: 100 });
+  for (const rental of [
+    hourlyRequest('2026-06-10T13:30:00Z'),
+    hourlyRequest('2026-06-10T13:00:01Z'),
+    hourlyRequest('2026-06-10T13:00:00.001Z'),
+    hourlyRequest('2026-06-10T24:00:00Z'),
+    hourlyRequest('2026-02-30T13:00:00Z', '2026-03-01T16:00:00Z'),
+    hourlyRequest('2026-06-10T13:00:00Z', '2026-06-11T13:00:00Z'),
+    hourlyRequest('2026-06-10T13:00:00Z', '2026-06-11T14:00:00Z'),
+    hourlyRequest('2026-06-10T16:00:00Z', '2026-06-10T13:00:00Z'),
+    hourlyRequest('2026-06-10T13:00:00Z', '2026-06-10T13:00:00Z'),
+  ]) {
+    for (const operation of ['quote', 'book', 'availability']) {
+      assert.throws(() => service[operation](rental));
+    }
+  }
+  assert.equal(service.quote(request('2026-06-10', '2026-06-11')).total, 1000);
+  assert.equal(service.quote(request('2026-06-10', '2026-06-13')).total, 2700);
+});
+
+test('hourly availability and bookings respect hourly and daily overlaps and adjacency', () => {
+  const service = setup();
+  service.addEquipment({ id: 'hourly', kind: 'board', dailyPrice: 1000, hourlyPrice: 200 });
+  const rental = { ...hourlyRequest(), itemId: 'hourly' };
+  assert.deepEqual(service.availability(rental), ['hourly']);
+  service.book(rental);
+  assert.deepEqual(service.availability(rental), []);
+  assert.equal(service.quote(rental).total, 600);
+  assert.throws(() => service.book(rental));
+  assert.throws(() => service.book(request('2026-06-10', '2026-06-11', 'hourly')));
+  for (const [start, end] of [
+    ['2026-06-10T12:00Z', '2026-06-10T13:00Z'],
+    ['2026-06-10T16:00Z', '2026-06-10T17:00Z'],
+  ]) {
+    assert.deepEqual(service.availability({ start, end, kind: 'board' }), ['hourly']);
+    service.book({ itemId: 'hourly', start, end });
+  }
+  service.book(request('2026-06-11', '2026-06-12', 'hourly'));
+  const duringDay = { ...hourlyRequest('2026-06-11T10:00Z', '2026-06-11T11:00Z'), itemId: 'hourly' };
+  assert.deepEqual(service.availability(duringDay), []);
+  assert.throws(() => service.book(duringDay));
+});
+
 test('quotes whole days in cents, including leap days and year boundaries', () => {
   const service = setup();
   assert.deepEqual(service.quote(request()), { ...request(), total: 5002 });
