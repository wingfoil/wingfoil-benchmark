diff --git a/test/rental.test.mjs b/test/rental.test.mjs
index 9a8786b649b3586d425c34d4661ff109545e676f..5bd9d53c0528f09cd2132c9636f0f887cb8a0155 100644
--- a/test/rental.test.mjs
+++ b/test/rental.test.mjs
@@ -92,3 +92,49 @@ test('caller mutations cannot change inventory or reserved periods', () => {
   booking.end = '2026-06-11T00:00:00Z';
   assert.throws(() => service.book(request()));
 });
+
+test('availability filters by kind and sorts IDs without reserving equipment', () => {
+  const service = setup();
+  service.addEquipment({ id: 'a-sail', kind: 'sail', dailyPrice: 0 });
+  service.addEquipment({ id: 'z-board', kind: 'board', dailyPrice: Number.MAX_SAFE_INTEGER });
+  const { start, end } = request();
+  assert.deepEqual(service.availability({ start, end }), ['a-sail', 'board', 'sail', 'z-board']);
+  assert.deepEqual(service.availability({ start, end, kind: 'board' }), ['board', 'z-board']);
+  assert.deepEqual(service.availability({ start, end, kind: 'sail' }), ['a-sail', 'sail']);
+  const result = service.availability({ start, end });
+  result.length = 0;
+  assert.equal(service.book(request()).id, '1');
+  assert.deepEqual(service.availability({ start, end }), ['a-sail', 'sail', 'z-board']);
+});
+
+test('availability excludes every overlap and allows adjacent periods', () => {
+  const service = setup();
+  service.book({ itemId: 'board', start: '2026-06-10T00:00:00+00:00', end: '2026-06-12T00:00Z' });
+  for (const [start, end] of [
+    ['2026-06-10', '2026-06-12'], ['2026-06-10', '2026-06-11'],
+    ['2026-06-09', '2026-06-11'], ['2026-06-11', '2026-06-13'],
+    ['2026-06-09', '2026-06-13'],
+  ]) {
+    assert.deepEqual(service.availability(request(start, end)), ['sail']);
+    assert.deepEqual(service.availability({ ...request(start, end), kind: 'board' }), []);
+  }
+  for (const [start, end] of [
+    ['2026-06-09', '2026-06-10'], ['2026-06-12', '2026-06-13'],
+  ]) assert.deepEqual(service.availability(request(start, end)), ['board', 'sail']);
+  assert.deepEqual(createRentalService().availability(request()), []);
+});
+
+test('availability validates periods and kinds even with no matching equipment', () => {
+  const service = createRentalService();
+  for (const query of [
+    request('2026-06-10', '2026-06-10'),
+    request('2026-06-12', '2026-06-10'),
+    request('2026-02-30', '2026-03-03'),
+    ...['bad', '2026-06-10', '2026-06-10T00:00:00',
+      '2026-06-10T01:00:00Z', '2026-06-10T00:00:00.001Z',
+      '2026-06-10T00:00:00+01:00'].flatMap(date => [
+        { ...request(), start: date }, { ...request(), end: date },
+      ]),
+    ...['other', '', null].map(kind => ({ ...request(), kind })),
+  ]) assert.throws(() => service.availability(query));
+});
