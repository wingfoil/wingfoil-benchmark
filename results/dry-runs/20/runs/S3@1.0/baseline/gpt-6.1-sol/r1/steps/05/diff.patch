diff --git a/test/rental.test.mjs b/test/rental.test.mjs
index 520bfbcf6ec2b8cec8991303f498bf4e18a39e08..21fc42709629bec0e96c2f213c8df1398f5daa52 100644
--- a/test/rental.test.mjs
+++ b/test/rental.test.mjs
@@ -248,3 +248,74 @@ test('availability validates periods and kinds even with no matching equipment',
     ...['other', '', null].map(kind => ({ ...request(), kind })),
   ]) assert.throws(() => service.availability(query));
 });
+
+test('cancellation refunds the booked total at the exact 24-hour cutoff', () => {
+  for (const [at, fullRefund] of [
+    ['2026-06-08T23:59:59.999Z', true],
+    ['2026-06-09T00:00:00+00:00', true],
+    ['2026-06-09T00:00:00.001Z', false],
+    ['2026-06-09T12:30Z', false],
+    ['2026-06-10T00:00:00Z', false],
+    ['2026-06-15T00:00:00Z', false],
+  ]) {
+    const service = setup();
+    const booking = service.book(request('2026-06-10', '2026-06-13'));
+    assert.deepEqual(service.cancel(booking.id, at), {
+      bookingId: booking.id, refund: fullRefund ? 6753 : 0,
+    });
+    assert.deepEqual(service.availability(request()), ['board', 'sail']);
+    assert.throws(() => service.cancel(booking.id, at), /already cancelled/);
+    const replacement = service.book(request('2026-06-10', '2026-06-13'));
+    assert.notEqual(replacement.id, booking.id);
+    assert.throws(() => service.book(request()));
+  }
+});
+
+test('hourly cancellations use the actual start instant and release only that booking', () => {
+  for (const [at, refund] of [
+    ['2026-06-09T13:00Z', 1503],
+    ['2026-06-09T13:00:00.001Z', 0],
+  ]) {
+    const service = createRentalService();
+    service.addEquipment({ id: 'board', kind: 'board', dailyPrice: 1000, hourlyPrice: 501 });
+    const booking = service.book(hourlyRequest());
+    const adjacent = hourlyRequest('2026-06-10T16:00Z', '2026-06-10T17:00Z');
+    service.book(adjacent);
+    assert.deepEqual(service.cancel(booking.id, at), { bookingId: booking.id, refund });
+    assert.deepEqual(service.availability(hourlyRequest()), ['board']);
+    assert.deepEqual(service.availability(adjacent), []);
+    service.book(hourlyRequest());
+  }
+});
+
+test('invalid cancellations leave the booking reserved and cancellable', () => {
+  const service = setup();
+  const booking = service.book(request());
+  assert.throws(() => service.cancel('missing', '2026-06-08T00:00Z'), /Unknown booking/);
+  assert.throws(() => setup().cancel(booking.id, '2026-06-08T00:00Z'), /Unknown booking/);
+  for (const at of [undefined, null, 0, '', 'bad', '2026-06-08',
+    '2026-06-08T00:00:00', '2026-06-08T00:00:00+01:00',
+    '2026-02-30T00:00:00Z', '2026-06-08T24:00:00Z',
+    '2026-06-08T00:60:00Z', '2026-06-08T00:00:60Z']) {
+    assert.throws(() => service.cancel(booking.id, at));
+    assert.throws(() => service.book(request()));
+    assert.deepEqual(service.availability(request()), ['sail']);
+  }
+  assert.equal(service.cancel(booking.id, '2026-06-08T00:00Z').refund, 5002);
+});
+
+test('cancellation retains the stored price and start despite caller mutations', () => {
+  const service = setup();
+  const rental = request();
+  const booking = service.book(rental);
+  const id = booking.id;
+  rental.start = '2026-06-20T00:00:00Z';
+  booking.start = rental.start;
+  booking.total = 0;
+  booking.id = 'changed';
+  assert.deepEqual(service.cancel(id, '2026-06-09T00:00Z'), { bookingId: id, refund: 5002 });
+  service.addEquipment({ id: 'free', kind: 'board', dailyPrice: 0 });
+  const free = service.book(request('2026-06-10', '2026-06-12', 'free'));
+  assert.deepEqual(service.cancel(free.id, '2026-06-08T00:00Z'), { bookingId: free.id, refund: 0 });
+  assert.throws(() => service.cancel(free.id, '2026-06-08T00:00Z'), /already cancelled/);
+});
