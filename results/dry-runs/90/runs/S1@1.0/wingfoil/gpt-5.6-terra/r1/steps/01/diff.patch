+++ b/src/index.ts
@@ -0,0 +1,62 @@
+/**
+ * Resolves an RFC 6901 JSON Pointer against a JSON document.
+ *
+ * @param document The JSON document to traverse.
+ * @param pointer The JSON Pointer identifying a value in the document.
+ * @returns The value identified by `pointer`.
+ * @throws {TypeError} If `pointer` is not a valid JSON Pointer.
+ * @throws {Error} If `pointer` does not identify a value in `document`.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new TypeError("A JSON Pointer must be a string.");
+  }
+
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new TypeError("A non-empty JSON Pointer must start with '/'.");
+  }
+
+  let value = document;
+
+  for (const token of pointer.slice(1).split("/")) {
+    const referenceToken = decodeReferenceToken(token);
+
+    if (Array.isArray(value)) {
+      if (!isArrayIndex(referenceToken)) {
+        throw new Error(`JSON Pointer does not resolve: invalid array index '${referenceToken}'.`);
+      }
+
+      value = value[Number(referenceToken)];
+    } else if (value !== null && typeof value === "object") {
+      if (!Object.prototype.hasOwnProperty.call(value, referenceToken)) {
+        throw new Error(`JSON Pointer does not resolve: missing member '${referenceToken}'.`);
+      }
+
+      value = (value as Record<string, unknown>)[referenceToken];
+    } else {
+      throw new Error("JSON Pointer does not resolve: encountered a non-container value.");
+    }
+
+    if (value === undefined) {
+      throw new Error("JSON Pointer does not resolve to a value.");
+    }
+  }
+
+  return value;
+}
+
+function decodeReferenceToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new TypeError(`Invalid JSON Pointer escape in reference token '${token}'.`);
+  }
+
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function isArrayIndex(token: string): boolean {
+  return /^(?:0|[1-9][0-9]*)$/.test(token);
+}
diff --git a/test/index.test.mts b/test/index.test.mts
new file mode 100644
index 0000000000000000000000000000000000000000..afb807a64ef51ab909c474f1215d1563e91f587b
--- /dev/null
+++ b/test/index.test.mts
@@ -0,0 +1,43 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { resolvePointer } from "../src/index.ts";
+
+const document = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  "k\"l": 6,
+  " ": 7,
+  "m~n": 8,
+};
+
+test("resolves the root document with an empty pointer", () => {
+  assert.strictEqual(resolvePointer(document, ""), document);
+});
+
+test("resolves object members and array elements", () => {
+  assert.equal(resolvePointer(document, "/foo/0"), "bar");
+  assert.equal(resolvePointer(document, "/foo/1"), "baz");
+  assert.equal(resolvePointer(document, "/"), 0);
+});
+
+test("decodes escaped reference tokens according to RFC 6901", () => {
+  assert.equal(resolvePointer(document, "/a~1b"), 1);
+  assert.equal(resolvePointer(document, "/m~0n"), 8);
+  assert.equal(resolvePointer({ "~1": "value" }, "/~01"), "value");
+});
+
+test("rejects malformed pointers and unresolved references", () => {
+  for (const pointer of ["foo", "/m~2n", "/m~", "/foo/01", "/foo/-", "/foo/2", "/missing"]) {
+    assert.throws(() => resolvePointer(document, pointer));
+  }
+});
+
+test("does not resolve inherited object properties", () => {
+  assert.throws(() => resolvePointer({}, "/toString"));
+});
