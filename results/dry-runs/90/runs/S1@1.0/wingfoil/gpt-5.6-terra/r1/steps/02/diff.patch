+---
+id: task-002-implement-json-patch
+type: task
+title: "Implement JSON Patch"
+status: approved
+format: 1
+---
+
+Implement RFC 6902 JSON Patch support in the public TypeScript API.
+
+Export `applyPatch(document, patch)` from `src/index.ts`. It must apply the six standard operations
+(`add`, `remove`, `replace`, `move`, `copy`, and `test`) without mutating the input document, and
+throw for malformed patches or failed operations. Cover normal behavior, pointer escaping and
+boundary/error cases with deterministic automated tests.
diff --git a/src/index.ts b/src/index.ts
index f9497a003c1dfd9f845f440d635f8c2a269f5786..9a2292b293764f89a2db5b4c53ae879a32ff54de 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -49,6 +49,245 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
   return value;
 }
 
+type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
+type JsonObject = { [key: string]: JsonValue };
+
+/**
+ * Applies an RFC 6902 JSON Patch to a JSON document without changing either input.
+ *
+ * @param document The JSON document to patch.
+ * @param patch The array of JSON Patch operation objects.
+ * @returns A new JSON document containing the result of applying every operation.
+ * @throws {TypeError} If the document or patch is not valid JSON Patch input.
+ * @throws {Error} If an operation cannot be applied.
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  if (!isJsonValue(document)) {
+    throw new TypeError("A JSON Patch document must be a JSON value.");
+  }
+  if (!Array.isArray(patch)) {
+    throw new TypeError("A JSON Patch must be an array of operations.");
+  }
+
+  let result: JsonValue | undefined = cloneJson(document);
+
+  for (const operation of patch) {
+    result = applyOperation(result, operation);
+  }
+
+  return result;
+}
+
+function applyOperation(document: JsonValue | undefined, operation: unknown): JsonValue | undefined {
+  if (!isRecord(operation) || !hasOwn(operation, "op") || typeof operation.op !== "string") {
+    throw new TypeError("A JSON Patch operation must have a string 'op' member.");
+  }
+  if (!hasOwn(operation, "path") || typeof operation.path !== "string") {
+    throw new TypeError("A JSON Patch operation must have a string 'path' member.");
+  }
+
+  const path = parsePointer(operation.path);
+
+  switch (operation.op) {
+    case "add":
+      return add(document, path, operationValue(operation));
+    case "remove":
+      return remove(document, path);
+    case "replace":
+      return replace(document, path, operationValue(operation));
+    case "move": {
+      const from = operationFrom(operation);
+      if (isProperPrefix(from, path)) {
+        throw new Error("A JSON Patch move destination cannot be a child of its source.");
+      }
+      const value = get(document, from);
+      return add(remove(document, from), path, value);
+    }
+    case "copy":
+      return add(document, path, cloneJson(get(document, operationFrom(operation))));
+    case "test":
+      if (!jsonEqual(get(document, path), operationValue(operation))) {
+        throw new Error("JSON Patch test operation failed.");
+      }
+      return document;
+    default:
+      throw new TypeError(`Unsupported JSON Patch operation '${operation.op}'.`);
+  }
+}
+
+function operationValue(operation: Record<string, unknown>): JsonValue {
+  if (!hasOwn(operation, "value") || !isJsonValue(operation.value)) {
+    throw new TypeError("This JSON Patch operation must have a JSON 'value' member.");
+  }
+  return cloneJson(operation.value);
+}
+
+function operationFrom(operation: Record<string, unknown>): string[] {
+  if (!hasOwn(operation, "from") || typeof operation.from !== "string") {
+    throw new TypeError("This JSON Patch operation must have a string 'from' member.");
+  }
+  return parsePointer(operation.from);
+}
+
+function parsePointer(pointer: string): string[] {
+  if (pointer === "") {
+    return [];
+  }
+  if (!pointer.startsWith("/")) {
+    throw new TypeError("A non-empty JSON Pointer must start with '/'.");
+  }
+  return pointer.slice(1).split("/").map(decodeReferenceToken);
+}
+
+function add(document: JsonValue | undefined, path: string[], value: JsonValue): JsonValue {
+  if (path.length === 0) {
+    return value;
+  }
+
+  const [container, token] = getParent(document, path);
+  if (Array.isArray(container)) {
+    if (token === "-") {
+      container.push(value);
+    } else {
+      const index = arrayIndex(token, container.length, true);
+      container.splice(index, 0, value);
+    }
+  } else {
+    setMember(container, token, value);
+  }
+  return document as JsonValue;
+}
+
+function remove(document: JsonValue | undefined, path: string[]): JsonValue | undefined {
+  if (path.length === 0) {
+    return undefined;
+  }
+
+  const [container, token] = getParent(document, path);
+  if (Array.isArray(container)) {
+    container.splice(arrayIndex(token, container.length, false), 1);
+  } else {
+    if (!hasOwn(container, token)) {
+      throw new Error(`JSON Patch target does not exist: '${token}'.`);
+    }
+    delete container[token];
+  }
+  return document;
+}
+
+function replace(document: JsonValue | undefined, path: string[], value: JsonValue): JsonValue {
+  if (path.length === 0) {
+    return value;
+  }
+
+  const [container, token] = getParent(document, path);
+  if (Array.isArray(container)) {
+    container[arrayIndex(token, container.length, false)] = value;
+  } else {
+    if (!hasOwn(container, token)) {
+      throw new Error(`JSON Patch target does not exist: '${token}'.`);
+    }
+    setMember(container, token, value);
+  }
+  return document as JsonValue;
+}
+
+function get(document: JsonValue | undefined, path: string[]): JsonValue {
+  let value = document;
+  for (const token of path) {
+    if (Array.isArray(value)) {
+      value = value[arrayIndex(token, value.length, false)];
+    } else if (isRecord(value) && hasOwn(value, token)) {
+      value = value[token] as JsonValue;
+    } else {
+      throw new Error(`JSON Patch target does not exist: '${token}'.`);
+    }
+  }
+  if (value === undefined) {
+    throw new Error("JSON Patch target does not exist.");
+  }
+  return value;
+}
+
+function getParent(document: JsonValue | undefined, path: string[]): [JsonValue[] | JsonObject, string] {
+  const token = path[path.length - 1];
+  const parent = get(document, path.slice(0, -1));
+  if (!Array.isArray(parent) && !isRecord(parent)) {
+    throw new Error("JSON Patch target parent is not a container.");
+  }
+  return [parent, token];
+}
+
+function arrayIndex(token: string, length: number, allowEnd: boolean): number {
+  if (!/^(?:0|[1-9][0-9]*)$/.test(token)) {
+    throw new Error(`Invalid JSON Patch array index '${token}'.`);
+  }
+  const index = Number(token);
+  if (index > length || (!allowEnd && index === length)) {
+    throw new Error(`JSON Patch array index is out of bounds: '${token}'.`);
+  }
+  return index;
+}
+
+function isProperPrefix(prefix: string[], value: string[]): boolean {
+  return prefix.length < value.length && prefix.every((token, index) => token === value[index]);
+}
+
+function setMember(object: JsonObject, key: string, value: JsonValue): void {
+  Object.defineProperty(object, key, { configurable: true, enumerable: true, value, writable: true });
+}
+
+function cloneJson(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map(cloneJson);
+  }
+  if (isRecord(value)) {
+    const clone: JsonObject = {};
+    for (const key of Object.keys(value)) {
+      setMember(clone, key, cloneJson(value[key] as JsonValue));
+    }
+    return clone;
+  }
+  return value;
+}
+
+function jsonEqual(left: JsonValue, right: JsonValue): boolean {
+  if (left === right) {
+    return true;
+  }
+  if (Array.isArray(left) && Array.isArray(right)) {
+    return left.length === right.length && left.every((value, index) => jsonEqual(value, right[index]));
+  }
+  if (isRecord(left) && isRecord(right)) {
+    const leftKeys = Object.keys(left);
+    const rightKeys = Object.keys(right);
+    return leftKeys.length === rightKeys.length
+      && leftKeys.every((key) => hasOwn(right, key) && jsonEqual(left[key] as JsonValue, right[key] as JsonValue));
+  }
+  return false;
+}
+
+function isJsonValue(value: unknown): value is JsonValue {
+  if (value === null || typeof value === "string" || typeof value === "boolean") {
+    return true;
+  }
+  if (typeof value === "number") {
+    return Number.isFinite(value);
+  }
+  if (Array.isArray(value)) {
+    return value.every(isJsonValue);
+  }
+  return isRecord(value) && Object.values(value).every(isJsonValue);
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function hasOwn(object: object, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(object, key);
+}
+
 function decodeReferenceToken(token: string): string {
   if (/~(?![01])/.test(token)) {
     throw new TypeError(`Invalid JSON Pointer escape in reference token '${token}'.`);
