+/**
+ * Creates an RFC 6902 JSON Patch that transforms one JSON document into another.
+ *
+ * The generated patch uses member-level operations for objects and edit operations for arrays so
+ * unchanged portions of a document are not included in the patch. Neither input is modified.
+ *
+ * @param from The JSON document to transform.
+ * @param to The desired JSON document.
+ * @returns A JSON Patch array which transforms `from` into `to`.
+ * @throws {TypeError} If either input is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): JsonObject[] {
+  if (!isJsonValue(from) || !isJsonValue(to)) {
+    throw new TypeError("JSON Patch source and target must be JSON values.");
+  }
+
+  const patch: JsonObject[] = [];
+  createPatchAt(from, to, [], patch);
+  return patch;
+}
+
+function createPatchAt(from: JsonValue, to: JsonValue, path: string[], patch: JsonObject[]): void {
+  if (jsonEqual(from, to)) {
+    return;
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    const fromKeys = Object.keys(from).sort();
+    const toKeys = Object.keys(to).sort();
+
+    for (const key of fromKeys) {
+      if (!hasOwn(to, key)) {
+        patch.push({ op: "remove", path: pointer(path, key) });
+      }
+    }
+    for (const key of fromKeys) {
+      if (hasOwn(to, key)) {
+        createPatchAt(from[key] as JsonValue, to[key] as JsonValue, [...path, key], patch);
+      }
+    }
+    for (const key of toKeys) {
+      if (!hasOwn(from, key)) {
+        patch.push({ op: "add", path: pointer(path, key), value: cloneJson(to[key] as JsonValue) });
+      }
+    }
+    return;
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    createArrayPatch(from, to, path, patch);
+    return;
+  }
+
+  patch.push({ op: "replace", path: pointer(path), value: cloneJson(to) });
+}
+
+function createArrayPatch(from: JsonValue[], to: JsonValue[], path: string[], patch: JsonObject[]): void {
+  const indexedPatch: JsonObject[] = [];
+  createIndexedArrayPatch(from, to, path, indexedPatch);
+  const editPatch: JsonObject[] = [];
+  createArrayEditPatch(from, to, path, editPatch);
+
+  patch.push(...(editPatch.length < indexedPatch.length ? editPatch : indexedPatch));
+}
+
+function createIndexedArrayPatch(from: JsonValue[], to: JsonValue[], path: string[], patch: JsonObject[]): void {
+  const sharedLength = Math.min(from.length, to.length);
+  for (let index = 0; index < sharedLength; index += 1) {
+    createPatchAt(from[index], to[index], [...path, String(index)], patch);
+  }
+
+  for (let index = from.length - 1; index >= to.length; index -= 1) {
+    patch.push({ op: "remove", path: pointer(path, String(index)) });
+  }
+  for (let index = from.length; index < to.length; index += 1) {
+    patch.push({ op: "add", path: pointer(path, String(index)), value: cloneJson(to[index]) });
+  }
+}
+
+function createArrayEditPatch(from: JsonValue[], to: JsonValue[], path: string[], patch: JsonObject[]): void {
+  const matches = longestCommonSubsequence(from, to);
+  let fromIndex = 0;
+  let toIndex = 0;
+  let resultIndex = 0;
+
+  for (const [matchingFrom, matchingTo] of matches) {
+    while (fromIndex < matchingFrom) {
+      patch.push({ op: "remove", path: pointer(path, String(resultIndex)) });
+      fromIndex += 1;
+    }
+    while (toIndex < matchingTo) {
+      patch.push({ op: "add", path: pointer(path, String(resultIndex)), value: cloneJson(to[toIndex]) });
+      toIndex += 1;
+      resultIndex += 1;
+    }
+    fromIndex += 1;
+    toIndex += 1;
+    resultIndex += 1;
+  }
+
+  while (fromIndex < from.length) {
+    patch.push({ op: "remove", path: pointer(path, String(resultIndex)) });
+    fromIndex += 1;
+  }
+  while (toIndex < to.length) {
+    patch.push({ op: "add", path: pointer(path, String(resultIndex)), value: cloneJson(to[toIndex]) });
+    toIndex += 1;
+    resultIndex += 1;
+  }
+}
+
+function longestCommonSubsequence(left: JsonValue[], right: JsonValue[]): Array<[number, number]> {
+  const lengths = Array.from({ length: left.length + 1 }, () => Array<number>(right.length + 1).fill(0));
+
+  for (let leftIndex = left.length - 1; leftIndex >= 0; leftIndex -= 1) {
+    for (let rightIndex = right.length - 1; rightIndex >= 0; rightIndex -= 1) {
+      lengths[leftIndex][rightIndex] = jsonEqual(left[leftIndex], right[rightIndex])
+        ? lengths[leftIndex + 1][rightIndex + 1] + 1
+        : Math.max(lengths[leftIndex + 1][rightIndex], lengths[leftIndex][rightIndex + 1]);
+    }
+  }
+
+  const matches: Array<[number, number]> = [];
+  let leftIndex = 0;
+  let rightIndex = 0;
+  while (leftIndex < left.length && rightIndex < right.length) {
+    if (jsonEqual(left[leftIndex], right[rightIndex])) {
+      matches.push([leftIndex, rightIndex]);
+      leftIndex += 1;
+      rightIndex += 1;
+    } else if (lengths[leftIndex + 1][rightIndex] >= lengths[leftIndex][rightIndex + 1]) {
+      leftIndex += 1;
+    } else {
+      rightIndex += 1;
+    }
+  }
+  return matches;
+}
+
+function pointer(path: string[], token?: string): string {
+  const tokens = token === undefined ? path : [...path, token];
+  return tokens.map((part) => `/${part.replace(/~/g, "~0").replace(/\//g, "~1")}`).join("");
+}
