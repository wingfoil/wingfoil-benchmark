+test("creates a granular JSON Patch without mutating either input", () => {
+  const from = {
+    unchanged: { nested: true },
+    changed: { before: 1, remove: true },
+    "a/b": "old",
+    list: ["one", "two", "three"],
+  };
+  const to = {
+    unchanged: { nested: true },
+    changed: { before: 2, add: true },
+    "a/b": "new",
+    list: ["zero", "one", "two", "three"],
+  };
+
+  const patch = createPatch(from, to);
+
+  assert.deepEqual(patch, [
+    { op: "replace", path: "/a~1b", value: "new" },
+    { op: "remove", path: "/changed/remove" },
+    { op: "replace", path: "/changed/before", value: 2 },
+    { op: "add", path: "/changed/add", value: true },
+    { op: "add", path: "/list/0", value: "zero" },
+  ]);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.deepEqual(from, {
+    unchanged: { nested: true },
+    changed: { before: 1, remove: true },
+    "a/b": "old",
+    list: ["one", "two", "three"],
+  });
+  assert.deepEqual(to, {
+    unchanged: { nested: true },
+    changed: { before: 2, add: true },
+    "a/b": "new",
+    list: ["zero", "one", "two", "three"],
+  });
+});
+
+test("creates no operations for equal JSON and uses local array edits", () => {
+  assert.deepEqual(createPatch({ nested: [1, 2] }, { nested: [1, 2] }), []);
+  assert.deepEqual(createPatch(["a", "b", "c"], ["b", "c", "d"]), [
+    { op: "remove", path: "/0" },
+    { op: "add", path: "/2", value: "d" },
+  ]);
+  assert.deepEqual(createPatch([{ value: 1 }], [{ value: 2 }]), [
+    { op: "replace", path: "/0/value", value: 2 },
+  ]);
+});
+
+test("creates a root replacement and rejects non-JSON documents", () => {
+  const to = { value: [1] };
+  const patch = createPatch(null, to);
+
+  assert.deepEqual(patch, [{ op: "replace", path: "", value: to }]);
+  assert.deepEqual(applyPatch(null, patch), to);
+  assert.throws(() => createPatch(new Date(), {}));
+  assert.throws(() => createPatch({}, Number.NaN));
+});
+
