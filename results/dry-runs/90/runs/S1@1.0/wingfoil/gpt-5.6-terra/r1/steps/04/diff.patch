 import assert from "node:assert/strict";
 import test from "node:test";
 
-import { applyPatch, resolvePointer } from "../src/index.ts";
+import { applyMergePatch, applyPatch, resolvePointer } from "../src/index.ts";
 
 const document = {
   foo: ["bar", "baz"],
@@ -125,3 +125,45 @@ test("rejects malformed patches and invalid operation targets", () => {
     assert.throws(() => applyPatch({ a: { b: 1 }, items: [] }, patch));
   }
 });
+
+test("applies an RFC 7386 merge patch without mutating either input", () => {
+  const target = {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  };
+  const patch = {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  };
+
+  assert.deepEqual(applyMergePatch(target, patch), {
+    title: "Hello!",
+    author: { givenName: "John" },
+    tags: ["example"],
+    content: "This will be unchanged",
+    phoneNumber: "+01-123-456-7890",
+  });
+  assert.deepEqual(target, {
+    title: "Goodbye!",
+    author: { givenName: "John", familyName: "Doe" },
+    tags: ["example", "sample"],
+    content: "This will be unchanged",
+  });
+  assert.deepEqual(patch, {
+    title: "Hello!",
+    phoneNumber: "+01-123-456-7890",
+    author: { familyName: null },
+    tags: ["example"],
+  });
+});
+
+test("replaces non-object targets and patches, while null members remove only object keys", () => {
+  assert.deepEqual(applyMergePatch(["a", "b"], { value: 1 }), { value: 1 });
+  assert.deepEqual(applyMergePatch({ value: 1 }, ["a", "b"]), ["a", "b"]);
+  assert.equal(applyMergePatch({ value: 1 }, null), null);
+  assert.deepEqual(applyMergePatch({ value: null, keep: true }, { value: null }), { keep: true });
+});
