@@ -52,6 +52,25 @@ export function resolvePointer(document: unknown, pointer: string): unknown {
 type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
 type JsonObject = { [key: string]: JsonValue };
 
+/**
+ * Applies an RFC 7386 JSON Merge Patch without changing either input.
+ *
+ * Object patch members replace or recursively merge matching target members; members with a `null`
+ * value are removed. Any non-object patch replaces the target entirely.
+ *
+ * @param target The JSON document to update.
+ * @param patch The JSON Merge Patch document to apply.
+ * @returns A new JSON document containing the merged result.
+ * @throws {TypeError} If either input is not a JSON value.
+ */
+export function applyMergePatch(target: unknown, patch: unknown): unknown {
+  if (!isJsonValue(target) || !isJsonValue(patch)) {
+    throw new TypeError("A JSON Merge Patch target and patch must be JSON values.");
+  }
+
+  return mergePatch(target, patch);
+}
+
 /**
  * Applies an RFC 6902 JSON Patch to a JSON document without changing either input.
  *
@@ -78,6 +97,24 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   return result;
 }
 
+function mergePatch(target: JsonValue | undefined, patch: JsonValue): JsonValue {
+  if (!isJsonObject(patch)) {
+    return cloneJson(patch);
+  }
+
+  const result = isJsonObject(target) ? cloneJson(target) : {};
+  for (const key of Object.keys(patch)) {
+    const value = patch[key] as JsonValue;
+    if (value === null) {
+      delete result[key];
+    } else {
+      const current = hasOwn(result, key) ? result[key] : undefined;
+      setMember(result, key, mergePatch(current, value));
+    }
+  }
+  return result;
+}
