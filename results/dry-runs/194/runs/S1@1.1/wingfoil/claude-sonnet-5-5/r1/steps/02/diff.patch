@@ -0,0 +1,89 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "./index.ts";
+
+const ap = (d: unknown, p: unknown) => applyPatch(d, p);
+
+test("RFC 6902 add examples", () => {
+  assert.deepEqual(ap({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), { foo: "bar", baz: "qux" });
+  assert.deepEqual(ap({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), { foo: ["bar", "qux", "baz"] });
+  assert.deepEqual(ap({ foo: [1] }, [{ op: "add", path: "/foo/-", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(ap({ foo: [1] }, [{ op: "add", path: "/foo/1", value: 2 }]), { foo: [1, 2] });
+  assert.deepEqual(ap({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.throws(() => ap({ foo: [1] }, [{ op: "add", path: "/foo/2", value: 2 }]));
+  assert.throws(() => ap({ foo: [1] }, [{ op: "add", path: "/foo/01", value: 2 }]));
+  assert.throws(() => ap({ foo: "bar" }, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.throws(() => ap({ foo: "bar" }, [{ op: "add", path: "/foo/b", value: 1 }]));
+});
+
+test("remove / replace", () => {
+  assert.deepEqual(ap({ a: 1, b: 2 }, [{ op: "remove", path: "/a" }]), { b: 2 });
+  assert.deepEqual(ap([1, 2, 3], [{ op: "remove", path: "/1" }]), [1, 3]);
+  assert.throws(() => ap({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => ap([1], [{ op: "remove", path: "/-" }]));
+  assert.throws(() => ap({}, [{ op: "remove", path: "" }]));
+  assert.deepEqual(ap({ a: 1 }, [{ op: "replace", path: "/a", value: null }]), { a: null });
+  assert.deepEqual(ap([1, 2], [{ op: "replace", path: "/1", value: 9 }]), [1, 9]);
+  assert.deepEqual(ap({ a: 1 }, [{ op: "replace", path: "", value: 5 }]), 5);
+  assert.throws(() => ap({}, [{ op: "replace", path: "/a", value: 1 }]));
+});
+
+test("move / copy", () => {
+  assert.deepEqual(ap({ foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } },
+    [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]),
+    { foo: { bar: "baz" }, qux: { corge: "grault", thud: "fred" } });
+  assert.deepEqual(ap({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]),
+    { foo: ["all", "cows", "eat", "grass"] });
+  assert.deepEqual(ap({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.throws(() => ap({ a: {} }, [{ op: "move", from: "/a", path: "/a/b" }]));
+  assert.throws(() => ap({}, [{ op: "move", from: "/a", path: "/b" }]));
+  const src = { a: { x: [1] } };
+  const out = ap(src, [{ op: "copy", from: "/a", path: "/b" }]) as any;
+  out.b.x.push(2);
+  assert.deepEqual(out.a.x, [1]);
+  assert.throws(() => ap({}, [{ op: "copy", from: "/a", path: "/b" }]));
+});
+
+test("test", () => {
+  const d = { a: { x: 1, y: [1, { z: null }] }, n: 1 };
+  assert.deepEqual(ap(d, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }]), d);
+  assert.throws(() => ap(d, [{ op: "test", path: "/n", value: "1" }]));
+  assert.throws(() => ap(d, [{ op: "test", path: "/a/y", value: [{ z: null }, 1] }]));
+  assert.throws(() => ap(d, [{ op: "test", path: "/missing", value: 1 }]));
+  assert.deepEqual(ap({ a: null }, [{ op: "test", path: "/a", value: null }]), { a: null });
+});
+
+test("does not mutate input or patch aliasing", () => {
+  const doc = { a: [1, 2], b: { c: 1 } };
+  const snap = structuredClone(doc);
+  const value = { k: [1] };
+  const out = ap(doc, [{ op: "add", path: "/a/0", value: 0 }, { op: "remove", path: "/b/c" }, { op: "add", path: "/v", value }]) as any;
+  assert.deepEqual(doc, snap);
+  out.v.k.push(2);
+  assert.deepEqual(value, { k: [1] });
+});
+
+test("atomic: failure throws", () => {
+  const doc = { a: 1 };
+  assert.throws(() => ap(doc, [{ op: "add", path: "/b", value: 1 }, { op: "test", path: "/a", value: 2 }]));
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("invalid patches", () => {
+  for (const p of [{}, null, [1], [null], [{ path: "/a" }], [{ op: "nop", path: "/a" }], [{ op: "add", path: "/a" }],
+    [{ op: "add", value: 1 }], [{ op: "remove", path: 1 }], [{ op: "move", path: "/a" }], [{ op: "copy", from: 1, path: "/a" }],
+    [{ op: "test", path: "/a" }]]) {
+    assert.throws(() => ap({ a: 1 }, p), TypeError);
+  }
+  assert.throws(() => ap({}, [{ op: "add", path: "a", value: 1 }]), SyntaxError);
+  assert.throws(() => ap({}, [{ op: "add", path: "/~2", value: 1 }]), SyntaxError);
+});
+
+test("__proto__ is plain data", () => {
+  const out = ap({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as any;
+  assert.equal(Object.getPrototypeOf(out), Object.prototype);
+  assert.equal(({} as any).polluted, undefined);
+  assert.deepEqual(Object.keys(out), ["__proto__"]);
+  assert.throws(() => ap({}, [{ op: "remove", path: "/__proto__" }]));
+  assert.throws(() => ap({}, [{ op: "add", path: "/constructor/x", value: 1 }]));
+});
