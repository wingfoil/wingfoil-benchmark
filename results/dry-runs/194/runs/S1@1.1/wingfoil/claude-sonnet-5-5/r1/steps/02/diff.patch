+/**
+ * JSON Patch (RFC 6902).
+ *
+ * Why own-property checks and defineProperty: pointers and values come from untrusted input, so
+ * `__proto__` must stay plain data and never reach or change a prototype.
+ */
+import { parsePointer } from "./pointer.ts";
+
+const OPS = ["add", "remove", "replace", "move", "copy", "test"] as const;
+
+interface Operation {
+  op: (typeof OPS)[number];
+  path: string;
+  from?: string;
+  value?: unknown;
+}
+
+const has = (o: object, k: string): boolean => Object.prototype.hasOwnProperty.call(o, k);
+const isObject = (v: unknown): v is Record<string, unknown> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+function setMember(obj: Record<string, unknown>, key: string, value: unknown): void {
+  Object.defineProperty(obj, key, { value, writable: true, enumerable: true, configurable: true });
+}
+
+/** Deep copy of a JSON value. */
+function clone(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(clone);
+  if (isObject(value)) {
+    const out: Record<string, unknown> = {};
+    for (const key of Object.keys(value)) setMember(out, key, clone(value[key]));
+    return out;
+  }
+  return value;
+}
+
+/** JSON equality: key order is irrelevant, types must match. */
+function equal(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a)) {
+    return Array.isArray(b) && a.length === b.length && a.every((x, i) => equal(x, b[i]));
+  }
+  if (isObject(a)) {
+    if (!isObject(b)) return false;
+    const keys = Object.keys(a);
+    return keys.length === Object.keys(b).length && keys.every((k) => has(b, k) && equal(a[k], b[k]));
+  }
+  return a === b;
+}
+
+function validate(patch: unknown): Operation[] {
+  if (!Array.isArray(patch)) throw new TypeError("JSON Patch must be an array");
+  patch.forEach((raw, i) => {
+    const where = `JSON Patch operation ${i}`;
+    if (!isObject(raw)) throw new TypeError(`${where} must be an object`);
+    if (typeof raw.op !== "string" || !(OPS as readonly string[]).includes(raw.op)) {
+      throw new TypeError(`${where} has an unknown "op"`);
+    }
+    if (typeof raw.path !== "string") throw new TypeError(`${where} needs a string "path"`);
+    if ((raw.op === "move" || raw.op === "copy") && typeof raw.from !== "string") {
+      throw new TypeError(`${where} needs a string "from"`);
+    }
+    if ((raw.op === "add" || raw.op === "replace" || raw.op === "test") && !has(raw, "value")) {
+      throw new TypeError(`${where} needs a "value"`);
+    }
+    if (raw.value === undefined && has(raw, "value")) throw new TypeError(`${where} has an undefined "value"`);
+  });
+  return patch as Operation[];
+}
+
+function index(token: string, length: number, allowEnd: boolean, pointer: string): number {
+  if (allowEnd && token === "-") return length;
+  const n = Number(token);
+  if (!/^(0|[1-9][0-9]*)$/.test(token) || n > length || (!allowEnd && n >= length)) {
+    throw new Error(`JSON Patch: bad array index "${token}" in "${pointer}"`);
+  }
+  return n;
+}
+
+/** Walks to the parent container of the pointer's last token. */
+function parentOf(doc: unknown, tokens: string[], pointer: string): unknown {
+  let current = doc;
+  for (const token of tokens.slice(0, -1)) {
+    if (Array.isArray(current)) current = current[index(token, current.length, false, pointer)];
+    else if (isObject(current) && has(current, token)) current = current[token];
+    else throw new Error(`JSON Patch: "${pointer}" does not resolve`);
+  }
+  return current;
+}
+
+function getAt(doc: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return doc;
+  const parent = parentOf(doc, tokens, pointer);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) return parent[index(key, parent.length, false, pointer)];
+  if (isObject(parent) && has(parent, key)) return parent[key];
+  throw new Error(`JSON Patch: "${pointer}" does not resolve`);
+}
+
+function add(doc: unknown, pointer: string, value: unknown): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) return value;
+  const parent = parentOf(doc, tokens, pointer);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(index(key, parent.length, true, pointer), 0, value);
+  else if (isObject(parent)) setMember(parent, key, value);
+  else throw new Error(`JSON Patch: "${pointer}" does not resolve`);
+  return doc;
+}
+
+function remove(doc: unknown, pointer: string): unknown {
+  const tokens = parsePointer(pointer);
+  if (tokens.length === 0) throw new Error("JSON Patch: cannot remove the whole document");
+  getAt(doc, pointer);
+  const parent = parentOf(doc, tokens, pointer);
+  const key = tokens[tokens.length - 1];
+  if (Array.isArray(parent)) parent.splice(Number(key), 1);
+  else delete (parent as Record<string, unknown>)[key];
+  return doc;
+}
+
+/**
+ * Applies a JSON Patch to `document` and returns the result; the input is never mutated.
+ *
+ * @throws TypeError if the patch is malformed, SyntaxError if a pointer is invalid, Error if an
+ *   operation fails (including a failed `test`).
+ */
+export function applyPatch(document: unknown, patch: unknown): unknown {
+  const ops = validate(patch);
+  let doc = clone(document);
+  for (const o of ops) {
+    switch (o.op) {
+      case "add":
+        doc = add(doc, o.path, clone(o.value));
+        break;
+      case "remove":
+        doc = remove(doc, o.path);
+        break;
+      case "replace":
+        getAt(doc, o.path);
+        doc = parsePointer(o.path).length === 0 ? clone(o.value) : add(remove(doc, o.path), o.path, clone(o.value));
+        break;
+      case "move": {
+        const from = parsePointer(o.from!);
+        const to = parsePointer(o.path);
+        if (from.length < to.length && from.every((t, i) => t === to[i])) {
+          throw new Error(`JSON Patch: cannot move "${o.from}" into its own child "${o.path}"`);
+        }
+        const value = getAt(doc, o.from!);
+        if (o.from !== o.path) doc = add(remove(doc, o.from!), o.path, value);
+        break;
+      }
+      case "copy":
+        doc = add(doc, o.path, clone(getAt(doc, o.from!)));
+        break;
+      case "test":
+        if (!equal(getAt(doc, o.path), o.value)) throw new Error(`JSON Patch: test failed at "${o.path}"`);
+        break;
+    }
+  }
+  return doc;
+}
