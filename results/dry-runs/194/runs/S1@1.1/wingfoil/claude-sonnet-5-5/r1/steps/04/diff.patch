+import type { JsonValue } from "./pointer.ts";
+
+const isObject = (v: unknown): v is { [k: string]: JsonValue } =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+const own = (o: object, k: string) => Object.prototype.hasOwnProperty.call(o, k);
+
+const set = (o: object, k: string, v: unknown) =>
+  Object.defineProperty(o, k, { value: v, enumerable: true, writable: true, configurable: true });
+
+// Applies a JSON Merge Patch (RFC 7386); neither input is mutated.
+export function applyMergePatch(target: unknown, patch: unknown): JsonValue {
+  if (!isObject(patch)) return structuredClone(patch) as JsonValue;
+  const result: { [k: string]: JsonValue } = {};
+  if (isObject(target)) {
+    for (const k of Object.keys(target)) set(result, k, structuredClone(target[k]));
+  }
+  for (const k of Object.keys(patch)) {
+    const v = patch[k];
+    if (v === null) delete result[k];
+    else set(result, k, applyMergePatch(own(result, k) ? result[k] : undefined, v));
+  }
+  return result;
+}
