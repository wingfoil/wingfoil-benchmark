@@ -0,0 +1,80 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "./index.ts";
+
+const roundTrip = (from: unknown, to: unknown) => {
+  const before = JSON.stringify(from);
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  assert.equal(JSON.stringify(from), before);
+  return patch;
+};
+
+test("identical values give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("small change deep inside is a single operation", () => {
+  const from = { a: { b: { c: 1, d: [1, 2] }, e: "x" }, f: 1 };
+  const to = { a: { b: { c: 2, d: [1, 2] }, e: "x" }, f: 1 };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/b/c", value: 2 }]);
+});
+
+test("object member add, remove, escaping and __proto__", () => {
+  assert.deepEqual(roundTrip({ "a/b": 1, "~": 2 }, { "~": 2, "c/d": 3 }), [
+    { op: "remove", path: "/a~1b" },
+    { op: "add", path: "/c~1d", value: 3 },
+  ]);
+  const to = JSON.parse('{"__proto__": {"x": 1}}');
+  roundTrip({}, to);
+  assert.equal(({} as any).x, undefined);
+});
+
+test("root and type changes replace", () => {
+  assert.deepEqual(roundTrip(1, { a: 1 }), [{ op: "replace", path: "", value: { a: 1 } }]);
+  roundTrip([1], { a: 1 });
+  roundTrip({ a: null }, { a: [] });
+  roundTrip(null, null);
+});
+
+test("array insert and remove touch one item", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 3, 4]), [{ op: "remove", path: "/1" }]);
+  assert.deepEqual(roundTrip([{ a: 1 }, { a: 2 }], [{ a: 0 }, { a: 1 }, { a: 2 }]), [
+    { op: "add", path: "/0", value: { a: 0 } },
+  ]);
+  assert.equal(roundTrip([1, 2, 3], [1, 2, 3, 4]).length, 1);
+  assert.equal(roundTrip([1, 2, 3], []).length, 3);
+});
+
+test("array move is at most a remove and an add", () => {
+  const from = [1, 2, 3, 4, 5, 6];
+  assert.equal(roundTrip(from, [1, 5, 2, 3, 4, 6]).length, 2);
+  assert.equal(roundTrip(from, [2, 3, 4, 5, 6, 1]).length, 2);
+});
+
+test("changed items inside arrays are diffed in depth", () => {
+  assert.deepEqual(roundTrip([{ a: 1, b: 2 }, 5], [{ a: 1, b: 3 }, 5]), [{ op: "replace", path: "/0/b", value: 3 }]);
+});
+
+test("patch shares nothing with the inputs", () => {
+  const to = { a: { b: 1 } };
+  const patch = createPatch({}, to);
+  (patch[0].value as any).b = 2;
+  assert.equal(to.a.b, 1);
+});
+
+test("random round trips", () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff), seed % n);
+  const gen = (d: number): unknown => {
+    const t = rnd(d > 2 ? 4 : 6);
+    if (t === 0) return rnd(4);
+    if (t === 1) return ["a", "b", null][rnd(3)];
+    if (t === 2) return rnd(2) === 0;
+    if (t === 3) return rnd(3);
+    if (t === 4) return Array.from({ length: rnd(6) }, () => gen(d + 1));
+    return Object.fromEntries(Array.from({ length: rnd(4) }, () => ["k" + rnd(4), gen(d + 1)]));
+  };
+  for (let i = 0; i < 500; i++) roundTrip(gen(0), gen(0));
+});
