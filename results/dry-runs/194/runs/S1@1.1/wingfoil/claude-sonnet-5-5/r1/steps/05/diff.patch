+/**
+ * JSON Patch generation (RFC 6902): the minimal-ish patch that turns one JSON value into another.
+ *
+ * Objects are compared member by member. Arrays are aligned on their longest common subsequence of
+ * deeply equal items, so an inserted or removed item yields one `add` or `remove` and a moved item a
+ * `remove` plus an `add`; items that sit between kept ones in the same place are diffed in depth.
+ * Values put in the patch are copies, so the patch shares nothing with the inputs.
+ */
+type Op = { op: "add" | "remove" | "replace"; path: string; value?: unknown };
+
+const has = (o: object, k: string): boolean => Object.prototype.hasOwnProperty.call(o, k);
+const isObject = (v: unknown): v is Record<string, unknown> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+function clone(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(clone);
+  if (isObject(value)) {
+    const out: Record<string, unknown> = {};
+    for (const k of Object.keys(value)) {
+      Object.defineProperty(out, k, { value: clone(value[k]), writable: true, enumerable: true, configurable: true });
+    }
+    return out;
+  }
+  return value;
+}
+
+function equal(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (Array.isArray(a) && Array.isArray(b)) return a.length === b.length && a.every((x, i) => equal(x, b[i]));
+  if (isObject(a) && isObject(b)) {
+    const ka = Object.keys(a);
+    return ka.length === Object.keys(b).length && ka.every((k) => has(b, k) && equal(a[k], b[k]));
+  }
+  return false;
+}
+
+const escape = (token: string): string => token.replace(/~/g, "~0").replace(/\//g, "~1");
+
+function diffValue(from: unknown, to: unknown, path: string, ops: Op[]): void {
+  if (equal(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) return diffArray(from, to, path, ops);
+  if (isObject(from) && isObject(to)) {
+    for (const k of Object.keys(from)) if (!has(to, k)) ops.push({ op: "remove", path: `${path}/${escape(k)}` });
+    for (const k of Object.keys(to)) {
+      const p = `${path}/${escape(k)}`;
+      if (has(from, k)) diffValue(from[k], to[k], p, ops);
+      else ops.push({ op: "add", path: p, value: clone(to[k]) });
+    }
+    return;
+  }
+  ops.push({ op: "replace", path, value: clone(to) });
+}
+
+function diffArray(from: unknown[], to: unknown[], path: string, ops: Op[]): void {
+  let start = 0;
+  while (start < from.length && start < to.length && equal(from[start], to[start])) start++;
+  let endF = from.length;
+  let endT = to.length;
+  while (endF > start && endT > start && equal(from[endF - 1], to[endT - 1])) {
+    endF--;
+    endT--;
+  }
+  const n = endF - start;
+  const m = endT - start;
+  // lcs[i][j]: length of the longest common subsequence of from[start+i..endF) and to[start+j..endT).
+  const lcs: Uint32Array[] = Array.from({ length: n + 1 }, () => new Uint32Array(m + 1));
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = equal(from[start + i], to[start + j])
+        ? lcs[i + 1][j + 1] + 1
+        : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
+    }
+  }
+  let pos = start; // index in the array as it stands after the operations emitted so far
+  let i = 0;
+  let j = 0;
+  while (i < n || j < m) {
+    if (i < n && j < m && equal(from[start + i], to[start + j])) {
+      i++;
+      j++;
+      pos++;
+      continue;
+    }
+    // A run of unmatched items on both sides: pair them up in place, then remove or add the rest.
+    const di = i;
+    const dj = j;
+    while (i < n || j < m) {
+      if (i < n && j < m && equal(from[start + i], to[start + j]) && lcs[i][j] === lcs[i + 1][j + 1] + 1) break;
+      if (i < n && (j === m || lcs[i + 1][j] >= lcs[i][j + 1])) i++;
+      else j++;
+    }
+    const removed = i - di;
+    const added = j - dj;
+    const paired = Math.min(removed, added);
+    for (let k = 0; k < paired; k++) diffValue(from[start + di + k], to[start + dj + k], `${path}/${pos++}`, ops);
+    for (let k = paired; k < removed; k++) ops.push({ op: "remove", path: `${path}/${pos}` });
+    for (let k = paired; k < added; k++) {
+      ops.push({ op: "add", path: `${path}/${pos++}`, value: clone(to[start + dj + k]) });
+    }
+  }
+}
+
+/** Returns a JSON Patch that turns `from` into `to`. Neither input is mutated. */
+export function createPatch(from: unknown, to: unknown): Op[] {
+  const ops: Op[] = [];
+  diffValue(from, to, "", ops);
+  return ops;
+}
