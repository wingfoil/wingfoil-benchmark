+
+test('availability lists free equipment of a kind, sorted', () => {
+  const s = setup();
+  s.addEquipment({ id: 'a1', kind: 'sail', dailyPrice: 1000 });
+  s.addEquipment({ id: 'b0', kind: 'board', dailyPrice: 2000 });
+  s.book({ itemId: 'b1', start: d('2026-07-01'), end: d('2026-07-03') });
+  const q = { start: d('2026-07-02'), end: d('2026-07-04') };
+  assert.deepEqual(s.availability(q), ['a1', 'b0']);
+  assert.deepEqual(s.availability({ ...q, kind: 'board' }), ['b0']);
+  assert.deepEqual(s.availability({ start: d('2026-07-03'), end: d('2026-07-04'), kind: 'board' }), ['b0', 'b1']);
+  assert.throws(() => s.availability({ start: d('2026-07-04'), end: d('2026-07-02') }));
+});
