diff --git a/test/rental.test.ts b/test/rental.test.ts
index a4c7ed0ab71ecdab1135c08fabda6e3fc3ae826b..b2e359337c5c24aa3285834b31e3ef5309ce0e04 100644
--- a/test/rental.test.ts
+++ b/test/rental.test.ts
@@ -55,3 +55,25 @@ test('availability lists free equipment of a kind, sorted', () => {
   assert.deepEqual(s.availability({ start: d('2026-07-03'), end: d('2026-07-04'), kind: 'board' }), ['b0', 'b1']);
   assert.throws(() => s.availability({ start: d('2026-07-04'), end: d('2026-07-02') }));
 });
+
+test('rentals shorter than a day are priced per hour', () => {
+  const s = createRentalService();
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  const r = { itemId: 'h1', start: '2026-07-01T13:00:00.000Z', end: '2026-07-01T16:00:00.000Z' };
+  assert.equal(s.quote(r).total, 1800);
+  assert.equal(s.book(r).total, 1800);
+  assert.throws(() => s.book({ ...r, start: '2026-07-01T15:00:00Z' }));
+  assert.equal(s.book({ ...r, start: r.end, end: '2026-07-01T17:00:00Z' }).total, 600);
+  // a full day is still a daily rental
+  assert.equal(s.quote({ itemId: 'h1', start: d('2026-07-02'), end: d('2026-07-03') }).total, 2500);
+});
+
+test('hourly rentals need an hourly price and whole hours', () => {
+  const s = setup();
+  const r = { itemId: 'b1', start: '2026-07-01T13:00:00Z', end: '2026-07-01T16:00:00Z' };
+  assert.throws(() => s.quote(r));
+  s.addEquipment({ id: 'h1', kind: 'board', dailyPrice: 2500, hourlyPrice: 600 });
+  assert.throws(() => s.quote({ ...r, itemId: 'h1', start: '2026-07-01T13:30:00Z' }));
+  assert.throws(() => s.quote({ ...r, itemId: 'h1', end: '2026-07-02T13:00:00Z' }));
+  assert.throws(() => s.addEquipment({ id: 'x', kind: 'sail', dailyPrice: 1, hourlyPrice: -1 }));
+});
