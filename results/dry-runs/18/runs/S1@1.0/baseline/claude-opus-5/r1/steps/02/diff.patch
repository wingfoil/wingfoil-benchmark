diff --git a/src/json.ts b/src/json.ts
index 32fc0b997e242ab10884c8b6b44f8f60f8d714bf..221924729a63da6bff6f4e9022df9df145b200a5 100644
--- a/src/json.ts
+++ b/src/json.ts
@@ -20,3 +20,65 @@ export type JsonValue = JsonPrimitive | JsonArray | JsonObject;
 export function isJsonObject(value: JsonValue): value is JsonObject {
   return typeof value === 'object' && value !== null && !Array.isArray(value);
 }
+
+/** Gives `object` the member `member`, replacing it if it is already there. */
+export function setMember(object: JsonObject, member: string, value: JsonValue): void {
+  // A plain assignment to "__proto__" would run the setter inherited from
+  // Object.prototype and swap the object's prototype instead of giving it a
+  // member of that name, which is the only thing the JSON data model knows.
+  Object.defineProperty(object, member, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  });
+}
+
+/**
+ * Copies a JSON value deeply, so that no object or array of the copy is one of
+ * the original. Only own members are copied, since they are the only ones the
+ * JSON data model has.
+ */
+export function cloneJson(value: JsonValue): JsonValue {
+  if (Array.isArray(value)) {
+    return value.map((element) => cloneJson(element));
+  }
+  if (isJsonObject(value)) {
+    const clone: JsonObject = {};
+    for (const member of Object.keys(value)) {
+      setMember(clone, member, cloneJson(value[member]));
+    }
+    return clone;
+  }
+  return value;
+}
+
+/**
+ * Compares two JSON values structurally: primitives by value, arrays element by
+ * element, objects by their members in any order. This is the equality that
+ * JSON Patch's "test" operation is defined with (RFC 6902 § 4.6); note that it
+ * tells numbers from strings, so `10` and `"10"` are different values.
+ */
+export function jsonEquals(left: JsonValue, right: JsonValue): boolean {
+  if (Array.isArray(left) || Array.isArray(right)) {
+    if (!Array.isArray(left) || !Array.isArray(right) || left.length !== right.length) {
+      return false;
+    }
+    return left.every((element, index) => jsonEquals(element, right[index]));
+  }
+
+  if (isJsonObject(left) || isJsonObject(right)) {
+    if (!isJsonObject(left) || !isJsonObject(right)) {
+      return false;
+    }
+    const members = Object.keys(left);
+    return (
+      members.length === Object.keys(right).length &&
+      members.every(
+        (member) => Object.hasOwn(right, member) && jsonEquals(left[member], right[member]),
+      )
+    );
+  }
+
+  return left === right;
+}
