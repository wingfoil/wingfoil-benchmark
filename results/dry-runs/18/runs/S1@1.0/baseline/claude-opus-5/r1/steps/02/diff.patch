@@ -0,0 +1,114 @@
+/**
+ * The shape of a JSON Patch document, as specified in RFC 6902.
+ *
+ * A patch is an array of operation objects, applied to a document one after
+ * another. Every operation names itself in its "op" member and names the
+ * location it works on, the target location, in its "path" member: a JSON
+ * Pointer (RFC 6901) into the document.
+ *
+ *     add      { "op": "add",     "path": pointer, "value": value }
+ *     remove   { "op": "remove",  "path": pointer }
+ *     replace  { "op": "replace", "path": pointer, "value": value }
+ *     move     { "op": "move",    "path": pointer, "from": pointer }
+ *     copy     { "op": "copy",    "path": pointer, "from": pointer }
+ *     test     { "op": "test",    "path": pointer, "value": value }
+ *
+ * Members that the operation in question does not define are ignored, so an
+ * operation may carry anything else a caller finds useful (RFC 6902 § 4).
+ */
+
+import type { JsonValue } from './json.ts';
+
+/** Adds `value` at `path`, or inserts it there if `path` names an array index. */
+export interface AddOperation {
+  readonly op: 'add';
+  readonly path: string;
+  readonly value: JsonValue;
+}
+
+/** Removes the value at `path`. */
+export interface RemoveOperation {
+  readonly op: 'remove';
+  readonly path: string;
+}
+
+/** Replaces the value at `path`, which must exist, with `value`. */
+export interface ReplaceOperation {
+  readonly op: 'replace';
+  readonly path: string;
+  readonly value: JsonValue;
+}
+
+/** Removes the value at `from` and adds it at `path`. */
+export interface MoveOperation {
+  readonly op: 'move';
+  readonly path: string;
+  readonly from: string;
+}
+
+/** Adds a copy of the value at `from` at `path`. */
+export interface CopyOperation {
+  readonly op: 'copy';
+  readonly path: string;
+  readonly from: string;
+}
+
+/** Fails the patch unless the value at `path` equals `value`. */
+export interface TestOperation {
+  readonly op: 'test';
+  readonly path: string;
+  readonly value: JsonValue;
+}
+
+/** One operation of a JSON Patch document, discriminated by its `op` member. */
+export type Operation =
+  AddOperation | RemoveOperation | ReplaceOperation | MoveOperation | CopyOperation | TestOperation;
+
+/** A JSON Patch document: the operations to apply, in order. */
+export type Patch = readonly Operation[];
+
+/** The six operations of RFC 6902, in the order the specification defines them. */
+export const OPERATIONS = ['add', 'remove', 'replace', 'move', 'copy', 'test'] as const;
+
+export type OperationName = (typeof OPERATIONS)[number];
+
+/** Whether `name` is the name of a JSON Patch operation. */
+export function isOperationName(name: string): name is OperationName {
+  return (OPERATIONS as readonly string[]).includes(name);
+}
+
+/**
+ * Why applying a JSON Patch failed.
+ *
+ * - `invalid-patch`: the patch is not a well-formed JSON Patch document, no
+ *   matter which document it is applied to.
+ * - `unresolved`: an operation refers to a location that the document being
+ *   patched does not have.
+ * - `test-failed`: a "test" operation found a value other than the one it
+ *   expected.
+ */
+export type JsonPatchErrorCode = 'invalid-patch' | 'unresolved' | 'test-failed';
+
+/** Raised when a JSON Patch is malformed, or when one of its operations fails. */
+export class JsonPatchError extends Error {
+  override readonly name = 'JsonPatchError';
+
+  readonly code: JsonPatchErrorCode;
+
+  /**
+   * The position in the patch of the operation that failed, or `undefined` if
+   * the patch as a whole is at fault.
+   */
+  readonly index: number | undefined;
+
+  constructor(
+    message: string,
+    code: JsonPatchErrorCode,
+    index: number | undefined,
+    options?: ErrorOptions,
+  ) {
+    super(message, options);
+    this.code = code;
+    this.index = index;
+  }
+}
