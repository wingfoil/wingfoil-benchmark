@@ -0,0 +1,423 @@
+/** Application of JSON Patch documents to JSON documents, as specified in RFC 6902. */
+
+import {
+  cloneJson,
+  isJsonObject,
+  jsonEquals,
+  setMember,
+  type JsonArray,
+  type JsonObject,
+  type JsonValue,
+} from './json.ts';
+import {
+  isOperationName,
+  JsonPatchError,
+  OPERATIONS,
+  type Operation,
+  type OperationName,
+  type Patch,
+} from './patch.ts';
+import { formatPointer, JsonPointerError, parsePointer } from './pointer.ts';
+import { parseArrayIndex, resolvePointer } from './resolve.ts';
+
+/**
+ * Applies `patch` to `document` and returns the patched document.
+ *
+ * The operations of the patch are applied in order, each one to the document
+ * the ones before it produced. `document` is left as it was: the result is a
+ * new value, and it shares no object or array with `document` or with `patch`.
+ *
+ * @throws {JsonPatchError} if `patch` is not a well-formed JSON Patch document,
+ * or if one of its operations cannot be applied. A patch either applies whole
+ * or throws; no half-patched document is ever returned.
+ */
+export function applyPatch(document: JsonValue, patch: Patch): JsonValue {
+  if (!Array.isArray(patch)) {
+    throw new JsonPatchError(
+      `Invalid JSON Patch: a patch must be an array of operations, got ${describe(patch)}`,
+      'invalid-patch',
+      undefined,
+    );
+  }
+
+  // The operations work on a copy, which both keeps the caller's document from
+  // being touched and makes a failure half-way through the patch harmless: the
+  // copy is dropped along with the error.
+  let patched = cloneJson(document);
+  for (const [index, operation] of patch.entries()) {
+    patched = applyOperation(patched, operation, index);
+  }
+  return patched;
+}
+
+/** Where an operation is in the patch, to name it in error messages. */
+interface Context {
+  readonly index: number;
+  readonly op: OperationName;
+}
+
+/** A JSON Pointer of an operation, with its reference tokens. */
+interface Pointer {
+  readonly pointer: string;
+  readonly tokens: readonly string[];
+}
+
+/**
+ * A target location: the container that holds it, and the reference token that
+ * names it inside that container. The location itself need not exist yet.
+ */
+interface Target {
+  readonly parent: JsonObject | JsonArray;
+  readonly token: string;
+  /** The pointer of `parent`, to name it in error messages. */
+  readonly parentPointer: string;
+}
+
+/** Applies the operation at position `index` and returns the patched document. */
+function applyOperation(document: JsonValue, operation: Operation, index: number): JsonValue {
+  // A patch is usually read from outside the type system - a request body, a
+  // configuration file - so every member is checked before it is used.
+  const members = operation as unknown as JsonValue;
+  if (!isJsonObject(members)) {
+    throw new JsonPatchError(
+      `Invalid JSON Patch: operation ${index} must be an object, got ${describe(members)}`,
+      'invalid-patch',
+      index,
+    );
+  }
+  const context: Context = { index, op: readOperationName(members, index) };
+
+  switch (context.op) {
+    case 'add': {
+      const path = readPointer(members, 'path', context);
+      return add(document, path, cloneJson(readValue(members, context)), context);
+    }
+
+    case 'remove': {
+      const path = readPointer(members, 'path', context);
+      if (path.tokens.length === 0) {
+        throw invalidPatch(context, 'has an empty "path", but a document cannot be removed');
+      }
+      remove(document, path, context);
+      return document;
+    }
+
+    case 'replace': {
+      const path = readPointer(members, 'path', context);
+      return replace(document, path, cloneJson(readValue(members, context)), context);
+    }
+
+    case 'move': {
+      const path = readPointer(members, 'path', context);
+      const from = readPointer(members, 'from', context);
+      if (isAncestor(from.tokens, path.tokens)) {
+        throw invalidPatch(
+          context,
+          `cannot move the value at ${quote(from.pointer)} into its own child ${quote(path.pointer)}`,
+        );
+      }
+      if (isSameLocation(from.tokens, path.tokens)) {
+        // Moving a value where it already is changes nothing. Taking the usual
+        // route would read the move of a whole document ("from" and "path" both
+        // empty) as the removal of that document, which no patch can express.
+        resolve(document, from.pointer, context);
+        return document;
+      }
+      // A move is a remove followed by an add, so "path" is read against the
+      // document that the removal leaves behind (RFC 6902 § 4.4).
+      const moved = remove(document, from, context);
+      return add(document, path, moved, context);
+    }
+
+    case 'copy': {
+      const path = readPointer(members, 'path', context);
+      const from = readPointer(members, 'from', context);
+      // The copy is independent of its original: later operations on the one
+      // must not show through in the other.
+      const value = cloneJson(resolve(document, from.pointer, context));
+      return add(document, path, value, context);
+    }
+
+    case 'test': {
+      const path = readPointer(members, 'path', context);
+      const expected = readValue(members, context);
+      const actual = resolve(document, path.pointer, context);
+      if (!jsonEquals(actual, expected)) {
+        throw new JsonPatchError(
+          `${name(context)} failed: ${location(path.pointer)} is ${preview(actual)}, expected ${preview(expected)}`,
+          'test-failed',
+          context.index,
+        );
+      }
+      return document;
+    }
+  }
+}
+
+/**
+ * Adds `value` at `path`. Against an array the value is inserted before the
+ * element the index names, against an object it becomes the member's value,
+ * replacing one that is already there (RFC 6902 § 4.1).
+ */
+function add(document: JsonValue, path: Pointer, value: JsonValue, context: Context): JsonValue {
+  if (path.tokens.length === 0) {
+    // The empty pointer is the whole document: there is no container to add to,
+    // so the value takes the document's place.
+    return value;
+  }
+  const target = locate(document, path, context);
+  if (Array.isArray(target.parent)) {
+    target.parent.splice(insertionIndex(target.parent, target, context), 0, value);
+  } else {
+    setMember(target.parent, target.token, value);
+  }
+  return document;
+}
+
+/**
+ * Removes the value at `path`, which must exist, and returns it. Removing an
+ * array element shifts the elements above it down (RFC 6902 § 4.2).
+ *
+ * `path` must not be the empty pointer; the caller rules that out.
+ */
+function remove(document: JsonValue, path: Pointer, context: Context): JsonValue {
+  const target = locate(document, path, context);
+  if (Array.isArray(target.parent)) {
+    const [removed] = target.parent.splice(elementIndex(target.parent, target, context), 1);
+    return removed;
+  }
+  requireMember(target.parent, target, context);
+  const removed = target.parent[target.token];
+  delete target.parent[target.token];
+  return removed;
+}
+
+/** Replaces the value at `path`, which must exist, with `value` (RFC 6902 § 4.3). */
+function replace(
+  document: JsonValue,
+  path: Pointer,
+  value: JsonValue,
+  context: Context,
+): JsonValue {
+  if (path.tokens.length === 0) {
+    return value;
+  }
+  const target = locate(document, path, context);
+  if (Array.isArray(target.parent)) {
+    target.parent[elementIndex(target.parent, target, context)] = value;
+  } else {
+    requireMember(target.parent, target, context);
+    setMember(target.parent, target.token, value);
+  }
+  return document;
+}
+
+/**
+ * Returns the container that holds the location `path` names, which has to
+ * exist for any operation to work there.
+ *
+ * `path` must not be the empty pointer, which has no container.
+ */
+function locate(document: JsonValue, path: Pointer, context: Context): Target {
+  const parentTokens = path.tokens.slice(0, -1);
+  const parentPointer = formatPointer(parentTokens);
+  const parent = resolve(document, parentPointer, context);
+  if (!Array.isArray(parent) && !isJsonObject(parent)) {
+    throw failed(
+      context,
+      `${location(parentPointer)} is ${describe(parent)}, not an object or an array`,
+    );
+  }
+  return { parent, token: path.tokens[path.tokens.length - 1], parentPointer };
+}
+
+/** Resolves a pointer of an operation against the document being patched. */
+function resolve(document: JsonValue, pointer: string, context: Context): JsonValue {
+  try {
+    return resolvePointer(document, pointer);
+  } catch (cause) {
+    // The pointers of an operation are parsed when it is read, so the only
+    // failure left here is a location the document does not have.
+    if (cause instanceof JsonPointerError) {
+      throw new JsonPatchError(
+        `${name(context)} failed: ${cause.message}`,
+        'unresolved',
+        context.index,
+        { cause },
+      );
+    }
+    throw cause;
+  }
+}
+
+/** Reads the token of `target` as the array index to insert before; "-" appends. */
+function insertionIndex(array: JsonArray, target: Target, context: Context): number {
+  if (target.token === '-') {
+    return array.length;
+  }
+  const index = parseArrayIndex(target.token);
+  if (index === undefined) {
+    throw notAnIndex(target, context);
+  }
+  if (index > array.length) {
+    throw failed(
+      context,
+      `${location(target.parentPointer)} is an array of ${count(array.length, 'element')} and has no position ${index}`,
+    );
+  }
+  return index;
+}
+
+/** Reads the token of `target` as the index of an element the array has. */
+function elementIndex(array: JsonArray, target: Target, context: Context): number {
+  if (target.token === '-') {
+    throw failed(
+      context,
+      `${location(target.parentPointer)} is an array and has no element after the last one ("-")`,
+    );
+  }
+  const index = parseArrayIndex(target.token);
+  if (index === undefined) {
+    throw notAnIndex(target, context);
+  }
+  if (index >= array.length) {
+    throw failed(
+      context,
+      `${location(target.parentPointer)} is an array of ${count(array.length, 'element')} and has no element ${index}`,
+    );
+  }
+  return index;
+}
+
+function notAnIndex(target: Target, context: Context): JsonPatchError {
+  return failed(
+    context,
+    `${location(target.parentPointer)} is an array and ${quote(target.token)} is not an element index`,
+  );
+}
+
+/** Checks that the object has the member that `target` names. */
+function requireMember(parent: JsonObject, target: Target, context: Context): void {
+  // Only own members count, as everywhere in JSON Pointer: a document does not
+  // have a "toString" member because every object inherits one.
+  if (!Object.hasOwn(parent, target.token)) {
+    throw failed(context, `${location(target.parentPointer)} has no member ${quote(target.token)}`);
+  }
+}
+
+/**
+ * Whether the location that `tokens` names contains, at any depth, the one that
+ * `other` names. The tokens are compared one by one, not as text: "/ab" is not
+ * inside "/a" even though the pointers start alike.
+ */
+function isAncestor(tokens: readonly string[], other: readonly string[]): boolean {
+  return tokens.length < other.length && tokens.every((token, depth) => token === other[depth]);
+}
+
+/** Whether both token lists name the same location. */
+function isSameLocation(tokens: readonly string[], other: readonly string[]): boolean {
+  return tokens.length === other.length && tokens.every((token, depth) => token === other[depth]);
+}
+
+function readOperationName(members: JsonObject, index: number): OperationName {
+  const invalid = (detail: string): JsonPatchError =>
+    new JsonPatchError(`Invalid JSON Patch: operation ${index} ${detail}`, 'invalid-patch', index);
+
+  if (!Object.hasOwn(members, 'op')) {
+    throw invalid('has no "op" member');
+  }
+  const op = members.op;
+  if (typeof op !== 'string') {
+    throw invalid(`has an "op" member that is not a string, got ${describe(op)}`);
+  }
+  if (!isOperationName(op)) {
+    throw invalid(
+      `has an unknown "op" member ${quote(op)}, expected one of ${OPERATIONS.join(', ')}`,
+    );
+  }
+  return op;
+}
+
+function readPointer(members: JsonObject, member: 'path' | 'from', context: Context): Pointer {
+  if (!Object.hasOwn(members, member)) {
+    throw invalidPatch(context, `has no ${quote(member)} member`);
+  }
+  const pointer = members[member];
+  if (typeof pointer !== 'string') {
+    throw invalidPatch(
+      context,
+      `has a ${quote(member)} member that is not a string, got ${describe(pointer)}`,
+    );
+  }
+  try {
+    return { pointer, tokens: parsePointer(pointer) };
+  } catch (cause) {
+    if (cause instanceof JsonPointerError) {
+      throw invalidPatch(
+        context,
+        `has an invalid ${quote(member)} member: ${cause.message}`,
+        cause,
+      );
+    }
+    throw cause;
+  }
+}
+
+function readValue(members: JsonObject, context: Context): JsonValue {
+  if (!Object.hasOwn(members, 'value')) {
+    throw invalidPatch(context, 'has no "value" member');
+  }
+  const value = members.value;
+  if (value === undefined) {
+    // Not a JSON value, so no document can hold it, and no test can match it.
+    throw invalidPatch(context, 'has a "value" member that is undefined');
+  }
+  return value;
+}
+
+function invalidPatch(context: Context, detail: string, cause?: unknown): JsonPatchError {
+  return new JsonPatchError(
+    `Invalid JSON Patch: operation ${context.index} (${quote(context.op)}) ${detail}`,
+    'invalid-patch',
+    context.index,
+    cause === undefined ? undefined : { cause },
+  );
+}
+
+function failed(context: Context, detail: string): JsonPatchError {
+  return new JsonPatchError(`${name(context)} failed: ${detail}`, 'unresolved', context.index);
+}
+
+function name(context: Context): string {
+  return `JSON Patch operation ${context.index} (${quote(context.op)})`;
+}
+
+function location(pointer: string): string {
+  return pointer === '' ? 'the document' : `the value at ${quote(pointer)}`;
+}
+
+/** How long a value may be in an error message before it is cut short. */
+const PREVIEW_LENGTH = 60;
+
+function preview(value: JsonValue): string {
+  const text = JSON.stringify(value);
+  return text.length <= PREVIEW_LENGTH ? text : `${text.slice(0, PREVIEW_LENGTH)}…`;
+}
+
+function count(amount: number, noun: string): string {
+  return `${amount} ${noun}${amount === 1 ? '' : 's'}`;
+}
+
+function quote(value: string): string {
+  return JSON.stringify(value);
+}
+
+function describe(value: unknown): string {
+  if (value === null || value === undefined) {
+    return String(value);
+  }
+  if (Array.isArray(value)) {
+    return 'an array';
+  }
+  return typeof value === 'object' ? 'an object' : `a ${typeof value}`;
+}
