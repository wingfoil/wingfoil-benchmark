+      {},
+      [1, [2]],
+      { a: { b: [] } },
+    ];
+    for (const value of values) {
+      assert.deepEqual(
+        applyPatch({ a: value }, [{ op: 'test', path: '/a', value }]),
+        { a: value },
+        JSON.stringify(value),
+      );
+    }
+  });
+
+  test('does not see inherited members of the expected value', () => {
+    const expected = Object.create({ inherited: 'no' }) as Record<string, JsonValue>;
+    expected.own = 'yes';
+    assert.deepEqual(
+      applyPatch({ a: { own: 'yes' } }, [{ op: 'test', path: '/a', value: expected }]),
+      {
+        a: { own: 'yes' },
+      },
+    );
+  });
+
+  test('needs the target to exist', () => {
+    assert.throws(() => applyPatch({ a: 1 }, [{ op: 'test', path: '/b', value: 1 }]), {
+      code: 'unresolved',
+    });
+  });
+
+  test('a failed test stops the patch', () => {
+    const document = { a: 1 };
+    assert.throws(() =>
+      applyPatch(document, [
+        { op: 'add', path: '/b', value: 2 },
+        { op: 'test', path: '/a', value: 'other' },
+        { op: 'remove', path: '/a' },
+      ]),
+    );
+    assert.deepEqual(document, { a: 1 });
+  });
+});
+
+describe('several operations', () => {
+  test('are applied in order, each to the result of the one before', () => {
+    assert.deepEqual(
+      applyPatch({ counters: {} }, [
+        { op: 'add', path: '/counters/hits', value: 0 },
+        { op: 'replace', path: '/counters/hits', value: 1 },
+        { op: 'copy', from: '/counters/hits', path: '/counters/misses' },
+        { op: 'move', from: '/counters/misses', path: '/misses' },
+        { op: 'test', path: '/misses', value: 1 },
+      ]),
+      { counters: { hits: 1 }, misses: 1 },
+    );
+  });
+
+  test('can rewrite the document and then patch it again', () => {
+    assert.deepEqual(
+      applyPatch({ a: 1 }, [
+        { op: 'add', path: '', value: { b: [] } },
+        { op: 'add', path: '/b/-', value: 'first' },
+      ]),
+      { b: ['first'] },
+    );
+  });
+});
+
+describe('a document that is not a container', () => {
+  const documents: JsonValue[] = [null, 42, true, 'text'];
+
+  test('can be replaced through the empty pointer', () => {
+    for (const document of documents) {
+      assert.deepEqual(applyPatch(document, [{ op: 'add', path: '', value: { a: 1 } }]), { a: 1 });
+      assert.deepEqual(applyPatch(document, [{ op: 'replace', path: '', value: [] }]), []);
+      assert.deepEqual(applyPatch(document, [{ op: 'test', path: '', value: document }]), document);
+    }
+  });
+
+  test('has no location to patch', () => {
+    for (const document of documents) {
+      assert.throws(
+        () => applyPatch(document, [{ op: 'add', path: '/a', value: 1 }]),
+        { code: 'unresolved' },
+        JSON.stringify(document),
+      );
+      assert.throws(
+        () => applyPatch(document, [{ op: 'remove', path: '/a' }]),
+        { code: 'unresolved' },
+        JSON.stringify(document),
+      );
+    }
+    assert.throws(() => applyPatch('text', [{ op: 'add', path: '/0', value: 'x' }]), {
+      message:
+        'JSON Patch operation 0 ("add") failed: the document is a string, not an object or an array',
+    });
+  });
+});
+
+describe('own members only', () => {
+  test('a path of "/__proto__" is the member of that name', () => {
+    const patched = applyPatch({}, [{ op: 'add', path: '/__proto__', value: { polluted: true } }]);
+    assert.deepEqual(patched, JSON.parse('{"__proto__": {"polluted": true}}'));
+    assert.ok(Object.hasOwn(patched as object, '__proto__'));
+    assert.equal(Object.getPrototypeOf(patched), Object.prototype);
+    assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  });
+
+  test('no prototype is reachable through a path', () => {
+    for (const path of ['/__proto__/polluted', '/constructor/prototype/polluted']) {
+      assert.throws(
+        () => applyPatch({}, [{ op: 'add', path, value: true }]),
+        { code: 'unresolved' },
+        path,
+      );
+    }
+    assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  });
+
+  test('inherited members are not members of the document', () => {
+    for (const op of [
+      { op: 'remove', path: '/toString' },
+      { op: 'replace', path: '/toString', value: 1 },
+      { op: 'test', path: '/toString', value: 1 },
+      { op: 'move', from: '/toString', path: '/a' },
+      { op: 'copy', from: '/toString', path: '/a' },
+    ]) {
+      assert.throws(() => apply({}, [op]), { code: 'unresolved' }, JSON.stringify(op));
+    }
+  });
+
+  test('a member named "__proto__" can be read, moved and removed', () => {
+    // An object literal would read "__proto__" as the prototype rather than as
+    // a member, so the documents of this test are parsed from their JSON text.
+    const document = JSON.parse('{"__proto__": {"a": 1}}') as JsonValue;
+    assert.deepEqual(
+      applyPatch(document, [{ op: 'test', path: '/__proto__/a', value: 1 }]),
+      JSON.parse('{"__proto__": {"a": 1}}'),
+    );
+    const moved = applyPatch(document, [{ op: 'move', from: '/__proto__', path: '/plain' }]);
+    assert.deepEqual(moved, { plain: { a: 1 } });
+    assert.deepEqual(applyPatch(document, [{ op: 'remove', path: '/__proto__' }]), {});
+  });
+});
+
+describe('invalid patches', () => {
+  test('a patch must be an array', () => {
+    for (const patch of [undefined, null, 0, 'add', { op: 'add', path: '/a', value: 1 }]) {
+      assert.throws(
+        () => apply({}, patch),
+        { name: 'JsonPatchError', code: 'invalid-patch', index: undefined },
+        String(patch),
+      );
+    }
+  });
+
+  test('an operation must be an object', () => {
+    for (const operation of [undefined, null, 0, 'add', [], ['add']]) {
+      assert.throws(
+        () => apply({}, [operation]),
+        { code: 'invalid-patch', index: 0 },
+        String(operation),
+      );
+    }
+  });
+
+  test('an operation must have a known "op" member', () => {
+    for (const operation of [
+      {},
+      { path: '/a' },
+      { op: 'Add', path: '/a', value: 1 },
+      { op: 'append', path: '/a', value: 1 },
+      { op: '', path: '/a' },
+      { op: 1, path: '/a' },
+      { op: null, path: '/a' },
+      { op: ['add'], path: '/a' },
+    ]) {
+      assert.throws(
+        () => apply({}, [operation]),
+        { code: 'invalid-patch', index: 0 },
+        JSON.stringify(operation),
+      );
+    }
+  });
+
+  test('an operation must have the members its "op" calls for', () => {
+    for (const operation of [
+      { op: 'add', path: '/a' },
+      { op: 'replace', path: '/a' },
+      { op: 'test', path: '/a' },
+      { op: 'add', value: 1 },
+      { op: 'remove' },
+      { op: 'move', path: '/b' },
+      { op: 'copy', path: '/b' },
+      { op: 'move', from: '/a' },
+      { op: 'copy', from: '/a' },
+    ]) {
+      assert.throws(
+        () => apply({ a: 1 }, [operation]),
+        { code: 'invalid-patch', index: 0 },
+        JSON.stringify(operation),
+      );
+    }
+  });
+
+  test('"path" and "from" must be JSON Pointers', () => {
+    for (const operation of [
+      { op: 'add', path: 'a', value: 1 },
+      { op: 'add', path: '/~', value: 1 },
+      { op: 'add', path: '#/a', value: 1 },
+      { op: 'add', path: 0, value: 1 },
+      { op: 'add', path: null, value: 1 },
+      { op: 'add', path: ['/a'], value: 1 },
+      { op: 'remove', path: '/a~x' },
+      { op: 'move', from: 'a', path: '/b' },
+      { op: 'copy', from: '/~2', path: '/b' },
+      { op: 'copy', from: 0, path: '/b' },
+    ]) {
+      assert.throws(
+        () => apply({ a: 1 }, [operation]),
+        { code: 'invalid-patch', index: 0 },
+        JSON.stringify(operation),
+      );
+    }
+  });
+
+  test('a "value" member must hold a JSON value', () => {
+    assert.throws(() => apply({}, [{ op: 'add', path: '/a', value: undefined }]), {
+      code: 'invalid-patch',
+      message: 'Invalid JSON Patch: operation 0 ("add") has a "value" member that is undefined',
+    });
+  });
+
+  test('an invalid operation is reported before anything is applied', () => {
+    const document = { a: 1 };
+    assert.throws(
+      () =>
+        apply(document, [
+          { op: 'remove', path: '/a' },
+          { op: 'frobnicate', path: '/a' },
+        ]),
+      { code: 'invalid-patch', index: 1 },
+    );
+    assert.deepEqual(document, { a: 1 });
+  });
+});
+
+describe('errors', () => {
+  test('are JsonPatchError instances naming the operation that failed', () => {
+    let error: unknown;
+    try {
+      applyPatch({ a: 1 }, [
+        { op: 'add', path: '/b', value: 2 },
+        { op: 'test', path: '/a', value: 2 },
+      ]);
+    } catch (thrown) {
+      error = thrown;
+    }
+    assert.ok(error instanceof JsonPatchError);
+    assert.ok(error instanceof Error);
+    assert.equal(error.name, 'JsonPatchError');
+    assert.equal(error.code, 'test-failed');
+    assert.equal(error.index, 1);
+  });
+
+  test('say which value a test found', () => {
+    assert.throws(() => applyPatch({ a: [1] }, [{ op: 'test', path: '/a', value: [2] }]), {
+      message: 'JSON Patch operation 0 ("test") failed: the value at "/a" is [1], expected [2]',
+    });
+  });
+
+  test('cut long values short', () => {
+    const long = 'x'.repeat(200);
+    assert.throws(() => applyPatch({ a: long }, [{ op: 'test', path: '/a', value: '' }]), {
+      message:
+        /^JSON Patch operation 0 \("test"\) failed: the value at "\/a" is "x{59}…, expected ""$/,
+    });
+  });
+
+  test('say where in the document an operation stopped', () => {
+    assert.throws(() => applyPatch({ a: { b: {} } }, [{ op: 'remove', path: '/a/b/c' }]), {
+      message: 'JSON Patch operation 0 ("remove") failed: the value at "/a/b" has no member "c"',
+    });
+    assert.throws(() => applyPatch({ a: ['x'] }, [{ op: 'add', path: '/a/5', value: 1 }]), {
+      message:
+        'JSON Patch operation 0 ("add") failed: the value at "/a" is an array of 1 element and has no position 5',
+    });
+    assert.throws(() => applyPatch({ a: ['x'] }, [{ op: 'replace', path: '/a/1', value: 1 }]), {
+      message:
+        'JSON Patch operation 0 ("replace") failed: the value at "/a" is an array of 1 element and has no element 1',
+    });
+    assert.throws(() => applyPatch({ a: 'text' }, [{ op: 'add', path: '/a/b', value: 1 }]), {
+      message:
+        'JSON Patch operation 0 ("add") failed: the value at "/a" is a string, not an object or an array',
+    });
+    assert.throws(() => applyPatch({}, [{ op: 'add', path: '/a/b', value: 1 }]), {
+      message:
+        'JSON Patch operation 0 ("add") failed: JSON Pointer "/a" does not resolve: the document has no member "a"',
+    });
+  });
+
+  test('report a malformed pointer with the pointer error', () => {
+    assert.throws(() => apply({}, [{ op: 'add', path: 'a', value: 1 }]), {
+      message:
+        'Invalid JSON Patch: operation 0 ("add") has an invalid "path" member: Invalid JSON Pointer "a": a non-empty pointer must start with "/"',
+    });
+  });
+
+  test('report an unknown operation', () => {
+    assert.throws(() => apply({}, [{ op: 'frobnicate', path: '/a' }]), {
+      message:
+        'Invalid JSON Patch: operation 0 has an unknown "op" member "frobnicate", expected one of add, remove, replace, move, copy, test',
+    });
+  });
+
+  test('report a patch that is not an array', () => {
+    assert.throws(() => apply({}, { op: 'add', path: '/a', value: 1 }), {
+      message: 'Invalid JSON Patch: a patch must be an array of operations, got an object',
+    });
+  });
+});
