+/** Something inside a value that the JSON data model does not have. */
+export interface NonJsonValue {
+  /** How to name what was found in an error message, e.g. `undefined`. */
+  readonly description: string;
+  /** The reference tokens that lead to it from the value that was checked. */
+  readonly tokens: readonly string[];
+}
+
+/**
+ * Looks for a part of `value` that is not a JSON value and describes the first
+ * one it finds, or returns `undefined` if the whole value belongs to the JSON
+ * data model.
+ *
+ * The data model has objects, arrays, strings, finite numbers, `true`, `false`
+ * and `null`, and nothing else. `undefined`, `NaN`, an infinity, a function, a
+ * symbol, a bigint, a hole in an array, an object of some other kind such as a
+ * `Date` or a `Map`, and a value that contains itself are all outside it: no
+ * JSON document can hold one, and writing one into a document would only mean
+ * losing or changing it the next time the document is serialized.
+ */
+export function findNonJsonValue(value: unknown): NonJsonValue | undefined {
+  return search(value, [], new Set());
+}
+
+/**
+ * Searches `value` depth first. `tokens` is the path walked so far, and
+ * `enclosing` holds the objects and arrays that `value` is inside of, which is
+ * what tells a value that contains itself from one that merely holds the same
+ * object twice.
+ */
+function search(
+  value: unknown,
+  tokens: string[],
+  enclosing: Set<object>,
+): NonJsonValue | undefined {
+  const found = (description: string): NonJsonValue => ({ description, tokens: [...tokens] });
+
+  if (value === null || typeof value === 'boolean' || typeof value === 'string') {
+    return undefined;
+  }
+  if (typeof value === 'number') {
+    // JSON has no notation for NaN or for an infinity.
+    return Number.isFinite(value) ? undefined : found(String(value));
+  }
+  if (typeof value !== 'object') {
+    return found(value === undefined ? 'undefined' : `a ${typeof value}`);
+  }
+  if (enclosing.has(value)) {
+    return found('a value that contains itself');
+  }
+
+  enclosing.add(value);
+  try {
+    if (Array.isArray(value)) {
+      for (let index = 0; index < value.length; index++) {
+        tokens.push(String(index));
+        // A hole is not an element holding anything: JSON has no way to write
+        // one, and serializing it would turn it into null.
+        const nonJson = index in value ? search(value[index], tokens, enclosing) : found('a hole');
+        tokens.pop();
+        if (nonJson !== undefined) {
+          return nonJson;
+        }
+      }
+      return undefined;
+    }
+
+    // Only a plain object is a JSON object. A Date, a Map or a RegExp is an
+    // object to JavaScript but holds its contents somewhere the data model
+    // cannot see, so copying one would leave an empty object behind.
+    const kind = Object.prototype.toString.call(value);
+    if (kind !== '[object Object]') {
+      return found(`a ${kind.slice('[object '.length, -1)}`);
+    }
+    for (const member of Object.keys(value)) {
+      tokens.push(member);
+      const nonJson = search((value as Record<string, unknown>)[member], tokens, enclosing);
+      tokens.pop();
+      if (nonJson !== undefined) {
+        return nonJson;
+      }
+    }
+    return undefined;
+  } finally {
+    enclosing.delete(value);
+  }
+}
