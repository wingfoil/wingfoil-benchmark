diff --git a/test/create-patch.test.ts b/test/create-patch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..023df97a7fe10779274d572b4368e143dca2fe8f
--- /dev/null
+++ b/test/create-patch.test.ts
@@ -0,0 +1,486 @@
+import assert from 'node:assert/strict';
+import test, { describe } from 'node:test';
+
+import { applyPatch, createPatch, type JsonValue, type Patch } from '../src/index.ts';
+
+/** Creates a patch from documents that are not well typed, as parsed ones can be. */
+function create(from: unknown, to: unknown): Patch {
+  return createPatch(from as JsonValue, to as JsonValue);
+}
+
+/** Checks that the patch turns `from` into `to`, and returns it. */
+function roundTrip(from: JsonValue, to: JsonValue): Patch {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to, `patch ${JSON.stringify(patch)} does not apply`);
+  return patch;
+}
+
+describe('documents that are already equal', () => {
+  const equal: Array<[title: string, document: JsonValue]> = [
+    ['null', null],
+    ['a number', 7],
+    ['a string', 'text'],
+    ['a boolean', false],
+    ['an empty object', {}],
+    ['an empty array', []],
+    ['a nested document', { a: [1, { b: 'c' }], d: null }],
+  ];
+
+  for (const [title, document] of equal) {
+    test(`${title} needs no operation`, () => {
+      assert.deepEqual(createPatch(document, document), []);
+      assert.deepEqual(createPatch(structuredClone(document), document), []);
+    });
+  }
+
+  test('the order of an object\'s members is not a difference', () => {
+    assert.deepEqual(createPatch({ a: 1, b: 2 }, { b: 2, a: 1 }), []);
+    assert.deepEqual(createPatch({ a: { x: 1, y: 2 } }, { a: { y: 2, x: 1 } }), []);
+  });
+});
+
+describe('the whole document', () => {
+  test('replaces a primitive with another', () => {
+    assert.deepEqual(roundTrip(1, 2), [{ op: 'replace', path: '', value: 2 }]);
+  });
+
+  test('replaces a document of one kind with another', () => {
+    assert.deepEqual(roundTrip({ a: 1 }, [1]), [{ op: 'replace', path: '', value: [1] }]);
+    assert.deepEqual(roundTrip([1], { a: 1 }), [{ op: 'replace', path: '', value: { a: 1 } }]);
+    assert.deepEqual(roundTrip({ a: 1 }, null), [{ op: 'replace', path: '', value: null }]);
+    assert.deepEqual(roundTrip(null, { a: 1 }), [{ op: 'replace', path: '', value: { a: 1 } }]);
+  });
+
+  test('tells a number from the string that looks like it', () => {
+    assert.deepEqual(roundTrip(10, '10'), [{ op: 'replace', path: '', value: '10' }]);
+  });
+
+  test('tells null from a missing member', () => {
+    assert.deepEqual(roundTrip({ a: null }, {}), [{ op: 'remove', path: '/a' }]);
+    assert.deepEqual(roundTrip({}, { a: null }), [{ op: 'add', path: '/a', value: null }]);
+  });
+});
+
+describe('objects', () => {
+  test('replaces the member that changed', () => {
+    assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1, b: 3 }), [
+      { op: 'replace', path: '/b', value: 3 },
+    ]);
+  });
+
+  test('adds a member only the new document has', () => {
+    assert.deepEqual(roundTrip({ a: 1 }, { a: 1, b: 2 }), [{ op: 'add', path: '/b', value: 2 }]);
+  });
+
+  test('removes a member only the old document has', () => {
+    assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1 }), [{ op: 'remove', path: '/b' }]);
+  });
+
+  test('reaches into a member instead of replacing it', () => {
+    assert.deepEqual(roundTrip({ a: { b: { c: 1, d: 2 } } }, { a: { b: { c: 9, d: 2 } } }), [
+      { op: 'replace', path: '/a/b/c', value: 9 },
+    ]);
+  });
+
+  test('replaces a member whose kind changed', () => {
+    assert.deepEqual(roundTrip({ a: { b: 1 } }, { a: [1] }), [
+      { op: 'replace', path: '/a', value: [1] },
+    ]);
+  });
+
+  test('describes several changes at once', () => {
+    assert.deepEqual(roundTrip({ a: 1, b: 2, c: 3 }, { a: 1, b: 9, d: 4 }), [
+      { op: 'replace', path: '/b', value: 9 },
+      { op: 'remove', path: '/c' },
+      { op: 'add', path: '/d', value: 4 },
+    ]);
+  });
+
+  test('escapes member names in the pointers it writes', () => {
+    assert.deepEqual(roundTrip({ 'a/b': 1, 'c~d': 2, '': 3 }, { 'a/b': 9, 'c~d': 2 }), [
+      { op: 'replace', path: '/a~1b', value: 9 },
+      { op: 'remove', path: '/' },
+    ]);
+  });
+
+  test('empties an object member by member', () => {
+    assert.deepEqual(roundTrip({ a: 1, b: 2 }, {}), [
+      { op: 'remove', path: '/a' },
+      { op: 'remove', path: '/b' },
+    ]);
+  });
+
+  test('fills an object member by member', () => {
+    assert.deepEqual(roundTrip({}, { a: 1, b: 2 }), [
+      { op: 'add', path: '/a', value: 1 },
+      { op: 'add', path: '/b', value: 2 },
+    ]);
+  });
+});
+
+describe('arrays', () => {
+  test('replaces the element that changed', () => {
+    assert.deepEqual(roundTrip([1, 2, 3], [1, 9, 3]), [{ op: 'replace', path: '/1', value: 9 }]);
+  });
+
+  test('reaches into an element instead of replacing it', () => {
+    assert.deepEqual(roundTrip([{ a: 1, b: 2 }], [{ a: 1, b: 9 }]), [
+      { op: 'replace', path: '/0/b', value: 9 },
+    ]);
+  });
+
+  test('appends an element', () => {
+    assert.deepEqual(roundTrip([1, 2], [1, 2, 3]), [{ op: 'add', path: '/2', value: 3 }]);
+  });
+
+  test('prepends an element', () => {
+    assert.deepEqual(roundTrip([1, 2], [0, 1, 2]), [{ op: 'add', path: '/0', value: 0 }]);
+  });
+
+  test('inserts an element in the middle', () => {
+    assert.deepEqual(roundTrip([1, 2, 3], [1, 2, 9, 3]), [{ op: 'add', path: '/2', value: 9 }]);
+  });
+
+  test('removes an element', () => {
+    assert.deepEqual(roundTrip([1, 2, 3], [1, 3]), [{ op: 'remove', path: '/1' }]);
+  });
+
+  test('removes the first and the last element', () => {
+    assert.deepEqual(roundTrip([1, 2, 3], [2]), [
+      { op: 'remove', path: '/0' },
+      { op: 'remove', path: '/1' },
+    ]);
+  });
+
+  test('removes several elements, counting the shift each one causes', () => {
+    assert.deepEqual(roundTrip([1, 2, 3, 4, 5], [1, 3, 5]), [
+      { op: 'remove', path: '/1' },
+      { op: 'remove', path: '/2' },
+    ]);
+  });
+
+  test('inserts at several places at once', () => {
+    assert.deepEqual(roundTrip(['a', 'b', 'c'], ['a', 'x', 'b', 'c', 'y']), [
+      { op: 'add', path: '/1', value: 'x' },
+      { op: 'add', path: '/4', value: 'y' },
+    ]);
+  });
+
+  test('recognizes elements that only moved up or down', () => {
+    // Nothing of the elements the two arrays share is sent again: the patch is
+    // one removal and one addition, not three replacements.
+    assert.deepEqual(roundTrip(['a', 'b', 'c'], ['b', 'c', 'd']), [
+      { op: 'remove', path: '/0' },
+      { op: 'add', path: '/2', value: 'd' },
+    ]);
+  });
+
+  test('empties an array element by element', () => {
+    assert.deepEqual(roundTrip([1, 2], []), [
+      { op: 'remove', path: '/0' },
+      { op: 'remove', path: '/0' },
+    ]);
+  });
+
+  test('fills an array element by element', () => {
+    assert.deepEqual(roundTrip([], [1, 2]), [
+      { op: 'add', path: '/0', value: 1 },
+      { op: 'add', path: '/1', value: 2 },
+    ]);
+  });
+
+  test('replaces an element whose kind changed', () => {
+    assert.deepEqual(roundTrip([{ a: 1 }], [[1]]), [{ op: 'replace', path: '/0', value: [1] }]);
+  });
+
+  test('reaches into the element that changed, past the ones that moved', () => {
+    const from = [{ id: 1, v: 'a' }, { id: 2, v: 'b' }, { id: 3, v: 'c' }];
+    const to = [{ id: 1, v: 'a' }, { id: 2, v: 'z' }, { id: 3, v: 'c' }];
+    assert.deepEqual(roundTrip(from, to), [{ op: 'replace', path: '/1/v', value: 'z' }]);
+  });
+
+  test('does not send the elements around an insertion again', () => {
+    const element = (id: number): JsonValue => ({ id, payload: 'x'.repeat(100) });
+    const from = [element(1), element(2), element(3)];
+    const to = [element(1), element(9), element(2), element(3)];
+    assert.deepEqual(roundTrip(from, to), [{ op: 'add', path: '/1', value: element(9) }]);
+  });
+
+  test('aligns elements that are equal but not the same object', () => {
+    const shared = { a: [1, 2] };
+    assert.deepEqual(roundTrip([shared], [structuredClone(shared), 1]), [
+      { op: 'add', path: '/1', value: 1 },
+    ]);
+  });
+});
+
+describe('a small change in a large document', () => {
+  function large(deep: JsonValue): JsonValue {
+    return {
+      metadata: { name: 'service', labels: { tier: 'gold', region: 'eu' } },
+      replicas: Array.from({ length: 50 }, (_unused, index) => ({
+        host: `node-${index}`,
+        port: 8080 + index,
+        tags: ['primary', 'healthy'],
+      })),
+      settings: { retries: 3, timeout: 30, nested: { deeper: { deepest: deep } } },
+    };
+  }
+
+  test('costs exactly one operation', () => {
+    assert.deepEqual(roundTrip(large('before'), large('after')), [
+      { op: 'replace', path: '/settings/nested/deeper/deepest', value: 'after' },
+    ]);
+  });
+
+  test('costs one operation inside a long array as well', () => {
+    const from = large(null) as { replicas: Array<{ port: number }> };
+    const to = structuredClone(from);
+    to.replicas[37].port = 9999;
+    assert.deepEqual(roundTrip(from as JsonValue, to as JsonValue), [
+      { op: 'replace', path: '/replicas/37/port', value: 9999 },
+    ]);
+  });
+
+  test('carries nothing of what the two documents share', () => {
+    const patch = roundTrip(large('before'), large('after'));
+    assert.equal(JSON.stringify(patch).includes('node-0'), false);
+    assert.ok(JSON.stringify(patch).length < 100);
+  });
+});
+
+describe('patches that apply', () => {
+  const cases: Array<[from: JsonValue, to: JsonValue]> = [
+    [{ a: 'b' }, { a: 'c' }],
+    [{ a: 'b' }, { b: 'c' }],
+    [{ a: 'b' }, {}],
+    [{ a: ['b'] }, { a: 'c' }],
+    [{ a: { b: 'c' } }, { a: { b: 'd', c: 1 } }],
+    [{ a: [{ b: 'c' }] }, { a: [1] }],
+    [['a', 'b'], ['c', 'd']],
+    [{ a: 'b' }, ['c']],
+    [{ a: 'foo' }, null],
+    [null, { a: 'foo' }],
+    [{ e: null }, { a: 1 }],
+    [[1, 2], { a: 'b' }],
+    [{}, { a: { bb: { ccc: [1, 2, 3] } } }],
+    [[1, 2, 3, 4, 5, 6], [6, 5, 4, 3, 2, 1]],
+    [[[1], [2], [3]], [[1], [3], [2]]],
+    [{ a: [1, [2, [3, [4]]]] }, { a: [1, [2, [9, [4]]]] }],
+    ['text', 'text '],
+    [[true, false, null], [null, false, true]],
+    [{ '': { '': 1 } }, { '': { '': 2 } }],
+    [{ '~': 1, '/': 2 }, { '~': 2, '/': 1 }],
+  ];
+
+  for (const [from, to] of cases) {
+    test(`${JSON.stringify(from)} -> ${JSON.stringify(to)}`, () => {
+      roundTrip(from, to);
+    });
+  }
+});
+
+describe('patches that apply, on documents drawn at random', () => {
+  /**
+   * A small deterministic generator, so that a failure can be reproduced: the
+   * documents below are the same on every run.
+   */
+  function random(seed: number): () => number {
+    let state = seed;
+    return () => {
+      // A 32-bit xorshift, which is plenty for picking shapes and values.
+      state ^= state << 13;
+      state ^= state >>> 17;
+      state ^= state << 5;
+      state |= 0;
+      return (state >>> 0) / 0x100000000;
+    };
+  }
+
+  function document(next: () => number, depth: number): JsonValue {
+    const primitives: JsonValue[] = [null, true, false, 0, 1, 2, 'a', 'b', ''];
+    if (depth === 0 || next() < 0.4) {
+      return primitives[Math.floor(next() * primitives.length)];
+    }
+    const size = Math.floor(next() * 4);
+    if (next() < 0.5) {
+      return Array.from({ length: size }, () => document(next, depth - 1));
+    }
+    const object: Record<string, JsonValue> = {};
+    for (let index = 0; index < size; index++) {
+      object['abcd'[Math.floor(next() * 4)]] = document(next, depth - 1);
+    }
+    return object;
+  }
+
+  test('a thousand pairs of documents', () => {
+    const next = random(20260102);
+    for (let round = 0; round < 1000; round++) {
+      const from = document(next, 4);
+      const to = document(next, 4);
+      const patch = createPatch(from, to);
+      assert.deepEqual(
+        applyPatch(from, patch),
+        to,
+        `${JSON.stringify(from)} -> ${JSON.stringify(to)} by ${JSON.stringify(patch)}`,
+      );
+    }
+  });
+
+  test('a patch between a document and a small edit of it stays small', () => {
+    const next = random(777);
+    for (let round = 0; round < 200; round++) {
+      const from = { fixed: document(next, 3), edited: document(next, 2) };
+      const to = { fixed: from.fixed, edited: document(next, 2) };
+      const patch = createPatch(from, to);
+      assert.deepEqual(applyPatch(from, patch), to);
+      // Only the member that was edited is mentioned; the other one, however
+      // large, costs nothing.
+      assert.equal(
+        patch.every((operation) => operation.path.startsWith('/edited')),
+        true,
+        `${JSON.stringify(patch)}`,
+      );
+    }
+  });
+});
+
+describe('leaving the inputs alone', () => {
+  test('does not mutate the documents', () => {
+    const from = { a: { b: [1, 2] }, c: 3 };
+    const to = { a: { b: [1, 9] }, d: 4 };
+    const before = [structuredClone(from), structuredClone(to)];
+    createPatch(from, to);
+    assert.deepEqual([from, to], before);
+  });
+
+  test('returns a patch that shares nothing with the new document', () => {
+    const to = { a: { b: [1] } };
+    const patch = createPatch({}, to) as [{ op: 'add'; value: { b: number[] } }];
+    assert.deepEqual(patch[0].value, to.a);
+    assert.notEqual(patch[0].value, to.a);
+    assert.notEqual(patch[0].value.b, to.a.b);
+  });
+
+  test('a later change to the document is invisible in the patch', () => {
+    const to: { a: number[] } = { a: [1] };
+    const patch = createPatch({ a: [] }, to);
+    to.a.push(2);
+    assert.deepEqual(patch, [{ op: 'add', path: '/a/0', value: 1 }]);
+  });
+});
+
+describe('own members only', () => {
+  test('"__proto__" is a member like any other', () => {
+    const from = JSON.parse('{"__proto__": {"b": 2}}') as JsonValue;
+    const to = JSON.parse('{"__proto__": {"b": 3}}') as JsonValue;
+    assert.deepEqual(createPatch(from, to), [{ op: 'replace', path: '/__proto__/b', value: 3 }]);
+    const patched = applyPatch(from, createPatch(from, to));
+    assert.deepEqual(Object.getOwnPropertyDescriptor(patched, '__proto__')?.value, { b: 3 });
+    assert.equal(Object.getPrototypeOf(patched), Object.prototype);
+  });
+
+  test('adds and removes the member named "__proto__"', () => {
+    const empty = {};
+    const proto = JSON.parse('{"__proto__": 1}') as JsonValue;
+    assert.deepEqual(createPatch(empty, proto), [{ op: 'add', path: '/__proto__', value: 1 }]);
+    assert.deepEqual(createPatch(proto, empty), [{ op: 'remove', path: '/__proto__' }]);
+  });
+
+  test('inherited properties are not members', () => {
+    const from = Object.create({ inherited: 'no' }) as Record<string, JsonValue>;
+    from.own = 1;
+    const to = Object.create({ inherited: 'no' }) as Record<string, JsonValue>;
+    to.own = 2;
+    assert.deepEqual(createPatch(from, to), [{ op: 'replace', path: '/own', value: 2 }]);
+  });
+});
+
+describe('documents that are not JSON values', () => {
+  const invalid: Array<[title: string, document: unknown]> = [
+    ['undefined', undefined],
+    ['a member that is undefined', { a: undefined }],
+    ['NaN', { a: NaN }],
+    ['an infinity', { a: -Infinity }],
+    ['a function', { a: () => 1 }],
+    ['a symbol', { a: Symbol('a') }],
+    ['a bigint', { a: 1n }],
+    ['a Date', { a: new Date(0) }],
+    ['a Map', { a: new Map() }],
+    ['a hole in an array', { a: [1, , 2] }],
+    ['a value deep inside the document', { a: { b: { c: [undefined] } } }],
+  ];
+
+  for (const [title, document] of invalid) {
+    test(`rejects ${title} as the new document`, () => {
+      assert.throws(() => create({ a: 1 }, document), {
+        name: 'JsonPatchError',
+        code: 'invalid-document',
+      });
+    });
+
+    test(`rejects ${title} as the old document`, () => {
+      assert.throws(() => create(document, { a: 1 }), {
+        name: 'JsonPatchError',
+        code: 'invalid-document',
+      });
+    });
+  }
+
+  test('rejects a document that contains itself', () => {
+    const from: Record<string, unknown> = { a: 1 };
+    from.self = from;
+    assert.throws(() => create(from, {}), { code: 'invalid-document' });
+  });
+
+  test('accepts a document that holds the same value twice', () => {
+    const shared = { b: 1 };
+    assert.deepEqual(createPatch({ a: shared, c: shared }, { a: shared }), [
+      { op: 'remove', path: '/c' },
+    ]);
+  });
+
+  test('names the document and the place inside it', () => {
+    assert.throws(() => create({}, { a: { 'b/c': [new Date(0)] } }), {
+      message: 'Cannot create a JSON Patch: "to" is not a JSON value: a Date at "/a/b~1c/0"',
+    });
+    assert.throws(() => create({ a: [1n] }, {}), {
+      message: 'Cannot create a JSON Patch: "from" is not a JSON value: a bigint at "/a/0"',
+    });
+  });
+
+  test('names a document that is not a JSON value at all', () => {
+    assert.throws(() => create({}, undefined), {
+      message: 'Cannot create a JSON Patch: "to" is not a JSON value: undefined',
+    });
+  });
+
+  test('has no operation to blame', () => {
+    assert.throws(() => create({}, undefined), (error: unknown) => {
+      assert.ok(error instanceof Error && 'index' in error);
+      assert.equal(error.index, undefined);
+      return true;
+    });
+  });
+});
+
+describe('arrays too large to align exactly', () => {
+  // Beyond a million pairs of elements the alignment is given up on and the
+  // elements are compared by position, which still produces a patch that
+  // applies - the guarantee callers depend on.
+  test('still produces a patch that applies', () => {
+    const from = Array.from({ length: 1200 }, (_unused, index) => ({ id: index }));
+    const to = [{ id: -1 }, ...from.slice(0, 1199)];
+    const patch = createPatch(from, to);
+    assert.deepEqual(applyPatch(from, patch), to);
+  });
+
+  test('aligns a thousand elements exactly', () => {
+    const from = Array.from({ length: 1000 }, (_unused, index) => ({ id: index }));
+    const to = [{ id: -1 }, ...from.slice(0, 999)];
+    assert.deepEqual(createPatch(from, to), [
+      { op: 'add', path: '/0', value: { id: -1 } },
+      { op: 'remove', path: '/1000' },
+    ]);
+  });
+});
