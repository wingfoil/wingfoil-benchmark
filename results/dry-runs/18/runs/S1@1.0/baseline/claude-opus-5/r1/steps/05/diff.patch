index 0000000000000000000000000000000000000000..33ade418ddeb72f87e4720f7d62e3fde16f6b7a5
--- /dev/null
+++ b/src/create.ts
@@ -0,0 +1,315 @@
+/**
+ * Creation of JSON Patch documents from two JSON documents: the inverse
+ * direction of `applyPatch`, as specified in RFC 6902.
+ *
+ * The specification says what a patch means, not how to find one, and a pair of
+ * documents is turned into a patch by many patches: `[{ "op": "replace",
+ * "path": "", "value": to }]` already turns any document into any other. What
+ * makes a patch worth sending instead of the new document is that it names only
+ * the places where the two differ, so this module compares the documents
+ * structurally and emits an operation per difference.
+ */
+
+import {
+  cloneJson,
+  findNonJsonValue,
+  isJsonObject,
+  jsonEquals,
+  type JsonArray,
+  type JsonObject,
+  type JsonValue,
+} from './json.ts';
+import { JsonPatchError, type Operation, type Patch } from './patch.ts';
+import { formatPointer } from './pointer.ts';
+
+/**
+ * Returns a JSON Patch that turns `from` into `to` when applied, i.e. a patch
+ * for which `applyPatch(from, createPatch(from, to))` equals `to`.
+ *
+ * The patch describes the differences between the two documents and nothing
+ * else: equal members and equal array elements cost no operation and are not
+ * carried in it, however deep they are, so a change in one place of a large
+ * document is one small operation. Only `add`, `remove` and `replace` are used,
+ * each one with the pointer of the place it changes; `move` and `copy`, which
+ * could shorten a patch that relocates a value, are not looked for, and no
+ * `test` is added, so applying the patch to a document other than `from` does
+ * not fail on that account.
+ *
+ * `from` and `to` are left as they were, and the patch shares no object or array
+ * with either of them.
+ *
+ * @throws {JsonPatchError} if `from` or `to` is not a JSON value.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): Patch {
+  // Both documents have to belong to the JSON data model: an `undefined` or a
+  // Date in `to` would otherwise end up as the "value" of an operation, in a
+  // patch that is not a JSON document and that `applyPatch` rightly rejects,
+  // and one in `from` would make a difference appear or disappear depending on
+  // how it compares to a value no JSON document can hold.
+  requireDocument(from, 'from');
+  requireDocument(to, 'to');
+
+  const operations: Operation[] = [];
+  diff(from, to, [], operations);
+  return operations;
+}
+
+/**
+ * Appends the operations that turn `from` into `to` at the location that
+ * `tokens` names, which already holds `from`.
+ *
+ * Two values of the same kind of container are compared member by member or
+ * element by element, however deep the tree goes; anything else is a difference
+ * at this very location, and one "replace" settles it. A container is therefore
+ * never sent as a whole while it has a part in common with its counterpart.
+ */
+function diff(
+  from: JsonValue,
+  to: JsonValue,
+  tokens: string[],
+  operations: Operation[],
+): void {
+  if (Array.isArray(from) && Array.isArray(to)) {
+    diffArrays(from, to, tokens, operations);
+  } else if (isJsonObject(from) && isJsonObject(to)) {
+    diffObjects(from, to, tokens, operations);
+  } else if (!jsonEquals(from, to)) {
+    // Either the kinds differ - an array against an object, a number against a
+    // string - or two primitives do, and in both cases the whole location takes
+    // the new value. With the empty pointer, that is the document itself, which
+    // "replace" is allowed to take (RFC 6902 § 4.3).
+    operations.push({ op: 'replace', path: formatPointer(tokens), value: cloneJson(to) });
+  }
+}
+
+/** Compares two objects member by member. */
+function diffObjects(
+  from: JsonObject,
+  to: JsonObject,
+  tokens: string[],
+  operations: Operation[],
+): void {
+  // Only own members are members of a JSON object, here as everywhere else in
+  // the library: "__proto__" is the member of that name and nothing more.
+  for (const member of Object.keys(from)) {
+    tokens.push(member);
+    if (Object.hasOwn(to, member)) {
+      diff(from[member], to[member], tokens, operations);
+    } else {
+      operations.push({ op: 'remove', path: formatPointer(tokens) });
+    }
+    tokens.pop();
+  }
+  // The members only `to` has follow, in its own order. Against an object "add"
+  // creates the member, and removing the others first cannot have disturbed it:
+  // an object's members do not move when one of them goes.
+  for (const member of Object.keys(to)) {
+    if (!Object.hasOwn(from, member)) {
+      tokens.push(member);
+      operations.push({ op: 'add', path: formatPointer(tokens), value: cloneJson(to[member]) });
+      tokens.pop();
+    }
+  }
+}
+
+/**
+ * Compares two arrays element by element.
+ *
+ * An array is a sequence, not a mapping: inserting one element at the front
+ * moves every other one, and comparing the two arrays position by position
+ * would then find them different everywhere and send the whole array back. The
+ * elements are therefore aligned first, so that the ones the two arrays have in
+ * common are recognized wherever they sit, and only the insertions, the
+ * removals and the changes left over become operations.
+ */
+function diffArrays(
+  from: JsonArray,
+  to: JsonArray,
+  tokens: string[],
+  operations: Operation[],
+): void {
+  // The elements that both arrays begin and end with are common by position
+  // already, and leaving them out of the alignment keeps the usual change -
+  // one element added, removed or edited somewhere in a long array - linear.
+  let prefix = 0;
+  while (prefix < from.length && prefix < to.length && jsonEquals(from[prefix], to[prefix])) {
+    prefix++;
+  }
+  let suffix = 0;
+  while (
+    suffix < from.length - prefix &&
+    suffix < to.length - prefix &&
+    jsonEquals(from[from.length - 1 - suffix], to[to.length - 1 - suffix])
+  ) {
+    suffix++;
+  }
+  const removed = from.slice(prefix, from.length - suffix);
+  const added = to.slice(prefix, to.length - suffix);
+
+  // How many of the window's original elements are behind us, and how far the
+  // indices of the array being patched have drifted from those of `from`, as
+  // the operations before this one insert and remove elements in front of it.
+  // Together they turn a position in `from` into the index to write down now.
+  let cursor = 0;
+  let drift = 0;
+  for (const step of align(removed, added)) {
+    const index = (): string => String(prefix + cursor + drift);
+
+    switch (step.kind) {
+      case 'keep':
+        cursor++;
+        break;
+
+      case 'change':
+        // The elements are each other's counterparts but not equal, so the
+        // difference is looked for inside them, which costs nothing for the
+        // parts they share.
+        tokens.push(index());
+        diff(removed[step.from], added[step.to], tokens, operations);
+        tokens.pop();
+        cursor++;
+        break;
+
+      case 'remove':
+        tokens.push(index());
+        operations.push({ op: 'remove', path: formatPointer(tokens) });
+        tokens.pop();
+        cursor++;
+        drift--;
+        break;
+
+      case 'add':
+        // Against an array, "add" inserts before the index (RFC 6902 § 4.1),
+        // which is where this element belongs: in front of the next one of
+        // `from` that the alignment keeps.
+        tokens.push(index());
+        operations.push({ op: 'add', path: formatPointer(tokens), value: cloneJson(added[step.to]) });
+        tokens.pop();
+        drift++;
+        break;
+    }
+  }
+}
+
+/**
+ * One element of an alignment of two arrays, read in order:
+ *
+ * - `keep`: the elements are equal and need no operation.
+ * - `change`: the elements are counterparts to compare further.
+ * - `remove`: the element of the first array has no counterpart.
+ * - `add`: the element of the second array has no counterpart.
+ */
+type Step =
+  | { readonly kind: 'keep' | 'change'; readonly from: number; readonly to: number }
+  | { readonly kind: 'remove'; readonly from: number }
+  | { readonly kind: 'add'; readonly to: number };
+
+/**
+ * How large an alignment table may grow before `align` gives up on it. The
+ * table has a cell per pair of elements, so two arrays of a thousand elements
+ * that share neither a prefix nor a suffix are still aligned exactly, while
+ * anything beyond that is not worth the memory and the comparisons.
+ */
+const MAX_ALIGNMENT_CELLS = 1_000_000;
+
+/**
+ * Aligns the elements of two arrays, pairing equal ones wherever they sit and
+ * accounting for the rest with as few operations as it can.
+ *
+ * This is the usual edit distance, computed by dynamic programming over the
+ * suffixes of the two arrays: `cost[i][j]` is the smallest number of
+ * operations that turns `from[i..]` into `to[j..]`, counting one for an
+ * insertion, one for a removal and one for a pair of counterparts that are not
+ * equal. Equal elements are paired for nothing, so a common subsequence is
+ * always found and never sent again.
+ */
+function align(from: JsonArray, to: JsonArray): Step[] {
+  if (from.length === 0 || to.length === 0 || from.length * to.length > MAX_ALIGNMENT_CELLS) {
+    return pairInOrder(from, to);
+  }
+
+  const width = to.length + 1;
+  const cost = new Int32Array((from.length + 1) * width);
+  for (let i = from.length; i >= 0; i--) {
+    for (let j = to.length; j >= 0; j--) {
+      if (i === from.length) {
+        // Nothing left to turn into to[j..]: every element of it is added.
+        cost[i * width + j] = to.length - j;
+      } else if (j === to.length) {
+        cost[i * width + j] = from.length - i;
+      } else if (jsonEquals(from[i], to[j])) {
+        cost[i * width + j] = cost[(i + 1) * width + j + 1];
+      } else {
+        cost[i * width + j] =
+          1 +
+          Math.min(
+            cost[(i + 1) * width + j + 1],
+            cost[(i + 1) * width + j],
+            cost[i * width + j + 1],
+          );
+      }
+    }
+  }
+
+  // Walking the table from the front recovers one of the cheapest alignments.
+  // Where several are equally cheap, pairing the elements up is preferred over
+  // removing and adding them: a pair can still have something in common inside.
+  const steps: Step[] = [];
+  let i = 0;
+  let j = 0;
+  while (i < from.length || j < to.length) {
+    const here = cost[i * width + j];
+    if (i < from.length && j < to.length && jsonEquals(from[i], to[j])) {
+      steps.push({ kind: 'keep', from: i++, to: j++ });
+    } else if (i < from.length && j < to.length && here === 1 + cost[(i + 1) * width + j + 1]) {
+      steps.push({ kind: 'change', from: i++, to: j++ });
+    } else if (j < to.length && here === 1 + cost[i * width + j + 1]) {
+      steps.push({ kind: 'add', to: j++ });
+    } else {
+      steps.push({ kind: 'remove', from: i++ });
+    }
+  }
+  return steps;
+}
+
+/**
+ * Aligns two arrays by position, pairing them up as far as the shorter one
+ * reaches and accounting for the tail of the longer one.
+ *
+ * This is what `align` falls back on when one of the arrays is empty, where it
+ * is the only alignment there is, and when the table would be too large, where
+ * it is a guess: elements that merely moved are compared to whatever now sits
+ * at their position instead of being recognized.
+ */
+function pairInOrder(from: JsonArray, to: JsonArray): Step[] {
+  const steps: Step[] = [];
+  const paired = Math.min(from.length, to.length);
+  for (let index = 0; index < paired; index++) {
+    steps.push({ kind: 'change', from: index, to: index });
+  }
+  for (let index = paired; index < from.length; index++) {
+    steps.push({ kind: 'remove', from: index });
+  }
+  for (let index = paired; index < to.length; index++) {
+    steps.push({ kind: 'add', to: index });
+  }
+  return steps;
+}
+
+/** Checks that a document to compare is a JSON value, all the way down. */
+function requireDocument(document: JsonValue, name: 'from' | 'to'): void {
+  const nonJson = findNonJsonValue(document);
+  if (nonJson !== undefined) {
+    const where =
+      nonJson.tokens.length === 0 ? '' : ` at ${quote(formatPointer(nonJson.tokens))}`;
+    throw new JsonPatchError(
+      `Cannot create a JSON Patch: ${quote(name)} is not a JSON value: ${nonJson.description}${where}`,
+      'invalid-document',
+      undefined,
+    );
+  }
+}
+
+function quote(value: string): string {
+  return JSON.stringify(value);
+}
