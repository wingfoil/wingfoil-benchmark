index 0000000000000000000000000000000000000000..32fc0b997e242ab10884c8b6b44f8f60f8d714bf
--- /dev/null
+++ b/src/json.ts
@@ -0,0 +1,22 @@
+/**
+ * The JSON data model, as produced by `JSON.parse` and accepted by
+ * `JSON.stringify`.
+ */
+
+export type JsonPrimitive = string | number | boolean | null;
+
+export type JsonArray = JsonValue[];
+
+export interface JsonObject {
+  [member: string]: JsonValue;
+}
+
+export type JsonValue = JsonPrimitive | JsonArray | JsonObject;
+
+/**
+ * Narrows a JSON value to a JSON object, i.e. excludes `null`, arrays and
+ * primitives.
+ */
+export function isJsonObject(value: JsonValue): value is JsonObject {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
diff --git a/src/pointer.ts b/src/pointer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..162fe3f3b2ce50984dd5219906a72893953de528
--- /dev/null
+++ b/src/pointer.ts
@@ -0,0 +1,107 @@
+/**
+ * Syntax of JSON Pointer, as specified in RFC 6901.
+ *
+ * A JSON Pointer is a string made of zero or more reference tokens, each one
+ * prefixed by "/". Inside a token, "~" and "/" are escaped as "~0" and "~1"
+ * respectively; every other character stands for itself.
+ *
+ *     json-pointer    = *( "/" reference-token )
+ *     reference-token = *( unescaped / escaped )
+ *     unescaped       = %x00-2E / %x30-7D / %x7F-10FFFF
+ *     escaped         = "~" ( "0" / "1" )
+ *
+ * The URI fragment notation of RFC 6901 section 6 ("#/foo/0") is a different
+ * encoding of the same information and is not accepted here: callers holding a
+ * fragment should strip the "#" and percent-decode it first.
+ */
+
+/**
+ * Why a JSON Pointer operation failed.
+ *
+ * - `invalid-pointer`: the string is not a JSON Pointer at all.
+ * - `unresolved`: the pointer is well formed, but the document has no value
+ *   there.
+ */
+export type JsonPointerErrorCode = 'invalid-pointer' | 'unresolved';
+
+/** Raised when a JSON Pointer is malformed, or does not resolve. */
+export class JsonPointerError extends Error {
+  override readonly name = 'JsonPointerError';
+
+  /** The pointer that caused the failure. */
+  readonly pointer: string;
+
+  readonly code: JsonPointerErrorCode;
+
+  constructor(message: string, code: JsonPointerErrorCode, pointer: string) {
+    super(message);
+    this.code = code;
+    this.pointer = pointer;
+  }
+}
+
+/**
+ * Splits a JSON Pointer into its reference tokens, with the escape sequences
+ * resolved. The empty pointer, which refers to the whole document, yields an
+ * empty list.
+ *
+ * @throws {JsonPointerError} if `pointer` is not a valid JSON Pointer.
+ */
+export function parsePointer(pointer: string): string[] {
+  if (typeof pointer !== 'string') {
+    throw new JsonPointerError(
+      `A JSON Pointer must be a string, got ${describe(pointer)}`,
+      'invalid-pointer',
+      String(pointer),
+    );
+  }
+  if (pointer === '') {
+    return [];
+  }
+  if (!pointer.startsWith('/')) {
+    throw new JsonPointerError(
+      `Invalid JSON Pointer ${quote(pointer)}: a non-empty pointer must start with "/"`,
+      'invalid-pointer',
+      pointer,
+    );
+  }
+  // The leading "/" is a separator, not part of the first token, so dropping it
+  // keeps `split` from inventing an empty token in front.
+  return pointer
+    .slice(1)
+    .split('/')
+    .map((token) => unescapeToken(token, pointer));
+}
+
+/** Writes reference tokens back as a JSON Pointer string. */
+export function formatPointer(tokens: readonly string[]): string {
+  return tokens.map((token) => `/${escapeToken(token)}`).join('');
+}
+
+/** Escapes a member name or array index so it can be used as one token. */
+export function escapeToken(token: string): string {
+  return token.replaceAll('~', '~0').replaceAll('/', '~1');
+}
+
+function unescapeToken(token: string, pointer: string): string {
+  const stray = /~(?![01])/.exec(token);
+  if (stray !== null) {
+    const sequence = token.slice(stray.index, stray.index + 2);
+    throw new JsonPointerError(
+      `Invalid JSON Pointer ${quote(pointer)}: "~" must be followed by "0" or "1", got ${quote(sequence)}`,
+      'invalid-pointer',
+      pointer,
+    );
+  }
+  // "~1" has to be decoded before "~0", otherwise the "~" that "~01" decodes to
+  // would be read as the start of an escape sequence again (RFC 6901 § 4).
+  return token.replaceAll('~1', '/').replaceAll('~0', '~');
+}
+
+function quote(value: string): string {
+  return JSON.stringify(value);
+}
+
+function describe(value: unknown): string {
+  return value === null ? 'null' : typeof value;
+}
diff --git a/src/resolve.ts b/src/resolve.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9cf78b39fcd0c077dd722a34e8cace06a4c2a3aa
--- /dev/null
+++ b/src/resolve.ts
@@ -0,0 +1,89 @@
+/** Evaluation of JSON Pointers against a document, as specified in RFC 6901. */
+
+import { isJsonObject, type JsonPrimitive, type JsonValue } from './json.ts';
+import { formatPointer, JsonPointerError, parsePointer } from './pointer.ts';
+
+/** Array indices are decimal, without a sign and without leading zeros. */
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+/**
+ * Returns the value that `pointer` refers to in `document`.
+ *
+ * The empty pointer refers to the whole document. Every other pointer is
+ * evaluated one reference token at a time: against an object a token is a
+ * member name, against an array it is an element index.
+ *
+ * @throws {JsonPointerError} if `pointer` is not a valid JSON Pointer, or if it
+ * does not refer to a value of `document`.
+ */
+export function resolvePointer(document: JsonValue, pointer: string): JsonValue {
+  const tokens = parsePointer(pointer);
+  let value = document;
+  for (let depth = 0; depth < tokens.length; depth++) {
+    value = step(value, tokens, depth, pointer);
+  }
+  return value;
+}
+
+/**
+ * Takes the single step from `parent`, the value that the first `depth` tokens
+ * refer to, to the value that the token after them refers to.
+ */
+function step(
+  parent: JsonValue,
+  tokens: readonly string[],
+  depth: number,
+  pointer: string,
+): JsonValue {
+  const token = tokens[depth];
+  const unresolved = (detail: string): JsonPointerError =>
+    new JsonPointerError(
+      `JSON Pointer ${quote(pointer)} does not resolve: ${detail}`,
+      'unresolved',
+      pointer,
+    );
+  /** How to name `parent` in an error message; only built when one is needed. */
+  const location = (): string =>
+    depth === 0 ? 'the document' : `the value at ${quote(formatPointer(tokens.slice(0, depth)))}`;
+
+  if (Array.isArray(parent)) {
+    if (token === '-') {
+      // A valid token, but it denotes the position after the last element,
+      // which never holds a value (RFC 6901 § 4).
+      throw unresolved(`${location()} is an array and has no element after the last one ("-")`);
+    }
+    if (!ARRAY_INDEX.test(token)) {
+      throw unresolved(`${location()} is an array and ${quote(token)} is not an element index`);
+    }
+    const index = Number(token);
+    if (index >= parent.length) {
+      throw unresolved(
+        `${location()} is an array of ${count(parent.length, 'element')} and has no element ${index}`,
+      );
+    }
+    return parent[index];
+  }
+
+  if (isJsonObject(parent)) {
+    // Only own members count: inherited properties such as "constructor" or
+    // "toString" are not members of the JSON object.
+    if (!Object.hasOwn(parent, token)) {
+      throw unresolved(`${location()} has no member ${quote(token)}`);
+    }
+    return parent[token];
+  }
+
+  throw unresolved(`${location()} is ${describe(parent)} and has no member ${quote(token)}`);
+}
+
+function count(amount: number, noun: string): string {
+  return `${amount} ${noun}${amount === 1 ? '' : 's'}`;
+}
+
+function quote(value: string): string {
+  return JSON.stringify(value);
+}
+
+function describe(value: JsonPrimitive): string {
+  return value === null ? 'null' : `a ${typeof value}`;
+}
diff --git a/test/resolve-pointer.test.ts b/test/resolve-pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..38a57453e467bf08a4b9324a839f97689420f891
--- /dev/null
+++ b/test/resolve-pointer.test.ts
@@ -0,0 +1,248 @@
+import assert from 'node:assert/strict';
+import test, { describe } from 'node:test';
+
+import { JsonPointerError, resolvePointer, type JsonValue } from '../src/index.ts';
+
+/** The example document of RFC 6901 § 5. */
+const rfcExample: JsonValue = JSON.parse(String.raw`{
+  "foo": ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  "k\"l": 6,
+  " ": 7,
+  "m~n": 8
+}`);
+
+describe('the pointers of RFC 6901 § 5', () => {
+  const expected: Array<[pointer: string, value: JsonValue]> = [
+    ['', rfcExample],
+    ['/foo', ['bar', 'baz']],
+    ['/foo/0', 'bar'],
+    ['/', 0],
+    ['/a~1b', 1],
+    ['/c%d', 2],
+    ['/e^f', 3],
+    ['/g|h', 4],
+    ['/i\\j', 5],
+    ['/k"l', 6],
+    ['/ ', 7],
+    ['/m~0n', 8],
+  ];
+
+  for (const [pointer, value] of expected) {
+    test(`${JSON.stringify(pointer)} resolves to ${JSON.stringify(value)}`, () => {
+      assert.deepEqual(resolvePointer(rfcExample, pointer), value);
+    });
+  }
+});
+
+describe('resolving', () => {
+  test('returns the whole document for the empty pointer', () => {
+    const document = { a: [1] };
+    assert.equal(resolvePointer(document, ''), document);
+  });
+
+  test('walks objects and arrays to any depth', () => {
+    const document = { a: [{ b: [{ c: 'there' }, { c: 'here' }] }] };
+    assert.equal(resolvePointer(document, '/a/0/b/1/c'), 'here');
+  });
+
+  test('returns the value itself, not a copy', () => {
+    const inner = { b: 1 };
+    assert.equal(resolvePointer({ a: [inner] }, '/a/0'), inner);
+  });
+
+  test('distinguishes an escaped "/" from a separator', () => {
+    const document = { 'a/b': 'escaped', a: { b: 'nested' } };
+    assert.equal(resolvePointer(document, '/a~1b'), 'escaped');
+    assert.equal(resolvePointer(document, '/a/b'), 'nested');
+  });
+
+  test('decodes "~1" before "~0", so "~01" is the member "~1"', () => {
+    assert.equal(resolvePointer({ '~1': 'tilde-one' }, '/~01'), 'tilde-one');
+  });
+
+  test('accepts the empty string as a member name', () => {
+    assert.equal(resolvePointer({ '': { '': 'twice' } }, '//'), 'twice');
+  });
+
+  test('accepts members that look like something else', () => {
+    const document = { 0: 'digit', '-': 'dash', length: 'length', ' 1': 'padded' };
+    assert.equal(resolvePointer(document, '/0'), 'digit');
+    assert.equal(resolvePointer(document, '/-'), 'dash');
+    assert.equal(resolvePointer(document, '/length'), 'length');
+    assert.equal(resolvePointer(document, '/ 1'), 'padded');
+  });
+
+  test('accepts control characters and astral characters in member names', () => {
+    const document = { '\u0000': 'nul', 'a\nb': 'newline', '🔑': 'emoji' };
+    assert.equal(resolvePointer(document, '/\u0000'), 'nul');
+    assert.equal(resolvePointer(document, '/a\nb'), 'newline');
+    assert.equal(resolvePointer(document, '/🔑'), 'emoji');
+  });
+
+  test('resolves falsy values rather than reporting them as missing', () => {
+    const document = { a: null, b: false, c: 0, d: '', e: [] };
+    assert.equal(resolvePointer(document, '/a'), null);
+    assert.equal(resolvePointer(document, '/b'), false);
+    assert.equal(resolvePointer(document, '/c'), 0);
+    assert.equal(resolvePointer(document, '/d'), '');
+    assert.deepEqual(resolvePointer(document, '/e'), []);
+  });
+
+  test('resolves the empty pointer against a document that is a primitive', () => {
+    assert.equal(resolvePointer(null, ''), null);
+    assert.equal(resolvePointer(42, ''), 42);
+  });
+
+  test('resolves the last element of an array', () => {
+    assert.equal(resolvePointer(['a', 'b', 'c'], '/2'), 'c');
+  });
+});
+
+describe('own members only', () => {
+  test('rejects inherited properties of Object.prototype', () => {
+    const document = { a: 1 };
+    for (const pointer of ['/__proto__', '/constructor', '/toString', '/hasOwnProperty']) {
+      assert.throws(() => resolvePointer(document, pointer), { code: 'unresolved' }, pointer);
+    }
+  });
+
+  test('rejects properties inherited from another object', () => {
+    const document = Object.create({ inherited: 'no' }) as Record<string, JsonValue>;
+    document.own = 'yes';
+    assert.equal(resolvePointer(document, '/own'), 'yes');
+    assert.throws(() => resolvePointer(document, '/inherited'), { code: 'unresolved' });
+  });
+
+  test('resolves an own member named "__proto__"', () => {
+    const document: JsonValue = JSON.parse('{"__proto__": {"a": 1}}');
+    assert.deepEqual(resolvePointer(document, '/__proto__'), { a: 1 });
+    assert.equal(resolvePointer(document, '/__proto__/a'), 1);
+  });
+
+  test('rejects array properties that are not element indices', () => {
+    for (const pointer of ['/length', '/0.0', '/push', '/-1', '/1e0']) {
+      assert.throws(() => resolvePointer(['a', 'b'], pointer), { code: 'unresolved' }, pointer);
+    }
+  });
+});
+
+describe('invalid pointers', () => {
+  const invalid = [
+    'foo',
+    'foo/bar',
+    '0',
+    '#',
+    '#/foo',
+    ' /foo',
+    '/~',
+    '/~2',
+    '/~~0',
+    '/a~b',
+    '/foo/~',
+    '/~0~',
+  ];
+
+  for (const pointer of invalid) {
+    test(`${JSON.stringify(pointer)} is not a JSON Pointer`, () => {
+      assert.throws(() => resolvePointer(rfcExample, pointer), {
+        name: 'JsonPointerError',
+        code: 'invalid-pointer',
+        pointer,
+      });
+    });
+  }
+
+  test('a pointer must be a string', () => {
+    for (const pointer of [undefined, null, 0, ['a'], {}]) {
+      assert.throws(
+        () => resolvePointer(rfcExample, pointer as unknown as string),
+        { code: 'invalid-pointer' },
+        String(pointer),
+      );
+    }
+  });
+
+  test('syntax is checked before the document is walked', () => {
+    // "/a" resolves, so only the malformed second token can be the complaint.
+    assert.throws(() => resolvePointer({ a: { b: 1 } }, '/a/~'), { code: 'invalid-pointer' });
+  });
+});
+
+describe('pointers that do not resolve', () => {
+  const unresolved: Array<[document: JsonValue, pointer: string]> = [
+    [{ a: 1 }, '/b'],
+    [{ a: 1 }, '/'],
+    [{ a: { b: 1 } }, '/a/c'],
+    [{ a: 1 }, '/a/b'],
+    [{ a: 'text' }, '/a/0'],
+    [{ a: null }, '/a/b'],
+    [null, '/a'],
+    [42, '/a'],
+    [true, '/0'],
+    ['text', '/0'],
+    [[], '/0'],
+    [['a'], '/1'],
+    [['a'], '/01'],
+    [['a'], '/+0'],
+    [['a'], '/ 0'],
+    [['a'], '/0 '],
+    [['a'], '/'],
+    [['a'], '/99999999999999999999'],
+    [{ a: ['b'] }, '/a/1'],
+  ];
+
+  for (const [document, pointer] of unresolved) {
+    test(`${JSON.stringify(pointer)} in ${JSON.stringify(document)}`, () => {
+      assert.throws(() => resolvePointer(document, pointer), {
+        name: 'JsonPointerError',
+        code: 'unresolved',
+        pointer,
+      });
+    });
+  }
+
+  test('"-" never resolves, even on a non-empty array', () => {
+    assert.throws(() => resolvePointer(['a', 'b'], '/-'), { code: 'unresolved' });
+  });
+});
+
+describe('errors', () => {
+  test('are JsonPointerError instances carrying the pointer', () => {
+    let error: unknown;
+    try {
+      resolvePointer({}, '/a/b');
+    } catch (thrown) {
+      error = thrown;
+    }
+    assert.ok(error instanceof JsonPointerError);
+    assert.ok(error instanceof Error);
+    assert.equal(error.name, 'JsonPointerError');
+    assert.equal(error.code, 'unresolved');
+    assert.equal(error.pointer, '/a/b');
+  });
+
+  test('say where in the document the walk stopped', () => {
+    assert.throws(() => resolvePointer({ 'a/b': { c: [] } }, '/a~1b/c/0'), {
+      message:
+        'JSON Pointer "/a~1b/c/0" does not resolve: the value at "/a~1b/c" is an array of 0 elements and has no element 0',
+    });
+  });
+
+  test('report a malformed escape sequence', () => {
+    assert.throws(() => resolvePointer({}, '/a~x'), {
+      message: 'Invalid JSON Pointer "/a~x": "~" must be followed by "0" or "1", got "~x"',
+    });
+  });
+
+  test('report a missing leading "/"', () => {
+    assert.throws(() => resolvePointer({}, 'a'), {
+      message: 'Invalid JSON Pointer "a": a non-empty pointer must start with "/"',
+    });
+  });
+});
