@@ -0,0 +1,48 @@
+/**
+ * The shape of a JSON Merge Patch document, as specified in RFC 7386.
+ *
+ * A merge patch is not a list of operations but a JSON document that looks like
+ * the document it updates: each of its members gives the new value of the member
+ * of that name, and `null` asks for that member to be removed. Anything that is
+ * not an object - an array, a string, a number, a boolean, `null` - replaces
+ * what it is applied to outright, which is why a merge patch can describe no
+ * change that sets a member to `null`, and none that touches a single element of
+ * an array (RFC 7386 § 1).
+ *
+ *     target  { "a": "b", "c": { "d": "e", "f": "g" } }
+ *     patch   { "a": "z", "c": { "f": null } }
+ *     result  { "a": "z", "c": { "d": "e" } }
+ */
+
+import type { JsonValue } from './json.ts';
+
+/**
+ * A JSON Merge Patch document: the members to set, with `null` for the ones to
+ * remove. Any JSON value is a merge patch, so this is the JSON data model
+ * itself, named for what it is used as.
+ */
+export type MergePatch = JsonValue;
+
+/**
+ * Why applying a JSON Merge Patch failed.
+ *
+ * - `invalid-patch`: the patch is not a well-formed JSON Merge Patch document,
+ *   no matter which document it is applied to.
+ *
+ * Applying a well-formed merge patch cannot fail: every merge patch describes a
+ * change to every document, so there is no location it could fail to find and
+ * no condition it could test.
+ */
+export type JsonMergePatchErrorCode = 'invalid-patch';
+
+/** Raised when a JSON Merge Patch is malformed. */
+export class JsonMergePatchError extends Error {
+  override readonly name = 'JsonMergePatchError';
+
+  readonly code: JsonMergePatchErrorCode;
+
+  constructor(message: string, code: JsonMergePatchErrorCode, options?: ErrorOptions) {
+    super(message, options);
+    this.code = code;
+  }
+}
