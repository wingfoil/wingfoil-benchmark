diff --git a/src/index.ts b/src/index.ts
index 2ee43aacd67b360edf8227d9bb2a25a8ae7de461..46fe6c757b939efe9c7780c50ef8ee7e52f8c7e3 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -239,3 +239,21 @@ export function applyPatch(document: JsonValue, patch: PatchOperation[]): JsonVa
   }
   return doc;
 }
+
+/**
+ * Applies a JSON Merge Patch (RFC 7386) to a target document and returns the merged document.
+ * The inputs are not mutated.
+ */
+export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue {
+  if (!isObject(patch)) return clone(patch);
+  const result = (isObject(target) ? clone(target) : {}) as { [key: string]: JsonValue };
+  for (const key of Object.keys(patch)) {
+    const value = patch[key];
+    if (value === null) {
+      delete result[key];
+    } else {
+      setMember(result, key, applyMergePatch(has(result, key) ? result[key] : {}, value));
+    }
+  }
+  return result;
+}
diff --git a/test/mergepatch.test.ts b/test/mergepatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..236b28da132f5cea9d38f57003f239f729dbc03d
--- /dev/null
+++ b/test/mergepatch.test.ts
@@ -0,0 +1,24 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { applyMergePatch } from "../src/index.ts";
+
+test("merge patch: RFC 7386 example", () => {
+  const t = { title: "Goodbye!", author: { givenName: "John", familyName: "Doe" }, tags: ["a", "b"], content: "x" };
+  const p = { title: "Hello!", phoneNumber: "+01", author: { familyName: null }, tags: ["c"] };
+  assert.deepEqual(applyMergePatch(t, p), {
+    title: "Hello!", author: { givenName: "John" }, tags: ["c"], content: "x", phoneNumber: "+01",
+  });
+});
+
+test("merge patch: non-object patch replaces; nulls stripped in new objects", () => {
+  assert.deepEqual(applyMergePatch({ a: 1 }, ["x"]), ["x"]);
+  assert.deepEqual(applyMergePatch(["x"], { a: { b: null, c: 1 } }), { a: { c: 1 } });
+  assert.equal(applyMergePatch({ a: 1 }, null), null);
+});
+
+test("merge patch: no mutation or prototype pollution", () => {
+  const t = { a: { b: 1 } };
+  applyMergePatch(t, JSON.parse('{"a":{"b":2},"__proto__":{"x":1}}'));
+  assert.deepEqual(t, { a: { b: 1 } });
+  assert.equal(({} as any).x, undefined);
+});
