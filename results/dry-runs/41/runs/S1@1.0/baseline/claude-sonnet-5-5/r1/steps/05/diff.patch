--- /dev/null
+++ b/test/createpatch.test.ts
@@ -0,0 +1,39 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createPatch, applyPatch, type JsonValue } from "../src/index.ts";
+
+const roundTrip = (a: JsonValue, b: JsonValue) => {
+  const ca = structuredClone(a);
+  const cb = structuredClone(b);
+  const p = createPatch(a, b);
+  assert.deepEqual(a, ca);
+  assert.deepEqual(b, cb);
+  assert.deepEqual(applyPatch(a, p), b);
+  return p;
+};
+
+test("minimal object change", () => {
+  const p = roundTrip({ a: { b: 1, c: [1, 2, 3] }, d: "x" }, { a: { b: 2, c: [1, 2, 3] }, d: "x" });
+  assert.deepEqual(p, [{ op: "replace", path: "/a/b", value: 2 }]);
+});
+
+test("empty patch when equal", () => {
+  assert.deepEqual(roundTrip({ a: [1] }, { a: [1] }), []);
+});
+
+test("escaping, add, remove", () => {
+  roundTrip({ "a/b": 1, "~": 2 }, { "a/b": 1, "m~n": 3 });
+});
+
+test("arrays", () => {
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2, 9, 3, 4]), [{ op: "add", path: "/2", value: 9 }]);
+  roundTrip([1, 2, 3, 4], [1, 4]);
+  roundTrip([[1], [2]], [[1, 5], [3], [4]]);
+  roundTrip([], [1, 2]);
+});
+
+test("type changes and root", () => {
+  roundTrip(1, { a: 1 });
+  roundTrip({ a: null }, { a: [] });
+  roundTrip([1], { 0: 1 });
+});
