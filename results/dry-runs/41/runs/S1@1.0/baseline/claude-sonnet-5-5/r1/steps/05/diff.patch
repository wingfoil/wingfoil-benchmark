@@ -257,3 +257,52 @@ export function applyMergePatch(target: JsonValue, patch: JsonValue): JsonValue
   }
   return result;
 }
+
+const escapeToken = (t: string) => t.replace(/~/g, "~0").replace(/\//g, "~1");
+
+function diffInto(from: JsonValue, to: JsonValue, path: string, ops: PatchOperation[]): void {
+  if (equal(from, to)) return;
+  if (Array.isArray(from) && Array.isArray(to)) {
+    let start = 0;
+    while (start < from.length && start < to.length && equal(from[start], to[start])) start++;
+    let endFrom = from.length;
+    let endTo = to.length;
+    while (endFrom > start && endTo > start && equal(from[endFrom - 1], to[endTo - 1])) {
+      endFrom--;
+      endTo--;
+    }
+    const oldLen = endFrom - start;
+    const newLen = endTo - start;
+    const common = Math.min(oldLen, newLen);
+    for (let i = 0; i < common; i++) {
+      diffInto(from[start + i], to[start + i], `${path}/${start + i}`, ops);
+    }
+    for (let i = oldLen; i > newLen; i--) {
+      ops.push({ op: "remove", path: `${path}/${start + newLen}` });
+    }
+    for (let i = oldLen; i < newLen; i++) {
+      ops.push({ op: "add", path: `${path}/${start + i}`, value: clone(to[start + i]) });
+    }
+  } else if (isObject(from) && isObject(to)) {
+    for (const key of Object.keys(from)) {
+      if (!has(to, key)) ops.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+    for (const key of Object.keys(to)) {
+      const child = `${path}/${escapeToken(key)}`;
+      if (!has(from, key)) ops.push({ op: "add", path: child, value: clone(to[key]) });
+      else diffInto(from[key], to[key], child, ops);
+    }
+  } else {
+    ops.push({ op: "replace", path, value: clone(to) });
+  }
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns `from` into `to` when applied, describing only
+ * the parts that differ. The inputs are not mutated and the patch shares no structure with them.
+ */
+export function createPatch(from: JsonValue, to: JsonValue): PatchOperation[] {
+  const ops: PatchOperation[] = [];
+  diffInto(from, to, "", ops);
+  return ops;
+}
