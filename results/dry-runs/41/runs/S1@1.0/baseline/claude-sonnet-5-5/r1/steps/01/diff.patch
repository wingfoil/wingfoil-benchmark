--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,58 @@
+export type JsonValue =
+  | null
+  | boolean
+  | number
+  | string
+  | JsonValue[]
+  | { [key: string]: JsonValue };
+
+const ARRAY_INDEX = /^(?:0|[1-9][0-9]*)$/;
+
+function unescapeToken(token: string): string {
+  if (/~(?![01])/.test(token)) {
+    throw new Error(`Invalid JSON Pointer: bad escape in token "${token}"`);
+  }
+  // Single pass so that "~01" becomes "~1" and not "/".
+  return token.replace(/~([01])/g, (_, c: string) => (c === "0" ? "~" : "/"));
+}
+
+/**
+ * Resolves a JSON Pointer (RFC 6901, string representation) against a document.
+ * Throws if the pointer is syntactically invalid or does not refer to a value.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (typeof pointer !== "string") {
+    throw new Error("Invalid JSON Pointer: must be a string");
+  }
+  if (pointer === "") return document;
+  if (pointer[0] !== "/") {
+    throw new Error('Invalid JSON Pointer: must be empty or start with "/"');
+  }
+
+  const tokens = pointer.slice(1).split("/").map(unescapeToken);
+  let current: unknown = document;
+  for (const token of tokens) {
+    if (Array.isArray(current)) {
+      if (!ARRAY_INDEX.test(token)) {
+        throw new Error(
+          token === "-"
+            ? 'JSON Pointer "-" refers to a nonexistent array element'
+            : `JSON Pointer token "${token}" is not a valid array index`,
+        );
+      }
+      const index = Number(token);
+      if (index >= current.length) {
+        throw new Error(`JSON Pointer index ${token} is out of bounds`);
+      }
+      current = current[index];
+    } else if (typeof current === "object" && current !== null) {
+      if (!Object.prototype.hasOwnProperty.call(current, token)) {
+        throw new Error(`JSON Pointer key "${token}" not found`);
+      }
+      current = (current as Record<string, unknown>)[token];
+    } else {
+      throw new Error(`JSON Pointer cannot descend into a primitive at "${token}"`);
+    }
+  }
+  return current;
+}
diff --git a/test/pointer.test.ts b/test/pointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..66742dc871c8d452d33254aa1ec0e09453924850
--- /dev/null
+++ b/test/pointer.test.ts
@@ -0,0 +1,53 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { resolvePointer } from "../src/index.ts";
+
+const doc = {
+  foo: ["bar", "baz"],
+  "": 0,
+  "a/b": 1,
+  "c%d": 2,
+  "e^f": 3,
+  "g|h": 4,
+  "i\\j": 5,
+  'k"l': 6,
+  " ": 7,
+  "m~n": 8,
+  "~1": 9,
+  nul: null,
+};
+
+test("RFC 6901 examples", () => {
+  assert.equal(resolvePointer(doc, ""), doc);
+  assert.deepEqual(resolvePointer(doc, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(doc, "/foo/0"), "bar");
+  assert.equal(resolvePointer(doc, "/"), 0);
+  assert.equal(resolvePointer(doc, "/a~1b"), 1);
+  assert.equal(resolvePointer(doc, "/c%d"), 2);
+  assert.equal(resolvePointer(doc, "/e^f"), 3);
+  assert.equal(resolvePointer(doc, "/g|h"), 4);
+  assert.equal(resolvePointer(doc, "/i\\j"), 5);
+  assert.equal(resolvePointer(doc, '/k"l'), 6);
+  assert.equal(resolvePointer(doc, "/ "), 7);
+  assert.equal(resolvePointer(doc, "/m~0n"), 8);
+});
+
+test("escape order", () => {
+  assert.equal(resolvePointer(doc, "/~01"), 9);
+});
+
+test("null values resolve", () => {
+  assert.equal(resolvePointer(doc, "/nul"), null);
+});
+
+test("invalid pointers throw", () => {
+  for (const p of ["foo", "#/foo", "/m~n", "/a~2", "/~"]) {
+    assert.throws(() => resolvePointer(doc, p), p);
+  }
+});
+
+test("unresolvable pointers throw", () => {
+  for (const p of ["/missing", "/foo/2", "/foo/-", "/foo/01", "/foo/+1", "/foo/1.0", "/foo/x", "/foo/0/x", "/nul/x", "/__proto__", "/constructor", "/foo/length"]) {
+    assert.throws(() => resolvePointer(doc, p), p);
+  }
+});
