+test('quotes and books whole-hour rentals shorter than a day at the hourly price', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500, hourlyPrice: 700 });
+  rentals.addEquipment({ id: 'daily-only', kind: 'board', dailyPrice: 2_500 });
+
+  const request = {
+    itemId: 'board-1',
+    start: '2026-06-01T13:00:00.000Z',
+    end: '2026-06-01T17:00:00.000Z',
+  };
+
+  assert.deepEqual(rentals.quote(request), { ...request, total: 2_800 });
+  assert.deepEqual(rentals.book(request), { id: 'booking-1', ...request, total: 2_800 });
+  assert.deepEqual(rentals.availability({
+    start: '2026-06-01T17:00:00.000Z',
+    end: '2026-06-01T18:00:00.000Z',
+  }), ['board-1']);
+});
+
+test('rejects invalid or unsupported hourly rentals', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'daily-only', kind: 'board', dailyPrice: 2_500 });
+  rentals.addEquipment({ id: 'hourly', kind: 'board', dailyPrice: 2_500, hourlyPrice: 700 });
+
+  assert.throws(() => rentals.quote({
+    itemId: 'daily-only',
+    start: '2026-06-01T13:00:00.000Z',
+    end: '2026-06-01T14:00:00.000Z',
+  }));
+  assert.throws(() => rentals.quote({
+    itemId: 'hourly',
+    start: '2026-06-01T13:30:00.000Z',
+    end: '2026-06-01T14:00:00.000Z',
+  }));
+  assert.throws(() => rentals.quote({
+    itemId: 'hourly',
+    start: '2026-06-01T13:00:00.000Z',
+    end: '2026-06-02T13:00:00.000Z',
+  }));
+});
+
