+++ b/src/index.ts
@@ -0,0 +1,174 @@
+/** A piece of equipment that can be rented by the day. */
+export interface Equipment {
+  /** Stable identifier for this equipment. */
+  id: string;
+  /** Equipment category supported by the school. */
+  kind: 'board' | 'sail';
+  /** Daily rental price, expressed as an integer number of euro cents. */
+  dailyPrice: number;
+}
+
+/** A requested rental period, with an exclusive end at midnight UTC. */
+export interface RentalRequest {
+  /** Identifier of the equipment to rent. */
+  itemId: string;
+  /** ISO-8601 UTC timestamp for the first rental day at midnight. */
+  start: string;
+  /** ISO-8601 UTC timestamp at midnight after the last rental day. */
+  end: string;
+}
+
+/** The price for a valid rental period. */
+export interface RentalQuote extends RentalRequest {
+  /** Total rental price, expressed as an integer number of euro cents. */
+  total: number;
+}
+
+/** A confirmed rental booking. */
+export interface RentalBooking extends RentalQuote {
+  /** Service-generated identifier for this booking. */
+  id: string;
+}
+
+/** In-memory operations available to the booking desk. */
+export interface RentalService {
+  /** Adds equipment that can subsequently be quoted or booked. */
+  addEquipment(item: Equipment): void;
+  /** Calculates the price for a valid rental period. */
+  quote(request: RentalRequest): RentalQuote;
+  /** Creates a booking when the equipment is available for the entire period. */
+  book(request: RentalRequest): RentalBooking;
+}
+
+interface ValidatedRental extends RentalQuote {
+  startTime: number;
+  endTime: number;
+}
+
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1_000;
+const UTC_MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00:00(?:\.0{1,3})?Z$/;
+
+/**
+ * Creates an isolated, in-memory rental service.
+ *
+ * Booking identifiers are assigned in creation order. Data is retained only by
+ * the returned service instance.
+ */
+export function createRentalService(): RentalService {
+  const equipment = new Map<string, Equipment>();
+  const bookings: Array<RentalBooking & { startTime: number; endTime: number }> = [];
+  let nextBookingNumber = 1;
+
+  function addEquipment(item: Equipment): void {
+    validateEquipment(item);
+    if (equipment.has(item.id)) {
+      throw new Error(`Equipment with id "${item.id}" already exists.`);
+    }
+
+    equipment.set(item.id, { ...item });
+  }
+
+  function quote(request: RentalRequest): RentalQuote {
+    const rental = validateRental(request);
+    return toQuote(rental);
+  }
+
+  function book(request: RentalRequest): RentalBooking {
+    const rental = validateRental(request);
+    if (bookings.some((booking) => booking.itemId === rental.itemId && periodsOverlap(booking, rental))) {
+      throw new Error(`Equipment with id "${rental.itemId}" is not available for this period.`);
+    }
+
+    const booking: RentalBooking & { startTime: number; endTime: number } = {
+      id: `booking-${nextBookingNumber}`,
+      ...rental,
+    };
+    nextBookingNumber += 1;
+    bookings.push(booking);
+    return toBooking(booking);
+  }
+
+  function validateRental(request: RentalRequest): ValidatedRental {
+    validateRequest(request);
+    const item = equipment.get(request.itemId);
+    if (item === undefined) {
+      throw new Error(`Equipment with id "${request.itemId}" does not exist.`);
+    }
+
+    const startTime = parseUtcMidnight(request.start, 'start');
+    const endTime = parseUtcMidnight(request.end, 'end');
+    if (endTime <= startTime) {
+      throw new Error('The rental end must be after its start.');
+    }
+
+    const days = (endTime - startTime) / DAY_IN_MILLISECONDS;
+    const total = days * item.dailyPrice;
+    if (!Number.isSafeInteger(total)) {
+      throw new Error('The rental total is outside the supported money range.');
+    }
+
+    return { ...request, total, startTime, endTime };
+  }
+
+  return { addEquipment, quote, book };
+}
+
+function validateEquipment(item: Equipment): void {
+  if (!isRecord(item) || typeof item.id !== 'string') {
+    throw new Error('Equipment id must be a string.');
+  }
+  if (item.kind !== 'board' && item.kind !== 'sail') {
+    throw new Error('Equipment kind must be either "board" or "sail".');
+  }
+  if (!Number.isSafeInteger(item.dailyPrice) || item.dailyPrice < 0) {
+    throw new Error('Equipment dailyPrice must be a non-negative integer number of euro cents.');
+  }
+}
+
+function validateRequest(request: RentalRequest): void {
+  if (!isRecord(request) || typeof request.itemId !== 'string') {
+    throw new Error('Rental itemId must be a string.');
+  }
+  if (typeof request.start !== 'string' || typeof request.end !== 'string') {
+    throw new Error('Rental start and end must be ISO-8601 strings.');
+  }
+}
+
+function parseUtcMidnight(value: string, field: 'start' | 'end'): number {
+  if (!UTC_MIDNIGHT.test(value)) {
+    throw new Error(`Rental ${field} must be an ISO-8601 UTC midnight.`);
+  }
+
+  const time = Date.parse(value);
+  if (Number.isNaN(time) || new Date(time).toISOString().slice(0, 10) !== value.slice(0, 10)) {
+    throw new Error(`Rental ${field} is not a valid ISO-8601 timestamp.`);
+  }
+  return time;
+}
+
+function periodsOverlap(
+  left: Pick<ValidatedRental, 'startTime' | 'endTime'>,
+  right: Pick<ValidatedRental, 'startTime' | 'endTime'>,
+): boolean {
+  return left.startTime < right.endTime && right.startTime < left.endTime;
+}
+
+function toQuote(rental: RentalQuote): RentalQuote {
+  return {
+    itemId: rental.itemId,
+    start: rental.start,
+    end: rental.end,
+    total: rental.total,
+  };
+}
+
+function toBooking(booking: RentalBooking): RentalBooking {
+  return {
+    id: booking.id,
+    ...toQuote(booking),
+  };
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null;
+}
diff --git a/test/rental-service.test.mjs b/test/rental-service.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b2c451b625abe431251e0f24358e2ecc0fe4d92f
--- /dev/null
+++ b/test/rental-service.test.mjs
@@ -0,0 +1,77 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { createRentalService } from '../dist/index.js';
+
+test('quotes and books a whole-day rental in euro cents', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+
+  const request = {
+    itemId: 'board-1',
+    start: '2026-06-01T00:00:00.000Z',
+    end: '2026-06-04T00:00:00.000Z',
+  };
+
+  assert.deepEqual(rentals.quote(request), { ...request, total: 7_500 });
+  assert.deepEqual(rentals.book(request), { id: 'booking-1', ...request, total: 7_500 });
+});
+
+test('rejects unknown equipment and periods that are not whole days', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1_800 });
+
+  assert.throws(() => rentals.quote({
+    itemId: 'missing',
+    start: '2026-06-01T00:00:00.000Z',
+    end: '2026-06-02T00:00:00.000Z',
+  }));
+  assert.throws(() => rentals.quote({
+    itemId: 'sail-1',
+    start: '2026-06-01T12:00:00.000Z',
+    end: '2026-06-02T00:00:00.000Z',
+  }));
+  assert.throws(() => rentals.quote({
+    itemId: 'sail-1',
+    start: '2026-06-02T00:00:00.000Z',
+    end: '2026-06-02T00:00:00.000Z',
+  }));
+});
+
+test('validates equipment identifiers, kinds, and integer-cent prices', () => {
+  const rentals = createRentalService();
+
+  assert.throws(() => rentals.addEquipment({ id: 'foil-1', kind: 'foil', dailyPrice: 2_000 }));
+  assert.throws(() => rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 12.5 }));
+
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 0 });
+  assert.throws(() => rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_000 }));
+});
+
+test('prevents overlapping bookings but allows adjacent bookings', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+
+  rentals.book({
+    itemId: 'board-1',
+    start: '2026-06-02T00:00:00.000Z',
+    end: '2026-06-05T00:00:00.000Z',
+  });
+
+  assert.throws(() => rentals.book({
+    itemId: 'board-1',
+    start: '2026-06-04T00:00:00.000Z',
+    end: '2026-06-06T00:00:00.000Z',
+  }));
+  assert.deepEqual(rentals.book({
+    itemId: 'board-1',
+    start: '2026-06-05T00:00:00.000Z',
+    end: '2026-06-06T00:00:00.000Z',
+  }), {
+    id: 'booking-2',
+    itemId: 'board-1',
+    start: '2026-06-05T00:00:00.000Z',
+    end: '2026-06-06T00:00:00.000Z',
+    total: 2_500,
+  });
+});
