+function parseUtcCancellationTimestamp(value: string): number {
+  if (!UTC_TIMESTAMP.test(value)) {
+    throw new Error('Cancellation time must be an ISO-8601 UTC timestamp.');
+  }
+  const time = Date.parse(value);
+  if (Number.isNaN(time) || new Date(time).toISOString().slice(0, 19) !== value.slice(0, 19)) {
+    throw new Error('Cancellation time is not a valid ISO-8601 UTC timestamp.');
+  }
+  return time;
+}
