@@ -187,3 +187,40 @@ test('validates availability queries', () => {
     kind: 'foil',
   }));
 });
+
+test('cancels a booking with a full refund at least 24 hours before it starts and releases its equipment', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+  const booking = rentals.book({
+    itemId: 'board-1',
+    start: '2026-06-03T00:00:00.000Z',
+    end: '2026-06-06T00:00:00.000Z',
+  });
+
+  assert.deepEqual(rentals.cancel(booking.id, '2026-06-02T00:00:00.000Z'), {
+    bookingId: booking.id,
+    refund: 6_750,
+  });
+  assert.deepEqual(rentals.availability({
+    start: '2026-06-03T00:00:00.000Z',
+    end: '2026-06-06T00:00:00.000Z',
+  }), ['board-1']);
+});
+
+test('cancels too-late bookings without a refund and rejects invalid, missing, or repeat cancellations', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 2_500 });
+  const booking = rentals.book({
+    itemId: 'board-1',
+    start: '2026-06-03T00:00:00.000Z',
+    end: '2026-06-04T00:00:00.000Z',
+  });
+
+  assert.deepEqual(rentals.cancel(booking.id, '2026-06-02T00:00:00.001Z'), {
+    bookingId: booking.id,
+    refund: 0,
+  });
+  assert.throws(() => rentals.cancel(booking.id, '2026-06-01T00:00:00.000Z'));
+  assert.throws(() => rentals.cancel('missing', '2026-06-01T00:00:00.000Z'));
+  assert.throws(() => rentals.cancel('missing', 'not-a-timestamp'), /Cancellation time/);
+});
