+test('lists sorted equipment ids that are available for a requested period', () => {
+  const rentals = createRentalService();
+  rentals.addEquipment({ id: 'board-z', kind: 'board', dailyPrice: 2_500 });
+  rentals.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1_800 });
+  rentals.addEquipment({ id: 'board-a', kind: 'board', dailyPrice: 2_000 });
+
+  rentals.book({
+    itemId: 'board-z',
+    start: '2026-06-02T00:00:00.000Z',
+    end: '2026-06-05T00:00:00.000Z',
+  });
+  rentals.book({
+    itemId: 'board-a',
+    start: '2026-06-01T00:00:00.000Z',
+    end: '2026-06-02T00:00:00.000Z',
+  });
+
+  assert.deepEqual(rentals.availability({
+    start: '2026-06-02T00:00:00.000Z',
+    end: '2026-06-05T00:00:00.000Z',
+  }), ['board-a', 'sail-1']);
+  assert.deepEqual(rentals.availability({
+    start: '2026-06-02T00:00:00.000Z',
+    end: '2026-06-05T00:00:00.000Z',
+    kind: 'board',
+  }), ['board-a']);
+});
+
+test('validates availability queries', () => {
+  const rentals = createRentalService();
+
+  assert.throws(() => rentals.availability({
+    start: '2026-06-01T00:00:00.000Z',
+    end: '2026-06-01T00:00:00.000Z',
+  }));
+  assert.throws(() => rentals.availability({
+    start: '2026-06-01T00:00:00.000Z',
+    end: '2026-06-02T00:00:00.000Z',
+    kind: 'foil',
+  }));
+});
