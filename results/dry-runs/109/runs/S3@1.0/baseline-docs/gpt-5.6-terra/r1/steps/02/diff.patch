+function validateAvailabilityQuery(query: AvailabilityQuery): AvailabilityQuery & Pick<ValidatedRental, 'startTime' | 'endTime'> {
+  if (!isRecord(query)) {
+    throw new Error('Availability query must be an object.');
+  }
+  if (typeof query.start !== 'string' || typeof query.end !== 'string') {
+    throw new Error('Availability start and end must be ISO-8601 strings.');
+  }
+  if (query.kind !== undefined && query.kind !== 'board' && query.kind !== 'sail') {
+    throw new Error('Availability kind must be either "board" or "sail".');
+  }
+
+  const startTime = parseUtcMidnight(query.start, 'start');
+  const endTime = parseUtcMidnight(query.end, 'end');
+  if (endTime <= startTime) {
+    throw new Error('The availability end must be after its start.');
+  }
+
+  return { start: query.start, end: query.end, kind: query.kind, startTime, endTime };
+}
