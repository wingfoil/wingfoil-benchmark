index 0000000000000000000000000000000000000000..788331bdbedf2862618baebbabad9a5319b7c54c
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,61 @@
+/**
+ * Resolves a JSON Pointer (RFC 6901) against a JSON document.
+ *
+ * @param document - The JSON document to resolve the pointer against.
+ * @param pointer - A JSON Pointer string, e.g. "/foo/0/bar".
+ * @returns The value the pointer refers to within the document.
+ * @throws {Error} If the pointer is not a valid JSON Pointer string, or if it
+ *   does not resolve to a value within the document.
+ */
+export function resolvePointer(document: unknown, pointer: string): unknown {
+  if (pointer === "") {
+    return document;
+  }
+
+  if (!pointer.startsWith("/")) {
+    throw new Error(`Invalid JSON Pointer: "${pointer}"`);
+  }
+
+  const tokens = pointer.split("/").slice(1).map(unescapeToken);
+
+  let current = document;
+  for (const token of tokens) {
+    current = step(current, token, pointer);
+  }
+
+  return current;
+}
+
+function unescapeToken(token: string): string {
+  return token.replace(/~1/g, "/").replace(/~0/g, "~");
+}
+
+function step(current: unknown, token: string, pointer: string): unknown {
+  if (Array.isArray(current)) {
+    const index = arrayIndex(token);
+    if (index === undefined || index >= current.length) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve to a value`);
+    }
+    return current[index];
+  }
+
+  if (isJsonObject(current)) {
+    if (!Object.prototype.hasOwnProperty.call(current, token)) {
+      throw new Error(`JSON Pointer "${pointer}" does not resolve to a value`);
+    }
+    return current[token];
+  }
+
+  throw new Error(`JSON Pointer "${pointer}" does not resolve to a value`);
+}
+
+function arrayIndex(token: string): number | undefined {
+  if (!/^(0|[1-9][0-9]*)$/.test(token)) {
+    return undefined;
+  }
+  return Number(token);
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
diff --git a/test/resolvePointer.test.ts b/test/resolvePointer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..814c6be3239210e5d049974697f1683063b39391
--- /dev/null
+++ b/test/resolvePointer.test.ts
@@ -0,0 +1,80 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { resolvePointer } from "../src/index.ts";
+
+test("resolves the whole document for the empty pointer", () => {
+  const document = { a: 1 };
+  assert.equal(resolvePointer(document, ""), document);
+});
+
+test("resolves a nested object member", () => {
+  const document = { a: { b: 2 } };
+  assert.equal(resolvePointer(document, "/a/b"), 2);
+});
+
+test("resolves an array element by index", () => {
+  const document = { a: ["x", "y", "z"] };
+  assert.equal(resolvePointer(document, "/a/1"), "y");
+});
+
+test("resolves the array-append token '-' as per RFC 6901", () => {
+  const document = { a: ["x", "y"] };
+  assert.throws(() => resolvePointer(document, "/a/-"), /does not resolve/);
+});
+
+test("unescapes ~1 to / and ~0 to ~ in reference tokens", () => {
+  const document = { "a/b": 1, "c~d": 2 };
+  assert.equal(resolvePointer(document, "/a~1b"), 1);
+  assert.equal(resolvePointer(document, "/c~0d"), 2);
+});
+
+test("resolves the example document from RFC 6901 section 5", () => {
+  const document = {
+    foo: ["bar", "baz"],
+    "": 0,
+    "a/b": 1,
+    "c%d": 2,
+    "e^f": 3,
+    "g|h": 4,
+    "i\\j": 5,
+    "k\"l": 6,
+    " ": 7,
+    "m~n": 8,
+  };
+
+  assert.deepEqual(resolvePointer(document, "/foo"), ["bar", "baz"]);
+  assert.equal(resolvePointer(document, "/foo/0"), "bar");
+  assert.equal(resolvePointer(document, "/"), 0);
+  assert.equal(resolvePointer(document, "/a~1b"), 1);
+  assert.equal(resolvePointer(document, "/c%d"), 2);
+  assert.equal(resolvePointer(document, "/e^f"), 3);
+  assert.equal(resolvePointer(document, "/g|h"), 4);
+  assert.equal(resolvePointer(document, "/i\\j"), 5);
+  assert.equal(resolvePointer(document, '/k"l'), 6);
+  assert.equal(resolvePointer(document, "/ "), 7);
+  assert.equal(resolvePointer(document, "/m~0n"), 8);
+});
+
+test("throws when the pointer does not start with '/' and is not empty", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "a"), /invalid/i);
+});
+
+test("throws when a member does not exist", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/b"), /does not resolve/);
+});
+
+test("throws when indexing into a non-container value", () => {
+  assert.throws(() => resolvePointer({ a: 1 }, "/a/b"), /does not resolve/);
+});
+
+test("throws when an array index is out of bounds", () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, "/a/5"), /does not resolve/);
+});
+
+test("throws when an array index is not a valid token (leading zero)", () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, "/a/01"), /does not resolve/);
+});
+
+test("throws when an array index is negative", () => {
+  assert.throws(() => resolvePointer({ a: [1, 2] }, "/a/-1"), /does not resolve/);
+});
