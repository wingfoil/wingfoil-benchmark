diff --git a/test/createPatch.test.ts b/test/createPatch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a0d7c322c36534a31567f953a6b7034112151e2f
--- /dev/null
+++ b/test/createPatch.test.ts
@@ -0,0 +1,102 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+test("produces an empty patch for equal documents", () => {
+  const patch = createPatch({ foo: "bar" }, { foo: "bar" });
+  assert.deepEqual(patch, []);
+});
+
+test("describes a single changed value, not the whole document", () => {
+  const from = { foo: "bar", untouched: { a: 1, b: [1, 2, 3] } };
+  const to = { foo: "baz", untouched: { a: 1, b: [1, 2, 3] } };
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [{ op: "replace", path: "/foo", value: "baz" }]);
+});
+
+test("describes an added object member", () => {
+  const patch = createPatch({ foo: "bar" }, { foo: "bar", baz: "qux" });
+  assert.deepEqual(patch, [{ op: "add", path: "/baz", value: "qux" }]);
+});
+
+test("describes a removed object member", () => {
+  const patch = createPatch({ foo: "bar", baz: "qux" }, { foo: "bar" });
+  assert.deepEqual(patch, [{ op: "remove", path: "/baz" }]);
+});
+
+test("localizes a change nested deep within the document", () => {
+  const from = { a: { b: { c: 1, untouched: "x" } } };
+  const to = { a: { b: { c: 2, untouched: "x" } } };
+  const patch = createPatch(from, to);
+  assert.deepEqual(patch, [{ op: "replace", path: "/a/b/c", value: 2 }]);
+});
+
+test("describes a changed array element", () => {
+  const patch = createPatch({ foo: ["a", "b", "c"] }, { foo: ["a", "x", "c"] });
+  assert.deepEqual(patch, [{ op: "replace", path: "/foo/1", value: "x" }]);
+});
+
+test("describes array elements appended at the end", () => {
+  const patch = createPatch({ foo: ["a", "b"] }, { foo: ["a", "b", "c", "d"] });
+  assert.deepEqual(patch, [
+    { op: "add", path: "/foo/2", value: "c" },
+    { op: "add", path: "/foo/3", value: "d" },
+  ]);
+});
+
+test("describes array elements removed from the end", () => {
+  const patch = createPatch({ foo: ["a", "b", "c", "d"] }, { foo: ["a", "b"] });
+  assert.deepEqual(patch, [
+    { op: "remove", path: "/foo/3" },
+    { op: "remove", path: "/foo/2" },
+  ]);
+});
+
+test("replaces a value whose type changed", () => {
+  const patch = createPatch({ foo: { a: 1 } }, { foo: ["a", "b"] });
+  assert.deepEqual(patch, [{ op: "replace", path: "/foo", value: ["a", "b"] }]);
+});
+
+test("escapes '~' and '/' in member names", () => {
+  const patch = createPatch({}, { "a/b~c": 1 });
+  assert.deepEqual(patch, [{ op: "add", path: "/a~1b~0c", value: 1 }]);
+});
+
+test("does not mutate either input", () => {
+  const from = { foo: "bar", list: [1, 2, 3] };
+  const to = { foo: "baz", list: [1, 2, 3, 4] };
+  const fromSnapshot = structuredClone(from);
+  const toSnapshot = structuredClone(to);
+  createPatch(from, to);
+  assert.deepEqual(from, fromSnapshot);
+  assert.deepEqual(to, toSnapshot);
+});
+
+test("does not alias values between 'to' and the patch", () => {
+  const to = { baz: { shared: true } };
+  const patch = createPatch({}, to) as [{ op: "add"; path: string; value: { shared: boolean } }];
+  to.baz.shared = false;
+  assert.equal(patch[0].value.shared, true);
+});
+
+test("round-trips a complex change through applyPatch", () => {
+  const from = {
+    name: "widget",
+    tags: ["a", "b", "c"],
+    meta: { version: 1, nested: { keep: true } },
+  };
+  const to = {
+    name: "widget",
+    tags: ["a", "x", "c", "d"],
+    meta: { version: 2, nested: { keep: true }, extra: "new" },
+  };
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
+
+test("round-trips when a member is removed and the document otherwise differs", () => {
+  const from = { a: 1, b: { removed: true }, c: [1, 2] };
+  const to = { a: 2, c: [1] };
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+});
