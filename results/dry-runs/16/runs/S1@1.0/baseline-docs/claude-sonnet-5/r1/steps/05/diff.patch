+/**
+ * Computes a JSON Patch (RFC 6902) that turns `from` into `to` when applied.
+ *
+ * Neither input is modified. The patch only contains operations for the parts of the
+ * document that actually differ.
+ *
+ * @param from - The document the patch will be applied to.
+ * @param to - The document the patch should produce.
+ * @returns A JSON Patch which, applied to `from` via {@link applyPatch}, yields a document
+ *   deeply equal to `to`.
+ */
+export function createPatch(from: unknown, to: unknown): JsonPatch {
+  return diffValues(from, to, "");
+}
+
+function diffValues(from: unknown, to: unknown, path: string): JsonPatchOperation[] {
+  if (jsonEqual(from, to)) {
+    return [];
+  }
+
+  if (Array.isArray(from) && Array.isArray(to)) {
+    return diffArrays(from, to, path);
+  }
+
+  if (isJsonObject(from) && isJsonObject(to)) {
+    return diffObjects(from, to, path);
+  }
+
+  return [{ op: "replace", path, value: structuredClone(to) }];
+}
+
+function diffObjects(
+  from: Record<string, unknown>,
+  to: Record<string, unknown>,
+  path: string,
+): JsonPatchOperation[] {
+  const operations: JsonPatchOperation[] = [];
+
+  for (const key of Object.keys(from)) {
+    if (!Object.prototype.hasOwnProperty.call(to, key)) {
+      operations.push({ op: "remove", path: `${path}/${escapeToken(key)}` });
+    }
+  }
+
+  for (const key of Object.keys(to)) {
+    const childPath = `${path}/${escapeToken(key)}`;
+    if (Object.prototype.hasOwnProperty.call(from, key)) {
+      operations.push(...diffValues(from[key], to[key], childPath));
+    } else {
+      operations.push({ op: "add", path: childPath, value: structuredClone(to[key]) });
+    }
+  }
+
+  return operations;
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string): JsonPatchOperation[] {
+  const operations: JsonPatchOperation[] = [];
+  const commonLength = Math.min(from.length, to.length);
+
+  for (let index = 0; index < commonLength; index++) {
+    operations.push(...diffValues(from[index], to[index], `${path}/${index}`));
+  }
+
+  for (let index = from.length - 1; index >= to.length; index--) {
+    operations.push({ op: "remove", path: `${path}/${index}` });
+  }
+
+  for (let index = from.length; index < to.length; index++) {
+    operations.push({ op: "add", path: `${path}/${index}`, value: structuredClone(to[index]) });
+  }
+
+  return operations;
+}
+
