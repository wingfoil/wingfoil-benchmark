+const WELCOME5_MIN_ITEMS_CENTS: Cents = 3000;
+const WELCOME5_OFF_CENTS: Cents = 500;
+
+/** The discount a known code gives on items worth `itemsCents`, or the reason it does not apply. */
+function discountFor(code: string, itemsCents: Cents): Result<Cents> {
+  if (code === 'SPRING10') return ok(Math.floor((itemsCents + 5) / 10));
+  if (code === 'WELCOME5') {
+    return itemsCents >= WELCOME5_MIN_ITEMS_CENTS
+      ? ok(WELCOME5_OFF_CENTS)
+      : err('invalid', 'WELCOME5 needs items worth 30.00 € or more');
+  }
+  return err('not-found', `${code} is not a discount code`);
