+/** Rentals of 3 days or more cost 10% less than their full price, rounded to the nearest cent. */
+function priceForDays(dailyPrice: number, days: number): number {
+  const fullPrice = dailyPrice * days;
+  if (days < LONG_RENTAL_DISCOUNT_DAYS) {
+    return fullPrice;
+  }
+  return Math.round(fullPrice * (1 - LONG_RENTAL_DISCOUNT_RATE));
+}
