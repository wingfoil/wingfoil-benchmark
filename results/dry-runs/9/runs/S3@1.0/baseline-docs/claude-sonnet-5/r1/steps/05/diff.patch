diff --git a/test/rental-service.test.ts b/test/rental-service.test.ts
index 1b7b0aad6c76337db44ed1a16c217ddf9358b5f7..fe9c9c24c5daa09ee3c5f933203364e121b6cd36 100644
--- a/test/rental-service.test.ts
+++ b/test/rental-service.test.ts
@@ -308,3 +308,57 @@ test('availability returns an item free for an hourly period', () => {
 
   assert.deepEqual(ids, ['board-1']);
 });
+
+test('cancel refunds the full booking total', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-01', end: '2024-06-03' });
+
+  const cancellation = service.cancel(booking.id, '2024-05-20T10:00:00Z');
+
+  assert.deepEqual(cancellation, { bookingId: booking.id, refund: 3000 });
+});
+
+test('cancel refunds the discounted total for a long rental', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-01', end: '2024-06-04' });
+
+  const cancellation = service.cancel(booking.id, '2024-05-20T10:00:00Z');
+
+  assert.equal(cancellation.refund, 4050);
+});
+
+test('a cancelled booking no longer holds its equipment', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-01', end: '2024-06-03' });
+
+  service.cancel(booking.id, '2024-05-20T10:00:00Z');
+  const ids = service.availability({ start: '2024-06-01', end: '2024-06-03' });
+
+  assert.deepEqual(ids, ['board-1']);
+});
+
+test('cancel throws for an unknown booking', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.cancel('missing', '2024-05-20T10:00:00Z'));
+});
+
+test('cancel throws when the booking is already cancelled', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-01', end: '2024-06-03' });
+  service.cancel(booking.id, '2024-05-20T10:00:00Z');
+
+  assert.throws(() => service.cancel(booking.id, '2024-05-21T10:00:00Z'));
+});
+
+test('cancel throws for an invalid at timestamp', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+  const booking = service.book({ itemId: 'board-1', start: '2024-06-01', end: '2024-06-03' });
+
+  assert.throws(() => service.cancel(booking.id, '2024-13-40'));
+});
