diff --git a/test/rental-service.test.ts b/test/rental-service.test.ts
index f6e928890223b79d683d16b997b06ed6f21cb226..afaa08966ad60ddd16bcd0f90135729aeb17682d 100644
--- a/test/rental-service.test.ts
+++ b/test/rental-service.test.ts
@@ -91,3 +91,69 @@ test('addEquipment throws for an invalid kind', () => {
     service.addEquipment({ id: 'board-1', kind: 'kite', dailyPrice: 1500 }),
   );
 });
+
+test('availability returns the free ids of the given kind, sorted', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-2', kind: 'board', dailyPrice: 1500 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1999 });
+  service.book({ itemId: 'board-2', start: '2024-06-01', end: '2024-06-05' });
+
+  const ids = service.availability({ start: '2024-06-01', end: '2024-06-03', kind: 'board' });
+
+  assert.deepEqual(ids, ['board-1']);
+});
+
+test('availability returns free ids of any kind when none is given', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'sail-1', kind: 'sail', dailyPrice: 1999 });
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+
+  const ids = service.availability({ start: '2024-06-01', end: '2024-06-03' });
+
+  assert.deepEqual(ids, ['board-1', 'sail-1']);
+});
+
+test('availability excludes an item booked for part of the period', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+  service.book({ itemId: 'board-1', start: '2024-06-02', end: '2024-06-03' });
+
+  const ids = service.availability({ start: '2024-06-01', end: '2024-06-05' });
+
+  assert.deepEqual(ids, []);
+});
+
+test('availability includes an item booked for an adjacent, non-overlapping period', () => {
+  const service = createRentalService();
+  service.addEquipment({ id: 'board-1', kind: 'board', dailyPrice: 1500 });
+  service.book({ itemId: 'board-1', start: '2024-05-30', end: '2024-06-01' });
+  service.book({ itemId: 'board-1', start: '2024-06-03', end: '2024-06-05' });
+
+  const ids = service.availability({ start: '2024-06-01', end: '2024-06-03' });
+
+  assert.deepEqual(ids, ['board-1']);
+});
+
+test('availability throws for an invalid kind', () => {
+  const service = createRentalService();
+
+  assert.throws(() =>
+    // @ts-expect-error exercising runtime validation of external input
+    service.availability({ start: '2024-06-01', end: '2024-06-03', kind: 'kite' }),
+  );
+});
+
+test('availability throws when the period does not start at midnight UTC', () => {
+  const service = createRentalService();
+
+  assert.throws(() =>
+    service.availability({ start: '2024-06-01T10:00:00Z', end: '2024-06-02' }),
+  );
+});
+
+test('availability throws when the end is not after the start', () => {
+  const service = createRentalService();
+
+  assert.throws(() => service.availability({ start: '2024-06-01', end: '2024-06-01' }));
+});
