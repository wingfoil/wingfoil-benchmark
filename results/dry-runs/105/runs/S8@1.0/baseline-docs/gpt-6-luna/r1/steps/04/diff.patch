 export type { TaskFilter, TaskList } from './domain/list.ts';
 export type { Result, TodoError, TodoErrorCode } from './domain/result.ts';
@@ -16,3 +17,38 @@ export type { NewTask, Priority, Status, Task } from './domain/task.ts';
 export function createTodoList(timestamp: () => string = () => new Date().toISOString()): TaskList {
   return createTaskList(timestamp);
 }
+
+/**
+ * Adds tasks from semicolon-separated lines, skipping blank lines and reporting rejected lines.
+ *
+ * @param list - the task list to add tasks to
+ * @param text - one `title;priority;tags` record per line; priority may be empty and tags are space-separated
+ */
+export function importTasks(
+  list: TaskList,
+  text: string,
+): { readonly imported: number; readonly rejected: readonly { readonly line: number; readonly reason: string }[] } {
+  let imported = 0;
+  const rejected: { line: number; reason: string }[] = [];
+
+  text.split(/\r?\n/).forEach((rawLine, index) => {
+    if (rawLine.trim().length === 0) return;
+    const fields = rawLine.split(';');
+    if (fields.length !== 3) {
+      rejected.push({ line: index + 1, reason: 'line must contain title, priority and tags separated by semicolons' });
+      return;
+    }
+
+    const [title, rawPriority, rawTags] = fields;
+    const priority = rawPriority.trim();
+    const result = list.add({
+      title,
+      ...(priority === '' ? {} : { priority: priority as Priority }),
+      tags: rawTags.trim() === '' ? [] : rawTags.trim().split(/\s+/),
+    });
+    if (result.ok) imported += 1;
+    else rejected.push({ line: index + 1, reason: result.error.message });
+  });
+
+  return { imported, rejected };
+}
