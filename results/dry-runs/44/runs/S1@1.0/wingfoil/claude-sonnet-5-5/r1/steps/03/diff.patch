+---
+id: task-003-fix-applypatch-rfc-6902-conformance-gaps
+type: task
+title: "Fix applyPatch RFC 6902 conformance gaps"
+status: pending
+format: 1
+---
+
+<!-- task body. `wingfoil memory add` copies this scaffold, setting only `id`, `title` and
+     `status` (and any `--tags` or `--set` value). Fill the required frontmatter fields and replace
+     these placeholder comments yourself; `wingfoil memory submit` then checks the required fields,
+     moves `status` forward and commits the document as you left it, naming in the commit body the
+     content it carries. -->
+
+Reviewed `applyPatch` against RFC 6902 by probing every operation and edge case. Pointer handling, array
+index rules, move/copy ordering, atomicity and deep equality already conformed. Two gaps were fixed in
+`src/index.ts`: holes in a sparse patch array were silently skipped (now rejected as non-object
+operations), and an explicit `undefined` `value` was accepted for add/replace/test (now rejected as a
+missing value). Tests added in `test/patch.test.ts`. See dl-003.
diff --git a/src/index.ts b/src/index.ts
index 9305a14ae4e70e35480efdb2137f7ebafc420d6e..a18bfd66804dad11f6c9276bf87cdb1bb0ad652b 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -148,7 +148,7 @@ function applyOperation(document: unknown, operation: unknown): unknown {
     case "add":
     case "replace":
     case "test": {
-      if (!Object.hasOwn(operation, "value")) {
+      if (operation.value === undefined) {
         throw new Error(`Invalid JSON Patch: "${op}" requires a "value"`);
       }
       const value = structuredClone(operation.value);
@@ -194,5 +194,8 @@ export function applyPatch(document: unknown, patch: unknown): unknown {
   if (!Array.isArray(patch)) {
     throw new TypeError("Invalid JSON Patch: must be an array of operations");
   }
-  return patch.reduce(applyOperation, structuredClone(document));
+  let result = structuredClone(document);
+  // Iterated rather than reduced, so that holes in a sparse patch are rejected instead of skipped.
+  for (const operation of patch) result = applyOperation(result, operation);
+  return result;
 }
