@@ -0,0 +1,68 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch, createPatch } from "../src/index.ts";
+
+function roundTrip(from: unknown, to: unknown): unknown {
+  const patch = createPatch(from, to);
+  assert.deepEqual(applyPatch(from, patch), to);
+  return patch;
+}
+
+test("equal documents give an empty patch", () => {
+  assert.deepEqual(roundTrip({ a: [1, { b: 2 }] }, { a: [1, { b: 2 }] }), []);
+});
+
+test("a small change gives a small patch", () => {
+  const from = { a: { b: 1, c: [1, 2, 3] }, d: "x" };
+  const to = { a: { b: 1, c: [1, 9, 3] }, d: "x" };
+  assert.deepEqual(roundTrip(from, to), [{ op: "replace", path: "/a/c/1", value: 9 }]);
+});
+
+test("object members are added and removed", () => {
+  assert.deepEqual(roundTrip({ a: 1, b: 2 }, { a: 1, c: 3 }), [
+    { op: "remove", path: "/b" },
+    { op: "add", path: "/c", value: 3 },
+  ]);
+});
+
+test("array growth and shrinkage", () => {
+  assert.deepEqual(roundTrip([1, 2], [1, 2, 3, 4]), [
+    { op: "add", path: "/2", value: 3 },
+    { op: "add", path: "/3", value: 4 },
+  ]);
+  assert.deepEqual(roundTrip([1, 2, 3, 4], [1, 2]), [
+    { op: "remove", path: "/3" },
+    { op: "remove", path: "/2" },
+  ]);
+});
+
+test("root and type changes", () => {
+  assert.deepEqual(roundTrip(1, 2), [{ op: "replace", path: "", value: 2 }]);
+  roundTrip({ a: 1 }, [1]);
+  roundTrip({ a: null }, { a: {} });
+  roundTrip([], {});
+});
+
+test("keys are escaped and __proto__ is an ordinary member", () => {
+  const from = JSON.parse('{"a/b":1,"c~d":1,"__proto__":{"x":1}}');
+  const to = JSON.parse('{"a/b":2,"c~d":2,"__proto__":{"x":2}}');
+  const patch = roundTrip(from, to) as { path: string }[];
+  assert.deepEqual(patch.map((o) => o.path), ["/a~1b", "/c~0d", "/__proto__/x"]);
+});
+
+test("inputs are not mutated and the patch shares no structure", () => {
+  const from = { a: [1] };
+  const to = { b: { c: [1] } };
+  const fromCopy = structuredClone(from);
+  const toCopy = structuredClone(to);
+  const patch = createPatch(from, to) as { value?: { c: number[] } }[];
+  assert.deepEqual(from, fromCopy);
+  assert.deepEqual(to, toCopy);
+  assert.notEqual(patch[1].value, to.b);
+  assert.notEqual(patch[1].value?.c, to.b.c);
+});
+
+test("undefined is rejected", () => {
+  assert.throws(() => createPatch({ a: undefined }, { a: 1 }), TypeError);
+  assert.throws(() => createPatch({}, undefined), TypeError);
+});
