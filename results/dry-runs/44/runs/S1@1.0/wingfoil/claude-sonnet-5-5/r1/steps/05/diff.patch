index 8ab5d612ff1e6d3aee1b84eb856c7a665146cdde..f7abdcdaabaa5e97af48bd125e6f1a709c338585 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -235,3 +235,61 @@ function mergeInto(target: unknown, patch: unknown): unknown {
 export function applyMergePatch(target: unknown, patch: unknown): unknown {
   return mergeInto(target, patch);
 }
+
+type Operation = { op: "add" | "replace"; path: string; value: unknown } | { op: "remove"; path: string };
+
+function escapeToken(token: string): string {
+  return token.replace(/~/g, "~0").replace(/\//g, "~1");
+}
+
+function diffArrays(from: unknown[], to: unknown[], path: string, out: Operation[]): void {
+  const common = Math.min(from.length, to.length);
+  for (let i = 0; i < common; i++) diffInto(from[i], to[i], `${path}/${i}`, out);
+  // Removed from the end, so that each index still designates the intended element.
+  for (let i = from.length - 1; i >= common; i--) out.push({ op: "remove", path: `${path}/${i}` });
+  for (let i = common; i < to.length; i++) {
+    out.push({ op: "add", path: `${path}/${i}`, value: structuredClone(to[i]) });
+  }
+}
+
+function diffObjects(from: Record<string, unknown>, to: Record<string, unknown>, path: string, out: Operation[]): void {
+  for (const key of Object.keys(from)) {
+    const member = `${path}/${escapeToken(key)}`;
+    if (Object.hasOwn(to, key)) diffInto(from[key], to[key], member, out);
+    else out.push({ op: "remove", path: member });
+  }
+  for (const key of Object.keys(to)) {
+    if (!Object.hasOwn(from, key)) {
+      out.push({ op: "add", path: `${path}/${escapeToken(key)}`, value: structuredClone(to[key]) });
+    }
+  }
+}
+
+function diffInto(from: unknown, to: unknown, path: string, out: Operation[]): void {
+  if (from === undefined || to === undefined) {
+    throw new TypeError("Invalid JSON document: undefined is not a JSON value");
+  }
+  if (Array.isArray(from) && Array.isArray(to)) diffArrays(from, to, path, out);
+  else if (isObject(from) && isObject(to)) diffObjects(from, to, path, out);
+  else if (from !== to) out.push({ op: "replace", path, value: structuredClone(to) });
+}
+
+/**
+ * Creates a JSON Patch (RFC 6902) that turns one JSON document into another.
+ *
+ * The patch is minimal in the sense that only the parts that differ are described: objects are compared
+ * member by member and arrays element by element, recursively. Array elements are matched by index, so
+ * an element inserted at the front of an array is expressed as changes to the elements after it.
+ * Neither input is mutated, and the patch shares no structure with either.
+ *
+ * @param from the parsed JSON document to start from.
+ * @param to the parsed JSON document to reach.
+ * @returns an array of `add`, `remove` and `replace` operations; empty if the documents are equal.
+ *   `applyPatch(from, patch)` is equal to `to`.
+ * @throws TypeError if either document contains `undefined`, which is not a JSON value.
+ */
+export function createPatch(from: unknown, to: unknown): Operation[] {
+  const patch: Operation[] = [];
+  diffInto(from, to, "", patch);
+  return patch;
+}
