index 0000000000000000000000000000000000000000..a5cb4e0a031db8326d4b78ec72b07e8114987be8
--- /dev/null
+++ b/test/patch.test.ts
@@ -0,0 +1,200 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { applyPatch } from "../src/index.ts";
+
+// RFC 6902 appendix A examples.
+test("A.1 adding an object member", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux" }]), {
+    foo: "bar",
+    baz: "qux",
+  });
+});
+
+test("A.2 adding an array element", () => {
+  assert.deepEqual(applyPatch({ foo: ["bar", "baz"] }, [{ op: "add", path: "/foo/1", value: "qux" }]), {
+    foo: ["bar", "qux", "baz"],
+  });
+});
+
+test("A.3 removing an object member", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "remove", path: "/baz" }]), { foo: "bar" });
+});
+
+test("A.4 removing an array element", () => {
+  assert.deepEqual(applyPatch({ foo: ["bar", "qux", "baz"] }, [{ op: "remove", path: "/foo/1" }]), {
+    foo: ["bar", "baz"],
+  });
+});
+
+test("A.5 replacing a value", () => {
+  assert.deepEqual(applyPatch({ baz: "qux", foo: "bar" }, [{ op: "replace", path: "/baz", value: "boo" }]), {
+    baz: "boo",
+    foo: "bar",
+  });
+});
+
+test("A.6 moving a value", () => {
+  const doc = { foo: { bar: "baz", waldo: "fred" }, qux: { corge: "grault" } };
+  assert.deepEqual(applyPatch(doc, [{ op: "move", from: "/foo/waldo", path: "/qux/thud" }]), {
+    foo: { bar: "baz" },
+    qux: { corge: "grault", thud: "fred" },
+  });
+});
+
+test("A.7 moving an array element", () => {
+  assert.deepEqual(applyPatch({ foo: ["all", "grass", "cows", "eat"] }, [{ op: "move", from: "/foo/1", path: "/foo/3" }]), {
+    foo: ["all", "cows", "eat", "grass"],
+  });
+});
+
+test("A.8/A.9 testing a value", () => {
+  const doc = { baz: "qux", foo: ["a", 2, "c"] };
+  assert.deepEqual(applyPatch(doc, [{ op: "test", path: "/baz", value: "qux" }, { op: "test", path: "/foo/1", value: 2 }]), doc);
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/baz", value: "bar" }]));
+});
+
+test("A.10 adding a nested member object", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/child", value: { grandchild: {} } }]), {
+    foo: "bar",
+    child: { grandchild: {} },
+  });
+});
+
+test("A.11 ignoring unrecognized elements", () => {
+  assert.deepEqual(applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz", value: "qux", xyz: 123 }]), {
+    foo: "bar",
+    baz: "qux",
+  });
+});
+
+test("A.12 adding to a nonexistent target", () => {
+  assert.throws(() => applyPatch({ foo: "bar" }, [{ op: "add", path: "/baz/bat", value: "qux" }]));
+});
+
+test("A.14 ~ escape ordering", () => {
+  assert.deepEqual(applyPatch({ "/": 9, "~1": 10 }, [{ op: "test", path: "/~01", value: 10 }]), { "/": 9, "~1": 10 });
+});
+
+test("A.16 adding an array value", () => {
+  assert.deepEqual(applyPatch({ foo: ["bar"] }, [{ op: "add", path: "/foo/-", value: ["abc", "def"] }]), {
+    foo: ["bar", ["abc", "def"]],
+  });
+});
+
+test("copy duplicates the value without aliasing", () => {
+  const result = applyPatch({ a: { b: 1 } }, [
+    { op: "copy", from: "/a", path: "/c" },
+    { op: "replace", path: "/c/b", value: 2 },
+  ]);
+  assert.deepEqual(result, { a: { b: 1 }, c: { b: 2 } });
+});
+
+test("whole-document operations", () => {
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "add", path: "", value: [1] }]), [1]);
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "replace", path: "", value: null }]), null);
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "remove", path: "" }]));
+});
+
+test("an empty patch returns an equal, new document", () => {
+  const doc = { a: [1] };
+  const result = applyPatch(doc, []);
+  assert.deepEqual(result, doc);
+  assert.notEqual(result, doc);
+});
+
+test("does not mutate the document or the patch, and shares no structure", () => {
+  const doc = { a: { b: [1, 2] } };
+  const value = { x: [1] };
+  const patch = [
+    { op: "add", path: "/a/b/0", value: 0 },
+    { op: "add", path: "/v", value },
+    { op: "remove", path: "/a/b/1" },
+  ];
+  const docCopy = structuredClone(doc);
+  const patchCopy = structuredClone(patch);
+  const result = applyPatch(doc, patch) as { v: unknown };
+  assert.deepEqual(doc, docCopy);
+  assert.deepEqual(patch, patchCopy);
+  assert.notEqual(result.v, value);
+});
+
+test("a failing patch leaves the document untouched", () => {
+  const doc = { a: 1 };
+  assert.throws(() => applyPatch(doc, [{ op: "add", path: "/b", value: 2 }, { op: "remove", path: "/zzz" }]));
+  assert.deepEqual(doc, { a: 1 });
+});
+
+test("test compares deeply, ignoring member order", () => {
+  const doc = { a: { x: 1, y: [1, { z: null }] } };
+  applyPatch(doc, [{ op: "test", path: "/a", value: { y: [1, { z: null }], x: 1 } }]);
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a", value: { x: 1, y: [1, { z: 0 }] } }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a/x", value: "1" }]));
+  assert.throws(() => applyPatch({ a: [1] }, [{ op: "test", path: "/a", value: { 0: 1 } }]));
+});
+
+test("test of a missing path fails", () => {
+  assert.throws(() => applyPatch({}, [{ op: "test", path: "/a", value: null }]));
+});
+
+test("array index rules", () => {
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/2", value: 0 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/01", value: 0 }]));
+  assert.throws(() => applyPatch([1], [{ op: "add", path: "/-1", value: 0 }]));
+  assert.deepEqual(applyPatch([1], [{ op: "add", path: "/1", value: 0 }]), [1, 0]);
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/1" }]));
+  assert.throws(() => applyPatch([1], [{ op: "remove", path: "/-" }]));
+  assert.throws(() => applyPatch([1], [{ op: "replace", path: "/-", value: 0 }]));
+});
+
+test("remove and replace require an existing target", () => {
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/a" }]));
+  assert.throws(() => applyPatch({}, [{ op: "replace", path: "/a", value: 1 }]));
+});
+
+test("add cannot descend into a scalar", () => {
+  assert.throws(() => applyPatch({ a: 1 }, [{ op: "add", path: "/a/b", value: 1 }]));
+  assert.throws(() => applyPatch({ a: null }, [{ op: "add", path: "/a/b", value: 1 }]));
+});
+
+test("move and copy need an existing source", () => {
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/a", path: "/b" }]));
+  assert.throws(() => applyPatch({}, [{ op: "copy", from: "/a", path: "/b" }]));
+});
+
+test("move into its own child fails; move onto itself is a no-op", () => {
+  assert.throws(() => applyPatch({ a: { b: 1 } }, [{ op: "move", from: "/a", path: "/a/c" }]));
+  assert.deepEqual(applyPatch({ a: 1 }, [{ op: "move", from: "/a", path: "/a" }]), { a: 1 });
+  assert.throws(() => applyPatch({}, [{ op: "move", from: "/a", path: "/a" }]));
+});
+
+test("invalid patches are rejected", () => {
+  const doc = { a: 1 };
+  assert.throws(() => applyPatch(doc, { op: "remove", path: "/a" }), TypeError);
+  assert.throws(() => applyPatch(doc, null));
+  assert.throws(() => applyPatch(doc, [null]));
+  assert.throws(() => applyPatch(doc, [[]]));
+  assert.throws(() => applyPatch(doc, [{ path: "/a" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "frob", path: "/a" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "remove" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "remove", path: 1 }]));
+  assert.throws(() => applyPatch(doc, [{ op: "remove", path: "a" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "remove", path: "/a~2" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "add", path: "/b" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "replace", path: "/a" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "test", path: "/a" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "move", path: "/b" }]));
+  assert.throws(() => applyPatch(doc, [{ op: "copy", from: 1, path: "/b" }]));
+});
+
+test("add with a null value is valid", () => {
+  assert.deepEqual(applyPatch({}, [{ op: "add", path: "/a", value: null }]), { a: null });
+});
+
+test("__proto__ is an ordinary member", () => {
+  const result = applyPatch({}, [{ op: "add", path: "/__proto__", value: { polluted: true } }]) as object;
+  assert.equal(Object.getPrototypeOf(result), Object.prototype);
+  assert.equal(Object.hasOwn(result, "__proto__"), true);
+  assert.equal(({} as Record<string, unknown>).polluted, undefined);
+  assert.throws(() => applyPatch({}, [{ op: "remove", path: "/__proto__" }]));
+  assert.throws(() => applyPatch({}, [{ op: "add", path: "/constructor/x", value: 1 }]));
+});
