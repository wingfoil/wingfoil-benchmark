# One run of the @PROJECT@ runner for line %i (directive runner). Installed by
# scripts/runner/install-schedule.sh; started by @PROJECT@-runner@%i.timer.
[Unit]
Description=@PROJECT@ runner, line %i (one workflow step)
Documentation=file://@REPO@/.wingfoil/directives/custom/runner.md
After=network-online.target

[Service]
Type=oneshot
# 10: the run only waits; 11: the line is halted. Neither is a failure of the service.
SuccessExitStatus=10 11
WorkingDirectory=@REPO@
# The agents' CLIs and npx must be on the PATH the timer runs with.
Environment=PATH=@PATH@
ExecStart=@NODE@ @REPO@/scripts/runner/run.mjs --line %i
Nice=10
