# Every @MINUTES@ minutes, the @PROJECT@ runner for line %i (docs/bootstrap.md § 7). Installed
# disabled: the approver enables it with
#   systemctl --user enable --now @PROJECT@-runner@<line>.timer
[Unit]
Description=@PROJECT@ runner every @MINUTES@ minutes, line %i

[Timer]
OnCalendar=*:0/@MINUTES@
Persistent=false
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
