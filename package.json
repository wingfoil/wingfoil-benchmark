{
  "name": "wingfoil-benchmark",
  "version": "0.0.0",
  "private": true,
  "description": "Benchmark suite measuring where WingFoil makes a difference in AI-assisted software development, compared with plain agents and competing tools.",
  "license": "MIT",
  "author": "Roberto Pompermaier <robypomper@gmail.com>",
  "type": "module",
  "bin": {
    "bench": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/make-bin-executable.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "wingfoil": "wingfoil",
    "test:bin": "vitest run --config vitest.bin.config.ts",
    "test:docker": "vitest run --config vitest.docker.config.ts"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1",
    "wingfoil": "file:vendor/wingfoil-0.2-pre-3df305e.tgz"
  }
}
