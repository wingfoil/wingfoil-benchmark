{
  "T1": {
    "1": {
      "commands": [
        "printf 'cache\\n' > cache.txt",
        "mkdir -p \"$HOME/.claude/projects/-workspace/memory\" && printf 'the codeword\\n' > \"$HOME/.claude/projects/-workspace/memory/note.md\""
      ],
      "events": "sessions/question.jsonl",
      "resumes": [
        {
          "commands": [
            "test -e \"$HOME/.claude/projects/-workspace/memory/note.md\"",
            "printf 'redis\\n' >> cache.txt"
          ],
          "events": "sessions/resumed.jsonl"
        }
      ]
    },
    "2": {
      "commands": [
        "test ! -e \"$HOME/.claude/projects/-workspace/memory/note.md\"",
        "printf 'old\\n' > old.txt"
      ],
      "events": "sessions/approval.jsonl",
      "resumes": [
        {
          "commands": ["rm old.txt", "printf 'deleted\\n' > deleted.txt"],
          "events": "sessions/completed.jsonl"
        }
      ]
    },
    "3": {
      "commands": ["printf 'ready\\n' > ready.txt"],
      "events": "sessions/completed.jsonl"
    }
  }
}
