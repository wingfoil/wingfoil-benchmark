# Without the trailing slash this also covers a *symlink* named node_modules. One was committed
# from a linked worktree (c448a67) and, on the next checkout, replaced the real directory.
node_modules
# The runner's workspaces, at the root only: a run's records under results/**/runs/ are committed (bug-009).
/runs/
*.log
.env
.env.*
.idea/
dist/
coverage/
spikes/*/out/
results/**/transcript.jsonl
# The runner's build cache: harnesses built from their clones, by SHA (adr-003 decision 2).
.cache/
# The built site (task-045): rebuilt from the committed aggregates, published by `bench site publish`.
/site/
# Release assets made by `bench transcripts pack` (task-047): attached to a GitHub release, not committed.
/releases/
